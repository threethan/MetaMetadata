O_58KoQ7kNvwHwZBaB&_nc_oc=AdpCc1IOpo3ygFgJu9Vqs_2M-K_EchuXWJMOED27f8cWAwV_REHO7iNhNej6chEf0HQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPDlkXZSLrApEwAgf_Frt7yfI1aTOFnkJflArNSGqxBg&oe=6A788F29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9hKiGhzO7QQ7kNvwFBNuUA&_nc_oc=AdrXTLAeqnT6CwJL-z3T0IwnK34SOi4DBGc2IYcSOjeHYHdYeyQx9lZTIPnETFGh9UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7IO0jtVI9AZpFOy_38ZXJ2FVU2VNKSTk4SSA9Mzs3Qw&oe=6A786C8C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WX8cOvaTLoQ7kNvwGFYYO_&_nc_oc=Adq_kv0yARvzirEgQNkmF-IwhYbawr-w8NvH1zBAI_yeJODd5EGwTyGUi2yZpB8tfNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIab5HQmvPqAPLsKB-0jySEZXDVJ0z4ucuJ7iPwy5VVA&oe=6A7862D4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2BUk5BL3mEQ7kNvwGchdAA&_nc_oc=AdrRC-hfxE8ZHgi5RPsioUaGaZabLWTPvw0T2Tu9cYps_gxoUHHzBts9GIAzM7NNK9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP-9P1LUEjpLAI1QyKjxcLYV82pjYKtNQd7dqpzq7nug&oe=6A7880D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIKVne6-WvwQ7kNvwGW2wGD&_nc_oc=Adp6bbYyvYR0ppTdJ393zTDMFsXifn7a19N_OXZg54zMNSntaLMgDvvLNriz2vGEwtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcKW9L-rfCElXX-TNc_68k2ktwCwkydvGmMjhxOw9jsQ&oe=6A7885F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
ROBKMMQ7kNvwECRKYX&_nc_oc=Ado3bIYhcoOrDuZDb4OhYXXEsv69TbwLssJ6hsjrsPm_glKYjmDT0pY_NxxoDawdBSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj_MUwRJwn-grvgb6TUqanqaMpj1gzJuw6mFFdcktlQQ&oe=6A734929"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTe51FwVYhoQ7kNvwHwajzE&_nc_oc=AdoWn12Je5tlL8C-NIBfGsOWNqno2blx9MQ0Oa7nZxAj5lQUWa4uaZ5xBx98gIk-zXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH71pHSNhfyMQZXSO-jhOhRUqk63feAFZpNT-ZF69mUvw&oe=6A73268C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrgZPmkVh14Q7kNvwE3NVUr&_nc_oc=AdqoqhUjM4X5Uw_eYXk_Q16YdywWmOjQ7EIdSqDPUpNP-fGhfiNZIB6zkO5cc8VJjMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfjpd4ufoE6CYZ0h6DAqZskn19Yb7PoKRYosfzEIPPAg&oe=6A735514"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcXTh6LrfXwQ7kNvwGoPDtL&_nc_oc=Ador30B0axn-TLAQjjRazIjcKhrrhKyN2eMP-lKZbyruY-fQScx37IB6S8b-lACnTcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrE8mL9cUHod4qtyt6wjfRWiVzO5obflaazR_3t4Y9uQ&oe=6A733AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W0BYIsiwK4Q7kNvwHekIFk&_nc_oc=AdoYGcOGbpij-g2gOUNZvex1L9hTFLAVy5m6ufAGdLlpobUDxLLdwhvyq1ptKG1xNDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV_APn_hdBcdchczdCw5xpxg1EPEwlPyrV8kd1J0H_MA&oe=6A733FF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
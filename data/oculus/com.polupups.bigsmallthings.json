Z6QPAcQ7kNvwHU5Kc9&_nc_oc=AdrkqEedeCgizzeQaSBTbFKxWaJ05ttVLmQqMLzx7vFxUlyaZJ9SUShlaz-Cua70THY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04yFiNREL6V5KubnBqWGlLcax2FB-BCzGai-ixpg8_nQ&oe=69D51529"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54PQsVP3zusQ7kNvwFK6Abl&_nc_oc=Ado9vs_UZbEX_tR_5C-nc3_0ca3joQpsieCVh_IP1g25RVPK96uo0Vcjj994GpH-F40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6LS83H2727XOkYCh5WIcFPjYf9CcC2tkEl05MxrWwg&oe=69D4F28C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKO-RdHnop8Q7kNvwF1sTX9&_nc_oc=Ado_G0gmP4C5S0n9pMwrpG9gZezdo1efrR3r0bPEmyydp7MjjXxb9Arp_hgL9HjQK9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NamOwSjjdJQiSQh97vy_5LdSb6MADnlTFcB7fgQ9a8g&oe=69D4E8D4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OV9Yr9Wmr-oQ7kNvwEVq2yS&_nc_oc=AdrknVaniihTCvqRz86tFU9uP-gB9pEVF3YO3Y6ftGyUW0_JKGkcMJYgz89nillD5_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r7NtOU9c6R4c7jDuXwz6QpMVEVfixXHnj-ZJS4UANsw&oe=69D506D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpQ0-5zt2XgQ7kNvwFOjXmH&_nc_oc=AdrSj2l2ElaXhjZgP7GtH3tfIEegPexpWUk887pqWAKWJiTJozTDwSI-es7UlKEmArk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YyjNdG_jI0CorE4Fpn5HeoflG5UI7Yk7O8BDhgCf67Q&oe=69D50BF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
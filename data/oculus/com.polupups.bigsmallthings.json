r2wv6gQ7kNvwE2pyMz&_nc_oc=AdqpQu3ykJ6HN4ig1Qwd4qAREuL-7yxoRq9bkNU1G0AJsS27QE7ClvjMEvDnKRXTbNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzMDq1wducza4A7z0W7M-tTQZXnoFzQCCtvW4dhZzqIA&oe=6A53A529"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64XLmUcKSl4Q7kNvwGzCKOy&_nc_oc=AdpuiIbBEL6Ew4l8rMbZsg7C5Xmx_qy7DVq0aznA9uzDvGMgLnbFKS5cDC1PR5_ICyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq9Kj_Cz5x2wv5IpTS1RX-n6c_5LlIB4LC4pP9uAFJTA&oe=6A53828C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4vv8clL9psQ7kNvwGCnOS5&_nc_oc=AdpAVPFZlMjrSeHiYETHxPoPBAEWwdHqEq6HgxZPPPaLGpCsLI-2vdvra33Y9YMOIr8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJsXiuGk9Gma_dx0esAWVI_qH28BGoXoonheAocxGAMA&oe=6A53B114"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG3ACpqHrrcQ7kNvwFx3N98&_nc_oc=Adrbi330KDVB49XzLKcuDDN0sv1K7V6_84rrPMwxs4q-Uq7saHLOT5d01FgWJatLHH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjJF-41R-lSCwvYIVVL7q4TCM-0_nBzQD0ICZNWsaZwg&oe=6A5396D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJIyWhTqv-QQ7kNvwHXMbFb&_nc_oc=Adoeub--d3bLJArkJmoTcbfduqa7ts3wc34MEzJYqqimo3eMmJbI8dj3JikCkjTJR6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBculOx3LEkp5dVbBxYYkOFQIVyQAfl3IXIMyGc5lUCYQ&oe=6A539BF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
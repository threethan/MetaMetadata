JinH2gQ7kNvwFWrzEE&_nc_oc=AdrRRg0h0w1gugutSD0etKn0TcykkhiM3jAk91Pt_6N_8aGR_xmUqIkwFQdYve_aW70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZLRD0Qck1Rttbf6deWay-TTI4jlrsElKuKTaF906FMw&oe=6AB53429"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONBsFYIWsWsQ7kNvwGutwkS&_nc_oc=Adr3tHmiQuinZQQq4uzGX5IyEVvXWzXAS77PeZCNwGBAUEJ3h3cKZYQqim627wy4sdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9uCdFazQrpmjaPrwYhoTGCSyj4mbNPUpQ8u-H3H5vog&oe=6AB549CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwdcWNvZfOsQ7kNvwFHpH4q&_nc_oc=Adrm5SA6C4kgRccqv1N2M1j2ePEJWuczpd4py2P7WQTWbD_8Vwmz1JJw__OCfK8vWHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGIPL8qjkBAoOwjYfoSP-vE01Evm3pfJfcMTdtTIXgFg&oe=6AB54014"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qZl4-Bk5KkQ7kNvwHKpgS6&_nc_oc=Adq7YvIN0BuKjDQZFqcjk2LB20pAfSi4vsq49s7aieDyRQOv-V6qKb7V0rQ_QfGr_Eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkchHHjQV5NeBtaRa03rGiydmdSQBQqO8xMNxOzis64g&oe=6AB525D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoHJZ0sjzmQQ7kNvwHvFK6t&_nc_oc=AdoWqows1iJLMS6p4SMsRgs-it1esjycFpRg9uyQadCmf3pvtBljN0ZwypCH8uhU2Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx3Ii3Qyg0jEsEpDsyw81nIWjlImkQIrN7AJzrP49FLw&oe=6AB52AF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
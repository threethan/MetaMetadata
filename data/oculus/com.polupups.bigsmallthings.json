7S1hU0Q7kNvwFw3PB5&_nc_oc=Ado6MYQxlJX_iQ1FczpduGC4u9M_xutJ7kECkdLhArMrbcN2vEMLPyq4mx4xwoiM_mE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PuYoJvTHytMj2YsgpaOqnLc1oHGBj2DiK_lJ6hFPU5Q&oe=6A072E29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIKab-yOgEoQ7kNvwFkTmbp&_nc_oc=AdorglFQ-SIE7Z1pPwp5IfY2cBhkalR7026Haz3Q--9vDuF5Cx2T_pfjCTw9XNjuweE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IorNHIqycuxoHiPH2Y2Uj5cWHckle-PuavuKqRTKP4A&oe=6A0743CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95SdirTxVrMQ7kNvwGB7lvc&_nc_oc=AdpYWNnepVFJKOadSq5bSG3UbqUFSxu-HH3XJlM1ppIO7yT5b6jIWbwOxLotC_uPLKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lX0VtLNN9WVo6yZ5cXKphaOfgM-ZjE-A8upWvu7zY9w&oe=6A073A14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyPv5aOOMA8Q7kNvwEfJTen&_nc_oc=AdoDXUTSFqt1a3PrnUbdbW2WsDWZo-ulfKWpSlGATD4Vm1zp7qZFwUCgixaIc4d0Gy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DUgxC0oKGdrwU_YNBmWxe8oyKl4U80RJsHkJsZ4sToA&oe=6A071FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCzyXZ071g0Q7kNvwGO57dx&_nc_oc=AdoF1NqrgaB74V9jrg5dY2892ZdL4FbG4tCljnGEcxUiWIh2Dt-tcdnPeEQM1pN0iu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78rQuBYviIww67FyyL3bSWJ5lkHiYcRwKEO4CCC24lmg&oe=6A0724F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
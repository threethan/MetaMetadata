3cCVBgQ7kNvwFu3ISB&_nc_oc=Adq-I21FTRFvW-A1jU6uj20zwu-HGFI5DD2x677JDfAnZxG48T8lySloMekE0hDqxgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJohgPoIZWa3KnAn7g4TRZIOkkjghXHTO-PtbxSjpsv1Q&oe=6AA56229"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQjCHXBitDcQ7kNvwGNKbs9&_nc_oc=AdrUeEVYjLDtFQ78i0XbZKIY0WoJZ3EttuBiDW_q6AvjsrnmDshaU2ws2Wmd7Oppo4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpmlKwF3DCzoLJrDmoGCTG0B_DDIR_Nf_LSCC8CqL23g&oe=6AA53F8C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRruOVqVaMYQ7kNvwHLshr_&_nc_oc=AdpZ6Nrcg_u7BpM8uMIACeyHdYhBYp5JRDsG5d3YBhk7ecbTb2AmOy-IgEEMbe325yg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdEE520VtSGDH3oa3vhpL7fK3GGqRmNDlldGW2RGKhAg&oe=6AA56E14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9FB2F5MN30Q7kNvwGUwMgk&_nc_oc=AdpKUKyoH8-c5go-VbpkcXZS2-8FZPLhRI1d1xQwZBCKuWkPTcqHtgYs8x1uJFNMrVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCHSkvKxYQcivlFuo54HvK6qq0olLeHlElC3wuEhdTsQ&oe=6AA553D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqRh_jLikV0Q7kNvwEPU7rM&_nc_oc=AdriJthVtmzftAg3-ZpuE19B79Lrawkoxkit2BUe2wyVnVjn4NH742_j1YfX6Oy08dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqi9ciWktJuhYeQVF1D9wxjMUqf_w9lyg2qCWjIfh2ig&oe=6AA558F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
QWVQWQQ7kNvwGQCN7j&_nc_oc=AdoC60Df5kmG_u0n4WHXSEx0jF4D5_Y4tX_2sUrm4ltov-RjoK0mkfWm5iH35wqBlVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwvrIUv-k5TIlxtg79IgyWwmZi_dPv_Fi2YLOFYloLag&oe=6A9AD629"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzGp2fLjjq8Q7kNvwEB6cXJ&_nc_oc=AdoguGqN6DXp1gr_uN0CQQ7rR9GuWrWPIBiKk1L0VQGSBE56tUkfZN1MuP-c9DGSphs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFFxF0AKhK1yHGMg-y4g-nSbfvfY3Gjr307HANdAppuw&oe=6A9AEBCC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPb1ijRl2zwQ7kNvwEMplOx&_nc_oc=AdrAlsrG9RZ0fm9VQ2PiOLEYLjzBxUJD9395vLy6K4E2KpEKKZhBlzNhuuGPZx4wVD8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKACmsU6SzTwrArW87K0_w6AFG4pzYAvSZ5bM13FAW7Lw&oe=6A9AE214"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv_19MJONjYQ7kNvwEblYGa&_nc_oc=AdpDDu8HlFVU6hV4Dwrk4WRFKqABaAHZ-8i127znNpPwe3lL1mBzw8XX3tvMILw8n0Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP-oghFDEH-T_WTfN6Zu7B1zD_mMnWNhHQjIbxVFO0ZQ&oe=6A9AC7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VedxmMosOxAQ7kNvwFUev0G&_nc_oc=AdpCnAN8JB6Cac3xwUxIn8aGnasw_nhhid-6rdW4ZQaAQr979X53c5kxFicSRV8aSUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIatpN3hZ97cm2bgEX8-F0Ml6VodTUulxm-5vGe8cJ-Hg&oe=6A9ACCF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
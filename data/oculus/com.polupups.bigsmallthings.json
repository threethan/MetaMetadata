_xb5MwQ7kNvwEYlkkg&_nc_oc=AdpXzhXBHTfZsJiiNmtQ9RoKW5sqy0BozM_vxF-WtbR9QDib-S6T5LMUkY7LFr3EXJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiNrS720DTxHA8lcFrDtOgMWLedS0c1aNZE8vx3vpRcw&oe=6AC111A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwVOsQGCadoQ7kNvwGe__N7&_nc_oc=AdqLiB8jFCKUuXewzG_A52BZGJi3s7GIpxHCN5fLfuTm-m3IOvta-OTsNZDtxKUvtIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-qKWoDuhM0XOARhGpXM9BXyyjnMPoqPnhS0q5mE_XUw&oe=6AC1274C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAbOJUTgh7QQ7kNvwE7P1AZ&_nc_oc=AdqkPOD4aHIu-S905YH6atrEagkrtdxQQcn5Ju_YT6PzbsrgQDLxbQLYuN_rvU-lfMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ-r2PJP2SJewiQJwinAj72O-HVm8s6yxkRp-O69pbyg&oe=6AC11D94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4DFGzxx8cQ7kNvwFdy7Th&_nc_oc=AdqxMp60jRURlGAWDZ91McGW-tTamMUGfG28YdGllFBqCexTre6fpt57OyGC9jW5t6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjMqKN_OjDUkJTi3waGx0149lcz0_TivFhpIWVzCJ7HQ&oe=6AC10352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2IEclIoMCQQ7kNvwEx3eRS&_nc_oc=AdrKE4xSINM8zX-2iiavGL2-uux8oCM6zEwac73p3WLnos0A6hYZlfxTmx5pc7XsYWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMvu9WZJpcH5TFAU60lcNJStEnWJSoExFlTQjfGwgfaw&oe=6AC10879"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
s58spgs6H6vWQnm_tajuQsn4fCcEpddHL6fnmLgQ&oe=6A22F2D7"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWp0A1ctZsIQ7kNvwEojWWi&_nc_oc=AdofNE_dE6cG2y8s07RFljGQACRDoQMn8aypd4gTxRs0PI01XMV8-vXvuuBa2ygyQlw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bHxgYZbdYeh5WgOeZOiaCDaOxWEn-MvE89OvWBt44Nw&oe=6A22E675"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gD1pRmCBgAQ7kNvwHJskqO&_nc_oc=Adp3kh0nWl7wPjSbrc7jc4rLfSlrQIBr3raoRASrHTkwQcg6NV2BiaR4OnPlCgVj8sw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1bvC2OBEfPD29zQK4oZ81_cLYKBm9tz3RR9Qupt3SHw&oe=6A22EAE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR e
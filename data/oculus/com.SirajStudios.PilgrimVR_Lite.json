68966201337100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL0PR7C35I4Q7kNvwE6U-Vt&_nc_oc=AdoeU4xc884KYK3aAo6kQS9u9nRTiPpQgplEa83PFlVnDXuNngeuZKQz6fBRojiegeU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACbFYS9CAcoYtT08w_n9ywAtavYrplWCie7buEi5hhpg&oe=6A54FF75"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tny25iQmEncQ7kNvwE4APU1&_nc_oc=AdqNECTrQQ6i3ZZPLat81Ky0YJ7viFdmMuEpAAvTQYYIJxHfrk7YArcoHUhFcCV4Bi0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvKd56NXiEH17V9-C1lglZB1prDHxjwnKa0KCkLcjhQg&oe=6A5503E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR Lite: Hajj and Umrah, an immersive VR experience like no other. Explore and learn about the sacred landmarks through a guided tour, experiencing what it's like to be at these holy sites, all from the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pilgrimvr.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Center for Islam in the Contemporary World", "support_website_url": "https://www.pilgrimvr.org/#contact", "website_url": "https://www.pilgrimvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24071868199116883"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1511326369746035"}]}, "baseline_offer": {"id": "1511326369746035"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747336920, "status": "PUBLISHED", "id": "1511326369746035"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24081336081503428", "version": "1.0.7"}, "id": "1550862365739311", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7520833651313599", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24081336081503428"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id
nt-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzF2L48ERzkQ7kNvwFuljjT&_nc_oc=Ado3q18CZYiD8Xbrk7O3UECHfUNrHLCnKohSZkxZWv0ijg7d3lgb9Xt103OxmHJh474&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0b8gKZtwtliT63gL3gbGrjbO9gvsbpsfAbXVaVNMtsw&oe=6A6CB6EA"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hk83GGYeWcQ7kNvwEvKg80&_nc_oc=AdruqUelAmSOWXJN5bOHbouK-ZiPlmXPvW3fc7TCpusexJqJsAb2DXhOsnt7INZphjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvJdeMlxQvx0Hzas5mHd1GfBw5QI1nI1ftUxBAY93wXA&oe=6A6C9263"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about 
DZ02rxCkXyBbPVXUVCTDuCwNik0w&oe=6A007397"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmVeDAjRBZkQ7kNvwEX2B7q&_nc_oc=AdrEDca7n89Y4_Yo0I0NYDXlk3KYRSEYPQuHxnx4EnFFfsTOVgf1XuvS_WyDjzxjnjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af563JUypPr6Z1tdQVRgnn5CDidGQSZjKkDRjIM-g36Wjw&oe=6A009F75"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odghSlIiBFEQ7kNvwEI7g3r&_nc_oc=Adq3eb8sCN94OOcAyeOBcXU5zrCrCPGGYNMOc5pPH5Syk_wd8ogyOUgcoWmzsQCwtvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70QrTUiabdUXcXU6TUV18xol9EiBuy54IVgctcc9SbCg&oe=6A00A3E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
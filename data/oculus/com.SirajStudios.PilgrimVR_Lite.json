lM5i86QXGz0jlqf20GDhJ7-FCezw&oe=69C3CE97"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBN936mr-DcQ7kNvwGxwZqQ&_nc_oc=AdqBHMDEhGW-n-P4xfLgt3a7k7RucCtEBtSaMfCVt4iQMh03ZDM8tu6BOwBbc5c917E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoWcyUPCEIp6EuccbaU1n8u5z33_4m0zfTCVsFzwopuA&oe=69C3C235"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmpVWhRAn8YQ7kNvwGaFERw&_nc_oc=AdpFLeopm6cbeE5UETWfxANohECadQrz0PpsCN4vHR44VJyv07XTBaENvo1UGX7qoRg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy82KcEiuqnbo29b3tLNm057fe-Jk5X8SMjoSwcyI_u0A&oe=69C3C6A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
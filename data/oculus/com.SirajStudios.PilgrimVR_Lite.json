62sZyovVD88giB07Cn5ed571-EuQ&oe=6A21A157"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWp0A1ctZsIQ7kNvwEGbmhF&_nc_oc=AdrFTin23ZhacZ3QTIgwntMVbeqxiRd3qVNIAmijOOFLaL0qc1R5Ilt47ngcKkrgapM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z5iKcMCxCon0fHNlMBwN8JI00G_dxco9hP-EkmXz3YQ&oe=6A2194F5"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gD1pRmCBgAQ7kNvwEE9tst&_nc_oc=Adp85ncL0NmNV1F5ibdCr1NXzJWrsfHkOI5YqeEtJFHqLxRoMeTkmOiifny9YZ5iqZQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85QTSqPfBJylm79WlULclo1435jqzQNqll97PxclrrJw&oe=6A219968"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like no other. Explore and learn about the sacred landmarks through a guided tour, experiencing what it's like to be at these holy sites, all from the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cicwlearn.org/privacy-policy", "developer_terms_of_service_url": "https://www.cicwlearn.org/terms-and-conditions", "publisher_name": "Center for Islam in the Contemporary World (CICW)", "support_website_url": "https://www.cicwlearn.org/home/#contact-us", "website_url": "https://www.cicwlearn.org/pvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27465749609728708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823296_1107764628149040_8864923113288650511_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISJVMO3fvnkQ7kNvwEkvsyF&_nc_oc=Adq2Dr2jbxqiMckOLwdd5PQm0bwTwKblUvUHdAAB7bxHyNsK68OPQRDuOOMYP-CMThM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lb_7yp5jFBkfjgALtTsZIZU4cOPofB72DkN14vT6kng&oe=6A217E3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043
xuOmHM_9wYLbvlsD4dP_R636_R3w&oe=6A4A7FD7"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkEO9L7wuQYQ7kNvwEb60P0&_nc_oc=AdpQNFeD7-PcG8dlR-QxOx0_ovBYOSbCzkapSf3tXAci40emlkV5q9K45BRGnhMgM5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHOTEZxO_ZUOmePKqGhZWpTILxlymhkss5_EuDV-jhSw&oe=6A4A7375"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS2p9VythOMQ7kNvwE51o4J&_nc_oc=AdoRPIyOJEVnsLMtktrVG8NZ_kaSe2rNd1sbgdlGZpq6EJ7RjWXN0QzMjhVNyVxO3jM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_Uj7WK4lcs1xwSY4TrYcN34Hy8-dKs7a9aEoVrkUycw&oe=6A4A77E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
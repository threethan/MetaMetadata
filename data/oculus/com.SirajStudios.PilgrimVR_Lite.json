nt-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EMcMA7NkI4Q7kNvwH_OIVH&_nc_oc=Adoo3tEtQ43LIaB0Imc-VRp4Bw09oyfQDUy5lSyvgpRToZz_KRr3VyfXlgnG01bTbMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJq_TUTsLDSwDYLJVPVPAFfTUsglNRLx7Agn6qgg-qrw&oe=6ABD226A"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u5raF27E7sQ7kNvwE1fucE&_nc_oc=Adp9nusF31uOO6JO4xi3qsPZk0PwzcApb2V5DEZjSQrsmE2DfmhMvIsANYQOMlgiiow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGHQNNETJ1tQa7CYmCE6L4HbFSGAxBsmQa643O5eTC7A&oe=6ABD3623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about 
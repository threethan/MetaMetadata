USjepYprre98u9ejTWDlX5f5pBnw&oe=6A2838D7"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGAtXd3Hl8oQ7kNvwF5gWfM&_nc_oc=AdooAal90PKeUdfy2WMUeuOxC965NwEta54izXzJMBQg0u2YTPe3ZGDrEItSm9-RrQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aVCBXS3QtwEDARFC-l6BQNx8dNNisbrpDUQkwSmcuIQ&oe=6A282C75"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJmsKIzKUxIQ7kNvwGxYd89&_nc_oc=AdqjocPsKmJxHxl-7MbnCZSgqamYXwhn9szFYs4UroAI6mTwKHUbVDM1s5MNwAQB-BE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-zWdDUlfS-8N8YW0j9YvOGgyurlgMw8T4ch2G-FKcOQ&oe=6A2830E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
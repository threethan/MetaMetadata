hxHc1bZa29lvL8GYfCIWvd8MwsRw&oe=6A492E57"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkEO9L7wuQYQ7kNvwEZDWKz&_nc_oc=Adp_WQ20H8lTV-3msDjBDUpsiILdgIYe9kMuV2arL-RWxzy8FUYFaCp6_c86KAii6L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDryoyzNd96pLgEwbZsTpikVDfH3qPce-U0mW_XpJRDqw&oe=6A4921F5"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS2p9VythOMQ7kNvwHbxrYR&_nc_oc=AdoxCTwWGgP1khobjatslbe0NVRNQZFqbKmS0O1ddrTIcFCCdx0q37gLwh8YqKIfNZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIa59ZmpbioU-bCDaAxNqXulhfd2CKZxBgqo2fGPlG8w&oe=6A492668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like no other. Explore and learn about the sacred landmarks through a guided tour, experiencing what it's like to be at these holy sites, all from the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cicwlearn.org/privacy-policy", "developer_terms_of_service_url": "https://www.cicwlearn.org/terms-and-conditions", "publisher_name": "Center for Islam in the Contemporary World (CICW)", "support_website_url": "https://www.cicwlearn.org/home/#contact-us", "website_url": "https://www.cicwlearn.org/pvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27622647424038925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1107764628149040_8864923113288650511_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3K7VPuhAbcQ7kNvwH0LSiI&_nc_oc=Adq3IlAQ-UadQruYhHj25CMEn2BtjFyFy3upIXz5VE_prnK386rXGlf-DBijL4QBPRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqJWVrE5FpWknQZSWqCymfPufkcSd31p-9DmCnGfucwg&oe=6A490B3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043
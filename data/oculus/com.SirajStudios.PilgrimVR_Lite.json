T6K3ATLMxk7N7sWp6CQQbjm_i_gg&oe=69E61597"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU_0aFh6JvEQ7kNvwE0d14b&_nc_oc=AdpW4K25BBTBdPghVFyQajfwXT66AN7NSnpZnW0-KPRM5TXCKgmsbSX_voGxJvxmvIk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IlqS1qs9DhaOApvV8g7IhGBigUto-XeSL3Hz-Tj3frQ&oe=69E64175"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJXLdWdaLUQQ7kNvwFOCXEs&_nc_oc=Adp6u2OvBl_EitnwW6jRaSJC4b-CX2UM7wAIl5UdFGK0jcUw4MUYk76JmRa1OqNodMg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Xp79TKDx-w6gNNcNbwc0exMZnTiT1WZBe-wtbQzcR3A&oe=69E60DA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
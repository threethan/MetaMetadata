ToOmuI3pbmYOEtwSvSGa7US1VeGw&oe=6A538217"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVRpxo_GDAsQ7kNvwEQYOVk&_nc_oc=AdqVUhW7570d53uCHAWEiNMx__o94ntvUfeNMxY6Og4iAWa1KDGzt8uXnJLFGgOMA9E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOBl3bgNYl8hbkryj1DcwVFhDeZaWfGakVzr9axPKKDw&oe=6A53ADF5"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSlQMQMJWgsQ7kNvwE9lbXP&_nc_oc=AdqJxBO3gyo0QCrEF-Fe_YGqXJ68W10OIuPG8RqqBiyMsf0l5Jtgu3HweBgsbq-D3JQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxpryetTFYye1qL9yF2JhhJp5r3m5ZJpaF9d8L_d5qcQ&oe=6A537A28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
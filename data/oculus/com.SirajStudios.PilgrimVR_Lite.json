epWpR2gFAAKfYLnk_NkHEnPFp95Q&oe=69E8B897"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU_0aFh6JvEQ7kNvwGBjEeo&_nc_oc=AdqFLaBWz4Rmbxn7HSfgzrb2_8wakwoOXMKet4lhCHzGNH-c1F6vTnjPYR8fyRsMzRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21HhniooZe_i2b6NzhfZFhdxipSE6OKmpJPdjwyuBPWw&oe=69E8AC35"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJXLdWdaLUQQ7kNvwEtr1NC&_nc_oc=AdrbM22uoK0jsDpaaMXY7HLX88zNf6rFqnq2SH0KSh5PhlHQ0-pdoMqm13r97fxVSP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jvEhMBJo3T54t3c5lY9xsnY-lDAV6geN6TJpx24CjUA&oe=69E8B0A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
TPuEmr73Gwi-7J-y_7ibHzjn4_0A&oe=6A1B09D7"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWcTexHWoBUQ7kNvwHA6xCr&_nc_oc=AdoIyXSZrpYE6Ov9H2CJqbV4muLvHX6llhCSl2CUOkZJHmWIiZCrTZm-wg1OFgRQxUA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4knmtoZfJXUe-nfjcjfU0D0ehSoq0VPfyJzENVThilpA&oe=6A1AFD75"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vka84yucZLcQ7kNvwHLwipv&_nc_oc=AdrCs558mMXyVJkLFSHzQx8670uIfobeez7mTdrMiRDPnyuEl1FP8SBtrimLp3v8jRM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DITNjvCgYFCd7Nse27f-0VZZiNUdfGSI6CLPDu5TxjQ&oe=6A1B01E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
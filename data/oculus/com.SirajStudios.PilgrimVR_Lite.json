241387098327_8811736960911752574_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jxsbLpZUDUQ7kNvwEK53h8&_nc_oc=AdpTgGI1sM2EY0ZP5IzV3FuF_ZnTV2Kk0YuIpV0R9tQo41JnwXpIbKyCfHpBUPXtPe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Ou97v6TpXA2a5YdBW0jop3Rp5w5NQjD34BcliQOv6g&oe=6B072530"}, {"file_name": "Screenshot 4.png", "id": "1375835187976501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DG9K4mXCnsQ7kNvwHpcASL&_nc_oc=AdrdQYc5EXszqKmtB_z01_HZNLa3pE3sGxJMF8FPCjksyb21c4gBH4wjpuZkYWEK8Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSLGUd8L8n9_VLfno10-OxVxAagz4B7fKHDaTj4wFuXg&oe=6B06F66A"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtBzIYziJV0Q7kNvwGuRAE0&_nc_oc=Adr0bFCACdH3iyiHd1ZH4Q29lbmWWtUUUEJTPwhMgQEVsqy01adJBaPn07Y_ZRzOt18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6vXvMi3tEb0T8L7ffgD_rBN-lRRdRhv5BRdN73Os6tA&oe=6B070A23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about the sacred landmarks through a guided tour, experiencing what it's like to be at these holy sites, all from the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cicwlearn.org/privacy-policy", "developer_terms_of_service_url": "https://www.cicwlearn.org/terms-and-conditions", "publisher_name": "Center for Islam in the Contemporary World (CICW)", "support_website_url": "https://www.cicwlearn.org/home/#contact-us", "website_url": "https://www.cicwlearn.org/pvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28065762979727365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1031610066350649_3397590026068132264_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzVU_QHeuuwQ7kNvwFnTnJS&_nc_oc=AdpQr9TzswlFMQGjf
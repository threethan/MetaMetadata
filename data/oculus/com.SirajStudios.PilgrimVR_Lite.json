eAnZ_yKbfDGJVcCnjeocl7ZoeHJw&oe=69D3A097"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfPFOqko1bAQ7kNvwFQxp4R&_nc_oc=AdriqHgT8VR7IvzwrlNmLrQSEwmCwecPRmSIRxgeoOdtnfEt8yNbYBlrwvHSZrIE05o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xW58zP0fl9Rfc0erNv_h_McIAZh_KRpfIpvFjRET_Zw&oe=69D39435"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pH6Klo0770Q7kNvwFcB3KO&_nc_oc=AdohLLL_uWm3-H0YE4kkHIE39rqM3one_md1wzjqhpLQ96G9rM9q3iq7PyFRgx-ZkK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yIekd0Dz53cu2uqdYGGhO82urIX6BmJYkV-jvlxj5eg&oe=69D398A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
241387098327_8811736960911752574_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0084XKhiXBAQ7kNvwGkmyjd&_nc_oc=Ado1KC5uwMQ_kSePllEo3qlCkbT3yFt1-UOMCt7ZjjLKetANil0girbIlbtT7sn3sps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2PokUCvvKeatbTgSk1sS97v4E7NWXDJrSNHOXIU2pvw&oe=6AFF03F0"}, {"file_name": "Screenshot 4.png", "id": "1375835187976501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upTgkNpmoVoQ7kNvwEFwb00&_nc_oc=AdphErTTH17KP4REjdeI0dE2YYoMfv9R4WwiIuMFVFEFxRJsgEESVsU5O_GSnt8et_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUuVkrObmRoa2mIBiC30RuG4ubeVLPDE3XnZq4qT8G5w&oe=6AFF0D6A"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6niNWjMjQ2gQ7kNvwEIKTaL&_nc_oc=AdpO0SlZFuiT6CEp7YaRmc27ojNTg6KQVUFHj92WBv3u3yx1H_dVBHtfkvp5sWhWExk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlx_yG4vaeH-CKm3Ahgai9ArDGZBvctcbiDwiaXrqG7A&oe=6AFF2123"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about the sacred landmarks through a guided tour, experiencing what it's like to be at these holy sites, all from the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cicwlearn.org/privacy-policy", "developer_terms_of_service_url": "https://www.cicwlearn.org/terms-and-conditions", "publisher_name": "Center for Islam in the Contemporary World (CICW)", "support_website_url": "https://www.cicwlearn.org/home/#contact-us", "website_url": "https://www.cicwlearn.org/pvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28065762979727365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824292_1031610066350649_3397590026068132264_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf4lC3HP7DcQ7kNvwG84AJL&_nc_oc=AdqLCY17SWIZDsdW8
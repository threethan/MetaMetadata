Z5YDeWQ_izI7FX8-6wpTttPxjO6w&oe=69F5E797"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqJlnh3xC_gQ7kNvwGZzh5V&_nc_oc=AdpL0wOun9tD2wNZso1WhnHL3oZto8JrVB0IVckw749biWR-I5s-yC6CVxojlu6moZo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gkBLNGqwSBHhBFzNTDgzZ384F3sAjJGT6ATKZjW5x1w&oe=69F61375"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcJ4fDPnxikQ7kNvwFL9T8i&_nc_oc=AdoA8yCJWseVDHQ2DXEStUC7UYcgkDGWc2WdAvS59JT44h_XZJ02ruJ0A5j3Ac6xT6Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2J-L7LZybQ2lrewNfZj6n33eBuaNwgHiQyVJjI77Rh4g&oe=69F617E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
fHCWdlbFBuWA-NuixUHq9ydGpPpQ&oe=69CD0917"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXH3vzUTk-AQ7kNvwH7uvwh&_nc_oc=AdrLW9Qp7gPPtNjgVXv6NL1Za_IIQGuNKTDNiDtO5wqLxbDJFLNcLAkAVTMTnVpxkiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypJwZEk7y-JK3G7hBXGLTj_47vKoGqm_hmtWyBN1RoiQ&oe=69CCFCB5"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP3kwa65w4AQ7kNvwFY-jUK&_nc_oc=Adp7_tVIXiuTVOSq_ZFG0vDZTycK-Z4dFPwjEoZy-1ceOco8FXSqAuNBDWfZ4Y0ZT4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx5Ili9rJ6Pf-OGjxOu_Wrt4oN4novZTYI1xfBmg9giQ&oe=69CD0128"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
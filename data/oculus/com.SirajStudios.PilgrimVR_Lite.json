nt-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8urilZu3wDUQ7kNvwG67hZM&_nc_oc=AdqsohoAJj9L2sK_e2j4EpTiSUDZwaNT0wngHuag0Vc1FALibVynamuluVOc875Us-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIVNEFmT5k_plCSW0oUrQo1Jet5_mFg5V1Ay4Nv70cCw&oe=6A5E366A"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KAsdolWIkYQ7kNvwEygMLg&_nc_oc=AdqgfzovGjph_co23M6AZr3jlJaaYWZeWiBr5DXfUmEyJc0CGrBnEE7ApTiq41QjZaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWdPjp7-eDWWR7HdVfC7tkWPq13bPrXo85feVjnP8-7g&oe=6A5E11E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about 
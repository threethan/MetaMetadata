nt-lga3-3.oculuscdn.com/v/t64.5771-25/491823901_1375835194643167_2614595073547441635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GULRXLeqygsQ7kNvwEkeuzw&_nc_oc=Adp7IJz_Avvf8vMkt9ScAWcJazgw-4Cy-yqMk2D54HzQcj7p2KmSYS2G9SotEtUANns&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0SEq2BFtgkAdqBzoL4EboV7JnayUniQEteA8KUucgrw&oe=6AC50B6A"}, {"file_name": "Screenshot 5.png", "id": "1096707152689594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1096707156022927_6409183781696906200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiCxmLabRcwQ7kNvwGG94re&_nc_oc=AdqnUqqXmid9wNLQ-ng4_YupLYSAk36sN_z1zPwsOU05iCWpfDw6etT-a2FT108h3uw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvRBVcPA18U4jgP9_Mp5SJdlqfA42b0GpREWfWDa7pfg&oe=6AC51F23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR: Hajj and Umrah is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile you can enjoy the lite version which focuses on providing a guided tour of the landmarks,  you can also subscribe to the Premium version to unlock a deeper experience. The premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. \nTo access these advanced tools and prepare more thoroughly for your journey, simply click the \"Subscribe\" button inside the app.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah , an immersive VR experience like no other. Explore and learn about 
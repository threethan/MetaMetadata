lZ0cRdN_cFwFdGMl-t0WKMYfGKEQ&oe=6A298A57"}, {"file_name": "Screenshot 5.png", "id": "968966201337100", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_968966204670433_1507774537471580452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4OAhd1XwOIQ7kNvwEbToK_&_nc_oc=AdrsjnYFplRzz1FJ3X8pvaxqKumERbYyp-HakbeP07lQK0OyFRNFPyUD3mw7OOsf2yE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EKum0EV22UEt3Gy2li7sx-mbmYVFX5cZWDCjFnRqjMg&oe=6A297DF5"}, {"file_name": "Screenshot 1.png", "id": "947166990424632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974630_947166993757965_8801589779408154086_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJEmKGkE5vQQ7kNvwGVD8VR&_nc_oc=AdpLEpNK4eOVHoefUvre3pPJi9GfAOTHOSihDIX6_Q-LvrxJzA8-cbjG7fWqDyR9cIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_vEcZW_FzHUA40Zv24YSTYElxOw8Sr32JrzOKBLPC0g&oe=6A298268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pilgrim VR: Hajj and Umrah (Lite)", "keywords": ["Pilgrimage", "Islam", "Hajj", "Umrah", "Mosque"], "long_description": "Pilgrim VR Lite is an immersive virtual reality application designed to provide users with a detailed tour of the Hajj and Umrah pilgrimage landmarks in Makkah. This VR experience allows you to explore realistic recreations of holy sites and gain insight into their significance. It\u2019s an ideal resource for students, educators, and anyone interested in discovering more about these significant religious practices.\n\nWhile the lite version focuses on providing a guided tour of the landmarks, the full premium version includes a comprehensive training guide, interactive 3D maps, and in-depth tutorials. To access these features and prepare more thoroughly for your pilgrimage, you can explore the premium version of the app on our website.", "short_description": "Embark on a profound spiritual journey with Pilgrim VR: Hajj and Umrah (Lite), an immersive VR experience like n
CLg&_nc_oc=AdpwSAAja6S6H7T_XId9tHkkHH_rFKHUKfXAddi-p-hqRvvCiq4o60190delA8HvIIQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXUWV84VCS6w8E9GiqxknWSLUoW9q0mGbgyTpcOeXUng&oe=6AFB1BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MoneyDream", "keywords": ["Fortune", "food", "money", "gem", "dream"], "long_description": "\"Money Dream\" VR \u2013 The Most Ridiculous \"Cash Rain\" Simulator!\n \nSuper Simple, Insanely Fun!\nSit on a virtual bed, grab pizza, hot dogs, gold coins, dollar bills, or diamonds from the bedside, and hurl them at the ceiling\u2014instantly, the room gets flooded with an epic downpour of food or money!\n\n\ud83c\udf55 Pizza Storm: Hot, cheesy slices rain down on you\u2014smells unreal!\n\ud83d\udcb0 Gold Coin Tsunami: Shiny coins pour endlessly\u2014grab handfuls like a pirate!\n\ud83d\udc8e Diamond Meteor Shower: Glittering gems crash around you\u2014too rich to even dream!\n\nNo thinking, no effort\u2014just pure satisfaction!\nPerfect for stress relief, lazy vibes, or anyone who\u2019s ever wanted to drown in cash!\n\n\"Too much money\" never felt so good.\n\"Money Dream\" VR\u2014Live the fantasy!\n\n", "short_description": "\"Money Dream\" VR \u2013 The Most Ridiculous \"Cash Rain\" Simulator!\n \n\nNo thinking, no effort\u2014just pure satisfaction!\nPerfect for stress relief, lazy vibes, or anyone who\u2019s ever wanted to drown in cash!\n\n\"Too much money\" never felt so good.\n\"Money Dream\" VR\u2014Live the fantasy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/a10b9a78-e501-4411-84ed-9fd637ec3120", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MoneyDream/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKv4IWsFpZ0Q7kNvwGsGwH8&_nc_oc=AdmSpkGdf3HtcnGEe1I55F4rNkaC0uZIZWceueN9i5O5cPc5q7ys9_HsLor67JbeAn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi6rF8JLNI6ES-eg6aL0V7YUrUX3g74UFht3kpDit9zw&oe=69B53C3B"}, {"file_name": "2560x1440_\u7f8e\u98df1.png", "id": "1463748098377798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1463748101711131_8957055774221756247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxM1KWEMzAYQ7kNvwHMv6by&_nc_oc=Adkl-nc5qDtQgaNWMDVdtywS-r1F-Vz9QBkms6DK7HtaEK62Ubo8bNVfsTN6ym2ec8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-pSl9HZCe1QhMN6CcLI2M6MkrQMrxjFSnZvHLA2inXA&oe=69B55806"}, {"file_name": "2560x1440_\u7f8e\u98df2.png", "id": "1293078972210783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_1293078975544116_3136265095905894431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0AW5vRU_NwQ7kNvwE54lNZ&_nc_oc=AdkZ1IFiKz1XuiqEHqnvrE_xHDkN5MZrZhpbQLC3V9ZRqoZA9htXbl32ocnQlrE_9ok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu1uF_MsmNPjKLBfz9nGbZ3NGAz_G-VgjQE_wdkS1PPg&oe=69B55D05"}, {"file_name": "\u94bb\u77f3.png", "id": "673433009101670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_673433015768336_1024519573698832373_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyS4hpCWGOQQ7kNvwFewJ2f&_nc_oc=AdkagKrsFfeWUHPBzBp9JvSsHS_l5SU5BU9-7S3c4HWxHYpQ0jdcCcMbCjZTvoiwQFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysfD7afp00qxXDuHyeKtYozFH60FJGD0Qe4B3FKhLdJg&oe=69B54138"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MoneyDream", "keywords": ["Fortune", "food", "money", "gem", "dream"], "long_description": "\"Money Dream\" VR \u2013 The Most Ridiculous \"Cash Rain\" Simulator!\n \nSuper Simple, Insanely Fun!\nSit on a virtual bed, grab pizza, hot dogs, gold coins, dollar bills, or diamonds from the bedside, and hurl them at the ceiling\u2014instantly, the room gets flooded with an epic downpour of food or money!\n\n\ud83c\udf55 Pizza Storm: Hot, cheesy slices rain down on you\u2014smells unreal!\n\ud83d\udcb0 Gold Coin Tsunami: Shiny coins pour endlessly\u2014grab handfuls like a pirate!\n\ud83d\udc8e Diamond Meteor Shower: Glittering gems crash around you\u2014too rich to even dream!\n\nNo thinking, no effort\u2014just pure satisfaction!\nPerfect for stress relief, lazy vibes, or anyone who\u2019s ever wanted to drown in cash!\n\n\"Too much money\" never felt so good.\n\"Money Dream\" VR\u2014Live the fantasy!\n\n", "short_description": "\"Money Dream\" VR \u2013 The Most Ridiculous \"Cash Rain\" Simulator!\n \n\nNo thinking, no effort\u2014just pure satisfaction!\nPerfect for stress relief, lazy vibes, or anyone who\u2019s ever wanted to drown in cash!\n\n\"Too much money\" never felt so good.\n\"Money Dream\" VR\u2014Live the fantasy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/a10b9a78-e501-4411-84ed-9fd637ec3120", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MoneyDream/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235103312848586"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "81653563769
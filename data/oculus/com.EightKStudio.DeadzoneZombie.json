G25NLA1qzBiDxOJHacl_MinDe2uL_v8Xo40Db8lo968tU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsnzxFrjJLE2HLv_PntYCcxUEZjFByWTHaQjCeLTHEgLg&oe=699C364D"}, {"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VQO2AJNKEQ7kNvwEd8JBo&_nc_oc=AdlW2NYb7zrEKERumIrmWcX-Js0jRnN3nLJyLWrwe8dely4KrnZqdnpcpM6jww5abM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftr8wLkcs8N-O2l8-hcX3wl6RzpbP40JQS67bc26fzERw&oe=699C475D"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_mI_EckThEQ7kNvwHwoLUq&_nc_oc=Adl11okr5mpkdHjl3junPZfg-7G1d1qT4Sd0b7uMTykUpWOY7eGussKrBouVDnfzzMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0sDe8TMnAToHTgXpyirQASO4eDfaP9z19PHLmE4Fnhg&oe=699C4E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_2560_1440.png", "id": "525252999448110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65227368_525253006114776_6043420586234449926_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01HxzW70sdwQ7kNvwH7RYLY&_nc_oc=AdlQG4dBH5KryNnkbvZc-WNqo-cGQEr9P3P_Wf3R3CZg5oGqanCBn0TzTs3US9qecew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvN3ztVFq0Nn9AVihRJOxhryGaqjdGIFEXMgVjIjrCUYg&oe=699C42B0"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1230058584388043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974694_675202400638553_8266737524255045705_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5-ZqHBv9NwQ7kNvwEurRDR&_nc_oc=AdmV7YC03fVngjE4axaBdI-1Ds4dKgdkRVKR9iUBHMao8cTU1jW3kKo0yKhan3U99j4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-yH_sYc9QzrENtKekDHubs7wrVxS2yDYPMxA12kyNX
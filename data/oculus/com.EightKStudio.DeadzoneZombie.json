64058806288279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHovSgISFEIQ7kNvwHgDe4t&_nc_oc=Adrnnby17vb0WPdI53AbFaoWi2ag170IxKz0AeJU7b0SrtPkLfyugUzm9j61bI0FRJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSWVI7heVTN5-pzBOgI-COrMQqboHRxOjh7kZ7M7jdtQ&oe=6ACBA78D"}, {"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZyz_pDOkVgQ7kNvwGjVX29&_nc_oc=AdronIKahEcPdfxsCJa2XnFt3mkhw1-fI0u_pZoQq-MMmCDBG-4I7krqi9oBfBVagyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5W1EK-hz3DyZPlcgWrnEnC4nM22b83cY_wpxt32xYIw&oe=6ACBB89D"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrVdL6kMDAAQ7kNvwF9uMMJ&_nc_oc=AdoqbbqLxVl3qwjtCiCUFpg0PqhJ_y6VxFCP5ndnNpjITR6I5psdXyk2qie4iEkuCkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ5MfbnWqMx_DD-qxhqqI_BrCB5ZINMV7_TEO8OsPZ8w&oe=6ACBBF98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_2560_1440.png", "id": "525252999448110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65227368_525253006114776_6043420586234449926_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiH1Zc6Z7cgQ7kNvwG6IkWe&_nc_oc=AdraOQsyOoLS9_wrbCIi-dQUl3rWdhPBelhHoFA3lR8ZbhImUvxYE5X9FnXiG8MRJ48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeSd-C90bcDV7rg91MeE7ql0OsBEmEcdfbpiao_-yFkw&oe=6ACBB3F0"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1230058584388043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974694_675202400638553_8266737524255045705_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlzjzeSTgdAQ7kNvwFKNtFr&_nc
_429608532652201_6912487942951236984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfmluEOrqEcQ7kNvwEeZqi9&_nc_oc=Adorcr7VGok3NY46N3xF2yHTI8DD2ANxSzD5RKQ2VB52lDo18ldjrZkITZAOuyVvY6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af811ZYn5n5nF2eNTW-f-ku8o-eNzP-aYA_--aekhfm83g&oe=6A341938"}]}, "id": "1304174523455473", "locale": "en_US", "screenshots": [{"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjDexvMLapwQ7kNvwGd_Xb_&_nc_oc=Adokxx8Q2omXkl19vtHcnO68xh0BeVkyf7iENA-4n7mJffsD0JoUEureFUVdLWV28t8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j2-n6_7U-YQsj6MCem36Wy9BfdUBkPqU0NXG6JDtiCQ&oe=6A341C1D"}, {"file_name": "SC_0000s_0002_2.png", "id": "1283485029168098", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982613_1283485032501431_4062464058806288279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-YfQx_ZYXEQ7kNvwEFnbj-&_nc_oc=AdoYTsICM6s0FkH__q0u-OcD8jlH6tffkh3NdJRZyeYMfdaM7PWj0cOmKKTcR3pXbso&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91K7jHYn1w_ykfI2z4THpCQp8Aq-icVjPlCFcfdTGnzQ&oe=6A340B0D"}, {"file_name": "SC_0000s_0001_1.png", "id": "1244208696312298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_1244208702978964_768588130442483455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5frkGfuUmF4Q7kNvwHh6yx7&_nc_oc=AdqaNW4h5Aaw8hnwhey21aht9fw_wNGF6dnc9qO07I6IoCLRg3her0h5Gcv7_mc19Yw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wAaMbvNmWmKpQ8A8cA12Zy4jdEcViqnnlR4e2PCDX-Q&oe=6A340BDC"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kvw6mCMpp0Q7kNvwF_S8Mf&_nc_oc=Adr0nGWyIwTGV8MgQ-tIJYLbs4y4L5lqbr36mZTiejg5ndTbCB9g1A6mqbaQjvVcNPc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83x3_iT05okHVWR6p4yYxBo1CHE_V2_WyxwFtV6RjL1A&oe=6A33EAD8"}, {"file_name": "SC_0000s_0000_0.png", "id": "602757361583410", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003260_602757364916743_4472869646762931476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzC6v2DrEh0Q7kNvwH9SHt2&_nc_oc=AdqN8IG-pULlvwOYmhmtKxZskEIRk8fQC1klQgo1aWc2zq61G5BPen5qT-1QRrybHGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qv5BfzxToNtPbCCkaGtAPEuRRBAkRxxx9G2FgAJfgAg&oe=6A33FD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "801747277700153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334050_801747281033486_4967619914442193317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKiygRVQ_P4Q7kNvwFKUK2P&_nc_oc=AdrDv4JE5N0ZR22e8JwaWL7rtNMD5S7W61J-JkvbpeoWSQ5DsMmuQF1PG-BkXchApns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GqgRc-RaoTgqNUMVbIa-JAKcvRWEA8nTUG-rJWN_DNQ&oe=6A33FC90"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1834022286978808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1090756961634676"}]}, "baseline_offer": {"id": "1090756961634676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668184380, "status": "PUBLISHED", "id": "1090756961634676"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24009207388726013", "version": "1.6"}, "id": "859004781777692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8235038329902839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24009207388726013"}, "release_status": "RELEASED"}, "binar
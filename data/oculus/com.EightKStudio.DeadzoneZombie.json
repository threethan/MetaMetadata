GCwtmy9b1APHQuR8ixQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mVpQDN8QDTznD6J74hpwNiAXmk5_SNJ5VsU9yesiUZg&oe=6A1D8158"}, {"file_name": "SC_0000s_0000_0.png", "id": "602757361583410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003260_602757364916743_4472869646762931476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U37UlWi5rgQ7kNvwG2x9CR&_nc_oc=AdoGQZf-ki9R1n8J6P-k5mav9dmRjnR4_D4WsAcqclJi3DT-Ra_XwO_qHOZCEawRu7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eCkWeuDbseyFzbv0LHxLbezaqOPzccDuT1zmOVqexYw&oe=6A1D9396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "801747277700153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334050_801747281033486_4967619914442193317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJw1xlNShEgQ7kNvwHQj3ji&_nc_oc=Adp7XqWUVwmH73_Re1Uth-vg-4FzGtG6-oRZeRxR4EjuZvjBiU-FfzxXrP06HS-axI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nAU0p6v_AkbJUecaNYUQxid_Z42lpHFnSfHIdwScqMw&oe=6A1D9310"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1834022286978808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1090756961634676"}]}, "baseline_offer": {"id": "1090756961634676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668184380, "status": "PUBLISHED", "id": "1090756961634676"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24009207388726013", "version": "1.6"}, "id": "859004781777692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8235038329902839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24009207388726013"}, "release_status": "RELEASED"}, "binar
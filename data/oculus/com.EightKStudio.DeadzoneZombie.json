64058806288279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjjZS9eRP48Q7kNvwHZntQP&_nc_oc=Adps_Ips7eLv3BKcpYBSH-cmzB8E-luRPJuRUPvcO1G6A2boOKFsYr9322olzSTv8dc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mBrIS4biz-hubpx1rnW9MBhzjy4dEXleMNUjXlQlVDA&oe=6A2C220D"}, {"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DuW2eXCKzQQ7kNvwHsBjoh&_nc_oc=AdoWSx_curwMFhCyQnkmBXyEvzAq6z5D1QuPYOQpNt6OFZ4-gSdHCt9Jvba2P3aCrzU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99ISg36qLKrwTA-K9dH8-6UINlE6ducAH2bwvKuUWTdw&oe=6A2C331D"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYA3GYlOXDAQ7kNvwEy10nQ&_nc_oc=Adrlx2lgtEawZf8kikZPFsc5-5uYqtVKvTMVvLmnYcXkxE3I2GCl77BH6CfNYVUAkaU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o1vE3qpgEIbnqtKfJPLbsOpTZDQeM4P4ar3bisTThog&oe=6A2C01D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_2560_1440.png", "id": "525252999448110", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/65227368_525253006114776_6043420586234449926_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTvDYMMsOqcQ7kNvwHjZrn4&_nc_oc=AdpJnBhA68I9M7JcoHVbM7GypJlH-b-8Q1QuchDPJNHE9WdbKDZYog3R7PccgNmn6yg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XGMfcYcc7CK75GxKJYVUeQCKPolx7I-O0beljp6ciew&oe=6A2C2E70"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1230058584388043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_675202400638553_8266737524255045705_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtDk9pEdaZwQ7kNvwEATPXC&_nc
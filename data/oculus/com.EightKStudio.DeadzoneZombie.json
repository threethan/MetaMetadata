_429608532652201_6912487942951236984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtbZgqMZ0hkQ7kNvwH1_ZG9&_nc_oc=Adpb4tioCFjTpMtKfMutRo68wmjtFTPk-eM38uZ8R262aD-CFLTrfq3xkWjFHMCMftA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af617OcoU8jwj6oQGWqVWjd7xzw6TSrW2yERTLmgBF53tA&oe=69FC81F8"}]}, "id": "1304174523455473", "locale": "en_US", "screenshots": [{"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPT__nmshjsQ7kNvwGXYxUS&_nc_oc=AdoEwXSKIwhBabMu8Ez0s6eUcqQIgZr7FcOQcc2sF-7Ga5Cnf3rYaOwpjwcOEJYhzFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xouE_LBHOLQmelAxba4H8-s4vwlSfneDZ3DwUimvyCg&oe=69FC84DD"}, {"file_name": "SC_0000s_0002_2.png", "id": "1283485029168098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982613_1283485032501431_4062464058806288279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXOZkXJqhYYQ7kNvwFjmkuX&_nc_oc=Adp6q_9Q7vzXPMZvfiH-Kuho6Z4SNLYR_uc9EVjVHe0Wq20Fw7sUIs8dS3Fk5Wj18d4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ih_ebslaivbECrizrTuwLkCs8EyuQpQrGmx8HG0QJ_g&oe=69FCAC0D"}, {"file_name": "SC_0000s_0001_1.png", "id": "1244208696312298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_1244208702978964_768588130442483455_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FN9yvCrLxAQ7kNvwHtfeFH&_nc_oc=Adqh1pA8qiptLnkfy707_d_mOv34dOgJhXMBN9ZvuTfwUQK8BueDADTy6dS1Z5nIocQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ex6JDXNViO5vnOOqTyr3AcSlM4w_6DHJi2V8f1s7V6g&oe=69FCACDC"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Iyf5CK8yQQ7kNvwGFBct0&_nc_oc=AdrtTieEmZf3nnyKJfyEqRVjYgp3RxLAJTno4uDs4UqqvcMH18Go_SPv3sYm_Jy7sZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af791jo6zoHxQVoxa_zGjv0bJxjGtvTwQRXR9_ZAKxNi_g&oe=69FC8BD8"}, {"file_name": "SC_0000s_0000_0.png", "id": "602757361583410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003260_602757364916743_4472869646762931476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXGbNHfSrZQQ7kNvwFIGhUk&_nc_oc=AdrnXughex7gU1M6CLnmuxADapdpqT5yL3RJUwVOe3tQxLI7hI6NJNu_RI3mIUovD8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lS8JmzBcIb330JHfpbTbE2YvVDONfEKeTyUpmWDWGxw&oe=69FC9E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "801747277700153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334050_801747281033486_4967619914442193317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ7xbqUxwuoQ7kNvwHVxT9T&_nc_oc=Adp-GPSRpxdvaG_xZiNz5MOTVrRAfGvSUS9w688jXjfBJqgdV8UD14IErfB-sBv_haI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tfHSLfGRVbGE2-Lzl79HMIMGa8nwRNadpUgJExu2gag&oe=69FC9D90"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1834022286978808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1090756961634676"}]}, "baseline_offer": {"id": "1090756961634676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668184380, "status": "PUBLISHED", "id": "1090756961634676"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24009207388726013", "version": "1.6"}, "id": "859004781777692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8235038329902839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24009207388726013"}, "release_status": "RELEASED"}, "binar
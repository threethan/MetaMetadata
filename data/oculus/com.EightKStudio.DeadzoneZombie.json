431_4062464058806288279_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKy-AXgBpJkQ7kNvwHYQ0nT&_nc_oc=Adr6EtEYEdrKPU3p8aOH4koWWijE9DUbagrbiEIUFxYnf27zWEFz5fS6iTjg-X-1apA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdIab4Wun4hD9lwbuSSNX21Mlkx_1ia12gWpBAhXr9fw&oe=6A7DA6CD"}, {"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgvHwOMD7tkQ7kNvwGSwTgV&_nc_oc=Ado-iw5UoWqscevZXVky0LDf5i_8aXmvUIATPep1knolb35uQQltRKaWCvrAf94kxNE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbQgt0T4mv0b9Ss8TdJbsUbkgIHv8UCZNXjrfO3e_NXQ&oe=6A7DB7DD"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAp5bn4lQtYQ7kNvwERW0B_&_nc_oc=Adre2aljN6TqYhNDJcbYmNipByIxBtSUmJ0WCQXpAYuOQtoMqrI1JXtNb92xtdGW4_0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQBQqkg3RSBHSdchym5XZZXzW-d0R8dXnU_rNMoq0CFQ&oe=6A7DBED8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_2560_1440.png", "id": "525252999448110", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/65227368_525253006114776_6043420586234449926_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9ZydqHe2HAQ7kNvwF1Cs1y&_nc_oc=AdovJk_rgT-SrucLCflitrwTeVnnKC0JCdhJ8kERh4_vaK38zIL-ONKYMIZoHRqPsVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNJFox1MoFbBDXu6nx6Z1J2OSNM4H1KBAH82z-MhNOBQ&oe=6A7DB330"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1230058584388043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974694_675202400638553_8266737524255045705_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqVZtSubR7wQ7k
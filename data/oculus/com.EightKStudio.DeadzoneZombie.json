JgaqdLDQkrYIilkq2KwHU_uN91plXI5N98e3TD_UC5yrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfscFV4zqMTavzbt7pumqnyNAhMncG4fG5EjmFpM2m1A9Q&oe=69A2CDCD"}, {"file_name": "SC_0000s_0003_3.png", "id": "1692986441082930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035320_1692986444416263_661876145207327289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0g_-hHd3K8Q7kNvwEjj1t8&_nc_oc=AdkvOLhk17KBER086JP9PgkNzYdO-JLHOk8X0J2zsE0ac1n1ilRFTbdwmnjxZgrz_To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstxUVV28CUKg5bmFf0auncMACnGZmQLsgjj9Xqo6Dyow&oe=69A2DEDD"}, {"file_name": "SC_0000s_0004_4.png", "id": "805294024024687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982476_805294027358020_7620078546683690455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8vWVkNRxewQ7kNvwGkuS9z&_nc_oc=AdlQx94bm1DzuOu8vH9qKwLDqf8AwKTZMkO73FTYexY0E4NJ6YIWzj5OCsxIIFPKDqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsn9dynsQCASt0-rFPCzjkAUBwkfrD4C_pMwt9X0NrqXg&oe=69A2E5D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_2560_1440.png", "id": "525252999448110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227368_525253006114776_6043420586234449926_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17MOdpIh_gYQ7kNvwGQ_Kty&_nc_oc=AdkVfMbdyPySolIIaFoKYbXPGfFBcrJCY6ecV9dQ-MLa5oysRFCaU4mCUYr3NmhuQc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdiS934Wnc1IQqvXXMQj-sI9G-RWvk9bnMU01wkccAHA&oe=69A2DA30"}, "display_name": "DeadZone Zombie", "keywords": [], "long_description": "Massive arsenal with dozens of different weapons, including many different types depending on the player's preference: handgun, shotgun, assault, automatic and a variety of high-damage melee weapons.\n\nMore special is the item and trap system, depending on your attack and defense strategy to choose the right type of trap such as: Fence, Sawblade Trap, Gun Turret, Electrical Turret, Thorn Trap, Fire Turret or Drone.\n\n100 missions with dozens of different types of zombies and bosses will bring you a great challenge and experience.\n\nIn addition, you can team up with friends to conquer the hardest challenge of the game with 100 stages.\n", "short_description": "If you are brave and like to challenge yourself, then surely you will not be disappointed with this virtual reality zombie game, with a world destroyed by zombie virus, endless chase in the Scary background, will definitely create a strong feeling for players, in addition the game also has a coop feature to play with friends. Let's play together now.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deadzonezombie.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8K Studio", "support_website_url": null, "website_url": "https://deadzonezombie.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1230058584388043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974694_675202400638553_8266737524255045705_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBOYsqIue04Q7kNvwFh3JqJ&_nc_oc=Adn-CNWQwzKToQg5COWn7lzQLl39OYBUrHH03bfkthEsKgNvEHommSXhwUIb-fsoVPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsg_UZELHQPfCOxayjf2yoJ4SgXj-1rulYwXvepFxteA
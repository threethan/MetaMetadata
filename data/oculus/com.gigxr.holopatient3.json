 different requirements and so pricing will be discussed once we understand your goals and context. Please get in touch with our sales team on sales@gigxr.com", "short_description": "HoloPatient is a patient simulation application."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gigxr.com/privacy/", "developer_terms_of_service_url": "https://www.gigxr.com/terms/", "publisher_name": "GigXR Inc.", "support_website_url": null, "website_url": "https://www.gigxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9252101211548761"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "662312022857444"}]}, "baseline_offer": {"id": "662312022857444"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741099980, "status": "PUBLISHED", "id": "662312022857444"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29076054762060112", "version": "3.2.6.0"}, "id": "1753892325453078", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8798570513568502", "is_concept": false, "latest_released_binary":
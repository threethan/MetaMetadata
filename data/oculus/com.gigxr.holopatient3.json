hot 2.png", "id": "616853747627673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393450_616853750961006_630790251095139589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVG1udZwIxoQ7kNvwEZ4pVi&_nc_oc=AdmCJRxSCas5cj_7gptFUpjEXqmpClcPEJg_ecAt7CcrnB_xhmZ2ueq4UwySat9mKrc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyj8HQCbrAUmLXkvf2idZ3cFg_LTdCdIjZVVvtJY1pbTw&oe=69BD4928"}, {"file_name": "hp quest screenshot 4.png", "id": "555970304155823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_555970307489156_381890560387641015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK_mYDbu8fYQ7kNvwFF_IS3&_nc_oc=AdlniArNB2nOabuKRWhAYWjl8jKWd1SUO42_V62rf_d8Iz1rmmKaN-AqVhwGvlp8SUM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFsTEvgU10uXkFz4gQWijB2GP11qL1IhDnv0gXb7HJ0g&oe=69BD4FA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloPatient", "keywords": ["education", "medical", "healthcare", "training", "simulation"], "long_description": "HoloPatient uses Mixed Reality Capture to deliver holographic video of real standardised patients to you and your students in the setting of your choosing. Built with and fully ratified by international healthcare simulation experts, HoloPatient provides true-to-life patient performances along with the pedagogical flexibility to meet your specific teaching and learning needs.  \n\nThese apps require a subscription from GIGXR. We can work with you on a full purchase or trial licence for a limited period of two weeks. We understand that each of our customers has different requirements and so pricing will be discussed once we understand your goals and context. Please get in touch with our sales team on sales@gigxr.com", "short_description": "HoloPatient is a patient simulation application."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gigxr.com/privacy/", "developer_terms_of_service_url": "https://www.gigxr.com/terms/
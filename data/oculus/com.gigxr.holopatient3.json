hot 2.png", "id": "616853747627673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_616853750961006_630790251095139589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcxisr0PkTQQ7kNvwGPKoWq&_nc_oc=AdlzFaBhm1kp0gZVo2blgcz3xguLtqoO13JkbR3peuasJ-ZCfkuRdIjS7gFdt2P08w4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYHUdXhaoge6Y2E5ZKNFtGZG6bY6zm3VEE5cthGW5Ozg&oe=69AD7728"}, {"file_name": "hp quest screenshot 4.png", "id": "555970304155823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_555970307489156_381890560387641015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GynypxmJjeMQ7kNvwFpu5vk&_nc_oc=AdlIqg0tD1AedVcF_ZjzKlBqY0lQh1uxosgJPb5AT_jmeMMumHiMOh1-58sVJ7CVxi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVACb8OjcT9uT5KeJoyWgIkItKtRjLtzTWymmecPgI8A&oe=69AD7DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloPatient", "keywords": ["education", "medical", "healthcare", "training", "simulation"], "long_description": "HoloPatient uses Mixed Reality Capture to deliver holographic video of real standardised patients to you and your students in the setting of your choosing. Built with and fully ratified by international healthcare simulation experts, HoloPatient provides true-to-life patient performances along with the pedagogical flexibility to meet your specific teaching and learning needs.  \n\nThese apps require a subscription from GIGXR. We can work with you on a full purchase or trial licence for a limited period of two weeks. We understand that each of our customers has different requirements and so pricing will be discussed once we understand your goals and context. Please get in touch with our sales team on sales@gigxr.com", "short_description": "HoloPatient is a patient simulation application."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gigxr.com/privacy/", "developer_terms_of_service_url": "https://www.gigxr.com/terms/
c=AdpM_EdY12X35JAWontyay7K5jzJN8NGHM-ffy4MECYd_fRGH-fnmw_PSrCcEhpT9ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtLaGUzoM_-7l_z8r71Uv46boQfOfa0Nhigh_xzcF-5Q&oe=6AA6A26B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPSOameXuhEQ7kNvwE7CE8w&_nc_oc=AdoHP4moO93FLxpzkQsPdK3LwMZm5FBavOhDkhZF4GIDRGqLyYbNym478xIn-5uZy00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsEiqlutVeTpY3aG2d-X3grqsr_L-ojlPFKx_9zpQ9fg&oe=6AA699F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Tx4YdSkbG4Q7kNvwF1GLOh&_nc_oc=Ado_m9j0swlQ0Z_hH0ipYhvApreHwG8AwiSAGsCMVuJ_oKB9ls8-rBpVMevDEEreA3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2oFs8EN45qvyOrFm3xOPh7C8XUeeGH2DLer_vZhGLKw&oe=6AA6C9DC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQrsJO1e2oAQ7kNvwFiCrDO&_nc_oc=AdqnYaZa2xHUETkK7VCyoaVu-0YXfxl0qnjxlwFl07qEr6eocp8w6_U9KBAQI1UzfHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx5lrokbkN5-vQ12OkFlzx65I6WuSS0iAl_iJ1tRB09w&oe=6AA6C729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ECk81u5mc8Q7kNvwHtHR-Q&_nc_oc=Adp2-MrqwbYxqSgg-n3KtYaZDsUz5U2rztdYKhGLFglA9ZukumQgy1-OpOZugQfTvmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBuTDflqLuktZ-n45y_VcgCUMo7euT3Ph9wLzjjoYSBg&oe=6AA6B10D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
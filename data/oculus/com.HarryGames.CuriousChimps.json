c=Adqw1f4sHpR3wrbvMbM_mFH6bqY5f-iW2MTKuxrfWmO9zSIVHWcD3OOZX5euebwSSGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzhlQMqYdBbPzm55jNLZ-1-HMZmijPN6qOS40vG6_I5w&oe=6AAD39EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zArogbSyBqUQ7kNvwHHmXoW&_nc_oc=AdpWiXiwLgu4KKoh8Jz_fom4tfn8BqUMu5dvYv0guRPXcf62uiVHqDEbVtVfEWFUk44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV8WS8Mgr-RzXKS4FwUabKTN5XE_bVs4eXpde2eGkfgQ&oe=6AAD3179"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr-xmcii2F4Q7kNvwGWESEA&_nc_oc=AdosH6fxAuMyCSTG4lLTawbsAKUbLEAwG-MRtFMw1s1om9Zn3kOo1Rlfyb4l7riNtLY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN5G4O7Av9XrQBaPejnXNk524L0taC_bguzqKZIFTnHA&oe=6AAD615C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Puw09RG675IQ7kNvwGbi41b&_nc_oc=Ado7vpW9J98HSz6rbsMypuSm8WsswVT_smloRx9tYuIlZ1Ah0leI-XmUiaEOLETGvf0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDurbsl_VoX7IlMF7kVeoye4WQC7yx3eY2RfxS8b3tMw&oe=6AAD5EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zGScC3UC9EQ7kNvwFjEnLo&_nc_oc=Adoyh2bQhoGUmfGzHHx4AHRRuQH0Aw1dfvreCnDpI_IuJn2F2NbQCEXeRi_jmQCNv9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo9c-MPkLh4fWF_MNT9Lj6gCGOgjDkiXMfCRlC3BJH3Q&oe=6AAD488D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
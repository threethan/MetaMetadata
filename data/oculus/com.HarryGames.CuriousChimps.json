d": "2424966294324930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5jX1APy2WAQ7kNvwH9_TZK&_nc_oc=AdpEMjjxVF2jl1gipZ7TO68EfsWcoczgSM8BVEkpJychh__VcCISRBvkX0fiIxFIvUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUX7m6Z9fSx3waI2Unj29Qef8u2deE2ExYPwuYHYkH0A&oe=6B0323AB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhE6mOYzp0EQ7kNvwH81N2r&_nc_oc=AdqXHMRY37gLJk2Ei1213gna4rOudgKOnQ_3dPlRTBcbKtMM9ZixSTiWLbW9DMwwcDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS55QZcwKN_UpE2c9Dxyo_m78U62FbewrlHYUtt3C1zbw&oe=6B031B39"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ae9eqFYlXIQ7kNvwHlvEvR&_nc_oc=Adqld7rN30hUcTn44Tv8t1W1UY54G-HGd1YAHpzcO3dZFcRBkezrVaxrXYLIGv-WWyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNh9PCQvgBuPics5qABiPVK5uLL-Czxynoli-jPsFieA&oe=6B0312DC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mgGgpqpM3wQ7kNvwE_7m2U&_nc_oc=Adp-bX2FaRhVbB1dshUA8GjG6gvzv995jY4dxA0wvOGTgbPM6q61iOKpq58OHssu9v8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSshi2IbKXFIgu1_Pdi1-0WaMCPxHvbiZjNlEOkhIrJDA&oe=6B031029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAnnpIKYwm0Q7kNvwE_NuGN&_nc_oc=AdrPK3h3vtGz42BjBMNYFH8hRhdXFF5vcOUoEruoPDSnaeMmTd6Ny9wPCtpJvr0G3eQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAw5xV0rKpUH8abDPBKnhfO1Bh-EFD0uK5gfBUvuQTLA&oe=6B03324D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
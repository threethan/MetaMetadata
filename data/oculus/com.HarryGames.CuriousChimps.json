c=AdqoQFfQWe42KHkd2nnJH2c7WMsJLkxZEKZ8gkEeFb3XuT1iD11hNOJ_dNw0-KK-Szk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13OtAVTaJ6e4FgA0ayPNRlq0cPJH7AEjuaj8dCh7CYGQ&oe=69EF61EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1dPAXdibx4Q7kNvwFbu1dE&_nc_oc=AdrKBnp89BJUFWa3aQzOkZzhNBkQn1-1pAsNiQdOe8HdkSfy7fQUZBvuqaZxqn5liZo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l5x1X7DBHhiUtriAGa11yjgcyybT2l7lSOzifBEJRow&oe=69EF5979"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JACsqXtYM-oQ7kNvwHXNupl&_nc_oc=AdobhOO1ZsFqdyrrBAxuA5pt-mNYDUqHJ4cWa-PzZRM424B-lgiVZWCb0CGx9cf_-kw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Hl9GrvELsxIfsVnu2vDjxkda4TMPOZuZb9hJZkcngUw&oe=69EF511C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3QYzq_dAU8Q7kNvwG6OK06&_nc_oc=AdrnZeJTBfQXPa77b70jiM27A78JZHcW514agSuxes24CQc544czaXPGZy1iFyUHirg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q8WaCR3uUpd8gg6245wIj0dO9LHfBVZSi3mTvaV6PeA&oe=69EF4E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEaE_p3VhskQ7kNvwFZmuhO&_nc_oc=AdqYTYx2yUOMRJpjC8iAl-Em5VPUJjhTsdiTwSO5mgfCg-ij1PsENNw3rgUEPlk4l2g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fLG91fcyFjX38Wmjlsyz7A5BFOWvsW6rBIikjSdfZtA&oe=69EF708D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
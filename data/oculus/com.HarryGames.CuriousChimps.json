c=AdoVGMGuoBoO6RBYXKWpGNkmmFuhPIjHlPLprNtHrgn9jWMURuSg5mI3w91Nk2jrZOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn85luUtS23sM1CyJ8AVueVRSdKgaBGaENrU0AiiXX7Q&oe=6AE498EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQGsr7DPDkgQ7kNvwGwflNJ&_nc_oc=AdqEYWmG4qn91x6PF13aVGHTNgtlNgdeLTckON7EMfPr1YW8asz-g71S_aC4e7yeLys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOez1ORwyhqA8C-F1Zb27a6e1KRAYE6YuaqsncxOa5XSg&oe=6AE49079"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMTheeamubMQ7kNvwGqa35O&_nc_oc=Adop9VzYleWBKjxnikz81JPpBazV7u6y6LldcDZxOxMguch5fDXELbxx_cLjeWlThuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5LReCRrIaQ-7KHmw4u0-OCvjOsue8rQI5clVFOvGHmA&oe=6AE4881C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBlxINLphCYQ7kNvwHWjdS5&_nc_oc=Adrcma9T9xVxtO7xchuvSc_vbbLjz70_XolkMvQa_uJDPtmVn4uRHWriF4dDyBqZksA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZZIJmYdznL-CAf-jY46eUBZSDYOjTA6iTAaluMvS9hw&oe=6AE4BDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knjz2mLrdGIQ7kNvwHblb4K&_nc_oc=AdqUU5AEg-BRjm_SdUEn6m7OhonsPIIIyH2yTG6RFELabJB_hapXgcIaqF3KBQ5Velw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoj_Eb4X9o2uER7CTaZr3KJmTK1mZRUGPqiScpNjcjeQ&oe=6AE4A78D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
MkmVfXp4zPUBlqJdoaeMBVU7GfCZqHn-8ND4A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4lYmGgd9bLZbrxTUOHtHmVIywse422rwjqm6y-SlpmQ&oe=69C13D6B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGMMGi5yfukQ7kNvwHxSVdc&_nc_oc=AdozLVRBRogkUoBNLmepz7L_lnuL5ANdVWyHF7rMr25MPXzhSuMUSOVnh2nPCxvl8E8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4WiIDbSUyYP5Ilm0_bE0YvF8TKkQr0XbNYjH85fwn7g&oe=69C134F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR2xtNWxFh0Q7kNvwHR9Csp&_nc_oc=AdrLIThMN2cBRAynFoAxjDjs4qtb9RNQdzbpXVCO0ckcwIVl3r7Y0env0y7bsrSzW-w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJycoDC7nD152x1cO1uom16x0RplTOo6_VvNGc6SgEXA&oe=69C12C9C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrwXCkFiZ7QQ7kNvwGipAJu&_nc_oc=Adpe0lt_EBFGHZNFfWBoq1MIwR4__LiBVgm29MAhL6VrWZ8n45AwxEA9QJOcpAAzsME&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDqDwExi-d0SHyRzni8WcJ1VXiwUPrZVxh-_Cl8UZamw&oe=69C129E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iocRFZCwvNUQ7kNvwF63tLg&_nc_oc=AdqDty7iTFqGjW6qgZtVX72oBAOOmUNlGV5lyptRflamhsRihK1uWKofw8KyTivkkHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1x-jBUL3n1ZZ7d4MWkpKfHqFXqs6zSXwjUy5-mXenjA&oe=69C14C0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "75196923
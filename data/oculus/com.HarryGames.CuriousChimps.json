4&_nc_oc=AdppVctYKyS_JX3-APksXrvNVX4b3HVb5IOpZQRxTDkuykSHeKdiIBk4xCB3miHEH4A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BOvDrJe6ExfbITlCE2_8h5tjUtVOPAu04PsUhDFXN1A&oe=6A3692EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7V2aAy3h7MQ7kNvwFxfXCY&_nc_oc=AdowW3CuVNcK_6E5ovlBHXKAVAl0fDps1MmL7tdPjExMCUJgeaneMb1mtpSYWrqTGPc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P9EbgWmY_Hds654XgRsYOlmSwXYwUXG6VUKLlsoVWpQ&oe=6A36C2B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID4_hhvg75MQ7kNvwEW_IE7&_nc_oc=AdqwFtNagZXldYT-1HSsp_AL0P0he0EzHAfPh8SbIf7xuX_vm1lZP2tI0nq8WRBpToc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KY77Q_Axh6UexdFkKlsK6kLh8vf5orUQcJODBKOC3QQ&oe=6A36BA5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPkZopWmcesQ7kNvwEjYZm5&_nc_oc=AdoFFlQzj8-1G4olwsdmmD4fwGayimxIDxYOr3R8hpSBhxXet7-KG88f85wcALnBfG0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qqSV9cWrpsdlw1dglufmiI4lR1EJXIISoCu4oz-31PQ&oe=6A36B7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CbTbtgKAJMQ7kNvwGKw0f_&_nc_oc=AdqJFuDDqUWHi9VQp1NNmOZRMGjPAJgaBUmorM1lNXAbDcL1Eeu2oMtL5dL0NXZwMiY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YigrGy8kRWKtVO0iJZf2_nNfsQC7EW8D99JCJUvuSxQ&oe=6A36A18D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
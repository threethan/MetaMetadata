uluscdn.com&oh=00_Afv3gtM3XpV1eAmpJHDqPByv_bq5a9Cpn2EpjHtTabuvOw&oe=69A58DEB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSUliMWv0KUQ7kNvwHJIpht&_nc_oc=AdlGnVH6HUycTkLAUNMJ6csNWq__phE1YDAa7mZ7xr2Wx_9Omvpc_8pymIwsXTc4rLA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuAEYml13q8PCrGH4twSxuxlxLyEB-5nUrDSBLTUsrtTQ&oe=69A58579"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2nrTRebkyQQ7kNvwHPBB79&_nc_oc=AdlV7iXaCxinVHj7HISAL4QG-jEsmRI78pLy2dyE-PDJxK-dP969Xm86AZL3cZYrGpo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvfTMY3-Uj2CjTdcy6CUKLdOpURt99EdJ0jnYmKp4Metg&oe=69A57D1C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqMAnivaRMIQ7kNvwFgmzPc&_nc_oc=AdkHTUe_QwUKhMUCDHUNEJwrRAv6BSNLgEtkxX02q6Vzy_8JtPGe7vFzgOdFEzfqZKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsazcMqVqnbSNpNzgn6nzqNIqhbD9G0h_EsGVJ4eNo3cg&oe=69A57A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXXIJtGjI-EQ7kNvwFv2NbH&_nc_oc=AdkASm0izWMnbMUtCnj_WSep9sp3w_mqePGuRePnjPgiFNYh3mtSMtsimgnU80MN_2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft0kKKDfE3073R63YF9iYkWGDunAZ_Zp9ViO7EYusuoKg&oe=69A59C8D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "751969239978747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-
c=Adrh_EGYytyf4jGDCoT_xT8xWcq3dZYmU2Bby7vVCW9wvi9ETiZW5KlprdNRcBpwLro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMru9hDXAqo5RmhOz1KbmiMJcNo3AZqgJXNll4Pv1yhA&oe=6AAFDCEB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9njqkq6p7kQ7kNvwFU9YgF&_nc_oc=AdrYbCPMrtBJic7s5Vo3RJYraoLFdaWceAKOvW3IOozewUFBIshjCpADCsGV3uvnNus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNkaBDJSuFBkF9H5x81OZuYkfkMfzMI5lcbYT4m_01tg&oe=6AAFD479"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr-xmcii2F4Q7kNvwGSVJ30&_nc_oc=AdpSWTHMLY4SrqJowtfB9FV6wUfuwgQzGQ_yIINVTlnPN448fMZWPdL_-saJ80KAvUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdxuDovtnpflFPmAlhdyNAA3nHNBQFX0uI_04C-NFRkA&oe=6AB0045C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Puw09RG675IQ7kNvwF0KcFO&_nc_oc=AdrMA99JOAUTikE5Z67baKFn3AYAgonnUO2bfPbpoJ2w3pAww0KsXznGnQC1R-fMKwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIudN9u6R9793mOHV8NuOI1qFlJKMrPVcO4MBPpxMmZrw&oe=6AB001A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7OuIM3ujhAQ7kNvwFoyr4u&_nc_oc=AdqdAi6hb9EBeL2Y-2_undaO6bsNNstKUosdh_8j8VQPYDX9rqeb_QKQSYbKq-fg5KI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUZ242aTDi9mE1VuFuAXwHD5JnKBdkNUpScOEDfSUPug&oe=6AAFEB8D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
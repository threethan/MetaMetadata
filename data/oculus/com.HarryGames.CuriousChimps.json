c=Adri6DRgBq6g11gtdrV5rP79I4FgcHaLtygvNgDIUBLJFCYU2IDxRzY-LsyzW41Y3RY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB08QsbTDPHiwWHouEU-1D6-4STDcsjmeYAp4kb6_6Ig&oe=6AABE86B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zArogbSyBqUQ7kNvwG7j4Er&_nc_oc=Adqe9LZ6nlDqfiosVUZvTAYCmSa0tB84KwnQ87dMJn_cjHuvjtjqavmxLri3zsUxtJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImGKU0uBZDGizsF3HMkE8A9692yWu3op15i1Y2ovT4Nw&oe=6AABDFF9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28CX63E-KGUQ7kNvwGRRn1e&_nc_oc=AdpbSu5uMTuTcIsECS7OZ3YBuvZKmX_gMTYA2ZTGwnRwngn-pv52nc27_PoYg5anfbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKXXKGPwDYmDVdXJniEedwIHw24KuH9Kp8ceRBlrEpbQ&oe=6AAC0FDC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8qnHHzN6jUQ7kNvwE8h_Au&_nc_oc=Ado1Ms1jxFNd9Puk9TBGT3ASP3NjYTa2EKQ17eg84TkZ1FKWNGtPfBtTME7HFggqQ-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq4R0TNHnlhTZwoPAmFHulQU3nhpsdKIt-9N11dYog_w&oe=6AAC0D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zGScC3UC9EQ7kNvwEP0EeJ&_nc_oc=Adory1jKxd5nQqUDJG5VAthMLrul2AiOzg-vo2KaDRKJkTIv85CY7JTMYRkasrwfEfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMQXWTtV0wXjd1OjGonMocdJ5fyom5NwPRg8v20PfxQQ&oe=6AABF70D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
bzJ4lhLBj1G_2pp_J1I7Ioz4pMSAciNF7TYWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjKla_POXhAlPy8pmLUgf5WJteZva8GBYYVw5eTGeFYA&oe=69B2BCEB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LebSw70Plz8Q7kNvwFefDZ2&_nc_oc=Adnzdi7_MI2480hdRWAmQVrpjLnr5Ji1Uv8xlwz2lkBwTCP4MmQzvo1eRmFLz90qoTM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyd5oFxtBDegfU52i1XYQxDnHBG9ajbtJWwdS5PMkZEhQ&oe=69B2B479"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx87ms6T9QgQ7kNvwEJ2l23&_nc_oc=AdngNT10RaVcppQzTQFAp7sS3G_ccA1SsNw6C76wysE3cCTzQh32cIyzI3aKesyBAXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyxmq8D3lGEpEVHu2fNJV2_5qBTpxlVSZ5oBljgsJCS3w&oe=69B2AC1C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=833d_CMwOowQ7kNvwFAg7q6&_nc_oc=Adnbd_-E_5dBVjHHU3Z_-k1OPRz6OUzurm1NBDuol2P6ycuib8LVeK8jLu-oFwhCodI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYz2ntM9IgZniOtTRR7nvt0S39Wnn3L0YmWBUTYSNjHA&oe=69B2A969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_Jc7gglh64Q7kNvwHp4YBk&_nc_oc=AdkhgudWeUmgkpZRP9KZR1caXIDl_qY-PMWiN2nMZFd6Wr8HPzdCamak5U_B3RDffts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3TpU1xjb8I_RZ0JkhbaIEt7VsC31ePjqJmT6VythX5A&oe=69B2CB8D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "75196923
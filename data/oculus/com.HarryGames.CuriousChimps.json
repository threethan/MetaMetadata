c=Adp5Jft_rFHd1ET0-ZxRkbjjRgx1TXt9wyvuSz9W5OLddMZmI2ctLIo0Hg-M4zVaGfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JOFBAJdgzhYLVy8p0ZmGyx0NP3nC8WJVLOid3-ADOIw&oe=69D260EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiVw9GC7biQQ7kNvwEltd_a&_nc_oc=Adp82QVjOgvvantLlKsc9aiGqYfWlR0YzCPhnP9UvSGENYcEVYfQZu6zY8sRgfnOWog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H2Re-C7otQRJg8r1MQnrqJDterkjATV1KFBVR_DbfBg&oe=69D25879"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG7UW9MCqXMQ7kNvwEnPOJr&_nc_oc=AdrGOkyDg5n4NXD-icCyCRU4Ma0WKguxerHfzbZ78GGMetc1apVtIKIq4clyJCoZOfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x_4CCKqxtwvJeVq4q6BYJZ9i-OIbNm1Y5MhbQAk4LzQ&oe=69D2501C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzsNnTk8WpMQ7kNvwEAcsPw&_nc_oc=AdpOVh-s6nN4bYES62F1ynSmfqDESV089OQgOxIXyW0hOCQhxhqT99Ss4HOGaZe3zgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3etkuV1tTeEE6UhubigdK7dwrrls_YakadFwwURX7K_g&oe=69D24D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rahwbuMma1sQ7kNvwGNN8zC&_nc_oc=AdrbKBnOjxGvsWnpkoTyHmhkYFh11peL5AuP4nVNc29-pIKaPG35wJdsPWyzlBS-lpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06y08iXYPOaVb1VAzPYGYfLmZSv0u2WT1gsc4-dopAjg&oe=69D26F8D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
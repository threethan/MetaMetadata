ar96O58O6pa_0hkgOF3L9lK6rZAkE_JqM1b8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpp0hvw804vrvzhWByvh3KHCP2QyCtSCYtnS6f9dp7Eg&oe=69B16B6B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LebSw70Plz8Q7kNvwFyXaPD&_nc_oc=AdnkwxdT9XhuyltOOwjMXRJX4I7Fg0IWXSbazzj-TS2kGpi2erLhdoyTvBUiUU7QcUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKWmX1llj91mYIeAJCtY0WfoV5KpmbJrprP8aJDYLTCg&oe=69B162F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx87ms6T9QgQ7kNvwET7rAU&_nc_oc=Adn3sgoiBMD2Vg_1W3y5MVYQAnQkR0MiHlH2a9nC6-sNpiDxL-PDdv1TThazAJehluE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEDNk2lrTFeZYGlrQdUlgrfRKyavdO1IcUIfNra-pc0w&oe=69B15A9C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=833d_CMwOowQ7kNvwH0JGHx&_nc_oc=Adl3ZIOTpPUfYxR97ZwkXms9-_HaKrwZfbTDNGw4ArdKk8ZSY-GeSJEFyxoRn3q8ZiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKtUdnZUT0gwW9XY4ag5ACIYekdel2DCxshAgBxeJSZw&oe=69B157E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_Jc7gglh64Q7kNvwFqUdcu&_nc_oc=AdkTelxicQRoUr83NueyMkl_jNln6F32PYwOIjNWeCqLu_AFTGCgIjOpDz9SmatsBeI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9QjYE-Owu-Bzm97Rcbk7ZRYuQ57QfFJWcCot2CgiwTQ&oe=69B17A0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "75196923
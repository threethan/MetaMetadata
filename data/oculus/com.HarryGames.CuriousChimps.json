15To564ZAycXdgZsRuo7e1OXKNYIouuzchN70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2GgbuGKw3-6gITIhe2liIV2GZlf55y_KZiaoiWfeqdQ&oe=69B802EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk64FAxy9jsQ7kNvwEGgThE&_nc_oc=AdnyUiQ0kyF8vGbYwAZitbpzFuMT0-c9tRcTCMZpofNLZlAAT3KilbzKw2EhSyKAjHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzjx8YZdu8YfvTlbvqUU3f3mZp4j_I-bVI6K2C0knBN1w&oe=69B7FA79"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1Nuvaxk-xwQ7kNvwG2ckvu&_nc_oc=Adm_ri-48hxgu4O6b7QsdSi9sMo0G6ELAwHBEefLm3FKaYIUMBCoZyw_H6LN8R9NZVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxn89YKZf4Km_0plYP4xy0z7o1Sl8PwY6MpeDZ0-QvsXg&oe=69B7F21C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD5CqskNqSYQ7kNvwHU1Mnu&_nc_oc=Adlfa0FbA9ZW-DDpKn_6mLYqFl57x6J7TWEvYq8dgztYe-nJlfNGVyudWRi4B5LNJE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeQNuLUw6iHHokCsjajLHFTE4nv3T0j37eHc4fmCb4eA&oe=69B7EF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLp6kPNWeAQQ7kNvwHo6rrM&_nc_oc=AdmSZVPV6bYnJwDmPROEAwVSTvg-z2heMH6Mj6oSKNSd0mY34GlLQjtWkAPUHuuNuZY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdyyyKw7ZgHnj8E4x7Xpa-ZPlgNju7kFwKRe5sPGTPUA&oe=69B8118D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "75196923
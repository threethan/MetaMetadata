c=AdrFWz1tiObyhTM2AOd1KCNXmHU3Uz6nL0rQidE8mF4Qn1B2UI7RB7x4i5tOUL0Mk3I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn-HqbhlihfRlb_6Q0DMECCkRnIv2ElrDAqpQiK-kNrQ&oe=6AC797EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAKCXDQOMq0Q7kNvwEF2tGu&_nc_oc=AdokU4oE5OIHMx9QE8GjQ3j9OpKSi-HyXR3FiS4nHy5hTAqmyJMRH2L14UCqcgllJCg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2furHaE65RVODat2U5h7cJwDdT6dRQDMUW5r4vpeJnw&oe=6AC7C7B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x234L-VgwE8Q7kNvwETAgIq&_nc_oc=Adp5nyU-NrCIYkOtA1XPQrzu2VUGzfHZjDnXek5s1E4yAAoVHg7-ZmcPESP8zTqX_CY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW6E0q_d1BXB-S7qmfwP7pnn1qcya9BCLEg5B6JXEYzQ&oe=6AC7BF5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmlHneVu5EkQ7kNvwGHkO9d&_nc_oc=AdpD7x0t8Yp1R1kazmFcYB0xOxfM7UVoVKGmtg2aAb_33L6NtvTHBJ9_-alKlRESM_U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp7ReS7-L9pfn3g46TGZ2bY_YmWw6gjlPsz_mbLFH9pw&oe=6AC7BCA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBInrsOyFd8Q7kNvwFwIacP&_nc_oc=Adp13cRii_EYtfTlmWTapFvOyITrd3Xqzw9vP-35ImuQ41eXAMdOCPHFOIilHL-5JOM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8gvHGvZxbpVyR6mLBzxlI_KObNUFUjKrwgR8XqXzr9g&oe=6AC7A68D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
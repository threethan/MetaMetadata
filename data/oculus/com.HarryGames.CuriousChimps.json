d": "2424966294324930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMCpF4gXjQQQ7kNvwEjNyhu&_nc_oc=Adr7d0q2u86Et7BYFeXBio78it-fBGsNxq6KFhIzmpl-eE0rVLT9e3qOGh2skNnFUdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCZzZurBAYvWi5XrcVGym3GJ1u6xX1_NZwxNQ1-tko-g&oe=6B0F012B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YP6SDd-QZAQ7kNvwHVVtXd&_nc_oc=AdqIZmKPIj_h8kTgrJjoqiXBf_Jf-THggdbaqdsiQDkIMEGp9CHM1bOhqMs3WizXTwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4JODcf4QGpyVTdmSXEglyHxVemh4oVFRQx_-pw-Anww&oe=6B0EF8B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkfyXHnd5eQQ7kNvwHdN0cO&_nc_oc=AdoscDSAKOcoCoHi2D2R6wINovg9apgulyecFOBM5l3oGmBz5fvp7Xk1hCUrEwliAQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7UbLdU95rRQz9H8_dFKQZIMVwjraZNN0MUZbpshMLEA&oe=6B0EF05C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdC1iLU7SeMQ7kNvwGqdkOR&_nc_oc=Adocc797LBnAlbIIvXf3Qo4YKG0xv-LY6b-tIJhacyQioDJ7CccQhwF1pLtuogK2hcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2mAQFKdgQtn-qSqE-wVdLEDXG-0qs6bLfLdhZFpj_Iw&oe=6B0EEDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MSmH-tbcB4Q7kNvwHiVqWS&_nc_oc=AdrZkeyoYtQVuEhm0VTj4ITrjJlCnlyTv7GBspXSKnmUtBiKTHulHjaAZhuGMXl5bgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkWzpD6Cggbviy7l8MxihKy_aBCbSnBpaXDnUCkcFcSA&oe=6B0F0FCD"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
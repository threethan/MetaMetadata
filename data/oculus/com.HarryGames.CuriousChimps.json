&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQo6FU3ngAPek6hsclMCP8sGOslpuhQVeyog1r8QNYnFw&oe=6B0C5E2B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stOKkaJzFAAQ7kNvwFXBItZ&_nc_oc=AdqWe-ZMHT28TMzBHqyP3wgI3XapiYopQ5RHhLdyo1Hw5Hbz2ZlcpsSP9nUPDA-yRuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBHmefZg5B-eexWeq8I4PhzMj4ICtsaSZVjoDSJl1FOA&oe=6B0C55B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkfyXHnd5eQQ7kNvwGlyvzN&_nc_oc=AdoxX1DAM7VMNX54vDZ6M3o0iKmCIW9l0R51TvmbQdS2pxkgu0DnC_Rc1YeleB_Ut1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT068_vUHcYwn5vFvm2yOjzKBKeYt3QSysFCmw0L_TONQ&oe=6B0C4D5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdC1iLU7SeMQ7kNvwFhXu1s&_nc_oc=Adr7wBhR_4bbNkkoOicvqDDs4mx6pGCgtxD8Re_3KPT7zVM-lug44MnVkn5tkDIG2hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8G054NTPjHYKJQHDAG-2LUMC_N2IxHXDFMURSqgo_iw&oe=6B0C4AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kzc_84y3EoQ7kNvwG2qtwE&_nc_oc=AdrnWV-JsSuHGYewvA3tC5zOWfiy_Tgo1zpK7cowT94oSP8b0kV2vK6j4tvEOupzv9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwF5I0Ac_EBkE-gMixmcgoLVAiOaY_rrEhb-ni7CXe6w&oe=6B0C6CCD"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_
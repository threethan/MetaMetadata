ent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af354i1rSFTA22GD3FiimtwjdvHYo0iMtKWyhU3j62mbzQ&oe=69F204EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Pq-uMEda7IQ7kNvwHn9xj8&_nc_oc=AdpJ4u7B7pRWCM7hRN_ky58ed3GAf1l1m667gh5clZe350h15nd0abdcP1uiR8Lu64Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0BYGU1avfh1tf6LZO4rWf7S4zD9Hwpp2N7AbEjBO22gg&oe=69F1FC79"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JACsqXtYM-oQ7kNvwEpXT5t&_nc_oc=AdpM4LP4e9qyU6OftM830eype6AsrRDr5j-EjMjzvWioPdqG1awQbmKAwZAJ4ewSzAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0d1R70EI4eDmgPEncwDK2NDMXMjgYilP3edKwnT_Q2LA&oe=69F1F41C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3QYzq_dAU8Q7kNvwHqWQF-&_nc_oc=AdqLkKPrVr4WzUKl00vnqU7aremLejLFYjjmTXuiRkMaFR9BTZL4BbxJoaT93pSIgM4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hv-BTRpDG20miWU6wZOxjQ0_M9fLwHq9SOlbjO7ZmSQ&oe=69F1F169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZRFtXBsq9EQ7kNvwGy0QTl&_nc_oc=Ado2dEyn9S31_QaQmmY2Yo2cVH1xVrMdW5Cf_kIlygTz3XFdfdapEqMj6fsnhnGCM9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BANg6U18M9GaeJEAyPyL8yR1fUkXorR0eXRQoImNQ2g&oe=69F2138D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "751969239978747"}, "review_messages": []}]}, "cover_square_image": {"uri"
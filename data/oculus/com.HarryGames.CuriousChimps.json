uluscdn.com&oh=00_Afu3ucQFEZU7a5HIDytqfkOqKPMdFJjES0e0HKzpsG7sDA&oe=699EF66B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZbN7dgci-cQ7kNvwFQExAE&_nc_oc=Adlf8cWpYZXfezlWvV5Cub1aCOGllPdwkuVW1wd0ylPKXNmuw1hqQjBlX-qE2jiM6io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvvTL0i9_1L_UGlT4KuqNO0mJaVfJlSV9xcQ4qhfxoVaA&oe=699EEDF9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zenS-YE9_40Q7kNvwEwql3c&_nc_oc=AdlLVvr0K1InQnmwey2c-ujoujiTz9xE45ZDUW9yxF33sNHceoXZXP4Ho9tlJe1Fufc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsDcwuVDw92B6meB7HnD4Z-sxipVx3pqgyO_my48YIWDg&oe=699EE59C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qFaRbqg6AUQ7kNvwEK6Vnr&_nc_oc=AdkJec8gvZPB57cKScme5sfKrWHgpkCZYxby6acyEevSbLoY3cghSIh15qayqXeyDcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfujcQaKikNzNrF1zFKKXZklBmzl-nR528VkXsroyQal8w&oe=699EE2E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdFzk9GzlbcQ7kNvwF5FesU&_nc_oc=AdmiGaNczCUe-oHraREo9oDk8JgrDU5bsSixnbh9nsLqc0T3yEYcLJuc6EZJbPqlVQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu2-FPXPo5i2l0ry2DmFR-QrCPVr98E7GXlASyi2fEalQ&oe=699F050D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "751969239978747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-
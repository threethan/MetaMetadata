&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqWZNeqjdIvhbgSx9EYnRH7NF5M5i81Pz6uCAZPHR-0g&oe=6AFF2F2B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu0Gs6g0IJQQ7kNvwE_MJ0i&_nc_oc=AdqQHomjtAtY3hx2ktzi0Yz1OG---vrjm2aAqr7GcBQAFkSr67PsnW8sPAtTXuvdZpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6zpa6LaS9a7Qkcz12_Il2z9G9MN89b562Jri3rzHdBg&oe=6AFF26B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngJCRrnvYF0Q7kNvwGITj4U&_nc_oc=AdqctcYQcwsfJnCV5dhLykAua6m8X_KZNZ9V-J2iKpjK8qN1h9HOP-oqTaBv3zLkGhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHjFbYmxwqF9D4AEsbUu_te6t-NwIF25G0SI27OZrUUA&oe=6AFF1E5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBANZHrBnUwQ7kNvwHLVyck&_nc_oc=AdqKIg_hCamLj3YNR1DnqS0fLf0kobv0x3WaMZxLN_W3Kkm8O3SbmfbYNJOep9qgAeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7TMO7pMhnQJpI4Idiocm-2ZqTYulEdvcVagMnw3plUw&oe=6AFF1BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_nRpWVz1nwQ7kNvwEu4HGU&_nc_oc=AdrsKBwUOIT7SrGrbXiTgpShUk_kv7tEA86CFzgxm0fY8eds8t7BPEoqq2Qx4iRv8dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDvxX_qiiKMNWBLKrAXqmgtnJJk49_cDCkM46h4zBG_g&oe=6AFF058D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_
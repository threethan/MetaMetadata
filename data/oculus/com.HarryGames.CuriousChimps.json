d": "2424966294324930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpxOdGTTmi4Q7kNvwGS4Nza&_nc_oc=AdpvU4GU-kydCpoTdhCrsSrqwl28oQhapNBNyZH7uzk8yPz0ZhE4YiKz8zRYIVKItb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqN9gqwkVc1zy67rNz7bPWywlZtQ0s0kv5P0F3AMMW8w&oe=6B07182B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9ZvQVxWOEcQ7kNvwFkkQt7&_nc_oc=AdpynQ1bIjd2H2YlLKhLhC7gaux7RrHgcb9YQInojpMiZ4hmgMBz2t4M1UnJOktGCl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0vMpCQ9HRWlpAHZBYbXZxNzcG2caP0o1Ipqq_ZGyzow&oe=6B070FB9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWLh6j6sWe0Q7kNvwEYF964&_nc_oc=AdpVzOL8q0xp_f6TMVFvka4kPn1szenJx8Szf2-gFAt-_UzvgtqeiTY3xYT4Ay18bHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdJiBLCFOzBFiCxcuhtdXRll0LhqpBmNYKSPri6J1ZOw&oe=6B07075C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnY9CzLYiZYQ7kNvwHuH2KS&_nc_oc=AdoV1YC2UUTjZ1ei2c8a7tsexskhGm3F8Cy5DqsRnf4muuBp500_TQRiQDi64nSDbxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjzEamVR4vA7LGQj0bLBloMiaZrO9T2L6d2S-KqLlcOQ&oe=6B0704A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZLB_MdYGJ8Q7kNvwFvnFUZ&_nc_oc=AdoruQSTsywd8WFWAe0MA5aB7Iib434-FoYYgpBMuCgbtcvnsB_utpB-pKqogaXIbvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRthbyFcBvfzDkJyvV-uNwpLO1otXZM4e05pQhFhBzXCg&oe=6B0726CD"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
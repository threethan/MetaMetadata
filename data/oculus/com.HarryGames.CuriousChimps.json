c=AdqBHqjaZQPXMgDJgA9J8uCZpWvaHaVA9nkpuSbWX1jAcoK4OWwTT9kCPgYPNbMpdfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgean0ATaVrrP1yOaUMFT8guJVLnjAUNKYqlIs125lVg&oe=6ACE67AB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot03DqlpAN4Q7kNvwHzAhfH&_nc_oc=Adrg9w9-AAP-xcHlhDkacle0pCc_ajqsTeT6ZsK23rVYBHSd78VJ7UYeVWe1gGK-QaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcwoxNgBH0WFVtgopvUFD0XpqGGbv4tk8X_fbw5qRyqQ&oe=6ACE5F39"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfmEJ2RXBlIQ7kNvwFP9iEU&_nc_oc=AdoF2cTR8pYTej6i4S3YgU1OVr9NgvlbRNT9Lg9v0A9SLzbLdgIAyXcuNonABJen40M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT-_p_oZ0hqvcbG0tsP4RX7D2ptfy6zeKaO0oz3QeVnQ&oe=6ACE56DC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COdt3-1gI4AQ7kNvwEXHpbT&_nc_oc=AdqA8Ft8k-pROh2FlmZ7izF9Tdpxj2d13xR2JUnp_ykwGBpOqSD9G3IN5UC8rxD_fSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_596-JNh8oZ5KAlS5dxHfDHK4sA0Aw7fMrIzxGvHGoA&oe=6ACE5429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOeWtEBw9Y8Q7kNvwH7HAqm&_nc_oc=AdrX3OvE0y0DS-F6WrhLRAv8Ytcx1i1MZfPV-05bWo0w5A7afcJaGlyfVL5VIivh2Ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0SLbUPOChzh8I22Z4XVImTkT92wcVyRq1MZReQdjSxA&oe=6ACE3E0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
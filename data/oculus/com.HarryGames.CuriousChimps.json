Ae&_nc_oc=AdqiOsTEb_4rcnit0j8b0kqEQxmABSy0HkweLCHUuNlNrTDU6D9VUsKfGOuqBmv1Is8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN1Qqo0yWKzgQIhzS3z_aDg_U60ZHm-c7ln5lEc6S_sA&oe=6A8EE76B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOZvJWCnl8sQ7kNvwHReHwX&_nc_oc=AdpeyhD2u29_LpUYuNBE0VVhnsT1OJME5WVC3ifb-KR9rsBmz5hypeicQPX5EmRCUaE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl4E5J0oB2znLA6LRbYwYUNbltmLJIwnBc_J5vUOyfQQ&oe=6A8EDEF9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mED5pH7_fmYQ7kNvwG9_MTY&_nc_oc=AdpGLKyyJDjw3k0DIhrUk5l7W0o6Zh-yi8aNWGZDsH_62FA4X20N817712GKNF6HhLc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4sm90mX3TUhDoDcTokUgpy7YLPY6p_pRxzwVedn1Btg&oe=6A8ED69C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnWqWe5DsTcQ7kNvwHLwKXP&_nc_oc=AdoQLSEeoLZ1geBA__tkex1lFpI7XU5licsE3Uk_4Pk9wYl0TlIh-dakN4jJbpWOscU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC0wyEQ93KhOkAUHiAcngNwUZ6I9Io3koPak68_sSLOg&oe=6A8ED3E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9brncHVuNoQ7kNvwHc-OYH&_nc_oc=Adppkjx4BP3IlIwVxoNYtRukvBY1to5JZc154A3KbZVo1jjuFhxdYs_LobbVx8K6xNQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCABxoi9TOxgcE1beLJzjP6qqfJ9YAHIqpc8CXtUKraQ&oe=6A8EF60D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
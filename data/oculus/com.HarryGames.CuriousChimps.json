d": "2424966294324930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5jX1APy2WAQ7kNvwGk1L4g&_nc_oc=AdpNGRRbvpNeBUZi_qW1lTOxfkbL-KeO8rJF3ENnO44VXYMO_YAUlgM9tGx7PzSSkaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXSomJAKs8XoDpp38Qfr5Ne-1gPyqIQM5xcd8JNBPUig&oe=6B01D22B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhE6mOYzp0EQ7kNvwEPz7nX&_nc_oc=Ado8av26cP2WF7gYKOQx9MHsTdU6Fq48sA7iRHRIToF8E57jD93clNwNqZrGAGgFnGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhOe44Ai-qN5yQni3YYo_mIZzLPKkDrexjJivoRG2XXQ&oe=6B01C9B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ae9eqFYlXIQ7kNvwEnjH5I&_nc_oc=Adp3FWbBe8dPhGsT9-d2_2y3D1JaquXAX7rEMeFUbCjCJqMNZLv7Wdj3oZhpUuAS30s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQohf3qu9yP3Iybg9EvjadAX62WcFis1jc6VT0X-FmR2g&oe=6B01C15C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mgGgpqpM3wQ7kNvwEXw9J0&_nc_oc=AdrIoH_1nDxrkNNI4vY_kPo4PGOUoDOPS8PUigCfnvl3n0ntkyswEMZuKunZZNgtRgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUrNsvokfGg1qNql8khzt7KTtWlet0bXIAi5uHnVdYrw&oe=6B01BEA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAnnpIKYwm0Q7kNvwH5TQ7v&_nc_oc=AdrzJH7LA3VopcezN--0Upi7o1KE5Aog5WvFBpQldWWtZlm62qduoAenWUYzqd-xCJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHzXnrK72xni-FV6Q0SrCHPYm7suiTy05hm_lCSY5ISA&oe=6B01E0CD"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
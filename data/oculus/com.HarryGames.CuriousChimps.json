d": "2424966294324930", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFCWtRGhjaQQ7kNvwERjTcO&_nc_oc=AdpX-4syurRoFZJbokb3WXRl_p3YmDPB7SF16qprjRWIMo7PVmJYApveGg0EnAWRPUY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQplQx5-cQUJ7D6f2h3-b5LSxGxh1g_kUnsOMRCujlbig&oe=6B0B44EB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stOKkaJzFAAQ7kNvwEpcdE0&_nc_oc=AdqP1vIyKBp5Z3ojpX2To2Gmxne0w6948gkWkEWEaZVxe2ubkv6By-M7NsZxkcyePpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJ4WQkKiDqWbrcINYMEM2Ve8VNlD8Rppd8AF5SkMOwQA&oe=6B0B3C79"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2xvKBWjqosQ7kNvwGpTGEM&_nc_oc=Adpn0UZFgPkTq6mEVpQx4MyfTbS3ZM_zRA8up_jgVDL0agQzOR_JqYNoPHutC9K1RI4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHMEdloEMzp0BKu3jLm56G59f02N76ksVx4AUQos1FKQ&oe=6B0B341C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVqNdyB28oUQ7kNvwEpct0r&_nc_oc=AdqPkwlMHHPMrswCzk2PWSqO3NqDUWLNWaxEwbrpu1Fb9R6_nvBvybZg88sRrhVttxE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSztabOyytaPEwF4ZohCbeBdAtjkPekiuZfDxUiUjoGIQ&oe=6B0B3169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kzc_84y3EoQ7kNvwHLQHds&_nc_oc=AdrksTKm5BUslfXVO1jvXBmqQotj3QP06i2YoOojDBkSYhDLQen9FGwlVRbNi78LCs4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcNLcGXgxUvzCp6QUCVViR4_w7-37F0XPyA-oJSUfW8g&oe=6B0B1B4D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp9R_Kn-MPvK5qJKP67fp2mBAtqtBrNo18O6s6lK2xew&oe=6AFB3AAB"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mst5l2OzWIQ7kNvwGckfpa&_nc_oc=AdrsmDUWmtmXCIqa1hST2nWsBZNvvqBRdCaOcz9Uu37fZP_uLDX4jYZpNjHXeLJY9jg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkF0_8JLxkzS3E5HgZd3QrXe7O7FDxUCINqv5GY-TMrA&oe=6AFB3239"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94ghJkg_zMUQ7kNvwF2uxSI&_nc_oc=AdqF-M-eZI5E7NQb9DswsmRye4aghJBWmQwXltj1dHqulChXiei0nYF6QajtH3bF47I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvkqVkT6o3sw6UwEgVdZ3XPDM16RX_KjtLp9sKK3uTZQ&oe=6AFB29DC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gCWUcicjiUQ7kNvwF3-pnu&_nc_oc=Ado1gmZECC5ufB9gZTU5Og05mjm6Cz8yMRHIEKkvwpZ2yRzGQX9MnuE423XcUaAjuXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkrzAzlHPqyDWfml42i1iDV5kgC9QTDw51v47ZLYDtVQ&oe=6AFB2729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpoIFlNjuaYQ7kNvwE1lQuW&_nc_oc=Adr56UuNvRJbPTVe2ZRZPebwBjQUHCbchDE67lfk5HMLXr74cH2-ktJMSpUIhRJP1b8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrANIkjs3-sePMrM06BKThVYCkH45lXkaSJXE2OoSSSA&oe=6AFB494D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_
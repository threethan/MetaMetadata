d": "2424966294324930", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86872727_2424966297658263_8266824707558603585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PGuhrjvMuEQ7kNvwELSZ6b&_nc_oc=AdqxxiF9HBZsPJZqkXjKGSi-TQ_Qe-NZMkuX87maPaF3paY_wMwYGleW3bLWakSXKSc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHBAeRAKCshMPVT_6uqtMiK5zl7jNPPhfMa_eZtfz14g&oe=6AFC8C2B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mst5l2OzWIQ7kNvwH4Nrvq&_nc_oc=AdpqCu5TLZ59ShQRWFU_-IisDPr-ZK4L2J9WbpSLeeQtjGS0AUXOQ3X3MDOfePndT-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Lh2F1fWXoDT7QASkjjhXp4LxpzdWrPh5YyZXFOBDBA&oe=6AFC83B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngJCRrnvYF0Q7kNvwHCVJ0d&_nc_oc=Adq8g4Nzvt5-wIaYkplINTedkm-f3AWilPlf9_QGk7DXE6Jsu3oLv6Q-wOm8rFWnCH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJkz1Z1eN1KLjjHjfZLXQinxqTiK8dAM56OzZ-JtjjwQ&oe=6AFC7B5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBANZHrBnUwQ7kNvwGex961&_nc_oc=Adplr8MVYNMShl0oQJxNf6msTEGBjc_XkT0ZPeGSYIne116b-bAXlAnPLa8_ypWe6MU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqDLinCwc5Vk7VdVNGw4V8edNv_ijpANrIKWPvEZOAdg&oe=6AFC78A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpoIFlNjuaYQ7kNvwHJFN_d&_nc_oc=AdodAYtGX9_K1j_BQy1L0JAFld55dzRgmDNUxPzTSDoppu4fNNOeMj6b6f3pA0i-JKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHP_gA1yRn3WHFca4qV53sb-q4s-sRdsO9KznPs-we4Q&oe=6AFC628D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
c=AdpMKZudHSmBO4p9ZVEt0IidjNZq-nRGP5vocHXnfL16Le8Cz7YnUcHvJIQ5Ggc9yd0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSHzX4jHwtln6lXQ9aK5UUzK8gYDbj_XAVamgTCKxErA&oe=6A6CA06B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDfXpqp85IMQ7kNvwFfI98B&_nc_oc=Adq1cLodS6oQEOrmjZmd0xGJeGw6ZP7PG8rxg6qHXWgK_-ptbzOVQbpIiqSXdiiQ7Yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0hHOoVGAjAIZnzGO2jD97kKf4SMgi05S4_D_VCQlp7g&oe=6A6C97F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTbOwQTnwQkQ7kNvwFvaE2Z&_nc_oc=AdrF7ocTcvdqP7nqUpb6HriDhDRC8N8US2WT5y5v6YAkjGkQe_C9P4PpSS-YTcuHaD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcz9ZNEQoSmZ0zcikPs3EYYsy_Td6k9r1JsGs9DbuhNA&oe=6A6C8F9C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YUYqPdEDuoQ7kNvwFkdpsP&_nc_oc=AdpKFP5OdXFqXKTvjU-_XToBIsa2pPFaUTabUkdP603AABPglwISOESAMAHbZP5EZsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASmK4hnpm-duT-UIC6kD1iIhBIwfHY3NAIriyHvH6dIQ&oe=6A6C8CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCv2SBySotwQ7kNvwE5k1fD&_nc_oc=AdpoiRwI8pXCZdqh8ZUdkSOkbwpA_oXl2BO4HaShrGZSjsRVX65nxIu-ilioRHbrTNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfiMKXAEYqom5gwgO0kMdRv30G1XPOPWR2nqPijWDMHg&oe=6A6CAF0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
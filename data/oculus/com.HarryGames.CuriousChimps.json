2&_nc_oc=AdoKP_CYIIIhUw1WJp_qUG-AIeX6irQVGn8p-toV-T7QvoMoXZewPqXOxkZu42ZRnuk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PiaPpD70BDdRc4GBmCVwVKPEaXPRi_rI-v4HNuosQcQ&oe=6A22CC6B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5k9_hfCg50QQ7kNvwFkM0jN&_nc_oc=Ado1GZ6-2teLDusuOMhz2Q4Jv6juiDATovidnJSYx-eUMvRHOi4ycy0mQerE8TL2A4A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NqqXa4RkHIe1Dm83VmmT7zXSlqqlM_daIziWGE1Yx4A&oe=6A22FC39"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpPFHKjG8X4Q7kNvwETXHH2&_nc_oc=AdrdogxflufJPeNm3HIYjjk2H25MLjUhyTISul3vcdiTJPKfxnl6gb0KOBTNTNtpm5k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kqViflvKdt0eCj05nbf52yZcIm9JoNVOHAcDH_PcQ1Q&oe=6A22F3DC"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuKtt7gLIr0Q7kNvwFXZYMJ&_nc_oc=AdrX5T7XG0qXAvhH0yLWqbAgPUL2krhTiZD4lf_bE9g7TBeO1zwDQx0DjBUkmKU66Zg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xReO0iiSzhQ4vf9Baf0fw3PpE5B8BSI1ucS17lnO3mA&oe=6A22F129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LLytF5rRyIQ7kNvwEMiLb6&_nc_oc=Adr_O4Aop3iaYofZjeL2yplsvjotS910UEwwQwXpaF17OaD2QFSe4XNhE4laqyUvou0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LBA8-PW3IOC8scZwFsm9CjV1dxc3icBIu-qsk3jTwDg&oe=6A22DB0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
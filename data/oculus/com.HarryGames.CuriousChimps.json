eUxxd6xSwAfv3vJHDNzck8SVV4QLxrtq7j6sI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8PM81Gy_04Qbc9__UkT8cFiofSAtEyalTuhtXM5BYqQ&oe=69BE9A6B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzJCl8AjghUQ7kNvwHdIHfb&_nc_oc=AdmFQQcL8THNHpzuJGARKoTiCMKY0JJm5O8d4RsQ3Q5Mmokd_01IX2-JFq4eAJ1sUnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzg56VJznJX_qZEI0CpEJiyhFxFviJyJFaSrdbMDPlzQ&oe=69BE91F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrCS8h_-BCwQ7kNvwF8Lza8&_nc_oc=AdnwMNH4Vk--QQazbaZlIp2WndJiwPuI8jvszCSX3Ax-Nc06i0BaGI_EYgKFAXYq2nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3iJaCjLUK2x3z9cVJa7v_UgonCgowyD28daA7a-025w&oe=69BE899C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVfiHv_jIEQQ7kNvwF-vYtS&_nc_oc=Adl5RPjfqYVGT2fG-9p48u-qMzMz9lqeRjgWogKnEVKv9HGW4M84sz93xh40ipkrkFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoWpdTw9L7XYT8ZSGFOYiYhWTP6lbwYv0fplJCNXWwlA&oe=69BE86E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI5k7Z69ppEQ7kNvwH7qGNZ&_nc_oc=AdlSL-cFRO7PyuN1mVxcf0G_jwxrMelu2iQ2SZaaF-1YXnASGmHdXeNoYaO5U1gaKlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYA7OoF3eTQ3vPuv1xym47qSH7115yX9BvrQHSBqPuAg&oe=69BEA90D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "75196923
&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq-F6QzhpmFedXs5VT4aMmNkOcboLl-p0iHk4l0x2gCw&oe=6B09BB2B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stOKkaJzFAAQ7kNvwE5kRa8&_nc_oc=Adr6Ieo_yQdGbRNsnsehUj1GwdaoZkE6kpG4w6WsZy_n_XN3GCNEhBpRDgJauMbAobA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc5g1XodWCJJSdB_7MFTEDmtVho0V7Ryu60qCeDd1xbw&oe=6B09B2B9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2xvKBWjqosQ7kNvwH0r3A0&_nc_oc=AdoGkjuut4glaZcuShQ_3Dni5SaDzlFp2vfMHmKipcL2SGY2FlBi6Ag9ArVhIieEPIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5GO8ou-joB2Kd7BwiFQckncbnI295-nBa7lPCD3MJEA&oe=6B09AA5C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVqNdyB28oUQ7kNvwH3FjPW&_nc_oc=AdoICHZsvkCQ0BKmg2R4UBYGphi1mguS-oN4r9J2qxITZfR_044mIjPWrdoAzHMsTIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVKRAkebZkHytUD425qalK1fwlLRW8un0qnKGipgO4DQ&oe=6B09A7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kzc_84y3EoQ7kNvwFIxUkd&_nc_oc=Adp98KOo3iISpso1eXokE-HHSeD0lrzxO72U-1aGvDu3phbPA1WfcLqVwCgdD7J52Y4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT28RQ3CjoQ3CbdQVAkHt0ScWr-F7O4XT9DHHoSE4Dg_g&oe=6B09C9CD"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_
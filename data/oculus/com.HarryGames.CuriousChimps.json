uluscdn.com&oh=00_Afs0xiKMcUiTyYCWE_1Xw1VSRjM1VdMSTiZUS4beiipAZw&oe=69A1996B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BApSaOcF6q4Q7kNvwEiEESL&_nc_oc=AdmzvqukOMQpRrLyMusgJL68LdoWWnp7w-vwse38Uh-bp59Vn2sdVMi7kSgbcLRYUa4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsSRuz1-WvZxRJT3q54hh1if0oxeK-HYlJa2AZl_u4BDg&oe=69A190F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YtZ5qjryuUQ7kNvwF-zBEt&_nc_oc=AdmIRLROPxPEyrlCuNUq7UE321Gp6GMXll7nvDr-UlK3N4GSU6f1dL6KUS8zGW6g1pQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afuptrikl_OeEeEmXrt4uAIPwpoO56iPh7pwjLPP96y-4A&oe=69A1889C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_oeP0iigc8Q7kNvwHybspS&_nc_oc=AdnwoPCL7NVUpN1M8Su-YjLMlxuV-DlYpLjo8XZGkxbiI-ybXi8Pdc2r2aA6TxoWbmM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu3FspehXtz0LUJZqy3dXq5YuWpYmHGMLQ0gd-DDGmzPg&oe=69A185E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-T0zphq6AQ7kNvwHlSEe2&_nc_oc=AdlB7kjDRNWI633aHTUmIIGwxsNNivAU63vzmmHiNwno4PqO82WXHPMIFacAfcfZAKU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfteZ8orChuSAr0Q9KiDNHexIu4mVTAbCynC0uDvdAN9LA&oe=69A1A80D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "751969239978747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-
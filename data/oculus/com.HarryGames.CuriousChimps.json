uluscdn.com&oh=00_AfvqLpxez1U4ijrXZZUA3_bXiBbOpr67viMZNvdG_-Cjsw&oe=6999B06B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EcgfeRrrBMQ7kNvwEBNtMp&_nc_oc=AdnOOUJ4Yv8uoIkq7mzWZ9t-zL6z3unDg9bHF3moJdTNNfRCarRFqEQ1bEVcrTe0tqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVYVXB-l9fNcVrmdDZSk1k2itbALo7EMJPSqH-UPpMtA&oe=6999A7F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym6-OfNXqSwQ7kNvwFkeNJl&_nc_oc=AdnyoYL4scwUK-7zEbXwaiYQentz7oBGOlSDGg1lQWXeoAIip3abTkIG_YO-qtU6bns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspTTgtxtMS_YA51nnSBWFtwklzpqRo5OY6Y83rq8AaDA&oe=69999F9C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4SPWEd2_mQQ7kNvwHMw5Fg&_nc_oc=Adkch6JrC1SBBgwXEi22P47YSCnf5W1hInpoO6j_RO_O0U9bpFNrT_2B0J9sMuGPHn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7LDkobqUrgJkC1BPRWBKLwMb2KMYApW676R9K2hugcA&oe=69999CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKpveWfSX3EQ7kNvwFerkyr&_nc_oc=AdlUuEe83CzVR0Gc3-tpO6L32t45vBojDHpH2JPQq1eBS8fhJrTtYYF93-FDkGISNnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvzzms1jzMdC1x8eZD1E6XCWPKVdksE86A6hnN4RsLSqg&oe=6999BF0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "751969239978747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-
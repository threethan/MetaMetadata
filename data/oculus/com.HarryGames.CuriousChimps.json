c=AdrD0NuTCQl1qREN90nqWN3g17ubjtUi411Bs1JZ1XJPU1SHjz6G8N3Nvw7KfvyBS9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zDWZDU21RdaFUu4HoVXYNBeaTea64u6hYbGWsxeI8jQ&oe=69DE3E6B"}, {"file_name": "cosmet.png", "id": "850519769579980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_850519772913313_5412227322777280623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysQ1yWsbfdUQ7kNvwHruU60&_nc_oc=AdpZjYk9587h5Nu0lKEfOTvXwUlD8MP713yySD6mVGQfcz0ln7_e35I1367ZmB21KL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aPHiB9CTI3oeao4SdQlGStq-XYygu70nPFYkFew42RQ&oe=69DE35F9"}, {"file_name": "kill me.png", "id": "650706660195346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031531_650706663528679_3732996701508599993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h-vkFcH8jMQ7kNvwFcZzet&_nc_oc=AdqcMqA4TH9kZ9nxPyJDJ8VwAzLWrQ6LbwXegjAcRC4KoyGafZlt8cMUULzuo2jkO_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15fWMiijChSl8VFwnKSaLpdvtjhL0TNTbIflGA3vdCtw&oe=69DE2D9C"}, {"file_name": "png.png", "id": "202193189081219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982543_202193192414552_3927611314600845508_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtvaButp4McQ7kNvwEkGaWT&_nc_oc=AdrxYVp3-8bvFYVvo8rJ9GqzTqYNAx3WNyHXXr2DDYBMb0OSdpO2c-HIXlSygsUpH_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eJvbYH5OFxo0o6LIdLPCpXxkxPaDm4ehsNsQMuer5mg&oe=69DE2AE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbi open up.png", "id": "901652134489482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974885_901652141156148_8256750132629386093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVKq6KU_9DQQ7kNvwF5_DTy&_nc_oc=AdqizVVU_buckNhEGzfpovmnpNYdR12ZCuP4C1OHQo0-x0jeOYLPLV7dLcQQ5KHna9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30xkaGwEvK2blLVsZ30jXdp6iMnOQUPNdrQYbgMB4pVQ&oe=69DE4D0D"}, "display_name": "Curious Chimps", "keywords": [], "long_description": "A game inspired by Gorilla Tag.\n\nReturn to Chimp.\n\nExplore the multiple environments your natural home has to offer. Run, jump and climb using only your arms, no thumbsticks, touchpads or anything. Stack on top of each other to reach new heights. Climb trees and swing around the forest. Climb walls, run on the ground, jump from branch to branch around different trees. Swim through Zero Gravity, escape Dad, fly, launch, and grapple around in the Mechanic Playground, and put your mind to the test and find out which branches are real and fake, be careful though, time is ticking and lava is rising! Why not a little adventure to satisfy that Chimp curiosity? If you aren't feeling up for it, hang out with other monkeys in the snow or forest map. And whatever you do, do NOT go to the mines.\n\nNo more hooman.", "short_description": "Gorillas, Orangutans, Gibbons, and Monkeys are pretty cool, but what about our closest relative -- chimps? Explore a reality, where chimps with futuristic technology rule the world in this free VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/curiouschimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HarryDog", "support_website_url": null, "website_url": "https://sites.google.com/view/curiouschimps/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
-6RYFcLq2LRtZzQe2TZtTFPo8LeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeMJi4faeo5EcCoERJfMGA5wB1vLsG1xeyJ8QABuW0eA&oe=6B0C6C03"}, {"file_name": "screenshot-02-diving-catch.png", "id": "1126924153041055", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1126924156374388_6576530054943066276_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YYPABEX1S0Q7kNvwHY56zw&_nc_oc=AdrMhQNgaB8gMuwKzLMavwgDAXLDzHSekYugPhaNU5aACDCOtDE_ez29C76aOJd7ckg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ75xSkNMMgi0XXTeJoORYyDLHbI5oxpmrjCq2RLHcRDw&oe=6B0C7255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1831262241403411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1831262244736744_3625251532981568827_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVA1EzBUVLUQ7kNvwEeZ_tY&_nc_oc=AdoPh5lnPY_9AZS25WD8olSNf3JHvhPyNbX6JtsyOLNybvXKfIi32MjswJdLuZWiNtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmMtxrrSDAI9BE26j93sBuPtiX1KIip6BhTNIRdLMAKw&oe=6B0C6D04"}, "display_name": "VR Cricket Mania", "keywords": ["cricket", "sports", "multiplayer", "vrcricket", "cricketgame"], "long_description": "Pad up and walk out to bat in **VR Cricket Mania**.\n\nStand at the crease in full-size stadiums and face real bowling: genuine quicks, seamers and spinners, each with its own run-up, action and pace. Your bat follows your hands \u2013 leave it, defend it, or put it over the rope for six.\n\n# Quick Play\n- **Super Over:** six balls, chase it down.\n- **The Last Over:** the twentieth over of a T20 chase, with the match in the balance.\n- **T10 Chase**, **Powerplay** and the full **T20 Chase**.\n\n# Challenges\n**Chase, Survive, Wagon Wheel, 360 and Boundary Hunt** \u2013 test your shot-making against a set field.\n\n# Practice\nWork on your game in the nets or out in the middle. Pick the bowler, the delivery and where it pitches, and replay any ball.\n\n# Head 2 Head\nPlay a friend online: one bats, one bowls.\n\n# A Living Match\n- Fielders who run, dive, slide and catch over the shoulder.\n- Fields that change with powerplays and move to where you score.\n- British commentary, a crowd that roars for boundaries, and fireworks for your sixes.\n- Four stadiums, a dressing room to choose your bat in, and replays of your best shots.\n\n**Comfort:** you stand at the crease; there is no artificial locomotion.\n{1838693377317493}\n{3062314120790044}\n{971212102246581}\n{2178861776360603}\n{1879515929708338}", "short_description": "Cricket in VR, from the crease. Face fast bowlers and spinners, time every shot with a real swing, and watch fielders dive, slide and catch. Chase targets, top the weekly global scoreboard, or play a friend online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrcricketmania.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Pikko Studios", "support_website_url": null, "website_url": "https://vrcricketmania.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1416569321543265"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1911188056967961"}]}, "baseline_offer": {"id": "1911188056967961"}, "is_approved": true, "firstOffer": {"nod
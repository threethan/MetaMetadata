dn.com&_nc_ss=7f30f&oh=00_AQXQtagWH-vZn98J9DkJ2UHZ6MIP63Xt3UOCJDp5D7Jx1g&oe=6B1066D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1831262241403411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1831262244736744_3625251532981568827_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfeCWAYbwFcQ7kNvwGd-ELh&_nc_oc=Adr26ZYcfkOHrNy2B3I5PZZbjvdcJEprAWvSzV8LO9uoGkM_Grv-Xec4u-WNcZhdGz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUq6pj9khxff9OkZVJFL5fZT3w3pjY7SkFH7VuNRNSyFA&oe=6B106184"}, "display_name": "VR Cricket Mania", "keywords": ["cricket", "sports", "multiplayer", "vrcricket", "cricketgame"], "long_description": "Pad up and walk out to bat in **VR Cricket Mania**.\n\nStand at the crease in full-size stadiums and face real bowling: genuine quicks, seamers and spinners, each with its own run-up, action and pace. Your bat follows your hands \u2013 leave it, defend it, or put it over the rope for six.\n\n# Quick Play\n- **Super Over:** six balls, chase it down.\n- **The Last Over:** the twentieth over of a T20 chase, with the match in the balance.\n- **T10 Chase**, **Powerplay** and the full **T20 Chase**.\n\n# Challenges\n**Chase, Survive, Wagon Wheel, 360 and Boundary Hunt** \u2013 test your shot-making against a set field.\n\n# Practice\nWork on your game in the nets or out in the middle. Pick the bowler, the delivery and where it pitches, and replay any ball.\n\n# Head 2 Head\nPlay a friend online: one bats, one bowls.\n\n# A Living Match\n- Fielders who run, dive, slide and catch over the shoulder.\n- Fields that change with powerplays and move to where you score.\n- British commentary, a crowd that roars for boundaries, and fireworks for your sixes.\n- Four stadiums, a dressing room to choose your bat in, and replays of your best shots.\n\n**Comfort:** you stand at the crease; there is no artificial locomotion.\n{1838693377317493}\n{3062314120790044}\n{971212102246581}\n{2178861776360603}\n{1879515929708338}", "short_description": "Cricket in VR, from the crease. Face fast bowlers and spinners, time every shot with a real swing, and watch fielders dive, slide and catch. Chase targets, top the weekly global scoreboard, or play a friend online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrcricketmania.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Pikko Studios", "support_website_url": null, "website_url": "https://vrcricketmania.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1416569321543265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_2078520056173424_1573288552349748795_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBCQdBzDRnoQ7kNvwEzR3on&_nc_oc=Adp07eqRYJ38twX4ZYI6MGVNN2LWMPYbpfepPpUN-N0wknEp8c16-GnGu7rrCixBT7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUjoDOdoFwkaIw4wuqCyHzi20pxds6aGm03zP1iTrCrQ&oe=6B106C26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Cricket Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "i
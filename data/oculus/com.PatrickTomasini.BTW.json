g4Or1iPdJMvAehFLuKOh8Bt4pM6gzrN4HVcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdbIiYBBnwafwC6l-CPAmOCF5mbsxOUNANnujDYod-TQ&oe=6B0B24E3"}, {"file_name": "08_SCREENSHOT_05.png", "id": "655344115538296", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982678_655344118871629_747775133149602557_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltqMgRvPOFEQ7kNvwHmLaVf&_nc_oc=AdofiMJc4Kn9kdvp_zHm_xgly2pizLF6hyxgf571oZaXLNxIeK4WVNNURI11knyP6sw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgIOFxG5wuaH96zdEDpN62N2pmlK5jMQAo2DjSirPVPQ&oe=6B0B3CB1"}, {"file_name": "08_SCREENSHOT_04.png", "id": "364977965543207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031372_364977968876540_7276143607145301656_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC-XNwo_GpkQ7kNvwGXhHe8&_nc_oc=Adpoy3twN9DTF8y7AZEbbKzrMeyfprJJc2Y847LSllmL4cJiLMVefB32zrdeK_Avcbs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMAAr8r30epTtF-szYiQcJIz3TumXaoHckV7lhiRUJjA&oe=6B0B1FF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "377769314212245"}]}, "baseline_offer": {"id": "377769314212245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649700960, "status": "PUBLISHED", "id": "377769314212245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5773569852704835", "version": "6"}, "id": "566094681156178", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5152194664842360", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5773569852704835"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
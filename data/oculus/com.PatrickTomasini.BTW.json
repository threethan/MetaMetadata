Uufx8RbLaVMdWewYAFYYcMAtlhOMY_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs23WG2Zfwh94X2TlKfh17bvZf0j5iXwLjzCbLo0RihzQ&oe=69A6D495"}, {"file_name": "08_SCREENSHOT_03.png", "id": "4981300048654580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982714_4981300051987913_5938453035609939282_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss6DidYpId4Q7kNvwGqJo5H&_nc_oc=AdmaM7pZfMHzziZ2Wvzzt8u-2t3f53yo09ELzVWwQyKC9_3PQnYqAy4NYfLy0KQ8gno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4BfT5sYnGhcIsCKB6BqdaUOPRwWDujZIILNlc5NUmJg&oe=69A6BF63"}, {"file_name": "08_SCREENSHOT_05.png", "id": "655344115538296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982678_655344118871629_747775133149602557_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qggQpl0muicQ7kNvwHEFxRD&_nc_oc=Adm0Sf2rknrhWWUHenttAIjYvw3vJe0Z1_-8zlhpQ9vx-klCkMEeFyVhkWwRLNiUi3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbYL-PXS15kiFixBOGoQ8mKPBJrIXtPrxggtrQICDPrg&oe=69A6D731"}, {"file_name": "08_SCREENSHOT_04.png", "id": "364977965543207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031372_364977968876540_7276143607145301656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWfO0zQuNuYQ7kNvwHWr4bN&_nc_oc=AdkplfosimC9t9v_WKrv6WaOQd4PYe2DUvY8WRez2GBSJObUTOuUFcGEcU3wrh_mI6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaBsxNXvYVELNTKQTH8ewnKHnSP4axmkAvaViiPUz3_g&oe=69A6F2B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_666701068000332_5502683009710188503_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=u-LVVMEBuosQ7kNvwGc3WWD&_nc_oc=AdmA1YAa_5FzxiCXcNnYP-NNvVKaZHXAfjKdNWoW7yAM1HgElqaj6hZzTAATpTS5Ntg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspkOHpMz-0XWhlfPz8u0A9k0I_idP1q8pwlOct7VthJw&oe=69A6ED5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BEHIND THE WINDOW", "platform":
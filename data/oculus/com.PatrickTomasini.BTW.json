vwG3kZQM&_nc_oc=Adol6MsNzr87B5S1Ws9PylBu8C-nKY01BgZabRAL-6RZX0S9APm8DL2uEsTiUcV_eDI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MHExIPhFx886lIVEavn9cuYeJJ5dy1sg9JQ8HSiiJjQ&oe=69F1FA15"}, {"file_name": "08_SCREENSHOT_03.png", "id": "4981300048654580", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982714_4981300051987913_5938453035609939282_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2F2XC9ucuQQ7kNvwF_t5QI&_nc_oc=AdqGmXTdV4O3kLTs2p2_9A4SRA_sqoOlGC5gyDZzhTI-GFtW4KCrbX89dVuz3bu0VUU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1-tSvtz_vDtlN0bZGTPuAz6Q1pxcdmdqR6Cb1a3Ow6rA&oe=69F1E4E3"}, {"file_name": "08_SCREENSHOT_05.png", "id": "655344115538296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_655344118871629_747775133149602557_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOqayJnPi8oQ7kNvwHZ7b1m&_nc_oc=AdoZyoeNK73fInZsllVQbAjfoO4uHfaTAaynVV8f78SlkniUkCN6-arrcrmi04Fmsh8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2rdF7_Af9SQ63v8QjPKlFpwZBKclBc1pMG7z1_JqyT0w&oe=69F1FCB1"}, {"file_name": "08_SCREENSHOT_04.png", "id": "364977965543207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031372_364977968876540_7276143607145301656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXPppxkWQdMQ7kNvwHI9FbX&_nc_oc=AdqMU7IbimpAgSkza-CL9CTPw81-d20yAFLspZQ8MM7YpZkVtKkpu6clC7gUhcirSG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3nnOPVAKKwGiH1HdNts4UomhIvvrMT-BJAAzwtLJXL1g&oe=69F21835"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031486_666701068000332_5502683009710188503_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=WZ-fe6OynX8Q7kNvwHgJxkv&_nc_oc=AdrssU4RuLP2Gyq8dOXtfwNlFTickvv2yoAeSumgKzdyuDBWBZBg1Jf53sGgvjvQ2cY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cKP_qjpu6FMwF74hZ3EgJIMS6aE69ToHZSnMHYkPuTw&oe=69F212DC"}, "is_concept": false, "is_test": false, "
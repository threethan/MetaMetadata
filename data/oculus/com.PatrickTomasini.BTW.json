_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp_-wbNtnQcQ7kNvwHtsqxe&_nc_oc=Adqs9M11Mdi3wffZ6Lylztyjtzjqwg5e2cxeb8YRNSa9WZyfwg-AsMvnJpWysoT5shs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF31Qtrq25yxzQTQgnN9dovytE09TQaJMRDBRGRKX8QzQ&oe=6A7DB915"}, {"file_name": "08_SCREENSHOT_03.png", "id": "4981300048654580", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982714_4981300051987913_5938453035609939282_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE1QVg_rgmAQ7kNvwFWxmIT&_nc_oc=AdrDft4UYtqPSqLUeYxw-PYAXQNOPa0nTSaZBqvp9AGI845-YBGxGrzr-FgJsAs3fDg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYYdX16adMuQ_ZEf1PeUY1zDlhqmVDUA32DU7H3SLAOg&oe=6A7DA3E3"}, {"file_name": "08_SCREENSHOT_05.png", "id": "655344115538296", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982678_655344118871629_747775133149602557_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwB1PNrn5sUQ7kNvwFWTxOH&_nc_oc=AdpDPE7PhrIRZH38Jjaqgip7-Uo_8XrU6OPBX4no-gqkDHqCZ8BFctsbVwwhAmtJans&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4vCZUghjcYHF9u75NFy190G2uu_wO5Z34baTRjCCwGQ&oe=6A7DBBB1"}, {"file_name": "08_SCREENSHOT_04.png", "id": "364977965543207", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031372_364977968876540_7276143607145301656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4vG7zoTJNwQ7kNvwH24nAE&_nc_oc=AdoJxeExfR3v_7aurFctUMiM1tZeGHYmfCorh1u6Hq6tkngb8qEecS_viscy8-_Y6hU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2qTdxm_-z6RymU1IGWxScP-FF74oRAWXeRwi_g868oA&oe=6A7D9EF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031486_666701068000332_5502683009710188503_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=0cAj4rQDY7sQ7kNvwG1H_bO&_nc_oc=AdpykkAhi1VxZOvWO0VLLaB1fu_vGL7slNMi8_tO4y89yfGm43pUj7kDYj1EtY_OIDU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH
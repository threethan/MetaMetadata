on of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031486_666701068000332_5502683009710188503_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=REtsGw_EZIUQ7kNvwHTuTfg&_nc_oc=Ados6uSF-yPkVZJC6bBt2pk4F7K6ei15-x-iEpsxeFNdHEbgvAR2XVmkLE35JFMnsJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gplU2Bzx
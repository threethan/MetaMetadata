keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/
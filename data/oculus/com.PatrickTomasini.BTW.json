ed and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4998958770224120"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "377769314212245"}]}, "baseline_offer": {"id": "377769314212245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649700960, "status": "PUBLISHED", "id": "377769314212245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5773569852704835", "version": "6"}, "id": "566094681156178", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5152194664842360", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5773569852704835"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
301656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXPppxkWQdMQ7kNvwHI9FbX&_nc_oc=AdqMU7IbimpAgSkza-CL9CTPw81-d20yAFLspZQ8MM7YpZkVtKkpu6clC7gUhcirSG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3nnOPVAKKwGiH1HdNts4UomhIvvrMT-BJAAzwtLJXL1g&oe=69F21835"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
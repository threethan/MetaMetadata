1FF1"}, {"file_name": "08_SCREENSHOT_04.png", "id": "364977965543207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031372_364977968876540_7276143607145301656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZz-Mwtle_8Q7kNvwGr3MPa&_nc_oc=AdpKeMnRpBLxe_pjee22hnbQeahCfEO8J3TYeN7pGTC3grgA_NrpF7dgFGfgyqho-no&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ANo_4l040sdcJnqu8odjlFOLb2IwsnSPV9BdLOXk3SQ&oe=6A340335"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BEHIND THE WINDOW", "keywords": [], "long_description": "The experience is a visual journey in the art project by Fabio Santoro \"Behind the Window\".\nIs a visual path that aims to explore the complexity of human condition in modern society.\nIn the rooms of this visionary gallery, the paintings will lead you through the exploration of the complexity of the human condition in modern society.  \nThe shop windows, symbolically become in these paintings the theatrical set where the modern life of the great western metropolis is staged, and the mannequins are just a ploy to represent ourselves, the dynamics of our lives, the relationships and bonds that we create, but at the same time to undress our real needs, instincts and feelings, exploring the contradictions and peculiarities of a society increasingly standardized and consumerist.", "short_description": "The experience is a visual journey through the Art Project by Fabio Santoro \"Behind the Window\"."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.patricktomasini.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Tomasini", "support_website_url": null, "website_url": "https://www.fabiosantoro.it/works/9", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT
n6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMaK5NkHWqeOvP42XNe18He9JOM5lGxhDpFukggy8sfg&oe=6A7DC9CA"}, {"file_name": "MRPool_meta_screenshot_2560x1440_5.png", "id": "700958614821408", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75334060_700958618154741_841056018972498732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltLXPwlcTXoQ7kNvwH11frq&_nc_oc=Adqi_Jo8I89cvvPtkQe0Vl1frzWsjIAJFXQQdtufMMXFpL0Qijg33anRx12_Wuq6SU4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7L5BIBjDV2v1RHB7jCIy6GOER-bwQ8kmxNGlvBKpjNQ&oe=6A7D9C3C"}, {"file_name": "MRPool_meta_screenshot_2560x1440_3.png", "id": "862915232024955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982528_862915235358288_8848225477585209988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SC_0-PfJG8Q7kNvwHKVWbV&_nc_oc=AdomrJHuDINA3YmPGYc51I9MsLQymaetmQ-m6_ZwjiLIvbwNHH9qTjdT7fxIzzQQUdM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL-JuBb-88RO0G3GYb0Bf5OTnsoUOrBhj6Kf3Jk2FPhA&oe=6A7D9C05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MiRacle Pool", "keywords": [], "long_description": "Have you ever dreamed about having a pool table in your home? Now you can!\n\nThanks to Mixed Reality and Miracle Pool, you can place a virtual Pool Table in your home, walk around, and shoot some balls. You can also play against friends or against other online players.\n\nThis is a room-scale-only experience and you must have plenty of space to use it. The minimum recommended play area is 3m x 4m (10 feet x 13 feet)\n\nFEATURES:\n- Practice alone (8Ball, 9Ball, 10Ball, practice drills)\n- Play against computer (8 Ball)\n- Play with friends (up to 4 players, no rules enforced)\n- Play ranked matches against random online opponents for ELO points (8 Ball)\n\nNOTE:\nThis is an early access version, and we reserve the rights to change pricing and feature sets.", "short_description": "Your own virtual Pool Table in Mixed Reality."}]}, "develop
n6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzvY_mzo_fVihcuw2-alozY4Ym5pI3MMGxIurk2G4WSA&oe=6AA4054A"}, {"file_name": "MRPool_meta_screenshot_2560x1440_5.png", "id": "700958614821408", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75334060_700958618154741_841056018972498732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eY5cgM-KiQQ7kNvwHj1Wo2&_nc_oc=Adr77Ccs00V17_ErklgQ8MsUt9TMnnW_IsWF0HGpi7ivZ1z8HrSD6hYKNF6MC7L395g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_nqSdXgCpyNYvOvOjNtDLdM5iD24ANyGwzlWQdmsUEg&oe=6AA40FFC"}, {"file_name": "MRPool_meta_screenshot_2560x1440_3.png", "id": "862915232024955", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982528_862915235358288_8848225477585209988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsrzdrA2aOEQ7kNvwE1eZXB&_nc_oc=AdqBwvEuJInpzoucXeLi91qtQ7n9U9wu5RelWOVvy5xKnzF61AecxHOAuZDGYgJmtIQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuWALyEgExg_rj2TyhRc8C1nfs6jRkzwCXIrr9Hs5qcw&oe=6AA40FC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MiRacle Pool", "keywords": [], "long_description": "Have you ever dreamed about having a pool table in your home? Now you can!\n\nThanks to Mixed Reality and Miracle Pool, you can place a virtual Pool Table in your home, walk around, and shoot some balls. You can also play against friends or against other online players.\n\nThis is a room-scale-only experience and you must have plenty of space to use it. The minimum recommended play area is 3m x 4m (10 feet x 13 feet)\n\nFEATURES:\n- Practice alone (8Ball, 9Ball, 10Ball, practice drills)\n- Play against computer (8 Ball)\n- Play with friends (up to 4 players, no rules enforced)\n- Play ranked matches against random online opponents for ELO points (8 Ball)\n\nNOTE:\nThis is an early access version, and we reserve the rights to change pricing and feature sets.", "short_description": "Your own virtual Pool Table in Mixed Reality."}]}, "develop
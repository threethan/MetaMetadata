r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFKuyE_nYy38tRToXDhe61dr-akrREGlg6MXv6yRadLA&oe=6A8D638A"}, {"file_name": "MRPool_meta_screenshot_2560x1440_5.png", "id": "700958614821408", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75334060_700958618154741_841056018972498732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtTFFeYg5VMQ7kNvwH21lrM&_nc_oc=AdqZBUXH73j5mnVZMumbyLVEFtoG6W7EJsXYixCTbtcJ41MfYOp94-rUc_7mVhIgKvs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy-jg5ZjsccP1z4-UK2VSnxbAQO-6_wHQcH_T4TDt3rA&oe=6A8D6E3C"}, {"file_name": "MRPool_meta_screenshot_2560x1440_3.png", "id": "862915232024955", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982528_862915235358288_8848225477585209988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqfjeIet5WsQ7kNvwGS8vg_&_nc_oc=AdoVIEFPRcatv36ifdDUhaHtLYHfPGrWWJo58sAdZa6hWEmF5xUag-LeNQCvm4-jRcU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCsKJ8t1CJMi4SipI4OdaUMl9MWEbwDkk4J84QMwYVPw&oe=6A8D6E05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MiRacle Pool", "keywords": [], "long_description": "Have you ever dreamed about having a pool table in your home? Now you can!\n\nThanks to Mixed Reality and Miracle Pool, you can place a virtual Pool Table in your home, walk around, and shoot some balls. You can also play against friends or against other online players.\n\nThis is a room-scale-only experience and you must have plenty of space to use it. The minimum recommended play area is 3m x 4m (10 feet x 13 feet)\n\nFEATURES:\n- Practice alone (8Ball, 9Ball, 10Ball, practice drills)\n- Play against computer (8 Ball)\n- Play with friends (up to 4 players, no rules enforced)\n- Play ranked matches against random online opponents for ELO points (8 Ball)\n\nNOTE:\nThis is an early access version, and we reserve the rights to change pricing and feature sets.", "short_description": "Your own virtual Pool Table in Mixed Reality."}]}, "developer
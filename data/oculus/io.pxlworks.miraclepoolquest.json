7kNvwHyg_FX&_nc_oc=AdoQKIRC2viqj-K86jjOGJCKI4iQr2D1BMN2wBHsrb-zjp2V8h5CTBLnwP-R_lsPKj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcefxq81MVIF4kGKRimlRcCqVlyF1uZVBk9Iv0wZHvng&oe=6AE5F04A"}, {"file_name": "MRPool_meta_screenshot_2560x1440_5.png", "id": "700958614821408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334060_700958618154741_841056018972498732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrVRUzsryG4Q7kNvwFx03a2&_nc_oc=AdqKUPgfMoQncuM7Jo_ak-LDhja14hQSBJLVt5dpe6fQPvemPsd0XPp2_7RfBdPrj5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEZ6hbbxUQRvy7wm6t7LJuXwBHRNMTBPUIEL1qwLODoA&oe=6AE5FAFC"}, {"file_name": "MRPool_meta_screenshot_2560x1440_3.png", "id": "862915232024955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_862915235358288_8848225477585209988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e57jl0eyavMQ7kNvwFU49lH&_nc_oc=AdoKItQ9BqYqT9ylByckpuFRMNTZxSeESEz3XYfzUe_01i7z0vxbXzcX5wrgC1is5LY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnGlBjxt2K7xR8E8Am-5-aJmt8fwU-R42c5h-VO2E2Pw&oe=6AE5FAC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MiRacle Pool", "keywords": [], "long_description": "Have you ever dreamed about having a pool table in your home? Now you can!\n\nThanks to Mixed Reality and Miracle Pool, you can place a virtual Pool Table in your home, walk around, and shoot some balls. You can also play against friends or against other online players.\n\nThis is a room-scale-only experience and you must have plenty of space to use it. The minimum recommended play area is 3m x 4m (10 feet x 13 feet)\n\nFEATURES:\n- Practice alone (8Ball, 9Ball, 10Ball, practice drills)\n- Play against computer (8 Ball)\n- Play with friends (up to 4 players, no rules enforced)\n- Play ranked matches against random online opponents for ELO points (8 Ball)\n\nNOTE:\nThis is an early access version, and we reserve the rights to change pricing and feature sets.", "short_description": "Your own virtual Pool Table in Mixed Reality."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/mrpt_pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works", "support_website_url": null, "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "5796340213802765"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1368299804106049"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1697061360, "status": "PUBLISHED", "id": "1368299804106049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6788567581246685", "version": "0.9_68_EA"}, "id": "231560786204450", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5796340207136099", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6788567581246685"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "231560786204450"}]}, "change_log": null, "created_date": 1717
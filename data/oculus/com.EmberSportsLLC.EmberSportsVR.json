029794_7710645321252881375_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9P_hHPvX-8Q7kNvwH_09Ds&_nc_oc=AdrfsHyDryzqKI-O36uS8VhnYVZ_uOCcTwhS-MDUZoyLhMMzr5yZV04azfaijKAMRP8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ja1x-D-me05GfkHU-HuFt2i-2YY-VqHRZOfFeLV_M8w&oe=6A11CFF2"}, {"file_name": "EmberCatcherBatter.png", "id": "597222821930300", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75326676_597222825263633_6917431437147021015_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh0tInNtNuoQ7kNvwGMXVPa&_nc_oc=AdoRbTIYcC3qQ89JlLx2vkdyw57rN31m5jtgcpkCntHpj5TOnt5yMdgWvWAWMDd553w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pvSN46wwXfLkdAZ6xAppPD74iMg3gklzXmfZakrFJkw&oe=6A11A10C"}, {"file_name": "EmberFan.png", "id": "567639611753966", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982568_567639615087299_3628860069126233262_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9FKJ-fvdvAQ7kNvwHOW9by&_nc_oc=AdqdSs7tT-sxJE00HJCaekkNoib-4Sn8gEdW8Ij73xzJfS7B7u5ilv0QtBsa5rxYbxU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZRao8GGf4eljEm5d3TsbmSHGX8IpYU0LQjAT55ivsVg&oe=6A11A4F8"}, {"file_name": "EmberUmpire.png", "id": "369490128689881", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974845_369490132023214_7640326933891038072_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9roQcjghjYQ7kNvwFRBjJb&_nc_oc=AdomVfKZgVhzHH3-aUJN48E0UmKnq8cStLUvTU4pU5r9S1LHQHoJSP8qBdRjwDSVE_Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XYcWWZetLzCYLpnVi5-ImBUMzO25W1fg6RORb8A2KOQ&oe=6A11B6C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ember Sports VR", "keywords": [], "long_description": "Ember Sports VR provides both baseball players and umpires with virtual recreations of live pitches in a controlled and less resource intensive environment. These virtual pitches are used to train and evaluate user\u2019s plate awareness, pitch recognition, and technique. Ember's virtual reality experience is completely customizable that gives you complete control over the training experience.  ", "short_description": "Ember Sports VR is a sports development platform focused on offering quick and easy access to sport specific repititions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.embersports.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Sports", "support_website_url": null, "website_url": "https://www.embersports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573464137842241"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86627649_341580164725772_7813992183431178847_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQJeB1ptxvcQ7kNvwFmvAhk&_nc_oc=AdoKUOVP6TectlIxDDDuM1cEglpOb5ATUJi766Yu26NZPQ7BzT3c8o567Da0IgR6TTA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58g1da9Ca7zPdlsau6dYr8WAcnRSzMoGTlMqKjZ0ME2A&oe=6A11C2A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ember Sports VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1662699600, "last
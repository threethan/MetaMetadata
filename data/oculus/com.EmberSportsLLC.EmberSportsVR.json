lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR09QOIxBgQnETWK4YQdIHAB08TuvmX1XRKpNkyjhj5gQ&oe=6AE89B41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ember Sports VR", "keywords": [], "long_description": "Ember Sports VR provides both baseball players and umpires with virtual recreations of live pitches in a controlled and less resource intensive environment. These virtual pitches are used to train and evaluate user\u2019s plate awareness, pitch recognition, and technique. Ember's virtual reality experience is completely customizable that gives you complete control over the training experience.  ", "short_description": "Ember Sports VR is a sports development platform focused on offering quick and easy access to sport specific repititions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.embersports.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Sports", "support_website_url": null, "website_url": "https://www.embersports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573464137842241"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1621338812781821"}, {"status": "PUBLISHED", "id": "1094819324491981"}]}, "baseline_offer": {"id": "1094819324491981"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": 
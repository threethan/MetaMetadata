689881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974845_369490132023214_7640326933891038072_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lku4x-_hFcYQ7kNvwHAq6Jr&_nc_oc=AdpD-x84PaoqWr80HX56ly7wPQjDHpxmQXgwqfS1fYLPQpXBNNvmnDtAAqhcA7Mepm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAdkECzHPb65y4-ksDDVTGEOA_HF1QnuSuQct_Hoki9A&oe=6B09C901"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ember Sports VR", "keywords": [], "long_description": "Ember Sports VR provides both baseball players and umpires with virtual recreations of live pitches in a controlled and less resource intensive environment. These virtual pitches are used to train and evaluate user\u2019s plate awareness, pitch recognition, and technique. Ember's virtual reality experience is completely customizable that gives you complete control over the training experience.  ", "short_description": "Ember Sports VR is a sports development platform focused on offering quick and easy access to sport specific repititions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.embersports.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Sports", "support_website_url": null, "website_url": "https://www.embersports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
change_log": "Ember Sports VR is now free!\n\nNew\n\u2022 Free to download. Jump into Free Play with no account.\n\u2022 Ember Pro subscription: save every session, track your accuracy and history, and sync across headsets.\n\u2022 Original owners get 3 months of Ember Pro free. Sign in with an Ember account to claim it.\n\u2022 Ember accounts and player profiles, with support for team and coach seats.\n\u2022 Redesigned menus, pitch history and stats.\n\u2022 Hologram strike zone and pitch tunnel visualization.\n\u2022 New softball gear, stadiums, jumbotron feedback and a Little League baseball field.\n\u2022 Umpire mask and helmet brim views.\n\nImproved\n\u2022 Pitcher animations and release timing.\n\u2022 Call and swing recording, with the call you make now being the one that counts.\n\u2022 Performance and stability on Quest 2, Quest Pro, Quest 3 and Quest 3S.", "created_date": 1793317431, "id": "29817198571217050", "version": "2026.10.16", "version_code": 128, "release_status": "PENDING", "status": "UNDER_REVIEW", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5625848130778765", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5972513232778918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "676534200281115"}]}, "change_log": "**Ember Sports VR is now free!**\n\n**New**\n\u2022 Free to download. Jump into Free Play with no account.\n\u2022 Ember Pro subscription: save every session, track your accuracy and history, and sync across headsets.\n\u2022 Original owners get 3 months of Ember Pro free. Sign in with an Ember account to claim it.\n\u2022 Ember accounts and player profiles, with support for team and coach seats.\n\u2022 Redesigned menus, pitch history and stats.\n\u2022 Hologram strike zone and pitch tunnel visualization.\n\u2022 New softball gear, stadiums, jumbotron feedback and a Little League baseball field.\n\u2022 Umpire mask and helmet brim views.\n\n**Improved**\n\u2022 Pitcher animations and release timing.\n\u2022 Call and swing recording, with the call you make now being the one that counts.\n\u2022 Performance and stability on Quest 2, Quest Pro, Quest 3 and Quest 3S.", "created_date": 1793220894, "id": "29800687556201485", "version": "2026.10.16", "version_code": 126, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5625848130778765", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5972513232778918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793215715, "id": "29799770799626494", "version": "2026.10.16", "version_code": 125, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
QWWwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb6qWybuaEru9XfzZ59P7A9mUqZWrqfPdyzUc9FOhHWw&oe=6AFB3A72"}, {"file_name": "EmberSportsVR_StoreImage_4_SoftballUmpire_PitchSelection_alt.png", "id": "29193937323533822", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604370996_29193937330200488_8767173483817177086_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBBEVS0WsekQ7kNvwEL3U62&_nc_oc=Adohw-IGurgtBag9tZv8omeqBsA_Emq1Chq7_LByvzIvoL2NfQNQHn2LiJRtXPBjNj8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw3f-SYdZ1awasiFd47f0iJunjmDbusbL_OAup5HCPoA&oe=6AFB35A7"}, {"file_name": "EmberSportsVR_StoreImage_1_BaseballUmpire_Mask_alt_closer.png", "id": "1111435594809854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654862493_1111435598143187_3980373052490525162_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH4Kwa33sgMQ7kNvwEgpcwv&_nc_oc=Adp8COlb7M-Xzuya4IaofTLH1EBghLpu54n6g7nJ6oOZlXGw385D096ayG83PREABRE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFcJuC_ska5HM-5uqO5qlp7TMdj-4R8DiUEO6YzCkx6A&oe=6AFB1AC9"}, {"file_name": "EmberSportsVR_StoreImage_5_BaseballUmpire_Positioning.png", "id": "3121679084831088", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654862493_3121679088164421_7042625018330641131_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa5Pe_QW_34Q7kNvwFcxFhS&_nc_oc=AdrzY63N_uK8GJKtCLMPT_QHqfoVXlAFm0m_Asc2eVusEK9h4q1l6baK6zcT0_LQvcg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVIKl-3Y4JLaRnwKRrhP_GzABgkqKS83-3G86f6RPcwg&oe=6AFB26D5"}, {"file_name": "EmberSportsVR_StoreImage_6_BaseballHitter_Stats.png", "id": "2277104783138613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753328995_2277104786471946_5180595661091127616_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cj3JdifFZvoQ7kNvwG4tNTg&_nc_oc=Adq8rZ0El0g4l5s09tgCc-5KCMOzLqAf1pyI5Yu9hEGqX_s6t2oH0HFGol6T9cwAapQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS09zgLbT1A-tVTxmS-2ntxyXo96AExRD3QOBeNNaQ9ww&oe=6AFB297F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ember Sports VR", "keywords": ["Baseball", "Softball", "Umpire", "Batter", "Hitter"], "long_description": "**Step into the box. Make the call.**\n\nEmber Sports VR puts you at the plate or behind it against lifelike pitchers, so you can build the skill that matters most and is hardest to practice: recognizing a pitch and deciding fast.\n\n\n**Four training modes**\n\n\u2022 **Baseball Hitter**: read the pitch out of the hand and decide to swing or take.\n\n\u2022 **Baseball Umpire**: call balls and strikes from behind the plate.\n\n\u2022 **Softball Hitter**: fastpitch pitchers with all pitch types.\n\n\u2022 **Softball Umpire**: call a fastpitch game from the umpire's view.\n\n**Real pitches, real speeds**\n\n\u2022 Baseball: fastball, slider, curveball, changeup, cutter and splitter with multiple deliveries.\n\n\u2022 Softball: fastball, changeup, riseball, dropball, curveball, screwball, drop curve and drop change.\n\n\u2022 Competition levels from Little League and Middle School through High School, College and Pro, with matching speeds, movement and field dimensions.\n\n\u2022 Multiple Strike-Zone types \n\n**See what you missed**\n\n\u2022 Review your data from the web.\n\n\u2022 Pitch tunnels that show how pitches look the same out of the hand and break apart late.\n\n\u2022 A hologram strike zone, pitch selection and velocity controls, and umpire mask or helmet brim views.\n\n**Ember Pro: Track Your Progress**\n\nSubscribe to Ember Pro in the app to save every session to your profile:\n\n\u2022 Pitch history, decision accuracy and breakdowns by pitch type and location.\n\n\u2022 Sync across headsets.\n\n\u2022 Review your data on the Ember Sports website.\n\n\n**Free to play**\n\nJump into Free Play right away, no account needed.\n", "short_description": "Train your eye like the pros. Recognize pitches, master the strike zone and sharpen your umpire calls in realistic baseball and softball VR. Free to play mode available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.embersports.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Sports", "support_website_url": null, "website_url": "https://www.embersports.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29815565828046991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831393_1774153430334622_7113618744799396541_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBFNsoxzM-QQ7kNvwHfyTWi&_nc_oc=AdpV8SqO0vrhKSWZCNOjCliYQ0BjlQg_upBCeW286Kw7Wlo-hFx0cNXjnhsAkHzdx7M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIBilOUcwKCD_OjJWhNuGIsf-AoQDf-5WAizoYRf1SFg&oe=6AFB2D50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ember Sports VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1662699600, "lastRevisio
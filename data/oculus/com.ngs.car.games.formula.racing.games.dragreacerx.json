=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2S5Ug_yXt7afSfjGnimuhaZCBOKUsqqaD1jHit-WOog&oe=69BE843B"}, {"file_name": "Untitled design (8).png", "id": "938632485284335", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_938632491951001_4440651792659739853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4jeNCbjD8IQ7kNvwGHjPJH&_nc_oc=AdmUVSIKx6DuLz_6NF71V0yKDTWnCjXcrIgPv0sB7Y_p64j9RbH_AZS-5QF9ln9c-vA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8TAvwaUxOwAQsUHDob3_8rt0z8uuXU1Wi7gRHQpujxg&oe=69BE953A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drag racing -Car Racing  games-Car Games", "keywords": [], "long_description": "Rev up your engines and dive into the world of high-speed car racing with \nDrag racing -Car Racing  games-Car Games. Experience the thrill of racing with stunning graphics, realistic physics, and intense gameplay. Whether you're racing through challenging levels or competing against players worldwide, this game has something for every racing enthusiast.\n\nFeatures:\nChallenging Levels: Conquer a variety of tracks with increasing difficulty. Face unique obstacles and exhilarating challenges at each level. Earn rewards and unlock new tracks as you progress.\n\nCustomizable Cars: Choose from a wide selection of cars, each with unique performance attributes. Upgrade your vehicles with powerful engines, tires, and other enhancements. Personalize your car\u2019s appearance with custom paint jobs and decals.\n\nStunning Graphics and Realistic Physics: Enjoy high-quality graphics that bring the racing world to life. Experience realistic car physics that provide a true-to-life driving experience. Race through beautifully designed environments and dynamic weather conditions.\n\nEasy Controls: Intuitive controls designed for smooth and responsive gameplay.", "short_description": "Step into high-speed Formula racing in VR. Drive open-wheel race cars, sit inside a fully immersive cockpit, and compete on professional-style circuits. Feel realistic handling, intense speed, and competitive Formula-style racing built exclusively for Pro racing lovers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26008576172125151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820619_1614195969628022_6099341795379802264_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F65eDjncU4Q7kNvwGolDHv&_nc_oc=AdlCQt13K0AxbNt0HJBMl8kdy5jam2nqFdSKr4Y4Yj-dysYz0mu6e_Chd8F-Gm1bPV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9gH81pigzFqI7a7YKhf6FueQnGagMTRsXIlBS5K0H9w&oe=69BE8F7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drag racing -Car Racing  games-Car Games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "S
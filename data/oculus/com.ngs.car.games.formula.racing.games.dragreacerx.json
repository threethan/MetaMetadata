?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbV8Q0Lf70MQ7kNvwGyLtMs&_nc_oc=AdpZakcThEzNyd0tnwjJUcY3KXYbjZgkLmQ6y4bQp5Vl4Qv1qs0UOjAh_7qzQ-OcwLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sZBJygzEFPWEiuKcHYvq2687FGAnrzCA07akBTF5nXQ&oe=69DCD6BB"}, {"file_name": "Untitled design (8).png", "id": "938632485284335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622276_938632491951001_4440651792659739853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNETN5DkvP4Q7kNvwGlvry5&_nc_oc=Adp1VJFnQsWZcgcPHz5YInhFzjq6_Ie7tNJzLQI3qOII_kFAuBF6jqd579rrYXaJDpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mnHvFfCC9Xe6wXvb1HqdOZClwkNmSd0Fk1X4451QZLA&oe=69DCE7BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing  games -Car Game- Drag Racing", "keywords": ["carracinggames", "cargames", "car", "racing", "simulator"], "long_description": "Feel the rush in one of the most immersive car racing games in VR\u2014where speed, precision, and skill define every race.\nJump into a realistic car racing simulator with stunning visuals, smooth controls, and intense high-speed action on Meta Quest.\n\nCar Racing  games -Car Game- Drag Racing\n\nIf you are searching for car racing games in VR, realistic driving physics, and competitive car games, this title brings everything together in one high-speed package.\n\nRealistic Car Racing Simulator in VR\n\nThis car racing simulator VR game lets you experience real driving mechanics, responsive controls, and dynamic tracks designed for both casual players and serious racing enthusiasts. From intense solo races to competitive challenges, Neon Velocity stands out among modern car racing games.\n\nWhy Neon Velocity is One of the Best Car Racing Games\n\ud83d\ude97 Realistic Car Racing Simulator Experience\n\nEnjoy true-to-life driving in a powerful car racing simulator. Every turn, drift, and acceleration is designed to replicate real-world physics, making it one of the most realistic car games in VR.\n\n\ud83c\udfc1 Advanced Racing Gameplay & Challenging Tracks\n\nCompete in multiple levels built for high-speed action. This car racing game features progressive difficulty, sharp turns, and competitive racing environments that define top-tier car racing games.\n\n\ud83c\udfce\ufe0f Car C", "short_description": "Drag Racing is a VR-based car racing game that combines realistic physics, immersive environments, and competitive gameplay. As a car racing simulator, it delivers authentic driving mechanics, customizable cars, and challenging tracks, making it one of the best car racing games for Meta Quest users who enjoy high-quality car games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26177350708581029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820619_1614195969628022_6099341795379802264_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3lmfFBGvGcQ7kNvwF
0_AQJ4LQIbGN8c5Xmb0zit9UzmNIZRE_FfmWrFADJUPbAC7A&oe=6AA7FCC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AAA Trailer Cover 2560x1440.png", "id": "912786578210970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_912786581544303_1789462832436055605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I18jstjn0Z4Q7kNvwEeDaW-&_nc_oc=AdrrAdl-0yDeXyKueS9VxvG5jw4pUy5F3KjlsSqYAyKvsxraALU9DbjvAbh-BIbggSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwg9dEKEorjuPkVxP7yUgS9AJ2-N-XsimZEQUp5EFKTg&oe=6AA81665"}, "display_name": "Asteroids And Aliens", "keywords": ["Sword", "Gun", "Alien", "Robots", "PvE"], "long_description": "Welcome to MASS, the Mega Asteroid Suppression Service, Agent. Your job is to protect this space station with your lightning sabers against Asteroids and Aliens. Are you ready?\n\nTest Your Skills!\n\n- 10 missions with increasing difficulty, can you complete them all?\n\n- 1V1 mode against an elite alien drone.\n\n- Use the local leader-board to compete with friends and family.\n\nEarn Goudas And Unlock Items!\n\n- Unlock cosmetic upgrades for your sabers.\n\n- Discover new alien landscapes and add them to your collection.\n\n- Uncover a secret weapon befitting an elite MASS agent.\n\nImmersive VR Environments!\n\n- 3d sound to help you pinpoint the location of enemies.\n\n- Unique alien landscapes with custom music.\n\nand More!\n\n- Play in endless mode, adjust the angle and speed to fit your skill level.\n\n- Fight your way to the top of the global leader-board.\n\n- Animated credits scene featuring a dance battle between the Attackians and MASS.\n\n- Access the Alien Dex to examine the Attackians up close.\n\nGood Luck, Agent.", "short_description": "Test your skills in this immersive VR space opera by Star 1 Studio. Utilize lightning sabers to strike down hordes of bionic extraterrestrials. Fight your way to the heart of the planet to defeat Attackian Leader RahKah. Unlock 10 missions, 10 alien landscapes, 8 saber colors, and a secret weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.star1studio.com/home/asteroids-and-aliens-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Star1Studio", "support_website_url": null, "website_url": "https://www.star1studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26218117997819953"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1577509110759920"}, {"status": "PUBLISHED", "id": "3858220074486726"}]}, "baseline_offer": {"id": "1577509110759920"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780605660, "status": "PUBLISHED", "id": "1577509110759920"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26218661364432283", "version": "1.0.1"}, "id": "2017350412155820", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26204876532477433", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26218661364432283"}, "release_status": "RELEASE
mTGgeO85VEp_ZaolKXY7hp0CJLPEf5TKnuOmpkUp762bQV20w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fiwtwiKNWDET_WgmkIKMuvixfKQu5knPXgnwu_H7tIg&oe=69E62147"}, {"file_name": "4 Double Gun Sky 8E.png", "id": "1484690836351147", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_1484690839684480_2440141054464654735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7cPl37ma_UQ7kNvwFit1Ql&_nc_oc=AdpneJLHRGvGP1n9DS3v4FeNVxqrXdPu_Io6WRy1MW7AlNIPaRuRT_xVbABEiPiYAuw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IYdc9ibIINlw91UIxI8bDz3Ru77AVySPuREWvMcij7A&oe=69E61837"}, {"file_name": "5 Casting_Screenshot_1770699279509 settings and records.png", "id": "1548099099582861", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820058_1548099102916194_8833034358893580297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WUhFitDUkkQ7kNvwFCXMTm&_nc_oc=Adq1FuF9Az4TQmgxmr6ZRzDy_G7V-wIf1d7bjS1gLWsBHScj_l2uH0k92hV8KUHAUm0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DC10G5oo9TLg_Q1cDUz9ZrDstm51_RdoZUD3HzgwffQ&oe=69E63043"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AAA Trailer Cover 2560x1440.png", "id": "912786578210970", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619681_912786581544303_1789462832436055605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCCBX0JgiW8Q7kNvwFCU8Kw&_nc_oc=AdrjoBkZYOQf24nNIn0VLYkSfNRgE8fXYmJRvM3uxqv8EC-MTG664D6fjZs6HUJG4jI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jFPdR1B59DOd-PMt3fD9gYNtXhfOgrJQfTQijzERtGA&oe=69E611A5"}, "display_name": "Asteroids And Aliens", "keywords": ["Sword", "Gun", "Alien", "Robots", "PvE"], "long_description": "Welcome to MASS, the Mega Asteroid Suppression Service, Agent. Your job is to protect this space station with your lightning sabers against Asteroids and Aliens. Are you ready?\n\nTest Your Skills!\n\n- 10 missions with increasing difficulty, can you complete them all?\n\n- 1V1 mode against an elite alien drone.\n\n- Use the local leader-board to compete with friends and family.\n\nEarn Goudas And Unlock Items!\n\n- Unlock cosmetic upgrades for your sabers.\n\n- Discover new alien landscapes and add them to your collection.\n\n- Uncover a secret weapon befitting an elite MASS agent.\n\nImmersive VR Environments!\n\n- 3d sound to help you pinpoint the location of enemies.\n\n- Unique alien landscapes with custom music.\n\nand More!\n\n- Play in endless mode, adjust the angle and speed to fit your skill level.\n\n- Fight your way to the top of the global leader-board.\n\n- Animated credits scene featuring a dance battle between the Attackians and MASS.\n\n- Access the Alien Dex to examine the Attackians up close.\n\nGood Luck, Agent.", "short_description": "Test your skills in this immersive VR space opera by Star 1 Studio. Utilize lightning sabers to strike down hordes of bionic extraterrestrials. Fight your way to the heart of the planet to defeat Attackian Leader RahKah. Unlock 10 missions, 10 alien landscapes, 8 saber colors, and a secret weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.star1studio.com/home/asteroids-and-aliens-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Star1Studio", "support_website_url": null, "website_url": "https://www.star1studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
Z_xxb6dmrZ4zVFaTwgtR8a0NIzNiA4SgSCs7iEbu7NPg8_KrI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yFDNWA08JoFG3t1lTLVrpiXTMdjK_yLeos56Ou_TqRg&oe=69F5F347"}, {"file_name": "4 Double Gun Sky 8E.png", "id": "1484690836351147", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618069_1484690839684480_2440141054464654735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSOqlZBHEq4Q7kNvwEOX0eL&_nc_oc=Adpu1_txWbVMSoHAvfquFKWXIJ9o1QYl4wbcGb9rDn6xdJTv0baCIABQ-YdLw0Xb3MM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uLK_8uINZbniX9XM21N8Ie1LWDBGKaMliOgGGUXW2QQ&oe=69F5EA37"}, {"file_name": "5 Casting_Screenshot_1770699279509 settings and records.png", "id": "1548099099582861", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820058_1548099102916194_8833034358893580297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSKmJtZWE50Q7kNvwFmuMt5&_nc_oc=Adr5Vn-171wxpGLiciRp5iprL5H69VFDK-5sficaQvleXq3wYHVxHk5J_9zfy06IYRc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-LmPHvzZsw-ZX3IgJ3EYVm-dXTLJ-_uKTHJqX9-uEow&oe=69F60243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AAA Trailer Cover 2560x1440.png", "id": "912786578210970", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619681_912786581544303_1789462832436055605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaDwXwz1fA8Q7kNvwEnH9EW&_nc_oc=Adrwk9oZZjM7DbXAXQdH15mNf3Q4r9kTzqY_GebinBuW-v2WxqzxXNNEo9YR3Nwdqyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i2hN_rosi2VlM_WPm8i8Gi2v3kcOUDCf7LmDpZleUJw&oe=69F61BE5"}, "display_name": "Asteroids And Aliens", "keywords": ["Sword", "Gun", "Alien", "Robots", "PvE"], "long_description": "Welcome to MASS, the Mega Asteroid Suppression Service, Agent. Your job is to protect this space station with your lightning sabers against Asteroids and Aliens. Are you ready?\n\nTest Your Skills!\n\n- 10 missions with increasing difficulty, can you complete them all?\n\n- 1V1 mode against an elite alien drone.\n\n- Use the local leader-board to compete with friends and family.\n\nEarn Goudas And Unlock Items!\n\n- Unlock cosmetic upgrades for your sabers.\n\n- Discover new alien landscapes and add them to your collection.\n\n- Uncover a secret weapon befitting an elite MASS agent.\n\nImmersive VR Environments!\n\n- 3d sound to help you pinpoint the location of enemies.\n\n- Unique alien landscapes with custom music.\n\nand More!\n\n- Play in endless mode, adjust the angle and speed to fit your skill level.\n\n- Fight your way to the top of the global leader-board.\n\n- Animated credits scene featuring a dance battle between the Attackians and MASS.\n\n- Access the Alien Dex to examine the Attackians up close.\n\nGood Luck, Agent.", "short_description": "Test your skills in this immersive VR space opera by Star 1 Studio. Utilize lightning sabers to strike down hordes of bionic extraterrestrials. Fight your way to the heart of the planet to defeat Attackian Leader RahKah. Unlock 10 missions, 10 alien landscapes, 8 saber colors, and a secret weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.star1studio.com/home/asteroids-and-aliens-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Star1Studio", "support_website_url": null, "website_url": "https://www.star1studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
-LsZzUkI1Lif22eWFNg-LMrA0geLQnfku8Dro9YZt1uiYIYAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pgyyeB5WJDVdYyEEy_PCckDduDa07m6uUOrNi4stSjQ&oe=69F744C7"}, {"file_name": "4 Double Gun Sky 8E.png", "id": "1484690836351147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1484690839684480_2440141054464654735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSOqlZBHEq4Q7kNvwEVjqVh&_nc_oc=AdqYpdD6O7WyovqO_hqVLX6yUhWQe4fGv2ubMX7Ti6goDPQvGUCelbeI-bauAM4GAYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b_mliQKaI1dS9ueuD7PZZDr5qxscNHUPB54lNUOZGUA&oe=69F73BB7"}, {"file_name": "5 Casting_Screenshot_1770699279509 settings and records.png", "id": "1548099099582861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820058_1548099102916194_8833034358893580297_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSKmJtZWE50Q7kNvwGaSMUl&_nc_oc=AdrUx7LWTintHmqGYph9zcEaT3HdHmWhyd6VJFftEU8OkJgC-HO-d8oKuiScId9kYIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1piuBooRCMxbD73Aq2dZTV6e_sIUqJweTwq1Zn-vJdVg&oe=69F753C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AAA Trailer Cover 2560x1440.png", "id": "912786578210970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_912786581544303_1789462832436055605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q9LCsWyqQ0Q7kNvwG-KC7F&_nc_oc=AdpcCZ-9Bs71K7O4C6i9Ku7KjIapUtr0gqiFRjAOT0kzugcN_LWXO2gRnpwsPJJBKE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H-oVigbw2AbBy1_1LEvI4a2jFYy0_YAeR8PWwX3bZLA&oe=69F73525"}, "display_name": "Asteroids And Aliens", "keywords": ["Sword", "Gun", "Alien", "Robots", "PvE"], "long_description": "Welcome to MASS, the Mega Asteroid Suppression Service, Agent. Your job is to protect this space station with your lightning sabers against Asteroids and Aliens. Are you ready?\n\nTest Your Skills!\n\n- 10 missions with increasing difficulty, can you complete them all?\n\n- 1V1 mode against an elite alien drone.\n\n- Use the local leader-board to compete with friends and family.\n\nEarn Goudas And Unlock Items!\n\n- Unlock cosmetic upgrades for your sabers.\n\n- Discover new alien landscapes and add them to your collection.\n\n- Uncover a secret weapon befitting an elite MASS agent.\n\nImmersive VR Environments!\n\n- 3d sound to help you pinpoint the location of enemies.\n\n- Unique alien landscapes with custom music.\n\nand More!\n\n- Play in endless mode, adjust the angle and speed to fit your skill level.\n\n- Fight your way to the top of the global leader-board.\n\n- Animated credits scene featuring a dance battle between the Attackians and MASS.\n\n- Access the Alien Dex to examine the Attackians up close.\n\nGood Luck, Agent.", "short_description": "Test your skills in this immersive VR space opera by Star 1 Studio. Utilize lightning sabers to strike down hordes of bionic extraterrestrials. Fight your way to the heart of the planet to defeat Attackian Leader RahKah. Unlock 10 missions, 10 alien landscapes, 8 saber colors, and a secret weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.star1studio.com/home/asteroids-and-aliens-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Star1Studio", "support_website_url": null, "website_url": "https://www.star1studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
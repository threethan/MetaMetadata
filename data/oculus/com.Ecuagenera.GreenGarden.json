6068_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xTat3YU6XYQ7kNvwGRWfzF&_nc_oc=Ado-xzZ1NU9C4J-2bNbBDeeUYXr8R_I_kXXL5VJkIlH3WY2eSvuzFrjM93epV9LzXeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxZsAd587DFX39TPhponT15dUxPnntdmeh4dnQBz0vUg&oe=6A524144"}, {"file_name": "SS4.png", "id": "975082817907272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_975082821240605_6921470802895206283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPaJRyM4kTgQ7kNvwEXQToG&_nc_oc=AdoxUW-F5HPWKnjnSiKk0O1XqYFD62KeoANhvant3iGash4GhdWT3sqOdXkjUs1Rn5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfEBztutKcNDmJettYJVNc8X_pKZHjL0N2wjdAmbuWzQ&oe=6A5232B7"}, {"file_name": "SS5.png", "id": "1037858574768148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391958_1037858578101481_2629243191898837421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXGlGxlV1hIQ7kNvwE7HxvL&_nc_oc=Adp9Esq7TOLRrNl9zkSJ5V0tca2h2zbgTQvZDwDuTXp1zQgLEBfGVJguQkO77KvljeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkk5A51uj0Ueyrdx-Z8wgmQv6K57YKaZoU1L9k7EmVig&oe=6A524951"}, {"file_name": "SS6.png", "id": "2487265508271117", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393516_2487265511604450_2683266361515773971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyOcCLq5GwcQ7kNvwGy8G2i&_nc_oc=Adqk8HROdB8lXWaW4OJzvz88s78eJkfYulld_SlhDINYLdn58ibBZFX8GE554jYG0IA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoZX1clM9-xcOOoI4hu9cDkA1XLJtN9H2CWfpWMDyb-A&oe=6A52440D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Garden", "keywords": [], "long_description": "Green Garden \u2013 A VR Botanical Experience \ud83c\udf3f\nStep into Green Garden, a fully immersive virtual reality experience where you can explore and interact with a beautifully designed botanical environment. Discover exotic plants, engage with nature, and enjoy a relaxing yet educational journey in a unique VR setting.\n\nKey Features:\n\u2705 Explore a detailed greenhouse environment \u2013 Designed to showcase a carefully curated selection of plants.\n\u2705 Interactive mechanics \u2013 Scan, water, and fertilize plants while observing their real-time reactions.\n\u2705 Dynamic environment \u2013 Experience realistic lighting and environmental effects that adapt to different times of the day.\n\u2705 Immersive sound design \u2013 Enjoy high-quality ambient sounds that enhance the atmosphere and realism of the experience.\n\u2705 Relaxing and educational \u2013 Learn fascinating details about plant species while immersing yourself in a peaceful, interactive world.", "short_description": "A Unique VR Botanical Journey\n\nEngage with nature in Green Garden, where every interaction is designed to offer both relaxation and discovery in a beautifully crafted VR greenhouse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://contenidoecuagenera.github.io/green-garden-privacy/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ecuagenera", "support_website_url": null, "website_url": "https://ecuagenera.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922140294505620"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord
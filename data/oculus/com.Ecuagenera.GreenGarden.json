6068_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhoSFPQtovQQ7kNvwEnI4fJ&_nc_oc=AdqVeSad_mMAKPA4eSwCzCyUUCosm2SlXZaLpcSyKaehhaQhNWQfbSQq6_xtDXliwx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fk8BMjj7sMb4RJ6xRzMOxs-O_ub0WGGE5HreoMxdmjw&oe=6A05CA44"}, {"file_name": "SS4.png", "id": "975082817907272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391909_975082821240605_6921470802895206283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd0ktS5sL24Q7kNvwFUl0x7&_nc_oc=AdpkzDXgAGMS6xgcDOTzqfHtHLOrgfTFR_KXx-fbWOD7_FW9C6BIFV7RJpjIEqbdbjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aRp9Gibuq_W8O0URM-uBfB_A_zKbs5ia8NbCyRPbeLA&oe=6A05BBB7"}, {"file_name": "SS5.png", "id": "1037858574768148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1037858578101481_2629243191898837421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1_AvQN7WxgQ7kNvwHDl-RI&_nc_oc=AdpQGvVe7_HLLy__0DeCwo7FmMc9H-dGjGgc3YPIxxWZclYtE5iqr_FOQGNRmJAjHug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xhMIqSYO2rOWdmkng6NcyHrHqWzVUTv5mQYAmEl8ckA&oe=6A05D251"}, {"file_name": "SS6.png", "id": "2487265508271117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_2487265511604450_2683266361515773971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdB_2FAgYUgQ7kNvwG2fuQ5&_nc_oc=AdqZoXmkjGjjDkSQUsKLFzB1VkN6HxG0f-7P3JsEO5ZzJFjdWDs9v-3wnqnGZA081T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_5r4eFhqtLXSn-gQ6DgOJjNn87NZQsWX5OsvGd1grTw&oe=6A05CD0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Garden", "keywords": [], "long_description": "Green Garden \u2013 A VR Botanical Experience \ud83c\udf3f\nStep into Green Garden, a fully immersive virtual reality experience where you can explore and interact with a beautifully designed botanical environment. Discover exotic plants, engage with nature, and enjoy a relaxing yet educational journey in a unique VR setting.\n\nKey Features:\n\u2705 Explore a detailed greenhouse environment \u2013 Designed to showcase a carefully curated selection of plants.\n\u2705 Interactive mechanics \u2013 Scan, water, and fertilize plants while observing their real-time reactions.\n\u2705 Dynamic environment \u2013 Experience realistic lighting and environmental effects that adapt to different times of the day.\n\u2705 Immersive sound design \u2013 Enjoy high-quality ambient sounds that enhance the atmosphere and realism of the experience.\n\u2705 Relaxing and educational \u2013 Learn fascinating details about plant species while immersing yourself in a peaceful, interactive world.", "short_description": "A Unique VR Botanical Journey\n\nEngage with nature in Green Garden, where every interaction is designed to offer both relaxation and discovery in a beautifully crafted VR greenhouse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://contenidoecuagenera.github.io/green-garden-privacy/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ecuagenera", "support_website_url": null, "website_url": "https://ecuagenera.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922140294505620"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad
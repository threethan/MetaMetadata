6068_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTq_YTdihVgQ7kNvwEWBA2Q&_nc_oc=AdrN2U_mPpThNxjgxfR1ZVofQGyBa22HtGbUlrNt2EkBGUdnCzyhxepkRp-IiziQAYE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5USkHWnIKcjVeUDJpq5S1t4eunepyval6cLATlHdYEAQ&oe=6A09BEC4"}, {"file_name": "SS4.png", "id": "975082817907272", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391909_975082821240605_6921470802895206283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8FrE7QHNOgQ7kNvwHH3sq3&_nc_oc=AdqOzlRLgqruOC8ya5J0E3b5BDfYiB3csQo2jMb6jo9FR0TZtrmUyyKh6Y8jlb0MKbM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V_mbszhNwtmc_3ProRyoQPV143xQCVxVCAbJHxX7MUA&oe=6A09B037"}, {"file_name": "SS5.png", "id": "1037858574768148", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1037858578101481_2629243191898837421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT5R_tw5k8oQ7kNvwF49gK2&_nc_oc=AdqVbAYEIgNuH4Oq0eB3OtvKUaW6u0GFHZNj4vCbxfO46nvakvdlaRxEJccHXDtTCQg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cclgqulXMe6v4E1nsQyK85X7CM2w1BEHGjGSCHbg9Qg&oe=6A09C6D1"}, {"file_name": "SS6.png", "id": "2487265508271117", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393516_2487265511604450_2683266361515773971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLVrDZvzTIYQ7kNvwFX5aqY&_nc_oc=AdoASPeexo3v9KJhDwOk0zLvxJ4CbpUgmDYYQTErZW8felsqtFQolDKSUv9HFCVyiEs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-5XmLGBnc5Fx2fbl2omVwXoNtH20Jm8D_9KLhTwaqGw&oe=6A09C18D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Garden", "keywords": [], "long_description": "Green Garden \u2013 A VR Botanical Experience \ud83c\udf3f\nStep into Green Garden, a fully immersive virtual reality experience where you can explore and interact with a beautifully designed botanical environment. Discover exotic plants, engage with nature, and enjoy a relaxing yet educational journey in a unique VR setting.\n\nKey Features:\n\u2705 Explore a detailed greenhouse environment \u2013 Designed to showcase a carefully curated selection of plants.\n\u2705 Interactive mechanics \u2013 Scan, water, and fertilize plants while observing their real-time reactions.\n\u2705 Dynamic environment \u2013 Experience realistic lighting and environmental effects that adapt to different times of the day.\n\u2705 Immersive sound design \u2013 Enjoy high-quality ambient sounds that enhance the atmosphere and realism of the experience.\n\u2705 Relaxing and educational \u2013 Learn fascinating details about plant species while immersing yourself in a peaceful, interactive world.", "short_description": "A Unique VR Botanical Journey\n\nEngage with nature in Green Garden, where every interaction is designed to offer both relaxation and discovery in a beautifully crafted VR greenhouse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://contenidoecuagenera.github.io/green-garden-privacy/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ecuagenera", "support_website_url": null, "website_url": "https://ecuagenera.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922140294505620"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro
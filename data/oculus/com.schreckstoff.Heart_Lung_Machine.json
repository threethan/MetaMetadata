uluscdn.com&oh=00_AfvMMBaDZKU7LJF27-nrkVOMHB9FKOHk5kGXtXzMOQhsBg&oe=69A2D3F8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vef59aW-KN4Q7kNvwEUy33X&_nc_oc=AdkMDbcwUsE7ukzHkrj5K3eheOS-QSmZ_X5X85v2PfdVOdP1_e-muVLHoet8wvMVKTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRWKGAwh58zOND9ZWUAjMWdAI0o0Z6vmaWWDa9UNCq3A&oe=69A2DF17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HARMj1FRUwYQ7kNvwG1lhcT&_nc_oc=AdmSqN3I-ZF3d2tsXpgHJ8uvlk1BrYC19huQSIyEcZs_PIBS24VAVdhdQ2faQq47tx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afst_cVCyv0eWdHfnKLjg0WgsW2IzmbJlmgp1QHk4fSOQQ&oe=69A2E92F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
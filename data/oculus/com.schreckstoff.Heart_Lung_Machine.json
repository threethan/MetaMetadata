uluscdn.com&oh=00_AftyYIUZRSTKT-re8FU7AK5KUA-H2nx6OZyW2mxVmhOmXg&oe=699D8DF8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRakyuKRn5wQ7kNvwEVIRCl&_nc_oc=Adl1Kn9dhSoeOUPhSOICBdZ8G9FwMl-UHSexIB8KoYWAb50YtDgTtOXGJIY73P4TYfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3KN8j9WrvW9qZg8r5NuV--iEvwmc-J_ElJHIKLNIF5Q&oe=699D9917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVWjJ63H25wQ7kNvwEKRwnp&_nc_oc=AdlPJXjC4Gc1WfC3MGmjg6jcV7igOkXLhCtjP41KmupE4WhwxRDT3ZYpH96WJ3XOgfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKdo-sqY4xnyXgC-9K_12HKXonCmtvPxLSi1PG8fWrvw&oe=699DA32F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
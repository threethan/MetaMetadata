67"}, {"file_name": "sc_gotcha.png", "id": "1810406789710696", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393328_1810406793044029_4614968675109170400_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzAIGscsYiUQ7kNvwFQK5-x&_nc_oc=Adp3-pNVXoQLuOXPiu2qLDbOapeFYVpBZV07NuirwjK2NNzgcx3RslDTElaomISkbic&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDvSMYq05hyP5SzYdH_vBORTqXKOaI8tVCeRxA3-52zg&oe=6B09A438"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFA_Lo9TVvkQ7kNvwFmERv8&_nc_oc=AdpAkDsANuayaB90LfhRilwjO4UKhAj6MoWxMi4E9KeKbsZ8JEIqa_rO7H-OIEEYUdc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz9JOaay2dq-9jwOGO-2w0HkLk-PTeHqAFqK1SNI0wjw&oe=6B09AF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKkDOIBrVAMQ7kNvwEcZEA0&_nc_oc=AdouyFJfV33h-m7--dYM-Z4kOUKdB38-8zYlysOGhG8nv-7OC0AQM5nfe62iOIlZYHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3D29XuWidlN7X4WIPDhoPoVHls8bz0l5OpQ8pYmyTNw&oe=6B09B96F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621289470847298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_1008591807331946_1284254622726315146_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcT8DGbfi-EQ7kNvwF5mnCb&_nc_oc=AdomIMvywNqOvZxzAnbk8VBUNcGOX3Pi2U3d88QH64hMLPO5wQGipw916RVQ66yAWIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPzinNDrWFicNage6rrQsjDhlBb2h7QNNvZSrwLx9tfA&oe=6B09B4AD"}, "is_con
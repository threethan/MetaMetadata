uluscdn.com&oh=00_AfufKr2LVLVS5xHTaGHn7iAXZmZHth4E3JeDnrID5tmD5w&oe=69A030F8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vef59aW-KN4Q7kNvwEFitJh&_nc_oc=AdmZoa9O34Qw6budorzOdUd58f0aeSVdZsUwIS6ffZ58Zs8qFSx8h0ip_J_EQCKBkrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0EKlJROTyIM4GqmfeDY6RBhETzrKAo1Cv2GjUNGGuIA&oe=69A03C17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYbZYy-7-6wQ7kNvwGGuihd&_nc_oc=AdkomoVN-E1B-fnt-I_bfWGA8-CSf-gDuVyXeaQpLp52CpWCM_B30FnJRzfiMuIODIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEYkNTM3L8E19sEt8oBDBxqW_aebFke6-0cNOqkH1MWg&oe=69A0462F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
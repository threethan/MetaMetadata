uluscdn.com&oh=00_Aft5DpclsN_BowKjl-v6aq1Zcst41iC-Mm1NEohDj4zjsQ&oe=699C3C78"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRakyuKRn5wQ7kNvwHG6a__&_nc_oc=AdkSP-o_XIJspdjKL1zb7I-yDHrYjKh4cEBXRjEGz_XA_7gO_M3vkoHpRVpHhaGMfq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuLF67eEJBxsA1C1yxVq5S0jUcXU-KcWH9oIR7acbt25Q&oe=699C4797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVWjJ63H25wQ7kNvwEKJGu9&_nc_oc=AdnmzA2aHPh_v6xt-0Y_vVZWCMn91s8oQnNY3tP2pC6PShF-sYrymVktuIW5IDHZoiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvf-a5gjl9iWf5AUqMD25LZXxmLCXF6s7sJFXfJIR_lNw&oe=699C51AF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
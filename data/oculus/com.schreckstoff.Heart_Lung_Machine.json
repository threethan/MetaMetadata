67"}, {"file_name": "sc_gotcha.png", "id": "1810406789710696", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393328_1810406793044029_4614968675109170400_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ba5Na-Xsh8Q7kNvwEZ3Jh-&_nc_oc=AdopjI0nIm-FChsz1UsoIkc4yssx5Hhrds1SF_EAnb-TQIaxFhe1ciuOhB2ylkzijb8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBty2ZTuGDKeNrNV1Ijj0bhgMSU-hPInjhS-igdxGPpg&oe=6AFF1838"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5zulf-c8nwQ7kNvwEXNXmm&_nc_oc=AdpX5GdNxbGE-Rb0EGXhLs8m_CPuZWSrYCd13S3tuJ0YH57ohMZYuDB_j4iREMEY_Ok&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_e5WApHBozHWiDI749rpZW5j9KAV6j5PBSSt_Lx85iA&oe=6AFF2357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUPoG06qreQQ7kNvwFZLfs0&_nc_oc=AdpZIX_uADDBgH7-qHLGKOtEI8vbAJrb4aU_yT-7UeFdMXBIIIGFmPRpsnkfL_MtOFs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX06GmeAM-Y8nSaMF_1HFOBpyE4NNK0mSKS-lmg5ZGhw&oe=6AFF2D6F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621289470847298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_1008591807331946_1284254622726315146_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUHipcJdIYMQ7kNvwHUc-L3&_nc_oc=AdoV44lFBBjuDPdVh8Bis66V585KF5YollDqq5aG3oKhTQoMdblVLZKLCaOVquZwCFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLhXZooKPqibVs8MuIMWhTg3Jep02z1ce56UqMN27rvw&oe=6AFF28AD"}, "is_con
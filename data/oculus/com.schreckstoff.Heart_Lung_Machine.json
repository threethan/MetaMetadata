uluscdn.com&oh=00_Aftm41dwL_5eLNJYdV-LKuJht6V_2AMgmNngnCFNwFdssw&oe=699AEAF8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuC8frKMyWsQ7kNvwGLHGF7&_nc_oc=AdnR4P4a4hEUHRV2PN-CRQXjc-de4ph1l97wManMb4o8KXlPQzonmAvLkldKmKp56jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfueksCT89KpM6-hBNfU1ZDwmN9G1f5w81R3Yh3h3iiSqg&oe=699AF617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVWjJ63H25wQ7kNvwE2yvpv&_nc_oc=AdmtRHVPnBBJ12qC_qi2kZGgqf9z2NGRYJ4VuYrDJTkhEO0pM-02xKBFnuYyE2EXH7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvh0B0SMNlY-jq29rNRK28JGMDLnyalP5KkWJkaxQoBlw&oe=699B002F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VaDpNEsy_3KCM1cEkgZ8b-28CbnkX22IvQW4K1_uAuQ&oe=69EA2BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1040510587785370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391923_1040510591118703_2250977284536817096_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTmCCSlwh_oQ7kNvwH3EWWM&_nc_oc=Ado_ZaoqRe5mx-cd_f_dbySkzaqD12D7tmmtVN6reAFmlDaQpLaJGnp8FeP0n1CYlNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SH6KDRRO4tQOTur-tp6r2G7g03e4XO_1Hlm7zXFK06Q&oe=69EA309F"}, "display_name": "Heart-Lung Machine", "keywords": ["horror", "stealth", "monster", "bunker"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{1133132718364961}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274
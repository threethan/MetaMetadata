.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP71a_m_32-7MgiHGiiOVY6P9ZuHYl9OVt_ch7f1sLmjQ&oe=6AE3575A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1040510587785370", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391923_1040510591118703_2250977284536817096_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnRGauU3FjwQ7kNvwGuPUR0&_nc_oc=Adpxhxk_r1v_17C2dja7Ka12yQi5Tvny2s-uv170JLrpfv74RLiRU4CIL1X0WVp0-qE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCwaTe-6vSdzSIFPNK-LqSNi2t8vw57UEhzZQe8j7N_A&oe=6AE35C1F"}, "display_name": "Heart-Lung Machine", "keywords": ["horror", "stealth", "monster", "bunker"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{1133132718364961}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274
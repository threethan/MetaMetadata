uluscdn.com&oh=00_AfsWkYqBKXQDo7_JoIDfNBeoGuWaL2Vo-Fw8rsykTaljhA&oe=69A18278"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vef59aW-KN4Q7kNvwF71zpo&_nc_oc=Adnxjou6wNiwEpbX0s7_Y6n-gR0mln2-u4SVXI6ELv4yThhM9RwQjNdlCFSJA7RQXn8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu1mqIGFZS6POKff4WyMEd5YxNaXU_TIe6IelHiZjuPRg&oe=69A18D97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYbZYy-7-6wQ7kNvwHa4YEo&_nc_oc=Adkv3RTZKZC82TLHp0J9gJPbnT7AwKvWtBzkwaKeH9cKHE7RYijHjkt6pIacbyc_V28&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftP33M2y7etvrEa7OGyqXojijT5tbeGmKoL9G78D3e4aQ&oe=69A197AF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
uluscdn.com&oh=00_Aft4TD5WF7ua03ACTq3PA0SqPFtZgo0ybMZD6AyoD6uFbg&oe=69A6C878"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9KWGaTm8IgQ7kNvwHh-q_Y&_nc_oc=Adn_0s5rD2YAecs5HsWjFvOyjsg-9X1WX-LTAWTmjpCFKHGqo8peUGZCnZgwoZvnJ9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMySaIQ0SriRIlZIOG4foxqYZhoLw-SmbD0LcnD3BXtg&oe=69A6D397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwGG02_O_WwQ7kNvwFbC4nh&_nc_oc=Adnum5pZTxPygxV5sBO_1dCFnHclTDYV0ofgrWzceCM1XgtRmJU_8AbBvsqMH_oGD0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afta7aaENea85qAHTMLd1O3uUnaM72mWwhO90WNLTTXEQQ&oe=69A6DDAF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
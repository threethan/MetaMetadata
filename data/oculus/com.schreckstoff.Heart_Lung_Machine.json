vwEggAm0&_nc_oc=AdqUzmlvcA6vn8KRUDFPMEohyVetYAz00ZcS_-bebzYQunFng5qJKBZ1V_oi1fy6iDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmZyFLv0FloxKO7K6ByTEd7a8GE6nu77RfgwB0hR4g4g&oe=69CFA6F8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DzoHAYB-LkQ7kNvwFE2CGr&_nc_oc=AdqRnAWyjDzt7ux62GnCnVcISarcfcax1Ez_ZZ7OFBxkHwFYV5-ymnPN1ZU67UAe8kw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuzoGSnGF6aEDdK_U8WvHKkv-H4Pa8xh9D98SNJObFMQ&oe=69CFB217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgWD20mUmvAQ7kNvwGgI7Ic&_nc_oc=AdoE-WUVvnOgeZgwVavR3EdB1giKRSgSmPrTPFJjeYyiUVD9ISjibOshgvL8yUhnu1k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcxCMB1S-flT1T_jO0s57ZE_gHz6WY9E03xHU_E1_BBA&oe=69CFBC2F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotte
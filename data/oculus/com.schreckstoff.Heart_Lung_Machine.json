erience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621289470847298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1008591807331946_1284254622726315146_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOp_ycHyjJYQ7kNvwHa_k2a&_nc_oc=Adp80Q4idJ5r5_0KNBdyjDQ0mcu3bbsorkbKqg9U83wa_QvPzeKXwSR5Lot8oboO0hA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5CpUDyty8sdgGxsCrLmiC4dNdiVHTLFcxro6e3GZOew&oe=6B05C02D"}, "is_con
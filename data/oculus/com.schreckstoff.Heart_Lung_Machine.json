uluscdn.com&oh=00_AfshuqR3BEbU1MmsyQMD62Gffwxa_JIPisyhYMafquEPwA&oe=69A42578"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9KWGaTm8IgQ7kNvwFj-irT&_nc_oc=AdketLlhTppt0x3gwDq2PJSK0KlHYouy8W02jKEFpwhNVp1uMEW2UPSMGIC-LZp4nxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRRmFK6rW5ynZhre4wyKncwoeBgEbEugXgZFrrRROOVA&oe=69A43097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HARMj1FRUwYQ7kNvwEXgj8K&_nc_oc=Adkt7rtRz9zQu6Iu4k60yZhZhLa5Lp0RuwAZezkfGv16tCUP18cxtBT5_UpVcanaclQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvjOr1NfHeV-5Kc9Q_XsrmSkGfFx7PWzdMHwJJ7fZ5zeA&oe=69A43AAF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
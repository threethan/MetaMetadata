uluscdn.com&oh=00_AfuwoA0D5I-CEMVK3q0mNK2sdp1pCAN8MbWMtrTHvjtupQ&oe=699847F8"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuC8frKMyWsQ7kNvwHG-AZo&_nc_oc=Adm_PfkMnulmSID3c3NqHioE0rmR-HomiweX61-R1pTDq_BNe7DuR6CrgM7abOU11Us&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvC6K2y16FrqzxzIpEUVSNzeqgURjGG4tZOAnYvlB3heQ&oe=69985317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l6MDXCTNhkQ7kNvwHHYx6u&_nc_oc=AdnYEUCLZJKK7lnUB2P9Ccmn3GrerHgfMUQtuuV4h7jiLI2k1xl3rMKJMso5dlxg9qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft3mHVZ9MGs_WtuOuTl_jQFz_kHRzFSF7Yl29nznXkVIQ&oe=69985D2F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
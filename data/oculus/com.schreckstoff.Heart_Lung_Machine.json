uluscdn.com&oh=00_Aftli3DLglEqQbUEtYheNvDIUouiV_X5aejn2BkCCQmSWA&oe=69999978"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuC8frKMyWsQ7kNvwEXffck&_nc_oc=AdmtxGAyAvL3LjgGxcs8Hb4Q7gAqw6fyXIdm8Y5cK49xDS3vrDn6dZrddNIS8oiMrsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxfIJGbOlrV-yiauS9JJW2zyT7vfXDgUINckzH8fyvQA&oe=6999A497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l6MDXCTNhkQ7kNvwEebSyU&_nc_oc=AdllRUo8xpEHO2iR5ezuF-5O7W6pI5NASdFmGnveNPI-sE9QP1Wm9bkXdWU9fv3wPvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMzJia_neqB5qyowvDlHAIsOJ5xWRShA7LV006XdTt5A&oe=6999AEAF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
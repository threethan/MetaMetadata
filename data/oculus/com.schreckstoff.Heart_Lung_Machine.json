vwFAkuw1&_nc_oc=AdqOwkbN3JRxbL33vSR8ghXxTD2Ryw21DNAWaUnPhAngrF4apZ93qA0oSS6YydzHBcw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyQjAf5hgeb_6TjjGwBqb-NoitVLLq2fFX7YE2xsS1mw&oe=6A941678"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ_7v7jXR4oQ7kNvwE8bfEA&_nc_oc=Adoxy2orid98Is8iu83sUyQ97scl73JQEFeez8gJdn0DDoKuEvWPgeHZ3wKcq3z4tik&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU_81CNC2E9WXqk7HAWCPosxD771-KW-bm2ql265FAtw&oe=6A942197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1Bud4hrC-YQ7kNvwFydMXr&_nc_oc=AdrVK7cA5xA2odgyoNkwK1U3krsA0YvFV3XM16pbvavYTTweUmbtMd-RqtD9h8PxIGg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO2LiIrc_6cx-VBEhMVUs-F1MDGykUYXlkFgd2iJIVeA&oe=6A942BAF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621289470847298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391998_1008591807331946_1284254622726315146_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQDhCjLQ3LUQ7kNvwEXJrF8&_nc_oc=Adomz6Vkfg3T5ss24MgSjgSfEAY9bKAdHtG4w4fAvBRvBqFgdZ7-r54QVmqDuD0OWDA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR7PF54S_JYP9Bh_CXbPoMyOQG5hlKoOPQSDYsFelFSw&oe=6A9426ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heart Lung Machine", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"top
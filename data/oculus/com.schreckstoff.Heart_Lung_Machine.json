uluscdn.com&oh=00_AfvfLW0na_ZOiJcHRW3bBBMkIHR_z4EEcTP_BTNKcg-4Jw&oe=699EDF78"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRakyuKRn5wQ7kNvwFUIAzK&_nc_oc=AdmBQvOP9QcBaXW0B-gAQlTL6H3z-WcPacUz10xnxqdPEK3zGIuDDo21p2PGrgoS8Ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5iVpHuaMSKaNh7x15koFpMyEB7c6RalI5XiHVWkiTdA&oe=699EEA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYbZYy-7-6wQ7kNvwHFJLRk&_nc_oc=Adm9vg3loSVMawTO32hXqlbif_we9Se7Fkv9OJcbF9o1Q5G4Q_7sy1YAhaqx_b0rRaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfthrjRHhsztRRysNR5ARazk8RoVrA5HdVzu_eOC4vqoaQ&oe=699EF4AF"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!
67"}, {"file_name": "sc_gotcha.png", "id": "1810406789710696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1810406793044029_4614968675109170400_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JmABldccNgQ7kNvwFvDZ7Y&_nc_oc=AdoN4qZ0F9xUgbsBrUHORn-YIiFwqQenrN0wPnICN2QAklFG3xfuU7U4w65jJFOqGSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViDW7wzGspuiBA4TKddAez8S4cpBZxwQKY0YgJZnOXhg&oe=6B0F2278"}, {"file_name": "sc_storage.png", "id": "1773472076764009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1773472080097342_7912265992722539606_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjKreuhuTbAQ7kNvwEc44g2&_nc_oc=AdrQaUG5QuxY7CvLQtx3JR2uNqYhPCi2aHx6UwmDCqwtTvz168PUXJ7N__OuzJ7J5kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgH9ERwGkN6V0zKoN88vqhmVFEXzPVDyiRYz_61cC1hg&oe=6B0EF557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alt2_headercapsule_16-9.png", "id": "814528898315674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_814528901649007_3720009396097777677_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orK4ipFRRZIQ7kNvwG2ieaI&_nc_oc=AdrM57KvAUgl_RVueNJC_FA2D6LJ2wblkhaKXcAywWE-2BcLfLxAlyRJRZlqn87DWcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPwOb6xDP6kJ-OAeBCqelVLCDXd8UQDfESXmucxvzRGw&oe=6B0EFF6F"}, "display_name": "Heart Lung Machine", "keywords": ["horror", "stealth", "bunker", "scary", "Psychological"], "long_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets about the facility's past and experience the ultimate VR horror!\n\n{552182744443557}\n\n**The threat is real:** The game's AI operates autonomously, presenting an unpredictable and relentless challenge. Stay stealthy, or risk drawing its deadly attention.\n\n**Experience true-to-life hiding mechanics:** physically crouch behind objects, crawl into shafts, slide under tables, or squeeze into lockers to hide.\n\n- AI-driven Monster\n- Realistic Hiding Mechanics\n- Randomized Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24621289470847298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1008591807331946_1284254622726315146_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7ZStbbCslAQ7kNvwFVJQSa&_nc_oc=AdqsCNstQfqi8Nso0bh8o-e3aP0VrSZW0LT1IQMxLpqugeB4C1QaPkF9KJpykF1akvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMgLW5hKgiHkUzWhELKn06WLy16f1NT-UQS4ONiKDEYg&oe=6B0EFAAD"}, "is_con
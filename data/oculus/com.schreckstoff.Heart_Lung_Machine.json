ed Elements\n- Hardcore Survival Horror \n- Dark Topics", "short_description": "Trapped in a forgotten underground facility, you must physically crawl and hide to survive a relentless monster. Uncover disturbing secrets and experience the ultimate VR horror!"}]}, "developer_name": "Hermann Hetzer", "developer_privacy_policy_url": "https://www.heart-lung-machine.com/heart-lung-machine/app-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Schreckstoff", "support_website_url": null, "website_url": "https://www.heart-lung-machine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8987806254622205"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1161453409847903"}, {"status": "PUBLISHED", "id": "1775687196793385"}, {"status": "PUBLISHED", "id": "1670250004067731"}, {"status": "PUBLISHED", "id": "1604612608062500"}, {"status": "PUBLISHED", "id": "36188651444067197"}, {"status": "PUBLISHED", "id": "1627887791686662"}, {"status": "PUBLISHED", "id": "26261447640127904"}, {"status": "PUBLISHED", "id": "1988033595390906"}, {"status": "PUBLISHED", "id": "842462628396082"}, {"status": "PUBLISHED", "id": "1110970421242556"}, {"status": "PUBLISHED", "id": "1313494433509244"}, {"status": "PUBLISHED", "id": "1042383034321246"}, {"status": "PUBLISHED", "id": "690072486721849"}, {"status": "PUBLISHED", "id": "93935685740
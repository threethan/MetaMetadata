12427666_606806356154725_856457470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TziqH90puUkQ7kNvwE3Z8aN&_nc_oc=AdrjkooEdxAwMZnXcfUr86EgUCUKCHQ7ZUoLZf_ZaZeJUH6b91yPj2PVcqIsm1wlnnw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qi3yEILM2vA34KG_cOjeNtwjsHzj-yDISX9c4K60aWQ&oe=6A11C5C5"}, {"file_name": "migrated_image.png", "id": "634299220448349", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12449015_1690735187851840_581939041_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1_MSUq6TiAQ7kNvwG3aniQ&_nc_oc=AdrB03EEzy-0XjNmGP9gKBD9P-XJi7XCyUS4-Pfl9N8f8_f10FcBknOaJ460sh2NHcE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6edVQfIpeA4OTkVvuLm2cYxA87XajwfBbRL85cNjt_1A&oe=6A11CF1A"}, {"file_name": "migrated_image.png", "id": "227623631720177", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12448848_975187145933027_990241602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj3A1POplykQ7kNvwHaf-L-&_nc_oc=Adqv9vm6BBzv67c-2kda1c_pBe4MoSM7Iflv-9cD5JdKlhQsALELozTaaWz6ghKYCB4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o3T1qZch66PEHyDQS0-xaAdHiLfXqD7pDso9KgwxZOA&oe=6A11B2BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sketchfab VR", "keywords": ["sketchfab", "cultural", "places", "education", "science"], "long_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders.\n\nSketchfab is the platform to publish and explore a million things in 3D and VR. With a community of over half a million creators, it is the largest library of user generated VR content in the world. We selected some of the best experiences for you - discover them now!\n\nYou can also browse the entire gallery in VR using the Samsung browser in the Gear VR, enabling WebVR by going to internet://webvr-enable, and clicking on the VR button on any model.", "short_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sketchfab.com/privacy", "developer_terms_of_service_url": "http://sketchfab.com/terms", "publisher_name": "Sketchfab", "support_website_url": null, "website_url": "http://sketchfab.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ART_CREATIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466166215148548"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138836_1596292744015587_433885596_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHTpmKM0Bm0Q7kNvwHXXAdS&_nc_oc=AdpAVDyN8Zh6ySX5xT2JmsrjFXZK4XEamc42CGKFeVoZysOwW_M4gfdO-HWKz1oMu_g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A1ca0kF_ZNqoUjF7OdGyWHGvQT1p_v8-m3-z1ZIIuTA&oe=6A11A234"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sketchfab VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1464764400, "lastRevision": {"nodes": [{"id": "1526652900977671", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "95788734098
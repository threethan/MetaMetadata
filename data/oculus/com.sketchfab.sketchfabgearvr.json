25/12427666_606806356154725_856457470_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyJBrSrewC0Q7kNvwEGX1At&_nc_oc=AdqzgwN6Ml71G88BuBdIFuwEUWZZ_GFX019VQXHx04PNaHDeeWssEMX42qcm0lGkDvA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdcXkiDEgduIlnrgQHB3Y5MODJbDWJfXh-Y-vrl5ClkQ&oe=6A8D7A85"}, {"file_name": "migrated_image.png", "id": "634299220448349", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12449015_1690735187851840_581939041_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rIWkQ-XZkQQ7kNvwFeOxL5&_nc_oc=AdrSi5BTJKcjxm-2cZZzxeanZ0D-Sz6LIguQUG5FLnTxt6nidGIYU_lynJx_nUz2uH8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrbzRyXErWKfvPyWFmeKJJ3AO32LC3xOJh7ld3lLLe-g&oe=6A8D83DA"}, {"file_name": "migrated_image.png", "id": "227623631720177", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12448848_975187145933027_990241602_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2sZpe703A4Q7kNvwHJnuMp&_nc_oc=Adr3yL_qX3tk6YWw3VHr0ZUOMayIxd3OCa1g8Bdx2PgpBeLM_n6A9r3772Q4W6Me8DU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAGOiLQOSJ8-ZrkpgMNz8DZwTd5lj6LGJlm9acvRBs0g&oe=6A8D677F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sketchfab VR", "keywords": ["sketchfab", "cultural", "places", "education", "science"], "long_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders.\n\nSketchfab is the platform to publish and explore a million things in 3D and VR. With a community of over half a million creators, it is the largest library of user generated VR content in the world. We selected some of the best experiences for you - discover them now!\n\nYou can also browse the entire gallery in VR using the Samsung browser in the Gear VR, enabling WebVR by going to internet://webvr-enable, and clicking on the VR button on any model.", "short_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sketchfab.com/privacy", "developer_terms_of_service_url": "http://sketchfab.com/terms", "publisher_name": "Sketchfab", "support_website_url": null, "website_url": "http://sketchfab.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ART_CREATIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466166215148548"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138836_1596292744015587_433885596_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYxz-xZPAhMQ7kNvwEYtcBr&_nc_oc=AdrYYspIRYbOkGR6feNY-TsFkf5qJwi44ymS4BYpPz6LuLbMRRLjo6iV4F9cWoC7iew&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECx7dpqxLc0olW5kV0RdVFzpKORL9A0SZUItudLVweQg&oe=6A8D8F34"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sketchfab VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1464764400, "lastRevision": {"nodes": [{"id": "1526652900977671", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "95788734098
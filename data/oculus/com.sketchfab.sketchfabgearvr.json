r half a million creators, it is the largest library of user generated VR content in the world. We selected some of the best experiences for you - discover them now!\n\nYou can also browse the entire gallery in VR using the Samsung browser in the Gear VR, enabling WebVR by going to internet://webvr-enable, and clicking on the VR button on any model.", "short_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sketchfab.com/privacy", "developer_terms_of_service_url": "http://sketchfab.com/terms", "publisher_name": "Sketchfab", "support_website_url": null, "website_url": "http://sketchfab.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ART_CREATIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466166215148548"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138836_1596292744015587_433885596_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Q8YRBcn7sQ7kNvwEbOBEW&_nc_oc=Adopq6A0r9pGf2_JfPi0lwaOFAguBhXSY_0Zx9xZ93NF8r_M4_aak8c686bBTzJ_V8w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXQNBwe5iSHHXIS8VQAsV4fdE6-pAZleuG5nyvXPL8Yg&oe=6B0862F4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
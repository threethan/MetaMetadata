com/v/t64.5771-25/12427670_809056779225902_161800765_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFS24dOTXk8Q7kNvwFsR-bx&_nc_oc=AdpGIymweM3gYpEwLkwcYXkhnQuDZrO6ANqc_56SWTTh-DLN4a9RU9O2pyIwLnl3G74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS0rZ6z1G1BV15JqKguPYdCSVbFmpB8VyMQyQbw1niwQ&oe=6B01B7D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sketchfab VR", "keywords": ["sketchfab", "cultural", "places", "education", "science"], "long_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders.\n\nSketchfab is the platform to publish and explore a million things in 3D and VR. With a community of over half a million creators, it is the largest library of user generated VR content in the world. We selected some of the best experiences for you - discover them now!\n\nYou can also browse the entire gallery in VR using the Samsung browser in the Gear VR, enabling WebVR by going to internet://webvr-enable, and clicking on the VR button on any model.", "short_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sketchfab.com/privacy", "developer_terms_of_service_url": "http://sketchfab.com/terms", "publisher_name": "Sketchfab", "support_website_url": null, "website_url": "http://sketchfab.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": nul
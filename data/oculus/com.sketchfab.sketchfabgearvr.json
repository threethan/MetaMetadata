_description": "Teleport yourself to Rome, hold a beating heart, or walk among dinosaurs. Open Sketchfab VR to discover a showcase of explorations through remote places, fantastic creatures, game worlds, cultural heritage, science and other wonders."}]}, "developer_name": null, "developer_privacy_policy_url": "http://sketchfab.com/privacy", "developer_terms_of_service_url": "http://sketchfab.com/terms", "publisher_name": "Sketchfab", "support_website_url": null, "website_url": "http://sketchfab.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ART_CREATIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466166215148548"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138836_1596292744015587_433885596_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzFrBgtGxP8Q7kNvwHMD6JT&_nc_oc=AdmElwznPaFZROxmslTY4n6iNlLGfvn3GOpn6lMjDFEJulfGzLcidE_pM7bL-AjuDVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOeUmHDo6zkUbo6nxdyz5TuM28z45HmnTAVs_bOwXOEg&oe=69BD4234"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sketchfab VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1464764400, "lastRevision": {"nodes": [{"id": "1526652900977671", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "957887340986022", "is_first_party": false, "enables_in_app_ads": false, "is_c
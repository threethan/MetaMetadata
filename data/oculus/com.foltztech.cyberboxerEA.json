21958472025325_1175396582022802569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeNMwXT3gkwQ7kNvwGupUfv&_nc_oc=Adqblpf9-niDWm0vYDStmyb_SOie4tvj1EcS30EMGBpMRHr13MkzNpQ0srahAicG_q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jl-M1--llJ5Bk6Quzi1PYmZ3zqH6TROrnbxtt8oJfJw&oe=69F74463"}, {"file_name": "5.png", "id": "1508196443481903", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299795_1508196446815236_5667301067523467873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=549f6PRkbu4Q7kNvwEzY81Y&_nc_oc=AdorrdXDSZ_M4RFU5H9NC1gFvsXR3qK6z1dZv7N5HwERPtWbhxBbYrh1L7G5J1PzMA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OYvsc2nqZdYzeturNBcz5cV3dRZ5B3MTBPXrMig5hlw&oe=69F73DC9"}, {"file_name": "2.png", "id": "893445626948766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303386_893445630282099_8655114936017669750_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djL-AClp1_wQ7kNvwEeL57l&_nc_oc=AdoWGH98ChEtEcVG0apxoMQ0alhx2AIKzbFA6Pf5QB-EyQq3FPxuyhOSP9g-j8BZMD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M0fHcxwUW13_-RwkxicJz3YJU6WCu-7jrm0BMVA1CdA&oe=69F73E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "635633692318012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818916_635633695651345_5561461355952636106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcS4k8nyQqUQ7kNvwH34EE5&_nc_oc=AdoYy773IiZkynaTsAEVJCLjPkrWwBZ3tpNvfIXKGVMNjdQWQ3e3z0Bj2GpF-HtaXNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_gIvzzYAGVb10VHM4gb34O9_6-qFY7ihcKg4UYo1UZw&oe=69F75ECA"}, "display_name": "Cyber Boxer", "keywords": [], "long_description": "Step onto the rocketboard and throw punches like your fitness depends on it\u2014because it does.\nCyber Boxer is a high-intensity VR fitness game that blends shadowboxing, cardio training, and rhythm-action gameplay into a futuristic workout experience. Soar through space on a flaming rocketboard while dodging slip bars and punching glowing targets to the beat of an electrifying soundtrack produced by DESREN.\n\nDesigned to improve your cardiovascular health, reaction time, and focus, every round of Cyber Boxer feels a great cardio workout\u2014only way more fun. Whether you're looking to sweat, de-stress, or shred calories, Cyber Boxer turns exercise into a game you\u2019ll want to come back to.\n\n\ud83d\udef0 Key Features:\n\n\ud83d\udd25 Shadowboxing VR combat \u2014 punch and dodge to survive in space\n\n\ud83c\udfb5 Original custom soundtrack packed with EDM, house, and dubstep bangers by DESREN.\n\n\ud83e\udde0 Reaction-training targets and slip bars designed to challenge your speed and coordination\n\n\ud83d\udcc8 Built-in calorie tracker with session feedback\n\n\ud83d\udd79\ufe0f No joystick movement \u2014 pure room-scale immersion for Meta Quest\n\n\ud83d\udcaa Whether you\u2019re starting a fitness journey or pushing yourself to the next level, Cyber Boxer adapts to your pace while keeping things intense and fun.\n\n\ud83d\udd2e Upcoming Features (Planned in Future Updates):\n\u2705 New tracks! Expect new bangers to be added with every update!\n\n\u2705 XR passthrough mode for mixed-reality boxing\n\n\u2705 Multiplayer and leaderboards to compete with friends and rivals\n\n\u2705 New songs & difficulty modes, including ", "short_description": "Get fit in VR! Punch, dodge, and soar to amazing high-intensity EDM, house, and dubstep ear candy produced by DESREN."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTt4SMVKKLGF5tpU6mUuoSRuE68gEPxhInXim0L4DK2HvpW3oPnxorlDw92QK5E3bBOYnwcjrTCdGGu/pub", "developer_terms_of_service_url": null, "publisher_name": "FOLTZ TECH LLC", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vTt4SMVKKLGF5tpU6mUuoSRuE68gEPxhInXim0L4DK2HvpW3oPnxorlDw92QK5E3bBOYnwcjrTCdGGu/pub", "category": null, "comfort_
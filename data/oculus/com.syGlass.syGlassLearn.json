e7a0a&_nc_ohc=-JhcxznXOxEQ7kNvwEDVFHO&_nc_oc=AdqOIKGmmf2nQbWYWzBvC88mzkiRybqWkSJJaMPgsHIDVqBoWRSFJWNlQktVgMoouug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAhw7DL9x6svveucaG9ILfxpGxBqyj51U6aA436sSag&oe=6AFDD165"}, {"file_name": "com.syGlass.syGlassLearn-20260521-113151.png", "id": "1702887944464800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_1702887947798133_2805578916152741566_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOsvfOKS9PQQ7kNvwE2MkNb&_nc_oc=AdpZZ4rM-JcOnTe7tAphN-KSEiHZgUehmMNMzDvDr-efBg0ihJ6OeraPKaPI2Kv_kYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVa3WN2QhWP4OGc8uGvEjmA2KP6bg6pFDdWdczP5fcKQ&oe=6AFDD922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "syGlassLearnCover.png", "id": "1323760736603646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623115_1323760739936979_1252213035731096720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQs0CHpWfJAQ7kNvwFZnnsB&_nc_oc=AdqYgDEpEz3_rsvWJZwEwKy-480AYq8Xx28mXpm9f9PzS595tASe1PGxQouSQRwkbCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNQBNLjwAcAxiuUZ4ZkGM6H76HJghSA2PRg75MhDjPuw&oe=6AFDC2E7"}, "display_name": "syGlass Learn", "keywords": ["Learning", "Anatomy", "Education", "Nursing", "Premed"], "long_description": "**Learn Anatomy in a More Immersive Way**\n\nLaunching with a complete undergraduate-level Anatomy course, syGlass Learn showcases how immersive lecture recordings can support deeper understanding of the human body. Learners can follow structured lessons, review challenging concepts, and explore anatomical relationships in a way that feels more interactive than traditional video. Built-in active learning and assessment opportunities help students check their understanding as they progress, reinforce key concepts through applied practice, and identify areas that may need additional review. \n\nWith syGlass Learn, users can:\n\n- View recorded lectures created by Dr. Derek Harmon\n- Study a full undergraduate Anatomy course\n- Pause, replay, and revisit lessons anytime\n- Strengthen understanding of spatial anatomy\n- Learn through guided, visual course content\n\nWhether preparing for class, reviewing for exams, or exploring anatomy independently, syGlass Learn provides a focused platform for immersive education.", "short_description": "syGlass Learn brings immersive lectures from Dr. Derek Harmon, a university anatomy professor, to an engaging, visual learning experience. Designed for students, educators, and curious learners, the app makes it easier to revisit complex topics, study at your own pace, and connect common textbook topics with rich 3D content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.syglass.io/s/syGlass-Learn-Privacy-Policy-2026.pdf", "developer_terms_of_service_url": null, "publisher_name": "syGlass Inc.", "support_website_url": null, "website_url": "https://www.syglass.io/education", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28283358448027668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299051_2207320433160530_1021745674398072513_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlge
&oh=00_AQIOpJCqodIyYuhCK8BZ67dudlemLsQwm4axlEPs3cq4Yg&oe=6ABD2349"}, {"file_name": "syGlassLearn_Endocrine_System_And_Exercise_Snippet - frame at 7m21s.png", "id": "1265596122325372", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307444_1265596125658705_739086315428670555_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhJ8rkyfqwoQ7kNvwGS0CjP&_nc_oc=AdoDn9ZiU8CETocZMT0UtvyYqQU-uWgEu_mpySz5UVIUKnpTA0T_N1bfF7HJxScT08w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQTMNYQ3nEmE6ELiZRMFytPmJbvEdtyv57_vjWakbNUw&oe=6ABD3647"}, {"file_name": "syGlassLearn_Eye - frame at 6m0s.png", "id": "1498404781890591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302344_1498404785223924_8287670270049559166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qFadcaO7dgQ7kNvwGcWIYM&_nc_oc=AdoO5SWS6YVAW09tXk0yVqzZmQVE5If-0EcXE86qQhocTjg7Ow__IZERw8n9Wi_Ga5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcwsi9O3YbWUCXzwB4Pl8bZ7FSCgAKO8zHUyi0GFQt8g&oe=6ABD2667"}, {"file_name": "syGlassLearn_Lungs - frame at 1m12s.png", "id": "1982966255681043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1982966259014376_2387758249476354747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_unXSlnFe8Q7kNvwFf09hC&_nc_oc=AdoMyuOHns5dmst0NTHzL9Pw5mbopth7DWorWEAhxtAQxsHICM1ahaqloJ5LMNCkTXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq6QiDmHpY9oNaRxZ02N8J9jEtN6OFliOr6oC2vkzbfw&oe=6ABD37E5"}, {"file_name": "syGlassLearn_Endocrine_System_And_Exercise_Snippet - frame at 3m47s.png", "id": "1020737396946492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303769_1020737400279825_2045541842185947005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGuFjnwR_sUQ7kNvwHIcD8e&_nc_oc=AdovkNd98iMmblGai6ZEKG0ApxZxWnsFq-cf2eXYjWd0Twodap5TTnsllTGAhqv20Rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRNwkv2es_87T-lZ-yMhL0Dtq7253I2kYKe02KlufcGQ&oe=6ABD3746"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "syGlass Learn", "keywords": ["Learning", "Anatomy", "Education", "Nursing", "Premed"], "long_description": "**Learn Anatomy in a More Immersive Way**\n\nLaunching with a complete undergraduate-level Anatomy course, syGlass Learn showcases how immersive lecture recordings can support deeper understanding of the human body. Learners can follow structured lessons, review challenging concepts, and explore anatomical relationships in a way that feels more interactive than traditional video. Built-in active learning and assessment opportunities help students check their understanding as they progress, reinforce key concepts through applied practice, and identify areas that may need additional review. \n\nWith syGlass Learn, users can:\n\n- View recorded lectures created by Dr. Derek Harmon\n- Study a full undergraduate Anatomy course\n- Pause, replay, and revisit lessons anytime\n- Strengthen understanding of spatial anatomy\n- Learn through guided, visual course content\n\nWhether preparing for class, reviewing for exams, or exploring anatomy independently, syGlass Learn provides a focused platform for immersive education.", "short_description": "syGlass Learn brings immersive lectures from Dr. Derek Harmon, a university anatomy professor, to an engaging, visual learning experience. Designed for students, educators, and curious learners, the app makes it easier to revisit complex topics, study at your own pace, and connect common textbook topics with rich 3D content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.syglass.io/s/syGlass-Learn-Privacy-Policy-2026.pdf", "developer_terms_of_service_url": null, "publisher_name": "syGlass Inc.", "support_website_url": null, "website_url": "https://www.syglass.io/education", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25626202073743332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2458138254635995"}]}, "baseline_offer": {"id": "2458138254635995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779127200, "status": "PUBLISHED", "id": "2458138254635995"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28098460126517502", "version": "2.0.0"}, "id": "890772510472684", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28098460126517502"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- New lesson delivery system: Lessons and meshes now download from the syGlass Learn dashboard, reducing the overall app size.\n- Automatic upgrade for existing installations: Existing lessons and saved progress migrate to the new content system.\n- Faster loading: Improved mesh and texture loading, with loaded meshes reused when restarting or relaunching the same lecture.\n- More flexible exercise navigation: Launch an exercise directly and seek back into its lecture. Exercise answers remain available when returning while that presentation stays loaded.\n- More reliable label placement: Fixed intermittent attachment failures when moving labels between answers.\n- Improved exercise visuals: Corrected mesh visibility and positioning, label depth, hint visibility, and overlapping controller icons.\n- More consistent controller UI: Improved controller alignment and restored crosshairs correctly after returning from the menu.\n- More reliable lesson management: Fixed stale menu controls during downloads, improved loading-error handling, and ensured removing a lesson stops its playback.", "created_date": 1790188743, "id": "28098460126517502", "version": "2.0.0", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28098460126517502"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Fixed an issue where some objects could be highlighted but were otherwise invisible.\n- Added key terms to presentation details for easier reference.\n- Improved the selected presentation menu with scrolling.", "created_date": 1785428571, "id": "27395802446783277", "version": "1.0.5", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28098460126517502"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Removed the previous post-processing pipeline to improve performance, particularly while the menu is open.\n- Replaced the background grayscale effect with an optimized approximate bokeh blur.\n- Reduced unnecessary URP rendering work by removing unused renderer features.\n- Refactored mesh-opacity handling for simpler and more efficient visual-state updates.", "created_date": 1784661937, "id": "27294336633596526", "version": "1.0.4", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28098460126517502"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Grab and reposition models during interactive exercises.\n- Reset models to their original position using the new controller tool.\n- Improved label placement so labels stay attached to the correct model as it moves.\n- Added an option to hide the narrator avatar.\n- Narrator drawings now remain visible during label-dragging exercises.\n- Improved two-controller interactions when moving models and the full project.\n- Fixed controller crosshairs remaining hidden after placing labels.\n- Fixed some downloaded lectures not appearing correctly in the menu.\n- Refreshed menu button colors and artery/vein visuals.\n- General interaction and performance improvements.", "created_date": 1784047226, "id": "27216533608043496", "version": "1.0.3", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28098460126517502"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": null, "created_date": 1781789459, "id": "26928182656878594", "version": "1.0.2", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
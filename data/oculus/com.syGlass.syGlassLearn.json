content-ord5-1.oculuscdn.com/v/t64.5771-25/499303769_1020737400279825_2045541842185947005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSAohKdI89AQ7kNvwGnuDj2&_nc_oc=AdojA5XVw5fqUQD_yE4fPrLXs991dJkcoFHTeuaBaRxHkdozNpNzyY9JBACcLX4oAwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHGmoK3CFzlll2Mx9JWFpjPk8Fb1utvt5-0eDeo0ip1A&oe=6AFDD0C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "syGlass Learn", "keywords": ["Learning", "Anatomy", "Education", "Nursing", "Premed"], "long_description": "**Learn Anatomy in a More Immersive Way**\n\nLaunching with a complete undergraduate-level Anatomy course, syGlass Learn showcases how immersive lecture recordings can support deeper understanding of the human body. Learners can follow structured lessons, review challenging concepts, and explore anatomical relationships in a way that feels more interactive than traditional video. Built-in active learning and assessment opportunities help students check their understanding as they progress, reinforce key concepts through applied practice, and identify areas that may need additional review. \n\nWith syGlass Learn, users can:\n\n- View recorded lectures created by Dr. Derek Harmon\n- Study a full undergraduate Anatomy course\n- Pause, replay, and revisit lessons anytime\n- Strengthen understanding of spatial anatomy\n- Learn through guided, visual course content\n\nWhether preparing for class, reviewing for exams, or exploring anatomy independently, syGlass Learn provides a focused platform for immersive education.", "short_description": "syGlass Learn brings immersive lectures from Dr. Derek Harmon, a university anatomy professor, to an engaging, visual learning experience. Designed for students, educators, and curious learners, the app makes it easier to revisit complex topics, study at your own pace, and connect common textbook topics with rich 3D content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.syglass.io/s/syGlass-Learn-Privacy-Policy-2026.pdf", "developer_terms_of_service_url": null, "publisher_name": "syGlass Inc.", "support_website_url": null, "website_url": "https://www.syglass.io/education", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25626202073743332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2458138254635995"}]}, "baseline_offer": {"id": "2458138254635995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779127200, "status": "PUBLISHED", "id": "2458138254635995"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28659352743761568", "version": "2.0.2"}, "id": "890772510472684", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28659352743761568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- New guided VR tutorial: Explore the menus and practice moving, grabbing models, using playback controls, placing labels, and answering questions.\n- Preview lessons before downloading: View lesson descriptions, key terms, and available exercises before downloading.\n- More reliable downloads: Improved detection and repair of incomplete or damaged downloads. Removing a download keeps your learning progress.\n- Smoother playback: Improved audio synchronization when pausing and seeking. Returning from an exercise to the lecture now restores the narration view.", "created_date": 1793823092, "id": "28659352743761568", "version": "2.0.2", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28659352743761568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Answer targets now shrink with smaller models and stop growing beyond their default size.\n- Virtual controllers and pointers more closely match your physical controllers.\n- Fixed issues with anatomical model positioning and visibility when entering exercises.\n- Fixed submenu background transparency and overlapping labels, menus, and exercise prompts.\n- Users provided with a valid license file can access content without a Meta subscription. Initial activation requires internet; subsequent offline access is supported until the license expires.", "created_date": 1791388432, "id": "28271246149238898", "version": "2.0.1", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28659352743761568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- New lesson delivery system: Lessons and meshes now download from the syGlass Learn dashboard, reducing the overall app size.\n- Automatic upgrade for existing installations: Existing lessons and saved progress migrate to the new content system.\n- Faster loading: Improved mesh and texture loading, with loaded meshes reused when restarting or relaunching the same lecture.\n- More flexible exercise navigation: Launch an exercise directly and seek back into its lecture. Exercise answers remain available when returning while that presentation stays loaded.\n- More reliable label placement: Fixed intermittent attachment failures when moving labels between answers.\n- Improved exercise visuals: Corrected mesh visibility and positioning, label depth, hint visibility, and overlapping controller icons.\n- More consistent controller UI: Improved controller alignment and restored crosshairs correctly after returning from the menu.\n- More reliable lesson management: Fixed stale menu controls during downloads, improved loading-error handling, and ensured removing a lesson stops its playback.", "created_date": 1790188743, "id": "28098460126517502", "version": "2.0.0", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28659352743761568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Fixed an issue where some objects could be highlighted but were otherwise invisible.\n- Added key terms to presentation details for easier reference.\n- Improved the selected presentation menu with scrolling.", "created_date": 1785428571, "id": "27395802446783277", "version": "1.0.5", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25626202060410000", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28659352743761568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "890772510472684"}]}, "change_log": "- Removed the previous post-processing pipeline to improve performance, particularly while the menu is open.\n- Replaced the background grayscale effect with an optimized approximate bokeh blur.\n- Reduced unnecessary URP rendering work by removing unused renderer features.\n- Refactored mesh-opacity handling for simpler and more efficient visual-state updates.", "created_date": 1784661937, "id": "27294336633596526", "version": "1.0.4", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
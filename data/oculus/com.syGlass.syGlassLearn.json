76354747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_unXSlnFe8Q7kNvwFf09hC&_nc_oc=AdoMyuOHns5dmst0NTHzL9Pw5mbopth7DWorWEAhxtAQxsHICM1ahaqloJ5LMNCkTXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq6QiDmHpY9oNaRxZ02N8J9jEtN6OFliOr6oC2vkzbfw&oe=6ABD37E5"}, {"file_name": "com.syGlass.syGlassLearn-20260521-113151.png", "id": "1702887944464800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312263_1702887947798133_2805578916152741566_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8kHdKGx3XsQ7kNvwHEIVNO&_nc_oc=Adr7PHi32GwvMaNf07AS-t99dHgyxgSpM1DpWmlvQoRbxmqXGyMBbFtR3HZYVfF5pPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkLrh8nogIaLhCqme7EMDapSnxN--f0qfUUNMWaiYskw&oe=6ABD0762"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "syGlassLearnCover.png", "id": "1323760736603646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623115_1323760739936979_1252213035731096720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI9Bk8WKeo4Q7kNvwGibBVf&_nc_oc=AdoSmSa8gEoPYxhocNJoHQ8-b5msp8OY6O-DfNQ8u46K6ecM2MeEddZj_Rbt_BLBC_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSaulFJ9WDT0_XrCSLkCaqYIeP2suMqGi5Llp-fNpyqQ&oe=6ABD2967"}, "display_name": "syGlass Learn", "keywords": ["Learning", "Anatomy", "Education", "Nursing", "Premed"], "long_description": "**Learn Anatomy in a More Immersive Way**\n\nLaunching with a complete undergraduate-level Anatomy course, syGlass Learn showcases how immersive lecture recordings can support deeper understanding of the human body. Learners can follow structured lessons, review challenging concepts, and explore anatomical relationships in a way that feels more interactive than traditional video. Built-in active learning and assessment opportunities help students check their understanding as they progress, reinforce key concepts through applied practice, and identify areas that may need additional review. \n\nWith syGlass Learn, users can:\n\n- View recorded lectures created by Dr. Derek Harmon\n- Study a full undergraduate Anatomy course\n- Pause, replay, and revisit lessons anytime\n- Strengthen understanding of spatial anatomy\n- Learn through guided, visual course content\n\nWhether preparing for class, reviewing for exams, or exploring anatomy independently, syGlass Learn provides a focused platform for immersive education.", "short_description": "syGlass Learn brings immersive lectures from Dr. Derek Harmon, a university anatomy professor, to an engaging, visual learning experience. Designed for students, educators, and curious learners, the app makes it easier to revisit complex topics, study at your own pace, and connect common textbook topics with rich 3D content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.syglass.io/s/syGlass-Learn-Privacy-Policy-2026.pdf", "developer_terms_of_service_url": null, "publisher_name": "syGlass Inc.", "support_website_url": null, "website_url": "https://www.syglass.io/education", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26769074586122736"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627042_1532872198175118_3914856204964108568_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_n
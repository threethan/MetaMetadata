73342827", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221314_682607076676160_4428722991282093828_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU5NR62vSEIQ7kNvwGJZXho&_nc_oc=AdnipQ0IMBTXWCt4pgifLc-e0xh0u7zA54YlRo1_jO2lkauJGHjnkx7vYH22wMUZ2Bc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyabC1uwvxbfufeBD_Y4ZiONrO5SYhat6SJ-pEgmSeh6g&oe=69BBFD77"}, {"file_name": "Mein Projekt (2).png", "id": "727831442038440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254876_727831445371773_4161727330170931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pabXEGoYYR0Q7kNvwFDDPQE&_nc_oc=AdnOVRtOagLv_HJ0xckDDszC94coHowga3TQHZLOKidu0_THY-XK1bw7aHLy1_FWAjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyltX6pkzstc_jsqz8HJaJMP1Qe-6BCyUiGXUnbpsh4xg&oe=69BC1089"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.PNG", "id": "1315048785920847", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_1315048789254180_4768268940396036555_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3XAdTXN0UgQ7kNvwENjZZD&_nc_oc=AdnMPTnJdBhQyM4sGL8BaT7vf2bvnhC6vtDNK_JuT2g3h9JTuLS12hv-QUqCBFzeO68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afywh66rYJ5g7gudUcFWJj904Ff9VeSaElC9X5GNmAWOZw&oe=69BBF1D9"}, "display_name": "Monkeys Place", "keywords": [], "long_description": "The game is about Monkeys.\nyou can Jump around and have fun with your friends while playing it.\nthe game has a Gorilla tag based Movement with some extras.\nthere's a shop where you can buy cosmetics with Game-Currency.\nEveryday you Join the game you get 100 Banans(In-Game_Currency)\nif you find any bugs you can report them in the Discord!\n\nHope you Enjoy playing Monkeys Place!", "short_description": "Monkeys, Monkeys, Monkeys!\nwho doesnt like Monkeys? you do like Monkeys! so why not playing a with Love made game with your friends?\nThe game is currently in Alpha. so if you find any Bugs you can join the discord given in the game and report it.\n\nHope you have fun playing it!"}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1YLTkKBlJT2rqdAMN10vlPVpHOUIDvUUfauZm3WD985c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Gandalf", "support_website_url": null, "website_url": "https://linktr.ee/gav_gandalf", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "561509675476891"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "923161158750981"}]}, "baseline_offer": {"id": "923161158750981"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1672340340, "status": "PUBLISHED", "id": "923161158750981"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8458611677501900", "version": "1.0.3"}, "id": "1115878452455889", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6198284860201271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8458611677501900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "crea
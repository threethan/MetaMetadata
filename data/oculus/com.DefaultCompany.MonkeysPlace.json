0_1315048789254180_4768268940396036555_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv3TK3M1rKoQ7kNvwG6DXic&_nc_oc=Adr-jq5y3tWb8yfbP6PHq3SylXrJXrwRSub47cbX6NxKpzSioqMgaLMz1rC1t2Ph4c0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919xbp7bmKHjQzsm2P5AK84Z6CS-Oln_k1ySg_drgfig&oe=6A36C599"}, "display_name": "Monkeys Place", "keywords": [], "long_description": "The game is about Monkeys.\nyou can Jump around and have fun with your friends while playing it.\nthe game has a Gorilla tag based Movement with some extras.\nthere's a shop where you can buy cosmetics with Game-Currency.\nEveryday you Join the game you get 100 Banans(In-Game_Currency)\nif you find any bugs you can report them in the Discord!\n\nHope you Enjoy playing Monkeys Place!", "short_description": "Monkeys, Monkeys, Monkeys!\nwho doesnt like Monkeys? you do like Monkeys! so why not playing a with Love made game with your friends?\nThe game is currently in Alpha. so if you find any Bugs you can join the discord given in the game and report it.\n\nHope you have fun playing it!"}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1YLTkKBlJT2rqdAMN10vlPVpHOUIDvUUfauZm3WD985c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LuWi Games", "support_website_url": null, "website_url": "https://luwigames.com/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
.oculuscdn.com/v/t64.5771-25/75254876_727831445371773_4161727330170931_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glo20RtN11UQ7kNvwEedoqI&_nc_oc=Adr7hatfAm6NUyIkQTczvutQc7vg_jhiZYPH87AciHUx8LVcuLkGznLu49fX6coNoS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2EjVDbIPPDb0mbJw7rIGBuMzGB-oXI8v9nq8OudjC0A&oe=6AFC6D09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.PNG", "id": "1315048785920847", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001660_1315048789254180_4768268940396036555_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSOBQONylZEQ7kNvwGJ8BsV&_nc_oc=AdqbCrz8_V1N9RrZEIvn5_SJkNn8Eb7agVo90ZcBbkzLvGEhExP8v41wzWXNlx2kDu0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZhS6HgOmdS8z1xyOEcd_hmKHHlEXhPTO6RypIfO9iRQ&oe=6AFC8699"}, "display_name": "Monkeys Place", "keywords": [], "long_description": "The game is about Monkeys.\nyou can Jump around and have fun with your friends while playing it.\nthe game has a Gorilla tag based Movement with some extras.\nthere's a shop where you can buy cosmetics with Game-Currency.\nEveryday you Join the game you get 100 Banans(In-Game_Currency)\nif you find any bugs you can report them in the Discord!\n\nHope you Enjoy playing Monkeys Place!", "short_description": "Monkeys, Monkeys, Monkeys!\nwho doesnt like Monkeys? you do like Monkeys! so why not playing a with Love made game with your friends?\nThe game is currently in Alpha. so if you find any Bugs you can join the discord given in the game and report it.\n\nHope you have fun playing it!"}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1YLTkKBlJT2rqdAMN10vlPVpHOUIDvUUfauZm3WD985c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LuWi Games", "support_website_url": null, "website_url": "https://luwigames.com/index.html", "category": "GAMES", "comfort_ra
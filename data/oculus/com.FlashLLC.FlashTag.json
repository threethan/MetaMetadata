240_813224070635456_5457132011633613715_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qKSm653I_8Q7kNvwFaq5X2&_nc_oc=Ado5rBP-_FhzSgE2CFMx6QOEPH5-u96fjqQ3W7qUGAotcc_47XJJtnQ2YSQLCjDxO1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DlGftop0I_9ZbwT9bo9g5L4DM9wkoQu-xwSseh1WWiA&oe=6A184959"}, {"file_name": "liduyij4btiv3_11zon-2.png", "id": "425340277221417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974626_425340280554750_5034825087382515871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAhbg2xZjYgQ7kNvwHDfOxO&_nc_oc=AdqXeSReUsGLuRPaIaJGsqtkqBb_bVpGIBHgkHGnKa_pww9UFt-ZflrBbTpkXPm0nv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h-sVd3FFriebDPTVMO6auyIYQgNZ1L-YPu8dI3RCZRw&oe=6A1844FA"}, {"file_name": "efvcuhrcuhvr_11zon-2.png", "id": "7768830206575983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75363517_7768830209909316_3417287885201992192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4YhhkhOiKAQ7kNvwELEtFY&_nc_oc=AdqISfuxO6XOaBipD5bA7-5Ts-kEowK7pjnR6fVmwXKEFE25MpRYtKm02yvacArje0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49pGNq2evZeX2qGe-CUdVtV5dkOUkvPNfNQv7N7ktJdw&oe=6A183307"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Gorillass", "keywords": [], "long_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world."}]}, "developer_name": "oreo, unstabled", "developer_privacy_policy_url": "https://sites.google.com/view/fast-gorillass/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo & unstabled", "support_website_url": null, "website_url": "https://sites.google.com/view/fast-gorillass", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26769742885972693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574720_1053350479531073_8305808961836893102_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBkEImNRmEwQ7kNvwFQniGY&_nc_oc=AdqjF7wNd2sKa4viLCFhIsex8gL2mmGARS6SrLlQUHcNhRgXV1TKhEOYHydwGBZBA78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tll90cdc09-5YESFlGkvLMffcPsf2zXX-ed9mH6mwNw&oe=6A18382F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fast Gorillass", "platform": "ANDROID_6DOF", "context
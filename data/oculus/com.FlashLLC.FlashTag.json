2.png", "id": "425340277221417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974626_425340280554750_5034825087382515871_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iPlUrofUfsQ7kNvwGy97Qb&_nc_oc=Adp9yVGlf1TMA5te3_fbrfjwmCzIXjHEf2RvTnlZoKKl-u7MRD0c81RPFSHoPeHgML4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRebcThSS5sfOufnRhwMXe3llzudkX21JvE964i0BXfmw&oe=6AFF33BA"}, {"file_name": "efvcuhrcuhvr_11zon-2.png", "id": "7768830206575983", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75363517_7768830209909316_3417287885201992192_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qAucSM7cLMQ7kNvwG78kLI&_nc_oc=AdpdfEwKZbBAPUW7zgKpA_3uNlNL4Fm48YdrRTKnc818R6PZn8rfD9epkBbV_aqmBQM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPhJjKRoEpgo8Lk0usEDEHK8dAURMPnc1Li1xBucT9vw&oe=6AFF21C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Gorillass", "keywords": [], "long_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world."}]}, "developer_name": "oreo, unstabled", "developer_privacy_policy_url": "https://sites.google.com/view/fast-gorillass/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo & unstabled", "support_website_url": null, "website_url": "https://sites.google.com/view/fast-gorillass", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26625750110371972"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26500391789574472", "version": "1"}, "id": "230299523045878", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9532089860164597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26500391789574472"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "230299523045878"}]}, "change_log": null, "created_date": 1728685178, "id": "27347238801556429", "version": "1.1.90", "version_code": 9492, "releas
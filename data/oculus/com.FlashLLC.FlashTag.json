240_813224070635456_5457132011633613715_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQLr7-bxYloQ7kNvwEGcII7&_nc_oc=Adq0_R9gXN3OzUz_WVww2Tr9g-Ig2db1cPPOel9ZPHq3LNB7OM3O05Dr3umzuqpbEYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qazyzfP2r7SDOnjpAB76ePTqdKTfHCIpk4zVYY1NENA&oe=6A451C59"}, {"file_name": "liduyij4btiv3_11zon-2.png", "id": "425340277221417", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974626_425340280554750_5034825087382515871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIHw_UKaUggQ7kNvwHffQi_&_nc_oc=AdpzyzOUPOfLmQLYaPJ9408qDBK5JvYUAodO3DDmstMCoxyDDJR6fGfla9xcmbDnLXs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D5vG_bJCYnfz2GbblRRp_8uvh6wnQBcTDSq5cTM8EDw&oe=6A4517FA"}, {"file_name": "efvcuhrcuhvr_11zon-2.png", "id": "7768830206575983", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363517_7768830209909316_3417287885201992192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GuFnICqWsQQ7kNvwEJ6ZHn&_nc_oc=AdpoDIWQdMbvB1qy2a7evOMLx76shdDeq-KxmUkM0aOATAIOmk3LBcgEIklU_gEDTrA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zov73-bK5FSYyR2VUXrW78wI2N-KQHL4dk5mtxyMZxQ&oe=6A450607"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Gorillass", "keywords": [], "long_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Fast Gorillass\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Fast Gorillass is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world."}]}, "developer_name": "oreo, unstabled", "developer_privacy_policy_url": "https://sites.google.com/view/fast-gorillass/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo & unstabled", "support_website_url": null, "website_url": "https://sites.google.com/view/fast-gorillass", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26769742885972693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57574720_1053350479531073_8305808961836893102_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9XUL6Ww_MwQ7kNvwEOrD6q&_nc_oc=Adrpax3qqFmlW8prK1EkFo0zoMgf5a-lNpH3TKu4soghniaLbv5J4CAjlnVxcaQvyyM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84FLgxP2QuFzUYqOlB85R4WvurDLunHnLmizYrxSSWyA&oe=6A450B2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fast Gorillass", "platform": "ANDROID_6DOF", "context
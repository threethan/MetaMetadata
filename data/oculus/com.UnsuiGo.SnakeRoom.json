1.oculuscdn.com/v/t64.5771-25/38974491_1387625391942454_315235586577457409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHEFc4GG5qYQ7kNvwF0zYrV&_nc_oc=AdqDuaImqJen_XRl6fovAFxI4W2iO2_nIgH0bfC36D0W-Ieip069Rara5Fap2sDZp6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwId9FcMUeXHz0vuYLqhzqOlNki0i5n_Lo2tBfTTFWlfw&oe=69CA7932"}, {"file_name": "2.png", "id": "1560975361418341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572919_1560975364751674_5434209131356578822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_haFuuCwB8Q7kNvwHMy3-d&_nc_oc=AdpKDYT-4GXZ1mkk065t-4LQO0RmQ4bnosAQeS6zwW5NveCvK4g5RkG4idPWSlbrA6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGYCq7zPJpstput9cPeD0NR4GVFuldiMaSpZ_wgFsg7w&oe=69CA6132"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-HfdXQkXhwQ7kNvwEV7niR&_nc_oc=Adqon36TG2YhATNWsndAIHn048CSbgPkGMqt59SYkzn0WZqhhO7cMfu56-MaUKRggIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztxhQqbzo2dQLkZHrg5W5370rtUxF_TkSS6SzyFxabEw&oe=69CA8C54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSK4_0EOMK0Q7kNvwG9rN87&_nc_oc=AdoveCg_J7BDFJZT4nf7NgnKpO2yFLnZS_I25KbscoY1v551fLFJIsxQgXugYh1F044&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxvq_bF7xCoSBuRsGVVUyxv7Akt7pATCWikfZrGuZx6ig&oe=69CA8484"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "The game offers unique challenges that will help develop your attention and cognitive skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sbnrnWk2s9qw8Sfj50GatWuy6VDm4Pco31PHiqWqTQM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "UnsuiGo Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61559711884734&sk=about", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9581095571942349"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476756_874037554484956_4184708388150
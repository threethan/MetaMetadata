ent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLIM4LLbUFzSa2DGuYq5wu4ceq8iBIMoOZRgIv8pUb8A&oe=69BA8F32"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iu-SrEJ7CgQ7kNvwFuTFLJ&_nc_oc=Adk0-qZoMJumoxiVEnnsEnR7EU1fpwIYniUL9EC2jRRQDJ0olbliwA-SG4E44T04yaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3S0t8QGpT_KV0rWTMKRrVIhaEWor3jxECiE_RSnsFCg&oe=69BA8214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z04nhAbZOJgQ7kNvwEZn8Oj&_nc_oc=AdkkgX8UL3nejqHA1qU-XD7d-mizBAVx9x9i3K-_7M0kpUUy3sNGAxgwEHVxKM9sw_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfZezx-nQ-CunjGPJlscMThMJXgWqyFZO96Njl7kej8Q&oe=69BAB284"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "Th
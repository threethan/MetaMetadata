1.oculuscdn.com/v/t64.5771-25/38974491_1387625391942454_315235586577457409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQRpvsEVgNAQ7kNvwFCVzAe&_nc_oc=AdqEopQJLf5p_dzG1uKgNzqaNXAo8BVEYw1n2KSVw5oe9_wTIm1byJKkAig-8vwaPZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ilxr7CfkyAVklfU2yN4o90k-OUHBNE2oi3sUJ4Z3kNA&oe=6A0F0732"}, {"file_name": "2.png", "id": "1560975361418341", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572919_1560975364751674_5434209131356578822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijUDkyQofM8Q7kNvwGy8344&_nc_oc=Adr2DRjRFuZzjB1FKcnuk3_BZn7yGoBgft1VrN2WeHesjZwuW1CAKZ4YFVT0BRS0f6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HB2bZtTHSD8777hv8nXTO-zT2FF625nLzK7_-IDpq9A&oe=6A0F2772"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjjBw5oKUKMQ7kNvwE_abRs&_nc_oc=AdoWSpWO6fZ8Or5s1-aUtdG5k5AOxtOLDrke8bBYLOmJam_KJ4ppMrmp68-1vuf_Jck&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RBOe9oiaM50CidP_gHxUuCV7OMVh1kYthM6UCT_Xvsw&oe=6A0F1A54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpFcTZYd_vcQ7kNvwFEaznZ&_nc_oc=AdoG-M5acuEKCfnFe5dHgxmMQGNnyQXqLWut9KbBVPA-3A8S_Vc04AAzWCHpYdzcVac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q7PUbg9gl6KwEJy1ZNlZ6BNB6lXfnKZaC7JTBCTdTZw&oe=6A0F1284"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "The game offers unique challenges that will help develop your attention and cognitive skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sbnrnWk2s9qw8Sfj50GatWuy6VDm4Pco31PHiqWqTQM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "UnsuiGo Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61559711884734&sk=about", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9581095571942349"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476756_874037554484956_4184708388150
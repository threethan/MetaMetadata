91_1387625391942454_315235586577457409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uGds8Tm-jMQ7kNvwFm6VcO&_nc_oc=AdnFVM4Iv6NGVqc3F5EPB-_JxhY94lxWy-NNBXYgOirR-FphEb73AlJuM48ec2bdUxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvJNT_Fc_oACDshouPiQ_H4QYzmY66KseT6Qt7GDQtIg&oe=69AD7832"}, {"file_name": "2.png", "id": "1560975361418341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572919_1560975364751674_5434209131356578822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UoTCkzcmUsQ7kNvwEdxs8X&_nc_oc=AdlQmko8fYVa-5K_6sRdH-AOAxlWUG3jjx7DoCjZkHsvqEus59lIEW7TCBkk15HqWPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPFtqZgmneahF_1WkOiKwf_DAMY73DGbxuW3mQ9fe90A&oe=69AD6032"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ncLje0kT9AQ7kNvwHBnH73&_nc_oc=AdkoIaI3fQ-CeHtQgBmza67J7oTG-raOszsp0Kbsx2eYIRq_lsoGgM7IClQb5rXkCMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvmiVO1RylX2a4XNjEmKMN9oUt4VTf2DywNxdAbvpLWA&oe=69AD5314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhxIfXLepJgQ7kNvwFSoXWb&_nc_oc=AdmDM2mlfdbTkpDHlaTsIxXFIFfE8DOQQPUCpShldqN6U0gX7JNsoBJpuNN-3rDuS4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwAkeVGPdjjExxiUQZvkiZGpQGds4GcyE2WNf-m7bW_w&oe=69AD8384"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "The game offers unique challenges that will help develop your attention and cognitive skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1sbnrnWk2s9qw8Sfj50GatWuy6VDm4Pco31PHiqWqTQM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "UnsuiGo Oleksii Hinchuk", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61559711884734&sk=about", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9581095571942349"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476756_874037554484956_4184708388150168486_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-
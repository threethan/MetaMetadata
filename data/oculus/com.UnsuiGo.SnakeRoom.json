ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjobKFHUL3X7vj-PzbUQp1XxOwPGtYTp4YY4qkB4uK3A&oe=69AEB1B2"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUU0zTH7LZkQ7kNvwFiOxcc&_nc_oc=Adn5RxhJ_KDJbSg00NO-cM3nlaoB9h7TqDi4-o22I1uTuyTQoFcEteFfC7LdhrGcdZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRIOVcWwI80lz6ApXex-wXdr5KFLmp1HwnZBy4nmxASg&oe=69AEA494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcVCTtB0uVEQ7kNvwGxzp63&_nc_oc=AdmUAo5hcpVtiq7kujvu0U4xrWiQFFUqdLMaxN-_91OnGxrnWQP4NgAPYyzwzbydBc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsSUpSL5U-qzR0FdBD6RsKAJ5GsfkvxocSSXVMZbjiBw&oe=69AED504"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "Th
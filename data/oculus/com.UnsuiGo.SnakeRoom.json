ent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfztbSAB2jJdVxZc-H9OHUOrl5MXVrfR-IaLmIElcY0HTg&oe=69B3F7B2"}, {"file_name": "3.png", "id": "448803264503173", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031333_448803267836506_8215332141608573480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iEGk3P0VEkQ7kNvwFdUjkY&_nc_oc=AdmrWDWbHA8d6J-w1EaG7m0tNWAjdtwMpMzhxrCg6fixYrGmc6GBZgz_K4Pypj3Xo4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFUMNODQpKOsC1SwllYRDx8VvevybsVbLRBBuBnhhOkg&oe=69B3EA94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1129390168209125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363515_1129390171542458_524827826417408804_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk0LVae299AQ7kNvwGCKp4U&_nc_oc=AdkWdXL1HkV4g79i_hBQ2BIkA-6Hr5bQ6mv3aLl1-ETBMZP7IGq4CdK7Uut5fLOCPj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpO-HuSg9wyEXiLjYrlrHKWUKAOq43TbMg6gV5dEU2TQ&oe=69B41B04"}, "display_name": "Snake Room", "keywords": [], "long_description": "Discover \"Snake Room\": a new level of VR immersion! Dive into a beautiful and meditative underwater world where every movement of the snake brings tranquility and relaxation. Enjoy the soothing atmosphere and stunning graphics that bring the ocean depths to life.\nTrain your brain while playing: \"Snake Room\" is designed not just for entertainment but also to improve your spatial awareness and decision-making abilities. The game offers unique challenges that will help develop your attention and cognitive skills.\nIntuitive control for everyone: Regardless of your VR experience, \"Snake Room\" provides ease and intuitiveness in control. This makes the game accessible and enjoyable for players of all levels.\nPrepare for a new dimension of entertainment in virtual reality with \"Snake Room.\" This captivating journey into a world where beauty and calm meet interactive mind training.", "short_description": "Th
leased_binary": {"__typename": "AndroidBinary", "id": "27687249647610941"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "\"Major Update\\n- Added Android phone and PC screen mirroring and remote control through companion apps.\\n- Connect multiple remote windows to different devices and save each device assignment and spatial position.\\n- Added hand tracking and Touch controller support for taps, drags, scrolling, keyboard input, and right-click.\\n- Added 3D CAM stereoscopic MP4 recording on supported Quest headsets.\\n- Stereo MP4 formats are now detected automatically and rendered separately to each eye.\\n- Added VRMA timeline, pose, motion, and synchronized WAV audio editing.\\n- Added QR media scanning, GIF playback, MP4 thumbnails, and a seek bar.\\n- Added preview and recording control for multiple compatible Android camera devices.\\n- Improved remote video frame pacing, reconnection, audio cleanup, and deletion reliability.\"", "created_date": 1785346449, "id": "27676560955346477", "version": "v338(2026.07.30_02:22)", "version_code": 338, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8767138216715369", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27687249647610941"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "\"Major Update\\n- Added Android phone and PC screen mirroring and remote control through companion apps.\\n- Connect multiple remote windows to different devices and save each device assignment and spatial position.\\n- Added hand tracking and Touch controller support for taps, drags, scrolling, keyboard input, and right-click.\\n- Added 3D CAM stereoscopic MP4 recording on supported Quest headsets.\\n- Stereo MP4 formats are now detected automatically and rendered separately to each eye.\\n- Added VRMA timeline, pose, motion, and synchronized WAV audio editing.\\n- Added QR media scanning, GIF playback, MP4 thumbnails, and a seek bar.\\n- Added preview and recording control for multiple compatible Android camera devices.\\n- Improved remote video frame pacing, reconnection, audio cleanup, and deletion reliability.\"", "created_date": 1784738531, "id": "27595865273416046", "version": "v281(2026.07.23_01:34)", "version_code": 281, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8767138216715369", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27687249647610941"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "# \uae30\ub2a5 \ucd94\uac00 \uc694\uc57d\n\n## \u2705 \uacf5\ud1b5 \uae30\ub2a5\n- \ud3c9\uba74\uc5d0 \uc77c\uce58\ud558\uac8c \uc774\ubbf8\uc9c0\ub97c \ubd99\uc774\ub294 \uae30\ub2a5 \ucd94\uac00\n\n## \u2705 Quest 3 \ubc0f \uc774\ud6c4 \uc7a5\uce58\uc6a9 \uae30\ub2a5\n\n### \ud83d\udccc \ud328\uc2a4\uc2a4\ub8e8 \uc774\ubbf8\uc9c0 \ucc98\ub9ac\n- \ud328\uc2a4\uc2a4\ub8e8 \uce74\uba54\ub77c \uc774\ubbf8\uc9c0\ub97c **\ud30c\uc77c\ub85c \uc800\uc7a5**\ud558\ub294 \uae30\ub2a5 \ucd94\uac00  \n- \uc800\uc7a5\ub41c \uc774\ubbf8\uc9c0\ub97c **\uacf5\uac04\uc5d0 \ub85c\ub4dc**\ud558\ub294 \uae30\ub2a5 \ucd94\uac00\n\n### \ud83d\udccc \ud328\uc2a4\uc2a4\ub8e8 \uc601\uc0c1 \uc804\uc1a1\n- \ud
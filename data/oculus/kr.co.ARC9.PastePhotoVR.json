content-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_2022648065287462_3857135850605483682_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlyaSVDSQ5AQ7kNvwFx7DW-&_nc_oc=Adp8B2z6J7mQSIBU03ocVo7zEW9jzk1ifRTpX3AxmTgjpO7gUnQdPTPOhOVbevI2hbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6X9ZfQX2o60IyBB4xphrDAjjrjOLeLaO91F71WVlusw&oe=6B0DAF18"}, {"file_name": "SC0001.png", "id": "28276720511912778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619163_28276720521912777_3789521124326977237_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyoKSn89dK4Q7kNvwHkkfnt&_nc_oc=AdpxvvmkGy8VCzTwKQIOgjSinJpQqfa-oPmcN9g0-AXE-cOUxrr2VkuUxLfaKHOizjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJbN3Yy5NdOjZxk8w2ofMa9iS-uy3QRGQIEg5fSblKKQ&oe=6B0DB1CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverPage.png", "id": "1534703385058327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619668_1534703388391660_6279687021896173537_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKGzpizbGfIQ7kNvwG2Eu1U&_nc_oc=Adqq3ZyXD6WLqp9ZTyC8Oz7q6VDN9IVDmFtfe2q9z0nk7TOeYxu-QklkYinJRAsMdG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQC5pkD8HJEFN8yA0qn5x-KoMsjPZvgmcBGJ6QDuX8mw&oe=6B0DAE49"}, "display_name": "\uc0ac\uc9c4 \ubd99\uc5ec\ub123\uae30", "keywords": ["PDF", "GLB", "VRM", "Video", "NDI"], "long_description": "\ub0b4 \ubc29\uc744 \ub098\ub9cc\uc758 VR\u00b7\ud63c\ud569\ud604\uc2e4 \ubbf8\ub514\uc5b4 \uacf5\uac04\uc73c\ub85c \ubc14\uafd4 \ubcf4\uc138\uc694. \uc88b\uc544\ud558\ub294 \ucf58\ud150\uce20\ub97c \uc6d0\ud558\ub294 \uacf3\uc5d0 \ubc30\uce58\ud558\uace0 \uc800\uc7a5\ud558\uc5ec \ub2e4\uc74c \uc2e4\ud589\uc5d0\uc11c\ub3c4 \uac19\uc740 \uacf5\uac04 \uad6c\uc131\uc744 \uadf8\ub300\ub85c \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc0ac\uc9c4 \uadf8 \uc774\uc0c1\uc744 \uacf5\uac04\uc5d0 \ubc30\uce58**\n- JPG, PNG, GIF, MP4, PDF, GLB, VRM, VRMA, \uc6f9, NDI \ucf58\ud150\uce20\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n- \uac19\uc740 Wi-Fi\uc758 \uc2a4\ub9c8\ud2b8\ud3f0\uc774\ub098 PC\uc5d0\uc11c \ud30c\uc77c\uc744 \uc804\uc1a1\ud558\uace0, QR \ucf54\ub4dc\ub97c \uc2a4\uce94\ud574 \ubbf8\ub514\uc5b4\ub97c \uc5f4\uac70\ub098 \uc800\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc2a4\ub9c8\ud2b8\ud3f0\uacfc PC\ub97c VR \uc548\uc73c\ub85c**\n- \uc5f0\ub3d9 \uc571\uc744 \uc0ac\uc6a9\ud574 \uc548\ub4dc\ub85c\uc774\ub4dc \uc2a4\ub9c8\ud2b8\ud3f0\uacfc PC \ud654\uba74\uc744 \ubbf8\ub7ec\ub9c1\ud558\uace0 \uc81c\uc5b4\ud569\ub2c8\ub2e4.\n- \ud578\ub4dc \ud2b8\ub798\ud0b9 \ub610\ub294 Touch \ucee8\ud2b8\ub864\ub7ec\ub85c \ud130\uce58, \ub4dc\ub798\uadf8, \uc2a4\ud06c\ub864, \ud0a4\ubcf4\ub4dc \uc785\ub825\uacfc \ub9c8\uc6b0\uc2a4 \uc624\ub978\ucabd \ud074\ub9ad\uc744 \uc804\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc5ec\ub7ec \uc6d0\uaca9 \ud654\uba74\uc744 \uc5f4\uc5b4 \uc11c\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0 \uc5f0\uacb0\ud558\uace0, \uae30\uae30 \uc124\uc815\uacfc \uacf5\uac04 \uc704\uce58\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4.\n\n**\uc785\uccb4 \uc601\uc0c1\uc744 \uac10\uc0c1\ud558\uace0 \uc9c1\uc811 \ub179\ud654**\n- \ub3d9\uc601\uc0c1 \uc378\ub124\uc77c\uc744 \ud655\uc778\ud558\uace0 \uc6d0\ud558\ub294 \uc7ac\uc0dd \uc704\uce58\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- Side-by-Side \ubc0f Top-and-Bottom MP4\uc758 \uc2a4\ud14c\ub808\uc624 \ud615\uc2dd\uc744 \uc790\ub3d9\uc73c\ub85c \uac10\uc9c0\ud574 \uc591\ucabd \ub208\uc5d0 \uac01\uac01 \uc7ac\uc0dd\ud569\ub2c8\ub2e4.\n- \uc9c0\uc6d0\ub418\ub294 Quest \ud5e4\ub4dc\uc14b\uc5d0\uc11c\ub294 3D CAM\uc73c\ub85c \uc591\uc548 \uc2a4\ud14c\ub808\uc624 MP4\ub97c \ub179\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc544\ubc14\ud0c0 \ubaa8\uc158 \uc81c\uc791**\n- VRM \uc544\ubc14\ud0c0\ub97c \ubd88\ub7ec\uc640 \ubab8\ub3d9\uc791\uc744 \ub179\ud654\ud558\uace0 VRMA \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc7ac\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc790\uc138, \ud0c0\uc774\ubc0d, \ub9ac\ud0c0\uac8c\ud305, \uc5bc\uad74 \ubc29\ud5a5\uacfc WAV \uc624\ub514\uc624\uac00 \ub3d9\uae30\ud654\ub41c \ud0c0\uc784\ub77c\uc778\uc744 \ud3b8\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud638\ud658 \uae30\uae30\uc5d0\uc11c\ub294 NDI \uc785\ub825, \ud328\uc2a4\uc2a4\ub8e8 \uc774\ubbf8\uc9c0 \ucea1\ucc98 \ubc0f NDI \ucd9c\ub825\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uae30\ubcf8 \ubbf8\ub514\uc5b4 \ubc30\uce58\ub294 \uc624\ud504\ub77c\uc778\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \ud30c\uc77c \uc804\uc1a1, \uc6d0\uaca9 \ud654\uba74, \uc6f9 \ubc0f NDI \uae30\ub2a5\uc740 \uac19\uc740 \ub85c\uceec \ub124\ud2b8\uc6cc\ud06c\uc758 \ud638\ud658 \uae30\uae30\ub098 \uc11c\ube44\uc2a4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n*Paste Photo VR\uc740 \uc5bc\ub9ac \uc561\uc138\uc2a4 \ubc84\uc804\uc785\ub2c8\ub2e4.*", "short_description": "\ub0b4 \ubc29\uc744 \ub098\ub9cc\uc758 VR\u00b7\ud63c\ud569\ud604\uc2e4 \ubbf8\ub514\uc5b4 \uacf5\uac04\uc73c\ub85c \ubc14\uafd4 \ubcf4\uc138\uc694. \uc0ac\uc9c4, \ub3d9\uc601\uc0c1, PDF, \uc6f9\ud398\uc774\uc9c0, 3D \ubaa8\ub378\uacfc VRM \uc544\ubc14\ud0c0\ub97c \uc6d0\ud558\ub294 \uacf3\uc5d0 \ubc30\uce58\ud558\uace0 \uc800\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\uc6a9 \uc5f0\ub3d9 \uc571\uc73c\ub85c \uc548\ub4dc\ub85c\uc774\ub4dc \uc2a4\ub9c8\ud2b8\ud3f0\uacfc PC \ud654\uba74\uc744 \ubbf8\ub7ec\ub9c1\ud558\uace0 \uc81c\uc5b4\ud558\uba70, \ud578\ub4dc \ud2b8\ub798\ud0b9\uc774\ub098 Touch \ucee8\ud2b8\ub864\ub7ec\ub85c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc870\uc791\ud558\uc138\uc694. \ud638\ud658\ub418\ub294 \uc2a4\ud14c\ub808\uc624 MP4\ub97c \uc785\uccb4 \uc601\uc0c1\uc73c\ub85c \uac10\uc0c1\ud558\uace0, \uc9c0\uc6d0\ub418\ub294 Quest \ud5e4\ub4dc\uc14b\uc5d0\uc11c\ub294 3D CAM\uc73c\ub85c \uc591\uc548 \uc785\uccb4 \uc601\uc0c1\uc744 \uc9c1\uc811 \ub179\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "4089348781365861", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_4089348784699194_1121677955078616797_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3qUig1jumkQ7kNvwFC3f9B&_nc_oc=AdoKhlUSS6X6pn2zG4TuuPiZBlG1mXhl6pUCIhdVfA7oBTDg76QA5eH6CrDFNREnj5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBh5c9REJ3oaWiRgA46NyAXFNnR4KoGcHff9fw3EQpxw&oe=6B0DBAB2"}, {"file_name": "04_3000x900_HeroCover.png", "id": "1858368298477836", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_1858368308477835_1521920654353433239_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nspNznCt7u8Q7kNvwGqVLxr&_nc_oc=AdqHF81mB0CbXjY9LJdyZ8GpFDBX0ns9ittZ2vXCHNKHj4blASH-0e6pIDcG7Wy3dqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoTgS7A0cwUqga7mXJszVZOAcbqrUrUExgq9GHRzRnqg&oe=6B0DCAEE"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1654188555679196", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604302364_1654188559012529_7925366370553514428_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou24so-6wPUQ7kNvwGGxDn_&_nc_oc=AdrHD-08tcRQpr7vFGjKK6qWVl_N4i_vMaONrCBZQeBA8UekmqAyLmIIcayP7ABuMOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCJe07F31xXMZ4QkptnRYQGqFqcbUs8i5ddGjnEzGmRg&oe=6B0D9AEF"}, {"file_name": "ICON_512x512.png", "id": "1363171985994849", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303116_1363171989328182_280768001852702850_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKqUq4vIYXUQ7kNvwH2wilI&_nc_oc=AdpwQbIaDIpgZ5_T7QpYlM48nZCla_bwjsCsMESsxyKzHi6i7XXSVNXYhBofL8AJhJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscd
des": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8767138216715369", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28967671466235413"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "Fixed an issue where all objects became transparent in Quest 2. Added experimental LiveSync feature (allows real-time viewing of each other's objects on the same network).", "created_date": 1785938207, "id": "27756384504030788", "version": "v388(2026.08.05_19:02)", "version_code": 388, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8767138216715369", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28967671466235413"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "Awesome update\n\nhttps://youtube.com/shorts/8kLZXglGEu0?si=gR4fAxyiguYoIYKw\n\nhttps://youtu.be/sGjCdeUns4Q\n\n\n", "created_date": 1785427763, "id": "27687249647610941", "version": "v358(2026.07.31_01:05)", "version_code": 358, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8767138216715369", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28967671466235413"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "936000788427438"}]}, "change_log": "\"Major Update\\n- Added Android phone and PC screen mirroring and remote control through companion apps.\\n- Connect multiple remote windows to different devices and save each device assignment and spatial position.\\n- Added hand tracking and Touch controller support for taps, drags, scrolling, keyboard input, and right-click.\\n- Added 3D CAM stereoscopic MP4 recording on supported Quest headsets.\\n- Stereo MP4 formats are now detected automatically and rendered separately to each eye.\\n- Added VRMA timeline, pose, motion, and synchronized WAV audio editing.\\n- Added QR media scanning, GIF playback, MP4 thumbnails, and a seek bar.\\n- Added preview and recording control for multiple compatible Android camera devices.\\n- Improved remote video frame pacing, reconnection, audio cleanup, and deletion reliability.\"", "created_date": 1785346449, "id": "27676560955346477", "version": "v338(2026.07.30_02:22)", "version_code": 338, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
_a_Q&oe=6AF9DA0B"}, {"file_name": "SC0005.png", "id": "1385623883526964", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604282317_1385623886860297_3752032814889039779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXibsJfUeP8Q7kNvwGCj-3S&_nc_oc=Adq-4zyIGMKDnv_SHgESgbHU66LqcGW6X7u1BndPu3UIZEl2QG9_JXXccWg0FFo7D_U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEZtIIZvgdslTcWyL1wDjETkqxxP8uEFthgCYQ1O7a7Q&oe=6AF9CC76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverPage.png", "id": "2438909379917856", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499299845_2438909386584522_6010866789649497182_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqVS4fDNIwkQ7kNvwFKIBX1&_nc_oc=Adp3op-CKRO40E1UOBbtn8vyPg70wSJBo9OjmrHlgMLBxlXpcxWJTJHhii4NFUjhbxg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUabBiX3sDFr5ji_prQ06-dmQBPlf6um2NKXpBoC_mIw&oe=6AF9D63A"}, "display_name": "Paste Photo VR", "keywords": ["PDF", "VRM", "NDI", "GLB", "Video"], "long_description": "Turn your room into a personal spatial media workspace. Arrange your favorite content in VR or mixed reality, save the layout, and return to it anytime.\n\n**Place More Than Photos**\n- Open JPG, PNG, GIF, MP4, PDF, GLB, VRM, VRMA, web, and NDI content.\n- Transfer files from a phone or PC over the same Wi-Fi, or scan QR codes to open and save media.\n\n**Bring Your Devices Into VR**\n- Mirror and control Android phones and PCs with companion apps.\n- Use hand tracking or Touch controllers for taps, drags, scrolling, keyboard input, and right-click.\n- Open multiple remote screens and save their device assignments and positions.\n\n**Create and Watch in 3D**\n- Browse video thumbnails and seek to any point in playback.\n- Play compatible side-by-side and top-and-bottom MP4 videos with automatic stereo detection.\n- Record stereoscopic MP4 memories with 3D CAM on supported Quest headsets.\n\n**Animate Your Avatars**\n- Load VRM avatars, capture body motion, play VRMA animations, and edit poses, timing, and synchronized WAV audio.\n\nNDI input, passthrough image capture, and NDI output are available on compatible devices. Core media placement works offline; network features require compatible devices or services on the same local network.\n\n*Paste Photo VR is in Early Access.*", "short_description": "Turn your room into a personal spatial media studio. Place photos, videos, PDFs, web pages, 3D models, and VRM avatars anywhere in VR or mixed reality, then save your layout and return to it anytime. Mirror and control Android phones and PCs with companion apps, interact naturally with your hands or Touch controllers, watch compatible stereo MP4 videos in immersive 3D, and record stereoscopic memories with 3D CAM on supported Quest headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223680591079", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": "https://blog.naver.com/uc7/223680592275", "website_url": "https://blog.naver.com/uc7/223680590174", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27718261647843074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5
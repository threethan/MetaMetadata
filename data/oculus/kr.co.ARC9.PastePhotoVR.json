5Loma9MxiXv7LeKxemEkLitQxhkDHP1rH7TxSQ&oe=6AFC745D"}, {"file_name": "SC0004.png", "id": "904122115587794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_904122118921127_3512784971857314448_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkF1QUj4nKkQ7kNvwFWWz5G&_nc_oc=AdoLHZVN23biVmaahfsatocjn6dS22gxQ14EUWN2sc1Ju5C_j3aKmDCnyZTN0w8YXGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4mrxN4OSBIdQn28niV1feKqRGvoaFjRZFBqEj8hmD4A&oe=6AFC7D0B"}, {"file_name": "SC0005.png", "id": "1385623883526964", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604282317_1385623886860297_3752032814889039779_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXibsJfUeP8Q7kNvwGlJ9qb&_nc_oc=Adp3nhhRBwyOdXZqj6IzKhbJRKu73fDnd0svLefcwFErCiWIBfcf57mOwB0kT-8XSrw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFlc1EJYAyvxJ2jL57_YVyrdmfu7Tv06WEjO6zu8RFcg&oe=6AFC6F76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverPage.png", "id": "2438909379917856", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299845_2438909386584522_6010866789649497182_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POCiRmDR4OMQ7kNvwGcHB1O&_nc_oc=AdpEXeGJQbA_rln6dRPGpNKzSqSduzh2QBsJETCer2S6GfjpAsyYThDByc-MyCaGMbc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRwTyU6-1e7UuNyF7DWqs_B-e_YpdJ17T8NPAKo1xO_w&oe=6AFC793A"}, "display_name": "Paste Photo VR", "keywords": ["PDF", "VRM", "NDI", "GLB", "Video"], "long_description": "Turn your room into a personal spatial media workspace. Arrange your favorite content in VR or mixed reality, save the layout, and return to it anytime.\n\n**Place More Than Photos**\n- Open JPG, PNG, GIF, MP4, PDF, GLB, VRM, VRMA, web, and NDI content.\n- Transfer files from a phone or PC over the same Wi-Fi, or scan QR codes to open and save media.\n\n**Bring Your Devices Into VR**\n- Mirror and control Android phones and PCs with companion apps.\n- Use hand tracking or Touch controllers for taps, drags, scrolling, keyboard input, and right-click.\n- Open multiple remote screens and save their device assignments and positions.\n\n**Create and Watch in 3D**\n- Browse video thumbnails and seek to any point in playback.\n- Play compatible side-by-side and top-and-bottom MP4 videos with automatic stereo detection.\n- Record stereoscopic MP4 memories with 3D CAM on supported Quest headsets.\n\n**Animate Your Avatars**\n- Load VRM avatars, capture body motion, play VRMA animations, and edit poses, timing, and synchronized WAV audio.\n\nNDI input, passthrough image capture, and NDI output are available on compatible devices. Core media placement works offline; network features require compatible devices or services on the same local network.\n\n*Paste Photo VR is in Early Access.*", "short_description": "Turn your room into a personal spatial media studio. Place photos, videos, PDFs, web pages, 3D models, and VRM avatars anywhere in VR or mixed reality, then save your layout and return to it anytime. Mirror and control Android phones and PCs with companion apps, interact naturally with your hands or Touch controllers, watch compatible stereo MP4 videos in immersive 3D, and record stereoscopic memories with 3D CAM on supported Quest headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223680591079", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": "https://blog.naver.com/uc7/223680592275", "website_url": "https://blog.naver.com/uc7/223680590174", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jycud9HkqFsQ7kNvwHQMOTK&_nc_oc=AdphE9kQhlDWtwz0NlVUOwBt3EBJ_3BRd6UJoYWoVBINAXAWleEAaDso_kuJNjLic9I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_1RV2jYn1LG5rGJGCwYfZw2Uav7K6atnyNnS3OlZQxQ&oe=6A941BA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diE0XmPqwbwQ7kNvwEabDBf&_nc_oc=Adraxr31hsx8H4nPx83KNUbrL209sqWSlBhasIi6PWqL9qw37kHZSHfySSiegGCBr84&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxib2eazv0llxFWfc1HfeD_ozBeOzgH824JnJilPaIYA&oe=6A942F81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJxaDk2j50cQ7kNvwGcxvE8&_nc_oc=Ado66_JZ5fQ7LHHNcSOart90eHuC0sHfbrWVh1xzYglmhYPDItnNb1FnhR4tdjYhzFo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwZym-3pHmADqrSFX3BHmmMpuxENTLwgUrgENSNsRJyA&oe=6A94096E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFiMprcHcc0Q7kNvwFRlcuw&_nc_oc=Adrm9RLyf0SLAZ9eSUxb9tRjDhGjYUT1FTCtqbMFnmYazO95B5VRATYgrsujOR9yDRI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmfuFq1fbzGApFnt4YTBgfwLLTFROp8_1pf-t-D25kAg&oe=6A9401A0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iOUWYvHc44Q7kNvwHcbJdV&_nc_oc=AdpsJYb6Qt6Z_h1pCSPJVk8M9JsdC5dB_39xGvce99BrvQ5JFkwtPDBqGmm08sBjPTk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs1kR-4VTebUhPdVUIc-urTv-mYkY-jseVrN93VcW4og&oe=6A940926"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ8d5FTcscoQ7kNvwHBfYTp&_nc_oc=AdoE8tSJT60kOuTQk4_iAMhRoKXN5V3gVvr40rqW1Ve3ckKNtEv6h5_nfxv9DDF8fgA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUdozJVo0cAIC0R7FjvKQLGFR1itApMjo3JqGeJDMz2w&oe=6A9427C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or2jRZgyA0sQ7kNvwF22laT&_nc_oc=Adp3-vJ9HjiUcrnQhdaGmkBhnWT4zb8O95SmugQyKxNT0KxlZASxpg6VHPorL0XVa80&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHVFp24V236DdjVKPd2YMpS_D2sS4QxABgkWlC1U12oQ&oe=6A941F22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiEj4p-M1_sQ7kNvwHdgGhp&_nc_oc=Adq56TeVvgjpLLGX92RMsbrc4Nj8MFhtBAeF4dtd4Q0So5_jTLBoawGj0KiM1G6XE8w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4JqqmlEc_DHIM8Sk-TmtBnixdIxMHew
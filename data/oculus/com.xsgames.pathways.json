ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4epXIiXJAzMQ7kNvwEVPP89&_nc_oc=AdrgchcBDlB85vzVlL5NHBADzt0PZJfNEIZ7uFHGdQQWWNSAVqvWCJMZfYtyTPQdk2I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LXbJYKEoIVnXzULegbKemGTC7Q2lbbro7VwFpqBxFdw&oe=6A2C2D69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l67iC4Knv8Q7kNvwFcGneA&_nc_oc=AdpOqE-S8Cwk7r5HB1J0vP-T1E17V0RPbiAjA7yhHY8i0WHeufCLRMU3Og0teLy_048&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PO7_g-JJEjq2oRlVeSpIjElyrnPjEH4C0_YdIvaj8qg&oe=6A2C0901"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nocDTOfq-eEQ7kNvwE6i2mJ&_nc_oc=AdoTmNp0a8jZFyV71rHT6YQrRfHNHThK76xwzkcmsQxal-RjdOze2aNR1gan3zf5ueg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D_iQN4hXt5ztr1Sx_JxWBNL2QYbRPFyzI_XjaYrGmTQ&oe=6A2C1B2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoFY0XtYimYQ7kNvwHr9IO9&_nc_oc=AdoVU7B4w1qmAU-ID29Di9bRKgPYVnS7thQ6Ax987EC2Ly1VWjOeOsP2SftpmQyT3cs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KAGjHH3eMz9tRcjI6i2va0vk35mX5OKwyRj03u3StIg&oe=6A2C1360"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT632LLoyY8Q7kNvwFdgMTi&_nc_oc=Adotg1qtD2ek8X9CbuJjRZ5mKkIboP_kiT5otsL9n56p9xQG_oJTSqJgiXUiGHqs88M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eJSmXJrmdwsxUFoC0KjlIxzz-xiMkLyBvaULsQNp6hg&oe=6A2C1AE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvSsObPpfx0Q7kNvwHHY48d&_nc_oc=AdpVQfbAQoOq4u5vh2u1vpxQvHtpFAyCLFmvlBgS3xt2aBKfOhyHCNfGTeib7mddkxY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yBMC14tK6lHlunNYX9uKmsifEwnUnOuvZ2Wh_hoMJhA&oe=6A2C0144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2owoAhWzOk0Q7kNvwHfRx-J&_nc_oc=Ados95Tt3gFtPgTKFuR3aKNDDLbmgBeCVgO-3dekB-zPINlSdXVUMYbnGoL_cKiu0XE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Go1njj5YUMjlg6Bqb9AAL74xnDZLCdMs6kk-8wQZJyA&oe=6A2C30E2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi8dJPMZU0wQ7kNvwEwtFPg&_nc_oc=Adqu-obO3K1Beu0JJKbWMZg5_lyOujpw0dKZlX2oqgC7VtkYtqD8HIGxKDqL3wXm6c0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83FDOE8bTGqQVUDhGAhsOgTPmoPG24Wh
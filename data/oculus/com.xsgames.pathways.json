ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5r1IQW6O3wQ7kNvwGtHCoa&_nc_oc=AdoA4PWCA1LKEzpP1pbfF6LPrUeRxzePPJT7if0A90xWBMo8RKXQTvR2pN3rTpJYMas&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzFq7L1AMuiQq_cfsuND9O0AS6iLtdaLJbq2v8STxmyQ&oe=6A883E29"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfa8VX3dCKEQ7kNvwFAGfMC&_nc_oc=Adok1Y11tP6nb25yiCVo2NoeL7C-Bdcj4X2Z_-UtjIi6k7L90HcxpAIFAJsIm0myuMU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzuSt9obJtU7xcW_S64V4zIeJPNnwgyQMq4d5Bqioeqw&oe=6A885201"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YrUoIeJAMAQ7kNvwHQeRiG&_nc_oc=AdoVV1arLXXM4JoMyaidvA_jopz2Oq2vGilXH-njRwJIbIMvRVMnRbb-vF-2tR5yxqo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwDMEHBdLzBYHYXACE8aOJg6Fs0DpZg0Mvj_kNYWvZKQ&oe=6A882BEE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL1jN3orMhcQ7kNvwHEHldT&_nc_oc=Adq4yLR8QyNjSfsXZuyMc5OIbzOvISE9h1RemOiZSyVT7G9J6ez1uiOV2UtpbCfXLa0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7PfC55eEj-cxGANccnKuW3z0upESI2DvibKaokLJ6Aw&oe=6A882420"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJqkO2M7ShQQ7kNvwFygrh-&_nc_oc=AdoclMZL31uHkUecyhLggfJbNyg2mdCJx6LNZ9BXqVDOFRCxRYIgwjXV5y2z9edvPc4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrlDz-F0Z-9E_pG0txTQYq4s8oUg3zhjTwLsce2DqJXA&oe=6A882BA6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZKKUNZ688EQ7kNvwEhlzj3&_nc_oc=AdprdrceViwlgY6C__tMLEKYlOZT137tBgRmLCgVc8eGoNHw1-ef_zRju-Jn_u--TaY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq1q2rjFUlr-N0kwCkQtrIpTC8QKlnZL7ZALGNEBqj_w&oe=6A884A44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6-exKBSLmkQ7kNvwFtUUSC&_nc_oc=Ado5XBpwH1wC8Mt4IUoqxQcl2WKxVXlQsE7JaM01exshD7Bo6ZegzE2jcxhbeDuyXR4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxO4_TCJf-9JLk0C9VaI6MOZx8sw8CKPtZifseOEEn0A&oe=6A8841A2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyag-f9BEA8Q7kNvwEt6tm8&_nc_oc=AdrnAOZP8nlVrsfg1sXhniauV0kHWuMTlSdVRPiTIUO7JOpedl80IFnbnsiJhF9OSec&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXlPfHT3Fn_Q0oeURTtuBKaRA02Jt5QT
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEE8AV4iwTYQ7kNvwFkTl2x&_nc_oc=AdoAJ_Bqx57BgzpIh1TLuLqs3k25LGQwW0CAmz9yFDg5jJAXqIzBGQg8eiy4Y4vSCH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpjzYkO-jPxjD8QnS8yLE3bBrozjHS2skGLjcBSKOduw&oe=6A4A7FE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0_xSQJaUooQ7kNvwF0AtFR&_nc_oc=Ado7I4aCQKjfw8XgzhicwLIKBNG1Uwk7gpFqmLLrYje0C6Ol9eqDmWKJTfHnbd0pg4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfVYQw7QYiEBMZxcTaoyLbabyUwW53Tex8MAhijZqKSg&oe=6A4A5B81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQJ9YP5QGJYQ7kNvwFOAQg4&_nc_oc=Adrp9AmNDOuu9qxDPhK285ZCegeoyw51zE47qYo5IRG2I2OH27gjIk7msMPc2pV4_jo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4F9DIM8MEealVRvrgDYou9ibXoVX6bQJCBbnqKUlrdg&oe=6A4A6DAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBo_hZScijwQ7kNvwF4HEw1&_nc_oc=Adq_rhniEbrpqUxaR5F3LEe_IdjDOnA-JDilK7P10Borkpn4UFjvj4OiFhJJiojhDCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcwH9Z4-c5Tyc4HfwnH0hhj1jO_slmBPvzclpoQPJTgw&oe=6A4A65E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OQ7lvybGDIQ7kNvwHq9ECW&_nc_oc=AdrXmVJr9w7BSknIcl4PBf_bSA8d-o3map_B3H9NoeclUB5D294yUiZok16iCrpXNeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBakkiwWTxSKfrt0teWfHNULrJKVKh1h0kIhW5DEJLQLw&oe=6A4A6D66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YocU7NK4ThUQ7kNvwHZuX7n&_nc_oc=AdphHzWrUect1CIY3HElpqf-5R5zyBXz8oBWJoFWoqNZ1_5IZetpZRgMx_6P1W-2GnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6BeiYYwmxVvq5oFUBrV0OneCqnqeVVoo0I5HaKelMUg&oe=6A4A53C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaKHLYf7kr8Q7kNvwE4NY3V&_nc_oc=AdqpL2XXjrcjInu1T2r3g1CYQgms7I-2jFnP-tEyZt7q9CphA6QK9ot1bExk5hdGmSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiQl7GyvwSVnYExgxFEh5yqeyz5i62PIpGXJd7ODzK2A&oe=6A4A8362"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxhQ25JBRVUQ7kNvwF-jNK7&_nc_oc=AdpCKkyKgTC50TffU93nTgzSdzVGGW9VIpBRtOQPA2nigSN1jLdG5C3Sjqm9yDVKml0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0ATwdxhm9LS6zILsqkK9isJx4jQf8--
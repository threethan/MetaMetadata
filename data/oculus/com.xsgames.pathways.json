ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X6MYb9WuEIQ7kNvwGdS9YI&_nc_oc=Adr4mL4mk5coEUOdjikdcVsGGuqL5jYu7eQl9TCfOD5XkLQzlplAp2CbigcVHFTzDYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzzcbkaLUhKTI9pce6lCc5pomDAPpBd8NM-sTi0ipslQ&oe=6AE4BF69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfZ7Y9-NK84Q7kNvwHVAGhj&_nc_oc=AdoFnzDODIXSknboxngpQS4cPYMpmTRJl2P4AzdNJUK3jT02Q3DEt4Bqj0a7y7jGxLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBLBZ24A69CcONsf84usR6HQBq3JSXsruI-fdJp8kB9w&oe=6AE49B01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPGSnh-knPEQ7kNvwEBsn-n&_nc_oc=AdricEyTjkbIRHhmV5GoUVdRCX_WCax8BKBqA39nNMnCkeah2-sNQxF66bVd3BnfMEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNMUxeidWxnG1DUilEAgMGV-FKyNU9vosPcI738C9Wnw&oe=6AE4AD2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CvjWsXYWG4Q7kNvwGVdit6&_nc_oc=AdrWYPiKqZlYa6vt95n8WNZaBlZESr4ahnQmMz4Md5B9rz-BWMGuB1ZL1f3Cncer9Ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq5HMzQ_r0JYdHjxfmnZNfJ6wsGW5EOhq68ATz836J7Q&oe=6AE4A560"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEdgsJjUvcIQ7kNvwGTrmem&_nc_oc=Adp1yWLh8T3ahRmGoBo2UGJNwv11fzudkwKW9TM0ZqN8L9jfdbG-ZsHY4A4K9Iigzv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe2er75-oNtryxbEdcN7alXL6m3dKsiYOBC_gvkvV3AQ&oe=6AE4ACE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXjPcarB0ewQ7kNvwHIm6tJ&_nc_oc=AdoGHnLhfnScx4lMP0addSIJZkRPZdF0tzxw8RF_5bLCE3sJPm0hD-7jqRfIc1WVrw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmBSpi1f2XJW3CqzvkdJMse3dJF16AoO0OywtfVPZM5Q&oe=6AE49344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZTs8moYYUIQ7kNvwEmZXkw&_nc_oc=AdpFrh4riA8awmYmam34-zyckJn8SngLEe0azbSxhvHO-VFYcjWC7oBbkL-vN_9SMrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvsEHvzqTcBzwA4YXgXUeNvyYjpk6EzIfDOG0fq_FvFw&oe=6AE48AA2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgHYnku4sCAQ7kNvwHe3NcO&_nc_oc=Adrif9X1HTbvbr6sM5ubfxATExoUeb6uLfLB4giTIssGIggVgREX3OwO2BD0yYghB2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvyo8GiyBlKQMHuR4-vV7RpOQgbG8aWw
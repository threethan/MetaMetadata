ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEE8AV4iwTYQ7kNvwFo1oe5&_nc_oc=AdpyGB-RXqdF3pscv85_TwBKZGqdk3iJb3HyreGebidW5ieXQXPuMqHjiDoKeculj5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmdFFKtTh66O3eP9Y4kpYI0QqHsJerSKkzSWaP2opO9A&oe=6A492E69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0_xSQJaUooQ7kNvwFDEUTl&_nc_oc=Adq33CQ8-Ou5-OGs0A3r6ij-D_iZwJmoF74m8gi6po1FuHeSm3xzKrGv9pAjCSP3TU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGI5bUp1PaxJSTpe1a6uPAj_yzZil0V5LFTh9bxMi3ig&oe=6A490A01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQJ9YP5QGJYQ7kNvwG57ywi&_nc_oc=AdqpV_7oPgt1vZsMZmn31VtkU2ZJJoZsD4oeer9X4Rb1YxICg4jt-tbhl0MWJIzw0N0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9-YR1Ta_6UXLkF-3fEL1yRWast2n92ZAKo0buZOFsDg&oe=6A491C2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tciy_i8NwREQ7kNvwFOyrlA&_nc_oc=AdpiEGBVkDCgn_nsQWbNGFsHryUqEbLr9jJ8jE3448fGwvaqYcDwi-DT1_PMGCogFyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxkrF_JB7czHxJuyBSVaq8v8L-3UgpAysNkYZndE_WLg&oe=6A491460"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OQ7lvybGDIQ7kNvwGC6eWg&_nc_oc=Adp0nmDWSooJG_8B237JXILWPaMupDtCM1vS2oqL701Z7Ogd6uDpbXP2y3pUp-bz5cM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6v4klpVa2LTzeRCKjHPspw7GAOUcbbPSe-WPLQ9jaqw&oe=6A491BE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YocU7NK4ThUQ7kNvwHtgSwV&_nc_oc=AdrgnV8x1jyIlLgwo8_ZQxF9xAB-ROmsMcq-eA5pH53GT4M56vNnhetMEVQJsTeftiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBMFsn6ipym0BFr2KmX0u2uy-rUoSFLvAAJV3TZGUd2g&oe=6A490244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9s1xeINl0MQ7kNvwFnXX6a&_nc_oc=AdoRQrwxxIj2hj4E8qvzSeOqcmufdb8NxkpIVYFGVTy0XR3JKjONngDnwkxw32O_Z44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDz5xSB7DkcXVe1jBz1D6wSEOuhVui6vFoGnUjZpb1BA&oe=6A4931E2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPTECCAoNosQ7kNvwHCxH9W&_nc_oc=AdrLR8gQ6DlD8yikWjbQ0qXkg04NzB48zHmhuRhSWBOqR3NMiysdA0_sBQZf_-gJjys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr_vLu4uxc348SO_ccm4QJi1vXX6JUSj
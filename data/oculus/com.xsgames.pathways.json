ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl-PmHAQK2gQ7kNvwEFCl29&_nc_oc=AdrKoArRi_MOa7uCbKZghcJ8L4GxXDO3puXXbFuBUeYEAgMTev5eI_mj7U2_rdRizl4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyKRrr4Pz_EyPsOB5ypJk5LVqwYwo5IzkhXSvij8CI6g&oe=6A54D3A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3ZOifa9SHoQ7kNvwHBEhpd&_nc_oc=AdpYvaV0i4k_mwhFr6XnC61hPk0cvY-i0iNFthiFbYKphofyqzOweleCQpGBzKBrNzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCloJlDPu2kj79YXHc1M6MswJSYkxAgzbjTM6bdoBRziw&oe=6A54E781"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqj_XNMCbZ8Q7kNvwEuMkOK&_nc_oc=Adqrihcep8DFEss8hY90n6qalZPPZ1vSm9hJWMB5tbuvpdMKmLg76axTjf7JoD1fFIU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxQHfBtyNFM0CNodAeY2glDKFtj_GNDBfhk7GXq9GPTg&oe=6A54F9AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUoABYwC8vsQ7kNvwGuoKGU&_nc_oc=AdoWbg0rEeVADTcaSMQw8qVhcaE5J3kqx_Vwh9t6_kiwJe7CiEqmkj6lx6Jv71yeLmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvSQQ4W00MDa8qouDuD5TIgSe3B2hjMWcxFwgDSON_fw&oe=6A54F1E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnoUbXWaqpMQ7kNvwFMHy_e&_nc_oc=AdrESGjwQOrO8YgGeEm-UC1Z5EaJMaurcB56N-Lu9YA3Kb6oPstykrM8ZtzIgbaJVlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdK4HzWwKONgtcdnu-MaghbwllcWkwWsXQ3g2k6ECRLQ&oe=6A54F966"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhqvE-1_X4MQ7kNvwGBBBNI&_nc_oc=AdrL5YPJbu5oEvpu_k7WqQK5WAZTOhpULih4gQI7eaHXUi7wTOY1dxtDdAC97S4CQEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ1UCvQFlZeKkToHzgKlVYnQquRAFaptpjcqX9JrjSqw&oe=6A54DFC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNMsNj5WdJ8Q7kNvwHrNzVB&_nc_oc=AdrKK_cSzcGBP5gW5f6JapKrqBP0LWslnNNk-UX3SuFaaGcH-R38Lb9kNfkHLmNU9kM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwFArDlasi3ZkWH7c0BaVTkAob4camzwNaO2hrNwJWPA&oe=6A54D722"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In4kFix8uxEQ7kNvwGjTgJB&_nc_oc=AdqSZTuCl3QwF9G7pHz7leaWzxnlFiGx4ydgnG2KI3UzxItvR_VTdl4aeSH-W_SsCkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAExX8TlsIZ5ED8a5AhsInFAAgnKV9YH1
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_GE6uQijOsQ7kNvwGUoUmN&_nc_oc=AdrdJnYpPMKieKeC8w83_6DBo-UR3TeZD1QYIpSsmhLQA5vMwsxqzRjJrZJ4LY8qclg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwX8Giu0cXuLNGr6216uFcEVN8w7-dqvoamm5RAAuWJA&oe=6A8C32A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iuDsfWG_zEQ7kNvwHbiPjy&_nc_oc=AdqhCCsH-44j8T-AypVSZnNLG85QFDe6Q9Hbv-SDFX_1unteTgVbi8aUDixRyulY9RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHZl-etSLwyDrn5_MV1Fki9NO5ptLPaZBuofm2j86tRQ&oe=6A8C4681"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0VzxB5j9HMQ7kNvwGhcbme&_nc_oc=AdogzhMyrjc-uh3Le094FhVDsAP8SS0-FPGK85HS8TK5bzDYun4VV08Ljq5Z0dV1T18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv2goABj4kKqvv3tpOm8RE8YtIAEfeJ-movVf3fKIqyQ&oe=6A8C206E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rApigGrKu5YQ7kNvwGjlo08&_nc_oc=Adru7792Br8NQ41_KUFJcIDnv6p-3xo7tSlFKrI5cFxeV3oWL6zj3-VMh6YF4PbsyLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXrt6v1VCesmT977Gx0OJWkXwJwQdKnBw71_VWzDqofw&oe=6A8C18A0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPbNqUqNsd8Q7kNvwHOaKUs&_nc_oc=AdrTYgh6XI4SmKQaD8rjQ6bY49w-5BgzSNFsgH0eXet8uzaawPkFjrAFEBSKmyS1GcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy45g7FwFoZY6onN293daVGkFhKMrM1Fpvg1yGXx9jtg&oe=6A8C2026"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDR30axcncgQ7kNvwFTp4kk&_nc_oc=AdpMbnRJQVu0Gn-7OBe5jJhr29PhWnzgSHGd0D3SIO7zFdUylV3oJafWYAGcgUvhI9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0MwuxUXtIKCAIFNhZ7xjTh4qgHZIaQq3SDOPFWxBw3g&oe=6A8C3EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hso9X9gUZ4cQ7kNvwHR2Nek&_nc_oc=Adp7uxdkxJqlCQiIy_wotAU4FKvIXMfvvf_le6FdOVpkUy1J-n-QiXfocj0zqbbjHPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGtMPB3JyOGe47RWVAn9zKpSjWuoLd27X1kFyAcwWo1A&oe=6A8C3622"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbO5IYDvKpwQ7kNvwFTYILf&_nc_oc=AdpKUYszp725DqphzCiMEu19StC9COEZm-kAM2NI3-EIhDToobEve_MuXrZcq7jifBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7JV9gn-FJ6PtP_ZrsseXlQ0vtz9aHQ6
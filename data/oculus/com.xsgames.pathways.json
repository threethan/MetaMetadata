ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCj_FyjO6JcQ7kNvwH4IzY5&_nc_oc=AdozaMMDCoQER2ZirVSUVFXPIiH-KEPkhEom6N7wFtJUkyNNMLTdTAjT8aJzDoIVG1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FcPZXnlZDSaSDRG8MZsZ0KtMwyTcJdYSI7xFhzgl-CA&oe=6A3FBBA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfDQlSfpYDMQ7kNvwFA5q_B&_nc_oc=AdrBZiQRYZyb0uTSL42Wyfikw1R6Bc_zh34-fyUKBh_Htlfg22STIEpSGRbSPTugAHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9umv3-Myhnxgq6iLETi4uVHk4eesEe8xu8s4o31EwQbA&oe=6A3FCF81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d20ulnX_wsoQ7kNvwGEcxoc&_nc_oc=Adq2Uxhktu0jjYxQsPQze3baAj97cC3v7fXwWte9YY_IqjlVLkyGkLY4LEZNAqrx9Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TiPkzmIIBtuMw1dRvQV1VZF5xIioAlz5QvuNBy-l3lQ&oe=6A3FE1AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VghgnmOGE5UQ7kNvwF6Gbkk&_nc_oc=AdqnlNS-VjDlxExdX2ZTax8KLMKx8cAUnZW-WPAWNWCo5SZrPog5GYXPZWrTMxfqWKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Hm0QnGdL3Vic8QULEGO-lU_JH8_weJxHL4oIDRybrA&oe=6A3FD9E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQKd8Hr9pbAQ7kNvwEzNP-i&_nc_oc=AdpDW73ERblveDo4Q8AboWrfgUNDY3OY6W3-z5mPILksBQpu7Cw32JrWozuD_BSC6vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pkoaFm405VEXtel6ahIAH1xeGQv65q5ec-tzLcZKFYw&oe=6A3FE166"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jSONQ8cFEgQ7kNvwGyfWbb&_nc_oc=AdqVQj36DskAy-0toytl8-6RLCdM37-Jv_KilRmKGGzgKFFOspGYRuct4sWN82aPJh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rroblyKs1Hnde3cpvCnQTkQNcuz26mfwh7kJsrxQE1w&oe=6A3FC7C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt9NfG9XRGkQ7kNvwGKuGq_&_nc_oc=AdpE50xsJc_4cByKGmVN4LWfPB6CbZhMkykLjaULKfIgmZ4BxxbwuadpicjvD3mZaRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H88xcPZEem1OUG5YOJAWBe9nCXjh0gnXNl_UzGzlT9w&oe=6A3FBF22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUzZXb2pHOUQ7kNvwHAqvmj&_nc_oc=Adq0NY-q7M3yIhNkDvi4cLUG1p5mzjSs38jaYmqRs35uvlfStsdt57ZpJDXXtiRc7QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TYx5rDmOQQqitmUwxfT7jdvt9bNkGlx
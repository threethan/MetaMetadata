ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZVoOs-XFaoQ7kNvwGzaqAt&_nc_oc=AdpED1HamyPlbHiyRLhIDzTt4OOhEnl3ZKYVlUjU_as8s3ArtFv7yFiY52c_RZ3zNq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW7AcjgY7C2DBTDm952JfDihNPe8UrUUSYTTtPE0TXkQ&oe=6AB93DE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Uv-Nma1nyIQ7kNvwFPrcKt&_nc_oc=AdrreygtopMhoHswHFKt5W1V4bnUVnfpTSFD_Ct6hTvNX1vWWUgzVt3hfTLK6yVICYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4KRWTouhLoAVovhPirwpzbVeJ1vELwdC9CD7RmI5NKQ&oe=6AB91981"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVOAGSEttgUQ7kNvwG0RAMo&_nc_oc=Adq9NORzviBez20rC8dpDTAGGsbw4dshaICcNN-Bd-XCz1FxWyfgS8Vy6bg6l-Qtd3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkOo7PHHTlOFlhqap3d8aJ6R_CN6_SrNjD6HEi0kX7Hw&oe=6AB92BAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA6m_W2izMcQ7kNvwFztb5P&_nc_oc=AdrTKNvsRCMcEbc2IymCP5ZIl0BpigPkvXa9yaHJ9oipUqw6R-ygAxu2zqEmbV988wc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUlGLZ0CE4u9nnCa12CVoIZxb2zq4spvOMFkima3YrzQ&oe=6AB923E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ1uKC7JIrUQ7kNvwEIDasW&_nc_oc=Adrz0vlhLXCvERsoddufE9fRJ7wL2hclVVirkDmT6HPOZ05UhmEHWYsnj5NKWucqNGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQOCAolSNOP5hXew5aiAOgte8EKzt9G571gr5hZgV0og&oe=6AB92B66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyenT9VNrsAQ7kNvwFyO-kC&_nc_oc=AdqXPlW3NapIfXqOxiHYihUMum6M5QL-l6GQ-jlbLIINm_7cBzKmlAUC2zuAFEEeSGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIKednCqd7l2LdKp5S5VSupJocnk0Y4Y3drfpsdKuH3Q&oe=6AB911C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uGVVRM8DyMQ7kNvwGmIJHC&_nc_oc=AdoiuWv7QAQkL2Bw1XUYbCusi6EdxTkZChtqRIAUqlMLfNZm7a_NKeVDtcukA_MeVjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbqvrYE5Z6LgfYSydxkUfsBDLAoms4LoO1zFcpTwyNmA&oe=6AB90922"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpH2HF_ntx0Q7kNvwFrjxxa&_nc_oc=AdpSl8MTLEc8tqpAQqtZtKkA0pTkMPdzmWiSsmRWTi98Y-4S_7cwx8zUj3XSgDOd9H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNNb9bAxh835_0dmQ4awDkse32u1SliG
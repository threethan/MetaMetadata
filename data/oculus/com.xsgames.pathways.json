ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4epXIiXJAzMQ7kNvwGY0LZT&_nc_oc=AdpdMaMdJUs11Oa9QVVtmAVgxC_UL0WVZLHNhuzGWd-qBleQPljj5xLHbAM0BDGSiSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96bIO8MdL8mMRog_lyVQejsAEippXkgjzSJsZymqTBzg&oe=6A2ED069"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC0ywUQ-CHMQ7kNvwGeAgal&_nc_oc=Adp7FD73p6EXWkDYy2StqJC2qiKVxSs3gipvX71PuZQ6jUCZZ0l2Dl9fdzO6qDEzyFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zQwJaUpnJDPQJS2_22oCaJa7uMYp0hEkne83AdyO-lw&oe=6A2EAC01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXwTIzkPpq8Q7kNvwG0jf6A&_nc_oc=Adosb5gIiI-6RCcJIS1oj4TmM7ly5bi3eASc9pOwtMEnSLNSUh_13-odb1DDbv4i5vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BXFirgoZEoqPU6m65d2Zk41Uv-VFvRXkZ3R97tVOuOw&oe=6A2EBE2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFGA8dGAnE0Q7kNvwF7Bv4F&_nc_oc=AdrtdPELt2AgqRp0D6MxjsaYNtui-ifZOlkCOyynN6s22Ok1JF2VRspKbfBH-gfJPQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BQMwZGoYOH4AR20SXE66anviDVb1c00o4WFy2904c6Q&oe=6A2EB660"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80LJGhHQbAYQ7kNvwGlg4q5&_nc_oc=AdoFKxk5aaH8bEj_tsw0upwPsr5u2VsIozPg-gq8HDsnqqOOjPcfnryGdT4QFend5dA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80sd6pBi6MCGncC98JvYzxqxWqSiRTk9zcWWHOPOJv0Q&oe=6A2EBDE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvSsObPpfx0Q7kNvwHtDjMj&_nc_oc=AdrSHH8Ntkj5Htpd6Rufi46qy5hmyy9pUh-ALzHlc4KI4KDPDDe6yN3mJKwhDebdmYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88OBeSyGlbOa8iIps6HfwIfA9Mk8i2tHpRtmCbfp9-wA&oe=6A2EA444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWTmN1sU5uwQ7kNvwGBIb1A&_nc_oc=AdpEeuf5uz4D_VZNUh1qozjX3bzkG9PDZ4PDwXxKP8gY2pEUIZUjNlbyyT1nkHuaP1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2-HtTirsWdFqR-B7mBAuk1m396YDjGgJhP1DL4oYK3g&oe=6A2ED3E2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32ZR-Cw1b50Q7kNvwGdDk-x&_nc_oc=AdpVag3Mve675DzCJzTjq_oHZNfEt3LPuzwRSyKT6oL0XfcEmUSbqtInG-7vY8cT3Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82ixDUJjZKMgdLzyJZPDVYZ-j0zMdCx1
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xHAk67-10QQ7kNvwFDL6QG&_nc_oc=AdrwFI8q3nwNc4X16QvxjnKTqaQQbtSAiImK1hcv6irboPWIqAjMYb4wEduoBx3T5o8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ZrjXdrZ790tJQVAmIVJGH9BC-xxRuaNlYPupbwYJlg&oe=6AAC0EE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVt7EpDio8YQ7kNvwGmvL6e&_nc_oc=AdoG1dDqofBvEl9vacZgfJ9JYpjdyIpnxScV59mOR9jJiT4Nx40Ixv_ykb7OvTrZwxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEuD3sNLGrpFMvh0eZSh7v8jndiEELe5aQD5tkZKaeHw&oe=6AABEA81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlVcm3icv18Q7kNvwHyc5GD&_nc_oc=AdpqRsRFRD6IKPTiyeEO1f2vYQDciNLP98Bv9HgVbRfoCXNWKWQytekFeaTkubss8C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA18NDDFHonWRF_8k3-EDH5xSaHsCKKNmu9si9ScvtDQ&oe=6AABFCAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvy8Ipd3T2IQ7kNvwERT-3v&_nc_oc=AdqecJZkjSN0-KVYW1XAqBS175q-OzY72JFtZdeDMAEPlV3fQJ7FsAObAK0P4Gxf3oE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnthvF3JAYLBRa4VWt60PhkZI8vV3BT64zQF6F62_uYw&oe=6AABF4E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16X4E1R6ECAQ7kNvwFpTK-n&_nc_oc=Adr2hgry5KN8uYQBy50KtYkedBhVkmwwOXpNuGMhoWJhV4HqsN2fsRZA6laqsMQHDFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3DgNBe2tnVyAb1g7OVtVyxC8KURh-rMn7HivXeR8kAw&oe=6AABFC66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ-NHX_XeUEQ7kNvwHQiZZT&_nc_oc=AdrgLP-alKLNUUd_D7HVTAhOh38e8ACbEl9WaGLcEXAnTcFJyZGUZWUo7z1v86SfRlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTkHI2XwROs1rw87ghjlRZhzgz910rGsVbWBlCUGDMAA&oe=6AABE2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nip0lXcfuf4Q7kNvwGhTMqI&_nc_oc=AdrPc177zDLJptY3w343Mn9WFKIwYovX8gNPAr8dPyAkD47lljnonx8hXHJBzo3sfX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUeVfQzpD2nUOpVF_MZVrjDUxApC9L7Re28ZltFV915Q&oe=6AABDA22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qo4Nj7g4IoQ7kNvwHc2GDo&_nc_oc=AdoeMa2Dbz7T2cLW7HSDqKXvjB4YxbJAHrmca10IXEN7k91gA5Ryo-Zu4IvJwfeC_-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhXWT7aHsNpP_XGeMjZ0CeTOAZcSXdRl
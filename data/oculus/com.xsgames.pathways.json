ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6LTud8WKGEQ7kNvwF6TgtH&_nc_oc=AdpyC5VrTVehUS4znrtxZgPYCeTRQn6ZFjzEp3Y3cPBS9gsaHDZPc47VFdduwUMgpBM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W1gWOOBJroPF8QuulItCG43kWgF_XJ43xYDFhg_mifw&oe=6A15C3E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbtRLlO_fQcQ7kNvwGwDgDz&_nc_oc=AdrFeoA9fgKfCY54IgIAD4wJn--iegGzrLeKSuo0X0kxyt5PtkewXDBcYxAVXtPPjZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZT1PPgIJMcD128o5_ID4txTJCHHt79FwcrOFFvdTxlw&oe=6A159F81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPs40B73pDUQ7kNvwHyeEEE&_nc_oc=AdpSnE4VhO1F2nmqK94G9domBG1APlUrBAfgDkQO5CVerCq8Ea1WByXe_WdlqVhYAFk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OD2BVAu69Qykou87rFardrg7y7KILkGV6RT8Yji2DvQ&oe=6A15B1AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLwJOPM79YcQ7kNvwFj1DNv&_nc_oc=AdoL-__1fAaYXSoz0jWuko9cNVQG__RFFaLE4AlBu5tTWfNpAAHjlGFe4N2b3MGygW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eOaG-ya3tqaLPUNIipvPxJ3LFdlynwL0njGMjx0Xuaw&oe=6A15A9E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BXWgKwPANoQ7kNvwE_vitJ&_nc_oc=Adp3JAYAHRJ0GhDskx6Ig9LOaoQHs9ILByMX2sj5bvz66M_E4Dop2284-u4TB1cseYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ncoeEcg61ZzdtvDWO5_S7iSQ9s0-GBiTzTiz2Q5kaWw&oe=6A15B166"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PIA-2wkjlMQ7kNvwGOphv_&_nc_oc=AdqUe-2KKAmWv1wt4JyH31NvQrkFs7qIhFaIeInbkpDTNQzDS-cMEGEXBR05ynLM8Is&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LnkawtIjJSqbbWMpGFWvO-4cSZcAHwYlYpUCKtKgfEg&oe=6A1597C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3trgDWPTHKwQ7kNvwFVris4&_nc_oc=AdqL0-KVVMF3e5zUKY2cgrVqWVxdBXRrwZDwSnazwvu5f8TllAAjoDI6SkGJUwMQK40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5batCQ1hf-K-MwOeShcBJDNbXfd0HEWZ51e7pgWkGF5A&oe=6A15C762"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXQ0cj4FhWcQ7kNvwF-QPEU&_nc_oc=AdqU9apOgHPRirgITgTN6ARVw63io2pOpIs1tus502-NVSaS8A6FGy3VvX-t9ZK87oA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gri2UBbPi3YNfODsymOYXTxmshlOyTz
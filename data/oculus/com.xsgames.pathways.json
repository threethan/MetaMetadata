ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSea9YD-sVMQ7kNvwEqNUCz&_nc_oc=AdpLTaOQUOPX9ga0_8nFK7AGfTzFckMaQrPMM5LvFtI4vBf8z1eejDFO55W0iGEI610&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xUkePhy9AYaposu9cTOo5Yo5C-9kD_g33V6s6DhGLww&oe=6A0894E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKfV2iAep-QQ7kNvwHorOtX&_nc_oc=AdqrK4Ok23tlo2FAmpuZFGc3Gp2ewu1vJuiW-ulNgcwMozAqXFy1JOw2d1VvmZf_QnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mctLIiofcwfO5f7hnMRMN28MdzNPqp2-6tLQWlDSrWQ&oe=6A087081"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArK3QY_oh_oQ7kNvwFDJISA&_nc_oc=AdpL48djS7MrrHpmGYtbAr4-Yg3RCG2R-C4PgyDe2oo3zLYzOkFoOvm0Mg7XUGYwNRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VCX7TUYbKFlCC9v6KarSQdVtx1mm_8gkXvmUdh_tjdA&oe=6A0882AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K-uWJXdZ8gQ7kNvwEZNrl9&_nc_oc=Adob65HPz3cZWFNv_sUmW1CuMYNqj3BbVfMVEMxzf3cQsFnYQsGpUIVCzBsWkuPaya4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vFBp3sgnMljvXm5QDn2X0vfDSaWRyar7b-r2nGf9-YQ&oe=6A087AE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6KnWlHdgoQQ7kNvwGOEbvB&_nc_oc=Adp99Lr8vTE5WFz6Y779uLxykKe2Hfc4aclzQRNgWDCoP3TSwqFk1_ZJ3PFpL266b-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g5nNm6-8H4ouD-yOb8km-iZqzSpD4QLkFV31hl1GILA&oe=6A088266"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzSes6afVAUQ7kNvwGCu12a&_nc_oc=AdrLtHad0swkfwjXqqzh2LXvOiqyx-f6BcHdC22xi1PX49wEVJuvgNpa_2Ca5jYJT90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UBqPrf7edOnE2TJ9-gdBjS8jybFABnuk44Z3fc6rKow&oe=6A0868C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBYsq4U40OcQ7kNvwHk75TR&_nc_oc=Adq7tPLnzIaR9a9Wk1KGD-CjJZEobCfvraKD2jWjJdslNpiRxNZy4KYu6SgV1zxRf7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55E7XfuOyDZmbjsWbTpkfpcBHundeBee4d4D5X2bmSfQ&oe=6A086022"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb0z8idnKG8Q7kNvwFfDPl5&_nc_oc=AdotOwt_0cl7zaXq-G_2x1FQ3W7lUQKBuuaykFnprTyameEiK24N5pJa1BBm2dX51h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e4mIFIQIoXYsb1fyYgID1NVubsvT5W2
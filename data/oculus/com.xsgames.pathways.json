ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-bn0G7KzSEQ7kNvwFU6SVN&_nc_oc=AdrHdDDbzNwnhAzyefFTecuj4aufH2sK-aVObXjym9ZlOTcTTF-8iHwjcUfWkzNSO78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K0oa3LP9WDWJbkfIb7h8Z5tCwlJSECo2LOsviEuC9mw&oe=6A05B9A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKfV2iAep-QQ7kNvwEJvNTJ&_nc_oc=Adojt_Q9cS4ydV9yFU-afgMc_L1fjnyStOAvLihqT6MvBZy1J7Cic2T4ETu0JtJhjgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KeF1P6FAUFRxLUAgqqpLSD4alf81Mqs1llKxGRgEtcQ&oe=6A05CD81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArK3QY_oh_oQ7kNvwElwkSB&_nc_oc=AdoaH8AGjP3PTgsV3KiII5-R8AJ5lEpxCzFRRFTsyXi4IUb9Dyxch7px6WPHZZwPSqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r98lASGVPvyI4ddXv5-tDNQKqCSU_FPXMl6lAyOTw3Q&oe=6A05DFAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niLzMAYEzSwQ7kNvwEh0Acq&_nc_oc=AdpD0du3yVnZi-wOxJRlFRmvlPQ-HUp23ZFSWq5iQuharWuO-hK3zZ1tBua8EZtoRSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TEhZc3uS3Y3uTJrl1krmVsCLeusTk36K81E-e76Vogg&oe=6A05D7E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6KnWlHdgoQQ7kNvwFh8Nhd&_nc_oc=AdoJq24C3W2J5mdMa060-4Px7d-S9_hoSZC9_EJDzms8NWjy9a2pjASaaCzMUYlcOLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L8QUgCx9wyka1wJyUwjBlsRxiq0gBnzIh2vCeuLIe0g&oe=6A05DF66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF4D6P0QiQ4Q7kNvwE_ux8G&_nc_oc=Adod4u-yi057DZOC0i0miKHRfz3U2Jn_ItWBd0exEKnouj--8fC8HPZ1BV7I6kfVW-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48wzRCXFJSTWMdiyn2k7GEq8SXmAgo2c7hZtuitX5bUw&oe=6A05C5C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpwhl-y_F7cQ7kNvwF82OoC&_nc_oc=AdrCWAYfQNk_3nOaqpCMyyy2AJ33DeLkAGwybTw_x_Dzgdg843gxnG9wD_IpComPubQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x1aP9aYo-pRKt4vfrQwttx0uXeV0kqQ2ut0yH4qEsqQ&oe=6A05BD22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0pVnflsraAQ7kNvwGHkCv3&_nc_oc=AdpCPi_n4g6wCGB71s7n1FsHcUu_zzBlWIJ05l6rqeLUPLAD4CBZI9V_ObvQBneW9v4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t67oNBcNuLEq8klikorfpe363qCU55b
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWwkFJdmP5IQ7kNvwF3WpYW&_nc_oc=AdojZCtHA1ISi5s_G0jOi9Shv9X--TcJdS7sg9fpe_dM2CF_mE1u_ypz5cvBZw4t8gc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnEDAckdrl68PXkOAJLYXZ5T1plL3Z5iIpLhzh94rOlQ&oe=6A9FF929"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy8c1BSRa5IQ7kNvwGPH-3-&_nc_oc=AdqkdbvSY9RAGVTmn1vvbbsfDLkXmuJPbKueEZEcUjFxuXWiXfAXayGy7R8juhtDeno&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPHPvJBF37x_PMhU3E5V1GDj-nuc4eDXi-wP4aqzEnSg&oe=6AA00D01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3zSuEVvcosQ7kNvwEovOPE&_nc_oc=AdpAro1Pi0dIRPab15GImznBc15CrMax8PtJFW7gAT_aSX6SSXcguQ5XfhJ_zfZomNI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2yVZlSGPcl73EjDwOiwXCptDrFNWFOOeYSmUqzUAMmg&oe=6AA01F2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmtUnt9vVEMQ7kNvwHMMrbT&_nc_oc=Ado3n0442S1JziI-eFk-ra84zSXeBBIsK_y20Umw_3Gn-o4xWnv25N3ooXnnB62fceM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0rV1V_ogE12nfDFR_ljrbDsHT0BGENNTCs4p64521gQ&oe=6AA01760"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_umuAE3oHwQ7kNvwE_630a&_nc_oc=AdpQwSWGbUS05O2N7uyoK8MCRfIV_qydRqcUyBnMbeU8IniuHHStU-3PKiNzTHBIg7I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsqT4_VsAjvTv5nrm2x3vMsrLPzw5tW41xp-opbadjkA&oe=6AA01EE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRWSnjmlPy8Q7kNvwFTIHkG&_nc_oc=AdoduURVETtSI-TnZ13IqQqxf7ffY9koKu_1VAaPHHJO0onKbYub61mnPuTeCO2_RsI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg4Wp7flNymrdhNC0ratPzCfTytlx6PuGTvkmiaJmjjw&oe=6AA00544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkHYKGvPUEcQ7kNvwFFsspw&_nc_oc=AdohhgeeXroCyIDr8FnkpzSc24s6yBlgR5enZovtolImMtscevppCxJIoXdH26dE4ow&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-2IDLlM0-_Unqqd2ynLpJd6zmANk30R-ZkdGLmBiflA&oe=6A9FFCA2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYJv7wODLPAQ7kNvwGdtdKA&_nc_oc=AdpEjaLS585BSqdzo7cNzqP_iFteDfKqidk0c5xm9yibqbSyMB0pDOx2EfiunDZ2HvM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEuHMpthCdVWr-PXU0OPEd8d-hDwMn_H
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByNzP22ReYIQ7kNvwFrXMx-&_nc_oc=AdqN6RoaAT0vg0OoPsVRS0T7AkL2bppLR3zU3fhuJS0sEUKO0suVpe7iS08NRvzygrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKKmv8K5a4UVEYQqhAxtJfLJgEl-O7vJsnG750_tu4Cw&oe=6A82F829"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AS1LqEfArcQ7kNvwEFpr62&_nc_oc=Ado2Q4RBJy5A6myKceXb7V2XPuu8Hogy8sUzq0tKZSXmICzv3m91C9iOY5Um-TjyuUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkTSsZxomSl9qzZjj-uqzIIpXzFtUGChJpAXn6QltvWQ&oe=6A830C01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laAEBb39y_0Q7kNvwEJ5bFN&_nc_oc=AdrA4fKSRy1Vk7KvQ0R-eYH8egBXn8dSN42iVD09JL6UGuXkOuOiE1yXeopZd9LzKvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq1n1Gofb1SWGweqzmQUxgZvdmhTkVUeH6GjyY4gvJyw&oe=6A82E5EE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QsquZMNTzUQ7kNvwEJBgBE&_nc_oc=AdpQUptuYsLJzxbu6Z97K6GMgz8le046CjvkJS7KSFMvbcyORYd8h8DQc8Z0SFl4g8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSZ7otg-22vIGkI6bQebgM-WgtSq5Hy7uF_NK2hYU1lg&oe=6A831660"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWQpH6A3yesQ7kNvwF7MkGT&_nc_oc=AdoQa_ml5CTn0jUwNx-TiIlU_QWgFzpJMO8vDIxVA8KWRpfVt6_gxgsN6BRPzOYNlpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUQOb4dzvFtLA5JdftsZ3jH09Sm6A9CM6nvYzmULQE2g&oe=6A82E5A6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbohc7_xzJMQ7kNvwEAbabF&_nc_oc=AdpkMuQLCfEcZbD3Zh74ECEw5W5cdJtcPjqAVQ7VlCK7D8MHH2Ekn_csSuNnz01VmZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR1AfKMFr7k44b-yOpi1prhsWH30NNyS8iTirMLN4WLA&oe=6A830444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjO8ZcjSU_sQ7kNvwFP9z6X&_nc_oc=AdpAQLqQ1mb42mvLcCZbwOvbQ41SZA3WEp6sNwSfIee0BxbD_Qh33mBMZ9gYCFlDX4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtT5O6daiJ2yuU_VoVu-yWKtZA4u-FwV6uWirkaUntFA&oe=6A82FBA2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eWHkcQCobgQ7kNvwGaHuu3&_nc_oc=AdrL3jLTrurWtoqqUXs6jHLQ60SSQ6SBYIykeNcF5dYNIm8ob3-XlPerXVPj2JL1xQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnfrT07mVTC1-ZltMJCikbB1fS0TADYg
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=234-YOrPft4Q7kNvwHU3-hm&_nc_oc=AdqhNqnYD8hSUnmA41_UAXz7bg3VHFnYCJ6PHQpZMXxEqivAlWZ0QlfY_AyZ5IMDF6c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRWgRv39ErhA4V8celqxk8-AsD15zNlqPBia8miK-iwg&oe=6A5A19A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2M5WT90POkQ7kNvwEoRtE7&_nc_oc=Adr_sINijlxHH-YbTJhL3Nq3rxnSxm5f2Vq4OSn_T4f1Cirpr84ijdKLqkAtIJb9I64&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDxRObtnXw31-OE_XErDwje6cipZcn7lwpDAjiFoLC8Q&oe=6A5A2D81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p20R05b-q4Q7kNvwH_QdAS&_nc_oc=AdqRqG1fpPmgTTPgcTDXccCkTjdIUBnee8wE491-kkxFYJlKHRNfzw8-D8A9ZGxNUlo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmMIYyCj0lLOKsbqWrQ7CT_itZNseGAy493S9fZWSleA&oe=6A5A3FAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dho6Gz2NxGcQ7kNvwGd2wKK&_nc_oc=Ado0aig07fJp1hXsazgNtXHHcpkc1mR3dQWBezo6fnMz94DlOg5oqAptG4VZTLtJv4o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxvFfhUt_xvMqaHNvzBfg3vCZNLb1WTGBOWyG8Q6VLsw&oe=6A5A37E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPkyrI0EvkMQ7kNvwGl6GzS&_nc_oc=AdqJu-y7ES0Z-9CEHRPdjIT5qYqLify-alEl1YrFBwUWEhdLxDygoMEUafHGE1veeAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATr_AOzYOR23jWKZa00y0SE8KgQvi2bJY1c4vO_w3lzA&oe=6A5A3F66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS219kaNOEcQ7kNvwFEcz0d&_nc_oc=AdpPMvE0wPmR9UC80HVj2MIifLIHKYjnSgq0GV55VZLAKP_0NZi6yauoHGDwT8QxrhE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPbQ083LJzGBnlXdFG348qjHDDWp52WJwrL7koq7i91A&oe=6A5A25C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M8xoN-0kp8Q7kNvwFWRBgC&_nc_oc=AdomC84P_aQl3QDck3YvkJXg8ZSNV1reWST0kG8vQ4kAc0clj8p85Za4sMsujVh86DQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfmwrc_PpyLSuVlQ8IddRpsv-UD5G4QjQVnGI1pqpiGg&oe=6A5A1D22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZfwmInSqgYQ7kNvwF3-wSz&_nc_oc=Adqex5cJo0d5HouSoYGWcCG0kjuZfvCsfMcya8q61Efg73z4XU1dYV0-KduMucYjEu0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD4_BYOVU69zLpuy6EZkcdKETkM2e43-
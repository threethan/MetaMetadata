ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6onxDWxw0L4Q7kNvwH6js2J&_nc_oc=Adq97T2EUs8-TCQwK-KkFu16cfDi0fIszVK-ONl2_i8Uiylak57jT6oHK1-YxibY-_Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dTcmJ3pbH0RfVTHwknqISa629wF-fF2fNSaeJGKzyLw&oe=69F49629"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phY04J4lWwAQ7kNvwFbXCIN&_nc_oc=AdrvOjzlY16d40ORBdXkZaF0cOoxb5SipKaOZqRDUHBoquL1oP6AwSqN049gyfvQm9c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2g4fS7zdM6quZe892lJxs4hKRzXWUMsnZsk7sBfLbjPw&oe=69F4AA01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agICnxCY0YwQ7kNvwHOWH2M&_nc_oc=Adq64BY-F1gp0Wt_JqOdZEDYm4_VAuxFHC2KYE_9vHSC38ofVul9ccYswiqxaZPOO8w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SZy1QLwtK_vN0fgjgvhr1biGmSfV9JnK_VooB8H8HJw&oe=69F4BC2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTekS2JcndQQ7kNvwEOgr3B&_nc_oc=AdrL6Qh8Yd-jQwyzjUvgxcnPIz_Cbu4eHUo-NSFgoGKNn9n4PKORCQFZUr7xjzfTpYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aRQmf4ab9JbBULfC5Vcdb27mk8vJSdczHCFOFGGaAEQ&oe=69F4B460"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7XI4DyADhoQ7kNvwGODpG3&_nc_oc=AdpkvN6F7ph7yisnkXV6qThpE0fHBMuHAFUqKYWczmByV9sCof2k95AgRp4BN3xAfsM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15NvzTIOIBtjndK0Z9qY61zWPRCvSDDrOrFF_UFCtSTA&oe=69F4BBE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0uWuJLos74Q7kNvwFH9zly&_nc_oc=AdpNaMI_dfKVTqL7M5--08nkZvU9qYN0eFvhmbxqzXxHhFO2Rr5uuIuy6O4xouc3vFo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w47uzyBa64O8WZYhS_YbBFAYhLOvFmZnEXT96Ryv_Rw&oe=69F4A244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFhaBGZ2MysQ7kNvwF72vLV&_nc_oc=Adq0jsFwA4zS4BPjtYfS_NzjarTzsM5L0pYNAxR51DmIyEyz9QIC-3StP9MVDt0KEtI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yPTfTmAHiarNDhsb3jAzUPC_pVeG-bQBmZj-0B1aevQ&oe=69F499A2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Sau2UaDmIQ7kNvwF0PzP8&_nc_oc=AdrQFuVHyagg8yKsyiy_JpXOqksnhSx6tPwTVx4AHJ2WFmuRN_z9_Nib1uZFumoJe0o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KfCKA6I4aXXg7M7pBt8LOnj-MKe5IE7
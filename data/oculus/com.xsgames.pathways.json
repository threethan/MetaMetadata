ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWVAoiQ2lO8Q7kNvwGqDTdL&_nc_oc=Ado0JU3UY45iTjJZV6ufDKHaXjdDs_2qnA6dDJmj1WRyGOLYk-HTUVw_1Pnfp21Ys8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4R12nMnSCLjCHMfISE5JGyDUDw3B8asrdo3FkfZ8PzA&oe=6AE0CAE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQbq2y5vcqIQ7kNvwEspwmE&_nc_oc=AdoMxqBiioFk9bfkqjznZZgeDYdUflB2uI7qYyYZ1_szpVuptDxHvbJVCxbGsy_t3Zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNKeIFmOXO5OmWtSn5NWg0_OQRaZCzOPkMDwp1iiTboA&oe=6AE0A681"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXQvIqUx5-wQ7kNvwE9wBCZ&_nc_oc=AdqCvKhcHFWf33l6K5kQqPraJ9PKiKhs0jAO8TdE2baoGD3sYVvzenPmuncWJ721aAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6ZJfZVsnL1raZMmYDourctISFhFBVu8zbqlK40r0YbA&oe=6AE0B8AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujsBiwz4UBIQ7kNvwEBWh3c&_nc_oc=AdozPTmYntotBkD26jrK3Exxes2nQJKSkXpyvXrOUqznPSV7PwXtXubQQpe79GsnEds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCHm70xPr41zf7_crquKIzftRi773JaQSZLTokF3Gp6Q&oe=6AE0B0E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3bfqC0pp3cQ7kNvwED0dZu&_nc_oc=AdqCQsQj95I5kBl4BCNTZhKLaDwvtMBfdtiZoawqpVe3yaevTK0s42gmpKXPr6XrZAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiRDRFpuZ5oQT1LICKaq-63jtnWK_VLaNzFE0SB9gOjQ&oe=6AE0B866"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBkatPlUgHsQ7kNvwEVOchc&_nc_oc=AdrPdaxpeIdLUFyjuiqBr4gzzd2asvUpPgNmeIDoUDgey1KI9rTTA5cFd6zkwedm948&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMsjVOj8PXH_eM986-zy7Ufem_J-Vc8HmSDTGuYgzOjw&oe=6AE09EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kInTFl2mMKkQ7kNvwFCjki-&_nc_oc=AdrjmC0rZxWGfkSOg7I65PN61di-3aRa5C7QfATUkqbz0f_9qnd9_ftNFSgS8MNonKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnXhB5iWtEyF6gA3TgNQV1ufUSv5INgW2LBvxBvSE6Rw&oe=6AE09622"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ4EhyffQfAQ7kNvwFC0xbL&_nc_oc=AdqwldHC3VBl11_z_KAQcEyADi9dVbu1l8eEFAj8fd6JF0UTGFsMLPDhahQ8_HN_eks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ98yE7EdaAeRktQzDSqhzRxG-1OdRw3
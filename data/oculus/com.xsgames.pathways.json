ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfUDzvaCkroQ7kNvwHb0wy-&_nc_oc=Adp10Ai_PEqjfk8BLMHSPcvcf2-f1vh2SsUcAWt1CCeGmh21-AbhzdI6UDMy4sP50Uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjVeW1_gNobQxMEzPNIYPTQ6suTUBnzb2ItFk2IiAFFA&oe=6AD24A69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inzdsJlpoZ0Q7kNvwFuXY1s&_nc_oc=AdqYnxP4Lz-quUl8ebfbvvX24fLGhR_Z5AW9NJqK-zaBq3m2VHn2mopS-cHP6P9kuwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB1pumwYzlC4S1OJ3pBHfuPv3eQCY41JGMNijp7PvrGQ&oe=6AD22601"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mQk7nyqDZgQ7kNvwH_d3Ri&_nc_oc=AdqGQtlpBYyBBGbt7S7xKJ2Cpn42yWPoOD-YTWNb-ofg1nFJTJsFqgb9NPgcZ3GbYHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMBsjNUZ58hM0RzDP-HDLXccgmfXce3P0oThAJiSO78A&oe=6AD2382E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHWxQyVPc3cQ7kNvwEHjnPW&_nc_oc=Ado7Pmny0hgg3Xi0o-fIVM9gg0mVxN0URpXJxyutX5OiLzUqRzZRsQnW6J7ttqQ4Nko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObRS81YW0Dkz9VbTC4sToMuvsrlDcw0jjdxRYj04JI8Q&oe=6AD23060"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiEGSuHXSaYQ7kNvwHTM_39&_nc_oc=AdpoC5mRfIEySeeOa1JtYND1AC4jK5kfKPu433xnQVg9MiTCynMof_KDIqtopYXzh4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDYpKYtreKTvER3iQxaM1gkRVub6e36Kdt98_K09bsrg&oe=6AD237E6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpuscu8r4G0Q7kNvwFGt3XP&_nc_oc=AdpAnx8sn2nF2jVmpVafkto_ydKw8KRDCNK9kznl3-Izha0iisSm8G8mkG2-WkWP6OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQjbyzVqBB5eY6HW8QdOuzjW6wSeih4fTttilX418R1w&oe=6AD25684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pm2tE-OnYYQ7kNvwG-Kptt&_nc_oc=AdoQCaa01Shgti3a6waznFVqF5L4zy8PeNSUj-yaMoUIblHsZjIyKBQSAncVyDnrfcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9ljvjUeoqnIaunQV2j9jdDV8xXhSk_N8dn4eta-KuwA&oe=6AD24DE2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es7_SzFPsb4Q7kNvwHU_YSU&_nc_oc=Adp_AVUVrQcCyligCT1IK-YT-r3smTO6YO_q2gF03Myo64YuGjK7taLvHsP16Uy2nlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8648SCowsYzulH6cSXw8rYMWlGetBe_
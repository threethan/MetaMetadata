ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ir5S6kaspsQ7kNvwEw7uE5&_nc_oc=AdpZKckJdWoVD5fTOC60uz_SvlaBS0P02m45x_JWKQ3ARXAfAUILb-nj3VJGczfZL88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIehmIZ0g-B7uSaH27VulNjtq70ooNJ3ldT6DdqJhMnlg&oe=6A9AEB69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79FX4QdPtC0Q7kNvwGvgEut&_nc_oc=AdptsOVrS3y1jYGAezhJzWKiWRNtGiNhnfgXwQDIzq2hvk1f7DyfRSad-abLd8iSTrY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk7g1alwhvnxHZ2YIV0GGxY3Oj8yc8n5GzUx_Of94iVA&oe=6A9AC701"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG1elkEHtGAQ7kNvwGJAke7&_nc_oc=Adpue0aaqXOARjf6BBunopaoJhWW5XWDj52bDhYfrIoy0o0JtnQlT4nV8xNN0oz1dnQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdL1dRcBOQldUf-gynfW0uXOHo5E_UpvMlNagoOF2kGw&oe=6A9AD92E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APbcVU4_LlgQ7kNvwFw6zl8&_nc_oc=AdrrAJAdTknVfGemdEoI1iIpu7j15C06mVCsdN7g0jyADt3-uNFkQvStwaRQaq-2zHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe31iAIzjerQYsn1RX112WpwSq92FzWY8z_ix8Z3hmmg&oe=6A9AD160"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_HJKCyZyo8Q7kNvwFt1dDO&_nc_oc=Adpw8JXha6mmx4_mG0mY1NjRZxow1UQCOM3etCNWfXzNd_JfsT8DHtUlooIry-hEXX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHj0gANDlYeBlfuiL-_27L9GMCHvOQHJb1DS7W0sETGw&oe=6A9AD8E6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZS856ddNfgQ7kNvwFab0oS&_nc_oc=AdrE5s7LnIFGEXNBmtgCa1_O6l325XFh7qBRBN3FekuZb1w2OxbuxnDp0RkjVdpqFgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfi7NbgAMkKzf0w2Xq3HEQH0qxHaabsEcmP-MfWMYCYA&oe=6A9ABF44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdsgTwGHDCUQ7kNvwEzgRx2&_nc_oc=Ado7_BEd5RhY9xXlOiDv0Xvq6tTj68ha4jE8VGqqHKJ9WRWX9BvJpwqgVU9zctp9e4k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMB2-yEglPCqICpueZCu7rmNZWK7DZ2h362UUhy4bDEA&oe=6A9AEEE2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eOv_UzF7hEQ7kNvwHV8bac&_nc_oc=Adq0A1LGdCCDAeUcMkcqualHuBIaRlsumwY422L6nLjV1oeoED_pGvSbrb2hc7rn7KU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHf51hCPTltuWPlutQwHP0i3hp1d9IQA
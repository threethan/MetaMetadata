ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk0HUFw9VcoQ7kNvwHeTcJs&_nc_oc=Adr1YIaT6gvFYCT-ucORSPdSxHll7RoSgYZdpgmT0gKrDHf7YnwwQHSvey9rYKRNihU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsX9QmX9tUUvtsFAvdPTMQkxyPFsFZImpTWT3Axbi-RA&oe=6A708329"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNcLLQasQZYQ7kNvwEpOEMP&_nc_oc=AdqzvwNKUAe3QR84BllWB2pXOFYQcexZSha-YCQbOSu1eDFlKP__o8QKGGAKTIwuFz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEbymISrj7Dstk3K2gb7DNmLEQtKXV65opF58rb2bPPw&oe=6A709701"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyj8AmrPe30Q7kNvwFrJxnx&_nc_oc=AdpfroWQAQyrLLxckLn-mPl4AHuYeQepZ_vKLUDppVRyEc1rM-3RDgHPv-paQdJ1w_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCA5YeDehKmfNeSvEMmvYEimcl7e2BAeq0rHeqpzAViQ&oe=6A70A92E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiiuWaMvLB8Q7kNvwHbfSrl&_nc_oc=Adrw8x6dc4qp5A0yV6qg6A_KDNE6BjJRzTjaZZUXSb2erXHh6Wy70kQHXj1XarIOUkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUxhA1QsZo8wp93K5UKbSRwCwTMuqh6lkEIIee_OU_pQ&oe=6A70A160"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_IVF0M4ggYQ7kNvwFRrY1A&_nc_oc=AdoKIC209e3MRLYJIhMyGKLEB4fq2wiOB9ns_1plRY33ys6rRynskf5HDQg6ya74ZyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGco1R-gOYkaoBT9vxYPNQRJlSw9QGszccVOUz53vN_Rw&oe=6A70A8E6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbehg8Ebjd8Q7kNvwEXWhPR&_nc_oc=Adp9INwTCfkNM5psuyp7GXx-rKAZFb9fIKrweN7mIWGJ9C_trtxtBnV0piMtyJhAx_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG27T740UZpA1T3gqnOi5TyJlrwmAiPKWplbj2asv_5Dw&oe=6A708F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXHmmJZsElUQ7kNvwETVt_X&_nc_oc=AdrVKNvWquSJpIYhwmrRpiaUirt8jaqLzcGiE26fgtAi11tO7Uinqh_EWOXLtR4FrPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXcU6FNuv-08wSiKfEkuR1vvvdVmzsFSugBr9bnjx0vQ&oe=6A7086A2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzK06B_u954Q7kNvwGHsg0i&_nc_oc=Adru3dxEpSjfMGsFk1TvuaOYgt098z4HHDKgt19uNIjigVyYf7prkNHNoJPBz8SxF3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy8q_ehk6ZcXdwHykMupGoKICAnIZDN2
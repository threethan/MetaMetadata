ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jycud9HkqFsQ7kNvwGE0oUd&_nc_oc=AdoaSsiDb2TwZa6WDzXsCKkviX0JHhEp4o0_W6jzh_lRAAjcshDSG9BlykjE4GHaL2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC2TLkglLCiJtJ5OvIvq4PD7jrnxDMNTT_FI4IuaLpoA&oe=6A95DDA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diE0XmPqwbwQ7kNvwFNEOrV&_nc_oc=AdonxAw-oE2nvwUifaJPgqQcKGIFUHzTsPfLHA3iuMlxWQsYOfPUqJWMxxB4FepkCKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjnT-BkXOC0_LTKvCRWdCnOUi-5Pb45IgQi4a2hgcDvA&oe=6A95B941"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJxaDk2j50cQ7kNvwGbfUOy&_nc_oc=AdrQaLoHjoEuYVqRoq4bUEImEBqrAm0zV4naq_uRlT4MVRIPwxNA0xPDFdtt1bx1lSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1W9UbaAbfncdxG0oz16Vf5LnZ8p3-vYPl2c83qcyD0Q&oe=6A95CB6E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvTbRU1HwmIQ7kNvwGHG3YG&_nc_oc=AdrsoU4_JHxZCsycFbVch05YBPbWDPOajrzLALaHXf6uDPVVj95cvF4Nvy0sBfX4S6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEThpwsXhLqY5Q-bj5_JM8TrN94NER4IG7e2cxqjEr7Vg&oe=6A95C3A0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iOUWYvHc44Q7kNvwF13fqu&_nc_oc=AdomhDWGSjfM8lmo0KkTimtUP5feGhVz__FxeO5-gzNA4VkIMkafGBdQe3rZ3fc9Faw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQTO4-GZlUaoPYNh2XylY5smNTpPJSzL_oPlXiEPkLww&oe=6A95CB26"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ8d5FTcscoQ7kNvwFlLUiH&_nc_oc=AdqJ6A1u1VeVBYrB-i6Dclle1ipnpQIFn-iBh9dt_739F5VQV8HPQIO-7pwx7AfN5Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiOjmKEmQRT8zCvG7yF9t-Zj4zdrL3fSiFhzlKyq52Jw&oe=6A95B184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybRLbcOZPaAQ7kNvwHlMw2Y&_nc_oc=AdrAiZnEz4d8AlhKnBvUOgyNlrjjLjGp66mgx7rjSOZeK456LDqZkyTsXe1xkfu71Tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeWYhD4mQMC5vDQBnKyvhgFs9VVUhHw5MHKhInJV9Zvw&oe=6A95E122"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZShayRs-3QQ7kNvwFnYL7-&_nc_oc=AdqOL8MPc-X1Cy0tuTGoFyLTCjsBLZgr4gpu6_55V11Db_g19Z2I9hzkWUULTVIQO9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjXmsgvBMZH6GGEBuLTWiW4z1sJ9Yio2
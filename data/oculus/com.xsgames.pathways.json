ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrBUmCKg3LQQ7kNvwG6QLVv&_nc_oc=AdpbTIqkcuf6FDQDmR6-hzUUM1cJ4RrGSlMmYfxUpbI6zI974l_nR6bEZc27zGuAu3o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TEXHQ-LcPXwlDG3RxN46_0Mt1MswTN-0h3aKKfY5Eig&oe=6A4539E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGVbRzmwqf0Q7kNvwFCMqhX&_nc_oc=Adoqvy4eiu0T-aVwDKfGASpNG67TgCrdy_NQCFiSihZ0ew71M4tzJEqo-qIXxgsSFLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EXqpfMbyg8nfDNY-jQ03I5plYH0nYfsYxw9xe2gMCIg&oe=6A451581"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lEy05KktjIQ7kNvwEypy0Q&_nc_oc=AdoFRj56KYgxztVtYEvfCJyv1Ptx6iYWd8pcf22D6GPUucc50OIxNhvEdHtuZscl8y8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af822zsfJpC4RdItKMQj4AmDGCHbrXGF3WsUtHBtGDj2Mg&oe=6A4527AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEyqXTsxDbQQ7kNvwGKt9wx&_nc_oc=AdpkvRiSB1FPwdd6vQ677Eiixt2r6ddg9aRAAe_nWmqMmBOIqTsNSWK7kGyguE5htrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-acDAzZT1hT2rdpS9YDqwQN0eBe8MRLZVTRrl_4E5c1w&oe=6A451FE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E49RCx1ooi0Q7kNvwHoEmUF&_nc_oc=AdpeZQdZ5bcleAs3zUdSG8HGBPDxKrPjDxuZh_c92ocmzuLOsBjIfs1TSDYIJKBgH3o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jC4f5UMv14xWQSQ-XnHiPB3HVzr19kMZh88WrOwpu5A&oe=6A452766"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIszAEicrhMQ7kNvwGX_3Ty&_nc_oc=AdrwV-tajCodjmS1pN5Uij4jrZeu1Vl2kkHo9sdQqwyR4CQz16wN2GRVYB1YK9Ss4pg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bRWCoPL-qmzLW1EIRYxS-4sCuUR6d9YP8QX0wq1bpgA&oe=6A450DC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQy7BGh3f54Q7kNvwHgO_0I&_nc_oc=AdoFhPn8mHk4fUpBGDKOeur0eYxSg1gB1TwaRuTEj6QaezJCTk2_8Y2hb3H9lvkMXr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O5qTm5iXqZ9JrenBtOPdxtV697JRuRE3VpnHhRliALQ&oe=6A450522"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-9GYfMKH4gQ7kNvwEkXVve&_nc_oc=Adr_ksBMmBGrDEOITbxz1JMZ32V7ycVj4XC9RCOQOPrTctEHWsEONemxupZt5502aJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HdNLpbsesM_y1qHvSC21UMbzipBaCIK
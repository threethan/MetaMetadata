ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=234-YOrPft4Q7kNvwHRFyK-&_nc_oc=AdpMQZ6DDKzl2ew4Hl2RQmGsqAV5VBBxEsYtPD8J2IxDkNZVGVtonli3wQI0KyA6-VY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfTAYMEn1nGDo-9RQnK6DqO1EpCGbzfKfEQJUq80QDdQ&oe=6A58C829"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2M5WT90POkQ7kNvwGTNC2I&_nc_oc=Adrd0aOV9ZtaIwDydu0bvfei2xXEsGVsMKtoCeq4wnDvZJxE7K9L-vQw-2WpVPQwUO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKdBedGxwWs_4Q8ONeW4yqPYGXsQALU6gYX1vbnhqTyQ&oe=6A58DC01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p20R05b-q4Q7kNvwEZYoZR&_nc_oc=AdrsBs9KIZ8g19TMNqhnDpscTN6kNaVmEgAVZTLKNY5GflwiFLaGONtZgasd_DbS88E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUeFDuiFr7zQh8YTY7OOV3WyYlqEsrvynKWH13M-igGA&oe=6A58EE2E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GqhDZUQr3EQ7kNvwENTaRd&_nc_oc=AdrnwgpzN2cpOXI9xD68D6ZJvneGWrZAd93H-ayhFO70RFFKvPAfarEpG-_tG-AbKlQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMCTaprll71qF4VZJQ-e26_-Xp7Z9AnxvD6UopVn4u4Q&oe=6A58E660"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPkyrI0EvkMQ7kNvwFbjnQK&_nc_oc=Ado0QLjpeW77nyFGggZSYJS5xgmVE4P4Aq__4XQmNxtKMDQDXyz2xDtwWxJ6AAPjAGQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwnoaXJK1Q-pnDKCn8ynjs3qNR3MuTrC0aRq_RCkVeBw&oe=6A58EDE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS219kaNOEcQ7kNvwF1JNys&_nc_oc=Adov0j6gyx-rpSnur9OrAJIRayyqteatOQ-k4L3797BvSsa4G9zZZlzkI9FQlX52qD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3a37ShlEGFSFgMOk8irbxRfTMmoBDGSUFx8v-O3okNw&oe=6A58D444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39xN5J27cH8Q7kNvwFsWNWT&_nc_oc=Ado9vPqgO3HEI4Ah79GnMM_olc6oESciszN61SaK_Zz6q7qZJL5uAZ-O2GwLpmORVCo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS_kuBODlAeUVqffAAfS5hR0tcmGPbk35CQ620m5g1iA&oe=6A58CBA2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzGjpASDrcoQ7kNvwHqGDFs&_nc_oc=AdrE-rKHEBosEOR7gR4s0rkOCVYoz31-Dz1LoCY7xMcaLglmg9NXv1iPM4y2fXvD-TI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJSjwwmzcbQeBwCTUTU-oDrUkRZvpjyI
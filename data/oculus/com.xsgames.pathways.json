ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSea9YD-sVMQ7kNvwHgpWvR&_nc_oc=Adqw5xNEpeuwjAiLQ5YzyiOO-EISanK4UC8e53iFDmLtsnPErTzwF3VKyvxlNxRingQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FuUXhCokMJVnpMGYpee106SVwguxq_1cGwkgmxyIWHA&oe=6A0B37E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq0llwI2uT0Q7kNvwEZWXzz&_nc_oc=AdpA8AbDvWcZkuV5oNHa0pPuPAz6MMl3zr1kKdnOiE0U_Ydc21FPkojHzkdFbZ3E7S8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zGJ19vsstMI1y5-25P2hRYCilXh5UKkQFPJY4BUb0Dg&oe=6A0B1381"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCebV8roC8oQ7kNvwF4MVwB&_nc_oc=Adp0N9AUI3vrNSVVymj7r9a1_xwtsD6ATKBPrbm9MJOBVOtt4ugF0wgL9XlCycVrScY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GHkDtgfaV_XCZY38c24yQEQDgoFY-o6Zh_7MjEpS6cA&oe=6A0B25AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pvkxMQOcZwQ7kNvwF63vYt&_nc_oc=Adoo3ZenYiIjm6tPEHM8YOBFWjPpJfO1mG74M24E-i7_nYzAw4WQ4-ur8vTB_hFxPm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ndesgiFLti4PYPQxHjgGLn4B30aZ_z5cnKAPmQvrpEQ&oe=6A0B1DE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YicdYWflEUgQ7kNvwG7wvHg&_nc_oc=Adog8G2JtlVeAUJuwPn96BfDPyNCGyzM_nBsa77AGCymKiiMFIydBNPdxrnFxbcHO14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fCHrwK5nyRNTcbhgavSPPrqt-c-QXGddZ8MtA1q6lLw&oe=6A0B2566"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzSes6afVAUQ7kNvwH04fun&_nc_oc=AdoYtdBCGRkgbOq7h7V8AmXlhKj7lK37rl6Mn7QLM0NjnRYj7R3kDOeQjTHHAf9m7tw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_uqcDTahM5iut5T9vAvCRzHvtbkt-NY_tG6CBPmgn2Q&oe=6A0B0BC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIhzVQiWi_oQ7kNvwGBtgBi&_nc_oc=AdrJ9QQxNqZaVi3UQMvuvtIc4lztc-W_qXv0Ys__124jrmc0FypGh3fE2-1Hg08eKj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tdvVZR3hE-oW3TX1NoBs3W1s7Uos8bJ-218cBJfnL5w&oe=6A0B0322"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LVr1fCutg8Q7kNvwEqTEoT&_nc_oc=AdppEO6EdI0SDItw_lv7K4etHJEUA9mKRzxzSa5t5e_1S6Co24Kh5GrQRNCwr5XQov4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WRHY9JygJ0LSBhNNXuM_qhHMRBeuF5R
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7bHr89BXT0Q7kNvwH2E42F&_nc_oc=Ado-8VnEqYSMdwau3HHApTfEOggZ9JSiIjKSp-qnkR1Xz5iJ_IBSoGFQQMKigaQKTJ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSU5Ahddhfn-n63TZFGi0DjlIkN7oEdhqIf7y_wsOIbw&oe=6A689A29"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWiGurgH4lcQ7kNvwHOVA1G&_nc_oc=AdquXi-9H_hEBsuI8Ar0G3Ld6Q_DpG6VVkqSa9RHSaOkS31GCa92OJ4ur9NE2j26F-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBdqPcOuh0QtToFC0DxScscxGUn16UmSVhdDhw9ILhig&oe=6A68AE01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OJdRFvNJC4Q7kNvwF6Ww7q&_nc_oc=Adrek228XRWqA9Pco0dqMQMioI0qD2LTh0ehdqfV0mwUsJYyM0cwGizsAj7Y5fLBxqM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs2dPnXO_vWcKuh4pHJJ1qbi6u0To-qDakeMVD2yDoAA&oe=6A68C02E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xsw6_NRQKl4Q7kNvwFvIPP1&_nc_oc=Adpu0lzi9xANE1EEVhNMOIHbDNXFQydpq6Qpdfsm9JjRyOIS-eR1xcLTUVvQQXJssOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrdswm40qMBVSZGRfXxEAIN-r0JautPD4xDFhHXK49Fg&oe=6A68B860"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6UuIPURS6wQ7kNvwEhJwzC&_nc_oc=AdpDM5V089tJCgHiDrMTFb6L-wxOkviru_S5NPRNf46WDjBttikJ5yzQbvxFYgu7kco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3ujAI7OTmEZggXpL3eslduGkJtGdDrsnamWj7w1kQjw&oe=6A68BFE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqZABqBIcS4Q7kNvwFYjMYN&_nc_oc=Adqst2TZiY5wvjI1UhSDvjJrGPJapxfMV-7ivZ1z_lNHOFBUBtJYLrH0hFrr6UxSNRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC3HOae83bB2rdVhHdCfXw6O-nUTI3nwALLinsI97FlA&oe=6A68A644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk5vPE3pDzcQ7kNvwFZ6N4a&_nc_oc=AdrvDdEDGac7Ap2zmBvStgeCZt3rGqebcQrUd4UuEgorzsRmDp7uhceWW9GLpvLPUmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0ElywXPLakg5IzkvJbWdBWwEOSIpuc7YyV5hUoigTTA&oe=6A689DA2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nczQIcLYTsgQ7kNvwHO7ew9&_nc_oc=Ado_uqVs5ULhysUo4_IdEZ74Lb2jfdXrANyfpcxLVrZKwkC7cZmR3Q7wreSPJ4LR710&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaIW7C-4Qb7SptBFIFn2TXQl2UUJI-C5
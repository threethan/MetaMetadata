ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz3Gmzd3tsIQ7kNvwET5mEc&_nc_oc=AdoY9rXjRCFbCVqwZHeaBuODlexV03vIlzaxxNE9NirCVw4xuPe5nSkGOL095ONb5HE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOHKXCRxBefDkwJQpyrwKb2RJ1bpHIdti5mGvE1TFYCA&oe=6A81A6A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AS1LqEfArcQ7kNvwFioynt&_nc_oc=AdoQ3zQafrvFhIEkInw8Lt4Z6f6yHDAJ4D60QnYsfKGDIIdRizbiQixVseC8JFKjNFU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_SQQchU5rfko8RDrTQFp_zjczrfT-yls6P-6vOCNpuQ&oe=6A81BA81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laAEBb39y_0Q7kNvwFO8-E8&_nc_oc=AdqwRJe2BkqPyygdKSfxEmVWe4x9t3UPIALkmfwhlqpirYZrR5C4BydkQUw1dF0YSe4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZBMfVsqMfR9wwAuoTjMs-ag9tmloI0S8LFzTtehSjQA&oe=6A81946E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QsquZMNTzUQ7kNvwEL2PjP&_nc_oc=AdpaVAm5UZyZFMmDg64vmMI8SegrGZ6fGFPMOejwdqLT4cSoC2_Rb5hvro57pwJ9Chg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeOo8DMapC21UZ8VzwIo1swW5oQLilrR_r46nw0Kpaow&oe=6A81C4E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWQpH6A3yesQ7kNvwHYQHUP&_nc_oc=AdpE0xPScJojVnTIXi4AL7UGAOfvLD3fNFzQRHfb2109EcZ_b82V4iDWZ7vBuLb9Lok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe5NCOVtmFZwmK7mZtYvJa2OImeKPJRttdF2-JM3h-gg&oe=6A819426"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbohc7_xzJMQ7kNvwF9fhCL&_nc_oc=Adp8bPITHo3WNvYHpsAKngDQpvkBEPowEG9VfW2US67-EOY_81XszfHIODYSEuGG8ng&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZVHi3q_ls9iuzOm-eEQUbwUKv-IJXJxLWXHgKIgt0Gw&oe=6A81B2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjO8ZcjSU_sQ7kNvwGHap3e&_nc_oc=Adp3_QsJmy7YoxTbsYknLdsMsT7Ow_0qyjQKyoNgqiQRNmqZPa-YT2BHRWfNJqNXW8o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhU5T9qOmn-PnEnRE5f7b3W7N7FA7jNi4uI94LCv_Npg&oe=6A81AA22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eWHkcQCobgQ7kNvwF0apyB&_nc_oc=AdpJK7w6AFZ4e0O3ccB5yhndbPK00WkVjuA6YonsHjC0C6sVRZSO4wnsjfN6NH-Pz9Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnWiZU0YPp-idIxIKwcxTZ1zV7HLe1-8
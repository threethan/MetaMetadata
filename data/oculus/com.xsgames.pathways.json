ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfUDzvaCkroQ7kNvwExyLlI&_nc_oc=AdpMqZnztuRxiU_7IbGzuizgEmnfh5-oSdYgC0Q2IcRrGt-ke3kBUWKL7UUrpIWwqSk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyTBaA5wVNtlp7BNZobyS1F2wS5hBlgUL-tt0nZ8Ie9A&oe=6AD39BE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thlihYEY9rsQ7kNvwHD1YGA&_nc_oc=Adr0gaoP2-O0vb4X2oiI8S-COqEi7Sy8KTK5V4VRPy8zXUuDy1iK2AHKt8BonOB-q1g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlI1-lLvSjd3j1HNPibOuxOwXy0Y2e6n42fUTEY9miQQ&oe=6AD3AFC1"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97CB30VCHgwQ7kNvwFZ_mMN&_nc_oc=AdpJYeBLCpylOx6MybpL6Wbm1Ks6zwYHBSp6pLMFLKOMw5eHAaYAI56ZhdzWWKxPtNY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeCVuJV1CtieBcVMyn4siwUyn36uhgxNioyqF5wZsQ6w&oe=6AD389AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwUGieQrxfsQ7kNvwF6dZkT&_nc_oc=AdoBe-Ypkn-EMfrKGFOQ_eQ1o0UgmnnRC82OYfKSMcOLLYvTFg0W_A-aYOTGPEkBPFk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsua00eS9DNVfumtzoXMR-lLuwmfdD8amfQRIIqKsPFw&oe=6AD3BA20"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMbwSqcdNxUQ7kNvwFLg2lu&_nc_oc=Adp3nxL1m_b-bEHA-QgCoJNXEKtvL1K9cdUexItshlUsm-5Dcj6gsXkj7xXkRl9Af8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpXTEvkhNnPxPuycx9ZLSlBqhqsi8VwCLBG1oBvpGo2g&oe=6AD38966"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpuscu8r4G0Q7kNvwHEvGpv&_nc_oc=AdqsxchZEu1F8CCgjC-aJza6wkKdkPsVdzJMuCoqbVbNG0vSwBowppYIFoKMEsOhhbQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvWKfVxqyovtS0PzJgIdGJeyB_uZWiDhO4NxBE-0CbFw&oe=6AD3A804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pm2tE-OnYYQ7kNvwHp70yl&_nc_oc=AdoS4DPPOGHKgK54gHPXy8tSXpAvJMbQIOHSSMecJtzYvZ2mxn4fMEpf3OxqHZceg7s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-sdy2EEyg11hM8IPj3vOZg86nVdjiX_xQyJSD17accA&oe=6AD39F62"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es7_SzFPsb4Q7kNvwFa9pRR&_nc_oc=AdplzPvcPNZe8tbQdzWl-LSAaA6eu_BfFhkeMY7uiLzh2dhVoS4xhU5cuHPe6HKh-5M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRHpUJvQ_OphFlHefBIj2N5OIQKtQkfp
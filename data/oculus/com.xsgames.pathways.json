ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWwkFJdmP5IQ7kNvwFdCvUf&_nc_oc=Adp4XMhOrVgmMFhetig4JcqnUCP5Cy5kc1HBL4XhQuS5vAHDE_IUVJQFeuoixClNuT0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIArAx8bZHktOxC9V9wjuDKpMZ0j2crX2spqwZa2shoHA&oe=6AA14AA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy8c1BSRa5IQ7kNvwF0cbQg&_nc_oc=Adp6-aP8VVP4WooiplW0oK9COtuOGmiqFjaU9I0rpLJKSiEcklvtXQ6z22h642lGN6E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0m4TynC8JdswTmKj0yBZf8UVA9k4NHPoJQCz3GIEh4A&oe=6AA15E81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3zSuEVvcosQ7kNvwHx8iw7&_nc_oc=Adrj5_XJIQpANBdH37C-o8jSZSgmWkhMBr1PeGM9Q52iTpifg0FzPjjLWjJ6T1p_Z3A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgxQHCzpsT4tnyZU0d7pNH0rVuimuYX-fiHt0auUKs8A&oe=6AA170AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VHAfukBIBIQ7kNvwG0_Nm3&_nc_oc=Adp2V9_ghPw1VWe_28MzxJbTMrFinskukQKvJYN7Evv-DF2FXTimPYD8tapZ9WIJiv4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_AHc5YXVwHQekLLtQ6xnjwlwsCY3PGYgZ4ychUYt_UA&oe=6AA168E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_umuAE3oHwQ7kNvwGCDSy0&_nc_oc=AdouTxLETR-NqPgICRLQLObdgrymE2dgv3m3WGxzgHINx9Tlaq5FrsRYwMwGV8kcUYk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9v0jRmFi7B481EIwKLOV_MQKhLEZ4-_yX5LtSwqwnqA&oe=6AA17066"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRWSnjmlPy8Q7kNvwGTNMsV&_nc_oc=AdoSqneEKAOU4pS7q6yNwz9oiTK2lvQRbA39vcXUje2TtmGsWSLS5Zq15qoURZYI6AI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9WhQQyrT5hGzgvjmJcNaPMZEQhrtORTczavf91xOG9g&oe=6AA156C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Gp2hAIokyAQ7kNvwFCNU8s&_nc_oc=AdpFaQGKQDC4t_3BDTXHZCktofp_KJsW5Jidmo3tRdJlzvXaDERdoDeeePksz0dyUQU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVO19_dp4kgF2zSiHumUU9LdddXDi1N3fJSpawaXCxiQ&oe=6AA14E22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnGruFB91v0Q7kNvwFom8Bd&_nc_oc=AdoxNn-72wyE-aK2AUHsaCua1_5yrh-16KtBqCbe8fB3iF53jWbzt5LjWH4AgcdG-c8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICX47qR4hTwmOHPX2Y4gxrA9XbdQZ49l
ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn3bBwR2XAYQ7kNvwHzo8Pi&_nc_oc=AdoaeUbiu8I4zoIJYejCDCwqdYvkcmp1nOpnrDvTqqssVLmba225zIP2bbBEdLerEl8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DuLQby6U9O23uThwgHnYmP3pKS90u9yf4IVttUn30kA&oe=6A32C4E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82G3jHpCW1MQ7kNvwEu-4C2&_nc_oc=Adp1G_wDODBH01QFUb2VH7YakOWr7DmahlkF50ai3YfqUyFmW2Bj2ijNchkloHwZlnw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RZ3H6w3mqyszmR7ybOGfuPf6SymFasoE8VEpuWdoRow&oe=6A32A081"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewIcKtajAuYQ7kNvwGah6YL&_nc_oc=AdrC20_29rszkiNB31EZiQxaw8I_OurFaAi4bhAwWUZQmadnOi8nLLcFQfApa8mrcKQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q6n-8iaPi2flbk9OApT3yfevmRk6VLIshTFl2N-CiSQ&oe=6A32B2AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXNkVsC-_CIQ7kNvwFsO_DC&_nc_oc=AdpHKz72VGhobfzHFMf0NR3EYaEG1cq4DugSo2PwFzT60cBRViJlLtarLqvcLk4peSA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LmM6Uc_lETeXWkJMla36k0Lp1v-4A6QfPkvrn3pTCKQ&oe=6A32AAE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGSG17tH4CQQ7kNvwHJN5Sp&_nc_oc=AdpBpJAHNzgQN-cHdsEvM835ohDqhNcAl0cdqRZtpZCoUgfsfjSflau_hVpdLtj3X28&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wCykJ9sH8SdGelXJAnr_t9RyGQ5uV48WEKvRypz91sA&oe=6A32B266"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHHw9I4cEAcQ7kNvwExoMGh&_nc_oc=AdqkcfqXOYKyidRMzpWY73X8FTgRspaYwkqhOk1JfQ_cu7KyWEB0VhWiL_WBIBZ0SZk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jx7meSlch4LGL2bl6wYrxfKxtgs6F_mgGveiqjwL06Q&oe=6A3298C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7RYooGEm9sQ7kNvwEnH-Xp&_nc_oc=Adpg36JSFCS7Y-VoNJQ31UctB57lGOt0bFGNSRC3X3X5MYezoKmvt5ytAjS90dZWx8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EVQFKMfv8OVmggEF6o25lbCV7KxCTKnLJ5DpD2G9-nQ&oe=6A32C862"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwgxDD1Jf5EQ7kNvwHRgo74&_nc_oc=AdrhlzjZeJcdh8Np11-CmUlTa2-XyA7FNbkckAlWoDzhRIiiCCebfCLSex3ZUWT5NSs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nYnQdB0hs3P5OHYRgg0acINbSFhBlfp
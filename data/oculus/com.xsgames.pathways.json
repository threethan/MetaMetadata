ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q5hlSXxioYQ7kNvwFy3dSs&_nc_oc=AdoUmhycbiNkDoIbP6I0wRiE46PiMS6av51-KNSaskellcK8mEV_od9ut2-8YP_0-wY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ckOHC5gq5S-726GUpoVQbg7UiOyAJsarElFuqoZASww&oe=6A204FE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEezYhAOV9IQ7kNvwHa8xj2&_nc_oc=Ado8vuSTat_1Fs8EEhxNA8jNRtxWubIsWW6McEIUCm_ttpyUBhCwB6d6wPooro_SJRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lespUUt5KrV3EJR99X4lwP2C53u4meHkRkW45qLv1pA&oe=6A202B81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb5ACCVOVZMQ7kNvwGIRAP4&_nc_oc=AdoocC6H-DK49s4TxrREpm5MUHzZl5q0pbi8Ag7KDJuWL1qdkkkprRDXbQHOxVmgEG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pr3lUBaA4N3ehoiDKG6YzDTZo0-Jeriw0zA504Mf7-A&oe=6A203DAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLj3as5HTmAQ7kNvwFdvayg&_nc_oc=AdrH-FCA9HfjX7f_hBtOAj0dl0-rUzzn8Y6deFZq-OkLyW2hLvoPEsant1X1LwKGWdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gLb2Kaa0zeQePAELDZElvMmNf54g6iWGV2r-5W3i95w&oe=6A2035E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJmZcox-a8Q7kNvwHspyGt&_nc_oc=AdqSf-v9-qpNl0SD2YDm1M9intmLFoLrosg075d8zRbWSOR1lsQJ7N7qwSVrjGTAb1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dZCNwr50nVtYxEVJgwyqs8BXaxh1pZQBsdWQFTAdwxw&oe=6A203D66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYS2M3nGBWgQ7kNvwFF6RjG&_nc_oc=AdojD8dBV8BK0BOx2PPndVYYMW8fNzVgjL6IpeHKi92ONPOtspzrFlChYQjhrDtkq4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e0okkt8aHOVIkbqlSAwDbTbpfCGrTsvuyiun6QQorSQ&oe=6A2023C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2SUSc1cUHQQ7kNvwGYBRmP&_nc_oc=AdrC1imgeMyLnn7UtpX0unSi_SQiElS_8MVUHOJjldGaqtyr-VeTyhQgUYr7MkDS1xU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52AbxjgXBXrFi4T6U_BC5T85fwwJIaxsVQB0H7spMazQ&oe=6A201B22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMPOKilmrVcQ7kNvwGbIfGU&_nc_oc=AdoufESOVxLzw39Nm_zNAXXJinQ7KS37I2YeMtlnY6R-31O0UXBiN1pmX5VtTu_KCAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q37h-KCIAcOYzRjBUBJ1AKPx3u4ADMz
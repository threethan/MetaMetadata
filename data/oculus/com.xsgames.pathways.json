ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI9W1XvNp3UQ7kNvwHmSafg&_nc_oc=Adq9vKlC3V2sgywi1YihjrTEagecqq6noZbHEajKT95inuw-Nwla7DEmDVkhItV-PW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-OR9pdwA9SV3WpMniz8uLbKs21XGeLtJrElQ63Ugwqw&oe=6AE76269"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDRTdNhFkikQ7kNvwESOgAs&_nc_oc=AdrgD0fp7lTDUhsQ9kjmpM5cRBHwlyDxEpUKatYf-Pi5Cs3X5cDIKTCNIIBcxFdmNg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZTatIK4vuYwn_UrytVZRPcaD1HLUTn5ZViBdQJjCP3w&oe=6AE73E01"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLaGutKkIGgQ7kNvwGU5ozz&_nc_oc=AdoROvRMJkB_vZp-J9HRYS3_1qS31lJglXiUL9CxG5Uh1tcHPgonqcDRdw3QilhJ6l4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsOX0pKYZtS5gcS43XAaWNYOskv6Cohs03uMzZxZxpSw&oe=6AE7502E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQmH0wOTUZMQ7kNvwHRe8A7&_nc_oc=Adp9pivKda1Kad8OSXuWBccX80Wzr1gbFQOwVZR3R3BW9n8_cSQtTuVK7TAcbb3GRdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO8Q-5WO345J1oqr6ikY-fxUE5n7dZVw9lG8mvup0HBQ&oe=6AE74860"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-C08xI2ikQQ7kNvwGKfc9z&_nc_oc=Adpavn_I26HQ_Pfb8idSeti4GDVF4K2k3yclUI58Mj5zoO-3QkWnGnkhsa3RjDyx_SU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvlG077sa6Y4_sWHFrnfFndpxsJKMggF1rVtcgrbFoQA&oe=6AE74FE6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXp3-5I7ANwQ7kNvwE6tmTr&_nc_oc=AdoCfWcknikrgfq6YZzMILHnk5mYKHo2swZIHDviDrbrhrOfsBqCxhuypLKEpbVUAx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnf5-oC0gGLj2iT03tFsmE9S81R4zE9eqq-QPIu0nTIw&oe=6AE76E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZTs8moYYUIQ7kNvwFkQw5_&_nc_oc=Adr4gIFv_Rw6js3Lt9gjLHaIl6yIdUvsDRxw-4PsI1h5Y767dOcqV2BY76Teng869x0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsR0Nb_guPClZkuMBlJ8oFuEDhzd1VAMRNN3qMUx_K1A&oe=6AE765E2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgHYnku4sCAQ7kNvwHSI5Hq&_nc_oc=AdrT5L84TqL33UggJ35RxSCthmu5F0XPtc5t4BqQtwYrP_4LsGJKhGYO6iHyDuOMQKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRDFw152iiz2rGlDKv8pTGl6cf6eDjy3
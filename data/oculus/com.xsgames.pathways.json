ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP8MAKMkLqsQ7kNvwEOlOLo&_nc_oc=AdpZLJn78SmHEXf8etKQz5hGy9zNBapP9NgP6oGCAdWlgbRdK8i-loxyiYne1WDwVfw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Pf-GlDpS9i87_XWmQg8gE0Yf5-I1g3oEcbKk4MAf2Q&oe=69FDD0A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suicIbJc6ZMQ7kNvwEaoFXH&_nc_oc=AdrYEH3z0U2cjHyCCin_lOzCcUHanUhxcvRdQrBExDkPXUDhGkRIy6CuBWqYb88n-vY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vjd0Qji8gh1h8NuZ9C9nVFCwqeuJ0szqEEtDQrL2Sgg&oe=69FDE481"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N4DWXVBjxIQ7kNvwFHD191&_nc_oc=Adr-u3nTiIQXzOlI1GqEKrf9YIn5SGFWYXhbD7wUtejuXYDV_jE0UuzgCb2jlxv3UVE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M3LtmgJUIcZVfk4H9rkKENaF9mmaO9BYw5PO2QwqGdg&oe=69FDF6AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3dkhqKdxZ4Q7kNvwEc-vy_&_nc_oc=AdpO-qnWaE6f6DiQLroAc5rKGg4-NZWpl6LFFinVVtWUD7btKBzwme5QFG0jP18P-3g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L3kmtNHZSLdQRFzW145L8xr_Ih3ah7NzNArZ2CnQWQA&oe=69FDEEE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDIG4rnOjxgQ7kNvwFdOQVj&_nc_oc=AdqiSXsn547GL5cI8w4VbgTxCmUPgaIBafo2hhpldyU_ywIy-cJnti8F2sF_H3pMPAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xSWrYl5PpJwCheeXY014Llqm5NNYlO6chzDfJyWsa7Q&oe=69FDF666"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRhQTUNrns0Q7kNvwGBDNSx&_nc_oc=Adp9ck99hhM1_OF2USUQ5GhouVg31aQ32GUehbbyW9e3ADdHXT-JmnftI27QDR9aoJU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XYivRldMiEcoj8qhngBFNvAriy3iqxjhUrQfjYnDLPg&oe=69FDDCC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNzs-e5qK-wQ7kNvwFxFnrV&_nc_oc=AdpKe-8-aSOoh9cTFuMvDBnX-5oMKaDvu5I55EzHSYP1RoUSbOGYUL34iB84Hp0puOs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oOSFSu4z-sv4Wn9PEWsDsPETnqUsip_zCTgFENgr_jA&oe=69FDD422"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udBubMcGp-EQ7kNvwHkT7Ey&_nc_oc=AdoKTu3Jq8MGZKIljIybsO8ork1P2xoV5VfPAF4IL1_iNoV-ApzBO8LgMO7mQzaYqg4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SJZZSDny4B1dQ40k_2Sz1OncivtRYyx
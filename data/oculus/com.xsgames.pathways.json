ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eep6eJbJZIQ7kNvwH9Li5I&_nc_oc=AdpYTWIkec0QQJmD6RfE-XTMva36ZlEKKFzZnS_4Qb88SfOO5B-ntIH9-Jykn4jiZ0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UeJ33L9rn7QVQofV1B0UVtIr4rZB4V4kVvetQTCPoWA&oe=6A2838E9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A13YqtofMWkQ7kNvwFz2Sdr&_nc_oc=AdpgQ6ggtU2j2ZrWMA4lvpp4cc6TQizpbtgJriWZY5UuQCq6hYkwhMqMqRiCm3Y9YBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QcRMLniuDXtRkIei_6InqTTeNIFt34whaMdGECgcp1Q&oe=6A281481"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHkZ-pX-XuQQ7kNvwH3mACt&_nc_oc=Adp_UoM7ttC62gDr8PNeSlQCXIXMVXeeNjuPZ2UryDQCmMTlhIbVVPi095hPN_DyTrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n0WW89oU8qECETJoLuQUPNt4N-IsaEcYwQuV82TuiEw&oe=6A2826AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URPywCcEyqUQ7kNvwGMYk4K&_nc_oc=AdqjFK2yjRdo6LQle_uPMR8itLtpCVw6aOHGahc87J83PGfp1u9U536wUSlkQ01KZp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HGOUBlhaIFjAOcnTfGvftRROpNHwk2F7hQqY7luwKTw&oe=6A281EE0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW9ck8KjhbwQ7kNvwH3R73e&_nc_oc=AdpQvxbxsB5EZsvK0aYts8Z2mmgba8OU5Zrg_HudOINmPluWKd13DIspJ-rhq9kpK_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IErQnKX2q8LbEPxUtE6fYNISrvpvBTO-FRoINlWmzXg&oe=6A282666"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnnKmDVX2ZoQ7kNvwGCaHA2&_nc_oc=AdrbrSflGB5Lwq4Alxmeqa5Omd_pz-695n8Hp9xxvVnZRYH6YpU4Bpxm99IXQXfSWCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C_LrQn3PtSlDNhzEDXuB7Ev3x9B2RCSnmE44tMjLAYA&oe=6A280CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnejjb4Si0gQ7kNvwF2ppWh&_nc_oc=AdqVN7oFrfmOEMJ7CeucUiN5nqLqwZkZEndynGIVEVZMeq8d8dlMTvlowfGmCswHtOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CUJkkt1_4bp9N0UN6vDNW3C2WzCrhCumq_DPeoOxtJQ&oe=6A280422"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0gCWRivQfcQ7kNvwGeI5fk&_nc_oc=Adp7eOWderRp8Cf29dPKy2_R5G0CAKjNhxX7Z70N_kBQ7_E08jg6L4cVaePmXt9DBpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MvV6nPWKhNLV46l6nd4gU2wjSBxkTS9
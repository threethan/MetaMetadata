ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5r1IQW6O3wQ7kNvwFPSOzT&_nc_oc=AdqL7pSNBb2-HOuTTNGH_ozu91HZ5elCqUw5v4FDa7o-l5E31vnlxBHVhmA9XOV5q5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSJX-lIHo_gq6EWu29YZ63VmaUHpgpbaaqHDJurorN9g&oe=6A86ECA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7k_p_pKB2wQ7kNvwEa3IE3&_nc_oc=AdqVugMVDu5RcmnzBtCy8HDdZm-5tN0kGISKhPK4qQgfZZI_bSwwIPakXEGUZ_RgR1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENgj-s5CFRRhQg_ncuQLWw3nw6SgJLiAjCQ_CdmyN7CQ&oe=6A870081"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0Wl1fK6UQQ7kNvwHguCee&_nc_oc=AdqLjDxP2D0wNQybgLY-in7omETNzwAgeShuj787rhhJPvC1bqSr33hns-VWHHK7gm0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErj5oRj4fQie4OXHZp1ae_Fx_B2Lqg_FIl2JbOTqnR8g&oe=6A86DA6E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL1jN3orMhcQ7kNvwGA1q_s&_nc_oc=AdrWCcZoIJOa_48b1dWIOjptrm02EAPFnlyoiuPcoAPAeU1h6bDl7SpFJ1RxiWdTHFE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGS9q1M3epZn20m0PF8uuP862ttibTLjqaeNMUpQRQjg&oe=6A86D2A0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2ONZbkXEL4Q7kNvwHodlaI&_nc_oc=Adp87g2M3MvNzNilF-e1ERZyHaHUQ-XqdTKqusEUhlJFC2_yj_baILxGRs8hCCEzWHk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRzuuqJyqSp5xo-Z5Twxnk_zn_ZKoIVtxIqIjXlQLciA&oe=6A86DA26"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CiAYmqUlqQQ7kNvwHAnQaB&_nc_oc=Ado3rkEQqD1sYptx4qdkSHwwL5nov9kmHy1KigYxpoQyDek2I1Z7vsYX9FXWv5upkGU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdspKY5dUu2a1czmViCPehTWr6HPRn1C-QaJ83Iz_FPw&oe=6A86F8C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6-exKBSLmkQ7kNvwERUrRj&_nc_oc=AdrZcbbOpAwcZr5s53yZIqRpr21QJmhHQO20uQJbLCuMbKA96UnGE-Yn8J0nY5lqlRo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJK5igIH54FvOczXwS_qJXH4Y9V2B4B9BwSdreXoe8ew&oe=6A86F022"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyag-f9BEA8Q7kNvwGO5uig&_nc_oc=AdocUH99MmIUQSDHgllrcKo9zB0Ta2bjWq8zSm_t3LBlcy5s2-lP3nrs4NrdUcSBRF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1kUmJVW1ALDgWzFDeqjIgYZwMO5EedV
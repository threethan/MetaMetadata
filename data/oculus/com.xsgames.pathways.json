ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywEXhMJ8FA8Q7kNvwEMZ10y&_nc_oc=AdrcgaDcm8zjyyHS7qDRP8whYot0XEqH-4accOcNd-7O555aM_yF0bzIXXpxHG3cHpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-jY-phMnDatWY0GDtR2W6vAexY_Z4YjPcYIHP8D18pg&oe=6A1DACE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEezYhAOV9IQ7kNvwGNUo_o&_nc_oc=AdpG8iC49YhYuSXzXIwWtdI8Noz1PvZ8xX6-SkQwiCEROx0VvrX3HCUAKYKYNEgDYA8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WsP3fMaTVoKKXRLsUAUgLQQSjLWoVSEFM-6tklCyhfw&oe=6A1D8881"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb5ACCVOVZMQ7kNvwE5zlz3&_nc_oc=AdqoHEZtjKIYX4__xB-f5WpL_yeDvhU8nbSAMUdLVPhKKMK3f3ySmD1MsbsKHgOR3x8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G4LtT8BKJrtiGN268GxAN5B6tji9EhP0RdhtdngZ8QA&oe=6A1D9AAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4rdEeE55QwQ7kNvwHX8rqu&_nc_oc=AdozOy2dEoMMPtMygujGtOBWN5AvwkS-YrRYiMdwBvnfp-z0LW_-6tTpDwPYkcVrv18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LCwieC5YWg9XhwYAcCk0VwXzWrtzTfXyKsQl6qVcHPw&oe=6A1D92E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJmZcox-a8Q7kNvwFCXe1w&_nc_oc=AdpE61WZWY1jn80nzvSSVcQYlr5mzzPbS6brhfw6ZVfBYqIaM5zyahL7mPX6kqn-nUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SQnf8SugE0ruck6JGZOw8OXinTksXQF29MpsTo7m2lA&oe=6A1D9A66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cFgwcBdGPkQ7kNvwHkDJko&_nc_oc=Adrcpn9h9BuTsRs5c7YZhGY_ww4VCpLyR0EwYpydmNS6w6iWbwPJRslOCMXaQGbxnj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AaJ4bW5h6DnT2hxyotUwEGMVQsc8hTjYhH8sZK0GtbQ&oe=6A1D80C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlXHkMbZHLkQ7kNvwEfceAu&_nc_oc=AdrDdLSN-UH51KD118j1kqNvDmRBJibQp9NFEG_FtbbS_6Z3YmsNFbJMEuTzLb3J6zc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jv201QbNnst_GHlufGSu3o7mKVH1Oj10_AQ8lfKVBqA&oe=6A1DB062"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et8839OvwrwQ7kNvwFBi4gx&_nc_oc=Adr_1JOiIRyY-OIAVwilKfCRLYfSYzqsk-iOwzXl0jD2XxvgxkDM3LHLeHypCTsdbPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ov5qEZVpgPKzeWolGPzfcHluCkqT6I-
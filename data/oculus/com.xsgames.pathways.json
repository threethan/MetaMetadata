ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndywJl6jwnMQ7kNvwHLFeOP&_nc_oc=AdrzotKB5CI8OXrdI1JLMCv4QqwUKqMYzNxZ122YIAUZjpCMlU1zATuriFE4XV8a4ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHY4mKm4HSWnx0Syi8bYnfzxwAMdO3wA0oRnCRLujk9g&oe=6AF33FE9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHDzke5SZUoQ7kNvwGObbeL&_nc_oc=AdoMv96hjF0F6UpbRlbH9bbI2fhwYePEyaeZM6sXEhX6VlzAkpwdij8M4bRpkq0rTRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpxQ6-Vl6Jj5j9YqhE_kQWxF8M-I6jIcZzXFnwnReVXA&oe=6AF353C1"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWe879xotRwQ7kNvwHqHpAx&_nc_oc=AdoSSjxEHD3cCnVMq3MYSxK05h0OdT_pL5T6MkS6QBHrxjqcuTyLnRLd8lMhmhdTa5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWw1GgoyUy6k373YrhJx8NqvtvBquFJgC7hwwaH5lTZg&oe=6AF32DAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UnfSUu7vPoQ7kNvwGttUJf&_nc_oc=Adp3fYhSmu8NmiyEo_g8th4H2Ws0Gog-R2-rQUidYFcGGn2lt5F0llRbU0wrAorhRiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz3losiYlTo2jTf7_NJDeDV4D-gzjf_cIYK__nTwH88A&oe=6AF325E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR8LSVN9PbYQ7kNvwEmwyg7&_nc_oc=AdqSdFBZNeEbQO62yrzhmNXoLnTdLH51knaCSsvk5GFXKNNo_noWRAMCKUac7GdWpEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqu2kw_4bu_FPz7J3Iwr3p1c7QcWNIe0sxFQE2MplkuQ&oe=6AF32D66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp41ToKXMsAQ7kNvwHWb7SF&_nc_oc=AdrOxTZbvJ2zSFUrAgzk0HUxFM82ywBT2ddE9cnkcdhHdvYrP7YrNodL5Frl8-YUQbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_TSpAm9BUnbF0IbXhB4ABfNgtZj-vl2XOnPgj05NcYw&oe=6AF34C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3psVfxT0lMQ7kNvwEkOYK7&_nc_oc=Ado28CJhNKqLsQWcRSwEY_UjZKQ_YaH3mmGNIzVRtk6SGp2fxCPrkZhcVCiugRPqIQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRUPR8KcmRIsAqpVgMKgmwCIByMjbrA1D5QEmA1PoyCg&oe=6AF34362"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwOAEmJwf2QQ7kNvwF7yb3W&_nc_oc=Adq5pbT4YwBjvzazyIsQNDhu0bar4nu1k85WxEAiEKJaBYKctmAJ63JeUwdPnfnwzpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmB_DIHqG0KIuHtlp-7wSy5b9Gys3k2J
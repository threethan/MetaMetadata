ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywEXhMJ8FA8Q7kNvwGXiXXz&_nc_oc=AdpnTrQRdwDsNzdRBDY08Pqzqu9ALeXcRuU3yqDfG-oBHh9C4gFyz3T11P9GASazPTw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71kmEmQjNHCo_U7PiShCiOHsirlkURY1Cptb_uPUUDxg&oe=6A1C5B69"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK2g-0Gszq8Q7kNvwFcbKSF&_nc_oc=AdoRu01lyddVbU81lKVNbiTufdvh27g3cNIHBaGLe4YJGPkF16VLKSSOM4dQ6sefM4g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OhmXdILJpVJJvf95tu1yg_GcoYK_YFxbs_G9BED99Cg&oe=6A1C3701"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A96hGB_hNSEQ7kNvwEkVLrK&_nc_oc=Adov7v5fLFVB741bv5ytDmcHQOjLHJ2C25YANAbW9S9oQbpcDtswGkzEfr83VLVo-no&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VJCIcD7tT9Qfn5kosfnw99tPN-hV-QIO9OD0guDN71Q&oe=6A1C492E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4rdEeE55QwQ7kNvwER69ks&_nc_oc=Adqjowr6m8CLsz__M7WPNavSP1oov-HzspmUaw-uMPTp4DAkPxf5xDvb2fd2V30sXUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jd5-Yps6jWIsWzNLm90LQKxE408DRisnNg_lpuxDg4w&oe=6A1C4160"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQ35WC96tZQQ7kNvwE0B5MO&_nc_oc=Adrmyy6qEosAxxw7kmSH2zdfNP0cqfKi-KPLz5fTwt7BG_cHmQqCi-UMbsG043JdfNg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nXh2kiUbOIJU3MhyEInSqX3G44othgMKjSunumrfY7g&oe=6A1C48E6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cFgwcBdGPkQ7kNvwEY-reW&_nc_oc=AdplxyfU3kt68iKudatDbmkhbsn9rUo397F_p-hfJJ8Wm1uxqbSDdHOjvFPIxmcNHRM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y7LI9TcGakVbyAzJz5rF2uyPvKIOsS-i-1Cvp_zt2Dg&oe=6A1C2F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlXHkMbZHLkQ7kNvwFO20cS&_nc_oc=AdqtxG1bH2ZRxqh7VNACB3BTBAvW_EUl2y1LxvzPgna4TpUxFQ6gdMdMmfTOrtVB7s4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55TmS3JAI8IgRiGFf38e3eLF9J0BQUMKwALUsPiQgAKw&oe=6A1C5EE2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et8839OvwrwQ7kNvwHRhuWg&_nc_oc=AdoYg2s_V-o_Yxydww9Y7zl2mwdSB1ssJy6VbjVVsFYYPk8wm_Du6T4EXu3FTWGV8YQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VSV24zBqMLoKmAYTgMu3_cqIiHbTZG0
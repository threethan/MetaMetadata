ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl-PmHAQK2gQ7kNvwG6vPVK&_nc_oc=AdpDIqtODhpNtsjAv8GJZ-KgARB9bgSTEu_iIFETv33CAPXUSud7IkK8I2t6ZMslBWE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIDI8alzGb4s-moZnIB82aMu-yFnu-7kWDD7_0agVDMg&oe=6A538229"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvoawcMlJ88Q7kNvwFLQjU6&_nc_oc=AdqZ9aG1vMnTGID-AR-EmgpDny1ZbyGd4378WKkp5F82CJCXPmfS1yxAroyJrZZcjGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-np6v8veZI4d0T6LVtouSZZUGjo1d9p0_sOcfSlZy8Q&oe=6A539601"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLH_P2vDtwEQ7kNvwGe0mRF&_nc_oc=AdoFBz9bvSr7In0Ur9TRxKDKlqMzSRryLuaK3WzklecYAKObK4aquHovaKwjo_XjlnQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtzamOBTfAuUY0I9arrWOoMsaXvavtHiSFqL9t1g4MPg&oe=6A53A82E"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUoABYwC8vsQ7kNvwHJqF1Y&_nc_oc=AdqqB2VRstc137B2EGC2F7oK8yYfQ9aW7qbMhrd3I17GxD4LcB5ohIzbkiViJ1pVdZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0vhDXjarynFAPa2TsNIzokgn5sj5BunOcZRL-YB3bGQ&oe=6A53A060"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0CvtT1w3XkQ7kNvwEQJi7U&_nc_oc=AdrcPEleRw8_bL3z8um0bfZnlY4bq5rSNgczT5NM6dwn9yyQBydLZRPODI40Xw58FIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM8uJq54hrf8l6FSirVirNgnulKy_x-FgYYt2kFEH61g&oe=6A53A7E6"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4ggj5XnqhoQ7kNvwFqGscP&_nc_oc=Adrzs1HjO2q-fNH3J-Om1JUR35kT6k1pYDW4XdXusV7o21OScrCLxYKm0h6cV-LvHy8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEEaXnd8Ekn-l9DQFcLF7QdRsQW9_Gwt_nh4BQhcHBkA&oe=6A538E44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNMsNj5WdJ8Q7kNvwHBbBKd&_nc_oc=Adq0VkNcBNC4DJCNrr_HDiH547BFIhXCul4ro2-Hk37jXC0HgpDRheY7dQXgThiN8-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7FWQUkXTUABhNl8rokc90MYZjSfEc22ZN4c0jpbS1UA&oe=6A5385A2"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In4kFix8uxEQ7kNvwHyC-KP&_nc_oc=AdpwMVjagWgLWmoMSMgnTW2NGZDDzkVBLas3isYmZoEvjN2wfJh597G0iYkrteGcDWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNDbdWwtCUzAXDyn0UC7KrMyqHhEhqFp
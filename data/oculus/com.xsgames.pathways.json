ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7bHr89BXT0Q7kNvwETiXO-&_nc_oc=AdqXDkT3BJ2UPXnzod-sUMzqR0HRqx_1a7xAkg2mxOwAWL87-xjWb3OI_Ue4WXWDyCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa7iVSct6VUMv0EkkQYh8_CHgVRgx8uDwUDyURQ5phCg&oe=6A69EBA9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWiGurgH4lcQ7kNvwErobUZ&_nc_oc=AdqskN2lWRBTxH1g3Ep3vJpZELDgfI7G5hsamJfWUjojM2fBSc8dREvlCsU0Z56bnVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp2GJmh9ew6qqPL08CIEPkJ4MyuUvAShM4X9hG8-sgWQ&oe=6A69FF81"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OJdRFvNJC4Q7kNvwHEEr0o&_nc_oc=Adri2XGAV_e6P9FKXnXpOdX9_B-qxJ0ua8_8xgOwEp26KscVEgubN--KNXU6c4pH8Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbHm_7RbIufzoMPCcu5Wy3qbGJwJ4C5YOF1DxLDlUfrg&oe=6A6A11AE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeiqTJef6cQQ7kNvwGLjwQ1&_nc_oc=Ado_D8J80pjrv13IO2bWRRsjfRBFv6uT_C4asl-0DHIaEQ8lZbJZzs0z5BchhzXNK9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO0D5qRv2Uv-h1m6yCXjUbXT9u5m5CCJAu5Rd_VBpDXw&oe=6A6A09E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6UuIPURS6wQ7kNvwHyQB0S&_nc_oc=Adq-yD9JXdx7aItXXGCiQEXTWjcX8IQs0GmJn1gkdiEJIqbReuF5GdtWu1sLCY4B_uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHUbpoWr_mlCaSD8J3Q8Q9utR82Z9VmFzGBVMl-glvhA&oe=6A6A1166"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqZABqBIcS4Q7kNvwEkCQHb&_nc_oc=Adopv4aQJdJ0a5_4Y7rJ0ADgNAAs3m8UiTYwGKc6nRD9Z-AvrT9Ck1zAiV2S8CipMf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHFCUQYOMJZC8VhaUrh67oe50ymaqAkPLOmKwIQEGu6w&oe=6A69F7C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By1Ha_TylOQQ7kNvwGzugO3&_nc_oc=Ado7R0oXrMCfl_d7eg3GXAXNZ_ffroV1SCw-0lOFvKPY8dP4bttCJaeCGcqA0V68kk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhFKvQO-qtkMAGaHdfmgzvyhqc8WRMhiL2Qc9o46WDKg&oe=6A69EF22"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbfWtKhCR2oQ7kNvwGaBh-N&_nc_oc=Adp7VJ4K7BR9iNCv36vYAdehF4PG-IvqBMZQ8eTjmE18oWcvMNDYsXHvzDxXRYrUfFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDecT1kDAlJN7tEiV7xFLW8hlQH1uNiec
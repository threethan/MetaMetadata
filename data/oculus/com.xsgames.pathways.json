ype": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303198_906090585406678_5695503153784069950_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7LTnx7bTMYQ7kNvwGvY56S&_nc_oc=AdrvbxVGLkwTZWdMBt8xX7U3gaqtMFgLxNYY2ipjNwNVtcgzKIJ5azKLx7mngLK6qZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gKkRPe-1aeOm5xpP0Ewn-yz7_BhFWglqs8G20zHp9CQ&oe=69F344A9"}]}, "id": "3952156054990422", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2302558406880276", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_2302558410213609_9216906279442333842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phY04J4lWwAQ7kNvwGKnYPv&_nc_oc=AdoLdV1WKhu0yxlSrlcG1eFJ2Bk7uJGdYC8E-0udQX_Z0WbdwkrDWtoskUcObJg-Pgg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wW7kaDswo5qAzfRLaSJ9Sv-_27-11NnekTdxjvcN_mQ&oe=69F35881"}, {"file_name": "2.png", "id": "780992208354089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_780992211687422_7375995919838855526_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agICnxCY0YwQ7kNvwGaAokl&_nc_oc=AdpYg5tI1m-H6beH4jyRA45Wa5U1GXJxWSxAMrs8XsSIVyl4ytxXlDObvdmxMDFpUwY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S_ESMDBS-m-ELS9WKLvFjcsL6dZplhB09obzeRSArfA&oe=69F36AAE"}, {"file_name": "5.png", "id": "1410342230805222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_1410342234138555_7000217725320607911_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTekS2JcndQQ7kNvwEA4Gpp&_nc_oc=AdoUBMFPTIyHE6v23Qtr7viLI_tAscPqcJo88xi71HQSmGvDad4Ov1xk6UHsJw-onKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fCfDUa1vGCNnJADNlF75J_54GEcE6TrQRtWh82ucW2Q&oe=69F362E0"}, {"file_name": "1.png", "id": "2309517369541760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_2309517372875093_4276077307252057321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7XI4DyADhoQ7kNvwFgwwc6&_nc_oc=AdoCmq-kLA7cW-SZBq8I8yqlLBLngBi2SoyXr28nIJtfa4B0znb38LOcOhsUCbdqTIU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af076VIe68M7QiTg8LrpA6Cl6D4FeaVESGL5NmvxEMMUeg&oe=69F36A66"}, {"file_name": "4.png", "id": "1395260918912048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_1395260922245381_5793823271047433467_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0uWuJLos74Q7kNvwHuR9ga&_nc_oc=AdrsmvNYDzXCI9pXzNGiZhuM2JT34csssKrZuaLbaCByGu_7KlF7MhruoFdhmh0mmz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GT8A9fnb8Br-iRHkixLq1IcNsWkZXP7vcHYYvZy5_Pg&oe=69F350C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "910690944768858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307962_910690948102191_7705803497706145935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFhaBGZ2MysQ7kNvwF0Fq-4&_nc_oc=AdoSWQFXZf0tqt8_babQS01nfKRt_5SHoNV0sO8yvCI3eUtG_x3a51oQe5UI1FofmXQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XtgjwQiyTqRr17YPCIAONl05z9T3CQdCCifHP_W8avA&oe=69F34822"}, "display_name": "Reflecto - A symmetry game", "keywords": ["puzzle", "symmetry", "trivia", "brainteaser", "squares"], "long_description": "In a world of fragmented patterns, your goal is to restore balance. **REFLECTO** is a minimalist spatial puzzle game where logic meets geometry. \n\n\n\nThe board is split by shifting axes\u2014thick black lines that act as mirrors or pivot points. What happens on one side must be perfectly mirrored on the other.\n\n# Rules are simple to learn but difficult to master\n\n**Observe the Axis**: Look at the lines separating the grid. These are your \"Symmetry Lines.\"\n\n**Match the Pattern**: If a square is filled or colored on the left, you must activate its corresponding twin on the right (or top to bottom).\n\n{772239162572240}\n\nAs you progress, the levels become more complex. You may deal with single axis - simple left-to-right mirroring - and cross Axis - four-way symmetry requiring perfect balance in every quadrant.\u00f9\n\n{871049805667364}\n\n# FEATURES\n**Mindful Geometry**: Over 100 levels designed to challenge your spatial reasoning and short-term memory.\n\n**Minimalist Aesthetic**: A clean, \"dark mode\" inspired interface with sharp lines and satisfying click-clack sound effects.\n\n**Dynamic Difficulty**: Start with small grids and expand into massive, multi-layered boards.\n\n**No Pressure**: No timers or move limits\u2014just you and the logic of the grid.", "short_description": "A minimalist spatial puzzle game where logic meets geometry"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26181771221408598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1805832586655531_5360267448509737395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Sau2UaDmIQ7kNvwHS6Hy3&_nc_oc=Adp1SmPszc2I5Pw83VkIRffnkFMuP5p_0RpW1gFY2Dm4GFi_tEwno2OzzTF0BWT6Fx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15U0g1dHPYK7kvL48S1Z6PCHWyroSUrB
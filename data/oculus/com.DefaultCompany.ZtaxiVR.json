vwFo0SGk&_nc_oc=AdrUBs7zR3-sAQPXW6peGKs6gSjEJwLDsveBW_7ZV0aYGkXwlPsP5zih1TaL-yPMkxU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3-FIoUJP78IRBPmzOldpNLJQPvggrgGXtVpZ81U38VQ&oe=6AA94D98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DTTCCoverArt_02_2560_1440.png.png", "id": "889501417120505", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821919_889501420453838_5033090913255997554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nD71QcSt4UQ7kNvwFSYQ9S&_nc_oc=AdqqHomNI7t9rwP00JSFza8qy97tvF4NVMUHe451O7qXzENM-lBb5JuXMcIx2ls0Vfc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM-pfK4sxL7hF8Fv3ycs79z2BgEwG9kiExqUgrnVg3Rw&oe=6AA9698F"}, "display_name": "Drunk Town Taxi Co.", "keywords": ["Driving", "Simulator", "Physics", "Funny", "Taxi"], "long_description": "Welcome to Drunk Town. It might be broad daylight, but the party started hours ago. The streets are blurry, the pedestrians are wobbly, and you are the only sober designated driver in the entire city.\n\nAs the newest recruit of the Drunk Town Taxi Co., your shift starts now. Your job is to get these disastrous passengers to their destination safely. But that\u2019s easier said than done when they won't sit still.\n\nThe Challenge: You have a job to do, but your passengers are fighting you every step of the way. You have full control of the car, but you have to compensate for the chaos happening in the back seat.\n\nKey Features:\n\nThe Designated Driver: You are the only sane person on the road. Keep your eyes on the street while the town descends into chaos in broad daylight.\n\nPassenger Interference: Your passengers are unpredictable. They lean, they grab the wheel, and they shift the car's weight, forcing you to fight to stay on the road.\n\nPhysics-Based Mayhem: Master the weight and momentum of your taxi as rowdy customers try to throw you off balance.\n\nInteractive Cockpit: Use your mirrors, tune the radio to ignore the rambling, and keep your hands at 10 and 2.\n\nCareer Mode: Earn cash for safe deliveries (or cleaning fees) to upgrade your cab and unlock new routes.\n\nBuckle up. It's going to be a long day.", "short_description": "It\u2019s the middle of the day, but everyone in town is already wasted. As the only sober driver in the city, you must manage unruly passengers and fight for control of the wheel in this physics-based taxi sim."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26345097108407979"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1046741011095100"}, {"status": "PUBLISHED", "id": "1490570659052458"}, {"status": "PUBLISHED", "id": "985018694355829"}, {"status": "PUBLISHED", "id": "951862017482707"}, {"status": "PUBLISHED", "id": "1971501333500140"}, {"status": "CANCELLED", "id": "1577080670241948"}, {"status": "PUBLISHED", "id": "867513862853302"}]}, "baseline_offer": {"id": "951862017482707"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED",
c_ss=7a30f&oh=00_Af1CbSvBgjtdpBNOMW_2ByBgdiDrEn9Ghm9DCmgau0SFtw&oe=69D65D98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DTTCCoverArt_02_2560_1440.png.png", "id": "889501417120505", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821919_889501420453838_5033090913255997554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylXJZi2vvKoQ7kNvwE8ulAl&_nc_oc=Adp6gn4KfS_zvUmExfJJOQT9x5JiG9UjmdQyoTfZc2rpWohfmyN18Xy9ENw7muVX0hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lAWSkOZj_HTW88NRLr67mF_dJ-WQ-_PVVv2JEmQLapw&oe=69D6414F"}, "display_name": "Drunk Town Taxi Co.", "keywords": ["Driving", "Simulator", "Physics", "Funny", "Taxi"], "long_description": "Welcome to Drunk Town. It might be broad daylight, but the party started hours ago. The streets are blurry, the pedestrians are wobbly, and you are the only sober designated driver in the entire city.\n\nAs the newest recruit of the Drunk Town Taxi Co., your shift starts now. Your job is to get these disastrous passengers to their destination safely. But that\u2019s easier said than done when they won't sit still.\n\nThe Challenge: You have a job to do, but your passengers are fighting you every step of the way. You have full control of the car, but you have to compensate for the chaos happening in the back seat.\n\nKey Features:\n\nThe Designated Driver: You are the only sane person on the road. Keep your eyes on the street while the town descends into chaos in broad daylight.\n\nPassenger Interference: Your passengers are unpredictable. They lean, they grab the wheel, and they shift the car's weight, forcing you to fight to stay on the road.\n\nPhysics-Based Mayhem: Master the weight and momentum of your taxi as rowdy customers try to throw you off balance.\n\nInteractive Cockpit: Use your mirrors, tune the radio to ignore the rambling, and keep your hands at 10 and 2.\n\nCareer Mode: Earn cash for safe deliveries (or cleaning fees) to upgrade your cab and unlock new routes.\n\nBuckle up. It's going to be a long day.", "short_description": "It\u2019s the middle of the day, but everyone in town is already wasted. As the only sober driver in the city, you must manage unruly passengers and fight for control of the wheel in this physics-based taxi sim."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26345097108407979"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1971501333500140"}, {"status": "PUBLISHED", "id": "1577080670241948"}, {"status": "PUBLISHED", "id": "867513862853302"}]}, "baseline_offer": {"id": "1971501333500140"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774706100, "status": "PUBLISHED", "id": "1971501333500140"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26520310620886626", "version": "0.0.12"}, "id": "888420690598218", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
10&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kupqH5Hh6aQQ7kNvwFJXHzs&_nc_oc=AdqAeCgPoyF5hvm1YSRCeZiyg4UUULRQfrBWs0eB7UNP3FrDOKmlmOmJuzbwcRYlAUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTASAwA0GMoHzJrP1gbw3kXwrT3kpKEEsUiBUbhmTxxNw&oe=6B0703CA"}, {"file_name": "DTTCScreenShot_05_2560x1440.png", "id": "935549335702840", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623370_935549339036173_6446574622130490652_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VDTa6H097MQ7kNvwGKCffq&_nc_oc=AdqzR7oeleiuKnjHs0fK_A16XCJlalPFCVvVxQshECaH3RNR3tVXDB00BFQrqWZX8OQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0CKlluLWB4v6boofJ-5HupNAUbY9QB3h53YYEAX1cjw&oe=6B072058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DTTCCoverArt_02_2560_1440.png.png", "id": "889501417120505", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821919_889501420453838_5033090913255997554_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsGKDHKmKTkQ7kNvwHOLDX2&_nc_oc=Ado6yQYE-Bd0v-APOsD8UAWiIYIeEMOzxBGhGCKUC8huGfRjQIUnY0rDEFugLNcqHlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6fpG56WQk7XOX8VimIqsF4JEoeBNY9Z7qkw09Bb08_w&oe=6B07040F"}, "display_name": "Drunk Town Taxi Co.", "keywords": ["Driving", "Simulator", "Physics", "Funny", "Taxi"], "long_description": "Welcome to Drunk Town. It might be broad daylight, but the party started hours ago. The streets are blurry, the pedestrians are wobbly, and you are the only sober designated driver in the entire city.\n\nAs the newest recruit of the Drunk Town Taxi Co., your shift starts now. Your job is to get these disastrous passengers to their destination safely. But that\u2019s easier said than done when they won't sit still.\n\nThe Challenge: You have a job to do, but your passengers are fighting you every step of the way. You have full control of the car, but you have to compensate for the chaos happening in the back seat.\n\nKey Features:\n\nThe Designated Driver: You are the only sane person on the road. Keep your eyes on the street while the town descends into chaos in broad daylight.\n\nPassenger Interference: Your passengers are unpredictable. They lean, they grab the wheel, and they shift the car's weight, forcing you to fight to stay on the road.\n\nPhysics-Based Mayhem: Master the weight and momentum of your taxi as rowdy customers try to throw you off balance.\n\nInteractive Cockpit: Use your mirrors, tune the radio to ignore the rambling, and keep your hands at 10 and 2.\n\nCareer Mode: Earn cash for safe deliveries (or cleaning fees) to upgrade your cab and unlock new routes.\n\nBuckle up. It's going to be a long day.", "short_description": "It\u2019s the middle of the day, but everyone in town is already wasted. As the only sober driver in the city, you must manage unruly passengers and fight for control of the wheel in this physics-based taxi sim."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://github.com/SerenadeVR/drunk-town-taxi-Co-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SIN
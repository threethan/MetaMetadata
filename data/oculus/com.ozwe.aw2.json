-AQ7kNvwHXNIfB&_nc_oc=AdmMhNPtgPfrS3CUWhoHKyxcHCwIVa5gJEczVbDV1bRXY4_Wqc0BSnIblLklvaRedDM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIuNmQHUvVXWIyZWmEwboVS5eSo8AqF1_pxcuVswM9eg&oe=69AABF3A"}, {"file_name": "migrated_image.png", "id": "856825908073792", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162739_1730798390476953_1811104045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIe1YNI6pLoQ7kNvwEZbpzE&_nc_oc=AdkOLrJTidHnIZdHC_hyVF7mkAKE1EXQ44spUhmHHgGYbiCT9PQfeP1pE93yglgafKs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzggm9Kqybvv4mNAWb_vOZfMeray02ThXbQ4FiPt5QqXQ&oe=69AAE5CF"}, {"file_name": "migrated_image.png", "id": "704537776951263", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138836_618417551634527_1692202340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnpZ-Y3nHAQQ7kNvwEHTzOe&_nc_oc=Adk9xm2YRJgr0jnWwMVV-6p__67Io9xS5J2RNZ-lQE6enjG9j8rID6z8Z0Vtk8wzgfo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQMtjEp2by62aAY24CcWPhOLTWq-uJ1NoicKwUjxr_XQ&oe=69AADF2C"}, {"file_name": "migrated_image.png", "id": "263053671362610", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138912_1819036441656370_1947383459_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32l4YrS36p4Q7kNvwFmA2qn&_nc_oc=AdnF7WtlW6HDbuj4pYJRQUDHzuUv8I7pChJL8UKVQevBhlbEkbhw8qtv2eA4nXf9mLs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFLzJy4xRwwuqmEauF8CpKUizXwbFXGHbP4Bi3KjofjA&oe=69AAE5A9"}, {"file_name": "migrated_image.png", "id": "199997061290377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138809_1682502058663753_1479022223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8x6fgw-KrYQ7kNvwE29Qu8&_nc_oc=AdnXOfoFgm_JqoTlRUI25_ZgrzWYFcVxophw6kPBoCmKiY2IRqaiwsz88FERJwdaWMc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQiar6FlGB-gJEYfoxdAUbTefWLbpOV7FNhxAJeUNj-w&oe=69AAB595"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anshar Wars 2", "keywords": ["anshar", "best", "game", "games", "gun", "multiplayer", "shoot", "shooter", "shooting", "space", "top", "wars"], "long_description": "New: 4 Multiplayer maps + VoIP, Gamepad turn for 180 gameplay\n\n\u201cWow. That\u2019s what I kept saying while playing this game.\u201d 9/10 \u2013VRGIANT \n\n\u201cAnshar Wars 2 is the kind of videogame that Gear VR needs to cement itself as a true gaming platform\u201d 5/5 \u2013VRFOCUS \n\n\u201cOne of the most impressive games we\u2019ve seen in Gear VR in terms of both gameplay and graphics\u201d \u2013UPLOADVR \n\nFly a variety of spacecraft including the Ansharian Fighter, Bomber and EMP ship across 13 large missions fields. Freely traverse large planet surfaces, dodge space debris and asteroid fields by steering your ship using the Gear VR 360 degrees of freedom by simply moving your head. \n\nAnshar Wars 2 let you take the role of a newly enlisted pilot in the deadliest squad in the Ansharian arsenal. Bring the fight to the Nergal in dazzling ship-to-ship battles in deep space and lush planetary surfaces. \n\nGamepad: Supported\n3D Depth Setting Available\n\nFREE UNLOCK: This purchase will automatically unlock Anshar Wars 2 on Oculus Rift!", "short_description": "New: 4 Multiplayer + VoIP Maps, Gamepad control for 180 game play. Campaign: 13 missions with multiple objectives, 3 ships, open areas. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ozwe.com/", "developer_terms_of_service_url": "http://www.ozwe.com/tos", "publisher_name": "OZWE", "support_website_url": null, "website_url": "http://www.ozwe.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommende
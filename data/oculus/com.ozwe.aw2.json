drqBRk79kUunhw4pKcwhao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfueMNLhU_KPv8xPZohoYm-pSW8pz2Uj6SCJ6w5Meem4eQ&oe=699C3EBA"}, {"file_name": "migrated_image.png", "id": "856825908073792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162739_1730798390476953_1811104045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99tjaZmjD6kQ7kNvwEFwbhi&_nc_oc=AdkGRfVnkep-WIDSZSwMEK-wRBuadjqqvWnDg6jfcaBCA05Yj_eZSJLRAfK05oe-c8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuGp6bCHHZwNU8afGWF5Vv8xrmfm4i-Wuk440TQON9cRA&oe=699C654F"}, {"file_name": "migrated_image.png", "id": "704537776951263", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138836_618417551634527_1692202340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odN6ywaGcOIQ7kNvwGxIutd&_nc_oc=AdnFND-jkMbjNbEqE0d3kjOTgZ3r55_16f3ePzYWHL8ZdwKH4VWOP1oPupN11EReqVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7Y8OMQ6Nyr1_PRfEBv6alznWuPPhCnmK0phX8V6rtDA&oe=699C5EAC"}, {"file_name": "migrated_image.png", "id": "263053671362610", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138912_1819036441656370_1947383459_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D3ivjW1iIMQ7kNvwHGqA6F&_nc_oc=Adki6R72Z7_ETHx4CyC2iYr4Ljj_fnehsvUbykSMRcOCVtVMBTgmHTWx6cFPk1r0ks0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftgZXaGuRP0CeN9dtzhEjB2E_2dE7keoXkXfNv0gzf31Q&oe=699C6529"}, {"file_name": "migrated_image.png", "id": "199997061290377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138809_1682502058663753_1479022223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZLu6ho4hZ8Q7kNvwHvuT0T&_nc_oc=AdnqfYtTKT_O_hthqAHU-J1YNX0a0orsGUYSVWlsQZs-34bLa3aeyq2BPn-udFSVm8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuyi1j8VTEnmBmr68UIS3bu4GtI5pNDAAzynmJhqPtGVg&oe=699C3515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anshar Wars 2", "keywords": ["anshar", "best", "game", "games", "gun", "multiplayer", "shoot", "shooter", "shooting", "space", "top", "wars"], "long_description": "New: 4 Multiplayer maps + VoIP, Gamepad turn for 180 gameplay\n\n\u201cWow. That\u2019s what I kept saying while playing this game.\u201d 9/10 \u2013VRGIANT \n\n\u201cAnshar Wars 2 is the kind of videogame that Gear VR needs to cement itself as a true gaming platform\u201d 5/5 \u2013VRFOCUS \n\n\u201cOne of the most impressive games we\u2019ve seen in Gear VR in terms of both gameplay and graphics\u201d \u2013UPLOADVR \n\nFly a variety of spacecraft including the Ansharian Fighter, Bomber and EMP ship across 13 large missions fields. Freely traverse large planet surfaces, dodge space debris and asteroid fields by steering your ship using the Gear VR 360 degrees of freedom by simply moving your head. \n\nAnshar Wars 2 let you take the role of a newly enlisted pilot in the deadliest squad in the Ansharian arsenal. Bring the fight to the Nergal in dazzling ship-to-ship battles in deep space and lush planetary surfaces. \n\nGamepad: Supported\n3D Depth Setting Available\n\nFREE UNLOCK: This purchase will automatically unlock Anshar Wars 2 on Oculus Rift!", "short_description": "New: 4 Multiplayer + VoIP Maps, Gamepad control for 180 game play. Campaign: 13 missions with multiple objectives, 3 ships, open areas. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ozwe.com/", "developer_terms_of_service_url": "http://www.ozwe.com/tos", "publisher_name": "OZWE", "support_website_url": null, "website_url": "http://www.ozwe.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "support
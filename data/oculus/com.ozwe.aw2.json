-mE1v7wWWalaGnQoTxIAJ1cBYk8YAE6GLbd57-h_AWSLUpu_bFGndUXh38-Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH_Nhf8az90Eg1oHG-odXoMwsveUENlHBij3zPC1l-eQ&oe=6AA41129"}, {"file_name": "migrated_image.png", "id": "214003173137936", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138809_1682502058663753_1479022223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js7ssOpPDv4Q7kNvwG6Zwzy&_nc_oc=AdpbPL09ldFb3R0uDG3oSnAdQHuIzlvffQ6IfztEtt_7b5UogS-E2dauFdM4scEc1uk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFs6W9pv0yUfnDSmPjVGPMzZ8PVwMSuomAGSXY-2bPjQ&oe=6AA41955"}, {"file_name": "migrated_image.png", "id": "1079944405737735", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138836_618417551634527_1692202340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5Wl4iILebAQ7kNvwFNCg9X&_nc_oc=AdqDecfLe4qBZ5dReqmoC5Zu5Dzedle5UjYqkUHUbv12xSMv60nwjoSkjSpXdyEuKLE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF-32QkUOU9vnzFC9jxNl14FFFpplJaK3Va62UUQ_Efw&oe=6AA40AAC"}, {"file_name": "migrated_image.png", "id": "233518074492536", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12138805_1662796740653961_339524207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuZepbbE_H8Q7kNvwHNux0u&_nc_oc=AdqPxB-YfuElYvKLeulyJSqEX7DFjAXlQW_iqng4YUTR2tqQ2LEZ027Q_V99PJl0cuk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpjYNy4SRBtNlUjy0nKDmww3JPYSAZ9l3D0RTq7sD-Ow&oe=6AA422FA"}, {"file_name": "migrated_image.png", "id": "858813137966869", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162739_1730798390476953_1811104045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xw9q7EFZSoQ7kNvwEuntMu&_nc_oc=AdokH6cHFldCJqCi2pYAiPuQeabrC0iZW8Ebt8zm1ZKge2mEBOOuNQi1m3dcHWUXLZA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Ax33NoK7CHL77ka-Ovh9pHjfQnoAihTx5hBcuuh_qQ&oe=6AA4114F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anshar Wars 2", "keywords": [], "long_description": "The Ansharian Empire is in peril.  The Nergal, an ancient and fierce enemy,\n\nhave unleashed a galactic super-weapon capable of decimating entire \n\nplanets.  Take on the role of a newly enlisted pilot in the deadliest squad in \n\nthe Ansharian arsenal.  Bring the fight to the Nergal in dazzling ship-to-ship \n\nbattles in deep space and lush planetary surfaces.\n\nUtilize a variety of weapon and ship power ups such as missiles, \n\novercharged lasers, tesla blasts, and portal generators to transform your \n\nfighter into a powerful war-machine and cut down the Nergal forces \n\nwherever the fight may take you. Fly a variety of spacecraft including the \n\nAnsharian Fighter, Bomber, and EMP ship. Gear VR technology allows you \n\nto see the fight all around you, real-time, for fast-paced and accurate \n\ncombat awareness.  Steer your ship by simply moving your head, dodging \n\nspace debris, asteroid fields and huge Nergal capital ships.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ozwe.com/aw2", "developer_terms_of_service_url": "http://www.ozwe.com/tos", "publisher_name": "OZWE", "support_website_url": null, "website_url": "http://www.ozwe.com/aw2", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3159585354360031"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "489218484794781"}, {"status": "PUBLISHED", "id": "773863
3B2D6YwZpJJxanazmFtWG8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuFNsqXJBLSD4a3_OcBD9lAyMqUHR0vKbk9YDuaY4xS2Q&oe=69A184BA"}, {"file_name": "migrated_image.png", "id": "856825908073792", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162739_1730798390476953_1811104045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wpXUTPq8zwQ7kNvwEDaGcB&_nc_oc=AdmJqiREbo6eLCeAh1KjQQR6bVZYXHcicZL9YLosls15lTDATknFCeBF7EEMO5vTJ54&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfthJ44ybHSjqb_4Mk-ewWMtHfsgtc6wgD-Ic4IWKg5O4A&oe=69A1AB4F"}, {"file_name": "migrated_image.png", "id": "704537776951263", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12138836_618417551634527_1692202340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFEk_MI94CUQ7kNvwGZZar9&_nc_oc=Adn-ZFUwurIcIETmnc4bRPwnK32gVWg8s0u3q4BeO36bwHBic7AfPQsP0ibMTmOPa2Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afttho8fzZTir4erFR9_hfp-h_FZfc4gJ9BHC2w0KmBQBA&oe=69A1A4AC"}, {"file_name": "migrated_image.png", "id": "263053671362610", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12138912_1819036441656370_1947383459_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVjbeHObxCAQ7kNvwGUGqXd&_nc_oc=Adlp5-4OHErQthTBerllM14JwoaedRjBE1O5LcivePl_rrkLrelMRqXlq2k5JqN9YBg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftZ9_qAyNIEyyw4NvYf1v7-dp1Oii2-LUNP4egRc_rf9Q&oe=69A1AB29"}, {"file_name": "migrated_image.png", "id": "199997061290377", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12138809_1682502058663753_1479022223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0Q7XOKVhLsQ7kNvwGchLby&_nc_oc=AdnqCu3l9mHf2CqW-JyclYb6Hmdq2UNQ6YM1Mb7udcOxgIQnwcUhbXzZ9v-BxjScv7U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvO54tX5khmCZn7HIA4HgbaKzvtxjrsvSlFvGzjOzhZRA&oe=69A17B15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anshar Wars 2", "keywords": ["anshar", "best", "game", "games", "gun", "multiplayer", "shoot", "shooter", "shooting", "space", "top", "wars"], "long_description": "New: 4 Multiplayer maps + VoIP, Gamepad turn for 180 gameplay\n\n\u201cWow. That\u2019s what I kept saying while playing this game.\u201d 9/10 \u2013VRGIANT \n\n\u201cAnshar Wars 2 is the kind of videogame that Gear VR needs to cement itself as a true gaming platform\u201d 5/5 \u2013VRFOCUS \n\n\u201cOne of the most impressive games we\u2019ve seen in Gear VR in terms of both gameplay and graphics\u201d \u2013UPLOADVR \n\nFly a variety of spacecraft including the Ansharian Fighter, Bomber and EMP ship across 13 large missions fields. Freely traverse large planet surfaces, dodge space debris and asteroid fields by steering your ship using the Gear VR 360 degrees of freedom by simply moving your head. \n\nAnshar Wars 2 let you take the role of a newly enlisted pilot in the deadliest squad in the Ansharian arsenal. Bring the fight to the Nergal in dazzling ship-to-ship battles in deep space and lush planetary surfaces. \n\nGamepad: Supported\n3D Depth Setting Available\n\nFREE UNLOCK: This purchase will automatically unlock Anshar Wars 2 on Oculus Rift!", "short_description": "New: 4 Multiplayer + VoIP Maps, Gamepad control for 180 game play. Campaign: 13 missions with multiple objectives, 3 ships, open areas. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ozwe.com/", "developer_terms_of_service_url": "http://www.ozwe.com/tos", "publisher_name": "OZWE", "support_website_url": null, "website_url": "http://www.ozwe.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "support
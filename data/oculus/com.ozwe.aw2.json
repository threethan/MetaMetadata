kNvwGLZlCx&_nc_oc=Adk6t2xy483cjtfcz6ky649AoFesLnvgWFpbQjIWKsmDW2Qnnb9JIFeLyDGBoKUGxBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsUF5TvV_Y7zsJ2aNjcNAy0AjT9lr7CODiFLTzRb0obxg&oe=69A96DBA"}, {"file_name": "migrated_image.png", "id": "856825908073792", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162739_1730798390476953_1811104045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIe1YNI6pLoQ7kNvwE4rWqM&_nc_oc=Adl1u4F37PqhypQiaoRxDTpuSRv38prc13gkQESsCDkah4ULcD0WZgKL4RcJCvzM6Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsmfTrZMXJJsH_e3EQeu1HrCH3tqCiB5uiciQ7vsUjflg&oe=69A9944F"}, {"file_name": "migrated_image.png", "id": "704537776951263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138836_618417551634527_1692202340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3TjQVWhIgQ7kNvwHGoIQF&_nc_oc=Adlub0cDQr_PDq_VnZlbPFnBgeZAPXxgHaI2NU-UZGenDII47mv7l2yhjsLyRpBnD08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKjHEbR4sqB2A9StjBemifV5Z0EWHeobv0bOE4hgAHSQ&oe=69A98DAC"}, {"file_name": "migrated_image.png", "id": "263053671362610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138912_1819036441656370_1947383459_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32l4YrS36p4Q7kNvwGokDm2&_nc_oc=Adk1VLBMwXYmLwNsvfgU3H5ThumJMawVunVZicZVI3LGeeTV4b-qEsZTmuiZzctWGO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQUYqvYUYXLtBKNkUK_5ld1WZbL6tu0AX6JiesF5igaw&oe=69A99429"}, {"file_name": "migrated_image.png", "id": "199997061290377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138809_1682502058663753_1479022223_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSrGs0nZFZMQ7kNvwHXkmP0&_nc_oc=AdmpWt41vY7N_GlBmL0m-JIV53iklNfzp0ea9RUk_AMRR2AX3gr_26b63ZUrF0RyxyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvnb663XUuQdOq9qW0ZJoLXfZ3phj3oToSCwi6fKav-_A&oe=69A96415"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anshar Wars 2", "keywords": ["anshar", "best", "game", "games", "gun", "multiplayer", "shoot", "shooter", "shooting", "space", "top", "wars"], "long_description": "New: 4 Multiplayer maps + VoIP, Gamepad turn for 180 gameplay\n\n\u201cWow. That\u2019s what I kept saying while playing this game.\u201d 9/10 \u2013VRGIANT \n\n\u201cAnshar Wars 2 is the kind of videogame that Gear VR needs to cement itself as a true gaming platform\u201d 5/5 \u2013VRFOCUS \n\n\u201cOne of the most impressive games we\u2019ve seen in Gear VR in terms of both gameplay and graphics\u201d \u2013UPLOADVR \n\nFly a variety of spacecraft including the Ansharian Fighter, Bomber and EMP ship across 13 large missions fields. Freely traverse large planet surfaces, dodge space debris and asteroid fields by steering your ship using the Gear VR 360 degrees of freedom by simply moving your head. \n\nAnshar Wars 2 let you take the role of a newly enlisted pilot in the deadliest squad in the Ansharian arsenal. Bring the fight to the Nergal in dazzling ship-to-ship battles in deep space and lush planetary surfaces. \n\nGamepad: Supported\n3D Depth Setting Available\n\nFREE UNLOCK: This purchase will automatically unlock Anshar Wars 2 on Oculus Rift!", "short_description": "New: 4 Multiplayer + VoIP Maps, Gamepad control for 180 game play. Campaign: 13 missions with multiple objectives, 3 ships, open areas. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ozwe.com/", "developer_terms_of_service_url": "http://www.ozwe.com/tos", "publisher_name": "OZWE", "support_website_url": null, "website_url": "http://www.ozwe.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
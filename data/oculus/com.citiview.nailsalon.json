mire her new set. Or just play in Free Paint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/nailsalon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": "https://citiview-games.pages.dev/nailsalon/", "website_url": "https://citiview-games.pages.dev/nailsalon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372284742634728"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1414518130077376"}]}, "baseline_offer": {"id": "1414518130077376"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791309120, "status": "PUBLISHED", "id": "1414518130077376"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1372306659299203", "version": "1.0.0"}, "id": "1743513810279083", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1372284739301395", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1372306659299203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1743513810279083
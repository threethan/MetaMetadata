ile_name": "screenshot_2.png", "id": "1087350237335588", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1087350240668921_6712422910707514782_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFz15sFJU04Q7kNvwHyn1Y5&_nc_oc=Adr-fqhox_Bw0wzONxhP1fSw5cdwa52_uiMe1s5RqFIJGQ9s25k6gQOWqXH_-famCFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjZofshPJIc6Sj_EIKzbfAxsUnw5AOoE7YwSlEIhRn3A&oe=6AF33311"}, {"file_name": "screenshot_1.png", "id": "28286561834376076", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_28286561841042742_1790327026794962045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENmtZDORxMIQ7kNvwHyj-pX&_nc_oc=Ado02SQZyVNX6w-te-C2ex9tmFcYPVizTpIglCkXiCL7WqCpyc1l0WYkCJ-Ugzjq95Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLq5BNVYXX6tB2H1oOLq82n2VDiUco9QhuwmdKwSUKSQ&oe=6AF348CD"}, {"file_name": "screenshot_3.png", "id": "1117937577349401", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1117937580682734_2513698698777865855_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G-U_yjmUQAQ7kNvwHlW7dt&_nc_oc=AdqSXzUMYK3UMDbSJ4U7Jkjb_Q4BsPKEP5aRhNzSmtxo7X8xAcG0jvQ9StAV32gHPLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPPuIsGFHxl0gqpDxhaaepfe5nIHel1jS-WJdrj6HWUQ&oe=6AF34ED1"}, {"file_name": "screenshot_4.png", "id": "1069733285878164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1069733289211497_5042384341231561482_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdIyWORHgE4Q7kNvwG_P3uv&_nc_oc=AdqHC9uQtdeLW9fuh7ukybKx1Yh200i-1htPExDM1MNMD9IaBNA0eWBowAl4Ltxj6KI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmz33HVKEtcDRQORdNMCb7JPH3Ppn73Ri9pgndocAxyQ&oe=6AF3415B"}, {"file_name": "screenshot_5.png", "id": "1070809356005217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1070809359338550_7731583595671575438_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMJLKx6CegoQ7kNvwFfJ_xF&_nc_oc=AdoYtaz3TIsnfFtWP0yeNnT3HhboILI345kcZ8Pt8oF2k4fEB6rFj3tGARU8aXBdgWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWxLuwTU5qsM3nHCyU53OGRPEo_lQcspYUANUMMgh4Fg&oe=6AF326C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2118411162110477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_2118411165443810_3580588771870873943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls62zD9Z70AQ7kNvwEA5n1c&_nc_oc=AdrKDn_jNeCeO0FTefsRBJSM_eAgHj-5-Ij75vMN1JugZkStbrcmT1BYu_6qCfTIKO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHN8OZXQXggSLBQsYCgHGW46Om6C7okY-myJn-MdCicw&oe=6AF32E8F"}, "display_name": "Nail Salon", "keywords": ["nails", "manicure", "salon", "polish", "simulator"], "long_description": "Your table. Your polish. Your salon.\n\nPAINT REAL NAILS, STROKE BY STROKE\nEvery nail is a real canvas. Pull the cap off a bottle and the brush comes out loaded with a glossy bead of polish. Lay a stroke from the cuticle to the tip and watch the bristle streaks melt into a smooth, mirror-wet lacquer. A quick flick goes on sheer, a slow confident pass lays a rich full coat, and two coats look like glass.\n\nTHE FULL MANICURE\nFile the free edge into any shape - square, squoval, round, oval or almond - by the angle you actually file at. Push back the cuticles, buff a natural shine, base coat, colour, top coat, then slide her hand under the LED lamp to cure it. Dotting tool, rhinestone tweezers and glitter polish for nail art.\n\nCLEAN WORK MATTERS\nPolish on the skin stays there until you clean it off with the remover stick. Wet polish smudges if you rush. Every set is scored on shape, length, cuticles, clean edges, colour, finish and nail art - and your clients tip for perfection.\n\nA SALON FULL OF CLIENTS\nEach client sits down with her own order and her own hands - grown-out nails, old chipped polish to remove, French tips, accent nails. New requests unlock day by day as your salon grows.\n\nFREE PAINT\nNo orders, no score - every colour, glitter, dots and crystals, just for fun. Ring the bell and she will lift her hand to admire your work.\n\nA BEAUTIFUL BOUTIQUE\nTerrazzo floors, sage walls, brass and marble, a wall of 500 polishes and a London street outside.", "short_description": "Run your own nail salon in VR. Pull the brush from any of 24 polishes and paint real, glossy nails stroke by stroke - the polish flows and levels like the real thing. File the shape, push the cuticles, add dots, crystals and glitter, cure under the LED lamp, then watch your client admire her new set. Or just play in Free Paint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/nailsalon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": "https://citiview-games.pages.dev/nailsalon/", "website_url": "https://citiview-games.pages.dev/nailsalon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372284742634728"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_845066601997146_4911668407135789505_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKoYJjGVjy0Q7kNvwG2RM_d&_nc_oc=Adrn8UGNrfpYyY30boSAc2bNn9WOMzmeKBSWLoLw2ZeChVhpYg0
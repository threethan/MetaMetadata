033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_978888133917366_2283855180938564210_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpOUTJYBBDQQ7kNvwG0gAmp&_nc_oc=AdpPjq7VeaTbJNdjvvVRWO7LRc7U5i25SQv13jne3IFUm7dWf7RwkopaQ3c73XpZe8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEJP9auVAYD56MAgrwA8Gk3z7STfmyutChXlrT-6A6KQ&oe=6A6DE141"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaSxl6EK5kAQ7kNvwELQrOH&_nc_oc=Adr_nuB8J3yKZ8SbstqjUnup-8ebij2GFTrSC3M04AvlmIVQPwpiksIf4q1w565DgeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCAB6XsuVKxUai2sXUkg-SwTHCqPDiqkuOto-pTInfzA&oe=6A6DDF51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-polic
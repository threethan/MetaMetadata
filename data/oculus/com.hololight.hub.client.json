n.com&_nc_ss=7f20f&oh=00_Af9ZyYhk4fEMu1_5IydhPpL-jj7PAi0UqNqdVixkIr0g3Q&oe=6A26E881"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBVUSVabZKYQ7kNvwEtdgc5&_nc_oc=AdqQOqR-1wb0WWokRempJr0rUgDH1rzcAFNEJaosGp3xRzmwjAV05Q-AuwVlb7VOFLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GblwuoYeyniMhBpDsD0aja9XvzfsaoW1R-5NoMnahpA&oe=6A26E691"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-policy-hololight-hub/", "developer_terms_of_service_url": "https://hololight.com/terms-conditions/", "publisher_name": "Holo-Light GmbH", "support_website_url": "https://support.hololight.com/", "website_url": "https://hololight.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "conte
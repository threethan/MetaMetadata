033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035311_978888133917366_2283855180938564210_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZwCfoivUYIQ7kNvwEl5JkZ&_nc_oc=Adq_qhyvF3KbrcFmqPsKYpCAYM9BoST5FCjgzZhWUPpIdfigga1UHpvBhqL4XCPkXRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFABKT9XYo7lCfKNe5B2DSlILJfCjsjtRWn9iMHGJwbg&oe=6A64A6C1"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOkQRBGiRasQ7kNvwGt29QF&_nc_oc=AdqtC6fx6iApjnWXLhZPDLmnAKbeySeX89TxQvHpRoY0o3vXMRdB3UZivlXtJr13VDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl9O0FGO2y37Rng6zHTOGq3dK9ByW-qO7Vz7RuaXtoXA&oe=6A64A4D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-polic
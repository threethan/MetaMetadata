033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035311_978888133917366_2283855180938564210_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STYRl0kYsbcQ7kNvwFArciy&_nc_oc=AdotYGMDr4Bd71DgHW-HCfZbzWNuXtvhsTosXXGQdgMkJT9Ye8QgpUgzy38dH9M2iCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiiDvJzBXZDR-GR6H7GQJV7chx43-ScLj7P0uFb2BuXA&oe=6A732741"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J4zlb4TNboQ7kNvwGqojmq&_nc_oc=AdoZtTaHYad7lv23tRWaiwWIS_yiXnyvYdhc1DGp0-1GXPvVSWNSPUuN1AcOKgmO2Ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7hkyUsE7aoiT-otBOXusXX5jla5bYY3si00fTF7SWGA&oe=6A732551"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-polic
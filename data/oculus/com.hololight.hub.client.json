033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_978888133917366_2283855180938564210_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upxFQV9PLQEQ7kNvwE2yqZW&_nc_oc=AdqbB5VM-7U50VedTnXu2G3aGkB0UajO0305EoOauIn5G_Bd4v0b_HldKKRaUuPcg3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF3Y0fvV9vE8L9xbtTieWa0pgYXIBR5kRx1rKuF4bvFA&oe=6ABD3381"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTa4YZLLGE4Q7kNvwFZ4II5&_nc_oc=AdppptLCjyomCpjLZHAQ8hMAHUrrupHTTMtliLedbbb9TA-b5vJROpUtVkr_7fEJRcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGQnsx7222Xaxnn1-kv802cJ4lusS5tgzlF4dde7kApA&oe=6ABD3191"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-polic
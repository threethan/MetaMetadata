033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035311_978888133917366_2283855180938564210_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlECWuq6UY4Q7kNvwEaSKsQ&_nc_oc=AdoNZ7TDwQC8t5u-IeyQF3UCFKF-J3BBpUTswxTLtKgbHDupViyA8uHdUR2YNj1xIJg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOmNN7sNg8eG2iPzMhpe5P7YN5U2TnvxodBJ29NCJMzg&oe=6AC7BF81"}, {"file_name": "38974482_724439382569765_6049069610101849621_n.png", "id": "3849654778694595", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974667_3849654785361261_5685323359537778171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9DBlX96xIEQ7kNvwEutr_u&_nc_oc=AdrH0h0zzJnfdp-74-rKqhpLNBQBhF68Drl37DkCOF11S6DAn8MJw3BgT49DQZmGC2A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM3KMjIvIkAWKymCpjLRiffjvZnb3fQ4rXgNCyFr-PUw&oe=6AC7BD91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hololight Hub", "keywords": [], "long_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers. It provides the largest ecosystem of industrial XR applications from independent software vendors (ISVs) and enterprises, covering all use cases from design and engineering to training, remote collaboration, and front-line worker support. Hololight Hub enables centralized application management and secure access to 3D content from anywhere, on any device.\n\nHololight Hub contains streamed content and requires a high quality internet connection. You may experience latency issues or discomfort if your connectivity is interrupted.", "short_description": "Hololight Hub is an enterprise-grade orchestration platform for hosting, managing, and streaming AR/VR applications to mobile devices - in the cloud or from on-premises servers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololight.com/privacy-polic
dZDeXNgQ7kNvwGpCElU&_nc_oc=AdrXYJxy6euv4evE1NY5bLN7qAuX3vSP5qkV_SqygGo-gKS9heCjZMOlVoxz9yiKJEc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o9_ACfv5TO8uLIWes2UZI-s8YZrIK2Zhq_fOLWNbFpw&oe=6A106A47"}, {"file_name": "5.png", "id": "2319637268471507", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491820496_2319637271804840_4649620927331857378_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsYOc7fMZLgQ7kNvwHxBdlc&_nc_oc=Adp9LSUdBx8zI_76krAZD-s0w-ccSTR5JJHVmjR_Bppu1dTPPy_VhHcm5cuRhcSzW5M&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GfQ89411dIh5_0MuIaRkztW6xgkTlNJTNDmfX22mQPw&oe=6A106B4E"}, {"file_name": "7.png", "id": "1764607580861404", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820887_1764607587528070_2161181377186197013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUeldmQjGycQ7kNvwHnt_-5&_nc_oc=AdqzXTyhMVPAdm7L8mEvMKeoM7sIwdVh5DA8begD75n6Elvixsddz-HAz36Jt5B9o28&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PMWp6RhxtvmH7xDjtScQI7pX6m2UbbrUuFuntuqC9dQ&oe=6A105DCF"}, {"file_name": "8.png", "id": "1135288471694811", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819356_1135288478361477_2425089163477883892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RlB8M0dc1IQ7kNvwEEn_Rd&_nc_oc=AdpoGeX9S3lYtP6B9JcnmMaas-705cI01XbIlrUltQE8X_HpuQn_Lra-Fnc9pyTy40Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WEIQDXKnoDbMVKnew2BJ59XFQXAwux3UdPUfFx5PBJg&oe=6A1065D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ball Smash Hit", "keywords": ["smash", "hit", "glassbreak", "glass", "break"], "long_description": "Ball Smash Hit VR brings the classic smashing experience into virtual reality. Equipped with two ball launchers, you move through a forward track and break everything that appears in your path. Aim, shoot, and enjoy the satisfying feeling of destroying glass-like obstacles before they hit you.\n\nPhase 1 \u2013 Easy Mode\n\nThis early build focuses on smooth, simple, and addictive gameplay:\n\nDual Ball Launchers \u2013 Shoot with both hands for maximum impact\n\nContinuous Shooting \u2013 Keep firing until your ball count reaches zero\n\nAutomatic Forward Movement \u2013 Just aim, shoot, and keep progressing\n\nBreakable Objects \u2013 Enjoy clean, satisfying smash effects\n\nBeginner-Friendly Easy Mode \u2013 Designed for quick fun and testing core VR mechanics\n\nEarly Access Goal\n\nPhase 1 is designed to test core VR shooting mechanics and provide a basic smashing experience. More levels, environments, modes, and improved visuals will be added in upcoming updates.", "short_description": "Ball Smash Hit VR is a fast-paced VR arcade game where you use dual ball launchers to smash breakable objects while moving forward. Keep shooting until your ball count runs out and enjoy a simple, satisfying destruction experience in Easy Mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ballsmashhitvr.blogspot.com/2025/11/ball-smash-hit-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creation", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25504690435836491"}, "review_messa
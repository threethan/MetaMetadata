&_nc_ss=7f30f&oh=00_AQQqssEaQGHW02mthhEn6y-N1MBY8KjUqSfHauuuNqXSGg&oe=6B0C7107"}, {"file_name": "5.png", "id": "2319637268471507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_2319637271804840_4649620927331857378_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcJ9RCx0GqgQ7kNvwEAOdNG&_nc_oc=Adr4cPDxLYDeSzAD_bXVgBxy7HgRbJO7k3T0iW3bWUwFPv7bkkrNwJbTYJT48QHMH5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHGcNdtRZA8-SbSN1CxI9-yr-KZcX85fhQTURFoDtsaw&oe=6B0C720E"}, {"file_name": "7.png", "id": "1764607580861404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_1764607587528070_2161181377186197013_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKLT3oZ0QbAQ7kNvwFOGYpT&_nc_oc=AdpxMIz3KMHaRFHxtD2tTJsDislBRtch2ixdu9T5EYde4JIUvWC6qlHaaS4CC3lpgu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB4CyEe8n5Tt0y_nWbuVJPHZIFObhlgEqxds8MbC8osw&oe=6B0C648F"}, {"file_name": "8.png", "id": "1135288471694811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1135288478361477_2425089163477883892_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lN00JoWsEYQ7kNvwFOnRQ7&_nc_oc=Adqu1GhzB6lowIDqFtHxgA3KqymF3shWUmWADINPtgxDr-rytJGoS8tufLymUMvMqiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAkvwdVlH54NWOawAcX5HQ3jvE-Q_G9dGRiuG7wpxJMw&oe=6B0C6C96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ball Smash Hit", "keywords": ["smash", "hit", "glassbreak", "glass", "break"], "long_description": "Ball Smash Hit VR brings the classic smashing experience into virtual reality. Equipped with two ball launchers, you move through a forward track and break everything that appears in your path. Aim, shoot, and enjoy the satisfying feeling of destroying glass-like obstacles before they hit you.\n\nPhase 1 \u2013 Easy Mode\n\nThis early build focuses on smooth, simple, and addictive gameplay:\n\nDual Ball Launchers \u2013 Shoot with both hands for maximum impact\n\nContinuous Shooting \u2013 Keep firing until your ball count reaches zero\n\nAutomatic Forward Movement \u2013 Just aim, shoot, and keep progressing\n\nBreakable Objects \u2013 Enjoy clean, satisfying smash effects\n\nBeginner-Friendly Easy Mode \u2013 Designed for quick fun and testing core VR mechanics\n\nEarly Access Goal\n\nPhase 1 is designed to test core VR shooting mechanics and provide a basic smashing experience. More levels, environments, modes, and improved visuals will be added in upcoming updates.", "short_description": "Ball Smash Hit VR is a fast-paced VR arcade game where you use dual ball launchers to smash breakable objects while moving forward. Keep shooting until your ball count runs out and enjoy a simple, satisfying destruction experience in Easy Mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ballsmashhitvr.blogspot.com/2025/11/ball-smash-hit-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creation", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25504690435836491"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id":
481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5SaM4M_6cQQ7kNvwEv_To0&_nc_oc=AdpScak-O8od07x85uNFZ-3quki5Dm9damVKV1XkXg5A8cJZD8EKSv3S1DDCgjotyV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt-5Nuzulv2D5MTsSLgQ_8Caa_tn2LtwxbMTHwX_ilPQ&oe=6ABA8D2D"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw-9JznwLbMQ7kNvwFEwe9j&_nc_oc=Ado9m6RYNHIxmty_K-LUabRMCHK4bfPQ0uz038fxS-NKMh1ibIF85g1QMxiIWW52oXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf61LHoGoqf7rJPsGlzWNyUFvnGcjGskqcuAmlAhKPxg&oe=6ABA879A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwpBeUM6318Q7kNvwGbdYO7&_nc_oc=AdpXfVpP--Mp7-GBOA5oa5wnwDKwE6EtkxSj3aZNAGmIyBamybN0kUxXDnWaAL4zCFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIotcVEooDOxFwR4R2F8Zw4q24D6z-kdSqEYI0oNhF6Qw&oe=6ABA8A1C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOVIaV5j_7wQ7kNvwEhH9l8&_nc_oc=Adra54FgOAMk0BMtKc6MPVQs9I7Wk2rdNVLXyy0Onfo-ZorCHea1ppWnSPetUjUOcBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUEjayFUHu9jHNKcdOnDAFzEAW8aB6y9Q7y2r4NiyXNA&oe=6ABA78DB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBS9W_KaL6YQ7kNvwEUK84S&_nc_oc=Adow3-sDELBDJgCVTu27ODvrgsoEKL-UeNhu4CmrBtUsl917qKOGd9uxSw_8Vrt4RlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIArPwtCwPzNWMAb_9qOpfelObi5XvhpeH9ZxWe-ftqg&oe=6ABA731B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clXGFKf3RI0Q7kNvwHdmd8d&_nc_oc=AdrXDEFg1ARgIvhkCg08oFBdTr8FGHZ1oqFtgoh6Gi4ICt2mlX6YYscn-7XbntjGvJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCk-FLaBp7cuFPw0-WM_LjmILhM6wNJvsVSS_0JA0jjA&oe=6ABA8A9B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_
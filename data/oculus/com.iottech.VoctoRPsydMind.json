481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zar0FJ5fIrgQ7kNvwEyeQed&_nc_oc=AdoylL8ajlJmy7s0hPkzHT7REskKq5oNFQs1qR7RQ-dsGE1MbknZfv0MCTDClqeG7AM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jimhs7eKlBzsmIWXtayaAV8_w1vtijC3XPHuwXMYwHA&oe=6A1B07AD"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV9tAUU5VFIQ7kNvwGtg9Gm&_nc_oc=AdpbqZhX6IultQ_xgbgdOm8BwGOKho5ny6pkDUNTdmMKFhmKx_koYDUrPUKrPz88hCg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ff4Kb_tAVGzgnMaXsrUfL8v9fW8zS7c4WvZNPKqF3aQ&oe=6A1B021A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VUqZ3SLvZYQ7kNvwGGbgwb&_nc_oc=AdpulVBtOfZOk2g_ytDKCjyZxFTCKlrhRCdrSrLP04qDQ7jcSzvxhmQkeEb-afhiEIo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w34rU5o3yfPWY1MFgRQX7wfmS9ULx3-4PD7oNFmju-A&oe=6A1B049C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3GBqxko59EQ7kNvwEXpLtK&_nc_oc=Adrt-E3bA7DxcrPNzZBSj_NzGkEKNc3dKAOoMuq-aLYXip_v9jMolpUB4dCtT6tVrDY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cj9j_s-BFAN0XfqIK6BUA3WnhYXHqN377dH_ekfyigA&oe=6A1AF35B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pMqPdzAWj4Q7kNvwHqq5W4&_nc_oc=AdoiRTF0RRs_fAmKJ4ET6y9wJx6fGwsjOEcwpN-Fc-ax_3BQKYJF3Nw20nKU9o7DFCs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60c10aUFZEo8fl_wZNkq9H3oNSqXke1TxSooFKp7i4SQ&oe=6A1AED9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODWiPc_iSncQ7kNvwFkf3xj&_nc_oc=AdpNKg5eDefCtrMfCt4_KzRXCGTyQAVyeR-z6Cmbmpt8eFCdqGNt8-GRWDCscfGi5bw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kkHXrlbw8gdNr54JioXOz0JcwS1PeNGtOM-1XPVB8qA&oe=6A1B051B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_
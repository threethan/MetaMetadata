3658396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWRISOX0OqUQ7kNvwFXfwN1&_nc_oc=AdkE6w_0B-zl9G2CluoH_H-Skr3YsUWxEz4xbeTEYsZuGFSaFfsp6c68ER0EoqEQRIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYFU_N6-ouGg-GlhcsGKiTYCukuP2hFY2-pQcVYylHlw&oe=699D90ED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLaIyCLNiTMQ7kNvwFtRhFQ&_nc_oc=AdngzDspUWE5r9dS8ljX_LcyVwpXKPEJtChRILtiLkmI3rrAGHWXL9BM0G5gQkiAjT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftI4OoBrtwq3dlqdXMyIiwu_2J2M7J3xNaQFP-JMbvlVw&oe=699D8B5A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNDIQMIgBs4Q7kNvwEpWE14&_nc_oc=AdlThCYO9RGMaccmDMVcqdt2i_x7isAwO-X9WptXGuCGimMUHpvZdgMYKctFaQmk8Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMUSF_QkhftmB9zYSzJGi4R8Ked0ZQnCfzFYpChq3Pzw&oe=699D8DDC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_Hc1OaCEjIQ7kNvwEKf5iF&_nc_oc=AdnhbQh9olLSIMxePijM200m_x3FvfTgks1nKfyJ5mqkJnV-Y57ZAK6N24rorCHanqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXPXXTuWMBJisdPyj6EqGzIhOoffDEPxbjnPGVJtJNyg&oe=699DB4DB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY0rt_Wt5FYQ7kNvwHVx0Rl&_nc_oc=AdkGx-wo2AAwVz84sDh2ljkwmAikiIZwTLPfaeT4RnTIR_-mjhNvyuo6PieNwIHk15E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftL5aWw_yZKU3KF0rYfnk2ZUnjYaevkCvqTyrX9X07b0Q&oe=699DAF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxUu7Vrc93IQ7kNvwFnAoYG&_nc_oc=AdkeeKCloiaQ8xVlpcP9lbrga17jmHMxNwEveyA-oHCq-cZTmgIe3pG_5x7d-2Rcexc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOj7AzNNWqCNYmYcYxJdg3WdNtPpwwmy1NRwhRy31how&oe=699D8E5B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhCBtv2UnZkQ7kNvwGVAkC3&_nc_oc=AdnM52dvel1iwZHXT3FycnujMLhsaHSb1X-gRPGU9UvjVZUlv6UsxOD2qhL7fEAbq6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00
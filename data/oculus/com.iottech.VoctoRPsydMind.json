481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VefOm4iFBEQQ7kNvwGPYH9f&_nc_oc=Adp0nlPdkiKw9brpKSeedodq2i88fOYBCwi0x1cQ7b_mlngT8hk9RdLQD1d8F_imaj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1-Ps3XPGEC96eK_fgaPfsFHxO36I3w5wnk_GhK4jdpQ&oe=6A6351ED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJe75BTAaa0Q7kNvwGDajOm&_nc_oc=AdrkpPdrS3o976wZWOppEf3ZOObODO0wJIjtYq_FTJauWliS-08bICeqrfwT0U7TqPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwPhMeXrrkYvLcl4Bbn0xDMEZa_564EMShZggHG0BJOg&oe=6A63849A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R571Fb7L0YQQ7kNvwGsikxj&_nc_oc=AdofkD1SBHsJilPG9roxzENYYcHUOmnyhwb50yulovKIEJsxJhEQ0lumeh8iZm_wA3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2JpYKA4PZnh3DyU-fMNZT5D312qAcWnGcfhTX9RKb-g&oe=6A63871C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxEt_p9ao2YQ7kNvwEF0uiB&_nc_oc=Adr4wNfiCug8V5TT3agPFZF1K28D6pbTaVY90jyasQM1UX8shHc7cMu2ZCwPCF4b42M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFJ2HN_Kh2O4ybFHMwtA_sXXRlYrgf5vD-j5V1k8mi3A&oe=6A6375DB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kpA2mLSkGwQ7kNvwHNfsfM&_nc_oc=AdoaPgdmpstirJqtk-YexXkgbeaJr8C4lw_xC53vN6aN-2SpH2cFsz1V--mZi0D60Kg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoF8tjO0UP6E6y_ltlTGx7GTjdQy5w_BkVZQN2Dp3c5g&oe=6A63701B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXn7jxUV7QEQ7kNvwGxOBSH&_nc_oc=AdoI99ArD434Nk02ws3DE-NiAsD8WbbRoIKJIWwS6FBkp6wmhXRgwBuinCxAES2NQP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwFxzY5rg1QTIQSSUjSti5aVhuOCMt1_iFzCEiMlAH2w&oe=6A63879B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_
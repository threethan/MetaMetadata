3658396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5IO74tXye8Q7kNvwFmDKz_&_nc_oc=AdmQGBd8s5EcGoMSxtArVTvn_cHi0A-fm-6zvUMvL0dCOz0ZcK5XLBuWQuDrtmLgc3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlWz0RZqkypp66ASj8Cwl9OE52vJMWKTdymnljrPKj6g&oe=69A6CB6D"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Sc-5ZSim8Q7kNvwFjf7CI&_nc_oc=AdnuBTRfB1q7D2XKHkzX_bAiCajv2wAwgIoRYjD1rZg342WPIWm-rKZpSmF448SOf78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvs0jS7oMxFuGMxb9DH87MOPYWjWv7TdjxAHqdSOsTZmQ&oe=69A6C5DA"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJcxZFhp17QQ7kNvwE-3iEP&_nc_oc=AdnAeyo1YdF8zZVAkIgN9TECsciwf2HcW_2N6M01NZVbjMv9WsyursyXupho6t38jKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNqZf5u5VFdqoVAFB3IvpSPXGnmQLaIuua6wKBNN39og&oe=69A6C85C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRmTtrkaBo4Q7kNvwEUbkeb&_nc_oc=Adl4YUfgmMQMkjGQkoOfKKDrnRfGpwg7S769-xBZ7uI7mkzrP6tXtMrLa-BZlvMzK1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCHyWpg194vUgNNJyykSjsLOi61ocoYqRidY1jRdnJpA&oe=69A6EF5B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGfrzaEqRg4Q7kNvwGfryS1&_nc_oc=AdnKwDK4CYsN-gktxahVnSSxc2rNHS5myIFSalxUrx9ZGqnKbNLElVUD2p7rLBNe4sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftv1b5HvuV0acA-ghWxTPqL7Nt8_M7etQ8fkNEsIza4RQ&oe=69A6E99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekOExnE4JZkQ7kNvwG7mnUE&_nc_oc=AdkvO5DeCRdRnIAOwIHT_PtZOyz0NRoBqtfvglB8Lq1ccYpZ6xQUZvwA9bvyCzhIEew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSIWwq1sTmtW5shzBennhn0hwO13prbayNo_A5EK4VSQ&oe=69A6C8DB"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byFGdcXc5S8Q7kNvwHd72Zv&_nc_oc=Adl2YOrO5PaxQVqsIrdEtMiBmAtM1S_7lsf1Qu_H7iyCMEuOiBra5V7Z9O-srEnIwDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00
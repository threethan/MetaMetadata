s": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQyI2O0iBxwQ7kNvwGiyVdj&_nc_oc=AdqFxndl0e8DcMvp-AorCYqKmPeTjfYKxwrr5ozvBadBsliOQftPZiEZPzynhIhX-hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NQfpsJrWa58Tly_NsF_aenVwbVZbShe--U_vuHbdjgw&oe=69F1F0ED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5Oksk7-5kAQ7kNvwHmaDHD&_nc_oc=AdoD-2rQsq8xilsLDyyiz_nnFmj-XRhqFTy88ZLqgYBnyAGIpIeEowIaqFDwuu5kkd8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z6NNnWld4_u9JGhnE_UTC7dyiujPEgB2_e7Y1pDlp5A&oe=69F1EB5A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb64qG-0BHsQ7kNvwF__31i&_nc_oc=AdpS4x3-cA65QpL4TZlNq-rVaeVcVx-5a_MYsnlSdgSekLZso4VhflDeQ6evnZD5cYY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AALmzbMPypRqGJ1h5xQQesI-KzJB-l678_baSHMYa6Q&oe=69F1EDDC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdCMAIZaQYIQ7kNvwHBB4aA&_nc_oc=Adr0Aj2OmSYZ7GLyBd9fKCwkvZXFS191yooFWLGt-PQXpIZRxHXFkZyFUHb8uR6YiOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af09Tt8kAnaq3-Q8zeQMVlCrTUtGN6AfJrdxhHo9YrAE4Q&oe=69F214DB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTrBqBFd0DUQ7kNvwHPYx5G&_nc_oc=AdrE8W3SOvzzMYIavkeFAGWJ6m3HDtcTbT9XpAtE9akYvZOcSt8AOszInutzRU_Njow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tX-Iq4SDjfWZPYjv-CuKTmGj4foR3KhqQP23ZMvy7sA&oe=69F20F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ue1IMcBUk4Q7kNvwExrBRQ&_nc_oc=AdpYt6yHofhcWedSCJh14nLmg26d0BTJiPucY61xnRwYgUFO6kCiM5jtwu_A9cATePo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3v0-a-d4y0cTOzbRxWjYYMHUlfA0kThNSxbPDiDBmD4w&oe=69F1EE5B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H7HMvNRnygQ7kNvwFER8xv&_nc_oc=Ad
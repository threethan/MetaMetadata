3658396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6P_375S1hMQ7kNvwGDZa-w&_nc_oc=AdmJ_0FNsTarnBiwdLr5sQy7zlPjOxrh5EKRsSG3ryozzw0YZwMpD6iYP2yr7UVSCSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftMOfzYM6GOZbOEQF2uWqqQ8NaDOUxBIvseOHq1kWDwPA&oe=69984AED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbaKzC0b8coQ7kNvwGQ5IbV&_nc_oc=AdlnLJVjU4IRSkdaazRtQ_uLKPj7CFMNWlaYWK5djDKNYNcCOZMtkoB8CFQqH-XFCc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afur6-SCmf3T_gczQU_A82XEb-jjg5JZvy3XcemXHkxrbg&oe=6998455A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrlHNvi3Td8Q7kNvwGPlqLT&_nc_oc=AdkzPARYwc8qAQeoGFdgio9Po75JFQNSWvS8A-FVfEI9uL0dD7TcvXpoSi4HB6pgsX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuGjo4kW5BLq9IN1Jwdi_uW8feZW2AajM8OrG-VubAgLg&oe=699847DC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M96T9vVRmr8Q7kNvwHCmQ78&_nc_oc=AdnvRtK3zRU7anpJaNRurhQ9C9fU0V9i2J0-7hglundPUB_CLRILI8jKYr3Te2nBDQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuONNNPZyOf3nPk1bFFm7Yf2ADa_HWoU9-PwgywyBmHQQ&oe=69986EDB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D-iUqTrNIEQ7kNvwGR1cNX&_nc_oc=AdkIfyETOWn73BW8KsCQTdGAC0xDycrTZrJ-EFE2uPp00_MbuXNh9nxmtoC_FOMJIN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsS9_KR58niS7-z9yU96lAV2FSL7K7uV3XPWfkB631u9Q&oe=6998691B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxbGnr2P2EMQ7kNvwG0rqKP&_nc_oc=Admr3O8-VbD_7R3r2IBWUxz2hBdm2Dh9n6_6XU_hdaEiRCCBBuXGgMdfFVQyLW8kSec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs0VCk0K2frrpnTkz5yo9l-Yfc2SRJ56oIZa8MS-Wsk3A&oe=6998485B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI_NdvmwKK4Q7kNvwGFBapS&_nc_oc=AdkSjaE36GmCl4DzJhi4jY-NNAqNDqgMeHKYvSM1xC1mqFLpk3icEeeDHvPWXFDtFKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00
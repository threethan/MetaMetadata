": "3314906295481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4--sPWJ4LnMQ7kNvwEGJG1E&_nc_oc=AdrX8pqnL9AcGWUMq2XMVVFoqL8GUi68Tyi2_TxWNI6u2hVHfOMO4LePU9ti6HmNPbI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD9Q0mJJxECeNZGhabKCrczeb0KKZiqSFk2mderdFm6g&oe=6A8598ED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTlIV9OHXZcQ7kNvwHV2up4&_nc_oc=AdrgTSXEwcT9IpW3a1NuY45qjGt4bK0-2IBc8nK4h72YMXgMTUSNKwT6YZNB8XZiRhM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-ut8Zt75J2x6TqG8Br6m5mNJ58tmtBXg4ZtQolaVpUQ&oe=6A85935A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qme76uNx-JEQ7kNvwEJ4dFE&_nc_oc=AdrXuMm7A97eOZb11hvPWXz-VAOWerMc2wkgpmc31RJw0I8tZ8aTBIA-mmHGr4WpUQ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjOuzKEvPUj74LhJVkM-eg7ark6nj4zOh2-TWzJdlslA&oe=6A8595DC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDIkmEg7z4sQ7kNvwEygu42&_nc_oc=AdrC0oTS_qqW0gk4xnAVe87g51Bh66sZstmN5L1myrECS5Gq8yIc6jJudVcZy9YDW84&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlKxmP7fzV6VUShCDFrTZxycb83jbKogl-yJ5944Dd2w&oe=6A85849B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtFB1B6fNe8Q7kNvwGr9WmA&_nc_oc=AdpFeWZOpd3dCNi9il4KMyHyk74O3-dFEMtWcX4XZFODVCII3OrEOM5ruCh__MGKev8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3FiiCeLY6DQD0KrwAQaUVCr10xRYts8ncyFObZ1Wd7g&oe=6A857EDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD0C1cOHhekQ7kNvwEuLenw&_nc_oc=Adon9vW2Dp4ygodqkXhMX3hRz1RZYEc9tPkeuf3w3xWOA1fJOCMPLgFpCEQNjGw1vSM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4avhyVPCqZXFk_Qb5XRIatZwEkiKwUYEH1G-g5r8L7A&oe=6A85965B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360
"screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5D7-TlZe8gQ7kNvwH5K8K2&_nc_oc=AdlIeSpvL-tIjAZKcLm76Fa1TqJG5ZwX2RqaBIrBdan55V4AmKjkFQmwQiN1QS4GXaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzAFMwNSpNLyohPHosWrFk0G35WNHi9h9UqpF3Dz3CNg&oe=69AEB46D"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vAHMneO0rkQ7kNvwGvwiOF&_nc_oc=Adn6Fe-nVGJuogxHyTF2dT6Sy24Uy3WR7q48ozVgXeVvUd_zi2xlZPcAPwIG5X-QkIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzbb749_7_j5Qmi-Gfn4VWhD8b1CjRJ_zF71Fz-azf2Rw&oe=69AEAEDA"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SmJAnpcw6UQ7kNvwEF-qoG&_nc_oc=AdmkOxMkhokXd-60ri30w1gXdijNkVPT-EuD6dX3SL_0pcENnHqArsqW3sITRqMkbJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUWs3spyPYsdhDoHSGSSrm_R-VnVifckW6KSmgbGqtcg&oe=69AEB15C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkcCyC_MWk8Q7kNvwF7lKmO&_nc_oc=AdkhLmeUjSr-N-S_XNRMrYOWDkIrN6xjq_4-tktMXQk-gmr_m-uQlLoOJSRa_F6ji-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzntgH7gn95E7JPi9wttNeg7e9whm-xu5szRih8c8rLGQ&oe=69AED85B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1FIa8pEx2YQ7kNvwFOY3Ll&_nc_oc=AdkchkUhcWKRDaYegm3WUQzmmJHM4pJBN2Lxw5MmpfqpTcKCkZpotKQ2yu99qP06cFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygQ-snzWpd0HvQrHVCLTA4FgL975gIQiltQRe4TiMaPQ&oe=69AED29B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X_C4GjP4MgQ7kNvwG3pbhM&_nc_oc=Adl2mIe6XbB7z9z_vQv8b189FdBrXy2tFVtDSTW2gwhmTHXe-9sIxykIPU4IMoh_s5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlx5tB8JLY-fpPU-zr7IuAAQtrIUp9pKSm5zrKxnDtaQ&oe=69AEB1DB"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wZ0yCMk31kQ7kNvwFIm5qP&_nc_oc=Ad
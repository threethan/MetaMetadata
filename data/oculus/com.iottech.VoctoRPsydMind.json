S", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwvIRIKziwEQ7kNvwGLgszu&_nc_oc=AdnVQL1xoYl0x7pJwXdyIxw3TCKQ5Ie4OCCDFjBJXOHXs9jOYJTv5k29vAcJAeTY_24&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWuLqP6zzkM9cSKpl0ApLiNqYuTr0_6HZ_rJwTO3iufw&oe=69AABFED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMHuIqeVJrwQ7kNvwHlJj6P&_nc_oc=Adldtq-u7M-0a2mmYoSx5mv4JSPY-GiGeqdXrB7qXGMcFoO7Pd-JHUrSY110Sf2X_2c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfydmXtPSiG002beOsyUPAwJ7AmLqzCweueJpQ6Dv2YL6g&oe=69AABA5A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuPXtkVgWS0Q7kNvwGui_hA&_nc_oc=Adm0GrQdHUiju17zQ765X3IXeo7xnE0laE_9uHPm61RBKPZVjbH6XJLd6mSZy3FZ8uI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxp24LiI-f91v-Q9e6BLaf11aG4YDIK3AolZcY1EdbZkw&oe=69AABCDC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgAieCa4EPkQ7kNvwEYWp6t&_nc_oc=AdlHKV-szXt3bIuJrddj1Hwugk9tVrNR_UWNY97Ogo9c5CwUujh5ShkldcvXwOe5lhg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyE4g_QliSKHAp-DiUI_AyiXjWcQx80T22vsNc02bGp-Q&oe=69AAE3DB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdJg2Up-_p0Q7kNvwFHOncr&_nc_oc=Adk_JK4Gxza_wZlmvZJ0RQVimAfV9stVo1QEpSgnAkYnFEnClH1nfsq548Whs9rYqBo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkD5nVPelWgNBaS6bKkVbLMNb9uZ47fHkw0JoNtcQQAQ&oe=69AADE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgOtSP3zEVoQ7kNvwHbWzKl&_nc_oc=AdngeVwTRLzTZHj50rSn-Z3hZ17iBY6hGteV16x8b2uzMxJ1wl6m5Qos7kArxLdbagY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxugq2x8Z2GeP3mU46y9udSKC9BKAPVHd1uq5bAPrBBYg&oe=69AABD5B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRwbpTGMeicQ7kNvwF5wvvM&_n
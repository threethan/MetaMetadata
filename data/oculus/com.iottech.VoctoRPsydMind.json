6295481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC9LDAsuIqYQ7kNvwHg0VHm&_nc_oc=Adry-mLOgbMQyuimod3SD6ImjBM7Jy3ePz1w-KGMoem5G6io_j3j4LPSYCeSBMRWipA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMXftogpw3Ut4JnhUf4vWC25rli9AhHlc56dHlXVaOZg&oe=6A7DAFED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6ck1apAYbwQ7kNvwHk2jKO&_nc_oc=AdrWBFY3LfUQnC4egONwGKeNZ4t7thxK-wjyz2TP-fvhuMJ64KG2pAvSQp1JKolDZVE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2IUqY5-BGdE-GMbP20JB1lHLJI4USjYPnm5hUIbOHrg&oe=6A7DAA5A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8IutlmjIIQ7kNvwFKTNLe&_nc_oc=AdpM6J_7F113iEnL1CnIu3V2dVLhZHOqBi129BN4dt5nG1Uyg39dBAwW4QSI9mjqcPQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSkElyYJvKGcdykADEFmn9bA-n_7Nvv5XlrIwR-5Ob7g&oe=6A7DACDC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GW-RnV7KiUQ7kNvwFV0KB6&_nc_oc=AdqQTwNmU1xnfRAb_oAJWSQXIAu560uTPlbdnk1vXwDrOe74fYiIpCOwycLkmb_tGb0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0_BuzqTNO7BteD-RN_6adQjOkwKR97cybFa3gZiY8HQ&oe=6A7D9B9B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfKHOoIr4_AQ7kNvwEl1_WX&_nc_oc=AdrfVpYT_uMbT29XoFZiCijYxxvnbqsxH7liM5EWT5TWbPSEME4ok35cAaT7Lpx_nbU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQYnNOdbaHl1tR1201ILler8FfdWVYfyuJZxl2azcWDQ&oe=6A7DCE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfzARezDdVAQ7kNvwHpbkzx&_nc_oc=AdrrzckKHUJ5ItVucfMscrQMs80zWVjJI37lhymSvVbm_NltcrWVVty0GiJNtp_Y6fM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYDyhDqxjnw6tLMuBaQt31ye_Nys-deRGX4pZ52SgFxg&oe=6A7DAD5B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1
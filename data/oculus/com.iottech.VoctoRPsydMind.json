481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CrErwSgEn0Q7kNvwFs-11k&_nc_oc=AdoYLD0HFuowi-MtYwqxnwIsTFrQEX2pHnAI26Iaqm1TKPx2ELM7SBRstYlqi763zAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UCt7YdO-0d_Kl38fZJM6W59QyDv2qlqsB376z2wLXTA&oe=69DF7BED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DHJfmKbOJ4Q7kNvwGJbAY7&_nc_oc=AdpD9TnSrQ_h-cMIeYZ1_GBfhA4IRMVJIhniT9HgA4JiVwvyfbMVjnDmvxZncZ78FUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iKeax-7QfhotDyV1lAl0uFa3f8Ed6alsrfbW3Kf7BAA&oe=69DF765A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07RIVanYqqsQ7kNvwFhxRi3&_nc_oc=Adr3fu_8EuGoYtU7T5eTpOEp0i0U18bh84Ykj2j1fGRn-9QgMhWZB_rtgqNm0y2wR7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03-_HBRAKH_c9FTqzPll0n0ue5AF3cn7p3ofGy6qyd7Q&oe=69DF78DC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orbz1ZFao8kQ7kNvwFX6ALE&_nc_oc=Adp3xobjsjfCA-jrob_bKjHuopkGFV4UmbPKrQ-eY66bvK1iEMoZdfRO4QkXTub6NWA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zexRcTnlJgrZ9vPzVWIK2nlC8V4knPbD89LDY2kLC1Q&oe=69DF9FDB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9GLXcmymdQQ7kNvwH1mgs2&_nc_oc=AdqqpRsRf4zRXgGXNggJlnxUdP1eBLa8FzYaR0xUHGSCR9M9Gv4ruBqmtWFQMHGUfSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fUVbl_A3MJaJ5qxgybvoJtfISYvHz3WeWss7vOFwWbQ&oe=69DF9A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWXqwkJY-YUQ7kNvwE9viDw&_nc_oc=AdqQahKATtC9MWTYdfsfDdsazJVvg1eco1S8aNYDb3POyHs0edtlktLw-anb_59ij38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MI67GSHYUrMNjL6SLEilByOaIyy7LqIajghpKpPBQqA&oe=69DF795B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_
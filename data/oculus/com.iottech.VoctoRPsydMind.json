481249", "locale": "en_US", "screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1gRBmtQTCkQ7kNvwFfOzAA&_nc_oc=Adojt-fbrShHiaIusiGkW2Cr-io-M0d9W4sKuhsls2wwOBRV6N4NkhMFX2H2eQMZ03g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kqRfv49Gq976cgoDIM776T7_ZtZnb5GKHKlqLeYWeMQ&oe=6A24422D"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YXM1WeQhOkQ7kNvwFKkJjx&_nc_oc=AdqTNQG5RPVV2cpgdhca2W5mBZv5EwrSCvdQjm9-Qx3KFRMQqkBzSKvDLo-w-t-pHls&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90phEj8LJ3VfG3ERS1eebcFHiiobGvWSwOGeczfMKXuw&oe=6A243C9A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzcIGidvcLEQ7kNvwEv0FWS&_nc_oc=AdpC5beonQLTw4AD877ruSOHwayhcxs47Y3y2emAqnI4jRAMq861dPsSkWF61Vtra-k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LXw5H5EDANd0UzQQ4lvYVII_SHWVvPEOPIcS4Dn1UDg&oe=6A243F1C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cs-3mxWnx0Q7kNvwF7121U&_nc_oc=AdoF31v7fHxie0H7T9EYvHKS-karyzma7uVS0OKuPOfdoOyNjbMwjJ4LI_V2RAWeDyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LeSctK_X73tkaITL4Xc1-fUbDr_adUs_pCdRfEuggbQ&oe=6A242DDB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9dm8BJeE8AQ7kNvwFRhI-z&_nc_oc=AdotHGDClmj6Oiai0xQdYcnyfVafoEHcBjqpIOaZleYb5AFcgoGjGnxg4062sVnzo3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0cF7Lwsc_Cpy5jO0xRlo5ff5s10ycInjbewXw-qC2cw&oe=6A24281B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCFMOInbG7EQ7kNvwGKqqWZ&_nc_oc=AdoIqzNiljJAE-GN4HGD_Mh5oSo5XH29F-vOnOEL2sftjD2ToQmrebHDnUvNoCioHvQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K4XC_43HI0ehzEAhVp_o2Wx7GxKYBPrQNO8S70StyEg&oe=6A243F9B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_
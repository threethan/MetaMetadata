s6alydVoK5wcWoFdorsvUy0HX5l5llEiOvUD6lqnOPme75X3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa4EkerFM4ccOYwkOkPOzOoxrK023LBe9JUb_3OIkj5Q&oe=69C14D5B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL_QQKqTvoUQ7kNvwEVbt5C&_nc_oc=Adr3o_kgWD10DBSmiGwAsA6YOgz6Oi79fF8lqxlD3cb8lbxB0On0zQMHRzrSoQU6el4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRiJnpTWBOZomWj_7ttBra6DJpWOIjZssYMJuvV-9lTA&oe=69C1479B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfgjTbOurw4Q7kNvwHjjoXQ&_nc_oc=AdoPEOV4Lnig8WOq44mSjin8gIGAkhHJIcQ-ow2VStXsl0fY7HnfPtJx4k63ZMx1CrM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6N155U7G1UDO6a8IUZS6098yXpstm6lq_UhsyN2NIoA&oe=69C126DB"}, "display_name": "VoctoR PsydMind", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
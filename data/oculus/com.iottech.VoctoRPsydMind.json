3658396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyDYqij8U1UQ7kNvwHEb1YB&_nc_oc=Adl_qgTF_PPOYw-ybURyOoN5AGHX8k3zfKdQX7lhILP8c0N9N5XM50J7-_GOR5PbLI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsnJzpr1a28zlXWyfBlKjpyPSS-gEhockVCiazr8aiu-A&oe=69999C6D"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbaKzC0b8coQ7kNvwH0_yXv&_nc_oc=AdlZ4TSh5IJedLeZ-ir-k2eia3SFBdTQmrttzXZHjsBc-eEFM1t6myrXBZQwVhWqHks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujOOEJ3cgCI29xs-P45hYla-u0YDopjJpufbD-uL16Jg&oe=699996DA"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrlHNvi3Td8Q7kNvwE2i918&_nc_oc=Adl3DL6TWdG2Wv9Ura6qCUYLxK_o4NkF3JnpPIswvWIFOrg1J8gA8pDWsj1icxfJuDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftx2URLUBOGWLZQrAueyz1vSzohvpSTy4RoHduFNbnYLA&oe=6999995C"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WePvODd8TFcQ7kNvwGb8Icx&_nc_oc=Adk9N79MJOAcLPIwMKVgmaiPrhJPpneugCQz2A9YJPL77W-i-zCznIYEAasiVpdxRdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGdO9lAD_DGec296-yqN_U5w0o3qhbZO3SXTFpUIQhvw&oe=6999C05B"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D-iUqTrNIEQ7kNvwGLVPN3&_nc_oc=Adl5NsE9JMR5lsvj3v4ZYAJTznXFmcVNZYK6oyEzx2JjAipXoeGFnukqiEG4VqBsBKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswnnWzwsViSswc4sTiVcUbmaMS--BrxTGgDl_mmwXYUQ&oe=6999BA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxbGnr2P2EMQ7kNvwEMoL6W&_nc_oc=Adn2N8AQoIUJ_I9RbWdOKVyCBwJiDU0CY6swgk7Ust24riMIXO94zPpkE9mL6_YOszc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGLrBrlRgx8Xac7SHM2ZWoWSZ4OxvXgjp_6qxGUHDpbA&oe=699999DB"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I7zyH-iLkAQ7kNvwHsonbg&_nc_oc=AdkiSXJpTq6XqanwPpG5V7YFyfCrLD4voiGqkcXL-sKJqHjeYg9DlsPE0048EtQ3N2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00
"screenshots": [{"file_name": "Sierpinski.png", "id": "913165003658396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75318183_913165006991729_7834394292683619686_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izvn77S5hs4Q7kNvwH1PPrZ&_nc_oc=AdkPVJk0KIgrCJIFI5WFky00pV_FIdpDnms2pFbPDolkvjRZk33r2aRUdahculoHhp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzF8ZJ2GDLi3uvWSmx2mhXDmhBSoxwOg3J2yXx0iSe_hA&oe=69B2A8ED"}, {"file_name": "Mandelbulb_01.png", "id": "262138356520276", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_262138359853609_2859759454155653088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZVuDGwvsToQ7kNvwEaqZ45&_nc_oc=AdnHucgtUx2gITE1Wt9P06gid_jffHmfoMvlOCGzuPME2rq08hM2rWhZcYyOJq16Dag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgXhwVtQspebwrmjeXZ3gKa_SUdJtve1nuSpJzlfcOUw&oe=69B2A35A"}, {"file_name": "Pythagoras_02.png", "id": "1521857538609718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65402154_1521857545276384_6932935515601424484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P74J7gz6LkQQ7kNvwFdZuVH&_nc_oc=AdkAs9tvVbvtWiT4ITWIe8KAdnNRq9k282XTNwtKzOjXgLZZpvkLLPEearO8Xum4x6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfysZqZ9lzIFXowubD-6eu1jJSHW1kaTE0e0UPcKhTgMgA&oe=69B2A5DC"}, {"file_name": "Levy_02.png", "id": "196149426884252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/43997710_196149430217585_1332548403471429223_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIVasygesIMQ7kNvwEHv100&_nc_oc=AdkDccgCZrW_0aoYHph6BuChLaghKoIuyklvqtHw6pB3AoOkiX2mzbl5jLd9HZOv9-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCHNYZyisvN7eULZikR9ZScMyrgMwRONxCwhr46TgkOg&oe=69B2CCDB"}, {"file_name": "Radial_Solid.png", "id": "271501478838543", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031373_271501482171876_8031340628965781426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPj1kx0VRscQ7kNvwEepjgk&_nc_oc=Adn0Im14Wegb-2FJ23_CWP2PyfaKvv_1-54BsYewsE0sX_42i1F24FFEgwlAWYRMHvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0sY-5PnUlyeSnkc4UjZD2z4aEayogZAjTW0CNrVY6QQ&oe=69B2C71B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Psydmind_Landscape_2560x1440.png", "id": "1020482742612505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982514_1020482745945838_6452784102981224285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fCZ985fttAQ7kNvwEvK_2R&_nc_oc=Adnddz6pqnQOP3EQdJ95QM2BAQVj6JKHdR40s7a1q2cZ2hnxm84KXXgmDEkvXB-j-hU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXZynHnqo_u-KaMiyA-Yby3j_Fvdxp38-zeguS3ANEJw&oe=69B2A65B"}, "display_name": "VoctoR PsydMind (Clinical Research)", "keywords": [], "long_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\n\nPsydMind offers a powerful approach to meditation: \nFive distinct categories: Each scene is designed to address a specific mental health concern, incorporating elements of color theory, math, and shape theory to optimize your experience.\nGenerative art: Witness the mesmerizing beauty of evolving fractal landscapes, created through generative art, adding a dynamic and captivating element to your meditation practice.\nObject movement with binaural beats: Harmonize your brainwaves with the gentle movement of objects and the soothing sounds of binaural beats, promoting a deeper state of relaxation and focus.\n\nData collection and analysis: Gain insights into your progress and identify areas for improvement through anonymous data collection and analysis.\nBinaural beats: Incorporating beats with the moving objects could further promote relaxation and focus, aligning with the user's desired mental state.\nMusic: Carefully selected music can complement the visuals and binaural beats, creating a harmonious and immersive experience.\n\nAreas for further exploration:\nCustomizable parameters: Consider allowing users to adjust the parameters of the fractal drawings, binaural beats, and music to personalize their experience.\nIntegration with other tools: Investigate potential integration with other wellness apps or wearable devices to offer a more holistic approach to mental", "short_description": "Experience the transformative power of VR meditation with PsydMind, your personal gateway to inner peace and well-being.\nCombining the five categories of scenes (anxiety, stress, ADHD, insomnia, and depression) with design principles like fractal drawing using generative art sounds like a powerful and creative approach. Objects moving with binaural beats and music further enhances the immersive and therapeutic experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/psydmind-privacypolicy.html", "developer_terms_of_service_url": "https://iottech.com.tr/policy/psydmind-termsservice.html", "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://www.iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6809356815841159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570307_6523707741085603_5188546024188693358_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlrRn7wAEigQ7kNvwGdpIQP&_nc_oc=Ad
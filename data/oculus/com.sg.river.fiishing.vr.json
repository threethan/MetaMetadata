=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rouv5yU1crcQ7kNvwGQa4vk&_nc_oc=AdpBGwDNhetp0Ab0K1-fiejTmSZY4JJFkFliUkV8_aMkqQS0AbzO-XHjFyzaydRnncE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh7SD1GBH7M4SRY67WA4efX2i-bgEzTf8HjuDr6mCg3g&oe=6AFB27FF"}, {"file_name": "WhatsApp Image 2026-09-17 at 11.35.22 PM (1).png", "id": "1102244322759356", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628092_1102244326092689_2931837419580184065_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P6IELGBkj0Q7kNvwFXs1Jo&_nc_oc=AdrylqazOT0qu05hII9uFuRa5AgDwOjvhntC1-nX3A3-Xh9sQpFbUcYlspT2hyHdZHY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2KLUgHh3tPI2roAftce18txeKdHDl4q91Pqnz5EtM1w&oe=6AFB1476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fishing at River Edge VR", "keywords": ["fishinggame", "riverfishing", "fishing"], "long_description": "Step into a relaxing beach experience in VR and enjoy a peaceful day by the sea.\n\nPick up different fish from the table and give them to customers. Move around the beach, explore the environment, and enjoy the simple interactions around you.\n\nExperience the beach in both day and night scenes. Enjoy the bright atmosphere during the day and relax under the beautiful night sky as the environment changes.\n\nWith simple VR interactions and a relaxing beach setting, this game is an easy and enjoyable experience for anyone looking to spend some time by the seaside.\n", "short_description": "Enjoy a relaxing beach experience in VR! Pick up fish from the table and give them to customers while exploring the beach.\n\nEnjoy the peaceful beach during the day and experience the relaxing atmosphere at night. Interact with your surroundings and have a fun, simple VR experience by the seaside.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/city-art-horizon/home/privacy-policy", "developer_terms_
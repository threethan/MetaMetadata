-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsZyP2xNzwYRHI6-ccOJgSqirKY9HGDW4JXRduAMPB3A&oe=6AFB2985"}, {"file_name": "Layer 4.png", "id": "2102742500321970", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821796_2102742503655303_7789891940280671767_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5TaBjDAfJsQ7kNvwGBBw6C&_nc_oc=AdoFPhgd6R9ngE19hsDNGCcj9VKrdBoEyGuWt-sBXcoZBmH-g7MDlOdq3peg4M23qHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM5R7ow_MAM-X2jr2dB4e1mjhVvFf9Cd277HqcwDyp3Q&oe=6AFB3F0A"}, {"file_name": "Layer 1.png", "id": "3925999797694774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_3925999801028107_3359801882399555951_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGcaGg74fGsQ7kNvwGiPnf8&_nc_oc=AdpDfZyneRQD3BzAqyWlHwvB5Nc76ZR-3dhbRE_spbYfz_hdhVZg40pRoEPGyoXVWws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfHfXEwftFGVju61X9JcD9T9xLRHs4B45Pvxh84a2jRQ&oe=6AFB3790"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "How To Fish", "keywords": ["howtofish", "fishinggame"], "long_description": "How To Fish is a fun, colorful, and immersive VR fishing game designed for players who want to experience the excitement of fishing in virtual reality.\n\nStep into a beautiful outdoor fishing environment and get ready to cast your line. Pick up your fishing gear, aim your cast, wait for the bite, and reel in your catch. Whether you're an experienced angler or trying fishing for the first time, the easy-to-learn VR controls make it simple to jump in and start fishing.\n\nExplore scenic lakes, enjoy the relaxing atmosphere, and discover different fish as you improve your skills. Every cast brings a new opportunity to land a bigger and better catch.\n\nFeatures:\n\n\ud83c\udfa3 Immersive VR fishing gameplay\n\ud83d\udc1f Catch a variety of fish\n\ud83c\udf32 Explore colorful outdoor environments\n\ud83d\udd79\ufe0f Easy and intuitive VR controls\n\ud83c\udf0a Relaxing lakeside atmosphere\n\ud83c\udfc6 Test your fishing skills and aim for bigger catches\n\nGrab your fishing rod, cast your line, and discover How To Fish in VR!", "short_description": "How To Fish is a fun and immersive VR fishing adventure where you can cast your line, catch exciting fish, and explore a beautiful outdoor world. Grab your gear, test your fishing skills, and see what you can reel in!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/city-art-horizon/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "City Art Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/city-art-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1302055766323056"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2261133421344575"}, {"status": "PUBLISHED", "id": "1646194123882397"}]}, "baseline_offer": {"id": "2261133421344575"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790182800, "status": "PUBLISHED", "id": "2261133421344575"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1317607564767876", "version": "1.1"}, "id": "1391948413095661", "channel_name": "LIVE"}]}, "is_for_o
8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbM1Vp5FKh0Q7kNvwEFdNsX&_nc_oc=AdoT5gl7ACn_xdaDN2qkcma3gCPSMOT852_MXzMZVx5wX5fDWx_EgGYusWgG_EWaapI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYzTK3e_vDuNyh-_KN02VGs8byN3aeH-6hABomEp1lJg&oe=69C1339C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEoQoEJLA_EQ7kNvwGNSaaV&_nc_oc=AdqigPXeduR1ZJ5EMVCv4e6jmS2A-zBvvMx12AMF5YTq8sKy__clqDxU8t_w8mu6EHk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnUcNCvMGvDHLFPIWJDYj5Ej3dUEtj01WnX3Gq9uycvQ&oe=69C124E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gouGVZ2jskMQ7kNvwEUFWIm&_nc_oc=Ado7S0UTKM-ejAYE_g6mVTWiJwGIWTlEMwOsSRCPcQpyi-ziewfvATkqgSOHHFYFxII&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZzQIikcQn8KLzBzrN4pf_FeLN7cV6nd795eOo_QbsNA&oe=69C14A32"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8xo6miReqUQ7kNvwFZTurU&_nc_oc=AdmoPcZuPQfauhvwo6PVUxNgLqcBlbbXrkTeBSobfMY8W8sn9q0xp1qHajtYvFW6UZM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsIYR7-eG7WlwOWhgyQh_KdnJ1HOwRSKFlT4902YouUw&oe=69BD3F1C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz3x6ItLpssQ7kNvwHuqyVK&_nc_oc=Adkw9KYOgncIotQg3P24DCx-onEeEI_ZX_Ehom-QxqlLDs-_GFs9J45Bzucv8sOQpMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC2lquQQKIA_S_BJFa5JcxZCQpRaJjoSo1k6K7YBUULw&oe=69BD3068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acF8G2b6GfoQ7kNvwFxt4d5&_nc_oc=Adlmdvb-Gf242EpXLSXzNpBYVTbDYCkpfsfJd9xvRG-A7JJ6DZufxo21hz3otFcWz4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdTzpI4hsBFHXSJbISjzlTVIDFqMrfA_y7VTrZw8o_xg&oe=69BD55B2"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
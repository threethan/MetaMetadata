eqd7q-JNHw3v4arUtUbV-osg7qpfLi9hg_BZinIImsiRvH1Dw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTqk7ktJFBksgSdl1KwBqYWl_9F0ZBelkgNZjcmHJzCA&oe=6AFB288F"}, {"file_name": "Screenshot (122).png", "id": "744625859827156", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77Ltq827B9MQ7kNvwG1mRn3&_nc_oc=AdpPGsnyGppqmoVzSsUngK9NLehljFVDpVj7jP_CqFTiFgtjosXGdUHjg_iWb4uBJbk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaTiGDKiGSIbBD5W2gPoMQUlAC82aR9UZhzLdb-reK9Q&oe=6AFB2944"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bIEXb-7uAgQ7kNvwH5Ls6R&_nc_oc=Adrb3ShZGJS9Iq3tthEKqQLwL7YbvrTqgDMP8oMBUGyZCO4-SAnE_WzkaZph-_5KJrQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU8Rcde73J9zc3PlWhRKiC6pOKRiAfZqKdgyuHjoIbcQ&oe=6AFB30DC"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oGMsjVoIYAQ7kNvwHoHAYq&_nc_oc=AdoEQuwnNzka_zilmBarYHCVjG96TSpX8x2lfTqDHILzNUDSYUF21qBZjoq4e9KFUwk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXhn2BzR7T6qGMMy8asOJu2c-E-MIMyEtl46DIzxRtbg&oe=6AFB2228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj2fxWPTVTsQ7kNvwGa4QcY&_nc_oc=AdreuZU7M5V-Y9zVSQWyWYw3OPgk4wHM9G5iBTR7D7iXHnSE8CosYl9y2xqiPeOPflA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Wv_rZxuZmvxxUqVp0LiAQREPzp-ONVAwFvJ3F5WXEA&oe=6AFB4772"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "intern
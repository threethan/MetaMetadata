_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_rFqY0tySYQ7kNvwH6EDUA&_nc_oc=Adk3f6jUqtAx1SuKYgy7dONydk5n3lDcS6vHwAr5NLLM-1-1208s57cReXTIrtF8e4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEWaEiHN2sCN-apD-U5yukAyftSFHsAbi1-itZDQ21VQ&oe=699D9384"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97QDX2CiENcQ7kNvwH6_cF4&_nc_oc=Adm8MrnzXTu-7cUau_OIUxTOwsEXNc3S0T6cAnZ4mDNlHA-wSglSrhV6XQBsnFhu1WA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqNwF7k1F5yd5yelRIPXRgSm0ySNtsAy_KV9Ell2Pw2Q&oe=699D9B1C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvAFa8Z8NEkQ7kNvwH0HS2e&_nc_oc=Adn2ds-btpYhAm64zh8j5YjRW1fJUTXCo8QLNx7jlMd4HwO7Nppr04b6uI7B3mpxG_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvHALe1l09JRq6UChumv_a_hKY9xG6FtfkP03kCBY8itg&oe=699D8C68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBzBedOWabUQ7kNvwH0cr-y&_nc_oc=Adn98pv31OYEEuATyFSLO_4WktPdBgQTJYa_vBdbJ3oEabsGLlAk7Wv1a08kr29ZTV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyKZhaLJlhMJbDZoCdySLv5FM-0VxkoHTH-fhiC30-mA&oe=699DB1B2"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7355842087854683"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_28880162649150
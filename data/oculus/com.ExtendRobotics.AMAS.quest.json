156", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGQxugpuDKgQ7kNvwERzfOa&_nc_oc=AdqCq55I90hXMH1fv044iWJOLyv9LldxHI9Q29G6WqUHrRU1ypZ6v7F-L0SklEIrC_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxcBNoaAhJrVIUz6tIR3n_M6T7dCErKq2omj5cw1qYug&oe=69CBB804"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jzlLQGgBwsQ7kNvwEk_xXC&_nc_oc=AdrxxRb7AXDbvKG7VxEzlIqvwYzzApJs2Tyj4RLqGRONnC8coTDkIghWZJEGfKrj80Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHoVJBMWnnVH85RLTToQ0j0f-OHAaQBMjD6zRoRvRZhg&oe=69CBBF9C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyPedzjgo6MQ7kNvwH9ePz0&_nc_oc=AdrlvzP_6XJrU7iLi35tw2bVLQQs8JRJgASuVYRak86mhTciXFLarq5SBXG83T9BHWM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzxgxbzzi2Ox1grzSEkMyBBqT3Sucj2_cYv71wKtJgq4A&oe=69CBB0E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS0cqx2K87AQ7kNvwE-ls6n&_nc_oc=Adr-iz7xLoZ3zQv2T_-QcnT99nYl1zsBblkX1ZdVIu_x7PZbNwFeH-cpgpedL34vukQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnvF0Mdy6ylwQE4BTDnaxWGGmlou3cnz5TjoEtZy8ijw&oe=69CBD632"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4IxG7HWqjwQ7kNvwGW_Spx&_nc_oc=AdnLx424KrECpbAlXf2EzhiOqvfu_3Sdhhc4OplX-tXzqWeWeBQQWB4NDdBo3CB-S9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRGwAGOFmMOu5WwwWZ33ybct7oNLJdTZtdhEhnqJWfKg&oe=69B2B31C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fappPuZTEC8Q7kNvwGbCGuM&_nc_oc=AdlV79_dYqonKAwaebIBn3XZozg3f1VaDPao2cKpYsUMrxsdEvL7edzP3Ya-qbw74Ok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfBiZD1u8sF0e6uPig4k0TC5frDfJ6WYoo0fLNVSiozA&oe=69B2A468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGHh5B2WY4gQ7kNvwEmKoAj&_nc_oc=AdkUmE_2kcjWH7nt_liLvnwwRY_d-P-JoHenv_FjGnsZ2JzA6Syo-oqh_zQbrNQYx_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkUqsqdBqlZFHGgAELCmn8Mk4tpiwEnGGPZFWuF2uLcw&oe=69B2C9B2"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
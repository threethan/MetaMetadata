8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IIVu966ALwQ7kNvwG8SAa2&_nc_oc=AdnoLRSx_Lx1VAjLkPAH1AyEBWrGOiZvHTx8YsNDPQ3sa6M36tIaekLnyvtd_9-7gBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyyciGu1Gk-q5BwspcvLj8ZZtTbsdDC0Kr06HGVhzIGw&oe=69B7F91C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8M87m1SBHwQ7kNvwGKPS59&_nc_oc=AdkcQUZNb_AeWIH_IMBZVZJveoI6w76jad1A_ISbPg2LGgZHtpA4wTkiPEHU1c3Z7DM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxiK0fOGt_qKLUnHyi-b_ptlyfO2CZV3rYIcRikksQK1Q&oe=69B7EA68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl_Z2wDBkIgQ7kNvwGo_R4p&_nc_oc=AdkuAz_XLCmHSUVgk4Z_-5hkLoZK1b9h-BY0_cxuIqz5qylTvfjcubsJkxZWLoX5p7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsMig8RWlgnJ2EHB5Rt4kMRJx36cqhzdeyPABKoUkIhw&oe=69B80FB2"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
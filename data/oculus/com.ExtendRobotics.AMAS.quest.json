156", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGIyVdKHZykQ7kNvwG2gwO-&_nc_oc=AdpkFJ2pgbv74_wRFTxC7-zQaJ9Szy1Eg8TVXfptGQYkrBjM3DtZyfnGdAHscy2vowc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dU7kYu5OGw12CjeJ6hERjVoPUP7Uyv7d1az1f9Rf8xQ&oe=6A09AE84"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aOspFI77OQQ7kNvwFehIJg&_nc_oc=Adq7F3MDZeXR9x7teYWVXYHRTb9PLSV8J8pv7EFslQ8wWSSz2CZEWEPz88Oi5l1fAhA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gTVk2H2jlqtDFVpntm6p6jr8wRnGlNkMrgxmGAycm7Q&oe=6A09B61C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S7NADmyPRMQ7kNvwFeNc_E&_nc_oc=AdpEhuh_ViYTBr9MY7DlalbVvKiqQ1YnCskh39-eNwrS3NZuieyJz3JUnvZxS_y5FX0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oRAb1s7NwmM0rmHe-ybPg-sOPFcS5ETxk7YKIx0vjPg&oe=6A09DFA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bCa_O9NZfcQ7kNvwEP1eLc&_nc_oc=Adqq6QPyIamo0EVzQaVdN_Alxh5ElI8Tb7gI4M6fP5tuCPmglqW6EzSnb-YwvxyGZUo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UHcYhv2BBPytG-STZfK0WFQoBJNC81OLYnD8J1xRJOQ&oe=6A09CCB2"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
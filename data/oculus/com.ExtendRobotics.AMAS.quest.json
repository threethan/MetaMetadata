9827156", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhJz5I_TJXkQ7kNvwGfqO0_&_nc_oc=Adpgs6Xeu54sv64BsDJT5qnKRN5XxD_8V-ojuznH86livWNOTBzrvaL2gKwfgr-llvU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAbqUsmLid-Z0d0ZrFaBYdPALA1UzCxl7UElBzvWi0Tw&oe=6AA93404"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTp-v1QDG5kQ7kNvwHovseq&_nc_oc=Ado149Jo3XAf9R__MyT9fpZTnKhbw-n236eJyHpdiyXFyORH9pOYXuhGKtiQN4j5sP8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_pOi2PyXNLEsJOVOntZ6xP_TTWMc2x0EYZNTayeC_Ag&oe=6AA93B9C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2unWr3qXKsQ7kNvwFfP-pV&_nc_oc=AdoNsCEA2g3fMIhE6iv7AGQnD7eddvAX8bHDO0fzFfzL9ad89fiChlSzuBFUwfGExeQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa511hfhUQllt7zOijN5hS6dlG3xoPTaDyCT6GmiSLkg&oe=6AA96528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IMFKDALDZYQ7kNvwG5ulbH&_nc_oc=AdrEOke5mwmcriQUY5xbGZfks_XjF48ullTJOGiNzaDtsIFvlI7AkIEhwasZxEGFmno&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj3RUl2SzZitM2AXOzwxS_kGAXRlR99ELtqhOMF3En7w&oe=6AA95232"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
156", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSQ-tMYuR7gQ7kNvwEZNltY&_nc_oc=AdrWf9WdcFLI_rizosgGCqNGeMJcZctaelsMIsyKLKBdnw8f9IeYOks4luw0J5gliQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ii_inlcX6Sysq2E9Gml0aU9Kf-56ZrPYTOnJPuja-YA&oe=6A3AAE44"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBsNkSDwekUQ7kNvwGPFKHy&_nc_oc=AdqKBmvwdhcr5RnIhyYfB_cg0vmq4vmOfVafvjdHdH5Ey-g7e1Ly16QO6FWcPmN-PjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aUJT8yiVDdapBl88Rr71L9c6TeYskRk6-fn0vS9tCIg&oe=6A3AB5DC"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ1-rfV1GUwQ7kNvwG2okvS&_nc_oc=AdoliKaDht_4MZez8ZC7HQf5g3fwTqNOYh6zG2cCF03HEfjs4j7nmuefSWVTVPvgUXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V9fW-xKPm4BN4O_hYGZ_rKIet_IkfGGN4iFQBA3hIMw&oe=6A3AA728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut76h3Hux4gQ7kNvwH97pzu&_nc_oc=Adr8pltjjdSKC8KzrDYVhu8nhx90JzbGHWxcXZXeS94NVua_Ki_WENcVGGeWK_K-_rE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jucGgDHEZKoYYHXjV6swg4qoWM4kasIcjQBbLdbSsTA&oe=6A3A9432"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
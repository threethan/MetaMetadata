8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtOuv0IB6hMQ7kNvwF-A4UZ&_nc_oc=AdmSrZ3TU30jcfKdTy7Y_RrtQKB8_Tf5BqoEp_gadzLEUA1jBHl9iOp0lmpVcS2YmF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvQ2Kx9od07oW7qJVMH89ftkW1LJaDVIJghkyqr6QiPag&oe=69A9789C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtFnon-RDN4Q7kNvwESpp35&_nc_oc=Adm2yJ0m7fgrffbDjvQnjV-8YXZLqizSWrGfw0xwDfN48d61Ouv06X4EQ8VxdNp61-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuj5WpYA0UQ2lUQg7eEfOUWJRAMIpFEBCyuoClHGD1VJQ&oe=69A969E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzdQw_5MmQ8Q7kNvwGTXhWq&_nc_oc=Adk-7Ml-4GebSGIrk1SHa3eZttR_XG3aJlR0ActiJHWR3cu5g33Y3rsba5JaJ_2lbB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwNubTQkMfHQ1Njwl6JQToEWHh2NXk-bEettYcg_Ebdg&oe=69A98F32"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
9WxHLdimgLxF6Ua6o2nTd2LIlo9Wt0Kw6tu-1ngrphrfg5IiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQLfNejaO740tN2zc3JfUh7CRJqqXPN8gnQSOzoA31Ww&oe=6B10408F"}, {"file_name": "Screenshot (122).png", "id": "744625859827156", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H8qInZv09gQ7kNvwEeNhpa&_nc_oc=AdrBFsZQVYc7JuWPE8JGIp0UFF_hh3MNAgUG64cW8r0L2AQggzbgOEYlO-M6XaSoU-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUK6FmNIdveBW8pDJkKipeTy-DMOjzWA_930p9Gvy_RyQ&oe=6B104144"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g95UH_S1DLcQ7kNvwGBXmu_&_nc_oc=AdphAdCAxfSU4lILtP8qmYakHvCkX8slRTa191s4itXOveimzuxZ2lDWHk7Z-AdVxuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW5XSypbYHZBKldI0qgIVvmBwsoqsFyHCQzkPiL2uRLQ&oe=6B1048DC"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTFMOkrTJfIQ7kNvwGjbAv0&_nc_oc=AdqBS_yvmW-sXf4UcYSBY3hr4ajduyNL9mUqE_e6V-FPl_GP3We8nlLNqzu1Cg8PJK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWiLAb3g5bRNyqUeOa16AbDMwreSyFioN6ukApWPGJqZQ&oe=6B103A28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPOey2fOxMoQ7kNvwH0r7yz&_nc_oc=AdrdDIp4wYNK819lBBU-cn91gVcGOObs2P-2VgC9Ii9aiRUkoo8_qb5WEEK69pRynzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-YzLgmWVdrX99rh8w-aKRZzX4tU7JtH5BONT9WawjBQ&oe=6B105F72"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "intern
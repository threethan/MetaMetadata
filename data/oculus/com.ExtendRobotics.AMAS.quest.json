156", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3ijAS_VkXkQ7kNvwGHsosx&_nc_oc=AdpJnNSmR99PB9_mB_TXKC_6vgRHcpqY1GFBkggUVbajjSRAAgNruTqkxKsNgwAy5dk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SFxSZNgVY_m3rnR_zQWAwi6wVB9NjAJOuql6M8pAMCg&oe=69E61604"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8ytZ_fYdekQ7kNvwEhU3XQ&_nc_oc=AdpV3LR1nzShz0wFUssBEA42cYfb39f0xaOEU-iduMyEyJ1sunJX75vRi8kcLP_AQrM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y9sd4qww5QwhCQS9wHGmMLsZPeGQ9mz47Km2w53FbzA&oe=69E61D9C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2baYN1pYPwQ7kNvwE7rfi8&_nc_oc=AdozRnsbZAD-TGIVxQyh0XY9ivNaEHqKp6GWhf4mbkiD1T1IRBl2KzNGzqF1mX70gAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h_QBrpYAnxWOp51kAykfvrAjtZmspFwhFi2G5nw091A&oe=69E60EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiGy6ohJzUcQ7kNvwHx9vOB&_nc_oc=AdoNxl5dpNMnqMcopdumej6vvs2eDFpkNqvCgfYPSzX4IWxSaUD8gaBpJkaq23lu6yA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GWHkTGH551r-lzNk89zGGd3oP_7yTxNyxMVcsB2xjFA&oe=69E63432"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
156", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974683_744625863160489_3999024988748835723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCjZyw9PuJ8Q7kNvwEiIlm1&_nc_oc=AdoNccsDD0CqYEOkKM400DZnJtN2iPuM-u-Tww7beYyeGxj2OjqD-JjPGMzqqDXwwtk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhlVn7y-f5-02xETPJ8GbIfSaxlom8WDYHrdd0xAlUrg&oe=6AE8B444"}, {"file_name": "Screenshot (123).png", "id": "441798080794085", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031313_441798084127418_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_DQpCVa1XAQ7kNvwHkNk-h&_nc_oc=AdrpgMHtim86EsIw0I75paE1d2cC9WmMEA174TfmkXFWCxwet1rYL5tFO4kV2WMi-JE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxAHIv2XM5_uT7C7CiwZHD6HjAvjtIsbTyCAimH_wb9w&oe=6AE8BBDC"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leibFWHUrrEQ7kNvwEsP5ev&_nc_oc=AdoKJAejxDo4Eiwk1tXta6w2bN-NtCOtjXQEYHhRTnJxUpuCUipX94ZFvN6YPU6aLak&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD_F3y4aEJ8hLUot2Npy-x2r7C83UY8_dZCk_Ro7R0UQ&oe=6AE8AD28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9Weh3_ryVMQ7kNvwGsJl8D&_nc_oc=AdpVAom4RzhuGkLN89oKP0HHFRCP6T1O1I1dz5zFU_LmZelkrE2624HSGr9-7lIKH7U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQXfPHgb5VesOYx27q24Z0EC5viXoz8yRXxidVfCf8Gw&oe=6AE89A32"}, "display_name": "AMAS AppLab", "keywords": [], "long_description": "Imagine if you could use your own hands to control a robotic arm on the other side of the world. Imagine with the right robotic arm if you could lift up an object larger than a car, or smaller than the tiniest grain of sand, without being physically present.\n\nWelcome to AMAS, the Advanced Mechanics Assistance System. AMAS lets you physically control robotics arms remotely over the internet, using intuitive gestures in an immersive 3D environment.\n\nThe application begins with a tutorial where you learn to control a simulated robotic arm; and record and replay your movements of the robot. When you\u2019ve mastered the simulation, you can then graduate to controlling real robots anywhere in the world.\n\nIf you have a robotic arm that you\u2019d like to connect with, please get in touch with Extend Robotics at (http://www.extendrobotics.com/). (please note that you will need to buy some extra hardware and software to enable tele-control). Extend Robotics are always on hand to offer expert advice.", "short_description": "This is not a game.\n \nApplication for physical robot control using VR with 3D camera input.\n \nExperience above in simulation without hardware components.\n \nFor hardware integration contact Extend Robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extendrobotics.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Extend Robotics", "support_website_url": null, "website_url": "http://www.extendrobotics.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3iJW2-X300Q7kNvwFZfXL4&_nc_oc=AdnIp32go-jyz3PlIAO10cq-rzGXjJOn49_-wMdUHhQaEKt6bB7HrHsIGSxZHOlK5wk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2kVXvIJHunfGMCRp_Px4WmbdN2JUZwjCLQdD1leCWmA&oe=69AD6D1C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RelYlchWa4Q7kNvwEiegSK&_nc_oc=Adlu4EaTBKykzex7bzQszJLLek7wHpKyhxSK3h_rv-NcGONKJZ_f5lchT-pRI0xqvPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYviQA7KlHucHJlAxI7WOXbnVPQV4wS0_Ztz5ERY_2ZQ&oe=69AD5E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Sk1BL7rbRMQ7kNvwGF3t27&_nc_oc=AdlhNyJWt7Yri2Dc_WBJu461k3zuGnxvnzqJ3mDckwHtU-YqMnopZkmLsuyeCo5RB3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxafdHxFZ6S400Xof4BFLF5Gso05EX6khvOKBCUw_TBkg&oe=69AD83B2"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
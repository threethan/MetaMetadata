8_6466023488837283457_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8xo6miReqUQ7kNvwEqXniK&_nc_oc=Adl0dLPLKWwH9AXhHWrGDW3Cyy6tWoGlm4iNXAtX1uYCQazqPHA7yzirDJVSzxDMEb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7Ps14sHRBTsJUybAvtEdKJ326wbvoG_oHGbgCWKKv8Q&oe=69BE909C"}, {"file_name": "Screenshot (125).png", "id": "1077642882808314", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982535_1077642886141647_3996924414895117640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz3x6ItLpssQ7kNvwFPkECB&_nc_oc=AdlNmzIN0uJOkpgaSiZK3R5yREdGLKOV5mI19pnMbdVfm_EGMKliHPt2_zhI244pN4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC1Fm3Y9AK6QCquA0Csv03nbXhuS8ZdMWDQWN8U_VaUw&oe=69BE81E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1789612074582758", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031316_1789612077916091_4846501484232258193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acF8G2b6GfoQ7kNvwHMa6B6&_nc_oc=AdlUv39NbcDYMq7fRI51Mi_lbps1CHVOuRlMrwm-VYLHOvzDV0CuU2KOfqdt2IRCbO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbJEk1eOWpNOGlat0cTXREgy_NzW6NTvNsX582GZxiQA&oe=69BEA732"}, "display_name": "AMAS", "keywords": [], "long_description": "AMAS - Advanced Mechanics Assistance System.\n\nPhysical robot control with intuitive gesture input and immersive 3D perception.\n \nThe application starts in tutorial where you may:\n- experience robotic arm control in simulation\n- record and replay the motion of the digital arm and the interactions\n- connect to physical robots (hardware required)\n- connect to 3D sensors (hardware required)\n \nThe tutorial demoes the principles behind VR control of robotic arm:\n- grasp the end effector of simulated arm\n- move your hand around to move the simulated arm\n- control robotic gripper with Oculus controller\n- interact with simulated objects\n \nFor hardware integration contact Extend Robotics.", "short_descrip
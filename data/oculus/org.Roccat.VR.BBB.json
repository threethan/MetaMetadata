ibIqFOIQ&oe=69B4046C"}, {"file_name": "migrated_image.png", "id": "207493767165093", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974831_1135477419935879_3642863854557331456_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se3M1vSLl9MQ7kNvwFtMJsT&_nc_oc=AdnTLLO6m3XyvYa2FdTs6FWfJI7nRg5ixG9GqyXpTQ6XldliLvSlAYo-rW2iR6EvSeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoJSOEOogUE07we-Hp4pRuKGItN8QVfgSzjWSloue7Bw&oe=69B3ECC9"}, {"file_name": "migrated_image.png", "id": "156105205554484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982474_542544866183780_610219624746713088_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLZsQxcjVJEQ7kNvwE-m1fn&_nc_oc=AdnPZalGevrvOSGjK6QV1jCOX-cF-_hTBWcLgkn8TScB_IQA2ttpjLSHuvKy4JxAMZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoXCBhZSmwN0ChHKHWVq4sK0IMcn62KKWYtXjTnbPr2A&oe=69B3FF53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/CIeZBt", "id": "460476651467533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031364_460476654800866_5928229825503297536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKFsrTxGCioQ7kNvwHM-Rqy&_nc_oc=AdlahbK0qFiR4AIfm0WF_gqAJMP6dRgjxy2zPf0xzaKKH_TMDKeslL-7PrDdQxE6Tec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwzm1dWm_0E5-Jrld6lJX886hNOtTJ6UlL4BmriicanIQ&oe=69B3F9D4"}, "display_name": "Bat Batty Bats", "keywords": ["Bat", "Arcade", "Highscore", "Sports", "Pinball"], "long_description": "Be the Best and Beat those Bad Batty Bats Back! In this wacky Arcade Style Pinball-Breakout-Bat-Batting mashup!\n\nNow it's own title from the Bonkers Babes that Bought you Elevator... to the Moon! Bonus!\n\n\u2022Beat, Block and Bounce Bats into Bats and Bumpers for Bucket loads of Bonus-points! \n\u2022Bunches of Beautiful Buffs from Boomerang Bats to Bowling Balls!\n\u2022Bonanza events on a Big Ben with British Bulldogs to Bad-Ass Bazooka Babies!\n\u2022Bat Beating device unlocks! Be Belligerent in Endless Mode and uncover new Weapons!\n\u2022Be aware of the Bizarre Boss Bat to Beat at the end of the Campaign mode!\n\u2022Be Brash, Barge your way to the top of the Boards!\n\u2022Boatloads of content, you won't Believe it's only a couple of Bucks!\n\nBut Beware, of your Beloved Belongings behind you, isn\u2019t Bitten By a Bunch of Bad Batty Bats or it\u2019s Bedtime!", "short_description": "Be the Best and Beat those Bad Batty Bats Back! In this wacky Arcade Style Pinball-Breakout-Bat-Batting mashup!"}]}, "developer_name": "ROCCAT Games Studio", "developer_privacy_policy_url": "http://www.elevator-tothemoon.com/en/PrivacyPolicy/", "developer_terms_of_service_url": "http://www.elevator-tothemoon.com/en/TermsOfServices/", "publisher_name": "ROCCAT Games Studio", "support_website_url": null, "website_url": "http://www.elevator-tothemoon.com/en/Home/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "966668817577257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982505_1619492498196984_8762059860268285952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxn9bN8_fPUQ7kNvwHwMkgL&_nc_oc=AdlhesSD2-nzJV4Sd6nFPSFjju8pYAbaeJ7IKZCmMeQst53xQfifT9Aju9HoZin9tg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2rOa8XS-wE7BmqA1X8SsCahBT1UAqM22oVTV45PCl6w&oe=69B416F8"}, "is_concept": false, "is_test": false, "is_trial
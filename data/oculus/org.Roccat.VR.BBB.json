f5_DoUTw&oe=69AEBE6C"}, {"file_name": "migrated_image.png", "id": "207493767165093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974831_1135477419935879_3642863854557331456_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1v-GIpc7PYkQ7kNvwEq_6S_&_nc_oc=AdlOAAGObr19mWHzbgjO2qj0Ii7WtwHigr6BtuNFXOodmY_6YynFYXZ2pKLRMpr6j2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSmxP2PdGJTkjqQbLZHS--L1LjidiZeQFrXzdBJlZqig&oe=69AEA6C9"}, {"file_name": "migrated_image.png", "id": "156105205554484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982474_542544866183780_610219624746713088_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfjz1Rc8DWcQ7kNvwFdDedv&_nc_oc=AdkojNykmAowGelraAR3WrO6OSwwPsSwsQmVEXecfQh5zko8EJT2GWb4FnaNQM7Yiy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHDhB8BtZTLjwcf2-80VlbQkV6tPZ8Kb5TefypRlSJ8g&oe=69AEB953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/CIeZBt", "id": "460476651467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031364_460476654800866_5928229825503297536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOV3fNSLPikQ7kNvwHlan4w&_nc_oc=Adm0n_c5uDJH9TkFYyr4pMwoRJGhZ_7yMy2R42BK9-H4_wzgzRkL4sM8E90bzJmq7kQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl5E3TinIr-vEbbfmkgLSY_FoYNyv2dDa3jlCvjc8NdQ&oe=69AEB3D4"}, "display_name": "Bat Batty Bats", "keywords": ["Bat", "Arcade", "Highscore", "Sports", "Pinball"], "long_description": "Be the Best and Beat those Bad Batty Bats Back! In this wacky Arcade Style Pinball-Breakout-Bat-Batting mashup!\n\nNow it's own title from the Bonkers Babes that Bought you Elevator... to the Moon! Bonus!\n\n\u2022Beat, Block and Bounce Bats into Bats and Bumpers for Bucket loads of Bonus-points! \n\u2022Bunches of Beautiful Buffs from Boomerang Bats to Bowling Balls!\n\u2022Bonanza events on a Big Ben with British Bulldogs to Bad-Ass Bazooka Babies!\n\u2022Bat Beating device unlocks! Be Belligerent in Endless Mode and uncover new Weapons!\n\u2022Be aware of the Bizarre Boss Bat to Beat at the end of the Campaign mode!\n\u2022Be Brash, Barge your way to the top of the Boards!\n\u2022Boatloads of content, you won't Believe it's only a couple of Bucks!\n\nBut Beware, of your Beloved Belongings behind you, isn\u2019t Bitten By a Bunch of Bad Batty Bats or it\u2019s Bedtime!", "short_description": "Be the Best and Beat those Bad Batty Bats Back! In this wacky Arcade Style Pinball-Breakout-Bat-Batting mashup!"}]}, "developer_name": "ROCCAT Games Studio", "developer_privacy_policy_url": "http://www.elevator-tothemoon.com/en/PrivacyPolicy/", "developer_terms_of_service_url": "http://www.elevator-tothemoon.com/en/TermsOfServices/", "publisher_name": "ROCCAT Games Studio", "support_website_url": null, "website_url": "http://www.elevator-tothemoon.com/en/Home/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "966668817577257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982505_1619492498196984_8762059860268285952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek8iUCBU_DwQ7kNvwETzHtD&_nc_oc=AdnYqsmSSj8fUXvdPvZHlE87vISJuDNnzLHCcwwtNHVElSwuLOHs9vWudMi1a6zym38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9MzRy959E228RebGVDWttWSho38yZ9uHPgSmzTPkA7g&oe=69AED0F8"}, "is_concept": false, "is_test": false, "is_trial
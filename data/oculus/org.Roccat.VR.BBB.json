gn mode!\n\u2022Be Brash, Barge your way to the top of the Boards!\n\u2022Boatloads of content, you won't Believe it's only a couple of Bucks!\n\nBut Beware, of your Beloved Belongings behind you, isn\u2019t Bitten By a Bunch of Bad Batty Bats or it\u2019s Bedtime!", "short_description": "Be the Best and Beat those Bad Batty Bats Back! In this wacky Arcade Style Pinball-Breakout-Bat-Batting mashup!"}]}, "developer_name": "ROCCAT Games Studio", "developer_privacy_policy_url": "http://www.elevator-tothemoon.com/en/PrivacyPolicy/", "developer_terms_of_service_url": "http://www.elevator-tothemoon.com/en/TermsOfServices/", "publisher_name": "ROCCAT Games Studio", "support_website_url": null, "website_url": "http://www.elevator-tothemoon.com/en/Home/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "966668817577257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982505_1619492498196984_8762059860268285952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A34btS1TB8Q7kNvwEFAgm5&_nc_oc=AdmpmGxXBNQc9cHImmWHqUkYFAIf3W2g7_M2hhHNYcWJJSbcOX4xp0wHRcbXa2K-iek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNtAdrkNJn6jxhW3EM2cxO7F4wRNO4ZKgqN1VuKytHHw&oe=699EFEF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bat Batty Bats", "platform": "ANDROID", "context_category": null, "context_topics": [],
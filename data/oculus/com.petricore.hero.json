&_nc_oc=AdpFCV029fRbC6QtdVuD1sz5TtM2CWCqDD4YflizaCdQCMydEWfVYPZ6j11oN3bzSpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eXeuXxQXKRS2S5lMNBLbyOgA0lKv4VzpbCDxgZMmyzw&oe=69E4DA38"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIKjwSRE8TYQ7kNvwFTfGdL&_nc_oc=AdrbmnO-5NpjgNsWbwpR7XtAB1_UhF9xe2_BdHpIpkYjm9QCSZi6L8Ue0Xop92GW5GM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bJ_6pK7Cf5-BTAga18T1BFxT-bU41KvdM90-zKflGzw&oe=69E4C0DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSoI6I13YxcQ7kNvwG9mpBe&_nc_oc=Adpz6cBOTEwcLuwiepzWEpBbF0LgX3lb7McwuRg_daQBok4NVCaO3CKzu-zpLjDXi04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dFo7pF1C6eXbn_TOu8wPfZsh4wD2fXBUaXZSXizUhGw&oe=69E4BF27"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigne
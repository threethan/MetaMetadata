64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v99IYhtPvkQ7kNvwEteuuU&_nc_oc=AdqBRW2k03J2HHNNZAOk1x19bm4ntqYSlxgYWKG_-KcOGF9PCAHWdQt4CUl1SXmQPNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANBNMgpk8nQAJepJhiLjrC2YDrliRisZ79b3RKOIJ6ZQ&oe=6A6A08D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqRYmC11RJwQ7kNvwFieBMc&_nc_oc=Adp9AyWOmGOaVxiDaCSSz4O5Yse31U9AirqqMyGVuzW3LQIWAJtDujROjZZPlFcHNkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdXrHyFnTY9hm0Jpz3h3colGBZlhZBnpd1vnB5d0bRKQ&oe=6A6A0BDF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXx9VuuRkUUQ7kNvwHX3KKb&_nc_oc=Adqe7kSRL04WyGmZSJt5fhDLvZXPDghIX_WLwAORxLM6bL6PtarTzlWH_Kj1N2g7lmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_hu-rXCkk9bfRTXeG8hDKYYBeSvsqyt4iPZAZI8hmig&oe=6A69DEE6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQp-0tcdtd8Q7kNvwHBnrd-&_nc_oc=AdorQCQ0LCiAww77bqeUk0ER0bVFpVUHvZ3o4V1prGpg795MznD8mlunbi_r5GkC8FY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWj38zeAKj_FeZHCanMrbrI7Qd2_TvtT8Lx4gtdBICJg&oe=6A69F829"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpgdbXHgCrwQ7kNvwEl2Q46&_nc_oc=AdpNe_DClgdQJj1I9piW_YFk1_t43zCV3WEbYDD_rdG5-jzQ7VySeB1m-xOhBgiASU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfeLbEDnKEQmVYyop-Al2IQsnhLJop3qrvuEcRzvI7cQ&oe=6A6A01B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLK1AwDHr_oQ7kNvwETN1QQ&_nc_oc=Adppf_ovKGNJzW75juVlPj0ZKad1io6VUNqryUHxYLHd9FEKWhronm5J6GsSwGRgMxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFOFmEzLlifaV2wq4EueKmGJ_drWatfk9uXPK5ej2TDg&oe=6A69E85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw8E_LBdGJoQ7kNvwF4xe4c&_nc_oc=AdohhW9zf0nj2XRrWLr4ux5vH7LSEqFAOjbfMFNyxYbVn0ZiWkr3GWdjiy0gBTakiMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT5tyxGCsB5jpFKjtY5PhfhzSMBiJzOgvVBRjrGTx7Tw&oe=6A69E6A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
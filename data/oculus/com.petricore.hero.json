64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZU6ItjIBQQ7kNvwH49qk_&_nc_oc=AdpV0fOYxJmGYN9rTR0G9lXaXv5BZG0xCaxCyEi1cAm8HhiiqUCGWSsKFKoh6IZFyiA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvdttFMOcngmiT_N7PkdcVE6zy-rJviMEMBmYl6GL9UA&oe=6A539F54"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO7kKDG79v4Q7kNvwG_NNNy&_nc_oc=Adphv3DWcmXKJvIDdw4vTB7OPWq7G59e3r__xAGQO2ynlKSYdvTKfvprrp19XyV_tiQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1MeecmoD5hfa697mhKCOxaSU60_7epNeu5dUl-AxduQ&oe=6A53A25F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG1XALbiVa0Q7kNvwFvqlYw&_nc_oc=AdqOzSG8Lmkks0ob1tGSVQR7BRvqVLx2CLgKTwegLKZpStHd3qyNpxe6Ag5cLblP_c4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzvT_bLX8Q5wYdZKjcdJq6ekm8Y80hwMugS5THLQWBmA&oe=6A53ADA6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-dGKZS1UA0Q7kNvwFZ7jYP&_nc_oc=AdrL63tgtOs70Iu6Im8R8O-WXnVMxSnj2KK8UPOELrWBSUZQIfsWqK9YH0t6S4PRL8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3YfazWMkW4JT1tAT0G0vmfLzltDtqEtMQofx8NPco8Q&oe=6A538EA9"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJR_box1NdMQ7kNvwHBh5jH&_nc_oc=AdoApP2rWMAEPkuXmb7WqMxY6HVsD7fdGkX75RZp1xYGN-EM1U84VF0YZzO-idAEshg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvziDte40FLR3pglwgXLklsUp8PFVJ21IWtjcPUqaBrQ&oe=6A539838"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb8yI-OX1X8Q7kNvwG3DY_J&_nc_oc=AdruYxFErJbquQMFDalpa1_Fbj6tq_EK209N671FiO8tf55yohjMjs2W_19Kd1K_8yU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_7ZJ6qY8U66BrZqkAsBStE0PsDj3YrfSjccRo7NuTew&oe=6A537EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF8drzYbYH4Q7kNvwG2xN6M&_nc_oc=Adpx1cOTFxy04ypwST-G6CilLSZm8dhD6CWeb2s_dBRv87ZmyRBpUXCxnqlgI5C919I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbasZ9Ae2SHeOrjjFi9Cx5cW1BMO6-E63hFDhyPNKmEA&oe=6A537D27"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
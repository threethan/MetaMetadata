64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yTGP2kKvQAQ7kNvwGP_UBZ&_nc_oc=Adrr5tlb8buxMyO8lE4dCmUvBUIiJCpRkJf8R6iWBV8i4ktb3Xpcv8I9FbygckN3VCw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHRWALZgu6UrdHbp3buTWRJdRPEkm3ZAp6Y5zZ_y1nmQ&oe=6A58E554"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2xk6wSLM4YQ7kNvwHwTIVl&_nc_oc=Adry-hUEas155uUiDkWsAZGqgTWgJS-VcTXt1UovlPu1rYRVton2960rHm4keDiM6TY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5PwE-g576WNxxB_QTO1QWSlA2q_rxib7fE-Qn4sLFag&oe=6A58E85F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6-GjFOiw4Q7kNvwFsFqBK&_nc_oc=AdoK4CJhY74f20Doh1ibxq-e4hPrcti84Q21N6WgVvQvwTJ9cGQ2wtE9F85r2xJ6k0Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP53PZhEGZXpNqymaTmZYNNs-AYDVKbOG1YqIYlNA0pQ&oe=6A58F3A6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh-72mgVFKAQ7kNvwGseEeL&_nc_oc=AdpnJ99nnhFRTZ02XFMOHLXa8g0RdVj38kQVyJE8JU5KVC2hS0ZJ9flmrSaNtpBdcpE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ1VDZe7paZzcfosmu4KKHfP-9AGpeEK1HBNbvs_zBcQ&oe=6A58D4A9"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7Efr1C_cRYQ7kNvwHWrnVV&_nc_oc=Ado9WDz0UW6MizvcDZTzUt413y4CxaGXCe9GOZC4uoAJpl7q9Fyodcub9zLHwPlY-Ic&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACA2YrKbT6yL6BZYgTN2sZeacb96uQZpK5AEEKRa-p_Q&oe=6A58DE38"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGQhDy2KDocQ7kNvwG2t6ct&_nc_oc=Adq247pIUqvyYTW1u-lHr3vUy2v2Dvv-Vs4Ba9aSR-EjBrfsRGaq9oxTk50H-pLE18Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlaDTqzA4rm99wgyecgq-p1_f9oycpLsNeGNDicarCGQ&oe=6A58C4DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8RdU4tpDWsQ7kNvwEkg2Sf&_nc_oc=Adqe8d3-qaqZQ8aLtW39OWhoC-0BXFzUm7ASxlW37nnLkJJpThJN9yQxePk6qFhjf8o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQAKbAXodF_gJnO0t3Ne8e-eo8BhN4n41HVx6MKCPdYw&oe=6A58C327"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLnYWjapEroQ7kNvwG3YfM9&_nc_oc=Adr8NBm-Om-luyR35t_WYVu0iCRB__xibBkc3rCYlzltViYRFqDw01ZO5pjTJWtcTUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJf26HFad33HyFBvSF24g6m_Kbs4RWeW1AWR-rA4N47Q&oe=6A7B2C54"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BgOYJxry6gQ7kNvwG5j4x7&_nc_oc=AdoP0XxqenUe4qbkzCdmwxjoL4ndP5EE4lyHhs-povXCc2St1MyevnNOQMkNH7yQYyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqdlljAYAZ2a88FiGXjCAXWMppzQ8di416LBsi5YpdYQ&oe=6A7B2F5F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckfQEj30LdIQ7kNvwGVEcFF&_nc_oc=Adr9CGkcytIsDMZWdStIJnRPcQPy9py1FXLxXEm0bhMDOP2cbqpkjLUcLCF3BEel0yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEOrJwU02mUb4ag-942pXMM7kibxrJVywlT5lnlSZSDw&oe=6A7B0266"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-secPE2F8Q7kNvwFOvdSD&_nc_oc=AdqXJsMyChVUJl5VSKQF_OpMrZGE00zB6UdXHree4PZ6FMfQGBYBedhWjddtEIHOWHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNiqdpDR6fvz9DRHCHn-Uvbpnq5VEXtepn0CeVoaxHlQ&oe=6A7B1BA9"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOKZq3J8eNAQ7kNvwGFOi_j&_nc_oc=Adr9QmT_pkVTlBUe4LqC_gLo3caM25-sSEZ166m2sqYsOfAWcaNAdXu-cYTiba8An6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQn9Xk5nV38VrjY6kALtRmHeLLEV7iIaOBYxSnaw-QEg&oe=6A7B2538"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tREuOxOvRlAQ7kNvwHmVjmZ&_nc_oc=Adr9DCRmgY7YH2J934x817sGuyRSvd5Y1tBjAQgcnz7Qh90Oollchng3KRSw4fi4lsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4BDxpPLlp1W443hWEPr8tWkhdKp6yO3S6nNXFMtHfSw&oe=6A7B0BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cYUJMBx4vwQ7kNvwHjihOV&_nc_oc=AdpVCzMdpSyfj4j3DGKI8ahOF0vsTlv1QnQlxD1iDeBomFjSpDDBb_gLIhJka10Jk6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqUlpt-2mkaOTrDDQ8aQiNNsBFBOGgtcesQ0s1L3GpSw&oe=6A7B0A27"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
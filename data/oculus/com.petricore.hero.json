05354"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjMqgmPRXPQQ7kNvwGFk75k&_nc_oc=AdmMYhmM7AW_VxoFDD8h1JRIlpZZK6h9VqtUj2045kOL7uUayald5q29lFYYsANt4Yg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvW7QUk0iey_nvtCy9KjxZbGjHUbYT7sMN62VSxyqum0Q&oe=69A0565F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL-Ccj4Zbt8Q7kNvwFkw-9v&_nc_oc=AdkNgoTUT8KZDh9nfyMQMns1kRYacu90wYr_uoJdUIVckhKXk-cBA6Lvqpw__qNXYuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9zy5I4PPIX2xazT4nIKzM8qzV5dcRovv3b6hsrjZWnQ&oe=69A02966"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlF7dVXyDDYQ7kNvwHuPHV0&_nc_oc=AdlfoZ2qCechh-AVwL9K1WuvO_zOXqm-RLv-93vC929M93ICEsDHnRoT7YPhk60oVb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-OBcNJppRrlR0WHC_coGfRRF8ig8uw-ONJRdGEO1SgQ&oe=69A042A9"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc42vj_bqjYQ7kNvwHnCsva&_nc_oc=Adky_dKzhRCGqHEVg0o2C78zpFJIYCi910GQTbbrMVxrev6Ook3OMwtWlfKXB7j6Xsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs17xg-ic4gzNUuo9BvS1OGcl2FFvQTRhUooT203BTj9A&oe=69A04C38"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLh4dytkqZsQ7kNvwHPOPR6&_nc_oc=AdlPCZcKs9oqae_O0CkcQ2usiA86ilhRUXuJDvSg16nBymmJ3wofxtEVe6s0vz8-hQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuG6rFIc4EYhUcqUTqKmMnomBpci7Jw2txY5H1Rqubo5A&oe=69A032DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4c-_WmmKRQQ7kNvwG4BfyF&_nc_oc=AdlcvAlkBq7ORs95S2wzleumDdX0YMldfmXFCW6WFUH71iDb76gwp6dysg5dsIn3woE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsckugHqEr4-h29OqoSA7X84X5AKNXUXGX_U3oaSOrvMw&oe=69A03127"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg4FTKvdVL4Q7kNvwEaLhfP&_nc_oc=AdkWRVP-ekwpNAD1FZDUxR8dKoGTYUVwxU2oHixlLIVdrY7LYtT8R-8lgaLiwCAy9HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQtyf_NeJMzQK_yAvZW3FHoKiqC9xPxvkSn_tGTb75lw&oe=69A053B6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Bootcamp", "pla
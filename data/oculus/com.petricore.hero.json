64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqkwkf_dqtIQ7kNvwHkzxkj&_nc_oc=AdoCNh2svLCrE4GMcOIYwascerE8UodPq3DFttt367fvuKMgZxjAkJ2fQmX_MJu2tRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf8ryoUSQeDmCoUOhiylGKiKhGZkvchGDWrMvCPrAwGw&oe=6A5CD9D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhAmJ5_3jhkQ7kNvwHRCS-y&_nc_oc=AdoBFcj7NL9UDiqv4ptMlCD7E08J1FOzIBfAM0qcYwiNAGbIDw65Tp5AZEALGMcC4aI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvdVJ2rQ1t-NZnwiCs8Bh8_Su7k2uaKj8H97zODn0O6g&oe=6A5CDCDF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqHY04cdnj8Q7kNvwELAHH5&_nc_oc=Adr05bFJOK3Ys0dDJ35E2uPtZiKa1ImFDZLw88G2nu938Adz2F9skXw1lsB49I3fkOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Wl6_bD-4LinwjoQuVYfAgBsEqXM7XJNVSLt4wwR_RQ&oe=6A5CAFE6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZHj-IdkEQkQ7kNvwFoUL4S&_nc_oc=AdpRXwddqp42k12ab9jWq6VQ_LoBIqzxlIdXtTd2b8D67fDMPV3yBh8vjyVJ9Kr1Mn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6xmaM0Zm1x4vq-z_eWFPgyWbxNfEIJ8yNzAPvf5BF6g&oe=6A5CC929"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wzv9bL4qCsQ7kNvwEJW8ZU&_nc_oc=Adr_UhqE9R_RW1Mmcd1V1wxTP1fMcqnX33qY6IjdOw9QT0tZtY48tqF5EBbsAXMn6xo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ7yghMZTRrhAuHtC7h30YoEN0paPrCf7pV6AyeGjGrA&oe=6A5CD2B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3nvQpeRXygQ7kNvwGnsW4-&_nc_oc=AdoBxpsCufq4yYQ3V_AreTGruzIgVthQmRseb4vxW-jkMwyNF_bwJODzqkhkh0HySEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp1FSXwFDOhclBSNEAsZxRb2OukpenMTytZd0IJjzcKA&oe=6A5CB95E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT1jF2qbguEQ7kNvwGpediB&_nc_oc=Adqjszz7t7AMNpzFaZxnjbVnPt4d4PvhJmV25WC1bLF2MmlX8XhHmxC4zJaidf0HmsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUTgkAPufxYjV6NOMK43rkmPwIAT5fdsr1VQ7daWIN7Q&oe=6A5CB7A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoYTyzn6g_wQ7kNvwFtqVMK&_nc_oc=AdrVNrcbHQLzSzC9biRmdLChlu0y3SunhK_Z8f3zbJaqSysZzqgLGjJiJ9um097wyYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPO-8ionYscicRCiJUqK-YVbxS7AJsmaoHT5G_J0iWCg&oe=6A95C294"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-EgMotI5XgQ7kNvwFdQq_U&_nc_oc=Ado4cmDqzgXQri1-DUsWvg_u0Ow6iwiSxKaTTWMPHp83FIy-r43YggpC2rlRsxyHYeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHkzFpEFNi3rHWJ7lBzPPr4YsmzwvfCNc7H7i13AZc7A&oe=6A95C59F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBQrnVo1Vo4Q7kNvwFI3sQL&_nc_oc=AdrTlHRS-ve9unFRBLZt9OoXZpnzVNwb-IxaMv0Yd-7h3pPljQwYaL-IYNZL87y6rtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEj01YU1wVyvVVS2QTkXXVrPFePPbDCGYVPFL7KmeVJA&oe=6A95D0E6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NATCmC7YtxUQ7kNvwEG6pYZ&_nc_oc=AdpALxiFtEAV8fWIgRLVdA6K0zir4HBFFwUYovXLDVI2JwVmSW39XJs2R7a5kkUxXFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN2aGU_ZoFi-hNZmySeU11N8jQ2wfeGWjICkIfu3jtRQ&oe=6A95B1E9"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bUWzYtmo_oQ7kNvwGrw0rr&_nc_oc=Adp-6d7nOuFdQgKR8wffSwSTEFH1Y3GClF9QUHO6lsg4_D3OUpTsMUj_3VEsGhm1dvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3KpXflDNVv7m7Ej7y6nOn8Pj33OYtenASGmEDPnNEjw&oe=6A95BB78"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZwVqOkOflUQ7kNvwEWD89L&_nc_oc=AdrIV2loLPxHYIcrHE3zGV1RsmGMKZa9r3Ei0qIF8wbCniIZn5Tqs2OzsP7SBNGi-FQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQbzu04P1CCtvQAhThCFJXlQMdPFzMeinE1IJP5n8RwA&oe=6A95DA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08AWsVhhrHkQ7kNvwGZiR6Q&_nc_oc=AdokvZxlb14gTjvvamicU8VXJ3zyUlNpr9oAcNzn0xHozQ1dInAqZt6KGTwRTd6lI5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8xNWiZGbeixN7miymbN-aBXngzfG8DPr5-J-GHnwuAA&oe=6A95D8A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
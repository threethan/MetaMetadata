64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqkwkf_dqtIQ7kNvwHgRfku&_nc_oc=AdrKGJF8GDZE4AXInlD08vxfzrGn3Uzja0A3lO7R-8y5svSSXIvsISDEqqH1s-ep9_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhAILIc0eDo17BX6hI0ZCSQB7n-RnmP_5cedimM9DFNQ&oe=6A5A36D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhAmJ5_3jhkQ7kNvwETVTnR&_nc_oc=AdrPSLOfE7B64s9kulRwRDLQ8zrquSfdOpaDBObzByPeWkXyL_Lxr3XlfHNIye9xomU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxuri2KmfV2s3JBTqO6jti-vwkSlrpuv10Pj6JJnqSBw&oe=6A5A39DF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqHY04cdnj8Q7kNvwHdVM_c&_nc_oc=AdpdJo-sMdruZXqCVmW4ftNieQXb5K9GZQoyubqyuQO0BeD_bOHfyPA2unqmICo_Voo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD23uti0W8-ngW_j3lInv4pjknKxUXVurYMYd_qRdGacQ&oe=6A5A4526"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh-72mgVFKAQ7kNvwEDZrVk&_nc_oc=AdrMQI8ekcBs-q0nS9pK50cS-Kn98hrAO2r4qiouPol7Dj5-jBDIX0oWXhf52yWETzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAajdZFaQ1yVGNKXh6Vxci8bml5-ov5aBwq84btJDAuog&oe=6A5A2629"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wzv9bL4qCsQ7kNvwG66DSE&_nc_oc=AdpjwhsinImw_1lhctgPYeIJqMWAaTYZ1dOu4DY74QE3S87DaPI0CBhZNHvaSVtyGzQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGw7qA4kpJYePwPlIcRPZiSJ_5swY4xatuFUZnvyfUmQ&oe=6A5A2FB8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3nvQpeRXygQ7kNvwFBo87V&_nc_oc=AdoYH1wvaar9oZt1yGl8732fNa1QW4O0C4QGuclfvxLjjuHej2ukItNTvjGbErkt_-M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW49Yp_5X0XzrcHtuj6KTURmWf5uHIahhhGlY52tPjYA&oe=6A5A165E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT1jF2qbguEQ7kNvwGrSNIn&_nc_oc=Adq06kqjizHiGEkI7vYwOH8Fh9LaqdWAZiHry4j5I0WpKbdrLvtRD5PjE6q6D5o6MdA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrMojyfuqMo1PE7nuHmtxQz-ZSrwV9h-OIq2f1p3OXFA&oe=6A5A14A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
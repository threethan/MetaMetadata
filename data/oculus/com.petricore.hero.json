1A4D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjMqgmPRXPQQ7kNvwFZ-MRg&_nc_oc=Adl-YQ-_pBk7J73IqJ4jBSXpMt5ssg8_rOR_yU6uwpcPyJ3Ie6EYkrdg13oRkYgqg_g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuGX2rgVxBJESHzLxpcLklLfttwcJN68n09zufDmG56Eg&oe=69A1A7DF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL-Ccj4Zbt8Q7kNvwEfe_-f&_nc_oc=AdmvePOXMLGmyFH1tb0qIlYi-McdDJ1cHJLXqsqDXC3qqbooSLbgx5_g2jaC8kmDndI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvwubtrARxYUKiXVCPKFLZMKoERxeMDpL86StAyUJagcA&oe=69A17AE6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlF7dVXyDDYQ7kNvwFYLh6H&_nc_oc=Adk1NC0074q9hlmje3PZnFuvK-PWuDukPhOizMCn_Puwp_33hGb7dPI38Dmjk521BnE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsoRsYl_dxnS-AHJbdOhf5TW1gEe-Ea5MKIijB-Z8ioBw&oe=69A19429"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc42vj_bqjYQ7kNvwHGkx_f&_nc_oc=AdnP8fWzX3YjV4riZIxna2HrgvPYcAHEEK1afZWH2jGF-bCY5-0pN9jOJNeVh_UhwAA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsoOCz1J_5gSehhVguHUqh3UDHeoLxc-jHIS2r1lJE0VQ&oe=69A19DB8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLh4dytkqZsQ7kNvwFXds3c&_nc_oc=AdlR6xTVBxx29Z9QEZn7XtC3BHrLr_iF7uARHEVt0MTKNfZkvTmbkyys2QhczX9LGxc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuBxsW3kOWxdHWgRPjmaE4j_PkP6P7zwENBV4_OJIvOag&oe=69A1845E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4c-_WmmKRQQ7kNvwH9Fh2D&_nc_oc=AdmfDuCazCaFuGNuG03YhkwhpGG4Z_J4pAsTv6Namfyo4Rz5IT3UHzTI38BusZTymLo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft1JL0lO409bD4mPoShmZKxzg-WUR5SM0SN4AWNTQxSbQ&oe=69A182A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M1wQ2JBHHYQ7kNvwFjx7zF&_nc_oc=AdnDC6vCufNwUfW8h5iLaD2F3MSFAPlGgEYJmtFc2_yeaf6e-eTf-oF4t3gmQeb6t2Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvROjpPnEIY9sCCnx5ZI85l6x0y-LJQ9mNRUmhDeZlpsg&oe=69A1A536"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Bootcamp", "pla
64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_hZZSvnjtcQ7kNvwEyDwKo&_nc_oc=Adol5wnuPHkNGlgp9L1Y7y4rS8U-SIFNa418xjZMCXnlW9kVAIu5h056RQ9LNfxNhEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE137R7WfGNcZ0LXTHNjoZHReUhX928LYyNg71gRfOe-A&oe=6A897494"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiFQzlSEPgkQ7kNvwGlEzDy&_nc_oc=AdpxKDQX-NOuhfVqTw09S_fWc9M2z4wXeLyvjJ1AeihrCdwFyhi4Zo46BnaNIIRZr18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Rce6-JVcQteYrFevvDB8vxXzSp0wwpNzredOcdxU9A&oe=6A89779F"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5Q1sHQr-c0Q7kNvwFde1ME&_nc_oc=AdqhubSfcOMguzFdeO0xEaSJdMiB9VyepP3Ps0fmlR41uOCzI_3Xrxk3TSpC_sio8Cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSeQYbwohzoHRlqx3wzmKhuS5MPHqOxrC3tKTepCvtzw&oe=6A8982E6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHVCuH1JnWIQ7kNvwGrbpxz&_nc_oc=Adof0M8VVfTcmFRY9OULYZHSEGCAFHO2BLGvU1NDM4RwoHPzS399pFEYgbsET3NlPgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCMBlcfM2bXpIwLp7wn1bWJCYypbd_s76zSMT8v4MRXg&oe=6A899C29"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVIpVrXkdkMQ7kNvwHRxl30&_nc_oc=Adpezi34Ea3zx6mEsevMhJCgvaIApJzaUF5jS2tSZe_0nZtsfhJJ1a__PIGu9f6zf8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg67Nyx-h5ymuG-0PwM3bWM5kXaWR4RpuaFMMyl3JjIg&oe=6A89A5B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOkZ5YwScBwQ7kNvwH51YcT&_nc_oc=AdrwpQ4WK-6XkynYo6f24WrLeRp1DIRFDXL2GdDbZqsRZEODa4jRU5sCauSQZdXOh4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPiKy5yhFelFxxiFNrdzHc8DOJxQbk7p4poHXQFPGgow&oe=6A898C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cFDXVKhhbgQ7kNvwEWi8_D&_nc_oc=Adq21XH-hCp34Hz2AnHxv2sXRZtiqgtW8_ELfP-hziK7az5HxRZP31vfVZwr1raeHFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSQr-3gDL54SdscSSmmwx47DhQz1d1G4-oZ95AeSbHGg&oe=6A898AA7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
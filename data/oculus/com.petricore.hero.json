6EAD4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d7DPPOgm5QQ7kNvwH8umMI&_nc_oc=AdnKW06pbZqnvy_m-xD8N1rAyOwrMTKZ25LuIZNArGx0Vk3aoPwMIutg3AhmYdU1_5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLbw9RuE_ALrFyqJ70b4ZFO13mGWuNik1ohCtfIjXCQw&oe=69A6EDDF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTXbo8Sm_ikQ7kNvwHwrJ0I&_nc_oc=Adlq6bgmX0ip7_bEnZPs7cJtACcYWxDc8YCBoPqYb5orhzs3steK6J8XXC4xA1nyqjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPOxYhAjOZ4QmZg05UmWpCB3O4Pu00kjhaLWOLeTuTyg&oe=69A6C0E6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2uGTC68MJEQ7kNvwHbuzAl&_nc_oc=Adkwc1lqmLF761YheyaU01Yo9GyF7WoNC4Vc4whFATr8V_-hkunV1-byga5FAynNbAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftr_t1Lx6ozQl-RrKypwzn4zULHlWtPF_md3i-3qXTNQg&oe=69A6DA29"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCs8A2A10JUQ7kNvwGUPYsp&_nc_oc=Adl5038AvcaUZOnWqtdWgx2uVPCFseKYLt_lWlH4wZUuHy4tpGtC-0ZnPAoLweZcc08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFJpJQbXgDF2HjRlEA7iuHQQDHplh3dde2CXONnSbWPQ&oe=69A6E3B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqIRSPCvXn0Q7kNvwG12Q-f&_nc_oc=Adlu0osZ1JJETHfB07I4YWIVgdebGVeQLEDf0jpkxn1pNbeKZRdosMtI2_ZEfHh-D18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR_qRnpEmqWtwrb8Et7GTKcSMMg6TUaUDxWbRsaD0Caw&oe=69A6CA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXhDGKOfNnQQ7kNvwGmQyO7&_nc_oc=AdnEBvMT2X_peJ461XmwQdhwhv_EA-lmZH2nPLidmJcgntV-qCJlA9bO3-8pkpG9hhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusLJGXoe2I9Y0GIB5JrxD2MVB2B3b2cuK23YHwsjr1dA&oe=69A6C8A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32ABs88SnA4Q7kNvwFrqtNd&_nc_oc=AdkpHM6xmGOsfk0Q8p455fJ11ckMjfu22tYiUxWorAK8BghSzr9Awbd6P30oIDaYVQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrtVDSytKDi6lkBtWFiG021ZkFsxH1ktKoVMNtYF6sTA&oe=69A6EB36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Bootcamp", "pla
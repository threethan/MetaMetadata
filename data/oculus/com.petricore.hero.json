64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69cLcvvwbooQ7kNvwFV33az&_nc_oc=AdqmkCdzkpPXn836YUGP0OqHlchxhE0jqDofmNOmCWrfagFBMsHrdEddj_qRatSU8Z4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fDwlWr6nTDI9ciTATdI-i--2KjsW0ox_kZ8uP56FARg&oe=6A32A9D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3Vz7C-Q16sQ7kNvwGOdEq9&_nc_oc=AdpGZBCHvPbKcyiWg28scgf5S8sgYNEHPWzXIXQtnDOvO_MZFM4aKm0cpIn79hqN95Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xq3VuVHghVly7j1aWmR3TcQP5aCugv5w_L9zWWGpSgg&oe=6A32ACDF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sdfpK1UciEQ7kNvwE6yPCP&_nc_oc=Adr1gtCkdWeNA6J4mPi9hXZ6fxnGCNMvSeHhbyS3wSEMUEYr99QOLlHA3HiFO2zl5Mo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sq8l3cTgaa8HCt_DcUUF2DC1Aj77K4qOF-zX_Fkq0zQ&oe=6A32B826"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDFDULhAWxwQ7kNvwEqCFZj&_nc_oc=Adqrzil2yHcv5MpYUisNx78Kh6V4_2q4Pq57tbRgg0Nj-FDTuJSHEnYo2ATwJ-XqHD0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9icgP3wNxpnR_45TJv42MM_cHk0c8dbrV2ZykiFM8yVQ&oe=6A329929"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpmGP7MMwbYQ7kNvwFDAMSf&_nc_oc=Adr5yzTnkN5jXHTi7p5cCWkMU9dr2pKJ1I6aznviRMjaTFub9uzk_3bR5Ch56sJ-Xh8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0z1M_pKnkMK5rq1_eLtXltsxfMPipBbv1O3VVnFRw5Q&oe=6A32A2B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S87MMu7X0LEQ7kNvwH0afpx&_nc_oc=AdpTny31VUVd_nmoF7atBjxrMCL_upH-G4Eu0eBSJTNM-PuW_z19krmBfXRcKSQL7Tk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5jq0uRLKIwIYnWHlJQWEIwvReip7agNgORQCodC4-xg&oe=6A32C19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOdcudW7j7UQ7kNvwE3-ix8&_nc_oc=AdoMserCggQUwiY4sr7vTnN4QRiOMllLH0dA-pv5rb94Q8LPFcpHHo4SbmJ-WjY0RJQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lhHczq0XgA_aPpIojg4BhTmLbDnS-2GeF0R7MIiU3Rg&oe=6A32BFE7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
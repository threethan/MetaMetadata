0BED4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeyMLg0ScnIQ7kNvwEny8uv&_nc_oc=AdoQ0wIj--zGwmbhkxjitweLNzYKmx4U_uBGOlaYnvBgYvN5EYpKDFsjDCZOre4Hc6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0XciC4Mn8Nn0T9VXN41q9z-igaoIzt6zs9-5rPyhL-yw&oe=69F0C1DF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1trDLR3Ss8Q7kNvwGQ-j67&_nc_oc=AdonBiy_3eXKqz5LXmtWqDtbJx6iOFuDLV-ASPGYq12q8xBAlk752Zo9UmEYPAdNszA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2qXNgsou-xfOeU-P7iejLUhfsjU7QxUJbEghYvNFYuaA&oe=69F0CD26"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpMB7yYFMK8Q7kNvwF2AIBf&_nc_oc=AdoS6s8RHDKB_Jo1DOTGRfMVOS9b9Zuj3SJgYCTdE8IIt_z-oL524hrpuK6GD7sWj4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3D8OKoDxeO_UIG1uCgKxoQVvhLlRLsjyf1pBuSaGgOEw&oe=69F0AE29"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZgW1K97f4AQ7kNvwFXGhSe&_nc_oc=AdqzDURgMzQa7NCWhGo8c9sy6LVRtvIGvjVx7XBGPHSKSoH21kYq7ihJWS_7gISLO94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2el92KH62hvKFzK04R_Q3E9In3YDMnBEUij1-mbwKkVw&oe=69F0B7B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOk0PfL7bNkQ7kNvwHU3dK-&_nc_oc=AdrewE7ner72ZZEiGZEwv5aYoYct28fmjXX6mpHLYuwV5xDgjBuR5ojW0D-q2bpX2t8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1pIxWnJ2pjL3DmobjOKTV4wmhgwaf1atrC41bpIiqMOQ&oe=69F09E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHho0UVGbWkQ7kNvwHNbctx&_nc_oc=AdpJnk42xQY6Jwwl9mPIkK0YCEP9JgF8T0aoiLJQ2fhxTW0SwKSUQxZwl0eYtZsiEVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0fBXh8Q8ywtgAh7x24fgZPgzeAWI3PU0YugxgvHJOIMg&oe=69F09CA7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPDdesVbhk0Q7kNvwG1Ef50&_nc_oc=AdpIuqvoGUMI4oLa0eqMM86koHvkPu9Bq8Tf6mZAqnuiwKv0Fq2VHI7a3nMNp0NoJHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3Zb4yQ22lbraMwZgqPT9CUm8-QRMVl_2IeIi0hmu3G-Q&oe=69F0BF36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Bootcamp", "pla
447D4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d7DPPOgm5QQ7kNvwHoIKG5&_nc_oc=AdnLui5c4VvzOUUV953ETI31G2wrbDOvvObtYR62wUAe3Qmcgd_ha8_4_R0vIcbPxzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuGJxR5_7PqQiPmiFk-0XziT8cd6_6GMOyw5NA9ugpnOw&oe=69A44ADF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTXbo8Sm_ikQ7kNvwEWTevs&_nc_oc=Adm4iDXTj02RRKqqw77AMJJtPs-exzFIBKfU0mIT4hk6fT5qVvKckju_Y5V_vzs6lzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfttOp-cumtLS_jfngRjalwD8QGdB8MNDdeb0uhUhggiUw&oe=69A41DE6"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGhGoCRwqgkQ7kNvwFUCX65&_nc_oc=Adkkj0kXLJD8cf_jmbXQwQ1bX4IGQ4NRw_7fG4xhlRmZGgMkpMzlSlcV9zeRUcCZy9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsD_by5QsEH6gfj4K8V2hCWPjWy5jVoFiYHx3Rb8061ig&oe=69A43729"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCs8A2A10JUQ7kNvwE6ssqP&_nc_oc=AdnPuwh4RVIQjZAELiAkp91UP0MEDpOrhuPoNVblumgnv9an44vfGM86Gj7e8g0FPNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjM1KE90jVnKFDERtxwj1o0YgqseljhxeyhjPj5OgeTQ&oe=69A440B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqIRSPCvXn0Q7kNvwHqyuT_&_nc_oc=Adlk1vIrsa9Jzh5nJaMjomaemBrKqAzSZWSleBtdO-cEVt7DgIrUDG5c7dlIetRIyZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0WWm0dSKELl9dAFaCvMoi598Ff4ng_yWiLYIKU52mfw&oe=69A4275E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXhDGKOfNnQQ7kNvwEi8jKT&_nc_oc=Adkpz0pY-cDyS7gYRGZbUXKR7And4sE1lhNavwnKQ4GPgx5jkvuvCRtYe6PL8MGbI9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvbD-6bCa9A1bzGqaKf-JpTp-IezituFj35clcLxPYLMg&oe=69A425A7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M1wQ2JBHHYQ7kNvwHaWJX9&_nc_oc=Adl9tVorz8Ku5-zTpGipb9LBC9GYfgAasJpRctxRTWM3RxBZVb3ih3Uxd6lQZY9DYho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs89Ojib9dCCgxBML2m2oJ04kLgUvVbz5ZBqZSmZUHoeQ&oe=69A44836"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hero Bootcamp", "pla
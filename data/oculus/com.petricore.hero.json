nshot_04.png", "id": "1091285542431638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaA0W7rZvhcQ7kNvwEEupgz&_nc_oc=AdqUIZETZh_GqKZ25S3PuGusWHTpOqOUc48_CA-e0I6_y0AXuBZyjD7D1Tgv_IvrZBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vC8i7e6PDqy_ke-B3i7qNUt7Cu1mtibVugqHfZSvm_A&oe=6A0B349E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3wvejxTlFMQ7kNvwEQFbny&_nc_oc=AdpuSasXFZBAXusTdSP7_Cs756b0ymIDvsneeuE_651Z00uZdMbSkU9vd3EwbhFFdtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fxYFEmS-aA-y690Fapxuc0xa8Fp6ysl873HF_V7K9Qg&oe=6A0B32E7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAvdDs1l9G0Q7kNvwG2NgZE&_nc_oc=AdrfHPLwgm22uBMkQhT1zi6UI2kSjqYhC_7ET_7g5wSfruxVsxSA2HP6G84RUeNRjjw&
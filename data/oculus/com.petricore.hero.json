64_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c1qiZoYyxYQ7kNvwHxOfei&_nc_oc=AdqoMPEN1aaVwsyiRywSug5l0GnVxDGro6xh6dbB2JVLJivDxLVesJe3HtzywxsBI3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81h9xvzn_-xMpjzkF7ssza-rWiVhAehonXu9X5pxbXUQ&oe=6A451ED4"}]}, "id": "1604893967539742", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_03.png", "id": "728519446709553", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307564_728519450042886_6659605055843555729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYt4TDFtQFEQ7kNvwGr3haj&_nc_oc=AdqnFZXiE6df5pWEhCyFcnL7WyMQHJc5gJy4XMsWMFFPJxUhDp013PYc-jXC3H8H6rM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QEwZv0KaiJww_f2PnAp6K0I_5U8VtfxIRc-0i0XAL5A&oe=6A4521DF"}, {"file_name": "Screenshot_01.png", "id": "709916731812590", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300929_709916735145923_2894433679554500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MkIHa6ieKcQ7kNvwFn6Por&_nc_oc=Adob5AolIr6q9iePe2xn6HVeIfyZNih3BFggkCVq5Xu3poEziNhE-pYcAiwlWSMOV4w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZeqZpp2gvIC5tN7dPt40oXFRv3syW9X7TtmPrMhB9Hw&oe=6A452D26"}, {"file_name": "Screenshot_02.png", "id": "23922996720706022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618947_23922996724039355_5949859508550277088_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0MS9XsgUk4Q7kNvwHSxQta&_nc_oc=AdopKSPbyytS2znpU737pO_pP0YVFzt34iyTDQXSZQ0c63idXuEV6JimQ_pG4YcgKnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RMKOG3BDRXw8IAXK6gjIp-Y9rzOFJGB5QpHZYPW9Jxg&oe=6A450E29"}, {"file_name": "Screenshot_05.png", "id": "747983277776435", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499309384_747983281109768_5228704477758294142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT1YCda93AYQ7kNvwEQVhat&_nc_oc=AdrX6vpSQe3vVL_dLQfhdOCKSIvDV88uYYLRHjXU8PTWMtrAMEVAhoCIFZYwZaJshX8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RwfX4ougZ9K4ay9FtvU7Pzlw80XxoXNwNObozyvTdEQ&oe=6A4517B8"}, {"file_name": "Screenshot_04.png", "id": "1091285542431638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297259_1091285545764971_7909632462982778633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1njgrhCBvW8Q7kNvwESOXG8&_nc_oc=Ado_GKeu2yH81XdqTH0xM2E9QiYkGHSOQsoP3glXqO8DuhWEeriZxoqVdiZn9pvOlck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2YR4LZ47y08tx3xTWhe3tH4Z6DlzfrAvGNDZR41THiA&oe=6A45369E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStoreTrailerThumbnail.png", "id": "839964898679398", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_839964902012731_3702857026679809738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb_toDTTSAwQ7kNvwEx8Vik&_nc_oc=AdpyT_VhMKCI4zKiDpD7llubfOz1s9aM3ok4zMdycb35vraIktu595GIw9KdVeyvVoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oKenKZN4jWuOBksicj9imIWJxqpXzl-AC4NJmae9lpg&oe=6A4534E7"}, "display_name": "Hero Bootcamp", "keywords": ["Eye", "Tracking", "Hero", "Superhero", "Bootcamp"], "long_description": "Congratulations, recruit \u2014 you\u2019ve been accepted into Hero Bootcamp, the galaxy\u2019s least predictable (and most eye-powered) superhero training program. Your goal? Survive the SHAT \u2014 the Super Hero Acumen Test \u2014 a whirlwind of ridiculous missions that somehow determine whether you're \u201chero material.\u201d\n\n{1173697554514916}\nChannel your inner champion as you fire Laser Eyes at malfunctioning equipment, telekinetically juggle dangerous objects, freeze time to avoid total catastrophe, and use X-Ray Vision to uncover whatever nonsense lurks behind the next wall. Every mission can be solved in multiple ways\u2026 including some we technically didn\u2019t intend.\n\n{1048934014043645}\n\nDesigned as a fun, over-the-top showcase of eye-tracking on Meta Quest Pro*, Hero Bootcamp turns your gaze into your greatest weapon. Don\u2019t have eye-tracking? Don\u2019t sweat it \u2014 recruits on all Meta Quest headsets can still take the SHAT in full.\n\n{1280058330507472}\n\nPut your eyes to work. Save the day. Try not to blow anything up. And remember: heroes aren\u2019t born \u2014 they\u2019re trained\u2026 questionably.\n>\n*Eye-tracking supported only on Meta Quest Pro.", "short_description": "Train for greatness (or chaos) in Hero Bootcamp, the eye-powered superhero training program! Use Laser Eyes, Telekinesis, X-Ray Vision and Time Freeze to survive the SHAT \u2014 the Super Hero Acumen Test. Built to showcase epic eye-tracking mayhem on Meta Quest Pro, and fully playable on all Quest headsets. Eye-tracking optional, accidents inevitable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32389483184030615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300897_1387002222593939_168974974296688410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
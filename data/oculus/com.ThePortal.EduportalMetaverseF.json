b-h6gv3t9ThSzf3Q24XcAXPZs2-XpY_aqX7IYpcn3g5chwRi_WyxoSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1hd5ECVcjt-YwMWnmoX52u8CiaQby5hiAfLZdbG6mhVA&oe=69F0B80E"}, {"file_name": "emv_image_0003.png", "id": "853846046356033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_853846049689366_1073301123337210432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf2JX1PoMBgQ7kNvwF13GGw&_nc_oc=Ado58jUciTWC9_bmGGAd5h9UjclstWC7dF1sYsNuRWCKLhMv56NwMU64Qkz0Gq04IKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2teUdAwzbtf0hYLfyiEdVdtjtgnKEzwoK_lQTFiwbc9w&oe=69F0A620"}, {"file_name": "emv_image_0004.png", "id": "267145009513013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_267145012846346_5648965998916443450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs1ud6iWSbQQ7kNvwF0PHc0&_nc_oc=AdrcLpB79zwZVDLamyRDqjl2lvIbV57Qznmuy-Js3pKNuilR8o14HOHtDlMj0aekJaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0TkVr1MVkIE4tXJfqTjNNzjkZUxGNiICnNzqWZ1KBhBQ&oe=69F0AB11"}, {"file_name": "emv_image_0007.png", "id": "230249206641331", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035434_230249209974664_1716616907977030152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDLO5rstYSsQ7kNvwFTXd3H&_nc_oc=Adrr7Ygg2-I7gBcSmlpAcBOHJEOB8l5sS22u8O1FoB_zcIlsN_sv4J9XRYZMdm5N1S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3KVnnvpWvoPQ2Jik7DtqBluCn9ZH_7tEAWL0tbkFpZLw&oe=69F0BAD3"}, {"file_name": "emv_image_0002.png", "id": "873752504322879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFfA1lA9EHIQ7kNvwHVXGhd&_nc_oc=AdoI75koomc1pqSbK7TAx1J_5r04HzERY1A9nLF7WUEQQrWEOsEOrZY86xuHqI9ljnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1byK8nKalZB0Fgn7RMB6gPBHMl8Qm6-ZGoTei4U7ny2Q&oe=69F0B2E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz2vW4_VLvIQ7kNvwHbXF9o&_nc_oc=Adqvd9BaJR1ExFrYtEte4aoHUM9Kytyc7i1UErYyWj5AqugYdoJd2bOP_LRIzTmwSF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11UcM60SpKaLzsi76RI_5W2XHFtEd-KXKORTIyHMomkg&oe=69F0A81D"}, {"file_name": "Cover Square.png", "id": "1507797733326092", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031328_1507797736659425_5054912392148623425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiVQJIJh0DIQ7kNvwFp0l40&_nc_oc=Ado1I95uG2YH6IPqMNCYAk-PnVhpICOU_NnJnT-YsfOeMNkKqz_Lu3guq5Dr3E8p2tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1xr-t7XeHf39h2AdOheDiv2cMtU-0liOdOQqgaReFLrw&oe=69F0BFE3"}, {"file_name": "CoverArt.png", "id": "1492203391319970", "image_type": "APP_IMG_COVER_LAND
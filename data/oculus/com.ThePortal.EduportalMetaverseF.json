K6KQpd95cR_VctQnPYG85Zfe6WkuNjvWjC2lzgbvM30Ac27nM8ZCHgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQWhRtZSszQxmDSIdOvNsOg5hEP3acm8ud7Vs0ZDEZuQ&oe=69A2EF8E"}, {"file_name": "emv_image_0003.png", "id": "853846046356033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031569_853846049689366_1073301123337210432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WAjAuA-54Q7kNvwF-qcdj&_nc_oc=Adn30ESu9gxGLwkS0Qu-7jz-lAAfpncjYzOM4Z44PiEJi3SXYbeMY6Z7AzTCp4q0OWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucxZ-ebXgjodKHL190RJbDlCz2INRJ5l2zoL38pYRmzg&oe=69A2DDA0"}, {"file_name": "emv_image_0004.png", "id": "267145009513013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_267145012846346_5648965998916443450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If8rgpCegNQQ7kNvwFRuTHZ&_nc_oc=AdkOBEAl7wg3S7glOAVz79ylyI9bVhvRK2InMfLmcu_xqeA1gN413vR2CXavS9SzwvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvchc7W4vQ_4_jz01U6Cr5uDQhyLJzZ9Nw4-H_7M_vLrQ&oe=69A2E291"}, {"file_name": "emv_image_0007.png", "id": "230249206641331", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035434_230249209974664_1716616907977030152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndmhd4aUm08Q7kNvwEKV933&_nc_oc=AdnYOI09raPNjiGgCXQMDehb-t8n2DAUsUnCBG9PTjm3Kpyuv5k_graCFxxx66AloiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZ9yPW4b8ldY84ppv8Gza_zd2rXacja9rWXOZ6FECeaA&oe=69A2F253"}, {"file_name": "emv_image_0002.png", "id": "873752504322879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFAJBuiLMccQ7kNvwGjx35k&_nc_oc=Adm14NCYwVMIoXbptmC5_V8fcjnDRiWVZnEr0wxO9Vm84O-JGtc6lkxlmJVcYevPODs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoDGNcRkj5JBKFHEM-RkHGlV9eP5P46OegSXq9UuNCvQ&oe=69A2EA60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcdZGsFmt9AQ7kNvwGDmANX&_nc_oc=AdlkkQ9ZdSPEtjGhgxe-1Eh_5g9zZrLJjIuCXC37woCfe9t4IDaI8zdNB1A7YZ8i5UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuM6APOqsqvM3vNhZKQmFyecQAT6GUJ0CUGG-KchpgQtg&oe=69A2DF9D"}, {"file_name": "Cover Square.png", "id": "1507797733326092", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031328_1507797736659425_5054912392148623425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmlV22U9x1cQ7kNvwGYYUnd&_nc_oc=Adn66MPobbD4S7eb0v2Geie-EjIaCWWGStoOXwBVGczkYQhX5hDHyRDu_C2Oea2X0_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDtK_RlDhmA3BR2cOBin7VpO5fyE_XAnC0t3PrbKCbSQ&oe=69A2F763"}, {"file_name": "CoverArt.png", "id": "1492203391319970", "image_type": "APP_IMG_COVER_LAND
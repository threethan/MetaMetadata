content-iad6-1.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjUiq9K35x0Q7kNvwFhOP49&_nc_oc=AdpNGt7GSXoiWLbyZO5hl4iQznfJIKKrecvVTUDhgqcUluc6sZqy0zD_1SlKKJj87N4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Q5F3TG1DxyZlBolbu7cX0wIynwlLDRQ9NTER0FFz9w&oe=6B05C620"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31PCKA1d2g4Q7kNvwHl2YHT&_nc_oc=Adq4v8U-OuaerEBbOo6ez0WCgNG6bzzVt9JissGR7bVwcbe1_iXvV6_n9OTDkBT852k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvLQafmwP15OsWREH_Lq33ZU_z98zggIca8JXW4sobEQ&oe=6B05BB5D"}, {"file_na
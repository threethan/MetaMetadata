WcT6pnZ6rLkF_iA76BZJIn9lGPF9JTGqnNh8GR3jkwPlkx1hsRSKrv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsmy1gKEK1GapEUftJHkfmtYbyfyBDQNeYT3A1iOzm_nA&oe=699B068E"}, {"file_name": "emv_image_0003.png", "id": "853846046356033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_853846049689366_1073301123337210432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws3XPrraDUAQ7kNvwGBURhU&_nc_oc=Adl1qfGhquEXpezNIurBFLsRb93uylXSeCVGOmghv5KVS0Nb5PtK_onsug_7A2salRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsZBOOfw8Wm03NAGyXZCHatVH1sSMvtRPfM-tpEX9LoSw&oe=699AF4A0"}, {"file_name": "emv_image_0004.png", "id": "267145009513013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_267145012846346_5648965998916443450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7KeSTiu0C0Q7kNvwFaQuQJ&_nc_oc=AdlszZNsRsVFaZxCkzGQas1xRey-nHQKskki46ji26sliexaXABGb5F1lKOXhEw-D4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVYYLuoH8WIWrhM7gfnkoJbFNZMweb4rqtJ2FhU5qVjw&oe=699AF991"}, {"file_name": "emv_image_0007.png", "id": "230249206641331", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035434_230249209974664_1716616907977030152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJoH19ybXIwQ7kNvwHHId2O&_nc_oc=Adn5lOg6wEGT_M-RVJ-4-aHb5BLsYNBYS-mtDMlxa5upiECHfvkrwVYqfkqVoW5Kc3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsDDaHcdTWOabFnUNfC0IHOZzgnmlLfXUweNI17GafNBg&oe=699B0953"}, {"file_name": "emv_image_0002.png", "id": "873752504322879", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EOpMLpZ1fQQ7kNvwHD-W3e&_nc_oc=AdnLWNC_NVgqir_DGtFFDtkUs_VVl2reQzingbHpig1m1REgg0UpMMUE-s-iU5uywV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuA5GKd8BBEU_EETAKJga3ZhQ21FWTtvOsJaHdvwT4mzQ&oe=699B0160"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnwBnsFd1UAQ7kNvwHtaYuM&_nc_oc=AdkgQFNuYvI8rip-kvtPDV-Qz5w7O-N-S850bzrjdOsdDrsIlQWweZ-zw7p2BuJRamo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsoXingMUFlytBmncmCxlDOfdokswEwGGKsXXFvj1v2LQ&oe=699AF69D"}, {"file_name": "Cover Square.png", "id": "1507797733326092", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031328_1507797736659425_5054912392148623425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acDL5rSj93wQ7kNvwECoMMo&_nc_oc=Adlt_xEqzzDKwAMNvgsLga7Cw1x2cpjPRdB2dFa3S8fCuyUTqdgeL-JOCIA1hp7GtgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftSoT7l3Ok-cvA7j6WkiTDC2vA5f6g-0_CWOkW2YDQndg&oe=699B0E63"}, {"file_name": "CoverArt.png", "id": "1492203391319970", "image_type": "APP_IMG_COVER_LAND
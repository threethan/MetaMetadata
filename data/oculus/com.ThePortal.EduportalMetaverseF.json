i36qNvEAMdK5Yx4gwmaFle-1PY3zjOraTm7IUESWItOpaISkPQ4v1m4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfukXjmK1HXSA3ASIA-iyniSPELkWgbxdZzrGOlUnKauOw&oe=69A4410E"}, {"file_name": "emv_image_0003.png", "id": "853846046356033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_853846049689366_1073301123337210432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5WAjAuA-54Q7kNvwGaMrcF&_nc_oc=AdmOmN7LxK8J6Q1qhXUR4UduSL3MK7cp9JWwtT9ETlm0eNM9vP_Jrs1WjtK0sBU2rbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsClpJMyhlAcR0Rcn-TwlXXF0FO2V2g9FcurCHKs2wYuA&oe=69A42F20"}, {"file_name": "emv_image_0004.png", "id": "267145009513013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_267145012846346_5648965998916443450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV5ipK7HtKoQ7kNvwHvKBZK&_nc_oc=AdmxGpCv8t2JnYBK6bqOujq6H_6AmTYaLCwlV5VNxia0z4CkELHJXspjtT5hVvZ02SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv_B3Ud4h4WDrJp3jN17d5T-9uM6XRlgeheO_5yyVbEig&oe=69A43411"}, {"file_name": "emv_image_0007.png", "id": "230249206641331", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035434_230249209974664_1716616907977030152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndmhd4aUm08Q7kNvwE-AimN&_nc_oc=AdkPgZGYkfd-r4pXA-rMmHhb7dd1u6qPEOldWr-wc5rBkuLMIiHTUxL6RoQWQ1xdne8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuV1Lzgoj9epYGWZg4rZ5srSSzgEyUEnaVpVgmC8JmK7w&oe=69A443D3"}, {"file_name": "emv_image_0002.png", "id": "873752504322879", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFAJBuiLMccQ7kNvwHa2NiJ&_nc_oc=AdnjKcVr-2H1F4dOXCXteVGiyV-AkERKfXzG5yqlCSlohqBRsveDHtzA_Q0KEkKn-yQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftefSoGsMuxv4ndlHWD0YPir_gtNtnIp-zCkYTwfggf-g&oe=69A43BE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcdZGsFmt9AQ7kNvwFL_aPF&_nc_oc=AdmtTbvKTBPkHIHhz600INFRI4OOo1FX4JAzZSAZ6Q9Cy_C7xvxcae0VKJloxBQr_ns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuFNegR5_MOJHodR-ywbk8_PsW-ZgNlqLWW9DLgRiZf_A&oe=69A4311D"}, {"file_name": "Cover Square.png", "id": "1507797733326092", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031328_1507797736659425_5054912392148623425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFWssPqi3AwQ7kNvwFDoMdf&_nc_oc=AdkriP8Drm7RKp-qEe0abTQ8CNocmY2CMnLv7ynkoIAzwG_wvyok360JWT4n8sRKM-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvnTakvc2YSbI1R6gI2k9xGJjY_z0kdp4MMl32d7YzLVg&oe=69A448E3"}, {"file_name": "CoverArt.png", "id": "1492203391319970", "image_type": "APP_IMG_COVER_LAND
content-sjc6-1.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-c_YVyoGAEQ7kNvwGNBJJX&_nc_oc=AdrjE33P4pL2Gtw6W0kmNyL4Hi2aDuPKAFEi8RIE_Aa5tv52oHv2putZD9f8EaVDTpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6BUQQctrAZSMsft1WYpzsokRtmJ9wT31itPILVwJxUQ&oe=6B032320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbrjb9IxuiIQ7kNvwEYIquc&_nc_oc=Adogct4AMCwggL5xp0uBwGA2HRcb5XhSwmhctoAoKdEXDx9VpQE_28VNRN_EDZ0sEPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_zLsxqGz3c10YlUe9XOC4cX0hO2iqCQktgPyEx4ijAA&oe=6B03185D"}, {"file_na
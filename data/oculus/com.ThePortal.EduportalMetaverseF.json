LbvEDN4imup5iVI1ZX0rBgu7fA7SJPT4-y_XANHFF-1-BxLDSClO-2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftkwud_eKT4A8M6B1Lrv20G-zo614bzGd5oOqmF-2J0wg&oe=69A5928E"}, {"file_name": "emv_image_0003.png", "id": "853846046356033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031569_853846049689366_1073301123337210432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb1bqdJERKYQ7kNvwGMrpSr&_nc_oc=AdmDq0lUgsBYJ3VCedDyNTTWoN54vRAsDrgQQAAwuF1iaozGuBoFbnnVP_4vknrqPko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVZqc5UbGjtERjWjgxbQERC0Emy6-MOfGpoyBnSsPWAw&oe=69A580A0"}, {"file_name": "emv_image_0004.png", "id": "267145009513013", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974800_267145012846346_5648965998916443450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV5ipK7HtKoQ7kNvwGV62MH&_nc_oc=Adlm_ynJ7Tl6QZ3kskrrub2daAtJUbPG1_9T_K5aTX-itl4OyHf0_a-WeU7im4HBGKo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvxUg7h4qKq4r6ZW_GYBrl5Drak6aval0I9lj7VGri3Rg&oe=69A58591"}, {"file_name": "emv_image_0007.png", "id": "230249206641331", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035434_230249209974664_1716616907977030152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbPjRNYWsaoQ7kNvwHm3NmK&_nc_oc=AdnRGDDGfbAZbxZcgS5ixJWZsZqbjylGy_zZ8bkNuEm2V5OAx9Znjj6qvXvLTbf0jQE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsZsBcyyEb-raUndQlr54NSEmnkullSk3wOeeouau71UQ&oe=69A59553"}, {"file_name": "emv_image_0002.png", "id": "873752504322879", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhJCb1hu1pwQ7kNvwGj_veG&_nc_oc=Adki5HROHnjY9i-RbFWB5Fz-JWFy22auTJ5XxqLgHWk3cpGwslpV3oklso4I2OFjpss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsvfFvjka10UjJsKuBPQ8_454vxVe8PyaJLs0hSwQ4YEQ&oe=69A58D60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2XJplcLKnMQ7kNvwH_e699&_nc_oc=AdnhgkWNsSIEgHzMR3EYWOvcmMipv6QCDSjnYV-k6H60_CMrN0GXkHCRb-gM5yicN_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftO1aykH7ikcPq0QPkbhJ5_8DOdsy_ayYDnc8xOXK9s2Q&oe=69A5829D"}, {"file_name": "Cover Square.png", "id": "1507797733326092", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031328_1507797736659425_5054912392148623425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFWssPqi3AwQ7kNvwFIj7hi&_nc_oc=Adkqi-22AAeFZUDBKiezu_eJuxWOZRW2WQITAq-RGSSbdpLjfEJKDUvfHfLNtsJ5RCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv_Iz0J0tS72Wc3iQFIYlyIVH0vYMRCLmgrMBQoeyz9sQ&oe=69A59A63"}, {"file_name": "CoverArt.png", "id": "1492203391319970", "image_type": "APP_IMG_COVER_LAND
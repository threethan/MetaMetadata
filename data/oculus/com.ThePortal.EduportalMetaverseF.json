content-ord5-1.oculuscdn.com/v/t64.5771-25/75196227_873752507656212_9208762014995295536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRkZZ4CNbNMQ7kNvwEl9mjD&_nc_oc=AdqDFlppa58FWsbrosJT2JmeOhrP4WIr4i7hOvOss-IlHymRb5_fCR7gfuk-ag-ukI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGnURDcx6g3vI3KP4JoXDMdUWVlK60bcXkatR1P5DGCQ&oe=6AFDDD20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Benvenuto nel futuro dell'istruzione: un metaverso virtuale per Oculus Quest 2, dove l'apprendimento incontra l'immersione totale. Questa app offre un'esperienza educativa senza precedenti, con stanze dedicate a allo studio, dalla Storia alla Matematica, Fisica, Chimica e oltre. Ogni stanza \u00e8 un viaggio formativo, arricchito da contenuti studiati per stimolare mente e curiosit\u00e0.\n\nNon solo potenzierai la tua conoscenza, ma contribuirai a arricchire questo metaverso. Grazie a un'interfaccia intuitiva e un'esperienza immersiva, ogni sessione di studio diventa un'avventura. Scopri, impara e lascia il tuo segno nel metaverso educativo di domani!", "short_description": "Entra nel metaverso dedicato all'istruzione! Visita mondi entusiasmanti, crea lezioni e condividi la tua conoscenza. Esplora stanze dedicate a all'apprendimento, da Matematica a Storia e da Chimica a Meccanica. Con Eduportal Metaverse, ogni materia \u00e8 un'avventura."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "3515777122022023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982626_3515777125355356_3782888504074124199_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gD7d6hOdrYQ7kNvwH9_AwH&_nc_oc=AdpessmoZCBkWkedTHfPxhEO2zhMpGxjZUs3OrBQtp3PoTlGQEeox1UZZcrUNakoQc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJkpxyZnFJ1KqacMqNXToKJWJOkXWEZaL4CTxnYBGwvg&oe=6AFDD25D"}, {"file_na
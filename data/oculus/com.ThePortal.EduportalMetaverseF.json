852_1233671048029212_4279240988081700290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0aycHNUCPcQ7kNvwFW21Wu&_nc_oc=AdpyJl7QiriGi7iXeu2jo-lccubvzcYxqIHs2K2xNGpYfsNByI9HWiqN5h8aLHsvM-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo_5-XlsaYhrOYvH8P0HDyDxZx5tsxcQqcJYOBcphJvA&oe=6AF7499A"}, {"file_name": "emv_image_0002.png", "id": "678752813821333", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363513_678752817154666_7977210780750375542_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVUleVq9masQ7kNvwHBbidd&_nc_oc=AdrG4buFu8Y2pEYIrC-wgOukuOWMr5NxRfHPoIKxBmQAVNKLtn1kbkQ-LbwUKS_6IGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkxBntiyXZtYHJv7CEc7FgK9mc7QdaAhaguOwICBrEg&oe=6AF71D1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Welcome to the future of education: a virtual metaverse for Oculus Quest 2, where learning meets total immersion. This app offers an unparalleled educational journey, with rooms dedicated to everyone wants lo learn from Hystory to Math, Physics, Chemistry, and beyond. Each room is an informative journey, enriched with contents designed to stimulate the mind and curiosity.\n\nNot only will you enhance your knowledge, but you'll also help enrich this metaverse. With an intuitive interface and an immersive experience, every study session becomes an adventure. Discover, learn, and leave your mark in tomorrow's educational metaverse!", "short_description": "Step into the education-focused metaverse! Explore thrilling worlds, create lessons, and share your knowledge. Dive into rooms dedicated to learning, from Math to History and from Chemistry to Mechanics. With Eduportal Metaverse, every day is an adventure."}]}, "developer_name": "The Portal srl", "developer_privacy_policy_url": "https://www.eduportal.it/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Portal s
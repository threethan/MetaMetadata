852_1233671048029212_4279240988081700290_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18bvEdChgsoQ7kNvwE6CD8w&_nc_oc=AdpRkwbnW_GR2siJWqwcGoCrCRS3_4kd6sPkCAj3m4gJjsZmpeNQ6I28O5s_aOxJba8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WTXZdnSdzQ6-SgJIE_SwcPE5KFC62T8LKTJMRAZ_GtA&oe=6A07205A"}, {"file_name": "emv_image_0002.png", "id": "678752813821333", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363513_678752817154666_7977210780750375542_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSqtpXq0bgYQ7kNvwGVQ6Pw&_nc_oc=AdpKVdr-zVi0Hx0nXrLHXLFqSZ7YbV2KQWUCYnCZKTFvb_H9h6OL9-AohBXsvkbWB48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af720zI9OxN3g2Yffpn2CSlyIrWbwwvqovBy-UDj-gBHew&oe=6A072C1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduportal Metaverse", "keywords": [], "long_description": "Welcome to the future of education: a virtual metaverse for Oculus Quest 2, where learning meets total immersion. This app offers an unparalleled educational journey, with rooms dedicated to everyone wants lo learn from Hystory to Math, Physics, Chemistry, and beyond. Each room is an informative journey, enriched with contents designed to stimulate the mind and curiosity.\n\nNot only will you enhance your knowledge, but you'll also help enrich this metaverse. With an intuitive interface and an immersive experience, every study session becomes an adventure. Discover, learn, and leave your mark in tomorrow's educational metaverse!", "short_description": "Step into the education-focused metaverse! Explore thrilling worlds, create lessons, and share your knowledge. Dive into rooms dedicated to learning, from Math to History and from Chemistry to Mechanics. With Eduportal Metaverse, every day is an adventure."}]}, "developer_name": "The Portal srl", "developer_privacy_policy_url": "https://www.eduportal.it/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "The Portal s
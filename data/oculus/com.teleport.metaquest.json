DD8DB"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKrNLQurzGEQ7kNvwH2ecp0&_nc_oc=Ado4aqwxHYrpOlbMHnOJlVYThCNQdi8rN66vN0iNGfxUC_8HCRXABtXQCyC1aagb5EQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXsM4tX-BVgOD4K1yD-RDdywpn5t02MYA3OEeVuuUO0g&oe=6AFDDBA3"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqb52YOyD0QQ7kNvwG0KQUJ&_nc_oc=Ado5Eovqpfib-Aes5HEGCHWBKHCHHxBUWBkFAwAz4i5Hd05B5BOWrK7-nl86aySbgXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP7kqhgu0Fs1tOfJ9eueasCWpRjk-Fc0yVB9KB-Z4cZg&oe=6AFDCCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_NeTE9phQIQ7kNvwGpQF4q&_nc_oc=Adpn8HF9T7VzJlw8c6xXEBIfH5xQOizHlrOkR7RnIB7FqHrE7MGA_R0KdqneEHjE7bA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsCbjTuzM3KMzS-7h8lsaKoK1yBuauIlKlbbtmE6SMng&oe=6AFDD892"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
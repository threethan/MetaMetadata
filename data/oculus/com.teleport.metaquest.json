5C1DB"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4R9Vb5SLEQQ7kNvwFiQjXi&_nc_oc=Adqv5yigMTSjlfqRIVA4ItJl4tbk-vCkf9aOsL_dHxadK_nJ4cNTqgQxyNjcszJPjPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5iJqYr9OWPGJ_WxI-yseez7Iuh7tZl6i9UFXAUMZlXw&oe=6B05C4A3"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc7LtjDTkuAQ7kNvwGG5xHR&_nc_oc=AdoCdPL5Tc0EManrRgezbghz9JTjsTj1I-fi1TOs9AxLzdLq_0anoI0yrkdh7g4M-Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Mn8iyamo02IglUnfa5vUxLJ9GhQwmylwcJhZGGhl7A&oe=6B05B5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqRIYYA1meAQ7kNvwGq3CSl&_nc_oc=AdobiIzZFoDBAqFSP8_BPiOxtF_ruLD9wIK0L086JconQ6-MiK1h3nxuCAycs6q-pmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSABRRJvheLQjm_jKkCSt_A2tZLEyDQg8KAUk_CALLyxg&oe=6B05C192"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
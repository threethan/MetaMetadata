C595B"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmfVHBTQ-TcQ7kNvwFf8FOk&_nc_oc=AdoMEFaVN1gkfr5C9Prz3KG3K4BMKvq0VwcVpA9VkgPGzI3DAgPmKSaKQTr6cruJDTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJAY9CbE2Nua48tVoluNoTDEwvQUiMb0v_F4srYSpaNg&oe=6B0C5C23"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsamVZ2Osq4Q7kNvwGmqlzF&_nc_oc=AdroSemnnx3rUxVLmWwQkFTi0_ExNzUYqpmFbmnsxWP7MTDaQO9o76no_ENT3_lxxS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjPFAmm1YIZ-u5IoQunzdzHCW2aoHSb9RRClFHqcjU8w&oe=6B0C4D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpo6k54GzbwQ7kNvwGT0TjI&_nc_oc=AdqpQwzjgnPEqppKGNF-KRZ37qzEgxwImFsns3UgQUAzP6ix4OIfCxns5eVXd4LMV9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_KT5NHVqvDFGB2DyJjgymuVMuLzMwIMoPgbd9lzNqwg&oe=6B0C5912"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
7135B"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4R9Vb5SLEQQ7kNvwG5ycce&_nc_oc=AdrBZ1Us_5iI_9-0VICEARIow6IPG2UNaBy7tluEXp8bK_R8gL37uI-pUqLow4y-_ZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROecXU8Y0XogIYRcBacK7c8UD057h36bPlXxxgvmhaFA&oe=6B071623"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc7LtjDTkuAQ7kNvwEQNnuL&_nc_oc=AdpejT6pXYYO_3VweUJL2Dmf0s4ZRSZI4TZsvF7boE5VaXLui4VwRGQcmZc8eBJOmCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRatrh0PkCik9P1S7gA-jMCTvNow9l1A8JxDsJNwA2TFg&oe=6B07074B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvZXhiFB32gQ7kNvwHuiQq3&_nc_oc=Adrvti6NBnTmU5ETI7il4atV-jefqj0NKAUQr8Z1qLa1HuslD2HvmhpqjoR5iyVB4RY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-fIvaSz9WHsDijd_8o08-Bos7evXiOEUWu7tUf9CNqQ&oe=6B071312"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
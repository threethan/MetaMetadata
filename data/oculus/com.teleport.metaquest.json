B35DB"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxPzbrfVihIQ7kNvwHbh1Es&_nc_oc=AdosCbj_B9PTUB9u0idKZQ6mhtXpu5nRTpfMF7fi3mQkU13gDPQ-B20D7WeAK92QHRU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGzetyU_oVHHWyxj2DVTcD0OU7G_pTRCXU43qJBBNyaA&oe=6AFB38A3"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0O07_jaTPQQ7kNvwHhU48o&_nc_oc=AdpFSSyff0eJP56-or1QyNZPd98l9MeTUucp14K-aFiXLbjTaFHbGeBbxuzTSoBkBmI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx6AGP1_yqzLXW-QoUnGEM9zjFwiUVW7fNOna57CYzOw&oe=6AFB29CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_NeTE9phQIQ7kNvwEThv0l&_nc_oc=Adq9_OOI9z687B7m5yDH91Jc1imr1dRQdUVj8w2ZdT-uziWd5Z6SEqOB2vqp3qOfn88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8dwkzzIXVHRwb3eyEgXQ6TurNoEa4Q3X1hgG-qGyNiA&oe=6AFB3592"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
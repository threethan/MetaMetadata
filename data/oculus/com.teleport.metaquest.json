4705B"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuxV_T4uVowQ7kNvwGR0VAE&_nc_oc=AdqC6wVSUndnGhUnhxO2KFpUfCf2BSH8jft5FwjfxACvaCKU-nEkeI6by5WEM_xkH80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4eLtffjn03rrzav7QGgHnYlAh-ELgNXWK5g-cRt7zeA&oe=6B047323"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc7LtjDTkuAQ7kNvwHBieo-&_nc_oc=AdphlsMXzXODozVo3myyO-hXiRe8ZbHkHEbSWezV_Z3BI9UlTbd4oa6jAmev2-IbbrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNzJi1saLomdyQlvFoHvmt3nJ5A17yHuK0uR9NVtf3YA&oe=6B04644B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqRIYYA1meAQ7kNvwGmrG7Z&_nc_oc=Adrgz5KotHcsnOTAYGKUyIS-QnpNp0uzGUv-lI-N7voCr7MNmhPJODeCUXewXHQu0ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7v_nBaqm3N84i1tX0ckNi-nY3NdANffRW1bBk0h-r6w&oe=6B047012"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
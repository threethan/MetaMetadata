04DDB"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ytXOTX9tHkQ7kNvwEoJ8Lw&_nc_oc=Ado0aNbKkqmjp0eZXW8vX8K5-gwtblIq83lS3ctfnxl1CHUYMxOCaHKyFCaH5PrqlTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfx_23KPdrpdMmxa1869UQ1JPYT7Q1nnFtFgzfNdEWzg&oe=6B1050A3"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM4INBQSUVMQ7kNvwEQB3oE&_nc_oc=Adr90g7HAvlxdb13Ec0KAttZaRf6KcZxadpZziwTQQX_TSX3kx2etZs-5GY1AJHcaYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_B8VezcIkq31zwBpFN6hWs-0ND_UZqw76T_vbMHPmSA&oe=6B1041CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK3zcjZb9eIQ7kNvwE3CnTG&_nc_oc=AdoSqqXMwkBLX0fF6CPl31h__1AlYqz5JAOJRtJDl5fp3xpeoJzyg0FT0GrJnrVch6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8jN7ZhSbn3x0CeP1eLeBvyGZ8akwzFllNC0LaFKZW-A&oe=6B104D92"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
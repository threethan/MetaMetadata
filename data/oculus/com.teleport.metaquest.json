B401B"}, {"file_name": "5.png", "id": "1529865461822982", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619668_1529865465156315_5660986883736070116_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmfVHBTQ-TcQ7kNvwGiVm1N&_nc_oc=Ado93M84IEJheb3-mzkMMNWx5o_9TAGQaKygc5HVwR_5gWsnqS_zVjrDk5MpEsn5Zx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBncW3Zz84JNkMKnnVisFG1ZZpatr4amo5nF9lirPHiw&oe=6B0B42E3"}, {"file_name": "2.png", "id": "987562170877112", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_987562174210445_7080048223512092638_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYDqO6HMMN0Q7kNvwGN5xmg&_nc_oc=AdpbpNsc5FScXvO-33Y6BikSgn8lh6J_SwPnUtOVXTqlMzhJhkEoNKPOJGAogAmF8V0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPu4qEdUY8zCaVwwRi9rCcqQ7c9VO4kv7sroohohmY8w&oe=6B0B340B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "teleport cover.png", "id": "1647842666420426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617847_1647842669753759_5409658535621324257_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpo6k54GzbwQ7kNvwEUqseF&_nc_oc=AdoOmVMDF9oI9IhC4STugH0hvM081Ee0eVocCRB9mT5i3FAN99LInqJb04SlciY9_Zw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRv9ErfvtC3nEXRDIumy0i54t5wPBkJnbgfdBBoWS2P3g&oe=6B0B3FD2"}, "display_name": "Teleport", "keywords": [], "long_description": "Teleport turns remote connection into something you can feel.\n  \nStep beyond flat video calls into shared reality. Invite someone into your physical space through Quest, where they can look around, explore, and experience the moment with you in real time.\n \nFriends can drop by. Family can feel close again. Clients can step inside your world and understand it instantly.\n\nFrom home tours and design reviews to DIY projects and family visits, Teleport makes distance feel smaller.", "sho
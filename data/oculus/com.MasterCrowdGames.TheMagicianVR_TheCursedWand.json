/v/t64.5771-25/491823351_916226357752812_5798638067094716081_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C44XDzPIOd8Q7kNvwFYUjIq&_nc_oc=AdqTdlnEnyyLLplx56KiKrLu8bnM7upGvNCu-6iCBPvG_AxU4F7IW6FJF0B8wJWCImk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBBErnIA_Rp3BSMLz45amtNGyhDJCl_iQZt2bubR1iZQ&oe=6AFB17D8"}, {"file_name": "_0001_TMVRP_Screenshot02.png", "id": "751027667587165", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818890_751027674253831_3764186951519750621_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szzCImIXV_UQ7kNvwEtlFIw&_nc_oc=AdpGgjJehDVU6KAexvb1Rr0krVPeljBRe2SwtEtzinN9DU-ngK0rzE7XijgvE9P0lLs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFFohlTS5A-gHN7DQ04DZ001aHugBBPvZLsUlVU10-9A&oe=6AFB1DAD"}, {"file_name": "_0004_TMVRP_Screenshot05.png", "id": "738701788921172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819281_738701795587838_6480767104115671597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXaoLVY-YIkQ7kNvwGH0xhL&_nc_oc=AdrGHWP4jMl7QsbTcPUFkJRtse0WNADqJBMt3q8MisvNSPsW_wocqVCFbPprkFSOi2c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3-AGPQLkv2SENNl1umlVlldKOg9Kd1cXYs4O7yy-Hsw&oe=6AFB3E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMVRP_CoverLandscape.png", "id": "2450055652091829", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2450055655425162_8191799389640870627_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcUQco07Hr8Q7kNvwFbuI4Z&_nc_oc=AdrywKXO8n8-J73x_lXQKE_aDhM-E9zeNGma1DHdn9EoqRey3eG76AAkx8JgILeW7NQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRuqbt7hZ10dlv9AyV30_kKed8iYfqM9uhuQJirtdb1w&oe=6AFB14DA"}, "display_name": "The Magician VR: The Cursed Wand", "keywords": ["Wizard", "Wand", "Magic", "Spells", "Sorcery"], "long_description": "\n**Become a magician in VR and cast spells with real wand gestures.**\n\n**The Magician VR: Prelude** is built around one core promise: **wand-gesture spellcasting**. Trace **wand gestures** in the air to form spell patterns, then unleash magic with precision. You\u2019re not pressing a button to \u201ccast\u201d \u2014 your **wand gestures** *are* the spellcasting.\n\n{1695912878036935}\n\n# Key Features\n- **Real wand gestures:** draw spell patterns and cast spells through physical motion\n- **Arcade-driven combat:** easy to pick up, satisfying to master with timing and accuracy\n- **Progression:** unlock new magic and upgrade your spell arsenal\n- **For casual and hardcore VR players:** fast to learn, deep to refine\n\n{831229583229935}\n\n# Visual Style & Original Soundtrack\nCrowville is an **early 20th-century** city twisted into a magical apocalypse: vintage streets, ironwork, old theatres, docks, churches, and crumbling districts under red skies and shadow. The stylised look uses **bold contrast** and **dramatic silhouettes** to keep combat readable while maintaining a epic fantasy tone.\n\nAn **original soundtrack** drives the experience\u2014from ominous atmosphere to powerful combat themes that amplify every spell impact.\n\n{1152961863583112}\n\n# Play Your Way\n1. **Campaign:** defend key locations and push back the invasion\n2. **Survival:** endless waves to test your builds, speed, and spell mastery\n\n*Work in progress: pre-alpha visuals, gameplay, and content may change or not appear in the final release.*\n\n\n\n\n{874591808686949}", "short_description": "Wand-based spellcasting in VR: trace gestures in the air, cast real spells, and strike back against invading monsters. Step into a dark, epic fantasy atmosphere as a mysterious invasion tears through a doomed city. Learn to control your wand with precision, unlock new spells and upgrades, and build a powerful magical arsenal. Face relentless waves of enemies, adapt your strategy, and grow from novice to formidable wizard."}]}, "developer_name": "Master Crowd Games", "developer_privacy_policy_url": "https://mastercrowdgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Master Crowd Games", "support_website_url": null, "website_url": "https://mastercrowdgames.com/the-magician-vr-2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33194467343501931"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1791691775408126"}, {"status": "PUBLISHED", "id": "1650571163103242"}, {"status": "PUBLISHED", "id": "1537920404734693"}, {"status": "PUBLISHED", "id": "27337956752567589"}]}, "baseline_offer": {"id": "1791691775408126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792083600, "status": "PUBLISHED", "id": "1791691775408126"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39049173481364592", "version": "0.14.3"}, "id": "810910938630676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3319446726683527
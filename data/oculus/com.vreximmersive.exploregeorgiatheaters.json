_sid=6e7a0a&_nc_ohc=AesduaBf58AQ7kNvwGZGCqO&_nc_oc=AdrxgVryywmcRuFbXidWqjkmLvUlOEUDe8fVkj-Sf2xFXWnkRvdDwE4nKfOalmn3QM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1cAQnyvvEWJk5froO2bG_fHWJf5oSfVXGd81ftxpy0MA&oe=69F1FFB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJFIGV05AOEQ7kNvwEiogI1&_nc_oc=AdpVBFpqNGyhsaBd4bKYTBN7D71e4jFEOHJnxKWH_6P3LNCqnpITs2QBsgBxjnyLpfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2pIiRc0De88EmjLgxHedt1g0eypPcKJNEao_GsVHHE-A&oe=69F1E356"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961
93457595714703_4769126578285803134_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV42vImfsDgQ7kNvwEcfIOl&_nc_oc=AdlxrF-WJGoSPIGFg8jY0avw0mqcvFu46ZfUzS3jdMWDh7pKLOHJ7uq6IdNU_73ZczA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3zS1JFEYo7WfqVx6H_Z0D954ZDFuA7DuQuJuBYPLhgw&oe=69BE9535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JajN2HiH1qYQ7kNvwG4Qv8w&_nc_oc=Adm80FEXVypEKngi1VVB64nhpDwDCgEDXWL_3RbYregTz5Qh4AQ6adXIdUEwzohCCEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afypb_ahjm9gP3-5nClpNL3zxW92NqbtfWh93fdBU1ZC6A&oe=69BE78D6"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
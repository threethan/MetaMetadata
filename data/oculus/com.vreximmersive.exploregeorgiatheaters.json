less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD7xvLuU8u8Q7kNvwHeHlaV&_nc_oc=AdqJYsHANLoJvuPhj4GLBx-asvPLz5pxEbSV5uNi3XbseKwmz4LNENOBWk2Jdtf1Uzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIhZbYGPd73uBVAmgSQr5lUjCkwfFSKNbLvz58qfCysg&oe=6B0DAA75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsQSVXAEXjEQ7kNvwGjBEWW&_nc_oc=AdppA-oQM_Elqz-sj-7IZQ5V3cxoGhNgh9uh7FMKlVsuKuvluF73ocELCSaEwWKOErc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbGHWA9ht_Tt_nbh-As05bF8zv4NIGF54ZvGdGzhgywg&oe=6B0DC656"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.vrexbox.com/", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://vrexbox.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_ty
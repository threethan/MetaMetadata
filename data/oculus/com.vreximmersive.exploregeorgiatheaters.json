1.oculuscdn.com/v/t64.5771-25/38974677_193457595714703_4769126578285803134_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywa3i_2WOL8Q7kNvwGJPDqu&_nc_oc=AdqF7qiArL7XRqyvJPnQIiWwyNBgc7fP2lp4z-Lx-JlFroOnueKQ_wlMb0O2Wy1m7lQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsrhOAf_-Hx1pd6kpCAQwdwInm6YkJs45bGjDdd6D44Q&oe=6A69F835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_cPKRJUjz8Q7kNvwEJuOh1&_nc_oc=AdoxSFK8ixogO9OE0AFmuochZK08i-foZQ4qBmmJANj1JC0ofqJqi_XnNl_nRNgcpzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAceR5-3dqBmSTlMZAyftdPqASOzgXM-wkY_AoO36rKQ&oe=6A6A1416"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "com
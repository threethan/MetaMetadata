1.oculuscdn.com/v/t64.5771-25/38974677_193457595714703_4769126578285803134_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA2yNO6HsI0Q7kNvwFrfVMQ&_nc_oc=Adr_TsufQHRp0ZwhFY0SVnLRmqE1splCa3KrLB2wMdBPhn0S2S8SlZIciOvpFuOH6Yc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BZUlE-qCNYYIQT2XmHTL3-NMVPfCAN2gNffAw6dpHcw&oe=69D65035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NEc2mcMVZUQ7kNvwE_4bHM&_nc_oc=AdrzSVNipg51uTadhB8m1ugga8FQEx9AIFNIW6KX10IQN0pnU5lbQoAHnYFKRZVa09Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ddHEF-M477lK7P71aKbROQG3sM0p3q72xNVNE3S5u7g&oe=69D633D6"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "com
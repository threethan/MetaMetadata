nyfUgQ7kNvwEue1Dm&_nc_oc=AdnqUYH1o5qLSALPc2kcB1AHMydP6FmGS8_0Wr1Fasn8O17Bdd4Ch9yWRILWK7hZRNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsoVQ49to-3p2R7OKbnoxrZShoQQxloioQCDX4qm165Tg&oe=699EF135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1290073454691401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1290073461358067_7529674252885442725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPd4zqXyAOQQ7kNvwHrYjHG&_nc_oc=AdlP3X5P8kVv3kcKn0X6bOhq5trG2SCGk_TqEdhP-TThMz4T7HT4D7XIqG09p6MJx2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfscUViDe4o32z_bVAkuuUB_y2s7SjdsCY-wl3u8zv_6cw&oe=699ED4D6"}, "display_name": "Explore Georgia - Theaters", "keywords": [], "long_description": "With this app you will be able to explore wonderful theaters of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Theaters\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore diverse and beautiful theaters of Georgia. \nYou can experience diverse list of Georgian theaters ranging from one of the most unique Opera houses in the world to amazing puppet theater of Gabriadze.\nYou will be able to navigate through the amazing Georgian theaters by simply aiming at the menu items and waypoints you see.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscrip
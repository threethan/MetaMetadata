PwW6Eed2c-EtKh5w&oe=6AFC7D97"}, {"file_name": "4.png", "id": "2192454195036716", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596068480_2192454201703382_1283337587534986339_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztzrkOod2KoQ7kNvwF848cd&_nc_oc=Adqnm_YJVl1fjfmT2cIMMNaQvrSW8t49PWJbIttGm_2Z3uE9D__it2allpoXahpdGUk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxMMLDIXhOL9uc_YYvqp62ZzTUCQLW8cp-vz8-pNQLjw&oe=6AFC8DD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cannon Strike: Shoot \u2019Em All", "keywords": ["cannon", "strike", "shooting", "smash", "blocks"], "long_description": "Cannon Strike: Shoot \u2019Em All \u2013 Ultimate VR Cannon Shooting & Destruction Game!\n\nStep into a vibrant tropical environment and take control of your powerful cannon! **Cannon Strike: Shoot \u2019Em All** brings you an addictive physics-based VR arcade experience where precision, strategy, and destruction come together.\n\n\ud83c\udfaf Features:\n\nRealistic VR Aiming & Physics: Precise laser-sight alignment lets you aim at weak spots and knock down complex block towers with satisfaction.\n\nChallenging Levels: Test your skill through multiple progressive levels with unique structure designs, moving platforms, and tricky targets.\n\nSatisfying Destruction: Feel the thrill as stacked cans, blocks, and obstacles crash down in immersive virtual reality.\n\nEasy to Play, Hard to Master: Intuitive controls make it instant fun for casual gamers and VR enthusiasts alike.\n\nVibrant Environment: Enjoy clean 3D graphics set against a relaxing beach and ocean backdrop while enjoying fast-paced action.\n\nLoad your cannon, take aim, and knock them all down! Are you ready to master the ultimate VR cannon challenge?", "short_description": "Aim, shoot, and smash! Experience ultimate VR cannon physics as you blast through stacked blocks, target structures, and challenging levels. Precision aiming meets fun destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1342736832253693"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1162745699427732"}, {"status": "PUBLISHED", "id": "1655589162800555"}]}, "baseline_offer": {"id": "1655589162800555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1162745699427732"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1342748412252535", "version": "0.1"}, "id": "28472701629024006", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1342736825587027", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342748412252535"}, "release_status": "RELEASED"}, "binary_release_ch
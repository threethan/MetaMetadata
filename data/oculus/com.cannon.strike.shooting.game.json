v/t64.5771-25/673819499_2176636416603050_371001314647977508_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1djJA_O3LtoQ7kNvwHugUHh&_nc_oc=AdoxVmQL2dXmWcF7e5_P_OLZVDO_KreLjixYTqXwDqGXSHjcmIDZRRrO330JxLazJU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcxoLK96p2CWS3_WrgOaxGHoqP_Cb_NNvWoLzxJo_7Xg&oe=6AFDD833"}, {"file_name": "5.png", "id": "28476192485322890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_28476192491989556_8534193843207252234_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPuZarY8kt4Q7kNvwHrjOJe&_nc_oc=AdqWW3izaBBYaEHAJcCRt1-YMaN7vjJtgZstvaMzb2zLpzmAHx3FS2dUIuBwkopAjT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFxsG53snvYuq_yx98y2-qRlUxmteyb2L9dWFv_c_HdQ&oe=6AFDCF17"}, {"file_name": "4.png", "id": "2192454195036716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_2192454201703382_1283337587534986339_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztzrkOod2KoQ7kNvwHdq2nv&_nc_oc=AdpTY-wTcQMjwcHjL1Y99vHhhvVwuqJshr0crhDAUslUlmCdth8tDuYWQ3gZdNE9FfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_HkM5fVdG6SiZjWJnn0tkCFHspIYtSmVh3kKpO23gdQ&oe=6AFDDF51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cannon Strike: Shoot \u2019Em All", "keywords": ["cannon", "strike", "shooting", "smash", "blocks"], "long_description": "Cannon Strike: Shoot \u2019Em All \u2013 Ultimate VR Cannon Shooting & Destruction Game!\n\nStep into a vibrant tropical environment and take control of your powerful cannon! **Cannon Strike: Shoot \u2019Em All** brings you an addictive physics-based VR arcade experience where precision, strategy, and destruction come together.\n\n\ud83c\udfaf Features:\n\nRealistic VR Aiming & Physics: Precise laser-sight alignment lets you aim at weak spots and knock down complex block towers with satisfaction.\n\nChallenging Levels: Test your skill through multiple progressive levels with unique structure designs, moving platforms, and tricky targets.\n\nSatisfying Destruction: Feel the thrill as stacked cans, blocks, and obstacles crash down in immersive virtual reality.\n\nEasy to Play, Hard to Master: Intuitive controls make it instant fun for casual gamers and VR enthusiasts alike.\n\nVibrant Environment: Enjoy clean 3D graphics set against a relaxing beach and ocean backdrop while enjoying fast-paced action.\n\nLoad your cannon, take aim, and knock them all down! Are you ready to master the ultimate VR cannon challenge?", "short_description": "Aim, shoot, and smash! Experience ultimate VR cannon physics as you blast through stacked blocks, target structures, and challenging levels. Precision aiming meets fun destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1342736832253693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1
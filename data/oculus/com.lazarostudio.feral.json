", "id": "1850703752937313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_1850703756270646_5308454598965886390_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4BNEoGd8dwQ7kNvwHhzJfp&_nc_oc=AdqB8gd_yaEOWHVkYIW-Dn2JE29bT5lmyBphdsJH9jqIF0qCfohQ2PExkrFujjCUbhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTE3MqhwO-x6-gCLL3XSkjxRmTk1JYS2grpoL8RCBvV0A&oe=6B0DA4C2"}, "display_name": "Feral Project Lazarus", "keywords": ["blood", "fight", "box", "boxing", "gore"], "long_description": "Fight your way out of Project Lazarus in a single-player VR action prototype built around close-range claw combat. Leave containment and navigate ten tunnel labyrinths, reaching checkpoints while enemy reinforcements close in. Time your slashes, evade committed attacks and strike during recovery. Hold a hand's grip to retract its claws and fight with punches; release to extend them again. Earn credits for damage, health and recovery upgrades, confront The Warden in sector 5 and face Lazarus in the final encounter. Clear each horde and reach the exit to advance. Fast, effective claw strikes can wound and dismember enemies.\nContent warning\nThis game contains graphic violence, blood and dismemberment. Intended for adult audiences.", "short_description": "Become the experiment. Break containment with claws and instinct.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://feral-project-lazarus.turingtech-2515.chatgpt.site/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://feral-project-lazarus.turingtech-2515.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}, {"id": "2710427532
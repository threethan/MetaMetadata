le_name": "migrated_image.png", "id": "210194980247566", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AecQ9GtatigQ7kNvwFl3XiV&_nc_oc=Adlq-pavET3aGY9bXUikGgx3JIhsWI-DJ3zxGDeyp6eBFqmrTLZXPbhppW31HI-nTKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAQpDBcBMnxxVex79so911fEfDyyiG-ZesC_T_KPrjpA&oe=69BAA056"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Azdj-zDvIrAQ7kNvwFAourl&_nc_oc=AdlEp61uBrPpLe7O1-S59GXUbrFQTl56tY17DNY47cgfW3IpAetPP14WW1uYf7Yw53g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpaUqHoFAreUzCIYMa7Ht11l4uiOPc5wqLZyp4MvGnIg&oe=69BAB11D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA6VJrKPUn4Q7kNvwFz5LrP&_nc_oc=AdmEMazFlc7HF4bA3i6HsG6h8xT2FpH94Xg9QEye8VQon7Fb-VymryozZZiEnhzopPc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQUasQwQOQbxVr-Ef5bGBmYO5_3iL1JIWbUqt11IAnsQ&oe=69BAA214"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tP-S2PByWQQ7kNvwEqzfV8&_nc_oc=AdnyJiHIqV-71Xez0mfTVw94xbuMOjQ1KJMbmm4TYwF0wTkONj_OL7ZPTUmTlu9dA9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM78sBHf4e_W2kxRf1xxxvU-Gv4qAXxaiP9Zs-wRFqZQ&oe=69BAAF42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8oP55Vy3-sQ7kNvwEftaWy&_nc_oc=AdntU8h5lxg_oN1WiEi4HhpHOKjrZrZV6oZETEVZ43Nj-PdrX3Cd2hzc01RsYsSBOYQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_EqVSefZTs-wEFISFJQ7MjEsle0xs7Qj3LNWpaLzTTA&oe=69BAA76B"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
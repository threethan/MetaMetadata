le_name": "migrated_image.png", "id": "210194980247566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D98KIiCfJh0Q7kNvwHcV1mZ&_nc_oc=Adl9NTn2DwWBtJvxiwWluMDhLJB2stEteDnpGthiHL4xD9LSKi5IeC2f8tKjuwV8a10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqqxCnO_9ClQgffVMKPztlCYIYR82zJ7_jMsE7MxsIkA&oe=69B01456"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQbFmmVYYtsQ7kNvwFDsHof&_nc_oc=Adkj1QOWcONGRJRHn7wTgHM6cNzYncn8CJoxvN1aWi-mtYSPS0yCdB7zicCHASc8AJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0DeMQBOb6uVpN88rR4igVtUrBRDHTUfGexKSlvOGCcA&oe=69B0251D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7F8w0vJfr5kQ7kNvwGqI09o&_nc_oc=AdmjAqhvtOu2GuckWeG48iT-vRGAE3QySzLFdg75s36bdvIuOhaU2NdHVLdsybqKte8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgg2a9rQDEE2qdHrCXJSu9zNDequ3YeQyrmPYg2w_bfQ&oe=69B01614"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZtTSbuXCDQQ7kNvwHhib3B&_nc_oc=AdmXEVH8sFIT0JAb12BzvPXB_FsJZNeJWfu51rHterxZdYXq1ZSn3eDcIhWa2ULgEu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwmWh2-c7YEeXqdAQKfKiuRC70xGSCsPeTSMPx9faeyQ&oe=69B02342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OknE2AT0qFAQ7kNvwGe0Xkg&_nc_oc=Adl57AEXQFD8nMxww27Vg4nZjngj2i7dgu2bMval7RQoI3k7op76gDcllgbCovWPrcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6ZOxnDAm1XHR-TarSK4AJoBO9a7Fl9xCvmqtvHbS6xg&oe=69B01B6B"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
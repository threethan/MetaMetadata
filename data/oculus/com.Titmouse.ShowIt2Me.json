le_name": "migrated_image.png", "id": "210194980247566", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--ZAW-qZ0hEQ7kNvwHadshL&_nc_oc=AdkoYw0XuWsBnNawfQlnXKLCTCWE58OiUgJ_FzKJEHrtI7a3CbGyemcjXmMkg3CyXrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwibBWorZ_PNdzcWV17ryEmZCALhb0Qtk5ZWyTGM_KiIw&oe=69B6ABD6"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkJcnO2DbFIQ7kNvwGyGys4&_nc_oc=AdkK8J8fNjNCUfNYoy1NedaNeOzgyMLVEQ_iXA2LmhDtgyi9B8aRhUwdKvqlrcfLDko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ7wFHx88MLddQoH4opQK9ruBQ9QxXQXr4h0GGWLZhEw&oe=69B6BC9D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdJJi70RPwkQ7kNvwEQb188&_nc_oc=AdkAFEwoPwNX0SSekcM5vUFG2ZCdC_gu8ilKhx9vT1Y9xgXBd2U5JrWK6fGrp-ZQy54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX_fsuc65YLBfO0JkeM9jxuKCmPiIaDPsuHAj9Fkw0Sg&oe=69B6AD94"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSQRafq1UQEQ7kNvwGa15j_&_nc_oc=AdlvuIq-LPKdCnocfkJ_cOx3lDK9ZbCmEKwfeaQe-SHsrwwPgxVswSmBqj_7gk7E1rs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5dASibl3HF0fdYxTX7Dr0EpFlfZcNL0Lp8So_5BhquQ&oe=69B6BAC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9Ip2UBufs8Q7kNvwFSpOJc&_nc_oc=Adk9Gv8M1nS0NvtsGn_KIQPpwS7pnZmYIBG_g1rRp1tbbsdZ4ZETNwtRexxYXvWNR9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfydBjsZVd-B8Zrdj9LsTewkncHjbDg8HduODeD1bIvNQg&oe=69B6B2EB"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
le_name": "migrated_image.png", "id": "210194980247566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQnEwrlvykkQ7kNvwEoSmcV&_nc_oc=AdmcfyziQOlNKnxF_W0oYnVtH5HTzCVu3zsv5poB7J-wmmhdD7-ZNvjrNwdPXITaRZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afshu82VU7l-K5YHVyKNd8Yxo09hCaoeFAflTnpxEDMwwQ&oe=69A82B56"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB1S98hcbsoQ7kNvwFe7FOb&_nc_oc=Adn4NzhfdAE_yR5WbcRj9x9BLP5DUQo_mqrFZq6SX1djc6CxavXnpPd09yEyIZ36Qbg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfucM0qVQhUMxtgOhPQVs8OGC4idb8jdlic6HJxsc7bLCQ&oe=69A83C1D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_n1LuuPdYEQ7kNvwHhl1fh&_nc_oc=Admymzsc3ukNd1V5BeHEa6kIrmBc1yw4JQhvM9_NolSLC590ZBccOUOAhcPuBU6Dm9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvzIjcXixhlKTfIFlsD4KlMEgutO4_NzmR9_Q-d08JaTg&oe=69A82D14"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8RI6W52OLYQ7kNvwFmXPbP&_nc_oc=Adn7yV-x-G9lTGckky8QZ1miuGV3xuUWc4Rb2RFmAarTrOQpSv7WBwWYYFDWKJVt-Ig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWEwuYDum80aM7Owv0XTQNv8UKIaDCTq_3qnCTighKcg&oe=69A83A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXV7MsfhUSYQ7kNvwH2n5t-&_nc_oc=Admfs56thNH6sGqmqfQj5KyWC2frPCF8QDiHWZlQR6e7G1_itocJowRoG0qs3EKMsFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLOEgXzAQleNG2Ub0gNLAEpLVa7fQ2guIfF1bkoUs6rw&oe=69A8326B"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
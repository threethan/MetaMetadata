le_name": "migrated_image.png", "id": "210194980247566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdOgErAm6L4Q7kNvwHGx4NZ&_nc_oc=AdmADGtsUNs855H6_KUwkNWGQCs7gLpQxQdUjF-QOU_OG3XKvQ1IXkBMW5R7LKRmQkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4JWAAuYKqXnghz0Ndj2u38JrDSboHOWf34W7KavFsKw&oe=69AEC2D6"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzA5RcSVTEgQ7kNvwF6nvJF&_nc_oc=AdltIPRMeiV5QLL66Cvhzf9IpCT4OZEolA4OJbvuT9LZnaKK9WmsEZVVggeWrHkzoGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTUXAtNZTigDagq2e14NWNX0XLblgzEg-tRQM96Cpj7w&oe=69AED39D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XXKTWLB0wgQ7kNvwHDy809&_nc_oc=AdnpAlT4O2aL27rYFFIIlXVrclr5ZoRApqh-yXNaFRnXAV_pcOTsolcU949jL-Ev7rA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYL-N_8W4lVvALE5v5UUbRUCEPHivb42ueY-DpQDR1kg&oe=69AEC494"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZjTI-2hIc0Q7kNvwE3VmGc&_nc_oc=AdkRlsf6IjldbSNwq6EhLEMBtNYul7IbC67KHjMigPVsV0larBbNr4DZLAc13UMuE8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSxwQ-SPvbntzp4Zu793Hr3XcmZu6tZ6aRfaG9yL6A3Q&oe=69AED1C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9ZGaqojt0wQ7kNvwFBfwU-&_nc_oc=Adk-nL7RW1qz3aF7zk7VgRte_FmOhuCB9h1r92x4gpNKBxSr_7HOtCf5Y4PcOmfY2HI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6zSu3ktsDF0XPdpi3C3gYJg2QiDurb-gdu1Bkp5gFIQ&oe=69AEC9EB"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
/scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162732_2031765663727233_1528808997879021568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rbq1wlo0pEQ7kNvwEw5sCh&_nc_oc=AdlwDOpLk5o8AwKwybDgrLp0dZVDMYZPErmfZGShsrEcDbg14zAMUOsgiJZ6W6lysVw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuRu7i09k9Wbad2MEyNS3DfE1RG1EAlAOh9V5NQe6XhJQ&oe=69A193D6"}, {"file_name": "migrated_image.png", "id": "561961238009541", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162717_447449712319537_716175269643157504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTkWzjk90ksQ7kNvwHVjT4l&_nc_oc=AdlpHafR2TrKBDzCXd54M_jPW060epAC-mszcGrCvOU1_K25T-XI7B4VM_3lZPUjPWo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afse6bVrJDWp2t7PiYFS-bhy9uQ_bfJQ_i0FNpwtqOTJ0A&oe=69A1A49D"}, {"file_name": "migrated_image.png", "id": "831287650717453", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162716_275279759662386_457623242060857344_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPeC7Xh_U-IQ7kNvwGpfphV&_nc_oc=AdnFL-TlGYNdBzyEXHJd_7lYrwI-hmIvb8KHg3KDOwNfOwiOyP2-_DZ59xFf0pd-9U8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftu2h4fb_E_RnCI0D-OPdOVKqgIYqD4jdnUEnVXr3Ilhg&oe=69A19594"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNiLJNRVh4QQ7kNvwGDRdtx&_nc_oc=AdnUpX53N1MDsjBaVbIhCqw78nLGDIFfgSQsvOT7BZH1Ru-wg2UbaZcNUD0-x7UW_50&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsRn8s2U8aL952YGfl_8PpSXGul3SyMq-YstMRC17CPDA&oe=69A1A2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXRlxawuJVwQ7kNvwGp-D66&_nc_oc=Adkjk45Ay2PWP4pWwzIPwX60g5gFEPXR50nv22mSytRB93Q3cS94IjlHn3BRhaMWuts&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfviQDSm77YX_mynOvsMw-ceOBYwHHgQbbwf4TbNzh9-bg&oe=69A19AEB"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes":
Fupj0-qasrO1AD3YVvNUWAx3yUrNcM2P1Mw1l3eXtHGPDVRM7WK1zaVCdkgtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftB1GbY69KzTMjTIUca0bBVI6TfIb6ujiw_XdidPm5DzA&oe=699C4F94"}, {"file_name": "migrated_image.png", "id": "1075992626098368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_1926639104018082_5758365492444135424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSRzGKACvpoQ7kNvwEXRbyO&_nc_oc=AdmqBDDML_-P8J5c02OVe565txZiMlWJendKkoX770pOzmay8eZ5O1CoauSw_djCtLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgfINRNgUyRDBlHpjKQhlgVsnYMAgu3Bt5YutYx89Jpw&oe=699C5CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "showIt2Me_2.png", "id": "508290726224658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_508290729557991_2462232582461325312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy0l75cWDnYQ7kNvwH7PVCR&_nc_oc=AdlMpeyHLb6z336-El26lKWDGLDDj5HvY2oeizxXBuRaAXCsKhjrrFniE9p2yKFLmZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuDj3r9U4PjMPg2FskPucoz1XUQCbs0Q7J3bu2LkK6Pmg&oe=699C54EB"}, "display_name": "Show It 2 Me", "keywords": ["music", "video", "vr", "nightclub", "titmouse"], "long_description": "Show It 2 Me is an interactive VR music video created using Tilt Brush's audio reactive brushes and featuring Night Club's single, \u201cShow It 2 Me.\u201d \n\nShow It 2 Me first debuted at SXSW\u2019s Virtual Cinema 2017. It features art created by Titmouse president and owner Chris Prynoski and Titmouse creative director Antonio Canobbio using the audio reactive brushes in Tilt Brush, Google\u2019s virtual reality app. \n\nWe'll take you on a trippy visual-ride featuring demonic cars, pulsating brains, and disembodied tongue-mouths. Named after the song by Night Club, an electronic music duo from Los Angeles that features Emily Kavanaugh and Mark Brooks, Show it 2 Me is co-directed by Mark Brooks and Dylan Carter. \n\nCheck out Night Club\u2019s music at http://nightclubband.com.", "short_description": "Come take a ride through a retro-futuristic landscape with demons, space cars, crazy head things, and disembodied tongue-mouths. Created in Google\u2019s Tilt Brush with music from Night Club."}]}, "developer_name": "Titmouse Studios", "developer_privacy_policy_url": "http://titmouse.net/", "developer_terms_of_service_url": "http://titmouse.net/", "publisher_name": "Titmouse Studios", "support_website_url": null, "website_url": "http://titmouse.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4735762176473457"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "130254851004722"}]}, "baseline_offer": {"id": "130254851004722"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "PUBLISHED", "id": "130254851004722"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1492081380873993", "version": "2.06"}, "id": "711006219094485", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1416383481777117", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1492081380873993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "711006219094485"}]}, "change_log": "added entitleme
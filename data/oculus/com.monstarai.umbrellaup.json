_ss=7f20f&oh=00_AQJUEXoNCe9lYPZ6m1dtkHPQz7yQYHYe3EC7wYj0f0c9Cg&oe=6AA02C90"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvSCNr7oAJMQ7kNvwG8dzZ0&_nc_oc=AdrWELGfRPRC1e0WoFLFsYGBxZk_yyOiqUQMPdHZsI7Xnnt9jLe-srzZNDw99cjbC3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1bp4mMROgHML82Dya5JGRmT4KKNbb_2wV42HBX-N2iQ&oe=6A9FFECC"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYlbchwLHNQQ7kNvwG5Vchs&_nc_oc=AdpflsnBT-zIVT1_RB6gCZt8C05HUV-WUzUuurN-K11PaOdhcFFJRjBbhdNql7UNa6U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzp09EQNaMmuu-cbsrn1A9ML-QPLDP0_UzlRUPlvuF1Q&oe=6AA02785"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUwGGQD5Cx4Q7kNvwGb-pMm&_nc_oc=AdrmRgFxEuU_SC6RCdvn2oGuO70XX3d-AHT8i_lE_22mO0KyIBExv6qjupr0JZlUnXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjPWm_y9L5y1Et-0cHBVsy5l-jvBilhJnFhVuIW-iZzw&oe=6AA00099"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00PeliiXGkIQ7kNvwGXuMnj&_nc_oc=AdojqmaUspWKmyZP3dJciWbn6-ROPzec9u03Z5KEy9XBKQa0uBCRcCLNqsp8uMdulQs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsTn0iN1Reh6SoKEB0g7AhmPpCYwqfKP7JQ0QPPIGo1Q&oe=6AA0165D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HimR1Tm635AQ7kNvwF3K0dJ&_nc_oc=AdqFRRl9pGRC_d5BWj8Lj3zPeyJ98Qx5yYZM5yoUgJcXERmNF6vue2PLngRdnsKi7fY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9XxmaDlfFkE30WBGuWAJq_hhKRSBWMiaIftJYAj0Bfw&oe=6AA02B94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIeSE32Ys9kQ7kNvwEG_EVY&_nc_oc=Adrghy0uiS-bsnnRHx6fDtVg8djuTxCqvkK0UcXeguVcgxxduGm_1d24QCE0ZO52UoQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlgOGabyh-zQ1Jb_xQqCLLz6LvIpy3HKYsFhFcgWM3xQ&oe=6AA00BEC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx-P_qr-vsIQ7kNvwHQmgJA&_nc_oc=AdrmtIS1oTzVu2yv-wxfyhg49G3ZY5niVcEzeXmxydG
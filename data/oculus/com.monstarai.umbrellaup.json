&_nc_oc=Ado1IRBxTrDnetBPY438m-8qIEY26zy7yeuZjpfjThxjQR7nkLCnVbW8qK-yjGnRBrw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFc1R3OQ8V0orJGbqb5MhTg9k9_TGA73TlX-YjM4QqXQ&oe=6AC90B10"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yABaKcO9RtgQ7kNvwE9z0Ap&_nc_oc=AdoOR2rrgKXKPZRX1g9f3aQp_X-H2V8GxPKLN7lIkbMPWGTSx4WKOHcT6HBf8-VjRx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK9UFuiDOazXDn11JU7k4__skgXRxqGSGAOewtsZyGMg&oe=6AC9158C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpUmgbEMGOAQ7kNvwFk99OU&_nc_oc=Adr3OogcSEKzY9aefARquSNgMuoKD5tpRbFClIMUHqDxvxvw4V70SA7hFDEe9Tms8p8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUFSiLi_8BjewGc5F1b3Y3fwNuUwznqs8vAip2YrqSZg&oe=6AC90605"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zS0Tx9rgxMQ7kNvwHK3W0J&_nc_oc=Ado7kJEYnM4dAxgRG7oAZNrfAfWoiUF1xBC0N256Jx5YPuCOAfJwyATVCo2LxmH4rj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXcb5uxXlp8UcBoBSeqJL3D3I_dzNaMmw1UABBPIfukg&oe=6AC91759"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Ulua8JwwYQ7kNvwGnDi3t&_nc_oc=AdqSlLwtJOsh6mVSGLArPmSGlKaJw0tl8-Vok5hHKwUKNqervopg7tgML7pGXJkLx-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOujWyIV7Sy0GqV_z9yrXNCCTQwXaWCMhGsLjsv23UhbA&oe=6AC8F4DD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXG0MCrf3b4Q7kNvwG3Bvam&_nc_oc=AdrynfFa7cxQGbl1DLRQBgxvHWJH4pq9afd4xD0xFn_hEBCf-mjsIgHVm1ZiXRC4usQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNevrcFKgCOTKvxmumQVEM2qFcwZ8veD5zLi2F3NPXuzA&oe=6AC90A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H71O661wGiYQ7kNvwFJTc6s&_nc_oc=Adr4mBlYC9j8wlQMNakob9oyrFxi7XokU_JVmWP0-JuvbwKcBeccYQsvPmQAkAseuX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWUvlZQo2syvBqa5DAZXemcw6Z7InVkzZFWH9Bk3Dp3g&oe=6AC8EA6C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s
9619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17wDe6RmHEIQ7kNvwFypGIi&_nc_oc=Adqc9qT5xWb9YvoEn1qb0LJuXBPlFIymHDj5c4yIPZlrrQ7yOTj1rt89eiIp8MLWDbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXWK0nA2-l_7BoprXaga3Iv_H9q9tVA38Nng_e2iflyg&oe=69CA6BCC"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPJVXbjg5yAQ7kNvwHr4Z88&_nc_oc=Adowq6Stu8PJS2Fc33dbQf90hpN8Lg8JmnVTJRsUFyZuU0l01BmEGL4nchbEDaIrO-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjwdbwtKkm4suKs6lLjg4gmKLuxBz3S5hz5Lhc5tJlQA&oe=69CA5C45"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyMXXVQMk9IQ7kNvwFYtOZD&_nc_oc=AdrxniY4faUFdqIrE_fG3VBNGClwRHPaKhTy3En9M0ycZBFFsfcFN4q5s3t-mT5CB9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP_bPgKbKTqxMkylogO1gqTIpI3egEQG1dpODPPoUu7Q&oe=69CA6D99"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4lOQbAsR0gQ7kNvwG-HdSv&_nc_oc=AdrY0h-Nz5bVHhvo1LuwAlIfQAw-QXH-NuGInS_w-ATyNI7uM2lXI3uKB4dAdTr89cE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDMxAYl786uoGpLV3af4VhNcok9CtYcUhPiyGml5nuWw&oe=69CA835D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZwWnOmwzfAQ7kNvwEOWKlW&_nc_oc=AdpsLrDlcFbGYPg3cM6j86JjY-9WgoDRYXB7icPCssKKXWV6vpc6U8gctBw6jISu58c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuCWINa5RShmZSgcNa70oZY1EEtOHHm9OROvuhXu7m8Q&oe=69CA6054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T-sDnYCdm8Q7kNvwE_qxfQ&_nc_oc=Ado5U31oyyYS-ymCDcHRDGfVzjesQSQEUww3G3dmEMzpGjWL8sczT9w8JPNGswuB31M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybULLeybsKYDX3A7BZz7HaPi7MFT5zQ5zvvNx5dbSwqw&oe=69CA78EC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKfNZL9dZBYQ7kNvwGkOLxZ&_nc_oc=AdrFmiRuEAu6q3dZ5lPx-LicdRJ-MUoT-10mK9IyjIyCXhrKvAGog4yIb8TYTSexPvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx14sYBlPG3z1aIYO91Wx2D71Mt0e64i0n1r09eTayeOQ&oe=69CA5B3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up",
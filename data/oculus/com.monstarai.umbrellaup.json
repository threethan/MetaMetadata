sQ7kNvwE_2jOd&_nc_oc=AdngeKTpFtPJgDiK6z3odrcw98uAAAEWL9Yj88tbLgqcs5KTTN4s1vEurrDtsxS1fQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsOmjRXrjPYhSixT6R0ExpZcjbYcBCcipaZpJ2SJcbj9Q&oe=699EEA4C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TINtsUBx0qMQ7kNvwF59cwC&_nc_oc=Adnco-xbG4yUNU5wR2Ujruo9GZKfPfMmMKBc88OS6FK_bkhLN6p84HXZoTLKRTXj_VE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXy3gYets_PrHK8LeDarQYA9NhAsUw52jYYWXeRCB-gQ&oe=699EDAC5"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0T9_jKAuDUQ7kNvwGnYSe0&_nc_oc=AdnnZ4oJ7kEL7SUr34dv9M0P0ncKNJpDpw-2UqW_thHjHguRWzZ--Dh9ICJR1ehZ9Ro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftngJf3BnPouzAGl5bJq_4ohPllM1zalKg8l8uTywhJkQ&oe=699EEC19"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWQhAkh9u8Q7kNvwHk0dHC&_nc_oc=AdkqzZQJlTPxAOc7fdKoYjOXGXXtmRb7rKjmIFS7t2kOX5R2U4L5x9KRxXAFxd7lP9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftsobETLEuTv9jzlG3DKgN6AUwFciW4UevpFzUwJCiy8w&oe=699F01DD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiKW_4emeeYQ7kNvwGCqK8Y&_nc_oc=AdnCdAr4tiuIpTYNE2SxJaucB5aAwK1vEy5dm9PeTsdjZfqriXo3cVNqQoUC34mgw4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZOC4TjP-5H_IWOieHCVtYDR6O7ureRk42QB8b9zmjFA&oe=699EDED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcbFRwbqM_QQ7kNvwHG_k9R&_nc_oc=AdnzYurFAQmVDagdQ_mEMLtZhyb8JQzFfnAUDv1fmFNxHgdaWsje07xQB-JqpLW5nDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftz6R3vY2jL26BsArq7SIU0OMT7IZr4eUHXPUJMqMCoBA&oe=699EF76C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud
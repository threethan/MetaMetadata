08&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9h23387cqIQ7kNvwFI0152&_nc_oc=Adrg6FRW-XuVpklFnaaxzLwMD-TkPySMs0yQljwvTHqrJ10rpmTCp3tK2M9Dc9lsFPY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK59Hwmm44BQ86lTcHNpngsjiDmDrRmlQevifY7JJYyg&oe=6B09A490"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q6knhp-I5AQ7kNvwF03-C8&_nc_oc=Adq0Xmrc0AMA-wSiG55xkuoa3J2Nq-ZNF81fLAf1RCLpSiycIfSYzgwosk8hYphGIC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB9BclPExNRzvGMVS329KOv-87pcfaQO1G428BSn-MTA&oe=6B09AF0C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8rIlGUoVU8Q7kNvwFFwdHB&_nc_oc=Adq7LhrpYvWny8uq3XAHRct4_Xy1qvl8CaJc5YBfvL6sMixHORLeiU1bCxQ6e1fLSgo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeYHnW2ADpP7E0-iS2uOgWQQI6cxYsq13qErLrDVq-iQ&oe=6B099F85"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkE76BNI8ScQ7kNvwHlCd3U&_nc_oc=Adpu6a50TI_pSqUI22fG7x2jx6TtsNc703cZd0iPgICxjrsZ2f-7H8b1ck21anRw59g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmkuEtQFRKmpG7AOXZaLWWozrDkXh-LSKU0G6t5cY1gA&oe=6B09B0D9"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4MLTlhwFjYQ7kNvwGtR1nc&_nc_oc=AdqtT7u3FhdpdRatTGyUXGIm6szyc9XMZqMm1PrrLs1aSucS8E_0S9WPDJog9fW45X4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9tnDb3gBl5L9auwqFJjoCN4oT8ffOlARk3jSZkEdpBw&oe=6B09C69D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i9qCh9NbiMQ7kNvwEwdsc4&_nc_oc=AdoT4BfMDv1TZEA2yc6_t2G68cgtOGvriqbJl5oAJCkrrZSy-GFYIROO036d1L2BnYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiywdAtj2ATht9_WfuiFM-qCxlZpf3IH2sqDOuWW6Pww&oe=6B09A394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0LkuVczpykQ7kNvwFBh1c0&_nc_oc=AdpK-hSMDmI5btEHbhBXVPTNhzLy0gNeZKlNADGluPX_pUe922xk9fhlOmilYS2thN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ8UhYA5VOylh1_nKz4geEZiMStPrNWl3az_0L_zjCpg&oe=6B09BC2C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_i
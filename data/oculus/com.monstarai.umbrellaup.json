08&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwTo06KCbisQ7kNvwFogy82&_nc_oc=AdrusU6Vdp3WhA4qn_e3LpBOmLiCbNam9ssadzfGvrdHT4PsONMoMjln7gj54NvgGM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvqhhsGD1o8kHxKVt3bJOYfef5ow6DgvgrbbF64b6w7A&oe=6B05B010"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Wd_EUuKvgQ7kNvwH0mdV2&_nc_oc=AdqzXg-ER7wPCdxvOWKugnEpat4jKTDpSSrE1h7AzwybBW5AWC8lHh6qFGsxqM50HrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwdAoid_7QAY8YEqs3v55vRbB3G8YMLRvy9Tg3q_ifzw&oe=6B05BA8C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTLWPXemJ-EQ7kNvwH2I_gE&_nc_oc=AdouDRzNZGlqIkGX3HaqCuZXUEB7NFq3R5exegcCb5IJD63CgjupnmyxUm9zgvGv3Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp3wUQqG9e6sVFn4bmpM9ePDz1GEk9W3TXarmyBt00rQ&oe=6B05AB05"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3sP2WEApwEQ7kNvwETYEg3&_nc_oc=AdpWZiGmgQtmXyqSIF0mrfDfSCbjzXvZ9tS_03NTGibv9NcX0ZTNGguMSvEmiHZIbUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkNXCzGaLNGpjgO62l8DMIJDOTjTcJEbR1aeO0RzXs6g&oe=6B05BC59"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZdruCOZZdwQ7kNvwGOzXhP&_nc_oc=AdpWVH-cZhdwBvQlfOoWwEnqukpr91h6m6dzOtgv5F4pXdZElVMYQeYFkZ_u1EIWpuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu-gh2NgaShiT172GZlLBbklETyGkQrL56-m1LIiqiTQ&oe=6B05D21D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujkAPrKZJ20Q7kNvwEieaYA&_nc_oc=AdqXTx4memxKKc6GbusYdOJdqdw2zGGjiTCu2gPJ_qxXpyvr2VbA3A1jlfHOiiFJjJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMaDB3B2k1XQu-TFHDvWSWWZ74BBjpxA-5FfbHDEV5fQ&oe=6B05AF14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbJknEELN3sQ7kNvwHGQDZZ&_nc_oc=Ado0kqNJxJrJVWN3r-EXC5bFrNmP0zbMmUiH0m0aX4GA9a0TB8kfKyQt9eS3v4h4q9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQemqDaryjQPHLncmXsU2yEGSfvKpwN2LsV2ByJ-vlQpA&oe=6B05C7AC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_i
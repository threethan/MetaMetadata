680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp5KqWsIWi4Q7kNvwFV8Ek3&_nc_oc=AdmgsZpJTHnPS31_HH0der06VfMvI6MvMKufLXoc1feknsY2Riz3Zan7RddpXDNi1Do&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcSwRO8oVSCBSoF59I9zLv0fjALWznSHj2YiBMS7yVDw&oe=69B6A54C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMkONr_Q6fkQ7kNvwESgrIG&_nc_oc=Adlnu2BFt1MQcOQ7pIzorwgN5gtJ4fR5YfP1m7I2H-_AtCSShjDc_dGkoYoHiZj31L8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSLdIDWQJxbub2vfXcDSiPiLPa_Ts2tjbkJVJOh0LQBA&oe=69B695C5"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCQxH05Xsi8Q7kNvwGqHSV5&_nc_oc=AdlyLvGgsw0H-n6M2Gy4fZ5k8l1UgbAuzgRHNM5ybb73eLbBX5bKrSI1U7Loz9hxvtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc9p-ULN1R1oeef2XCQKRxnQ_ogcsX3VXAIfsZ3B6n7A&oe=69B6A719"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=divElhvn2rUQ7kNvwGbH8MN&_nc_oc=AdkqOAQyb8S8OnnxjCCiu9y2dZ1QwLoM64v4S98y-FBICtXTfh5ARKthEwZ2HZUeWSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMbD0RtIRK49n4ZaVUcJLhmGPQ-sNtYCH1jNZRpVpP8A&oe=69B6BCDD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etrg4yV7da0Q7kNvwFgV-9X&_nc_oc=Adkybw1gYsFBUDiwZEjXmAZVeAnARcZSQNo6uxZbYA9ZT2GEjeYJ2PCpEHw_EAZSxRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynTVLOWeqaLNuXnRCLas_-lht__q8IDQ_NFOHBdA1s-A&oe=69B699D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3dPASK2jt8Q7kNvwHITScX&_nc_oc=AdkQLFgz_qGrOx84Bxeq0BEvO9otELbegzISHuVWoTOf5T5B8UtlfhPS-Y1ReOeKDFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyDPMtpIV6aREM5DQ6zjl0oEkR5zKexVzqTR-jKdrekQ&oe=69B6B26C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE_jsdcMD1IQ7kNvwHscHrd&_nc_oc=AdlQR4Qu0ynoYieh3VvY3Ib7NZYkIPT7gMYOKQG-ZjfvuJfrWR-We-ryhnrf5v_Anhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3wArY61h6pTCfArIVVFkStRmChRc_v9ih9OS0X-y8rw&oe=69B694BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up", "platform": "ANDROID_6DOF", "context_category": {"context_c
.com&_nc_ss=7f20f&oh=00_Af8cgRn_JNAcWJ-G6ycQeiNwtBXzRUlyZeddLW6_Qo7-dA&oe=6A468690"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0VhP-yG-2kQ7kNvwFkxq9p&_nc_oc=AdpA8Ty_xaAaJE3IvFLX2-rvPb3KUxYZ-JacDTNJ45KcuiWyi8PRHjuGdSvSBbxF-TU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-222et56_r-jFnq54_92d0-sxBzSh6rcYJAlUcaK7DxQ&oe=6A46910C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dUqW6mH_5UQ7kNvwHo17q-&_nc_oc=AdoyvFr287_86ad63wFF1ZgYlZ70q2ZH2eHO_YWqp6amYuZkHG9dGhR67eg21o3n4Xs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qn5mWvbrerOYfBzROQmKU5xVLBKiixthdtp2UgP-Dlg&oe=6A468185"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0LzH354sOoQ7kNvwHwNS00&_nc_oc=AdoZ4DJJz7G5e9RO6pnMPuhUoQ4al1JTKSbA-PtC5pqqaK03RWmHzRet7hw_Zfh7WBs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n8NcjqMNEbacs_ul_w4pPu2OU7RIPhAicsZHzLdyC_w&oe=6A4692D9"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_5OVy-dj70Q7kNvwGMSZhG&_nc_oc=AdqRnGVpanRhOw0uK__C1Sj4rOg7zfDNR1tjwUz_yU4mSYs2ZGRkItu2KqB-FNABnTk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ms-Q8wK3A93VI4ipLOaNJJzva2zbOiDGNWAXgPT9AlA&oe=6A46705D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HonIttVh7SgQ7kNvwG2fAaG&_nc_oc=AdqLnIgMi65x-tbwp6yy1alPlITU48hAfcvqGVbcIgk8GIcymFXi68kUL3PIrYseTB8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L4ciK4LJvTWp261LaRqUSzjf3TZ4iuc1Y0UvexhBx7g&oe=6A468594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymLaB-Zi0iUQ7kNvwGq49VG&_nc_oc=AdoumhJqMc-z9Hkb08VKy9OGA1-H_G2zx9CHX3h5dgqcS5Q1RI8lrWCjGW8fa6jxcD4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wBpBDIQCz6vVHbaS7yl9TFj-oOsrW1UE9c7njA-BU8g&oe=6A4665EC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPR5nRtsnXcQ7kNvwF47i_-&_nc_oc=AdqpTTPOcMxwEiXdOlN3H6R1T3dh
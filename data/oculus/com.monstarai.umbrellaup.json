9619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWNSPzA9qW4Q7kNvwHQv5KL&_nc_oc=AdrEyseLbvhTr8NgCPZ1yJdJdTBZYJvEFSgnuz_Jgku0RUjORA0Gfp0F53A4_ZBZdGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qqHtJ4IqQHwRLJdhbXGMf6yziyFMq-0XM9B4mPqR6rw&oe=69FB334C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ohm_-IUVeTcQ7kNvwEkTrXd&_nc_oc=AdqUf8ya5YO4pZgLYr9V9Ywq287qNMNBQLjmVtD1LomgmBjSp00BBfeMxMFV5GXo1EM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63-ou0LYeg_PEomT1BqZKuFEzLa4SPMcJFZ0C4ucFUKQ&oe=69FB5C05"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87GPeD336FoQ7kNvwHdbn4w&_nc_oc=Adpv84UdXvMhyMVzYlEcZmQBFn2LFnJLVkQHFYPAR2Q6gbTFEJC8pwFM4rPp4W5qVyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l-5G1y8x5aYzpDimpiZqGKY2NitsmEL-VyElBKCtHsw&oe=69FB3519"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHiZTwvHuZAQ7kNvwGFodIK&_nc_oc=AdoDDPcn348IlbpBSc_XT1iNUEH-9d87-rsY-JJRk_RUM7N5WB6Dj_dC_y8qMdbsmfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_AiuNNpfuKSfHy4nL7Q4FKiluAGXjJWHMtsG5zD9hDA&oe=69FB4ADD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUixctvoy6EQ7kNvwEdYc2M&_nc_oc=AdoXHqInCW64UXiSfildu3ho3PXlEyoQtwOVVRltp66svxecxcajpvF3La0-9qlc73U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OcywFYEVmlQ2ljxfhyWEgZkO79q0SXUzq5qDRcrsMYA&oe=69FB27D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6wWeG89hkQ7kNvwF92quI&_nc_oc=AdqB4URghvKJ_Z-Cyhs5wnmlc725U8qGMw6dZ0xxwoNDLjWq2Ck_Q4WNwAt8bSJhBkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L0o376LfnhXEBwiDS81mIstg5D7bat5hy4ccQnrzRIA&oe=69FB406C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtLM3jg9rKEQ7kNvwEG1fdQ&_nc_oc=AdohARl946ENF7Qiq7COQmx800_OCLNt-Fqjcv3T0rIKEcGFoD7s941DyxTZtjPMdCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-4t8rGRxmbLYdGj7VjA9Uh5wmFdb4EgaiHzZ0vx9eog&oe=69FB5AFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up",
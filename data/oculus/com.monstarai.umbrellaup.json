08&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwTo06KCbisQ7kNvwHSfERF&_nc_oc=AdoObe-5x-lBiOPBDeB4lSsF0xmA5nBOjb_7x4I91Io0taUODHCd_VVwIutZIXu1Tnk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4MQLcDCwSOwshBD5OCE8VbwsHOpZf5INBgKzvI65qZA&oe=6B085310"}]}, "id": "2090799601673742", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "2228903784188320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q6knhp-I5AQ7kNvwEvbQiU&_nc_oc=AdqGad8SmTwgdvKqB_pKE86_m2HW15e0Si1qxSnuWdpNtYb3MQMEHhu9gaZMm1OAlyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIIUBbSUqV56mSLX0Z0vMNo54Nnqfl3OZSCN2B7HATqw&oe=6B085D8C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8rIlGUoVU8Q7kNvwHFS-lb&_nc_oc=AdpAp9nkuX_ZpkP9_n54dUNIA4njgDKBgr1UHWt7XVsaVhJ2gITb7F9EpRWfBWXAR2c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTLbWkyR5OPGJrdz1KMnupfWWuIXqwkVQJk6NTC-xrzA&oe=6B084E05"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3sP2WEApwEQ7kNvwE96NLm&_nc_oc=AdpWeLOq5RkqHjHHajadGcWHLFQEHnbSnA-zZjBMjug-zKTouYVGh5zd6PmBrof2o8s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA2M4FdY7VXu4ClL-TMmBZ5sO3ruvlvq4K6qPnvtq_Rg&oe=6B085F59"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4MLTlhwFjYQ7kNvwFV_hc-&_nc_oc=Adrrk95UrFJ1Hixj7K5YgwqbdQa3DlKvHqUaw8TTOvAOsDT_yYLoi9w4DJMhgMQQO0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlSeXvOJ9zTpCIRfDD8NtMhk-33f27-x9Pq9NDmoFueg&oe=6B083CDD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i9qCh9NbiMQ7kNvwEf7w7k&_nc_oc=Adqf9riudEkWdTq3rz2hp7yZqF_cf9dDj-ixXMh6a5DWkJ6QsSP6Q06ADy78iHDjOiQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB0Ko5xD5aqQmksaifleiTlg-SqFKs111oW3aN8VUw4Q&oe=6B085214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0LkuVczpykQ7kNvwFWC4JN&_nc_oc=AdrdFUcHNMn_657DCL52FkEsd7NKHz4UpZ2SmhqN49YnbxBSeH8gKi-O46p1ch5S3O8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7dMW8nUf9uH81f3ntG5jJNR29AryMpYfYTYJi1WqZIw&oe=6B086AAC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_i
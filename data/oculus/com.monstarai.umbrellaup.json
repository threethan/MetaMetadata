9619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irEf-3f-oP0Q7kNvwGAB8HW&_nc_oc=AdqQhgZTl224zv9Op-oeaHN6Rt96LwvJVSKPVJpUeAvsqHxFrh8bCo2F71QG5ZI87E4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MHuNZ4_nX-57C4qzp09bo_SR4tRiPCJ3gb_BvSRHAOw&oe=69D254CC"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5T0U8-BrLEQ7kNvwH5gJa2&_nc_oc=Ado55Ck0dKvIhIEpba5VfdXLUBTW7l8LFxQ4bfcwPSPM6-JLHQ9bF6J10fuzXDNPAg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03sM8uILP2QqIngF1Urkhpi7lM9yml9v7ZGU6lYWVmSQ&oe=69D27D85"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnmjEQ-4mtgQ7kNvwE2NDjR&_nc_oc=Adpu9EUnb1haJopMWX0vPjNBAd25raMBjkYGSWSrW6QupO7RqkYVBajRJxQDq6D6Q9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zhRalZQuLUTsSxwhzU2eLg0Mtb9u49XQ7ekJTWGk_jw&oe=69D25699"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yNx5TmergcQ7kNvwE_ZmxW&_nc_oc=AdrMFKqZ6s0-DMge2xQrTzyqsQBr6v1947rSe-BD3Dpm99R22FR0iDXX519jtueX3OM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hDCu9FQ-lnkTbukeTtdTpAHfgd4BuiZwMrp8t1EsyCA&oe=69D26C5D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP60nNqgE24Q7kNvwHG-ZQG&_nc_oc=AdqkRbQ6Tx_GIrr34Fg3k02D-OGHMj1hJedGxz5GVq9XUxdVdkYCLgsdYSTDzoRvVvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nn8-bWd_FPmdSBN0yKYbobs3nwFUw-WaWdhx8t9riow&oe=69D24954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S8sxGDqbkAQ7kNvwH7_YQz&_nc_oc=Adra4mW4E7X7oxLJ5dbs5zmdK7oYhqLz_aNiMrl-vHy4P0PNO23dZmrsnQGfj2wHsDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05v_DlWdGNCfGEDg2AFB7JruuC4fF0aUeyOHQ8Bw3PVw&oe=69D261EC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdpAHkhgQasQ7kNvwEKNHXQ&_nc_oc=AdoD4Paze1l8RqRYpt88gRhDJT6KMdeYcTnsOVzvfy-HZ8vegnI1qMxxbTC5EmgCyWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-LQ3-_ucrRT_RJm_GzFqNYOQ1PnrISJDHeNLBXWgudQ&oe=69D27C7E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up",
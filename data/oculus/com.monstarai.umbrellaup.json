9619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrkmXE60a_EQ7kNvwE_uwCW&_nc_oc=AdrXP9-52f10dNHsvn4e2OVowIDrKWBayALVrbuQShLi1WvD2UevlDGLsx6wO42X4wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xU5q8clXNtp1OfJIK2fP5wpDaX_6CF5O1I-TDy_RDDQ&oe=69E4C9CC"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdLnVpXIQN8Q7kNvwFUHS4p&_nc_oc=AdoKu5_Hwcpx8A27PFID5H5U7Lc3Zg1iXZTsiq9F3lzLedmwkwOyRkbLIRAFQoh1U9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Iqu-f2Q7nvP7p56mnS_okzogDFr9_3D4_ONnEs79cnQ&oe=69E4BA45"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVLoeSB6xMUQ7kNvwESinGB&_nc_oc=AdqnYdWZR9LPqzd63qyWf-sPaZVithnlvl4LypR4V3w_zYX_5EqaSLU3H_sx9zxTps0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37ctPF2Lyg4UIxx5yOXWWpwfTI8ge0c8RuDNkIa0BC_w&oe=69E4CB99"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY1GzLjBXyQQ7kNvwHc1C4D&_nc_oc=Adom7v3MiZvNFWF-3ywkKSlzxbkOFmm-952BvF3sKHpu1A4dRGcSUk2BLqIaukpRAGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d2tSSX8WGu3jAQfWr6NIC21ck-409R-sfHZDFrB5_dg&oe=69E4E15D"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRxN229FwYcQ7kNvwEVdqXh&_nc_oc=AdrhkYreSY75u_YIX6_hImdOIY6d3TUjtpQS9ywNJwNFLirN27xMH17Ot8TwqQSDcNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NEowPK7F5t3FOnrOO63V9HWvURp3ruSId1pJsKso7pQ&oe=69E4BE54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_DQoGDTmfEQ7kNvwH2w3e1&_nc_oc=AdqhQggwSyszsDPaLKrM68725YMvib0slQR05HAwfM6CSJ6AQHPtBoDc35DumL9ZRPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38QkKdbMKPE2fXeYjGeSJAoM1XQ20P6j8sKNQXHHQl2w&oe=69E4D6EC"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siWgFw5jL-oQ7kNvwE0tnhY&_nc_oc=Adq6z7u6oHF-UgGPA98PsjJslQE16lsx8QSast9roIYVRJ27JYjicCClYCxdyGHvYrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_H4gvIFeSydzuCd0OJD_FxARsQ29KafF8xPNI3f-zfg&oe=69E4B93E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up",
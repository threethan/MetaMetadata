9619697_2228903787521653_7691527680346820636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uK1JpGKegwQ7kNvwFCJga8&_nc_oc=AdpADExVfmwgjMYngEc0J9vyEZwuAEq73AyHxPIjJWFOERr8bPhNqZFs269STG84ucA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kFAn95n5IKBjOwOAmOfAzodOad3fHEE7r7aC_LOf4bQ&oe=69DE324C"}, {"file_name": "2.png", "id": "1152286369897580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1152286373230913_5226934959439945484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WNq-t9Xtq8Q7kNvwHUCj06&_nc_oc=AdqONkNzOAtqN2ilYPHmMmP4n9L1MZbWAql1s-Fq1CtYQIrucHe4d-ENlXyf5y2kSv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A8U_acEIcHnXkIFmgsSM3PtNMHT5Vi8h3yNroUjNyRw&oe=69DE22C5"}, {"file_name": "\u622a\u56fe1.png", "id": "684521228053278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619485_684521231386611_6623603831782279089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keTSRJdlWGIQ7kNvwFldLSe&_nc_oc=AdpUNN72B-rycm3z_Q5T50sjt5ROnjOdl-Gdi09j8EYuS_7R38BxhXQNNJmyiAGScjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QDQnf1TAN4-zsKLebZUoqZvY3fRxhpHhIy8KZ834tXQ&oe=69DE3419"}, {"file_name": "1.png", "id": "1388131016268349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_1388131019601682_113874591060992121_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95bhDocENjoQ7kNvwH1Okf-&_nc_oc=Adrb_Qd7sPIMS87301GE7IT77Yt-RDxoN1DQmAWqM44lWUd5rf4jNFKCc5G_LgHHzRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nsV0vTbyed0erwMjkiNmD_Mz5kp2mb3l1V9nJpa2tQw&oe=69DE49DD"}, {"file_name": "444.png", "id": "779906775198861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314659_779906778532194_1744895043394346610_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2gcsQbBvZsQ7kNvwGqhUEk&_nc_oc=Adqnp-PcXtKDCQKhISILxyZCJTM_AXaVPXAihzIk2km3Rj_BafkW8xZrOZFFUvgM4uo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c4Wm9dsdYq117dxGn5SV-Wb6rNaciCZEC0gTFqILwAA&oe=69DE26D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1950760892146935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1950760898813601_5680159503057088351_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxKpWEdW0KMQ7kNvwGmqfoD&_nc_oc=AdqNYg_fSCI3V5t1kNfXNAwanwJYqjf61-lkFiq677zMKifFbgBunPToFYMaSEKYYNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Es-Njpy42BYyOt2AouDMPNuWtC2F-JMi9x4K-7j71-Q&oe=69DE3F6C"}, "display_name": "Umbrella Up", "keywords": ["horror", "adventure", "simulator", "sandbox", "climb"], "long_description": "# \ud83c\udf83 **Umbrella Up: Horror Mode** \u2602\ufe0f\ud83d\udc80\n\n**You think your umbrellas can protect you?**\nThink again.\n\nWelcome to **Umbrella Up: Horror Mode** \u2014 where a *cute snowman* turns into a *survivor in the dark*. \ud83c\udf2b\ufe0f\n\nThe lights are out. The park\u2019s empty.\nSomething\u2019s breathing right behind you. \ud83d\udc40\nUse your umbrellas to glide, hide, and escape \u2014\nand try to survive inside this cursed amusement park.\n{1094397659433664}\nEvery shadow hides a secret.\nEvery sound could be your last warning.\nFog, flickering lights, distant laughter...\nEverything feels *off*. \ud83d\udd26\ud83d\udc7b\n\n**Just remember \u2014 don\u2019t let the lights go out.**\nWhen they do\u2026 you\u2019ll find out what\u2019s really waiting for you.\n\n## \ud83d\udc80 **Game Features**\n\n- **Haunted Theme Park Map** \u2014 thicker fog, jump scares, dynamic lighting\n- **Battery Panic System** \u2014 find batteries before your flashlight dies! \ud83d\udd0b\n- **Creepy & Funny Skins** \u2014 from *Ghost Umbrellas* to *Cursed Snowmen*\n- **Hidden Stories & Easter Eggs** \u2014 only the brave will uncover them\n\n\ud83c\udf19 **Dare to open your umbrella in the dark?**\n{1387940046384292}", "short_description": "This ain\u2019t your chill VR game anymore \u2014 it\u2019s pure chaos! \ud83d\udca5\nPop open your umbrella \ud83c\udf02 and jump into the storm! \ud83e\ude82\n\n\ud83c\udf02 One tool, endless tricks:\n\ud83e\uddd7 Climb \uff5c\ud83e\udebd Glide \uff5c\ud83e\ude82 Parachute \uff5c\u2694\ufe0f Attack \uff5c\ud83d\udee1\ufe0f Defend \uff5c\ud83d\udeeb Fly \uff5c\ud83d\udd2b Shoot\n\nPlay solo or with friends \u2014 survive the madness, race to the top, and make a scene in the sky! \u2601\ufe0f\ud83c\udfa2"}]}, "developer_name": "Monstarai", "developer_privacy_policy_url": "https://www.umbrellaupvr.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.umbrellaupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25499516983074479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_2245062385961675_3830592801937478287_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ESd-NA9d3UQ7kNvwGUz-pO&_nc_oc=Adq-16B-yoJCAh6SOhJpRx7rqdFUs_lHR1vfCV0RdLO2A5qG86j7IGO6gcJjNdHagsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NLxdIFXw4YgKW_81lbV3-1ZZXzKU3HsJuu61CtpUvPg&oe=69DE21BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umbrella Up",
21_938950111838931_3538365005717126212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x225kHj3Ut0Q7kNvwE67x-s&_nc_oc=AdrucQjMxZjzj2Mc74hg5ttRIzck0VSAd8Wh3Ioy2v2OkSfX7yjBK51nMOeloFRBm2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISwnTqrvWBeBX1qksvIKRQVPPAw6F4y6Czmhrx8uFwuA&oe=6ABBCEAF"}, {"file_name": "Screenshot 2026-03-28 123557.png", "id": "839243009204979", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_839243012538312_8364709279723262446_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgfqK_pdWmYQ7kNvwHvedkG&_nc_oc=Adp3IhbPeWDA0mY2GWu90urO3_cZlrhUfTJwrWh9WnJm_njs_8fZ0ZHEqI5vPIe25qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkDijQZHTEht6NH-U3IhVlahOIm_7Q4pcgTckxJ5D70w&oe=6ABBBFA8"}, {"file_name": "Screenshot 2026-03-31 172352_resized.png", "id": "879521865114227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821782_879521868447560_2209803265533669324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu41147ce9MQ7kNvwG9buiT&_nc_oc=AdoWTHc2mVyjO2CkrH30_J7PPxYvSq-MNP0pucUKJiuksCB7e7h3GwqpXFV0UEtx60M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEC4HV0a_jBw8Yc_skzXKrgjo9KBrBi-56OhOCc3bwvg&oe=6ABBCE45"}, {"file_name": "Screenshot 2026-03-31 172502_resized.png", "id": "3088430874698788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_3088430878032121_7285165358801059500_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sh_ukSQ2gEMQ7kNvwHwOf-p&_nc_oc=Adq9pvQY-8ctdvrfLe62GWfnY50cSOOG2MV8o2X72j2Qu9QZVXs_n44pWanlXdUF1ho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2xmH_Qlm-b31_KVxrPUx9Py4c4LPDSX4PcR92Vgc-5w&oe=6ABBC051"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Withered Reborn", "keywords": [], "long_description": "Project Withered is a high-energy, physics-based multiplayer experience inspired by Gorilla Tag, built around fast movement, intense chases, and pure skill. Instead of traditional controls, players rely on hand-based locomotion to run, climb, jump, and launch themselves across the environment, creating a unique and highly competitive playstyle.\n\nSet in a mysterious, worn-down world, Project Withered introduces players to environments that feel abandoned, decayed, and alive at the same time. From crumbling structures to eerie forests, every map is designed to challenge movement skills while adding to the game\u2019s unsettling atmosphere. The \u201cWithered\u201d theme brings a darker twist, making every match feel immersive and unpredictable.\n\nGameplay revolves around fast-paced tag-style mechanics where players must either chase others down or survive as long as possible. Quick reactions, smart movement, and map knowledge are essential if you want to win. No two rounds ever feel the same, thanks to the freedom of movement and constant player interaction.\n\nProject Withered also features:\n\nCustom-designed maps with vertical movement and hidden routes.\nMultiple game modes to keep gameplay fresh and exciting.\nSkill-based mechanics that reward practice and creativity.\nInteractive environments that enhance strategy and exploration.\nOngoing updates with new content, improvements, and features.\n", "short_description": "Project Withered is a fast-paced, physics-based multiplayer experience inspired by Gorilla Tag. Players use their hands to move, climb, and launch themselves across the map, creating a unique skill-based movement system that\u2019s easy to learn but hard to master.\n\nDive into custom maps, intense chase mechanics, and exciting game modes where every match feels different. Whether you're hunting other players or trying to escape, quick thinking and movement skills are key to survive the round."}]}, "developer_name": "MalicVr", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uDfC2UGbQLKADIM9K6arYCXvSo7OfRGnphMbUnzPFNM/edit?usp=sharing", "developer_terms_of_service_url": null, "publishe
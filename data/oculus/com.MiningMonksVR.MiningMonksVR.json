5/491820441_2012508115986088_297694736653336107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3hcROTftNMQ7kNvwERuleC&_nc_oc=AdovJOYxqJpbCEF1D0MmwFSOo_uh5IwuQ3EbsznrqOC95gW5KJ2qOPXLWzj09DAFSHM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSJzghlhqda5X77zi-ortqnlMsBBI0EAYwus9eHNlNFw&oe=6A8ED32D"}, {"file_name": "142124.png", "id": "2348579448891609", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825497_2348579455558275_5068136922894221656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-RC3UimFlYQ7kNvwHb5V3a&_nc_oc=AdreqwBtO9ET4BG2WGNU7OJpuuXdp7T2uFy4xsrXaR3P1i0bWWJx1-vc_MBpGSW54m8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlh8iqkspA1SpdpUkFD-8M3oUuQqwi2JsEm12YpT1JXA&oe=6A8EE20F"}, {"file_name": "Hang ouT!.png", "id": "640090409039144", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823366_640090415705810_1835306858492455589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6XIAckZSG4Q7kNvwFAmluo&_nc_oc=AdomsJHykPEX4bRGX57FHMA0kOC3MsvHmXW_JuSfuLwXXpV_alsFxfA3TCP1V8BsLcg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1eDQHO91dscwkFn-30i_z4MAoyZ7Ic_Qgv6-vtNw_7w&oe=6A8ED48B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mining Monks VR", "keywords": ["Mining", "vr", "monks", "Horror", "thrill"], "long_description": "Step into the mines like never before in Mining Monks VR, a thrilling VR adventure where danger and discovery go hand in hand. Grab your pickaxe, dive deep into mysterious caves, and uncover hidden treasures while monsters lurk in the shadows.\n\nWhether youre chasing to be rich or outsmarting terrifying creatures or just having fun with friends, every expedition is an unpredictable journey. Go it alone for a true test of courage or team up in multiplayer to double the adventure.", "short_description": "Are you ready for the thrill of the mines? Well, then Mining Monks VR is the game for you! We have lots of different way
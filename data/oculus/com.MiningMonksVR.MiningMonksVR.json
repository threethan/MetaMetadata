uscdn.com/v/t64.5771-25/491823366_640090415705810_1835306858492455589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk26Y4FZd30Q7kNvwFaB7K_&_nc_oc=Adqv8WCkKT59pYqMGhj9H8CfFSZsW87JMAPLZlXV2Z0IV2Gyw8UyGh7OthVLIjN8iZk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiu3ScUCTAikD9DckmFZ50pEeKOcK48PL6z5ilOvCikA&oe=6A972E0B"}, {"file_name": "2.png", "id": "1893037054894133", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491822327_1893037058227466_6293935525322869915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jtg6X7On8NoQ7kNvwErkdxK&_nc_oc=Adr2vgmv1IxltEIpCYcnMZIsFUJa_uyOGN82-yrNLpuYayeYI7X3Url3GdGUBNg_AU4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUzXMzNKOvkO3LnoHFAI3wwFrmb1GiZpg1bd5vqRDvCQ&oe=6A9742F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mining Monks VR", "keywords": ["Mining", "monks", "Horror", "thrill", "Monkey"], "long_description": "Step into the mines like never before in Mining Monks VR, a thrilling VR adventure where danger and discovery go hand in hand. Grab your pickaxe, dive deep into mysterious caves, and uncover hidden treasures while monsters lurk in the shadows.\n\nWhether youre chasing to be rich or outsmarting terrifying creatures or just having fun with friends, every expedition is an unpredictable journey. Go it alone for a true test of courage or team up in multiplayer to double the adventure.", "short_description": "Are you ready for the thrill of the mines? Well, then Mining Monks VR is the game for you! We have lots of different ways to explore the mines. Go alone or bring along a friend  it\u2019s all your choice. Do you think you\u2019re brave enough? Well, then download Mining Monks VR today!"}]}, "developer_name": "Monk Games", "developer_privacy_policy_url": "https://68f60d1536f41.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Gamingvr.real", "support_website_url": null, "website_url": "https://68f60d1536f41.site
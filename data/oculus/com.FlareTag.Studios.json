0_1281113360583189_4929717974246007085_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PHzlJvGWm0Q7kNvwGOZaP9&_nc_oc=Adq-q_JfEMIonPaHvme9So56jD5nJVZOY4n0MTSUw3vuLoNEsjemTRzpujqngK2EJAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY_j1jdaTKA8MFeKQs76XkgQescQfSpupT-X2l9eCQUw&oe=69C2904B"}, {"file_name": "b0e23431632e4e80b90c28f852f3d7bc.png", "id": "1457126825940955", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296027_1457126829274288_8479671959179006036_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uiexs4R54bAQ7kNvwFSdFZo&_nc_oc=Adot1A4bTTIFwEsBqF1Mm8MIUPbTfkzBJCg5w9sLnP63y0pKNG8AGhZr5SX0gVsdH0g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYTABVAm-ocOXQwdI_sAruLI9nIN3hKq_59ykWGuRFCw&oe=69C26D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLARE TAG", "keywords": [], "long_description": "An immersive, high-energy multiplayer VR experience inspired by Gorilla Tag, built from the ground up for smooth, physics-based locomotion and competitive social gameplay. This fangame focuses on skill-based movement mechanics that let players run, jump, climb, and launch themselves through detailed environments using only their hands \u2014 no buttons, no artificial movement, just pure momentum and control.\n\nDesigned specifically for Meta Quest devices, the game is optimized for performance, responsiveness, and comfort in standalone VR. Players can explore custom-built maps featuring vertical terrain, tight corridors, open arenas, and interactive obstacles that encourage creative movement and advanced techniques. Every surface, slope, and structure is crafted to reward practice, precision, and mastery of mechanics.\n\nThe multiplayer experience emphasizes fast matchmaking, smooth networking, and social interaction. Players can join public or private lobbies, compete in multiple game modes, and challenge friends in high-speed tag-style gameplay. Cosmetic customization options allow players to personalize their character, while regular updates introduce new maps, features, and improvements.", "short_description": "A fast-paced multiplayer VR experience inspired by Gorilla Tag, built for smooth movement, competitive gameplay, and chaotic fun. Swing, climb, and launch yourself across custom maps using immersive locomotion mechanics designed specifically for standalone VR. Optimized for Meta Quest, this fangame delivers responsive controls, unique environments, and exciting game modes for players who love skill-based movement and social VR action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ewnEv61VisfZpU20s1vbSO7mLqrldd8ckjHPzr5Po24/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Acid Auth", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1WjdTJFTygMILMgtbB1xM_HmFIPVpfQhav1XXYoLwRYA/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34071879369122240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_773585569135491_4471964942783986728_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvf-fY2-QF4Q7kNvwEqlfBA&_nc_oc=AdqV_Xk0nkWdqZx08Ya0W1SVnHegAA7fXO1YTT7ZL5Y8bZHxhKU8Dl8UmC0jXlDKdHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn
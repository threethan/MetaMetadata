4_1567489146663642517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPVA5hi4HaAQ7kNvwEMTgxq&_nc_oc=Adl1NvDrishihZpf2gtpbJT4-7e04zVdOrLv6X7Yu-IXn42gH09mq6I41QLQfl50w5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy36bXJuBRh0BAb0ddwJHw8yEBv7Um9kCzUH_CSnYjLsg&oe=69BD5BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFsiijD9gHYQ7kNvwFkcM2L&_nc_oc=Adl4z4QvaP5ACE789FIJ8y89xwXujibN4V18JmgDEY5J4CFg__q-9NTjLTflEAzgaSE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw27E6ZwBbjEnIA2-MyKiJPW5ltKo-BSWvUstXwot609g&oe=69BD4737"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "
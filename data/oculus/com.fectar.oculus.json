luscdn.com/v/t64.5771-25/39031428_788733408711444_1567489146663642517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sryGGB1HtSIQ7kNvwFK7ujb&_nc_oc=AdoZF9izGfgIhok1PM-494IQ51VnQclG6SEalnhcGzu0M5ATiBXP46mHNhYyyPHRpUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aVFvLavfLr2Ma552l-FNhZY_tbHRxOWxRghQAnt75ZA&oe=6A428333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N07Spk0k3ZUQ7kNvwGOtTX8&_nc_oc=AdqzpzkfZ-0ePj6kmc52ItQoQN9FS0G_kfR0ymHRdz7zZYKzTjAgaZrxiIFlBQ0ysug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pQTC-dqf1QHFvWxizO2Naol49lHc3wZo9T2SX8CCkgA&oe=6A426EB7"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APP
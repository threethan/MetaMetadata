sqHwP17YD_svPX2fKY5A8Mjg8uXBArjiCnlkCnfINGpemykHQjurF8JhU_y0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5C39610f0XOrWoYRFAUJgw7WELKLfR4QDAQtRXNfBYw&oe=699C6633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkFQpwTJoJYQ7kNvwHJUSH0&_nc_oc=AdlQjvvMJopmT9SKT0a9nxboWuzpizqjFda6Zq70CTXJZWREICc8383LIp__BnpGl-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftI9CfAOu3szjgKFBg83xLN5b92hM2zY1Ougej1ryaj-A&oe=699C51B7"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "exte
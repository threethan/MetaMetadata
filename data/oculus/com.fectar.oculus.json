4_1567489146663642517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG2QiTPU7_AQ7kNvwEScyQI&_nc_oc=Adn5HIjBIHgmwkon3vaO8LJAx6GZ4aWKQBM45qP_TusCUKAvQR9G99mmhVyNhrS87to&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfziB_S21U1OKQZYm_58I7zNrn2rzagf1mPVVAAIQ5uRSA&oe=69B6C433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd9bT5CgTLcQ7kNvwEQBfiv&_nc_oc=AdkzkxXoEfA2yIaJ8z4Rd-0VFkPGAkTFoTA_2dETZt6LEgq0vd92E_N3QtdZ_hx0FEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysXx6wkV_FiJN55pbdraO5tWpt75xYafs_fAVAOjXqHw&oe=69B6AFB7"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "
luscdn.com/v/t64.5771-25/39031428_788733408711444_1567489146663642517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3KlI_6qa94Q7kNvwHhMjjS&_nc_oc=AdrzIfBaA4hLALRppGObyt6puategAEdiqlUZDI6CM-OF3z-RclhhFGczcBrXq6wDuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7062Jak-or9ucSWwd3rLCWsZ0gCH_aeVNIf9WrFMaIYg&oe=69FCA3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozMkM3zwUDUQ7kNvwHMljqo&_nc_oc=AdrEeSCuvZuW6k0ZaBpGGuiX6koZzn2fkZFFrHX5okQFOVwm9O-maqBSZQ1jENayNCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L3_lZqX-fh5xuJIo5quUKR_H8vo4DlEVbVJZma7dSdA&oe=69FC8F37"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APP
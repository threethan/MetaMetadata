67489146663642517_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRMpEuGLuWcQ7kNvwHts-Vm&_nc_oc=AdpY6q_VouYiuPlklbJo1n4TS4AmJcybEhsPiW1JdWEATKNfENK_4uSm-aqv9hfPuS4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3ICPUItfU7xaGDT2jghM-mNoxDyPxnS_2Km4bC6U3v-Q&oe=69F217B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmubAMGpJFYQ7kNvwHJG-Pw&_nc_oc=AdpSeYYB8Nubo9a7mdJq_MJk-nHHS5Py2pRpp2Xhs2kj2WIk1Cv02sySzl9g1ZjtGTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jwHxXKiZ93m5WrBbg7vSYi7JgbxhPisH6uMZwxbyPbQ&oe=69F20337"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
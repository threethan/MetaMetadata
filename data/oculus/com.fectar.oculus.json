3FnN3251ryo2lOIDmlJbPpqAnETuES43ALfnclSeX7jsaQXXlGsIQt0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvvKsJns1zaFxkcU90TjBT45Qe16arXiDRdW5NT0PrGA&oe=6B01E49D"}, {"file_name": "75314850_438558010232264_7368689155670278144_n.png", "id": "788733405378111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_788733408711444_1567489146663642517_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zonGNBPOUkQ7kNvwGllz0S&_nc_oc=Adrgjh4qy610lfba7obNSoVubMKpggO28eoyB2sWP9cuNoyXAau8mUTqg7LMOMg2ZRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFdsAeCfxyJy6SBA8Duu-Eu-xe-SRMq4dngqivPBpLTg&oe=6B01E4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRTrailer.00_00_02_17.Still008.png", "id": "270993741174182", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_270993744507515_1643962847341612112_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOTWTdublwgQ7kNvwGNcNoq&_nc_oc=AdpnTHeqln6tqVRYRbRRmsk5SnFCYx_8Dftj6BQPWgn8Ju2vFC1eHlSR5QtJYYhXHIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcx22bShuQ11zvjJToyKvvAISlwuE1DHMuAnBhR-EEsw&oe=6B01D077"}, "display_name": "Fectar", "keywords": [], "long_description": "HUGE LIBRARY WITH BRAND NEW VR CONTENT \nExperience the impact of a holographic presenter; Go to the 360 Degree Bubble to visit places you\u2019ve never been before; View and interact with objects in 3D; Explore images and videos from different views; Host a Q&A, and so much more! \n\nLET\u2019S GET STARTED! \nLearn more on our website: www.Fectar.com", "short_description": "Virtual Reality (VR) just got easier with Fectar. \n\nEXPERIENCE HUNDREDS OF LIFE-LIKE DEMOS \nWhat would it be like to discover the fossils of a Tyrannosaurus Rex? Or step into an offshore windmill, eh? How about a hands-on lesson in the life-cycle of frogs? Or a closer look at what the chef is cooking? These, along with many more user-created experiences, are now available in the free Fectar app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fectar.com/app-privacy-policy", "developer_terms_of_service_url": "https://www.fectar.com/app-terms-conditions", "publisher_name": "Fectar BV", "support_website_url": null, "website_url": "http://www.fectar.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "nl_BE", "es_PE", "en", "en_AU", "pt_BR", "fr", "es", "ar", "en_GB", "fr_CA", "es_PR", "en_US", "en_CA", "fr_BE", "es_CL", "es_MX", "zh_CN", "es_CO", "en_ZA", "nl"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "659959585194363"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1011859837526870"}, {"status": "PUBLISHED", "id": "6576615449046981"}]}, "baseline_offer": {"id": "1011859837526870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741332060, "status": "PUBLISHED", "id": "1011859837526870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9098336793618499", "version": "2.0.5.1"}, "id": "123847382944053", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3582708045181429", "is_concept": false, "latest_r
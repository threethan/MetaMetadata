content-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrL9t7FZUA6NeJqSDqtJROJZIZNgh2S5YyTTeNw1J59Q&oe=69B80FA9"}, "display_name": "Buried Alive VR", "keywords": ["escapepuzzlehorrorscaryadventure"], "long_description": "Your worst nightmare just became reality - you are buried alive! There is no room for panic, you need to act quickly in order to survive. A crazy psychopath has buried you alive and you need to rely on your puzzle solving skills to escape. The coffin is full of different riddles and puzzles you need to solve to find your way out. But hurry up as the oxygen is running out. If you believe you have what it takes to escape this horrific situation download this game now and try out! Game features: VR mode! Innovative puzzles! Stunning graphics! Scary atmosphere!", "short_description": "Your worst nightmare just became reality - you are buried alive! There is no room for panic, you need to act quickly in order to survive. A crazy psychopath has buried you alive and you need to rely on your puzzle solving skills to escape. The coffin is full of different riddles and puzzles you need to solve to find your way out. But hurry up as the oxygen is running out. If you believe you have what it takes to escape this horrific situation download this game now and try out!"}]}, "developer_name": "Room 8 Sudio", "developer_privacy_policy_url": "http://www.dozengames.com/appscreens/privacy_trapped.html", "developer_terms_of_service_url": "http://www.dozengames.com/appscreens/terms_of_service.html", "publisher_name": "Mobigrow LLC", "support_website_url": null, "website_url": "http://keycube.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
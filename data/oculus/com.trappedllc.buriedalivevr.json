_2080733148838362_8597566375222837248_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZhNgT4mvEQQ7kNvwGvr0tH&_nc_oc=AdkcgYCnHpeH3QLrg_FDEuNlTB2prZ8wniUvVCAjPwyz4NfZRYNoAvnE8CK9ppMAXu4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5d8ZzUZ_zv24T_FvLP971njrEoPJgLR9c24PK0ihfTg&oe=69B40354"}, {"file_name": "migrated_image.png", "id": "222761715587587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1570626653053966_7611590618778697728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QArxt6ec3q4Q7kNvwEpLJbK&_nc_oc=Adk-Jnh6672SlfxFMUsdwSoh9mMgUJSa1xuDupl6oFOvBkff6S9V2V5TTf0wbF_nfIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBTDt2ew8U_AzHA0oPINwH2oyf-ZdgHJeRYp6dxX7UXw&oe=69B40AA3"}, {"file_name": "migrated_image.png", "id": "198834524882972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504730_161237384566520_2228087917719322624_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQCQ6M1xJWQQ7kNvwHzuBw3&_nc_oc=AdmTFjqaboJi7P_FqGhXJ9QdGUGPqlITAWgl9c9qV54ojJD1KPJlHLi4tO81EH-DEmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-npdOZCTOBrazT0tP76tNSn4oRS8I_3_IK5BlqARXwA&oe=69B4193C"}, {"file_name": "migrated_image.png", "id": "2632763447003816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504844_1428633097265437_7931078349571489792_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEFqx_BtLIoQ7kNvwEzUy5h&_nc_oc=AdkyQCEorxe1Dv2ieQzbjtt5ztP2f-lbChL98r0yX1n3fWikkNQv8nJ3UkTcLI7_SXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVBA102J0TDDXK8-A3ox1aWJLJDHqydIqLZH3Wr__aUw&oe=69B3FAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "355273808295686", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_355273811629019_8881504142015594496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy1f9dSFEfkQ7kNvwFud9Dz&_nc_oc=Adlup_q5zuWS7L5pdeny2FkoRb2hQbhHPR5otXEqJX6GaYj3XxFmGxm8bVK22vvncnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydOYPjv8RdGL_X2vVTTBgHR_7WkqR9h5n2Ve8UdoenMw&oe=69B41B29"}, "display_name": "Buried Alive VR", "keywords": ["escapepuzzlehorrorscaryadventure"], "long_description": "Your worst nightmare just became reality - you are buried alive! There is no room for panic, you need to act quickly in order to survive. A crazy psychopath has buried you alive and you need to rely on your puzzle solving skills to escape. The coffin is full of different riddles and puzzles you need to solve to find your way out. But hurry up as the oxygen is running out. If you believe you have what it takes to escape this horrific situation download this game now and try out! Game features: VR mode! Innovative puzzles! Stunning graphics! Scary atmosphere!", "short_description": "Your worst nightmare just became reality - you are buried alive! There is no room for panic, you need to act quickly in order to survive. A crazy psychopath has buried you alive and you need to rely on your puzzle solving skills to escape. The coffin is full of different riddles and puzzles you need to solve to find your way out. But hurry up as the oxygen is running out. If you believe you have what it takes to escape this horrific situation download this game now and try out!"}]}, "developer_name": "Room 8 Sudio", "developer_privacy_policy_url": "http://www.dozengames.com/appscreens/privacy_trapped.html", "developer_terms_of_service_url": "http://www.dozengames.com/appscreens/terms_of_service.html", "publisher_name": "Mobigrow LLC", "support_website_url": null, "website_url": "http://keycube.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
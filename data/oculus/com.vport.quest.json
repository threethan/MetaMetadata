651168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfU2zcBJOmoQ7kNvwEIhJOE&_nc_oc=AdoS9DEfJheAdBwEbdQjuOSZLucsbWvm2vSm7OGjj364FPbSBageS7feqkmRxGb4k1s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLeUZAct6S9YM5q9ExNvNPmhF8CX2xM6MnmoQu4aJY0g&oe=6AD3914F"}, {"file_name": "Event.png", "id": "2569643623482493", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628882_2569643626815826_7108160625227820166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2lnng3qHW4Q7kNvwGpKbrh&_nc_oc=AdpOtHLsVrNjnJpnQSWuuphIcETRGCrQP33RnQBA3MXdWsHE4SKkpQE-MpslJEGVxyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgBFrJkuWWaBk33DAVxYQvSt5-VhcTgeKnVrTsr4qBmQ&oe=6AD39E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1098685116439919", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673531334_1098685119773252_8139802005696041643_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAGIh-z-6UwQ7kNvwGDHL3o&_nc_oc=AdplQHDsoTEPhkuFgdRFMbjucs0s-UNqyMJJkG0oi1TFESm0l_4hSqQCO-HRayKGx-w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr_LhHiaHnRBUBXwOXrL-1n9flqUm8t0Bb70-tFoY1xA&oe=6AD3BA73"}, "display_name": "VPORT", "keywords": ["Concerts", "VRMusic", "LiveEvents", "ImmersiveVideo", "VideoStreaming"], "long_description": "Experience concerts and live events on Meta Quest with VPORT.\n\nBrowse artists, venues, music brands, and upcoming or past events. Watch available content in a resizable 2D player, or select Watch in VR for immersive 180\u00b0, 360\u00b0, or stereoscopic viewing when supported by the video.\n\nSearch the catalog, follow artists and venues, resume playback where you left off, and use VPORT credits to access premium content.\n\nVPORT includes privacy controls, data export, account deletion, content hiding, and tools for reporting concerns.\n\nAn account and internet connection are required. Some content requires an in-app purchase. Conte
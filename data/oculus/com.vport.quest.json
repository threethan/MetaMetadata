876743172116396_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXixrMT2acAQ7kNvwFndQeO&_nc_oc=AdrYVpogYk9UNrWN6nx8SMGiu3Gaug7OOlQzicHpweSewf7XX8Cg0hIY3mT20kz_pR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYZgBA6Kqf1avSoaXh7siWShTD8SzAbuYnndM7c4RvJw&oe=6ACBB3D2"}, {"file_name": "05_account_features.png", "id": "28007814928886743", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_28007814935553409_5329640906215270975_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rphW1RxSNIYQ7kNvwFHfck9&_nc_oc=Adox5wZZibpxTiAfn5EFOrHCCtxuLMzeSF7SckucGeeaZozDJ78cN4W6-EvLEEAiHsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSmknHgTyJJkY14YCH_WFA_wcow70Mtoa5t3-6CqGRVw&oe=6ACB9DC8"}, {"file_name": "01_home_discovery.png", "id": "4044005829064370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_4044005832397703_3253744896412053559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKX0jUFv_k8Q7kNvwElwGei&_nc_oc=AdprK_PK0Nwap1WZKAR6EzWK9mdO64QiV99sooZWB0plz2-d4sMG_4NMbyLaAqvMjao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs-erUYVpzS4zCmfR58l8FiMPLAAfae3pxelqa3l9xQw&oe=6ACB9583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1098685116439919", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673531334_1098685119773252_8139802005696041643_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzcnZncgSN0Q7kNvwF-csPY&_nc_oc=AdrLBZpzRStPq8Vqq7jz_KxmSqOTKF_lM-MoOR9rJClcKALLjotvVdgQkNs9J8DdeXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Mkkg7uvb1GAdAW8lfJ6y8cEK0icaIulr5NfPhCWDew&oe=6ACB9933"}, "display_name": "VPORT", "keywords": ["Concerts", "VRMusic", "LiveEvents", "ImmersiveVideo", "VideoStreaming"], "long_description": "Experience concerts and live events on Meta Quest with VPORT.\n\nBrowse artists, venues, music brands, and upcoming or past events. Watch available content in a resizable 2D player, or select Watch in VR for immersive 180\u00b0, 360\u00b0, or stereoscopic viewing when supported by the video.\n\nSearch the catalog, follow artists and venues, resume playback where you left off, and use VPORT credits to access premium content.\n\nVPORT includes privacy controls, data export, account deletion, content hiding, and tools for reporting concerns.\n\nAn account and internet connection are required. Some content requires an in-app purchase. Content availability may vary by event and region.\n\nSTREAMING NOTICE\n\nVPORT contains streamed experiences and requires a high-quality internet connection. Interrupted connectivity may cause latency or discomfort. Streamed content is provided by VPORT and may not always be available.", "short_description": "Discover live and on-demand concerts, browse artists and venues, and watch in 2D or immersive 180\u00b0/360\u00b0 on Meta Quest. VPORT contains streamed experiences and requires a high-quality internet connection. Streamed content is provided by VPORT and may not always be available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thevport.com/policy", "developer_terms_of_service_url": "https://thevport.com/terms", "publisher_name": "VPORT LLC", "support_website_url": "https://thevport.com/contact-us", "website_url": "https://thevport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDIN
, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793530698, "id": "39674825465496160", "version": "1.0.16", "version_code": 119, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39591871650458209"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2273595783463524"}]}, "change_log": "VPort 1.0.15 (118)\r\n\r\n- Restored playback of supported spatial videos that offer only one quality, including sources above the preferred device quality limit.\r\n- Improved memory-pressure recovery and playback error messages across flat and immersive players.\r\n- Prevented manual quality overrides and pending live-camera checks from bypassing a terminal memory stop.\r\n- Avoided an extra video decoder during live-camera readiness checks.\r\n- Improved quality selection and notices when playback cannot adapt to a lower quality.", "created_date": 1793263428, "id": "39591871650458209", "version": "1.0.15", "version_code": 118, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39591871650458209"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793184117, "i
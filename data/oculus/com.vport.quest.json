h&_nc_oc=Adr2KIzR0vjmYvad3jYcpVlGnXyHW1-E5hpyfct3SSDpy7d74o3-h9USVRtUdFzIXkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcNyf90tMQ0qSfZzeVSWh4ESvrewV4_khiZ-CXoKTLSw&oe=6ACA4C48"}, {"file_name": "01_home_discovery.png", "id": "4044005829064370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_4044005832397703_3253744896412053559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKX0jUFv_k8Q7kNvwHHzpfR&_nc_oc=AdoOFU9Q228fE5ex9hTH-VDqwaQ3fpJfhU-ug6DhXymQtGhMNJRF1VBu1jP6HqvKYKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOlEx3XWxXZlUaF1c1NnxiTzEPtaWSKfTXZbjz7H7LTA&oe=6ACA4403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1098685116439919", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673531334_1098685119773252_8139802005696041643_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzcnZncgSN0Q7kNvwGaRCMP&_nc_oc=Adq1ZZL2yIhL0DzcaSLmi7H-dsJ9MDVda6Hd8c1Cm0QhK05Bi6f5xVbmuFinj9df0oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnzmDu_Pwogfcn3TFIytKOcTIqHofwB7B-_EFWXsHOSA&oe=6ACA47B3"}, "display_name": "VPORT", "keywords": ["Concerts", "VRMusic", "LiveEvents", "ImmersiveVideo", "VideoStreaming"], "long_description": "Experience concerts and live events on Meta Quest with VPORT.\n\nBrowse artists, venues, music brands, and upcoming or past events. Watch available content in a resizable 2D player, or select Watch in VR for immersive 180\u00b0, 360\u00b0, or stereoscopic viewing when supported by the video.\n\nSearch the catalog, follow artists and venues, resume playback where you left off, and use VPORT credits to access premium content.\n\nVPORT includes privacy controls, data export, account deletion, content hiding, and tools for reporting concerns.\n\nAn account and internet connection are required. Some content requires an in-app purchase. Content availability may vary by event and region.\n\nSTREAMING NOTICE\n\nVPORT contains streamed experiences and requires a high-quality internet connection. Interrupted connectivity may cause latency or discomfort. Streamed content is provided by VPORT and may not always be available.", "short_description": "Discover live and on-demand concerts, browse artists and venues, and watch in 2D or immersive 180\u00b0/360\u00b0 on Meta Quest. VPORT contains streamed experiences and requires a high-quality internet connection. Streamed content is provided by VPORT and may not always be available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thevport.com/policy", "developer_terms_of_service_url": "https://thevport.com/terms", "publisher_name": "VPORT LLC", "support_website_url": "https://thevport.com/contact-us", "website_url": "https://thevport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35798886733090072"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1031665722826447"}]}, "baseline_offer": {"id": "1031665722826447"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791150180, "status": "PUBLISHED", "id": "1031665722826447"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "389504960279291
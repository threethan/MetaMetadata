", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628446_1633305308262692_1243888566926167690_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLEnRMC-KqUQ7kNvwFwp9SF&_nc_oc=AdoAsTgadsKbHEecnuC0eU8ONo5msV2fFLE4zjbga5M9l2Ndb_oCXc_45MsGpjUxTpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMt0EPTfQtng65e-sjK6U6a7jEfhmfh5jML5TgJ4E_g&oe=6AE0AA30"}, {"file_name": "com.oculus.vrshell-20261012-211548.png", "id": "1657168776039752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619382_1657168782706418_6824835797414258685_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-KX-6ADqnEQ7kNvwGILaQ8&_nc_oc=AdrA5uW3wOBVBM_Ar-2hrxmddoPfldgDrZZtq6QfnbRAqONU2HY_M22Z8pThCbzuTtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx_jOuqQPA9GlgDRdJwxpccMJECEGciKAkO6NjQukL9Q&oe=6AE0A12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1098685116439919", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673531334_1098685119773252_8139802005696041643_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDLSrhysvhwQ7kNvwEM6iBy&_nc_oc=Ado6RvyBhGnog6B_46buMfDzTRWEJSzof-BHmn2BcbKQ3UF_ep0v0BVQ1KID5puWBBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJAo5pRoWPhu8anQVhZCZEqS5UrXpA8Tg5P6ZeNQAtBQ&oe=6AE0B133"}, "display_name": "VPORT", "keywords": ["Concerts", "VRMusic", "LiveEvents", "ImmersiveVideo", "VideoStreaming"], "long_description": "Experience concerts and live events on Meta Quest with VPORT.\n\nBrowse artists, venues, music brands, and upcoming or past events. Watch available content in a resizable 2D player, or select Watch in VR for immersive 180\u00b0, 360\u00b0, or stereoscopic viewing when supported by the video.\n\nSearch the catalog, follow artists and venues, resume playback where you left off, and use VPORT credits to access premium content.\n\nVPORT includes privacy controls, data export, account deletion, content hiding, and tools for reporting concerns.\n\nAn account and internet connection are required. Some content requires an in-app purchase. Content availability may vary by event and region.\n\nSTREAMING NOTICE\n\nVPORT contains streamed experiences and requires a high-quality internet connection. Interrupted connectivity may cause latency or discomfort. Streamed content is provided by VPORT and may not always be available.", "short_description": "Discover live and on-demand concerts, browse artists and venues, and watch in 2D or immersive 180\u00b0/360\u00b0 on Meta Quest. VPORT contains streamed experiences and requires a high-quality internet connection. Streamed content is provided by VPORT and may not always be available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thevport.com/policy", "developer_terms_of_service_url": "https://thevport.com/terms", "publisher_name": "VPORT LLC", "support_website_url": "https://thevport.com/support", "website_url": "https://thevport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39152857277692984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312231_28207663935539952_551206366659550568_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ibtuwm-WMP4Q7kNvwFCNP2e
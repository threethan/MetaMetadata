quality internet connection. Streamed content is provided by VPORT and may not always be available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thevport.com/policy", "developer_terms_of_service_url": "https://thevport.com/terms", "publisher_name": "VPORT LLC", "support_website_url": "https://thevport.com/contact-us", "website_url": "https://thevport.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35798886733090072"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1031665722826447"}]}, "baseline_offer": {"id": "1031665722826447"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791150180, "status": "PUBLISHED", "id": "1031665722826447"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39517688034543238", "version": "1.0.13"}, "id": "2273595783463524", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39517688034543238"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2273595783463524"}]}, "change_log": "VPORT 1.0.13 (116)\r\n\r\n- Improved Google and Meta sign-in readability with opaque progress and account-creation dialogs.\r\n- Improved account-creation layout with clearly separated buttons, a scrollable form, better text contrast, and support for smaller panels, larger text, and the keyboard.\r\n- Added missing analytics for venue social links, artist biography expansion, venue profile navigation, and social sign-in verification steps.\r\n- Aligned event-to-venue analytics naming with the current KPI catalog.\r\n\r\nIncludes the playback memory safeguards and pending-purchase recovery behavior from earlier releases.", "created_date": 1793021286, "id": "39517688034543238", "version": "1.0.13", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39517688034543238"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792954580, "id": "39499243113054397", "version": "1.0.12", "version_code": 115, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39517688034543238"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2273595783463524"}]}, "change_log": "VPORT 1.0.11 (114)\r\n\r\n- Enabled Google sign-in and registration through the Quest browser.\r\n- Improved immersive playback stability when opening or returning to videos from the Quest shell.\r\n- Reduced playback memory pressure with more conservative automatic video quality and bounded buffering.\r\n- Improved recovery of pending Meta Store credit purchases, including the account information needed for backend verification.\r\n- Added clearer purchase status and retry guidance when credit confirmation is temporarily unavailable.\r\n- Improved protection against repeat purchases while an earlier purchase is still pending.\r\n- Clarified pricing information for localized one-cent developer test offers.", "created_date": 1792949506, "id": "39497657053213003", "version": "1.0.11", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35798886676423411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39517688034543238"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2273595783463524"}]}, "change_log": "VPORT 1.0.11 (113)\r\n\r\n- Improved immersive playback stability when opening or returning to videos from the Quest shell.\r\n- Reduced playback memory pressure with more conservative automatic video quality and bounded buffering.\r\n- Improved recovery of pending Meta Store credit purchases, including the account information needed for backend verification.\r\n- Added clearer purchase status and retry guidance when credit confirmation is temporarily unavailable.\r\n- Imp
u92gNnw_pNmOHxa3xanjNM9FaUZh7Y7S3N5mBBKZlSHA&oe=699C320D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjVwaloxfCMQ7kNvwG2pyPL&_nc_oc=AdluYuwdGJb1GF5rFUWK0PUK9R-vT1trYpTdxahoh4-3GUyPwzCrdNavYspA6CNKZCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu5UPySJLW3sPAwnrnUHa15cKbm5eIBg04RLPXLk4Fiog&oe=699C3634"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0zTiAZwAMgQ7kNvwFHx4W4&_nc_oc=Adkjc3_4kSFLC97cs0RbAwGZ4rHhEMZqMJWfKCg3oBnO8g4XMFqz8eU9g_R19sQFtIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvlgsTWcYRJnvLFl6mMQnj1BxXe9ITZNNcRUb1CMhXxtA&oe=699C4295"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "de
05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJgDx40wVHMQ7kNvwEFC-vb&_nc_oc=AdofgEpMz-RMdS-AzU2K8sz1ixPWhUF2M2PsGEBUIsiH5uxASCqrkmbNkt72UEHDYOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbmO15WTXI0eIr4WEPme5R_RBMG7BbP3gQBLmrr2QJ0w&oe=6B01CCCE"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPrGzWa4bFwQ7kNvwEDlA4w&_nc_oc=Ado9C8ltsuqkG1aDx_fCGPHtKwIq05lX9skhm-xn-UcqoKOy_k9bGuh7EWKw2_Z3mUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVpcFw3-KWqOkRif43Fn_Odh2VQqzOWUg93geRoKYDSg&oe=6B01D685"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYKxsLuNjpEQ7kNvwGO8b1j&_nc_oc=Adr2MSoXEtjL0PVCzS2QKkErKQ7NOxUbYoLCtvtJSxccA5Qqp3z6d5Uyp8EWoWZSrfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFKWc8tYcaOerieHIBbUxImCXEoXjMh9hBWHeDUnYXyQ&oe=6B01E90D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xuf-1Nmaal4Q7kNvwHaADDp&_nc_oc=Adr5PSy72zAELKdOxVrGHz8vR85sA0v0f099cWCH-8w0EycW-s84WtD5adPM3oYmPIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdQiZkjIOBqZAKY82C9YzLb_MXm6jRPzn3D2u4KId0wA&oe=6B01ED34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm6NPzee3r8Q7kNvwF07RcM&_nc_oc=AdoIY0HpDrIT_1kteV8ITjbz4T-P2Xx5Wkya_YimAarn-aIqaN_op1XMx8sqSEI2Ivw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0oC3FKLK06FGvpKEa45zYe0PXKC-YFkZrjxXWjI5zfQ&oe=6B01C155"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
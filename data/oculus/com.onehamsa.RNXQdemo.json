vMp_wBUDrnRw2VZ0xpgKgipavdNuGAGxfqsYe35K0YWQ&oe=69A2C98D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p84Lcn8gQbwQ7kNvwHvGvlm&_nc_oc=Adnw0WVIfVdmj9BIIkyvR2Pzf_Kqd-WgRTa1TPlSwkU4U79xBWSDm_ONupLMt_gi4_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugK1n6sdYCyGHiSKQzNyGj-xFx37MZCdx5vPl9iSbXtg&oe=69A2CDB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWoHyTPFCeMQ7kNvwGY_K6a&_nc_oc=AdlRwZewk0HS0VcDKHP-92OSUeRM90LqG52tWg2WR9qoEMMAjUv9_EL6uD2G4qc0aOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRM4SyJleFhoq7K4KQfwG9Qv64xH1tGVU8vubwOVcVzg&oe=69A2DA15"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "de
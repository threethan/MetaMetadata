05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqmsBaxk-58Q7kNvwF39Lpz&_nc_oc=AdofG3y1mNGxtnPIVgLb2PbASiWRR5xo-OVZtT0jKS_M6oi9dWDKSe3j4Zn_kAdQisE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlmUQudvXjf4vvsvKp9sbyl_WNuAgLpJN_TdtiF75v2A&oe=6B08644E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_PeVM71_2cQ7kNvwFmr-VP&_nc_oc=AdqJYnHp7wWDUKDnX2uMFZnQpBYAwFIacFmE34F3djgA2jC25R7qxvzXQZDWd725_vI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAyxyQaepgoPohbGM4VpEgrcUcqxEAQBXgda4LxNCKeg&oe=6B086E05"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUsAkSql3hYQ7kNvwGYAhYC&_nc_oc=AdpjHRSDrF8pghUpGapeS_uaSRPU4xskaKkHIcBBFYi2l240XGaWyRppT38Iks39_-Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTJcoZVm_8LfHopcZzaXFH00hxlLifFQpoGdudUzGxuA&oe=6B08484D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyePJToVw9UQ7kNvwGydtL0&_nc_oc=AdqTL8xB7mse5KWb8W7xL0GTqHCzqeu3AHMI5Y_3pwVAZepVuy0u7DPFJ7PWK__SIm0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcVIEuOAo3nx0LrFtH3XuoWsV6FN8-B0oieDhUkuyDaQ&oe=6B084C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmmvofX79bcQ7kNvwGbNZCK&_nc_oc=AdpFFfKfFg_O-zn_l71MIgnhIXaaiwmwjBAu4RdsoNnXtXj9PhUsS_K2TziXvKgqlz0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDXiL2FK5en92_aRNRFaizfVMK8M800MLPN7uKzSv2nw&oe=6B0858D5"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
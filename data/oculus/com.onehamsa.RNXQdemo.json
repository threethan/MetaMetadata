05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVtxOyYwVrUQ7kNvwEgPGiH&_nc_oc=AdrfRLa-ATk2M70IkFVeYSzaVfyTqQX1pNRl6xRP_zV97SJRUmK5bXfo_fM_hLXf0HY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl9De9C8uej7FKSAh-_O-Csxu5A_H4xrzbvxuUpQ1omQ&oe=6AFB354E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyjOxgKsz5YQ7kNvwHhVXRW&_nc_oc=AdrdFywt-DA6DpAB_sPRjn0wohiiOsEvs4-kACm9BIvblhJna2d2pLIjAdgzjC1jtI4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh5piwGLwhsD0HeqpDldRK8KCofAAQHb00ocXb7TpR2Q&oe=6AFB3F05"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5isFqX4aOQQ7kNvwEUrELX&_nc_oc=AdoIL9doR_z9Cbehmq5ss5mefLu_b1-aAzLFdr45KQdy2ToHF5U3qIAC0Xd9vykuGA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWVutI-HiCFMh1N-Z3GGMSnOVxMIg9flncE8m6iWxMpw&oe=6AFB194D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_vC0uigtGQQ7kNvwHxTJoY&_nc_oc=AdpCvDfUyDoyAHX02eoC2EM7QMHCfH9un4QN65BiAf4RH0xOMVFtkG8l1exGITfFGgg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPWY3_5kCiD4mf2ezkuk1qytXVJyZd8LbcLvGiV0cCSg&oe=6AFB1D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VykjuvAx8R8Q7kNvwHjo0kt&_nc_oc=AdqB3wV0o_8zQAMBn8hFjEbmbWTqUdCZlOCVW9OChDQ45GYOxFabJZ4Wmtwxu5en0io&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV6SMKtHzKzN2tBfTaHrKCpeJSoXGgW5_IVDIPU9BoDQ&oe=6AFB29D5"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
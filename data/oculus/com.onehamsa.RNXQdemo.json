UvxWmPaSni7T1efWj387W3TOKswxeBeGjpNQ&oe=69F3510E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGSw7AiaNEUQ7kNvwGhWVWm&_nc_oc=Adoqpxb4_fTSbtEoePKIOcqqfAzYt-q47sG8wNX_iKB8QKQhIGX9GuYT_OEh1XXXQ4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af157X84hTjN0ODi1yGH1l3sbZ8xXVT3O9Y8N-0IV9wmlQ&oe=69F35AC5"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfZXbYk_VM0Q7kNvwEb5xGj&_nc_oc=AdoGZSltUcE-m3OVEoOKsZhlYvfPCg9rjehXHsRYNrfJ5usv7AvCSuIp13TmzH1tf_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MoLSh13kRJZt57BnGXW-uQyZYJVidTJ2L4ERWCKX-DA&oe=69F36D4D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0F5-NxOADAQ7kNvwGZt7HA&_nc_oc=AdrZtL5PxgEh-UMdPXb0DD7QwiFwjWFw6HydET7IrFLss8ur7n4THR8GPyzRcMfuL_A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07abs1fIap3apq-RTuyAyNK5kfqdD2t9RoL__Z93Hulg&oe=69F37174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buIJAdm0I4gQ7kNvwGM3bA6&_nc_oc=Adrb-Ui-DEsldoDj9Nma8cluuzO0DCwayRt_3GOCrQZl8tqGQyhezWSWdPO1Qw7QgxU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JE2s6ar5f3bSDmzKRFkNyRxPN86A1A966REmnQi3PNw&oe=69F34595"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7225140330898906"}, "review_messages": []}]}, "
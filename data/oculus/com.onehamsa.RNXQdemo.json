v8hPK36e2Jphqh54MjEA0WVVMq5DHGCRPGW2Q9mltjUg&oe=699D838D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjVwaloxfCMQ7kNvwH8gWwh&_nc_oc=Adlvwe5r9IugjDbaSJ2MmGsAUVUMxwoPajDfcVdF4MTn5CR_sSY7jKLzN5bNtbZ8NbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2A3UvNYOK9LIqfbK02tg2Gx9WHxjNLm2OFevf4EutYQ&oe=699D87B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0zTiAZwAMgQ7kNvwFMEbHT&_nc_oc=AdkqpEOVt1FBoLrsGl6I48amSCIdxpuVZnt-WgEigjUmfqCVDAKo4ilIsdP3EGBeSAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvS73h1GyoRIfvkP7WrOqDtlhXtxfZVrygHuHv-yy0kOQ&oe=699D9415"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "de
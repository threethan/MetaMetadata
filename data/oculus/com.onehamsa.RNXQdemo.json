agfyeGrNCe5VoJO1xj724i1iwBS6rNd7Yqkw&oe=6A80618E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac2nf0Rq6t0Q7kNvwFYknAI&_nc_oc=Adp9xlgIo0oUcX-rAv0xT0OmiVfP7711ggZkCUUd3AsWGrO-TMs1ePcWediZOTUrpUY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUcMdhcFztZDSR6hjq9aJRw3egxlvaBGXttdgn4Ict1A&oe=6A806B45"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld1taCtFhc0Q7kNvwH4E7nO&_nc_oc=AdqEaiVWyfbLu-wLJVwF_6Xt87-0nvvib7b8m9vW0XKzkjeiJEh-K2OdgfyCySTx4Jk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHoUUnNeJHeEJ2-aOnZALZJrOWZwNHwaAitada1xM_YA&oe=6A80458D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5MnaVc_ggsQ7kNvwHUiup2&_nc_oc=Adr8HmSCDmInt-m7X4_bKqAveIBrUcgl3n5AIvkxWxTIuzGzasSC3B88mTLHm07zu8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo02P7VVFVh9HIrUBntfsScB-QE8Q7I_c2gcYHXASiLw&oe=6A8049B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooYpEvnEDpIQ7kNvwHJcK9P&_nc_oc=AdoL_5RyHz0XtPDHv2RubEMWFmPzMHdZhptjEEFgjMEQWiV_R_v4sbVWYL8Dtg0d0x8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_kSnYFq9eop5rWHYiXfaLLF44NEbHk_8Mr1gjLcm3A&oe=6A805615"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7225140330898906"}, "review_messages": []}]}, "
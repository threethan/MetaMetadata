&oe=69BE950E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtpjH2Zpr_gQ7kNvwHBlUdW&_nc_oc=Adl6Cz5jaJuqyNzt4g-XKZQ-PJCkZV-2QRQ5OABXcaiDZpfZ0RqqCANI-zf1Rj2DjiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYgvgkV3hCJyFiGDGdmSaJQpHZGwxtBCftG90T_JhFCA&oe=69BE9EC5"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix0Jnr3YU84Q7kNvwFv_Oze&_nc_oc=Adke-e3MQ3EQUkExcE6ENW5PRa4wfl-0se4aze7ZvspuqtxI582bLN9Rr3Atg9-mjkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrKGQYO7ppCqobirNa8rkckEKUrmEN-_5YlCoV-Js90g&oe=69BE790D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01QCz-qr3BYQ7kNvwF7ETzM&_nc_oc=Adm29eYtaXwGrcjaJaXiUKeW2ctTYFC0ylnv6ZApZbmPww_FOFhZLtjVmMBY4gEK_Qs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsOQL2F28qyZXhQrVMDnixRNLPXbDToUwi6siAkaMoAQ&oe=69BE7D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFKl-3V3dboQ7kNvwH0wTRP&_nc_oc=AdnDEq1ViIy5SlBdKSKkqIuEBTMcoecfVWy82Ai5JtO11Uut-Qxmftu4vJOppA9FwLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxliv3pznEGT17fyTNRqmJHVeNd4GM0QsDoCBsc5c6KXA&oe=69BE8995"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7225140330898906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-
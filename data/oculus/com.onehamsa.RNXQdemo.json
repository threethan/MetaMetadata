05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OudhODD9_JoQ7kNvwEGgtmH&_nc_oc=AdoVRkXjzNew5SD4p4c9ALy-F2KaGeC7d7ZJzJvAko9XrFOpXidd-XtSbXldQTnBhN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM02OkIJxLCW0avOoDCQVCb5iXTK9w2lrI8qulo4D8Rw&oe=6B05C14E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTSmYUi2_GkQ7kNvwGdaQLm&_nc_oc=Adq8gpf36u8xczZPOo5iYtpyvk3_Zghi8zMUQ6RWKftSiGwzncnL5NHIqBWaxtunXcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbCWYbp1qTAKBGGugv5LG-EBuRxhVuA6du4ueefCM8RA&oe=6B05CB05"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8sNJNI9qyEQ7kNvwFxa3v0&_nc_oc=Adq9I766c37j-SEYa8ixE4_11UW2Jks0RoZFXebpTbTuFzpMInXOeKuKzcFHhQJj364&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ16YO7RTDon8qWELiYUeKm7psAx5LFkCQb9S5No2X68A&oe=6B05A54D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7miZd2bZi4Q7kNvwESB3Qa&_nc_oc=AdorZ25JMA9w-L9HLWlXpSBd25zrM_PxOLMuKlaoXyWH290QzeRmwpq9-GY0yXao5tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpgwe7SiLogSlqKTJK7q9Mt8jDSZCO5EBqEXA3hcLZ4w&oe=6B05A974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbshZDNYEyEQ7kNvwHRGrvJ&_nc_oc=AdrXvCpdz9KxllC5OJH-t3NSS70Xfu16Szeu7JqbUnr4GhdJsbx_LWza5Wf4lK4rzQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFCdtGXrMrDqaUcntgdRriDTwsWz3HtQVv6fOYRMNr-g&oe=6B05B5D5"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
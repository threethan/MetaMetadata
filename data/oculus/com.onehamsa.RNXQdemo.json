05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po2b2QCo4fIQ7kNvwE7Fk_s&_nc_oc=AdpU_l_PAvahft34GS8AgoxBKodTZjvgDePY1P9VS9LcrJSl0Y7qaqvYWsb13YKHYJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDJvtS96yYhtB0-Rn09WaeMEZ4TX9PdyFyyGpYWqCLpg&oe=6B0DAA4E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh5XqWfAPzAQ7kNvwFNIKka&_nc_oc=AdrRcoFP54KVbhKYtwfgNnXJNONAtGO52ZBvHsUHrhA6JVM9e7rJ7zf_5GzGO3tRLzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcbrYXpiw358hx3Se9PGX1rWY4FhAIA_ffZMPV56a-Ig&oe=6B0DB405"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybdRjWjAKKIQ7kNvwFM6oJK&_nc_oc=AdqDZuxPkFTaxFb7PJSp3u1Im8tLwDsf0M-rUHFCXLiQ65KH95CFGyJ6RRzdPl2Yxxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9aGg8djv-jkuXe2wBSUDUF1v9qlZyiMy-u9ogCRIhCQ&oe=6B0DC68D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AIxn9gOs_8Q7kNvwHWFsRv&_nc_oc=AdokGTh7T7cp1kMFW-WGsFuJfYvSYDIXVufxVuMUuUzKtrxuWQP0_kEXs3Wz84ZcZro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTASwOBaN4KCOxyMxP0pF3qomRBej8sN6NvHYoa5PgWdQ&oe=6B0DCAB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_8zR2YWB60Q7kNvwHYej1i&_nc_oc=AdqIAxTHaemY_eC8iZ_Bg_dRzO8rs18s9dIh08KcpTah-QCVcrDWu_Fmq-UCMyKM6jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfUJokXntcNbObIg6SIhFOu1JBW_IiOeSBQFKy3Ffj_A&oe=6B0D9ED5"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
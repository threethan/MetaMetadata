&oe=69B7FD8E"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrGUrV7ttlMQ7kNvwHqsbmE&_nc_oc=AdlWgD0Jlv0KJV1XzmXq_SFxrWC8g_9_xfZgPYCeNrBL6k-YYpgMSMypJdGvBEv7RzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymGC5kdmHqFwrqaXtML2gy3anQL1d34w5KFt0Vdb7Pxg&oe=69B80745"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj4wsRV1ceEQ7kNvwHUKqv2&_nc_oc=AdnEaCdGJ7dDx0SaxTwebPbuI3M6lH9gmdMn-x4JkXnASoy2_kCEavOzBYlKqZ77wM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfysO3oGJC5-ICWhN2EuY5vz1_EZxRMJx7anQ_9wQnE50A&oe=69B7E18D"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmmJ-kY4th0Q7kNvwHFK2IW&_nc_oc=AdmUA4_8ksIY0snN_cR40yX84KuHFpQHqIpPRzdoVCohN8OWywr-EMftoBLHu8nc2-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwf5duA7iisOzxBKXf-m7kq8PsPG30K9mNku7RidYzWuA&oe=69B7E5B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYDP-kbqAKMQ7kNvwFBcJ_S&_nc_oc=AdkGcKJs3tPRzGuCFKScdeRbSVfcb9dPrXphXxJUwqOl5R80fwf7vsSqkcLgPb6A-4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxccorXjYSYzMPyLwA8LxGNutpwo4hIq7qsEsbbrRFYiQ&oe=69B7F215"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7225140330898906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
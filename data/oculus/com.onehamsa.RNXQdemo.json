05&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rED24rvqJY0Q7kNvwGHmdCF&_nc_oc=Adp40CTeJvFvEIRTLVf6CVuCF3Ynp52GLhx-lBotvau3dhKsv7bQQRh4rEqPYnx1qUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwtuP4nCHjfzMcWUqIC0Tu4jSy7FLnmVFxxJCl_-xYIQ&oe=6AFC86CE"}, {"file_name": "Screenshot_03.png", "id": "163202132145458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982586_163202135478791_5945469478116710326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyjOxgKsz5YQ7kNvwFet6Ub&_nc_oc=AdrrPLLGxOuKBL0EBc6ip5reQjOLOxN6OrWxnpHIZbVgdnFsypGNeWrGxDPeLNXxctg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQepDvtp-8PMyFYdAB_WEnuUyjVK_Tilec2doLbWaoXeQ&oe=6AFC9085"}, {"file_name": "Screenshot_04.png", "id": "3931807113538723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_3931807116872056_4086830938543199693_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-r9fDwq940Q7kNvwFtIUWJ&_nc_oc=AdrYMpxzhJZkysBJxh-V1yLHxsAB4a3FZyHMwX2mo8nngtzwIPWAtYQ5WeSzTrF3ANw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8HIFKuTR7Hj0mDEljm-Tk4qYp93ygUmAiMBMc8s9aIA&oe=6AFC6ACD"}, {"file_name": "Screenshot_05.png", "id": "165207392075673", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982495_165207395409006_7079079192133666548_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_vC0uigtGQQ7kNvwHEaW4e&_nc_oc=AdpBooZwLM51IQIpmD0Eu28HCnLO8C5apQZxi_X1H5rYUbjIE3cWVYebey4pYTGMycU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRflc-nMAKjA-sEFRMgI5opXdT17qSSHoEmhFJoHeDR6Q&oe=6AFC6EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1049872652172517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984472_1049872655505850_9035876489653876993_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSddHiXb9OMQ7kNvwFAdSqT&_nc_oc=Adp29MJvF-ZSqogl8l0xAWBFFMJeVBiZfDdvP0tQcRVoUY-EP9V1LKUcWPiefu43kCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBEeEEpG0q37asp2KcgDNeFI-Nt9J2NRFfxBAciTSYjg&oe=6AFC7B55"}, "display_name": "Racket: Nx Demo", "keywords": [], "long_description": "Racket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner!\n- Versus & Co-op multiplayer supporting cross platform and multiple devices with the same user!\n- A sick original soundtrack and the option to play your own music in game!\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\n\nBut this is no ordinary ball!\n\nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path!\n\nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nBe quick and plan your shots well. Learn to control the ball to perfection.", "short_description": "Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
 people, explore beautiful virtual worlds, enjoy real-time voice chat with Meta Avatars, and build genuine friendships."}]}, "developer_name": "WWTM Productions LLC", "developer_privacy_policy_url": "https://livesocialvr.wixsite.com/livesocialvr/privacy-policy", "developer_terms_of_service_url": "https://livesocialvr.wixsite.com/livesocialvr/terms-of-service", "publisher_name": "WWTM Productions LLC", "support_website_url": "https://livesocialvr.wixsite.com/livesocialvr", "website_url": "https://livesocialvr.wixsite.com/livesocialvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27920637524294665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499310646_1782480502741237_5140436710487657422_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GTtdIhpSeEQ7kNvwEi7b2k&_nc_oc=AdoXjBwj_CVr3yd3qEK1hbhvCxxrp7zy07rxTlhTutZReybYGGKHTpd6eqTSwPKQdTk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6AHx_wKzyzX7unanI7MuD9lsVKCF3pj0EE1kh3cu_dg&oe=6AAE9F3D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LiveSocialVr", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1788
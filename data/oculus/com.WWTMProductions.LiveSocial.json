14just beautiful spaces that invite you to unwind, share stories, and truly get to know one another. Whether you\u2019re catching up with old friends or discovering new ones under glowing moonlight, every world feels like a private escape crafted for genuine moments.\nThere\u2019s a quiet magic waiting in Live Social. Download now, step inside, and find your new favorite place to simply\u2026 be together.\n", "short_description": "LiveSocialVR is a social VR destination for adults. Meet new people, explore beautiful virtual worlds, enjoy real-time voice chat with Meta Avatars, and build genuine friendships."}]}, "developer_name": "WWTM Productions LLC", "developer_privacy_policy_url": "https://livesocialvr.wixsite.com/livesocialvr/privacy-policy", "developer_terms_of_service_url": "https://livesocialvr.wixsite.com/livesocialvr/terms-of-service", "publisher_name": "WWTM Productions LLC", "support_website_url": "https://livesocialvr.wixsite.com/livesocialvr", "website_url": "https://livesocialvr.wixsite.com/livesocialvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27920637524294665"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1018127971102538"}]}, "baseline_offer": {"id": "1018127971102538"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788226620, "status": "PUBLISHED", "id": "101812797
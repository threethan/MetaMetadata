64.5771-25/673531334_2224078215103088_5960945652148431402_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-275kMf2V8Q7kNvwH2v-3c&_nc_oc=AdrLQYc_odOisb0PNK_M8y0DR8E9SMtZnq-i5CEeW0jmgrD0knAPca5GLiikORi-hMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0fE_SdTwYTQDtq9lsXQ5-S0Z2GkTytf9DvyXvl9zIbA&oe=6B01E5D4"}, {"file_name": "T H.png", "id": "1425366352801051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1425366356134384_5700248382405826657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rT1xwTgAyqQQ7kNvwHGaffy&_nc_oc=AdpB1DtrK5jaA4iCWAhLjoYwXYDYTBWXTKH4XQR2fT9gDsi8xInj53V_nPZ-6Gx3H4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfphbGAc5PMyXGrK-lbviuRz5bgv1d-P1CXz97YZjcEg&oe=6B01CA54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560  1440.png", "id": "1719010366061568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313074_1719010369394901_8087814773219516123_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEcynPGlcYQ7kNvwFnBVfh&_nc_oc=Adp4xdycoSJSt5P4jqC-hakq55YLM_diHKWKWeqgg3Er1Idp4aZFmm-AcejmK7vtfa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1i1X6f05fVvCc9dscZQglRIwtGGlZFJ1KvF8LR3Wo4A&oe=6B01D39F"}, "display_name": "LiveSocialVr", "keywords": [], "long_description": "Live Social is the metaverse destination built exclusively for adults who crave real connection. Using your Meta Avatars, explore a growing collection of breathtaking worlds\u2014each one thoughtfully designed to encourage deep conversations, laughter, and the kind of relaxed mingling that turns strangers into close friends.\nNo pressure, no performances, no distractions\u2014just beautiful spaces that invite you to unwind, share stories, and truly get to know one another. Whether you\u2019re catching up with old friends or discovering new ones under glowing moonlight, every world feels like a private escape crafted for genuine moments.\nThere\u2019s a quiet magic waiting in Live Social. Download now, step inside, and find your new favorite place to simply\u2026 be together.\n", "short_description": "LiveSocialVR is a social VR destination for adults. Meet new people, explore beautiful virtual worlds, enjoy real-time voice chat with Meta Avatars, and build genuine friendships."}]}, "developer_name": "WWTM Productions LLC", "developer_privacy_policy_url": "https://livesocialvr.wixsite.com/livesocialvr/privacy-policy", "developer_terms_of_service_url": "https://livesocialvr.wixsite.com/livesocialvr/terms-of-service", "publisher_name": "WWTM Productions LLC", "support_website_url": "https://livesocialvr.wixsite.com/livesocialvr", "website_url": "https://livesocialvr.wixsite.com/livesocialvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27920637524294665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310646_1782480502741237_5140436710487657422_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWHBm30DKgQQ7kNvwH3gtDw&_nc_oc=AdroFvzY8MCtC33yqN9kxAHXitAVRKot8XLerTaQKrBsgce9IJck6alcir4nba928J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnVSksv5LxJLNXfzZX3my3xQpjTuN_GOsrYJpX3zgZSw&oe=6B01E5FD"}
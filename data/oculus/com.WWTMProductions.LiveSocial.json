ke a private escape crafted for genuine moments.\nThere\u2019s a quiet magic waiting in Live Social. Download now, step inside, and find your new favorite place to simply\u2026 be together.\n", "short_description": "LiveSocialVR is a social VR destination for adults. Meet new people, explore beautiful virtual worlds, enjoy real-time voice chat with Meta Avatars, and build genuine friendships."}]}, "developer_name": "WWTM Productions LLC", "developer_privacy_policy_url": "https://livesocialvr.wixsite.com/livesocialvr/privacy-policy", "developer_terms_of_service_url": "https://livesocialvr.wixsite.com/livesocialvr/terms-of-service", "publisher_name": "WWTM Productions LLC", "support_website_url": "https://livesocialvr.wixsite.com/livesocialvr", "website_url": "https://livesocialvr.wixsite.com/livesocialvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27920637524294665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310646_1782480502741237_5140436710487657422_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EioqHLS--H4Q7kNvwEGJCgK&_nc_oc=AdrvlWSud6q5PMkzLGUTiaB9mh7QX2veJCoyebtn7iQYugz3gCtnsbSsqYSZNr3YBzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRW8Rr4epkB9DZx2VYcrnmbn3V9rYQSz7YSV9MnRjviw&oe=6B09CEFD"}
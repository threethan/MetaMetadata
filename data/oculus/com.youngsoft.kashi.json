CkNIQ7kNvwEgQPsp&_nc_oc=Ado_vgCKp_FaWGzjMAC0mvbxzSBku1DCUuSX5xiCQ6PyjTYXi5mHVQ4LfZTth3p_GqY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OfR4CnYx_wniRGtrK52q_w8ctmh_3qh0Q6AJnVvKWzQ&oe=69EF5602"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8BBVINriEEQ7kNvwG_u1af&_nc_oc=Adof9yodp0G-2hvgnYizo5x9qTRktEwy-iExQZYtp-DFe5nim6yPeCRiHWRZ1Ar2Q4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2in0mbA67vly-6QXOD4fz0mWvPzxwBTwmmAPMEFvAnlA&oe=69EF5214"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1pJIZjZEnoQ7kNvwF4-CrC&_nc_oc=Adq47KpdFj7ANpbPWKh_Yddr7etHpO_IkCO4c2uVJA4OD3PwHkWJK7-Gsek6ZqkoWzk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3r_4gLX-eml7B1lvDhUMD_bCdSzVNCir7ninCye2OxBA&oe=69EF65FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYO_ZIeOR18Q7kNvwFGC17F&_nc_oc=Adoc8Y0OtfP7IQBZ2Qn5co1i395C2SfbxsUN6fh9L1h5qU6oKRpvYJ8SjetbgPUx3Z4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_DU5ANGWJ9HFqAPMlQaj_HOllhU6NUWAo3DxRZeBQgw&oe=69EF6644"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxtr7zShBuYQ7kNvwGvTiSA&_nc_oc=AdqWraSVfgGoQF3PC4dAJNj-Nq22FIUgDInGKX8e6KIh85BuwAPUgJm6_xndLS-45M4&_nc_zt=3&_nc_h
-d7AQ7kNvwGFen38&_nc_oc=AdoxxiZLiQh-gQa3Pps1CTEu-4E9bRoV0i8n5JzxtsGq4Kbz5TF3fUYiMqeKOZ-2I8o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGazpn7DJ6nP-GLdq5hACd1VVKQ6g-Qs3kYXmy4VdvLUA&oe=6A973502"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFbHm6bHlK8Q7kNvwExXJ8V&_nc_oc=AdqaNuPwzg5qqyJ_WiCIsQkAxM4RfblHyo1uiQA4PMAJZyUt5jM-GOWQ-yhTWwuSE7A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs632f_Wjn-4hI4i5ZctfxSrrwP_g37Aic0Pg8NdOe7g&oe=6A973114"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMPgK6SEdOcQ7kNvwGVTAk5&_nc_oc=AdpPrTbnBqBTPr5-5pBez3RFR0_MTC-oGYcMHsWQTJYiB_b8_6FoxRr0F_bcY9D7Coo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-2i7nv9F0CfnsTtqZajjjwY51eA8o3J299SQDP0TFig&oe=6A9744FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDQrzPLbuTsQ7kNvwHaZfXG&_nc_oc=AdoopdWvTUY98U8XWW5IJW4PxPIMr4k4pMtWdrxPDDsckfnWXg4m6v5cIWLNjinyum8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDDL1xSgmouq6OnG6N_BB0sjtHdSOBuN_f_caU1S3e3g&oe=6A974544"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jhuym7TgBiAQ7kNvwHajdY1&_nc_oc=Ado2q1hO4cRUSeyumBWHG1E9uD_Vvq9rRZSzMmcf9HCZNbNDzq1zKc9wBBEotCuAjVU&_nc_zt=3&_nc_h
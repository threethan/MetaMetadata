9kp0Q7kNvwEyBpBn&_nc_oc=AdrfLf4NlX87akAHkVxsEBAJ2eMsfuUYUL_c_77G2dGLexsYcR84p8sHjqAluESzqk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A7fTTGhZ34oYg5VcLs6kj-Dsx8u-7cNYLkLaTlSK2_Q&oe=69D3A682"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwldA6VKBmcQ7kNvwEenVta&_nc_oc=Adrs0zrmLcuK8S_z96Am9P5Fp5YIUPAjtpTlCduT0t7AGcrIg3cja5xYoMkenZl1LfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jeRdO_YuxmroxXReYfvWjfvtQ92dZnNEmDduCHdnt1Q&oe=69D3A294"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DdZvpACwMwQ7kNvwFfYmJR&_nc_oc=AdoV0h1Yp-nTC_7dwkiI8O7E2nm6OyXMmOTGgGIGTRaPA6qbUEvDkGpOEhcbDxNGIzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lPWBE1ogSSldALxaqyY6xYyni2qVFh5vUr7c8Tjrrcw&oe=69D3B67C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yubod_Rrb00Q7kNvwFQ7ot1&_nc_oc=AdrgZyvKmdGBvpU4UlAqHQhLYl35KTjqfwPny138yNHAFw0Rbv2c1XU9O-4MbTcMes4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vhn34Ts1oqdnqDM_NVIQW_Qf4C_6CuEEWmEUo0KnlYg&oe=69D3B6C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu7HNTsfnXUQ7kNvwG8EqZT&_nc_oc=AdoxGFpPTtw6Vsc0mFB21YjEPXZug9UFVVccus7AqbXOAT3TNqQ2zAFBtXoy72ICREc&_nc_zt=3&_nc_h
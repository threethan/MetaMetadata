g95EQ7kNvwG0ceGm&_nc_oc=AdpOLgs_xDkMShPixBIhvKyAEgJB4UfsCvmbDsiXV4oyGhcnrS1cnO7-EbdeG1Ln890&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IEDoxL0JD7voZ6RmdauES4mXiyu-B_1Bf7bY4loufLA&oe=6A3FC182"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5BGrMn1FgMQ7kNvwFoQM_N&_nc_oc=AdoZhyiwtSUwnCPTgS3jFzJLUBKbm2vsmK10m8gEHtoal7BwdHu6eglXhU0u-MFiXlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gVJBP8Fh3JsVjCj02Q1HNKwO3bclt4q621Znb0fFFjQ&oe=6A3FF5D4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4GSyJz5RVMQ7kNvwFog9oI&_nc_oc=AdqFFmn_yUdYx79KKdSuhwHFAHhFRLZEx69jH8uzp8u6i-9Ti0a-BXwzsR9shudcrYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YfbK7qR7hvR9HBNkYtRWQql8iQ_AQ0WhOxYLf--006A&oe=6A3FD17C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4NOdQTTX5YQ7kNvwHQqjML&_nc_oc=AdpK3GNz0q0roE8yCNdQtcZCtPV08uGQ5NeL4FY43KNVM1xTOeS3A2hKQPlXtb3fM40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rts_ktDMm_XNn3jE_i7zJL-S1do-g3PSJxLLkPZDCWA&oe=6A3FD1C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUk76UylvJQQ7kNvwGPputA&_nc_oc=AdphU91mYJlCuRvmFTqCK4BKRMebGA284bVBUpbIm5myfzG_XYhz44OGqObuXdutNTs&_nc_zt=3&_nc_h
K6DgQ7kNvwFaHFfX&_nc_oc=Adq3aTnnjJ4Ib8fWWSJtcA27Is1xAR70z2LTGCmDpocuGnPnoWO5uF-OxpwU9RzWhpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJIuyc_PTYC4QS0ORp9DC9QoQE8iYgKdaA8OmMua6v3Q&oe=6AB51702"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfMNURwbzZ4Q7kNvwGQKCyZ&_nc_oc=AdqDJP-0vQ4xaYt41QJGa72u5IHyZxjhpvZz-rSKK-Wnz0lhaf7-_warKt2FBatPMlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPFhSmGzcEXztiOEkJdAmF9N2j7nh3owHexFyDZ_CGEw&oe=6AB54B54"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL6JAaKmmdwQ7kNvwHKQ1Oi&_nc_oc=AdovioMmhVk-g_gVZKTXt6LLp-2e2hpbIyk8xSE0Bt1ufWo8ijhHju_RZkn9_KfCzMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrhYKvD9UPRJqLC0usl2liKy19YqP4y96jhhBELubBEw&oe=6AB526FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgT0BNj7VGcQ7kNvwF7E82m&_nc_oc=AdpeSotnIRvXYOiaRKejCsv9xBlo_BkleLBw-m6SWAjOkcjRHS4-SG022ZQrzKt1WxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT9lZTHv5veqFdWV7nYLyYOQAKy-hpLNyAbx1gLD4Mbg&oe=6AB52744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQJg3ZgTWG0Q7kNvwF0XQ45&_nc_oc=AdqHLO3EKn8-8Mh2Cbb0-wxE8jUu3FRLt1zlFaiY6T3a7y8X-nTOVjRQaHpILjoXaF0&_nc_zt=3&_nc_h
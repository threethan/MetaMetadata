g95EQ7kNvwHrSJPd&_nc_oc=AdpMejoSPCozkvDzaLJ20NNAepD2WbjQ2hzcAwbBswlN49cZ5w-wq2mloWM3pkubFI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KyaOF1yCYNXLFEVdLXTTXpBLdxosEuyNBh6dxjZ74Zw&oe=6A411302"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5BGrMn1FgMQ7kNvwHwHsWU&_nc_oc=AdpxxN4-Mc469x6bahCtvPicDZhN_Gai0tg6wg9-oI3D04zG58XXDcFyRNYv4yZ3bgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af892qRoKa_VBC_UaocjrBdDvoWtd4H28w533IsEM3Ih4g&oe=6A414754"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4GSyJz5RVMQ7kNvwF77Yb6&_nc_oc=Adp2XAPTvM5jriYDC2GdyyPbTNFvQToz1eAUGFByyLiIwytsSKNPSx7Bp4W_J7b1Pj0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G-iHqywHwEAlIISnfVuMLFWNCtGYcx5FV4FaOhliCdg&oe=6A4122FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4NOdQTTX5YQ7kNvwGHI-BO&_nc_oc=AdpY9r7vaaFx12I4xNAd5aTVmi0qosEQLVmq24lEcb-jzhWuicuFx4hKscOL58zwEg8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jd95WI7fRw-GJdzawEY5oK3n_EHYhlFO9iDb5MkBy7w&oe=6A412344"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUk76UylvJQQ7kNvwHYovAN&_nc_oc=Ado3KfxYSL4Fx4DQWhv5gKJTzZqvt9KgjvZ1zj0XgnPdtH9V-O6z5hzGFhcQmt0qbdk&_nc_zt=3&_nc_h
J8l4Q7kNvwER6kKw&_nc_oc=Adr8BJCIAp7ttsOQMkYapUEHBcbGeQFM5vZICK6nnrwzF7Hrt2wGTNgBJ3s-z9wmmrA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-VThjBs_qviOIoyHIfa02veIuG3aXt8QddMz0abn9w&oe=6A58CE02"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePJ9ZpCpM48Q7kNvwHd7ci2&_nc_oc=AdpbBqp2Sp6Pc9oodVfl-27JiEtMA5Gl6IjO8z9rUdpwULjlQgvbvFtYBRc8vb7kQ7Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT9k7bo9hmQ83K_D0Cvl1Ii_AN_b0wt0LR3tKPRlwElQ&oe=6A58CA14"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c796zcEGKYQ7kNvwFqkLus&_nc_oc=Adp88RsrvTBlQg6sazp7LijoiyaSbsE_kZqdEMnSlleyv2yZvkqFUcFBGrmvYythjhk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo9l4BrotzumeELsMn2iJ5475L5Mz0mUmGManho80XRQ&oe=6A58DDFC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuxjydR7lwAQ7kNvwED0vVo&_nc_oc=AdouJDBsLmAX52-Fe1HIaARrWb_ZtjiBalFrFfGSefwKEI890UsBa5a4_nksAPRl5_8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcm_6P4CXtXm98aegAqNdX7lJ_NDQTSTEN32HzZh6ezA&oe=6A58DE44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-i2sd7Y8PMQ7kNvwFFRBzf&_nc_oc=AdpH7fo9_iuDzJPF8vfIzhPoktAF91OZrykFuB65O1UAND807vFsEB5Qg0k3JRos4WE&_nc_zt=3&_nc_h
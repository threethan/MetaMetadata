MEQIQ7kNvwHW5eyE&_nc_oc=AdqBf--KwlvnqGa2JmJs4ICOfYy9kszYN3L0Hj2KPs37uWtnHLH3ON1Q12-pRWn8lSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vJERqeUUIqS-LsZitX7Si-sU9CSlVUpDTv6OHgX4lMw&oe=6A450782"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22laWflo-MAQ7kNvwHtm8R9&_nc_oc=Adpn_bth6oItleI_QZK5MhgHiQe7Nkz2GKjB4wN26vYVG-1wEBGGdnap6RtfVicSmCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89rtgzpfh9YUksdursek75zErDL7Z3nyXc0b0ItjR03A&oe=6A450394"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Id_C5GoUcEQ7kNvwFObCb6&_nc_oc=AdrBy0OrvGX85rBvHePw8-Y_5vJbt_E2j2ERVSzwi4L27b-lpew6ocVBOqv61Hg2ycc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9i_PkI80190ZFTRMIX8izh3xUkMac3VGT6MGLEs8a9Q&oe=6A45177C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxIz9AiGszAQ7kNvwEfyIUQ&_nc_oc=AdooxfMW4sjiUkhFyclj1vG007EaGQzUSaDIsKSgmuihp1jaC46FDkY7sCrC0oqiza4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SBhwYZIeWUbCS07JZyeFhJegeLjgxkBpohi2OmHkFwg&oe=6A4517C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ChbT3ppA2wQ7kNvwEw-RAW&_nc_oc=AdpGjRWLoYqqSYtH52DHo2qoXOEOnayswQF1KyvykVv4zz6ett2RZq1KVEhh-dXL7zs&_nc_zt=3&_nc_h
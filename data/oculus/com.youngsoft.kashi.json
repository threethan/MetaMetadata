1kz0Q7kNvwEs02xn&_nc_oc=Adp_q6nRT4Z4IdQaoTE0wacF_IL5bZX6FXKjhtyw7x-5L6yqxUveosoIJU3nmIHALfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt8_UP6NR_pzvWY25IqGxNwXujUbNQr7Cw9aVi03U7Hg&oe=6A999FC2"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXneeHrmXlUQ7kNvwG4Ndy5&_nc_oc=Adora9byQ_8B7tdpAiOcLG7fbfRcytoGPpg0VoZbwpnQb_NB5qsn_WGdSwLfPsEzLFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy6FwaEW3yQTD_dxH-SoldEwcgM03HCZMVzVrfTKFIjw&oe=6A999BD4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsmCDdEGaawQ7kNvwFQjwcx&_nc_oc=AdpPD02bPyr5leGXc2ZWahwveHlkmReaHK3tmpc-kef3_nFLcZ3QL13UPthyUXvLM9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfy0-DbQhk_fR-Zk4l_QV8VrpSTjLbq0cHbmRcJAb8vw&oe=6A99777C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDQrzPLbuTsQ7kNvwGmZRUo&_nc_oc=AdqtAfNdFXHODNf_qHicahR1oAWD6rWE3CQIH4vKrc6NlrN2KqL9x2vZZv2F4jqs8mE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqgPwuyhiwr3k8CuRYslDu0bH6ktYMc68OEmrrYSvo8Q&oe=6A9977C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKf3wja_UAYQ7kNvwFIUgNW&_nc_oc=AdrqHfDf3HdU7YTfBu2jvjEk6yIrg23Mmq_zdWCBuf7891rLVD6pFki-ot8wLurWCIk&_nc_zt=3&_nc_h
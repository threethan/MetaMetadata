7GagQ7kNvwEMWeTG&_nc_oc=Ado8EJGLGyou9CeRAqFPaWOnJ9xGmlf9zXZTauxY_5bZ9Y-QyithcomjTX2fNWuqP78&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bFGmwOTcSJ_H0zinplw_TnUNWkTRzd9Xx_gqGsqYjBg&oe=69F34A82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD0dgkC8BkQ7kNvwFtkg3Q&_nc_oc=AdofTO3GfH1It0tQLuAlzjNY79fppUkZ1_rcsPNRhekSnOVbNoifxXlHIMXeujhCVkc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ctQK89KxRSyAsOiYftKoQIPCFN_rf9VT3KT_t1vKYIQ&oe=69F34694"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rum_2OEgY1oQ7kNvwFSzLLB&_nc_oc=AdquhPjeo673_2OdKuSEgcSppWZrsbVImoGutObxA6-kmITK_x1OU6gpNmT6FOgBmnY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eeY0uc2FBGq5rba2VkpBTCtf5dHmApbD8_Ul4VMmmgQ&oe=69F35A7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0JfDpf2AfwQ7kNvwEl9RVG&_nc_oc=Adq1uaISIvfEryCmn-D9JIMOeqkxRVWFs7QcRwmUVivtlSNJuxrjPttNXeVj_I0tduw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gqJDD-mbMeNeO1jT2pK-y6ypHIU4xOmeE9xl0j1mATA&oe=69F35AC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs2uERiuH24Q7kNvwELZIzd&_nc_oc=Ado8aXwxjk4qaFOc5jyk-QP7Go8sz_DYpe4aQcWObQpmNeiMgq1ZHDpBFNB4LS8dGjo&_nc_zt=3&_nc_h
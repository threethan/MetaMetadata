K6DgQ7kNvwGxFIEx&_nc_oc=AdqYDDngwf6LpRTyv_pvaGnzTLz6nSjyFPa7TNtqbpJaoE4IXh34_Jjc6hsYQ6bi5Ps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIORMbjFFjA-i7s12wgoTdPGo9_Kdq56BQJ7zWU-hYIKQ&oe=6AB66882"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfMNURwbzZ4Q7kNvwEQwNbp&_nc_oc=AdrKLwqhmYK_0WqyJ5GFhNRFnV5FAEi4goENfiCSdkxg9jPdmBDWJ-ySx-vPKVYB2MA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsLtTSfIf8iMx1G-rwmgxkXtac4Pg18Og0mSRCI4gZzA&oe=6AB69CD4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL6JAaKmmdwQ7kNvwFKHJOx&_nc_oc=AdoCg1tYIby7JfLm03VTeFK6fU5GOaZwSwx8Nsiho-AOShtjI5c95SykgLndxnBamVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy0S447B4L1Jv6_neVYG8AQdSwJNah0WUduw1r84p8lg&oe=6AB6787C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHGm6diMoJwQ7kNvwHM9de9&_nc_oc=Adrz8wFWaE9PXkB6R09SDXsOO7w8dSZotmfuXJ4D00jHTPBI3ccxbApqu6099Bb7MxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPRoOBLyeVubzv5hUfDIOrA99X0tDsMfqGQPEYJqbcSg&oe=6AB678C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQJg3ZgTWG0Q7kNvwH7qQAl&_nc_oc=AdqVLFv6nLJe9LhCn4jehi8vDZPfPJkwhLcv_RXdTufQfSeSzTSzCJLnLxqccGQBem0&_nc_zt=3&_nc_h
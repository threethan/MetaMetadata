o0_QQ7kNvwHxKJji&_nc_oc=Adr2CZ7OgjoIdXyP49jncoWTExBd_tfnLSSxXmkZZPXAG8ZPDDwUnyObD3-kFrrrdPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCFIfvUDTTmXxQlC4LadJBLDzZ7ARiOxbiMLQsRgJs3A&oe=6A5E1402"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi0zwmU0UScQ7kNvwHVpOq6&_nc_oc=AdockCpxAHsxCEdhVMKZOO_oCoTvFbvFrx7Wa0frvbs-PGtY3uykpvnm6Z2-rmfP1mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMxtomuAmedhzLkPYUxHMuVZSQmM7ytcd_X2m9pGW1zw&oe=6A5E1014"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QJeiJMHMXkQ7kNvwFxEXQ9&_nc_oc=AdrS4dve38wV7QowaZBoHJzQJB8QqdzeVJdBX_X5w-mnVbhar3ZQhMS7aZV8b3G0tHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1MpFGvzdTht0_Zz9sAnIVNTPa-rGogWrdmdTIi8eeDw&oe=6A5E23FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ7wlXE5eNoQ7kNvwHGdJ6m&_nc_oc=AdoeOqC9V2Lh8ozEyXN-4jqGdFLUeKFiSjajON-nK9hff4Du0PmT8o4yartn9-hOi9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUaIgPEd7JRSRz6He4IqIuLHGBX7yLG4qLAnMBhri4YA&oe=6A5E2444"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaoNHAJee2gQ7kNvwHtD41Y&_nc_oc=Ado1ddNsYZfzv6FTA8n5-ANkQZ0Vz8BdAHBLn8J1QTFSJ0ffojx1pLXRUA9JhJcb6HI&_nc_zt=3&_nc_h
yymUQ7kNvwGa3yOV&_nc_oc=AdrKdL1hfnqoQDyaXZHBOGVR6My9emZ-_aPiD2kXxEBdmU5iu37-on5c4dpqSxISS-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiM8F9t2Ypu7S_tMRPNRzRyy2ZcnwqEdqtHJodkcRw5A&oe=6AEA0B42"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhwtUglgZjAQ7kNvwGbChhl&_nc_oc=AdpKmhMn_18jwHuTsiLvs2WqGoaBEsoOzTEZ0tAuaYi61k87vxJWsvb1QYgMsc7y03A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRik4_PbEDAKi24fiNufV3GolkY_QSHBwWgNdw5cV8rtw&oe=6AEA0754"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3KttqXhSYwQ7kNvwGLABOM&_nc_oc=AdrAHxMsl7jnvRfMUcoWwzmcHxJXBbiWeWgmmcI0yRE5FLNCLxJ91CeX2SnTIFBlZww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStq5-0wGBZwz65w7B2_Fq39vAKMv4ralxmYX_xYqhIGg&oe=6AE9E2FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_vA9t5q_QQQ7kNvwF61FH8&_nc_oc=Ado-cPJRSLGnr2vk7aZW46eNuKav99k9celurJzNhZ2spU569yGNE4Fl_H9Ih-HavUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8CE8iM-4Ok4TO06QVY4sZR2MS_n2bEXTCbJS5pjmDJw&oe=6AE9E344"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1N0-iBGmiYQ7kNvwGT9oAf&_nc_oc=AdqD03OZATn1dTa-EEOC3czG5ogLKk2kG66lSHtyto3t5wK1nQcuCJpYgGtgiNzHGuA&_nc_zt=3&_nc_h
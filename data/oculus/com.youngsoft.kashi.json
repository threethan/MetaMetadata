kWtwQ7kNvwFDpoqy&_nc_oc=Adr3cA74OfaDzLQmZ2O1g2ZG61AVZ0TrpTo8rNaOMF3FeU_siCONyZCoJQqSLg6NMDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vg3fMgWXoHWXw0__OOZsZUGRQ9qCsngidA43vgSrztw&oe=6A201D82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEtBQSeRXs0Q7kNvwGOYMd4&_nc_oc=AdoPEgzaQQDdbTkgm9-MMCHoxv70KpLHh9YnSpcghmAvflGjjIK-M4bceiTvQTxec7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I2CJYZmwUrjkFzzWna0zvUv_Od9YW6RPmIW1jWzjdmw&oe=6A201994"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh_OOkxqyfoQ7kNvwEl7kus&_nc_oc=AdpuEo4XRmWj5hZxNPurSwF3qWVbFPxNICwEJtdM6k51JgUcV2P6BANQ28Q7lQNZZpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B6xCZ3UD3JIvs3Ewa76MKKFaqhe6bVbCUhzQHem5Fyw&oe=6A202D7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOBBcCXY840Q7kNvwEr1bex&_nc_oc=AdrbM9D0JSxj4jALWjd91WeUHVi2_FiI1pkDLH9kSykPjR4QbosX08udTa6i6zXlyy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b_KMncgftsvwlA_qRRMcEa80I0HUoWTAvyAvyvUVdBQ&oe=6A202DC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRicORRpvhgQ7kNvwE1EBuN&_nc_oc=AdpKsQjNlNT3Y2K4-qfijOU07A_8thRQakdogSDRvq00T8v03QbHaLmVONa8XmDJLc4&_nc_zt=3&_nc_h
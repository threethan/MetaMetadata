N2CUQ7kNvwGvqqd-&_nc_oc=Adqe4VxxbjfOFUmiqwmseQnloKyacb0gvsZdxUkBi3TLZuUmz3E52jgT2YJG4SyBMuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mdKSfTT1FCo72xhGQSb2c44D7CeEKbEGcnNNe7KwDFw&oe=6A071102"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODIbpi-r2X4Q7kNvwHLJCRm&_nc_oc=AdpE0eV6t3mLVrlkOHFQ72pLo8BzMYrJ_YvyGJDcTlieG9NW2D6f6VuwPJMSW3WWbNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64RTZ9e_72ouqFfFXGjvu_ZbXPWAhe4oT19zq0_UmNLA&oe=6A070D14"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tG6WsEwhLAQ7kNvwE6J0Wa&_nc_oc=AdrT1gT7i5f_Ujy-FTZn2uO-kf9-eDab0SapsdNcU3lbkWZDw6xODRgYEYTkqdQU61A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GIQex6VVIn5FogLQDzUShzY5eX7HlPvTl-xqZywB-pg&oe=6A0720FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMRk4UBuad4Q7kNvwHbMg4Q&_nc_oc=Adpo30Dfp1G7bn8AYCXi5xDERFaVkpca29SzipjjUj1KdefgIMf1OJzcd6Wjqrfvr-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60PwnWaVCdF0ON1z4NPRvlyMd7Lmr59QW4_0798UDyOA&oe=6A072144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxs5Mv7mlqYQ7kNvwEw-nhs&_nc_oc=AdpaHgvGiASqT4gazEB0HG5vL-NpIC5hCQ0VFGKdBPDFgO2S3e8WIFT7rDrVy1HaWLw&_nc_zt=3&_nc_h
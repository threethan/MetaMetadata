gVxlnVKriLeTevOk_Xhrruumno6of8DDjshgkc2B782l80IzIT05J-WFh3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy21C9MGrhKxbafFJOYi8KYjb1Ue1v9J344VOTH7Hg3mA&oe=69AC1982"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5dY9vDGnGEQ7kNvwGpWHHT&_nc_oc=AdmGizlcIfvJc-mJq0CzwhLmX-3wrHchJyjCmiZmooQMNdRq1qmEMGzMiLIOlxj4v0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzR3qsYk5GaqATJbPMHSmSgT0eH4QirAm6oq7FS19VByQ&oe=69AC1594"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzK0clP5owIQ7kNvwEDutYZ&_nc_oc=AdkmE-YfiIxfkDEvrhROWvxcqv2mEPtpEMRI9UeuxOTbi9PgxNIBcEkidY-tg4QcXqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfziyP3cU08afvrqNrnpPfvvtuzBf0V5YNyyk06xrf57ng&oe=69AC297C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ovaSIeMA_IQ7kNvwEaN3D2&_nc_oc=Admme-R7jDkXXEfa2rxziifQI2ZLpQdbpE9VqAhfZxgczMostuWbJ_yDrNOHEpBmit0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeJpcVyVZMUZHWyynwuolsspPJOgwL3nSBQZsUjCMrBg&oe=69AC29C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8RfVk5EdJQQ7kNvwGMBGJW&_nc_oc=AdmHmR8IIPoypaYw3P4ks1Bgnw57VKOsKlVSecc16S_w-7B3P1M41bfRPyzmebDm3jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_A
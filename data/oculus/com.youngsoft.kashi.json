qxzUQ7kNvwEX2Twh&_nc_oc=Adofgf6QbJyt-816XR9NgyhfxbYM1ag0ZKlGc0dgqZas8X49BJQLNod_vrV0gxQB7K4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mLpfEHpBrrcx0-aqaxRGgt_YZaUW6uAS-X3A2tpCuyQ&oe=6A12EE82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfGJuzskCAEQ7kNvwEedx7C&_nc_oc=AdrHs9354RZS1jQ-7sJznE8bv5rmOzExrF5Bkbly-1uXS9o0BIhoM06qe3omxLLWNR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XnFVDEnfu0j4Tczx_XYT3morIX4q9SvdylS6jpebMdw&oe=6A1322D4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvJ720FZtYgQ7kNvwFLOSAx&_nc_oc=AdpHqhdxeAY7pAQw3IGkd-YsjaqVyS8dr087Tn65mfnPosVZQeUXgY7U5MtPndmt2kM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N0C-2365Z7mSzH-uHz38ZTsGddMtATiQQ3s4m4rRCjg&oe=6A12FE7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sOov3DL4bwQ7kNvwFFmtJ1&_nc_oc=Adq8Gf3V-DfERsqLfikREMD6lgoc7e9loIy9u38-Hn2faUjRwSqLJtBkQkABWPFIXHc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hBnppkt0Yo1OvftqnEEU87EQd0QSJoB5va__5J1ZnKg&oe=6A12FEC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hiz1VzV1UUsQ7kNvwGxziDL&_nc_oc=Adq1d6yHyXlopyAvfNZAO5KQJ1wzlvz1KPLDml1ohQVaravk-P-lU9_42IR95dPPDko&_nc_zt=3&_nc_h
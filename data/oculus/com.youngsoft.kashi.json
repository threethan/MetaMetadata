zd14Q7kNvwGcJdpz&_nc_oc=AdpfP3r94HTY4oOtBKjupsfze9h5xBNJGIERr06QbfCOkTmFkDXIjKF4k_h5ujXZcIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_bP4CBcvolFltJmbcp2AbXNf2Qk2lWhQuJXRPgOmlCg&oe=6A772082"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQfP9Uv8m_IQ7kNvwFnI2Nj&_nc_oc=AdpZWKErQA7Urza_zMjTJtbxVv6y4x37nh_Icx39IKl7taliF88DwACHeDi57vVYMZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGErYOe0G9LjLmQK52wrjj1NUdGvvcJYks8cWHLFdGEwg&oe=6A771C94"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdCTrwBS2CUQ7kNvwFeOsUk&_nc_oc=AdrrgK65VNlih63QLrZiXYq5nOVEuCoMNg1gsGVMx4kRLjLY1-lZu5ZsroSfwbAt2ME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqru_31HwdHuE0dpw0lkIzdgA33JiqMqu-J2DYJoElbg&oe=6A77307C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEui7XdjK54Q7kNvwGnrxjX&_nc_oc=Adp9PnVH4DFWvQJGtGAP-D_V1ISXWuihXVNZMyH44RAF70_UwDzW_C0OqClOt4WchqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzncR1MqKK1FdTwIUQVPYLNjkXSonSQ_dMN5UwHyOpnw&oe=6A7730C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNi0Av38X_gQ7kNvwF6fS3z&_nc_oc=AdpIrH_XR928Iha8jRyj_nSONIfwqe_Wzb0dgG9BZBYEptHi8vvszE-FyMVwft_hUFU&_nc_zt=3&_nc_h
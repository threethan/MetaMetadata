yYoIQ7kNvwGKnIpm&_nc_oc=AdrzJkUzg2iCbU2IBlw7j_9-KD1FpSAMLBG8m89zRwb50vdcJU_hSFcH1RcfvW64ZO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhY7JuMRuWOSnoe0AM1oiVIdiOdUXcT4XUZjmmrztPfA&oe=69C3D482"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT2ikbDG7UUQ7kNvwF4OfMz&_nc_oc=AdoSp3VoUBJwfUupChbkqy9kfSeuQNyI3XP8RAXk24w-4qksAWOpyp9aKCWgtL3MIqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycjVI8t9XUFkytlvWhB-TBhIXHaK8T-FnR8emrEkqTMg&oe=69C3D094"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1bLZ9gu9EwQ7kNvwHTAe9F&_nc_oc=AdqkvbNf9xY2Mv_aqqGlse8VqN5QZ58f39oBYTGn6OKhvILbyguYi4kmkVykYSbfpHY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_3icz01teV8dZgq9PkG6oYnciligfqysCwtUYq51CwA&oe=69C3E47C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOpHZYulvCsQ7kNvwGcGfKz&_nc_oc=AdqKe-tcWQ0we6gBW8g7YG6guUEQcKi6p6f832W-o88xKBpi8Hs-7K4_YKXAiKGqPwU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkZ6bwKgewIvV1Mqv9FcvhudQ5L6G3FE5AOgFt0yQCqQ&oe=69C3E4C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpgzUVEcRJQQ7kNvwGTASZv&_nc_oc=AdqR9fqYvyAodAl-dpiKo_CnpOUkoq9Km6iqgxDE1pwvued7I2wU05jk0yjAkcRmpuU&_nc_zt=3&_nc_h
A-oIQ7kNvwGyoTzR&_nc_oc=AdofTZ3R9MY-yJiDxG_PHjF8N9AChY8P-4sPzfWZFXqYb1E_F3NoMac3sbBB5T57DbA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFocTAJ4m1geBGqG-tbBwS3MYyamygIXhbpEArLCqaUfQ&oe=6A917E82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqEGBoPGJzMQ7kNvwGumvjs&_nc_oc=AdoMLVnpbgIB_9EzuiH-dTFH9vc3P55vr4s80YZmV5CYkw7izhosnWRSzY-gdf6aCbk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_YWoaNf-wvdGN3v28vnfrkvSZ9Ya2mBk4DdYgD5cH_A&oe=6A917A94"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SkKofvxcnIQ7kNvwEigOdv&_nc_oc=AdqVO7QqISYDFLy6wRtkxyMqaWPIqTjfGP6fZcuizh7NuQAb76l6JJ1MZlpltHSYGuk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5V6jAue270HtYLJPdPDjcXW4vLkt-k9TYe_jerLq-UA&oe=6A918E7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xp1siXsEOuIQ7kNvwHEJSn_&_nc_oc=AdoXvUuE_Uz1R8r6MkRSiJIKDdZZ-FxIwqSjmr7hzH3fk1qjfWQ-adk2izmH3hZkdaM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElFKx1x3lGCumNjotEaFRRhB9FXiK6vfi7_U-p76tyyA&oe=6A918EC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CSE3tFa6X8Q7kNvwFyxbhQ&_nc_oc=Adp3WXZ1fZ9ctSO6e_jQQGZBCX67rLPivq3wocYb5wZFJoUVXtEpKJT9d6Nv4MsQZzQ&_nc_zt=3&_nc_h
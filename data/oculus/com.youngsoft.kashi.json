_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubbPnGJJNz7lrWooNrU8BzR9FO7erH1ovNGDDLRWJdTQ&oe=69A6D382"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVIdiRI09OwQ7kNvwHY1Ax7&_nc_oc=Admt-CM4gRgkTWHluc_vvBv0mlmzHKU3iJ7bMt6Gdmg-A0z-7vT8V9qbfh-VYGIKtyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNvb6p-QQp3T15B2SW0N-YDcsdwMRQWzd6OBdFAbBmjA&oe=69A6CF94"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVPVpv6E3ZkQ7kNvwGoNErE&_nc_oc=AdnMqDXVV_ilHGKkGXiQgFU45t01WAHNMrSa1qWbyQn7cL-__5-Q1yAfMH5l_rXHbMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZ8wXoTiV2rql3QZc-BfcqLqf5OZt0BF9lfYuwI3E5Ng&oe=69A6E37C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEM8c15ou-wQ7kNvwHONbgX&_nc_oc=Adn-Pw5n5ciddVxPSzwuyfzdwBmg7BtvXZm43aXf-CDxsUmHT-TJNbF9Jj0nufoT2hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiQbjVTXrZBDagTUs8PIlIgyzh5Vv-dX1EPjEmtrAsmQ&oe=69A6E3C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81cegGhDZn8Q7kNvwFrBnf2&_nc_oc=AdnwUjkI_loIRkhxCx8merAXxDIaST2voBS5Xev0sOe55dKtwIaUihqBK14oec0T6b4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscvcLPpAPnUWwiJPG_sk5Sey1KbC9FxMddZ_DKOzfl2A&oe=69A6F1BE"}, "is_concept": false, "is_test": false, "is_trial_offer_v
82NQQ7kNvwGSCxWA&_nc_oc=AdoUxZzZwNPywOO5KvlS-YmLEmcLSJygmqvt9ddxCKGvFcCtzKDuyppY8CjkhdNfdg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KmhUDsZTl83yzPKsG-8LaSPxmsewLr_gG-sLIcafeEA&oe=6A05BF82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXNQPCLIskAQ7kNvwF0wZUD&_nc_oc=AdqGwcVMP1kbb7IPYzDl4DEZ43dQ7wRuHTETQ59JpRYrHA-IaT_KqtKAZpNg7MO7Xr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SS6MbCXAq8-r2jym98RQoFho_2lixHiaPdtb744q6OA&oe=6A05BB94"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yifWWiA131AQ7kNvwHBiMzU&_nc_oc=Adpo5aRK2sF3DDtDUvXJN7iczTAGnuRfeTzJbc0ic7Dm5mPXqeWrJbRqOmo7gg-bqp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J-8ScngZWAFHGCYEIlYELfShE7L5-5K-T10GLoAovWg&oe=6A05CF7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMRk4UBuad4Q7kNvwEouuv2&_nc_oc=Adru6sf_QSyD-g_voIuo4XE2aBBqS3pZ3XdjZy4yb4D3SomecWi77pVsd0TNOqvZc3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4osK0BoZ-kTsHaZhzvyJc9AI6rZOy2VEw-61kietqaDw&oe=6A05CFC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlaED73TqgsQ7kNvwGdjKr2&_nc_oc=AdpZ4g41b3QbwirJyN2Z-D2sBHKuQl7SQz5PAddGByXcGP0NC6fn2eHmAalDL1dgsDA&_nc_zt=3&_nc_h
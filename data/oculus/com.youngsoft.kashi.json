-wJMQ7kNvwFBFDOd&_nc_oc=AdqnUjYNF9TA97dkZ6fZfCn-QoxxhLsI7vZ1jAk1aP9uu7m9ErdvLm6a-FE91YFOTsk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h1dS1iQqSETooPq5JlmnHY5Y84IkOdp_rgRDK94-rjg&oe=69E76D02"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHjXXk3xQnEQ7kNvwEYxdnO&_nc_oc=Ado8dtF7DS7Unw8L7AvXaW70vj-rOgh2Zz6p3jWVkNXgoA86HsgQIm3z6uaZgCB6cpU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hYMMjouPEFDMLGZDybjE3Y1RE4HL8gxNlJokcLx6XkA&oe=69E76914"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rhvioj5PMkEQ7kNvwHiMHS7&_nc_oc=AdpGZsxJvIUNi32m8REB22iF5jYe3XEhZog1DiwzgPOljrXDMZfBy1LYNsdPX9Hlzyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oV6N1wR0gYoEyR2irSkPkqURiMQMLs0skyuYsk7TU5g&oe=69E77CFC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bECYVy3ltSAQ7kNvwE2UI5D&_nc_oc=AdqBR_0wsAE8ytqrwB8QJHDIQOGRXUqcy5KI4zzDQ7gvkbnhjvcz-otdpXJBviOkyUA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af066VqDOug4oIBdC1mi-b4DwJLxaqgoXy3_Q6KlpwXUDQ&oe=69E77D44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONDheq_roGsQ7kNvwG3hotz&_nc_oc=Ado0i9d1iuHzqxo4pU02m_VG0g2slWr3ERZAIykE49C0F7w09lE_ZkBCG2RZ2sBiwUc&_nc_zt=3&_nc_h
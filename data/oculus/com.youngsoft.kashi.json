26kc4C39Ly0xZ0-jpvJIszlRUYW_SInMT5BuX5l3zzo2bow5BMM1erRJw7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsHb4xMwA7Fbl14kWM3cxaDIYXpRabJ9Fn1yUVPmO86w&oe=69B7F702"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFri0tvTEa8Q7kNvwFjbAkE&_nc_oc=Adn4UbnNeO_3XbAeq8ZClZbVeJOEfb6V7F3kQUbe9nHRUhOysc_rUR5sjvLEgEfN-EY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBmzZCGtELJVA99PbOsVO1ikJiOGTs_bHt5V9z7fRGng&oe=69B7F314"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jeRxwTm2E0Q7kNvwHtek1D&_nc_oc=AdmJKTECqM2AxD28a78ikP65DOmtUtzYEuPLw-ScG7rbt48HcIC60b5Ep1f_zB2ZwNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeAL_1xJtP9zYPNWfr3WAjsxs_ZLn0Xr43e4a5Qx03rQ&oe=69B806FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9D9_re9x7UQ7kNvwH5CJVU&_nc_oc=Adkj0YKeGlVEl7YOj53kQuj-nSzAoPZvkxxvng-3ERItmpkvhx6V2WvdVLNDbsUee7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyR72qF_GPmUylMj-5IQFD1uIhXDjxoxFOnY2j0kScg3A&oe=69B80744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zimmsBFThhoQ7kNvwE1wKyV&_nc_oc=AdlZzcXNFR0scs_xbjWchfr0CZPVeRDOF2DSaHpbZfB5oz1inj6LzfCJVdO5S8cRSDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_A
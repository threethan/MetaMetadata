7GagQ7kNvwGri_i5&_nc_oc=Adq1sT5BFPTVIg5aL9DkfBGFBBPyTjluY555b9xBc_F5B4vnWtmiOaiJlN-2kveDYsI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J9fJUwtov4CLPbdB-Qi9kFf5RL8bpgMV2-1RYhfI9wA&oe=69F49C02"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXD0dgkC8BkQ7kNvwED74CC&_nc_oc=AdoD9GRluCKScVPInFqjca6uAGlvXfIwgO0l2cbK1zOmrfTzAs8JhnewadwarRgFZvQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-UGIJPe46nMYcstH406Dy7003aa8i0H86ih_PNstv-Q&oe=69F49814"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rum_2OEgY1oQ7kNvwFq61PK&_nc_oc=AdpL2YQaM7It63Bnxflah7ueU3JCMIFFo2FsG3EzzhzHMO6zPuMlqjDA4ITQmbnyT24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NRX_l9JRQs9v5JlEddZ1cKpBox1Z4ICC5V2cKydIe3Q&oe=69F4ABFC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3CQAo9MGOMQ7kNvwF-z_7D&_nc_oc=AdqzBcbb8yp8fxL6VSGp033xkB2fr5PIGTABnjzchnsu35ExeCnY0pJA8Hc96HDvFtc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QqtiRmL4hlc2liT54URoca8uCIhWjnGhB73HtafOC5g&oe=69F4AC44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs2uERiuH24Q7kNvwFw_7V7&_nc_oc=AdqeuWLjkkw4I2367x_vA5byZJOV7ZIAjOFqI6ICirMw3kvCaVooMIXDNHeC8Ia_ytU&_nc_zt=3&_nc_h
_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3lgZ0TYeH0dTGUJTw656U8DtGNtvPyq42SNsMKnl7rNw&oe=69F0A782"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8BBVINriEEQ7kNvwFZPs7G&_nc_oc=AdrWBkdOi9xYOTC8seYCUpVScljkje1KMiWVTRo_x1kYEAl6f8eQFrV4XU97drEoLBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af06yovEIHnlZvwYu2Of3NHm7smotGWLPuD1hWAlVmTHKQ&oe=69F0A394"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1pJIZjZEnoQ7kNvwF1VYWS&_nc_oc=AdoN8NHtdfkYGc3WKtB5jii46NJDtx047Dppmk6vRqYFJA6rt6pOe8A4HfZLk0-IXoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2uYZH-hlT67NskPGci2L8DtOl9cIjFEea46Eo8pyR-JA&oe=69F0B77C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0JfDpf2AfwQ7kNvwF1R_WH&_nc_oc=AdoYpFQNw_0_ntBH2MXndSmmTaozp-rwYhO8Bs1QhjjMHwEs6p77GwieOPqw9yXCpXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0vgvlh_JAXC9KmiuOiNtiT2cDKi9YeAZIM8eMtq8KdnQ&oe=69F0B7C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxtr7zShBuYQ7kNvwEPYGbd&_nc_oc=AdrVfOtElum_Pl7o-nqZaDDeLgtgc73Kmk1SQdIrKriZP3h5VPikuH25HuE7oqZW2cE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2y2a1Pao0dwOr82uwkTY3nUfnRbKuKj_xgvDSdc8y79A&oe=69F0C5BE"}, "is_concept": false, "is_test": false, "is_trial_offer_v
VuyYQ7kNvwGq1RjR&_nc_oc=AdoeRB2QTot2Vn-4kLcRKCWZdIKUSt3oklxvW4QJqNt4W5hSTWGl-6wEaWuNv6imVjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG55KSoKc-8o0ZH2TmgGabMAPIQMWa-zoi10xjciC87g&oe=6ADF4702"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03IruLy4RZgQ7kNvwGYO25F&_nc_oc=Adq4mHfb0mlw-An6oHzW-oSGU06DfjLqQG5YokSOiCcPWNX1D7vshe2wsbnJR1ko_tg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJeb8pRhp9hGqGa87E6nPiHeuuYNNhFKcX8jYav2193g&oe=6ADF4314"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rQPLy6erMYQ7kNvwERk3qz&_nc_oc=AdoDOK82bAycgwlkQi1oDP8a4hrRnPCyxM4rIZyEn784JHwBy61PwzFqC_57ybevXe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEFyZZv0qmYTnPdqLQNC5v6q5bGLNAVRjH-LCN4t1nRQ&oe=6ADF56FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xFidTm2wxwQ7kNvwFMZ7rC&_nc_oc=AdqBZNpDn2baLalxB6ERlEMLpdZ-IIPpkBKQx64umHtfGi9lIoKX03NzS9K6zAItVOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Et-XtFPBjRJQEs-mOVgqF7y-2R-fIwVDmB5yEmRcDw&oe=6ADF5744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-6hfJX8n1UQ7kNvwGvKXNz&_nc_oc=AdoyAJvCxR6jSKAHILg2jjEhVppI5Ui6BkJM_hi_HCDg9sNMCqC6BR3GyWwxktRzqPM&_nc_zt=3&_nc_h
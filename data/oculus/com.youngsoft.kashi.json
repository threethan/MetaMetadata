gYi0Q7kNvwGX4jwY&_nc_oc=AdqsIsGQy2sLCRo7RlXL8s00m1pdLkDW_GJ995vbXXnj67LO_EMfqf7uUYFOXDPEyUI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgt7XHUvqL22J6PLvtGpL1qBIzybbL190yO48PEqLBfQ&oe=6AC915C2"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06EyOQ_JFq0Q7kNvwF3cznh&_nc_oc=Ado9yt3XAs0_Hch6YINfnIu_SxVJttUkjEhRlk4g8Wzj6yL9ioGaUmgS8wEtIju_ASc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpDq-vgCXzTPxkBA51kp6YMJcdLzvF91D_uM1T5ibVlQ&oe=6AC911D4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJK7IYdiOo8Q7kNvwGR4_oG&_nc_oc=Adpy6x4Yah9eNxau4qQJxtklIz7VAiJ45pV9aXz8rGJCji4PA3wBFKkaT3wRyH1Mnco&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBr0uzbBRKiV0AP5ek78XwT92nm520Gf-rJcwF1TKoCA&oe=6AC8ED7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41b_DRwG5QQQ7kNvwHkF7W9&_nc_oc=AdrQSZ_mKzS1zvKuWQVtDtyGFa3KKGwZZsO99pw7BEREl8OEyluOjSzF6sXB5NnnDME&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwQ4viU5h_AHyZbJjDtsZbJ0ivOGdC52FFOmIRfu5tHw&oe=6AC8EDC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecSr7BWpFwwQ7kNvwFk7riY&_nc_oc=AdpRzEagrCB5VJtKeb_GAwcbdcGCsztX0mkdHkaGE-EvPlC_qkoMoLJ-QGAfKZSo5jM&_nc_zt=3&_nc_h
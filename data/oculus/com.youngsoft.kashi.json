N2CUQ7kNvwF93BqP&_nc_oc=AdrjtFyBFjNLpg13fd6oF4Gx8eyTOxxcMT_SHZm7Z6jsGYfOCg38xScf9k8zLCN-0qA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B3i5BBTpIr4dpUMo1FOS67fUbYR3mZwqxBIRMu-r7Mg&oe=6A09B402"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODIbpi-r2X4Q7kNvwHe7Ysn&_nc_oc=AdpqFY_MgQ-MuCaLLwWG_ZY1_8q6O2V-jK_GX1D--I5wczc0795esDqhuZtc1UnIadg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sx7Pcra8CVQOS4wv2L2V6K9jXgZLQ6uwpHgJe8ZHEIQ&oe=6A09B014"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tG6WsEwhLAQ7kNvwGXUzRo&_nc_oc=AdoYoe-L7x-MkPT-Z6p1OaSOnqJoGXp7ZmvMGTjXw5-H2Gg-ydzgF-Jgk6Eq1-vq52Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ONkce76rVxQCNUAuXSVrS9NL-_G2DbG2uoqZ_SkDwmw&oe=6A09C3FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBIOWv5KOsIQ7kNvwEOpxR4&_nc_oc=AdphcOas-2AALl3OzObSkyv963i3qPc49HyzX8-TObLhMC3yAjF8WQjUvxGMYeDxmG8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af768L0vqCVDjFDTwo0oK_8C-hqMIWaHVl0o30Kw8-9KEw&oe=6A09C444"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxs5Mv7mlqYQ7kNvwEfpmgi&_nc_oc=AdrtPx6ohKOONgjNLI1rD5uoOctFf1muWFtP_SeQe2wf38UrZgi1EZ92D2L1X-ipGSE&_nc_zt=3&_nc_h
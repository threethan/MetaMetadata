T_j0Q7kNvwGz5u-Z&_nc_oc=AdoLFxBAmPYn2dUGpzRZHII5ldiB8GlvgkHvnTap_yxmAeGDHz1rgdkNXmA4vtUKs7Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ6zNZFDZcWZulSzcx3bEGziI-AVPRL-OJ3ouDzpSefg&oe=6AF9DD42"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtnG9d8cGOMQ7kNvwEQV_rC&_nc_oc=AdqHOs1qu5v8vsx5UO2cQKs-Bt1FnYVQ4gslMRkMsumK48fhg2JVoWFq5wJCXDtktpY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwy8j3-mvlgUFMD5JYiiQmr9k-_AYpofCghTRmi6NdtA&oe=6AF9D954"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0okfvkKtBYQ7kNvwH3qkA1&_nc_oc=Ado0OklMTs2NRe0OEgXZEja0Jo_TvBDzP0dT6iBCQ08bp2rKLN8MX0rjHEBM6dsXnJ8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDsB092rl6TGzuDC6oGoXc7-DRXBg6n6cuC-PAirrj3w&oe=6AF9B4FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPlWD51Yxd4Q7kNvwF7uuHy&_nc_oc=AdpDSqikT6Ruo8XOeqlZEyogw9Q4vYyYDsWQhQoNczDnZG6gNa26Ws8krKQt0H08rF4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkJfmsHMRy7_571F9dTSfu9q_G0JNudbJag1sI8eZ6tw&oe=6AF9B544"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdQNDl4HPY0Q7kNvwEOnMjB&_nc_oc=AdpN4TtuRqEqEh3lCJyjtcD-s8tWMifRiAZ-TqsxltbLUGq-J0d7_t24Ra2x2696BAI&_nc_zt=3&_nc_h
tA00Q7kNvwEnGXYJ&_nc_oc=Adp3WcnLa7Ak7OXR8aF71l4BCjTpFqUYYHgsWD60znfqNHQoWynbwDrkWJesbRskb4s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbhA2mkjnkrDwcyvdk8mO653_ATvm7-ig4Z4l8LuOSZw&oe=6AD3A1C2"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMnqRBOJdUwQ7kNvwGV_J3K&_nc_oc=AdqDaq26UvnYGXA8XaRp8JPsv4_Gqo8RuaskNsD8xwit_pVMrEHY0GwnbKLZI-LGqK4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7pLvp4UseT9SOShYDXDH0fxLUqldSD0MaNIeIiYIQGQ&oe=6AD39DD4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUCr4hEmyXgQ7kNvwGUzy_y&_nc_oc=AdqfBIwmGaUEgCVNFxTUSxT5X1oFY84Zb_RGNcun887SOpztw2T9w59DnmRS2xxlLPE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH45dHybw_JdBzliIJq-F8nra1z-jpKzbWWN98TpPBUw&oe=6AD3B1BC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNMmRMSLfZcQ7kNvwG2HAYI&_nc_oc=Adp5s_43eqjkmfSfv7gWx37L0Izu1ENeatJbjd26IAGUkAIm9VD1rRkAOgGcK9h1sq8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9asSC6UJY3BPq6OUu4P8d-1wyPrMrhm200NywIvE7_w&oe=6AD3B204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bW2rjj9R60Q7kNvwFbuR2q&_nc_oc=AdpLvq4GMO6LWargnmuxWMlOygEqAFHrfG8JQG6LLBG4ee3qNmoI9PkP0zkercXP7Vg&_nc_zt=3&_nc_h
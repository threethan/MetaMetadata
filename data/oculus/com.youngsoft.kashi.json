Zn9kQ7kNvwFWF_bA&_nc_oc=AdqS2My0dohg6OVxfOu3RYR1LJGkUA9nk1nosIS48S09bHMnG4mxx5UPida3hIyK2wQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyD1A0OrxZLlGHA9RAtpNv7IqtovWlEu5EYwZROZ5u_Q&oe=6A81AC82"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KuKZv__UlgQ7kNvwHOAa5A&_nc_oc=Ado95a4dqWUfNkAvXo9iNDASERsi9XREkHbTTuCCuEy-IAo1f3XDO1veyHLPpPV-QDo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf5kfhvcOXbC3vfYDn8kNKFUwM4tbx3TrXSOJtiltnHg&oe=6A81A894"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kcA320Z-0UQ7kNvwHIqsHW&_nc_oc=Adrpp0xmmG1ZO3_hKplZNV1FuMsa49Twjo7BlGVrNmkq_6C94MrjD5Ipsta3Z0SXi0E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2LuLM-mDLl9T4S66dyWQ6opnyv_IwQ_XGhCtcuaZzCA&oe=6A81BC7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LQVeZNBeAAQ7kNvwFX-9Qn&_nc_oc=AdoAARDjOJ2BjPF8RqXYJE48RVyBZwYhTjQSa8g3ahmRIyP6au7-fEwYN-KVOSXRO0c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDpUIe2PPNsx0f6cjW-5vN7H9ITzmK92Zov_57ChIPhw&oe=6A81BCC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUrPMaQ65ZsQ7kNvwHzbMaq&_nc_oc=AdrtArRis_BtGAkERX--x8_10TY4_IKbMMIhMrteacU0EmaIMncVKrHhrM3dnTaWbR8&_nc_zt=3&_nc_h
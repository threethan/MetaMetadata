eS1wQ7kNvwGk91aC&_nc_oc=AdpR6uqPj26s12X794raRshWluLKR1jDo1Pz0uNZb3a5zBtB_89hY6XGa3XpNqyxUzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYVU0EUDJj7PfZCFOVPbO70zvR_CNDTsicmBp7Igkywg&oe=6ACD0A42"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhdrQFNnALoQ7kNvwEx6s5r&_nc_oc=Ado4l2Hw1T82HqKstV01sOytOEi0VyPoj5jxON4NjkrFW7JhtAgDXCry1Z444gpEN6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzwqNxLXF6VSOPllZmbO_u_QV4MJUsS9DOe9pgg3-OQQ&oe=6ACD0654"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdv1P_JWX5EQ7kNvwFz_tl_&_nc_oc=Adq0thdxfj4a7PLIbHHpjNR7wDNju887NZjVngViIqd-9TAoQm1D_LS1QHC18bd-6Xc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXppTsCMKNRWYWeod9zOgaQjoCup-2HX7qFS2GULAKwg&oe=6ACCE1FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLm3KwRfPqwQ7kNvwGIf0ZN&_nc_oc=AdowbxCDB-HJO5zsUX2iWhV7HXLZzXnAwD0928Kcer5ZvjWq1_PxDMVm1lRICvNdteg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvErxbH9nB6A-G5QF2aA-4R1GTF6g81MrzCrKWi24l4Q&oe=6ACCE244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wEkmqFiy3cQ7kNvwEK4ElF&_nc_oc=AdrIOtazvgkmI1dyUS3FSIg0lAr2Q_nznqjYBFz4tCrptq22Ircmi8-no9QMjt05Mtc&_nc_zt=3&_nc_h
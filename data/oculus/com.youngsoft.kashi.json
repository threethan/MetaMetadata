b9zcQ7kNvwE9FfmJ&_nc_oc=Adok_jG_01JiVf436M8wTmLjUjcyX7KpVM-OBsXy9aHTdNTwDgb5LX4xts_wOaP2hdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w9nB3oa8R4YQDx4M_oaAQjKZlB9knoVuRgD_-73LEzw&oe=6A317942"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq2e7X0xH9oQ7kNvwEaRXUG&_nc_oc=AdqIIGVpiMeRVTaQrRhJ6ahRxotB9uNi6Co4dEgksT9kvqJRyQTLNMHcJNFn4Tz3blY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PIlR5WgzQ35vd2H9qHvRKPJteJBpVmti-T9ptqt4QzA&oe=6A317554"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvreFxPfX0MQ7kNvwE7BwpU&_nc_oc=Adp5NmgrepjxvqBIa323Al0OTrY0Ok9vAdC4EjR7jglXYOlC6fn8NL3EZoqpXID3QdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DfkEKGz5SnfDIgmPsGElmoq3HyAcZ-OJYYavJmfQogQ&oe=6A3150FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkZA-j0s9kcQ7kNvwF8vaLV&_nc_oc=AdohpEs_HWdZoorpt_SXtObuEnCVMtHwj6pkNGhw8KfWI1HC34BQ2g7LrFKNMmdhnEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sMB5vCpPMD6PJkTeeE2RdrIlaD8xfb4Jio_jVMItVvg&oe=6A315144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTKuq5ckQZAQ7kNvwHTmmIf&_nc_oc=AdqtpMx9VLJvIpK49vx16Q-8cSrKQM0Oah99gTq_Ey6f-qaRhSQhyqdrmHgE_YDTtwg&_nc_zt=3&_nc_h
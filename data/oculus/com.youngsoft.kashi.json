iPicQ7kNvwE4oxOt&_nc_oc=AdrS-Fyj0c7JUTSMZuLkmOU3Uo3-U3lxW7aTV_pAT7R-SSUT7eZ7Frk4twg5RoSu4IU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZO42X_k-9HjnOgBcPrnbpGdso7TrZh4ngVjidnSdR2Q&oe=6A8AE702"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKezGp-fHhkQ7kNvwHbss-_&_nc_oc=AdpkcsYsc2xsHe9jF-BO0sglu9P78Jde_h3lv_NRZ8nbNaqH3qv1g_RvwXzF9m5nO3E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFConio1UPD4y692olRyq3OLmKHmmeZZc1ZzfLvERtPLw&oe=6A8AE314"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSckaorYcawQ7kNvwF_fY41&_nc_oc=AdphNUf0p9CeUU3--uY8vZy8CDLjOZR3nL1RP9TKBYZFKv-2dF6yTqmAj6706_qFnGM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBGhyqt3cm77BOP_37qLOX7EESh3KI9ImXseA-qW1zRw&oe=6A8AF6FC"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQ3A8w3gjkQ7kNvwELlcun&_nc_oc=AdrXSYIBj6Awo-YViDEci5Ela2Q52-SAW_ps7sVB4ehyVxPfPSjqkLv-LFzCYulslLE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-VityQQA2ATSklU6MC0COKrYJx1DQ9FEHSyWfkMxz_Q&oe=6A8AF744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knkbucOiZLEQ7kNvwFEhg55&_nc_oc=AdqSmDomkciFRAmLtVXZ-rub6JOYW49kJbVZ8myviZFIpBpaJ8KK3F0Jgz0pHhf2IZw&_nc_zt=3&_nc_h
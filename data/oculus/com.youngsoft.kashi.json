LVx8Q7kNvwHiSjTm&_nc_oc=Adp1-96CWu3X3E1QH6e5StIp9Fvh3H0T03LmpwklYmncWP3uQ2xHi6hj0_MQA1TbO8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dhzwvNCmZX9P1nDDyhn1O1eaek7KJnAXtJsYTW-NSjA&oe=6A329282"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeAPe2yUWIUQ7kNvwENZBQs&_nc_oc=AdpJ7iFEH0smf0Vl81NcJzbzp4B5Q744DU4erEAeYyjVqemJ3tOYXehxyeOa8CraDfI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dto-cG6x2f1wzJ-VA1CmJ7K9wa3QgMCdiygYHSdCgKg&oe=6A32C6D4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMaULg5I2AoQ7kNvwFERMHk&_nc_oc=AdqQ7ImfKxtu-SjEil2I1DUGFaFu3EcJmjxWWahKBZDh9JkONNcmL_nkcFIiTn11Te0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SyV4SpMLy_NI1fPW9uEvhiWj-gzrzg--z0qY-0yakbw&oe=6A32A27C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkZA-j0s9kcQ7kNvwEWnKtB&_nc_oc=AdqDUN5p0pifVYSK_snMslu7FtETmQq7pfmmthjJat0KuK32qWKtIsthvb-MzFXIVOw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OwFGn4gI5D6u3om2JnPQKtgKTm3n6uP4rFWWejruElw&oe=6A32A2C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj1t9vsl6-4Q7kNvwEWA4Ef&_nc_oc=AdrvyqAXmVieT6EXRS0Nqm4s7VC3v6JfAv42omatQJTlccxo-mFzl9lc-Kg1HOUWvEg&_nc_zt=3&_nc_h
KleIQ7kNvwHxCt9Q&_nc_oc=AdpZ77kkospeAQK44XSu4wS4-7J4uQwu_HlD-6_45gzx4y2k2XlyLLLFd5JrwIJQ_jM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK42yBVQsuILVggAVGl1XbkPcOSKX2fqPkpsuU10q9YHw&oe=6A9EE5C2"}, {"file_name": "migrated_image.png", "id": "204136267668038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_588804264926773_210872981449080832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ9Vr3z_G7MQ7kNvwG_2EpF&_nc_oc=AdrsWc4PTUeFbyZ_WFgMIcZVrBf9ugebAPDU8N1Mgq2zTBDTdhTf0Ejz_3wuMmafd78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3-o8haDIdsGwsjyAXkoCtS-9J2ChuDj1JkYGUeYpjHw&oe=6A9EE1D4"}, {"file_name": "migrated_image.png", "id": "203025724287648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_2258074054415711_4973977779839172608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn8jYF3cYdMQ7kNvwHGd6xn&_nc_oc=AdoO5qc_Qs01fUDaaWzJzq4Hgq5HtCTFbh34KoicpBPu841DjZe-QXq6UrwIKq1ZpBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK82Z8zA9AwIvl0tKkNqm3Y_wamDmZo-vck8vq13Fi9ag&oe=6A9EBD7C"}, {"file_name": "migrated_image.png", "id": "146066386756615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974567_518888385300114_1706475542758293504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiHse-AWKXkQ7kNvwE2JGFL&_nc_oc=AdrJ6Wj2QdJQ_g6wHXY0wC9Mlj-1lonymKRZ8clC5FNfLeq3xpHPgXFN0V2bgf20X18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8hsYJrj-yYjTkJ3DLXVkR2JBA-94SMAuJV1k2GepQEA&oe=6A9EBDC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shri Kashi Vishwanath Virtual Darshan", "keywords": ["ShriKashiVishwanath", "VR", "VirtualDarshan", "Varanasi", "YoungsoftInc"], "long_description": "Youngsoft has created an exclusive virtual reality application through which people, with a smartphone/oculus and an internet-connected location, can experience spiritual pilgrimage sites, as if they're present in person. In this initial release, users around the world can experience virtual darshan (prayer practices) at the Shri Kashi Vishwanath Temple in Varanasi, India. The app will be further enhanced, to let users remotely perform Pooja and Abhishek prayer practices in the virtual space and to get a personalized VR experiences.\n\nDownload and open the app in your Oculus Go device\n\nA red dot appears on the screen which works as your cursor. To select any video from the menu, stare on any of the videos with the red dot on it for 2 seconds.\n\nOnce the video is done, you can go back to the menu by staring at the home icon in any of the video.", "short_description": "Discover a whole new experience of worship with Virtual Darshan of Shri Kashi Vishwanath Temple."}]}, "developer_name": "Youngsoft, Inc.", "developer_privacy_policy_url": "https://kashi.youngsoft.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Youngsoft, Inc.", "support_website_url": "https://kashi.youngsoft.com/contact-us/", "website_url": "https://kashi.youngsoft.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139763340177364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_385891691965853_2211053330099077120_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxiLjXU-gI8Q7kNvwEPHESm&_nc_oc=AdpAV2rLN_SEL6DkxF1eZnQO77vPXQmomOr7liyY2XBRNEp7Wg-FaWCF5G6TnBQUVMQ&_nc_zt=3&_nc_h
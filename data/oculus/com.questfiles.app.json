2576513989008", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1024941973598786", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1024941976932119_6023827727519445868_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndVOVjFZqlQQ7kNvwFUkoX2&_nc_oc=Adq7HREH3nC3X4zJ64d7dmP9UMwmcWo8kODt8frbb3hSTNUQXep1-vLOQxXqS6xbku4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK-n299zHjwDscyoaXEdqrWKLQBI9RXxj5wE0UxIwEog&oe=6ACFA0FC"}, {"file_name": "2.png", "id": "1544120873784053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1544120877117386_1414888434800096659_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x621n0srFyQQ7kNvwH0jgQ9&_nc_oc=AdpfpOs8aTPu8Fp5mpg6ku7qe6bkS2MGDCJqWPiIrUEfYZlIrPuWH5hiLFwwpU8y-kA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODjzviWsfSR9Da_GJN8sWE1IV9MkchitAtb_jyxqgYJA&oe=6ACFA6D1"}, {"file_name": "3.png", "id": "1192416456374316", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1192416459707649_6203551636641797249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfjRrWGT1WEQ7kNvwGh0w1P&_nc_oc=AdrJdcKZXDMC9ro2VdnrSoIast3J61O4uqeE2HsnUG1kdzFkJKdJf492eL1A3yIDsig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJfO8yU41wObGWQ1-VyQe9G-r94oP-GULN7xHIvexS0g&oe=6ACFA47A"}, {"file_name": "4.png", "id": "1054041317205778", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_1054041320539111_8365551111872847457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HPtXN8BRsQQ7kNvwFKU-wY&_nc_oc=AdpS5NITwLZF3owtKfx3LA2T4k-rh-mrT32iwRcOmNjJfsg7OJ0ZdUfWIrZVfCB4HsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf-iKFWmoQygaxSHcWUXYLK0yuYVTsXzqnP6O7_ZSEWA&oe=6ACFA3EB"}, {"file_name": "5.png", "id": "1065189282616846", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823910_1065189285950179_1048936583422117996_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd-NKUZ3uz8Q7kNvwG29MlJ&_nc_oc=AdpFGj6JUToeH4F9LmBOZY4r4t4_N-5R8oPyToptY_1DwxhEcmvJbXAEl62AX6AzviM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOps57ym9OWZ41tt2nwnuwUK7ztFEIGf4_lUpXvzQu_Gg&oe=6ACFB5C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestFiles VR File Manager", "keywords": ["files", "explorer", "transfer", "manager", "NAS"], "long_description": "Your headset finally has a real file manager.\n\nCONNECT TO EVERYTHING\n- Network: SMB (Windows shares, NAS), FTP, SFTP and WebDAV. Saved connections reconnect with one tap.\n- Cloud: Google Drive and Dropbox. Browse, download and upload like any other folder.\n- USB: external drives over USB-C, including NTFS disks Android normally refuses to read.\n- Local: everything on the headset, including your captures and recordings.\n\nNO CABLE NEEDED\nStart the built-in transfer server, type the address it shows into any browser on your PC, and drag files straight into the headset over Wi-Fi. It works the other way too: pull your screenshots and recordings off the headset without plugging anything in.\n\nMOVE FILES PROPERLY\n- Dual panel: source on the left, destination on the right. Copy between any two locations \u2014 NAS to headset, headset to USB, Drive to Dropbox.\n- Background transfers: a 20 GB pull off your NAS keeps running when you put the headset down.\n- Archives: open and extract ZIP, 7z, RAR and TAR in place.\n\nBUILT FOR VR\nBig, clearly labelled controls for controllers and hand tracking. Images, PDFs, text and audio open right inside the app; video hands off to your VR player.\n\nTOOLS\nStorage Analyzer, Junk Cleaner, Duplicate Finder, Large Files \u2014 for when the headset fills up.\n\nPRIVATE BY DESIGN\nNo accounts, no analytics, no cloud middleman. Your files, network passwords and cloud sign-ins never leave your headset.\n\nSUPPORT\nBugs, feature requests and help: https://discord.gg/UJSn59DDsv", "short_description": "QuestFiles is a real file manager for your headset. Reach your PC or NAS over SMB, FTP, SFTP and WebDAV, open Google Drive and Dropbox, plug in a USB drive \u2014 NTFS included \u2014 and copy between any two of them in dual-pane mode. Extract ZIP, 7z and RAR without a PC. Long transfers keep running while the headset sleeps. Storage Analyzer, Junk Cleaner and Duplicate Finder win the space back. No servers, no analytics, no account: your files and passwords never leave the device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questfiles/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/UJSn59DDsv", "website_url": "https://f1tt0n.github.io/questfiles/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1162974436903470"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1770527587373556"}, {"status": "PUBLISHED", "id": "2140091660720203"}, {"status": "PUBLISHED", "id": "903634319447732"}, {"status": "PUBLISHED", "id": "4320973418194023"}]}, "baseline_offer": {"id": "1770527587373556"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791043560, "status": "PUBLISHED", "id": "1770527587373556"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1324822230718689", "version": "1.1.19"}, "id": "987224660846928", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1162974433570137", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1324822230718689"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "987224660846928"}]}, "change_log": "1.1.17\n- Fixed three crashes: out-of-memory in the UI, a freeze (ANR) in the text editor, and a syntax-highlighting crash on shell scripts.\n- Text editor: much faster on large files, find & replace with options, line tools, undo grouping, unsaved-changes prompt.\n- USB: images open straight from NTFS drives; copies to FAT32/exFAT sticks are fully written before done; clearer errors for names the drive rejects; drive name shown in the path bar.\n- Network: SMB transfers several times faster; clear message when a saved server is unreachable.\n- Transfer: security and reliability fixes in the built-in web server.\n- File operations: fixed data-loss cases (moving a folder into itself, image rotation), case-only rename now works, newly created folders scroll into view.\n- Fixed: USB sticks (FAT32/exFAT) showed 'Directory does not exist' on the first launch after install, until the app was restarted. The app now reloads itself once storage access is granted.\n- Text editor: the keyboard's submit key now starts a new line (there was no way to press Enter on the virtual keyboard).\n", "created_date": 1791267034, "id": "1324822230718689", "version": "1.1.19", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAs
e7a0a&_nc_ohc=juL3DkzDgyYQ7kNvwF8Zns7&_nc_oc=AdrDx4NrKg2gc7PqO11uU_wNLqhrZLen_ujddL5LkwEJzujhQDzXJeVA35V9BlOGEPU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPu5svLE6O8oZbZJ4_pPrrq0Ajpl43pIccQ9BrObUJHg&oe=6AA41F7C"}, {"file_name": "2.png", "id": "1544120873784053", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823940_1544120877117386_1414888434800096659_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_UKau4dBWwQ7kNvwE02_Gs&_nc_oc=AdqPXkZ4TTvBEvRZ5SSSMmePReLYaswS0AbkY8MG9eqH8-ReFCNWWL5E4v29-OeZ-KE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RnTDKjj9_hCt4rRmYyNlvAnh8l3fpMmJFUMtvIgFGA&oe=6AA3ED11"}, {"file_name": "3.png", "id": "1192416456374316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823341_1192416459707649_6203551636641797249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPAszTmDI60Q7kNvwGM-siR&_nc_oc=AdoatiCm5TCVC1IWlCAPLokwWoyUc81nSKwzFZo8MhHCSJCquTTbK8s2k-RNj_6aCIc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNnkwlJFJtEGLjm0HApZnBWnmK9lm-YeTjmDzT6OftKg&oe=6AA422FA"}, {"file_name": "4.png", "id": "1054041317205778", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827601_1054041320539111_8365551111872847457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_Gwlerk1-wQ7kNvwGj4r4a&_nc_oc=AdqGcxkdL6K1JE-XTFgjxOKwK15XpNx0pUBCM-BQxZNOMH0XO-I8Ky7FUbA0_L7ikYE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-CHy_xrbCgTQ-mlxOQ1JVaS19olF85DXaPKhCfa3hag&oe=6AA4226B"}, {"file_name": "5.png", "id": "1065189282616846", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823910_1065189285950179_1048936583422117996_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TytT58t6o1sQ7kNvwGAOwSt&_nc_oc=AdqMYgn_ycILl_QzinN5RZwv_uhf9WAmejyJYxR_tzEkBvABiZKpowOtEfSG8ZkrtvE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdeocWkNywmTQw66HDm8OriSrRHEkl0t4Y9WGY_A6Pnw&oe=6AA3FC06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestFiles VR File Manager", "keywords": ["files", "explorer", "transfer", "manager", "NAS"], "long_description": "Your headset finally has a real file manager.\n\nCONNECT TO EVERYTHING\n- Network: SMB (Windows shares, NAS), FTP, SFTP and WebDAV. Saved connections reconnect with one tap.\n- Cloud: Google Drive and Dropbox. Browse, download and upload like any other folder.\n- USB: external drives over USB-C, including NTFS disks Android normally refuses to read.\n- Local: everything on the headset, including your captures and recordings.\n\nNO CABLE NEEDED\nStart the built-in transfer server, type the address it shows into any browser on your PC, and drag files straight into the headset over Wi-Fi. It works the other way too: pull your screenshots and recordings off the headset without plugging anything in.\n\nMOVE FILES PROPERLY\n- Dual panel: source on the left, destination on the right. Copy between any two locations \u2014 NAS to headset, headset to USB, Drive to Dropbox.\n- Background transfers: a 20 GB pull off your NAS keeps running when you put the headset down.\n- Archives: open and extract ZIP, 7z, RAR and TAR in place.\n\nBUILT FOR VR\nBig, clearly labelled controls for controllers and hand tracking. Images, PDFs, text and audio open right inside the app; video hands off to your VR player.\n\nTOOLS\nStorage Analyzer, Junk Cleaner, Duplicate Finder, Large Files \u2014 for when the headset fills up.\n\nPRIVATE BY DESIGN\nNo accounts, no analytics, no cloud middleman. Your files, network passwords and cloud sign-ins never leave your headset.\n\nSUPPORT\nBugs, feature requests and help: https://discord.gg/UJSn59DDsv", "short_description": "QuestFiles is a real file manager for your headset. Reach your PC or NAS over SMB, FTP, SFTP and WebDAV, open Google Drive and Dropbox, plug in a USB drive \u2014 NTFS included \u2014 and copy between any two of them in dual-pane mode. Extract ZIP, 7z and RAR without a PC. Long transfers keep running while the headset sleeps. Storage Analyzer, Junk Cleaner and Duplicate Finder win the space back. No servers, no analytics, no account: your files and passwords never leave the device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questfiles/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/UJSn59DDsv", "website_url": "https://f1tt0n.github.io/questfiles/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1162974436903470"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2140091660720203"}, {"status": "PUBLISHED", "id": "903634319447732"}, {"status": "PUBLISHED", "id": "4320973418194023"}]}, "baseline_offer": {"id": "2140091660720203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788534000, "status": "PUBLISHED", "id": "2140091660720203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1262086683658911", "version": "1.1.9"}, "id": "987224660846928", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
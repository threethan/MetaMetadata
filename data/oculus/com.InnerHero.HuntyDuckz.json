09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X59har_SJi8Q7kNvwFDLmmD&_nc_oc=AdoyvUjeVxkufxO4rK8X9aWgXIYNDDB0--lWAug8aB_6evQiRyVVGShvtm8Z_z3mObM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfimM3Y66y9hXg8vSr32gwSqKHQvxzmQFaKVjvfHtXIQ&oe=6AA56D67"}, {"file_name": "HV3SS1.png", "id": "579173918427452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394163_579173921760785_3908378811625041107_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kufJCHvkeQcQ7kNvwEibgPE&_nc_oc=AdpfPELpz3pM6O1Rc5d5RTw288hWWeHwn9l68r9CTdhkpglQKy4pxaitiuTK9deemko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd0FsNIhq2ryPVK-u3h1yFD_PFQpDKq3--tlJBpyi3fQ&oe=6AA55796"}, {"file_name": "HV3SS5.png", "id": "1114350219981254", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394159_1114350223314587_2892999508904884057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-wf5kXlawQ7kNvwG3nmCE&_nc_oc=AdpG0gNHFJb_Nyj12As6VldQI_K7tWILB5htkPNrELCj7toy_kIwoW7IQlfM6SiYks4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2FgVRQSxGzalWrPjV-VKhYUtXMsFOZuYwzJ4ap_vfvA&oe=6AA57444"}, {"file_name": "HV5_SS3.png", "id": "1570179294580994", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604366035_1570179297914327_6263873242487544278_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3yuA7rcuN4Q7kNvwFUpzWy&_nc_oc=Adp4nsDANWWWEVJMlFLaMrkwYZ40YKs08woRLcgTbSLAPBA-xskfoTy1ql4d_zY77Us&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNB25otw4BZzDrp5XnynlbA0Xf7wUuSlIXs46MUuOZwA&oe=6AA553B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HV5_New.png", "id": "2160435841181853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831569_2160435844515186_1595425237509263352_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZWPxYfQI0wQ7kNvwGIxsV_&_nc_oc=AdrfO7_nmi1yD6lFVXJLDgux7nABzrU6jfaTJ5_-27ce2agfHsDUqOAdaJ1I5Mvr728&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPFsscEPFQUDa2cKsKEyU1W2DMK1LGg8BLwZbEm4n_hg&oe=6AA55ADC"}, "display_name": "HuntyVerse", "keywords": ["arcade", "shooter", "hunting", "animals", "guns"], "long_description": "# HUNTYVERSE\n\n**Explore. Hunt. Ride. Compete.**\n\nWelcome to **HuntyVerse**, a VR hunting playground combining open-world exploration, multiplayer competition, customizable avatars, and fast-paced arcade action.\n\n{1046092554999574}\n\n# \ud83c\udf0e EXPLORE THE OPEN WORLD\n\nJump into a massive multiplayer Open World and explore a huge island filled with wildlife. Roam on foot or tear across the wilderness on an ATV while hunting ducks, turkeys, rabbits, and more.\n\n{1420395139951057}\n\n# \ud83d\udc65 MULTIPLAYER & CUSTOMIZATION\n\nPlay online with up to 4 players and create your own hunter with customizable avatars and outfits. Explore together, race ATVs, hunt wildlife, or compete in The Hunt, where players race to find and hunt a list of animals. Get there fast, make your shots count, and finish first!\n\n{1802929560889798}\n\n# \ud83e\udd86 ORIGINAL ARCADE MODES\n\nWant instant action? Jump into the original **HuntyVerse** arcade modes for quick, replayable VR hunting where speed, accuracy, and high scores take center stage.\n\nHunt ducks and deer, tackle challenges, compete with friends, and fight for your place on the leaderboards.\n\n{1090924407236430}\n\n# \ud83d\udd2b UNLOCK & COLLECT\n\nUnlock guns, gloves, avatar outfits, and more. Discover collectible cards, complete dozens of achievements, and compete across multiple leaderboards.\n\nExplore the wilderness. Hunt wildlife. Ride ATVs. Customize your hunter. Compete with friends.\n\n{1045044271486267}\n\n# The hunt is bigger than ever. Welcome to HuntyVerse!\n", "short_description": "Explore, hunt, ride, and compete in HuntyVerse! Customize your avatar and jump into a massive Open World with up to 4 players. Hunt ducks, turkeys, rabbits, and more, explore the island, tear across the wilderness on ATVs, or compete in The Hunt. Want instant action? Jump into the original arcade modes for fast-paced hunting, challenges, high scores, and leaderboards. Unlock guns, gloves, outfits, collectibles, achievements, and more. The hunt is bigger than ever!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huntyverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Inner Hero LLC", "support_website_url": null, "website_url": "https://www.huntyverse.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27960850830242701"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313074_849664497697843_316502728812806801_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT_yd0fMDZ8Q7kNvwGF6-sO&_nc_oc=AdodPdriUYOAGRXg34fY8uTx5OOC3uO78Ser8_sEbxENysCFzFYrDNSR6ZxBMwYZcRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZPuJHxTEebrGusICAhOiFHFSrU2pLJ_U9yc6bESOffg&oe=6AA575FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HuntyVerse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": 
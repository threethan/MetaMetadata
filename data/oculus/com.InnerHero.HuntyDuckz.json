883985699_4062922903346010643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqCUMLGhjDUQ7kNvwHk9lHg&_nc_oc=AdrzkcoP7AQSjxt4BH-5Z0rEsoql9OZmm-2ppvicxYtWHFiYt0_nq1Icnxd7-Z1R7ic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv2-Vvq8s-Pm0zGb6k7PXsZhBaJtUy3aaRnUDewOGZlg&oe=6AA545AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HuntyDuckzHeroLandscape2560.png", "id": "140645865717826", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269160_140645872384492_3483965729689435135_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7y2sVPfJwYQ7kNvwEfTmEt&_nc_oc=AdqeRg8gYAfufH_tRJazqVSgnlAnnLWgCDahEZETpZhFhFJANLyEXg7GYG0Tf5K-6g8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKud_fldAHIw19LNplTAmszCvKAjtS5gcpjrCF4TZTxeA&oe=6AA570EC"}, "display_name": "Hunty Duckz", "keywords": [], "long_description": "Load up for the cutest, most fun hunting experience in VR! Don't you worry! No duckz or animals were hurt in the creation of this game!\n\nThis bubbly arcade shooter will put your skills up against your friends and the world's best in 3 overly addictive game modes:\n\nStreak: Hit the most duckz you can in a row! Make sure to pay attention! If you miss, it's game over!\n\nClassic: You get 3 misses to hit as many duckz as you can. This is a great mode to get used to the Hunty Duckz experience. Explore the scenes and make your shots count! Gameplay perfect for switching up the headset to hunt with friends. \n\nArcade: It is Hunty Duckz chaos! Hit as many duckz as you can in a 45 second time frame. Go for hit streaks and in game bonuses to increase your time and grow your score. Be sure to pay attention! Duckz come from everywhere! It's mayhem!\n\nLeaderboards: Are you the best at Hunty Duckz? With leaderboards for every game mode, you will be able to see where you stack up against your friends and the world to see who has the best aim of them all! The points used to jump up the leaderboard will also accumulate to help with in game gear access so make it count!\n\nImmerse yourself in the animated wild for a hunting game approved for all Oculus ages! Right from the comfortable playing area of your choice. No heaters or rain gear required. ", "short_description": "Load up for the cutest, most fun hunting experience in VR! Don't you worry! No duckz or animals were hurt in the creation of this game!\n\nThis bubbly arcade shooter will put your skills up against your friends and the world's best in 3 overly addictive game modes.\n\nImmerse yourself in the animated wild for a hunting game approved for all Oculus ages! Right from the comfortable playing area of your choice. No heaters or rain gear required. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://innerherostudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Inner Hero LLC", "support_website_url": null, "website_url": "http://innerherostudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "323347950019382"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "508506105522762"}, {"status": "PUBLISHED", "id": "1327483047807741"}]}, "baseline_offer": {"id": "508506105522762"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732589040, "status": "PUBLIS
ams2-1.oculuscdn.com/v/t64.5771-25/39035428_522086285194684_3554199374332428288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFjvFiOM6wQQ7kNvwF3Fzso&_nc_oc=AdkjoMKYl1PL2s_icQOLoneItlUxHnpcU8eQKr-yy6sZDLAtDIppOg1lo1j1aqdpIQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfVytiq5SzkKEHhj67Dy7azOv6vFFbHp1tjpF8lMyaFw&oe=69AEB091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blast2560.png", "id": "1004061050511020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035314_1004061057177686_5737463710924949171_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwncBxgPhdMQ7kNvwFjZ8ck&_nc_oc=AdldVlkrGiq2XH3r6xOB1RD0aIez6w6457m7OaZpdy6jCn34oHnc3167oQKIBy1k5Lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqjGyOhOkAlLedfG3MQ0_fG7NpH8VAkbo5xa4NdhJ2Sw&oe=69AEC613"}, "display_name": "Neon Blast VR", "keywords": ["Neon", "Shooter", "Music", "Sound", "Arcade"], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Infinite numbers of shoots\n- Neon lights scene\n- Sound visualization", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Infinite numbers of shoots\n- Neon lights scene\n- Sound visualization"}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.c
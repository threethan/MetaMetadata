 unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Infinite numbers of shoots\n- Neon lights scene\n- Sound visualization"}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor`s Games", "support_website_url": "https://raptorsreality.com/", "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "233915835918203"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982661_2907436819291011_494521538029027328_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEg-v-t2fdcQ7kNvwE7Gtsp&_nc_oc=Ado_dpYixt5Ud087tZDXbcYmvntzKYKF3A7vHytoPrfEZqFlly4Gvhw1RVxZBSpSe2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0yiGsbGZVFVy6dffEmgicXXwQVfE-IZfb8csSfsi6rA&oe=6B0C5D51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Neon Blast VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1571331600, "lastRevision": {"nodes": [{"id": "2325131507701751", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
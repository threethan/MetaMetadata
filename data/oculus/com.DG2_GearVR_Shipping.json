fCchAcZabt1QNYLmjrC0NXIwEDcvDuvIq8nZkLg&oe=6AFDCD87"}, {"file_name": "migrated_image.png", "id": "150511852861336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427647_407275803101024_1399706928115875840_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUiQlgcjuDYQ7kNvwEt2uZY&_nc_oc=AdpzcE-kA5O1kZtyKOoSAxKqkdOHBFaIgj7k7G-fQH7GobreKbioxSWo5cViHc4jJnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDO8X8SXtbbMIvZptdgWypyfycv6uPTqMmAGuQtPn2Ww&oe=6AFDC5A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Defense Grid 2", "keywords": ["Tower", "god", "free", "Strategy", "Defense"], "long_description": "Defense Grid 2\u2019s amazing tower-defense strategy gameplay comes to mobile VR.  Defense Grid 2 pushes premium mobile VR gaming to its limits - utilizing the latest VR technology, Defense Grid brings Rift quality gaming to mobile devices.  We recommend updating your Android device to the latest OS version and drivers to ensure the best possible gaming experience.\n\nDefense Grid has long been the gold standard of tower defense strategy games, and the VR version is one of the most comfortable VR games you can purchase while giving you a physical sense of the action around you that really enhances your strategic awareness of the game. Defense Grid 2 supports the mobile VR controllers, standard headset controls, or a Bluetooth Gamepad so you can play the way you want to play.\n\nPlay the 26 mission story campaign, unlock achievements, or claim glory on the leaderboads today!", "short_description": "Defense Grid 2\u2019s amazing tower-defense strategy gameplay comes to mobile VR! Defense Grid 2 pushes premium mobile VR gaming to its limits - utilizing the latest VR technology, Defense Grid brings Rift quality gaming to mobile devices."}]}, "developer_name": "Hidden Path Entertainment", "developer_privacy_policy_url": "https://www.hiddenpath.com/privacy-policy/", "developer_terms_of_serv
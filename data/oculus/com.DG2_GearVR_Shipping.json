uscdn.com/v/t64.5771-25/12504696_360410607676111_8846753952465682432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z49mwsejZZQQ7kNvwE4svRB&_nc_oc=Ado8P7hEY5lity_YNbhQCTmCGFq8vORqwoRBErbDuM1zsIfYqmsA617QLHxB3lB9nyQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lwmfva6Vl82gH3fIyWgLQUnT7UE7VVkO46w9vzeDoYg&oe=6A36A748"}, {"file_name": "migrated_image.png", "id": "299649311007835", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139502_1240147686067907_2485357622685859840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h5xpHkW09sQ7kNvwF5zXB7&_nc_oc=AdqoNu8P_2XwWWGBmlUO5T6E9KhRAlog5CDvQ1J8giAQb1ehkHmANNVNRuZev5djchM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eNRMy4YIfAczkyLOgrT_md6gUDF4hpaRFjOEmHpysJQ&oe=6A36A82A"}, {"file_name": "migrated_image.png", "id": "151381996091489", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12533755_1345324618859167_607499879656194048_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfnNVftrhgIQ7kNvwEK_L98&_nc_oc=Adom3cmYS9U3Y7sBOnDKJnuqCvssEKO9rkA6vG5fXrcZ_YD_hivscAbtgLrPqhOOn7g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bx_ivE8uDRG7j2oEbu76MYkJhEV2GJXXZmQF8EH7npQ&oe=6A36BFCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Defense Grid 2: GearVR", "keywords": ["Tower", "god", "free", "Strategy", "Defense"], "long_description": "Defense Grid 2\u2019s  amazing tower-defense strategy gameplay comes to Gear VR and supports the Gear VR Controller!  It is \u201cFree to Try\u201d providing the full first chapter of content for free, with only a single upgrade purchase to unlock FIVE additional chapters of content.  Defense Grid 2 pushes premium mobile VR gaming to its limits - utilizing the latest VR technology, Defense Grid brings Rift quality gaming to Gear VR.  We recommend updating your Android device to the latest OS version and drivers to ensure the best possible gaming experience.\n\nDefense Grid has long been the gold standard of tower defense strategy games, and the VR version is one of the most comfortable VR games you can purchase while giving you a physical sense of the action around you that really enhances your strategic awareness of the game. Defense Grid 2 supports the Gear VR Controller, standard headset controls, or a Bluetooth Gamepad so you can play the way you want to play.", "short_description": "Defense Grid 2\u2019s amazing tower-defense strategy gameplay comes to Gear VR and the Gear VR Controller! It is \u201cFree to Try\u201d with plenty of initial content and only a single purchase to unlock everything else. DG2 pushes premium mobile VR gaming to its limits."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hiddenpath.com/privacy-policy/", "developer_terms_of_service_url": "http://www.hiddenpath.com/terms-of-use/", "publisher_name": "Hidden Path Entertainment", "support_website_url": null, "website_url": "http://www.hiddenpath.com/game/defense-grid-2-enhanced-vr-edition/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "ko", "es"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4840478422688491"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "567115243701832"}, {"status": "PUBLISHED", "id": "2124096017889941"}, {"status": "PUBLISHED", "id": "185089628872977"}, {"status": "PUBLISHED", "id": "720716744995439"}, {"status": "PUBLISHED", "id": "1348212861962948"}, {"status": "PUBLISHED", "id": "549750808
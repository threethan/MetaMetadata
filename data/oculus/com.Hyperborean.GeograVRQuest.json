&_nc_sid=6e7a0a&_nc_ohc=VB3v5wjLnIwQ7kNvwFfMUGs&_nc_oc=Adr6yab7kf1aigueqRf3WY2awVDaVnaYKb1l5e1-ZoUoQZQzOQUsRVqejd7PYffNkAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SpWjIlFwGqBMn44FFhZff8DpUGR48BeZFPcGCGzwIXQ&oe=69EE0330"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_ySVEADhyQQ7kNvwHv54Ca&_nc_oc=AdpgymQtFGhXC_j5CK4HgZzLcMsm8E2zqH0kctqTXX-TEP_kxhQTIOGbSXE97jq7DVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JP373dzL4FwppBv7lnGN0QHzuROaA1jiYPq55oFsb2Q&oe=69EE1289"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nTQ4bQLptsQ7kNvwGqoc6n&_nc_oc=Adpd6tpd_g1l0Pym57slYCm2vXfrpgt7zM2wVy74_92-fP8wsGqEjNwGjY35zWbBgJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xAfGVWmkE-rXghc7PokLNNlZEMBhtug4zbDBrS4yd4g&oe=69EE04C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93sn8foduzgQ7kNvwG-udLc&_nc_oc=AdouV5yLewMZYB9YMPgHQmCX2QIugtFHgbMj6FRG89JpEV7MoTI3rDaZ9ISYJ2ghpwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i5M-hATj7aQU0FVrQRDPw4uHOV47fXzggkxUM6k9K3Q&oe=69EDF12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4H8W_uNnGQQ7kNvwEwSxHr&_nc_oc=Adq-VvtofW95imcQCuq-_HUc6viKlBzLnYLsF2MQFaV7_-kktrqcNuH-hhPBAGtQ4sA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SM00QReLFAQ7Vs84amO6kyrVpFjNxv5_U0I0kyABctA&oe=69EE2381"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
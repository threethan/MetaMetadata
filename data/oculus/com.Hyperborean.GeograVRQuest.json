&_nc_sid=6e7a0a&_nc_ohc=hyFP0s4o9zAQ7kNvwGy574j&_nc_oc=AdrGmf6NVL5yAbrtbLCqe_1fxTPVAMyc1tEEQ0rXVKorD2sJzu74YB5z8cso8b66Xnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW3x-t8BRbLQzFasQc2uRYdmNkY8KJGBBl5YS7oL8N6Q&oe=6AF1F2F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iItoYtV94P4Q7kNvwFySkvr&_nc_oc=Adph7dZ4s0De_CG9a3R_uxl7siKD3e2QUwpjthD9I3-xN3ZgNKQCQZJO4OWQz2pVyJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8SCxlqNy1V_n1MOpCspxRSHAGZazaY_fVadovngrQew&oe=6AF20249"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfDnDuAbEYsQ7kNvwG9yCkA&_nc_oc=AdpNsntJwzM7TK795a7ttHMqMUKzdLtmxCtRA8ZQnL5TxNIYKcHCjo0HbMpJqji1vxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5gd1zHVmbOhs2ljpoxQnmTiWAb1zLWCth8Uu9-TLqew&oe=6AF1F487"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgxPC2F5IeYQ7kNvwF6rCRK&_nc_oc=AdpT2JLGDtfXglyJzS3QdsP72NAxD2uO7Bx2vdW-PZUdXdp8AIuSU572JSHap3qKt_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiyCHRxWd-_rGS0eSVhTpV2Cn5ccZWJOaeyomLNakjug&oe=6AF1E0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyxVe_RQXf8Q7kNvwHI75MN&_nc_oc=AdowbnzFVt-vN5KKD3kTzqZ7u3vnwMB-PFBF-caRZXgXxBfZje9bjIS6mSwInZmK7D8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSIjBuc6YsraefxTwt1fqcy-hF4XtwTL_W3XYfzcgKAQ&oe=6AF1DB01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=4BYgP4ZstC4Q7kNvwF3N6BK&_nc_oc=Adp6_2ZyXSGOiOdPx9LRzDfK9hl17zADfbBTFnwOaqB6yFkCVD3WzgvKsEmzrr4m6U0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4TRTPt7iBHuQJUhHwQLh5rxHv0kb6aAqM_mXhiyIIxQ&oe=6AD0FD70"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEmzbvU-TDEQ7kNvwEjcXz3&_nc_oc=Adp3ODOWTTN75KDIDvThfdn5BYpU5mCQxvuC4z9drTsfJ53Z0JWt7lA7vdYti8-yaQE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuM1p2N5o6bpCjFTxuD-alTh-blG0s40I5zBY92PI3Ow&oe=6AD0D489"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsRmo5NEEGwQ7kNvwGlxbwr&_nc_oc=Adr7aDD5ADF-4NHzSV4Emd_ze5tqqKmFTULH5vQ4xTx-rvAcXp49x8VeX7wGVyxGBgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeTcC47mtYJ_EG23e7tT4Ho5fTnVcmTwzhXEpEUM4T4w&oe=6AD0FF07"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQkMW3KSZH8Q7kNvwGvBA3j&_nc_oc=AdrS-3B8xIx2wq9nQFX81He7W1GoBzBuhBn65Ym1YgKEmOqzk1meKPvcjTQhxKaxXII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvQqpd8Umhm4AufALv1b0KBRtuY_t7Rp4AwmoySkuJaw&oe=6AD0EB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkJRE24z-80Q7kNvwGmiRIv&_nc_oc=Adpf-D0HOxZSWWfoXBA9ih6WQaH9PON8ACxKvzRm9rMLpLpLbr-zCRHu_RgXysYYoZc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcbqpte5weBJWMGX15ea0nDTyphjw4nVJaARTHfKKUow&oe=6AD0E581"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
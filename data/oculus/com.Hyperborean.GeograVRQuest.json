uwQQ7kNvwHj2vq8&_nc_oc=AdkHcDinYCA2lTbDZ2B8l6wL0jNWP_yz0BfHCgXOyPhd76Wo0K7Hx2T8EUm9D-9JpnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl_CpH-IYQ4r4VrmgbwEJij8BnbW8gHo1LZBKkfMWMSw&oe=69AEBB30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2yZ6fs2EfAQ7kNvwGZIBZP&_nc_oc=Adn_0Ff0yDk2ck-G_OeAOGfWJZWrmPDIbnMwmpDHo5HQ5UBEvGLmQvRFE9R7HNiPXoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjUTH5y9ofpnvIeMiUzu67ZMpY_sP85tJk8RiIuNmLvw&oe=69AECA89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPFulY8kW20Q7kNvwEmIgkX&_nc_oc=AdlWaytdEfMURvPIgBrn9zcjlzGHDsLbicRe99mv0C90pRYfdKAJotgz_aoZtzy82cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaA21128ANTY09J8jNkIpE8hfjmQ0C1Kxk0es2jNmuoQ&oe=69AEBCC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWZeN4F34oQQ7kNvwEEMceY&_nc_oc=Adm6hjlesZEZNq1ledMH1Y9O995ThsmRcgfX9R7MMxbDatzZiNhbB5iOC9TtgraBzy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFkbRMmvlMBkz-MIeQjAYndCkShb8tlgBoidOPeA2dSA&oe=69AEA92D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW8XI68yRzkQ7kNvwFO_rK1&_nc_oc=AdmV2fTvLtzM-e183L5tWBjrbNG8QxG1uGSs4IXqp5MkyRJmPkAhxonLtqdLslq77Dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqWpNT9ClFELJSpzi9geZNxD5Gv2qjBFdbE34bFidvZA&oe=69AEDB81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
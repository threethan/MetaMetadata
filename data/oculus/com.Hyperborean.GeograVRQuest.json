&_nc_sid=6e7a0a&_nc_ohc=G0kuGIdMkUAQ7kNvwGy-cgN&_nc_oc=AdpG5v0q8FeJQDTZZrvlIbtScPPl2udLD36ka51jGNdpriUcNEREapuRAbX_8-pEfGs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs0Xt1a56rlbMv3BbCuyfQG2Dqa-dSQ3Viyk0G3JdBNw&oe=6AC51FF0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUUcg-RpGCMQ7kNvwGk5iPN&_nc_oc=AdqrJRz2hxW88GBwiNaeMhHYI3LEEQAq4-XqB-c0Ycj7imKIV_zB-GTRM9BTVaSh8KU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4fIIeqXl5_gI4x0PgApbE4uzjBdKbDXFgfKtgz8r4GA&oe=6AC4F709"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdjNvTaoL90Q7kNvwHL_Ylf&_nc_oc=AdqyZ8n752iUcCFcYdfWpIhpWpGATd15eWB9IEfrxdVCxlBEno1ZYdGvQmWkbc6WZyM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwQfFg09DgOewgk0O87sURxhzZ_Xnx7LTzVL4Luf7vEA&oe=6AC52187"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RdvNX5ZDB8Q7kNvwHB1IXF&_nc_oc=AdrxyIRMCvAGlmCYAlEqpX7NrHcF6dRuO3Nh2nCqaRnwvBfoAKqYKQF7IPz9shXS0q8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8kzu6JQva4Yy4PQLVklILK1ngLDQ7AOcokhJ0bHCP8A&oe=6AC50DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_lDGKYsZlUQ7kNvwGyAlRd&_nc_oc=Adrb5lc33yhlgwfYVFwz2qhOBLzg4VFw9Qfg1HgK18EnAEiE8T4ZVVln4JHX2Om7RZM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPN1-ytzIlmpDSAXVdIQPac081J-VlueLeLhEeP8iqXA&oe=6AC50801"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
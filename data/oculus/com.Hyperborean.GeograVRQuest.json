&_nc_sid=6e7a0a&_nc_ohc=HeGyy_CaIdgQ7kNvwGUDZNO&_nc_oc=Ado25OWYUo1_hX5DbqGqUS99Z_VVfTsCSVQxR7jSxpAtIjZxDr0gkAiXkl6_yJVKCco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpn2EnlYf65CTZ5AIECxL24-Xsr_ZAVMQt1to2oN5Iyw&oe=6A4A8470"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7aL-vgVVpEQ7kNvwHsy4Ek&_nc_oc=Adr_nWyggCxFPpqY44VbvDXnlbi2Et006ifwqbaFxxEB1Pem8fbwc4_WGZHcD0fL2CM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ8aIdHa7a8dO4S1Rz1F7hs07NFKBczOhH48Dfe6sraw&oe=6A4A5B89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSrPvbea24oQ7kNvwFy7VRM&_nc_oc=Adrb-cykVdk_EoS6e01gnc4BpVcMbCrkeZGM5qInqvzkukuDipI_XM8NQSTvV9uOimY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3vx5c6BTa_6uIJqF-0an1Al6zK7bok34XDBsDJdnEZw&oe=6A4A8607"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDkohKSLx2cQ7kNvwEFg8Mm&_nc_oc=Adrr0ZJquc5t36JrbeTXyY0pGEeEd2S6AcB3rrTy39ERL2aME3mcYszsNXCf9EbzmPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQbnNPnSUf6evQb0p7ipdgV6SLwzs9JYaan2Ae7q5kXA&oe=6A4A726D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ktumykZ-aUQ7kNvwEwTqvC&_nc_oc=AdqA5vnWOtb_FtAlll4xrP7DMxvbyUd0ZLYruD3aMgMkzEg7p5obAxaxmUQjJKLlxJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6F3rzjhIM015jz0trKVixoKes77xIv1E2fv2dqVatYA&oe=6A4A6C81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=oERscVivUEwQ7kNvwGvMogk&_nc_oc=AdpldVpU7M_0mLJ3TRWxz-Ca2bebJmu6euA1vVntqfnfdHnhIxZzghGZupwJFMwe0ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gSAvNGeqFcygSk6vI4SjVep83WnPMIxE0svwdrl_R6Q&oe=69D3A530"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa8BGmcPtxoQ7kNvwF7y7SY&_nc_oc=AdrM-RBnAEpsRWxdP_EocOPUF2s1CdwFU5sckS3pmYz5EtjAK8cn9VhaJCHz5030yb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jsE3q4gqyODPVqyFOaWpi_Ca_JfmqiNCWCWxRGV1Uww&oe=69D3B489"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RYOpATPxI8Q7kNvwEs8-1A&_nc_oc=AdrfPRSYie2GCGUhb1MLFyKxDgCMsbzuDasDOalG7OG2yAHN1QPQgXeS9JGEhhf1XSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_yI51lIK0s57PKNfadGmnnVzh32MUNTDOhrZDyewihg&oe=69D3A6C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG3psZEhDwAQ7kNvwHJczwN&_nc_oc=AdqjRRmb9om7ysBjElvs1laUhvU-3E5fYpg6cel18EK-Y5jIGKHwb86x3Z5k3bo9SJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lqKkKLn8PaQT76DK_R0yPtsPqK_cbXwSNZUxWSutGiA&oe=69D3932D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt6wZtMpLhgQ7kNvwEl6nsQ&_nc_oc=Adr11cp4j0xiksuvOVwsfRsGfUKODrUNTkCc8dKTBQza-esEKBeGOs3KmqCf1yGLjEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HPaEyDyxPQIePliq2qvTz1X7BcSfezEgiLg-NwpzH7A&oe=69D3C581"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=47zr7MELXd0Q7kNvwFtJsnz&_nc_oc=Ado-orwaqvzIVFjBoNcSUTEmZokrf7_3Y4l-EQocDNQqrKc-r1BdhXxX8LxYCyzYogc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XwIVGm-dXk4gLnFYrDSgkDpo7wFWXkxvKANgyJqRiWQ&oe=6A3AB270"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai8qPZ1OHkQQ7kNvwEQ83V9&_nc_oc=Adpt3tO_ynX3Yc0jZhDMEHTd5sHJySR3js2PyeGsvtCcLRj6uxTXijqd1UW5JzdswW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v51vcf7oS6wtW5VwDEtc4cm37UHTWQR81-jGxfBCnrg&oe=6A3A8989"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K-BNhc9SFsQ7kNvwG9VBU5&_nc_oc=Adp1U47Md85ffblC0JVF0b0Tw687AjLfvR-3Hysju0L6G3Feyqn8J-7gi-FnXePwTyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ndMfuurvbN86lP-d2iQGsZJfBXIJwlhYgxDJ0nPofXw&oe=6A3AB407"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh9wNbVqh1QQ7kNvwEUO4RM&_nc_oc=AdowTEKHpUeH4prPeOFZMiwYWD12lCiaxVuBnJ2xfZCdEZuP2hSLxbZP6aL6QVNMK_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Y3F4LgqXTXXnPYuFHoR1HwEShWrifZXaDOqyVJMKCA&oe=6A3AA06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwi7ulTgXXoQ7kNvwHTGGJ4&_nc_oc=AdqNJmPhu486R31iAWe208MBq_KOUlz9LC15vgqFsenbAvp-WW4lpG3eZpVPcEVNMQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Wsbq61KnV4liKKlv-OvyRK5P4k16GaQusfaTu_RXqYw&oe=6A3A9A81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
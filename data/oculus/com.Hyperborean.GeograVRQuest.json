eaQBPCgQ7kNvwGkI871&_nc_oc=Adm-CiuSFdHEnCDjUeDO6U9HrtouZ9QVUY4ZSs9naaSVKiIEV0_nbBSq-EXlgPdE6zw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNbaDMgNakYV0Bqe2KkXH-WlOw7udUH0_u-6jYjoCDgg&oe=69AAC6B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo6fWm12LssQ7kNvwGEx5Bx&_nc_oc=AdmN-TbuufE24rwPrmpJgxruovXrNRiigGoMbMUTL4fQxCIHzVBzpJ_U_tIkUtJXK-E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUe89voqoTBY8Uty1YP-E2xVYJ1cR1ZBSTbOyWUlFXmw&oe=69AAD609"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57N4IJEy_DkQ7kNvwHpZU0V&_nc_oc=AdnAi4kdle4QBPlqNF4XgTB3hY6bvz68kgRIVfdjVdKpCu67CGz7fCrOnhwc8S9RPZw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJaL06JWGlnZCMLjs9FJ1ylzHXRKpj6fVfCwlu8hDYpQ&oe=69AAC847"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOGyq5AM3CEQ7kNvwGLVOO9&_nc_oc=Adn_qPFvsez0u6Qs2-pzVm7Dtc_OemunEmyCnAsgeMgD80nZnZlLVT5s2jKclVhHzpo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxqgjcr-5uQaAdWHSDAeUUpWnv_JRuxNwReoEnVepsBKg&oe=69AAB4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9m5VxlAC8QQ7kNvwERR00q&_nc_oc=AdmLuPu2H1WpKYl4N0mVeocn5uKf8hLL0G28ZO_4PBnW22AnrupoNO97823gKRkvD5o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzFWMJ5DE-RVaMY1BMQgoUvNUp8Y6hvU5lDFlxLwLAwg&oe=69AAE701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
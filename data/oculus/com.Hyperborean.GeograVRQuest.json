&_nc_sid=6e7a0a&_nc_ohc=wjeaTcALUcsQ7kNvwFFjDrB&_nc_oc=AdpN1N7WmsE4dVDNtYrzHABauEZukTE2h7lEtNkVAn4ED3fipJjRsUyR31VnbY5ORGA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAFzCLFkNZQd88ffY6AluS2QUHfo08aWxecc6Y9emxVg&oe=6A9733B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZsKWqUPO8AQ7kNvwE4A-4T&_nc_oc=Adp355RnwIZ9UWkPiwDpgRA8T-CpabQsFRuSpUlh4fOUAxvQTyN0pdrNnuMJYsHNr4s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0veehXs7Uf6NjlaVrWdORnYHbLCybkNWJda-qFu0YVA&oe=6A974309"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bHp2seNYUAQ7kNvwF9OnZP&_nc_oc=AdpKDEJ6OAZ_TFVlQS7Ce_aB3wSo69ydbLfyDX3ybGrZYY5uMr2NVGrNMOqkWvzp600&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyrJuvbphaSJUjRfLjXdISxyZm5F7V5xP9A66idVUFRQ&oe=6A973547"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0l8iu-VuiQQ7kNvwHxRElE&_nc_oc=AdrkoNdLz-RFSpL410AeNMv9t9-Ku_8nesx0HGPLn52x3pYxyv58Teohm0Hd_g98I10&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhXm4g6GbVf8MC2bSNo2KddZ4P1s3pYu-lnyUpyu3H5Q&oe=6A9721AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s81sCMpVuscQ7kNvwFeYTTb&_nc_oc=AdpwITjdUwCN-XB8m7L9MrOpXwnt4qKfwBoY0gTBJJRpxt9E5mKYS-0cphqEZFqXpMM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzO2ee9E9Ttpo_VPDkeL7dXejPbrF26vktYJzcMEORjQ&oe=6A971BC1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
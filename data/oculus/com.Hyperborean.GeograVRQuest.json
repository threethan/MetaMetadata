&_nc_sid=6e7a0a&_nc_ohc=ootlxPZGaZsQ7kNvwGnM41O&_nc_oc=Adpyb6KYCiSsBFJli-U2nzBuwo2Q5lxCHc25cEViwL2RK0Z1jr16zwSkF8CssvemGO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYV1SC9alm2ffoDcRaSFSCjZKmiU9SK1j8tRPsh38Jaw&oe=6A50E3B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSREgP9GTjgQ7kNvwF3k1MH&_nc_oc=AdrRUKkVOmfoFlppjD9dBwBuKMqGPYQyrr1HsawV8plnQMuJGDIxU4VabVqvjZaP1Hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTFCJPKbnbzQ7Y4F76anbjm1Ny_JFDsjOq5jZYzuKYSg&oe=6A50F309"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfY12VuM4bgQ7kNvwGGH-oN&_nc_oc=AdrZ59satloZnbmOtl_DmkPIF6MxHgE-8HTybwsFFOCCi2FO3z-D3edmv1e5ZMd0Uo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeExwAOW5Mrt3mKvKMgQWYg5oq056Jvj9lYDh9JkbOeA&oe=6A50E547"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN96hDcHBGUQ7kNvwHZgKPF&_nc_oc=AdplBqAUBS7fFR8lC6qp32EAlsD-ABWsbdt5J8zkQONxIxC6KDcCG15vRcdg90kTbuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcbDHfBT6XmtnRlQObYyWwX9f59kEOLpbAdlzMMRi05Q&oe=6A5109ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6DXzxI1hWgQ7kNvwF5aBhc&_nc_oc=AdqwIcfzcIvQLd8Y3DjICBVnFSWIg-8hYM-5KP82Cms_PGGcsrhO7R9u-oou3ykSuJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS7dx5Nc9WUJ7bUiDYWRgpvRQI7KBwnYV7P-edXbBVIw&oe=6A510401"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
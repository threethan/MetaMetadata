nt-sea5-2.oculuscdn.com/v/t64.5771-25/38974602_643662246757239_3081913009937865008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKZwyLIFGdQQ7kNvwEz_m3G&_nc_oc=Adpz54m5iUE9_hp0phKY0NpdQDTp_sPhMGdvYLiTFfdrBBTaJrn2CxZ6JRpmP5fLBkg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9yxuE2iCFEeU8_W9mRIuuILs9tJcIbTTLYbEAsBufkg&oe=6AFC7EF0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX19MFqULg4Q7kNvwE20aEy&_nc_oc=AdqeBveV3xklKSHPkKhSH8m0KTTBCoQrNeA7DYhpbpaRDL0Z3NOijF6AuM0rproqQuw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa-1XPWdW2V_qsUJ20HF-ObFMALF2s-GhDti8ljvjSJg&oe=6AFC8E49"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YojLk_0u7AQ7kNvwFRb2Vf&_nc_oc=Adon4Gz6sSS7Q5nJ3jNlCsiqaN2JfBbRCGq1kXqtmpYOi-BK92kvre9p4NeupBXFg-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_hud0MxaIKT9d5lfPFB-xCqovwlxAs5hqHigLxFjXSg&oe=6AFC8087"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qJ-r4EkaQUQ7kNvwGfGkuZ&_nc_oc=AdrN_718v56xdxaHeL1UlAoqVkNk3G1RrAMBjOBNlszdy76IkBn0vkNuxVzmV3kFeoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwjpb0ixWLwVW6WdCW9IBDOGma63I0FbVwTxYrok9YdQ&oe=6AFC6CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb4zm3AKdzkQ7kNvwFjgyzF&_nc_oc=AdrjoZVtVensdn-1oUONy1flXOd02klzsw_z4ysWts8ha3faO73TdUIxq3BqHwxeh-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQNb5y_e9sI5z19MVDlB_5cqdB3OhuVynCAddx7wQXxg&oe=6AFC6701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["AR
&_nc_sid=6e7a0a&_nc_ohc=byi_bkAU2BUQ7kNvwEdA4Q4&_nc_oc=Adqslizi-40Gs9bAyyrxz1ynJ7rMfObIADFBoBtlZnUTTBe5VaogvCuBn41CgtQSha4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3VhOxX2_CwK2gC8ypDior-SQV8I4ddeStI3rRwoAaIg&oe=6ABBE570"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMxjkb8ry1YQ7kNvwHf8msd&_nc_oc=AdqWAPuz3QZOHvmaL8J2fJeIo8iCjjcq_-B5gdRdI2SArM94Nsx450zuvRDJTM5pu1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlmo6435O3pQFwWKlbpam4v5qWPxtRmLZUwI1Ui2DgLA&oe=6ABBBC89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMixiMa8ROUQ7kNvwEixobp&_nc_oc=AdqWhj9o90mgL8ddFos8QbENJCp9L0IFqYBzT_Ol-Jt7dFvZiCacYKnBMwpiePfA-tM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoYMdkyYTSuF6deutbvu-QjBhRPsaiDCNBnhrIXGU7tQ&oe=6ABBAEC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsTUNkE5aucQ7kNvwHWm2_x&_nc_oc=AdrJdS-PigDwhCF0iPrZ2Zf3HLOL3g7pgoBRlzudXRlnipuky-8K0YfQ2lOFw9IiNRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9bhTI70Mbn8Kr1DeO5hi7j9zbr7ef-2eQnaYzG-jd8A&oe=6ABBD36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbI79ZBi_HcQ7kNvwHHsD7g&_nc_oc=Adprg0-Lfe41hbdq1MQvlGD_UlsortNPwBQYmfPpjq_B0ORIvFPF1ZGuBMZyR27ev6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFzfewoTilLOpZikEMoHUqVUGVPAsM3vZ5ywbax1wvtg&oe=6ABBCD81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
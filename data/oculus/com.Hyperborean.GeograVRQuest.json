&_nc_sid=6e7a0a&_nc_ohc=bwb-fgc1zHMQ7kNvwHWr0iF&_nc_oc=AdrFPZ2gumX-WGe2sVAjXuaIDMGmD9qpE0hOloC502nzeQ5pU_yb78OWYN41wYuvyuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89dw3Qs9ClfExQZdlBz8AKrFLNAxD0aLLV9IMuLoE50g&oe=6A3177F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL81U-uFvnwQ7kNvwGVzNU-&_nc_oc=AdrxsgTL8EAbKKidosAuADPqgikbNZZrO7GGLCiZwDM7mkHbYU5KT2knp5DVPa-TU6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VjO1YPoGe2PVj-6EQCna48KScw4hfZRPzUX1opEJjKg&oe=6A314F09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIP-aKq1SaEQ7kNvwE5T6jB&_nc_oc=AdrT9BzFNtCwl4pCM9JHJE3ULpy4QUSSihh1ReAjICEdvi4Wgi4Kt4JEwxPDaOeCdkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9deZ0dU2pbhqkX1glrCnDCk61fwmATdELHPHSKAxZR1w&oe=6A314147"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLT4XTnoRS8Q7kNvwGZPjLe&_nc_oc=Adp_q1FEo-hayITXSyVj7euDqCP3p2LVKZ-jtHBLwwOzLya9rFSmKJxvrnWTGxHFZco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af938M5pzAskQ-WlZzqEjw5xSV62n2IxmJQD_sWWRc4lGg&oe=6A3165ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0M4L45h1uQQ7kNvwFcZxWa&_nc_oc=AdpZzbY_wLpcHPZX5JwcLGsiJn2vnyin0VFEA305Hknq6Y8RjZu3rmRJTewXUN2BrL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ey-GwWrhasxIAM_jeWbsAuZ63JgeT4CWhRiyXGY1Yyg&oe=6A316001"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
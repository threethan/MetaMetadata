&_nc_sid=6e7a0a&_nc_ohc=-rh-H9R2Y54Q7kNvwFRuHie&_nc_oc=Adr86k2vPeFAIwUwsuPq_rfKbgQAr87GKZfEQhFr3oLtLOciPDqh7XZm0oH2M4Ux1Y8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzarjCAib6obnPyyLViun7GaEEkx_eajiFPgupD_0uJ3A&oe=69C91930"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x07v8d8myF4Q7kNvwHsuPrs&_nc_oc=AdqZhBw2FaAamo7JqPCkBcuKjl3B9ghTavcJsvv6N85ORCAHgds41HjTaBQ7CXlpbU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afza6Wh-jwsVkbHN-NpFwr67vudvNQYBVrF-QAT5_5w4Rw&oe=69C92889"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si9fBmqqCKAQ7kNvwFLyPBW&_nc_oc=Adp5HIEK1dm7NUgXfZU0R6BC3DyvbhbONFNM4qzktF7Ns6ivZiEYmj3DPeYWNc2vSBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyhubi84w7KTEOyDIhJE1tbAT3OZ_G8sIsPUP2o33kuOg&oe=69C91AC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38SFz9gv8PcQ7kNvwE09_ZI&_nc_oc=Adqfqfbv6Mb7fqtq4LSq8HVTWBJn_T-TzH_CKaBadTagxQa8eLPlBSAYs6Ly77sTY_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfEUFk0WjCroFhzJ-tYRb_YcJ8daFhkcqbLWBufGZeHg&oe=69C9072D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y9GYokhYcsQ7kNvwGHXlOR&_nc_oc=AdpXwGwIJ2hi-6dydoDKIEoQlCWvn_yF4lKePms8T05Ud5DW1TwHH8DtXjw1qdwNAAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1nU__LGYUDuugIm2Z0MvuvbIrqExNEb7SErsKuNouMw&oe=69C93981"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
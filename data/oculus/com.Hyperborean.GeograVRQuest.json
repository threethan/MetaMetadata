&_nc_sid=6e7a0a&_nc_ohc=-S5bBdThhxwQ7kNvwEtn7JL&_nc_oc=Adrjh3DkYpPiYSEBEJbiPUWzUp5Kega9feQr-xe66iPSIybvM1z4wzvlw4iJq4BpbcI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkczZnbAG6ZAcywoLfHRsquYUKefh4bhSk7xvBGIZR3g&oe=6A81AB30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1op4oMda_EQ7kNvwGXs1gQ&_nc_oc=AdoCVwYmTdV98A7LOu6y-vMcW-09rQkpL8asm-1LNsbM6LpRwZ0VTIake89vdUzxY5g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiqkCaIgsJjYbBgrH147eskbs2rT16MnCqYnNm28qSnw&oe=6A81BA89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TV2G78JWqcQ7kNvwFbI41u&_nc_oc=AdofXHeSpRlGyJP_vE_j_ARYydpkhCMyqnNmEs9-LpAUkLAX97RhJgC2XI1wdi12IXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqjibBsIe97rfPSIe9je_gLHmu8VwMUCdTX3yIs9P2Uw&oe=6A81ACC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpWBHHjtMxIQ7kNvwEVeVVb&_nc_oc=AdqOEPUl3GU5opWqx7t1djahju1EUbOEVtsOPrYjeGnIIJuyHbR_GYtlXMsgecxa08c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqsqR85373iISL7_E_gsJJ66_NdwnWDRY1hp4_6tONZg&oe=6A81992D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW25fmYIbYEQ7kNvwHqSa9S&_nc_oc=AdrGOyLIp1koTDgA8EwihXdeEN03DBxwE3tjLzFE75bpWQybH_DVUkT2RnouqKWm5d8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiZjF1-13g0BV-I1vKXsW4tIBjdsrym8ZtYIfsNjapIA&oe=6A819341"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
NW0Q7kNvwEtI9V7&_nc_oc=AdlTvsLModCCO2ff9uJyBCN-FaCwbXjllx3HekMl_LqUEOPcOsGw29k9QWfdO-cbkOM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy14x0CBIRfWjo7BPZJEFQUTyzPijVMPNb-LxzPnjQpXg&oe=69B15E30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2yZ6fs2EfAQ7kNvwFD9PJ7&_nc_oc=Adku9_emI6j7vgiKK4eTBQjw-Alazbc5aUUEfWUcgCiGpxjMf1z2BPr0_xjYX3jk8Zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi65oHjCYxIYbc6V6uYPnySNJNWMfhLSGJ0LkMGw10aw&oe=69B16D89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti0EfQI_RhgQ7kNvwHmlmxd&_nc_oc=AdnQwJqbksL7wuQrY57VD4GmSvnI1w4oWPaWiyuOUx1hieolj9wXVOlWEKctMDSR4tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2D2A5sC_FmXS15ZRrELxrE6extyOuLSdywS4croLumg&oe=69B15FC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb8Wa-Op11MQ7kNvwF49ORe&_nc_oc=Adnth7_wE56g0nalLQhd1DI2-J6k_qrdixWU-pNy0sBr5rVrCqSmB7W2yQ90wnvKAbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUMcv7wSs7-qx2oDcUhwiv3vcOVv4q1vvo9Mb9ICDIbQ&oe=69B14C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGCz8t4wKz8Q7kNvwF46Wgo&_nc_oc=AdnC_LtJJARyJ4p2mYQX3jzCJxBTvn62jsyu7t-U5p2XPE8Xqvjkpn41GzJk5Y0ToWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjPr99bUphDf0SZmM3dSH7PKkc-7wI_iHZQElNS-9qLQ&oe=69B14641"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
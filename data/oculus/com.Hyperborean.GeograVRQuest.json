&_nc_sid=6e7a0a&_nc_ohc=-kAtP4_rzP0Q7kNvwHyjchq&_nc_oc=Adp1Bm4vOMAbxL-BMH6Pd8Gb5WX2RIyajHkHrGrH3Pb-ew05gCDJaO3VTf7XpSGaPy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW3dxs5OKgbRN3jkyXwnYP-C3UsfoeOOx1lpP5L7jfVw&oe=6AA7E6B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsu9k0vPM2MQ7kNvwGu8ocE&_nc_oc=AdqKdJyyBFnhArixCFGU1nRopDeeLgcYAWFAh7tDEnZCRwLAGWZT6AedrxqKJ6I1Bmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfUfu1zdDCYwBtoBR4Kh_XoPf4ZHSdTV3CtKGumL_8w&oe=6AA7F609"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3eft-NFZjYQ7kNvwF8CMXH&_nc_oc=AdryCAgVp2InSLVvshkwie1T3SWJ11Him6ogiUNvM23evDfz3wpoXNeHu6iC7bC15zk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjdDEGeYnlTWUG5m_ruG3zj16BHE1lOH-PEawwQFnraA&oe=6AA7E847"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBu0NoQByW8Q7kNvwEdaGSb&_nc_oc=Adq6zUYqB6JtdJq9D84sVUc4NKDnNTMG8yurs1zPnDKSWaxCBMbXjBo1LkOeYuL6A_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwWYvVoOqB-jWnaXVvuShQWBAh3RWVE3xFakNcg-cWCw&oe=6AA80CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01NHMDflyxYQ7kNvwHuiHhK&_nc_oc=AdqXViTYZN8fk91QEoOGnVnM-yij_j3sC5YEVLlCd6m-eXnayF7t_gCojb1xs5XoByA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqG_OIx-iDA4joOqJj9MJoGGHxS1_f5ieWQsrOt0Ih-g&oe=6AA80701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
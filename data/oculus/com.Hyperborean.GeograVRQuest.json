&_nc_sid=6e7a0a&_nc_ohc=o6SpJnuiydMQ7kNvwFzmkXH&_nc_oc=AdrBfnwJ9U2p3zDNx6WdWw0vVI4XepmERvELsAA3QFDdkMG_g3nOIo6h3Wcb2wuunog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pbD4K3bKyakBiuhxwhfuTjmqjiK_wLYafHkXTEf5AhA&oe=6A1476F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US3xKMN6u-kQ7kNvwEJnI3N&_nc_oc=AdpWYpBcWMgAfjgb9FO_Dwaog9VAFfOxEBLegqNP46NO4TSt5TZjS_2f2LphkKjt3Uc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wI_inxPnQdnKD69o_Mk2wVakI10-_P55H33LPtokRUQ&oe=6A144E09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OrdZgbODRAQ7kNvwG7C0ka&_nc_oc=AdqSdcXsUSZiltRqb1MitXnUwcv4sjUf0vhMvqKbiMiRVA84HmBkD5NhzmVdVN07iak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wt1vDkyZInYSP_bR4I8vhlQhsus1A3R7ac-3YiukF-g&oe=6A147887"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tIx_9iIJvoQ7kNvwGgJM3w&_nc_oc=AdpTsXO6_IjLW5wAsGMArpVSRzOHTjT430I1fzePfnJGbfdmR_mYJ4XLar2MSewK59k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tJUCZYoXsEkg9L4irY9Kxi3JjunM75D_xO11CIsPHjA&oe=6A1464ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2mHmmCKgA0Q7kNvwGIx9by&_nc_oc=Adrps66ml4VC_6SZ-QU5niZeM0pBt-0Bp98KGKQrI9snLRs3uUz87hx7dMArOYlwE44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hLjHBLAvCmIySIhLUEPJ9J1L6NQRXPR86gugqwgY-7w&oe=6A145F01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
=1-7&_nc_sid=6e7a0a&_nc_ohc=uVXXsHQPuzUQ7kNvwE1XcUd&_nc_oc=AdrfgGC5x-IWwbdCDXLLPIYtF7invN2Ua8c5WQjetMZ59EEzGC5RdvMaUCnzqguGnNA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR-dj2nhIW02jCv9HZ_D-aoHBDxcM-_y3rv8AU_ofvhQ&oe=6AAE7E30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcfX9RLR8fMQ7kNvwHtPX60&_nc_oc=Ado_Vabj3VUS6TdTffoVjDwPxZelJ5KLOlXD3pOAXTBvAPg7_hPgi0k1cK1WZtLTqWA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMrShkEubX46mq81RJj7VrU9l0jCqidk9QzNxRQGYJKQ&oe=6AAE8D89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpSJB-b4r5sQ7kNvwFR1DnK&_nc_oc=Adrak9i-gAOnsZ1vXiWPK1-fhxJL5kevYh7vZDsr-yWYUlg0kNl1oW4MUVIspG5q8Ic&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Tu7c85f0KHXmjfKclZK8GiS4_YS4LzW8dUWTwsuZwQ&oe=6AAE7FC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr83sKlMVYYQ7kNvwGhjlCp&_nc_oc=AdrvzbA5CW2u-8d6MLTDGL_4vi81LcDtqAKVzL16Rp-e0Khr8jtyG8nhERG4_wCuNKY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIccgxhD0aO8znAbj4FXMk0C8gi83wvMfvxuhex4wqVA&oe=6AAEA46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrqs3Zog8eUQ7kNvwGuFWnk&_nc_oc=AdqBgrZYLOnAZesFTbW4BYpnc1Iwpt4CnhfZnc28LJeHdvNI91lBnZevxitoYRcey8g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbDl6fm2UFksMwsju35SK1S-Ho7O28v5dTCe5DEMYHpw&oe=6AAE9E81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
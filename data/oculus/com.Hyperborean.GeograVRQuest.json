&_nc_sid=6e7a0a&_nc_ohc=wjeaTcALUcsQ7kNvwHjkVg2&_nc_oc=AdrdIfU5O6ZSI1fdAyUhVdQwagviOlgt_FB4YDDhaVYKwBnWs0PJo9FKeARuGK2o96g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBfOegiy_25laNL6uDxmv350CNflM68JTXLaADVgUURQ&oe=6A999E70"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZsKWqUPO8AQ7kNvwGo6HiT&_nc_oc=Adodp2BqSdy76ILALV9_Axx0oG-0-FCaGBlp1Mq7sOXLgVJVPHMCFuKyDd4rpGeQl40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPYOG9OEgfmvtQ_Qt60ndZ24tLTEFKgymcazG2gIxYA&oe=6A997589"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bHp2seNYUAQ7kNvwE56e4O&_nc_oc=AdpQwqKcN9xo371sPwtJgRds3IfRRNLR7j-5sXGjzDkux8m1B67AHqJ2ab9qZaNtqt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlKHulULW4r6bXZdLbG9Cj-OE3V6YyTKCI3sR3VJIS1g&oe=6A99A007"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwQveOWtpeYQ7kNvwE6OYF2&_nc_oc=AdrJHWhMEcMrs2Z7jCMT1TVWtp-HyOEa0oI6wJ3SztFXHfr6S-vP6Pom8ed_0gzQQlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6I6YaEfGdM8frAPy-LlAszoljFefWF2gjyVcu2CUcjA&oe=6A998C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s81sCMpVuscQ7kNvwGvE0cH&_nc_oc=AdoHYT7qH5DDZKbUdJa58nTfpCqh1Z6K9dw58cHEZ76bw6EmCoPB6zhtk_MjAufWNA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK9QDL-VSZyEzuwv5H7FbC9GlONfPD2VZjSuDZAGr68A&oe=6A998681"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
uwQQ7kNvwHklHHS&_nc_oc=AdlbQD36BT4_D5uBjjVZ5dUZJuvOEy2rZM-3skk4kpQICqEwgrV_yIX1sX6wIBtOcJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzncxWPQM50jFmqTDo1oM_bDpwUULUnbLHJ24SBIEFEcA&oe=69B00CB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2yZ6fs2EfAQ7kNvwGwu5JJ&_nc_oc=Adl-EgLaIVMDnrsR5hPsC95LAAs2jOgyFr4mu8Q-D3ZlUr5OZnKUIVKXJ8RUI08L-lM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ7-P7JNZw8P0PGrH74RnOOnURXbB2jOQibUkvemLCuQ&oe=69B01C09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPFulY8kW20Q7kNvwH5kmgn&_nc_oc=Adm7E98LCwYptuuZC8Hb32xcxJjS0S09rGHPzB2lSqBvuqoS_CQO9yl80c0Q2dDRTrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSSGc8FdFP2_jnkeSke9UulJ9DV9sTU_VrkxYKDTvqjQ&oe=69B00E47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWZeN4F34oQQ7kNvwHuXldi&_nc_oc=Adlh1885Ft3iAieT9K4qQuHgaxn60CZUFGcNPU06pFT7FbFc3gLtmUPyH03y5kd2hvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKlZsQjEVvb7I34J2BHx3LD3c89e2GViuWptqvFl5bnQ&oe=69AFFAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW8XI68yRzkQ7kNvwFa1Nzg&_nc_oc=Adn0AoTSH39w6n1PIw8sh4KaKv1LeSJ1e5YJEK1LcJ6yoaVYujWNryFAkZtA2gacwC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6BtwBEd8LpkUWeDgnGm0kLX_JN-sYh_jSe9G_YDtzHQ&oe=69AFF4C1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
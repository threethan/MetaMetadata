&_nc_sid=6e7a0a&_nc_ohc=AcIE174kcPoQ7kNvwEZaxpi&_nc_oc=Adp7wnHb5cRno8s4surpTjLa7oruA3_yod7hIo2x-ikGMt_dzN9YmGYv4lsoyrH9VsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfXBU1flguIcTfxAmNzoTtnDSr3M_3I-MtT5Vbq2q5dA&oe=6A689EB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcVBesJogQMQ7kNvwG1E64F&_nc_oc=AdoIyK8hrsdrTuACgRATKSbpulOolwX7J8tnEPVPitlSS1l_NSgKjcDo68xQWuJaHQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUQTY03yqHN6U2qcMEMj9-el5pUv2YHKJxg0IM4qO_5A&oe=6A68AE09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6kgoUmb_d0Q7kNvwGJFmg2&_nc_oc=Adqumqq3t7ddxBHgOUVr2yuBPxAf970Q5kCnVOgGN6T5UzQzfqlkudkJJmiNL77j6uU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9J7URZFBnzR50kDwpgbFQgAqFEehVtUehaJzwt9wRhA&oe=6A68A047"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sVWrQxyaF4Q7kNvwEYf-d5&_nc_oc=AdpEyX2ZGlbaxlpZDF-F84r7r_PQ8-VYPiV8MzMUoNpYwrufh_Q8H3PLI6_mXpYaWQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgx5BvoYa4T3qwgeEF9MXSexdaVSfpMyIcmWNy5b8XaQ&oe=6A68C4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW9YI3_FcqEQ7kNvwFTM8Cv&_nc_oc=Ado7P4m90oTUthS_W1MwUpnUADqRPnAP87Yukc57dr93zTiB9ro6IYB4C82QBfW-4T4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxeunHLHKmbt0oT9hauG0zH21RxPvZdbYxY5YRSlp6dw&oe=6A68BF01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=4BYgP4ZstC4Q7kNvwE_zXPT&_nc_oc=Adr25eby1HYrFjnTeIoN4FqKNQSreXvADr8PofvtY9DL4J-JgWw9Nbd8Rx8x1iUc8uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA9BCyvjbP4FxjXL6MketZ12QKVAtDIs8HuNR_QBmZIw&oe=6ACE5A70"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEmzbvU-TDEQ7kNvwHqVCFf&_nc_oc=Adqe5E3M9GO1X2vqyYGciflw_3MPtl3YnGOBV4EXCtwbx45NjhuKfOOKCWwv7ns0d38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPibXIrd16BgUWXT48Koh2szP1GJiJBxWmM68jREmlSiQ&oe=6ACE69C9"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrZbPUHFeHUQ7kNvwHRQTe_&_nc_oc=Adofj_rYx2IwmdNCTirjgEqPs1Q6f3N8-u78m6tR1iCWY28Z9aZh05wreFYMpLQBUU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzcVgDdb2NTjJsgwFqYdSW4eElS742Gv3mhOD9CLUxZw&oe=6ACE5C07"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrVZ3DH3gC8Q7kNvwGW3oj3&_nc_oc=AdrKxwxLn3mgcf1ta1KcJ6A9HX6LTZYdZQGFa-vp8GMdDNPNHod2OCKPRk5EAB1-XAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLlyb392loseCJCU1HlodVsF4bBHm0QDHirmFNbZKkVQ&oe=6ACE486D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkJRE24z-80Q7kNvwGx0BuS&_nc_oc=Adp-7MC-8CCaxw8Bi-_Iutc_uf2dpmErIt0_hj7ttEfFcMVb5Us3DS-QKoHtaPuObOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8_-YIAPXAUSOLYbu2a51icOtQdbwi1g-Xp_X_ubZEVA&oe=6ACE4281"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
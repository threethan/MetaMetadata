1AgQ7kNvwFWAti1&_nc_oc=AdnuYLQTCBtY2_xA0chxWtMiFAVoVZdi18hX5yFoL82laBVIImieF6xDdtIFiF_Trc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyppkpB2xfmfVCW8q-ZbDTEI0HW3GIhy2X5tOqVBTPZ4g&oe=69BFDEB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVpSAmJWYSwQ7kNvwFWdDG6&_nc_oc=Adma4bDcID2pTeCEqfU2KDimBM93bOqUsYSevRQFCpSHF5IVeGuFoTx5SAb6Ywa9ZdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq4VrW7OfnKHg78SqslAdYXlOwvbfaKqhqRxN52E5Aqw&oe=69BFEE09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ClDvwBGsUEQ7kNvwE3BRaG&_nc_oc=AdnQLzBw208A1Yds3WNoYNDYtUHEX1nihoq0I7fjA69sBLMFcnwsQ_G_NVPYn_Y69U8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf_xpdvVxSOtQ1Y-ZP_qTGnzjH0PWqVLrsJSXeieUolw&oe=69BFE047"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXmosnzYdh4Q7kNvwE_NjlI&_nc_oc=Adm-BqeSyFU1-W4OHyjmsiHx9mLXpwaRqfjvVlDld3Mf5FB0Wxtt7-A_BnCJ9U6ZFz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3wVsPOlh1zh9h8FBlN3ZWoWsHek0Z7JshkuCJAzDbxg&oe=69BFCCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rONn6VfRlMsQ7kNvwEihTT0&_nc_oc=Adn05hviUeHl5QaaOQP2GsSumOeDCtJGdhWa2cRKwl9tpb5Hv07QEgTgNFVdvg4Lix8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmumOsYaSudknZhXKU7imAwQGzYlbBQHTp2gE5xceTBg&oe=69BFFF01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
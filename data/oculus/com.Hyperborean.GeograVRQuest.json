&_nc_sid=6e7a0a&_nc_ohc=JPwJ4tRnYXgQ7kNvwFlbW-n&_nc_oc=AdrcWqUsNpkTfiNw5G2VjkHCNeB1t7CVzStZWGTFo8L_bgKFvjD5_yZXNtMasO3XZro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACNu5LLQ3hcNjuMfk0EsYA6oSbA8MpR3IGURD0V7yCuw&oe=6A5F6430"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOG7CkOUKwAQ7kNvwFiltLB&_nc_oc=AdryajLGUtbj0F94k_64jGcZ8wDcbliHw5bhWXQpGe2Rm4B5XmQ5b8JJTZo_IyOXoto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA69YYeEq3IY1Tk1Rkl_KEQZlx-Ijvj8h6tC1D_5E9QkQ&oe=6A5F7389"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtGcU5XJcXoQ7kNvwG6hNqb&_nc_oc=Adr7idv7LoRNQK0LtmqHB8Zg2OuyBkVvgadxkDQ8zcGEHn0OryZVzX_G_0ADe_s2qZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Iu2TKQsJMsrSYI1peGQTgI5AYTOVTgS0PbPx4KCWvg&oe=6A5F65C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJu4L-JlbNsQ7kNvwGYoLpy&_nc_oc=AdopT5f1ODXGTSpiHyCKXBJcICTUa9jexw58MaKKZ_Peat1LomUMLHp4z_IekafyyKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw9AeqtZgVJ7X1T4qx-4WGAniv0Ar9_OWfPWxWeza5cQ&oe=6A5F8A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mytgmC0VlAQ7kNvwGp1PCD&_nc_oc=Adou_hMY1UCZgKpAF6eAVQjaRT7iEyayfhzRr9wnjfaqrPe1X0cbGqFhD5pdxK1gq3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBIf848EvF9PHrhXxQqEAd9jL97Gbs41gPMHFwkFYDiA&oe=6A5F8481"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
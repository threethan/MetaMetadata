&_nc_sid=6e7a0a&_nc_ohc=F8m3bNNFgQEQ7kNvwHp0oNi&_nc_oc=AdrsSUSPCXkQ4zLlHDOKs7HpvI1hoW0fkoJGpnIuxqa4EoIEWe3OdqVbSR5AQmMFr18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_jcEloVKUdMtlTZ4QxUjH34IexFR6KEybZVJBwFJR5A&oe=69F73DB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8peGbMWRV4Q7kNvwFYg34K&_nc_oc=AdrJFCyQzQFmRUhKPAxpnDqEAow7ySjwEJLKpW2IREnMAcW2Ehia4-4w2KwEkgU3SLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KcwsBZ9Za1J_HLRx7ATCQ6fFA734HjlbWgfkr6QTYBw&oe=69F74D09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEi9GlCUeBoQ7kNvwHS7msk&_nc_oc=Adq5zlLFoAiA_p4AesovQj-qCHwRmO7Go0pMBu8p0m-OE1nMEFkk-7QsZY8fw8VR6CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VX3NsBBfFEz2Jtdn6HCgudXdx2PH7-diY8zhT7M4VHQ&oe=69F73F47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mnRIUml5kUQ7kNvwGWIqWJ&_nc_oc=AdpBm55T0_kwJ7__9qZ1L7oG85B4AGXLEzQz8Qs2kkKYEVVgIQXZrOIU-kCS87eh-R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vhjzTm1K4Bek-Sa9pvHdQJ-4TCF1k8QXlwdyIp8IJ3w&oe=69F763ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UhKif5TotsQ7kNvwGCAtk3&_nc_oc=AdqO8dwfWULKD880T_eD0NVhCJTW5JjoVjJcTSwCUBKCHdHnMx4Gd48HqTBx0jqmZ2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jBX61rqSZ3Y9nmKMuPRjZTlMGg9EHr00cUOacTp1c9A&oe=69F75E01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=NgR9RRXFaAkQ7kNvwFVkpbc&_nc_oc=AdplbH6KOT4iVuccsX70qoC-1M8O9aItp21p82xGbjO4Yqm88Di9i3450IwWYWohQwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC__SLfp9fGEpYunfP3SstlGlCVLomXVVFPLOOr_wsVmw&oe=6A6358B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U7pJOjTcj8Q7kNvwGsqulr&_nc_oc=AdqA-8B1jq-DoofI7sNhqfYh-z58AQFrbpVCEOifjg98lycOPHl2ok6OKLjFMx9LkxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWgizYRUencsy4JWF4m9kRHlJ2Z9mYfy-iapWrW3LdOA&oe=6A636809"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc-WN6yoj5IQ7kNvwGS6V_A&_nc_oc=AdpjcxeB_PWxHqrG_sd4iNPgdOpP46Xmv7G-RMYAAJp0dC229QMnIyagdv4FDvAR-UY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv_Of61VJh_XxgmOkIbUv3enSvu3jm5NRQrtnVKd_fSg&oe=6A635A47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXFfLXX-7hAQ7kNvwHUSWR4&_nc_oc=Adp3wQq1rW2nOkM9La6zye49I1s87mY9Y_Lj37-hOZcY6Xm8KUgR2AqFLRtWTU7WvzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJIPdDCtIwlOue-88uRmekwh78-v6xpOBFMwhVt3zrWQ&oe=6A637EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU6J7mtwZ28Q7kNvwGAtTtm&_nc_oc=Ado8xg2jrNneFpDWfgXyaDCK2ndzsSZcIBLZ-_ip6YQ6g4oiNtEFYm9EnaBQ8SaHBNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjokd0vPNIoR_ubWPWUGhdqVeELWosSCJhN81sbqAp2A&oe=6A637901"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_ohc=DhmUxR1Fh1oQ7kNvwEgFlzF&_nc_oc=AdqsSkHrgto8Y2INXcmVbRaasUdwl3CRSjPjtdcmqb4RjtnK9x_SyB6a8Y0qNjozBuA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ejPZKopL34JzK8iDbsANAfR_exYqipKkPY-h2wMa8kQ&oe=6A3FCF89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWxBR6xco0MQ7kNvwGmc0Jn&_nc_oc=AdrIOUuMxzDrHNsHZL2jW2GXqUyWAt7Lw1ahTA94c7fp8uknheuAVJkvdzTwFFgqsbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NA4ckcKmcr_jp9NWxyjqJnpoiOymXtqG7tWysV6X3hQ&oe=6A3FC1C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVyKZwR88Z4Q7kNvwESU1F2&_nc_oc=AdoPoPKDvFZ7w_5TQcqXnc-7tGLuaAuFISRXGNwLsczQoZfnMJSOG2t3x2PHy-qixt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PlrUzhYLFGcX1Mng2kyr57zcTM8SEvTaY97szjWBn3g&oe=6A3FE66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTKzsdAmA1YQ7kNvwF1wbo8&_nc_oc=AdpiNgwfk0K8GiBYJ-5QWsq0Koh7BZR3ooGCOwjV5QaDqGFsXjEMKJ-bxHPqdwq9zQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zH6TZxJUNyktnXg4MBSF-oZeKl-u430-8osjgaDcIDg&oe=6A3FE081"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "973942873558422"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"no
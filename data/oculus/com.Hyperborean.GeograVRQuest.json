&_nc_sid=6e7a0a&_nc_ohc=jhNU8XY7CrcQ7kNvwHEKA4P&_nc_oc=AdrR9nAkzVFu_mDYXCL1DYKuwIxW8OPT-K6eDHnAvfBTeXYAI-uqCUACZ9hXnYQYKXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KzejO2_wvPELaZ-mywmXkzfGShuAgm51ONkK8nyim5g&oe=6A259A70"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUyA4KMjn7oQ7kNvwH2sXAR&_nc_oc=Adonkk2Rlbl_GIjz23nIKDUVjPmDSqYUMJVcGjLXcGxzj1w8OUkGvuQav7OGCnIBrrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h1D2dK0d461qkGMhEDA2a6hlZfMGXZSrndCdjXNE7Rg&oe=6A257189"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEn4g5otL3gQ7kNvwFmlCM4&_nc_oc=AdrfcghHvWiFskVGOrSCh7AKogBOUioNsfR_lHrxEkB8hmpb56islRRAKlz0vzyWDvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NcuLfkHdEhUUAvupspMzUA4VxXruXCZvpZXn2zhTApQ&oe=6A259C07"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVIkmY17F9YQ7kNvwEN8GnS&_nc_oc=AdoxPlWsuQ89jNjoMwT6Y2KBr13RotG_A1BpZWW7zM5XsNKfkHD8R32fJCzF8DQBmyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ly19QHmDh44uBF-MUmWzm7bDmeT5z7FL6hBolG7iywQ&oe=6A25886D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h75ICHGQ7sQ7kNvwGdYb60&_nc_oc=AdoR1MRrJKxs-h3TruCuMI_0peQy4gi4Xr166kltEoWHUSwlDoZHkNX8ReNf3gk2kQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qS8vGtHnfumYieF13iUreefgAV--JhU0z4r_ghljEyw&oe=6A258281"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
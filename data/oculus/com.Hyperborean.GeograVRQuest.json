&_nc_sid=6e7a0a&_nc_ohc=igNXmhwoXlcQ7kNvwE2XsOV&_nc_oc=AdoWlJKREPUbUBb1qZBWl3itmmO1MuvYAPlg77itGAlJZUs3mYXd90ZGLS1ktfPTTXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1J1Cd9RCUZ22TCI7OFek3AnQ0XfQHU4h7cQ90EMvH4w&oe=6A9EAC30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36G0_Mhp5TkQ7kNvwH3iKf9&_nc_oc=Adprl9nc9mWaurMEiEzorj0DLS68hZxHcvsyUe72j4a4hzHen2ygOQHMfXaWoqz_XoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6tI3AHYwV_tTXRC0Lk-BQ262Bby-FeXBaImhX3gSECg&oe=6A9EBB89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU53HdnW33wQ7kNvwERfRor&_nc_oc=Adp0YMlIVE646oHA5llMBraB2XdkwoOQMRgDoXj_0yzfDCmgK7-H6DNWAzfV1nJ_l74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbYa_k6VAjPTrKhJmncA_c49Vn_ipT8b2Jydp-y8t9JA&oe=6A9EADC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FbtmUttdboQ7kNvwHQXvHS&_nc_oc=Adp6WcbTI3eNiAsebDb_RMvwXcSAhxX-GpPcz5am_f2g-PAeiJiTGKegkBC860fT9Ec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL01NKWLt4MH1uHaU4e7s4-ag3k1f_trBoFT7FLPwkYeQ&oe=6A9ED26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IrfeaXYeu4Q7kNvwGdgahD&_nc_oc=Adp_jzcK6251R1sCH9ee51IVNaBqO3iPolVaL8-8Z1x6mtW4pAGONJc7N7j9fsj7iBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmYr8jkd8kcBIMZ2dULFv_enXdBMv_GT7lvVzNTJ2tdQ&oe=6A9ECC81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
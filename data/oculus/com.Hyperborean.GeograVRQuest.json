&_nc_sid=6e7a0a&_nc_ohc=EqtEUlwfmZoQ7kNvwFMAc9f&_nc_oc=AdqvoxyE7hbdGvGgVcm2ZVtpGyhvlhW-T8yXa7A7cKiG4pQ85VXqSXwgA_lshHNzMwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn6y4oAbXwUWnutp3OBdmUIFLna4zgEwsImP4S2U9DNA&oe=6AF5E770"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC-93LpxWuMQ7kNvwHy0ncE&_nc_oc=AdqzR7UCumFRYDu0R97WuIOJiajQuIGCcGRZnRmb2M_vpGpuiEEkiltFXjJzy02Tvsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYUGTYyYpnV9yX1gd2Gz83c4QA4VgEMJkxYB7Zi8Qw1g&oe=6AF5BE89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDTEyEWyTnAQ7kNvwHfC0hX&_nc_oc=AdqEj1-ItJOh6qjXpIFM_HPrvh8838A2UoamdqH80lgM3grVG8sw5O-iKFD2XCjeCZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5p_91zsnVo9YuvJx1-OljO-rMld40wcVFzYHgCA76mg&oe=6AF5E907"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nqPo2UgkrAQ7kNvwEna03e&_nc_oc=AdoHKU0bxABxFNmJ5suIavNYgtynGU6G0FjAWTnJe1RzM3JcxttGXSpE7Us9fvjOoZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS37vCDBbAU7aQVyKBX4PzeSOgsoQJoikDwah2v_Q1PNw&oe=6AF5D56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7LAEEfQsywQ7kNvwFhy5Gd&_nc_oc=AdqQvQhxYwcBzhzfARXoaJeTDtvv94xG9A0JgLVZ3PpAJ1j7qZ5zNm4Qd50tMOp8BqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyAAKzPpTkZ4gM2SQDLoFUNd_ouZ-PCnE-s70UH94PjQ&oe=6AF5CF81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
_4Z1sfewFK_siWouKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwPMkpUZoZzvrU3ZZzmWoBSP4RRGehWy4z1W08US2oXQ&oe=69A03AB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_KyFH57l5wQ7kNvwGzE-jg&_nc_oc=AdlMQ61QWd8UDucUUtGPObEVIZa-1x5oLuO0a4KJSUtQ7UFJPYJc-orpVGMfblGc-so&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPxa9QM4WYGTfk08PCxcwwkzonBcxBlWRoNNBQATkKCg&oe=69A04A09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_Ib3J1psJoQ7kNvwE8s3Q_&_nc_oc=AdlPCl1sSoojwab5VRn5gz0b74HPM7onVPxjnD6IEf2MVPT9sbLJyWudHCIGCBfy4nY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFZ4WZ98K0kM3Cb5t5DSbAz8c4lorRreLw1zbPY30H4g&oe=69A03C47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEq0j_iJeB0Q7kNvwFani39&_nc_oc=AdllcmyQYdZOdc3TBbe6Yu8bK7N9tf41OHXuvcz5Uz1MI6ChSdrULsuGYVYYhHFqJ0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5J-ytiTXcBhiRVIChKuFsPgMMfbHX_GCPjXQFxGdf0g&oe=69A028AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgnVAfxTgIYQ7kNvwExVs82&_nc_oc=AdlQCyewRJ8Zn2813pigdtUnStknYVc3Gm4DQqqAvndee-HabQvqlUhacqK-oJTY-pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfskociE-hHRkcWSFwQSUvcfpNivmd-8cBZKm4MjXQxl0A&oe=69A05B01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
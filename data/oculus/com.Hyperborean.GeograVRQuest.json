=1-7&_nc_sid=6e7a0a&_nc_ohc=HTvDhAuapP0Q7kNvwExkEuh&_nc_oc=Adqr0f_KVk_r5XtdagM5Qs-dHHWNXFex8-1F0Bjg5mFIaGhqAQviiMvBlOg5XlLVwWg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JGZ4wltDMDKBQtwDVFw_R-I0PunXGgDd_h-5PsVOF-Q&oe=6A36BDF0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOxTYy9iFGwQ7kNvwHKil2c&_nc_oc=AdrT9anzQVDP9sryiE2hVYCIbSdO8pGg6czObyvAZD2Lp2hkUSy5qugzyGxxZ3wRVZU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oF8SvumZ3sBEidmJgmnfKrelPZRvaUeHAxA_tE3kx5Q&oe=6A369509"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcGHEXTE1bUQ7kNvwEm2noe&_nc_oc=Adoecs8CXO0b1-qG49-wV7IPaXGeXllZ9CbHUuh9pnqn869MtI7y6l5x_FpQhwae-1E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wJ3Qa70n-xe1s6yQex6i6RTOxMKXVqypFBPJGw2x-cg&oe=6A36BF87"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IifOIRJmqi8Q7kNvwF8iy71&_nc_oc=AdruMWwxoHwnNRZ948tU7J8FEZvUgL75Cll-yRHwRv_6RFoueEjJEZVET156IyJo1zM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--WwGZhlxMYVm9iuI99VrFmPIOmPMFdmECBySxML3g9A&oe=6A36ABED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OBscWs-RmUQ7kNvwF-ihFJ&_nc_oc=AdqjEK-IPuFwH1PAUmrbwaQIArRgaEN9l6L8r7EqFV1XJyavPZxSFx_nBbTBApUlvBA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cqda_Q_6KPiwRi8aVCxTNXCO01ZDJJegYwXwgfO--pA&oe=6A36A601"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
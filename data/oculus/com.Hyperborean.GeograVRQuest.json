1AgQ7kNvwH-5HWp&_nc_oc=AdmqMk3-7O1VErzkxrfk5SH9plqDj4EZGAAwBEvL5IqzNLVOMA5xLfjsxXlKHTBCKO8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6OdU6Fwqw0jVbdsFceMmw6jMtAV40E5pIlBnOgQhEcw&oe=69BD3BB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU8jYHaFQyEQ7kNvwH8iROw&_nc_oc=AdkYrGmeSPzFByQeVe9IxE1xgZubCur0t_2Jnd5x1YLHUGGxufrOjCPvK8J4KLFgU-g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw27g7SOAr-mTRmI_Wj19TrD5PBRv3MAW0Pg9L-NITPVQ&oe=69BD4B09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ClDvwBGsUEQ7kNvwHzhdh7&_nc_oc=AdnBwd7TO1-pP5ykXT56MAR04cBpVghTnk3AfSNpeJgfHrXwQlHsLEPQU_38ddtkEB0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXrvZv59fwA0qw4pmGIhdpQEsElGrHg6C4oXDbXpntYA&oe=69BD3D47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RaeOCSTGSwQ7kNvwHxEn0Y&_nc_oc=Adl5EOyNo3hSBwO3_vC99yUl3fJJXHly1MMIsFD_2Q5kmDD8xALtRtyGL23rGAv5BXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxyDXO38UzMMGNHhlYjZwZ62A7cO4Wp7ESOLOVSSBDbg&oe=69BD29AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rONn6VfRlMsQ7kNvwGTk1SJ&_nc_oc=AdlMmXILg7UotDVjte_IPlDihN7Dc3E9XGGrMCsygNLdfIp3FiaF5fK4HZzo3WvNhUs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAzTPkXN7_iQq7Bd6JXvZAnWNjloEKOa5RrZnWppvMvQ&oe=69BD5C01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
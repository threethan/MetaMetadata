&_nc_sid=6e7a0a&_nc_ohc=LhZLdPXletwQ7kNvwE9ss1b&_nc_oc=AdrbZNUAj91CiZaMWRijs8fXW1-BMdQnj74vquT81jc5NbnfD9_IDc5z1dJ7aabv5gA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kaCEFSJ6qEw0B7n3T7W4gTgCj87pn5LkzqvOnLfSmsw&oe=6A1ECAB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRxuuAW-kKAQ7kNvwEuPNuU&_nc_oc=AdoaoIRX9nchuTQtqHJ31XAn6F5x0DvaYpTiwF5eQ8-6q6qlCMx_exhJnmBslZ4orks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75cB9f3kqg8eORa42PD7Mq17vlBzwNMnWCgLSsLYsKRQ&oe=6A1EDA09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5nufnryvj8Q7kNvwGak9AE&_nc_oc=Adraz9M0SljU9q_vB7y-eZ3c9gKLvOPNgiNpoYF_ngX5TJbXcZGG0uaOEnkW4Q-5wRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BQeMhBWqPTsOeaNLU2VG0fXCesspSHAYa2e5fWF3sNQ&oe=6A1ECC47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xioIyBfygg4Q7kNvwGDswVt&_nc_oc=AdrakOD4mt6RwuLPGQUZ6WhQpuIwo7qP-feyKkUF3We_z705_eIOUR-5joasc3j3YUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af610NMBs3y30MswtTt7kiIrTTH7pvp6FHnjGhVCx8MxQw&oe=6A1EF0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KdGmTIsI40Q7kNvwEOBgYG&_nc_oc=Adr1TTTl5TkV0kWGpy7ZYYKThSvhkYukaZHLlnYw8N_BDSPCgMpvLW3JtieiBM5AwdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VbZWU-WRMvK4Qccwr6q2DATDFwPI8S4oz2ADsYrW9KQ&oe=6A1EEB01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
-akQ7kNvwFNsJVn&_nc_oc=Adm3-sLDSIfp24akjguaB560kLYQesFP3jmaz4J148mwPruYUPEWlDsTPMRCeaqNCk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzY_JPFeFMQC_XF2G5m5EylSnAHa-BA9o9wrZ1bgy3Vvg&oe=69BBEA30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU8jYHaFQyEQ7kNvwGW01Kl&_nc_oc=AdmwQ-3LxYx94LkBAhHTUZbbjv8_LkH-450u8_oro372MZQkBZfYqy7f1nCfS_oltEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMteq_p6cnvguxBR5P5EuDtu5jjgKHRstvOMN4KZiAmg&oe=69BBF989"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuS7LooNI9sQ7kNvwE7mWkE&_nc_oc=Adn89B0ApsHp2DqZaTdcJGQfs4Lh-9ITIe3BHdKtOX_oYtqScQvavhvNwWg82w8GkpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR7hdRUe5xS3GhvJp46hnkKhce2F5a1Atx_CNaVAhfOg&oe=69BBEBC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RaeOCSTGSwQ7kNvwHUTcxs&_nc_oc=AdmzYfFkCVyEetvUHKd5iDOvhbf1FdKPs2IGi91KbspsjusjQZ5A_0VoqADPEXplVq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1O9q9urfOkePotcUKqUYZRzp-i7MNqtd92DqjdHjuzQ&oe=69BBD82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZnOUXAdbx4Q7kNvwEAufOf&_nc_oc=AdmS6pjl3W-U0G6pyI5rZtiLJHQx1ULT1dEeX5WD_Pk_-ATSjZ5djdi04_Wa0YNSnq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3gv9CKLtMt6QkAb2mPDOBeQB5pAtlg1GPwbFMK7cMFA&oe=69BC0A81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
-akQ7kNvwG_Hpv3&_nc_oc=AdkF97Ocs4qU6zPpGPkDjtGz-7oQnulDhB1oNRaEtFhRiblvJsUvh-nu1RMTaBc5y8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAjU9StWGuUgyZbcT1RQdruGpwp4zCTwUpnLQMlGLvKA&oe=69BA98B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU8jYHaFQyEQ7kNvwHSZ2yT&_nc_oc=AdljST6amnYaQTDp5K4m0WtB7Y3rFy3VpQNVsVbSFP6BnGlTroIMsjIv65ZcfXuUM9o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7HBqc4r3qNZoeTexoElaMNGDEMRm2O4VZ6R_q5Rrd1A&oe=69BAA809"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuS7LooNI9sQ7kNvwGnJf4D&_nc_oc=AdnLtcRQRIr4_VvxkOfCY8ZfJJTQmgGMLqzf2wrCAQLLtGPxnNScGEf1qzNCqNPJ3nQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_yXG9EHOvL4AhraLQyEAJjmMc5EW55ZIFm3CEGMlt8Q&oe=69BA9A47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIqRtgz-lpcQ7kNvwHYcISr&_nc_oc=AdmpqArQ0McZ8ndvtlY6tI1J_Vid917Km9ZKdduEylq2bZ-THnZANqj-45uIPzK9NbU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBD4B6XXqjkHLgaanY83zrkeld7fnvVYAuD_y8Kj8K8g&oe=69BA86AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZnOUXAdbx4Q7kNvwHXqWLO&_nc_oc=AdknQIyGbpwTsGik8IdvlhxXoIjkYvHJQAQV3sQB2s6aY-A-dIRH3VThR5yMOkmlN4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEMYe3uNp2JLqZooguJjjJdQ1pomS13uYPOBUa_uiZxA&oe=69BA80C1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
&_nc_sid=6e7a0a&_nc_ohc=M2X6E3OlvDAQ7kNvwHLOz22&_nc_oc=AdqzEdejxX0eeXIy2a_AnSWTQgGarLiITxu1P9QNeYheyjfFlbf8caZ448GOQXZGwUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYABw2kYmZxqCft04IPskkOL8oVYfKReuDg8oEfWDgQA&oe=6A7087B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZtdxSshVOYQ7kNvwFD15dN&_nc_oc=AdoFh3XzfrWRaKEfZZFoYM3wrAKdaW-F5_rIlBUbIrSE3533l-S0VYdMOTijuuAttHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo2azS1yMzFd8OaQJIj8Eyb34u9RZhthnJ1QK1ntIRfQ&oe=6A709709"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs3TSpUlObwQ7kNvwGI2l6c&_nc_oc=Adr5SM0b14SqAr9--zlmlDW2Ih8DJwbbM3WMaBPyRgaqFixT9Al6vYNAWMJpctsmqt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-8d_vyY1ONXX86mzaW7rvqJM-_Mb2p0tSoudY3uN2sw&oe=6A708947"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsVFaJIB5CIQ7kNvwHFO6ce&_nc_oc=Adr_mTMiKJpzq9zDBpiTYrNF2j_FFLk-p9OAyR94R2Rqz5O1EQ4IMgtPY20JuZCW_e8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv4ZdMLVmdhzKW17xPE1mrbX41aNvbw8ro1760S5cvIA&oe=6A7075AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7LejbA8xioQ7kNvwHKFhij&_nc_oc=AdrWYbTPc4JgvYC8edzvHdfmjjw89gzfxZej0My2dMeJWJBOH1D6t5qvplHRYRdZfdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY-y_0COLCmFvE_twAAtkBciJaslD8oEa0-UHJORvXKA&oe=6A70A801"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
=1-7&_nc_sid=6e7a0a&_nc_ohc=-kAtP4_rzP0Q7kNvwFGrqdQ&_nc_oc=AdpjELwxGAkcSwmTPj-U_Q7g5WhX4TbGjdIMBpWcJPLLKnloycSg6KR-MiYotg9j-p8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwTlGM9RlIJGTLpQkk9XTcN4SrAbsTNXRXrsPDgrLcWQ&oe=6AA93830"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsu9k0vPM2MQ7kNvwFIOaqB&_nc_oc=AdqSgXHbS3JM7uRFqqV9-Lrr_DUMkkU3uTRq0IbEsmuCU-Y3Slyw6NUm5kjS_FUinUE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9QnZrZwGFFiOZSzqlQZ-up_1yDVy3YOjhWnk5X43RSA&oe=6AA94789"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3eft-NFZjYQ7kNvwE271De&_nc_oc=AdonewZWB3vyvGqOR7tZLbso0V0Z9NIHHzrT1uCIT4blT27o07rasDblKulp8Un-2nI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0VUlGKhSLCAaYsBHDG4RfIyXIYz9FaKCGFqEGxrRWOw&oe=6AA939C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gag0bF7b1FcQ7kNvwFolyIW&_nc_oc=AdopdJG29R3PUek0ZL3EUIvZ7TxZhm6XZLamJHZSjcqx8PrOpQKHomAwH_o9LpJN2W4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_OHHx8z0x_AKs93aXp1BpEKwCxfXoFfSDKlF2ahHr2A&oe=6AA95E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01NHMDflyxYQ7kNvwF1bylu&_nc_oc=AdpnZiONm0VpLXgLC0S6MqvSX1i4mtihCRuTyNQTieaAbTC9rjdEiAZWxTNWmyImjvU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZk-8spmjSSESiCUklX4flvsnQIgc_uyAiy8KZS_oQvQ&oe=6AA95881"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
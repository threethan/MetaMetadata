uwQQ7kNvwHb7vdg&_nc_oc=AdnIcl_dFFJbbXybJNDKsfgL0j4f9xJ1dNvAQPcnGcK5wFuYnfyCHqaDdUkpugWe730&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB7vLA67X6NtIEUQ_spiZxTOqK3F0xubTySki3U3MN6w&oe=69AD69B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo6fWm12LssQ7kNvwEWC3VZ&_nc_oc=AdkXwv1H3iWm3xZoNb8-borWTaG005jQbhJ7xeBZ2EFEhM6r6sDJS4njZn62HiiEY-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSq3okLE7BYi8ELhua_XFvP74pbjPP2fNLhbamAP4Cuw&oe=69AD7909"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPFulY8kW20Q7kNvwHbEK5X&_nc_oc=AdkWOCAIJDQhph-wq-VgDf5tX5B_1ccrM_xwT51-W7-j3u-kidwCcvLSNTi1g2CH62k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBCO6GqEV3TWrBpRxJ0esmOQwFR-ZKbs0_NFsoU-D3mg&oe=69AD6B47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWZeN4F34oQQ7kNvwEZok_q&_nc_oc=AdnMxnJf7gfnGhQsM7mns1Fv2-m3hRQu30LdqaoFk3tYZNV_gSxD_L-qcATXhqtWz7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvwbUq_bBlx0pUuwjjd_n343kWrfGS6LPQ7hstej9kng&oe=69AD57AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW8XI68yRzkQ7kNvwEt_82J&_nc_oc=AdlkdGYRfng1l_rS3Xi2459mhXtfCTn5I8O5w8p_9xVmcwv70DEBH8Yr8cq-1dBS74Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybR9OoL1lwVNQ3vUUjxEDddVsFv0KcEldIa5tBh9wpPg&oe=69AD8A01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
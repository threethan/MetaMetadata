&_nc_sid=6e7a0a&_nc_ohc=Rf60BR9vu2UQ7kNvwG9Xk6y&_nc_oc=AdrLm5vkHF1pXIL0yx2_iSN19e3koo8gaI1hEx8Ti8txJzKyc1ajS1wRmop3ykXcdBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y8Xs_YctJghwBiXDRebqef0BMp-O-tJo7KYJ6RxCvpA&oe=69DCDFB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juACaiQck8YQ7kNvwGQDIvp&_nc_oc=AdrmAir2KIOqakSSUAUejugfYyLIJ-oAyoqkwNeFOBpiZnG68hV41B3JLRfy0WXcVlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bHu-KhcUGBQ58PBmonCEWPMtZvk2o74y3iSW4vodxPA&oe=69DCEF09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5Mhu-Pou_0Q7kNvwHRH5FY&_nc_oc=AdowQD0xM66aZfbsP-m35VwKbvec2YyUafv8zBcgX0s3HmhYKVv8vDdUI9KfbLN0F5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m4AMxysrYj0Kzl5aOYsev1khYWQEs8I7IPqA0LKDSFQ&oe=69DCE147"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK_gP8ehxeIQ7kNvwGsBNmT&_nc_oc=AdopJv-nIhkhc48H_QgQB0Sx_YruN7fJME5TB2ez-ucbvT8PorOP4LlSIXjN4tPCrIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2717jfgKu4_wQVe9nQHDDKpQQ2CVcUghqgfvCH63Hy-g&oe=69DCCDAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImaK8zRaU4IQ7kNvwGQVjgF&_nc_oc=AdqO46aqC-ivhRtIKzj1dJ2_2Lpz9g87j00rTQRkmpHMrgFx4slajGF0SmFdoqxGF7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25nNHjuu6ZnXBy2gWDLmp60coBWt6MEnOKRyrmMfvb2g&oe=69DD0001"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
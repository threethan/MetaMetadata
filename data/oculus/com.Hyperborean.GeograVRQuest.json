&_nc_sid=6e7a0a&_nc_ohc=M2X6E3OlvDAQ7kNvwGIlnOc&_nc_oc=AdrBaUSCqabIU02nCd4KUe4af7ldV3uJq0DIzr1Yvhiw9hMsbjcO7Wk4RaV-XczULmg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYwMvzuaRKswOQdwTAuWwv-8Y0OI5jnyxycKk1LFqiOQ&oe=6A71D930"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZtdxSshVOYQ7kNvwHu3dOJ&_nc_oc=AdqBMx-KkyrFBtWX1sQyrAT7A3XcUMXSYLuFx3AeJ3g1OaqZiswL1lJf3vpko85ZJis&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_eyeycBx3Ddrr9ctJXdt2cesR7G_DNYd_LKOJvEteIw&oe=6A71E889"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs3TSpUlObwQ7kNvwELMwPG&_nc_oc=AdrxBvkqkI2pl2AbCV-KyfhPrf1YSXhGADYoAS2-fYEvb6FV83iW-yNZxzsVrDdeCps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5jJFJ0VL4eibABgnlYozBDAX6bUgwEn3UtNWYprHaIg&oe=6A71DAC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxlOWgDptx8Q7kNvwEMrlbQ&_nc_oc=AdqTkVHLvIeCOf1Z8bsVRCvKEFJaGauGZD_IUDhZlBbg4qGK11Y5aglN8FLG2wqjzro&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9FyIb3wrCW8jVBpKWoLWGop8FHiHJn_eaCQwgtcU3xA&oe=6A71FF6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7LejbA8xioQ7kNvwFSgcu6&_nc_oc=AdoOAn7JteCeLW-CQI-wZRKVDconcGD3yyAeQuAHy22QEWyak5nF4lcdw-NX9vE4dgk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE42WSp7iMagULf_AHlMu_53-lsvx1yjNCs8wA5JsIeEA&oe=6A71F981"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
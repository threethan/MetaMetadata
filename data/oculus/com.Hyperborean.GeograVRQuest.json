&_nc_sid=6e7a0a&_nc_ohc=mQbNIqJJ1KkQ7kNvwHgfOXJ&_nc_oc=AdqSAoCInON6327JKv2JFAAfNkZT_OmsMdcuLYOwJpf5cX_RcNeKrR4Sl1LySpqm7Tk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kynx9328rVhgIb-yUXWI8xQ0T6K91DBEzNtTF4HyrVQ&oe=69E225B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZNu4SmOTUAQ7kNvwFfIwrC&_nc_oc=AdreyKMQzshK1VZuQxLt0PNnonYSLrnenkTMNZzB3uT5aRkBqtUyp8EbDK14nvvlrrU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16tqqvHuIvb9gpNnwiluCqdaoWoEC6fKj28P6nkGSMJw&oe=69E23509"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re1zkGfFoC8Q7kNvwFBiK_C&_nc_oc=Adq9dkj0H3X9L4DfpdVdYfzuLeaFYkoD1J483b1nzrhGdK3RbVLoR2Aj2aUVho3bO50&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GbsVywZn5Y5S5LRR3Wed2bmYfUXozxQOkkjHG9j5qSQ&oe=69E22747"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbQhnChXfWQQ7kNvwFZUJGu&_nc_oc=AdpxonktNrOkidCZSkA2wOMMLwCB7W4S-oug2Olv9JvRszBCy_nfpSMhnywx6jHIg6E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y0MTo94hFrVtqFT0b2ktoMHVY5kvRH93l6poBQsAjNQ&oe=69E24BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBpNZ3nGSu4Q7kNvwHXaAdD&_nc_oc=Adpw0mnXLnY4NYzp-5BZBIa97Ck9Zn5f36oSvwMntkCPVBh5n11DHB6Gt1kNG9bqct4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-ycM-A2iF5JUDyEFPrG8B8K7jPrtzDCkJYViHyehTow&oe=69E24601"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
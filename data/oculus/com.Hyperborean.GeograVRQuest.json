&_nc_sid=6e7a0a&_nc_ohc=a6w4RrOsNTUQ7kNvwH3SAYP&_nc_oc=AdpPBu80dI503b8YwaF7YyN0MKDYHcCuyXbXI0hBQX-Y3FLaPgiNJbSSwQVT0I-FG1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6yc3bXXLPKILmLExeetrKZ18b1z2RKTDyReiXT0chqA&oe=6AB3C430"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oquINBLw6dQQ7kNvwFB7ygT&_nc_oc=AdromRft_pGWdc_oRHTLd80uuPu2qOhDVth8YnlkB54FYmcYhzC7jtKSVccqdhOWJKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFRPf_A5vlDLCPrcRFz6uJVByRQZbZqYyiJbhfm3tMVw&oe=6AB3D389"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUKhy98ajHQQ7kNvwFiKRMW&_nc_oc=AdrA27NdKzucXxvQP8_d9niwcGvVEFsv0b1dW1e2ZwpuusHbpdCLnzwL_VGWFgQClN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdx6N4KFdT5TjUlYgzuLPljZSpCQ-I5r2cK48yPTweJA&oe=6AB3C5C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unr1ppXgyDcQ7kNvwHVkwjj&_nc_oc=Adr9FPXq00mFk88S6gve2IsHmGiApwO-wONDVvMdrb80KWpOBD1LXRuMekJvGXrqQWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJox187MHu3hD7qeDuJMfjN5wB1F4W6nUVfRSMA81fQQg&oe=6AB3EA6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXHglx50DmQQ7kNvwFaOx_B&_nc_oc=AdrRDwx-Vtx9sxNCW_hmkS5Xs7fD_qSkdoW3F56Xtk4oX9Gc1xUPemyesu7h2YqL9iM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn_QIDZxx9iRIhLz9apVzpcRg4F2oIHBu6Sovr9kDRCQ&oe=6AB3E481"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
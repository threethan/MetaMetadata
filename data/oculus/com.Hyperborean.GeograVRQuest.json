&_nc_sid=6e7a0a&_nc_ohc=NgR9RRXFaAkQ7kNvwEmDg8F&_nc_oc=AdoJ8c_nv5j9NB-PaMTyC8kRyIPjwOYJEO_5GRnNYRTpJtU2kXt08ECTkoeb00bR0z8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO0jZ4TeFvIb-0bEc4GpU9WxhhLggRKejy7NAGPaFQ3Q&oe=6A65FBB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U7pJOjTcj8Q7kNvwHiDeDA&_nc_oc=Adp8v0CBSBt4KzfjkUEgrpiY6xG6icpATo-PrJYomeOe8mqnlKxLgfdTmKuZjbyA1PI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAgTToqwnTmVcxGBf14gVKKtAJnqf1q0rZODbRiJNiLA&oe=6A660B09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc-WN6yoj5IQ7kNvwHIP1TJ&_nc_oc=AdqDwEeMBFgrQoMS2eHgUL5zh0ttcTazwoxKoSaVUjrcIj_-c8UcIL5WTJlcSkcr2zk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtmIxY6OwLdaPM0nn8a2KIhGx_JJDVThE5cDjEM4_kDA&oe=6A65FD47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sVWrQxyaF4Q7kNvwFilBEe&_nc_oc=Adq0eB_J0VTzlWyWhe2EszGpz5Py80HKKEc8SIVttP1psIV-oDqlZjWz7NkrbswP7dU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjh0-UjW7wOGGx-YRgLAtCFb1U3O00euDd6pU2DvEBlw&oe=6A6621ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU6J7mtwZ28Q7kNvwEiosbm&_nc_oc=Adp7W_HdrnklvkrZOO1-3YhR-ArzL9AHPK6Rq9lRy0mXKgjZ2rFvubTN06__ZtGb8Ks&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMNnsG3QKNBz-LK-6_WKMy3Jndnv5x3oWxoFJdidtfUA&oe=6A661C01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
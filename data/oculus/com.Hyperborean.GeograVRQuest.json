=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-XSTGegF5EQ7kNvwGM5sWN&_nc_oc=AdpK3uK8Q3XeoOlKybFcaqhyCfOLLN7bUpvXv6TMApL3K_BkAme9Ku3kE5obaD6CZDk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpFCWhV6aRd-pVXVqQG-jqHGbNW6eECYoTPBnwJiP7mQ&oe=6A8EDA30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkiDZymMfRUQ7kNvwEAiYS_&_nc_oc=AdoBZqtM5jLA0LBvxKhB5CqDHGMmWMbKXBcGsV5BG3kbHgqhbRK5daoj4i56BhKVh2I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWf_MLB3C_St46iYW2CTGyN5PUNB33ykQuK3KJ8iSoWg&oe=6A8EE989"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TYtBfE8DDkQ7kNvwEPkf5R&_nc_oc=AdpZ2unvQPcmS4jZPiv8zy1XsoM7mhH4BRLQGoVvXFMNk31PKAQCeNt3lh5Gof_gfwE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhccjaKxhWbUMrd4Ngblm3yS3CLBJTjc7f68cMOBNPRg&oe=6A8EDBC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCwpMV2b80UQ7kNvwHpy0su&_nc_oc=AdrQ7eYS41PKMXQbJpHqPOi54wvNMvWC2x8Cn6YJzc_Mbb6vtiWmHrZ18djacl-wYdU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUAfkkXcJw42diGsAAc-iy80_06efqnV8oEgjbf22EZQ&oe=6A8EC82D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCOOt-bv6BkQ7kNvwEeuX92&_nc_oc=Adq8bf7DDEeQuVXi3a_dN9BY9qQ9XsAeh-ZygBjNxYYvKaqv0DT5vSEmYOaVRp1LLFI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiZsnmUbZvMY1mBWq1be2Sf02q9kKkqOVXJhiv07zqFg&oe=6A8EC241"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
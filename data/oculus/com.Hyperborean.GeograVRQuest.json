&_nc_sid=6e7a0a&_nc_ohc=ewVlbcyz-TsQ7kNvwEaQr_5&_nc_oc=Adpfazit5Qy0-ILuvG595iwMzDR05CmbBjhY7uJ-KrTwCVBQ7Gz4b7fSJbUwfeeW7II&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnKsUJ16ArLiY3gIuge40cWauneaOQtAMgm-Uj6FS4FA&oe=6ACA65F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdUyKm7KOVEQ7kNvwE3qGV9&_nc_oc=AdrWC0GPfYPKA2x0bIHm7PNPOKz8IvVoSHy1RrYKiPbfZfrdNVRUFmOgfWOBBuRxbU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdq_Fq7IRwnVRiIMOhvsEshhpXsJEz-PMpOLb85OLz9w&oe=6ACA7549"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTWa4XTpXu4Q7kNvwHeGU6u&_nc_oc=AdoYtKSwWXANcu-xlvMr4uoGqWSUrI3CtshJ1m4m9wvHYTLysyYwhE2RYFJtO2xO6No&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIfARCGecPSRPByLW1F_EM3Din2YMO8nj8SyCs5RqcbA&oe=6ACA6787"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_zh2FVCDxkQ7kNvwGOtsWV&_nc_oc=Adrc27LM87W7uPGZDlGG04avBZ5NkX6rqsef0K02YsQxrQdJ6vgFRZJa4sGThW4F7OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORpe6CDlOckBJEb0mXo9TruUQ53GGdFcpY_Bs9sPa8KA&oe=6ACA53ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXew4V8Y4YIQ7kNvwEVVsFw&_nc_oc=AdqtG2rZiQ3neX8WVpYwUdyQ8jqJhPuawUZnPkGn_eTzmqCa4mX97NifTbNCL-ckq3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZRGwE3V4zNNlXUEih0rpXirwjCtFwU0U7n9AX-PZ--A&oe=6ACA4E01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
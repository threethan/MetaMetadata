&_nc_sid=6e7a0a&_nc_ohc=PGx8x1MIyfgQ7kNvwG4Z2Ad&_nc_oc=AdrShnPxRbkGEjPGaIqR3y5ErSXmwFYobIoi-ZvIddg4ax_3i0RaGPM8bP5m2zc67Hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK71hoRhqxL3WAzzAWuXvCUsvZB3s7fKLYdu-pWn7KpQ&oe=6A7B13B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YurpiKXVDoIQ7kNvwGIwimp&_nc_oc=AdpEfxiIGyUa_kzQ4C3p6IKL-cO-TJWgPGdJIfLfukGJTHLMDd0fJ1lxuUibLMFezl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYjVq-bo6JNe8k0JvLogCN7bdbeKNcvMaRZCmjvlExfA&oe=6A7B2309"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma653BkuGGQQ7kNvwFH16rf&_nc_oc=Ador5Ua4Q8yeTUVmzaEtNpNpDiSWr5HeP_9_D_395NIM2POSbpWBGsAt2faia_A_YNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES4U70StfaCuSVst4E6KQy-BeG_NSVi-dE0wr0oL4dLQ&oe=6A7B1547"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z51mT9F7IHMQ7kNvwGaAKqv&_nc_oc=AdqEoGdlfJGP0qBN7gC8trAMImBa1RyAt1-xaD0Aeg4F2xLjLh-Sgs5JaRW2NGqaqpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7s3tR4njn6egp0c3ssgPIR_koFZdTWCQp-75wPrNg_g&oe=6A7B01AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbdAtfZAaQYQ7kNvwGtt9BY&_nc_oc=AdohWgyX-wON4TGi7MMYIDqZL6PGVRoyWdcs6WfQk6uL51eIw_T2GzqAoA_TPSAz2Kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwyfqK1rXpaSGKY-ouWkbKS0SAncK7lu-ABApcKhDRZw&oe=6A7B3401"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
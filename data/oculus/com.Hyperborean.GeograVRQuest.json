&_nc_sid=6e7a0a&_nc_ohc=XR0KeupJ6HcQ7kNvwEqJzlc&_nc_oc=AdpK-fsZmiLWUIy_OdL0xoAmQiRqGbfAppeIXUM6x8o_3RwXQiW03q91NaDX_yFztSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM35wOg3YWOvCE_g6Dpg4O-f7-4pYDnZpui_dRiAcHAIQ&oe=6AD3A070"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHpUaZoZa9YQ7kNvwG1lm3o&_nc_oc=AdozXWx3VX-xuNY0wuoSTVgAFioztet6IuSXn6PL1brf9h9pnY7xUX7Xqib0sV9fRoU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKMX2O6qRzW9XyML8QfJg7SAvl7yDkJ3uUbGgnoIXcUA&oe=6AD3AFC9"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsRmo5NEEGwQ7kNvwFBZTiy&_nc_oc=AdpqUnNR0kJkj0Xpt6U87iHIIyFzw3gVqwfkGr-K87-UMUFQXjKQx8lTuv-uxxkHoCI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUX5ou0xFuZ8KWhhQAU8hKL87zcjLnaQdhj569j8TB9w&oe=6AD3A207"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQkMW3KSZH8Q7kNvwHvAAkZ&_nc_oc=AdoJvzC-fG_UmXRq1magT39BnqF_unvjSS7-H-cPBJczLJ2EaaQuKVjrH7rv43GY-ZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj9iSsyeKSA6CxbmsMJ_tCCM8WjMZHy-6CinqbG7yfRg&oe=6AD38E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2pQmtq7YFwQ7kNvwGIlnQ4&_nc_oc=AdpzI7_vehcRbjLZvrJ-Ae3DmR0Z8gbWYjhcHThzV27b0TFtgPoaifHSMDo__otcJOs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJDWn5F7aqpYxyFUdKGyTkTM30KU1KdFJIh_TfMHN_bw&oe=6AD38881"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
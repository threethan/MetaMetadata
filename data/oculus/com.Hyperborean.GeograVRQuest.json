rVjAgsaq_lEB2iOku8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afum11LgXRwqzjD1nTOL2JVk2iNDM8aKOJk0uV4-tXNaTQ&oe=699C4630"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnjGqxOFkfcQ7kNvwFBvmV8&_nc_oc=Adnemlzy2NLMWA156KOEGLqLQSMLJLUAoa6tMgkQ00RMvO5FPWPGXcIcNw7EshF7Lnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxWgBVjotdX2RuDXbjn5cPCta4LOzyjj6A9sW4r5wirg&oe=699C5589"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgjwkz02Gv4Q7kNvwHScIbU&_nc_oc=AdlwOALmzOy0DbyF4zQMlX8Bj2UW4hGJDZvTEBJ9fKyxoak2rWFa1WnVU1mro4FRPNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftNrXGE9VAwkQJhNxbmtb7wlVT65_Vnm-m5IqmW7KmLTQ&oe=699C47C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I8Utbht0EYQ7kNvwGUmtbq&_nc_oc=AdnyUGAg22JrCJ2sSW7Xl284SKCpD5W3hbzsesn2XXka_qhfSLYptgBqpCWGO84FAM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftFaJ0JsH_iKtecRxMH8CcsUGv09xhTx8531C1w4IjweQ&oe=699C342D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4oh5bDmsxUQ7kNvwE50LOK&_nc_oc=Adm2BBtXWDWhE16r5fmXjsPRsNNa5-4toUNAbngHXUOb2Gal4GMYuRNIQjdHLouHMLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAtLk9R-6Qaau38m5WiRrMN3SqmNnGbtYe1pUhfkmPMw&oe=699C6681"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
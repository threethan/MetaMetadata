_zQpCoqOI7M_a_kiGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvC-_cK8lbjEX4gJpqMCCOAVVa4bqSeERShycqhQ6tHTA&oe=699AF4B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnjGqxOFkfcQ7kNvwHZEeeA&_nc_oc=Adn9x9M4oRbhzVyrn0mZ0NzL4pglW0lhIar7VPmjMF1jQeSP7ymmrRCWQ9V3J4HxGOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGAImBCtWMtDgNpnr08yx_aOgZsHlcGv2ve_b_wP2XZQ&oe=699B0409"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgjwkz02Gv4Q7kNvwGQXSbA&_nc_oc=Adkzk4YYb6e6AvsFzxwUpePdSeuYED_G4kZ7X9rHMJXBQUixED9LE8lSVV0V0CS6sdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftvI5-n7wgM_CpYGgTN7eKXvswK5DXK9GjE_Fh-Y_igAg&oe=699AF647"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I8Utbht0EYQ7kNvwGvTVPc&_nc_oc=AdkTVEcjXTm9-ZO78q6qYH5R_8wSjPQoGNpl4IBoI91qN6J7cPZuT1WnALfgJjtaUyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftESGWWMbcI2GvWcGlaE-4PhcChKfs144xPwQRYa6657A&oe=699AE2AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4oh5bDmsxUQ7kNvwGSWJ8z&_nc_oc=AdmYKRhcAHTW5QCtBMQE2HlNLvPrfeSDzu7OKLSs_cluJosZ0Ds3psZrBihDuXZh0YU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNNPalJb4RzTISsfo81aX2IruyE2QfL0SPs0XMmlayvQ&oe=699B1501"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
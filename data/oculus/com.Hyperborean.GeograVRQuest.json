&_nc_sid=6e7a0a&_nc_ohc=i-Yk_DN9hrcQ7kNvwHvMAZt&_nc_oc=Adr_hwLOhWB7IxsqDXYdtsq0_KsKbs_Y0YEwltMtGI1RdNeC56KQB9iEv8YCMH2_U4M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVz55U2mby_aPfhRHTNoHvJ4q-6xvnN2Sz7YyOGyg4VQ&oe=6A5386B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhURYEvavZIQ7kNvwG4g3aX&_nc_oc=AdrwU9UI4qmzLXDEc6I8oGRuLGKynCbIK6DnSbMvvZ6ZDpzr11zC3yDu8KXJc7jiY-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQXb4Ip2V5JjBRiVsY8Hu3YLPl_8-vOhon4-RMqi626g&oe=6A539609"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lQTNwVOCYAQ7kNvwFXlvV2&_nc_oc=AdqdO-b0s3Puy6FYFK6VJ8sCUAvP6pPHHEHJCnr4BE3OuRlVGcWefBqEECch7Ctkp6c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHelO2YAd5fJntqwg3yCCoJxVenjMVPThXAQmBgaIjkA&oe=6A538847"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwh6rd1V3mcQ7kNvwEkHxLm&_nc_oc=AdrkairE7_RmUOYH79p1FRjqlgx8CeFLnPVTAdZq9KH4vUBBShSdeHQIL9Na8XXO8tQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM9GJN3jIegFuPrjcUiw1fb03BdCb5uDqFmaNeTY1PAw&oe=6A53ACED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja3fNlHoqkgQ7kNvwF8ZNOY&_nc_oc=Adql9ne26MMmWujnj-nWuQ_DfPSv1k3FceDn_IyjJ9X74ae8FT4kbHxJZwPxqqLYkOE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4X0E6EK3_ivC_aMRcozgLDEUDdS7128-PeS2kC1VCsA&oe=6A53A701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
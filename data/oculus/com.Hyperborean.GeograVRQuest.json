&_nc_sid=6e7a0a&_nc_ohc=ootlxPZGaZsQ7kNvwFaNmD0&_nc_oc=Adp7XwZPXBw50O-3P7YH1iej5YxeuIH91hJtvYvldufiX9FTE1TaL-dpHg_4RnfG-_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfV0s5kzgs_SRnGAJk5XyOjoVzPZcJlXOHsg8041mwPA&oe=6A4F9230"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSREgP9GTjgQ7kNvwE9TTXQ&_nc_oc=Ado-UuhpxyJ-9gUOC2qJ4zVm-B1_WPd7X2hzcQbN8EpscxR5SCffyQzDHYwFutwIbl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIuxvOfDUyXnMBkmGQOglBZ7Sq3FNJ0p5n6X676UTMVw&oe=6A4FA189"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfY12VuM4bgQ7kNvwFAZGbH&_nc_oc=Ado4kiav7LeV_tMcZ0YGlF2b-sTXJMBiM2_aRy08MefFn0XueqQYzIAt8b-LAgXBLg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiApoT1l3Z4Twodl3EUTAX_6Kc1_HylGo-2lfhQfZ7jA&oe=6A4F93C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN96hDcHBGUQ7kNvwHPgajc&_nc_oc=AdqUFGLL42cS5uHHqSLi_CapYAdL1lUppDKM6RBtKMxNx2f5fC-oQcXvE9MZ4-mTgig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvXRuFWx3q4LsN7dgIfO3OhEE5hyNZQBLQoVcknMXMMQ&oe=6A4FB86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6DXzxI1hWgQ7kNvwHRfILT&_nc_oc=AdqeiG6DWjPm0ALmF0N6wfdbNc7ltFvWaZfxfGCKLIHQBTCLOFNIkqT6TS4mQtst-0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2D9EYjr-TU6n84CA2kjVmL3l8y_iIqHgfdB1XvrZcfA&oe=6A4FB281"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
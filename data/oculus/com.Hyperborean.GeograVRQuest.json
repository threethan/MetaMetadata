&_nc_sid=6e7a0a&_nc_ohc=ur2EEndXuwwQ7kNvwHROn35&_nc_oc=Adr3fk4icUk8mXk_riwq48IMYxLkNWVIFR1E6PZ2KaIHDuOkx6PPv_vSPIOZgz0nMwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JooadLv1FMPuf1OpqnHz9_FvASoVXZUhXPvsIxAI1Cw&oe=69D8EB30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38YU6NRJKSUQ7kNvwH86Ott&_nc_oc=Adrcf0GLS8Hx098WRKQBiF418t1GdIvZnOqU4y44sEbjv_8mRGRPvIXzETwmPI8QZmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2izm34GWnnUQqdakNLdUc0sF1nrRGG9_yHYVzECpE5vA&oe=69D8FA89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhaCpyTH0aUQ7kNvwE2apxb&_nc_oc=AdrFKMy9PPJBNNogbVT9EsqU4zfWelXm9WFs1TcbruvzQpFVDAGbbuMDyIoxst0HV_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XOJLJljOWdzvmTPlGk4CaeqxQq1uotmB37d3tqvtE9Q&oe=69D8ECC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEB7DFJblDMQ7kNvwHXSwhm&_nc_oc=AdoGgqD9WIcV14MUstXD4A4YBT_PFy8GwxCZ-6wDhGE8dldDGXKMwMc2-e8aXx7r1Nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xZHF99WGnfQhgm0kx1YmYVWLaXzw1WqOO1WFlTj3VlA&oe=69D8D92D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03OxkjRp6egQ7kNvwFTQFXO&_nc_oc=Adrxfau4_v1naCBHY8ZMJr0aaW2buT7LL7ewqjpLLy53eKnQoZE7SnhDtpKtiwJd1mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nhS7py64mlyTDQdBYB31WfMlPqNljDQSXcCczepa6tA&oe=69D90B81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
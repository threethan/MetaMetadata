tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ckJ85ZTOKEQ7kNvwHbzmCO&_nc_oc=AdkIxDXQT77O6komtcxE8OEn-EFIb7Unbk52K1CiJj2jEMReZWOhb7hhaIfyFZRwh8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftfc6XRZ4yOA0YcGgvbdS0Fvp4U-mqs997Zan2ng-_O_A&oe=69A58247"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0OUO8HhbccQ7kNvwHi8WKK&_nc_oc=AdlY6DcWGugHn-RxqRiQr9dKfQRXEO6j6pbu7OUxvYa0DrWLoz9Vtlkr3-FTnAxSlK8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftcjJeTpMc2HCgRT04uTVoadljJp1widlnCu6Ja3yiv7Q&oe=69A56EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9CiC_YkAMMQ7kNvwHWj9Le&_nc_oc=AdlDfpvdG7OZTF8vLHm5KtgcxlAZMiADUCpAf5vHKN8IXy274xLGuT-fG0q2WG9dSYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfunvcozLydwGrGy6Uk0jtRq-TZIn7yiqkAdXoZr_cF4Yg&oe=69A568C1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "973942873558422"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5053779887978408", "version": "1.0"}, "id": "185923896758619", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4121604544529285", "is_concept": false, "latest_relea
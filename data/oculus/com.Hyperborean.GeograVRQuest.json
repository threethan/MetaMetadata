&_nc_sid=6e7a0a&_nc_ohc=UJUWAynafCkQ7kNvwHRrWMb&_nc_oc=AdqmtSCauxC2noVin2sbARBHR6FLBG8c5RAoVQ9mAVEVgvi0J0DvpzN0Pccjie88BhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af822jeDW6L2_tTdQ9lG5yBzalEkJFY-XLepRZ5i9ZkbmQ&oe=6A2956B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uweJuf_8MjAQ7kNvwETCQMe&_nc_oc=AdqdsCjqGVetkMp_RlV_ytsXyW1A0cjD705zsg-gPnmrW_RniHyliNkQKFPsBuMBMZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q3l4-y7xE1YF0z5dvZ-ri5T_2R_WONa_NnEJKvp_Fpw&oe=6A296609"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zULzZ6Gy1oEQ7kNvwE_0Jie&_nc_oc=AdoWcFhiNlOWguLIyLqYmvdN4sGR3HDYfEejJrvDyg35hkayzbzdTLZT8i0G4fXA49s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xXbmuOjoovUrt6rYgNKOSfrJg66JcdFBWH1laA3Hhrg&oe=6A295847"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKvRI8Pb-HcQ7kNvwEHQr0S&_nc_oc=AdrfleNGNpN5Eb4Rz9kLeQd8ixZ65NlYiaWPsrpNbfrY_XinVPtTc-ngSY12sfAUFoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QlqoL36naGUuGIpHNDeO3xqRyY0_AUUDrA9HiWCFdtA&oe=6A297CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usWFdZJAxjMQ7kNvwHbr0__&_nc_oc=AdoHolTYjxMgBG8eSeZvSswAeMX7VLiD7XD3gLWDMIH95vrf1lq5aQlsg1_PMxa7X8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Nfgq7ABuAX2mZnzKgdRumTMtkqwwkSy0XXRDUWTTlA&oe=6A297701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
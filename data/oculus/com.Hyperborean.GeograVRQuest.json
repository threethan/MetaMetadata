&_nc_sid=6e7a0a&_nc_ohc=BnofZOZBKAIQ7kNvwEn6c_4&_nc_oc=Adqux6_k-sn1u6tOTpQteGbdr0En5BRp04ZH0VCCIk8AfXdTpgASfI3P5Z4Uvg3LPPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7etZlak-ZZLUDNtROix3XCjEWtnCnkEyTgebQXubQ0rA&oe=69FC83B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb3GNnmYfEgQ7kNvwFvNhqt&_nc_oc=AdpN59vapJClxXqmBdFQ_raEtfbXwHGc9qwtw1iDCGEVdNuOwKHpZ7wNYENYP95ajWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Na87VNSHRryGlRsrmPzFigbTWnbQHI96DVC0hg1S-cw&oe=69FC9309"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B5zOiTf-w4Q7kNvwEtDxeI&_nc_oc=Ado5jX13-plPd8SgmHHORuSrwNtUcQ-Liou7wbzo1U4uZBwlkH83dsiYJqkD94vtl2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50soZbma7CYUffW7UTs2-qKtgL7PDgTklVFN9oGGvmug&oe=69FC8547"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDK6tTtG_lgQ7kNvwGCNPOB&_nc_oc=AdrZPYDcsablUByeM9-lh_6EK7Mxphp4IgdqX9H56On2InCL5c2tRphSUBXLVKO3D2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GSvWtqShflo1YFH_hPP8r3jK856RtkjKw2Com-2veYg&oe=69FCA9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMcVu5T8W9IQ7kNvwHZPvlE&_nc_oc=AdruJ_1Y29jhyTd8YlofP0hzWiLEZPnjoAFdFuaWRpju9O5T6Wk255juO07nXW_C_hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VPMGRkn5O7ZSMnmvI7gIbsorZ1dh0rVFyz4FHDzNREQ&oe=69FCA401"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=Som2ki753cgQ7kNvwGnvc39&_nc_oc=Adq5kHJWCGQ_UNOtieJfUrkPSxGtXLny3ATVyesMc-1CM-3OB9F6F-sa_n1xdPulb64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hCCK6K1U6-sEaY1z9mD9GeiPSqNFxBu2LlFTL-CDLjw&oe=6A086130"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uqGQYfJIKUQ7kNvwHrRUAW&_nc_oc=AdrVHTgvVq01nujmCYXjZFKCTTLTEImBmyoLs4QctuOz-o8vdDuATwDKoXTZfBaJRQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59m5liMmjzWCkG-GvqRwZw5Ivo7dxEbXPok7JW7jIDpw&oe=6A087089"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFj6FBjBfOAQ7kNvwE4Ky05&_nc_oc=Adp6-alz5EIF7XfrYzEoj2HWXX_piTuMKj4bTmU17xH8-GvK1YDtV1TsyTkaxZ1e6sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lY3TJtcbNxwpYOZbYYp9rkrxQHJY_Gy4YnzjdD9Hwcw&oe=6A0862C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YBhlH1SbW8Q7kNvwFkVr37&_nc_oc=Adr_uO9HKK5HMfRhSJwzs5HA4sppAaZSgoaVFDnoLEeZChxrEwdkMJPYPdWrPyndIEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J-zaQPdFFZ4Wjv_X2SWwWwKOY7Zexx4zEV0v9vG5SBA&oe=6A08876D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4etK71_9jAQ7kNvwHTnA4m&_nc_oc=AdpMLH3ShBzTY-vOc7oOJSrTu54cUrkAl5-FBjoK_qunrthIeLBPeJPnZMSuRwa-HV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cQ2YUx5RmGcx5g8vbUloZ7Da38DWnTZ8nMPptrYWEzg&oe=6A088181"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
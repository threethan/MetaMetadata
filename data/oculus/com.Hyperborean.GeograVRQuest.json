&_nc_sid=6e7a0a&_nc_ohc=M2X6E3OlvDAQ7kNvwFNoTuu&_nc_oc=Adomvc2M9oN4D9NoRfEfMvT_x0fu9TJJZeGRQyocdnURnUaLohUQgoBauyUhbI0Fvb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcx_uBn72ttq0MOQyKiOd4UIiIbIoZ3TxWNlPOI6sOww&oe=6A6F3630"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3k_D6zoPUkQ7kNvwGRjeM2&_nc_oc=AdqI9onEUzQyaF_G7mNqeHOQBj2uNHFqz_y9_gK91JmtX4djgt6c5hK3wuEgdvtObJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsQWAY8CvB0Wt8tuVOVjIxMzORBgSHblRhpq7ZbmiuGQ&oe=6A6F4589"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs3TSpUlObwQ7kNvwFT8GeM&_nc_oc=Adr-T24NZff_KatSWCagHiLzp1oNHQOSr5ob5O_3BW2dAeLaNjrlIV3JLaiPNlwLjKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBflHUpkJUP8vRNI1IzeDTtbZP7fMaWbp_rLeYZm6IKTA&oe=6A6F37C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsVFaJIB5CIQ7kNvwF0lyZf&_nc_oc=Adr0y_LJrhw_K2RSlDOV8F_duYVKu8I5tG-CNNycdxYPfdaWzWFCfKVQvbqo0kpj_xs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBReBuhTO9b9Lsrx6Ib1i3GBQeaeIlfoQuVra6LcM6QsA&oe=6A6F5C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7LejbA8xioQ7kNvwGxLMRD&_nc_oc=AdoCHx_Li8I4w3MoeADCBM7QnB5PkBGam7TLOCdyqEU4kgab0mQuacivul04LnbVQmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgvYZ22G2qFf5644ZHtn0IbizSTpcKxLF8pI6CdJJnRA&oe=6A6F5681"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
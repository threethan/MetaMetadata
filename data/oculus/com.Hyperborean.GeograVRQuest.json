vwEDHuBd&_nc_oc=Adp5LXnDQhmzuUvh0yPK_5hcnQLqmL8By3vkBhmnkMsdTO9A7BgejFFgNT_WqWF2epg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gyGy0ViW1IVoLnnLWt8xa0FinOZ45yy0hqHmGzlFVvA&oe=69F1F7B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0BWn705vkYQ7kNvwH8Kya7&_nc_oc=Adom_aZyhMmU2WiMnBZ-gFiIIMlnDNi0ArBxMH6vuTE5zzJv8jPckOtyMm0D8BsGaI4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1x7UeEJ0gayzUBSj1mtoqlr9IhEMZRYaezDW-DyI9RvQ&oe=69F20709"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCmwFNL3KKgQ7kNvwG_qlQI&_nc_oc=AdrZ7rdRIc1TZvFb4Xg1n_TQuJQrOrcpOiB9rYwV3TYHdI6VcUlAtHaflTEjQnrRzjU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1g5oswjDYALKWO63K39-faHqI1MPzK7JJ7JPqmxCTAOg&oe=69F1F947"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWDRFisjrC0Q7kNvwHZ4S7v&_nc_oc=AdpOu-YUZk4RU2Qgfp2qGJG7W0mITvCgue47cR6q-tYtHBJRPDKbKxFr3DllsMLtNtM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03Q_sRzdsnoQx2rqVfb1iuoqqztzUYrtcJroSiA9pDlg&oe=69F1E5AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-xy84JVykkQ7kNvwE8QUca&_nc_oc=Adp0rehXFNpe0P_7w5UDBZrbTRcPsD5GSpzZad4r1D_CCxAI5e10QiITwqEYcTGowb4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0VoMp28tHOO8yH8X2DHpXwm6UvVbkYUESzmHXMhlwVsw&oe=69F21801"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
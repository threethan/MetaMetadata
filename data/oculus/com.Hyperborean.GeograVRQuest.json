&_nc_sid=6e7a0a&_nc_ohc=V-6U_KJhUDcQ7kNvwF63ysM&_nc_oc=Adr02eOaGcRDmmluPE0otTiF9Z9L0y_Ct2mM9vgQajvEYKiZoiBCBQVlnucTBAYqBgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OscV9GHpuelQaf6sG7Q9SiqNr50rOtDnhKPORJQfkmQ&oe=6A3EA6F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu_cAGHx-scQ7kNvwE-XEH9&_nc_oc=AdrNfWOvK09vkqOb_1yWf39vZMwTSlcaL_O9pHe0wcoM_a_OTC3VdsagWKudpmExt5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LOAFAmOGdE8mzZ63PeyRybC8H0Army8uEG16olZ1pCA&oe=6A3E7E09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWxBR6xco0MQ7kNvwFujwTP&_nc_oc=AdqW81D7CQJk90ffei7k3-JpbNMI3fS8mH2uMhxssMSRdFN4GtIjawAI5EudfXRhRJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u814e7N39pwpNePRiTj8XyrfZWeAsNpbLy05hoLtfJg&oe=6A3EA887"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVyKZwR88Z4Q7kNvwGkucMB&_nc_oc=Adrbp5uqCIDTkOCOaJQCG_B5NwYGEKjj2BXtVx0QGD1C0h0fQD6y2BONgominq_DQdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fPvHTqWg9tzg373o-em-NhutZ0rlmbiLszdOX9Dy6yQ&oe=6A3E94ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIURMI_sRsAQ7kNvwFXe5H4&_nc_oc=AdrKskEYee4ACUSkGZAkE1-UXvMwdJcU0s_nIgEek4kUV25_k6ptM56bnBhS-HbyeLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WHPnS-0qwB_R70YzBAbkhs3l5_g9gqoo9UIsG3F8F4Q&oe=6A3E8F01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
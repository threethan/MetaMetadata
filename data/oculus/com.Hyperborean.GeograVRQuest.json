&_nc_sid=6e7a0a&_nc_ohc=E1Wb8lwi5RUQ7kNvwFvWOXE&_nc_oc=AdowVf_xEJwsFCd6YKMJZw6T1LVKAOPguPaM9BrOBCE6e4i7e6lRm3ZKEW97DIrWAC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61QDkKGfO7Sshl5xn9SsFe3rxVHJbzKmxi3rTqMazuBA&oe=6A031B30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKTU4SrlCq0Q7kNvwG4f9du&_nc_oc=AdoUVr9tRWme8qgDAN-e_xtoEhGb0bgvif4D9oL_NvkKS33w3vvxM_xFZUItf2Mz4W0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GMkjwqIjsIz-sq67qXSpoSE5cUV9fmk-FDf9scK8wpw&oe=6A032A89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJEO2Rlp25MQ7kNvwG7Ov8d&_nc_oc=Adr4HVt2_wymrxoprTU8tq7LS6_801-mrPw7ODAGGXReA9m-_If6-DbN0Si6LrQINnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EjsaFWMMSvTeOqwJhGG3HkVG1wludXEv5s6ccc2Wi_g&oe=6A031CC7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q85QppTWGW8Q7kNvwH-VsgE&_nc_oc=AdpaG7F3ERMCh52O98tRTCb64TE2tjLP2xuOYz-hBB5KsPo2E7DPhKyTw67MkB76t0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CGHfd7zFdVdNMYE6GjhqaDcu7EymBi6T2oqFYtWH_jw&oe=6A03416D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70dFjakKFNwQ7kNvwE_nQde&_nc_oc=AdocpbSrawzSyBTlBMozohy6H4bdIHAfw9YyKrMCFm7GN9jPqcu_5XV-bsAQwY9Ywys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_9l_eryxC-IMEv8YCHg0lZwmvAzAJksxiRp5XZP3xcg&oe=6A033B81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
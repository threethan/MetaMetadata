=1-7&_nc_sid=6e7a0a&_nc_ohc=If7m5Jd_VScQ7kNvwHhg4PA&_nc_oc=AdqMaBEPbfnWvRyJrc2DG2ZR30I3QA0OA4iFa82QoYW7DvKRTKjmIEX9Cl9lbRcl7aE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z6xdEaJX4hCkoA5Gx9CrFt2GWK-eAxzSqwjaaoLTWKQ&oe=6A119BB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwYzUHhETBAQ7kNvwGopgjH&_nc_oc=AdpxESUFX6NN1ewv4XtvnbbbVQUiinXZHj-LFrpaDgxmPTN_7rRwHsiEFm8Nwm6xVkY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QuJklEP0NdMdyF2bmaPFbMqSpzPDwi2TQBqgF8Wwm-w&oe=6A11AB09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzlsm0niLjIQ7kNvwHxFwIn&_nc_oc=Adov9yYS0L6f47No50gwZ7CyR5X5a60Kyqbg9Rx_2DAWUZzvMnvF25AqCPJW7V3QB94&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VNwkxBDpXCdxnP8vljwfm9TOBFi3K3SP5SlnDYO4h7Q&oe=6A119D47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx2Fs3MsKfIQ7kNvwFUYZb-&_nc_oc=AdqGfkf_yU0wVkWW7QSbFWIIbrS2yKkGY0FxWj0L0x1mq6C8xTVkyjpIduTOAuhbO4U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nl5oWrPvg_R-NagNNyp8aB0oPjRu64JoAxDPcZX9enQ&oe=6A11C1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAryXnNAAM0Q7kNvwHXo2Yu&_nc_oc=AdopAv5qGaw8A7fQvjDbQOtYO-__ZVKiK-THDhag7VPlXdZsgcg5JLDz_Oi0P0vqPxY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54KHvNxdjVk9VVFcSynOLRXuXojFwfnYIBUflwRk3j0w&oe=6A11BC01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
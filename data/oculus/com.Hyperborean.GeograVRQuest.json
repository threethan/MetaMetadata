&_nc_sid=6e7a0a&_nc_ohc=LhZLdPXletwQ7kNvwEZyiCs&_nc_oc=AdqwP80lzH8YaokLNawfTaV7q1NKWRZIli1BLWDVGPRm49FnlvqkS8HEBEmkJjVQPSk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eW4AxVwl67zGwB2TO4Ajkw07X8_uO3J573vvGKMu2vQ&oe=6A1C5FF0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRxuuAW-kKAQ7kNvwFhFvi8&_nc_oc=Adqrx52MwlIkLxUdWFe50hX3DOSGcjza-u1hHv8VPdLIm3QQukuZ4tve6inkSivbdj4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5viozhZdypiMYo4SUvUFnk3mqQRp5lyKxnvv69sWm-Eg&oe=6A1C3709"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5nufnryvj8Q7kNvwHCYCBa&_nc_oc=Adpt5rtJE0agQaISE92jtCyNqGy2SwuI8PqTmIore9EU74j1PmLUdp1OXK-FyJREssg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45jy_AUNXfom4BIFnf4X7SE05i6UN0bffie3CRpHDeZA&oe=6A1C2947"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isLUgiUDZK0Q7kNvwGdSQ7u&_nc_oc=Adr9Gv8aTGgiW643cpAyDSlbBPLKD7l4IwHW1a4bsZF5LXrn6unKYpu6KUVZ_8ScYE4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Phazq4KKv7k0OMLH8xjH_RQ2yLvx21wIpxt8RT_et_g&oe=6A1C4DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KdGmTIsI40Q7kNvwHkIFjj&_nc_oc=Adr4ULt14gU9kjm6brIfMGOdfSZdyvWqjk9AaQPN7ZWRhmNFbH17kNZ5V9iwTOjen78&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BSu12KWRBn80MjWXKlubr8BtcnmVz1uKTiVHGAQGJ9w&oe=6A1C4801"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
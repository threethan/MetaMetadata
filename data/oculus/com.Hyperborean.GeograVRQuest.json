&_nc_sid=6e7a0a&_nc_ohc=a6xFopIk-SUQ7kNvwHZxsZe&_nc_oc=AdqHcjJSSZwF4dNfsHYaf4MjEjBYi5CqC6bMc6fJaLoTtC_X6YyfAFIJQNNBBRDYJhY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLiwuHloP5WzekNMm-bUhCjA95iwqy0HWfh7HcK8S13A&oe=6A4CEF30"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebgg8kXcOvYQ7kNvwEUOen3&_nc_oc=AdqDjuauVtAsPyTGPtKzGL2ioZfrXO82dEuhr2sK7yFm5So3DAEDm1uEUYkedxfdKN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWCC0RaMnWgBEcopzuCxe0dxENz_ksXUN06RPzn_rTCQ&oe=6A4CFE89"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEmz_bUmBWYQ7kNvwGHO6Ev&_nc_oc=AdpNeDk_HWtFnt34mo_rEuDvFt5NW9JPt1xhmxQ0ZVGmcK0xvhJmmHMPDKqnCz7XOrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmCRG0Giu9VdnomjsVlChR0-j_UIX0UUFrkNuoUjXxxw&oe=6A4CF0C7"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDkohKSLx2cQ7kNvwFXc445&_nc_oc=Ado7Z4xfP4d0xxWvyNYa9C9yD3qgifs_1UCKizlI5-L3qTQV_qXi-asEI1VZvAXUgjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVwphRA-R5rKTiIPrqBMRJwAs5zDquOPY_azEibLcXJA&oe=6A4D156D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGbwfDtZ43MQ7kNvwF3Cdaf&_nc_oc=Adpt02fIUAgotVtIhVEvwftOBXkUrUnW5hH6DcJd0QfKGARvi2vdq2p5Vd9fehMVlNc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDeXY0-5LRNs29nh4XLh2SVQOdsTlc-B3w9pHxbZoJFQ&oe=6A4D0F81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=qNhtC5ioS6AQ7kNvwFp-obE&_nc_oc=AdqqDnL1J2wcmVNWuupGEoQGqFBQ9Lkhx0SfAo1jBKk_17b-Lcec4Sl_r6cDZHD2dRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TDqk7_4UnI07E55W-uUFdstR6jvPcGg_M7_-2ilQBjg&oe=6A0EF8B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF0UDBWXJAkQ7kNvwFBAOki&_nc_oc=Adr6F9704S3LYJXv84v6GHyBiThd3JcctwR_13WYKEeRG4e3D1nEEirkdW5sQAd0G_s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hLozoISjsMva-P88DQzurJxSqXz6Cw0gTwBXUr5dzqQ&oe=6A0F0809"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7Q68lQSseMQ7kNvwHFdE78&_nc_oc=Adp1ELbLahjdzxobbhFzy63Kkyh_eqt3rywkgj1Z5oxLJtNCZBDJOjkWLdwQaxfB_mk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ABX2eRbjXVQri0-AUXhWZS3EtNbt0NHPHbsnQYPKJZQ&oe=6A0EFA47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx2Fs3MsKfIQ7kNvwGuV3c6&_nc_oc=Adr7dcsdCuTb5r_CyyMiduMixiU2ja9xpQvUELjlbmh9096OvUOdjYqLtMP4oprNna4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uNVQJCAHBMwOpnQ4wxQn6SLGqGVxj6eG5TZb20twiug&oe=6A0F1EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYdem0D96ysQ7kNvwEoN1Aw&_nc_oc=Adq3BHJBVkR9D1MpUUOBMNDYFQUaaI9tQ6htUPgfWzAY1wd4Whft6rPLv0_0MwEsklk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JML3Y_hnky0DHLvFEKcsFqsr7tCwzi0E1vsWqfz59Uw&oe=6A0F1901"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
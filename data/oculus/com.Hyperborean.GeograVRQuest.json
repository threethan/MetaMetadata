&_nc_sid=6e7a0a&_nc_ohc=MV-F3gFnt7cQ7kNvwHEK3Rt&_nc_oc=AdoqZGLAZigMtxihwSVZBDkc4xsTacGFAPDd3lM-A00_riDMp7L6hIdvDLVA8bcBlj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzB01IG78C5w4o2e--Wz-MDyLdacML-uWvlgQDexSMHg&oe=6AC67170"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9PFEUbHBn4Q7kNvwEK6RgK&_nc_oc=Adrq67bYYJeev_8CMidLOzz2DrvupdxuzJFJIP0Igtg_o7AHVhGXlQQJOALn5etFHHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPQ_QHNmuAOP52IZE46uCqJ7f23G3UmuRrlLtLxWyGLQ&oe=6AC64889"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdjNvTaoL90Q7kNvwERklK8&_nc_oc=AdrttPBgs_2rAckgS5ctgjogcB2652SKOOdLbfMh2AINRNUkzKbHBR5K_Gp0eXREy0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHaBIskN6_tPLSUDIqt8-Tix3WzRzRxHaG7bvct2dNHA&oe=6AC67307"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RdvNX5ZDB8Q7kNvwFFKZ7k&_nc_oc=AdoxlTdz3WXbYcavZQk_jDzAUeTsijwR8-ieOkoGiBgehRgirDKRg8eATJmlRL2M518&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV89KZEKjPT0moaQ9gt5iUitjV7Iw7XXsfpgYCOy--sw&oe=6AC65F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEthlg7EV8QQ7kNvwHIICFo&_nc_oc=AdoLscOoWSEVfrJbuysiN5X2iMvxCoKfToDD96WNTWAYMHhN_nYfzf5TrPxLXOISa4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_3pMwAI58Y0r9JpSnBXO-yWRkgMnjH1V_TBAiyKieWQ&oe=6AC65981"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
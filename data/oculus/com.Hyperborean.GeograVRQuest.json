&_nc_sid=6e7a0a&_nc_ohc=m48hPXrI9CoQ7kNvwHx1HeT&_nc_oc=AdpJRYFduJjk7V9w0DTD1VwciLjGHogwfkCYi-62lyQQdpusx-Rw0X4dTtKPk33L4Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUT5fpeeL4s0DcUFZY3nefxA7bnLd6lihL1G0qxXlpyg&oe=6AEA09F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9xds8_sRusQ7kNvwFl_UPY&_nc_oc=Adrg1zVeV1J5n7gOMk1RPtlwxtpz2TIo6EWEw_qQOfKAd42oSEuLxWvphZ_V_WaHN2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIwdC-w010Xd-1AFme-5DAf9NNOGeH1QlZB5QHQUl2Fg&oe=6AE9E109"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuqDMsiueZEQ7kNvwEEiI8t&_nc_oc=AdpZj3Mz3GZgZlaCsvu5WqQBxwTjbLVfaSIe4pmDtIUTAsP2plCcUcZralKW5H_lEBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrp8iI-09-4ygXktioVzCb177j9DOxdi6ULy8wl0qvLg&oe=6AEA0B87"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrMwRaKOmOQQ7kNvwEhA-dB&_nc_oc=AdpKe8z9YFD8bN_JcV-UfdCigqZx4cJ3eTe9oZtWFjehGz2aL6ovCxllS8k6sY4jEBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ10xVbcaslOjl3cSt04o8dwuHglX0xrSNzW--tjXmvJw&oe=6AE9F7ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y_wKH8AxMoQ7kNvwHt3o4y&_nc_oc=Adr-xA2D8V9hzpv6z9k6KhMeJaoi8nM30pfOWFA7GqrdWpUmC6TL5KBXIJGDJXw0A_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4RG8C1j3YOIF4yttpe72aIqDTmJHPYtDexUjnIz0MBw&oe=6AE9F201"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
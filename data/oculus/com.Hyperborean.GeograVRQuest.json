&_nc_sid=6e7a0a&_nc_ohc=BnofZOZBKAIQ7kNvwFRJt9v&_nc_oc=Adpireke3i5R7eMuJg8h8gpdWBLPUs_pTSJ7HTq_hSLcHvC2JvxLQ9q87M5eJuC_Kt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uWHhk97SOpxJG8cPqZN4APtY4qT-jISuK8Ln7_u41-Q&oe=69FF26B0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb3GNnmYfEgQ7kNvwH9EXdd&_nc_oc=Ado6DowSKLkGfZ8MLiBeZsCTNj94Cae5RHtkid4h76sdFadtoIssj33WtHST_b1V8II&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WHTUJCrELIsyUVlLdr8Apnl-53VG_vBVEMgnu35i8TA&oe=69FF3609"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B5zOiTf-w4Q7kNvwE9rCbw&_nc_oc=AdpT6CoNA6kma-WtHGhXGvVVpA1IDgpHg7_HVsxx_6fFxduUR0WAdCDfnx2W5Q1EjVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ANNHtTAWCMj5Yem-eP8AJIyZ8d4fB_owOvXSlEcMYdw&oe=69FF2847"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34ulwr-8iRUQ7kNvwGpgZOQ&_nc_oc=AdpORbTFGt5M7CKA6Ns-qVUwUjQFhac8_A6DQfBo-IJnbEFnHh4UoTeBKkPv5LNMty4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uXj-MSiVJBPtnXih8YfqcYAbaKFtjCZMIR805O9Y5Qg&oe=69FF4CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMcVu5T8W9IQ7kNvwHM33sC&_nc_oc=Adp3OY0T4jqUognz8_4qZeoqsHXTpG0zwzTRMiuVGDmfkra1RJbn2Crtbndd-OKsPOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BjwmFNyzw-i5OoniP_zN6BnGr7vHjzETyZxWLSz9mmA&oe=69FF4701"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=hyFP0s4o9zAQ7kNvwF3cqN-&_nc_oc=Adpxv-xrAEtCLaMajBtWFrGbZbnfHdR-XvaMCR4q7W9Od5Must9vysEjrt184TkQK2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4GwdqkMPlCtXVzHhc_eVLtK1FQWyE_9ZKCOW76qVUtg&oe=6AF34470"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iItoYtV94P4Q7kNvwGa5SO6&_nc_oc=AdqtqV5xvH8PuReOHTra48z04UVWxE60yJB_OuPHaUXQVFC4Qr52FJXvteqCP44hCH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZQNbVCa4hSHIFMpzCCPaDbh46oxHJTmHGxmtvJaiX-w&oe=6AF353C9"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfDnDuAbEYsQ7kNvwEAhhLs&_nc_oc=Adpicm5IZil5js6CIzOy9__pCzwK1ncmcK6GuJfYHyypIJmdRmG_FmQPbKH0yKCTeAo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWjbxtyfgh0R9chXnTx9jXGcc6CZqXiukYwCK6dJFa2A&oe=6AF34607"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgxPC2F5IeYQ7kNvwFKMQjA&_nc_oc=AdqFs-6rnNysCbweTPCI2bChpSu8iYImZCwZYzEfLCcU4YvXBhyuK7NMmCK7vhFysfU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBMdWn0aFPXWmdctq4k3KIfBtLRaVdNC1yG289VLShOg&oe=6AF3326D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyxVe_RQXf8Q7kNvwE3yjDk&_nc_oc=Adq1pHnqqlmb7ec5TTShdhaqqxlcN9fh0p3DB5kFZqPFpU9EOsIzIqkf5ZY4TPhoONc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXL0eBZeQrWu-cgFMFb-13ZPwVhunsJYPexRLytiptg&oe=6AF32C81"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
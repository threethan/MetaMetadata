nt-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_643662246757239_3081913009937865008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGkd8JzCLv4Q7kNvwG4cfL9&_nc_oc=AdpZ3LjgkOlE0oF1IzyKSoT3l7JQrSJxB6JDNZ6bfkOWrVZtaFo-GBIrxcFKkp3gyBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj9PWpB98TV9T5c2WLbmeQXsoruvdQZDobu7l_HUE48Q&oe=6B0DA270"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pWrEPJVNnYQ7kNvwFeczOV&_nc_oc=Ado-9MsilvZafNxqLbP1AJ5IGRjrNdld9s3wRWRI4kCMGaFBe9cIUOtY9huwHO1iYnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ49hpQRP6AjZ7zTf1HnANcg5N8treSjPGXIewqGHjMQQ&oe=6B0DB1C9"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za10t86k04YQ7kNvwH-d0Ho&_nc_oc=AdoSR04_7f7uOFpQVq6EPhnHkqYKjT_j1Bf7gbJxWNTNaLqRc1iPD5kWtqeqEGl4d3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFhbateujeL98vS8mcalGtB6kl0kVUZKRTMi_LaHZzmA&oe=6B0DA407"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSNC9akqh-kQ7kNvwGvzrIr&_nc_oc=AdqSQR1fSI4tTEb1PIPYcPGvVaa9P54vaR8Bj4CT1sAhDF7QlxVXRukQV4whOTnoZFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSq87rYMfg2wSg8De-TqR-n4I2qrgfKmdRbQtOkTBkfdA&oe=6B0DC8AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKUGDEjnMfMQ7kNvwELQRr9&_nc_oc=Adqx0iMWc243IuViRcFGp48q_OP84f2jcJkPJMuqhEm4iEe708AX3CMJ73EA_g411gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEZHSjJgaxlBIrNTpxkuLSzlL6Elo90rLXgIvUdQTrLg&oe=6B0DC2C1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["AR
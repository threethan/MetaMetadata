&_nc_sid=6e7a0a&_nc_ohc=8jx0qr7WFMgQ7kNvwE8LnUX&_nc_oc=AdqggRkIIgQm_iFNELk9yJD2Kl2Dye9oRAKKMcTuIjzDBYZP6PaPFO7GEYNhyfLjLGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sV3nq1r7RQkt_WS0iUM7GHCAupLy77v0mTZtQ3EDqMg&oe=69EA0EB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZSAe3b0TWwQ7kNvwGEu3nV&_nc_oc=AdoGw3zEMCrn0NERamW0-yVtgRh2s6h9FHPkpK7vAPaxv2qg5DWWkURJl0Wpb2vUVq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oknQ5EjGniaEzzeXMPp2d4Lyq5DWVjGQFO_Y45DzXdg&oe=69EA1E09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMCnObA_T_wQ7kNvwGXX6wQ&_nc_oc=Adq2heTNiSk-3tDhpV1rWrQKB0LzHH0L3gnQQ9eit89moYp3mSKnlNWl-QBTSBvIZUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pByYRHWnlyOCTQQzzU48Agva6SfRHsu7jQS-2eQZktQ&oe=69EA1047"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM3VChX7VDwQ7kNvwEhTERg&_nc_oc=Adpt4q2Aq2djXRNt-J7q6bJi1zh230rPrqfWe4aafrSgqdivFPhViYb9UaW_oAwSCyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kTQzSXi6UD4BOsSZn6jd1Snd4xWqSGJt1MwL_OKY3XQ&oe=69EA34ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DoRmOuMSPQQ7kNvwGmZM5-&_nc_oc=AdpZPaByuiEdsYDe0Lr0rDZFqsz7YgpuSoxC4l79bOYqeU1cA7h_rf-eR2k1MdIyMro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R8w4DLZs4vPvqCJKQEVkBaEiymBGyxhkGLJ-8x-KubQ&oe=69EA2F01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
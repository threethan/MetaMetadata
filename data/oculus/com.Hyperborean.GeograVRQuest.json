&_nc_sid=6e7a0a&_nc_ohc=UHSc3BM5dH8Q7kNvwHXorvZ&_nc_oc=AdoWacp7OzqrA0OSrVpLUy6caBNwpiLKHdpXRN7TYnDMpdq-8Tnl6rL1NXXJlCnCASA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpi6vxKNmUMacEOttb5my5qHE_Y387toaBFRS-PQvBIw&oe=6AE766F0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6Hy06Zl7VMQ7kNvwGohRzi&_nc_oc=Adr23wlF_rHy2V_G3BDvpSHULIDlHBli-Yl04BsSlEW3PswBwFp1zuMTTq4Bw3Tax_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUTMBcmR98wSsnfrCuppM_L7NtuM31CeogdsZ3p1xpfQ&oe=6AE73E09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c_lJS91cukQ7kNvwEoK2_e&_nc_oc=AdqeRnjPQyQhf7JgR00O6b7RyoXqSx9XddWIorzS5s_eKC-LfD1r3YMN0OclVU0Fc8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRCuRC8u2URJ2JWiWJVzCFUR3gVmF2lHVDDgo4Gjy97g&oe=6AE76887"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH_sJUWTphsQ7kNvwFZIKhu&_nc_oc=Adr0llSXwaNacA0RivrDrBY8v9CFzft4q6ZbOB2uZSM2UQeAfv8WeDn6QJXZWXZNYFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCw43g0QA2AWTgEjGy_9t92VpJXELXO2vtHueer8lplw&oe=6AE754ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKQEoLDDG7oQ7kNvwEX6YJF&_nc_oc=Ado5P2dnpIX8sO34NW09s-WenXKo4l7rOlEmxHZzTS5GFYlC84pQSW3_lwjFXvC7MpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9zXdwogVB3AyoyWIStCNG5YAH7qoCzsWq7VReo8RRSw&oe=6AE74F01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_sid=6e7a0a&_nc_ohc=uVXXsHQPuzUQ7kNvwE4hhJQ&_nc_oc=AdplUyLaaSv6aagGBewzLk9lT5pP4CIu-2qwSu-u-qSJTz73Pp6MowAFXzDQrrDn2vQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD2EmuKoOXV1WfNgVwfiE_tsGgZxJTqw3jhXwBunttZA&oe=6AB15970"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcfX9RLR8fMQ7kNvwELV6ZS&_nc_oc=AdqmkKiZJa7LhcHe9iGrGWZdm7T0A4PTc9dRRXenSXPqYTCsJbBQMIXU2KZYtj0O4tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHDZjNpccctRENOb084RM9yqpgGr71iQ1imaId5zGYbg&oe=6AB13089"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpSJB-b4r5sQ7kNvwGshmBY&_nc_oc=AdquoZBp0Ik8JCOZvhUkn4tyKxxI6sNbreAkNXwGDn9SOm6i2S8-A6GxONDWRqSxPhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy876PVnrVSgWl1VMgYUwI6Plw5wyxce9OdQn6rqxiEA&oe=6AB15B07"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unr1ppXgyDcQ7kNvwF06x9a&_nc_oc=Adpdx5Oo3moEbaINxiQHZVxYtvjfm5vUOeRzrQJ6lS1BbI9GmPysRmMSlLzxCItgqBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqlKYfdozlqhVS4Ik4lxUNdSWutdpmyXV1seSffFn20g&oe=6AB1476D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrqs3Zog8eUQ7kNvwEt8zf0&_nc_oc=Adpb-r7h_XCJJnD8pjkEyaXnUBlBcNFQ-OI5n1q4dafAKB3xq6r6j3PIAHWzI_02tSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO6wiFzwd42QYblDqQPaZE1q7sQHz_VsF3d4bNRMDZUg&oe=6AB14181"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
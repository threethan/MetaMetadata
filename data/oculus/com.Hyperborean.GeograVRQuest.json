&_nc_sid=6e7a0a&_nc_ohc=RQ_UJelFFZ8Q7kNvwEQA-KS&_nc_oc=AdoR_0u3N7tSs4DVQvBKI3KFqmspjCKIFnimNVQFOmat9NU27CzV1odi-ObLzOLFtkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYbfaKZsZj33ZUAYhd4duUdfH42irvuNbhNNsxO9mz4A&oe=6A92CEB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACAbWpIaHu0Q7kNvwEstTrR&_nc_oc=Adr4p_B0m8l_I4pMCPLfmOW7B09z4MArSuNJMxkYpkkQg7hLWxL8QvBBEKS7eR6uey0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcBTDWeLgDhxfhVWtg3cpsN8eM_iV3TZDC-ysjGKc1uw&oe=6A92DE09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w36uJrF1KagQ7kNvwHwF8dh&_nc_oc=AdoVn0HBElxjxTxp8UrOrcahl241KgRve46mYC1TGNljJfnqVZYNVbi_mIM55f-vgUs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb_76fOryL7yiyGddRYuWpeexd7jbohDdyFKuvYOQUwA&oe=6A92D047"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2DJ063kNsQQ7kNvwGqHsBc&_nc_oc=AdrZ3muJ1heZC0i8o1jrl_i4IIDJ_ETZQK8hnqEhbFFgB-_gVjSgMHm8wyAWqZl_YZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoBE1pEVTBHRfkzb4fePIbbQyS8i6HTP6_4sdwUQK78g&oe=6A92BCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q23BSljlxZsQ7kNvwE4yiQm&_nc_oc=Adr9mNHvV4KQqUChwTPRRFP1ecOY18iJPeJMFCu-LNnNAyMMv4zKSDuv4AIkFz2_L24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdaQX3BvhbkmVdJm2oajstFVmowR2c1XbEgX9Z4HhZvw&oe=6A92B6C1"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
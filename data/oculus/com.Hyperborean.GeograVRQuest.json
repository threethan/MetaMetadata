&_nc_sid=6e7a0a&_nc_ohc=V-6U_KJhUDcQ7kNvwGlYp-A&_nc_oc=AdofwqFECcC5mcUQFC8370Y4ff2LAIwztpH75ucXEfxtyZtUMHwd9FXg50eUyxrTO70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_re0QVfts0Svik6mi26jRdeA6X8bgJMPJdw7jT2a1eYA&oe=6A3BCBB0"}, {"file_name": "GeograVR_Screenshot9.png", "id": "1291277504721698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001654_1291277508055031_4406815791933063785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu_cAGHx-scQ7kNvwHSEcgG&_nc_oc=AdpIvpd7NC6XanwHkcUp_5_TpSTGqIO5vUH17POuniV7IzhrDXnP2ra-nkzYl-68wz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lb2XN5zzE1KtNhJq90iBpbqqApif1N4caISsCu0H2zQ&oe=6A3BDB09"}, {"file_name": "GeograVR_Screenshot5.png", "id": "504041681053723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_504041684387056_489153490427308851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K-BNhc9SFsQ7kNvwGSe2Aj&_nc_oc=AdpHuaQgCpXiXidH4-aiQI-NyOKgZmzl4ZYRbL5sDv3UYE4ZNz2tKApg1-T7cCTiqTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3xux6JoKhXJXTXIEgrsXucypSiRe0EOhN_Qw41T32DQ&oe=6A3BCD47"}, {"file_name": "GeograVR_Screenshot6.png", "id": "642861553799923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_642861557133256_8235503438044789680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh9wNbVqh1QQ7kNvwHG5NeZ&_nc_oc=Adr1Xb-_nlxDm5GbtEgVmo3y9rdHJ4yNnupth9arsK7ygunSmKcofuDOV6HWpaYdg6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sf7AntPMAvLBzWl40s5upE6k5ZRsmVTzTcunviKDlVg&oe=6A3BF1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer - Cover Image.png", "id": "645812243281461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_645812246614794_2470528681344526397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIURMI_sRsAQ7kNvwGPexL7&_nc_oc=Adpa2nn6D87SRva6pKR8aHXtZAU-cMiyN28DP7y_EV9Aq-iTSOycVnq6Z4E9tvVFRxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87lzsXDqYOhpoQvDzSun7beM6KhgdDt81BCN6WKpoMPg&oe=6A3BEC01"}, "display_name": "GeograVR", "keywords": [], "long_description": "GeograVR is an educational game in which you can gain an understanding of world geography through fast-paced, competitive gameplay. Given the name of a capital city, you must pinpoint its location on a 3D globe, gaining points for accuracy and speed. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Surpass progressively higher point thresholds to advance through ten challenging levels. Play casually as a means of learning country capitals and their locations, or take to the leaderboards to take on challengers around the globe on score, speed, or accuracy. How far can you go?", "short_description": "GeograVR is a fast-paced game that challenges you to locate capital cities around the globe. From Abu Dhabi to Zagreb, you'll race to drop a pin on the right spot. Earn points for speed and accuracy through a series of progressively more challenging rounds. Play individually to learn, or compete against players around the world for the highest score, fastest time, or longest streak of accurate pins. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hyperboreanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hyperborean", "support_website_url": null, "website_url": "http://hyperboreanstudios.com/GeograVR", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
AdpdMNqr6VLf4AZgro5s_Ijj-JnL6CeVTy9tgPYT9HoTLYdIe7-kH6ONyMwAvldwudA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiVcrLudEla3tCgRyfBkcIHvFzWrWB00sUf220RSEX-A&oe=6AF328E8"}, {"file_name": "4.png", "id": "3477719549082595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628067_3477719552415928_800190843978304698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Lxh0O1IUyAQ7kNvwGicMRK&_nc_oc=AdrgRMuMJ9XmLmN4ul8ztjfWOfgVXCzLAXgiymHqveu0wTWhaRhwYtt8FIAuv5tNwnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1RWtce1IEww8Li-OXlhjascH4MIf8QoxETcWutPmNBw&oe=6AF35884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CarsX | Car racing game", "keywords": ["Carx", "Carracingx", "speedracing", "Ultimateracinggame"], "long_description": "CarsX | Car racing game delivers the ultimate Formula racing experience in VR. Step into the cockpit of high-performance open-wheel cars and feel unmatched speed and precision. Every race tests your reflexes with tight corners, rapid straights, and dynamic circuits designed to keep you fully engaged.\n\nWith realistic controls and deeply immersive visuals, you\u2019ll feel truly connected to the track. Whether you're chasing record lap times or battling for the lead, the intensity of real Formula racing is always present. Featuring detailed environments, responsive handling, and an authentic racing atmosphere, this experience is built for true high-speed enthusiasts.\n\nTake on time trials, refine your skills in practice sessions, or compete in full-scale races. Push your limits, perfect your technique, and prove yourself as a top Formula driver. This isn\u2019t just a game\u2014it\u2019s a complete VR racing experience that puts you right at the center of the action.\n\nFeatures:\n\nRealistic VR driving mechanics and precise handling\n\nFully immersive cockpit perspective with dynamic environments\n\nChallenging tracks featuring sharp turns and high-speed straights\n\nMultiple game modes, including time trials and full races\n\nHigh-quality visuals optimized for VR performance\n\nAuthentic car racing excitement brought to life", "short_description": "CarsX | Car racing Game delivers the ultimate car racing experience in VR. Step into the cockpit of high-performance open-wheel cars and feel unmatched speed and precision. Every race tests your reflexes with tight corners, rapid straights, and dynamic circuits designed to keep you fully engaged.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4496472677286428"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1125614616721209"}, {"status": "PUBLISHED", "id": "1742141336900169"}]}, "baseline_offer": {"id": "1742141336900169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794340800, "status": "PUBLISHED", "id": "1125614616721209"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4496709823929380", "version": "1.0.1"}, "id": "3729430727211423", "ch
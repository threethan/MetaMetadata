1038815253153771", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J97brVQk6ssQ7kNvwEGBgPC&_nc_oc=AdpSfqR52N5AstKVtWAzL4srMt7_tID9ZR4XpCcQYQw9GDdq5hyH7nAq8OPNA6OExRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbtaLNSj0u4vtVFFZfY1Fbk5lytGc7jXoERr_HvkEa5A&oe=69C67215"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rtl2HwsbO0Q7kNvwH24HaC&_nc_oc=AdrMqZof4p8uBFCFshlRzjCDXux7E0ij33s-QMDOF4fUeT169IXqCBiSfPN_OQw9BQk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEt0uI8NTGq80SBAQhm2GktcuYp9NMTYR-uLaUMdxNog&oe=69C686C6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mEucAqNQI8Q7kNvwG9B1Tn&_nc_oc=AdqtGG-8WjdjT7fA_5lUCETGal9-a1BSiHUQs2oFIDSCio1b7Y3UkWhIfMlsFLikZMo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGkvegxW_jOV57AfvDCm5lY2wBt-KgcU5g1YFwUUKPXA&oe=69C67B8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgbkCC5m0AAQ7kNvwGyRwAg&_nc_oc=Ado2BtHTmRiOKgvW_B6IbgixAfqUXVT3-RfLnV_qt-MpuFU53YtAS18NbNLgmGIFknM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVpI3pK4cl1JgyNbKvXLrjVlf2tcH2u01MAnXS_bVvpw&oe=69C670D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
ent-ord5-2.oculuscdn.com&oh=00_AftlMX8-Gbaha7hOn9BPeNvNf5W_tUFXxYNg2BHmwGPyDA&oe=699C6782"}, {"file_name": "migrated_image.png", "id": "303507947293075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974902_2345452102361663_4075271158939779072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkZnTkNc09IQ7kNvwFsWwWU&_nc_oc=Admq5ISXr4lmSuhCri8qAxHWixswhAhnrZaQfvG6l93bxC602w6QoY06Et-n7Gchjj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftytRpQbWwrchNc17LvBm2e857FLdYjQqLe4YqkCy5TIg&oe=699C4AAE"}, {"file_name": "migrated_image.png", "id": "198910648065030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_5RoWXTcTsQ7kNvwHgE7Wc&_nc_oc=AdneUQuenjNzmSLVqcQMO8KElAQ73MfmGiBgrczJYAnTxAiOqq08oLTpa7i43h2rFsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvqz6Snavey-YWgUPVjRtdmDs8f3AmsrtQ8ounNTpQB6w&oe=699C4215"}, {"file_name": "migrated_image.png", "id": "2702389736540478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl8c3D2VZ6wQ7kNvwECYyWA&_nc_oc=AdlVQMdqLO8SAGbD61P7t3fNedJNVDqFh91ck33Euw4jG6kP1qRijgbAl3tVJXDl7gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afto42wSoui7f0h0JWLCu2WbFBHT844zC9dJLXHOFgoSqw&oe=699C56C6"}, {"file_name": "migrated_image.png", "id": "197343111563672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4e5IvjdyqgQ7kNvwFakFlq&_nc_oc=AdkvfZi2eqZZeSZWzoCwG3GrJU_AIs31BIqeOVDUJsp1HzYmR1s4WwUFcFk1y8YERMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfucRim6aBdKtzUQf0qxM1qq2LQvmcyzS7GXzYX2ZiXmLQ&oe=699C4B8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacypolicy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315509250526538"}}]}, "scheduled_offers": {"count": 0, "nod
ent-ord5-2.oculuscdn.com&oh=00_AfutJRwmKMkNJA-ShUtRksYehYdHHOsnxAhvpIJzSvhnGg&oe=699ADDC2"}, {"file_name": "migrated_image.png", "id": "303507947293075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974902_2345452102361663_4075271158939779072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCCyhiYvx1sQ7kNvwG3GLVZ&_nc_oc=AdkKd2GxJSZSHi_y8mUv0DS1_widSKE08n3ImNVa5I7qEj2-p4BDTv4MJquz9eCotfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTTWh8lSQCZA7nXbYEuzjT3-S-hZ77z_Y8C1LWVdbqGA&oe=699AF92E"}, {"file_name": "migrated_image.png", "id": "198910648065030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_5RoWXTcTsQ7kNvwEcbcbu&_nc_oc=AdlteCwoOadr0D4vrHxYExlatA5P2mLW6M-fGgU4IP1oS-ra3KCzpTtIqDVu39gnB3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuGGf01UPW3nwaXD3ot6fzsaXxxK6yBAYHRa6n5JtFTmw&oe=699AF095"}, {"file_name": "migrated_image.png", "id": "2702389736540478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x3Qahl4y6sQ7kNvwG9xZ_f&_nc_oc=AdlO4X8Mzu9s7pZFfza0vWaPHwPEqi6fWTKGB-BDxqIKF9kEy_kjjbalHgiOIFY8xds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxGrD0kx53hmiBXiXC5UKcBqbKxW-Y6Oz80oPHOtgZ-A&oe=699B0546"}, {"file_name": "migrated_image.png", "id": "197343111563672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4e5IvjdyqgQ7kNvwGN-7AN&_nc_oc=AdkwK9goNAcMVAWdO7EHgMRPM0LIr1Pkl1wljuxAyJVf7lJeDXhh7M81ModCBLg-DrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5trq12BIpWv26Mo8rPRs9zwmYeP7_WNiaxa7evkSgqA&oe=699AFA0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacypolicy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315509250526538"}}]}, "scheduled_offers": {"count": 0, "nod
culuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxerVtjKg_AQ7kNvwFPMx5F&_nc_oc=Adrl544IrRBOVfMt7OnxgcE_AdltwoEdtW3YxIRiIbPT_DRM8MwvTWz1RrK5hukxkvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1P58vojk8vLiOdmeGLxDAd3ECyx_dx9yh91zoA50gaIA&oe=69F1F395"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2QL3RkQU-AQ7kNvwF87YMF&_nc_oc=AdpDp9Wyn7iN1Ghhpv9HgBBXRLE9N0d509vjCs2CVHVo0Y5wk6py6gJLZM2TfGV_2yQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0tCMs979s0EICEKJqL9pk9doleeNp87Kv8KFjEJvNDDQ&oe=69F20846"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wERM24RwGAMQ7kNvwEq73Wt&_nc_oc=Adp79FSKOo5hkp8cxovDh103RRWeTWWazbzmcNERNQvVMeXZHaNBNnJ9FkYJrC8Kzco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0skF11FoMxN3A7whZk820lhEXQNaJJQVT_ZKSMrht3EA&oe=69F1FD0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqe954aF1W4Q7kNvwHSR5VD&_nc_oc=AdreRtzqpCZ5orcHX8K5Qk1S8OECR0hlZzCAzfjdc6njYpknl2U--3rCK7JdAFbPSf0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qmuSeyo-W6Y3WT3M3NaLDWomZS7uew40ah8C14pzjXQ&oe=69F1F259"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1564074000, "lastRe
1038815253153771", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_sBTnyC0d8Q7kNvwFPadEw&_nc_oc=AdoOvJKuJbFBxIwv00ZyG6RMUsTLZJ9uT2VmLhCxtsJXQ81PUsqmbxnb_51AiWIGhtY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB2BedSBfv-sqL3uZOh5cpK9Fio7VBWSEoJmW2TAREfA&oe=6A58C895"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGqdT6EjBIoQ7kNvwGhVDVf&_nc_oc=Adp0sU8WXxnI1Jcipdo2TCou2l_LAq4CbaXrmXmc10VWlaahIFzDHBhWPV6cxyENksU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzk2sGmSssZ0597cjRyX9KotVJaN9J_-aLXhy262y58w&oe=6A58DD46"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNFZ7cBPwvwQ7kNvwEqYmnF&_nc_oc=Adqokku3puvzGBcOQ5rU3WKWV5-7RZ1u1NkQhLsrxlfgRy4dA8mQiUNRAKFycAZ22co&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD41rSMYOxAzF6OgP89kik80AZ_Z9EDOCyacBzvLGZnNA&oe=6A58D20A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RM5vgct5OgQ7kNvwGD4pk-&_nc_oc=AdoZVm3dA8rW2XYj30UGChZm1rhnTveHDaccWsIMnyBfL1fa53nqGSIobPdy7GKE7Wg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLlNZdlN4sJ1hPKsewsK2LKI0PuKPdxKQznZnWUhqiVw&oe=6A58C759"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
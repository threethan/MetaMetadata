1038815253153771", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJIqVhhwU7MQ7kNvwHkN5Z-&_nc_oc=Adpza1iuAVDcW_ckeXltl71h1w1cnzSKK6cSORywNJgZ0QXW_qfy5NxuRZr5fPkCGFA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B9Me4Q4nX1S6Imx3W0O5Ef3bweQKJ3n7TSXcOZga3CQ&oe=69D79595"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb42ppU7WuAQ7kNvwHcxZdH&_nc_oc=AdrFLiuCogq53bDrBpZiOqjuwF7mwaACswmUqgTp5p6M2gJvgSfnWslQ8rEO19F_yD0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af381hC3bku0hZW7PSbRQ7qu9K-6ehAg51Zf8RndCBNvcw&oe=69D7AA46"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXH2vt-H7ZQQ7kNvwG5U1Xt&_nc_oc=AdpjSKIL-NFNqQafQAK9UbgPmvZcTuKGvjojFvMUdae8IoGf0L9EKywqZYRXwT92kmQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11aslTHSVfgL-8K4_xJB2-R_Ny6vQiegQNPQ9x_P5TNQ&oe=69D79F0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6jUYcaA5vgQ7kNvwG2ZpHh&_nc_oc=AdoQmnAUh4SpiFKw5K-GcCLHOlG9TOYk2pdtgoETK47SmFMTCEdRQqR6a3h9jHtHzT0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mNP5mNcj-P26ODyaz870A6nAFjzeEy6fk-1KMKRJHSQ&oe=69D79459"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
ent-hkg1-2.oculuscdn.com&oh=00_AftXec2qvcLVU5OVazC5jJulUzyutjNZyZ-fEBk_u8tPMg&oe=69A17542"}, {"file_name": "migrated_image.png", "id": "303507947293075", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974902_2345452102361663_4075271158939779072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9U4Frr_fNcQ7kNvwGrbImG&_nc_oc=Adn46Tk-s4oH4QwHGBlF_YAzCfD6lV0D35Jucro_rO9o3w51DY901SB0WPOaVvOa1TQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft4XGbaMO2Awj8HIpSFbRQzqdiAzoVthxR-BjRo78Aozw&oe=69A190AE"}, {"file_name": "migrated_image.png", "id": "198910648065030", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtD81gsv44oQ7kNvwFAqaLj&_nc_oc=AdlpWPANkycgHP7NeBse2xzPjrxqWpH5MPXZWPQ3NjATWevIqZAcR7zZ7qh5euMbe68&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftKpt_dHBDt7GgXQJ300sktAgIyb_dNWZIap_xLzH_a0w&oe=69A18815"}, {"file_name": "migrated_image.png", "id": "2702389736540478", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_BRZB78IngQ7kNvwEvrvUQ&_nc_oc=AdlANqXOgUAfP9dIph8W-UH6Ck2PMEFoGyNiueMBxbq_6x4Wnqmh_KYoBcNfzTRU6Go&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuiK3l-Ej1GWqPdt1Q_AWBdG-a5381LdrlccDCaC14bvQ&oe=69A19CC6"}, {"file_name": "migrated_image.png", "id": "197343111563672", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNi2P-EvSHoQ7kNvwGitKAu&_nc_oc=Adl-jiWLW-kMvLeIBKEa1315XO1oFWyQGGdZqdQFB82VY0qr1pGweT7LUEtyq2c5fJU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftGjoe1tkHBNRVh2xhsG697z5whtlO1FVIwzsCfFYRobA&oe=69A1918A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacypolicy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315509250526538"}}]}, "scheduled_offers": {"count": 0, "nod
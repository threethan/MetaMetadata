1038815253153771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkCbh1tmmT0Q7kNvwHcbe_9&_nc_oc=AdrigCM3t_2chR_X23wC3RMTgOBTVIQTsj7guymLVvrbV6yowzp506Ml9VanB66doLE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhD9MqbihpxRy6y-EL6SNh7mxByiWzRE7PuSpfpEwPoA&oe=6AC91055"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4f5Jl2tTnUQ7kNvwGsIZ1P&_nc_oc=Adrd35s6FJvhfNtaTN7ZHkDo7crtb0w9y_GGvDBBfKKPbeV87FOS9BMZs-m6pinJT0k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtVhP-A6RlxzmbqS0ejHQNi2uVv3E3LPTwkPwYVS_iGg&oe=6AC8ECC6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrkTKlnh9h4Q7kNvwG5v9-Z&_nc_oc=Adpa5G9lkiBDNXvdRehMqM_e-IFWHCvZ_mxSbMEQRcCcWiaxunwrrL049seASVNLlhU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDBsUDzszT-3sdGnn6Df8GU-d_mAbO0_fUZ_C2RFdOYA&oe=6AC919CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W1Zjfskw3EQ7kNvwG0-2H7&_nc_oc=AdpaW2-TMG5OXMKfqQY2LJJhAKx84IWYin5wGv7BFnghVagcU8Zrej6uf16JYpv1Kbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrnGbBlyrriYJF0ZVBGQqCEsPAZ7q0QTZMA5M-iZbwsQ&oe=6AC90F19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
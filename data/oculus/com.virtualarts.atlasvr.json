ent-iad3-1.oculuscdn.com&oh=00_AfuMchqPSpZ1wNfQxbNDSvMsors58Xrlu8ouejDfdKLnfg&oe=699D80C2"}, {"file_name": "migrated_image.png", "id": "303507947293075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974902_2345452102361663_4075271158939779072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkZnTkNc09IQ7kNvwFKDOir&_nc_oc=AdnmMuubq21c5uee2g-mxPNz4pmV1-59nGtU5CUjN09ac9rQfFlgu3oop-YDzCcx1gU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuToZfREw9IgaQCFNJwFDoGXA97vlNW_rUYyY--LVWC8A&oe=699D9C2E"}, {"file_name": "migrated_image.png", "id": "198910648065030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymr9yh5zuGAQ7kNvwEvkKNI&_nc_oc=Adn-yxVJGlc3r-H-MefJGe9xaC9AARsEcZYm2ZY5UiThPNN_jeMq8rhEknz64ltQoFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfusM4_EHfTY7dWerCoNNtx4RHROk1bkLzhbmThr073QFw&oe=699D9395"}, {"file_name": "migrated_image.png", "id": "2702389736540478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl8c3D2VZ6wQ7kNvwF6tOtr&_nc_oc=AdlyaYSnv5_VTT6en_BFRXX_eOxx6-8ONYen2mZuVKaqb58mGrcWkoW5aDdy701r73U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBNbhKA95erACMrGN7FRhfOrxmBPr6FCBtsmc3JRRGnA&oe=699DA846"}, {"file_name": "migrated_image.png", "id": "197343111563672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5YCKuQheHEQ7kNvwHuA_dC&_nc_oc=AdlS_SYCor_3zJgCSVJB7eCD09XMPBGHb8CArE_GuX3PstB0OFCIVootvi2U3IAuNr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCYxGp3X9HRJGhRvflIfAXNewSiYw_bIwCjaBuuMSf5A&oe=699D9D0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacypolicy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315509250526538"}}]}, "scheduled_offers": {"count": 0, "nod
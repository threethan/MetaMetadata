180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_5RoWXTcTsQ7kNvwGcsa5V&_nc_oc=AdkC2Z72FvZJFDWlMHTGsTi-5-8gn98gi6w_iMFtNaomoNUVue1F2pH0Tx1UohONB0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBtxa70VbUZIl3qKKdG3dEfyvjkeae24bsN9-QJjRMig&oe=69999F15"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x3Qahl4y6sQ7kNvwGqNJI8&_nc_oc=AdlNIpsG8teEKjPZ3tNLPXaJBIOwE-XQCb3EmJd0yHjvh9RiGvyeg5RnwxEWCHZdpeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSkvUaDfYdbT1nttmP39HB7GkGXZT_FOsLYgFMgC2vbQ&oe=6999B3C6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4e5IvjdyqgQ7kNvwHiLZHx&_nc_oc=AdlMYja6-_0KdjfwzLDExNf9GjDBGZbdL9us-QD61JEqAJTTV2zmdVT8PB1q8MGtOtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvib2o2w1PeEuuUKTHSubGrOCODAqM5QZwffTgtY9qTGQ&oe=6999A88A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbl3CS7hX-gQ7kNvwGIl-9R&_nc_oc=AdkjqkUIlyu0eoa5bBzeeIzge-Rm37xT6cVFYOB17vGiBLlDVYusFYpO2hziNpGdIWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvticnGH3dTIYFGRs5Rp3TyqJBHpjXc6ZxUjdFRsDlBdA&oe=69999DD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1564074000, "lastRevision": {"nodes": [{"id": "887942918224190", "release_type": "SCHEDULED", "ad
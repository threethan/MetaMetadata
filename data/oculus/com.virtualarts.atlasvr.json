", "id": "1038815253153771", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXZJQOvz5TUQ7kNvwGf8AHL&_nc_oc=AdrMP1xeIX3zp0MWtAZeNkVGNBSWyy5tPWy7Z1kYM3GEko8roje6je_TtQx4pk8cJIY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfbzuJS_2OVTVSFB83kuDDYLI85GvCz8EbpY3uXhiHBQ&oe=6A859B95"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLNjOLSApaQQ7kNvwH0r8QQ&_nc_oc=AdrVxpUpx7xzZkE3-OCcbknvdIvCCpWJ-GAbEBFjY9Vw8Fms-IJaL4X_t1y1vgu4FpA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAMl15xA5eYUSxT--TFNxPirPEefC6o7o4aKoMOLxx5A&oe=6A857806"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OgywHouziEQ7kNvwEGir-T&_nc_oc=Ado4CfG1glppFdnphySgfsRfqNyY69VouCi1PwXzxFI03pEnDBPb08tCj-KFiiOBqOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8uczUeKOuIbDza8fFnlM4pH1zjxd1sTZNwXwB2iToTw&oe=6A85A50A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-0y2RKzoh4Q7kNvwGEraNy&_nc_oc=AdpNZ7_6cixNzdHsR3pI5Bb0w9uC3r0EALCFr2O8KZ4YxPrYF9g7recbB5Z9aqgFWfQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcZquy8tV9Oss8kl-ZOPnDjPpLFB_UVENE4O1vgAARKQ&oe=6A859A59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "
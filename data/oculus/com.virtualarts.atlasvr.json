1038815253153771", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3Co3urFvoAQ7kNvwFD0A6p&_nc_oc=AdpopESrXjG6wG5IqOzhjCPq0YyDAXmys9p0fzN7edQJ6suHhw4RrY3CzUzoCosnpoA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNp_iGFkTgvYDNCq_0ZLWbT-p9RplK44e0Pg8KvgxT8w&oe=6A917915"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQuFWzTrM-oQ7kNvwFM2gUN&_nc_oc=AdqgYmTkv9gVctFUwx_IB4HyhM41zNWJHoOcprtAXccngwXFV_kEu_NIyLMDvsCCJmI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0HvIPOFulua2PhzhuL5hTtc7j7cqOR9qbMa6lJoYK9Q&oe=6A918DC6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=far1czjmZ44Q7kNvwGWVepE&_nc_oc=AdqSkUYoNAMB9h_el6bavCpR1eRL38e1f8-KPB2v7YT--8dyWbmTjXz8ilcWpgg7z-s&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv3z-CndK7ohlMjfFuQKe80lw3RUHox0OSK_v6x9vrmA&oe=6A91828A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj1171SZFbwQ7kNvwH6fcAG&_nc_oc=AdqKMsEiOB5J7XQoEar3YcVl2D4i5laZt7B7kbWPpG941jXgsw5JpHZLjBqYV1nbk4I&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr0Np09Ef-8pQkCdUj9cQo0Zh7ZlMgGPmlwlRZw2mdng&oe=6A9177D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
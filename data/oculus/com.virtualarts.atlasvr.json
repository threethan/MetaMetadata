1038815253153771", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLXC7U_mVnUQ7kNvwFezB5I&_nc_oc=AdpkvmNpwguU0kTqycfMdhNOXKdg5Ct1Ee2sVu9YzmK7cz_VbLsiwZKi2DntFma2mn0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bmRFDhHjT4ZpRDDUEAXvAaKNWiaoAEYr66pHUE0fk5w&oe=6A09AE95"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNZgKmgTwR4Q7kNvwEIKfaF&_nc_oc=AdrpLXBoo7MWQ-oVIAFoUgAdRRAnAUxXSfRXc0-QL_M3YDdGIYa1sLBUyeIB2YAYvrs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hXN8y8N9mpoB2oOK6pTLX1slTn-9cdOFSRse98cAUQQ&oe=6A09C346"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Am5EjIIawpkQ7kNvwGzlQ8a&_nc_oc=AdojRCuDSWrqPU3KHkqG7HkWwDugGVf6B9XV3Rx_QT8aqHKgIvYcbK0CpVNYYF44JPg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f_BxByg4cVuCGuZPuvSxlwhX1uB289f7AvEvi-0Ygxw&oe=6A09B80A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZtDCSTVZdEQ7kNvwE-puzi&_nc_oc=AdoChBUMFjUw1zV8caZckEfqXGxNd5A_UXVG5nph3vjmrAURD5QhYwpy_tbuimBb7Ck&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tuSmeoOuePYSjRRmI_86tUbn4ixa0LYJc4yGdKZCf8w&oe=6A09AD59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxerVtjKg_AQ7kNvwHCSvly&_nc_oc=Adod3s4ONUwtSq3XD5KqM3VHSJ5-Z-UCp5_vmsL0hyK1FbjLYtwZ21KXLCexA_U0-C0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0smAWaEraQqWFNvEAgouiHqqzz9ZswkG9ngib5HaYZ8A&oe=69F0A215"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2QL3RkQU-AQ7kNvwFU2K-i&_nc_oc=Adqd3XyhH47W4pd21lUgzw7RhqGhBDQgjvkA4rZG1uviFTzhpVz8kTXqPUKYnvQCf_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2_baHWAzbYTCgiJGuTxcZNKVXu43k9ukYdkhsULmOrpg&oe=69F0B6C6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wERM24RwGAMQ7kNvwEdTTlK&_nc_oc=AdpRKOknzcKynYOew8lYQiY_u2ClvIg3zZfMLd5zXcEhS9GpSZQjp-l3dEKrtQ4mWeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af22sVaVAlU--hi2mU5zTSWRhe-x8Hp88NIqtWOiCxT8xQ&oe=69F0AB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5hjrtfTArQQ7kNvwHKFHwd&_nc_oc=AdoFwGqqPpKfP624edOBV3xy02o_miEbFfAaCC6P8jjdUrIrX6UtEAlJ_Ea-8cv78z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1WDoWjWvLWnloBNvRdpKRBvnEnHSWlFsqmYFL8DLHaXw&oe=69F0A0D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1564074000, "lastRevision": {"nodes": [{"id": "887942918224190", "release_type": "SCHEDULED", "ad
1038815253153771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRT36cHegoQQ7kNvwFFXiJy&_nc_oc=AdqjgTUwMcGLMMzMU4UrD-Q6EV1nIdmJKObqEVCOdoDYlySeH3bbIdtvYEKBNUUUw30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l8MYIJrZclttiqX4mh_g7HcdIuzbQ9jLV81d-gTn3LQ&oe=69D3A115"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtunBeDg2pkQ7kNvwE9AEKl&_nc_oc=AdoLbx3EEWCUvKAN2kdUqRZic6aLXCsd0TCxDvZv1pTfr1ochlcb9SXmMu-TWcvGx0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nDsJw08fBHY6ljUvYlGNLY4WqN4JylTE7xHr_LP_Eqw&oe=69D3B5C6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na0aaKkUwq8Q7kNvwHBLLuW&_nc_oc=AdqYiBTZmJuh4jP8gtA0CAa_h-gyw-Q7u-lkYwV6KXSlXU4kZKs-j_9xttepKzPCWvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E8Gr2CEAOU1LzKlyGKZveM4AuWA9K1hPXe1iYX8gLJw&oe=69D3AA8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PwybZ8X6xkQ7kNvwGgY81Q&_nc_oc=Adr4jHIMjQeh8VjTm6KKgRZA7rrk1tlTchWbMk__B_Cojj7YA5YKAcpy1lBqwRjJSKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cO7GSqiKeQJL9P6qOdR3F58lWBGZv-B-M2GFB2mQ6iA&oe=69D39FD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
1038815253153771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyo-bpgWyrkQ7kNvwEDXBi_&_nc_oc=Adrp4wjk-fVKs7Q4QT2CZ1AvjgRnw6wlpYAsn2XMYRNMTuNpGo9K86lRKogY1gk3fSU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19u65NtYny3o_X8u_auqfM79bleAXLiZbm4xfQYVxwGQ&oe=69F49695"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4p6oqBUvpEQ7kNvwHbDu_Y&_nc_oc=Adrwfpsxkrve81jjaqpj2pV8qbmlr_10g_FFn19m6wGQ-k0zw-6FDW2fnkxlM-sXLv4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D1YjHIOOuJBckrDS-MzD9oY6AuSByYxaMnMmOY7OdOg&oe=69F4AB46"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzlGhdhYfWsQ7kNvwHB0Z_-&_nc_oc=AdoefWXC7yl_8DOAcjQlpGo-cpIrXOt2ZLjskFhXO_c8SAJaGBio4zcEG8cWOtKDO10&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IGH8NCzEAFEzSVVIOLQPwXuGNRW_7bClyfvat8FIYfA&oe=69F4A00A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqe954aF1W4Q7kNvwHK86aE&_nc_oc=Adpc9ldCfseDl35tTijryoyal_eJ5wQFYdPb1YhoH42HqW6erZkQl3B50OmzWhMwrIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0q7dlFb60ts42K33rsr1CsucyChd5G4qJd1SMh3eOhvg&oe=69F49559"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "platform": "AN
ent-iad3-1.oculuscdn.com&oh=00_Af0r20HkA6Wjm5Ra2FVOF_l77lR3by4QdtajUa1gl2KpLA&oe=69F0C782"}, {"file_name": "migrated_image.png", "id": "303507947293075", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974902_2345452102361663_4075271158939779072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkjgZ66kMB4Q7kNvwFvpK1k&_nc_oc=AdovdyTt6rRyU6eP7nPGqlg1CXUV2JP3hWd-BMIcBF5A4z3BCbryufryLBqWNMZNWiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1qbQOZY7cOB5iOY-64GYATNqvmp4ehMhYLDkq34mc-Iw&oe=69F0AAAE"}, {"file_name": "migrated_image.png", "id": "198910648065030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxerVtjKg_AQ7kNvwHCSvly&_nc_oc=Adod3s4ONUwtSq3XD5KqM3VHSJ5-Z-UCp5_vmsL0hyK1FbjLYtwZ21KXLCexA_U0-C0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0smAWaEraQqWFNvEAgouiHqqzz9ZswkG9ngib5HaYZ8A&oe=69F0A215"}, {"file_name": "migrated_image.png", "id": "2702389736540478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2QL3RkQU-AQ7kNvwFU2K-i&_nc_oc=Adqd3XyhH47W4pd21lUgzw7RhqGhBDQgjvkA4rZG1uviFTzhpVz8kTXqPUKYnvQCf_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2_baHWAzbYTCgiJGuTxcZNKVXu43k9ukYdkhsULmOrpg&oe=69F0B6C6"}, {"file_name": "migrated_image.png", "id": "197343111563672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wERM24RwGAMQ7kNvwEdTTlK&_nc_oc=AdpRKOknzcKynYOew8lYQiY_u2ClvIg3zZfMLd5zXcEhS9GpSZQjp-l3dEKrtQ4mWeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af22sVaVAlU--hi2mU5zTSWRhe-x8Hp88NIqtWOiCxT8xQ&oe=69F0AB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacypolicy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315509250526538"}}]}, "scheduled_offers": {"count": 0, "nod
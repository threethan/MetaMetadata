 "id": "1038815253153771", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974487_691667844628624_7501772874865180672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFSxW05_-00Q7kNvwE3tKEj&_nc_oc=AdryFW4CnwBlK5KtQ34ozVHsnXA2LX4jWSOSQ_0UA8HxsSJhKT6FdwVwCQoBfuRkFXk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK21M47t3A8kvs1BvzZ09QkZelHay1m-7sCZ77AaQwZEA&oe=6AA96C55"}, {"file_name": "migrated_image.png", "id": "213335426571794", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982506_356045651763476_5914308758460170240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SWEn9H4IOEQ7kNvwF7Kri7&_nc_oc=Ado9SmG1IKABB3s8g4pKiD41vzZMNbmUhLixFFaETkuXu8N0kIkjuFWvYw6Lpx4kNBo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID9oKzjx6406lC3qxiojVwu1c5JJzrttYk0FCCIV3lhA&oe=6AA948C6"}, {"file_name": "migrated_image.png", "id": "1248875298643503", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031515_2820824637992848_7144217916920037376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hY8H-CimhwQ7kNvwFlzXAp&_nc_oc=AdowQ6fAVpPKuUQ-9G1tVa09Jmk1obylBRhnVompajQwElwFUeAFi6suWf56gQn1qLA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOvYyIXfBKJPGZY9kHVtBrtVWK8nM7QOTRSIcQWp_32Q&oe=6AA93D8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas VR", "keywords": ["space", "education", "planets", "edutainment", "earth"], "long_description": "VR has the potential to dramatically shift how teachers teach, but more importantly, how learners learn. Atlas VR educational game will take players into an immersive Virtual Reality experience where they can learn about both our planet Earth and the surrounding planets and solar system in an enjoyable and engaging experience. \n\nThe focus of the game will primarily centre on the Earth including its structure, atmosphere, topology, day and night cycle and the ozone layer. Players will also have the opportunity to learn about the Moon, the other planets in our solar system, Satellites, the Asteroid belt and the Sun.", "short_description": "Atlas VR takes explorers to space in this edutainment experience. \nLearn about our planet Earth and beyond via a fully narrated interactive \"hotspot\" system.\nPut your knowledge to the test in Quiz mode where you will be competing to get the gold medal!\nEnter Explore mode to view all planet visualisations and interactions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualarts.co.uk/privacy-policy", "developer_terms_of_service_url": "https://www.virtualarts.co.uk/privacypolicy", "publisher_name": "Virtual Arts Limited", "support_website_url": "https://www.virtualarts.co.uk/", "website_url": "https://www.virtualarts.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9549723858402999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974524_483192252481907_9033871650189213696_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFUnckUvtzUQ7kNvwEGUMOt&_nc_oc=AdrOZXj7wcO_-l9YPgvyQZBNkkToo0stpKY0Zarrgc2IB8iC33Hxbl4_7JKPtz_DwRg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlQD2E2NpgxAokroXSmSvi63Jp9lWSpIqsTU750L3HwA&oe=6AA96B19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas VR", "pl
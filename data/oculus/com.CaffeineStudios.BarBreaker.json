=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSojusRx1nxFHmi470kk-SuzzIp8Sq20wtk7_cuwwCftA&oe=6B0B1481"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bar Breaker", "keywords": ["VRdestruction", "smashroom", "rageroomVR", "breakobjects", "barbreaker"], "long_description": "Step into Bar Breaker, a chaotic VR destruction game set inside a neon bar made for smashing, throwing, and breaking.\nGrab objects, swing a bat, use the pistol, and wreck the room piece by piece. Bottles shatter, crates break apart, tables crash, barrels explode, and the bar becomes your personal VR smash room. Every hit is built around hands-on virtual reality interaction, giving you the freedom to cause damage your own way.\nWhether you want a quick stress-busting session or a simple physics playground, Bar Breaker gives you a satisfying place to smash objects without rules, cleanup, or consequences.\nFeatures:\nImmersive VR bar destruction gameplay\nBreakable bottles, crates, tables, and barrels\nBat and pistol interaction\nPhysics-based smashing and throwing\nExplosive barrel destruction\nBackground music and SFX volume controls\nBuilt for Meta Quest VR play", "short_description": "Smash bottles, crates, tables, and barrels in a physics-driven VR bar. Grab a bat or pistol, break everything, and enjoy chaotic Quest destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/bar-breaker-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
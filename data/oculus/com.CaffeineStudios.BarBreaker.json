DPkc1GIGRTkXZb_xQQz0WdPe7iQWDtj2p6nQpaPvNm2do-X_GGNeZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJMF-PLeAXD97gTQHzG05nDjOAygHV23j5Tpu5_1uN-Q&oe=6AA2CD44"}, {"file_name": "ChatGPT Image Aug 1, 2026, 06_10_09 PM (2).png", "id": "1365362461713418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829689_1365362465046751_8267517288866433486_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhsZmURfrrIQ7kNvwHEB5O8&_nc_oc=Adqr1DluRkRglOW2SI0fMg4WOD2F903IgDLLMz73SkfDQgUWwFy1XYmd2VCota591cY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBYrXHnId1SsCOiV1xuJSOT4HPeMxVtZbbFIEXkVps0Q&oe=6AA2C7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image Aug 1, 2026, 06_24_44 PM (3).png", "id": "932892549846668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507833663_932892553180001_5080494305098137541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNgqcYNTHNAQ7kNvwF3laSe&_nc_oc=AdrVP4EHbxpab44vcac5jpINi8trZ7-Ajggiz65xBIIkXo528W_Db6BYhf44VZBrxYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSFe28EgGw5dbK2yYCcsPCTmNDYAO2tWe7dHcWE15SWg&oe=6AA2D473"}, "display_name": "Bar Breaker", "keywords": ["VRdestruction", "smashroom", "rageroomVR", "breakobjects", "barbreaker"], "long_description": "Step into Bar Breaker, a chaotic VR destruction game set inside a neon bar made for smashing, throwing, and breaking.\nGrab objects, swing a bat, use the pistol, and wreck the room piece by piece. Bottles shatter, crates break apart, tables crash, barrels explode, and the bar becomes your personal VR smash room. Every hit is built around hands-on virtual reality interaction, giving you the freedom to cause damage your own way.\nWhether you want a quick stress-busting session or a simple physics playground, Bar Breaker gives you a satisfying place to smash objects without rules, cleanup, or consequences.\nFeatures:\nImmersive VR bar destruction gameplay\nBreakable bottles, crates, tables, and barrels\nBat and pistol interaction\nPhysics-based smashing and throwing\nExplosive barrel destruction\nBackground music and SFX volume controls\nBuilt for Meta Quest VR play", "short_description": "Smash bottles, crates, tables, and barrels in a physics-driven VR bar. Grab a bat or pistol, break everything, and enjoy chaotic Quest destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/bar-breaker-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1273492292512714"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312236_4515514752025387_1249572539224628717_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX_6oMcDkPMQ7kNvwHkW_xS&_nc_oc=AdqBykknsbaBtCbbIohp7zki3BGQqQ1q1Ni4-ClJI_FCRRUhke9DoX0ilFPjBqgZDVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl57xRZsNw25XN-OlDgCga-iM15MGvtFV22ulPNom7Jw&oe=6AA2BD7B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bar Breaker", "platform": "ANDROID_6DOF", "co
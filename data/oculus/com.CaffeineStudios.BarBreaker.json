at=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB9kwNUyAzwQ7kNvwG3aOxz&_nc_oc=AdqJY9D0WK6lFHWUgNrmVZ7PWeW8_0eP0zqVdxlSCLYToHbTZAdNCM6svuedonqQbDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrSMW09OcWDr0je4VVSYaXHYjfmc8d4ebCDO8fBZZIyg&oe=6AC3B065"}, {"file_name": "ChatGPT Image Jun 15, 2026, 02_54_19 PM (3).png", "id": "2409481669534962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_2409481672868295_8335742190161195248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC9dAANdzrsQ7kNvwEZQFYh&_nc_oc=Adp9HDDZNUjpNAhzbltIAofzIM_gZFUdE2YuiXsqfIORcYQpUPejiwsSyFDH7jomusQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo4BxOVpAxbf9ENzHzU9gG84sCXgNDvTKkyrN-wpIlvg&oe=6AC3CBAA"}, {"file_name": "ChatGPT Image Jun 15, 2026, 02_54_19 PM (2).png", "id": "1021245190371171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_1021245193704504_7859790769274316505_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nEOSgr5DYMQ7kNvwF3gSRu&_nc_oc=AdqgxCHaap9uyW_SuRmwpJ9HnaC2MbyFij11koONX1RM1Yzc3f17WAE4gSwThUChrRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIHg3XXsd9GVJ1ZTTHAZ14Q5wN6-WxjxtKqS42Tpyr9w&oe=6AC3AB41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bar Breaker", "keywords": ["VRdestruction", "smashroom", "rageroomVR", "breakobjects", "barbreaker"], "long_description": "Step into Bar Breaker, a chaotic VR destruction game set inside a neon bar made for smashing, throwing, and breaking.\nGrab objects, swing a bat, use the pistol, and wreck the room piece by piece. Bottles shatter, crates break apart, tables crash, barrels explode, and the bar becomes your personal VR smash room. Every hit is built around hands-on virtual reality interaction, giving you the freedom to cause damage your own way.\nWhether you want a quick stress-busting session or a simple physics playground, Bar Breaker gives you a satisfying place to smash objects without rules, cleanup, or consequences.\nFeatures:\nImmersive VR bar destruction gameplay\nBreakable bottles, crates, tables, and barrels\nBat and pistol interaction\nPhysics-based smashing and throwing\nExplosive barrel destruction\nBackground music and SFX volume controls\nBuilt for Meta Quest VR play", "short_description": "Smash bottles, crates, tables, and barrels in a physics-driven VR bar. Grab a bat or pistol, break everything, and enjoy chaotic Quest destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/bar-breaker-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1188358624359415"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1851401452960631"}, {"status": "PUBLISHED", "id": "1860285328274044"}, {"status": "PUBLISHED", "id": "2222483065233323"}, {"status": "PUBLISHED", "id": "1046318007972358"}, {"status": "PUBLISHED", "id": "4000282976931704"}]}, "baseline_offer": {"id": "1851401452960631"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790668740, "status": "PUBLISHED", "id": "1851401452960631"}]}, "liveChannel": {"n
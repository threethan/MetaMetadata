sh room. Every hit is built around hands-on virtual reality interaction, giving you the freedom to cause damage your own way.\nWhether you want a quick stress-busting session or a simple physics playground, Bar Breaker gives you a satisfying place to smash objects without rules, cleanup, or consequences.\nFeatures:\nImmersive VR bar destruction gameplay\nBreakable bottles, crates, tables, and barrels\nBat and pistol interaction\nPhysics-based smashing and throwing\nExplosive barrel destruction\nBackground music and SFX volume controls\nBuilt for Meta Quest VR play", "short_description": "Smash bottles, crates, tables, and barrels in a physics-driven VR bar. Grab a bat or pistol, break everything, and enjoy chaotic Quest destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/bar-breaker-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeines Production", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1188358624359415"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1860285328274044"}, {"status": "PUBLISHED", "id": "2222483065233323"}, {"status": "PUBLISHED", "id": "1046318007972358"}, {"sta
58_3176296113550652080_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS8sf15dyasQ7kNvwGrl_Wm&_nc_oc=AdoGZTc7ZFiuv4w70tMK5wahF0Yw8DYSds17QOIDI0k58DybgfNTaEctzAkXvZ00CE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIksWcxTczC-RltP5BvnlpvZxXgePGN3bkJBL_2zKYhcw&oe=6AB92D30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Terra tag.", "keywords": [], "long_description": "Can you handle the ground? Terra Tag brings intense, high-speed movement to your VR headset. Using a highly polished physics system, you\u2019ll need to use the environment to your advantage to avoid being tagged.\n\nSwing from branches, wall-bounce off cliffs, and use the \"Terra\" to find the perfect escape route. With a focus on smooth performance and community-driven updates, Terra Tag is the new home for fans of physics-based action.", "short_description": "My game is a fun gtag copy so GO PLAY IT!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/terratagpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT", "support_website_url": null, "website_url": "https://sites.google.com/view/terratagofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33110992768543907"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_a
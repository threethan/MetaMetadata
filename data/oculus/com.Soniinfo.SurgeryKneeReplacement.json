56800_1966870200348082_584234346435987382_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2a88obA2nYQ7kNvwG-0fJ1&_nc_oc=Adr4Psxme_5GHejBA_f6Ghhmv5xYD4MR2gPwLYIfhOvFga8MFirwVoiq-tTQ34WhAVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCb847qbUpN2XeA26Z0XynEAy0xp9tQ94-fp81tNxsIQ&oe=6ADCD56A"}, {"file_name": "resize screen shot  3.png", "id": "887647619564315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035303_887647622897648_9160694001347504503_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NslGQqlvhFsQ7kNvwHPyRiL&_nc_oc=AdpvUJAwmTi3DgT3W1_UvQjzW1YlrHMJHbDmnm-XjQN36kf50IkqRVFEH_Szn72XgV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEMPjUjgY0BsDRbnBLKOpNsFpkm_4e_66HYrX--f_p4g&oe=6ADCD6E0"}, {"file_name": "resize screen shot  4.png", "id": "1391417571461753", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422386_1391417574795086_1652313951427473006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mwbRcyw5TIQ7kNvwGph0cl&_nc_oc=Adq6D0A_YEL0nBSP9pqIZLu8KdOUTR7ddCuN0BmsC-8yCp_9A3Lb4XSUNf_KDEG63Pw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7i2QoNygXEl0AOB-OtkxL9tBpFt0RfJHOLliPxWxqew&oe=6ADCB3AD"}, {"file_name": "resize screen shot 5.png", "id": "729057732390145", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_729057735723478_8556230911738693952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoiqFbqcja4Q7kNvwHTUTOc&_nc_oc=AdqXreNDWirU1z6RVJBXEs24_6yGDuWEKm_sWE_KHVQtLCg-NmoZEf2tz1-UDAooGlU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVdzynCJqRuUTEeMlUdF4nvcyy3sUjfq6zja4DMHVEQ&oe=6ADCB915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resize cover image.png", "id": "262344213456544", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036617_262344216789877_181245506863688938_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK-UaagNd1UQ7kNvwEO8j_0&_nc_oc=AdqfdNfIKMg2RwlwggKpdfbNQn_B5GkHb3nT5Qg0StpZ6v6qKWuphJH-iXJE_V9VBac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6tOIfCo8ElrVqc8444JKTSkooU07Fi962gjUEPTzHwg&oe=6ADCB6E6"}, "display_name": "Surgery : Knee Replacement Simulation", "keywords": [], "long_description": "\"Step into the operating room of the future with our ground breaking VR game for Meta VR. In this immersive experience, you'll become a skilled surgeon, specializing in knee surgery. Our meticulously crafted game offers a captivating blend of education and entertainment.\n\nExplore the intricacies of knee anatomy in stunning 3D detail, from ligaments to cartilage. Feel the weight of responsibility as you prepare for various knee surgeries, including ACL reconstruction, meniscus repair, and total knee replacement.\n\nAs you don the virtual gloves of a surgeon, you'll wield a wide array of realistic surgical instruments, each with lifelike haptic feedback. Perform procedures with precision, learning and perfecting your techniques as you go.\n\nBut it's not just about surgery \u2013 it's about learning and mastery. Engage in comprehensive tutorials to understand the nuances of each surgical approach. Test your skills in challenging scenarios that mimic real-life surgical dilemmas. Your performance will be scored, helping you track your progress and improve your abilities.\n\nBeyond the surgical suite, immerse yourself in the entire medical ecosystem. Review patient histories, diagnostic data, and collaborate with a virtual medical team to make informed decisions. Experience the thrill of saving virtual lives while advancing your surgical career.\nOur game isn't just for aspiring surgeons; it's for anyone curious about the intricate world of knee surgery. It's a valuable educational game.", "short_description": "Experience the future of knee surgery in our immersive VR game. Perform precise procedures, learn surgical techniques, and save virtual patients. Explore realistic anatomy and surgical tools in a game designed for both education and entertainment. Available now on Meta VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/dbfd2486-8af7-4b24-85e1-468b83fcfa18", "developer_terms_of_service_url": null, "publisher_name": "Soni Info", "support_website_url": null, "website_url": "https://soniinfo.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6781259848657841"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1340289761405631"}, {"status": "PUBLISHED", "id": "2872984882859370"}, {"status": "PUBLISHED", "id": "412451601510563"}, {"status": "PUBLISHED", "id": "649384900669579"}]}, "baseline_offer": {"id": "2872984882859370"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1340289761405631"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7990939131023234", "version": "1.2.2"}, "id": "6797113553641528", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6387518998031930", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7990939131023234"}, "release_sta
_name": "resize screen shot  3.png", "id": "887647619564315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035303_887647622897648_9160694001347504503_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NslGQqlvhFsQ7kNvwHPyRiL&_nc_oc=AdpvUJAwmTi3DgT3W1_UvQjzW1YlrHMJHbDmnm-XjQN36kf50IkqRVFEH_Szn72XgV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEMPjUjgY0BsDRbnBLKOpNsFpkm_4e_66HYrX--f_p4g&oe=6ADCD6E0"}, {"file_name": "resize screen shot  4.png", "id": "1391417571461753", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422386_1391417574795086_1652313951427473006_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mwbRcyw5TIQ7kNvwGph0cl&_nc_oc=Adq6D0A_YEL0nBSP9pqIZLu8KdOUTR7ddCuN0BmsC-8yCp_9A3Lb4XSUNf_KDEG63Pw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7i2QoNygXEl0AOB-OtkxL9tBpFt0RfJHOLliPxWxqew&oe=6ADCB3AD"}, {"file_name": "resize screen shot 5.png", "id": "729057732390145", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_729057735723478_8556230911738693952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoiqFbqcja4Q7kNvwHTUTOc&_nc_oc=AdqXreNDWirU1z6RVJBXEs24_6yGDuWEKm_sWE_KHVQtLCg-NmoZEf2tz1-UDAooGlU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVdzynCJqRuUTEeMlUdF4nvcyy3sUjfq6zja4DMHVEQ&oe=6ADCB915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER  IMAGE .png", "id": "473965298770592", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982653_473965302103925_3752580428625802187_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gYIWQDdMRAQ7kNvwFwqIso&_nc_oc=AdqbakvHirwlKkSbFWl2Nybs9uDQ2Mw1_KT60CytjvYC46jvn2e3VVQyLJMEt0untF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCeXqgJ2kWnH6SlXw_HPdIxTK_3N_0nOZp1yjcugzDjA&oe=6ADCBA05"}, "display_name": "Surgery", "keywords": [], "long_description": "\"Step into the operating room of the future with our ground breaking VR game for Meta VR. In this immersive experience, you'll become a skilled surgeon, specializing in knee surgery. Our meticulously crafted game offers a captivating blend of education and entertainment.\n\nExplore the intricacies of knee anatomy in stunning 3D detail, from ligaments to cartilage. Feel the weight of responsibility as you prepare for various knee surgeries, including ACL reconstruction, meniscus repair, and total knee replacement.\n\nAs you don the virtual gloves of a surgeon, you'll wield a wide array of realistic surgical instruments, each with lifelike haptic feedback. Perform procedures with precision, learning and perfecting your techniques as you go.\n\nBut it's not just about surgery \u2013 it's about learning and mastery. Engage in comprehensive tutorials to understand the nuances of each surgical approach. Test your skills in challenging scenarios that mimic real-life surgical dilemmas. Your performance will be scored, helping you track your progress and improve your abilities.\n\nBeyond the surgical suite, immerse yourself in the entire medical ecosystem. Review patient histories, diagnostic data, and collaborate with a virtual medical team to make informed decisions. Experience the thrill of saving virtual lives while advancing your surgical career.\nOur game isn't just for aspiring surgeons; it's for anyone curious about the intricate world of knee surgery. It's a valuable educational game.", "short_description": "Experience the future of knee surgery in our immersive VR game. Perform precise procedures, learn surgical techniques, and save virtual patients. Explore realistic anatomy and surgical tools in a game designed for both education and entertainment. Available now on Meta VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/dbfd2486-8af7-4b24-85e1-468b83fcfa18", "developer_terms_of_service_url": null, "publisher_name": "Soni Info", "support_website_url": null, "website_url": "https://soniinfo.com/", "category": null, "
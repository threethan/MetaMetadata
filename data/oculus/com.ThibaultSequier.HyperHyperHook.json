3743502802_3128658097028376677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQESFK8fZ68Q7kNvwEYtdty&_nc_oc=AdoDKVbyCvBQfyQGa1QvGrlBrGHysur_qlvYRphuJGMojVNH5KKSfQYVHS97ZZN6dyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAor5UixnOb_BC4PAwsgKrnKYUJ2deGLy1wHE0MWS3Pbg&oe=6A5A2DEB"}, {"file_name": "Screenshot_4.png", "id": "847147138490669", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823485_847147141824002_5458776361512879106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azy3GW1orgsQ7kNvwEf5mXU&_nc_oc=AdrtCJMuMS1veDFWMjiLzNimPr1_OSJFMuNhZbnehnkopnAIonNI_1H6zRUFTHgdeDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZBC3iFnmUDqHVd7KwNjCWXQmcZwpsbqUhEoE1mCgQgQ&oe=6A5A3D5D"}, {"file_name": "Screenshot_5.png", "id": "1169509881820845", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823812_1169509888487511_2005479036638144061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI-YgCHpTEUQ7kNvwHWjtpf&_nc_oc=Adq8wyDWllRabs99e2s0BFS5HZSjauXqL6ekBUtjZBV4ZaKu-GWqildkwCTQuCQ04l8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALbn5xIlEBj1IcSFm3Yqjy7DxGuVhR7ls56mPo3HnnaQ&oe=6A5A1EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1287942493103522", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295272_1287942496436855_2303317854550347614_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP3vTmcXgTAQ7kNvwEdz2tc&_nc_oc=AdrUNe3mmTIyE8M3RugEGON0-YUAVEELkJjRTJ-OkYglYrM-NyZMgRAjzpSy0sh5aRU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoeygKgY_Qt-TH-WlghxRzZXlVe850u8ow_XlVqg9gPg&oe=6A5A23FA"}, "display_name": "Hyper Hyper Hook", "keywords": ["Hook", "Grappling", "swing", "hyperhook", "HyperHyperHook"], "long_description": "# Natural Hook & Swing mechanic\nPolished and easy to learn swing mechanics, giving you the true feel of freedom of movement. \nThe true competitor, however, will be those who truly master their hooks!\n\n# Customization\nChose your look from a library of free cosmetics with a ton of colors to chose from, or find a pack you love for a unique twist on your style!\n\n# Social fun\nJoin a lobby with strangers, or create you own for you and your friends! Voice chat is included!\n\n# Compete\nWhenever you want, you can participate in the 1 minute high-octane Orb Hunt that happens every 2 minutes on the map! Will you be able to reach the top score? \n\n\n  \n{853690867027036}", "short_description": "Hook, swing and compete with friends (and other players!) in this high speed free roam grappling hook game!  "}]}, "developer_name": "Thibault", "developer_privacy_policy_url": "https://thibault-seq.github.io/HHHookWebPage/Privacy-Policy.html", "developer_terms_of_service_url": "https://thibault-seq.github.io/HHHookWebPage/Therms-of-Service.html", "publisher_name": "Thibault", "support_website_url": null, "website_url": "https://thibault-seq.github.io/HHHookWebPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32977369581876420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296069_1351281746516924_3014959131991129092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLVA3mFhSLkQ7kNvwFlWuzX&_nc_o
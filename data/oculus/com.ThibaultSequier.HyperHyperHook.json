3743502802_3128658097028376677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSa3EUqltcwQ7kNvwFYeNAh&_nc_oc=AdozRyRPKHAz9B2V8yOubfNwR2Hd1QdPJJSMa_MzHgqLDHBKAGUteKZiM6bJmLRC2a0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X-jQXirirYgX-LKQFC9mqp3gb-UkFnJgUZR6O4SS2SQ&oe=6A217D6B"}, {"file_name": "Screenshot_4.png", "id": "847147138490669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823485_847147141824002_5458776361512879106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_WSYF_mUfMQ7kNvwFMD72K&_nc_oc=AdqFf06NW5vyEFrCCKEf3aDIpqDl0DYV-HmiVcIYa4c1uwlSIvZ52xNetVM70qPqeSc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DljAyKB0tq7y9m7K83LVXKISb3172-gEL0KOPFGiHHg&oe=6A218CDD"}, {"file_name": "Screenshot_5.png", "id": "1169509881820845", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_1169509888487511_2005479036638144061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gigi5psvPGEQ7kNvwF_N5FL&_nc_oc=AdrMW6gm7IPIEyBh6dozERjPemXoEvkCiG1MGQSG7pV4mbF6A1JVIkJLXRoHZh6NnXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HdF1qeT03st5jGRFofZS56hWAo5oxZ7_gM6F0-yZSTw&oe=6A21A6A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1287942493103522", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295272_1287942496436855_2303317854550347614_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JiMRzse4LEQ7kNvwEpgARV&_nc_oc=Adpdtr6h_hq53drN4lg3r_S4xg2iLiCeXa--v_MGFI3m_N50d_tjC0UH4OG8RnoQSeM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o09W_FsCv-PjDA9YBI5Qx9HHqqnfZZKqCS2vtKiT3Uw&oe=6A21737A"}, "display_name": "Hyper Hyper Hook", "keywords": ["Hook", "Grappling", "swing", "hyperhook", "HyperHyperHook"], "long_description": "# Natural Hook & Swing mechanic\nPolished and easy to learn swing mechanics, giving you the true feel of freedom of movement. \nThe true competitor, however, will be those who truly master their hooks!\n\n# Customization\nChose your look from a library of free cosmetics with a ton of colors to chose from, or find a pack you love for a unique twist on your style!\n\n# Social fun\nJoin a lobby with strangers, or create you own for you and your friends! Voice chat is included!\n\n# Compete\nWhenever you want, you can participate in the 1 minute high-octane Orb Hunt that happens every 2 minutes on the map! Will you be able to reach the top score? \n\n\n  \n{853690867027036}", "short_description": "Hook, swing and compete with friends (and other players!) in this high speed free roam grappling hook game!  "}]}, "developer_name": "Thibault", "developer_privacy_policy_url": "https://thibault-seq.github.io/HHHookWebPage/Privacy-Policy.html", "developer_terms_of_service_url": "https://thibault-seq.github.io/HHHookWebPage/Therms-of-Service.html", "publisher_name": "Thibault", "support_website_url": null, "website_url": "https://thibault-seq.github.io/HHHookWebPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32977369581876420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296069_1351281746516924_3014959131991129092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACW90-hiHxYQ7kNvwFB_A71&_nc_o
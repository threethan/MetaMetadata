3743502802_3128658097028376677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp1iyEVdoxkQ7kNvwG6rZpJ&_nc_oc=AdryhB8nEFHAzlwE9DiQqsQMkkg9QLu3ublLhEqsSeLeoKvOnzRvZ8hOb-IOZK555vc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE9pkQkkv_FGQZu7QnQN4_KXkH0OHkavc8hz8I_aYrqg&oe=6A68AE6B"}, {"file_name": "Screenshot_4.png", "id": "847147138490669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823485_847147141824002_5458776361512879106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71V_liAA2jIQ7kNvwHgJrNb&_nc_oc=Adq81qx-XngEhw4yhBUKMsO3biwmhRQu6GWhv7QmkyP0j9S6pnNhZ81ydNF2R_CtdOo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArS2z57XgSpm5979WNYJay2E_WcgOjgADDLSHcmMS7mA&oe=6A68BDDD"}, {"file_name": "Screenshot_5.png", "id": "1169509881820845", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1169509888487511_2005479036638144061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8Qi2hZJND8Q7kNvwEz_GGE&_nc_oc=AdoxCfTEt2Do2JLLpPqcZ9Raow518AH9LUhH8ceKPrwUZV1WpH7is7lxBpNxclhrG3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8uaXd_jrt0jfxK8DukA4wFRXkf43jH08yWMxa1j1GyQ&oe=6A689F69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1287942493103522", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295272_1287942496436855_2303317854550347614_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqBKpHkjA2EQ7kNvwF8XXQG&_nc_oc=AdrUXfv0ZKO3S6J2jdwN-7FPilTnkpPDauZeplz_NbRdAik0aF23usF5TsG99iXVFFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz4RUr3-k-YzgpHY1FLyK83Oqyw-YQNkw6z8U0JXdIXw&oe=6A68A47A"}, "display_name": "Hyper Hyper Hook", "keywords": ["Hook", "Grappling", "swing", "hyperhook", "HyperHyperHook"], "long_description": "# Natural Hook & Swing mechanic\nPolished and easy to learn swing mechanics, giving you the true feel of freedom of movement. \nThe true competitor, however, will be those who truly master their hooks!\n\n# Customization\nChose your look from a library of free cosmetics with a ton of colors to chose from, or find a pack you love for a unique twist on your style!\n\n# Social fun\nJoin a lobby with strangers, or create you own for you and your friends! Voice chat is included!\n\n# Compete\nWhenever you want, you can participate in the 1 minute high-octane Orb Hunt that happens every 2 minutes on the map! Will you be able to reach the top score? \n\n\n  \n{853690867027036}", "short_description": "Hook, swing and compete with friends (and other players!) in this high speed free roam grappling hook game!  "}]}, "developer_name": "Thibault", "developer_privacy_policy_url": "https://thibault-seq.github.io/HHHookWebPage/Privacy-Policy.html", "developer_terms_of_service_url": "https://thibault-seq.github.io/HHHookWebPage/Therms-of-Service.html", "publisher_name": "Thibault", "support_website_url": null, "website_url": "https://thibault-seq.github.io/HHHookWebPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32977369581876420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296069_1351281746516924_3014959131991129092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Aw4OKU3-gQ7kNvwE7t7Vc&_nc_o
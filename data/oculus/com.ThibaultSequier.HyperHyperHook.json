3743502802_3128658097028376677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_daqIyzPidoQ7kNvwF9oQ6O&_nc_oc=AdrlUVnLE-diiOupZqyk-_B7h29AJUNXD42R6qHvvmxo1WnbcR7Y-z2RjPPiCNFPaHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA4tdQRWIu4j-PrDTjbM-gMV5B9muaQgdnyUAiY1SHnA&oe=6A8700EB"}, {"file_name": "Screenshot_4.png", "id": "847147138490669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823485_847147141824002_5458776361512879106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wODjNNCJccQ7kNvwF-6JJV&_nc_oc=AdrAU5Gl-b2dY1kNQ0-u7w8O2p6JwON7UVjltGXSqlR83Gt83-d6bCQ-WjaHjEQOxX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcWIpWYSIInk0B3iKy0nBgsdcW-z9XeDx10dvoOeTkiQ&oe=6A86D81D"}, {"file_name": "Screenshot_5.png", "id": "1169509881820845", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_1169509888487511_2005479036638144061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGBRYMCpTb8Q7kNvwE6z74I&_nc_oc=Ado-zh3qsDma7bMkctPHWPuCLiX88mIgoUeAzN7NWERINfENsDx0zu3Sqyzjp1Q19V4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwM29lv0goBVd3myp-jv1DfGu4TpX7Ks-kC0EIamkyiw&oe=6A86F1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1287942493103522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295272_1287942496436855_2303317854550347614_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U85bbjIM7kQ7kNvwGp0ocH&_nc_oc=Adp7tqVnhJSERUJbslGAOP7q6PbI6fm9Fcag_6wJb5TgZ8dAR8fp1V3Cj42wt23M4T0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkuThCYJTkPdRJz50UpQaiEPU_HLOkITowVfpgOLP3lA&oe=6A86F6FA"}, "display_name": "Hyper Hyper Hook", "keywords": ["Hook", "Grappling", "swing", "hyperhook", "HyperHyperHook"], "long_description": "# Natural Hook & Swing mechanic\nPolished and easy to learn swing mechanics, giving you the true feel of freedom of movement. \nThe true competitor, however, will be those who truly master their hooks!\n\n# Customization\nChose your look from a library of free cosmetics with a ton of colors to chose from, or find a pack you love for a unique twist on your style!\n\n# Social fun\nJoin a lobby with strangers, or create you own for you and your friends! Voice chat is included!\n\n# Compete\nWhenever you want, you can participate in the 1 minute high-octane Orb Hunt that happens every 2 minutes on the map! Will you be able to reach the top score? \n\n\n  \n{853690867027036}", "short_description": "Hook, swing and compete with friends (and other players!) in this high speed free roam grappling hook game!  "}]}, "developer_name": "Thibault", "developer_privacy_policy_url": "https://thibault-seq.github.io/HHHookWebPage/Privacy-Policy.html", "developer_terms_of_service_url": "https://thibault-seq.github.io/HHHookWebPage/Therms-of-Service.html", "publisher_name": "Thibault", "support_website_url": null, "website_url": "https://thibault-seq.github.io/HHHookWebPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32977369581876420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296069_1351281746516924_3014959131991129092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrk6MP5z7HcQ7kNvwHncExg&_nc_o
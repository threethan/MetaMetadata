3743502802_3128658097028376677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMRPcGrGx-UQ7kNvwEchzLi&_nc_oc=AdpfIPuM9SbBPFIsNTOKeeGAZjwTFA3HnSBPoFs3z3Z4PqIr2kmsfj9Gknil3O593-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOKXTS8LAZ_phJyUeDmZLXmyOh0WbLkBZN9WsJdfSWfg&oe=6A64B9EB"}, {"file_name": "Screenshot_4.png", "id": "847147138490669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823485_847147141824002_5458776361512879106_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Z8pyg4_5oQ7kNvwFyeCS_&_nc_oc=Adpy5TjmlgeE8SjFuYw9lp_hYBvFiILlc3A2gsX7mstLMPXowDLhOqeQu2hqwHrX5Fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6oM0Lz9B7sSCQviV1HCimCEF5mz_AnW__cLrhS-c_Sg&oe=6A64C95D"}, {"file_name": "Screenshot_5.png", "id": "1169509881820845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1169509888487511_2005479036638144061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZl-M8bhHlgQ7kNvwErYFkF&_nc_oc=AdrXUUvtRdmxD4qGCvI05zEnUG7N8xkF4mwhtWYDXR6Ze-3F8nRRvTZSw_qLkwFPABQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA234KOH3JVdZQoQ2M6IqGl6bGnnD_1d6xIABPS3fmBPw&oe=6A64AAE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1287942493103522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295272_1287942496436855_2303317854550347614_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j43xUTPVMc8Q7kNvwFmGs-6&_nc_oc=Adpm1NeCxvxndbIJot0q5H4mwVpcfFpdHMOgqSxjAoCtpYn8uBM7xyvTSRp1_iVjNl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIgtePiuyIyI3lUsxidSwL8oY-dci3oGfA8v9jVk3KWA&oe=6A64AFFA"}, "display_name": "Hyper Hyper Hook", "keywords": ["Hook", "Grappling", "swing", "hyperhook", "HyperHyperHook"], "long_description": "# Natural Hook & Swing mechanic\nPolished and easy to learn swing mechanics, giving you the true feel of freedom of movement. \nThe true competitor, however, will be those who truly master their hooks!\n\n# Customization\nChose your look from a library of free cosmetics with a ton of colors to chose from, or find a pack you love for a unique twist on your style!\n\n# Social fun\nJoin a lobby with strangers, or create you own for you and your friends! Voice chat is included!\n\n# Compete\nWhenever you want, you can participate in the 1 minute high-octane Orb Hunt that happens every 2 minutes on the map! Will you be able to reach the top score? \n\n\n  \n{853690867027036}", "short_description": "Hook, swing and compete with friends (and other players!) in this high speed free roam grappling hook game!  "}]}, "developer_name": "Thibault", "developer_privacy_policy_url": "https://thibault-seq.github.io/HHHookWebPage/Privacy-Policy.html", "developer_terms_of_service_url": "https://thibault-seq.github.io/HHHookWebPage/Therms-of-Service.html", "publisher_name": "Thibault", "support_website_url": null, "website_url": "https://thibault-seq.github.io/HHHookWebPage/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "32977369581876420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296069_1351281746516924_3014959131991129092_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uE8KkY21hwQ7kNvwEhXtW6&_nc_o
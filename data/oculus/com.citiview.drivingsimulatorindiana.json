1_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLzUIS7bD50Q7kNvwF9cSkx&_nc_oc=Adpb1jq14eB1dF6vGL-5V4cm_zmYEu8_fJVqdEu4CwilqSYE3oM9PqpfutpWf7SHGq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScYrfhQlRayLmiIkYXV-N66CbkDegs6txWiqZI1y-F6Q&oe=6AFDE23E"}, {"file_name": "screenshot_4.png", "id": "1118017907281925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1118017913948591_7611514633037392077_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MQezbX31RsQ7kNvwErmww4&_nc_oc=Adr9_tRnkUxvgl_8J67GDz-yjgabe26XMpka-y_fBBlLYRTXwoNc1MdbWGUjsy4EL8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5vLMIHBFWjKIFszrbEmn-HyGfvs_rWVKRfC3jdCzVTA&oe=6AFDCC14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1782757612777110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1782757616110443_2478057149186062798_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMuTZDPlefYQ7kNvwHtR1Yi&_nc_oc=Adqh4AqPz1TrzZuYS4csHF-9ed2Hp1Q4jqJmS8n9sCLJXnFuLy_BLiCoafXJe-OAPKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSbptyRvy9CudpiVsmYvpF6tm9cIitnZS1w4uX8y0vUg&oe=6AFDBE5A"}, "display_name": "Driving Simulator Indiana", "keywords": ["driving", "car", "simulator", "indiana", "racing"], "long_description": "The dream drive, from the driver's seat - through Indianapolis.\n\nYOUR GARAGE\nStart in a luxury three-car garage with a supercar either side of you. Touch the throttle and the door lifts.\n\nTWO RACE CARS\nChoose your car in the garage: the blue-interior race car with a deep-dish suede wheel and a billet shift knob, or the red-interior original. Both have a V12, a race cockpit, bucket seats, shift lights and a live display.\n\nDRIVE WITH YOUR HANDS\nGrip the wheel, work the gear stick and pull the handbrake with your controllers - or put them down and drive with your bare hands.\n\nA REAL 6-SPEED MANUAL\nRev it to the shift lights and snap the next gear in. Prefer to cruise? Switch to automatic.\n\n21 MILES OF REAL INDIANAPOLIS\nThe I-70 past the airport and Mars Hill into downtown and the stadium, through the south split, the I-65 south past Fountain Square and Garfield Park, then the I-465 beltway round the south side over the White River and home.\n\nROAD EVENTS\nSeven events from the Skyline Cruise to the Full Loop. Race for gold - your best run comes back as a ghost car.\n\nSPEED TRAPS AND RUSH HOUR\nSix speed cameras record your top speed in mph. In Rush Hour on the I-70, close passes build your combo.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the White River, a bright Indiana day, or the city lights after dark.\n\nENGLISH AND SPANISH\nMenus in English and Spanish, US road signs, mph.\n\nPlus paints, achievements, ranks, a map with quick travel and an original radio soundtrack.", "short_description": "Wake up in your own luxury garage, pick one of two race cars and drive 21 miles of real Indianapolis - the I-70 past the airport into downtown, the I-65 south and the I-465 beltway. Shift a real 6-speed manual, drive with your bare hands, race road events against your own ghost and hit the speed traps. In English and Spanish."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/drivingsimulatorindiana/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/drivingsimulatorindiana/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
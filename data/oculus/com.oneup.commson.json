272213587794_2030881980150922357_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOFg0ksT7fsQ7kNvwHesfUv&_nc_oc=AdqVTR2x7gLzR7H2yOYfLLeoaY539OgAEdwHCxNZxv_YOWJ7ryfXrdgjT-9D8gHP0YU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR58xH_lWSRe1BgdqbAI7ypiJcQOv8cKfYQsyMUFXqD3w&oe=6AF73263"}, {"file_name": "new-message.png", "id": "1798290327958532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1798290331291865_2864066100474522330_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I71AJ5bkv7kQ7kNvwGgnIXL&_nc_oc=AdpkMNBQiBY9H_rdA_cbCoULWv_MH8MtyaqOeK5ED8obGCvkxA-VD3WssbLHOm9BCk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKKyTYX3e1fDsxqWSLt51IYrLPISecgWgu3kEVPsk0Tw&oe=6AF73B43"}, {"file_name": "menu.png", "id": "1077051395155049", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619059_1077051398488382_6920813814455427833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lvx3fEjbo00Q7kNvwEubRyx&_nc_oc=Adr5CVoIOZkW11UkCLFBOuLJXsfotZSMn24cjSA4QhQqmXkTb3LvRfnROL0FhvU7yfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRofJt75jpaz9GUXNdYNyE_sbmXgodLJRfmETwYjeOO9Q&oe=6AF721D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "4439053469682610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_4439053473015943_1040401309998727976_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syPx09RROK0Q7kNvwE3Er-Q&_nc_oc=AdoN1tG6QmLoC0gh8XDBOfbyRng1gKdmxUaTZjYCy_SD-nkDr7ZcesN2IbUANY7ucmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTattiBBW5aR2Q_gvryP-KMktJrNy2Hgz7S7nivuFOcuw&oe=6AF737D5"}, "display_name": "CommsOn", "keywords": [], "long_description": "\u201cWhy aren\u2019t you replying?\u201d \u201cSorry\u2026 I\u2019m playing VR.\u201d\n\nRead and reply to iPhone texts in a movable Quest window alongside supported games and apps. Keep your headset on and stay reachable.\n\n\u2022 Floating alerts and a bell announce incoming texts.\n\u2022 Find conversations and contacts in a compact menu.\n\u2022 Do Not Disturb silences alerts; messages still arrive.\n\u2022 Explore CommsOn explains the controls and Quest keyboard dictation.\n\u2022 Connect your nearby iPhone over Bluetooth. No laptop or companion phone app needed.\n\nEarly Access: testing across more headsets is ongoing. Requires a compatible iPhone, Bluetooth pairing and Show Notifications enabled for Quest on your iPhone. Contact sharing is optional.\n\nText only: no photos, calls, groups, native reactions or earlier iPhone history import. Outgoing replies have a 160-character limit; some emoji count as more than one. Up to 1,000 messages are saved on this Quest across all conversations; older entries are removed as the limit is reached. Reading or deleting here does not mark messages read or delete them on your iPhone. Messages received while disconnected may be missing.\n\nDictation depends on Quest system voice typing. Window and alert behavior can vary with other apps and headset settings.\n\nSupport: info@1upworks.com\nPrivacy: https://1upworks.com/commson-privacy", "short_description": "\u201cWhy aren\u2019t you replying?\u201d \u201cSorry\u2026 I\u2019m in VR.\u201d Stay reachable with CommsOn: read and reply to iPhone texts without taking off your Quest. Floating alerts and a bell let you know when a text arrives; Do Not Disturb keeps quiet time yours. Requires a compatible nearby iPhone and Bluetooth pairing. Text-only Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://1upworks.com/commson-privacy", "developer_terms_of_service_url": null, "publisher_name": "1 Up Printworks LLC", "support_website_url": "https://1upworks.com/commson-support", "website_url": "https://1upworks.com/commson-support", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id
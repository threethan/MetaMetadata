CVoIOZkW11UkCLFBOuLJXsfotZSMn24cjSA4QhQqmXkTb3LvRfnROL0FhvU7yfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRofJt75jpaz9GUXNdYNyE_sbmXgodLJRfmETwYjeOO9Q&oe=6AF721D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "4439053469682610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_4439053473015943_1040401309998727976_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syPx09RROK0Q7kNvwE3Er-Q&_nc_oc=AdoN1tG6QmLoC0gh8XDBOfbyRng1gKdmxUaTZjYCy_SD-nkDr7ZcesN2IbUANY7ucmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTattiBBW5aR2Q_gvryP-KMktJrNy2Hgz7S7nivuFOcuw&oe=6AF737D5"}, "display_name": "CommsOn", "keywords": [], "long_description": "Read and reply to iPhone texts without taking off your Quest. No laptop or companion phone app needed.\n\nStay reachable in a movable messaging window alongside supported games and apps.\n\n\u2022 Hear a bell and see a floating alert when a text arrives.\n\u2022 Reply using the Quest keyboard or system dictation.\n\u2022 Find saved conversations and contacts in a compact menu.\n\u2022 Turn on Do Not Disturb to silence alerts while messages still arrive.\n\nEarly Access: testing across more headsets is ongoing. Requires a compatible iPhone, Bluetooth pairing and Show Notifications enabled for Quest on your iPhone. Contact sharing is optional.\n\nText only: no photos, calls, groups, native reactions or earlier iPhone history import. Outgoing replies have a 160-character limit; some emoji count as more than one. Up to 1,000 messages are saved on this Quest across all conversations; older entries are removed as the limit is reached. Reading or deleting here does not mark messages read or delete them on your iPhone. Messages received while disconnected may be missing.\n\nDictation depends on Quest system voice typing. Window and alert behavior can vary with other apps and headset settings.\n\nSupport: info@1upworks.com\nPrivacy: https://1upworks.com/commson-privacy", "short_description": "Read and reply to iPhone texts without taking off your Quest. No laptop or companion phone app needed. Get floating alerts and a bell, reply in a movable window alongside supported games and apps, or silence alerts with Do Not Disturb. Requires a compatible nearby iPhone and Bluetooth pairing. Text-only Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://1upworks.com/commson-privacy", "developer_terms_of_service_url": null, "publisher_name": "1 Up Printworks LLC", "support_website_url": "https://1upworks.com/commson-support", "website_url": "https://1upworks.com/commson-support", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1444568515404000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_1155740976808238_5751433466778893550_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gthgCWa0HUQ7kNvwFYTSzl&_nc_oc=AdqpeVi-PaEhxjbsKdt5Ff8dOC6YEliezoMVPZJPNwUlNfx6Rqjb6-iuMQt3ee3FcYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQly-IjCJYaK_OmctpBrqZVy61aY1fVtUKILs66_eA0KQ&oe=6AF74034"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CommsOn", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
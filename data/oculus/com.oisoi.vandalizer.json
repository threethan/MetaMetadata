=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftwawbVtWhyqe9SEBMSOgD8dcyN1Lfdm9Ewg0t79khp9g&oe=6999A88F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jMOm42bTkQ7kNvwEeyT20&_nc_oc=AdnNKqbY-PVK7Ia6tOQ-vxo6Twfn8pIUAXeMxnswxgEJ2-sU3eF2vtj_tvR4M5sAAvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKQd3WQFymY-ODtXqxRFmnCZ40KjD2gjlx7hP4acQ97Q&oe=6999907F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a282nauMwpQQ7kNvwGLfOO6&_nc_oc=Admyxj8e--8HXwoa1x-YCpizo8h4WibK-U-Bxivy-lJy3GAfZp8_QKgESXcMOFpjMqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPT7GmUkuqvp55dmUf4kYK3f4Mj_FOp8SRMHcatlC_eA&oe=6999B795"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfOG41JsWwQ7kNvwEmdhav&_nc_oc=AdmK-oLZOO17h0DnbEfwTROHcjxFUfWf0-c0YU3w11eB170pb-9WcW3UMraRGMlumRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_7uE34uTN_kN7pVFDjVE_Ak0Y85RmwifnbD7VnPjaoQ&oe=69999127"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbZr61s31KwQ7kNvwEwNwV6&_nc_oc=Adm99L6Dc584LpriiyXjkvslZ3Bi6plmGL2vYVpjq-EVCruUQSMbiAnWz5hn8X1DnTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGEnEsNnqpbppL81WBsQ0Hg7ZaP61NnxpGB7ODn6E0VA&oe=6999B2BF"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
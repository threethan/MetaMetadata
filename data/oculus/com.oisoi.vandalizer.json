&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOahxtjk1z4Q7kNvwEGfQKr&_nc_oc=AdppJmnMZAlB7F911EQJK35xOsYU3K5GQuQilE2L3zEzuLXJef3moYJX770PiBM5PFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChqTl2qJse5KwfWzpwHt2t294KzGkKSg5ZO_Jecx9Y_w&oe=6A5CC68F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Gwz_NSzO0Q7kNvwF98Wzn&_nc_oc=AdrySCaP-XKxqEIDR4kmrZmbKnggROD-IyPPpEVOPa4jiyBuULhdRGmgH2cRRLmwxpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK70GzBiIBmEyWpwNKoaAQFAg9-EcX4lspUm7g_OgZ2Q&oe=6A5CE6BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B72GaPFJZJgQ7kNvwGnjXjg&_nc_oc=AdqvgPCN7XY5GyA7Nzq07a0wAB_69nEoWNC9PZxB0a54caCnI6DPQFZYz8Yv9a-GYS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwEB8gshpp7CRG89sl0nN4nV9gdRk133urBjVJQk6qlQ&oe=6A5CD595"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cDJYQXNSdMQ7kNvwHQpglm&_nc_oc=AdrsajZ547O-l4D41iWXKmzz26zTNicSW8WNsOKDZ3m_gJ42CyFs0PgzuqpOkFltDcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsQ3kEkm5Rwwwcpopry4WT4WhpCebjTcoL2hjcckTbJA&oe=6A5CAF27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy5R9m7WIuYQ7kNvwGvizl2&_nc_oc=AdqXchTvZjAvVlcgCt7HylvNPxRdS-WKMQrzzK3ffLAeDCvRhZHDLig1bOph6sRchw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXM7Y00KiMLlBBegsM44_ou_oqqEbtNlxcIDuhhNHtwA&oe=6A5CBEB6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
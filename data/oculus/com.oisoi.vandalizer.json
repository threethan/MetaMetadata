=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3kWDMW7aDOR4agKg1YmFs8OeQ7bQv38aPjElS81mKf5Q&oe=69F0AB8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2kF0mWGHqMQ7kNvwESfQb0&_nc_oc=AdpsI2brPjrn7fCZbwXodrFBWQwRNiOMQYAgEagLnxNIH9kGmv3UqnKjPqADz5PHZEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3oOqdN6paLDyVelad7N09tJQWZ8uebboYWLWjbaB_m6A&oe=69F0CBBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u01eT_er-lYQ7kNvwH8GFRT&_nc_oc=AdryGcTYMB8xHryE465QaN4I5hKbOEzOwqvoLQYhrmHlUMyPNsjvjPbpVVHvGIRy4-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af30aUhAjFrZz6qo7q3UiEfBVrm1TGlEZVF3s_5AKdYV9Q&oe=69F0BA95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIwEXycm0YQQ7kNvwFSDQvI&_nc_oc=AdpEKMr9reC_aAJCuWmm3kwVSlO2Tdz_Cf3oeGEyo79C8-j3nsK18HohJ-S5jxQCf3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3UyvRMW0vtwFAmrIWSM6QWS8vNB1-aAOzEOGhlhoclCQ&oe=69F0CC67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwosFBmSEMcQ7kNvwHs3M0D&_nc_oc=AdoEmNut2MZSWeNSZblaGy3B73pK1VLZVhWNqzg8c30c2_OymJsRxnM8QIjuneEtZdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0SM7ISMZFcJJptqWija4_PVso1T1yXuIOxhR7PeSTG4A&oe=69F0B5BF"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ1UQi8uFrAQ7kNvwE7j6Yz&_nc_oc=AdqeMOChLNvdpb-x2o1egmFaLmp7F68XVQ0XCBoj3EZdgQE8LGyBSX-Sm12_3LmgjaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSGpfKMgfGzbG80Wqpl30onSBMcemmY0XpQa5QEuVJcg&oe=6A5F698F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXLj94XlV7wQ7kNvwFFUrwf&_nc_oc=Ado0R8W18uvbG_lMrVBcBTxOcvJ8seuhPs4-em2QL9Oz5wswZcEmc6R1vpH9plJfCoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPtZE7XaaxUWdjYZFt3XUbRW3xIj_keWdnGnUjXx4VRw&oe=6A5F89BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B72GaPFJZJgQ7kNvwHDP0eQ&_nc_oc=AdrbKxg3-fiFPgSOl1LlyigsbQ3sA_YS2JR7eHCkxIlzvnABHMdflFuHv4OKTniuREg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAliYgCx_1JuL2-Waog3g6oJexp3xSiNh3r2rYBg6DWWg&oe=6A5F7895"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm834YTHMo8Q7kNvwHXAY6b&_nc_oc=AdruaMWjC6g2GihQk6B9x1OKWTh1P7wWk5iUghfZGgcMT8-uJTATJVL7pIAY-ab7UP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPW7KNNG3s_GyCZ4c8SIb6UGuktUDEWpvhNdML8-REtQ&oe=6A5F8A67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMmP5JVwsXsQ7kNvwF_Wuu5&_nc_oc=AdrDvuSsDeCMaXtJOUWHYcUpbYFZXCTKpyxymJwa0-xqIIzpQh19UQZm_VuW75yqEfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_uk_-ev7sr1Yg66DYB3cy4dZMvp4d6CxUM2dRfyai9Q&oe=6A5F61B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
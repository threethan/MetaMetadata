&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEPpyoanM4sQ7kNvwEf7kX5&_nc_oc=AdqSQVeTURQ5bvul85DLErHkkWnkWJE-U1ANFl0uoIoKfzR_yhbInNOaJ6HIa_V_XNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKnittom1jHTlCfpNgXF3ahkaiAdQjsHdK4Zsv5_DFbA&oe=6A620C8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXLj94XlV7wQ7kNvwGF6cwV&_nc_oc=AdrW6UprjYNTF1v6zBQsI7PnLr33Kc6Q9r6tnann7hsL7KAhK3ycaFsvMA79U21OrOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_YLbKzlcGGz3dYRknolSNOktI0O8MA9yHUTPCBfmhgg&oe=6A622CBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpDo0bUkTrsQ7kNvwHK5Jxn&_nc_oc=Ado-xC3EROYyeMrOik8EtZZUfEOLeZsbbMhT6D8TFOqi678F_pi2ceyDVadq3fUVIks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfFwTwcI-Eene96o7kvPUfwCdqJubtkKv5__2jKXyg7g&oe=6A621B95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfDcHBWydD8Q7kNvwFgeK5b&_nc_oc=AdpZshAdk2KD3QhbPKNgMCdcCxOgvwEZPQrppRrYPLAUf0wsJWiJXlBKvvkZ1G4spyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYq_KMWbHUbj_O1IBBKAL-TtOLoFpfE-pHjJd3W-l8TQ&oe=6A622D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmQ6CA5F29wQ7kNvwE-0qrz&_nc_oc=AdqC8tcuC0uB7vF80zS94pX6x1CKAWrv0r-jWe-93p0tUYtuhrI5HZd7Z2wLB-adFwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnHPsqgBNyIiC7FUv_Ler2M8Xv_P7Tz8YVn-uXhyLYzw&oe=6A6204B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
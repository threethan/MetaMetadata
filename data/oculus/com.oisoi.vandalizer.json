&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fye3iqgKBoQ7kNvwG3CZy4&_nc_oc=Adq9Hh2hm88kHvy_udVQ9LUXZ_Fp46ksuLeH5yDu4QCWX4LLnqXaKf336RA_CSGDmaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__-Exjbz4EQVKk_OghhyRm66O5a_Tl_1bDbcWzhM9fZw&oe=6A43BA0F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfmm5QUNRg8Q7kNvwFqWXa6&_nc_oc=AdqIYhYP8bGeINSwmSFKNRj0jzC0Vm6RsRrJaF33i5-n81OedaaZ_KpFIS0hr-mFD8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98FkAfub2fzKr6md95mO9KB_H32t-d1yb95btYK16PXQ&oe=6A43DA3F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlEGYPE5H5gQ7kNvwHnMsTx&_nc_oc=Adq_wzLRaZ-bKcx0onhrDvmIloXFYDyku_zxvNUbFPrNfnPuuKNenNQKE2mR3ZQa3FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W_5lQl_5LjNnTUld0pOasaRhxK3GSHjAwh6U9azkEOw&oe=6A43C915"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5ECjOtKHcQ7kNvwFAc7vO&_nc_oc=AdoTs1k5YC29jRjMEhywsVoR_Jq2IpN0pPd8CBXbU4ExD2X6WV9RcdFqhj6jt5QjoY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LKyTpHgVyBL84zA--sKHdeY-Y0sDeLUl1PvNkXSMsNw&oe=6A43DAE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N773TCV3XYoQ7kNvwHm0Mwy&_nc_oc=Adp51UkKxMmtI5Dm3Rpg_pEOyy6GqpxJlapJ3Roc75flxdYFVcmNodUT3FPd1pycG6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D0l_tOdoYGN1d744WKm3BcZiCIL-n5n-JYFMIWYcFWw&oe=6A43EA76"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
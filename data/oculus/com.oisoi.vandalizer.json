&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxaxtqm8c2cQ7kNvwEsPZpp&_nc_oc=Adrs1yJVj4IKEEn5BwX5Uty6BtAZumYcJ5fFnOyEnHF6CqcXpVrz7xRuKfqZ7Jn-3qs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK85ZlLDzpotCOYEHkh-TErRhQj1RCqPvA9pV9Fz6E2Q&oe=6A562F0F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xlKHW7_l9EQ7kNvwHVxPyH&_nc_oc=Adqh1l4xzNK6eoeAUyVd_YS1iuMFE4Jr5f5dLEnmEpnMH1HjTOKKnzrqLwaJmtho6sY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhi4V2F4FklBoKGqgzVjElTIkKGvT0PgNB3UULFkVJlA&oe=6A564F3F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LXMy2yt63oQ7kNvwF8Vz7d&_nc_oc=AdpfaFGbnhCghCOPoYD8mlcIk_oRaNkdxPsK7s_rF5Mor6wKu5iqL5G-x29pIjUDy8s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLMF8OeujIPCMP5C6TyHel4TIUnDKGg9Ba-B8dpJ5AlQ&oe=6A563E15"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04EQtMXojCQQ7kNvwGb-ePg&_nc_oc=Adrh7Q7fomqnWE4v2-025PUBuIR3suLv9gFHMrVBnpR37U8MCU5IvX0PGz8fCFhk12M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbTClnsF1wvPxPcW_kX8pUnh8hRbPE7EdbTTKFIgxlEw&oe=6A564FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggwtR0rSJX4Q7kNvwEb9eH3&_nc_oc=Adowq3-LUpu0WQpeyQiqZ0VHFuqCYAl086qswe_8wbHBK7Sjp4ZTtsxkI3bkzxraZeU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT576atM03Q5et4O-g5D_qkLMlogyayuuYo3DZsGc8tA&oe=6A562736"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTN58OsrkCUQ7kNvwHSXX-A&_nc_oc=Adoapzm__sG35RwWM89LG4FK0NqP8zHqFs7LGE-LtIrBebGy7WXEF3JeJwMrXWzqpcY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYH_Kn6ekCRPJ6vtmwkQq_RFyGxzKq7yBTGjrNGOGZFA&oe=6A66010F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-fn7HeY9I0Q7kNvwGVFyS3&_nc_oc=AdpoAyQksShXApMtvSHq29ZZf09jrkzmKFjMw5RzBVpjttrr5cSf8v587balQ2f8-zc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtDYK971Cidi_nV2hqJzP_92Rp5fO6CYpkQGAZBJyBuw&oe=6A66213F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuNlEaHxZEQ7kNvwHlNXg4&_nc_oc=AdqRVphmzY8J3I_D8srVPyKu_54DiTfre8AWwiEvviJ68OJTpxpAfgdUD1yChtrdoHE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTx-KOKC-m0n5zZ8qlonTZbpQ_8aQqGl4v5HA_hI2Nyg&oe=6A661015"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkaXnpdbxW8Q7kNvwHfsfJq&_nc_oc=AdptmSEMS109pz9O2sf9ZZgNNZXr425q4uUL3c1UEP5sjBwg9IRwQnjKL0-0e-HE6jM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjrkH0ozzbjJxoU9DRI4n86iyxXGAbY7NsjGUNim72zg&oe=6A6621E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9nllF1CHAIQ7kNvwHnFrKg&_nc_oc=AdpgL7K19iiJkx4T0d3NCLj69RFbkLFtjTcFHhY2MebuEuFAplWJdUqxJxG14vPFJOE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwyO-eFree5CFw91Rgqd_tRaoUae5o-lh7SbZIFvhpEQ&oe=6A65F936"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
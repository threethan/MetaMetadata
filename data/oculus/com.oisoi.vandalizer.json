&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h9Rr_6XJoIQ7kNvwGwvXsz&_nc_oc=Adryufz3aA4ZwdJIoBE4B0CaJVo7zrHdDwzwDowHfo7ueMpRGkr3M1fiU5X_2k98eSM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARraManVINjLV9mCmLYXfhhOVMmD-a7MfQozsUsAA3hQ&oe=6A4E460F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2aIZyr8cs8Q7kNvwEltG_i&_nc_oc=Adp8zkNo9RKYQgkkFZVVHES3CO8yF-8AE75Z0P-cE08mCDPAHZ_SYD6fSx9pbUjq_iE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7pKT3T7f8INBjhFFYTgQ9AUQHGcmp2cOiR7xr8h9zdA&oe=6A4E663F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgJ9ahNRMkIQ7kNvwHzw5E7&_nc_oc=AdrvAnLgkBDJfij3JuJi9TztyjLXO73sA3x3pQOb_oAvH5Pl0LhKt9g2CmSpmWxntdU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsxFpW6fzeqlsCdy9nkt-v6YrYjyxlDLkwxjjQFys1Sw&oe=6A4E5515"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AB-aKFpb5MQ7kNvwFBTnA7&_nc_oc=AdrdSyvVYNYWiyNIokIL_BuSQjIMXK_nfRADL2E7cSrOCacNDqK1wwAhRxHIRB6bbWM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJCaQkVFCDOWrvmW_2eJqSuIOoBY7u1qcTcmCYCrrp9w&oe=6A4E66E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3oi-mKofK0Q7kNvwHB5ZlK&_nc_oc=AdrKyiHaFVoL-DP4LLsQni0I6MQE7oaixc9RVo9oKGhskO1HyOOgTnyIEU166UVQrP0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdYEMHkawDHU_XH0DRgbTEDlbeZ8OkFnA23ETGO3G7MA&oe=6A4E3E36"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
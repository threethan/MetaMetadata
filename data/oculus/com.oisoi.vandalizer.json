&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN6xKadczzUQ7kNvwGRZcTh&_nc_oc=AdpbIXxruPGKT4-OWJkEM3qg7u9WC5XcvIsL7dEocJ1U2bJz5D3iLkbeZtnkddsXoz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo51_7vZBIu4FsPlMkplLmiR-SW7UXRMIVY5QgGMpRnQ&oe=6A54DD8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xlKHW7_l9EQ7kNvwH7qbHy&_nc_oc=AdoaDRW66D27GxCs_ZIeWUGivTFhYoBdYdQ2wBizPdN6-Mc9CXXeWJ89wulBkMXSsO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR87ITyoObrUuvMHvr5feIFV8jrBZ5p__j5mFfju46zA&oe=6A54FDBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LXMy2yt63oQ7kNvwHwN-eH&_nc_oc=AdprwsG9yAC3j3pTOf75P4U1qCDOdQ-CHnAmeqKApXZpyINZEujnLVB2l-6vBl_VRJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtz8E3YWfGDvzGqE2-P6gnRRs4uzDakeJw0HEiX7wMAg&oe=6A54EC95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMKNqso_N2wQ7kNvwFDmxND&_nc_oc=AdomLj6pnZ-6EDF0Rzky29JtCy4IzrVMdSnQMVl1yhlOqaI1nsamyz9AG2rQhBEEFHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB32Jj74WvjbBnqDe-ZUKeeHghwlnquY10sOAfmTuOJNw&oe=6A54FE67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbVTOP-KcCkQ7kNvwHsjraz&_nc_oc=AdoS6IlsyozKdPxATlDmzLvDNYOtuZbcEAmo0LcNzKB3sVi9N04WEYOzQVc5FtBr4JA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPupRfWJc41tOs8U1qFLqveM9immfso4mglFlVmyUENg&oe=6A54D5B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h9Rr_6XJoIQ7kNvwHDvuWp&_nc_oc=AdrImqU7Vncr-Crx77BY1B1VXBYpsBSgtslHtN-pMUehKejgLJ8BsC570rglT9WDGpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvBGEaIb_TJ8Heu49yLsdk3NNyugLbwAUTZXgDyzUqKQ&oe=6A4F978F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5hweFEuonwQ7kNvwESr9Si&_nc_oc=AdqF3YVLv-5T8rvHqlMcyjPBn48td4PyYhePLcGjY-23hr4SM9DY5QHb6RhA5YsLjS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNVevXaLYK4gpTGrheQ15X2iatdyeS8qh1Tgqezm9DaQ&oe=6A4FB7BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgJ9ahNRMkIQ7kNvwEQsFu1&_nc_oc=Adr4ehFED8fwzfFuvpVK06VbmyEQWP2LtBVK46F1zX7chkFQGN4PbtVXpnJ5-LyEGkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCziWke_WWN2FlLiAthaX0H0HxrtfVD9pqqmPYGmLYMEg&oe=6A4FA695"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AB-aKFpb5MQ7kNvwFgObZS&_nc_oc=AdprEOgP6SuVvFZyoWwtJbFJZremLIDMx1cfJBsHxKYV9-MaleZ3Tgj-3elgIrVy3FQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJmHL8tbe8-UYRCNPH_fDMXIrmIS5hnLRN0SMt65PJCg&oe=6A4FB867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3oi-mKofK0Q7kNvwG36H_B&_nc_oc=AdoCGlvNceDsQqnFNkhMmFeWEOIuv7rBbnHLc0wJmt17mm3oS45Rp7PjcoV8-SBXMb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg0cn60ryJfeBjqpZUOVVOx7IzQCdO4ltY5Vl8y-GzdQ&oe=6A4F8FB6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
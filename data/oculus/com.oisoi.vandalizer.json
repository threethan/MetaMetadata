&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ1UQi8uFrAQ7kNvwE1QShD&_nc_oc=AdoEbmJVG3GfN9tAKyk31kIUrog9Ey4YidXWBLmRfCKzmTYpcm00T84A6zsdhp87hmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQKr6wmuI3Kp10ako9cV1p6NR99E_CY8cNY5reDPFBew&oe=6A60BB0F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXLj94XlV7wQ7kNvwFA5nFF&_nc_oc=AdqlMxLcOO5-Bsr7FiBUikzPZlOUIUAa4PHf2JFSSfhB7ZUE0Yq2QCzSyRMpvyspxrY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQZ__64TDlaKSc8GVWmVXKvlBeTU5ou3S4btMojJaSGA&oe=6A60A2FF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpDo0bUkTrsQ7kNvwEJ8Kbo&_nc_oc=AdpTXAad1-lWFWPukUJ5AGEbrsf9Dyg-RGwDldmrv9VuHyW4tfv-2JTKsbnRsnKm2ZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0BbBV3UuFV-ltoODsuxZ95W2zlkIErksLHa7dWJg2Ug&oe=6A60CA15"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm834YTHMo8Q7kNvwGh80YR&_nc_oc=AdqS94v0PZ_aS__84LtGbs1BrWOgZzxkLUHlN0M1ycuuJ0-zNS6buNd_r9B65BjofXM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB3KCeaTHzhYPocAVaX2rVjqzj36ua87lU9GzORyK2Iw&oe=6A60A3A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMmP5JVwsXsQ7kNvwEUGP0V&_nc_oc=AdpA0ROadeei9uw-g6dpTMo8j8VaQ84OeGsFIyMgJe8CDzhVweNgJ1SeQp-hVzjkMII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArJ1TJdBgblJcQrUm_xFmny7LExI8gW8CbzBdM-ODEUw&oe=6A60B336"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEPpyoanM4sQ7kNvwE1dGAG&_nc_oc=Ado1sB4M2KZhWdDV4oAobRDNLNX4Dph_EOFDZots5TS7mBXEoguZjA82WdYhI_cp-Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKbAT_0aevoHsHeySWsZlm1pGmkUqpIa0HjyHISLYQOg&oe=6A64AF8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-fn7HeY9I0Q7kNvwFpPE5G&_nc_oc=Adq8dG1cEWkrBR2B3u4hVYqGcRHUdwybxb-wwNfEPlhbIrBw3g4DVHdjRe8rca2U6f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoHyODFvTFHacJYeSIUdyNlxPs-AlHh4E_bC6GtATh5A&oe=6A64CFBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuNlEaHxZEQ7kNvwEQmDSK&_nc_oc=AdqK3zk0dsv5z2IiCsTqGiq9Uhg6qNhn-V5aOZmW3Jg7jB-XyWjcnyJhWlG5hnJMZPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu34DGQSfN_XQKcMfg2_NC51JR2c55DbQcmWqrkFG89Q&oe=6A64BE95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfDcHBWydD8Q7kNvwGobYwh&_nc_oc=Ado6E8wbRWCHm5h7m6-XMZXcXK_pTo9znpGWMFd658jxTbEFD29F00YJPqZCmsZ9Ndk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuFYYx_JGAn49ASxXRqJ6IUbl6kgKrasU70SKMMhRY0Q&oe=6A64D067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmQ6CA5F29wQ7kNvwEigh_i&_nc_oc=AdoTVpH4JFBnnLNVQcl7Iu6gGuwK7sgBdFiNLC5euVq23fVIqBQKBuVFFm1_82CIcaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_vSiCxbQ_JQh89P1-D484Yc0u-JGNB1cRzuPrQHLPmA&oe=6A64A7B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
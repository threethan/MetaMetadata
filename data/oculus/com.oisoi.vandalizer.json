&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h9Rr_6XJoIQ7kNvwGWjW0d&_nc_oc=AdpJO0vpEKzUJZc3GkumtHz6L73ipWjyzBJjL0P8Ig8OqFOVozO4o56KcnXMl2go8jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCge3Aoyz6tTHDTj1wJU6IzTdlkgZ_iRFdDQYLgPpH2Og&oe=6A50E90F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5hweFEuonwQ7kNvwFQflss&_nc_oc=AdrmYPhPf3cMeRe4BSfsRf9e_4b-aa_SbX6xYrj1UwaGXEDT9y4UJvPglCzh_Gx9EOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqtj_tCRwNZKdILHhHMyYpzCWAq_3FaoMbGE4sHhM5XA&oe=6A51093F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6d8EPnnovYQ7kNvwFy-b63&_nc_oc=AdriD4aWDlxc3qGuaaAAuYyhriQN0dZvIxmCcqYKJDJIKd9jv9CrL64gzzaamtwl_kU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmE5FEKxr11-kdXzRmao7efyc-qRF0hc_OnK4YdSofXQ&oe=6A50F815"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AB-aKFpb5MQ7kNvwHFFQcL&_nc_oc=AdoENSqojti0oPH6Nu2vYxpLV3ZSxcqBEnAi5NsKmNUAVxV_nPTHmWis0yrlR_DPmos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0rwrHMfU9MK94VtMbOuDsehmNHqffpcdnDwj2D7sJHQ&oe=6A5109E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3oi-mKofK0Q7kNvwEVgHoj&_nc_oc=AdqK7JKedb381MB-1arcSbNbu83_5FWjC4n-ZqAiacmlzh53wCzNi3peNzWkWMoaVYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjzk1trTF6hVLH3k57brykpMkZgIwRoKaVV9mq219TMw&oe=6A50E136"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
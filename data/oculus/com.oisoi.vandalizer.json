&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN6xKadczzUQ7kNvwGNIZjp&_nc_oc=AdrhKNZ4_sdoCw72J0aG3nqmTnTNzXYIpJpanDg7ADKVXm2T6W2vL9eTi4YGl-xYuYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_-KxbqRvB9u433m6uSMApeowjKjjQpFeHyfDyC9EwOA&oe=6A538C0F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xlKHW7_l9EQ7kNvwEPEaGj&_nc_oc=AdrEM0VJpLDO_T6m6rYor0-EekDHNyRQ-eRIJAD6JSSDONrj0wSCDw1eXt03nrACxiI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Zvf1LFyF94xVZXmfcgRUWo_Wglq4c08R9qpcdeeqhg&oe=6A53AC3F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6d8EPnnovYQ7kNvwE9jRKr&_nc_oc=AdpFOaogeUrjk5qwJtBqw8KohhRE3gNTA9T05Y_XdV9DxgsPynDIhcrmZAW0hh6GTtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyYJ7_F5wlXVrjy0dEQPCZKqdfkJaOShs4edXb3x_X9Q&oe=6A539B15"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMKNqso_N2wQ7kNvwEf0YvQ&_nc_oc=Adr8ukeCenVigrztxb499kP4JiF4plD-n0txs-iixCeF_4VbC9WlVaKU7FC0sBrUbts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtnDSP4wIG64AQiSzZLryP8i_uHyFav1Qvbmt0W98nvg&oe=6A53ACE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbVTOP-KcCkQ7kNvwG9d6un&_nc_oc=AdoNs2lIp9OmiuciZX3nVpAqQRnUBCTJVflKMvkzM7tWkjSWRzwn5Tc8tNHdYJ6ibXU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWLNi_k0SWcViULuaSCFGlAWcxjHqZbM_3D6vTWKu01Q&oe=6A538436"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
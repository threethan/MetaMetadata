&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1ufyPUrVn0Q7kNvwGOOIXr&_nc_oc=AdqZv1p_FPRS7zC_ujnkzTHRzkRuQAdenRBdvdcm7rd6COXEc2nNPU7FjrJFmFyXF5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAMq9g62OI7lRiuypKuQAvtnnP1bdX3ZofhkxF62TXZQ&oe=6A4BA30F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2aIZyr8cs8Q7kNvwFXEkJI&_nc_oc=AdqXbGSapOLaCtPabX9RiR37ubHI5Edz4MGJ4BDGfuzhreQlKZg5tpTSPqt6JKZXLdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGo02-O5HYzD17Bhu3eDd4PrUCSrEsrI4Tj4mAlsjHpQ&oe=6A4BC33F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD7d-htDtxgQ7kNvwGyH9xL&_nc_oc=AdqoXwaZlAGOYSbO-eycRt1wDLbb7PJUC08K0MYJkIzdVXY-sKFNgZ2ntvReOgPzNGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp7olQ5fC8e8uYWl3S0VO8kn2zJHgu0r_qqGjRD18ngQ&oe=6A4BB215"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0dEWK1aqecQ7kNvwEu4UfS&_nc_oc=AdqtJ7WS0FZaQSw8LLEfu2hddAwH7gTW_fCQYkcHppyFddRhRcGyLRZEc4Q0LM1h474&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBMkTeSyrEKNtmVT4NJYj8cYeW50fLTFWNhZS8PQ0eSw&oe=6A4BC3E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln0ZdoIbHP0Q7kNvwHPY46d&_nc_oc=AdqaSMba8H-LH0K8XNMU-O-Nk0oh2DdkoOVjq251xlkkaeqi2tA4Q3hY1eL_IaEkIS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXbHEsILNWils0Bz172eQNhHLuqcBccgzKkekoeIE-QQ&oe=6A4BD376"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
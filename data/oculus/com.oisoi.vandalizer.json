&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ1UQi8uFrAQ7kNvwEZN6c4&_nc_oc=AdqE6hX1s3Fj0KAWchg2QzbWu33dD4GRjB0cVcB07ny21XcOGF_GR-isUXbuwD9XNz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6Kg3S3fzCxswQQmKrSRdU7e914YKjgUOogq7pH7uvmA&oe=6A5E180F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Gwz_NSzO0Q7kNvwFJ8iSc&_nc_oc=AdpY1wkKU9xSw_vkna-9H4Y8B8Vh3vyTKFTTGDbRWi8o-somZddkC4mtq5C_1mFCBEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1utO2wVXprG0L6utVP-X13-Vu1UE_QwpRB-6qfy8G6g&oe=6A5E383F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B72GaPFJZJgQ7kNvwFa7MZW&_nc_oc=Adp1R07O_3DuS98jT20rHApW_hgPwhyH599SsvGkpaJEYubgY1VgObOASQClUTFvksA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ6nFuQ3rNumpplocRTBh8PUmonEDPdDGHEmuueOhObA&oe=6A5E2715"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cDJYQXNSdMQ7kNvwEcv7lV&_nc_oc=AdrVGm5SS-hBXIBKmzpqjLCm8dJNI3JX_qhUE9EU7VsZjE9zZKfhaBvVDjVlX_1rUP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ9GXvdYLH27FuRRGGo5_zSsGgZeGm6gQJ_r6dBCEs4g&oe=6A5E38E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMmP5JVwsXsQ7kNvwHs7cow&_nc_oc=AdrPLzSDytLSsTdJcNYAKiVjMjFEjN2-DTBvADi7xrRZOS2PqYoEvg4wUkdxyAOL--E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC79fXmpJ3xVSxGJRS-GjaS2BD4_1J8C1KP_1Sd9q-8wA&oe=6A5E1036"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1ufyPUrVn0Q7kNvwENSiQS&_nc_oc=AdoTgAPlwu5eKR04aOJtR76Ljy5K_z-_Z0DyNZYQqs0NCDEKwV3FwzbrSb4DAY3SII4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbkXs0lqVDsDdpD_Z_61PVT3LC8QAYs_vq2zI2XYUJcQ&oe=6A4CF48F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2aIZyr8cs8Q7kNvwG_JhMG&_nc_oc=Adp9RU2nv5AxC7_-o1nYrU3I_6ySkvbE5CvLeaFhQrKxsIpRTBuzZIC0mIkJtWSlqMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAELcFCBcH8NXW-SLPUB1SoBvuXeEcZ-c1NER8xJ5SnLA&oe=6A4D14BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgJ9ahNRMkIQ7kNvwEyb6Ey&_nc_oc=AdpRqmGypAkZbkZJ0udKxg3bXYvf6erATh_UlJqqD3kvW-YYJq3SR5f_QuzlO4HZRbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg264y3o9t6JyhbpwQjpYqGhlSKK_yDHZK8TKIPsZa8w&oe=6A4D0395"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0dEWK1aqecQ7kNvwFFYN6m&_nc_oc=AdrUeSuMF-GrEiLCddUzpLWgjMNoaMMaQo55kOYVABv0rFnG9CVyV2bzFj0FaDxnYpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLvV5Gb0fsYo1rPztSDvwUCmH0vnhVNKewz4ibkldJg&oe=6A4D1567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln0ZdoIbHP0Q7kNvwHCvpMr&_nc_oc=AdrO4Kg9fuwdMIg4JoTf4clMnjvd3DbrBfdxBu07GphIJJzWeeleKTYPpezacie4btQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAiVBIsh4gwTiXhz5VoCQGmkFVAGld5P2r3_U7XcCD-w&oe=6A4CECB6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
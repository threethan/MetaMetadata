&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOahxtjk1z4Q7kNvwGNQcN-&_nc_oc=AdoUfPE291ItH8WAo-_YicAgutP2wdruCI0IZYCPEUQZmj2616KKukOFosmeMKBElBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjlQtPcTqbYcn_ZrtrVCpKYa_4Fgy586WhYh9bxozeFw&oe=6A5B750F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Gwz_NSzO0Q7kNvwGGjECd&_nc_oc=AdrFFhQ80foFvt5dc1HSmumYInnVr4C7gXWZeYPAZE3WOcw0O1_znQHGCjoC5PTZnJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwzU4MRdFD_dqK6p3eQWHdG8PucKoAeY2iHcEBqqf_Lw&oe=6A5B953F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH3n81IWJEAQ7kNvwFcYEzZ&_nc_oc=AdrmvDoZKbKmMlEuPafboIkhvTcqxaeNUvIm3-8s_x-90-4pD_EAb-Hue0sEbHwlA2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8wEbPjBTVIjnHyLBRQ0fvpoFq7Lzzgl8doxYZgfd_fw&oe=6A5B8415"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cDJYQXNSdMQ7kNvwF4-6X2&_nc_oc=Adqd0RuX_ZOcwYNhy9Y9l-_zesrJkA0gzuk1zF_yOE5yOH9fDwMXqIcD5u1c6JDSZMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjm7cxM70G0mLD1sDxKsoLuXolsO-EP7jYYQPUkcfk0w&oe=6A5B95E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy5R9m7WIuYQ7kNvwGNJZEp&_nc_oc=AdoosZgibBgs8KNPNJqctrC7xqoKqO_Ek0qOu6LkTiYkYUMxFxMH0a5nHB1U6QBSF1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIyXPxtmOy93VwA4koGGQfm79NABu3mZOh5rOLuX21dQ&oe=6A5B6D36"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
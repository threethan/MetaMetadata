&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxaxtqm8c2cQ7kNvwFsuFVW&_nc_oc=AdqfZOS7621IfHx4tDnmc_8d7ete7qPEaKEzQJ9QhXtjjng_57sJHMzcj7DzUnAPoAw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKpBoLg_shzkOzwzRrIbWI02SBLZufY0Q7UeEsBTU4uA&oe=6A58D20F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0WpEI1E2G4Q7kNvwGmV4zE&_nc_oc=AdoJYsaowCka1cb0I-iyPNiloznpyGjXXoMNZItffR0ilsXsDBB2_F6zLfRcQRzw4v0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcyrC4BX_t6HTcI5J-XxYccF6NavRZFxqvvwiBoK3hyQ&oe=6A58F23F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH3n81IWJEAQ7kNvwHHcXm4&_nc_oc=Adp-ahLv1MhFtB23V9NDlOt3yRjhrhdyIw0dcoXjzfDpDZQjieb6trBbSFiryx2suhk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGQiu8QlCyzsAFBzV04oLb2xawAvfQ_gLm0sVMAkJ9CQ&oe=6A58E115"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04EQtMXojCQQ7kNvwG82uKs&_nc_oc=AdrvnByvkZl_lPmPRKI5Ola3r_8VGM6dmokC5qJkPLWqZrypNoMPUVSOp4r9c00VdeI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9aYPm9QJL52eq5MWhMqHJsXQAQGN0ZMq7RJB9spYk2w&oe=6A58F2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggwtR0rSJX4Q7kNvwFcTC9i&_nc_oc=AdobC-Qw4o88v1jlCZCoNA3y3KlBBo4qYuSvfflu8WZKFS83ZhkO1HV4mByKilRMJrM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0YPh7BVy2UF3bajQhxWxP7J1-sGknL80TG5-aKBh1aQ&oe=6A58CA36"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
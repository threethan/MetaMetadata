=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afthjx8IYAgMWXvQffl8qKdMvQ6phKE1SNLVXgPyzWAg1Q&oe=69A1918F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_y67JsFZA8Q7kNvwHRGx4a&_nc_oc=AdlmFLC96_7PiDUrUfys4DFmUq8VeAddeu9jUDR7vgGjOzJ-mpXk8Ed-6rS52Z3-rTg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu1Sd0yx8TqF9eiSdQZff2Q5vXe9I9HzA-zf7OLRfa2YQ&oe=69A1797F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I1bfBsQfOcQ7kNvwHAMeuI&_nc_oc=Adl1BlhIw8-v2rF3SWzPSpbdCT91i0DGdfP-a32PVrCXR2fk00v2g5Muu6Nza1offLQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvTxFjL6EzmQIyKnkREoUL12EjxGqK7k7sWBIbKLXRabg&oe=69A1A095"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HWn7Udg4cIQ7kNvwFx1QhT&_nc_oc=AdmgEKamWzco5FFUGbQuD95T5MJQ-zEbHPVyMQiUk1fAxaRFIf9uUhwchtRtWMCM2LQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftOZioTzaiERvW4XdDav_aZgKJjGGI50aVN9-UQH7PghA&oe=69A17A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPf0gj1ItsYQ7kNvwFiILYF&_nc_oc=Adn4RhrA5d7ZpzHR31kk8S2JUFi4tGnhtv8CuguW1RPHvehWfkvgK47XwMDo2C_gcsg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvcJ1sbUKel4S53wPOVJHhQdXYdmQYoL4QEIaalv5Wktg&oe=69A19BBF"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
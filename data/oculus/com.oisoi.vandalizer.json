=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv6-xnG3hRvmcnqZZOkiZKgVBMxjaQX6U3ZfWr8PVj74g&oe=699EEE8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfAdhO59XAkQ7kNvwFteqnK&_nc_oc=AdlHsDSID7Dgp_SoJUtzihWY_PE0SHWsM2n7BQeUqktroRkL2uab4GRtCqPCh1DeVT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftmjqfmSei7lZYOv1GPQmX-8gHeN2iNryABXWVGgjv8yA&oe=699ED67F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I1bfBsQfOcQ7kNvwHvYfof&_nc_oc=AdkXFW6ml1tyG6bYbfEWNg2dOi0TxuxnSVdJ9314m-KUFADkf3yolfmlBznwmgrF9-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuW8H2njBRP0RtHIB_Aiv70TQP8rzTaAzYx2tQtwiaDBQ&oe=699EFD95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vloXayGXwDkQ7kNvwFwg0no&_nc_oc=AdnqiWktROn1mp53l3mOI4khRw-KpNh0gY1t-bbhNO3R35yxSl7qyILHrJXZedekh_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfurQoOmodZIIczSwi51j-QZ6lIiS0qK7gCDoLOoa2YgEA&oe=699ED727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP96bLIj5CYQ7kNvwFOBGow&_nc_oc=Adm4vKvED3XMOq1Z4NjF6hXVA0aRJUUKM1oUa6g7_3FBs-mVBPZPhLuwDKakOVL2q_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvI6SJiXmbQxHg-yOFivrs-KQOBcXVmb4ld8JbzTcLK7g&oe=699EF8BF"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
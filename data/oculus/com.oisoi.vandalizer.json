=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXFM_1DYufXaFD37YW-yC9JbU_SLnOTDAxDH6smaYB8Q&oe=699AFA0F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jMOm42bTkQ7kNvwFCh4LL&_nc_oc=AdnzcUG2nQh61-IAGmqSKMwVpG2S3rWiJOZiRE_NRIS04-QGZSs1KpCiC5RWK6LXWuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUNKE8ZAmZa7ByrR4Nn9o2a5MK9tUGgeqpm-0EJT2WUQ&oe=699AE1FF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkMV_XuBKMMQ7kNvwH_66Nz&_nc_oc=Adkjt2xRL0WmvrtiOe3xv2D2LNNcG8ORtEU9OSrq0KturA6MrPocPq-GHFevva_iiXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvAdewkmtbyvXqW6ZnNLX2fmB05eWd4M-6ZsmQe3Ko2Tg&oe=699B0915"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfOG41JsWwQ7kNvwHxDy73&_nc_oc=AdkEMmIdNAdHz2D38iwZz1BUFcQwfE25LJbDVr9L5DKzOadTvgjbLwGXXE-vvrdz18A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucEmuhZj0bcIFy5J1DgbWJMv7rYwt4OX-T2uG2AE8D_Q&oe=699AE2A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbZr61s31KwQ7kNvwH9tu8k&_nc_oc=AdkFUebYlo1sK5gnbXejXJ9ubJ-SxcTEyVJRGlIGTY6BxZF5x2oxasRsvt3jWSR-wF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftkH2fAkQMNo75AYUqUWSHsXiFENHTWV_cd8bqj8PY_nQ&oe=699B043F"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
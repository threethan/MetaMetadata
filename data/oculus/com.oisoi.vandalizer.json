=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCpI07emqJeEharqC37s9HPt92v0SzPB3Ivp5E-pZxSA&oe=699C4B8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jMOm42bTkQ7kNvwEY-uv8&_nc_oc=AdkvdxypXSeqhAYNBxKtbgssSTgcI8CwKmjwrSMgB15NXsJm5ejFGgI_nUWD1JdE7JA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEihXZagQrRkynl9fLHYwVFiksklqZlzaqhf4kR2DY4w&oe=699C337F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkMV_XuBKMMQ7kNvwGPDjc4&_nc_oc=AdkCXfAIE6Ez2AEwngi4wIGbZhwvkf0WS4pgtli-2xl8dPsebAW23X3TagRfy0pX5Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftzMpcv1dKvf3vzZC35S9aaneFAKSGO1mlllZC2dIY8pw&oe=699C5A95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfOG41JsWwQ7kNvwEN0_1Y&_nc_oc=Adknkx7PQDKxk2DlAfcjubn03LrCHM8lTi_FHDf-S9YtRgPUkPLgPk4nTM61fKt6soQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuTx_04wyB02ivqgZ3Pd5fdxUtRwYHNZK0jtm3tOIomSw&oe=699C3427"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbZr61s31KwQ7kNvwE2q5fK&_nc_oc=AdnU3lHHySAHVm1lTECHyzL5bgGpOeSbMrc1xx-MQQN28KA0NlMxnhY6Lx5qU1iXoDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuroP8wkAL3tdhDhmRTJgy555-GbOUTXOHn-Uc9OT20VA&oe=699C55BF"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
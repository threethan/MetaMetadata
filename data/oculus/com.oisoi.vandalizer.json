r-mzzJU3RQQ7kNvwF1q1tA&_nc_oc=Adqk8sJxeAaQEYF_vNKmORk76CxbYcS_NTWJmlg3LV03AYfYz2RCS5c45gvUXWU15Fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vq9beKx7GP78EbISWuSeBGhfhDzBzvp7jOTwzEFeefA&oe=69ECB70F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAM0QulUucoQ7kNvwFlRzG3&_nc_oc=AdoutN6fWtQqd290s1wEeVjh2IaVoQB0SkvZO1lyMJj65NMX0oUQT2ghCflKaFFd_hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n8JTWj6NHGM0izP3gOiH6M0HWcxAHs8AHdl9cHleqWg&oe=69ECD73F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BaG_NBqknsQ7kNvwGmKsUi&_nc_oc=AdphizGiLJOuUan7b32FGjLIjp5Q3V_a0uDF5mkdpRY1OuQyk2CSlOPSDUPXc1cR1bc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10pva-1kcam08fNrU9abnAexCoxevnqGiPzP1n8pqq_A&oe=69ECC615"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJQY6D78HxIQ7kNvwG06pGG&_nc_oc=AdqBg34hqSQdclRstETguHs6vrCH1gzo0T74Ny-AN2kvdkU7aPVryat9ofIlyAioP3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q8CfAe0abs9yHkqTeGFsjHUGZa1vRcUDsO6xE-vVRyg&oe=69ECD7E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFwrZiCTj7sQ7kNvwF78Tme&_nc_oc=AdpeXf4U5TRiVatE7E-6I51ta1i6DRll2GU84V20O6hErrIxWJAZzssWEvNKyZhGN_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IHfrQy8-QFUfJhp234nBoECmJQwMQbNw6j4D4yPTBeQ&oe=69ECC13F"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTN58OsrkCUQ7kNvwFD7qTx&_nc_oc=AdpPhAg9uTyW8oPO02G3n5hY6qrxDC0bCrh-zfLUWDEFH6uxJAdAInqRyy8L0Pzh7Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0AwPqAJnvtZoD4uCUuAoZ-cC-QPrdP5dyo52w8j_0-A&oe=6A67528F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzpqAuu5nCgQ7kNvwFBd2nw&_nc_oc=AdriJD8FeMHDALuifDT7smaTDH88sDgo_7KH0RKH9qffNQK8wMcOaioAQIHllJrvsjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLrW1309LZCE9X1GBobiIsvvmWAtrU5UOzAye4XzU9Pg&oe=6A6772BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsuNlEaHxZEQ7kNvwF8s5si&_nc_oc=AdpBQH2t_1b_JsmIgOCfvRa_rOyvxW12qSmqIfPq0SA7mwCRO1FmJcp4cylSZvBmpHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-ij8YVkFzrTcrXVUWELgageO7BcZnOEBXWdhpmj9VYQ&oe=6A676195"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkaXnpdbxW8Q7kNvwFaqY_C&_nc_oc=Adq_beTjpbeuMBcTjusrcmQyvW3t4pHbb07WcFkerPh2KAajbuWqnqG_Al2FrYL7gs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSNmDhoPj6GsLaa-BFSzkeZt-V2sl3s2TetST3a3SJMA&oe=6A677367"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9nllF1CHAIQ7kNvwGK8ZA4&_nc_oc=AdrI7G3Oa3iSs3yKM53OvhFtVjlrv8DgfjjoB8ji1vBeuT7lTvDUhclOhdMUQsBp1F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1CaqWx2NkIjXXBRsi0Och-zR9RNNtGJVqAH3WuptMFw&oe=6A674AB6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
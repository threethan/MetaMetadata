&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvaGwgVVwAEQ7kNvwETaEVD&_nc_oc=AdpJroz8NDWvWheSp23wrJoc1HUNjAVhVIkv1r2qAsecuaXQBhGhS2oHp0Y6q9Ke8Uc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_akO29ZBx_w4FVnlmjAa28TtmQMU1zY_cVJ-8fIUe1g&oe=6A47AE8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ9wQzBQ2qwQ7kNvwGO0m84&_nc_oc=AdriQu2cULJgnGyOSsId8KdKH4xLx_3i-NuaAvJghhcgwVhYd9HuQX1joNNDSqn0aJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8li-iNvuhyfaptq05YLPSWRyAOrpSi-efaq_VW_KpQvw&oe=6A47CEBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ZklYnyOHkQ7kNvwEzWEba&_nc_oc=AdrLJG0BWmOJBNU3OSldloewls2A-Rk9XXWFS1eQ5ebEfq2gVmLN8SbKq6O6_pZQiAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EfsMET2BXeFdfGZiWkEHVHYbyRdhm7ata3FPD4dLWEg&oe=6A47BD95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3xnfkVg6zQQ7kNvwGP82Qw&_nc_oc=Ado37e1ZSyQ2PQQZD4jVFA9FWGyToiS6MMr0QLr9plBtAtS77qcg7Rk6xap3ZCZYct4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GRAMwDQ0hBO4G6GlEKzk43xod2tghP_MH57jAyfIZvg&oe=6A47CF67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSJl9QtsJ8sQ7kNvwFGhoDk&_nc_oc=AdpxOr_zjDJaMO9NjqbjNbIBcLJ24t5QzAEkjKhXzsVyPJErEgCMMfLrmWVJIOhaIZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZJICGgvM6wrI3rCCZtYcbea3LcRDtMNmXtuC0DqmwBg&oe=6A47DEF6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
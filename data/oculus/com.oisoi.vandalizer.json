&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1ufyPUrVn0Q7kNvwHurjvC&_nc_oc=AdpYKnLddmINpNwDlymaZHe7dJYq8YbHujJ6QBUthVoRgjx20pxxXfojWA_DeMUL9vg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqNWMRmhaSJYjrpoYVPen_ID_1bvy-T6l-SYVBaZFecA&oe=6A4A518F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ9wQzBQ2qwQ7kNvwH1xcNX&_nc_oc=AdrZfSvrLvJhmacKJw51I5Z8xTGVbIUswih8AZTcbs2PEXY0PuxFgVyXBZXihgZ3IBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5BQc6i2WofEYFbTmF-PIv0zZtAArM68ZD25Hd4LRGjA&oe=6A4A71BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD7d-htDtxgQ7kNvwEc5qR0&_nc_oc=AdoCiw2uONMrThT60X0b0q7o7yRXW3LvbGC6oXy1VSL7xRKZPvkYzcwN_0S1Dp8BRl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCBJ0htt7jqTn77h1bBE6v3zzGtrEj5bumVhwURGMCgQ&oe=6A4A6095"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0dEWK1aqecQ7kNvwF0KlrV&_nc_oc=AdpNWprr4wnHjpv1EDpFo5QcyC7ipR_cKsL_rkFvavvZx0mrIt2tKq_uENiNKSj46-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP0R8BxYveksUzLpcBJOUVoqYv8j1g-KJSXVjXU8yrnw&oe=6A4A7267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln0ZdoIbHP0Q7kNvwGwh24e&_nc_oc=Ado5q2RvaYJ_kFtDoXgEc2232OgAp0m6U9oeQu7nPJ_LDOuDNO7N1HQL8p_uvbJ0oEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX95tRyrTeKL-TnasVYBw_mGW6y6QeH_pvrl8MGn4kyQ&oe=6A4A81F6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
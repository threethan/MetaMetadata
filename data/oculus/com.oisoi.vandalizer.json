mCKxn1Lm-oOHEESb1Y_F9JEqkrjQ3Gv0N1Og-3ulManN8amkPltVcW2ttAgVMigZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQEH_W24GAUgiRBPXaCwRTn_Bk6j6vLGL3KJjnCaVaMw&oe=69B0120F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9TTCwh_K14Q7kNvwHsaTiN&_nc_oc=AdlOfng8_7LGzM6pE24syRchop9VNynhjhv3QwzHtObQ6y4kL6IKrSmENVmruSFd6h4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCqHhXMAOqsJuZfojUBVEeRQnN4MnMnBgmMZejN3dvvw&oe=69AFF9FF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWLOZWkV6h4Q7kNvwE0LjS-&_nc_oc=AdkizdWkzTKYV2D_RZB6zid-rV4wzXwzojPiwMHXRLBfEYTZwM1WqAm8Yx-wftkODus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZsuMKCEXpxl318kDJkE8c0TsS6OS1CUqAcqNFJgVohA&oe=69B02115"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwOHvmUgFzsQ7kNvwE0AITX&_nc_oc=AdmRHaXMjZrDggkBwD5i5mxVjyhTIOryTfrUWM_k3y4d601Qb14FliXBj40tvYHYTn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyupUxzkFthuOtLIsVEpaV3J4pgeYpRA-cuBJWCaZy7cQ&oe=69AFFAA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd-mOfHylDIQ7kNvwED-IUO&_nc_oc=AdnoSaBpDeo9BsX8gjeZy7meSi71RQ4wcs4JjeloMQRpVGrSKFhU3GKst7hzU2SCCmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypjAxEATS-7LRZuR1Lz3oZE3h4YPdPUah44CucxMXT4w&oe=69B01C3F"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interact
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN6xKadczzUQ7kNvwFe1wzz&_nc_oc=AdooJumRXSMcu8xZJ_6bfJ4hNu5IH0R_eWBjUDGveZtWLKlz9nkx4n0Ihdn_erxfi50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClm7hswjf-ix9GiN1rUDrKkLh-oW6c0W4uIHCGBWXsvA&oe=6A523A8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5hweFEuonwQ7kNvwHQf_UT&_nc_oc=Adox3b9C8Q9OOmJs6i9uNHAqVrqgl9UbPFZH7SkYMBhtBPdsuIypJWx5u-3UoCrPkxw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjsqnp2OuVy7d64dEe55CltGJjNyX-I0CBjNn1jsRhrA&oe=6A525ABF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6d8EPnnovYQ7kNvwHF6gpR&_nc_oc=AdoChXdZk9Q6uRC6kHYx-nFMNQ9Uptf7oOdFxFVACKoxlf1_OhHCB1m9Eln7Tv1zYD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVEtEumJw4LvSn7rVoERa8Oq1L8GpXxcKqmqJKaMV4GQ&oe=6A524995"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMKNqso_N2wQ7kNvwEqye0I&_nc_oc=AdpDpo9BnBXmBZ5LnvqUuXjHzcgFdCI-GqvFsmpH6UbEBQeOUZ2MiitlMQYBMdJH4z8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3YHIT3qEVuFk08Xk5opwdDLTApsZeXpcJV6LAAxcA8Q&oe=6A525B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbVTOP-KcCkQ7kNvwEuhfLx&_nc_oc=Adqn4wfFXyqfQWGt7-c6dbKmsxM_LXVMM5JWwJDE4dV3tp0J_fTR44PgjR3TnsY3-JI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaSlfFxX7HrK7AzKA8UQmJPLH2zxn_cKQcrdJmiT681g&oe=6A5232B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fye3iqgKBoQ7kNvwEEK1Zq&_nc_oc=AdpQj5XDlNqkO_neozAXMDNaByF89SEY-uyQwE5RVrLrIdBTloGbI9xpMAQRiRHzhfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rmJCVK4IJXi3jqnA5i7mDUP2SfyWtc35jsSsjboKgBw&oe=6A450B8F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfmm5QUNRg8Q7kNvwEOTtRU&_nc_oc=AdrhKZuPwgGx0wPxmNSYGhivGDLv73Ab6ReD2e0qY2vFxQ3oBjqzEQ3zj2e0Lnfb3Bo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H2CSkDJuFXtMF-RHUOl3w6l-njVrQ0fD-uprRusD6ww&oe=6A452BBF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ZklYnyOHkQ7kNvwE-FfvN&_nc_oc=AdqDPeAbJcKUxvTggBcKgb7yGDkcovGW7sWFBfTl0TaM5Pz96v0a34lG9uaOBr31Kxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z459thzgqkDG-d5NunCO8QIzIAAW6Jrg3YBEUgAEtSg&oe=6A451A95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5ECjOtKHcQ7kNvwHLDCK-&_nc_oc=AdoVTT9yO3NCF1DjeNFBgDRzqp9mI1oxTfxvyHL0w6eId-xsIlBsJESKgIidRxOc3UE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4V9haS6QZwp0TD2N9X5Tgf7K9lII4QQrODna2aAWx0Q&oe=6A452C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N773TCV3XYoQ7kNvwHzkU7V&_nc_oc=AdrA5oN5Ivtk0Mqu7aidN5S0_HLMojm6FqogcMnJgYHmfdiayjidr6Oi3aLXrurnNjk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h9dRiwJ8RsYM_WYKNsdQfCXdR4jAss8Mx-ieZid36mg&oe=6A4503B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
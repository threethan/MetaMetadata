&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvaGwgVVwAEQ7kNvwHlDifr&_nc_oc=Adq15HX1T2olJ0RgYgMzKhdxzt-19QjgtzhDGvtww55Eh9uf7G0mJTeOmD7g04ZOt_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjQYFSei3Ipo2zlVZONy94PCI9VJVpfV--qL_PIQUcRA&oe=6A49000F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ9wQzBQ2qwQ7kNvwF4fi_i&_nc_oc=AdqefcQ2-2DXxz1C4HAdHEQJkFtY6F6usdbI9wNwvVb9WJ9GFdIB-j4XlBKlCzKoXXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV-HoDYm-ckYJvBe6kAp2E_X0GKGiVKnfp6cRoVK3ENQ&oe=6A49203F"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD7d-htDtxgQ7kNvwEtyepj&_nc_oc=AdqXRnSEfvfTqWjlMVHPre1_wFrJH1y79lKKTN8fuGywQCu1UOUfET4v8Yq0pepxlR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN89qoMPh575Vj4ArGglY02MHRtgeny5d_KfUaB5Lf3g&oe=6A490F15"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3xnfkVg6zQQ7kNvwFCVc71&_nc_oc=AdpYT3RgDBYHAXIeSmgQAk8qvj3lcj7S3mstl_tBRfxu-5vuvHVka7UQenJX5F7fUQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkkjJgVe3rQoLbBmkEwUXqRDCaToMAgAIO9eT3c4aomw&oe=6A4920E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSJl9QtsJ8sQ7kNvwHuG1lL&_nc_oc=AdpWlZYtwrGdaK0ZS4kFISNsBG3ve_Tdhu7JByB9fMEyngkubYTl08-uwx3HopeKKEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwSC7J1KNr3B9GkH86_ad4eZ5COxAh-KBCzEokL75y3g&oe=6A48F836"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afutjmm6k3CAUYJcSH_MM-olC07Yucny8OqFQ6gvhcq3jQ&oe=69A5860F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjFqzdc1DzgQ7kNvwFA6X7o&_nc_oc=AdmO3Qr_zJIigbZx1XP2zZ1MF0y2Q4wi_PY6yjq6C93fMTpWxfQSVB7iuYyVmkyfFLE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv-TDX3egMN7E_xI275-_K0_M5ykjKt8RVM3KLD8ilrzQ&oe=69A56DFF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTcyd5R60EEQ7kNvwE87tib&_nc_oc=AdkkR0spZglXfSaPHVgkzOtlJDuMUE_nf0oyKBK1OU9ZXouZI1Fk8HucBAxIe1HEWro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftBMYV87fyGnstuNpmsBII0htxfLKUmKQiKebfhZdfMcw&oe=69A59515"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoDTwUy0qwwQ7kNvwFB6Api&_nc_oc=AdmD2kE_qL6FSq26pZPeB3GrM3drHl-Pg_zKHxzM_bJJ72fiMGW1OB3fF2CHkOuk6og&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvl0NI2iBatvydy-aopJECV5B-XW1G_Xc0uILSu9CRjjQ&oe=69A56EA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_variant.png", "id": "2274680802956808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821725_2274680806290141_8699880522610858530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4n_pYoB_FwQ7kNvwFL2OJF&_nc_oc=AdlodScyLH15ida2Da3z6AunTWLzi4m0p0BED670PxL525NOvTOHwA6h35C8Im6ySZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft1YNzM88cqt9Bc7DtNbZw1ueGSpjkfUe8-QMt4J2xWDg&oe=69A5903F"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "king", "spraypaint"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25257330413968650"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
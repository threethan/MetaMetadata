&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yxaxtqm8c2cQ7kNvwHH81p5&_nc_oc=AdrliNmSxW8Z7vGMozwyDgw5P9zroct6TXFF94qJ-94M-8onJEx8n_G6_h-TAtvUfWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfBTAPNHga2mDYH8jT9FODdklvpMJFbSVTbZkg-l3gjg&oe=6A57808F"}, {"file_name": "New003.png", "id": "1322544156339843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1322544159673176_7648731647676096270_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0WpEI1E2G4Q7kNvwGJ-pFH&_nc_oc=AdrxzRfciyiXh_K_VKNa5Wuc8-OubFBLMwoCojmuO20MfJjvvLoOVLk3c2SUtYjq8as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9pDAbq79rGvNnGPQKGkEm3IC23DH9Svh_h7-8LqQ0fQ&oe=6A57A0BF"}, {"file_name": "New004.png", "id": "1811929292803526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1811929296136859_5518155757760850570_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LXMy2yt63oQ7kNvwHxY8yR&_nc_oc=AdqJdgZ04QsL8n-X4v5tdwEBi8ixo7yVcOyikHrZ9rpd1NeIxSdSm6ky1bSB95b5V3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6y4udZdr8liRaC5GgKNqSx32axJvDGkmsANunaNPLhA&oe=6A578F95"}, {"file_name": "New001.png", "id": "4278943055675067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_4278943059008400_356425530561127060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04EQtMXojCQQ7kNvwHlkQYp&_nc_oc=AdrPlhEc0S10qj33xXnkzrnY81-gEeLnKmoBSHpxZdE1RDcBkmOajyMBe5sKbeeD-To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5GcRCga_TDLdgvRMHeHLnN_qLIvi7Cex7bw63aFDrmg&oe=6A57A167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491819323_1613791439976645_6396553974257419755_n.png.png", "id": "1492810965566852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1492810968900185_2412099548680726608_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggwtR0rSJX4Q7kNvwHv39QH&_nc_oc=AdoDBFfGitXDlm1XtAzB77aozXF2nSV7_cq1CMTHqJBj2Dv_BYkBYbGhho2JMr0o8TU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZyB4-M4fInvsb4sqFjW4dq2tgVN9nNS8HwgNHQ-Lvpw&oe=6A5778B6"}, "display_name": "Vandalizer", "keywords": ["graffiti", "art", "paint", "spraypaint", "Creative"], "long_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported.**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. You can paint trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable. All the thrill of graffiti, with no risk of getting arrested.\n\n**Climb to paint**\n{1407889617570431}\n\n**Unlock absurd objects**\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. \n{1214344384000922}", "short_description": "**\ud83d\udc80 Heads up: Only available on Quest 3/3S. Quest and Quest 2 are not yet supported..**\n\nSpray paint bold and absurd 3D objects with real spray tools, caps, and colour control. Climb and conquer trucks, walls, giant skulls, dinosaurs, and things that really should not be paintable.\n\nYou earn points for spraying, which you use to unlock even more absurd objects to paint next. All the thrill of graffiti, with no risk of getting arrested."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vandalizer.xyz/vandalizer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.vandalizer.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
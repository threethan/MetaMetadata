829165_1745429309770602_3173616434644146412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWqxdVHZyW4Q7kNvwE1OIq5&_nc_oc=AdqyGr4cvifSagUWzZipkupJjvisNbZD1xHpO7UABZ8qoLWB4Ol0huIEB9d_bI-H7xQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ypp8vX9lUT1UqXGvsxxKw2rO9vk9yok4ouASQFg5Dlg&oe=69DCE2AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_24bit.png", "id": "779451085235427", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_779451088568760_4820113829668856600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpAMUXbXS9wQ7kNvwGJUkMT&_nc_oc=Ado_uhHmKCkJjQ4Kw3MtpRocf2mQPH6Rk2asrY9DtbvW5qxCma9HuajMTLSsGIkaO2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rWnELaq8qfQwiX5jSVq5ag6Zl54bR8iCMhUsLQUhNJQ&oe=69DCFEF1"}, "display_name": "weelio DEMO", "keywords": [], "long_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line.\n\nWishlist the full game at https://www.meta.com/experiences/27240704588852632\n\nFor suggestions & bug reports head over to https://weeliovr.github.io/game/\n", "short_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/wee
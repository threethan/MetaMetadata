829165_1745429309770602_3173616434644146412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMChJPC-agIQ7kNvwHkQ4gF&_nc_oc=AdpZLQZMFi393-SaYZc-if6rzMsANrj6blkFl2W7NkOXJbp8ErOP6tDUSmzFFCVIlA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrXWTHOIpFNNtI5UHiojKjNrtku-lWSEsiRw6o8ElQAg&oe=6A67502F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_24bit.png", "id": "779451085235427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_779451088568760_4820113829668856600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-aJqzK1uC0Q7kNvwE7r6kF&_nc_oc=Adqk34SP7xBRSq_d9AOosSl4L9u6cpnz88NWBQzhNEbVaIZizIKyDTUWEValuEcozUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtODSGei-jRdpq1vyLrp8vWjCaCQJFv3LgVJg0V2j37w&oe=6A676C71"}, "display_name": "weelio DEMO", "keywords": [], "long_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line.\n\nWishlist the full game at https://www.meta.com/experiences/27240704588852632\n\nFor suggestions & bug reports head over to https://weeliovr.github.io/game/\n", "short_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/wee
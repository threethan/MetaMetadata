ile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/weelioVR/game/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "Code61", "support_website_url": null, "website_url": "https://weeliovr.github.io/game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "26225423280428873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1859655828771157_3077553249014050333_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b3SYi9m0LUQ7kNvwHjsrF_&_nc_oc=AdqDWB1Cm2vmlrlGJVtDo19gZ4UxaRM2MCn3lXKs56Ysgq6AJgDbkS-guyh9uidWaq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrthAw4JFfWyzxQf5lh0iXCII92LOJWy9uYxXx-5kgYg&oe=6AFC63F2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "weelio DEMO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1772726520, "lastRevision": {"nodes": [{"id": "26067952236175979",
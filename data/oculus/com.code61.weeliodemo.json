829165_1745429309770602_3173616434644146412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqo9Bu8J7qkQ7kNvwEv4EOp&_nc_oc=Adp9Sh0uit8d8FR-L9j4nP0wlP3wiLOqgXgdg82o4jWqIyeDppzcPSht8_7LCJNvmzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjfn_7n3JaGCFqG8c3OxPhV2yW-o26Bn_Nas3_LSfpag&oe=69CA6DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_24bit.png", "id": "779451085235427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_779451088568760_4820113829668856600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb8Tysg2xokQ7kNvwHgMpTc&_nc_oc=AdphprtfQ2cOasEDZXVMXtdjxEQcSc9ahycXgVtOzXI4d9ajxMe5tF9wNG_jzNM-omQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR9QtCXb4m8WxU4do95V4jBmry2BjcIHOsjHUNPwF8Nw&oe=69CA89F1"}, "display_name": "weelio DEMO", "keywords": [], "long_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line.\n\nWishlist the full game at https://www.meta.com/experiences/27240704588852632\n\nFor suggestions & bug reports head over to https://weeliovr.github.io/game/\n", "short_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/wee
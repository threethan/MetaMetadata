5/491829165_1745429309770602_3173616434644146412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ0VUmCHvMwQ7kNvwEjDvWc&_nc_oc=Adp3eUcyFjVviKOEUurlhLZXcLOWXSB6-ZDQILxwEvUnmYoCJqsVYKHe2XqNMFwMmeE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eD6s7Gvyuh482WbRRkwA8NJVYh4MUlphZjK0d4lD9FA&oe=6A36C0EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_24bit.png", "id": "779451085235427", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820887_779451088568760_4820113829668856600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EM4H3YTPw4Q7kNvwFB6TSz&_nc_oc=AdqB-72wZLZe2qwhM88QLRi1Wgvm3QYuMQAbSbubGvlZLWo2QB1CMbaIwi-wMF8SyLc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1c0Oeu4jgNYc31hppSb_9ZSlknlmGkGtIY7LxZP8Uwg&oe=6A36A4F1"}, "display_name": "weelio DEMO", "keywords": [], "long_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line.\n\nWishlist the full game at https://www.meta.com/experiences/27240704588852632\n\nFor suggestions & bug reports head over to https://weeliovr.github.io/game/\n", "short_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.c
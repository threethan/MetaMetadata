829165_1745429309770602_3173616434644146412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvJf6K7ABzwQ7kNvwEPGViY&_nc_oc=AdqlxrvP50N04nH4gsV94z8b_9US5TMKLwRhGlbtE-XVpIy_W2xsarR0Nll46fkxczU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuEp6Na5dtAMkI2ojXeBuQrG0HGXYWevs4WFDwBJBomA&oe=6A65FEAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_24bit.png", "id": "779451085235427", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820887_779451088568760_4820113829668856600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eaaFLJQ7akQ7kNvwGjJhf0&_nc_oc=AdqsPZ9bXmuDdXH8BLiukGmcNRx8Tw_fmz4-au8UvE2-4UnYsUzEelBxcNYLc6Flr3M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjlgBFLnJOy0Z8WSblUXiFEp5csIrKRzqVeyv-cwIrZg&oe=6A661AF1"}, "display_name": "weelio DEMO", "keywords": [], "long_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line.\n\nWishlist the full game at https://www.meta.com/experiences/27240704588852632\n\nFor suggestions & bug reports head over to https://weeliovr.github.io/game/\n", "short_description": "This is Weelio (DEMO), a VR experience designed around the thrill of speed. You dodge, strafe, and shoot obstacles along the way. This is a game for everybody, regardless of your VR experience: intuitive controls and no acceleration to avoid discomfort.\n\nAs you traverse the track, you strafe left and right to avoid obstacles and shoot at hostile drones. Manage your health, grab power-ups, and get to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/wee
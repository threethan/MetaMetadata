2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezSeXcwn_dsQ7kNvwEpkw2l&_nc_oc=Adno-jgsvtDw5Mz0yVxqNEF5IFUTV2rgMGSEmavlxfuJRldkqlfMrig9BQqePnpj6tY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuEMJ24KE0qgNhYBll65CVPWXmml186YpUMgcDF__e_Cg&oe=6998611C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXDGLg3-X6IQ7kNvwELv3PH&_nc_oc=AdnsRyxpDz4lf_0zmsvZpr5ed5xdMeS0WoGUWtpAT2QIR8MgVRh55b_pejDLl6yD1BA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftj2sJQHapLcS9ytmbinndQsPR-5Hh3MO4WKZynTG68IA&oe=69986C9F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWk0tmNZRcYQ7kNvwH35Ppp&_nc_oc=AdkfoZYn7inkxuLsIeDiLhNOG2bd9tcI1HAmHkJyDNtc79WDxfP3tDW-gAAV707D8Bw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft8tFmdnfY-zA8W3YgH0PuY5D6tYCGgxyJp-RbXjzBmuQ&oe=699859DE"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypMa_mhbDqYQ7kNvwGBqU4g&_nc_oc=Adm7ppnIni6Ayoiq5AUjD0ajqxFX1GznB-w8pH6ENCYR41qIS0mOOxA9kab549RX6cE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvO-RHijZTS7p_3LT7IgP94Q4tUhwZlhtEtZsiSUzRQYA&oe=69986E43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9hHRn-c6FQQ7kNvwHXAFQw&_nc_oc=AdkTLcJytAvkI68EfUmGYZFMqOce4nqBGSv2JeW3cnaXXJbhBPT79i1ms_6EqLesY1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuOZdSKXyFmi6uIaQyq3yFDpTiXazIfZSujQ1_xHeXu1Q&oe=69983C38"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
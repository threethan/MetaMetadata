2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMSj_GCwvRcQ7kNvwExQULO&_nc_oc=Ado9H2M9AMqr3WHmI16W_lt_c8-Qp_bJURZ6utt8oyG7Uzx0lfb4L5OOA8hwHEY6J4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3pR_v3PHlk0AGUiwcwv65KqG9rURfUcBQoiewHwkIxkw&oe=69F0B59C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsUCkpAS_ksQ7kNvwESoje1&_nc_oc=Ado6OSu9I77eFVR9dcsElUuD28FKPfr-BgBnh72lQTTGXr_utevL1J5cc963UzuoSWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af32XSgCuWpQWktcV6SYx8RHOCGAssGE9et-hvQZq-pJ0Q&oe=69F0C11F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHTBJTtEnp0Q7kNvwF03PdI&_nc_oc=AdoOLnZEJjzazECLG6GRWyuXKTAzWM8fPjCIumvqImuoRR2DtFOG0vYZUghUXWRevTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1V4A2YNY8auW9qPVpe4x_F2gW8XoT5sHumzRIdtquGvA&oe=69F0AE5E"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj9M8uASCUcQ7kNvwFXUz_k&_nc_oc=Adqi1O01eWDQbnLJAMRcMNMHDE_8p-gyGn2uGoJwDySpYe3Zhsp9vtANJMQJWxXtQAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2D0eMjpQxjpUaYh9fiUt7MgAfvtWFmLAKvuyFWiTsVPg&oe=69F0C2C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ws26doglpwQ7kNvwHL2UCz&_nc_oc=AdqAW2vR8UiDmJOsmtYRO2_TUvHN0ZAsCXNqod7PrlhuGuhRJGXzX2HHC3KE6lTpfWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af01S_0N1cswVdjaTR4WcKfdUQuEXLK-D-BRC_XVQpqOsA&oe=69F0C8F8"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
cdn.com&oh=00_AfvFXixL6hC_YIQdJ_1k-VZc3M0NYCRwxDcrpPrljQ4UXg&oe=69998DB8"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
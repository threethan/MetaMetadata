2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o13IlHrn8HEQ7kNvwEZaJIY&_nc_oc=AdmxTPpgx34wdGWmP_WGfP9w3EDYnoleWKIsfEE494cT8MKdepbY0fmgvjsjZFhuHGs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv3atO6qxPKzzB0OovVLjoQyqw1M52pQhUGCZ97Lmb2OA&oe=69A19B9C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHJ3uAcUKQQ7kNvwHyfLUg&_nc_oc=AdmAbC5EEHH01yfqyhw1BIOZSxLUjbfmmiGQu7TcOPLeXyVVoDVDU4k7EnoOF--nrlQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsp5SWhXPlDYgnOyNMoRYtdsc1J62SID4O05wl2O2L_bw&oe=69A1A71F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiD8ab007eYQ7kNvwGd6vDy&_nc_oc=AdkDsPhM20vk5NYqG-5_m_hQayyRGf6w1Y0_-pwjokbeeCulUZBkji7idmLKljW15Nw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfswySGXf_MAQHRgWDycVyBJJau2eOARMWrMrBGDwRjBrQ&oe=69A1945E"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW_QdLVPXcgQ7kNvwEI--1e&_nc_oc=Adm7ZsPoqDUIWnVLNo0L_arEx175pX-uISTAu6823kQRZxURhXZMi_cj6jwYa0thtXE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu1XY1o2daVQcdP5pcljRag6YYDHfCmFDkyZwJW54WrQg&oe=69A1A8C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F6DjSY_C3EQ7kNvwFntN78&_nc_oc=AdlSuu295f5QA2nyMrb5Zdc1eVG0PsCfJQWLwA2VxkqAnIZrt5NiR_-g8XurKWX0HFY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuHrm7g1uZv1Pe0RHkRQci7XBQVFlI0c4WmZkUnBBL1AQ&oe=69A176B8"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
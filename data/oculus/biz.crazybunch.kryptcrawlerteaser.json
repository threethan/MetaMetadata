w7fw78W1HNFewz4e9ELny9aGqQw&oe=6AFB4A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf8y6DTmfegQ7kNvwE8DON2&_nc_oc=AdofR8eQFjYg-KncWZMog64TcmbxBiP9hbChliZ4wkO_2ZIXmdUZ-1_03HFBFOOg9Dw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr1tTc6Z12hO5q2sEFaj86w-ZtVmMcNhTReY5kp-s9jg&oe=6AFB17F8"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgame
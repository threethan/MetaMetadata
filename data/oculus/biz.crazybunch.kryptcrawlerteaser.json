2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF8BizRAsLwQ7kNvwEZ_E84&_nc_oc=Adn4NkImJArnZ10_4gIeP8MuoEzDy1wX5m1fakOiOz61o5nvAxhgqwnkHONsd9IDbiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvmM5B5MWIUpYmfyS-Ady2JNWAMyDmLu18qW6U7TTSrRQ&oe=699EF89C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHJ3uAcUKQQ7kNvwG7MtI8&_nc_oc=Admjp3S77C2dTthypey-LPuEio-2MjFeig_4jPhX19Z5Qz0vnQqkIC_55TBzVg-rTo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvlqg9Ukd-wT-eYjWzVbGggtyX1S7vpFd4rZ-C7So2zCw&oe=699F041F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6ipeIXb1DQQ7kNvwGmcSSA&_nc_oc=AdmDavEDLZySt24wWIz-mNiyghrdPOd1uaeesuVGFbxGTB7Db-8qmXBycnitECkPOds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsX_6QBL7hIfsfBb318fYNsLhIdczREsQ9k6Pl3uCxEzA&oe=699EF15E"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H11gU6XK30Q7kNvwEQzZWM&_nc_oc=AdnTxMqAEzmnSI9MtbJ3j692eS-RfhNDsl1FH_cSSQWamlMCzH1GJ63VP94UxdZBV4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuahD8YWt0uvXr2OkmKoMv43360_aiy2fNG5B1-rogllw&oe=699F05C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFzybtTKxOEQ7kNvwGw_VD0&_nc_oc=AdmkyhcmA7LQl_2IyqEABp-RYIEi70sb0Lz12FACq7yYDMx4BoDew-AKsAREt6VME_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsypaQWs-Zz6fWduf0hSASKQxY3ZdCpCyBU2HB4oBLRbA&oe=699ED3B8"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
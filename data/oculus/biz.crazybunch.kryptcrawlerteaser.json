2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF8BizRAsLwQ7kNvwHzCaUi&_nc_oc=AdlIYqxTEVbbUlRVf8ihbPBZhCoQVwC36AS4MtJi-L18IG7sAjbnJgf5cxJjH-uPIX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvT9hDQkHR-tYuQSfkBxzhzVZFmEhbthrIRrSFmmGsp4Q&oe=69A04A1C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHJ3uAcUKQQ7kNvwGtm8TC&_nc_oc=AdltOK9jy-eYiv4NFBG16DIt43kVjiecAabSDiKoj-t9bqEJmDThwGssme1kt0jDyuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3dcTATHng1_YXLEXV0ZiUQ35Yo80XXgKcMnlDLeYmqw&oe=69A0559F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6ipeIXb1DQQ7kNvwGQ5kQQ&_nc_oc=AdmaBFI4V23DYQHd9jtfZ29G_HzdVUuoF11-KfLZgqmKCKMy-nf_BPU3Vq7ZzGndlgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrDd-1dxgjUCeIeOqtKh4x_l_lSbJmRNJsuqpc6pzgkA&oe=69A042DE"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW_QdLVPXcgQ7kNvwFo63hl&_nc_oc=Adl6oiQYaEtPFQhgtWWLs2vq0SOMHFKPfG1FK6mk7GiLZwFaXE4jKNUPpTdOUaLsgbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8TcXUSh2WSDMA0KInUdb5dIhgUNv_3Hi2YSIkWckbqg&oe=69A05743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F6DjSY_C3EQ7kNvwEVWPSE&_nc_oc=Adn3xFdDPU_rcSLkiNKSDouvkVBb24Kjev739w2eR1yQ5QKD5hx3b2fZ58F_B6KWljw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvij3jtvm9fY6IvJHT9YE7vRA0AHNnvVGsYnUVNqCjR6w&oe=69A02538"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162678_113411822641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z89QoM12j8Q7kNvwEGYAet&_nc_oc=AdnEvPpP-KDAxgClzoG71IE9asfYEvqB30xpT_BCcgzticxFphf8JyYiExl8k2XoyjM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSosbRK-Le9K2rIusBngkqYBXPe4vQH3BBFJN75nsCJA&oe=69AAD61C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXlIzmeWxyEQ7kNvwEu35Om&_nc_oc=AdnJ2T2_WUSQgaiIYEV4VBVRgUMrbJHYjNMRQM-9Tc4eVBrY3flgXvL5nmMBjqj0i-U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzegB57ZesIpeIi9hDiKIZpf0hz5igXZUenRtfOmVb4aQ&oe=69AAE19F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJIpsUUGPm4Q7kNvwHxmikg&_nc_oc=Adl6uEWgANbbPygi8_HCiVSCgsvGQTya0Yt8D3yZOqWSAVyszRPuMgyP50cvAbJ_A7w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afztibzp8v-CLtlIqZyMHsJ6c6BlYuLGL6Cc2d9e94mZ0g&oe=69AACEDE"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjX54CLxT4AQ7kNvwE3z0XP&_nc_oc=Adlput9oOUKLHG19_d2FplJWvKM3Vyq11ZdFQ3TdvDDWSh9T1kHhxgXP4bZRuUVjfyY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2srbEYia8EQSQOOdV7y7UYPd-MrMS7UmdaM0ARXMPnA&oe=69AAE343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yvw78sjnBOkQ7kNvwEBNOcu&_nc_oc=AdnchKLr1HsdEavMifLQFT24n_3fC4vGcC-gN0AhNgFycEXMWXowSiy64R3spQOCc0w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPhPr9C0aQ7uxmMfJaOOQvpL6cxwtkL_AkiM0hEfRV-Q&oe=69AAB138"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
2641465_4487361511370522624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF8BizRAsLwQ7kNvwEX8cn4&_nc_oc=AdnU55sYXWaQEXyi_I1MRebtUM8-a7YdzN1pervuS2H_Y8bhojB5_M9lmUdZ-d5wGXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu51I2EDMd0Emy3PpO425DmD_ODIxFa0g1NnrodzkNGKQ&oe=699DA71C"}, {"file_name": "migrated_image.png", "id": "629294774298458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162735_498725977137821_4266948398239711232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ1a_39UhkcQ7kNvwGidzIt&_nc_oc=AdnQv1gI6KwNwG6v7AHlNa5i9DxZEMNDCYtXsMGDXv5pUvqoYAbcpoeg9v8-cBe1h-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvI2cFwTKlzlqjZr653Dt1tBNV_-d8H__XH5EO0fg5Jg&oe=699DB29F"}, {"file_name": "migrated_image.png", "id": "248654062832297", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_124576561485841_6770350059004362752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6ipeIXb1DQQ7kNvwGYOE8h&_nc_oc=AdlN8gVvEw-DWJXr4MmiH6Vm2f4S0UuDTVkp3R2fBcEn8gJHW2h4f-X2aIt32RyNdHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGffq4RMDmaJaYVO4gglfXYyGBZpfLQmoM1BGBV0aYbw&oe=699D9FDE"}, {"file_name": "migrated_image.png", "id": "195359681898712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162717_1912279389033061_3284699848774778880_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H11gU6XK30Q7kNvwHQcoZe&_nc_oc=AdlHGw79WOem_G8vCIHzhF7jpxnQPhrjIpR9dPyffibmXus1I2RXPkDVKmUvKa1cz2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvF-dNo0j8r_x1imxj5--JtL76DgNuur9ButIdSj9ApwQ&oe=699DB443"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kryptcrawler_boxart_2560x1440_Logo.png", "id": "1736571129969647", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_1736571136636313_1925396064559431680_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFzybtTKxOEQ7kNvwFaKa47&_nc_oc=AdmjBy0X8jGRRMaplXtQuD86O51kubF6bZE83f5dZHKeakejv47l8-9sHL0KSGtKfc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsgjRVuwTAAwYers5N0dXHrL7QY1wyNgagJDFSwJ4rR3A&oe=699D8238"}, "display_name": "KryptCrawler Sneak Peek", "keywords": ["dungeon", "action", "adventure", "gridbased", "archery"], "long_description": "This summer, KryptCrawler wil bring classic first person, grid based Dungeon Crawler gameplay to Virtual Reality!\n\nA combination of turn based old school gameplay, real time combat and trap evasion unprecedented in its genre, combined with the immersion of modern VR technology. Experience dungeons like never before! Let\u2019s just hope you make it back to sunlight and the world of the living \u2013 there are many rumors of simple-hearted adventurers who have set foot into the abyss of the crypt and have never been heard of again!", "short_description": "This is a Sneak Peek for KryptCrawler, a classic first person, grid based Dungeon Crawler  forVirtual Reality.\n\nKryptCrawler delivers a combination of turn based old school gameplay and real time combat.\nFind powerful weapons and wield mighty artifacts to defend yourself against poisonous scorpions, hungry spiders and the\nundead remains of the warriors who have come here before you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://download.headupgames.com/cdn/Headup_Games_Privacy_Policy.txt", "developer_terms_of_service_url": "http://download.headupgames.com/cdn/TermsAndConditions.txt", "publisher_name": "Headup Games", "support_website_url": null, "website_url": "http://www.headupgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_mod
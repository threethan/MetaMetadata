Wybbdf1gkKzDrai9trJ7-_Ewg1QKzmGg&oe=6A897A45"}, {"file_name": "SS4.png", "id": "4944318082336867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982635_4944318089003533_6150370119705039747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP6Uojqr1_sQ7kNvwGld7Rz&_nc_oc=AdovSdLTstCa-Wg7jlgqhXONjR_VfXySdzobTvnF9rHpegPLGRPikBfDInm2fn0raIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2gAez-CEGCvNUo6IikuIUhfgNx6DzX_oQKEwV6cl4ow&oe=6A8972F0"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0aVmX4ajvYQ7kNvwFPeeBD&_nc_oc=AdoYF8LRj6VaephG4Pk1cm_6SC6RsH374bzzvE4WKIyzIU8cSq5q1zrO0R5-LM4JHzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5S6TeaT9MwZHXn1QBIsyFr9QitawTD3vTPUne8S7A0Q&oe=6A8985B1"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YToY7J0nEjYQ7kNvwEVlH9w&_nc_oc=AdoY5lIHBiKB0CfI25st1pbsyTDVKDlgjHs3jAi1dnX7XC9TAfZL2KNcCFtqq4Qp3yo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhffJDotLkRf3YFzwx1XUOXINENbyg8L6ioz1lSh5l5A&oe=6A897BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TljFxD6C5VIQ7kNvwG0qibf&_nc_oc=AdoMrLEJo9cEc-FndrnjRPHcRHcIupR_joG-iTucK-XXs6h-ZSedA3LA9QrfM_O8neM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiNKAmtXTc0oVDjegKouuKY4Gt-YgGdJuBLPb_l8USZQ&oe=6A899D15"}, "display_name": "Solar System", "keywords": ["solar", "system", "space", "explore"], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
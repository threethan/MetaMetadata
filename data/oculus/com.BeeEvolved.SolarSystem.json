h3sjbJhmInVKyjYvvxLHd0-AJ1hXstOA&oe=6ABBCB85"}, {"file_name": "SS4.png", "id": "4944318082336867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982635_4944318089003533_6150370119705039747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLagOTG5mfMQ7kNvwHmREDM&_nc_oc=AdquFfBcynSppc-3laFCTMDFr5KPJURgO90P5A5B7_eHqoXHz5Rw1fxHTLn-4erDgxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxz82-uadWBECJNMFJUdxUTUZZUAphCDAudnZaFpnehA&oe=6ABBC430"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBjK_TH6RUoQ7kNvwHLgY20&_nc_oc=Adp5bXe5KHOv2av3Hqq8f-IMM51DCGpqUoHu2Rsy1sCEaSxXyKaCmQf5SU5P5k-ONqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo312V38LpEvObxyr7ARz7xeaxMwkhN-Jo99ywTISYjw&oe=6ABBD6F1"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-b41IsUsucQ7kNvwFSqQcN&_nc_oc=Ado40NDPy1iJmAV1B1FbZm0bqstk1y5DXdc1QAHVaGwREi4YMQ2UviVrJ7A5ZGMLo84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjFLnHTKTDgtnyOqfipUcop9lm4POv3QmYE2A52Wpkfw&oe=6ABBCCF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RISQvjraUgAQ7kNvwFR0NIo&_nc_oc=AdqWjNEGC6lYpjNT-yiw7gjfXNXwxKjb3X6ubGT-CgZ4rzMU-76LWYgo21EqQRQHHNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYa0ffoYqdBwV3DBnv3bKVGPrW43K0mn4v2VU58bavrg&oe=6ABBB615"}, "display_name": "Solar System", "keywords": ["solar", "system", "space", "explore"], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
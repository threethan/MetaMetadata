spuDoM72_oh4MXudvxIRlYVMBGjGooWg&oe=6AF47C05"}, {"file_name": "SS4.png", "id": "4944318082336867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982635_4944318089003533_6150370119705039747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NK8uhA-JD8Q7kNvwG_b16n&_nc_oc=AdrAaphwk8EaXzNW21iWI51pwHxMCx7NrAJMoTqhyCtBAwRMXZxGE-eUZ9n6KfAlmvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5myc_V43s4GgQDNvK3kgp9QJHRGgydhxWX4E6P-eCyw&oe=6AF474B0"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unSeLzSzJb4Q7kNvwFmzTxY&_nc_oc=AdpT_rEUA8oNfQTyFY5A7aeAQ79Hr6E60tTj1R2nOxIsAijqGHb2DngfGrIcW9pvS6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQceQKhI0hBDIoKE6nCido86eNst69p83KtInVuWjmDuw&oe=6AF48771"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr06YkiETHEQ7kNvwFVGdHt&_nc_oc=AdpIGtVsp8mgLqmes_38HWLQsLVDMMCxUX-m1aHG1-u-XL7m0O6od-xtfQzEU9LZhNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjJ8x-IqhuQKfrOHlthJenRT4wFwI6yGbzIfmR3DBrEg&oe=6AF47D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENH-WIrz4I0Q7kNvwE4lC7A&_nc_oc=AdpkH-Yu_-h5jMrfyFp_l6HVrsOJxXaAtKhBe2pflx3Kd__9CtO3gmeRIqJMvw4ggbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5KNXjO7J7bzMCFxrgtEiEhJnuoA_0NfiM3pny4dm_GA&oe=6AF49ED5"}, "display_name": "Solar System", "keywords": ["solar", "system", "space", "explore"], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
BwiYNBk_VZuMFof-BElXsIXDyo88GkOA&oe=6AE4AA05"}, {"file_name": "SS4.png", "id": "4944318082336867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982635_4944318089003533_6150370119705039747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT1u4bm2wWoQ7kNvwEdTHUu&_nc_oc=AdrMF8ViApu7etscYxqpEfXvZ8fXhBQc5OTCMU_oVohRUF02CMvGZx9CF-gUWIy6IgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8AsLr_s_JhZZvuF4sxY5B3jlXwHdOGATtUiT3_fK09Q&oe=6AE4A2B0"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdk-WgTrMOIQ7kNvwFSWLiv&_nc_oc=AdrBINw8SvX_saZ_6o_ehm0xJSw57dEb2PZpCfOFTWaH6IQNcsUr4e8xv6zdkbj9qqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM86uLPyo3i3klHfDVgN4iviMe8UFGRsrtf7k43bOKIg&oe=6AE4B571"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDkdrY0Jgt4Q7kNvwFmfBPM&_nc_oc=AdqqNZDdKMc98o6S6sKigw6cLkHA4YDiO84qSD4WGlcKk_q5nwsEZZ1Rq13RmMZmCWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAuTNZt1l4G7l4JIcvZtEvu2FV1T5Ii7XwGTgRoMxliA&oe=6AE4AB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7llyVppB8-kQ7kNvwEtNeQv&_nc_oc=AdrDaqEYSLZ2J3zBFvX-cJRSpi-lf5Ze_WsC-Et_fPNKiRR7Evu4Qa6lNrChySammgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlBwu-J7pBwD58IRKedb1BZT5OHm4hlaFqvBf-li3QYw&oe=6AE49495"}, "display_name": "Solar System", "keywords": ["solar", "system", "space", "explore"], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
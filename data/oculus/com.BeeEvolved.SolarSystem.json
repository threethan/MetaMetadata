20f&oh=00_AQSuECszqMTMrmevvnFtny2KAylNHQsva7CHzvqLYQp8qQ&oe=6AEB3A30"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJB5ljQCOjwQ7kNvwGmM7nt&_nc_oc=Adq4bpDSVkOZ2JKjMQpM5sl1ZkRfMO6UqjWt5KG1wktbapDNvyN5HnEhTm0RggD5W4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwYIoO4PbjGgmUHyz8Me6XRiwoTs4FPnBTIcrzOWcgKg&oe=6AEB4CF1"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gXo3yyjc9YQ7kNvwHIhGOC&_nc_oc=Adp0pOBsX2KQuosbN74fMXTnlgJVhVtVHVfP9-zxIHoC42KRGbrSKHPpyPgrt88Z56g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFh_-OWv1R1_g2yTulmy8pIr8s2GlVGITiL9AKxZwXrQ&oe=6AEB42F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXgBqH36KmAQ7kNvwEh5zbg&_nc_oc=AdrG7KpYAblvR8uN513mSushw4P4GEcfFoWsjiFgc5xhpm0z8UqkqtZdglSb7sExjl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNsJv7Zqxf1UWHUUgZ3pavdxZZI3hHF73IZkBcLwzkkQ&oe=6AEB2C15"}, "display_name": "Solar System", "keywords": [], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "848622289498063"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "617529977799878"}, {"status": "PUBLISHED", "id": "1317110422951341"}, {"status": "PUBLISHED", "id": "1187778921826520"}]}, "baseline_offer": {"id": "1317110422951341"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743534000, "status": "PUBLISHED", "id": "617529977799878"}]}, "liveChannel": {"nodes": [{"latest_su
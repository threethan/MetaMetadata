cwH4aSw-m2KdPXmivrJAzX9DFpBNktNg&oe=6A8828C5"}, {"file_name": "SS4.png", "id": "4944318082336867", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982635_4944318089003533_6150370119705039747_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP6Uojqr1_sQ7kNvwFTYIc_&_nc_oc=AdpTBOH-qF5JxTCYExLgqxgT4TbFeuX7CTUBffGg4zJiUlWU-yQq1gquKl90DKoE6us&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-2XizZa9v18Gq5DoD87CUzS7VXIbrOnKk7lbJU_u8OA&oe=6A882170"}, {"file_name": "SS5.png", "id": "650198270026258", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223479_650198273359591_933642925857922241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS4lclXxbFAQ7kNvwEyC602&_nc_oc=Adpk06_I5PfMnELHWLBMvWsFYyXjxrYHxI1m4DE7yorIm-POA6MbAQT_aAXMdBsMCGg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIezwZjFIA61lO6qzp14IBEEOcQ8iYDKl0JBZxGy1Bcw&oe=6A883431"}, {"file_name": "SS2.png", "id": "791801155263703", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974820_791801158597036_6582243183825947140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKe4SkDwsCgQ7kNvwFa_XFA&_nc_oc=AdpiW7O8jGht9mscwpVuXBnT-jraX111SO1hNwxakw4iBcM0XVlIjAu4fBsf62PLteU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkczxKYKPsNrfJriR-2qWAjayqCn7LXZdR2ejDMe8Cjw&oe=6A882A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1104990073555475", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974695_1104990076888808_1041706379218216168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TljFxD6C5VIQ7kNvwHKJdGm&_nc_oc=AdqE_QX7o4ZOV1wLtODiRJBCAQraV9szEmRL1oLPd4SsU_i-_vt-QOhS4WorKOqeVo8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIbG2EU8D_VmyrF27zW9rf0yYZFt4Ft6nXY2EFE-gMGA&oe=6A884B95"}, "display_name": "Solar System", "keywords": ["solar", "system", "space", "explore"], "long_description": "Solar System is a fully immersive experience that allows you to feel your place among the planets.\n\nThe planets in the Solar System orbit around the sun at different speeds. This experience allows you to feel this differentiation of the orbiting planets. \n\nExplore our solar system like never before.  Some might find this experience calming and soothing. Some might relax or mediate among the soothing rotation of the planets.  \n\nThis could be a learning experience. This could be an environment for exploration. This could be a journey of self discovery, as with most things. You define the nature of this experience. What will you discover among the stars?", "short_description": "Take a Journey through the Solar System\n\nExplore the Solar System and gain greater understanding of your place in the universe. \n\nExperience the rotation of the planets as they orbit the Sun.  Experience the difference speeds as the planets follow their orbit.  \n\nApproach a planet and the name will appear. The background audio is from actual sounds captured in the Solar System and SPACE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppSolarSystem.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/solarsystem.html", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
0f&oh=00_AQGbOsPNoDZSXuhgEE2UO13LC8p57bTAS63LaNPs26oXsA&oe=6A774521"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9I06PJKvuYQ7kNvwHF0HAD&_nc_oc=AdqxkaBM4u_laK_cjZtH6ftABPlsh-kC7z9WvAhACTG2J41nUhhI20_1ei475TyiqnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzaoo9Td30BZ-QxsYXxnHmg1brAU9UUBTaiToMKln_LQ&oe=6A77304C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgWO5BeNbvEQ7kNvwHKgUIh&_nc_oc=Ado5gSkCU2kEVIQjjshow3BO4PDOfR41pa0uHMXKvT0nFq6W28uWJhWfbC2cU6kXyt4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzjdhMVn9YRBmfDtVP_ILO7G_1r7FrdV_AiItg8VmHog&oe=6A772631"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDTueUCzcRUQ7kNvwF8-Qt_&_nc_oc=AdpSdnoXaZdFHkG8DLW36KkZaMayASr1KBV-ixZSYYCanlAQx-4oB4D13tQA9ZqlNUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjroyGL8PUEGmGB9wSNtSMNLid4GY2Vma6DINK6xU3eQ&oe=6A771F09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbKlub2dlTsQ7kNvwEdNcbb&_nc_oc=Adof9NRO0jZ4B478nNTs3iBe-HcRtiNVpNuqdEGXnLRbFasGl47HMX1rW-sXltvUAdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWOhKbA3BMiC0yoRp8bwmAVNwrNToUn0yFLB04uQv5gA&oe=6A7722FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSEMLph35NMQ7kNvwHAQVYF&_nc_oc=AdpD16nwuj_Kae4JVmghvCJuTpD4-CGaaNHNMBwRGCIT8kDFIP9Et8ImSlRBUQF_6TE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs5Jv4Lv9qpLJl945l_d_8GVWOsGoH3PT3ibrl-b64YA&oe=6A77336A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
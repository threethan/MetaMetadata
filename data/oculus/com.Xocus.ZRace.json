0f&oh=00_AQRFajcVlMO2pyVQg2EqISaWqxkc6EROaK2NXKyclLeMtw&oe=6AEB4921"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3cN-vJLMtoQ7kNvwEBwd0d&_nc_oc=AdpHEOzILvTwHhzc6od1yaJ891oiQRrpyFcGfZQJfVdoX5x2-1GHMCX17ZA0OS54jb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgSl6rDFKkr1xG2TPGU933gyAZWzHqjKWsY-hnQkMvMw&oe=6AEB344C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNPHLE8zYAQ7kNvwHy9EXN&_nc_oc=Adppd3lDKg2rsncu7pRbj6_fqe93sBdFgGodCPeVfWLt5F_sNJc5tuA0edFLJzv2TFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQResP_T8dZhjbrX8MjNwnmHWlB_hET52s23sXCmfWnFCA&oe=6AEB6271"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtce5V9svnEQ7kNvwEB3-5u&_nc_oc=AdonJQ1fB33M4wfRY8fqYdIPMrJc1NsPdhjFAa-DZv3t6Fh_UiWss_e0QfHOEjtQANI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUQXmPKKY_TaC_kk2dxEVoaxo_WhRxy3xmActK26j-9A&oe=6AEB5B49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfRwF39877EQ7kNvwGibJfS&_nc_oc=AdqQ28-7OHUqS_-24U6bug6mVt0rxq15x58ebXLHmfOA8ysYpClUaKD6EKWjXEuhjnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_gbAQKIZZyGoi15hJiLq7oL1GODHUGx1dVkx9MWLNw&oe=6AEB5F3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s87vKo9msVcQ7kNvwGgR1nL&_nc_oc=AdoRF5IPEjjBV93ZJGAl3eWP6b_3QmE4NuzgNbsAvRV0ePKAaDgRavHyFEjiM0GBxp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe5_XNLBD1r8KPIbFTk5rHiAPRqHvb7eUA0sqrcrgYBQ&oe=6AEB376A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
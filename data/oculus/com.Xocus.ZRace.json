0f&oh=00_Af6brBdgO8BSxv4LfgSjLKfZxG7n4c-rqX5qmYw8jrieHg&oe=6A185921"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2uqwwznHpQQ7kNvwGqqHCF&_nc_oc=Adqc81OcqaYV_2Eob-jPjh0PUCtximYVdBP0ieBNWdPRsbWBdpg1GBEz6GohrlKUY1g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71jWlYTgwB-UOy4nrQx50WU9a2-rm9DY52zqXO5pVyJw&oe=6A18444C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4LJrzGKgkcQ7kNvwE1b7BC&_nc_oc=AdrYrQoAgkM_V_FbTOHG0oDHOh4B-nR0EsA3wo5vanS6kJTmiuGimus3Z3iROODo3bw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TFRL38MFb3gH7aSnAouc8Mvf7DB_MDhMbORXmQ-319Q&oe=6A183A31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX1w30VDYC4Q7kNvwEetZk0&_nc_oc=AdrRhxXobmj-4pzpwtBYEVNBVqn8ePcSBgmYxyQfTQSAgWcMy4aeviLtOGdfUZnc-VU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DMo-pyc3k5y3qvVdbaprbTleR1g19hbs_kgYfBAsCXQ&oe=6A183309"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0l3bDLXifsQ7kNvwH-tUbJ&_nc_oc=AdrRQlGxwP4nSnnetiEA91xCrEOATVHHgdq_Zbzf8M4FL7klHl8NnXxW8Oz2wUziLN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_djXm-4capuoHONuLVkrY06EUA47xvE76Rq1tS38ZGQ&oe=6A1836FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKo5oRzP660Q7kNvwGNOUp_&_nc_oc=AdquXNqRK7dxw3DcixO-0lsmzesDGStyLFR8xPTvYjXQ-tBr6phu0l91_bDLFfMVruY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nNl3rbbfCdwdR41NbuP9ERI-LmZ_6sehYGrEOlqXaZg&oe=6A18476A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQGduQF8qQmetpnxznyGFgmfMamCd1cb0KuHE0g3OwMppQ&oe=6A7C52E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMzLvLafGvkQ7kNvwGKXPad&_nc_oc=Adr54j8pAF92zS8HB7AbXkKc6aOjFtHiWr_rIMT6c_ZR1uNenHPpFKyH6l2sGVD4ptE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcUyRHUmnMwYYpUFbW4TRFhdEFCbRC4QFaKGi25iOFdw&oe=6A7C764C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De81VImTG5EQ7kNvwFjs29n&_nc_oc=Ado4az_qJHlB_MiPVKIEZ8AyVzKZ0Y9Chm1GenL3z0Z5QaFlaZl1nJJ4BIwdubYPbsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx60BbgQ9N5IkEUo-OQ_NRv1r2uByWfNxd-mkzk7rA7g&oe=6A7C6C31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqOLcE1T2QUQ7kNvwGGxqo3&_nc_oc=AdrRhn6_dxbcxqHlhnYqIl0--b8PzbUTGQODqfg4tdSKKCS53tJrGvu3A7uw2DavR10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYtbu4O4SBCMmCWNbaWSLW9ZwQsPWw1kQVBsGG0VxGfg&oe=6A7C6509"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-ptaJpcJGAQ7kNvwFj_1Nd&_nc_oc=Adr4Ic9tF-gHihudY1Ap0kPh11zS5g_K_BIRyAhh6xQOdg5lZJZBaXakJ9m06l8bbtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjTB0O397w33IeXMvB5xE2qOSSxS1wGideyUYIhg7asg&oe=6A7C68FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipadzKz5xGwQ7kNvwGgcfmq&_nc_oc=Adr7fkLXgM_e8ujd5jPhQumyrZgtKSG7T59663eVgTLMxu2cgyMaSze5jcWWviWbB_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoIfk4dEl6yj8rdtSZW68PjbB5UeKqxVPh00A5ucZgzw&oe=6A7C796A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
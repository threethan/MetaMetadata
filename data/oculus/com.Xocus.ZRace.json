0f&oh=00_AQFB3fV-ofk9GMzVGt1hVOgJrujSow1WsZZyyEdRajM6NA&oe=6A707561"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPYVQqUfPtgQ7kNvwFb2VMX&_nc_oc=AdqWZLY-43Irh5RGk2_W6RcKK_gGddHzNCfBIh-DoPg9LrL2Ja5b4UzNS588diCr7cU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4vL3QUmyJF5y-yAF73SI--hcJcDEZ8Mj1IU9xcVKeFQ&oe=6A7098CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wqhQbkorTsQ7kNvwFCveHo&_nc_oc=Adq85AhgmvjhXYMM1uLDGTrGJWBtYT8x4M5Oh67yOYT_cV9IAN0ozMdlh3Glzi8QGIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwIdvHXaEtN4ntmBajSvY37mAKjTa58S1TsVXFz63KnQ&oe=6A708EB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2tDxueJ9IQ7kNvwEpUFpe&_nc_oc=Adrwk0ZhFr8n4FPHjzsjI-gW7_gxP6dv2d2PtRASH_YraF_eMtKxSCx2syo-ytWFcBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErUpPyo3vsgWATqZ2PHbsaudFBSk7KwtxHKkIxy_6xJw&oe=6A708789"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMNw8L1a3MAQ7kNvwEJMps0&_nc_oc=AdoEvy8cb2KXXweemGMmA-03UX7OUJkORaEPvjWrv518cdUeQ4TI-LA6JKa5k-G8Rms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEidElVyOMYkilRiVaodsEYj1pKFo3v163XybDyB6kmg&oe=6A708B7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4809XjAqO2IQ7kNvwEujhNN&_nc_oc=AdqVCNHchi3XZLNfnj5nD7UY5yQ4WSSjb-3mCaUFToo9t1TllN6g--wY9yuZtMqLTvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE68ick6JPbAZwrrL4PORXDwvyzTPePsg9k8JM6G9V1EQ&oe=6A709BEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
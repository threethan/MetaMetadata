0f&oh=00_AQDZcm_UaxwBgbloFhkjNyF7Ij2M2mUDpfS1h3HqxAl4ow&oe=6A4E66A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mocvfr8BRkQ7kNvwGNXxsA&_nc_oc=AdqrJ2AH2wVHHYDLItjbISafbZmvzkRsuLsYQO_MrIni1xr4Xk6vzJGMbov_CQU8GwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoRC56vsBPh6oOVBVLPmHDvLxR75xl7asTl1YMI7cr3Q&oe=6A4E51CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulPn6Iab2e4Q7kNvwEbIQh9&_nc_oc=AdrvZ_eozwFGt7b8HX9DTHgxR1ma4ccgV4f_fh1Wbi2FDaUGD2k9KwuEUG5rIDgpKGE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgNCvxgDDufKesLmDRv9Fr5Up-EjCbnK610l25TYpvbw&oe=6A4E47B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUPIA4LcKAEQ7kNvwEoNuil&_nc_oc=Adro1aHrekZzNidpRVTp0GACdtHFsVrow0e5Nl65TLbzY-xIB_l52o4xbkMeoH0vnek&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVeJFPL3kZftTVuCS-cwsCGUdf5r6Hax0HYcPnWwZZBQ&oe=6A4E4089"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chze8Z7pIBUQ7kNvwE6LXY2&_nc_oc=AdpJOAjQc1ZIaVpRuD7sPg-w-dl0s9HzLwbCpNvWHE8IfoYQhV-8eVilhwTF55xKAeM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGABmTKnnURNcgJ_fABIsBNI-wi7VnZgRFCtCOJflGGA&oe=6A4E447E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3WO0XTwgiwQ7kNvwEeCyAV&_nc_oc=AdoKHpuWmTeyhCeRu6JH86qc8IWn1sJEiBD7Yr3RHk5utyJMjnnfSG5U8jVHuaHfb4g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9O4877RPiMS94_mzI4U9fUHQGZero1Do5nh6NMNbKUA&oe=6A4E54EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
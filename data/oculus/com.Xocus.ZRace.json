0f&oh=00_Af3GdrVrvqvv3BDppdPvOoVFTQD8gHvVZAQkdy0N2zeBNQ&oe=69DE5721"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9PXiYSeo0YQ7kNvwFlHQS8&_nc_oc=AdpwbQkUBPsAQPHl2DnrUduZfpfc0DVsfbHhyGTgjrE1ydoqmvtcg2F9feKdkH5QSMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uC8-g2N5f05BW4cnhY_M5k09jUMxtII923N8xKaoonQ&oe=69DE424C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dynke7CvIB0Q7kNvwFL2KKo&_nc_oc=AdpFCVtC2FJ3IcOjv0mSPqi11toY_l4Hbk7Kgt-yAe2D8oKbKLP2dZ9jHBrfxb3VVoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UjNpc3LewiKRBXP1Vc-tFJ-dlwY873JKngfBhB5LHpQ&oe=69DE3831"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifJ6cMFxjREQ7kNvwH0CKIW&_nc_oc=AdrF7-CF5IKf7334CzP7_zzToTet60ofz5IJFFxMWY7pOEoekdY1T3g-ebFU-GVp-nM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KCMQ6iL0isaWn6fZEcO8wwXwshaOUS8fl9NmesM_0rg&oe=69DE3109"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZFprRsoK6gQ7kNvwHwhG8d&_nc_oc=AdrM7Z3DWsBTZHu-8LH65pJ9_Kil4rtRMJCyvRxn0eBbYXKPQ-5XcN2RV1tuYWpUIiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k0qg9xVY9wup1wvK1uG3Ycf_of-CYFd_rQ5Vkg1o_Pw&oe=69DE34FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hukdq0RWGqUQ7kNvwH-6YH2&_nc_oc=Adrs3-a8DBOKGe3SELMWqNLXAM4PRaRwlQNzEdRcaqP1aIxxykZdvYjQaPoUNHWw4kU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L3GpxQMbkiFN_Y_ygxEyg99oQ5A3EJw9nu_jo8PP9sA&oe=69DE456A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af1IEURh-StrRecebumyq4Tv-Lo22DkPJ4z35jaDlYDePA&oe=69E0FA21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KmXoN14CWsQ7kNvwF6qUeR&_nc_oc=AdohrSVePQwahMfATdfdcBafLekY2dEBW-9qqCyTxRSYLSTYs4h_BM90wxwX9ecuTTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lnaFSOj4Sye46IZttpWvRWKvfAODoD89KVsVrepid3w&oe=69E0E54C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96zKIVqLgXwQ7kNvwE4s3nW&_nc_oc=AdrVLEGch194Sqd8XZLTElSqkKoX-dWS6AayJhOoBv-m8ZZhqYTwEHHDMkecWD3lhC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PnV0bwIKbid1U2kZchlPBkhMKM2VoFhqY0wvH6XthXQ&oe=69E0DB31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifJ6cMFxjREQ7kNvwHUhf6n&_nc_oc=AdoQRyjKZqA9MsvvNJ-fIaArT8bPnz3aoi5i69gz4TVZxzbVmLg5RQrl9VcC0tD8mHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14sXw_Vy1fKiIg-0ncY29kjsFIY1doFbmlp1GwrN1KbA&oe=69E0D409"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZFprRsoK6gQ7kNvwE2f-tV&_nc_oc=AdrbXkrUQaeUC9SUTdEghdZGSo2Cu1BmWv7-1Lg0QXPE3i3XlstmWxXpwDY8Umtui6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZFIsR15Tiiv8kQxmb0ykiOJe14khI8qv05V8QulaRFw&oe=69E0D7FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hukdq0RWGqUQ7kNvwGzvq9k&_nc_oc=Adqy-Pac2Ko1YyoPKSKt_ymEQ27Y0Fphunk4oywEaDhjGaGFUZS_kOHd95n6Odt6FPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xog3BMW1oxsFzctpgbvMOj65Fvo8_Q5BWlz4rm30N3w&oe=69E0E86A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
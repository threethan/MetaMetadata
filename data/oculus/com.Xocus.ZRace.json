0f&oh=00_Af70p_UcHrKNsgJlJ6x_6wZcejPnK-qZydUz10dNwkPDtw&oe=6A19AAA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2uqwwznHpQQ7kNvwHFQcct&_nc_oc=AdrUjW9Er5dVTtkqdUZzwykYZZwqIPIOlWD5HiDwMy9u1vtT9YDCrlmUwZ766nDmMOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pqm2er4u_B_6xkMIc24y8DrN6NDt1XEH2N7OiVZXHuw&oe=6A1995CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4LJrzGKgkcQ7kNvwFQoQgn&_nc_oc=AdomnUTU4l9n5rKcD60wfkm2STLIjdL4I4B_GW0e1oKmjt6Dly77uBAY4m-3NnOTsQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zzgmgqdutp0ToBRHNTSkt4uSGlwf65xn3R4bGRJnBPw&oe=6A198BB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOBT8vDhTJ0Q7kNvwGz5lFQ&_nc_oc=Adq20hPBeZeesxKwR73fdAgfdlkUO1TqfazGR6jBmBaHiQ1Yv5vhxggUaor-koDeG_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-_YIDXfkJ1ZOmxUBkY8inl1S1EmCL0YGs8ZZZAJntUQ&oe=6A19BCC9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8IzxEYvxJ4Q7kNvwF1ZM7f&_nc_oc=Adplmo7H2XVexh6bo8nRL__iEQhPt3qDEOfpxKSGaptjw1NWOe68-2QHCivAiewU9S8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gi8ye4NC6TK8OLUYtszjzQCcTWJrKj3DdSI6hu1KAGg&oe=6A19887E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q7qMwqrKQ0Q7kNvwE4U4zx&_nc_oc=AdqDQlu6ZSqBTU7I5H1kIcp3QOgN6JG9VkUd5-lT6R_rRK-Poc9IuA5RYP_B9yEoOLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oIMgaBsrjpP7ebTVG2OHbsrqvihQEF09ogaxVqbfzgw&oe=6A1998EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
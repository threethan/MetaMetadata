0f&oh=00_Af4AfrEouCGOSOF-DzQg64daRXNmw6H-mhqHdfiFo4vx9A&oe=69FDFB21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3pv_7cqkwIQ7kNvwEiiHd1&_nc_oc=AdrcAXRhI6Pykrguyii771lBzSZzyRMccHoV0s1bZNWGJNdsBOyKf1qnNcePIXdKH5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rdvc3F-65GWxo5zurdgJnsEtwjT5SpIkMh4khc_mOyQ&oe=69FDE64C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVI8L2H8hcMQ7kNvwFhqP8u&_nc_oc=Adq79-p-hhHBeGvM8PrzQFChwWP9lgPPlXa7aU6AuyVU1oe851y5gxs5ItoAYfv1aBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WdyhM2MIWWEJbYkBoGF4quLlZ8_JsKI58Lifp3c-SVg&oe=69FDDC31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XsHFFBjZjIQ7kNvwGvoPMG&_nc_oc=AdrEqTp8mJbnUKtknJ-Wgb1jw0eK2rYbNHvkqj1iSBZSkDSrNQ2nmQl7_t9nd3bGgEU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b11LXZL4jW5jnTfi5v0Kp0ZTo4SzRjYxkThOVv0TswQ&oe=69FDD509"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krs-LypSBm0Q7kNvwFcPbDc&_nc_oc=AdqcDnEI18tFMVgKCpRvIArBs_MvGexUcdZ5-c6USse7PTNIufpXtdYrHLCrOnTXWwQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j8cjvjTTZMynpWTF73mu-RIkXHVf9ODWZxbU4gk9hiA&oe=69FDD8FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWfINyhq0KAQ7kNvwE-R4Gs&_nc_oc=AdqzQ6Vs2g1l4PJC0ZXqHBOLDpaeuhiGKS4k29ffYYrprdYnoRuGGU_FtElxlTRGRoo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xdGCLgs5f937HDr9KScDrsEJo_DSyxMG8U7FVAujU0A&oe=69FDE96A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
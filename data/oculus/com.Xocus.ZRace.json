0f&oh=00_AQEBMzMdxP-Or4e313stKq9cRWuMxadAJPojpTSXFW_7JQ&oe=6A8C24E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2yBCu0bFYcQ7kNvwHInGoD&_nc_oc=AdrAhWxmLnPif7dRXOhsfxRaCq4SY2QKtFsI6OrgEVWys9ofA1rs7hZZqX7j6SUkgCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX4B1rjBomg803W_XEVAyIyrb-kfEflNTcJjxL1Xxe2Q&oe=6A8C484C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifajuYALdmYQ7kNvwFAfPcR&_nc_oc=Adq5v_yX7MXfUPX_cfJbY_VbvZLcX_9pkwdk5jvprcBqBiw6e5dAa9kDNBy0MlbXbcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY7Xrbk76wplxc1lpub1vB3PW2izZbbyV7NXB2CyJYLA&oe=6A8C3E31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRKVzI6Vqo0Q7kNvwH_r3nj&_nc_oc=Adr9wcUOExciLk-PY-gqKmI4QCWVN3lLreEUriO51strqA14Zw80Lfli4Wu4BqFrpCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9PVNy_Lv9qI_dL42Pz7tGhPBxFd3Qr36yX5uS0OIRsw&oe=6A8C3709"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PszMJHXOL4cQ7kNvwGgGOkB&_nc_oc=AdqRAd-Gi2030xpBY8cw6csdu_KMgR98UgjirTdzoRABeifz1JABwH9wuB0G9KjJ-DQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTTYfN4U1GFVfCIvYlAv3FQkjX8AWYacUAr_REfp-d_Q&oe=6A8C3AFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn7P8pzBJ_EQ7kNvwEuOui3&_nc_oc=AdpWtU2gWtkPAAt-CkWMgs6pKBOJExJ5tolPTgfx5ExnHMosNE1SKnCg9ULy5Dc-mLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWbAshEcXT0f6BkTk5qAd60ETcC_RL3LUtdfC6WIcVlQ&oe=6A8C132A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AfxgS6mz_db29tmJlDto6SJvCBk_NzkY7W6vkoIGgBRPCQ&oe=69CE4CE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h99RCm7WAs0Q7kNvwHg19X5&_nc_oc=Adq4AR55attBL4-JqTQCT0yBTCGMNdYDHFazateMYrEBiUWBM5lYOFy3XnzIvzl-4wo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7LCnJpKCezF4GvQ-YVDUOUI351xGipjm8dozL3vsRNw&oe=69CE704C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziMdPjutqAAQ7kNvwHYc_pQ&_nc_oc=AdoefA_2rDefHOpvHSHfzfYNryScPeZbRUlHMFuQeF-KLLNuYFOf7SL8LpYkPOmMJUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBN1PxpLgyoVOjE8i-RJ3mA7HqgZY-9yZCVdq8PtApkQ&oe=69CE6631"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyTOUEfqAwoQ7kNvwE66uZ-&_nc_oc=AdqtYJNDvHVlwoPyobdjj92cqSPxLfrQPC5hCZhAWarTqv-Nr6hORphiD3cm1IttZfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxyaar1OS6bEmYpPsIDkuh26mT9DycncJ6-eQ2eR5XYIQ&oe=69CE5F09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQNfWmjDRjcQ7kNvwHGoVsf&_nc_oc=Ado9K1U9GY6ejfAgvq92M5_6bFHsGmPKn0yyRnAosYHMnTCc5s2ztX--1p5_v8-ZW-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP6iJN8FvjIRNxcLxRtvauWYsaxZXL-wxNkEVt3TDePA&oe=69CE62FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH_oOzvfzqcQ7kNvwEZlac4&_nc_oc=AdotvqlQdUndYGKLIErzl-dk8susadHsfOfCio4rrqbU1sdBGU-pKF9jEPZKj_DAxHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj5LQJSrtw_Na7qe-rNHa6k0_cO0LLMUyYfAvLEmaDEQ&oe=69CE736A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
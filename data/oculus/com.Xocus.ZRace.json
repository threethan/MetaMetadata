0f&oh=00_Af1yZVMQvGzsfs6Us5XLtv6fFZovGddIA-AdxTbgFnw-Xg&oe=69D78761"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1D1kKWuVH4Q7kNvwHQhTzq&_nc_oc=AdrHdExfrsqxcaD6Dv1Pa4J-ssyySQt1Sd5XA_87VpPfdLeWctXqSUAgn1YkTksLHtk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WmUjFvneCHsz8MWVujLdjQ93j48Y4TVyjXL4dUD8Jvw&oe=69D7AACC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcA2lK7qJnYQ7kNvwE45Juy&_nc_oc=Adr7RZHSTllMlxl7U0qTpFXQvItGVE6MVgB8f4zOz3QoNZ5NvG4L-Q64YbkQMuYw7Xo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FdR45BbjKf8gzKa6wu-ShSDkHzuCmJo1EPY3lR8H3vw&oe=69D7A0B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fChBZZWpv2MQ7kNvwG1rNSA&_nc_oc=AdoWQ6il-J88MLabbb_F1t61XCTtmRrzfKjF5O5BgnjFmyUsHquHnjENEJONaVMUItc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vnKYIGJh-pxuRItsGrFc8I7ZX9-3j6yZwbt6SyW7Zmw&oe=69D79989"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI_0rqaXhIQQ7kNvwHjkPCq&_nc_oc=AdoQTiHcZGDhG5Kx1zdL3R_LCKxAiu7QIe6WQohiUfW5JQti_m_Q2SkrVwOpT7ZtRTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e2-FT9BG8CHcBeh7S8LUD6bs3KzKwR-c2eJTqyLXdQQ&oe=69D79D7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM-A9jIsFiEQ7kNvwEutQgM&_nc_oc=AdpHcgL9vS9qEwiNpDJ_-FRu0W51bF9C1Nt5g4i4L20-9rJR3bTjLDzmSFPN44Q0ops&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jlfBH5McpYoRLeCpQcUP_8u5hVThYSgJYQmz6BBSMQg&oe=69D7ADEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
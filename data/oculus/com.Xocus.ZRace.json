0f&oh=00_Af-DCCykZKjDSVw2GGaWrQUnN8hMAyD2RJkgkj-237OAEQ&oe=6A2C1FA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iebbO4tXbfgQ7kNvwEFD8HJ&_nc_oc=AdrZLdnNa4PTQFNUohNKdrP8Nk3LRwN-FQNBs3za-kfbPE44JKFf3u35JiX66V6yQ9s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yGss2QbjJYPHkjsxT86CjsEWu_C1xEapABLQhp3QHAQ&oe=6A2C0ACC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8Tv3V2I97kQ7kNvwFctOiJ&_nc_oc=AdrdhcNWdwTTziE5naginB39LSeFKnaOPtavORpRNMWULvy6QtD-VRlw9Jc2tGGDfRs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5T_8kr2xiUDEUXRAQe_cuurAZ90IEc5x2aWyK--KfLA&oe=6A2C00B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kufHRZaPsPwQ7kNvwFybdj-&_nc_oc=AdoSNF0ITamyJA7xyBTJKIa1cgXEbDO2lvoJ8bKEIT4JPbQnRIqR-SoGfCwvp6_H2hA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WIntZv1V4PGFKPMWDAv2HfPmP8cTEooZ7yNNnqKjEkw&oe=6A2C31C9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY358pWX1TAQ7kNvwEABrnI&_nc_oc=Adqk2EFsPRhSWZiXUOQwVov6GDC7LPwJhDzdrzfZlpEyC-bqpSm-xqCjwMpoDgpyj00&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VWSmK8LOy6_5wi9EGr76taRQwlbnUC2oBvGRBK62LQw&oe=6A2C35BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eofw-Pd3vocQ7kNvwFcvrfH&_nc_oc=Adphr-pLzGk87p8XyPrR6fiQ6nBh6E0SzXyu27fqPHSA4dCzGFh3cQiH3k5QRLM5Hk0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a8ItmWCYBrDpswbj5MrvkYUReZJr1pKggVZ6M4g2fvg&oe=6A2C0DEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQBkuOc1e-TSwvp7HuMZZv8PzPyzxrNknqXiyk7mSVjRQA&oe=6A5A4421"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl82zE2kolEQ7kNvwE9i4CF&_nc_oc=AdpT01dtKWefgHJPKU2_gaUw__yymWPY9Ecv-QmbqFvbRK4uYiVeQtMWnCUwVcurmtA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgPHEquEGa6tsoemPYpIj2FaQtbp4cP3atY1ENJEOaYw&oe=6A5A2F4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiS932mxRvcQ7kNvwH4uNuk&_nc_oc=AdpFOddgP-d3shiYHFX1VLFJXR-AGnS3bzZSiuDUc8rXDtrb-vMpRA2bkxfd7XFHjqk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNtKAV3P3XJjLSC0P05MmWRWAydAeiUP5vwxU8qrO_eA&oe=6A5A2531"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul9a8WCkMoAQ7kNvwFONWLo&_nc_oc=AdpzBcPnZIEBlRcHtxZ86lC76_BbwPjKkqhS-KfRkXEPlRghJP4iiY_8sVgfCcLPZ1c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD8C6dlw1cNfItBvkb00uQDmIko4qdkiouhRcfh-opgw&oe=6A5A1E09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5roDKHPMxYQ7kNvwFsFzgO&_nc_oc=Ado486U-J0puTjFYPs7tcWWRb8Ko1rvxoh-JHSrIEIxOyLsS27s-1ZcG3_8lChLojXM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbMf9W9cT5MGvjjwioUDQ6EMsR3K6inZEoXaGbmcWZww&oe=6A5A21FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09B3N3rX9WIQ7kNvwHWv0AL&_nc_oc=Ado5vrQZGmfhrQH3AOZR2wniFHO8YrlzUWOEfYSfLqQOG7Jt8qRJzm4SokzkXKaHNto&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp_g8jvR_lVJ0QPFK6j1JAe9U2x_nDbmSQO1eppITd1Q&oe=6A5A326A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
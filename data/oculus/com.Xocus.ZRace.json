0f&oh=00_AQFTeI4jlZcSMs0jgs6L5msG-oaKrm5kG2GJuQXRrn6zsA&oe=6A8AD361"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2yBCu0bFYcQ7kNvwF14qJR&_nc_oc=AdosRzA8KXOjTABgKxujrNnpZsS3H15FX78crVktIN2j6hhEXLwQKLul5hJIHz0VnXY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElBhLIbWFe4YJcj7qKqCveNAaKg1zNVIoSHPV6dy97GQ&oe=6A8ABE8C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifajuYALdmYQ7kNvwEqEF3e&_nc_oc=AdonziMcuARKL25CxCYAUFVa2A-UjpqGyo1Odtvw9l7Nzk2MQLHDiz__lgQjlerqLbk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9haHA5ILrYRiKbdtxbvV8r2nuXV2JcvWARHPQyHzNgg&oe=6A8AECB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyM_ntcg8lcQ7kNvwGz7gR9&_nc_oc=AdrqvNJUZXFf9VF_JvL2u7_kbAQKvI2DcUC6J9wXWiOJ0G0vfqfX1JqgDqwW2OJXHoM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO3td62Gz4jJcNScpbry9rQFdMElhhdob96arE39eSdw&oe=6A8AE589"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QbPab0dZWkQ7kNvwH5EmMA&_nc_oc=Adoh_jBtyeAkmSuEAAfKrWeK8qLQd8AQhG4NKWmtKzkadx8ccSi8raz2L7Rgj3o6L5E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Usd-dTaqqRhM0wHpwsXgW4AboUh6yjShVNNrp0Cy1w&oe=6A8AE97E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pOeRUV1evAQ7kNvwF6YRfo&_nc_oc=Adrgu1XPao1P0C_LTn4sOM3SgrUGNcplNVjVBBrMYF_kxYG6q6QgbAtJKh4s0n_nWTE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM2VNqEeLNRWBQTw_cwy8URFk42K8k2SW_-6OH1pv1TQ&oe=6A8AC1AA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
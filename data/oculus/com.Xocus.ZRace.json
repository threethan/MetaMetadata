0f&oh=00_AQC0yQNcFqIWwBc2oM3fCmtJUpd9LM5OEaQqwT44sSqnsw&oe=6A5E38A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rWKHKflfgIQ7kNvwHRMud4&_nc_oc=AdpJQj54fHcKSBi3Qb7wJgLDH9sffT-B6dxFIQr_IMUluYe6HHRS9aZWiyp0sWrlQ8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiIcBgsMIZiXDW5MADwNwpnKBKFKgkomwOr4sYUoFLJw&oe=6A5E23CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBPKgAkwCYQQ7kNvwEyx4Ns&_nc_oc=AdpdVedrS9gh7lVNzmRSyLe4RtjxuA2FWCg13SVNSnrYoijoQZ8QXR0Rqq-Im3n2Q6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8gpCFBSG9ii3lbAfxbb_1SAG-De0FmGCCuQzPm_rqBw&oe=6A5E19B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSa9fohFNkIQ7kNvwHzyt8f&_nc_oc=Adq9HVyMkyFVv7NSfKXJ2ba8Hq7UMHxXmF0LbDYVdmM-CaTaBytcB7gtoX7hXQHd1MM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD09KaTQryL2vlIKNd0cxxd9aG34PNhl42FVZveJqrURQ&oe=6A5E1289"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rimSgO7ylK4Q7kNvwHe5bhL&_nc_oc=AdrVOicnXZmYbr_msxuY0KzgsaD_EdZy3H5fYI2mmmafDNlfjdDvuA0FynBLU_npobo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB529ezaOsLwfu3hSISv_f6lwC82JsEYVYVo8Ka7eRtxQ&oe=6A5E167E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRcDuZ3VRUcQ7kNvwFLxcmp&_nc_oc=AdrM_ze7V82tkyQ_yKh_ZAVLtHS_a7E_ALOHdW5RhWUAbT9KZGI-oUrv1Hf6d4PHB98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMX5JsJyeoJcArgxr-wf75qHCxpS5vetfrFffF6uw2Wg&oe=6A5E26EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
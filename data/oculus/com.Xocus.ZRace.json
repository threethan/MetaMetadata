0f&oh=00_Af-Q4EINMtnTJIfPKV7FTJkIqAxpWtSY70WlaPv8VckYvQ&oe=6A4137A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkP2LshYu9MQ7kNvwGyai4g&_nc_oc=AdpixbsM0pO0y1-S1uYC-tCeTHGv5LPOm6dXO967r_kWH2lOLGT3GXwPVb0xXXhoQdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ve3ehEzcd95aiwLuzsQ4SnHXD7xwbKHT1ULWr7RS9bg&oe=6A4122CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk5XTaHrQVgQ7kNvwEa5Je9&_nc_oc=AdqB6DSKSmKGCjqQyvc5ZIS4bhmq3DR8sG_aowokdau9cN1xkKpsY84YsZ58GFcVOq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WHe5l8YXMMWORy5lKvQTBPgHBWopxQu2PPoPjixlsmA&oe=6A4118B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ndZnNq2TYQ7kNvwEILNXy&_nc_oc=AdpFQCWJaxSo_SfJf0ULfJJGvHp9LBEKVkHXTEUzj9UKp-jLefmb5qfDnaIH6cOvyMA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uYt46JqjAEiL55U6M03CJWTZsKD7526h7ZPRf6BEuSA&oe=6A411189"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk9_yfxHN4kQ7kNvwHQDTx3&_nc_oc=AdoiFLN5eIJTQ5kTTJU_1pzZ2ZF6G2YvF5OPvZWUKSo8TWUfMN9xvjWzsz8TyMDLzAA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a8mOQ-8iw3RVoNPEar1fiCG6JJ1UdbngpBmiTU8KD0g&oe=6A41157E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAc7Yfpoj50Q7kNvwEk8BPT&_nc_oc=AdqLMvGJXMdPFEEJXFxRRQnUs3UtKzszgCn209GtnV8O8bBUzatH2b4TTOFlEys5ym0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IkmcEjRqJalYEbjpGYpnsFNm4S3MdzI16gcB2o8NutQ&oe=6A4125EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
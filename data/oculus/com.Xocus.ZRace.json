kBaOYCY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl0YvxkxFmQQ19xdGYaqJeL8Iedly98vg--b5J5mzCeQ&oe=6B085C49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YAbXFhal_EQ7kNvwHqG7fa&_nc_oc=Adphun74c07_-4e6A2a0h_4c2WlGW2bkOIWqaN0rn-EXHcRTxTgG1keE62nr-hWAAfc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP0zkKlReZci2pqPyLO_EI8MFJxHnysb5sQfhvFFbM5g&oe=6B08603E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o0ep_6jCfgQ7kNvwGfAh3T&_nc_oc=Adr3e4CKK3DKPwcLFoFiBXyz633-tiFNzLX5SnU7iUxFUNREOIRhHyZsbjLz0a0xP9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLJ-Kh9x9Z2tpw9Z6Oday-52AwCj_Phr4lSvgCf5n3lg&oe=6B0870AA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1560128274351242"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5439634252801104", "version": "1.0.11.5"}, "id": "4323125204437065", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applic
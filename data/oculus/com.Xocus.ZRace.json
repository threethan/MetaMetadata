0f&oh=00_Af7Ch3kP0DvbynAW_m4BhFORVDmBEZEoDSum38upT-sNbQ&oe=6A034121"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlSKTRDjKZkQ7kNvwFPz1mt&_nc_oc=AdqJbketHCS0oJRSC3Oh28QAnA_RFVWRFIRyfO9KfG2VsCplNN2WTW5qPc0RapKxVYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hdgfKxPDmQmssq0or2ilXQ5s66y_iNTKQX-asXEnqXQ&oe=6A032C4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWZsslsj7lkQ7kNvwHVV7Gx&_nc_oc=AdrI4d5XDAB53KdLccnQQEvIzaR2a-BVlnnhFz62mb-j-zmjRXXuq_9Oqwk9Xz2Q7zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54KxRXVqK8hkCpZSzrNeOTc_2CH71CyOLn0ba8wnCpKA&oe=6A032231"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxDfnGzZyv8Q7kNvwEbzhxX&_nc_oc=AdqlqhUCrSjUNqoEe2WJ0Ao5cvGPjTuCnIHC0uk15Zizvin9HVI2nhX2n0ot8Ed3UyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5KvnOTxx5vp7EFnZPLV11QEnMHkeIHfPGOV76Ax-Yw&oe=6A031B09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRGmPbKxasoQ7kNvwEVx56j&_nc_oc=AdpAOQ-PWn-SYzx2_gMPhQ6isQY8sc87r2xJ9yiWLtkP2PBpQdgmh2WejjVg5MOpXO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JRw_gG8wkLTU3ugJJDnG1kYmIG0DfQT3mhRvur7VGyQ&oe=6A031EFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBuWrET0z_AQ7kNvwGlS0Kd&_nc_oc=AdrJLfL9smfBAH3zJh1mk8ZxFBzCBYms_x1-jaeGuhDAdb4B9Uhf_prvBlv1O8Jr5U0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UyQEP5zWuHe6sQyuj7Kke_Vse6tm8Z-TBKk_YcIc2Zw&oe=6A032F6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
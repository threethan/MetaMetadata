0f&oh=00_Af0oAszNTue1vfAJIPmi0bZw6XGyc8pMEXGiZnPkWrmhTw&oe=69D392E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsOZj6qiHDIQ7kNvwHaNpnk&_nc_oc=AdpyS0UZFIz9C9su3MNmttr3snt_L1GdgDpv2UzGIDKpsabcJ-FsVPHPhqUiylPIaDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38DfAxXiQZx8p9Gy_BUKSkBw0JMSCtKHwM10ezeFk18w&oe=69D3B64C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_sX0hZ9JzcQ7kNvwEAN6R9&_nc_oc=Adrb6-6mP-xDPdtB-cQ9UHlDUDDV9wEeFvSvkhBkyck8oDxDCWwPTpxvZupBLDL0xCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xfYb5iRgBXc1m5LEEVPakhSoBZXBQkNHVBl3pcM2F0w&oe=69D3AC31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQz3HnGEhyUQ7kNvwGg6L12&_nc_oc=Adq9t8unlUq5JQJVUdRUL0Sc2sEK54zxYGtK9rXVzv_kb_4TNTvkHISHZk-519bs0Ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Pvso2kU-cdH14SlvN0xI8YXyWNNr1QuZCyrjD_unStg&oe=69D3A509"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcoJlWYJLtwQ7kNvwH85b-y&_nc_oc=Ado1S7XI_Sg0YOhJT9Ps733yp-eXEMbVfnpq1-IeEVK_IyG5EIXuGgx6pdiNj72y4bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xpw0CkoPPs44FqAXc8g3uky0J0UaL9x6B8I7SpCswbw&oe=69D3A8FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDWG-mBienUQ7kNvwF-dDJt&_nc_oc=Adp0jKYU2V3egXrREH6OBtQ2ve4iR41BORARFDEFfyiwjgC2c6BRYQnIuPt65fLFk6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0STcrDGeFQiv7DF8RbL30C7ZoiydHKjLwVwge_7aVEXQ&oe=69D3B96A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
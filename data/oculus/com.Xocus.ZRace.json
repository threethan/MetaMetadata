0f&oh=00_Af1F6W7f5avzVKf1MgD0-x3-rZ6QJsJnPGG5HQjH6OkxaQ&oe=69F4C0A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-66MVGwBm0Q7kNvwH2ZA8a&_nc_oc=AdpD7NBO3T4oo9CE6mzf6bfjTd7ETgrHSLk46_nJCQEY_p8kLn5TRL_rPN90FmEl0ys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3axdjL9lx7wj4jicU1hpZX-ftK4blK61TCXLMyYssvlA&oe=69F4ABCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXoqJnQopvcQ7kNvwFSSp0i&_nc_oc=AdqFFUn6yh0tKk-jHqFHmzVHbQUFKZIkObrRWZmmHYLnxN8o_e3qp-jJTVOplo4zLdg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bdq6OkmOXF1Lkl3zojpVxFlnr5CvWXNOOeXQTzrivAA&oe=69F4A1B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoqB3Sq1OFYQ7kNvwEmOBkn&_nc_oc=AdqboMEL3lc_rgJQ2cryFbhFqpqrJ4rL5NxPjgQnXazVdjtmTxS1y5dKSHrRdzjfXRc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gk-EDE6I7ZOYDY5xXrSug_1j9R9BPuE9GCqzdcGSOMg&oe=69F49A89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZYQ_64zOgYQ7kNvwGyy4eR&_nc_oc=Adq-xq1Ot-qXb7fZ7K-7kIgjjkOCzezhx8_RnZVymJjFnS89XGqh249SrrU0miycvLc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38ESC7oI-HofEIrkgMeqAd4_QfWGuvtwJhk1HtgMQpCA&oe=69F49E7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt3NfwmYV-EQ7kNvwEB4kGl&_nc_oc=Adp5NbiJc4gW5i6l-u9RiJVyxamTTmRWBWGWMouhE7h1Ehb7dG4GEL-hEZ4-4kgKnwg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FzbzHyplOYwGHMLvtr_F1-I3Qtkd3UhYIGHJ-26U6-Q&oe=69F4AEEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
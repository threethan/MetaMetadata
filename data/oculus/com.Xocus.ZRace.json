0f&oh=00_AQFKJU6EIX1SR3gzPyGBUk5KSz-TJbLZLCn2TyjEHh_RGA&oe=6A901961"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gug4Pqwp_PwQ7kNvwF_C-sq&_nc_oc=AdqnFoJ3TPjikMLyMNOLPWEhl0YGus95elB2qEW90s9lUayi7RMTFx4yakYTqsIACWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt_4z7HMuMJ3tm-ilbFGoikPf2QsB3brLWCNpZRzdMTw&oe=6A903CCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbfWagd3DUAQ7kNvwFWEq26&_nc_oc=Adrrpy-6S7nus-PmHY3maz5tS-V99yedAa2cx7yV6_lLIxIztn32QMz6-tQUqJMFzV4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhO449s1Y3xvscPOz-8SsAk8yg4URJ7XwZpG5dEkuDYA&oe=6A9032B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgdR3VpaXLIQ7kNvwFb3hrX&_nc_oc=AdrtOrKb3Aw6TBjgnl3uDhJojKLT86M3ItUwaDGTGJZRi6em2n4R2buUIU4i3LBIkIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKcqOgT2niM-_PYfQOxNocnLXq91Kce4Lkt7vd-Bbpiw&oe=6A902B89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNXRzIBC8JoQ7kNvwFVXNj7&_nc_oc=AdrjynI19YlZ-SBxCjoLikM00uwxkMifxz-aQV1BQJquE6l-Y_F_JPQN1rmUcBJTRDA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy6Iy5wj_eoY21ARMMZXdM-e_gFOVdeX2_jyoMSoGuxw&oe=6A902F7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGVIYaTs604Q7kNvwFuk5_K&_nc_oc=AdoczVNhSDC7fUkf76aC5Uui-pZq8-YShPajG7ZdvphPG85_YJPP9oQvn7Jf_GqaAU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDxSyLprzRKxUpkmIIT9Kq4GRA0ud3By3m_4dWZC_I4g&oe=6A903FEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQS0B3F8i_eRWBnzu2lIdEZIpIrPpNyFsh7vVf1bN4vDmQ&oe=6AEDEC21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4uOGo17EWUQ7kNvwHJS3B7&_nc_oc=AdrA2SCZF1zJfCNQuFJAG3AjELulHZSjk2_0tl9omoK-PoWnfKHSVBjnVB2WKubP9G8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9OSyNAiDgmjRFJ-YWzVasbDVohJ6B7P0IN7tW7jsRAQ&oe=6AEDD74C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSsnbarcDE4Q7kNvwH2HdmC&_nc_oc=Ado_uHUZYU_yaA77fsG8Yi5mMzCMuO3-yys3R3O4exS7r1wFJppUXFaZe0wlH7oTddg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2ZD8kci0oMh2SG9m4Zkz1LxY6YSsDiMqI4G3sC5r6qA&oe=6AEE0571"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtce5V9svnEQ7kNvwFe_wRC&_nc_oc=Adph7HThmN9DyuFkEeMOSFqLkyTAYwZAKb3KWRwXGryrg9gw5VEu2scFRtYAE5fkXv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9yekQwN5Mq4KWb1t6WHqEnec1nXocpBM80jP0_aEfog&oe=6AEDFE49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfRwF39877EQ7kNvwEoCT4w&_nc_oc=AdoJL2Scg_MTcYnX2jt39sevkru8SIWkxCSI_kZ9LYXTbWh5OrKN4I2a_0_tIosHMrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkS07D_T-W86vHIC91An0lMVgDiHD3JcE4KZ7-SFkjwA&oe=6AEE023E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s87vKo9msVcQ7kNvwEMakdY&_nc_oc=AdprZYWGohnIzy3g23-V5DhpAEtUBXQfwH0Et-vgD3wW1GoAiJUP7JQ7DYgahNddHiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTEZ2aD1fRDneai5YPgCJxOEw_KD0udcNwVUW0-qZULw&oe=6AEDDA6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
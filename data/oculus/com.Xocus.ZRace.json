0f&oh=00_Af5_LC73FOyAHzE59E7wnvowD2kZinMXaPP1uBjQAfpLzw&oe=6A009E21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMtKzxWzFo0Q7kNvwE3BU8m&_nc_oc=Adpy_S0gph21tDKsDINAK3-bjUPTxov5szJb0JCS6aKVEk1LeLCebiSKbVfrze0j2Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6074yyNknWBPiAkE33JK7hUxOp8j7yhZ5MniLIZclljQ&oe=6A00894C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWZsslsj7lkQ7kNvwGgwdwj&_nc_oc=Adrp1kHXMSgHG6utkBel8UhRXshgQI-ZPT85f4W9aPEab9wqRSfJT1xszX5HLJ1JRtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HvBbfrUK7H2rtyJKpGCpjNhXcu8fy44aoCOvU9QUSZQ&oe=6A007F31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XsHFFBjZjIQ7kNvwFi7tPm&_nc_oc=AdoBN1V-6ffNzDyl7Dc_bozF7jre2rYZN188xQCyRyPoUZ8FF0MfTNN9-252RdQx2wI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6waXOmSpUbmR_4RStmxTpkHXULs3nRqymewuRB5rq0uw&oe=6A007809"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krs-LypSBm0Q7kNvwEKYBEm&_nc_oc=Adqm0qCMEpxjgnSGKkLz1Hkib62wIkhIpEq0tJasGCZUyIYhfFNliMM3sd1b4xwuvy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MOqn7T5bEMLhDC7LiqoubkucFGSLi935x04zqcrr3IQ&oe=6A007BFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWfINyhq0KAQ7kNvwE9Q-h3&_nc_oc=AdqDHQLbyb9kenSaPcUQOpp78ilZJoPHBz-EfrhJHVEYaITPIs1xO1lBpz2-GkCSV84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d9TccYwUyGp0_nv5FoOyKJFKH3lyuOHmrSl4Wn1Enrg&oe=6A008C6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
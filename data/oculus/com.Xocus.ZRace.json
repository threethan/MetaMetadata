0f&oh=00_Af7jFvih2ceS7wHmVLiDYaLEMvBcWoB4WZ7adKrqb2bHgA&oe=6A0C7BA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezlmw8et5sQQ7kNvwFTdoTM&_nc_oc=AdoWg_DsdPY55oQPS0NsFwNgeSkaSxKXCN003OoQ-0akGMfQvEzGRpe8GdRlYbMvR8U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52UPeZihJ5SQH6Y1e32T4yHoKzsZZTEQecuDluOsslFw&oe=6A0C66CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKZPQ_UTAU0Q7kNvwFdW3yg&_nc_oc=AdrL-YiAqa2rISMj49SPelyH9WI0heo9YJEgzi-PJQt5c1IM_JfTAvlThv3HMjqHw-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5abV4Psrcq7UFjK2WSecr7oDqhQJuru6MHGp5psuOAYw&oe=6A0C5CB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co7VIBKTPrYQ7kNvwFBNWBZ&_nc_oc=AdquZpDUQ8sz696q6aDP4P69X0mgF80XiqvPwwLR4K30YtcgiPiB_VADu-tTvP5qh4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JtVylgq7sh8VJ27WQkOBUplII-VZ3mTIQLOrySHhc4w&oe=6A0C5589"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irA3bi2p0n4Q7kNvwHlObTP&_nc_oc=AdqzmwEWcRIj0_m-ATqbAEInrkZxhU2GTk_YsJQrLVBPQ2B37tZn5my0hPe5RttJL8A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hQ8BDlVAvCgV-82vYAeXhWS4LEyFc6cdqMLjaTuwNAA&oe=6A0C597E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LnXSVtkoRgQ7kNvwGL7-3K&_nc_oc=Ado3Mtw4HJwqy9oBnPhB5j8heh7H8-I74N7sDrBAD-s38b9yD_Bd9l7HYaOI7_Axsio&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hPgs7uoWkkbBO3wmAlyVfYSETv1-v0NsuO5bpAhT_kQ&oe=6A0C69EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
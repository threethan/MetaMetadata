0f&oh=00_Af3UhYQf3xhptC0sfZ7SbmI4dnTi_TjfNVtLXgJeVJ0gAw&oe=69DA2A61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1D1kKWuVH4Q7kNvwGwkjhN&_nc_oc=AdpD5aUmbt5BOL9vxDKiA4jjUOOw_NSlLoR9m20wjQMrwnwMWYjqpTgVnuu4cAdwD4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MU9WkhympG4H6IcnPCqYqSQtAlnD4G3XoGN8ruzkUig&oe=69DA4DCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zh8-429krAQ7kNvwHXkkMy&_nc_oc=Adq_3BDQle39DYvncA_x-AjEgKFbjlBKmmshCKEP5bWGxGXs3xOtj7HNFDYF0iiVuKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EmVJ8c4JVWgEutEiMUjUAqTx4rx2xbpd1TrMY5-4OtA&oe=69DA43B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3HcrVfdjyIQ7kNvwFobYLa&_nc_oc=AdoOs7p7CTpFM_lphr3J_eV1pW63hf_Y__RwM2_ot0vkK313nkp1EjtAvcnxE3AsCUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XyPGO-_kdq8Y8hLe8VMO3Om4ErbXP2t7GIL8HiP_EIQ&oe=69DA3C89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmx2gDJKxgQQ7kNvwHkl2mE&_nc_oc=AdoLyy1xBxk4FajRdgTynrcE6_TQ3Tta8vbDlIRy3mICAeNIy9TDzC7sct4z0G7w9yU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E2jBe-e0c1YU-dB2UKjqC6mDzMxHImhDFs6-AVRrgIw&oe=69DA407E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om2hJtNtL2cQ7kNvwHXiFvw&_nc_oc=Adp-LYM9FoVk0KlIPLESgHqCYn1zy32qJZBL4GS-SlztkYfV9Ao00Gd2kGPrCkU58gg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U4ii6DIsDJMxJT1KWAwXtKEdqat2pRj0WcB-C_ZaHIQ&oe=69DA50EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
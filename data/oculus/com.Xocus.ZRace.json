0f&oh=00_Af-IsVyxE5RtOkkC5m-OBhn2oIBY62gvynf3BYkD7rgcwQ&oe=6A282B21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWxIXS-x_6oQ7kNvwFY2Frx&_nc_oc=AdoQNLm3Glud5AJhVm9X_nkmnt3B74CMzh-MGoGF1x-EiQ2bjXXaV68csXVaNDwfSHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L9Ja-2Vxkc5qJJdR3zQQte6VN3R3DySeI_z7-j70QmQ&oe=6A28164C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQOd_TO6KUQ7kNvwGn4O3d&_nc_oc=AdqVPKqMUz1PF1g7DvMLz6mYdEV0wIAge1W3ZysSYrXLqSlvuDVZ8Tc05s_2QsOovns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LBqgNMUpUzYloSiRMqzqiaQUujTIbaqtwc1vfZ8ON7Q&oe=6A280C31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kryh_zVEMNYQ7kNvwHgmHxp&_nc_oc=Adre9EqTGMojuXfIQwHmDS0_x75_vJAtqN-Glp-Z0DvNcyvk6Oexu3ymidsgc2vHukA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aPTQVtw14ZkbgRFhptpX0-eKHIgQ_LdWhOztjQLqqYg&oe=6A283D49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgoNp1V_0I8Q7kNvwF_0aM1&_nc_oc=AdoI-XVU49iaDSNx4QMyo92_qJ81jQ4A0q9g9S_UVEPoM99L3bWNclv1rOJUvoxAhJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cpmr3gGyVwMqBY2-nJZumcraO5bOCtMJTC9W8uZZOng&oe=6A2808FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0jIpRrt2-8Q7kNvwGsitzQ&_nc_oc=AdqVBHyBP58m8qJXE1I1NROlUFnlUhpOKPlDJx37o84hB0j6cvBn4PGLhicCFRoThPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o_c2drAOXLAyMMDMcRCA3B3yRbMtetDUzuTNGaIDWgA&oe=6A28196A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
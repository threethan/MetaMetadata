0f&oh=00_AQCzCV-D1i8odHJXdPw4pFt2KSRaK0BjF-2JmDLcVds7Ug&oe=6A6F5C21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPYVQqUfPtgQ7kNvwHfcKGm&_nc_oc=AdraPKVMDBO9vkgAbQrG6d6QsAyD3VuwKc4w0ADg6g2d7KH-ajI08IQzhJm7uSJaXbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU6Bti1K6exZn502lOKHQ_-LxmuTCuArB0il3wJtQjkg&oe=6A6F474C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wqhQbkorTsQ7kNvwFZkrk_&_nc_oc=Adryop7tL4kWzpikE6oomT1f9EihGg9KGcoxeAaAoaW5KULwpijU2hNC0KZQgKarepE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_rfxwBZXNTMLEodrOg45_HwbXebH0x_gtug-HDLVy5Q&oe=6A6F3D31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1TvedjfWHcQ7kNvwGqxuAB&_nc_oc=AdqIalCHDOZSXpf3qc-qWBfgfsHcfW9TMFM-IYyUZlw3Xdm02kIJQKEfqXTfraAIG1o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCEs-Iy6MrT5C05Os15CqTd_dPOTH0lJc92RtY13u78g&oe=6A6F3609"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMPyJpyZF1AQ7kNvwGZ9MYw&_nc_oc=Adq2_UDFnRSZDHfL3OF-voZv_MmfhdnjxbSifHfAEeLz4ZDKSHgRK6nBcrw9FOoZQ7g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApjd4QOV2axbeATtSvb77MRV8ql53Ayk4xlncKubRyzg&oe=6A6F39FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmz75OLT7GIQ7kNvwES7NP8&_nc_oc=AdoWpew5JETOv4WduJew2hm8XXLZFHuzrLNsFcVCJqcIDLBgq-XCasbap1umoHJZ8DI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeYyGAs3yWm_n7upgT9xZOJ3E3WGE3OciPey5PeJ6UMg&oe=6A6F4A6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af8yMbJwkpWRG_Y93kU72y7WOO--yADjhGw9mMxuUcd9ag&oe=6A297CA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWxIXS-x_6oQ7kNvwFMh6Qs&_nc_oc=AdoO447sjGHAZr3mtaUI9Mn2Q-0xEPCNZ9PKf8TL9WlFRL3tKivsIRxEF2eMIiLD8F0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FY5JOLXHo84-bcA7xfDIRhpKGgLJj50JmHAh9DWQz0g&oe=6A2967CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQOd_TO6KUQ7kNvwG0MZUn&_nc_oc=Adq9Cs9hRdmdKkf2kVnPD6EfJILRhJF16omHH83QDXZl5243S1q_kAO42MvbnDSIMpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qd85jdseks1fbl037pvBktfmHz2XoCxi0GPWes2jGyg&oe=6A295DB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kufHRZaPsPwQ7kNvwEqhaFs&_nc_oc=AdqbEP-JzR0UfJ7RKgWg19pMugWE8aqHN6uhLKjxQMNr7GcABixzNxRdw9IQV8jOns0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Kl3bjB1WX-2dVMNE2KTwU3R6YPw73EH0Pk-1ogIQLQ&oe=6A295689"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY358pWX1TAQ7kNvwHWqMgN&_nc_oc=AdrXCcDsYZYVbc4MoqEBvzT55gnTS3ckARCh1WOL0qJgQtxOui_aqgJDWDpanqss8dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tZYEWgsNcEavRK9pcrXFt-hC23jIwax5ol3BGSsrahA&oe=6A295A7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eofw-Pd3vocQ7kNvwEPPprS&_nc_oc=Adq8trVSNUreiNQDZwLyvZ7v1Qtf6AGccPxjDMPOkcElw33pyOTvCAzoP73j_MnXOyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B8mUgJhPVlfHET8Kq098sMfrL2Gvde0Cfjt1DR0wFSA&oe=6A296AEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
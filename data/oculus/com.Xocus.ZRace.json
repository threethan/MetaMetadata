0f&oh=00_AQBbCQOhOGhTQ4xWwSZuS02PEq9LqFxuWGqa52xxDas5wQ&oe=6A4A7221"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPY_8YRLHmwQ7kNvwH4ANWp&_nc_oc=Adqq09N5TBmTVK8n6B_Jcd3e_PcZ8yj8eL0Omc04NDXmYtc4kTfuHMnGL54_XIrYB_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlP3VLrZC5PY7dZaH91dCcgzl2xgQTZ7MhjD_vRporjw&oe=6A4A5D4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeT73N406BoQ7kNvwGaxfYo&_nc_oc=Adq5FlmgAfqXPnyAvwNJwY4gBtvHrSrw5TEJTON8_bGCbVu3T8kcvevTielwvtbzWbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBKqjbp3iqkJ3IMZMfEoZegqib9PesYeXf3F8ps0aY6Q&oe=6A4A5331"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifPImlEsI4cQ7kNvwFn5UHR&_nc_oc=AdrqkGr12jVPqw31V005HxjOy9iPkGyuhRG2OXj22syUwNEjTRv_Co1rAlkX3XM8r8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7jusBtRDkgXxkcYH0F87MJXKrAIFcC1OMAVviIYJj4Q&oe=6A4A8449"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLC8wGF8dQIQ7kNvwGjyhOC&_nc_oc=AdqBvjdM-Al544OhWE75WGIuXJAgjivZNiUOP8EuhyY8JRHpa6syF31lKoseazt6YZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5uC2RiRknD58-zBCyCpcBLFlEO40f8cwO4pNUmOdBJg&oe=6A4A4FFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNfHnT1A6LsQ7kNvwGr1eYd&_nc_oc=Adr54Fjfn3vrkb3QExsoUZSZrqIlCngUxtCdWXHaJ67aCtSb0jh79Oy0LHNGVIc8jJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3lxZZ9v_AowBFv9qx_Jd1qu5Ho0Lnn89GIXJGnrBJ3A&oe=6A4A606A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
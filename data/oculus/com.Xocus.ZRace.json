0f&oh=00_AQEJJFcp3qMEaGSK2KFGBQ_q_LJLWsZzRIlOui8TJuVd2A&oe=6A940DE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McRj9rQt14AQ7kNvwF8DXOp&_nc_oc=Adobzl7cF5_V_Uh_qU0ixTFnWcFyTHLjMeDMafoxvpMA4QKHavBoeiZ88-cJaTWPx2s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbV4DzHeku8IaSrZ1_qIYNmYrQ-oHvLnZyM-3QH4Zc6Q&oe=6A94314C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oU5RPctvZoQ7kNvwH84cfg&_nc_oc=Adqnz73Uj9oECd42r7-lIlILgLT6KtZjaehWAG5cnlv-5fiAF34blDibKUTkFralijc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr9EwtB3Zkr7Pd4lu-DkhIL52Hb9c4id1b9xH0lQyROA&oe=6A942731"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2xBtWLvV4MQ7kNvwE-SQD9&_nc_oc=AdqEcqhZh8eb8DLCI-R7HIHZWNmjAFke5Y4ED3wwvbAv6ERYIU-ZSEFqRVem4qeqo_I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhb23IXz_OKAASWpbxEj5lULi4P-K60Bl7QU8B3EoAg&oe=6A942009"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqdENoHTYT8Q7kNvwFeANTl&_nc_oc=Adom9_NHByWKlf5qng-d3q0xxRwX3DSSQTpcyW9pPtTN_SjTpt42xjY0njl9X_cyyxQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd-1hbAxhT_pjMlLgKtVMpkk9BJMXd-IsGOMTWoGRcxg&oe=6A9423FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N-xuFD-jWIQ7kNvwG26ciw&_nc_oc=AdpUDzLOg-evkwzh7ca-UeJhGkPlXr0mfrluPxYtZpOxr2-ISLtR07HFT9XK0DX8awg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRvXiRt-40bbdGT4tpZj8QCQ_fzfjcjfMOkJ0_kIpshQ&oe=6A93FC2A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
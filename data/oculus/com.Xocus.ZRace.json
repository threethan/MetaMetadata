0f&oh=00_AfydBvJxBmAciTJ0vRzyuLnhkCBeEWWfpMts0ikb9iMgrw&oe=69D0EFE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iINjALWOYZkQ7kNvwGgr7HE&_nc_oc=Adol_bkewvxDJplb3hcGHl-S5yuTVso74jmYfHjIkM1pRlp6zcx6pYNjHD-Gsf2uCj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYOJIniqBpps1GbpKiOt0Jb8v9L-UJsUDu-spu_KtH4A&oe=69D1134C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_sX0hZ9JzcQ7kNvwHnhINu&_nc_oc=AdpK4hUUWOXIGvloo_bjko_IphyRjTGgKZElRjiuGk38DGB2UDnlzNzJAFVqB5-ol0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjUJ0S1WuEnZKOsbfUoRNcjrTpjotvQQSZ4q3u_ysiSQ&oe=69D10931"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyTOUEfqAwoQ7kNvwEZjUZp&_nc_oc=Adq4vIuS9lBAYEn5ZNqAkEzQvX-AJaKGMszv9BlXg90I7fKIO_--tpT3k8oFjs02UQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMVpsa9mIy-EVRsTueAE_dHqlacYY-j66oqefkgsJRwA&oe=69D10209"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQNfWmjDRjcQ7kNvwESh6ca&_nc_oc=Ado-n-Rm-8byNDZIzzj-7AuLS_2FYKeAfvOThZa3Itf4_eQXzPL6wOSgSMf6cZsT-lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHXgCtrEhE-wwZDjLcR9Fgx5oAmyaEQRsxSX1qSBgqUA&oe=69D105FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH_oOzvfzqcQ7kNvwEfhC7v&_nc_oc=AdoD-QixsBjrlkwbLwrM7pd-7HCjC8Jv7X5g-nYnbMlj3Z33EAAdn3sA9g9FWnl85H8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqXlXVGW7KddOq8dj8VuSWhibanQuJmOg7EPydYvIl4Q&oe=69D1166A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AfzcQi-NxQN1k65xuqPU-PAj4DEvGBMxqPw-ErOs1Z5AIQ&oe=69CF9E61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iINjALWOYZkQ7kNvwH0Dump&_nc_oc=Adr3xhFzzockZRYbTpCh3qzpPSPFaYI4HDTq9wijOuhsoDtjgHhKzFHfqbXS44-QUws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgmteD7uIITwzgBU4r24XR2JwkO43ppuzg9pkUKP33mg&oe=69CFC1CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziMdPjutqAAQ7kNvwHOd4AV&_nc_oc=AdqZ1vMx0MsXljn8RZ-J3-VRGn5kZzm9s4dUJJ1e_NNHchX0V6iT92QXwhFDQYP-Tdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyABNwmy_phAKSIIRj3Ao_2AnijXo0E-dXsm1c4WUTorg&oe=69CFB7B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyTOUEfqAwoQ7kNvwF66e1E&_nc_oc=Ado1kx6qYYik60mNN14z3hwa2M8ZXjHAryWphWwPCkx2Jt5gSclhbnfV1pPqCUVxW20&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjxyEnd8v1FkZC5uY3-mM1GkLoT_O6p4YQLgxUPC338w&oe=69CFB089"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQNfWmjDRjcQ7kNvwFtmGDx&_nc_oc=AdqUH0Xovm0v6sPpTtfz1uny8RnMhgGZwa00mJbkkvLlQo0uLacjstLlrcZjpsgifL0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4LrvlgoVV-gfg_3qDxplXU2LVUO_hdiCoRhtlU__qjA&oe=69CFB47E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH_oOzvfzqcQ7kNvwGruWLU&_nc_oc=AdocJ77I8fHzXl-GidiT0nlKvx8737nCQC1C5NfKskkoy2qjkD_oqOkN85Fu5sw1waw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM4dh0tV37niLcukmvyhgBwwTBpvby4mV7Urp6C2wcBg&oe=69CFC4EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
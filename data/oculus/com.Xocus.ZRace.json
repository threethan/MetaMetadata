0f&oh=00_Af5J7sq1XvfotIlTyGVGA-nVRlms1U2dixdJyc_F-HEhfg&oe=6A1AFC21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gznVcbaOzTgQ7kNvwFXCk_8&_nc_oc=AdrcmuI_5VOECDd36gqfr3IvAsI5kICeUQLShfAD4PxuGsd5YLGJVu9izJMgVrsrEDc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af776Jgq72X5S0UEhkIaFTma0dm5cLTgXC96Ldo7pbI_WQ&oe=6A1AE74C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4LJrzGKgkcQ7kNvwGRIkKT&_nc_oc=AdqVh29LBYuf_vKIELiThHjPjmFrvH76GPAGGSFswIkNDRFMK_-ZNWSGkfoO7w1f2CU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46jxvMsum1z04HfNn4Eq5nRAh3lOvdfVat6LPevEnPOQ&oe=6A1ADD31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOBT8vDhTJ0Q7kNvwEhd9PL&_nc_oc=Adpo3ggSpgZ4PoQpCe8vCG4L2c3SZlEiJbAJCHCFUW3IYYNzHDbHubd6Er2QjQMGpE8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mpX7TFvH26JW71bLrN8OmylWgyi3TMIsGbRGswXVJHA&oe=6A1AD609"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8IzxEYvxJ4Q7kNvwERhw-m&_nc_oc=Adryu-0-6JZCynKDsC4Q8nIfzYcTZ-cRAHD71ZET66PH2UJVyX4DzDkl46Uk0IRlD5w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U8iCxBHlLxTO0G9ZJVZg6njoYjumjWPGPEdGtFQKlYQ&oe=6A1AD9FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q7qMwqrKQ0Q7kNvwEeZvtC&_nc_oc=AdqhC143nyWjW2uWgjkT-Wsi2TG4RouGkNNuhY9fM3q0axvayvsndoswjQ73Fy2CLrc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MQi7HWb42mhnN9_b6dfzSE9lutt4NpgzlnQXEIKnTjw&oe=6A1AEA6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
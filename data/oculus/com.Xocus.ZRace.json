0f&oh=00_AfyhIKuOaATXUNzllSnO6BkYxBCUkZwW1SsFycmjZXN8-g&oe=69C906E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STGBj-HNVsYQ7kNvwH5kMWa&_nc_oc=AdoPLA5tF5IP4wx9YtMCvP_lpSg1J3yU80LEmn9DUOJSfPl_uNlc7VbZLugB-sNYkfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAwQ4QmdRyPh3jz7bpOVG7OWHk8hsVX38Oe487gQD7iQ&oe=69C92A4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUFfMPpRTI8Q7kNvwHGdYQN&_nc_oc=AdoAPNqI1sE1SCPsSf7K81nHfnePBlZPEORUtMO0djmDYOhyYJi7A_SdAmYKJZoF5IY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTVv48tQo4wCwGA_Zh4tL3Bo02Kb7h9z35yooppsVM2Q&oe=69C92031"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0OJ-IIOv1QQ7kNvwFUlAS_&_nc_oc=AdpkqDlv3nKxHwCr_vNagTP3ZzMEws2pg-cgV5RQyjwHXqTlbjRSVTSvGV9IJJuu8ac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRhHSbok42yUVhMSPd8xYb0--njMEKWJW5sCkXUQ73Hg&oe=69C91909"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUSqTcI05LoQ7kNvwEG4P0Q&_nc_oc=AdoUo3vU5-P2zboNPZlKC_3HlMSSjJiHoZntC2dnusHTR7ek0HmDQ0tjz_eg742eaWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkEOSBooMpEtvX7MIobGX02viGWli27ONt3jy93fsjWQ&oe=69C91CFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgWTde24WwEQ7kNvwFIXDO3&_nc_oc=AdricBV6TlW91cHw6mQjmkft_D-VNA0XnlZwGYjEGU7wZXJWpXn5iMLZXeytdK_4Xeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzoO0CB3BtMtAiM_y1eLXAPIqffWRdlbn2vtJiKVU9oA&oe=69C92D6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
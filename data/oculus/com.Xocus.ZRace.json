0f&oh=00_AQCjoovNWV9XGY0u5xUOohZB4GN5j3RZ33v6IS8vwJJ_fQ&oe=6A637EA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDZCLc6luboQ7kNvwE6s0Qg&_nc_oc=AdrIMOPwa-DXLM0X8Y6XhJLnRenzuJ4PMWoQFbaxyUkuA2oRyBDd7KHId11Z31CA-5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdZ_18h--t2fzAitiHJFa5cFk9U6KXtPMbDRSxQytsiQ&oe=6A6369CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oGfXItczCwQ7kNvwGqPWgS&_nc_oc=AdpiVA3VpYGb7StuMNSUMEqayWRoIbFFAvjHar_XfX1mmi6LtIslclo9md843stsZaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuInRZRC7xIYRzoQa0QyXsUmVkvzyM7oZvIddPogm3hA&oe=6A635FB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agNNIo1e5f0Q7kNvwEk38-P&_nc_oc=Adq8NbH-E0Eouu06Ke63nnHIqNpU2IuAJH0A3enqguXcZpbtZXZAN4wIUjCpCNuY4no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbv8IV2n_i3WA3Ft49f59XO6BEf4XwQbHjhTuFDkaAnQ&oe=6A635889"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39qMjgYKsysQ7kNvwGNLg9x&_nc_oc=AdqpZQEA1jLdMdwThPTDUyYnnppOpnUKbk2VtS2N0qXOOkpEMNhtCganNYGQCAapJVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyTN5ku9FZ6sKJfdwKUFdH_gksT8Cz2hgNqYzkKktbkA&oe=6A635C7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iGnTRU9mfwQ7kNvwEk6P-U&_nc_oc=Adqb1lyB9IAy2GdGaQGvBHyXkWj4_ZcsZgBSJ4X3WDYujsh5NV4MVIHtn3WN857uOhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASKTdUVBZFDPlyrqXD0oIK1Forb18Do8-mceOuOEmnTw&oe=6A636CEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
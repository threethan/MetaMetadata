0f&oh=00_AQCJ5JqV8def_atEezk31LhIO5jQHcCsSGbFrE9cxCbWFA&oe=6A564FA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MdDkePNcH0Q7kNvwFWVrd1&_nc_oc=AdopGIEmyWdz2nIWyiPX1kywGVWM8M0FC-VzGOmxoLminxxy-U78wBztwlqqKMAUD5k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn7UpqkdI_zVgzyKdPYCpGtjuUgmljQ1XLjZ9FQSswuA&oe=6A563ACC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmDEK6mq5dIQ7kNvwEImqls&_nc_oc=AdqvTHeCP4jwPWmwb35nmtIcVWiPEVe7jM2zQN_fRYpvt4g20pN5ia8s1zlqlkwTots&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfZu1ja25CJvO05BgVeKgVlpKsQcFK_rcDWFbcgSCV-w&oe=6A5630B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqh0eRkKDKQQ7kNvwE4psSr&_nc_oc=AdqwXhltolGWtFlrVBr0Hc6j_85MI07o63DfKQy-vnoAn5ZHz1yFEMRl1vmpORXKoU0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuWRxyI7grSl6LthcLZD22U7SXRwlnnv-GwJbDeOUaXQ&oe=6A562989"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJKEExc-yRAQ7kNvwExCbdT&_nc_oc=AdpUPtaaT6Osa8mMJRH9TzPnIrU-m7z-OLQbrpShTyr3XZH4tBhzwJEbGNJM-5O7KQ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAenI3bBd_hrUp9u3ph69FRTEyl0MjP9080wSuBFDOYyA&oe=6A562D7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dU1ALjsPzUQ7kNvwGBTREg&_nc_oc=AdoYd1zu8ARQuujwEylv3D4Fs_XP6nbxddFtQMvYddE3kfpo6_6R_RF3Y8j2wrqi1B8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEeahL5X7UyAVTex1Tf6EWm4Z6Ej0rH8oTxlyJSXB-XQ&oe=6A563DEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
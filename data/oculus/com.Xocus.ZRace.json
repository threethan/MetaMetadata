0f&oh=00_Af14UqpR40iSmrfHVsnLoKefzV6QG57QtG1Yalm7k9OQJw&oe=69D4E461"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsOZj6qiHDIQ7kNvwEHFnNV&_nc_oc=AdriR2tsn3smBhb8YmwKD7Los0wFJb-sif4Z39xXIzrQz9_BMuHG1IIs3kaMmgfOLJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iRrkLZwQPj3N7ZFd_xqhbPlEirjzHD7I6sC64qD7Ifg&oe=69D507CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcA2lK7qJnYQ7kNvwGiBA6v&_nc_oc=AdqD67co6TegM09qB7GhMK9omvWP-3xM9ruCfj9xqEVKwY5mb8ehfSukTiCSNt2sbDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gry_ha2Riumeaqb1cuVGKzet87vkMzyi8rNAU-NWv2g&oe=69D4FDB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQz3HnGEhyUQ7kNvwGMOdOw&_nc_oc=Adq2GcO9lk854j1bALXEYXYMz6oiCIk2J7I94Zos4Ccyhxw6u7Cvnuwusy46cXOjPDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IKhJb7L2uILA9kd8uMoefSIM_itnIofwyoRJ4Jly_cg&oe=69D4F689"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcoJlWYJLtwQ7kNvwFpdZVq&_nc_oc=AdrevezBUbZnDP4dA_XLMVwokkdX7m2zWmeMHaFWfb8A35deLyaUBamBbjzveI1efUI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30vpLLFPNwgwbUazTDmFm55afnO8n4rxFrQX7X9kofMQ&oe=69D4FA7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDWG-mBienUQ7kNvwGLdkkS&_nc_oc=AdrdDcdjuL9A9Vyf82MH1jor32Z2lrSWK-ssrdy6fRfcZ7Ple2SzxJh2xXK-obdS3Gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25VLE5_C4c9srTpxPoUlhqrW989pLFGbb3Wtv_myUFFw&oe=69D50AEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
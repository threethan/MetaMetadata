0f&oh=00_Af_OhyWNfVZRE2IMIRNDM2ImuFEKpZ28Yp3lBAfu4244VA&oe=6A2EC2A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlOmcWdhliAQ7kNvwFJHvYx&_nc_oc=Adq47xJcQDXwucmbfQeH0LP0bf3zxwyBa2LoS-F89tZ-F0ZRp27aAqcb2S_Teo2AOEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BbZisZkgOB99uY_WBgdu5SxBq1-aIde_RajRUXr9lEA&oe=6A2EADCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8Tv3V2I97kQ7kNvwE6sgaS&_nc_oc=AdqypIMihYMrN6haqaQsxQ6QLUWqylP_WvsIMjojoBuuCJzpiG402wN-sZHGW-UpbhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vjsw20kywu_UCJ8sKgE5KzZmjs2jZBIGpwUoRnwDi3g&oe=6A2EA3B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvYW4YBoSqIQ7kNvwEJTjHG&_nc_oc=AdqCGTbdgOgJLQN9FVpIoQAkKOHTyJxVodN8BrvrQN2U6B3OnkWACJZcKJ-4v5vxojg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gIbOXmmsAXRv1yS-M14bUMfIyrZcNSTVYjll1p3Z7FA&oe=6A2E9C89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1WRCgUlToAQ7kNvwGOfbbQ&_nc_oc=AdppjrlIyNG9bh9BOwJCHsI7z87EyJAcFDQ_tbs3MXWEnDJzNd6UolSilBLdvHQgefk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7CfECcf29CrLy21T0pxzAvzbZ_A5wh3sfs1kqeA6Dxw&oe=6A2EA07E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY43meFjYyAQ7kNvwG-FZe3&_nc_oc=Adr4xf6CotuI9gG4GX7_RkMThMej_D3CA4vds1uoDWz4quBIZ0OkD2yJwP7mrJ8zlJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZTzs3XhkPW05fnyj2-jFWTwMh2GMydFGicEvgSRP3Ug&oe=6A2EB0EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
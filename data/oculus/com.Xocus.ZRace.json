0f&oh=00_Af1AXQlcbC5pPfD0sG7xpkX_luzSBlaisHZ2uYPhNsYTMQ&oe=69E64021"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI2ZMJP7CaEQ7kNvwHh6xZc&_nc_oc=AdreOZJMXnMP4TQIhQwJYnmPoyDYiI1Mdm7PAac-tn2m0S99vHUkMjLU69Gc0EHsGS8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eCnjL6hJ4w2PtDAPqd0nymLU__SxIJz5DDnh8OkP-qQ&oe=69E62B4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GapnVkfEGm4Q7kNvwFFQLCM&_nc_oc=AdqsIGJISEgCcarRZCgsknS3zoTjQgb1RRy3dtsMbqdyy8hkquAAbqsSnrYOdUjyv4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_biaPgaaxU_UoHYenow_ORmCsdFV_MWUGonYWlKbNhw&oe=69E62131"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6_MzUXpZo8Q7kNvwHSZ4Lp&_nc_oc=Ado6dlAIUrg-XMgGvjpVfnCTXkXvYKJZfpD0Gd8EISiuxUuZBOq1aRZ8BzollCUj1Ho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JdEQpaOguhNk4EM1UgJdy6JG4jI4ZE4BrO7Yv8pZbzQ&oe=69E61A09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqavGa04aTMQ7kNvwEn58vJ&_nc_oc=AdrnSBtBR8ZWsamHD3Nh5nNXcr_UvJIUe22rhFhmeGT3ik5INgob3l3Rnk_WsHMRKDM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MjBVK9tphBnLK0g9tNaWb83teVAVwTq-k8ulFmGrNBg&oe=69E61DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY8xAHF69LQQ7kNvwGY7qPN&_nc_oc=Adq5IIVvapFuuHfwwrP-K-B3nlnPBcQaKClOl54EvR4DQyL7n9R33C3FiN0AjbbuTSY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23Da2QZ25KE3U5PSREUmfz6YcM4OjP-l294RbOpbePLg&oe=69E62E6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
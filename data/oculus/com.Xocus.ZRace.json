0f&oh=00_Af_wM8VTxCGOobKn_prHImaklPkILntWdnKLDGxYpBxYZw&oe=6A37FD21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkGgeCXcmg0Q7kNvwEiL4Gi&_nc_oc=Adpe8xUY3ddZ9h1-Bzpr1-QerIzgCoiOlA_YPdP1hZ32_Otl7dC7uM3V8QPv2zTG31k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zgsi-SkhU0QYzuwndMRKebWG-iOLr5OPPoGErf0Dy0Q&oe=6A37E84C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNBxUQ1a30AQ7kNvwGbeQqi&_nc_oc=AdrcImon3w8ovum4cPx9mKm2L7B8bbA6RfGQ93z9CkQI3xjqKNifwiWq4hNKqirurR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aOytAu4FGZGJz70hklajXhsT2LhK4apnXazjZoFFYGg&oe=6A37DE31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaYLvUA5aZ8Q7kNvwEb_kJJ&_nc_oc=AdpuOvzrImh6r7BTOHoy643l1laaka79f_5lfRgKiaDk6AUr-6k0oqrHJFUWlk2wvRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ml-iGUO3QWEkoSY3TMzoPoLi3aEYXoTq22bLRMyQ2fg&oe=6A380F49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw0FKki127cQ7kNvwG0qpLj&_nc_oc=Adr_YpHed5_RpekkGXQlqSFh73kAXq1NqHMp9afEAfNgYqLyVQtXcvBRW2vO0guZFRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PgdAjL9cxungdIATbhA3G-IhxfDR7-V_7_xwqJnfyBg&oe=6A38133E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoCWTI839nMQ7kNvwEuK5AJ&_nc_oc=Adq3M7wGYbH-XpwV39gedbczbb20pmuz4HU5CWoSFvqf7syrCxIrxtQphSfDkbs1H50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F_XOj7mWtGOutaNvSgGGkM_GSRXV6F7dGzkBSgzCNEA&oe=6A37EB6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
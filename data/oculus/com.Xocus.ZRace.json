0f&oh=00_AQCKKvlkuJWD-vK4OixEHIc6SZA27MsG2uZbRzeNqzz2dQ&oe=6A4920A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5i6vVerGRYQ7kNvwF8vLCG&_nc_oc=Adr0xeB5a0ogUeOzvuAhLTfhHXzm-BGyH5Ey6KDVpJxLgowGw6F8DOC0sIOgDVqrHPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEbiCpKMD3lzU-ovRqARVzWjDx7A47Hhw5mAa0GFwQnA&oe=6A490BCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeT73N406BoQ7kNvwEwYUKx&_nc_oc=Ado8fjctLHMOEBiHNOHjD76WvBKTnT9sM9CckCwl83hFpxIP8T7LyLCy4Dm3le7T6bU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAih7KzrfhWXLvPb3Oj_Aj1VrudZUqhKKRRlQ-U_hygoQ&oe=6A4901B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifPImlEsI4cQ7kNvwHo1pzh&_nc_oc=AdqTd9ruwN-WUYRYogC9mWlzIJcFd48TX7L-sq1k_1graVKmZsJZ6BtSprQ8UmgO8TI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnpIjWyuzm8xyLBJfW-dq2vo-wYi511QQkKSLFqgeNHQ&oe=6A4932C9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLC8wGF8dQIQ7kNvwEsbtRe&_nc_oc=AdqXaPZyEj6ULnYkilSVmcWq7lGS-Ku8zesldQ7MHu77prt4sL9fBh-nVku2nYoGB4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQYOwv4w8F-PYQwPGp0v11ITR4AodmEPm5FSBx4T_uwQ&oe=6A48FE7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNfHnT1A6LsQ7kNvwGEqMwm&_nc_oc=Adpk6ZXTk-ZcatITGakYJK-aOpsAnlviBQVL-nD-dMJYtbdFR94ZJMbDwAYS0UtVVBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnltaUEy-62MmyqMSCTd4W-lRCyzUGVxio6C-gw5AR8Q&oe=6A490EEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
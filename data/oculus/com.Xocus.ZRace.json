0f&oh=00_Af6ATYCrLoGfON2GvB1FEgyzVYRqyrLF0_AM-wwhFmq8iA&oe=6A131321"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iFGWzJVpGAQ7kNvwFrXx7w&_nc_oc=Adouns3lKeJt3N-SrJVn99_nVlio-wz7Co6mAx0Mg4DsenAkJF-pP2YMyDZz2_ehNCw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cj1vXcq4xP5XaF39_Xka6uIg_eQwJ4V6_zWHVG_7Zzg&oe=6A12FE4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdr66fvmzjcQ7kNvwGn8Nwp&_nc_oc=AdokUwEpLdcZ3_YPtkpeEc4mz2oUaCMFmmpauOc-_5_RdG4ilbjThMID5T7MYaBCoEA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xItXWJtA0F5LzChdrouRxvqbWU_4nRb2qKkT8S98hgg&oe=6A12F431"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eqVi-jj1EAQ7kNvwGkkDgT&_nc_oc=Adpv03i36oyyoRdS0lC_-gXzy9gdCQtc_14kaBsMNdUFKKw9FxHpNITxwYq1JnacCEk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LxTBdMB9RrZhEVSF2CCP90IUeDEG-uwqZjxPK3YSjtA&oe=6A132549"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHxwhEoXAqAQ7kNvwFJR8jz&_nc_oc=AdpDlufkRUh5v6zyFqn0Qp2djY6tgD3Hiba1wTxeVoXIyVMkAYP0S8SBYgO77EL2GDI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UOq7V6bg8EsnHerEsJ5zjS6WazLmV2njVqseQEvXv9w&oe=6A12F0FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cWKMik3Fp8Q7kNvwFC1BM2&_nc_oc=Ado16siZF6xsjTpIFdA7U_SlaH8usD9zQQIQT6otN5LPJNtTE7U6Uih1hoDl3NbXrEY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DiKA8L-7CcVqKDi8Wc-R35ltfn9_VtBEB5cc9mJo4gQ&oe=6A13016A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
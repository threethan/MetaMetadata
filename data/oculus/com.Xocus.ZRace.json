0f&oh=00_Af0SCLhPlkpJpNQOGGuAKIIbxaYM3jsRGEcCd_Xwo1dLSg&oe=69F763A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTW5_FNvL_QQ7kNvwEkcNoD&_nc_oc=AdrfOepBT5t7PSUsHPzmnUzfImTuNOhHcE7KBQLhXO1fA074ED_Vf_YzqcBG_IIKcY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06dEqP6zvvrOidngPwem2eNFvtfywXQawfhYs6JS6XMw&oe=69F74ECC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXoqJnQopvcQ7kNvwH4CWP9&_nc_oc=AdoAuPxEz0HAIvqKmSChFXcfaXJ24dZExy5gHFqu4WsE1SNkeEUx-CgS09CvgxwvdDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MZ9BWMgKiypPQoCFO9ZXuhZfUfAV6vU_8VSwlNeFFMA&oe=69F744B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wky5S93jchoQ7kNvwEJRhDc&_nc_oc=AdrAtRJMQq1pQkRNC8ZHQOqDqNmc2652RSty-59jPxnB4RVK92-4qXAm01J98a-LblI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_bGsHUjDtapjKUh4b__wl1nrASjRj7MOc6efd4y_KXA&oe=69F73D89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1XDvpHKip0Q7kNvwHzeX5r&_nc_oc=AdooNWNejmj8HHt3UOUQCJjZ-IUk6FKQd2cc5UidDJ5E8pXdzUsXIHSEoWpAMQgKRCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zBkDA1D3nhRnyfr3VH3uhCa3Aw-z7GKlKlXnJ-fUxjg&oe=69F7417E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXHYYcBZ3dQQ7kNvwHHuhBu&_nc_oc=AdqQVDj2lXY8mQYH4s-rhSpxXd2j5W6MObAQxDAhzUcAHdMLPfo-UmjSY-aY4nWyxJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0E1PRDfc0zHPdVKIu-HNlEy0TF3lKUhFIg87zpUpIn1A&oe=69F751EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Afxr83zXf4XDaOlAnSMIE7YYFY8vcx1pcLR21TuAR-b17A&oe=69C7B561"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STGBj-HNVsYQ7kNvwFfqM1j&_nc_oc=Adrnb6FNAjLmX2WdsYgXlWnFIczp3K4hNyLvwgKQNIwXioEoVhKHQLl_CHszPdQu6BM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5TbF_bg1qh1HmjKrDVEYqySKSEMF7373G9BJdLXN3YA&oe=69C7D8CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkpJA-ut19AQ7kNvwGbGntz&_nc_oc=Adp5h1MoERRGsD76pf92wgczDlD07ZmnGFZhYkJ2bEoZLyyPtRcxlcDU8m4eaAShvmM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEQlLYd1wGDux-eMP90T0MZgCwoD-WuXDLDAcKSEkinw&oe=69C7CEB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0OJ-IIOv1QQ7kNvwFqt8bk&_nc_oc=AdpSjxtahmvBxAZZSdSoN3iU5o9ms8GlF8T9o5RNjaqukGxTjv_K_1vMJFV4CzYQUwY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgUSz_DwjrCf5GoN4q3ZzJkncQ79HfoSE2BT8AiMGxVw&oe=69C7C789"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUSqTcI05LoQ7kNvwHyU94O&_nc_oc=AdrfoCE9yb6SRXHQ_KLaMi8iAUAlCPFW0WvQhtRhANY-e1t6Fq9wQHypaLgb8jcSExs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8ygWTOZdDLhT72TsbA8FOaE57f98NZXQhPeqzM-O8pA&oe=69C7CB7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgWTde24WwEQ7kNvwEbgXsr&_nc_oc=Ado4MHbtkUC1OuNfMq4KviWvthH1_ACE8Bp-Vn_cuotbSOlS-xXbAgrlxcMzGeHpGqA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6D-SxI0ll-ZPANbkhE1GwPTQ7M7EZyzDNL7fmRXOCkg&oe=69C7DBEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
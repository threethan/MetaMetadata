0f&oh=00_AQDCHejJdxlpqDV2YwrOfaSBIDFQNLkgt82onmv1nV6UsQ&oe=6A60A361"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rWKHKflfgIQ7kNvwGtQtQS&_nc_oc=AdpCridxk4nKIr-VJuCeK_mkKyEVaCc9Pm19vF3gXCvs96OPnFfzAH-pOsU9LD8BdRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH6Sem3qV-ekjqRl1SaVqCnbqxG7G1IaPKqtZn_8kJlA&oe=6A60C6CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR9P52xEpM0Q7kNvwE3-dAO&_nc_oc=Ado9-b4YwHK8wWU4w_5fqiVcRGRekJPUE4-GXa8yf2Mj7Rg1QmkDk0o_YAPIVrj-piQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMd7X-EhI8s4lMYLHdg8aoBojLfHbJDHTscrh3FLOkIw&oe=6A60BCB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agNNIo1e5f0Q7kNvwF9PMsc&_nc_oc=Adrurt5gQo0bboTll7S1tGG93ijQbZZmDWAnplHfVm8GCREU2FBveRjEg373f91QcJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDezkpPJC8-MAYNOguYOJY0Yq_xXKnLGc2zunoA9fK6eQ&oe=6A60B589"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39qMjgYKsysQ7kNvwGUETLb&_nc_oc=AdrAhoAKga_ipX_cX-8iDICn9RzEsG9ANjHKfKE5I-sarTZ6ecSfHJTwcvREoOPcWGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7RXa2AYJrPIFScRUQuxBKzoCy3DDsO5K4rDX3szCqWA&oe=6A60B97E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iGnTRU9mfwQ7kNvwEcnXzP&_nc_oc=Ado5-rEoNyDj1-HMVelA00sMg58w0bNJCNBpBfUu9X-LRuI5S2H44AbuxnGCs80fUwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASmFXHhTxIdC9jZY4ADKW_U1XwAAR58LONXTo3N-JOiA&oe=6A60C9EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
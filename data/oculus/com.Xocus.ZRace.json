0f&oh=00_Af4Xm-Id8ZEpMr58nhyOT1iDf0CEIxRnX79nhKFbzZMdvA&oe=6A1D9F21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gznVcbaOzTgQ7kNvwGlJg06&_nc_oc=AdoQcjplpOS8dLtREnqiN5G2Qqv94a1dZlgfKFE1fp4aPpucQdVnd_Hg5UMsMd8O9h8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TrqmGy79z4eFTKzXFivQDZNfCR2wvAOO4mesvhNRz-A&oe=6A1D8A4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1qTeAu62t0Q7kNvwGFuh99&_nc_oc=AdrSi7DDkTHqT49xzKfGdZu1ECwnNXEgsUosEu-jMoQa2VnxcSQyc2RDxSV3Tz-a_uQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68GG7KNYOsHKuGJYBQnPqvSvI8stX_5JFv-CS9YftTzQ&oe=6A1D8031"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9j9KEtkMLwQ7kNvwGso0eq&_nc_oc=AdqXt1sUaC6supGUIdeGn3S8i3ldIr3xjh8DLvRqLEBd6RddJMpPQ04IaIzuWR1QgbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af446V6hZJppGAOVi-VXeHjf3mQUxtq0q3vCGsrncXLhpg&oe=6A1D7909"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf15UbGl094Q7kNvwEw4BS7&_nc_oc=AdqjLI9N0wc8zXetqA4XIWM-WitoJQVoBHfJTNkQ99Rn-2b152ihVQGbOoyMPRsbR5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V3tdha5ixiNUvH1B_vZOUJfBr_YRo1LJPnqmSyK0VOg&oe=6A1D7CFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPX2hDIferwQ7kNvwGOtMdA&_nc_oc=AdqkQDX9gnpgDMWKSWP6d_vKr9EkhWOzAPZ-qN_DK1n7e5Gpb-U-A66wTYOBV5Dz2yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jUH79DMgwnSjNB48Zynp2xFOvfu-IcE5Os1N9QFFKnA&oe=6A1D8D6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af2lqi5iXqlWvGSkROKZxpBoOIryUgP7f0Oqa6ym4phOhQ&oe=69E39D21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI2ZMJP7CaEQ7kNvwG8vSBB&_nc_oc=AdqVJrf9_peypewIaocIFLkMkos80M3mFQhnz8Mhu4nmtCZodnUiOiv0HDZ7FkZJvws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_yaxyFrd67G3tXwISu7Z43kmK5KaoZngEAx9arw2qRg&oe=69E3884C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96zKIVqLgXwQ7kNvwF42DoT&_nc_oc=Adp1fGrzhuWuAa348lNmY1sS8Db5cOW4xxDmb0M7R1GlsczM6suytApqZ0GO6UeHG7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xM45xbpEY-HP7TLnzDWOfi7-BHl2amkIuSUfjuUVq2A&oe=69E37E31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl4wL3KgA3IQ7kNvwEQAOCU&_nc_oc=AdqqJwnLE9w8PiLVbbYhVG8Bcoh26hPGrFZMUqbfknkjB6esuzyHoV4upkm_K3UTDGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vMQm6WXE0AoIwLBq99KrbCqZaWFPtdvz1seVUQjChGw&oe=69E37709"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EyMhuX9p1cQ7kNvwGuCxCC&_nc_oc=Ado2mjEAGaRfy2DLJ5mSxRbq-rdeGqW-Xqto-ecUs5TPt81WEK4Xe2D8bevnkn0QkNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1umhRAXXdyfqAaKo0ViHb5F3J5C7EnWqukcqcOo11ABA&oe=69E37AFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOo58flayD8Q7kNvwEEH3ll&_nc_oc=AdrlJzkW8HSMQ8YpOeMMgSl7e3RBXZbWZmiJjLfDPSdj7JCTyxxYS4qfV7p1YCQycJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2otTxYqFi71tiZAYf_5fFbzRPPom5A4yKcz1Lui-rRrg&oe=69E38B6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
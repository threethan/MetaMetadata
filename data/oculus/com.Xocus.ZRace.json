0f&oh=00_Afy4DlMpmSn6Sa5xcGQRIH6TmBWgzQSuc-XWAEwfRnbSKA&oe=69C26F61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J62pWnXxNcEQ7kNvwF3Nu1k&_nc_oc=AdrdSLoyibJ95M-QQRBMzArHtJq601ZuPp9xwrQY36zOKXo3V-wbkDfwUOiIWF6jqO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuLO3cEIWMIwTT2Cyn0nKKU5d7gW4Kz5T-AKkeHxcLyA&oe=69C292CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISQvTfRJ3BQQ7kNvwFMuhNW&_nc_oc=AdrXOT4chCJdpw5tkdyaKaUMd4v48ubOqIgcGIhVmHj8YzyCDZ3Z5sG8OBPYpTIlkHQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvGUFReuUZ2qLEGJrIkRDYAZ0wIwI43IjfA_WisH7KKA&oe=69C288B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnIKwKCtfVUQ7kNvwFkX9ra&_nc_oc=AdrtZ5aOnSX6-Svmw2IGO_6T_Q6DdiTWrjBZQpYlaDncRS-pQXYR4tfp_AseVin1YrA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEwLsl4De_Phcjq2lSllaPq5svBixE-zrwicOb5AjKuA&oe=69C28189"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8E7dJekVZoQ7kNvwE5XDD5&_nc_oc=AdpJmnfbg4KXpoqlGSHcqqU7XtWaETzsvKTvY_2sPROIirYFifpiH4n1NCcnygRyKlg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_UCQajPoSlvrUDEnJOiR1KJ7tK_V_5B6ArITS7iHiwQ&oe=69C2857E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evoc8C6f764Q7kNvwGMxd0l&_nc_oc=Adoq96qox_Iw2C3ksfHyNnlsox_KUkCNXQ9jliZyUBjdq2Cqlr5B4BY4ETYEdQDdyg4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyM8F-0zmazU0lI8BwR5nz77ZiDgnKBSvm0OHf9cwZT0g&oe=69C295EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
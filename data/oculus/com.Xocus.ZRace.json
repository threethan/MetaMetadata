0f&oh=00_Af2mFHKf-YsAq41wPOGwCsorjjm5h14Xq5HohD5U7a3oIg&oe=69EE2921"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4soTY0x0fwQ7kNvwEx46YC&_nc_oc=AdqwdTXNbLD4QrKjwny5iQKj9c8Ke_roE63lkm5d2qXiDaeBGD-TMG8SN4zae9dQN18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BT47il_kUrNTUVkTDrUD52wNf4VQ7-0mvt-4TwpalCQ&oe=69EE144C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkNaxFO9ak0Q7kNvwFc-_iZ&_nc_oc=AdrwakWqLD6gGWQLbob2oqr7QZ7okhsmcznzH52yImNoINxoDD-8A3C0CwMV7nEluOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SBCNr4hXRYyiDTtzohkUN4EwrjSpL6RYhYO9Ic6q2KQ&oe=69EE0A31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiLt28OCM_UQ7kNvwFYV4cC&_nc_oc=AdqG_FaNntGjfOMQsa0JKYaLxgDuGwdk2YnxCvJXXae6GyA2Y_kIxgP65_vxocmzHkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qhFGiv_GEbfuXfxzvRpINm-bhV-sSL_zSZM_RSDEkcg&oe=69EE0309"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL44cVwGUGwQ7kNvwH-EtI-&_nc_oc=Adr88F4tIOS5J7aZV1X7nqGzxrlgFpb0re_51_9nM7SiDM3P3ULCIm6Pn6cB62SlbGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O0dhZBjv6r5hsMuIi10ZdDIDFiNH0T_XQ0Smp9Di_Rw&oe=69EE06FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6of6dZmzQ8Q7kNvwGRXXiw&_nc_oc=AdpUs5fRLBKFUeI6eOQhIfMlxq5L_T8QL8Fh1Ndst1jnRPR6BVMRd0T-w547aBs7Yj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qowr_s-1OkIFpUozR7GeZUURddjACGuAX-Lpk4FJw-A&oe=69EE176A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
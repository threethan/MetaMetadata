0f&oh=00_Af6PdNbSDGm3xhb0VOSR-yHM9KodxmmbPS9vBNmiQAvrDA&oe=6A0492A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlSKTRDjKZkQ7kNvwGtsekt&_nc_oc=Adrc_8OeaaJet_kJW1N-BCFJd7t_kI3z4oiCY0oH5NOFyRkjY8NWbUI6zpWoxJxqWzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6683sv8q_r5qRlwMh3cTS-kHO7_KihyqmFqq_ktjSv_w&oe=6A047DCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OT-zPwj1g4Q7kNvwE9v5qH&_nc_oc=Adr3FXK0InnNnYhBTZNGKfGYo35EDK-Yb4bhfnOBMCtYN-anytg3gdeZ0TEcpuxDOVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6annSPrmpY07O2uPv_nb3KG8dhNXTf24wqgaIDlJMRUw&oe=6A0473B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxDfnGzZyv8Q7kNvwGqsFX5&_nc_oc=AdooyVkmkI8l0-Vzktg8QlqlSrZxn1fDm3qtjfeV3Xb8uCfCVnOgBVovc_wOSARpcqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aynywYQuBYLSwybF1wsYepXphPqwCS_ng6f08xCm6MQ&oe=6A046C89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRGmPbKxasoQ7kNvwHL8kk4&_nc_oc=AdpvfNouRnBboXKJxz7S0_lL7HQZwLpBhw94O0rJWRS-jQ9P9XHugH4rYM2YrfK-AbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rN4YyV3hCWsw8FqeZUIlvhRZnhGpF7gnIpJ-j1Jgpww&oe=6A04707E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBuWrET0z_AQ7kNvwE8AVXN&_nc_oc=Ado5_iFdsBn9kZynCrHqO3DyiLNQgY2PrXETvBsrMJi0kmQi2UVJKnk6u9N44k90z3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I0RBKdd3aom81S7SDh3nbOCYVh3XhYndPjonZJjuSGg&oe=6A0480EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
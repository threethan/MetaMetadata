0f&oh=00_Af2WoA4ks0rvYLrn_BNQKZU9YeyGL3LaOcGEVMUhk_s0xg&oe=69F8B521"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTW5_FNvL_QQ7kNvwHanY0x&_nc_oc=AdpOz_UniptFMkxfIw_N6ScCvbtSc0VyWt0ymnQAQEp-3qzN3Si9-uOIlC815jqiZqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rM8LqS39zLrhmYA0v50O13f1dhZ-oVocsRwfBuBbTAA&oe=69F8A04C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inh0guPvhHEQ7kNvwH8brPY&_nc_oc=Ado98tnPKiDArWlAhbzbSdoHNwj-RT0XNjTZp8VQNYyLDlzPBYFzpyUNZxiTW025tws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZBbziWqvQdN-u6lUAPxSBBsynDQtrb0PkkNPtXRQhcA&oe=69F89631"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wky5S93jchoQ7kNvwFLVSJZ&_nc_oc=AdozyOY7vHw_y3cWrZzEepVhl8XH8sMvblvs-m4whkKHsnJSRlA4OSx7IQ__VBlBOzE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Rxo5FxXwH50L1cO3JmWtmGS33waRuDGgVxaDLSyMZSw&oe=69F88F09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1XDvpHKip0Q7kNvwGbloDh&_nc_oc=Adrws8deYiRjiURtmsxj9UeAITnvrtXKeLG4eXPJDF02GgX2yXy40078XsiY320oVcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_4ICszqpmX2euRqJ1bufAdCLrZLTaUVlYWAW4IFw01g&oe=69F892FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXHYYcBZ3dQQ7kNvwH-JM44&_nc_oc=AdoonFiFPZV7NNOAxKDkRxeU2bmbPalx2uNjCQO2k6A2HZifbmK5uEzwbURQ3XdRvmY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wUK5MooIGMDNFzGpvt7zs6U_L2wWwm0iT8NV6tbdiPw&oe=69F8A36A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af8NfhUwXy-wmdHC56jK9wF4TGfWjdioxQbBanj9hrpkFw&oe=6A3AA021"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeqeTA6Xe1gQ7kNvwEiszDO&_nc_oc=AdrJdj-MWMyIKlZKYWGlkV3kT7FzQUpptuOoZ6hVqH2QvXLbrH53J2ofJHX4wk195b4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TI8Rd2GgQHix9diMYeaNAX9uyleMvs_H3-XN2MFe6Sg&oe=6A3A8B4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNBxUQ1a30AQ7kNvwFkSZFo&_nc_oc=AdqEdnuFLORowc67J_Nezop4WTKuDiXZ-Xo3GlvMIf9KjUKM8Qm7k2wjFsKlo4pP0xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nfts7dU-yPkbEzTFvV2TIExVyGT1SvWPwX5ypeL5c4Q&oe=6A3AB971"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldc1dTi18eIQ7kNvwH6Y6rQ&_nc_oc=AdpJGLbwIPeuxfoOgsc7B_5IKotuQ29P_XKRHOm83VuTNfBSnYPV_InqcLW7GJNABFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9679k1kNpL2Ghg5KGjXws5GugAtGDnS4PWJe4p6SYhVQ&oe=6A3AB249"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GFJfV2LaEgQ7kNvwH6PsHL&_nc_oc=AdpBV0vouZcUcpcq5JieMGGnkBzVORztlebGLr6jqQrLezTaMubFzxoQy7mbQZgStT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wFGoSVCccwL1ao-LL5bgHEw5sR42BY2_KSwHsyZ46Mw&oe=6A3AB63E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw3sqpkcOSIQ7kNvwEr-s3s&_nc_oc=AdpPAcCdO8M8kca6YRO7Ucxm7u5eaXaNVPf73Zot-3x4BwoUuSBGVda2WJSjmq-cbls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h6YyDrMZ3USpHmi-dFr9heDRYZZppouW1MLLv00cQbg&oe=6A3A8E6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
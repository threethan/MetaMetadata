0f&oh=00_AQA1VYLH_LTOPE_LplkKxUFjV82k-WG1OHtA2AnM1xP-4g&oe=6A5B5D61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl82zE2kolEQ7kNvwGlJaxt&_nc_oc=AdrnnoCFdDKIGyBXFanBWP0g15WgiT3w0nsCRUKWeNPSTv6qXtajO-0obgers0RHZlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAji_npm9GBcswRXCg22FNLQe6F1_POQcJabb-GIzAQSQ&oe=6A5B80CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBPKgAkwCYQQ7kNvwGrGIWq&_nc_oc=AdpQ0txLJ3A9M_8kvd28z9HBa9XfhKoO2QrIKYba3hupSKwa3ZZ5frILi0fiMTf3VJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArx-GiZ-WNeNbZw6bC5iVQc1lMURk_s7QYc7hsF6dhsw&oe=6A5B76B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul9a8WCkMoAQ7kNvwHwDSEr&_nc_oc=AdqDOnsA36xww7Un63EuEB4uZBQV8U9P7Gtoei1p3zX0Grx5j7_e_TLfe8TyXaah5uU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAohXNHtNxbjQW8HElgmng4U5BwH5c91fsefvCJf4FvbQ&oe=6A5B6F89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5roDKHPMxYQ7kNvwESAfuM&_nc_oc=AdqsR1KfIsC9YQaXMpHd-xZA9xmJlpoSDwNPnYySVoeiHNPgpCj6upAEekz2bL3vnyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD7peQ0D8gLdtmW10tz_Hn1UL1c7Y1POvQDnIjfizEDQ&oe=6A5B737E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09B3N3rX9WIQ7kNvwGAOsqx&_nc_oc=AdqRWf7P-jUlAhxx8d4v5xab_FqHXKJ779Ejf8jksGiUEq5lZjcCUns8fdLnx9mk0IE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdrkQONMFsMs6gKAj9E6xfgS-hBi6URe4mAcGcpvbHhw&oe=6A5B83EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQRIMmqKictgkdTZ1gMSV67AtZwlejJQ0GUD6oHos0Lhow&oe=6AE9F7A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3cN-vJLMtoQ7kNvwFE8iVA&_nc_oc=AdoUB3vx7GBf1CIt1szhVx5OtZlKH9N0VCF4jtzDqqlTJy9H6QrbS2WU6_H0kbTmCAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuoovvXor7EJV5_uZzTUjgQjvKVk7yJOHSvwz5p7CwGg&oe=6AE9E2CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNPHLE8zYAQ7kNvwFrvqXB&_nc_oc=AdpUBFAHlQ_D7tIGK9jqaksFMBvcDfd_BQ0pFYMjifT7LvAek9dW5qi8lfLgjnGPMdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8tCAI10wFixDjsmRRZFGRzrfb1suAhBZPgKAyGQRrzg&oe=6AEA10F1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtc-zrlUDAoQ7kNvwEBz6bz&_nc_oc=AdrBD2FF1J3nKS0ijkTgzU37amTWfCUKHZQGXvBEP5OwE7nsd7mkNy1dL7gGjMjYBZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCYPA__zD5HUSZtpeiFRjPO0ACSic3lriK7mTzKcrrpg&oe=6AEA09C9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB3BizNLWbUQ7kNvwEjbRkK&_nc_oc=AdoBAgo4akdBRYAJceOfvBS2E74M1i3ulfEv8_ODZ89jJoIQIUkRJwYL2IXQtIFME0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6LBDxsMIhJJ9LpAjMSYUJY7U33T0NyHeIACzMxBSxSg&oe=6AEA0DBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo7lMbgEZJIQ7kNvwGF-g1P&_nc_oc=AdruTF_tgMZqR9DUJVSUC6K-E4rClDVpIFcaUnKAw2LUXhSEWGop73yQxzRmWjJ8HzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStpmtfbOSZdZOp8wzyJSWzTIkbz7JLfOU9eLyBoTnQtQ&oe=6AE9E5EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQFPWhrSseCvWiYJccbx67bTX8WOSHHjc2pmtcj7CGwtKA&oe=6A916AE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McRj9rQt14AQ7kNvwHtxn1w&_nc_oc=Adq9DDdRb_OpM_MIUJ9A7oZMGsoXfSFfBE5XA74tBggOu5EEIi50wla2LIukhdt8Pzc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHmAkvbC72fDiB_102P0-NKmbEqs7LWS1U_jmBmY2sdw&oe=6A918E4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbfWagd3DUAQ7kNvwF_fimF&_nc_oc=AdqugnAEisJUayyurWMT0zAMFEv1DH2I4E6ZRU42uvJ7UqzoB_Hy_DqU3SmQufUne7Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeeVwuyulylSGXmRQDoZFU7svHnDg9HWya2uRsPX72AA&oe=6A918431"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgdR3VpaXLIQ7kNvwG-1bMv&_nc_oc=Ado4ZzEXu9mx_wJ-gDs3XH5XHQ_gepvN0KBTTKFMe6czEtuQpalNvba82DbXGtaNtDw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEmzDbWCNAniOM_kEy_iRUNyRxytffnmV6QXDF903RWg&oe=6A917D09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNXRzIBC8JoQ7kNvwHbi6X6&_nc_oc=AdoKkHawGXUn34REUsCORJPcXOGjYy2QHfAApWEACBMSEA2trscUm87u44emC8jwi8I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHugCwoQnI5ENGVS6fDGNDbVJ6D0xv2hApGHQ2k-YyJYg&oe=6A9180FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGVIYaTs604Q7kNvwHabsqh&_nc_oc=AdrYbQSlf1zYcE7BZAToEDR3UsYvvC3c8owRKI2YPBAd14E1yF-UknV07wCyskihLuo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnw60eG3jAZ8Kx-PE5WHWedpdnvJZevDbrkF3Vq7Y_Hw&oe=6A91592A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
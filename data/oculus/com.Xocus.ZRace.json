0f&oh=00_AQAlo7Tggv_eZTYFKYPuq5UAZEuVCgmGwTTGOoi-nsoR0A&oe=6A6621A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWnOR9JJFDcQ7kNvwFSbCRb&_nc_oc=AdqJ7uVS6lJnC3qSzW_nTRQdPMWQTgm3FPpl25Z0eZzsorwMBMN0eLKFBZmaAfplXgw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClXhJRxjTw4F1PjsM22Vc4dpPsC0Be2nxqYm1jXNV_ew&oe=6A660CCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oGfXItczCwQ7kNvwHNof-s&_nc_oc=Adq4uV_mHp2t3rMTNqFBUrJ1idfNpZ3hQoZLhYsDNetkuD-9badGZFsNEzo7CaU0IaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD_CEdhrDyPEjqKWuySYD__L1-p_22Z-QizAuNkRJRNQ&oe=6A6602B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRM52flwQ1cQ7kNvwH3V5MF&_nc_oc=AdpY5MOAHIE4aBFd-lvwosutQusAxrH7sSrDfiW87qLxLReSQb6yA_jucHgcfAffYU8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8Moi_edvxBnKIbDcHXdpVqODVdrR3aCOD__MomdaO8w&oe=6A65FB89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-g-et5CdXAQ7kNvwGWsqiG&_nc_oc=AdouoOeca52IasZdRztzq7S61zgB99RcjcvshuDWRi0Lu5UkmPtqYGP6qyhAx9Kyo4o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgdFCrp0Usmw5Vf69jfk4OTCj1JZzZTWC3BQqJM4o4Mw&oe=6A65FF7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6khNfnuJ9lwQ7kNvwHGRiF6&_nc_oc=AdoS018FNGJ4BYTxLTITiYe9a99cOLjVOgw3M7v5-64LqW-r5QImlySfzGb870wPNUE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfCZJsBwAsWpOUdU7oBCWy9jYQntwz0AbRasmAz4IKOw&oe=6A660FEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
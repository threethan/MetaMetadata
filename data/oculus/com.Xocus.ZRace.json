0f&oh=00_Af99IMD_XV2Pmt3tcQK2gK6-pYq8qBQDUkId3SqvMuumfw&oe=6A2193A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4qCFzmL8PIQ7kNvwE1rrKd&_nc_oc=Adot8AYV3L_za6vhNqtgNdmneh5QzY-Vr2yj6uLbpL4NcZRHXnfLN48Ydxzgx5M5MZs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0mKy8hXVG5SuGtZeEVBn2O7JEh-mjlG9qCEuayuyfig&oe=6A217ECC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwgBaigA6w4Q7kNvwEZx0I6&_nc_oc=AdoayrvUciAoBxooLax_zKKPvj44CdET9qVFZ61e1JjdAOX9gQ_dqRsxHUDLgg6TjRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NQUc97o6Avfc1jlMuBCCm0W23JDsifkj_sElQPJ68eA&oe=6A2174B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlOsCVYmp0EQ7kNvwHGPEtg&_nc_oc=AdrTx-nHhhM_ajuNdhj55EO3mqgdiz6viWMk53Fml9ZwfNaSOjAFl7c0BhBz4myKOHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JJ8X8vjXWOAe3Ms-pt1tn4ggWYBArzXHHhUXRI5BZDQ&oe=6A216D89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OE9g45TxNEQ7kNvwFL0CF_&_nc_oc=AdpDkEU0jyS3K78x2yZ00VnadpInfRl3zk2aSemUUjW57_OWYrMnE5QxZhTom4emIA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RJ19nB1GqbNyqptml7nAFor4pZyVmx99-pLmTVCeUYQ&oe=6A21717E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFdi6N6UHEQQ7kNvwGPvIkL&_nc_oc=Adr6_XVWy99aw0rsyooVDnBMKmX0JUwGNCjvuX9-D96igYpSTKJmVjM7pW9_9QrKOTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eqsK8nj8sQRsquceyyMul_tnhTEivdYHAjT59r2lnlA&oe=6A2181EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
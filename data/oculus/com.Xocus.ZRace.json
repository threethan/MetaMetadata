0f&oh=00_AQB_HKski6Ovnmrcx-LDWq2I9dx00SnKMYMJZcZp8V9ZZQ&oe=6A4D1521"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPY_8YRLHmwQ7kNvwG50_88&_nc_oc=Ado8eGaiZ2cVstNa3pcke6ZsqxBZDR0FH3AXXV0ZJ-61OYJJVhpjmgEF_Wd3B4T4Cxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_QNqsz76XMaqn61o0hTZ8dh1lY8yXoKAc8UHHSu8b8g&oe=6A4D004C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulPn6Iab2e4Q7kNvwEv_7NQ&_nc_oc=AdoYNmkFQyx9x5GPo-al9YqjS2RdRwnzRKZCSmiQ9zbi3KgOURuCk5q02vY99EXyqBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu3Kf4FuOvladLqXgX-ui2vCw0ctWET7_IqVQGq0OQ2w&oe=6A4CF631"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUPIA4LcKAEQ7kNvwHPpQGD&_nc_oc=Adrbw_7ZNwy6CqiVPSGIhtXQ0orHlCGA5hRNCVc3Cnaupk08sDhERaj9aPFnniiyO6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsmDsZkyaZBEdY3pfWnYX1n4dk5EGf9BxDQEsAfzczVg&oe=6A4CEF09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chze8Z7pIBUQ7kNvwFNz9BL&_nc_oc=AdoC8s-eLniqxtV121uUyqxEwhwW-QUALwxRbUx-7875MJnQao6yetlmsuF9nUXmP_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHjMOvnF37gs8PpnvyX80nMIA_BPBUiY7BMMpiQGKGhw&oe=6A4CF2FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3WO0XTwgiwQ7kNvwG9nhks&_nc_oc=AdprhbRmHGkuPMnv9SXmLKE6cN8HnsmgFZLfCeWg14X-XVhBPFZU8FiUuAu2Ebu1WTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_FdXtL2ydF873mEI2IjcS54TUZCAg7ZBJzQJg1oYmfw&oe=6A4D036A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
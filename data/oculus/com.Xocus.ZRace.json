0f&oh=00_Af17PDkXhchjwKZsUbzTauOASNzVIAhK9wu_uqzH8zvE2A&oe=69E791A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSzLCRfASzQQ7kNvwE99rWQ&_nc_oc=AdqwbkcM7fu5pQexHAJeqwMxwPzNgKYk48LIPn9xWgMaDBToWFuvmNbPFMh6jNVNiuc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21kSqipDEEqrrPpMTcv9EtFzh-ocsgctTcia77wbDSZg&oe=69E77CCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GapnVkfEGm4Q7kNvwGhV7sg&_nc_oc=Adob0yHxSLNrnGL_lDNl58mUoRnxUGjA2T6Ytlvg1A7epqpvxn_PXhdDN4knFPb1UQY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mCfuTEF3HBxvPusGmraq_brmsOf0pW0MSuvE7IQBGyQ&oe=69E772B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6_MzUXpZo8Q7kNvwGdPlQw&_nc_oc=AdpnVbAMxfzXgOkH0a64EIro4k_sl7XEHlOT4VmnxzB8Zl4GPBAn8Jzk4dBU19-t7so&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04CdQu5vubmLobfVROmgdbKwNFMnT3vc3e6fBckaZXBQ&oe=69E76B89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqavGa04aTMQ7kNvwHTv3We&_nc_oc=AdpKHegUtvfEc8GRJud-EjGjdLruzBQ9e2eNagfAnArkICOmPVrReQxiM-i0P2iagkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x-CZ5sskkAeB9NEZPw0586-Gr5Cegp-pRDXmscAsbHw&oe=69E76F7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY8xAHF69LQQ7kNvwGCjTLI&_nc_oc=AdpUmAOTb0R2xRvREraBRfe5gT1iXOnwrSddxQJK6wa96pAORuowHgQr2ZSWbsTKdic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s_NZd_JkdbazW4_q_C4ubqgjzFBnP-Zf00_txMojCzw&oe=69E77FEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
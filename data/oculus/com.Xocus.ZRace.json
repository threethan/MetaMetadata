0f&oh=00_Af5evKic44nOHgZn_UiWp1sKZkBYbPIcFVJTXJO7LmcggQ&oe=6A1464A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iFGWzJVpGAQ7kNvwFsWNmd&_nc_oc=AdqIxGTboyZv7XnduNWOdZtKtcSxU9Sr0QmvMcQo2UAJraucoBHaS_d4hEllQfNI968&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gjIJtGs4sF6ggszfsC8uUVMGLdkN-8UvcplGaBnqNog&oe=6A144FCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkniypaJH4cQ7kNvwG_tZma&_nc_oc=Adp8dQyQe4PsJeHInRhHZxjQJSd_SdJJxx4fFsWxtdDIoz_okXsyFolbyWRQ8myBYcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69i5VsmjWvTpR0P3iJioTz6X7FyQcMFrUENymZoN7leA&oe=6A1445B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eqVi-jj1EAQ7kNvwFCAJlU&_nc_oc=AdoFg3CpVSQtvuGryvJ6btV6rnu9ugoNb9vFS0WiLNE_9fF6vhxqdo3uOyAeIu_dbOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RIA_hifXWx37lqBERsWpLQV43Jq1kT_x-HBPDO70yCQ&oe=6A1476C9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHxwhEoXAqAQ7kNvwExlHCx&_nc_oc=AdrLaotTAcPrzYiemjhEYgk2YQLz0xOcMgRtYRZ_B16CcppPskA2Hrr0FY8Xnj-FUuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZUaPHnE0UAM_vCiaEMRi9ZlqyIdi1ZirvhGRuPHPeWg&oe=6A14427E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cWKMik3Fp8Q7kNvwH6-cFV&_nc_oc=AdqTlhh0vpUoS0UOiu6DVox0BzDiPKPWLaoapGB9uYKbCPafOKJjqmk3QuuRLMf-Yd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lctOJwIp6TCOXfpLo3AUW07wsm0TE3_adUW4g5v8h6g&oe=6A1452EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af7sTHUoICzdUyyuSe6Lfa__DWW88IYdV08DtNqyWFC5qw&oe=69FCA9A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3pv_7cqkwIQ7kNvwHeztrx&_nc_oc=AdqQmmvQwsR6enSJEy63o9BG6NaBD_yFj3wQAsJvZuwiIH26eVhZgueWd_Y77pLWZzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mAt2HmffolKX8u_pd5YNpC_s6XUFlSSjZdirWTBt8Qg&oe=69FC94CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVI8L2H8hcMQ7kNvwGm8Nk9&_nc_oc=AdoQ7f5GdVvGUrtUlGGTkwNRjBtWdf1coyO9OAh3tshbpbfIFMDidrjkOPtL7cLC8ZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fh63cZ1ftVCK-jGIBBMPrvST5tbJsBySNi4W3FcaAEg&oe=69FC8AB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqZQynkefJcQ7kNvwHDgsQN&_nc_oc=Adp1P7CJL3B82utGqDAwHjOdYPP6zBV_sy9-i0lqJd77pIBe61Je41K84h1iLtmHdwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x8WtEH9rlF8JVs8ZMKlLnGuSaUh8qZ98khgOiUbFm4Q&oe=69FC8389"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYhaCx3koFkQ7kNvwFmGoEr&_nc_oc=Adq5s5pBYQNELknc60fmpSjf4vu1MZfVbkpMTqBZgXd4BlP2BQA9kHSqG3wiRc8ylXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_evSQ9eVTAhR48fza6wgSYnE6teRYFxY1xWL1xMQR6g&oe=69FC877E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op6_BCVl8LAQ7kNvwFlYUDy&_nc_oc=Ado1Qui6AsOP7az4c1ftVw8vdHAZ_Ol0YC1j4tmUWvV4U_dABp0EttoyVW449zw0XmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65bgKWduXtQZ13wDA4vWZoul4hwnI7e49bqHTYRO2jjA&oe=69FC97EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
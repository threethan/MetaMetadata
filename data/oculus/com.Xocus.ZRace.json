0f&oh=00_Af8Zm4-rG4UpzXW1wuDuudXr1gR_ef95Dk6u9zVmBKAGWQ&oe=6A3FE621"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkP2LshYu9MQ7kNvwEdc7Tb&_nc_oc=AdoTf2GyvqR3Kkvp5e8RFcvXrWHNmDX5Gk_0d6lYuSmpD1vruO-M2EQPbNHNmQ5sIqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hXy0JFBH5a18vk7vRyUEV8fRbZQCy2CBfK8-cbxEs1w&oe=6A3FD14C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk5XTaHrQVgQ7kNvwFayw6b&_nc_oc=Adr6lmLO-d8HP__2i7mHkR4LdRLe4W1it0ZUySP67tJ5gvVUH0BEZb0ug0EMcbwqqm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qdo_h2j7MQ7KgHA577xMKzFtZatw24EUAF3EFjGY2gA&oe=6A3FC731"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGBrPnQrrewQ7kNvwHCANlE&_nc_oc=AdoFz1zMSrS9OXjL6WWKIODR5xChAC2GH6DfuvkrGMSgFhC8tgPJWBZaDg1-rtg3mco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v7kbiI4p_3dm6ebi201kx532pJlcpT2JLvpKkyAX-WQ&oe=6A3FC009"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su1M4chkyxUQ7kNvwEG8c7h&_nc_oc=Adr9m2B1lNBy1O3U6Y3TFuOmyLsR4g9U9g7BvvYgJ3nGFiE2c7o4tbDU6HAMqVL81ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PE1wIFBxVkjKtPJTNClWmgsu6NO40xMjhgZ9Z85Mn6Q&oe=6A3FC3FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNTs1ib5nRkQ7kNvwF37z1F&_nc_oc=Adq_OAYP_tstGEBS6HXnGu81kiJmdxljb-Q5oXLmPrWzfF3o6HsT4mghUkJG6l3S0pw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M8vsoxuaJ4gBBnXtzX6U3FUQmV24b4XCcbGt9_HDlQg&oe=6A3FD46A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
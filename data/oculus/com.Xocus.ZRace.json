0f&oh=00_AfzZlVJKtBhZwQtVPfcMOB_tpVH8GcjKx8tbE8H_rDLlcQ&oe=69CBA9E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h99RCm7WAs0Q7kNvwEl7HAL&_nc_oc=Adq4eBv_l4natbGUbLj2NfRcJpcMHVHxmSVm_t0mWdS9HJZjCaZDWkbOQIugiJvWHDU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5lRP-OU6K04sntjuCwH4KdOJ7LyRaGvk5Y4932EEoDA&oe=69CBCD4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUFfMPpRTI8Q7kNvwGk6HXa&_nc_oc=Adpu0aH7KKDR8jFsn1WWJYFgPrp1BpLkfuRJaA6Q9leqkbAGhc6CQjIuD3L-mu_ppak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWC4MLd3JC5dwvHL6M2jzYv_1pclmNpBMKm2IkknPFQA&oe=69CBC331"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWcIoPXKDXEQ7kNvwG4siR5&_nc_oc=AdrC-O0sY7V50L8rGPnaWSquOUuzZyXi3m-jlWyVt6urOhHbr0PkJ7MPk25N__Hr1lI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHkNGb4wGbVOToQ6NPRYG3F-MEaro4gtskVJWsbfttfA&oe=69CBBC09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHTSFkDp-YQQ7kNvwFgeywZ&_nc_oc=AdqUFLWeFcvgu6g9v9K-hyzwGbFof1la3B4RARBOvvnyhMKLQBl0krZ5tkViSlEjIQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSS_6XgsMlBTu-KURE1OapUB7i5qu6-LKY-nmefaJ30w&oe=69CBBFFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HceEYR9AFdUQ7kNvwGqPqiG&_nc_oc=AdqW1SMtOO4ScO5V0vXHjIGbBpgzb42xkCQDaYNbC3titmc1JwIXyaUCu7uEP6CMXrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5hS67kZKRFjyLG8AaLEAww6o7rP3hlw5iupBqCpD_wQ&oe=69CBD06A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
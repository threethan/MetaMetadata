0f&oh=00_Af1iOumGxX_Zpgc7_lyW0UqnJsDe7IvxRKtT7ho2SbMgqQ&oe=69DB7BE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9PXiYSeo0YQ7kNvwFjKBse&_nc_oc=Adrq06uQSx07IwMn1AddDd2L_gRr91Po3oCy5CgH9_Z2x4D-66IbUKE4yYx4EBZKjpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lq6-_b7KwMEa5XiJYQWGHM0nLLa0CfFoFWvUiZar5BA&oe=69DB9F4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zh8-429krAQ7kNvwHODy-V&_nc_oc=AdohI9CuaU9BIH5N9z5koamxU2IKlmiqFC0vC4UdqXZgbO9gWx831CF1pZWQ_4xuHOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HDhJPTklnFFrGTaGoqUF0ufq6Pu1-ro4zSBYiYKEjiA&oe=69DB9531"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3HcrVfdjyIQ7kNvwHucvtU&_nc_oc=AdoLI_4YirKsb9z8vO3cNvDqiSqi2ENDmlM8e5umiMXHibj3unhLZUs1PFOiAYcNo8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0arNiyz2huG7tR4_Is6_CHPgXsE7MTyiGZ-CNx2Z5Siw&oe=69DB8E09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmx2gDJKxgQQ7kNvwF8Fz-A&_nc_oc=Adr6WnrnhfQmHLqOHtea3jtk5j6kw8qoAWZ02ZO2sjTFxKqnkFEPNuu891zTr5P7zio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XxfCnMlvARTdKjB0VIUkMeRwQzOSdafdvMjjNu2x3EA&oe=69DB91FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om2hJtNtL2cQ7kNvwHTrUO_&_nc_oc=AdoDYMB50JTZBAw3gy825htni_8hvxiLnTyEm239tnIKWfNl7jVmct-DO3Gv2Iz23S0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReTOtfiWy0JO_bun-cELepSX3cRJNzr_cx0XuNjDjPw&oe=69DBA26A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
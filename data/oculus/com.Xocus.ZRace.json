0f&oh=00_Af_zRNLTyok3Rd7ttSbV0Bga1uVcMAb_yIss9URut5qITA&oe=6A3BF1A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeqeTA6Xe1gQ7kNvwE4mbV2&_nc_oc=Ado9VearXoUGEMJbE8Aa6PNvzTjvQyI9iL7MY8u5Ngr7IeNI_9G7rcW95ktY1EP_n6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lyuYYhBFfs3wmEn2OGV2DmcYqn-xn_lrwYlqRtkp6Qg&oe=6A3BDCCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz6zMfWSw8IQ7kNvwH8IlRa&_nc_oc=AdofKbPJqv5Dh7UCSr7R2EMLaChTBDfWx0y_qW0Wkha48w36RyO7cYg6ZbYjXsipFdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sN8EGzSg1hmkUh33EDRBDiPPMzia0yxr3vQ0OwILZ5w&oe=6A3BD2B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldc1dTi18eIQ7kNvwHiwz8r&_nc_oc=AdqaNV-MG5cpo3LltQcz396BiLPV_eWmAUpQz4hY1FKPnh_oXMz6hpeqvU8U91SWG3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OX5zoJNjsp4AxlVgy5SxNPFg4UVj52t9_FbhBp5_zhQ&oe=6A3BCB89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GFJfV2LaEgQ7kNvwFoK25n&_nc_oc=AdoBoS9SiCp7um1xXqBELH32kujQImN_9xvD81Fu3NIYlxtjFOKwLA4DJDMjbeIEqAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ScQ-uE6TctmuVqDZ5zPwcGfL7w6XQgYJH2XAPhnDvxA&oe=6A3BCF7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw3sqpkcOSIQ7kNvwHokttf&_nc_oc=Adr0vozPcC3AAy7t8rHx0xE5tAYYwWXMCNA0Bb3Gr7NnhIuzHlahwzoiUQlp2H1meFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rNJEkmbIfmx9i9JxhWZ_FG6lRuHtBj2rIZnwj3thlqQ&oe=6A3BDFEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
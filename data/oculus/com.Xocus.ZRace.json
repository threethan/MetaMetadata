0f&oh=00_AfxRIfY81eEFmx-QS7Yg4-5pQcUT7X2FS5KpMzbXlQNqfQ&oe=69C663E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pMfREwNMV0Q7kNvwELzcVB&_nc_oc=AdrK-fWXjhxt6OXl9I7V1zKJflWUeJJ67tUYe4JeQcGft6B--iQLQkPBHpXS7bx_0qs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybBCyuJqhl5w_k0zOm3xmQ9yBb64iZ-tjSOwmKs3GvCA&oe=69C6874C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkpJA-ut19AQ7kNvwE2bWx2&_nc_oc=AdpD0dLLE1r75ve9TyG0o5Tvn2WZPZmFqq77JqMdPEYah4kuEhZaSDXP5TWLhJAoEgQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuL-h4NytdskKR54XZsujTwugZwIOSMCPcpF0SF7vNLw&oe=69C67D31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0OJ-IIOv1QQ7kNvwEsoVoN&_nc_oc=Adpzc71Yime_43_HdqaoYd8EI-dlkVrduCEf6GdmbR1zPSe6LeB7dgJZkJi8ouA1IjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvnUXnLk05RFZZ-R9cjTc8R2OuqdapBXbu4uW5AHHPVg&oe=69C67609"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUSqTcI05LoQ7kNvwHGm24e&_nc_oc=AdqcGo6Vrz5BVKXV5-czND2KGijHXJwOAh0RdkPaVHu5zsp0jD9S9PaKD7hGSisEx9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-tvPSGPbf1F3Ox6JHmyQ87A-dAjvoqhH5_WSCyGv0bQ&oe=69C679FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgWTde24WwEQ7kNvwE2ikr8&_nc_oc=AdqMLMK3BmJPILJQ7B1Lk4bBwt6cDGNJJAo39xHX1juQ2Eu5njEeOkXJkLqxOb1JAVA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzghQzERBaGgGVC7ombF_4t9Dszr9ZBYxhxC7fU3pQP_Q&oe=69C68A6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
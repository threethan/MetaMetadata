0f&oh=00_AQGMBW8YLBHZqKxrx3On6dfhgjEJnRz_DMylir5SvGP8DQ&oe=6A7350A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d979FaxPIcIQ7kNvwF9gusU&_nc_oc=AdrZZSVoVQHNlrEPaTqn1ZbngsRfVGBRc80NTAFzqcl1GMVxOWlkGQWz3KjJ6FiqIEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETu5EndXQbGW4pOoBDNfIXv_Rv5isFHKT_d0CUH7yMwA&oe=6A733BCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXEsf3j6UJ0Q7kNvwFRXtxO&_nc_oc=AdpkhzRFGBs0vKOZluwZiEqjqaYd9MWsMHRd9GonGNkehjq5v0vKFJjWtzSyfyndbvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz1vtMBDUD96r0odVuYeNCLCX8R2vpBM5l_Vtnq_7RiQ&oe=6A7331B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2tDxueJ9IQ7kNvwExk9MS&_nc_oc=AdorXlR_tr3Swy0zAUXqccY_k1brGI_WewjK-Dsx8qn7rne1cK3wVX6BHElJrjR7VTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc2imgZz_lK_Y2jMG5MNazRi2uZxybjPJoaOIo1allXQ&oe=6A732A89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMNw8L1a3MAQ7kNvwHfkVrb&_nc_oc=AdrjizlTr1Y7FHqO8MDPfH6ANHAWsqZ-kz769ph1TIrwSU_zUlqF-OJJYbCvozfb98w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwConrrMziYS-4HRgH7lNPbmGnhUn9mksTf6NHtROKYQ&oe=6A732E7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4809XjAqO2IQ7kNvwGAsHKE&_nc_oc=AdqP1_gsB_P2s2LWxICDyz9lzc0-rgOXLE1i6cVto1KvFozPAY9HZ5J0CCPVqHHXccY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNYvRd2ATDwgkoJz15Xf5E35g202wfHGSpCxgN83i15Q&oe=6A733EEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
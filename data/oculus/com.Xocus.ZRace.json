0f&oh=00_AQHTeYw2BMLcxi0Uu18xVtctfcpsvW99Xu_CEGCECWfBOA&oe=6A92BC61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McRj9rQt14AQ7kNvwEr9E8e&_nc_oc=AdpOMHF9R67nuTWMLtLGA1QjQMgiSx68P6gExyz70m1jGbsXUvPYhXHl86QiHTjdMas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGg8oqt3smh8U2IS4i4QerchB5fF9KT5Cdcc2ZKBhEtw&oe=6A92DFCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oU5RPctvZoQ7kNvwGpcx4u&_nc_oc=Adot1iZztv-KCaGY0whiV8QcpW92cM0nbwhZErhMyCkg_JfX-P-WyaXigQy0oXNZJos&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELC4nB27nwf6HzZDpPhhuhngrXtNPz9c0F5gGaexoQAg&oe=6A92D5B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgdR3VpaXLIQ7kNvwHoS9U9&_nc_oc=AdroyWzCOe4qaeWciOzvDmmnPXpH9CBryHJGmgCO834ySfl8PVqHPvt_f6NWg5s-ElI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsaE6qjFqAUXgnRaRITXKH0U9QfrnAOpLK32A_An1ycw&oe=6A92CE89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNXRzIBC8JoQ7kNvwGxmsX_&_nc_oc=AdoRTo4f9o-jrVehxMalVCZAaQkBkbBZ6hcNmGFl2ycJF5juOXfkZJFCi6OOWo9lDY4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsDPw_hYugZ3WwsDKgejMRoIl4MxYfPfkxIOT9s5hBeA&oe=6A92D27E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGVIYaTs604Q7kNvwHi4d3N&_nc_oc=AdoAK3GPb-haTIH5ag84hiuhowei65JUTlVfLsxOiEdKs3Ulb7Y_K-6jmmgY2Yjg3rI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNBkpiK_psR18w6gTR5ui3_b8W8IXtS4fQtRq8iDdrsg&oe=6A92AAAA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
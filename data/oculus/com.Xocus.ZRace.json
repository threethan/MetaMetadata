0f&oh=00_AQF1ZECGl0vj95_Rmt6Uq6_M0XNbKkrD4svRGvRo2QdZUA&oe=6A75F3A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9I06PJKvuYQ7kNvwGlYN3d&_nc_oc=Ado4AKPLqLvZcR2rg7QakIV2OAnNrVdNI3EXcjiQhH_wOzZHcB2TpYWPY2wM4fZC0L4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5j8dLrf8TU6_QZI5aPy4NedzZjBTc7Wxa18UR81BgFg&oe=6A75DECC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXEsf3j6UJ0Q7kNvwFRKuDR&_nc_oc=Adou3CYom3-OPznpdI5d1m3y7EuSEfB3ZvpPIB9fjjmtwxZRxprfwAP9LeeisfvvemQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLX7rDv7ZjpIz4u9bGuMo9Q2bTIFGZiwHsG7mSReCHQ&oe=6A75D4B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDTueUCzcRUQ7kNvwEaWDPK&_nc_oc=AdoZBJICSWmRW0ofzXbFgxPTTnXV1l2S4QckbbMv3aIMTdYjZdNTKaOKGo5Wv-faAkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAZR8sUqWlL493417Xro1aqwi2NeqFVXldFgXjjIZSHA&oe=6A75CD89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbKlub2dlTsQ7kNvwFPwHe7&_nc_oc=AdpyjVkaRnbyzrfzhPk2gafJpOIIzsJoZDvfS-m1AhGvA29l_hwSoyw2XyJ9XN7FPUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG211m1oSQlcZhOY3XtCQ4UmbQU1YHfYQoOa278GOu6zQ&oe=6A75D17E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSEMLph35NMQ7kNvwEPbUPI&_nc_oc=Adr1524s0IEepY3l_BeCCYrgAECaDmcDL2_SRGC3leRso7d4MwclkAqsnwekWQe1j6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTh2LnJ7IG9fL6-79Q29Oc7dmXSiIAfr8fYyRRBaPJIw&oe=6A75E1EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
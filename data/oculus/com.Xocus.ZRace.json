0f&oh=00_Af3rok1uCVDZo8DPNgvp127H_uhoqv9qOHthnrnv9BBkjA&oe=69ECD7A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4soTY0x0fwQ7kNvwH0r-UJ&_nc_oc=Adr547k-8TDPqoJR6bwXj6l1XFuPun5psfHaiOJXd4P2D5QJvG4OmDMPMCZMkPfubrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30_Bsnv70ZP39lIfGml5plm3OJR0C3A5ZRiQ3YJLYheQ&oe=69ECC2CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkNaxFO9ak0Q7kNvwHlEuda&_nc_oc=Adq-m55DUwtgQrrIhEW_fBzGM-EIiS3ZldMTgSqy53jiMTLCe1GgbpQTUbF5uPShXKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29XU7MKgPb_vmJTufDuvFMqH0zDO7RP7FPRiO04m1Xhg&oe=69ECB8B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkBNr7JgK-sQ7kNvwHbFOeA&_nc_oc=AdpnWRWLXJ8h-OzoRlh5cXYBj1SDGx71YawF6LQZ4qx5acPTIsQHdhFQt9ECQ69fWU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DEAaR7mQ56EiRciuwF7lKABo5Olq8RSGmz_kZIG28mw&oe=69ECB189"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxFSB7IIJcwQ7kNvwH5fdmf&_nc_oc=Adpv7rjO7rPMAFAoNSeTq-6BRsmnkeAaxziDHCWmYxYgBy3oFE5CCazX8WvZPAiWlCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KgzZREq2o-ROP30JCZ-SWCW8VyRwTIBqDmUoy8iCsqw&oe=69ECB57E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjnw9UYbByoQ7kNvwGTJl3_&_nc_oc=Ados5FjTE1iibx2zGJkNCIbSXY7nQXrDCoXF1yzddLS3DDMZ2RwGGnFIXszzt7CLPZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZGs5VS46hsj-_rD_bWusOeiuq_NIWZyYfPd5wjG3dpw&oe=69ECC5EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
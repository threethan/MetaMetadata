0f&oh=00_AQEC8deN_RHZTHrbMdcUvDJQT7OMrUGM6MEvq76PQV9UwQ&oe=6A8198E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqDQHD9Ly0Q7kNvwG5T76r&_nc_oc=Adpq81vpzBOspVVoR-MpmwV9RMHJZb_u-hF4tuCIrR-Iwjy5EJ-_URbMfNyHZ78fQSs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRh8dGPjBek9mZeJJW2IDVc4mtx8oVgq-VVYCnkgkelA&oe=6A81BC4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzNYOg_7YnsQ7kNvwG2-C_X&_nc_oc=Adomt10a3A0zudCz6ipL-ZlQ2brX3xsweSFmiFKCGCTVMyh7mTTjFSzU6QbtVlnH4Q8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpwpViu-aht0wf0YroY1dyhZuQNnWkfOHb5kmLEgItpA&oe=6A81B231"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bLEvaaHJB8Q7kNvwHMgjJL&_nc_oc=AdoZXijoKHVud2V_XocdEADi9rmmUPNZZHwL5w-PpX6oG8DF0Xsneg1m41JsFI-_iPg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6l5sqUp-G-VbJ916xei17jx4WrflU6_qtl2FYdLrSZA&oe=6A81AB09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyRfg1QZyU8Q7kNvwHSDaun&_nc_oc=AdrQUO6B-FHYjB2K_ci-Uwjol9eJd-J28EJusOStFCRGOVxyELTQ1RQM-Za_DjDyEsI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxLEopF9eEap4NVh8SNYhIXini2W443pcI36mdmQuDlw&oe=6A81AEFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81sblwpZRFkQ7kNvwHHgK2B&_nc_oc=Adogp6h10MYTByHfrdxH1DpoO2VwWr2NfExfNHsRLx3rzk5yxGh6P3VTIjN35-XE484&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbLCDXz68qmuuNgpVJoaZXpSIAgurma_LXWCbVRjaVGw&oe=6A81BF6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
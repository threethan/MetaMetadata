0f&oh=00_AQQ6Y8X9ecxRn-ozMkV-VEk9-kcW2mKuyHfdFQqeTa00VQ&oe=6AEC9AA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4uOGo17EWUQ7kNvwEUh04f&_nc_oc=AdqMMxs6pVEbsWrFy5oWD4f8vbe0AAU3wU3qmRajLJgLJumgDv030nKqJaRyD7cUlL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1bO8Ku45D_nNtHcor72hIjh9m28oUhDaXT5crroka_A&oe=6AEC85CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNPHLE8zYAQ7kNvwEYMjvS&_nc_oc=AdqTIonLAcFdS_Fwwv8iKPHSPxTG4cZ5lrT58EzOZRWt7BqfJjNuhIrn43z2Pqcbf4o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7EpWOP4QFAmap17U4Bqmn28TL6hhBsxuHs_vgnFznOA&oe=6AECB3F1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtce5V9svnEQ7kNvwEee6Ja&_nc_oc=AdoPEnSgGRY22tOBAb6kua7TjvdruaGobXCM2033Spm6A-rmufqX_5lyjmYMVhAIKxc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9LOGSRavwDg6VFoRWdbFTDNCtGGoP0uRJHKw3tz15nw&oe=6AECACC9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfRwF39877EQ7kNvwE0UFbF&_nc_oc=AdqHzQ38mmFytAUv0BBbrp-r4xvxz8wSQl2yJnDCepVrTfotSrpx5YB_HVbmbvNS220&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQDUlAbcUxJcAbQ7xAfQNJSoFeaxGGK8Btd_wVbBhYWA&oe=6AECB0BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s87vKo9msVcQ7kNvwHrGJlJ&_nc_oc=AdoSkE9FzKuVba--pfKr2d5h81oogu17GaIe3rJQYqqs9VoGn-NlhKvBXqNj5ecdnOY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP4uxizXhPCo5KSE3CICLs7BufJCei_vgnWVj2Kn8znQ&oe=6AEC88EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
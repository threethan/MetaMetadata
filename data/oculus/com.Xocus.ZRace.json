2.oculuscdn.com/v/t64.5771-25/75210890_1622765511389375_7039115814969934024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us2vygpfU6gQ7kNvwEYad5W&_nc_oc=Ado8-NBMOa8LuOc4SUt9JAONqDHjjdmRvQ45I3f-St9hi-ssDvIdWW797QYrilivK98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T1Jma4Gh5fmd7oWKWfEslhUJ7rADWc0OtL0cxZ9-qKg&oe=6A008C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover (1).png", "id": "169093589564357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974777_169093596231023_3709466873424777856_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V37XhV_xAsMQ7kNvwHtIq3T&_nc_oc=AdooFNnoBZtHHY2azswrLfVNNiV25VthYE6o1HQrZM7jmAJ1CcxM85Bi0-KrE9Dqr74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fCPH1OS1a7gtWFvhgVzacsu7qTk6dPQqqH88OmrIIUw&oe=6A008166"}, "display_name": "Z-Race", "keywords": [], "long_description": "Wanna have some fun? Join us! The most fun hand-racing VR game await you. Prepare to be immersed in a high-tech universe. Super fast racing ships and futuristic tracks make this game an unforgettable experience. Improve your skills, unlock new ships and take top spot on the leaderboard. Collect nitro boosts and coins, avoid energy traps and obstacles, overtake competitors with minimal motion sickness. A game for all ages, both kids and adults can play it! We go the extra mile to ensure that Z-Race is the most comfortable VR racing game ever.\nYou\u2019ll never be alone with asynchronous multiplayer. In virtual reality, this is the best opportunity to always compete with worthy opponents.The faster you are, the more competitive your rivals will become.\nFeel the speed and flight with us, become a real racer of the future!", "short_description": "Z-Race is a marvelous hand-racing VR game. Control futuristic anti-gravity ships that hover above the ground and can fly at super-fast speeds. Race through chic sci-fi tracks, collect nitro boosts and coins, avoid energy traps and obs
0f&oh=00_Af-tkphGlyUbCeTanQDbmA4r2Jt1g30vTu7pJ8L4Nbu8wQ&oe=6A3E94A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkP2LshYu9MQ7kNvwHs446V&_nc_oc=AdoIsVidtYxl_vlrDCLVe18x1f_qe7CX8YBIU2KzPnDTsWg4Wq0aYgLjiE7kvRWeKlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83T8Mpe5Ynej7Y1c2eFqHLg0P_W32oBYiwgZIxRuJ2YA&oe=6A3E7FCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz6zMfWSw8IQ7kNvwHnwq94&_nc_oc=AdpIWv0fYmT2FQQvtfiDH4Fw-1uFjIXOSyPI-K7i3nCXcxVRB1Il-KArwTtlxjDLc_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4b1AfaN2sL2tEvkeAAREY2xUUgdTX-K94MHjVPYPuhQ&oe=6A3EADF1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGBrPnQrrewQ7kNvwFbXVAT&_nc_oc=AdrKVXoe8VyhNWd395ZoVBB2Gzi5BiPsYg6JKiGoe_v1AAiPQl5ac-YEknhqBQHGTjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vsy2F2AtAlGBq87pNcRLTko_x9upejrR4GVolnhBuLw&oe=6A3EA6C9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su1M4chkyxUQ7kNvwEPJpkz&_nc_oc=Adr6YkEuOfTBd7dssje_r2DVz49v9eaw9S7YCKsvAWuZIYyqzc0Pyu2OwF4TnJ6JYsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_RsI69egrTeTwKraD0araisGYgP_xKojzht_IEeOYrw&oe=6A3EAABE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNTs1ib5nRkQ7kNvwF7uUEK&_nc_oc=Ado7JmUenaiuHOVoqnfFOjMm6H53uNSRAQNn2F-pEJYbNTNpKFp7XrDDfINB6oG0zlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vfh9X0YGeqRXevK_UjkMXLqe_2T842uCZh1w0Q8pAHA&oe=6A3E82EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
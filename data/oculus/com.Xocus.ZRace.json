0f&oh=00_AQCNpZtW08rFXoRsAPGQYjOWIaZYFmFp9zHaQrodrodGtw&oe=6A6DD261"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPYVQqUfPtgQ7kNvwEPsx6E&_nc_oc=AdrCAx9cyh--B2PWX39b7Wv1V66jm0id9iR_5xHv1TTQFL-PDaX8iuooA0gYPvmvFHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA69HjLupATpJB58-LdG5kyK5jHAE1fXtefaVNy7w_z7Q&oe=6A6DF5CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwMlODWEd4Q7kNvwF9sqf9&_nc_oc=AdptqQbNU7sc-cffwz57AwyEcvpxGYi9aqU_AzBbrn9vZUUTtYnaOb6qp3XZZlq4gQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCimKdNTtjtTyFxcYGmj5iymdtX2SFekRw8fmNtCGK4rw&oe=6A6DEBB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1TvedjfWHcQ7kNvwEx7Z67&_nc_oc=Adr0-iTKWDf1jPAa8p36EhhE6jB3Epuf-zQKhzvqtGJCLDwnofhUfp9j0JQ8PWLgTjY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNgP-IHlPFVz84JpzdsAV_cllIxLq1esnJ050IvtyoyQ&oe=6A6DE489"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMPyJpyZF1AQ7kNvwH2Drqm&_nc_oc=AdotQgyOICG0EluBOyzWm7jBS8Tn_0jn_XnADzIwVCMpmqiQ4fmDXQ6akAFNqj1DNQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOyyoBpgs7_r0MDn6altYrC2HgXJLuHLVqRvDd6TX9iA&oe=6A6DE87E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmz75OLT7GIQ7kNvwEq6DU2&_nc_oc=AdosCVOrX1Qtf6Vuz2alqB0-bcwSpCRd2M4SNDInHZSA2dFptcHrLSAPXf5-FQfJImQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM6-IMjiT5tThAuEkrmICGqtreKtNKR1ienZieufHCgw&oe=6A6DF8EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQDYG3BhtFvKfuJxCRjD_VnET5FIw5h8cpIr6eOtQ6tokw&oe=6A54FE21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0WQMt5iH7MQ7kNvwHxGe56&_nc_oc=AdqDUv_CNoCF9-iYi8SmSXQuCEVq3dAhyZZ97BZicGufXtGPsmslIa51TxjXfrATfqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ7eOH7EBoahNd7U_L81RazI4ggYQSzHthZPplHLjteA&oe=6A54E94C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmDEK6mq5dIQ7kNvwG2ipgr&_nc_oc=Adre5cFU1GOaTzuSRM3EUIaMYlJYCTBGOm3o4qO3hzyrgGm-AQtMiYgIUlxUZH6nOVU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4ZXQeoH7mlxjK0-26RY7UpISuZVgbXUhWeAjTNlZxaA&oe=6A54DF31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqh0eRkKDKQQ7kNvwFciSFu&_nc_oc=AdoOamoIQz9A_2InibERSHntS9nPg1CoKX6U0KEw0cX9q99V-mcAjCT8Zw_ek9Xdl2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA88K9-C5-ek-XizBsuX_GENKXq8CGa3q3aEik6GSrCA&oe=6A54D809"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJKEExc-yRAQ7kNvwHkbjIm&_nc_oc=AdqKrcEyzRvV097Y6TIz6OuSpCzNC3zLRwA4chBKSJCUWm1wM55PYYNiLvvMRpvj8u4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoXtlhqaYM22QJoGdFxBiBK05bc8wSofvpiuSv26DsTg&oe=6A54DBFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dU1ALjsPzUQ7kNvwEzALjM&_nc_oc=Adofn5Jqoyy6_ULHYnJ88q75-HYzPqfKXSg1AUe4hSGMfjzMXNtHeqjX3KCzUhWiSb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_RolyCkC8jZZx2je-G0G-2NCMCXJX74Yi1i6Et_DvRA&oe=6A54EC6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
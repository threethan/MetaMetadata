OAQ7kNvwE70rqA&_nc_oc=AdlOV5a45zs7ob3QNQxtv8ieqbvAZf0n5TrjIng-guD0MaVhd0TvFTJimm5QPiSVH7A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfssnwcX1q69i-Ub1eMD-h0tFr830dIhmk5oWWZlH2fQ7Q&oe=69A591CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZWaAMIq8OcQ7kNvwEU2dQc&_nc_oc=Adm-rBdUGsQ4JNBWSlUGLyeNNUv21wywD_Qzjv_bRI-pYtVuucXicjaaDKlnfDWpo0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsDgzv88sJz6I7wsLfsNg49kwasNhNI9Yh76gqq3Kd1gg&oe=69A587B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0acAuLqx5GEQ7kNvwHPW74F&_nc_oc=AdkCb8ukLUTLuQDCsA1m5OgVLd6dfwCgwbSGOHAmSvujI73VyYVu1iBe2YWo5k3dSg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsvhrJ_29rHRwequ22fSnIefSkcWQJMznjquk9v2bRZJg&oe=69A58089"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGrDgiuUhtwQ7kNvwGIXx4L&_nc_oc=Adn0YAgOIVhm39mwd_f3nhjwvIURSXwaa2C93qDwkmVS0TR0Pg7OdGKwIoifuRwe-j4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv_ecuu698mugPFz3KXfiGdchc6TXH7yfNws-lMJdWFAQ&oe=69A5847E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6JzF4KEHPwQ7kNvwFDHu9K&_nc_oc=AdnQnKQIDdkwr4gBkUVqY9JB_uwUepp7vqzCRcgr3oc7uYJdwU6pQU6bo65fYlV79cY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsm46UrrDAH0AgNxdngXI0AnYtEq5X89WeC_Y6Bwv0L1Q&oe=69A594EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
0f&oh=00_AQAq6CYgaWXTMPiqd1QY2Ac1MPMH31GCdkZUyTGF-QvOiA&oe=6A4BC3A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPY_8YRLHmwQ7kNvwEhKF9J&_nc_oc=Adpq5pcPo6sCsdXpwsFH-i_O6ZtR0N9vAXc1i7uCAoMFAR2UH9couCR0n7-4-EHKKZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsVShTFUVqtDgIwcLuhRTR4YorGaVAaU07JVQ6YGJZnA&oe=6A4BAECC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulPn6Iab2e4Q7kNvwHDq9SO&_nc_oc=AdqgEwiXUE6aOoFPKCXxpmhK_F-1bhTPEgalnrTE_p2vGx1cs55rKpvtyb_0UsKDE9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfHmYW8Sf7Y3hlNHzq8C1ABwHbvAhJ5WrTdDV4GgBqzg&oe=6A4BA4B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifPImlEsI4cQ7kNvwG3s32y&_nc_oc=AdoGE-i9cZ1WSRRxug1-g6h51-CIQejk3qoHQsIzdjjeGr3IlWzIlbG9tm1xtkaKpt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpbVy0-gFD-QaZ0J0oUNQkusX5MheW77i2DZW5gKoLPg&oe=6A4B9D89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLC8wGF8dQIQ7kNvwHFtUn8&_nc_oc=Adp75X8MQKsvUWZfCc_owrd2M_wVZbZTcm4YrUZqhUayS2QjuEtNEQgZ3ywHnZ6yjDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9lTvLxtErFo8s32ATR_Q1Ii2XaBhZ6rTbZLT6HC7o3A&oe=6A4BA17E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNfHnT1A6LsQ7kNvwG4nTi7&_nc_oc=AdoB1dkp53Q4O6ihm4CUefcuitKttwD9A0U-Gy5d7TqpCJCDOoI0gNHa2MAolRJCHgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZF-DvPEyKLDSaVAOD-VCDAFbsanwlkaIbXewM2IYtWQ&oe=6A4BB1EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
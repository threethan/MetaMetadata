0f&oh=00_Af3CjUvO6wXJ4QVdOZumq_XgwUO_7KbKNaxiHMyN5xb-ug&oe=69DF7061"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KmXoN14CWsQ7kNvwG5Lppw&_nc_oc=AdrFPWyVlyTt5H-aLQH6BPSaQz6kTLgYJoIAY3riy3dqcm5vpT82TThzblctdIrz-0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rdykPTxYvdoyqbVv5ebzxbaNwu0J-agkhZe6egxndgA&oe=69DF93CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dynke7CvIB0Q7kNvwHeIQyc&_nc_oc=AdptdiX9K4rfJfRiGrbrFlsYe4xN8s-xcfwRMsimj2gKYucKJvJeZA_qTPWeDt2BMUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-P-WSZz2FtnJvMTkFatHQQVTUMq5eHsmZcf6WgjqJfQ&oe=69DF89B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifJ6cMFxjREQ7kNvwFKEYRF&_nc_oc=Adr3YGGtqwOoyUn1jkrfLhuSLG8rVC_r_rpuhhzgDyL0SEZ9L3zfE97RhPja4R4MTi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qau0qqS3vVvexQSYoJqf4vtzcN-2vWHfJdBE-Z7tPWg&oe=69DF8289"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZFprRsoK6gQ7kNvwFTwJz2&_nc_oc=AdqdSMvtWdz0AK7Y6ptYnfAGLiC2toI-YqdBUMW1AP56p-0f5TK3uQQngV4_gDIu2XI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ABDTUSGdrh71hm2yLlJ9VjvuCv-yqalKMK0ckOT5GAA&oe=69DF867E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hukdq0RWGqUQ7kNvwHCoCEj&_nc_oc=AdrKTPRLBRw0YSvWuaV2GMa4PJLGudMkQ_zMz7ZJ_cDyrF1-ekKGlQQcr4GHhCIo5I8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iW0XgEmtDRyY-HiE5x_Gj55KyA0LLvnwE19w2WZfSng&oe=69DF96EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
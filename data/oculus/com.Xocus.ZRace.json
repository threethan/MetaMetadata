0f&oh=00_AfyVPHgDZ40vqar7cEqS59BOsLlSd-XumBHWDituLmrJLA&oe=69C51261"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pMfREwNMV0Q7kNvwHyHmzx&_nc_oc=Ado3KeJkojY2_xExkAROOYG_-u4c1q9YZsgAi3xmkY_BTvb2TTOomqTLVC2cROeri2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkG12JoQTXl9QsKPm7Hrxm0XeMoTqpM8PdQvjy7l_8eg&oe=69C535CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkpJA-ut19AQ7kNvwEa87R4&_nc_oc=AdpBJ8jn5-myK1afUWyegWP2YyYPCDjiP8WnFQ3d6TVcuDnkaQcsQwvirigODBU809Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYO93tqJgz226fvlVl2TmdF59PG1QFcD8VomY9JBvsMA&oe=69C52BB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnIKwKCtfVUQ7kNvwH9vy_f&_nc_oc=AdpG-VyobCvU6ADttPhzsB7AGI5B8syxcRON_BjZtcdq0z0MkYIEZ5fZvjsDFB39gIs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1pAv7D7gZiDoUQvgyhA8hJV6wKGmyMzZ1L8TkK7pjtA&oe=69C52489"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8E7dJekVZoQ7kNvwGuilDa&_nc_oc=Adoq1vLWkz6Ln_Ub79bUsNaPjpU349fYp0TRWY0lhHyA9wYL597A4SbJ8IHYEEAUfT8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-c-iu59D3FDuncTFcJFgbwJHE-DCTFNuz_iCYjxV4dQ&oe=69C5287E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evoc8C6f764Q7kNvwFEYst6&_nc_oc=AdoXvzfqeWnMf2tzWCxTxDl3r8_-fWZfhJDAFZxxr4TzvJZK3GMar17U6LN8pImzalI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9sGEvC9N506aSebgsD0afki3FgRelUmNxxlAm2VElvg&oe=69C538EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
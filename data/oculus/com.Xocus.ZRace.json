0f&oh=00_AQRhfYf-8P6xdwjcgz6lWnQ06D_pRMC8VsnVPxAq6oTnQA&oe=6AF08F21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGGC5pe4tg8Q7kNvwE4ayS_&_nc_oc=AdqP8CGhU_H3R9IZwyca8V6wQ0hQORfAEWgmF4jqsbdxGH7sjPVBBV3QELpI5sedNSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR8wYc1voJ49tZiuFyA3fbSswvsqS6mGDPSLTRyNhoqQ&oe=6AF0B28C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSsnbarcDE4Q7kNvwFXJvRR&_nc_oc=Adq-7No_RxiafBgrl7ljEdm4_R7wbG-Aq7S0-qZXJKFPGq0FzUXpK96a15mFw_PvAJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNTENUUYtTB4lDXXRVwC9ykvwJm_PJsHPaSkrxRs23rQ&oe=6AF0A871"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zjlz-MdqHZYQ7kNvwF31uP8&_nc_oc=AdqjfSrqltr9MLE9WrAkeLhJ3CynwCWY7Vk2T6R2iJY7MddMbTQ4P1FeJV_-csTJHGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFOLpvIg-GKzPybI8aYJddPqcAEkvg3N1k3XiU8C0BDQ&oe=6AF0A149"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbDwYmfc_PUQ7kNvwHyAYOV&_nc_oc=AdpCDkMxH3zekRuiW4JizI0QG6k1ptiianNhc3wmatyCZ90uhNNtc-T9WA9Fg_bGKE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5b83RzVoRu8bx22jYejko_W1-IgYxsBl4BZB_sLoBPA&oe=6AF0A53E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5MfKTUdxj4Q7kNvwE-a6I6&_nc_oc=AdoxKIX6DS8AVR6j-ssRLFciExXhtUzvHjenNSVuaqL_J7BFznTed6-Jez_iRw-FARU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0olvEg3Zh35Vip4i_fu7sEk6y0BhjtLbErL-xCMlWsA&oe=6AF07D6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
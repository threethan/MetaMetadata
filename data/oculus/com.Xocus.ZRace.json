0f&oh=00_Af2tUYFvi2ShogUM7alfh9VKhRc4cgpGr_NQ7-oMMXpxlg&oe=69D8D8E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1D1kKWuVH4Q7kNvwEUEznf&_nc_oc=AdpKs7sz55nMn_LN8I33HNKZBJzdmD6a-2CO8iXHF634P0NSZes1IpoyF_j6hhXPW9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cYziU2VYeH5A2Vf687W-CvVQjeGECWd754k9VppX09Q&oe=69D8FC4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zh8-429krAQ7kNvwH6xc9g&_nc_oc=Adpmd_F_arwJDoT9QGTm2mdK8WPMRV2krreEVSRCXbuteCRZXQj7z1HrxxTLE-3fHM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fHzLk2lnvAMAfD__vl97IonBwe7gL-NKsq_EDorQkjg&oe=69D8F231"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fChBZZWpv2MQ7kNvwFwZM3M&_nc_oc=AdprTaEEfTCIVoQXjqP2IKs-JF0A4ZXxLwOUk61Rcamtn6HIK0x8YImKDQjcR7VXQBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ROKeHg2CWLbWwb5Xxj50fNti91JjhMLd2Z6lJnq1cAA&oe=69D8EB09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI_0rqaXhIQQ7kNvwG36VZh&_nc_oc=Adq2pYX4PYrmdpMISu08AIr-MZeTjtwbCS0paTzqDPOo2O8fY2O9rIPLL7VmsmwJFkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rc9cvKNwhKTNdNM8_8AQ-v3h8YY_MBcirvC3R-8YL7Q&oe=69D8EEFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM-A9jIsFiEQ7kNvwF04DE7&_nc_oc=AdoH5ERlxfzLoNO4rR3QYX_lsYhRUrVz8ekr5go94Y3_LlWX7hbyhg930gDHiHtFXMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2euJR7yWnY7Xzud5k5jPQRgbPnqbscPs7wpFPZx0uHVw&oe=69D8FF6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
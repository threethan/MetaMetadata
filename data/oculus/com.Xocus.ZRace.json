f0-7e&_nc_oc=Adl2YAEznzL-mwnFNAJKmhJdzSo31TZm2UP0L863_lt7W4HaWfsBJBrkoJiJEFK4QMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsWdk4NqviOtSRkSauGublUuObCnz67XOqRyxfiRdTWwg&oe=69A59505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover (1).png", "id": "169093589564357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974777_169093596231023_3709466873424777856_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj3oTy-HFE8Q7kNvwE0jLGk&_nc_oc=Adkro7bbKPX8k17zuagLAjbIK0jWPjOeMl_oi1dWGeXp0U0E8be6Sctbbj6HUZKsLUQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuP3vo93-L9opivYLtEOD-DZkyzsimbF2qQ0IUsZ8Awqg&oe=69A589E6"}, "display_name": "Z-Race", "keywords": [], "long_description": "Wanna have some fun? Join us! The most fun hand-racing VR game await you. Prepare to be immersed in a high-tech universe. Super fast racing ships and futuristic tracks make this game an unforgettable experience. Improve your skills, unlock new ships and take top spot on the leaderboard. Collect nitro boosts and coins, avoid energy traps and obstacles, overtake competitors with minimal motion sickness. A game for all ages, both kids and adults can play it! We go the extra mile to ensure that Z-Race is the most comfortable VR racing game ever.\nYou\u2019ll never be alone with asynchronous multiplayer. In virtual reality, this is the best opportunity to always compete with worthy opponents.The faster you are, the more competitive your rivals will become.\nFeel the speed and flight with us, become a real racer of the future!", "short_description": "Z-Race is a marvelous hand-racing VR game. Control futuristic anti-gravity ships that hover above the ground and can fly at super-fast speeds. Race through chic sci-fi tracks, collect nitro boosts and coins, avoid energy traps and obstacles to become the first!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "
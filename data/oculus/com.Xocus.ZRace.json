0f&oh=00_AQHQo2o3ApX4uY-FZnK-r58C0oVLYTJLZuStKpnuMdqOug&oe=6A843BE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqDQHD9Ly0Q7kNvwFT5S52&_nc_oc=AdpigXtcvGBiiXFjNFM8ghNIB7AvD9u6dIcM0STdAobBbFLgvc1vPcGIom4ezjJgVZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlosCRKSjOw84mLD2ShW_10cnqA6R1KgG_5BE12bmgfg&oe=6A845F4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOnmLjA0JecQ7kNvwH43oIi&_nc_oc=AdpDwQe7v9ATD57cMuWtMt842Y97RY0J9X4l5gE5yPQShBSCcLJ-rX9DCPvqRS1Bn5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy1A-9bI6zw6gpkGHV_7p1CxqhCgdNbSekiELdGXHLCw&oe=6A845531"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKUXpEYKH90Q7kNvwGQuOd1&_nc_oc=Ado0mTZgbyQHlNiOJLTpNXvfUhX5MpJWyMZ0Fo-opmw8gdJket5EJDn-SswixCQJBlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6N8GplEYsvEPseRhNSYJy6a5HY1DVMqX7C_9x_g0SNQ&oe=6A844E09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN-JXJtiCDUQ7kNvwFIHxf7&_nc_oc=Adpueg_jn3OIbixtqZZZum27sxd4Z5fR-4_a8uC_vGWjDJUGn__qPbKCuAILuWwlAVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0vQkQWit_2Lj_zqI0QIFPV3Dp2JWEsXr9XPVduGsGXA&oe=6A8451FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vsena2UcX0Q7kNvwFUMUaK&_nc_oc=AdqYwC6ZibIuzqWoTW5TJtsjTwO3nfDhLbGNDZw4zaFe5E1ptlpT-lP-_7fObYJ6NA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDTxxttDtLWoMWGUDKUHfEcwN_yprT2oHeesyKBAr9Hg&oe=6A84626A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
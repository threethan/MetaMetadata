0f&oh=00_AQAoOE9KoiX7a6RESYiwzPa1v8uf9wlt_kTQlTRN6D3GLQ&oe=6A622D21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDZCLc6luboQ7kNvwEzvVbL&_nc_oc=AdrlWO0nkd9KPbF0vCwMWAhRvYwU_ICDHz2ZJAIsFc6lTrWlYmLsH3ZwJix4NCj1Mbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxSZaXJNiYsoZIK4LrtjesnPWM1LUEMnq8fLJC17DAow&oe=6A62184C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR9P52xEpM0Q7kNvwHMAIN4&_nc_oc=AdpIiUoDduzAZG3qK02eqp-Di3gMDxVIvGKXdjxwtTCgnGhcuSUyj5cS8RVZF3bbk8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO1L5sLW395qU0tysrefqgN08VCE8WFBSP7LLRYUu2Aw&oe=6A620E31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agNNIo1e5f0Q7kNvwFbtPTP&_nc_oc=AdovtP8xHDw9felTqi1ODvRaSKMaE0MKUXLtUZdFfIqwQpEeZpkhmudV99LqiTmsvKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAe2zLf4vz8vm2ecTHk_IMrfRXPHQS7dn9096YXZGWaQ&oe=6A620709"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39qMjgYKsysQ7kNvwFUuxhh&_nc_oc=AdpAZGczLCtqo923OaM1NCbY1fAZ3w6nLnA_YFMoZLJdwhEXxLdmUjdusvCjLGQg53U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChIqJiu8W86Zu6-rR-NqTvq_TMCgErjBVBVMhGkSFrJQ&oe=6A620AFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iGnTRU9mfwQ7kNvwETPOgU&_nc_oc=AdpHKPopL3pq8BVwMv0v9Co4Zgz9TXfGR19Xcx_2ZFgh9-1uzQVigzQn-KsC8QmCGlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSW8VLHLNmV8ncF1YxgE5nL0IFq6rLzHuRvzUGj17KDg&oe=6A621B6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
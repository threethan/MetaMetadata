(2).png", "id": "558223238724271", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L4thvJZ8W0Q7kNvwHTPkpd&_nc_oc=AdlGczEdi_Yd6Hq4UYm-YjrAO4LqWkqdwwcVOBIm1OATqwRLr2DltIfpVHVs9Pv3zpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0mqPyxLr9l3kKq2hVzu4-u5MnEbyHCj_ZLoaZEWp-Hg&oe=69BE9E4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXu7gwJ_PgAQ7kNvwGjnnk-&_nc_oc=AdmT-JL-V45pAXdqq67yh15XFp5HRZDtJnXKRKQyNHxXaeLbeXlagxPzMR3lP-vZwnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS5Bmo764_F6CMXZL1HtzZveoIMsvfFmSaZH7cLB9MiQ&oe=69BE9431"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYaRI1t_peAQ7kNvwHGGhcw&_nc_oc=AdlXtQf_mGIKVexu3VXtNPlx-ONzAWyaduxBbaJsrbBEMwxRwQvDF_7lKTpNd9yHGto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBymseI8VdOILzLGKYJKMlkul3A5JKPcXcBF6f5tilcg&oe=69BE8D09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45hb_noHcxgQ7kNvwG86nDX&_nc_oc=Adkd6mInnE-AhPhq9-t1fMVc5aNOGCCo5JxmQucr8Pbv1uNZNmONmMV0fx3xQY5ihOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq1rqaDoMl807dHfl7FiJFUyG91oSEGoNX7J2Z94lDlA&oe=69BE90FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImUUofFA8acQ7kNvwH45zti&_nc_oc=AdmrXkjWkDVrP45TXsMWWrQXO8QuQas7T5O5uZYvivxt2xvd-x6NUjlfYx5loSbcM0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuNH5y4DcQFfQdsi0wxzg3qGquwGjG0QJn_iwDeoagsA&oe=69BEA16A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"
0f&oh=00_AQDR-F0xap3xqwHYe8KeX_2WY8NzXHhWFyUD5IauGu6B8A&oe=6A6A1621"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBaFA3GlMDAQ7kNvwGjv22U&_nc_oc=Adp59Sv1imkyySPfOBAvPoQ7T5ECNxmrXzhPQEXwnyHLdn19uCjchrGleAaGBdKyCLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJSqnv-zWpXe_DyHVTgoxzOpbfEd6QHIQiX3JxXWVOow&oe=6A6A014C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xai7jz7bIbEQ7kNvwGaxK_P&_nc_oc=AdosCQTsXsTcvybKPml5wVMaFtpXu7DSqAjspA6MRSKlR1kNNCFmDKSI4v6Zl1yffmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk3Ybra2bV6C_AgciCR8M6653E4q9-4UqAeHh9CkPPQA&oe=6A69F731"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySiKW0ze1QQ7kNvwGS55nc&_nc_oc=AdoQbBrCMzqF22IMdAy3Hc1GJ3vm9e_xSSBZE48_2Hh3iCkcKIQ8o6kacqSmuEl8rns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO4VmBRjDV8EDxkcQ7UlARsqoMWqJigZSC28JQtA7xQg&oe=6A69F009"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6BU1REw95AQ7kNvwEJaSEI&_nc_oc=AdqoSivqxWTfvJYzI0ryMlMmmOybZQ0jGJ1L3bG2MAMx48Ocz5tHj3gj1wWqz5YAhNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbzyOJkk9ihgmFhT_A0AthykfmAp6AMJNgHQNTEjtAog&oe=6A69F3FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXLO4RQv42gQ7kNvwE62XsJ&_nc_oc=AdpO5bW1qk161UGs_9ijxetdW0cFVEOZWn2DW_k1tyJvUdcaqK9-bBtPy8lweUUjqTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVns-r3ltNzfPJVk45nJYga-9GwiBmTxf_x10i48fm0A&oe=6A6A046A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
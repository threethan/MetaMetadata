0f&oh=00_Af_nlANjmI6jmKEIQw_1baCrp39liRqzx9_BVCJaFl7ixQ&oe=6A428921"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oiy8VsdxgLUQ7kNvwH4rXbH&_nc_oc=AdollB-z2y0xUi3PN4S3X4C00txeP0XorIQcJnm7ZkVY3Cer39Po5KdPjJ-cq1T0Slc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xwkv6GrVjocCLeUhuEOOHJ2O-Btt5P112J7QJ32ehMw&oe=6A42744C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk5XTaHrQVgQ7kNvwGJk93P&_nc_oc=Ado2-cJ0xsrkDL5nfXqx1X79bJ_TDlSrL-BRpmtPkvHCoAqs7knQgpuXNVpo6fepRCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n6p8NUHTdSwGGVroyVS0JpQb8n0-0b7_5AvK-27XEgQ&oe=6A426A31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ndZnNq2TYQ7kNvwHbvGNz&_nc_oc=AdrkJizJMTvtiHaNs_FwHybBznWe4o90HF5De4VSt8k2DHB0YadTgRlhx-rRUblk6U4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tUperDt8mSpwvUGOoQCdN0vr68YrIsSh_UW-mpQEDKQ&oe=6A426309"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk9_yfxHN4kQ7kNvwHm3YYV&_nc_oc=Adqrx7C0X48OI8OIIG3YuQjiKoqKCZOgoQjvIDzeX6qCMB8Ipe2IngC6_6ia0FqbiOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YMJCwNrtN9vyxYM4a0c6j6cl9D-rLYZCOjBK4MMuvng&oe=6A4266FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAc7Yfpoj50Q7kNvwFRUuvO&_nc_oc=AdqE3VlRLCFQxtbT2UG07R8qFy6bY8SLIjhJHaDV3-YvnD_v_XcwIUtNrfiL5IADCfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cZGXuzmcwAofkjB1GFSAvgSEJ7VrbKHD2csdZWLBQVw&oe=6A42776A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
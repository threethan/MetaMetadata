0f&oh=00_Af_QF69hVZ92RxTIK9TUOP6mmnmnWmVFYr51b9CLkalv6w&oe=6A355A21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh8O4LRfFZUQ7kNvwFSxMb6&_nc_oc=AdpFriw69fxDWRp4iXqd_TR8ZijejymX6LRPvkJc54dtqANGapa9sZjLbIClfcNWtp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-AGbreAAVum8hVL4-RlhcyLqTXqCYSm3vEUMli4HUzQ&oe=6A35454C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11KsPisvlI8Q7kNvwHvGIoO&_nc_oc=AdrPByg6JwJbAao034KgUFwiLFJ2j1cKVRSUu7m38meJQSsRKOxfcVjhRep_ccJNVwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FZ8LPcK2Po0Y1ypVbH9tAzrzCK0yY-Tvv46kOsP3f2g&oe=6A357371"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaYLvUA5aZ8Q7kNvwEIOaPJ&_nc_oc=AdpRRirHUYjj8PkdDGWRyqo4ImBzU2W8sEWJ1cstlGVDPaWzcM-KF3j-4N6JjQcBXiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-42GTRBJrSU9SB7hNC_zPXI-wAOeAzAl2LSc8ftLYt5Q&oe=6A356C49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw0FKki127cQ7kNvwFEKxWG&_nc_oc=AdqdCkhuOP9Ye_nI_kFbJVJ6E9QItz2om0-hJ9TEfyCzuQneWrK_1AOpNKuM0Wr8rbc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nVFmtSTRzk5bZLr8wGk4BuLw8VhOHIDY4FviV60gRSQ&oe=6A35703E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoCWTI839nMQ7kNvwFnT-i2&_nc_oc=Ado_Y-jayyeuESzXEmF5-kTN8WllFjVQD9l9kdyp_LoN1uIDsYcQn0Ka6YXqiERpUQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fmk3lybzSOJfWhzV5_yL7Sn-7kxyWU80Ya3t-ZOXtUw&oe=6A35486A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
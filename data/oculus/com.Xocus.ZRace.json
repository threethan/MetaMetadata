0f&oh=00_AQGE4obljmrv8VxCXlNjVboiYlRx3HCObMYWo5Xz2VmJOQ&oe=6A74A221"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d979FaxPIcIQ7kNvwFwm1UP&_nc_oc=Adq-sDAbrxYwxvlMoztvkXShgnci302uVvCSm9z5sCQ1TkdzqI0_tFmyyMV8IAIV7Pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqZlNTOuCG6BBCALWLzpEti_-7n3wV-Mv5qv8vZA-bJQ&oe=6A748D4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXEsf3j6UJ0Q7kNvwF6x4zn&_nc_oc=AdpaPFJoRoW1o42E83adkrrheLYanYhwVxx5NM8foeSpELZqHehhXWspBoQE7J5d9f8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfriJ1U2Nbm3vX535Cyzd7xh4VF7KfVr7h3zr3bG2hXw&oe=6A748331"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDTueUCzcRUQ7kNvwH3f_IG&_nc_oc=Adpw0U00hHhmVxtoaxj726zUZ5iMKJ7mtp_thNkf8JJ6Lcye9WoD36KbaHdWThEXwOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9pIxD11JA8HZbORpWLsxx63nJHnaLJj41yCWSro3xwA&oe=6A747C09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbKlub2dlTsQ7kNvwH07I77&_nc_oc=AdoKwoZ_gkXxEZDRKB3hUeXndnXgRU3NlzVpdaDq1nWC3Td07VXi5Gu64HzEIymamgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENpkmLrzrk8nYUIy5z4lICi3XKaruF52VbQcKebzW64g&oe=6A747FFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSEMLph35NMQ7kNvwGHnMBv&_nc_oc=Adq4tlQgT0k_CyV3fZYijD0OGLiFHRq5TWMRIswjZNuDxfHLIcv6g2zwjuUV-5HF2pI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYWHvSSffdZayKA03YR5tEiue7-34jTEFEwJrKcNGo5A&oe=6A74906A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
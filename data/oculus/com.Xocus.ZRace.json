0f&oh=00_Afz60tKA2bnYQ0VkJi6g7Y06H8T6ABpvIHRBFmEj2WEcqg&oe=69CCFB61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h99RCm7WAs0Q7kNvwH_0_qV&_nc_oc=AdrHNpr8noyB86UkPUDAYLufssPU_fN83fxxgkqYWOQCCQkbSqmGy81he9kXbtNYmUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjc6zIeI965hWgHv_iMNkJlwC7bJwBRnp6zTPbxjYBcA&oe=69CD1ECC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziMdPjutqAAQ7kNvwGWepz8&_nc_oc=Adpq7GUNLGvNo-dqEetnzwNE24gLKChVPlmnYVDmi339gUNgnPuTziB8EodkWQlQtkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3P9m8j_Pu4yoV3eN2XW1VJqKTsFPF1b2X1--E7YkY6g&oe=69CD14B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWcIoPXKDXEQ7kNvwHUHz9j&_nc_oc=AdoUFkOM9HpE9sb8r8o0btfYiPHfdNhL5DjU2yek4g40xOvTgGM9vEi7gHEazDRagvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHK8r9w1dObl-5u7Z3L8Gn_hWdeFoBRQ7_dvg1JCkoLA&oe=69CD0D89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHTSFkDp-YQQ7kNvwHQA5s8&_nc_oc=Adqa2IQAjivTZS1z2c_7-z7_plWlXiEhk4ZaL7HjiTwdGmWz2tlTeoJc3BJBblLARU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYW76WZi_BLUZrnGqZZlv7GgovTTaL3tTyQPTwe8EEOg&oe=69CD117E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HceEYR9AFdUQ7kNvwH0jb4-&_nc_oc=Adp6-Sg_glFjxJ2d2w9EqjRbGvB20zHq5JJfBJatXStZyzcKhunNroFG_yWNlO905Z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUfs2MmlxgkRp4-R5ASYABNFJ-j0iDyTprOk40zuB1zg&oe=69CD21EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
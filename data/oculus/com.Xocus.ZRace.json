0f&oh=00_AQFMiLqWA0raYodz51AWkqEqias4naLSHZAyCSzYedekgw&oe=6A7B39A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMzLvLafGvkQ7kNvwHWQSGx&_nc_oc=AdoYRDiuafwhLsYXl7916-YbnbLm-2XoWTusn92n9_S_U73eKOfhdKMGImavTvySQFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfK9Xf7vU4Tq0YOB1nT0VG_Ph71YtnPRPV5AERwfMqOw&oe=6A7B24CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De81VImTG5EQ7kNvwE8A1n7&_nc_oc=AdrwaTLCIvM2PGljdRovBoRAo8gtxD3fWVNZVpB65FXsLPfmXy7F-B38BgHYBJVuzjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW5nC4jQf5xHhfcbmKZEVTcpF6G2WA9ROBiK9nCKmabw&oe=6A7B1AB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agex1TiI7dkQ7kNvwFAUwUy&_nc_oc=Ado2N3Ex1Xxh7Q5-9lEqhhQYj6HiaqAp5hu6YHlEe6xYmEqITj_TIKwFZP8bmIMDKkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG52k7EZXfKiVYe47kQKTqA8d1TH6wr-_8ziDj1GWkrWA&oe=6A7B1389"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbAEHXFYEnwQ7kNvwGEjjrt&_nc_oc=Adpv4Nrg1HARlzBfIe9utcsEx-i1u9z9z8xvjQfKxV6zcLVC5ZISj6PNlEKfUQcru-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmESrn2s1rf7MG1VJzjl0Khv0KL9pDcABwGTQYX4S4ig&oe=6A7B177E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziS9t1VyTEIQ7kNvwFfpW4E&_nc_oc=AdoZ06K7hxZ6a1RVbXbM3-QTU8UFXw-kL01FVbHtv_ppP7hYMAe7yabvRP03v2eslaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7YYEqnLmQ-T_3mRRNLEyIiCchRLSYFRk0o3FLoM3nUg&oe=6A7B27EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
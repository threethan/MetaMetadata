0f&oh=00_AQCj4X2P4z31zPgfXwlJVaX0cQpVjyr6d58X6wVEgj4f9g&oe=6A677321"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWnOR9JJFDcQ7kNvwFaczzK&_nc_oc=AdqaA25MvhJkKjjkdBPExUzhbBDFHU_CCwD-gAjYyUfiFV38p_Gd5ytGf-4stOZF95o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRqcpHDW7m30Z6e5c8ZxWVaCPRag-z2MeZnL_9MofiYA&oe=6A675E4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xai7jz7bIbEQ7kNvwF9OlQg&_nc_oc=AdrFbpKRxPtEkAwsuzlHQk0rPGkvNcd-M8rm5PNTy57ix088bvOo9pcR_lNznbKIiEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqkAltDPNU9pF-vjGaveRWZuim61RYIizM3947G77ozQ&oe=6A675431"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRM52flwQ1cQ7kNvwHdV8id&_nc_oc=AdrCWfz6mwpWqp5Xn7Hv1kk4FXYz3gBz29OFwm9qI-ax1_tk7LagrkecVsfjg01jeSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcXJtfiTkkkTvii6tFB4S7vgdpn4EDu5RgSxGrGCv82Q&oe=6A674D09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-g-et5CdXAQ7kNvwESG2iz&_nc_oc=AdpkXK_XqRBJHOPHddUj26nZHi2NdVhDHf3pBjoDBVgMbRLwCv8NPZIYTlxYm0gHSSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvgs0KqnblViOO9dmPnSUnF7mgqeO5G3Ls7Bv34MMNZQ&oe=6A6750FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6khNfnuJ9lwQ7kNvwFgIgBV&_nc_oc=AdpNuGg6M5C_3e74JjdezvuJ4WV6VfZUjUI8JlzOwSc86xuJw1NbDLCBlAN23M084Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDpEa-nTMvKg2S0EEb_iIyXrg1ob1QnfRPeU_12kfwlw&oe=6A67616A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQFfg0LWUKrAtcva5UIWAm2tyExCDc-kxBqo67OdxmPYSA&oe=6A8981E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2yBCu0bFYcQ7kNvwFrlZe0&_nc_oc=AdpB9JqtxRDQwHDi94Vp3m-9kIMQzH94TZVZ4gL0llN1dcYPGce95tx_6h93-eP9sOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5z2VJpYkWqEbB5nskWYL8TVJ6Y1xHviP9PlAMuZ5vGA&oe=6A89A54C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdI_Co7cznkQ7kNvwEwnBsY&_nc_oc=AdpcZJD0nhmHn5QBRzVNvBgwOHV4rK7s4A5wt7XazVSbRGj-XKXgo3DI3WGStS087H8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcGo_ko6sf4v-6MBvxyJm8t3tthVDGt8mSkBrMNeO_bQ&oe=6A899B31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyM_ntcg8lcQ7kNvwFg8GA8&_nc_oc=AdqtBauj9IyYNs8dUKWbvgirtYODUe0Hn-8_Na9wMAcwh_Cu97o9ci5KU8Unde3U-1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSam0AnThWx0qtQD9YW9MuInMw2I8MZVFkhpC_ksBWSw&oe=6A899409"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QbPab0dZWkQ7kNvwE8U3Z4&_nc_oc=AdophDQIUTK5PZpopTDC5fdLvyvLGHOjFdNCAhBaO0hPT2p0mCmEutG3sPkQwXCpyxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAROL1onR0ESuBGTIGGHIhGDhSp9ZsEWQgpN1INPNyjw&oe=6A8997FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pOeRUV1evAQ7kNvwEwJpMb&_nc_oc=AdqOiDWbXZrWoznBo-iISPTI5lGfcSoOionBFQtwAo7Xg2zm5pwMCC2KJSsgeIFX8Qg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmD4ebxeayUaZj8p13iwRkOXkZmdSW3w4N2qZUFqRWVg&oe=6A89702A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
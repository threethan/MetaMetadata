0f&oh=00_Af7wGFJ0CcCZy1bsMQIJbRgfCYbENIG1iwetpKPrZ3_VoA&oe=6A1EF0A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4qCFzmL8PIQ7kNvwFYAcPV&_nc_oc=AdolFLisKhmCgq3XDOkj3uiZgLIW0oagZqqZcF0KtMhG3P0rEG6hZNpBO_Hm0vp2MuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GPrpmxluSWXMqLe9mqwtWRwVtr-stE2FIego3ekxWsQ&oe=6A1EDBCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1qTeAu62t0Q7kNvwHlcK67&_nc_oc=AdoRJSiRtwV55rZkv_SOxT3HBNMr7DHgOBPJ64rXsF_cZAfTARVIPtmT_okQqA3hjxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nn0VJqFHbBH9af5kW-vcHw-cDKMuHmIlPx0T3o4BXpA&oe=6A1ED1B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9j9KEtkMLwQ7kNvwGTRrkl&_nc_oc=Ado2LQvuok3Xo-7N_j_77wcvZQZbQL0W9nEvvLXNYonnjVT2yk14P_uavEfLc3sZp_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NiycnrpG-hnfk_Ye6b4H3fkhUpmbEyhwnWl7ELv1m1Q&oe=6A1ECA89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf15UbGl094Q7kNvwGW8OHL&_nc_oc=Adp7cS6M3OLtaj-4YD_TX9MhPai8tM4Rq_5ki_6umiJ9tLe2o4-ifXP-gFG6X1rBhi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aXiW3CKI72jPXurjukR2UEhKYvKLkZcwQtSOcHAgFhw&oe=6A1ECE7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPX2hDIferwQ7kNvwEKWzP_&_nc_oc=AdqpAm4UWn-t2FTYEYV7VhmTRwFjgaZaFoNGr-FOiJBB0RA68AwJKwGfixyUiD_HQQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LRcVeZWHpnhj8RJmgkE8zEY1kgTjTRoCghQBshb9WDA&oe=6A1EDEEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AQDLe29jp3Slpgz52ZFlXUrGRJbCDnG0jzeyuIhQvayWKw&oe=6A53ACA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0WQMt5iH7MQ7kNvwE2v70a&_nc_oc=AdqY7eT40PjOaG2FvM4EoCblUc3c9I6aSppsTdaHOsBVN34i8BoM-Ami0TyEbMFhbhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS4118Zpc44HdA_mb51XzaZcb0kCg5XbEgkWbNQCVzEg&oe=6A5397CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmDEK6mq5dIQ7kNvwH5XDey&_nc_oc=AdqkjWm51M0_PmahLJkJmFVP7-7Y5G9oEzUKkzZunsd6LJHXqi6Tqv1-hN6ROYbTWHM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM1i21Wcp91BSXte3asOi28nyQDWGLb9OX0ONJdgD9yg&oe=6A538DB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t32wcGphuA8Q7kNvwHUng8V&_nc_oc=AdobipxqfsR1Ykhc0vBA5rwgfIHalTlGraAyrgLy6h2HXx8g_iV8HQDg8OxTFeX66Rw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5xRfsNgUkKMOsQeoIccdEECKcd_vn_5LODAdC54Sd-A&oe=6A538689"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiY-Rjc1UtAQ7kNvwHpn49v&_nc_oc=AdpbunzRPF6ZIHojd8kCb3uNp-zslYUOTV15GJFWdiov9v03DSsWUoRVnyYnYXbbmuM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASBxpeh7zvMUMx5761cqsWyoJx6oEp28qTTQv6Aj2oNA&oe=6A538A7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipsMj1yidsUQ7kNvwHfdn4y&_nc_oc=Adpyvsp36Ck8iTIbSdo0SnRxv6u1JJ3T7Yr6LTVD1egcF61gauRmaWXKnvnLHkEhHfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNc3JzpEVLR9bdIYabEmSVs457UijfO4kxriJRCnFUPA&oe=6A539AEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
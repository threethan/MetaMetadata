0f&oh=00_AQEaSOVa_JK43iZPoP3bo-Z2AtPjVj_bIKQY2TX4MsWnDQ&oe=6A82EA61"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqDQHD9Ly0Q7kNvwEWIuub&_nc_oc=AdqEQMpUvBnD6iCVT9JI2eeUnixIUzlLeZFtnzo22fCpp0Quhdip76f64iXBMLA34VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPz59-qWxEBnYkx_AlplfPjKil8peEaQ8s0bezRxUDCg&oe=6A830DCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOnmLjA0JecQ7kNvwGgYK-b&_nc_oc=Adqfi3z8s89NHcOyo9qnhrGZ_KvG8dejMDaTLPidYTa65jP4PVoslxNzB4maW6QzGYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsB0Wgh6SvcPg4ucgUI_RtKkvwBMWPDATFa_AihN3xQQ&oe=6A8303B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bLEvaaHJB8Q7kNvwGZES2r&_nc_oc=AdrozrBV_RETg5UCFyfts1bv28c0qHP_O-V7wNrybJUrphPCLbtboquqeb5tv5twZII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc4SdKyF42x_IHTpM3FgPQc9jAOwXUt5uN-_dBuYIH4Q&oe=6A82FC89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyRfg1QZyU8Q7kNvwFaX-b8&_nc_oc=AdobOk13cfpDBsM1A1SquxFRb2oURh-yDT180NUWrLOcC_hq3tooTYbp9k01w90QgCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgafJ0WPvuSMdb3tPfunJyLD_1XVXosgDYllFiVDb9aA&oe=6A83007E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81sblwpZRFkQ7kNvwGSPSsc&_nc_oc=Adqo8mjbKT0WKD-ecejEgf3L_I_vviaWcb-R2rqgIGtdvU6roXXpkr1mct7CeeQGaHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6r1zDXI0q5OmOT82ZjdeA2lyp7ucaMWYZSpp0vriH_A&oe=6A8310EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
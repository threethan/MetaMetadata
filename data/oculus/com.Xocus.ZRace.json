0f&oh=00_AQGZYoNmsjYE1JA2Cas1NeAMpyR1dH2kxtdr_CNvsK-BfQ&oe=6A86DEE1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyIRcqb2DUwQ7kNvwEEQLhm&_nc_oc=AdqNS7uOAlG1JORkTUpTHYSWbjBvqN-DNcDrmv7ZUQX5cqPHmMCMQfVBDVb5tLBBU-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9RO6fTMQ9yFsnLBDRt93nPCxX_vGNQ4KgRN1-iAlyfw&oe=6A87024C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdI_Co7cznkQ7kNvwH-Ukr1&_nc_oc=AdpBtemm3IaE9pKuMOO7mSyvZhmRtAzYe883cvt9bPTmfi8bFeEelEj-rwor-lvKSk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHumV7T8Sho9l-4_972kxyEDYd_9bE9yrxj8omMFHte8g&oe=6A86F831"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKUXpEYKH90Q7kNvwET8cEk&_nc_oc=Adp8l73u-YYCVF0TGNSz3XaQvAXOzUGnWInOb_4T1FDN0fumU5tcC79K5sKXCm90XgA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqF6ANJPtiBGq6V0lB2ROOQtND3nA7Kq0PbN9UwsX_wQ&oe=6A86F109"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN-JXJtiCDUQ7kNvwE6rQG1&_nc_oc=Ado8AEoKRjCF_eN6brKiFFmKzPBbF48D6PUkoPHUmJinsePTb-t4plau_ZR8wVRftUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtsUPNE9plj4d8gQh_IDhfbQzamkUqn7oLgxZJz4GpZA&oe=6A86F4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vsena2UcX0Q7kNvwEbuK9v&_nc_oc=AdpUv2pRZtTZgtDMemneQoGYLyThyJD0XzFjkCMRwjHcJ87fog8wTHUybWW1c8mlFqQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3jNExgqstzqyOl6PFSq_OlbHI1n0h7IYFwkq7B_TDAw&oe=6A86CD2A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af4vQrgHhY_5OQsZiZbsI_dSjukkyYyy1nGW4T110G8ZaA&oe=6A15B621"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iFGWzJVpGAQ7kNvwEHQwp-&_nc_oc=AdrLwyns7hWxsRglX44GhXl3RXWN9AptdInJQlLEt5Jwtb5D9w_IeqkF-YNrpDcugls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48oXxGyoApMvMowmKCxTB3YXnM9GgxpWe3ZF0jTqkeSA&oe=6A15A14C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkniypaJH4cQ7kNvwHq11UA&_nc_oc=AdrSckHE6rId7PUSqQJcJq4rFCKTo65q2h8kRqhuBoquwT_YUN6rLKciDFD96q-VJ2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wSmgvmiE3mBVcSvTMhIzL8m1dviDK4rlJvEmfoRaPSw&oe=6A159731"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX1w30VDYC4Q7kNvwHir7_N&_nc_oc=AdoALrF6nm_kWHAb5u-Cne6S1ttGjeQnevitRgNB9qYhb5T40PLM_R5z2kR9SxPzcic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f0Vs2pM1BC9RtYAJSzyBVG3ccyH_yLqxa8Q7exJDD3A&oe=6A15C849"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0l3bDLXifsQ7kNvwHtu0dr&_nc_oc=AdrhnC7or6KmjKTn3tyrQM-GdK322k6OCSk2gKp2hgD-_rkXfciFslCgZE_EeXxto-A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48xvu0wUDSMvtrCttgb-D-rfx8rBFz2WBDPr1I9pE70g&oe=6A1593FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKo5oRzP660Q7kNvwFnEH_v&_nc_oc=AdrLOs50w79vEoemduW2mLY--1vcNfJX6PYDcQk1dqci_0BXRSbBOFpTjaO6p8bExCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cliqm98jQeTaZ-g5tIdKcXKjTLIbH8e7Qv4rSV0C-NA&oe=6A15A46A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
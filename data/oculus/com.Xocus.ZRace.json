0f&oh=00_AQD42IeffK555gq-3gQre8fI8aUeg42gx9LCwjeQEv61PA&oe=6A58F2A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MdDkePNcH0Q7kNvwGlkiu5&_nc_oc=AdrtfN_Z5H3N4bv-ABWUrJARghQNi1AbT5rnODQ3ei2l8OpzZm-yiwsPlberx7I8Fec&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGmG9CkioGQsBTuwk2DuIPcSbcwQfdjtlA6A-We0IY2g&oe=6A58DDCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiS932mxRvcQ7kNvwFWa-f7&_nc_oc=Ado6E75ijye5PUFZtxu6OTHeFnucyk9DPNqBqD5fQ9UsfPU3Ge173jgd1_EviU6acXY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9oT7nM63H2qckICGV3lndk9SJ_c0gV-CXoCYilFOJcA&oe=6A58D3B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul9a8WCkMoAQ7kNvwFF72V_&_nc_oc=AdrHIcmDrOMHcRlzg6GGB6LoRLDZmOqAQzB7aLCiytSSu1u4X6vSOUpD5D0LA1YySy8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHdVkBJPEdaG_QWJhkR2tAVcC0pRF5YTSkmRkeCMCDYw&oe=6A58CC89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5roDKHPMxYQ7kNvwHtPjuN&_nc_oc=AdrlAwQ8vjTjgnRx6_DmQ8-sjIBNXc3WJZCBkSWcYEbyP9pIMi_CTHEj-neYMragGUo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrlHihVGbbA4fLekBPRNn5TnxtA_SvFcxZrAiuMHyh6Q&oe=6A58D07E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09B3N3rX9WIQ7kNvwG-Uo_q&_nc_oc=AdoNUarjd3ajYIz7gEinNBY2kSDBsXUS3dyJdNCaIeyl4yHbJDM8ZfRhUXaQzlyXx6E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn1b9UhM0W975aA8Psxx204IZgWAZWJ5fMvEZlbkuGLQ&oe=6A58E0EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
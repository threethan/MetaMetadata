0f&oh=00_AQBLIr0hMf_DMIA8qflMZB8jscUSEXdABZzLERGhojWdyg&oe=6A6B67A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBaFA3GlMDAQ7kNvwEo7L-T&_nc_oc=Adq19_4mQ5jWd3Rig2vNjQRf4yAtiKxb8kKrtuhrovY2OvRp_TxtfYpCsRJd5zz1rJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAre7bCZx5fb1bD3KcnlCAHlwiEwpvPb5trn9MqZa4Xgw&oe=6A6B52CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwMlODWEd4Q7kNvwG2U2CD&_nc_oc=AdoYFo6gEwQQMropwMRnMZEFrN18FuJAsv3ILZdfgDmCmgSL61aSfkfxCL5aO2g4KTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsebO4Lb1AcjsRAH3EISX01w_SbVZN4ykZ8DcdZRx6gg&oe=6A6B48B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySiKW0ze1QQ7kNvwFHgymt&_nc_oc=AdpBRBZ5p75xs_QF5TTPc936sSE7EkFCrdSCqT3cDmYr_Op3quhzQAPnctjxkG1N6M0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTI_CYcsyBDxVN2rpP9rhUX57lEQCLupJompgObA9hqg&oe=6A6B4189"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6BU1REw95AQ7kNvwHeUuoP&_nc_oc=Adqv7gYQKNz-4rcfuwLkLU25AzEjg3UmKM7Ttnh5KvRU-LTTK9-ZVvciMJiOu4pQHX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAkqQUN3Kid0rGhDbtn_Vwg8yJcdFpwy7yk7Nldw970g&oe=6A6B457E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXLO4RQv42gQ7kNvwF62d8Y&_nc_oc=Ado8xC8O37MoyIvDmAGLn-CyTqB5V-QdLOMwKdNq6EviIJ64CMYVaNBBek56YrbENLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY0av_awMDAREdrisgaJkJdHDNO_dlSIE4aeMj1mLgSA&oe=6A6B55EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
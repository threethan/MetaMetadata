0f&oh=00_Af-Xm54M44HgfGpTySv7hZYar59EiU5CCsAztsxcaIybBw&oe=6A3408A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh8O4LRfFZUQ7kNvwH-YXAJ&_nc_oc=AdoNhXQo83ZPfQqfggXd7zEJTwxCDcFCzvkwcTUhxGPpXm9vOxfAUndgO0h20JoSAIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UMPvNsiTnOkVHEEeIbJL2Ckvdt5A3T2Fejy_tgItaxQ&oe=6A33F3CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11KsPisvlI8Q7kNvwFJJdgn&_nc_oc=AdrFCgE5rxFUs_SydJ4Fp6yKPFdyMvhWI7GOcXdxb36ZWxk0O8d0WP5IY0mzc-q9uS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xaYk3csC2YSot0SJ_9DdsYP0hUOq3ONTxCgSxYp1Z1w&oe=6A33E9B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5oS1AA0myAQ7kNvwFD30fs&_nc_oc=Adpqh1qxZtD2WTCEgma8YIcZ3mi8YPsGj6TWZLgqBWWtCwMDxGiFlvvkyVrnVKUpjt0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mL-T9gUdTA6vOmek1H6q5nUNa9Xj6Vifiho3d1sxwaw&oe=6A341AC9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnHpaBx_WLcQ7kNvwGQJobh&_nc_oc=Adp9El7J15g42qYTxsRzxiYfRBo3lwyzDiHplUzfi88vGBUE3tm-tBahG95pUT0AWZw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6Tn7Yu1CTJ2n9D9YnnC7qCmAJCT6nLA8HnuaHCpAHQw&oe=6A341EBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhZnK9z6Nc8Q7kNvwFZPt6_&_nc_oc=AdqERJhqjUyaq3dTO60ICyMXue1opBGIcK6uuiuMw1jU8gd5GOr5W0EdBQHdyeLb7co&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qKzunq_64wF0tuHAPYBppYU1v_mU_YcrhHl5wMSVGnw&oe=6A33F6EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
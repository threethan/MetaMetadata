0f&oh=00_Af1nQZKwt09NqOKiXLBsQAqMXtxm6hw1Lq7-tsab8-oB0g&oe=69E24BA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KmXoN14CWsQ7kNvwFOqcr0&_nc_oc=Adpwp00Vd2oOeqdvNCqKhISe6Xj9PJf8RYfwPUhVRUgToODC98DbHOFvsO4STSzHyj0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08ry0S4p3iQ0z3S1QwHEzM7zJ15Mu5lIMXqk_owZDSoA&oe=69E236CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96zKIVqLgXwQ7kNvwFt7HXJ&_nc_oc=Adrmdbx0Tt4e7KwUjXv3-IDohb1XlJnaXFgKCROHxKAij9PHH5Zll2-qZI3150QZiOE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L9qdUM4GWljXoxnwSb87y5TDwr5WiB2-0PTIzIhi3Jg&oe=69E22CB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl4wL3KgA3IQ7kNvwF2AP3d&_nc_oc=AdoDr4xiuVl2T1pZG8J121qIqrvbFl8lUdiXEUIM4-2Sa8b_UIrqBz7mYMedRfPrx_4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0up02d7gIIouUtEL2jkMScdb8drASlensyyI7joOL40w&oe=69E22589"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EyMhuX9p1cQ7kNvwEDQK0N&_nc_oc=AdozjYess1iAFrSEfC-2WMIqc-5FzBwFE_XW6juU6b3SVW2CWLZJa2usstYXMvdNPDY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FDEKOTHTE3npSmcqg3UgjM4Dj7_av-mqyj9m5IafZSg&oe=69E2297E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOo58flayD8Q7kNvwFq7PDL&_nc_oc=AdpOFjOViHJNx4CLf5NOISHH0mCqW4AHn-ejZJiXXU73-s6Pj61cf0_kMxb0_SyEMXY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OEZPsqwEkWO8hS_91F0KkCVd2PtIMcuGUCW4hTiitbw&oe=69E239EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
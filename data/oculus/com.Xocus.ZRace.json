0f&oh=00_Af6bnv3fEiCXAM6fJxvbzodd8u00oId0UaV-enu2Codo3g&oe=6A107021"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHSsx46X08EQ7kNvwHHMB3z&_nc_oc=AdoWNs4EvzkITUomubHVKvgJ7kgjt8byu2fu5Md_r6rxixPYDwV7iYzUPj8wpmAoiy8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66djzKW3aEuqG4vmbhO0K6QmAkiuqQrzQ47T2FRrDpqg&oe=6A105B4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdr66fvmzjcQ7kNvwHT-zWz&_nc_oc=AdpU4BkM6e3ZZVGA3_-CJFcLO1PMlYSgkmKkrRZy_9zQlqFtC52IOwzV4cHNMea9TsQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RbmDA6EQgh99Ycey4BEM6zWS178L-PSmQvxa1kwQ1Yg&oe=6A105131"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItSxnwb1lVoQ7kNvwEl3djE&_nc_oc=AdqEGqEvpUncHLFm-1ITpwkXfgaJKvu6rdJQYce7vPs3SdbgmxUdTKbJjUKPv1lNkIA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hiQsusIVRKdPucNzoyV6j3AIctQ7pWMJDcFmySdie7A&oe=6A104A09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZmLlL93TPAQ7kNvwHjxF-4&_nc_oc=AdqACrFLN-ukoWKgr3FTCuf8YKCIEKjZ4OZSK2b2DyL7iumtkI0Q50GklydOLOFW5ts&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t5nwvL4p358XSbDouwPp6NJAzhNhXV3FqnftNbNZqEg&oe=6A104DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN3jMUynvNoQ7kNvwEypCsA&_nc_oc=AdqsK9E2OvsHOMp-1z1hmNLoVTeLFsLflvU9mq3B9GXgqN42HGG59SUzuxiqFIRH_dA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X0F7-hd8F4OfXRKDAoBuJd0K0AVtuf46ibJTNQ148HA&oe=6A105E6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
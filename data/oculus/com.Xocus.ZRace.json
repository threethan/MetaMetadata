0f&oh=00_Af1hPYr0lTAITxZIUXCy54iSZjWE7Houd1V0rWadqa-MYA&oe=69EA34A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSzLCRfASzQQ7kNvwF2FQXV&_nc_oc=AdpompKCOYUkGeFES29WaGtIyXKUQHoeKwFKM3K1MNTBi7fobY6Fc4H1yWCtOjXre54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uNwHMMorMz2iAVIQUpQmgmFlT5wW_JhiaSgShjEJsow&oe=69EA1FCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khce3wDac8oQ7kNvwHK1Ja5&_nc_oc=AdoE_eZnFrxQAxtTHwbsZWgeWhYF3wQF8d6pbh6JnXkV62nHYx2y6TkXVar1Nt-2tro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ld3u_XA0n04WzFKT5j79r9ZP5GBOZBCJUw5d0JOlJOQ&oe=69EA15B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkBNr7JgK-sQ7kNvwFkMwbG&_nc_oc=Adqlsav274TMoMTPGd2R6qV_2FOn4b09O2Zl5C-aLyD3McOM_YzoJjZ1VCzRAxGXKQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E2HumrVAYKCZTLkluWZElYr9Z8pixpszgc6S62N6s9w&oe=69EA0E89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxFSB7IIJcwQ7kNvwGZJvHx&_nc_oc=AdpqtwrxATNBycDsJs5qjQ42Ew9iTYd9sD62Qqd-uazQRHVeC0TioyQgID1h8qoVTRQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h94UIMeSTgk7_qCoh0HdcMySNUmMH06XS_GgAEIijYQ&oe=69EA127E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjnw9UYbByoQ7kNvwESAVKU&_nc_oc=AdoujuzLE8QtslASpHzPv86UI_9r6fc-5Zez5IsIr-ky4Ucmj77FVydqFYI77YYskog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OEg3qnqDjDsskPqSgXkyQ_K6C2Qpj0Q278gXfcoSGcQ&oe=69EA22EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af-qeh6i3AAw8MOniSZl8YCdLg7wV-dvv5A75v9fe-klwQ&oe=6A258821"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w6xjiqO8OAQ7kNvwGPpHXg&_nc_oc=Adp81ssIUw-IvdZdvWvjkIl2QmR7JNhwwNpzhfV3DmsPU3Kjk6XRc6kivC4kIHaRkw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9voGsgTpz5Iw85J7ABu1vp3ZYJYd-ePBCPCnzOPZeJA&oe=6A25734C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2viynwf-FMQ7kNvwHCFUdM&_nc_oc=AdrM3VH_9EvcgeDcxdHHuGm4ZpGJxxNC7MG7EF13LBsJwBA9ODJw_adn-97pgp0cmfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KQ8aQ_FXskivYusgyo_11i0Fvc5a5Gg2tGLiUm_zGgw&oe=6A25A171"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kryh_zVEMNYQ7kNvwG6F14H&_nc_oc=AdotddxcCfwXzOYFuryE95tHaH2AkSylWf_2x2pdlY2OOFsJDXgDie0UL9iXlzP6WHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w8lMUGaPtNbxdw-s2nTxhPQim9LFUHDnhSX0YAL6eSQ&oe=6A259A49"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgoNp1V_0I8Q7kNvwEHZgdy&_nc_oc=Adq20U9PA2yFFrm4F00DJLTQoM27lSOaAM1otGXi8TDoiarZTe9AoFHTXh9qVdBn3BA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DTQpl2OQOnmSIYxmXbYEsyzouPadtMWu7lDlVKuV8VA&oe=6A259E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0jIpRrt2-8Q7kNvwGJr9Eg&_nc_oc=AdrLNXRf5GdRFs0LgOGLLTwoapksheCJy4Mfso2qDpOhZNuutrQicBByOoM7ILtb4ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85lkTxOGP7NDndr9kWXWZVgb9xY6y5yXKdMwsAsjR3FQ&oe=6A25766A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
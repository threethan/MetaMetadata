0f&oh=00_AQHtQ02yYIVuYpBtl6Og0dFLQos118mdSM1OU_uEh3j7PA&oe=6A79E821"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMzLvLafGvkQ7kNvwEnxCdA&_nc_oc=Adpsa6-6O7bEZKv5RkIFEZ8UZcAICyKXyxU2qD5eGZCt4EuyerTfo94mxgscXz4ZzXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx8MCDqF1N_VB3tGEAaFsKVXrWAIEpiGM7IjZZJKg-WQ&oe=6A79D34C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgWO5BeNbvEQ7kNvwF63o9z&_nc_oc=AdqtsdM2rY1Z9nzUI6fTY_b7bEy5RQbe1nAe8ypIkm2Q8M0ElHi4awDZvjBAQ4U7PqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN7W8agtjq5lQd8AfPi8Vzw50n0VYBVflMQlhZCSaADA&oe=6A79C931"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agex1TiI7dkQ7kNvwFs5Emp&_nc_oc=AdrN8hqk_N4SvdrmWMP09spKsJW1CGmN5qWteH0E4HDMamjLuBD0H-n-gT6tbGnsI-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJytY0MRAATcmPMhFAAlkTQb3Z1QfZqyHoJL3ccF7PzA&oe=6A79C209"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbAEHXFYEnwQ7kNvwHJ7CeM&_nc_oc=Adr-QtbyY1HdrCRnth-J8gPD4jKVa7ctfsurj3Ot6JdmV-IiXyvKVIwDtXi1Fzs3Mmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyoOhcbEBeZd8BpxJxxPbEW7PkQ8GwIEjz6LkS_cI1iQ&oe=6A79C5FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziS9t1VyTEIQ7kNvwG3JTcC&_nc_oc=AdpO5zoQyw_00o-dV1jdOKE3YoolzKa57aqgazaas_EdwR3YpffQs4s2tgav3Ps2yf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpliRIa3iproEvU8p7dic6SvoPbofJOwisHh57hdM1wQ&oe=6A79D66A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
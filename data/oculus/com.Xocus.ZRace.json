0f&oh=00_AQF4uXZNE4118VcWTc-2Qc6QqNZuS3l4xrPEOTWunTxP9g&oe=6A7896A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9I06PJKvuYQ7kNvwHZGLKm&_nc_oc=AdrFY35ixKF8rAJv2VXZrem5b71LpHcmN9mX6PnsGqw9fVkC_7dDfPCFYkLJ563a0bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXaudeirM4f3TT6IZsXVR4Sx2umQ-nD0a1-7VC5oEF0Q&oe=6A7881CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgWO5BeNbvEQ7kNvwEj1tMm&_nc_oc=AdocB7gad20-Jo2gc8c76ACF48Ii1lcxtD4QAkGldQo3OW5PQTB2FgQknWiABv7J-nU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOjhFPxPKAq6nFAW77alI5UJBFayMCzmotW2PVksptLg&oe=6A7877B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agex1TiI7dkQ7kNvwHUEpJt&_nc_oc=AdoLemcMwfuNHQ7BZ7q-Lscp8EN-zc-jkTpJo0vQbEQ7m1jhG1mXSuKQAwx2YZWq5P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGhqFCcwEgSQa_PGYliugdoherAKGfc0xA7azwUR8cVQ&oe=6A787089"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbAEHXFYEnwQ7kNvwFbIYkr&_nc_oc=AdohjxckGYnlyreA2_UHI3jTZKef2nvKXZ82JzaU11G_lJMzS0bM7uMHtB8kNuoAvsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcbGQQ3ShCCCqww5HqC8imVM10Vl3bVfkclSQ1QaPuUQ&oe=6A78747E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziS9t1VyTEIQ7kNvwErtikV&_nc_oc=AdqYGp7ozLLS3mqiqizBhxAtkqUprfW4QwcipjCXK01jM8tSGSpT7XhhYka_fgy6duQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8lpyrwR9wojpJTb7y_dS5b-4Uu4OEGALq2m8YorZQzA&oe=6A7884EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
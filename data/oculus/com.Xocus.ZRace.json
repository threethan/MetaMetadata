0f&oh=00_Af0hlLCArmZUnQUF1P00BpcAG7MZiewWR-XaoWT6hOBgTg&oe=69F61221"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-66MVGwBm0Q7kNvwG4R89F&_nc_oc=Adqo9dN0fe9pebyMWVVpynHYc1SDU2R271c4LT018AjAdEL_g4qwBeWaMhgF0Sy8Mr4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RUG8TSmFn5zjSpPNm5nOnbc2LOCipvwbuM7zF9Ij8ZA&oe=69F5FD4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXoqJnQopvcQ7kNvwEe-4Wr&_nc_oc=AdqXpXWswlpjRVzsHNbzYc3HieRSbPUMg9Db967j6nrsrunKiG_M_9a5IYP6aKWxUvQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xl_KJtRZZSCFqBHZCMQSVYcFtA-TwRLiMNt4-AWfqcQ&oe=69F5F331"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wky5S93jchoQ7kNvwGvHXwH&_nc_oc=AdoXJW7-cv2kgUfzg0zmTF6gb4CJ63sRnzgzM0DUd7s8r8wESTHO_iawx8WRoR25w0Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34aziaPj6X83Aj_tbslXbFJrsqVuRpURAtL2WaPmI4Zw&oe=69F5EC09"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1XDvpHKip0Q7kNvwH731jy&_nc_oc=Adp2aMcq_Vp7AGf_GF81TWl2eHs6Pdf2BHSNxusF7n_JHLrAR6DF2GiGQGcPrcdv_Q8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OVKJevk0B0wJRMoc7h1hiaLkjI9SGsiR9VWyGofAUhg&oe=69F5EFFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXHYYcBZ3dQQ7kNvwGSWtA5&_nc_oc=AdrTwsRGhjMHlcSm6UWB-yLeaop8OjeNeB1CkJQbTUlQJliH3ltkDirH3mTDLylZwHM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0g80kd1gl5U6OLTMwNXfxhjg5hDrwk8SDXzkQ4MNjBkg&oe=69F6006A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
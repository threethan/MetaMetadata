0f&oh=00_Af6UKUDSP4peiDTbD11bTtkfkIgwAlfldZ2yMmOjDwd7zQ&oe=69FB5821"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3pv_7cqkwIQ7kNvwGbQido&_nc_oc=AdpWIwd8RL8YJUdMYsvoKL1xNVpza2IsujJdnRTJojmqE7P2M11RAhi0TpyluKDjnD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nKQPFiCo43ZK0F_8tYpF26SG4RRpc7sbYSoPz6IWXLQ&oe=69FB434C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inh0guPvhHEQ7kNvwFZy1eJ&_nc_oc=AdqnvuFHxhsIrn5IHqrReaVgKALTphseyojr1L5SGvhqG9E0_izzRD9RpzOYrp4uPhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uK8TizTJNSEzQFXksj9JuYp3w0RpVt5o06RpKBjbCdw&oe=69FB3931"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqZQynkefJcQ7kNvwFzXt5-&_nc_oc=AdrMgQ2IlBXqze1Cb9wG9yBa1wcquKVShd-SypPXTqn1UnrFPy6seZGpU8dLYuRZb-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BDfXIxcbSFSZ77dSuPmJc8zqhGGJhC2B5iiy523lh1g&oe=69FB3209"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYhaCx3koFkQ7kNvwFKjpFQ&_nc_oc=AdqUd37z29iRa-fKIWkGmlslkjWtUIKxlpZZYy9g08euWIFEMdotOxOH-rOpQprDsPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CHHvh7sh3VNROxbHsKMq8LoVfUpjZmjcQU3W2w4MYDQ&oe=69FB35FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op6_BCVl8LAQ7kNvwElD0gQ&_nc_oc=AdpdK-VuH3h4cYZ4mQh4KMgbIoSc1JmoFfOU7z7yrvo5kMvS4MPXb1lbs6b7UnPjBZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tSrHBO2KpDsLqflhkfw7hrHdd5cZ4IyIIneAvOZ1qTg&oe=69FB466A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
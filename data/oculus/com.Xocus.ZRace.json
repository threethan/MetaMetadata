0f&oh=00_AQB0bikhxw8-muTwZ4oWlSqJ9yn_bhcvSg8llMn8Lpl6aA&oe=6A5F51E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rWKHKflfgIQ7kNvwG1leT1&_nc_oc=AdqkJA202eZ1alP4T31bv8GudvuXMlub-k8OIMxsStZBVtrEBhSqe50lM0RQjg0GQ_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCap94EFu_kgjRzn3Lp7534D5giYigFqc6JAmXUzLEWbw&oe=6A5F754C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR9P52xEpM0Q7kNvwGNGQLo&_nc_oc=Ado_vQR4VAWKDYjBrLhQg5wEkwA2_prBKIfAPjCZZN6LMDfX2mpfwmWROhZQYzpkAF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdZCmI5rJ1gQowXjP0zh-5h_yVfzjIeM6ZiVLJjpHusw&oe=6A5F6B31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSa9fohFNkIQ7kNvwHkTXiN&_nc_oc=Adq8SyZr0rjttz1ZzY0XAZOaEkQIQQaiGu5YfyNariQljleTpmVNB3BuRPWa_rHIgdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW9Rg-RTlY1v4sPGciczDypUzfh_680D0WhJkxckCC2Q&oe=6A5F6409"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rimSgO7ylK4Q7kNvwEEe0w-&_nc_oc=AdppyPvzrRi66dGCaL-nXjV6c5_jDzoB5XLJvJdw9DfSeGy51GGElKG-B3eCDslaOKY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSPcte_6OkpymajKVwsnlFk8WDuosjNwFOr-41Pnigzw&oe=6A5F67FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRcDuZ3VRUcQ7kNvwH-V7eG&_nc_oc=AdqpeSZKczntEySUNUzg10Ba0nixF0ZFYkPJxcSCR0bxHsFJcSN_A8vwl8IkdFKTTx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOzxsOwlzfecdMChqTdKdb8EfBHC6WfWVGhkh9w3DMTQ&oe=6A5F786A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_AfxHa3Ye4HaQVYKyDf84py5mBD4XKKRdxr40THFXkYgZ_w&oe=69C3C0E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pMfREwNMV0Q7kNvwHBjtqH&_nc_oc=AdpmH0OuGALuy1UYpZy1HVEWpx-ZSeYdHAm5q51SKbhCjlkbTjcwiVJ4DHiPPvWkRZw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0yB8-gcJfoB_WlSODSmLI_-8xVL9uKxL7_OZBea4bOw&oe=69C3E44C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISQvTfRJ3BQQ7kNvwEJjDQ-&_nc_oc=AdqXHkAtkAmEU2_hQHDtRMW6WP5krDFzVsFJmWooumyOKkMRdcJgEzCGw6gZDckSQLI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTyN_K22exW9veSDi1CMVsx9ktaOgOVoac9fYIOb1C1A&oe=69C3DA31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnIKwKCtfVUQ7kNvwGsY-y1&_nc_oc=AdrxeQXT0gilxNdfHjzTHR8rVcBUiglvSAjHyzZPCRiiKau-HI5gR1rW_jdfuJUGmS4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNRkAcrx_JqVrPqBVSON66E1HvYH2eWF1I__f1C-7a5Q&oe=69C3D309"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8E7dJekVZoQ7kNvwHVxpL7&_nc_oc=Adq_UyEyYxjc0E0wT-B6TRyAh6wF1OA1JXfS6iSPalHooWKhKXRUMb8IO6PQI7dEs70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPJWgC_yEdZiXrOqhBTtZfRMjYyaNIXBxl3SZL93hgNQ&oe=69C3D6FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evoc8C6f764Q7kNvwHI3FLj&_nc_oc=AdqGSalkshnjd2ctfPQF2r89L79VvJIV2b2TBRddBA2W3pQ0qdr38KnwJCnaARtSgM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI19eRyEpspScZZkTzaevmS27-dKOBpa_hqcHDgoOk3w&oe=69C3E76A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
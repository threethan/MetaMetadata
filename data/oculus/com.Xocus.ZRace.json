0f&oh=00_Af3NgI03UF-E-pQZOChp5EHxN_UE5JfzZq2655s95JymYQ&oe=69F36F21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-66MVGwBm0Q7kNvwGVODIN&_nc_oc=AdqrHR1EhIWE0y3jZ_PKqF8yPKh_hP8jdCWMJLq7muhLOQ3kteu9TmAIiYYThq7d9do&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C050ZAllYE-YaA26J0fZFhAvAP95J1BUoXRq2eW5qTA&oe=69F35A4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHWC3uxMAR4Q7kNvwHjgZo3&_nc_oc=Adqshquhj7EwoWpgWVIzzl3tMEzInCpnkXi4MPFPxzqR_yUIuyvXWcKu8yc26MzHg44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13bMvMGOLsekvPvSPLJBflNGqiHGpHjZHH042Zp_hesw&oe=69F35031"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoqB3Sq1OFYQ7kNvwH5zmW8&_nc_oc=AdouHeF3PtGsmULa2FJGgO3MciVi4RinTUWv_YqSKANfPh5VM6VUtRmVuiVhqfkv0uw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Ef43Wu-Bvi6wp47ILgiaJMw5tEX6CO8xiYXaK3lwNqA&oe=69F34909"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZYQ_64zOgYQ7kNvwG7PPif&_nc_oc=AdqYDjqmCLEIo1rTq0ppyVIZ0OuRf0ONvlZ6onLYPjbrNQBz2fb6EaXLq1hStX9FeaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1j7QsLyCpZMM7OYmliPq3rNXUJgJltzqlGLeKiebQ9mw&oe=69F34CFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt3NfwmYV-EQ7kNvwHcdOrb&_nc_oc=AdpXlOww3qELJLtoyr7K49WOaxyoQi1CenTVcXelP4hJcnjlrIPSI_ab1ffFJ0AvyxA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01EHP2-e55tStWiONwROAUKr14-OQtFWIEBc5nZSohPw&oe=69F35D6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
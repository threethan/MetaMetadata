0f&oh=00_Af5XW-RwiFbObSTVRdfBFRVWEKsnQ__aqr0dh6_fj-1QYg&oe=6A01EFA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMtKzxWzFo0Q7kNvwEGsAks&_nc_oc=Adp5hHAiskCsvobsR_GEBDsvu0vA4LYersKcu-zCKy1R2S7zJdzRLKUZc1SWBjEBn-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G6GB8vqBvVtThZJDDSKfTCnJpUberiRt7rQUfgaJ7rA&oe=6A01DACC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWZsslsj7lkQ7kNvwGvwyhn&_nc_oc=AdqHI8DFALPZWIx8GBsxA-d6Efjnm0pImGSH9aqCEM6o4ZXWdYk8lzdby--pZ_T9ITY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51TaVff5PXCwPN9Oze_vFjXU7Jm0xJKzdcPf0ibbjvaw&oe=6A01D0B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxDfnGzZyv8Q7kNvwFlEHYC&_nc_oc=Adou0v2ydKtchkFh3yZILd12vgAKALttkpL9XiE7M4nO4k6sIVDF6CVY_UaZSsI4pEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LKpgFMBvKd2rwJftOsvKx0ZOTrgIZtZnSq5aPlHl7fw&oe=6A01C989"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRGmPbKxasoQ7kNvwGo--rx&_nc_oc=AdqLiggHF2MJsmUNfsW44o229bOPMdzb-1eh6-wOWEzWQ67MIOojWhKyr0LjQywis1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jlC1WkTwFkOfB00MsWuPDe57t4CFg7ChNRpRl4a2Uuw&oe=6A01CD7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBuWrET0z_AQ7kNvwFR2sWd&_nc_oc=AdpzQ136q6v0ri2wG5SU8-D-iv7DWOP1kIlrVXj2X1sMyPb2vlKcdJP8hfsIn1mV_dU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sRv9zYdfLpPLPBGJEfzBjgVwe_LFdX_zKdbCVbOnSaw&oe=6A01DDEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
(2).png", "id": "558223238724271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PexlaQ8srZ4Q7kNvwEGGg_p&_nc_oc=AdldeaK3eGDTbH5A7bAITY2gvrYSg4TMQco23vFRi3uWUmpXGRcgg4I_y7NK0nQLyP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXUpLrannpD73KyE8uQOX_oedscSajzhQUh_3FjnYbRg&oe=69B563CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L3--IFg4usQ7kNvwH4JmDH&_nc_oc=AdmRX9g1tnl6mz1xuwYuMB7Zt_D6wxc9nhkU7888wSmZfuQ9o0vF_Gh10REUL48n5tY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXveFbEbjMcu0NIoq0ujQ_0SDZSud2JwIRyyj5q0NQrQ&oe=69B559B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSYqDdYZFtkQ7kNvwGvcZuT&_nc_oc=AdklX2mZUSb6-0dpAgVIY35y8D6F3tGacOeKrUxQdzA7Kngc9gZuJvTeDmo5jEqstjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYiSSh91ig-clRgCgP5mWUquhn-t67JioVnG-N5RwHvQ&oe=69B55289"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRn7KD39pzoQ7kNvwELPWRH&_nc_oc=Adn5ExNjLc2IMpEV7rBUh7vT-hS5QY5KFsSkEWFxFdf_KMwnuAspY-9rSxQdfyOOpWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoeiFM7RlFDG6Jx5rNrCTWSubCiV22Eps8mN90Ww1fnA&oe=69B5567E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKjK3NsyEZ0Q7kNvwH-khA0&_nc_oc=AdlDD6UT6gAdy1hRdNWyUeAg4yTiDEgWkYVuGxEOkJyC_pjcyIeWOJOnRP64DXBkYXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPrn_MfGjK9igftCsRQxxj9uEdLKRxeoyKoD5rY28kCg&oe=69B566EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"
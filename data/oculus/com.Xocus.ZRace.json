0f&oh=00_Af5aqDMxQAp8UD540VDlKzYwHX5efzWifBuHCON2nvTC_w&oe=6A1C4DA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gznVcbaOzTgQ7kNvwFU31oo&_nc_oc=Ado4YzQFNEiBnWyyzjlH8RXOVrmC-nvn3yYAogKWiSGRYBBonQIg53a2ODdrO5RFL2s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pM-2I_fa2fhaK_TSHCNixmIAjrJEpEIK02W7Hf0dWlQ&oe=6A1C38CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1qTeAu62t0Q7kNvwFi23yM&_nc_oc=AdrDe5tq39Y-16n-77e0ps5v9FD4BwtyA-I1QufLnPfcacF81xsNWVkCCV6ppt_QKpo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lrlM0-8jOrvgedoOzqN0XwuJJk4F-8BYIDNF9KijlVA&oe=6A1C2EB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOBT8vDhTJ0Q7kNvwGXqaNb&_nc_oc=AdoDBbueijD0sobUUOgZJC3sHsqyIKjaNrB8okoVwvaE7C-nFiuDcgrLoxfUg1mN89s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BNgP7xGIo1VlbgtDJIX84c3jNXNnVKgz2CVHTVyybhA&oe=6A1C5FC9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8IzxEYvxJ4Q7kNvwF6SROF&_nc_oc=AdrMfkp9WD65mi_xBT_3ow_wPtUEC9pS7ghE3Bf4fyCRvfeVKJqz_hZy-HsCojADjCc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r-s6N3mjHDnmpoQjlbh7BvNtwwS6Q0nz7KPwiuGqcGQ&oe=6A1C2B7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q7qMwqrKQ0Q7kNvwFHD_nt&_nc_oc=AdqevueKelRu7ERQOm7vUkp4WluC4YzTowyPvFVnq6FvTUtpTnymqu3JWDVeCRNrUoY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MgbS_oE2HsxhLFHKAaTvqH-MMRt9YWZ_tdZt_udr7mg&oe=6A1C3BEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af9XORUuPzfvdc-y1AjyZwppxk9OciY8upAP05XmnMSuJg&oe=6A452C21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oiy8VsdxgLUQ7kNvwFIOsuC&_nc_oc=Adrpmp9wKCKE13d_PJA4Wpa7ZCjsdx1EDGUxteJsBcrtCMmlOaa06dZLJ_dqcQ3EYMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WVfGWvKypSDPLGk76tPTZ6KxrXK7I_vl1rJAmoXQwGw&oe=6A45174C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5LOAghE80AQ7kNvwFOlR4Y&_nc_oc=AdrrVs37HygjOudb0-QTZLhD1cW0KSdm3jGOlLjyFgp41wu0-tEgHgcJKkP9iv0e8ZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CbX9nzlkqi_7g4WHiS-wyKEWREM4XRqnMqNFg0a9TRA&oe=6A450D31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUb6h2pSBOgQ7kNvwG_bTNG&_nc_oc=AdpTrxBE0Cx7vXyWmzeXfsZiUZ_zSCmPZDKrSpmIHfJoaWJZHxObp2W2YIjuI9bcSjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90KKNkfoOtJZB_n_jjthRMvL10TLfsUc3o29gUoJPpPw&oe=6A450609"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB6CPPx4Zg4Q7kNvwGgFyG_&_nc_oc=AdotdcWxigEb3vkMmNz6K52zh_0IC7ooAHRGPjpp8ihTZYMLuVxdfQ9cRuzNILFtZHs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cwL1uRsWD5Zpc94iGLWkE9O1z04z9M8eCYTBZJiOGHw&oe=6A4509FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNWKlCpu0jAQ7kNvwFyqqib&_nc_oc=Adq1vcqMxXcxQHRgEy8QwZtJrdilJ0BZG8y-6ZIcOMMzvAzVp902O_RHGw14ApUfIms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QdKjhTNXMv6qraUe8b6Ddtl_MhfrvlPgRTE3KGmuB-w&oe=6A451A6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
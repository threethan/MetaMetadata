0f&oh=00_Af7F_kWxMtxTNknqRB0IxWugNCbIim8N56492Oif9oBP3g&oe=69FF4CA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMtKzxWzFo0Q7kNvwEsmU_f&_nc_oc=AdrWcreJxlD0aW5R87cSxEI7aklwawOs33zHHrlcUHzj1gKEmgSlR8GNAn5hwhyL3QQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rPDkIdmg139bPYC4F3nO34jBDwUgi8yv4OHettaRvQQ&oe=69FF37CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVI8L2H8hcMQ7kNvwEPDy4i&_nc_oc=AdowlFpU58LK8clXcsxp91rOgpAIpkm2a0Ckm0NQQ7P_gQ2Z0w2yO5LIHog6gK2_jew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M2e3ZBibUR4a8VZvTkHWMX-oGdGiv3Dc_zdAHbz-G1Q&oe=69FF2DB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XsHFFBjZjIQ7kNvwFDkLX1&_nc_oc=AdoGUj9dEyPDh7RvIf7vrdqSOOMbmN8XBOheMatC4Hmve6FCF7aVBtHY5-_B3V4uhLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y66Mfe8rhmnZN3SR1ZpNapIfUujo2HSc4gr3f7dVyiA&oe=69FF2689"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krs-LypSBm0Q7kNvwHCroid&_nc_oc=Adp_0m4PNB37hcwpfnHy8l_kZPo2_t6V9cOSN0xr6amvJbWMOeXhFrg6q8Y3znEK_FM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I5p2eivQNl5BVpiVtSKLrvMPrEPgA6nfZP_E1KQuFEg&oe=69FF2A7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWfINyhq0KAQ7kNvwELpepk&_nc_oc=Adqu8vYqYEsO8Qd4zsbqvjq_xxl6E67BtPB6-P-NIXHwpehkBcRyawgoYkB0yOFXg4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e1BUHd9ps2HPF5NhtEg7ihXhMbiCscKhLXXfgZFyyCg&oe=69FF3AEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
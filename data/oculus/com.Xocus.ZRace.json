0f&oh=00_Af1EjKEqgAtrx2j_DYPOYI9-ysipiSamCwCDUD6rYjJ4kQ&oe=69EB8621"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4soTY0x0fwQ7kNvwEu_ySJ&_nc_oc=AdrviJl45RNH1EEfHGKXc7leXCWyXaHQXmaitWMcs6crpyhihpjuEOjQTQKXVhgMCSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HXtCTUZQsFUGZyVh1OJ2Vs5XyNEhcN8onqwgSGGbMOQ&oe=69EB714C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khce3wDac8oQ7kNvwFyiAmX&_nc_oc=AdpOeERzB525bshICzKNCUEOIhR3jvkAsAc7x93Yd7CEH7ndUCwzRHmjzMBRKRZPhrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0My4DcHxeZuNiF2JtgquRF2Zl8ZKqTmAREN9AvcaxiWg&oe=69EB6731"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkBNr7JgK-sQ7kNvwHlhwb2&_nc_oc=AdqU5pfVM4t5qqkNiUT5ahczGObqTUik38RdjRmyUWZDqGwAJuWi_H4dF1mf5eaEgco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L_6fFnj5ufE08mw2ec6oJQy9dfHNrewX850fWUSDvIw&oe=69EB6009"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxFSB7IIJcwQ7kNvwHkSKpx&_nc_oc=AdryV0ykCTA1FS0gqlSmOuygNSqoDQQNCUJlsfk_dyo4F6LrMh5ddnNFEu-WCGp12fU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FDxXzo5gFM2FXLTkZxH9yRNllz_PJCo-xv5pXnweCeg&oe=69EB63FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjnw9UYbByoQ7kNvwF4_KJr&_nc_oc=AdrUza5lRYAP2ccGnPzOyCngSdYhztygzLoqQjNCWnfqAYYkz9GXVCw04A0xbbCKJ6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z9HPO20AKm2S2hVZ5d4YQvMbgas8vbq2Pk8fAXu7GIw&oe=69EB746A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af-aKECjMXFvg-3SIHVcW5QMzdj0oWbVelDdRlmGPjir1A&oe=6A32B721"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh8O4LRfFZUQ7kNvwHLsS0O&_nc_oc=AdpaqNBRnncwBw3LLJmK3jBdBTK1s2DOl22vvmPkGyqKuLlHmJk-cWAHyZ5oQ1tz2SA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfO8I_YgnUld7RZlOYEFdIrR-QQZ4vgR1C5_qWIJe4g&oe=6A32A24C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcantI082gQ7kNvwFynaen&_nc_oc=Adox0GgLXcI4nk_hOwZIXnU3RcmCoI5bOjpq6ZQgqQP-j8JVPIg8_YTcABmYfuMqs-s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cwcg_b4U6-OydTZdQ_zKIRzutSS9yLmEmMNZQ6Cgw6w&oe=6A329831"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5oS1AA0myAQ7kNvwG8LQhr&_nc_oc=Adqi93yqzL-Ngsnb5gpVdcRbuNA6orsOGwNYjI8cmiqY5CM3w0CaHVCOrFVjCzbYX_0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NdhLis4SsJxkW7QYspHbC_WpgLK7gVKvOiuNK8vBMGw&oe=6A329109"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnHpaBx_WLcQ7kNvwGDukRV&_nc_oc=AdqhwmUa0wmHmpQGFySf95gfGprmUK8w808DE65qf7ZlVE0RcZFyef__LcKVLzXWUkc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W0jbONjBLgwmpQsT6iUPDLEIznbdDruE4QlQLCVSxMA&oe=6A3294FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhZnK9z6Nc8Q7kNvwHMcvxO&_nc_oc=Adr6gC3nnw52qDctLVrEvvbzoq-64G413r0oGvY9NtP5ymzLvTRDwdM7LPEhvq2wx6U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oMBGOEoI_2_Pfu-MFz5Y3RORm2zIVngGEXhdtnbwwtA&oe=6A32A56A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
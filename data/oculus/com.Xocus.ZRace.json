0f&oh=00_Af_75YRxR7twEipxXxmq-hgwHaZXkLCsgnqSpfoqdZwDyQ&oe=6A43DAA1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oiy8VsdxgLUQ7kNvwFnRLLa&_nc_oc=Adrwmznycuy1xuve_anBazu630VCvqHqHWxb-t3ddbXQwlt656pF30KOvZyHHGDN1yE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXhoxw8iCL7pHQi0Ir7d4BJNZFf-YCBZ7jUw_KnWmnw&oe=6A43C5CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5LOAghE80AQ7kNvwGMoEZs&_nc_oc=Ado_xkzS6UM8Z6o0jxaJ9V7E6XPdcZE_E_3dcfc87skTRlk9I4LpYiwO9-GZrjn_Lok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k9ODxCHW5TRnEiTEJ4xIh9nD6AlX3EggpEiK8WGjZIQ&oe=6A43BBB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ndZnNq2TYQ7kNvwGDcS9z&_nc_oc=AdrXOyFC8s6KbZN847nZOdLo6-JvsqKHlh2Ve5DPq_idcB_BpT37sCMkHPOjqqKYZMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HXBiAwgmLV58Apx33zFcYpDqrRqSSB9_Qn158IRF08w&oe=6A43ECC9"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk9_yfxHN4kQ7kNvwGU3Rgk&_nc_oc=AdoZXUE8EfTKwGx8u_PokGNcFb5e2z0HJJZZbIG4kHV9zXM2gtGdkmDUsK2qt4TfCEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Aei37H-mg8Eo9qDsA_AuKv-a4PiEscthGG0kfKdGkwA&oe=6A43B87E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAc7Yfpoj50Q7kNvwFy-G92&_nc_oc=AdqE21kIMH2o3hkfA2B2CP_YKudOhy0tuuQxNrjrD17q0V0lWkawSGVOONTCgMjUsHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9khWSh9NurwbV37qvHmOYNiWe7s4ujvBvRlfsNex3DKA&oe=6A43C8EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
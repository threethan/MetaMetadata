0f&oh=00_Af2Pd-PDFfJ5n4CvGP8hxdfeH4j88k7wrmQIt0Un5XuVNQ&oe=69D635E1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsOZj6qiHDIQ7kNvwH4IOPx&_nc_oc=Adq_VZHgYJw8ZCrtNuqn6HmhPXR_vBJVTTbIMeg6T_wk8vRquDR0-IqYMwo4lwNUpsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TMDeZWW19oZixZPmP0yU-ONAn5LUhD3vZVHEV3DV6FQ&oe=69D6594C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcA2lK7qJnYQ7kNvwF18XMk&_nc_oc=Adp03mNoHp_njt9GRXdG7e9g3LrnUU5Wzs118gyaR_aMFyp7yCkUrXDj_RkOCWd28R8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gFMIf2Is1Sjr5yTF489DEDztpzLSBUnIHed3DCxQkiw&oe=69D64F31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fChBZZWpv2MQ7kNvwFqvPst&_nc_oc=Adq7XVmTe4orDOt_9aCLsBIJQH0lUtrtBak6gtm6HEAKtRL6_clK2hyBwuChn84wJT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af032OREsDL70fzXHKyxFvl5kdQ0gD9GCx_yb9OueaF8_g&oe=69D64809"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI_0rqaXhIQQ7kNvwH7l77O&_nc_oc=Adot2jwrTDuaLMA0FOTvdW9SfxyVZoz3V46U8RFtfB9OUtncgXMsNiJFD10dBxgEbsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K9EZyuUEA9R9v8Kmz3zzdVeEDvd3u4MbGM-nbb0QBQQ&oe=69D64BFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM-A9jIsFiEQ7kNvwGcxCr1&_nc_oc=AdplPPOcoEWiFNANh_KY3ROC-J7Cpy4J4BFjCTrcL7I7fJBBRSd3Dv2TmSTdcCdBTGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GLI5rU3jLi-dUHrb16KTHprYoFPZQQ2_n6XGrC5G4Ug&oe=69D65C6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
40520630425_6087658679729123006_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-7qtdYKVdUQ7kNvwHi2_Gs&_nc_oc=AdrepJ1gIpdfsgMidsBjFKvjQTBW3Ag19QJt6Wf23epukrgRtPIo_PFJGgTRy6tUUSw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQs_klEdJ7mmswhHHMOmm1oMfQnZnpm9jk3AHsYZn-OQ&oe=6AFB3625"}, {"file_name": "6.png", "id": "1622765504722709", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210890_1622765511389375_7039115814969934024_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za6QHbRLszcQ7kNvwHCGmGo&_nc_oc=Adre7xM_2st4C16iS-9GVfWTa7uU7whyWIQxw4Aq8KEEIt8Ynn8fwTFk4iI6lmcdVEo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBxfTx651qO39FyZ7BmsuifOUH1ka4VpoaxIKbo-KBCQ&oe=6AFB41C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover (1).png", "id": "169093589564357", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974777_169093596231023_3709466873424777856_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JYeYHUVQtAQ7kNvwE4nwF9&_nc_oc=Adq8IT_jCzYomObEQkz25GvtYb8DBB6Xly-mGCwgFTHPIReLHLnKgTRRVVVSZZJywCg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdFsPTX73m5stAYzofwJ2RCo2qnnSvtmuXSCA2kzABhA&oe=6AFB36A6"}, "display_name": "Z-Race", "keywords": [], "long_description": "Wanna have some fun? Join us! The most fun hand-racing VR game await you. Prepare to be immersed in a high-tech universe. Super fast racing ships and futuristic tracks make this game an unforgettable experience. Improve your skills, unlock new ships and take top spot on the leaderboard. Collect nitro boosts and coins, avoid energy traps and obstacles, overtake competitors with minimal motion sickness. A game for all ages, both kids and adults can play it! We go the extra mile to ensure that Z-Race is the most comfortable VR racing game ever.\nYou\u2019ll never be alone with asynchronous multiplayer. In virtual reality, this is the best opportunity to always compete with worthy opponents.The faster you are, the more competitive your rivals will become.\nFeel the speed and flight with us, become a real racer of the future!", "short_description": "Z-Race is a marvelous hand-racing VR game. Control futuristic anti-gravity ships that hover above the ground and can fly at super-fast speeds. Race through chic sci-fi tracks, collect nitro boosts and coins, avoid energy traps and obstacles to become the first!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6536841719747013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982548_799444301983390_7739700285363449602_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prvOCifMRhEQ7kNvwHWsgC7&_nc_oc=AdpHQdlm37aRzjdwdHsxB5B4m7OF91uNXERD_0TNa_AmjHtI1SXbxVvgzntRh8ya1oY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrWBm48cxSrl8fAd-ubdkxSK0ELg83fbP0kGritMAlwg&oe=6AFB29E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
0f&oh=00_AQEZOKb1TvwNLU1hZcP4xgJFwUM8khxWlGbqrT-G5sUJhQ&oe=6A883061"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyIRcqb2DUwQ7kNvwGvwjb0&_nc_oc=AdoUaIejq8tLrDsSh3DDQujyvnZG1RGEp0M4sbJsaw5OBBAanZUumG4UbiGgl0-KDbg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFewWwTWH0xGYQjNsems0cvxo73Onz3w5Sa_N_9jBi1PA&oe=6A881B8C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdI_Co7cznkQ7kNvwEbrdpg&_nc_oc=Adp7wTRzpEVP6DYTKCBB3pzDIMuDTD_VmIG6xghS0ECzYQNf6Kg9cakGfLjcvvpPsgY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVW8igNVNpMWI6cGdwQxpuhFK-_4EsGxU_1HKvcpYEow&oe=6A8849B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyM_ntcg8lcQ7kNvwEWK91G&_nc_oc=AdrOUQDxUPrdN2V3rn6gbySGPg3XeLzu2Y3ckN-g5Jy6QgzWLoR94dE5zu4or1jX6Ao&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvaS3aj-WNdlTLiHNLRVTpBc6jUi8qLd4nW7wM_0Y8Ow&oe=6A884289"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QbPab0dZWkQ7kNvwH49zD4&_nc_oc=Adoc_jEddT4YZHhXo8Ra94IhRE8DjjPOgA4sc0LddYEoBuUYlinKGPN7cOkcszyNtT8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOCZCcmkPS8EoIqZagZRshBTtKToemd_svDWcW4YcZyw&oe=6A88467E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pOeRUV1evAQ7kNvwGGJjJd&_nc_oc=Adqiq-Vr0JtQACdOloHxhYY9ITi0eThF_y5Fkyp5kmJawuzf577D-cFyZniAvqYxRTU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuBNNZn89nP1EegQPsD2SXuVOPQ9JWN2wkTHxqbeBhCQ&oe=6A881EAA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
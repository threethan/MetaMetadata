0f&oh=00_AfxK9kuMadW-EdI6axf0O14RS6LQCorC0ViZm_GnLXCdeA&oe=69CA5861"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STGBj-HNVsYQ7kNvwEZ5Eal&_nc_oc=AdrylhSlzSNsHzRJJi8XDq3ZhXwUq1RpNbuEPjKxK9pA5S6dFmnq63zFJpjtd0D5uWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbsLSj5e_jXwUlUVTzQRdEKWViDVTT93PiyVy1fnq4wg&oe=69CA7BCC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUFfMPpRTI8Q7kNvwFaAEtY&_nc_oc=AdqxZdGEGwGGjuOe2ItHuf0iWLv1Ay8LrAmJ6ftlwTICx6IMYRS8L9fWRg3GWnu0cy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp6QcFcufMCdH7FqCWb8qB1sskKS8T8yvIwfwKGji_wQ&oe=69CA71B1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWcIoPXKDXEQ7kNvwF_GlEI&_nc_oc=Adop1SKUlcNZrMaPjWneAppKgBpXpY9IfAUe17E_7yXBqpODCwsFu9o1Rw0H0Z2rAi8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5XarKFsP0LSdJKD85KBNmHTqBG6YiwnQ2X5XemfiX3g&oe=69CA6A89"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHTSFkDp-YQQ7kNvwHP-Iyi&_nc_oc=AdqaFFVYaXD0LslNB16sDWd3UIvDwxQYtQZOi5Sp-thPEpfcrSXdMRKhO29jNzE0uMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-DEdgRD9YbkRGqIzDN7z88fl4V7M_IPuAx4jq3ozcJw&oe=69CA6E7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HceEYR9AFdUQ7kNvwH54n-M&_nc_oc=Adp_Hr4lUeWNPfpWw6_LjcdEBYS-Mx42734xvh25dt9QzdwnzIvLntoSoBlOKDSXy9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVS2Juw1waMdINS4e33G31Fw24pkqe9xc4zkraPaGPQw&oe=69CA7EEA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
0f&oh=00_Af9J9BxL7Mon96vT9yGqq_asWCfR-FiB_276MVgzfZEEaA&oe=6A47CF21"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5i6vVerGRYQ7kNvwGFbxAD&_nc_oc=AdokqlaPpV0CJLSxtpoc4TPjIKPoLfzNzkFjqRjK6gnDEKhxKUzHG5gm4ftzNRyXkA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-33UwQvDBswP2me_SU2P3ONBejghDCtL6RXOEJQRktag&oe=6A47BA4C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeT73N406BoQ7kNvwHTE4lF&_nc_oc=Adr59p9zWRtzz5L00oiiY_0yClILAobAXCVS3_AaHGrbLNHo7eUW3wA4TZnVKuXM7PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UHIpwEKx0nJO0cmF1ErtnQfg7QHsSmunsY82G8ZlRFQ&oe=6A47B031"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUb6h2pSBOgQ7kNvwFueAXH&_nc_oc=AdojEm7quDvPbrApuXDKrzSW37idMe7Fub4rPGYX1w6BT9TsxngWusbjG_DiG96DvgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HX8On9NCLExD68FXo-HZ7laM_WxEt0YC3kAJM5x_v3w&oe=6A47E149"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB6CPPx4Zg4Q7kNvwHZVrib&_nc_oc=Ado_JKle0RVj--c5e15LVehm4q52NmYiXctYcwBnuOp1g0rOvPNEyHFetEvsBVC8II4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jzt0MJUkL93x8S8uA3JpdAdSw_hbTsrHNcl3MIKf__w&oe=6A47ACFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNWKlCpu0jAQ7kNvwENBGG3&_nc_oc=Adql4yfOjg6ALsX0zYtBJY3Ri3B9cMMLmwnhv8KZU3_SdXY-udphzxVGPpX8Ox8kNiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3cU3n8nFegdl-HrkrK6__E2EZ4JdUtSe_DtcJ3uhdGQ&oe=6A47BD6A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
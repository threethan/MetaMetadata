0f&oh=00_AQC0t0Avsk8jyMD87h51rDftLlFkFvuaaGO7M2pcgZ9cig&oe=6A6CB921"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBaFA3GlMDAQ7kNvwHvFMR-&_nc_oc=AdqDgq2vDaO1F4fRDG2PhMFKbPArnJhXquk_Fwxb-IU9m0zKSwFQkaxtF5FwTOqU3RY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA763ADiQ8uoLvUdjpM5YbWHexX1ZJGafuTLdeXPAfQEA&oe=6A6CA44C"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwMlODWEd4Q7kNvwE20gI6&_nc_oc=AdrHmL9wcnxSpZafpzN5A4XfGk1LCj2oGnVMuwd-5SQ2xszFCrfs4dcwxo3PBuen7g0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDknmvej4e7VWiKsBYFwRMnOYKUFym0Xg-YPJzHiwhNcQ&oe=6A6C9A31"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1TvedjfWHcQ7kNvwGfiB9p&_nc_oc=Adp-HUELbj6COTOeVlXlXepJvFuU71HMoCGWivNWIG9t6FCTg2aLIPfPN1kgjbg9Hvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4w772kN_z50gyV_cuSZcMHAZVICfVg5creyKiNWMPJg&oe=6A6C9309"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMPyJpyZF1AQ7kNvwEX_rk1&_nc_oc=AdosQhJQAhNvScPDf_y9hXxHeSXP4nVvaONQc5klcqI3idDb6Gej_EdhCJFji_EuNcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcZ8j-edwxFuIrEJo-2Uxs-Z5Imn7cqWg_GYZjRtzKSg&oe=6A6C96FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmz75OLT7GIQ7kNvwGkjBCP&_nc_oc=AdpCqY7DQjAXGjPmyGWDx0glpDoS7MRCKnFZnrfWkKXnUG7NNczk3N-KvLrkXE7lt6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWKdv6MT2AIDHFTvuOAyZxWh57KJfFYjtNOK3S8Y2_YA&oe=6A6CA76A"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
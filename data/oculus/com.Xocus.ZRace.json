0f&oh=00_Af1eSdJpNyA741_jagSLFqk3Kqypyfwj5hAEOe0M8cD5zA&oe=69D279A1"}, {"file_name": "1 (2).png", "id": "558223238724271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_558223242057604_3078493144839413426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iINjALWOYZkQ7kNvwGKnGEZ&_nc_oc=AdpF6dLzHAmPefMv41R6WQaXgbulub7alNHLww2eXV3x8XOJS52iC0EWKQPcmK-p4hE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ygQIkqKsjB8mj8rwZAt3cbZW_zvO1mxTaN_XzSM9mbQ&oe=69D264CC"}, {"file_name": "3.png", "id": "957388168142886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_957388174809552_3281711998672760426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_sX0hZ9JzcQ7kNvwFBCWpU&_nc_oc=AdoqPc0SVsflAjxpW3FnflfmCKbsHNNOwlp6kvIlvhJVUabvl80ugu6iU_430xDELzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28DyxV6LkqCYVjGeApIixGcChuE5ahsCv7QkjVeKUcKA&oe=69D25AB1"}, {"file_name": "4.png", "id": "842324689816011", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_842324693149344_9073550766037834893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQz3HnGEhyUQ7kNvwHGLMVJ&_nc_oc=AdqT-bz_tgaQHniud4hD6MyQRyvQvYOSNCCvIBK1InNZpoWr88DZVLfwoWxYAqDqoPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DuSIp_R4vjq_yNtcaYFQTpOBx8L64yIXE2CvUEJhvUA&oe=69D25389"}, {"file_name": "2.png", "id": "327599549135458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031318_327599552468791_4697181753991591811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcoJlWYJLtwQ7kNvwHN_O71&_nc_oc=AdrgNsstW0z4c0-AzHpQ_F3uG4GVdP4dl-5_FWBTfrM1jnTYxPN7aSzA6jZuSwJ2xCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v7oqU-JPb7BHnxeSS14mb_WQG7Ms64lCv5W19Qv-rNQ&oe=69D2577E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "4622399031126186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_4622399034459519_1713643228457242232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDWG-mBienUQ7kNvwFita6a&_nc_oc=AdoD1ncWLp0C7eD2XqNtG8MbmVYBagOAlb_QGvNbb3aY4JzaCgB2aaMJwLPwkAYysMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mmXOidT7WyVVhl3ICBF8tv8b0WIXO0S_be6bw_uevXw&oe=69D267EA"}, "display_name": "Z-Race", "keywords": [], "long_description": "Z-Race is a fresh take on the concept of VR racing, complete with high-quality graphics, unique track design, and our very own \u201cFormula Z\u201d racing ships. With 15 tracks of varying difficulty and creative lore, prepare to be immersed in a high-tech futuristic universe. Compete by flying 13 Formula Z ships across three different speed classes, each equipped with your own companion coach, voiced by your favorite members of the VR community. Intuitive controls and motion design create a game that provides the racer with little-to-no motion sickness, allowing absolutely anyone to play. The multiplayer experience in Z-Race is designed to assure you\u2019ll always have competitive opponents to play against, and not be stuck with ones that are too slow\u2014or too fast\u2014for your skill level. No matter how good you get at flying Formula Z, you\u2019ll never be alone. The faster you are, the more competitive your rivals will become.", "short_description": "Z-Race is a zero-gravity, VR racing game packed with atomic physics, spectacular effects, and innovative gameplay mechanics!\nFeatures:\n\u25cf Beautiful, high-quality graphics\n\u25cf Specially designed to be comfortable to play, with no motion sickness\n\u25cf Innovative, simple controls\n\u25cf Asynchronous multiplayer\n\u25cf Tournaments\n\u25cf Multiplayer"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
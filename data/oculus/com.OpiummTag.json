.com&_nc_ss=7f20f&oh=00_AQREZzJeiRv-SCAl4Pk8E4qc2ELRa6L8dr2YzOqakYsUYQ&oe=6AFDD7CA"}, {"file_name": "Untit2222led.png", "id": "951921440566235", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-55QYM7RfYQ7kNvwFf2TVG&_nc_oc=AdodrGUK0pr_zQRKZXq3T_xPNZbS6TaSqWQfXJwPRUBdausucJxHhs6w3ZWoZEaK23o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkPRUIhRi54noc1oi0TEz8auWoMg9Xug2kFnvuixh3lg&oe=6AFDDC4F"}]}, "id": "932567526151249", "locale": "en_US", "screenshots": [{"file_name": "Un234234234titled.png", "id": "1228307722787805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295969_1228307726121138_2093025695544697700_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK30gvaEia0Q7kNvwG8CMp0&_nc_oc=Adp2f3DGtuu9KcnfE4HlqbPNjPT0jFdJ-pyLFZCGFcel2WaifhPd867ULTQu7Evr_bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0UqK3Gnp4XGE5kmxCNp4WbhXz46EaXXXNUuvk6KZcSQ&oe=6AFDB64A"}, {"file_name": "Un234234234titled.png", "id": "4469355010015966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298150_4469355013349299_8829915453550282448_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp-tytO6CpgQ7kNvwGf1CwX&_nc_oc=AdqXH7B_UBYc7mWLzsfOJtEshDfNv88BqSzAGddHmiTfJ9YcXh2Elun4b_5s4qC_IZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhnixNHrMqlDQT6wamUWB-L59aeqb4tFew7ehAdhYQzA&oe=6AFDE44A"}, {"file_name": "Un234234234titled.png", "id": "924543680372739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_924543683706072_2180293481539938571_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HECrSDiwt9oQ7kNvwH6px1M&_nc_oc=AdqHR8UxJr0qba4s5BK1Rert500DPssNU3kE6GPvQS7DLqTdY8bqV1OTxVyVpfDx1NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST-bfdNxKtR0GzMhXOvT_QTINosKubPHFOSR9a7vyN9Q&oe=6AFDD239"}, {"file_name": "Un234234234titled.png", "id": "1282816693768408", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294616_1282816697101741_8816531829381590059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCq_hI00hFYQ7kNvwEY-Oz0&_nc_oc=Adq5qtUWbb51kh92NXbgFajrgzB2HFLO8Q1hTjeEclVumvDQB9cmSzAE6WnSuzmu6Mk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4AxSxrjyX_WuJeNTutsgJQLqtjwqTJ-0C8fTKuWcjAw&oe=6AFDBB26"}, {"file_name": "Un234234234titled.png", "id": "704512972674497", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_704512976007830_3057160559923660842_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCGKRzzytG8Q7kNvwE_B5TJ&_nc_oc=AdrRdSqni2cGZTiLFqszT8luUq8Lmkeb9jhwdL3_DokldxJATY8fDqIDc16krcYpVVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqbn6bCWvg4wHMG9lQZLjHDnmyAO4rCNXqI9bMLs591g&oe=6AFDC63B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opiumm", "keywords": ["Tag", "Taggers"], "long_description": "Opiumm drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opiumm is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25365312273142242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-55QYM7RfYQ7kNvwFf2TVG&_nc_oc=AdodrGUK0pr_zQRKZXq3T_xPNZbS6TaSqWQfXJwPRUBdausucJxHhs6w3ZWoZEaK23o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPd7ZR918_mPRehKrHMZC_MpVH6svL7DcJi7jzz_RDHw&oe=6AFDDC4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opiumm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 17744860
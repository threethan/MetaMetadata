.com&_nc_ss=7f20f&oh=00_AQRjg5PXiKXEYEQLKHXENorbjfq0Ta9A5oBfN4t5GLSW6Q&oe=6AFB34CA"}, {"file_name": "Untit2222led.png", "id": "951921440566235", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-55QYM7RfYQ7kNvwGE9U5M&_nc_oc=AdrHBuuOj2bgR-eA6Q1Qi8Z-zEvjM4on-Kh-2AnvSPyvyRJ_DjvxuYa6TRX8vKm1aIc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxunt0ZiPvnevXg7a9YydD7VeLaFbXy6N3Ow7d9E6tKg&oe=6AFB394F"}]}, "id": "932567526151249", "locale": "en_US", "screenshots": [{"file_name": "Un234234234titled.png", "id": "1228307722787805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295969_1228307726121138_2093025695544697700_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK30gvaEia0Q7kNvwHfKkGy&_nc_oc=AdrU8RLJi_Nqki9GwTjcjKXlN2scsNAp9oWtt9Lu4IEtnJ3hFA80ao-cgInceAY21n0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNormdEJH_E3iYh-M7NavHMK0naR5ce1SeQFxDss3BFw&oe=6AFB4B8A"}, {"file_name": "Un234234234titled.png", "id": "4469355010015966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298150_4469355013349299_8829915453550282448_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp-tytO6CpgQ7kNvwGYWUBh&_nc_oc=AdrtZQEM0nKkG2T74QEJpDO0eCJuXpNvG9wk0snPBQjRgLIc9K-AlgmlHlO2R3mjhXM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0mRKtXRyTEhSgWDnxMPLjKVrHSqRXanUc_DTF5fZj6A&oe=6AFB414A"}, {"file_name": "Un234234234titled.png", "id": "924543680372739", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305071_924543683706072_2180293481539938571_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny3NZLd9fTAQ7kNvwFnDKpb&_nc_oc=AdoNupI7bzrSDV-lCvvRWID7q1oBbrSKEfP9TtCBHlyzaabNUEcHS3D0bSEEmd3X89w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6kUeMAhl7_QCYiav6qQsdHBafVrrNFane1CEXnJBLrA&oe=6AFB2F39"}, {"file_name": "Un234234234titled.png", "id": "1282816693768408", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294616_1282816697101741_8816531829381590059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39F_THD7y0AQ7kNvwGzSbjp&_nc_oc=AdrReqtHV0kWLxyF7S0c7gskc_8CqaQ2qU0FDCYjw3y43san3vpKoCINnL_MIefUrJM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh0LS5dgdeHUNCRmqTWalRasr-UW8fx4okps1KlMZI8Q&oe=6AFB1826"}, {"file_name": "Un234234234titled.png", "id": "704512972674497", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298930_704512976007830_3057160559923660842_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCGKRzzytG8Q7kNvwFVeEWk&_nc_oc=AdqgTO30QW9PQKS07vbvEkQcONg-mNft6xbFuuWJMhOifYrdVT37uxWwt-98u2ww-l0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-jDEuInAS0lqtcS34IQj9Eh_WDzMmYDBELd4rAxqSCw&oe=6AFB233B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opiumm", "keywords": ["Tag", "Taggers"], "long_description": "Opiumm drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opiumm is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25365312273142242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-55QYM7RfYQ7kNvwGE9U5M&_nc_oc=AdrHBuuOj2bgR-eA6Q1Qi8Z-zEvjM4on-Kh-2AnvSPyvyRJ_DjvxuYa6TRX8vKm1aIc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL5dF-ojfalmAupgfcXBRQYVzC3Tu6J1Ju0G51nqDPfA&oe=6AFB394F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opiumm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 17744860
.com&_nc_ss=7f30f&oh=00_AQSNeJffYR4S8Cdil0gq3jNT3qOrvbT2XBv6Adrd0NIBag&oe=6B0C584A"}, {"file_name": "Untit2222led.png", "id": "951921440566235", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qneIQT98RT0Q7kNvwHooQZC&_nc_oc=AdqzBxyUC4ANiTv3Vg7JPCIBE9z8PKo5HMlRWUhZhXZUC1Pb5iz58GlWoA5_5fnRT6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8d19cZNNq364mKHxFQff9IFOopLAaG_WyA4IZ8Yyw8w&oe=6B0C5CCF"}]}, "id": "932567526151249", "locale": "en_US", "screenshots": [{"file_name": "Un234234234titled.png", "id": "1228307722787805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295969_1228307726121138_2093025695544697700_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvwWalvrEjAQ7kNvwFVR_vS&_nc_oc=AdpeKSXqS2HZQOXXoVkUCE7jZEabCidJo12ZjYf8BD9joqc6BbXcVssrp7Joqq1u4F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuUtVQJA60IfTxSrw7v3JfFjThaRQfNnRylKGNANRBdg&oe=6B0C6F0A"}, {"file_name": "Un234234234titled.png", "id": "4469355010015966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_4469355013349299_8829915453550282448_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6Y3OG4uoKcQ7kNvwF6KqeY&_nc_oc=Adq6dtRkqodRjXTb4AS890YD9H_NoUoiN6CPliz6nIbwMxqRoCIRorlpyaxyxPjJKjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2-6XGtXlHefrvlbK8Rn8bUwAjb5_neke6gwpOttedoQ&oe=6B0C64CA"}, {"file_name": "Un234234234titled.png", "id": "924543680372739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_924543683706072_2180293481539938571_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P28WSpdx2ssQ7kNvwEXpow-&_nc_oc=AdqAqtJ6s-RwJXlap68UPCF3xCAnXC6-ir_ui9qJng5PB3LoodcCrox9Bo7uuxsHHzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvG48gxmNQzXBgVWT3DxpZPOwQ7g6TjQeZ7xzL0MgYyA&oe=6B0C52B9"}, {"file_name": "Un234234234titled.png", "id": "1282816693768408", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294616_1282816697101741_8816531829381590059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gn8q8WxvlkQ7kNvwFZYwSg&_nc_oc=Adp5cDGDAGwOoEt2zUiSVnh7E7A6ti5os_nbo9iO1VC3m5ANPYbV2ZHqpk7ARbfF1R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9UD707-ZSaKaY0jLYSsvQGAh4yPEXwW2V1-enDpLG_w&oe=6B0C73E6"}, {"file_name": "Un234234234titled.png", "id": "704512972674497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_704512976007830_3057160559923660842_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxbWaUH-TUIQ7kNvwFyexSn&_nc_oc=AdomSv_dZ3VL2MKMMhoDPPmDTqE7lAEJvxSU3CZZ6gUs_w_PqccrZZ67vuJxk0XjRTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjNcmvdP7i3iOgwKVsGoUdF1u45T52_CbsVCGfZDXLLA&oe=6B0C7EFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opiumm", "keywords": ["Tag", "Taggers"], "long_description": "Opiumm drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opiumm is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25365312273142242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qneIQT98RT0Q7kNvwHooQZC&_nc_oc=AdqzBxyUC4ANiTv3Vg7JPCIBE9z8PKo5HMlRWUhZhXZUC1Pb5iz58GlWoA5_5fnRT6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3lLIGCdiVc6a-yA2vGElJKkdPYphWA2pHzSPYmh3IBQ&oe=6B0C5CCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opiumm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 17744860
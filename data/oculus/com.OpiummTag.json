&oh=00_AQSEsleSbOkYfWMG3lwvD3l0EjWIYqcQJ4OOonQZnCg3Bw&oe=6AFF23B9"}, {"file_name": "Un234234234titled.png", "id": "1282816693768408", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294616_1282816697101741_8816531829381590059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCq_hI00hFYQ7kNvwGnQ9ry&_nc_oc=AdpRv6pK6yE8x45oZTyawh-mqdBqWpvksFFdI-D2KSgML8ocg0a6_FzUDy_hUnLkSEo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoPqno91xtKXiHHfUswSVl0C-Voi7KWlkpIizHnfqyew&oe=6AFF0CA6"}, {"file_name": "Un234234234titled.png", "id": "704512972674497", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_704512976007830_3057160559923660842_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMnJtf8UYCUQ7kNvwGIJVMB&_nc_oc=AdquoHL-ShccH8PyWBJ3Ccd3-Xq1ViW7XS836CCIzoVnYw6z0cs7KHbWV7gyYCVad6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStQuF7G1iJQsWVbK-Xj6eXY-zDRyks03iG6PfEdfZS2A&oe=6AFF17BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opiumm", "keywords": ["Tag", "Taggers"], "long_description": "Opiumm drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opiumm is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25365312273142242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296037_951921443899568_4007359417473991301_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBWesk0Ng0wQ7kNvwFFkKx4&_nc_oc=AdpkhW7cq0ujPemYRTuh-XpW9GEZTUxU6kpn_LmUUsuD8d7uqTlK5Nw-eBM7LtlZtvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP6Auc44TPLzn-LUwAlWoFOXCrKBNTwXBdiaQgTKDwPQ&oe=6AFF2DCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opiumm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 17744860
ng", "id": "924543680372739", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305071_924543683706072_2180293481539938571_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P28WSpdx2ssQ7kNvwFKQ7xb&_nc_oc=Adon8Peu9uRf7CRPsDlqSnHxmfVrBPVMn2vB89y4hHYNxJhwYYbTTtmCEasBE1m0chc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXiQIq1uLg4btQZKuOq38ACMCaa3OYWVFnRhPnTMlMcQ&oe=6B0B3979"}, {"file_name": "Un234234234titled.png", "id": "1282816693768408", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294616_1282816697101741_8816531829381590059_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gn8q8WxvlkQ7kNvwF1fjk8&_nc_oc=Adr54R59zS-rNC5xMzROZ9ShDZxUKzYzHCYFwbP24BuLq9_8jujOUjYzCj4uMSMWpHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1XGaVAvixBYmzwC1Fr9YT0kmkh5zm_I6ohKNAmP36Qw&oe=6B0B2266"}, {"file_name": "Un234234234titled.png", "id": "704512972674497", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298930_704512976007830_3057160559923660842_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxbWaUH-TUIQ7kNvwGW6jq8&_nc_oc=Adov0j_zAz8Q0bNLNBGWpYekDYgKPQm7oUC5sa-YknWejw_Q8Udmg_L2NBhHR0d_nbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6Q7Hf0Bkybi0utz08cSAtb7x9t0rFKU9yH5L6MkhGBg&oe=6B0B2D7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opiumm", "keywords": ["Tag", "Taggers"], "long_description": "Opiumm drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opiumm is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25365312273142242"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25539039882436146", "version": "1.1.100"}, "id": "785416397942197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
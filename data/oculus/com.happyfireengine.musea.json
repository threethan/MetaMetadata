g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlkjL_dV2XEQ7kNvwEdTejC&_nc_oc=AdoJ_FdY5E53PbpSvyGZ1ydb0Ui_xBi6xqUoXxJy3iNQe_MJfGGSZBkwRyTj2ZbR82s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL43IuVDW7K6r4plQF6ryHmzopYzaM1mHd-W6rHMiRFjw&oe=6AB66846"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytBkJZbuoUMQ7kNvwE5XQPu&_nc_oc=AdqslhOAoJe69wewSb0BndiIEVvqdwuZ7moU75NAs8h1QB0IocrIjGmb0NYdDii05PI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp-1KziSi5eE4QiW6Qdo6LsTMPly-wzcqp5l-FmVRm_g&oe=6AB697E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyUYoFCdhDoQ7kNvwFsPRXn&_nc_oc=AdqfKJefNGN5etMCnGcNGBnnB2Kj14CNLYi_oUPxw2UavuswnFRxepkyD59ibyj0t38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgb4jNRQQz7j046vN2uZzp9R4_2UgiKFgArf71T-uTFQ&oe=6AB68A49"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Musea: VR Art Museum", "platform": "ANDROID_6DOF", "context_category": {"context_
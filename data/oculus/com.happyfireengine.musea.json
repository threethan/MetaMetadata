3-2.oculuscdn.com/v/t64.5771-25/499622214_1054829273904310_3734188238385928451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix2peesCZ6oQ7kNvwFLHzc_&_nc_oc=AdqBooTCeGzK3op_OckVCAQ3ZS3qSIm-E0-oJX1TWny9guw-bh-Rq1ObtKDsNIr36hY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCQJsKRkhfhYVCzCCNxKBv8TFJBvwfb02nkhb3jbboQQ&oe=6AA02D29"}]}, "id": "1692121948678055", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.browser-20260719-220727.png", "id": "1350223040559269", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623443_1350223043892602_8783633884821753709_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_SLx4Ay9CIQ7kNvwH3Bxrz&_nc_oc=AdqVsY1uip884OGACy22ZpFQi4DsCZOL69L9PWQfvuMQwQpG5eiBd0JBsPfQMnrGuNU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr17oJb1urmozsm4LXguIsi61qvRmOfy9dCd6dKPFzHw&oe=6AA00376"}, {"file_name": "com.oculus.browser-20260719-220838.png", "id": "947905701647186", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622325_947905704980519_2437786297565037014_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFpZB_FJbzwQ7kNvwFd7e4U&_nc_oc=AdpKcTRocEsbhqVdlNe2stxPukMggncb2e6m8o3dGLfcO8-E6nO_SIZ9ZB8SS4u3yWA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2amBS2ZkTyD_70ZWbKasnvFldlzkvZ7ENY6CAKzAeAA&oe=6AA02ABE"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE-tFLvS7yIQ7kNvwEftvg9&_nc_oc=Adp1GNqprm-POan21RQc6MC7mDDXYHWxm4orFEe83X6GhWr2_G_URE6eb3jgP0sN_Jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKYJnd6mB4EnZg16yuzphVZrFhcB9swlqraOHbKS9gfQ&oe=6AA01ADA"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrOEBnktp6sQ7kNvwGRXReX&_nc_oc=AdojUuLXuDqRD0lgPeTml3EKqTZIe3od2anCGhnIhgk_KrwIjNbwKD5vESTfpSbM1rA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL58TUXe74M2YMaYARmodev3g1fSPMvorI0lvQcSxXMIw&oe=6A9FFEC6"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xyOIyiooCUQ7kNvwGOlX-O&_nc_oc=AdqcLNTiuAIENABknJHFBKEteZeIoml-951PgbF2VBJmS1loTlFvpCsN0SHcVgJc37U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjMVgT-lRRN6guwdfkpoRsaOMmLV_cKvQdPzvZfpzSHA&oe=6AA02E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3iNXcEwzU4Q7kNvwFigJHa&_nc_oc=Adqwa55fTnDtZ6ih3ES1EjJ2Y7-EF5QBu-crYrfQ7jAZXcS40a8fLhb-r3AiU7GSTMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgxpRgyZKE02VYaPJA8amz-16hGWPdgdFO3lGe2ijmqA&oe=6AA020C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Musea: VR Art Museum", "platform": "ANDROID_6DOF", "context_category": {"context_
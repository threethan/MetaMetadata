g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9q_CUeb_xQQ7kNvwFP9HJK&_nc_oc=AdqsdkFIA5wbbzWhJCCUen08AbFtqc9VcKUlD7bj85__H83lz6ovQGmZX3dLdWnC3Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODYZowBqqcpunmhdHXPI98hGtieqOeR2p0gmJ-EbFRgg&oe=6ACA6706"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44gr0aI-JX0Q7kNvwFl3ld2&_nc_oc=Adqjss_8wkaa43MvbeJJZ5N62rMEEWXy10lgE4gyT9wYamMzyzGeP7bZclxGmRvEQVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSpf_OXKzUp_0lh0R3LDynIsIJM7085GVfv9yCsS7xmA&oe=6ACA5E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfQupJydYz8Q7kNvwG8odfH&_nc_oc=Adp_Psrp6V1uquf8x4qy2P5wBg9-0_jfjC_Ozq8u0uZYIhW4P9Dj9Wz_1wJnapfUfPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3aSvgnGJ92GIi9TaiNz52IFca1JscITGkBq-UfzAwRw&oe=6ACA50C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Musea: VR Art Museum", "platform": "ANDROID_6DOF", "context_category": {"context_
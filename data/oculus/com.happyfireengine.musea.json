3-1.oculuscdn.com/v/t64.5771-25/499622214_1054829273904310_3734188238385928451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSaaV78QzDMQ7kNvwEaSQTI&_nc_oc=AdqVVL2btKCdzDc9PxG83yQLJNtV8Faz7UaMeh5XtyZXpxdfnorPgll7Jn5-Y-LBO98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGukhUnV5TM16YgF8q6rCR4QFKMrx8eCTj5HCMY46I6Bw&oe=6A82F3E9"}]}, "id": "1692121948678055", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.browser-20260719-220727.png", "id": "1350223040559269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623443_1350223043892602_8783633884821753709_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gRk2acEkFkQ7kNvwHUIAv6&_nc_oc=AdpzV-68_HAxg2myWuOnwo5-HI68ddYXR1_uH_uE6vjyZdO6nt7dSfDFZZJ44hqt54E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6WRbXFZTeKslr4Lb9HJJmNfcD6vxCI_Q_SQfks0-EIA&oe=6A830276"}, {"file_name": "com.oculus.browser-20260719-220838.png", "id": "947905701647186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_947905704980519_2437786297565037014_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhtSiAeye0YQ7kNvwEnBA9Q&_nc_oc=Adr8mpm59LoOdvOW22X6B_sxWceZYdWQ9IOT2KfOE4v2hDU6X8GH_Z1Kt7XLbnQNclQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-gMJMiuGktYcsOn5Wo6C8RfWD9UgVA47OccLne8BKdQ&oe=6A82F17E"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC4ET7np90YQ7kNvwFtBddm&_nc_oc=Adr-Rgz8lTiffLLgGnusPrD-oJSLoGGe198YJyv1wGjPzm2FP0bKmq3amocF2rYjAv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Wct5MniI6HDiNfRYwYdavcy-RwaMP-Gaz-tme0YTRg&oe=6A8319DA"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZP7mxr9ApYQ7kNvwE1-Mvl&_nc_oc=Adoo9YYmSpmWvFjwpRmrrtWWIUfwIhZvoz7eW-E3Ke9AlDtBeKo-jid9ywn0EXpWaaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFeh8yPWNo0WzTCcyygedh6ciszzoCluIemxbOVn08OQ&oe=6A82FDC6"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQuSLilkzAcQ7kNvwEFm6TA&_nc_oc=AdqRv0Wngr8w8cx3PN04_RynkdNi9Vc3BMvg7j42t2QgNcAsoZn2fsoy3x6JfVBNsHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPbtbc03F5wjJCWxJeYTrA-IBxfza8vc0YYqwylSZKSA&oe=6A82F521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k9ln8sdwqUQ7kNvwE8Mplf&_nc_oc=Ado0OYgn3mH53QI2WL94N2ohiRs_vkAbbWYse__iOfbKJRibV6fQVbXnJpawLIrtb8g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAqy64wwa4csm9K9VBb4QTnp5rUAokCfmZHj14p2CUag&oe=6A82E789"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Musea: VR Art Museum", "platform": "ANDROID_6DOF", "context_category": {"context_
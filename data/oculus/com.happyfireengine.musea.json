3-1.oculuscdn.com/v/t64.5771-25/499622214_1054829273904310_3734188238385928451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j81diSYcSa0Q7kNvwHbxocG&_nc_oc=AdqxRw5nGoY8x7OygcdmFIFenKvI0EeUPZOy5Gn84Lby2AxE1rg1TBsYHSXJzzY89Wg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzLmByyfgEAyg1i2AC9Xyq-7YKqXb4Wpec3thuw3MPNg&oe=6ADE23A9"}]}, "id": "1692121948678055", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.browser-20260719-220727.png", "id": "1350223040559269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623443_1350223043892602_8783633884821753709_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hanA1_m1blcQ7kNvwGiecEY&_nc_oc=AdrFGjd4mU_IyCPsT1lyZpu2XSztSOBl3pbS-88QzFuL7f28R3i8OK93_O1CiwT16H4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnmJC5y4L4MtNyAfcuVXrsIX9J1ht5m7D33zEldik7MQ&oe=6ADDF9F6"}, {"file_name": "com.oculus.browser-20260719-220838.png", "id": "947905701647186", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_947905704980519_2437786297565037014_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfMkhrlNYvkQ7kNvwGb1a4w&_nc_oc=Ado9bKsILH5BfAC2uU8wisH9e4C55BhbhNWwx2Msdt38Z-uUToTZUVCJWkTTxL2S_t0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkYo0jGfZeDAGUYuJxObxiAhsYIsVGgv2KT3Mn-iL2pg&oe=6ADE213E"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUAF8DJpVXcQ7kNvwEAWuFq&_nc_oc=AdomtlDE9-DTymXwB1slxHLC-zlWDcxpZZClDWHxM3sx_SzOHTsHJB9Os1UOENX-Llw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6RyDv8g7mb8nqcKXOJ7F4AI0PbzDxANjBDSyfNd2VVQ&oe=6ADE115A"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNLsb9orE6wQ7kNvwGmtldp&_nc_oc=AdqXltRu-xfRafT85hUqdRKZHKJr_K5AH-E5oapqg3yHVQeZAPcZw53nAWyvmekBLSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_StUUOt1Fe1isLRIbuDiF441KDoSAIHyxdJWbWyA3lw&oe=6ADDF546"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfGmZ8V7TwkQ7kNvwFY94gr&_nc_oc=AdoZgcg1rlLuOpNTWnqswhbffUhTe4U9Y0Pg54VytjtxoJiw4rjkN4SmAyt22htJtfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWwIiY9rActqof1f_VoLjPCQsC5K6Nzp26oGOoAPBIVg&oe=6ADE24E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUyu8bzBuGIQ7kNvwH5Kl3U&_nc_oc=AdpUy05sRM-VgeMwstqAeCNq8F4Uj4yzaqjCtdBbfY6UEj3BeXoCDV0d2Isjuk6I36w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM34yut1Zc1iIC-UnQAXE0L80SeR06UotCV9ndFjXpm_A&oe=6ADE1749"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Musea: VR Art Museum", "platform": "ANDROID_6DOF", "context_category": {"context_
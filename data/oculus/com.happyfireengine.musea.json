e": "Musea512.png", "id": "1054829270570977", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1054829273904310_3734188238385928451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq5GHFWwnuUQ7kNvwE3F9fW&_nc_oc=AdqUqalg2u_z7avYmr3Yc6DLAonRwJOHamYFpFXm5eMHKCAgybQDnNlrF5CiymdojdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqrlFMm38KE9Gr3Vts3vNwjH_KB7Ws6Ilyf6cNaBSy1A&oe=6B0D99A9"}]}, "id": "1692121948678055", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.browser-20260719-220727.png", "id": "1350223040559269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_1350223043892602_8783633884821753709_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxdiDNUMCLQQ7kNvwHowX6A&_nc_oc=AdodrI4aG56EQxEv4oSBKJr0PcX_M_AakGIsOMYj3aklV6RRQxCMQJV5QNW5nHTrvo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUUqHATy_A0paOGFayOqro-7T5qltxIE4G-RiG-rxn8Q&oe=6B0DA836"}, {"file_name": "com.oculus.browser-20260719-220838.png", "id": "947905701647186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_947905704980519_2437786297565037014_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFHlJdqgBoIQ7kNvwEJ9J5L&_nc_oc=AdoivZNGeUWIxjTfZg6464h17J4gffF7XDIb13KSh8ByPtoqYuZ2gI7ebcHF4MXxHBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxRdlXsksw2iS8bzUWjl9CpQm303O7aSNdngfm2tctDA&oe=6B0DCF7E"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfeZk_dPZIkQ7kNvwEQY7I5&_nc_oc=AdrXJ9iCSzaWZEqJRkXKFSi3MB2qrdhU90P0UW9JuTepbxXYwfYIKbEgbFFB8fgV9uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUQVnvbIgYQ_vEHqOHLLMzcbfC4kOk401QuVat2GIVFQ&oe=6B0DBF9A"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXtpsG52iz4Q7kNvwG1bgkC&_nc_oc=Adpb_EyFYs20WXvfEA7ouqXkTI_tWmMwdaKPjaZtW-g_hA8qbtpvQDLFrmrvslHMFYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcrDg9U4lgCaLXcen2upOsoar23RlLQ9CPJc3RGiGTjw&oe=6B0DA386"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxIrOrVNx70Q7kNvwHtGflk&_nc_oc=AdoYSjWi6sqbPtX1r3tFHeUUkbU-HCKhoA7jjPjXNoxnLtRF_E_m-aZ4sDkxgtl3Q5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOUhrfzB46tzBJZ4N1bTvnRlMwf3CD5iZH8gKMhXmoEg&oe=6B0D9AE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl7o69YSjUcQ7kNvwGSKf1o&_nc_oc=Ado8nnNRkFA9RMILWfz7eAktab2x29QJ-twSRjAnMy_nASWd2rXc2hGn3k6M0H2e-RY&_nc_zt=3&
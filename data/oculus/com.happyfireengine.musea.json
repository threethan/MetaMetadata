e": "Musea512.png", "id": "1054829270570977", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622214_1054829273904310_3734188238385928451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd3sbACR41IQ7kNvwGtNTT3&_nc_oc=Adq7S5xVhNPLALebqXsw4LnWg0S4k0oK4YVhWM4o5YHbJefHtoNd7Mq133yd3AiKXa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZb_9hoUM0_1n-GtNZESoGe7iSWkhJzSSlwDETZEtzFQ&oe=6AFC7629"}]}, "id": "1692121948678055", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.browser-20260719-220727.png", "id": "1350223040559269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623443_1350223043892602_8783633884821753709_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXEifIbkMaEQ7kNvwGQJ85k&_nc_oc=AdpKfiR0LvaIf2OR8jEnxtqAVicP_oiuFXLcRjeM8_Xt_MjyUcvmi7XYzics_BLQzFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7SmosdmuajhyIfyYmYqHwn2gwVFcy_cw6Aa0AvmRE0g&oe=6AFC84B6"}, {"file_name": "com.oculus.browser-20260719-220838.png", "id": "947905701647186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_947905704980519_2437786297565037014_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRsa-3fofcEQ7kNvwG5Z5e9&_nc_oc=Adov7g00a_iRPu5DD2VZrC_oioXWc5IaKDzTWfAOU2MXI6TrRRxBe2mSvZ3bR9EWq-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1MJYzBoCnvQ3rOMIl8cejUcZQK8HJmwxXWE3ZDNTNew&oe=6AFC73BE"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0ZZkrK79gMQ7kNvwHli_Up&_nc_oc=AdqDHry8_yn171dRcFXEKypEW0mXTALqKMy1eZ24LRGObnzTCTr0TJAyD3IHDgypuD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwwSY_XPNjEltwH6arFugesJRFTqTzfl8wZmTz23jKhA&oe=6AFC63DA"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKXzFWgaL4MQ7kNvwHP7ODa&_nc_oc=AdohQ2YMPFLaRKnevWVfS21Zor9RU9zDKF1uQHFS60PQgAQTiK6XFtGqm74X1d6uhos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYv3W2ScCJzdhT20eJe3y01QW6J1ucid1AGFz_tSpthw&oe=6AFC8006"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQI-3FoBkNYQ7kNvwGGGx-L&_nc_oc=AdpF5kfopLQzWLD1Z5TRO_VJNftPW2udjdQaOVir5BJWDvMiQQrhq6edaa5sIVbGKUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUkWuNoycZ_c_-oNgFv47Ru-ijMJX5Lu0Y86RhF8QaeQ&oe=6AFC7761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2107038993488922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622214_1711871526792552_6453594174322041226_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFD1TZfh01wQ7kNvwGfBtkx&_nc_oc=AdodxtEmFejIF6Qc9T5JfX-ulOGqmth8nPaHuNLQTaGEEVrdTgZinsKePvuvxGrLovQ&_nc_zt=3&
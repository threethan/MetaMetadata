nt-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYWtIWMtV6JtpD1CloufnxInpqdQzb2Z83pSeb0aaczQ&oe=6A95D6FE"}, {"file_name": "com.oculus.browser-20260719-220810.png", "id": "4431834137133103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_4431834140466436_8794073591640477638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBu5MEuNdJcQ7kNvwEZDoOA&_nc_oc=AdoUoO9u8gAYQistDcMHtVGVjfP3WNLwJaWN1cWS9apA2SCqfx2jIc7Na0InRLARMF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT34qE9jTWq-KSZoGUON2s8B2h2jKpxfsdaAsaPyP--g&oe=6A95C71A"}, {"file_name": "com.oculus.browser-20260719-220646.png", "id": "1034789198921609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_1034789202254942_5166030498516409047_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU2JN_4DlyIQ7kNvwHMwQ2h&_nc_oc=Adpl4xYBPoQA9xuJfmMZvRcQ-eeN-U2hZ3UMxMX1L3M8cq2vsJRqE3fPeDUtiY7p3s0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1RBjwgBPg7nIwHzunwwUHD8uNa2tYx6ygcQfZvefZ-A&oe=6A95E346"}, {"file_name": "com.oculus.browser-20260719-221715.png", "id": "1552995220354447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_1552995227021113_8299056879367332245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHGSkDXUd0YQ7kNvwE0sjMS&_nc_oc=AdqO5Co4cbN7EftAE4q4Wk1UpBXBE821LUiMmFuwskeO7HaOWQpJ50pz_gBFc0v9V7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm0r1mA6CC7SHmp1IcVP7B9O8d2h12XMtrLkk5XVftQg&oe=6A95DAA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Musea: VR Art Museum", "keywords": [], "long_description": "**A museum that never runs out.**\n\nMusea is a virtual art museum where the galleries are only the beginning. Wander three handcrafted rooms hung with history's masterpieces, then type any artist or painting into the in-world search and watch a new exhibition assemble itself around you, drawn live from the world's public-domain collections.\n\n**Three resident galleries**\n\n- **The Grand Salon**: a monumental hall of European masters, from Leonardo to Van Gogh, with Raphael's *School of Athens* commanding its own wall\n- **The Focused Exhibit**: Impressionism and modern visions, from Monet's light to Seurat's Sunday afternoon\n- **The Vault**: an intimate jewel box of Japanese masterworks, home to Hokusai's *Great Wave*\n\n**Infinite exhibitions**\n\nSearch all of art history. If it's in the public domain, you can hang it: verified, attributed, and rendered at museum resolution on your walls.\n\n**Every work, up close**\n\nStep in to inspect brushwork at full resolution. Read the story behind each piece on gallery wall text, just like the real thing.\n\n**A soundtrack to match**\n\nClassical works fill the halls, opening with Vivaldi's Four Seasons.\n\nNo tickets. No crowds. No closing time. Just you and five centuries of painting.", "short_description": "Step into a museum with no walls on its collection. Wander three grand galleries hung with masterpieces, then search all of art history and hang public-domain works in your own exhibition, drawn live from the world's collections."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happyfire-engine.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HappyFire Engine LLC", "support_website_url": null, "website_url": "https://happyfire-engine.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
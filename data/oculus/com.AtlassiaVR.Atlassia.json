735_5688999590949547541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6FNvfzZpeYQ7kNvwGgWef3&_nc_oc=AdrL3zh3eAQXWJM_gqytf2SzP2u3pJsD4hlNMWWiWmxhxITH7lFeGorFloy7jcA6r4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN3AW3gjKStpTZboIX47gsLMyDlvSbrxis3_Bl4r34Gw&oe=69C1356A"}, {"file_name": "Frame 55.png", "id": "487290133813517", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974658_487290150480182_6911910573783685737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1MPYfjJsOYQ7kNvwFgB3pB&_nc_oc=AdoJVNIoymbrGdjNekHnAxhi4ZqTe2n38Xj4KE74nsT7O7655tAGqXHOFcGQGGuodAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIDVoUr6x-UpbdoO5HZbvhxGUyboMPRN3knfblsLglGg&oe=69C11B79"}, {"file_name": "Frame 56.png", "id": "1112008496568432", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_1112008499901765_1042443027956768288_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tll16rlkXPMQ7kNvwEzl1QG&_nc_oc=AdoZ1UFoiZv4I-wwWOl_r29Lvn8G6gYG85MMV6Ehcl5PBdLLmUY_ejETuW-Xaa1D2_A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7nG1QaldQHVtrglPqH95BpTCZdU5OWOqiAdvlFCl9-g&oe=69C11E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 53.png", "id": "485071047332515", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031564_485071050665848_6866340915274874641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=080XGm8Gg50Q7kNvwHHLA9t&_nc_oc=AdqNdPTYQ0cGehf4Is9D5qac4jfLbg0Lsqih2xkEuTBVTMbWosAcRAig5AFHuLALL5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzsgh1oj8IedXQPCYKHk6oV8rPZxgQ6WoBhPWwTiF_JGw&oe=69C12EF6"}, "display_name": "ATLAS ENDGAMES", "keywords": ["free", "shooter", "battle", "royale", "fps"], "long_description": "# USE HIGH-POWERED ABILITIES \ud83d\udca5\nUnleash the power of 6 unique heroes and master 18 epic abilities, including drone piloting, portal teleportation, and grappling hooks. Master powerful abilities and become the ultimate champion.\n{440543928908440}\n\n# MASTER THE MOVEMENT SYSTEM \ud83d\udca8\nExperience next-level movement with wall runs, wall bounces, and infinite slides.\n{964672438686645}\n\n# EXPLORE A GIGANTIC MAP \ud83d\uddfa\ufe0f\nExplore a massive and wild environment of 1.5 square mile (4km\u00b2). Fight up to 39 players.\n{791130333148631}\n\n# FIGHT WITH POWERFUL WEAPONS \ud83d\udd2b\nArm yourself with 9 powerful sci-fi weapons and 6 types of grenades, all with realistic physics.\n{1135254451031064}\n\n# SURVIVE THE ARENA \u2694\ufe0f\nBattle in the arena (gulag) for a thrilling second chance to rejoin the match.\n{1524544925154847}\n\n# PILOT VEHICLES \ud83d\udef8\nSpeed through the game with fast, physics-based vehicles like the dropship or the hoverbike.\n{781170470826206}\n\n\n# YOU ARE THE NEW CHAMPION \ud83c\udfc6\nCelebrate your victories with friends as your opponents bow to your supremacy.\n{1011730990316459}\n\n\n\nThe most ruthless fighters in the galaxy are joining the battle royale.\nSome fight for glory, some for money, while others are only interested in revenge. But in the end, the only thing that matters is survival.\n\n\nDo you have what it takes to become the next champion of Atlas Endgames?\n\nAtlas Endgames is in early development but aims to become the ultimate next-gen battle royale experience. The game is receiving constant updates.\n\nJoin our Discord: https://discord.gg/BK5FUz5tGr", "short_description": "Next Generation Hero Battle Royale"}]}, "developer_name": "Atlas XR", "developer_privacy_policy_url": "https://www.atlasendgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas XR", "support_website_url": "https://www.atlasendgames.com/contact", "website_url": "https://atlasendgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "
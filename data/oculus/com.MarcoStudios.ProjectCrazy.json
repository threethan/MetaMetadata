rt6qTj-XhFKpAYGftFZuL2VeQ&oe=6A3AAD95"}, {"file_name": "S5.png", "id": "1325687751986295", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_1325687755319628_6126337536874170708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChddkUjawtYQ7kNvwGHvKN-&_nc_oc=AdrZC3PWQTPGY1Hz11lrcILqBtJsF9NnubzhMO56g1kg5vRr5L9QHZrG5bfgz94wI38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4v0-IspVAi8adMLsk7R466DmMlpCmYmh_igodYHQ1-w&oe=6A3AB8B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Crazy", "keywords": [], "long_description": "This is a fun and exciting Gorilla Tag fan game where you and your friends can run, jump, and climb your way through all kinds of crazy environments! With intuitive movement mechanics, you\u2019ll feel like a real gorilla as you swing through the world, play different game modes, and just have a great time with others. Whether you're chasing your friends in a fast-paced game of tag or just exploring and messing around, there\u2019s always something fun to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ilKiiU0AqjWYuwMqx9mtJJ6Dsa1u12g0TtAFr4ZmhGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "H1unter/Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectcrazy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
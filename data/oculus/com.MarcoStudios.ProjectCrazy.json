8_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPObP0DkZSEQ7kNvwH7i8-K&_nc_oc=AdqA15IPZXK5lVo8OQF-bnpO791i_nnAhEF62JBQ2McbrxX5Yr-9-fgKL_BLoXMngXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8yoQ3WvWTDEv5LZaJKqdrWI5wOU3HyPPvkqra1EXkrQ&oe=6AFDD6B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Crazy", "keywords": [], "long_description": "This is a fun and exciting Gorilla Tag fan game where you and your friends can run, jump, and climb your way through all kinds of crazy environments! With intuitive movement mechanics, you\u2019ll feel like a real gorilla as you swing through the world, play different game modes, and just have a great time with others. Whether you're chasing your friends in a fast-paced game of tag or just exploring and messing around, there\u2019s always something fun to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ilKiiU0AqjWYuwMqx9mtJJ6Dsa1u12g0TtAFr4ZmhGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "H1unter/Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectcrazy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
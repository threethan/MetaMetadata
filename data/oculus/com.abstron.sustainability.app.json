mF4rquIbfq7ngC5ylnt53le3cP_p8Ld3bhxO8UfmNRTUefLBYFImY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOgQ_70X3a0_wpIbgfLM32R27FbwmkZZgjsOCKsJDXWw&oe=6ABBB281"}, {"file_name": "Screen-5.png", "id": "2163828141104722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623345_2163828144438055_2224858664025739643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtAzgYMkBOAQ7kNvwFNvIUh&_nc_oc=Adpd6FSyyYkHW6W11jUwfenTHYXc060UUr44ZwQHmLkbikN2QS_YokzZKY7bA-mTX1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrkh_MMK-B4KqYumpQ7VySZJz67stv_ySzPqtH4nmRxg&oe=6ABBDB05"}, {"file_name": "Screen-4.png", "id": "2524480611332907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_2524480614666240_3395347588962649257_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vblHjHhdvbkQ7kNvwGZ5BFE&_nc_oc=AdrA8gUbpVGl8cvt5VZrtlnfGiCjx9suh7i_2B7RVn_GJ9ynLqt8Q-74A8OTnvtizZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1iPeqyAaLnGGZdeVyByU0gHz8OVIT_fEfMpLDntlORA&oe=6ABBBCF8"}, {"file_name": "Screen-3.png", "id": "3105843569609296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622919_3105843572942629_570477464156608358_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRwWd8KyqcAQ7kNvwGHbV2Q&_nc_oc=Adrx43wN_cTQLLl4zauBuvKnZcz3kHpC2dfJxB-vPiL2rg-E25oQrPvCDY1gAuqqJ70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInXmwZX9PX5sEomJ6lUKdizPoQkcHB_d2RR9wgeM2mcA&oe=6ABBE252"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "S3Future - Sustainable Living Experience", "keywords": [], "long_description": "# Experience Sustainable Living in VR\n\nS3 Future VR is an immersive virtual reality experience where users can explore a peaceful sustainable eco-community designed around nature, self-sufficiency, and future living.\n\nWalk through eco-friendly homes, farming areas, ponds, livestock spaces, and community gathering zones while experiencing a connected and environmentally conscious lifestyle.\n\nExplore the world using multiple interactive modes:\n\n- \ud83d\udeb6 Walk Mode\n- \ud83d\ude97 Drive Mode\n- \ud83d\ude81 Helicopter View\n- \ud83d\udd4a Fly Mode\n\nDiscover the environment from ground level or enjoy cinematic aerial views of the entire sustainable community.\n\nS3 Future VR is designed for relaxation, exploration, environmental awareness, architecture visualization, and future community experiences.\n\nFuture updates will introduce:\n- \ud83c\udf0d Multiplayer exploration\n- \ud83d\udc64 Custom avatars\n- \ud83d\udd25 Bonfire gatherings\n- \ud83c\udf89 Community events and meetups\n\nWhether you want to experience sustainable living, explore future eco-community concepts, or simply enjoy a peaceful immersive VR environment, S3 Future VR offers a unique journey into the future of connected living.\n\nWalk it. Drive it. Fly above it. Experience the future in VR.", "short_description": "Explore a virtual sustainable community in VR featuring eco-homes, farms, ponds, livestock, crops, and social gathering spaces. Walk, drive, fly, and experience the future of peaceful community living."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvr Ltd", "support_website_url": null, "website_url": "https://s3future.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW3B3yRbVD8Q7kNvwGmEFHp&_nc_oc=Adr9vb8P9faVqqjdBoy5t7-iZsv3Y8iBxL6EzVH26LvC5f4NcJAZgjO5uvraOQNA-7g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT50NAg2WPAUe_6wi8eR_bKSVRLcsI-oeZfn-lCRib4w&oe=6A660A99"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UPoaUOoDmUQ7kNvwHOOI5Y&_nc_oc=AdqMp2jltXlp9TFR0lOsZ1qNjXsRGYzpkPfL1lK3SR_5vFzbtIi8kzuDYxussW0YW-Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWDNqvG4U6JplzyO2B2RoE5C8gXWTLVcdXvxvDzgrUvQ&oe=6A65F18B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "36269221144287
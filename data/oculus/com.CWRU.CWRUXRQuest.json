&_nc_ohc=FMA6ljsSd5QQ7kNvwGrOXYK&_nc_oc=Ado0Toqq-0Q-U5tmLEx04l66BfIMWFTzdZz7wlxxKMkyTr-BykDe3d3RhWMK3Yj3ALE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTm0-oTS2Zf6sDXFUZ688YHS0GAItRy2eCbYuq6RVlNAA&oe=6B0DB993"}, {"file_name": "CWRUXR-Quantum-Cut.png", "id": "614090867933410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392022_614090871266743_2000430809769570553_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNtvvODKd00Q7kNvwF_QR2O&_nc_oc=AdqecR6r2PTI-d6Iqt3vvQBr_K6sOF9VhojsO1eZJdrjKowlAqlVIs9Ph98s3Z76Bb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMoR2vStZ380VG2xCqAnmzeeu-ObjQCAPlFZXVPHpAKQ&oe=6B0DB159"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cyvfn0vIC4Q7kNvwEj2SxU&_nc_oc=Adqpdobtt5EojSw6S_mTqzAx1JTiMVBXCCeTPy9HGoYIw7IF7q21pakrwnahSAPlaM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjibATS1ys63gXM3lrgY2p-wcjNl8e6iPxFYIJUR6tHQ&oe=6B0DD08B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "9109526199176578"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "472803402539063"}, {"status": "PENDING", "id": "1278231643503258"}]}, "baseline_offer": {"id": "472803402539063"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738008000, "status": "PUBLISHED", "id": "472803402539063"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28738520035850569", "version": "5.3.1.10"}, "id": "1112049854294320", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8884167921712408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28738520035850569"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_na
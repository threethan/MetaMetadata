?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZqQUwQc53kQ7kNvwGDmgwE&_nc_oc=Adqmjwobdd9R6N2TFoqtJcC4ACPo2fRkjbB-Pl3Jh5pp2vstC2uA7jxCUO4jqRnMERo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPzwgnlg57Z0lj6b0TXgRV5W5jf-r51AMZQbWLcKbfrg&oe=6A5F7319"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3OzdZVC7JEQ7kNvwFVf604&_nc_oc=AdqOJXK7JS8YI7bqcJ-gEroJK87oRVLaEJAiM-k8EsRFerKh_2QI6QO7mnszdSgqg90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5WHyQ-w3R5oo7TUEar_gfmlSxveDTTnPgd1uPXY9ghQ&oe=6A5F5A0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "36269221144287
?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_coTZc0pQ_0Q7kNvwHo6SfW&_nc_oc=AdqYGoK1pX88r2UOakQEIRB9tRoDgvGC5Rurw5zspzxQOEJhzolsT87OGm98zQeb-vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dywn65VY4FhVaHTPD6TH_gyBhvz9aszDA2Kn2Djz6Sg&oe=6A3FCF19"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq4cCI8oupcQ7kNvwH8nnwL&_nc_oc=Adpkb_OGWvoMyu__8LVGcvNPNFQQYSijIDFge1NkDo3hg8j8tTmoyj42uLsTD-wADOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rSqRDm3n1oN9KqlGYB5DYVVbFjr4RhmnrzoPPVr_O4A&oe=6A3FEE4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "36269221144287
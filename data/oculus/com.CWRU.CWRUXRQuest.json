?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L83GEpuvBMgQ7kNvwFriM6_&_nc_oc=Adrfq9ygftUF_ZKsvmSopDGdOEwqdeORQAePjvjxQAFZpvYgTP-WzhRN6QtD_tgfsBk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElF1j-iClnRT8cpzdolfl72EBMMRyS5cdxvXmOQcbBTA&oe=6A806899"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXq57gFgdBIQ7kNvwFQbuc3&_nc_oc=Adr2LgQKf9HGPw5eNApUF38q8sg15-juAaqsY6BjLlymkwizyZdzAUJq1bt7t9Kfhi4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMVYgCkEfWmA6gt9rfYuyO_2uLix2bSJTBF_qxUVuvUQ&oe=6A804F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "36269221144287
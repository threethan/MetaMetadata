&_nc_ohc=OIASpylX7jwQ7kNvwGoN3m6&_nc_oc=AdohkmCNH_SAp59XVYeymZJ6WfYHOZ3zQHpKQTj9X3OpfWHge3rKKwuVH8k34IjFPBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5KXWaWCAz5Me9LJ5Oo-oqOt094Rvfzqo__qfBTNTGWg&oe=6B105C93"}, {"file_name": "CWRUXR-Quantum-Cut.png", "id": "614090867933410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392022_614090871266743_2000430809769570553_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL_Od38QvIMQ7kNvwHFt7pf&_nc_oc=AdrWnAV3RRKhqvs1NxpYbmh4AUXghU-j7IUzZWhhlC3g0VdK_3TreLRmNVraQNe1qyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAXO9_b_7fQZZTOBo9Tk1sqPk5FbIhxD1rpFWZD6RlCg&oe=6B105459"}, {"file_name": "CWRUXR-HoBi3.png", "id": "489728273784746", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473402323_489728277118079_5817081082081935424_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cyvfn0vIC4Q7kNvwGy6FTF&_nc_oc=AdqwMZLUr-3Xj3V7p9AzbGkY4tDZcI06Y6nnD7SSwkJYQcBXb4TMYwg74KwYYf-DNFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3klLO9urAB2uxrLTysvLyOe-d70ahPMOJVXPmGZRy_g&oe=6B103B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CWRUXR", "keywords": ["MixedReality", "Education"], "long_description": "Studies show that students learn faster and retain information better when using extended reality (XR). These trends extend into industry, where XR training programs elevate novice learners to experts, faster and more efficiently. Until recently, however, getting started in XR required significant investments in talent, software, and time.\n\nOur newest framework, CWRUXR (pronounced \"Cruiser\"), allows users to bypass those hurdles and start reaping the benefits of XR right away. Creators with no or limited coding skills can develop and experience 3D content. Additionally, CWRUXR allows for real-time iteration, shared group experiences together or remotely, and can partner with AI.", "short_description": "The fastest on-ramp to XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cwruxrprivacypolicy.z14.web.core.windows.net/", "developer_terms_of_service_url": null, "publisher_name": "Interactive Commons", "support_website_url": null, "website_url": "https://interactivecommons.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "9109526199176578"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "472803402539063"}, {"status": "PENDING", "id": "1278231643503258"}]}, "baseline_offer": {"id": "472803402539063"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738008000, "status": "PUBLISHED", "id": "472803402539063"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28738520035850569", "version": "5.3.1.10"}, "id": "1112049854294320", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8884167921712408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28738520035850569"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_na
8E7kMYQ7kNvwEOCoPV&_nc_oc=Adp-vi36EH2NI6KO8fzQSHLBjTM7t_eA1v3wZnFTuacLYD9WMnZvP19qswbhJsMmEnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25IcQslTz2asZY7b9COyuwwd4zMwRNi3mkgjEKwazWjA&oe=69E0F139"}, {"file_name": "migrated_image.png", "id": "2600925290163734", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_1457874804331191_9180376497939021824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip8fAjPHZ0YQ7kNvwHJJDaS&_nc_oc=Adr-8o9e-z_eIbdVAfUnJeLVuAOKrEdALxJOLSeAstBvAeZFJb70fl6kaNQLfxX49l0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gz9G2aiCUE4jF06Yfrdq-Je6-H_zrwAvv_a7FdGukSw&oe=69E0F61B"}, {"file_name": "migrated_image.png", "id": "238816354187646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1459102564157802_1576258641219026944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEsjx8td2xAQ7kNvwHQmQh5&_nc_oc=AdrR8QlFTyD3J71cvANIyAK7lawQGuLw23F28fCY-T3FwvE0ZsCN6-FH6d4sdLGdR74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aCPzkqVmQYD6iJzASc7y9Dp6wu3zx7-JcMdWrknPm7w&oe=69E0E045"}, {"file_name": "migrated_image.png", "id": "350318102529806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_140120660066762_1988633423563980800_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5iKPRlcUCcQ7kNvwEaUp2M&_nc_oc=AdpgirI6-PobOWx1ZWkW90aplFi2hC2m6tqD6QLXpEz5J8G-fnFWtkVNEe0cKssspWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eORpSh44S8Z39W701UVONL7ue3xKy95qb43uwEVkCLw&oe=69E0D06B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azul - Mindfulness and Relaxation", "keywords": ["mindfullness", "meditation", "relax", "relaxing", "meditate"], "long_description": "Azul is a VR experience designed to relax and refocus the mind. Our simple, guided meditations are designed to reduce stress and anxiety, increase creativity and efficiency, and promote high level health and wellness.\nBe transported to 6 beautiful, rich 360 scenes including:\n-\tWatsons Bay\n-\tCandle\n-\tAlpine plain\n-\tCliffside\n-\tRocky lake\n-\tSummit\n*Additional scenes will be available to purchase in the future.\nOur guided voice meditations are:\nCalming \u2013 A meditation to calm your nerves and re-centre emotions\nConfidence \u2013 Increase your self-confidence with this empowering meditation\nBreathing \u2013 Focus on your breathing with this relaxing mindfulness exercise\nChoose to complement your experience with unobtrusive ambient music. This soundscape also includes directional audio to immerse you in the scene.", "short_description": "Welcome to Azul \u2013 Mindfulness and Relaxation\nTake some time out of our day to relax and refocus your mind with our immersive, guided meditations."}]}, "developer_name": "The Pulse", "developer_privacy_policy_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "publisher_name": "The Pulse", "support_website_url": null, "website_url": "http://www.experiencethepulse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1741015316091847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_1387412041376612_7875850048012025856_n.png?stp=dst-png_s360
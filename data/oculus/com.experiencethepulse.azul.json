nt-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlvBMfrHVOrnp_42jkFYVgb0rFxTN1BGplXKtPU2LkIA&oe=6AE9DDC5"}, {"file_name": "migrated_image.png", "id": "350318102529806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_140120660066762_1988633423563980800_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw5gGcwIHVkQ7kNvwFH6DEQ&_nc_oc=Adqf5yQP7nuZen67cIsjwLbgnrHAPYOU1kz7gKyk5KV_-Tt9-CJWDp6-49waaK1JVyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRBfjnsTG4X9cST4ACG0Qw2nNdFRbt3nN_UOW7R7hpOA&oe=6AEA062B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azul - Mindfulness and Relaxation", "keywords": ["mindfullness", "meditation", "relax", "relaxing", "meditate"], "long_description": "Azul is a VR experience designed to relax and refocus the mind. Our simple, guided meditations are designed to reduce stress and anxiety, increase creativity and efficiency, and promote high level health and wellness.\nBe transported to 6 beautiful, rich 360 scenes including:\n-\tWatsons Bay\n-\tCandle\n-\tAlpine plain\n-\tCliffside\n-\tRocky lake\n-\tSummit\n*Additional scenes will be available to purchase in the future.\nOur guided voice meditations are:\nCalming \u2013 A meditation to calm your nerves and re-centre emotions\nConfidence \u2013 Increase your self-confidence with this empowering meditation\nBreathing \u2013 Focus on your breathing with this relaxing mindfulness exercise\nChoose to complement your experience with unobtrusive ambient music. This soundscape also includes directional audio to immerse you in the scene.", "short_description": "Welcome to Azul \u2013 Mindfulness and Relaxation\nTake some time out of our day to relax and refocus your mind with our immersive, guided meditations."}]}, "developer_name": "The Pulse", "developer_privacy_policy_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/
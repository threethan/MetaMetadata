6zfw98Q7kNvwEeX0jo&_nc_oc=AdrrnWOtQFvEJOepZv-hcKPhjIkM_afKNnGbvN9fXq2plcoVUHuFQECOw5QjI4wgQlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxY3n6iGpnT56JZNL0rrCFchBTPuMBgPg89rapc3X-UQ&oe=6AE205B9"}, {"file_name": "migrated_image.png", "id": "2600925290163734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162703_1457874804331191_9180376497939021824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BauJd4-fDTQQ7kNvwERvyii&_nc_oc=AdrBeE13NLjxCEFse_lWLh0Akuz3dYa1AAEYoBT6WiBv-70-gAZWrr_2BT5gP9Li2m4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLj0HXw5eoEiPKs7VRIIiWG7bq_2kwC-vYD8eCizFakA&oe=6AE20A9B"}, {"file_name": "migrated_image.png", "id": "238816354187646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1459102564157802_1576258641219026944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFGkR8UgoY4Q7kNvwErT8fJ&_nc_oc=AdqRNy9ldJSx3VMJLpr9YVfI1dxS9CbX7BvfGY2XZpe-_PLYWIVYw1DoefkmMS7OL_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk6ae_po6iiHMI3Q30GUx1dU2zkoBH2Ru4H7MGfg-loA&oe=6AE1F4C5"}, {"file_name": "migrated_image.png", "id": "350318102529806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_140120660066762_1988633423563980800_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqq__4Pp4FUQ7kNvwEAKqjB&_nc_oc=AdrYziX0q8jv0Eh5f0QPBjQSYv3oKFHyq-wxYETXyixz4S462ZaIEQhQFhZg7wg4aAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzazLjeVM_37bnlbg4plEUvrHfADIrqUn6qsz7Lg_-jw&oe=6AE21D2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azul - Mindfulness and Relaxation", "keywords": ["mindfullness", "meditation", "relax", "relaxing", "meditate"], "long_description": "Azul is a VR experience designed to relax and refocus the mind. Our simple, guided meditations are designed to reduce stress and anxiety, increase creativity and efficiency, and promote high level health and wellness.\nBe transported to 6 beautiful, rich 360 scenes including:\n-\tWatsons Bay\n-\tCandle\n-\tAlpine plain\n-\tCliffside\n-\tRocky lake\n-\tSummit\n*Additional scenes will be available to purchase in the future.\nOur guided voice meditations are:\nCalming \u2013 A meditation to calm your nerves and re-centre emotions\nConfidence \u2013 Increase your self-confidence with this empowering meditation\nBreathing \u2013 Focus on your breathing with this relaxing mindfulness exercise\nChoose to complement your experience with unobtrusive ambient music. This soundscape also includes directional audio to immerse you in the scene.", "short_description": "Welcome to Azul \u2013 Mindfulness and Relaxation\nTake some time out of our day to relax and refocus your mind with our immersive, guided meditations."}]}, "developer_name": "The Pulse", "developer_privacy_policy_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "publisher_name": "The Pulse", "support_website_url": null, "website_url": "http://www.experiencethepulse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1741015316091847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162737_1387412041376612_7875850048012025856_n.png?stp=dst-png_s360
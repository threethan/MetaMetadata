aFJpG0Q7kNvwHUbsRj&_nc_oc=AdqvUccX2XPmP_XxbCtugh7xgKyrQcjK84QejDpz8FsNrqfsCI34fOO_vud83ev3wQc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SyOBksJ_YL-gddp5oe05cM58fh11LQPGy5s3BuXci9g&oe=6A19A1B9"}, {"file_name": "migrated_image.png", "id": "2600925290163734", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162703_1457874804331191_9180376497939021824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0T__5XoNH8Q7kNvwHH91Kj&_nc_oc=AdoV7CGUl0MT3z1VRj1KHLXM9c3gLOwKd0EqkcCwWDYWAXWb7L0sh7ZAItgTdFoMFIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wN7rnz6TnZ6iBgxkAhb304eAYV9V9gRSFBYF33VmHgw&oe=6A19A69B"}, {"file_name": "migrated_image.png", "id": "238816354187646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_1459102564157802_1576258641219026944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbUqCV37iYcQ7kNvwF9OMSX&_nc_oc=AdrcVEHuIgVK47-W-A1VlGXKdL_hd1oMaLh16yiARDcQpjKZF_teP6iMcsuf2o5dilU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kB3EtSJclflO1r6Q0HFNEzDDSN2qIEzq9QInGL1zZaQ&oe=6A1990C5"}, {"file_name": "migrated_image.png", "id": "350318102529806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_140120660066762_1988633423563980800_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R6aSlvVDgMQ7kNvwGvhZee&_nc_oc=AdqYvd7YW0cV9mA0NNKZuggfTU8xr25-m_kEPVGy_8JjUqqJ7gR2AMY1A62ygNZMsfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vbCfLKnejMPIJkMdiTrHXOpjXg-mEBPHzKmvZHsL6dg&oe=6A19B92B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Azul - Mindfulness and Relaxation", "keywords": ["mindfullness", "meditation", "relax", "relaxing", "meditate"], "long_description": "Azul is a VR experience designed to relax and refocus the mind. Our simple, guided meditations are designed to reduce stress and anxiety, increase creativity and efficiency, and promote high level health and wellness.\nBe transported to 6 beautiful, rich 360 scenes including:\n-\tWatsons Bay\n-\tCandle\n-\tAlpine plain\n-\tCliffside\n-\tRocky lake\n-\tSummit\n*Additional scenes will be available to purchase in the future.\nOur guided voice meditations are:\nCalming \u2013 A meditation to calm your nerves and re-centre emotions\nConfidence \u2013 Increase your self-confidence with this empowering meditation\nBreathing \u2013 Focus on your breathing with this relaxing mindfulness exercise\nChoose to complement your experience with unobtrusive ambient music. This soundscape also includes directional audio to immerse you in the scene.", "short_description": "Welcome to Azul \u2013 Mindfulness and Relaxation\nTake some time out of our day to relax and refocus your mind with our immersive, guided meditations."}]}, "developer_name": "The Pulse", "developer_privacy_policy_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1W_nOnqVjflTOVVZVPSkiH9cTVH9MLogoL-QfCeDy35A/edit?usp=sharing", "publisher_name": "The Pulse", "support_website_url": null, "website_url": "http://www.experiencethepulse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1741015316091847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162737_1387412041376612_7875850048012025856_n.png?stp=dst-png_s360
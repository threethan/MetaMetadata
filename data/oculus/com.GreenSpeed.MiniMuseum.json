=7f20f&oh=00_Af6_sS4JrxmqyPGZAlj3C9Mkre_3EwqymjUul-TE5PYVZA&oe=6A1ED980"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)1@1x.png", "id": "667066202924801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392104_667066206258134_7543880294407519053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOf6KWGcAvUQ7kNvwHYqlDY&_nc_oc=AdrS59OooXuuHRUu7Ts23_tgQAeSau2PgK9Hhp7W-pPoG2pRJyRcgbos6J5wSdwlyBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f6JN55YxQ0gcNaVHU7p5y7QPD8JIIJJ8FX7czhNNEmA&oe=6A1EF123"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)2@1x.png", "id": "9039728616131417", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823381_9039728619464750_5252774077275070212_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ko9H1sc2p4Q7kNvwGClhuV&_nc_oc=AdpNPYA9vxfw0fi28u1y34YKWx52BfjqqfMmvEmoGf9pBb9Ac6U3sZbOxDqWVcLEBNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cnpt8BjOoKyPgyVK614lhZn-ZVWcpCYzk_8-XigABcg&oe=6A1EE311"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)3@1x.png", "id": "654783817519484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392182_654783820852817_5118396049865181026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzvGxSHaXI8Q7kNvwEjEidU&_nc_oc=Adrq6CjCAyfJulAyVilcsA2L1GTNk9_4qRtaioBWOOO29pAV9l3uu97rTyTXv0w2W9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wULgUIcZ34mM4I8wNeqlPCODIfS3jG_G99MnK52Ndog&oe=6A1EEE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc(2560x1440)@1x.png", "id": "642054762160291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819950_642054768826957_5653212766017132647_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAS7wnm6Gh4Q7kNvwGzO4NF&_nc_oc=AdpWrf5O9NWMk2ahMsA8loaN_mc5OglWtcziIJARkfBviOc1PVAT-fcfLbSq5Wrza5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56zHWT9GaqY3MCmkahFfJGrFBzFwCtSUlbRKj4xIglSA&oe=6A1EF5E8"}, "display_name": "Mini Museum", "keywords": ["Museum", "Gallery", "Dinosaur"], "long_description": "Mini Museum delivers a rich, bite\u2011sized VR museum experience. It features nine exhibits\u2014three dinosaurs, three real animals, and three entirely fictional creatures. For the dinosaurs and real animals, each display includes an embedded link to its Wikipedia page, so users can dive deeper when online.\n\nA play\u2011button icon appears to the left of every exhibit; tapping it zooms in the model for close\u2011up viewing. Using the middle\u2011finger trigger on a Meta controller, you can grab any exhibit to move and rotate it freely.\n\nBeyond the standard museum setting, you can instantly swap to alternative environments\u2014like a magma\u2011surrounded lava world\u2014letting you enjoy the collection in dramatically different VR backdrops", "short_description": "A VR gallery showcasing nine models\u2014three dinosaurs, three real animals, and three fictional creatures\u2014that you can zoom into and grab, with Wikipedia links for real exhibits and switchable museum or lava\u2011world backdrops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://green-speed.co.jp/privacy-policy-mini-museum/", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Hub", "support_website_url": null, "website_url": "https://green-speed.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "sup
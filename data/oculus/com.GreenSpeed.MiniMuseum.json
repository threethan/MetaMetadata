=7f20f&oh=00_Af4XmUJHm9LAcB9xDjMLjug8ip74h7w-1SVU_TKBsTMlTA&oe=6A12FC00"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)1@1x.png", "id": "667066202924801", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392104_667066206258134_7543880294407519053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTw_opklM8YQ7kNvwFQQvCl&_nc_oc=AdrJfTdF0gbMa53Tcc31sKmgRt45ohtDqBZnkUpkSsR0_NL2rn0mTy-yFNU-l3Mtbnw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n4nzt4_aoMAkyCV4pRKl4r-nVVIhXqa-PtiBTR1Ysfg&oe=6A1313A3"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)2@1x.png", "id": "9039728616131417", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823381_9039728619464750_5252774077275070212_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_weU_fWdLoQ7kNvwEL_G_Z&_nc_oc=Adq8e76upOokvClo4jDR16bljc5zCwOFffZBtq_Nb11KW0B1YlgWBIXays_bDsaRDjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50rAykqL7DDE73iS7PPldnUKUqr7h0RWvjyyzzVoKXXg&oe=6A130591"}, {"file_name": "\u30b9\u30af\u30b7\u30e7(2560x1440)3@1x.png", "id": "654783817519484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392182_654783820852817_5118396049865181026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGQ4wbcSjxQQ7kNvwGSkUJP&_nc_oc=Adqch3EK0iM-1DDqYLLLDaTZD7zUxczsPy0KqtDpKLuu0bBkUt7FygBENDcmik3AmPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W-Toyr62aP_RcIb4iAYoa1yeXRubeuFPGElW0y0ievQ&oe=6A131093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc(2560x1440)@1x.png", "id": "642054762160291", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819950_642054768826957_5653212766017132647_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQh-kcyIjhkQ7kNvwGyH348&_nc_oc=Ado_7WdvoWOaWcjXrh6aDkYyY76_pnydom2l4PAwoDzkO6LYJkTADw-YZMRmedS9QNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OvoouBa6mNsc1tTPM5B1lbUD1cXKLBholIvtA0xKY_A&oe=6A131868"}, "display_name": "Mini Museum", "keywords": ["Museum", "Gallery", "Dinosaur"], "long_description": "Mini Museum delivers a rich, bite\u2011sized VR museum experience. It features nine exhibits\u2014three dinosaurs, three real animals, and three entirely fictional creatures. For the dinosaurs and real animals, each display includes an embedded link to its Wikipedia page, so users can dive deeper when online.\n\nA play\u2011button icon appears to the left of every exhibit; tapping it zooms in the model for close\u2011up viewing. Using the middle\u2011finger trigger on a Meta controller, you can grab any exhibit to move and rotate it freely.\n\nBeyond the standard museum setting, you can instantly swap to alternative environments\u2014like a magma\u2011surrounded lava world\u2014letting you enjoy the collection in dramatically different VR backdrops", "short_description": "A VR gallery showcasing nine models\u2014three dinosaurs, three real animals, and three fictional creatures\u2014that you can zoom into and grab, with Wikipedia links for real exhibits and switchable museum or lava\u2011world backdrops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://green-speed.co.jp/privacy-policy-mini-museum/", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Hub", "support_website_url": null, "website_url": "https://green-speed.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "sup
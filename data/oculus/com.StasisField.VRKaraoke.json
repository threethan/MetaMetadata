74805_1177392399952497_361609265701854980_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_ivmq0XtKEQ7kNvwFmW4dj&_nc_oc=Ado8u2qqxeM2tqtBIjU_fuAoU56Vn-HhofBRF1zZQfn3TRkZ1ylAXfoUWu8Dj0f3N8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc0JJKiXYC0ofXhw0udg6dbiNj3IBQHuK3PS689ha-Nw&oe=6B09B507"}, {"file_name": "image (8).png", "id": "998387552003168", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036656_998387555336501_1041508412027266609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4nh5qGMlg4Q7kNvwFVx3Mu&_nc_oc=AdqXLE814HxwmIAgpCIrwF9ildOlyrOmz5KNf1bsGBLg9eKR107xnct1kfLZ_YvRGbs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoGw8HxcHZ73dFgt2Do_RrElLGv2hiBXpmNU9rSv5_JQ&oe=6B09B7E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "343595785223679", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035310_343595788557012_4607738394468203131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azM_cNtWLLIQ7kNvwFIQNxU&_nc_oc=AdoWuucDtmVQ1xSEsS0ueERfe03ghGMQj0F1b9J-SyhYuTCF8DOUXRHyobc4cs8iJY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfCZVrMb2cAVqDESp8DADMZHivq7_FfCBcT1hLncOZ_Q&oe=6B09BB91"}, "display_name": "SingRoom (\uc2f1\ub8f8)", "keywords": [], "long_description": "This service is not supported in your country.\nCurrently, we are only providing this service in South Korea.\nWe appreciate your understanding.\n\n[Great Spaces for Singing]\nFrom realistic recreations to fantastical virtual environments, experience spaces that are perfect for singing.\n\n[Karaoke Features like Microphone Effects]\nEnjoy a variety of fun with echo and other microphone effects and karaoke functions.\n\n[A Wide Selection of Songs]\nFrom familiar tunes to new tracks, sing your favorite songs, with new songs added continuously.\n\n[Connecting Through Music]\nEnjoy music solo or engage in multiplayer and social interactions, connecting with new friends through music.\n\nStart your performance and create memories with XR entertainment centered around music!", "short_description": "SingRoom is a VR social karaoke.\nEnjoy your favorite songs alone or together in stunning spaces!\nStart your performance and create memories with XR entertainment centered around music!"}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.singroom.com/privacypolicy", "developer_terms_of_service_url": "https://www.singroom.com/termsofservice", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.singroom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7311938835576236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031590_415561818114285_886423097653337494_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDSvpsgvzT8Q7kNvwHAuZPv&_nc_oc=AdpcC1Igp9sKW6GDcY6NC-wnr6K4JdiPkVW6Bgzt5W7dBMGsnDjo8fzV9k7DaBvDnSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBcI7Q-gI5Xax_hplDntJlWi6J9AeLizZiCkG5eedqJw&oe=6B09A545"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SingRoom (\uc2f1\ub8
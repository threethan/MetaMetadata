74805_1177392399952497_361609265701854980_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2e3ooc6ZwBwQ7kNvwHx4PSb&_nc_oc=Ado4ZL0Z_jkaCmD50Uu3dlaVSKgNHpm7PFC2DwSK0qjzk_tykM9XlPbe9vX84MdSZY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1bvcTERf7DZGUJ78lcVdJ0oGyKvEh9teP1JD2YTzg1g&oe=6AFC8607"}, {"file_name": "image (8).png", "id": "998387552003168", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036656_998387555336501_1041508412027266609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnYDkftEFiwQ7kNvwEkINaz&_nc_oc=AdosAS2iNxauXt6Qu4oUDIRqDUYcYDn7k_NrU3JffQ3vdrCiLo9cVdZG0_VxODV5Di4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOAhGDlz7ILbbzFEjmNF47zdczUufWO3k96ZYNuxGf7A&oe=6AFC88E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "343595785223679", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035310_343595788557012_4607738394468203131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGZEFNOSFpUQ7kNvwHBQjsJ&_nc_oc=AdppF41U5ykmGAJGTkydSH8qe4EKDhNdtGs9sLQsHrMEfKcTGyE8LEEREf7UjpceRWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD0Z-f4fZwHo5tQOJ9HHuJSZDj0ufXu1o3JbRyR10tlg&oe=6AFC8C91"}, "display_name": "SingRoom (\uc2f1\ub8f8)", "keywords": [], "long_description": "This service is not supported in your country.\nCurrently, we are only providing this service in South Korea.\nWe appreciate your understanding.\n\n[Great Spaces for Singing]\nFrom realistic recreations to fantastical virtual environments, experience spaces that are perfect for singing.\n\n[Karaoke Features like Microphone Effects]\nEnjoy a variety of fun with echo and other microphone effects and karaoke functions.\n\n[A Wide Selection of Songs]\nFrom familiar tunes to new tracks, sing your favorite songs, with new songs added continuously.\n\n[Connecting Through Music]\nEnjoy music solo or engage in multiplayer and social interactions, connecting with new friends through music.\n\nStart your performance and create memories with XR entertainment centered around music!", "short_description": "SingRoom is a VR social karaoke.\nEnjoy your favorite songs alone or together in stunning spaces!\nStart your performance and create memories with XR entertainment centered around music!"}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.singroom.com/privacypolicy", "developer_terms_of_service_url": "https://www.singroom.com/termsofservice", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.singroom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7311938835576236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031590_415561818114285_886423097653337494_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXnIJnzBnUYQ7kNvwE4qUpV&_nc_oc=Adqw-LQAXTb_qf0PTQQ1BneJbCUeCAAoZuttk5hQr4NtiijlBHD8bCJtEEtOt4_-kw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQubY3FlKdOSBafdRYUIExTQR2CYUZU4xTiJdWlmLZGwA&oe=6AFC7645"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SingRoom (\uc2f1\ub8
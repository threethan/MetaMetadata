YqDQgo4Zg&oe=69BFE8A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "343595785223679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035310_343595788557012_4607738394468203131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbqrzl7xyUgQ7kNvwEO-_Sf&_nc_oc=AdlSdq4woU9He0QMeiJPufq1gsfgAYgzCeKZhJppfyrVQJNKhiYFi_4z2-nexPHgVkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRIGyCHXPi17H8tp_ChrKwwBGsRCAtvrNTOUUFWtDdWg&oe=69BFEC51"}, "display_name": "SingRoom (\uc2f1\ub8f8)", "keywords": [], "long_description": "This service is not supported in your country.\nCurrently, we are only providing this service in South Korea.\nWe appreciate your understanding.\n\n[Great Spaces for Singing]\nFrom realistic recreations to fantastical virtual environments, experience spaces that are perfect for singing.\n\n[Karaoke Features like Microphone Effects]\nEnjoy a variety of fun with echo and other microphone effects and karaoke functions.\n\n[A Wide Selection of Songs]\nFrom familiar tunes to new tracks, sing your favorite songs, with new songs added continuously.\n\n[Connecting Through Music]\nEnjoy music solo or engage in multiplayer and social interactions, connecting with new friends through music.\n\nStart your performance and create memories with XR entertainment centered around music!", "short_description": "SingRoom is a VR social karaoke.\nEnjoy your favorite songs alone or together in stunning spaces!\nStart your performance and create memories with XR entertainment centered around music!"}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.singroom.com/privacypolicy", "developer_terms_of_service_url": "https://www.singroom.com/termsofservice", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.singroom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27433
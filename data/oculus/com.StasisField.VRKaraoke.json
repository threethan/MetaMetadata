738394468203131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKrfWtL3SswQ7kNvwG-BWWt&_nc_oc=AdmzSqwvNVIa9ApIdxHoLMaBuFS87k95E3nfRcLghdJmJYmDFXxpwJLDVRoWAhzhgRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvbXq7rOeFoCuc6PlYgB66aA6WcmAhv4K5V0CoHFbsk8g&oe=69A43CD1"}, "display_name": "SingRoom (\uc2f1\ub8f8)", "keywords": [], "long_description": "This service is not supported in your country.\nCurrently, we are only providing this service in South Korea.\nWe appreciate your understanding.\n\n[Great Spaces for Singing]\nFrom realistic recreations to fantastical virtual environments, experience spaces that are perfect for singing.\n\n[Karaoke Features like Microphone Effects]\nEnjoy a variety of fun with echo and other microphone effects and karaoke functions.\n\n[A Wide Selection of Songs]\nFrom familiar tunes to new tracks, sing your favorite songs, with new songs added continuously.\n\n[Connecting Through Music]\nEnjoy music solo or engage in multiplayer and social interactions, connecting with new friends through music.\n\nStart your performance and create memories with XR entertainment centered around music!", "short_description": "SingRoom is a VR social karaoke.\nEnjoy your favorite songs alone or together in stunning spaces!\nStart your performance and create memories with XR entertainment centered around music!"}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.singroom.com/privacypolicy", "developer_terms_of_service_url": "https://www.singroom.com/termsofservice", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.singroom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
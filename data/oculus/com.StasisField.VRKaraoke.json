w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxsMWQcHQBfHdd_alkhw2z4rWnnfWAUnZOnTekVgiSAQ&oe=6AF1FCE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "343595785223679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035310_343595788557012_4607738394468203131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9d-Sc1qr0UQ7kNvwGeE5Um&_nc_oc=AdpAspiUcZ4kNh9EHVNyWlDO8EY_VHcU65ktw0vnDIwkrdIh5GQjhXFQTtESujiYEkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEAbqWsknlG6vogglkARVVskBPWyUojYjdZWDd5mWEBw&oe=6AF20091"}, "display_name": "SingRoom (\uc2f1\ub8f8)", "keywords": [], "long_description": "This service is not supported in your country.\nCurrently, we are only providing this service in South Korea.\nWe appreciate your understanding.\n\n[Great Spaces for Singing]\nFrom realistic recreations to fantastical virtual environments, experience spaces that are perfect for singing.\n\n[Karaoke Features like Microphone Effects]\nEnjoy a variety of fun with echo and other microphone effects and karaoke functions.\n\n[A Wide Selection of Songs]\nFrom familiar tunes to new tracks, sing your favorite songs, with new songs added continuously.\n\n[Connecting Through Music]\nEnjoy music solo or engage in multiplayer and social interactions, connecting with new friends through music.\n\nStart your performance and create memories with XR entertainment centered around music!", "short_description": "SingRoom is a VR social karaoke.\nEnjoy your favorite songs alone or together in stunning spaces!\nStart your performance and create memories with XR entertainment centered around music!"}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.singroom.com/privacypolicy", "developer_terms_of_service_url": "https://www.singroom.com/termsofservice", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.singroom.com/", "cate
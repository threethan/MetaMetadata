2\u305f\u3089\u3059\u30aa\u30fc\u30d6\u304c\u60aa\u306e\u30c9\u30e9\u30b4\u30f3\u306b\u596a\u308f\u308c\u305f\uff01\n\n\u52c7\u8005\u304c\u4eca\u3001\n\u30aa\u30fc\u30d6\u3092\u53d6\u308a\u623b\u3059\u305f\u3081\u306b\n\u3042\u306a\u305f\u3068\u5171\u306b\u65c5\u7acb\u3061\u307e\u3057\u305f\uff01", "short_description": "\u30b8\u30e3\u30f3\u30d7\u3084\u30c0\u30c3\u30b7\u30e5\u3092\u99c6\u4f7f\u3057\u3066\u30b9\u30c6\u30fc\u30b8\u306e\u30b4\u30fc\u30eb\u3092\u76ee\u6307\u305b\uff01\n\n\u6614\u61d0\u304b\u3057\u3044\u3001\n2D\u98a8\u30b8\u30e3\u30f3\u30d7\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u304c\u767b\u5834\uff01\n\n\u30d3\u30fc\u30c1\u3001\u548c\u98a8\u3001\u6c37\u306e\u4e16\u754c\u306a\u3069\u500b\u6027\u8c4a\u304b\u306a\u30b9\u30c6\u30fc\u30b8\u3001\n\u30b7\u30f3\u30d7\u30eb\u306a\u304c\u3089\u3082\u5965\u6df1\u3044\u3001\n\u601d\u308f\u305a\u71b1\u4e2d\u3057\u3066\u3057\u307e\u3046\u96e3\u6613\u5ea6\u306e\u30b9\u30c6\u30fc\u30b8\u304c\u3042\u306a\u305f\u3092\u5f85\u3064\uff01\n\n\u3055\u3042\u30012D\u98a8\u306e\u4e16\u754c\u306b\u65c5\u306b\u51fa\u3088\u3046\uff01"}, {"images": {"nodes": [{"file_name": "transerogo.png", "id": "532373978016467", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035454_532373981349800_5940232288632359337_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4tNVeWC_ywQ7kNvwHIDcwv&_nc_oc=Adkt6GwY41GydzBsBQi3MEtgmOfJxG64Qd8jyrxNdKOoJtyBAPqiR3qXuWuFhbZp-94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlncD5oyZhPUvje50JIiHaLw3nOLAbeRw1-BXCCEucMg&oe=69B55CB8"}, {"file_name": "yyoko.png", "id": "875097223359871", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974759_875097226693204_5800282339439131436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL7W_gtlSa8Q7kNvwFB2RQn&_nc_oc=Adlgip2qrO-tM76PehPzru7-OP3jE-CUGdH87gScKwC3GH-tnQzuzu5Q-S6XKOYYga8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=0
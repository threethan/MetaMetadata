056"}, {"file_name": "GameStorm - Crazy Croquet - Molten Monster Madness - Player 2.png", "id": "3969811156597445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391862_3969811159930778_5025549885913672345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7dO-48kdKgQ7kNvwHrhy9c&_nc_oc=AdpFNXeWJvpppCEO5I5xUmxJxWrRVUgHkvL35d54ZS6OBSy2u9_pJzdEa6zDp83mjfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFR6slOfE2cLk47Wt7u3PEN6iG-1AjWnZxEI0MldkMQ&oe=6AE09ED9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2550x1440.png", "id": "923217716553510", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400716_923217719886843_4981941182010633762_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7-vDZJPToIQ7kNvwGKkF38&_nc_oc=Adqu9y-nPGMC49xyL7YwS_Dl1p7phg41L1h321R3qVYxkTIBisevybkIWp1ggVFRIXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuIch9tl9NqydXIwXn_PJgg_ayZwXKfuZWJ7m8RhBXig&oe=6AE0B89B"}, "display_name": "GameStorm", "keywords": ["sandbox", "create", "playground", "toolset", "animation"], "long_description": "GameStorm \u2013 Build, Play, and Share Games in Real Time!\n\nUnleash your creativity with GameStorm, the real-time, multiplayer game creation toolset that lets you bring your ideas to life \u2013 no coding or art skills required! Design, play, and share unique games effortlessly with friends.\nJumpstart your creations with ready-made assets, intuitive tools, and powerful gameplay mechanics across multiple genres, beginning with Crazy Croquet, a thrilling mix of ball games, puzzles, and platforming... or whatever you want to make!\n\nWhat makes GameStorm awesome?\n- Easy Level Creation \u2013 Craft worlds using a massive asset library and simple 3D building tools.\n- Bring Your Game to Life \u2013 Animate with keyframe posing, puppeteering, motion capture, and physics.\n- Create Exciting Gameplay \u2013 Use triggers to set up cause-and-effect mechanics.\n- Standalone Player Mode \u2013 Jump into the action and play your creations with friends.\n- Real-Time Collaboration \u2013 Work remotely with others to build and play together.\n\nPowered by FirstStage VR, GameStorm makes game creation fast, fun, and limitless. Start building your dream game today!", "short_description": "GameStorm \u2013 Create, Play, and Share in Real Time!\n\nTurn your wildest game ideas into reality \u2013 no coding or art skills needed! GameStorm lets you build and play games instantly with friends. Mix and match scenes, assets, and mechanics to craft unique game mashups.\nKickstart your journey with Crazy Croquet, a wild blend of ball games, puzzles and platforming.\n\nFast, fun, and limitless \u2013 start creating now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://firststage.moviestorm.co.uk/firststage-privacy-policy/", "developer_terms_of_service_url": "http://firststage.moviestorm.co.uk/firststage-terms-of-service/", "publisher_name": "Moviestorm Limited", "support_website_url": "https://firststage.moviestorm.co.uk/about-us/contact-us/", "website_url": "https://firststage.moviestorm.co.uk/solutions/gamestorm/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9319070244875285"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "974493027921285"}]}, "baseline_offer": {"i
aceWorld", "solarsystem", "Universe"], "long_description": "Depart to unlimited Universe.\nUpon wearing VR gear, you can depart to Universe.\n\nObserve and move to Universe and planets in the solar systems including Earth wearing a space suit.\nYou can see Sun, Mercury, Venus. Earth, Moon, Mars, Jupitor, Satune, Uranos, Neptune and other asteroids and meteorites.\n\nGame operation\nThis game uses touch pad and eye tracking of VR gear.\nThis game uses the eye tracking for direction choice.", "short_description": "Wearing a VR gear and watch solar system as an astronaut.\nLook roud planets using a space suit.\nExperience and study Universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://einpicturescafe.mycafe24.com/terms-of-service/", "developer_terms_of_service_url": null, "publisher_name": "eiNpictures", "support_website_url": null, "website_url": "http://www.einpictures.co.kr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25073498185577409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162727_206327716569126_1454863619685613568_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMB_RD2WysUQ7kNvwG02bo-&_nc_oc=AdqbJv9WDUxwUpeUvvAsTdWpl4qpZgx9QPp9EMWulzXlgKY5YFMkTksqwkOH30RXStc&_nc_zt=3&_nc_ht=
5d0 \ub4f1\uc7a5\ud558\ub294 \uc8fc\uc694 \ud589\uc131\n\ud0dc\uc591, \uc218\uc131, \uae08\uc131, \uc9c0\uad6c, \ub2ec, \ud654\uc131, \ubaa9\uc131, \ud1a0\uc131, \ucc9c\uc655\uc131, \ud61c\uc655\uc131, \uba85\uc655\uc131, \uadf8\uc678 \uc18c\ud589\uc131\uacfc \uc6b4\uc11d\n\n* \uac8c\uc784\uc870\uc791\n\ubcf8 \uac8c\uc784\uc740 GearVR\uc758 \ud130\uce58\ud328\ub4dc\uc640 \uc2dc\uc120\ud2b8\ub808\ud0b9\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n\ubcf8 \uac8c\uc784\uc740 \uc2dc\uc120\uc744 \uc774\uc6a9\ud558\uc5ec \uc120\ud0dd\ud558\ub294 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.", "short_description": "VR\uc744 \ucc29\uc6a9\ud558\uace0 \uc6b0\uc8fc\uc778\uc774 \ub418\uc5b4 \ud0dc\uc591\uacc4\ub97c \uad6c\uacbd\ud558\uc138\uc694.\n\uc6b0\uc8fc\ubcf5\uc758 \uae30\ub2a5\uc744 \uc774\uc6a9\ud558\uc5ec \ud589\uc131\uc744 \ub3cc\uc544\ubcf4\uc138\uc694.\n\uc6b0\uc8fc\ub97c \uccb4\ud5d8\ud558\uace0 \uacf5\ubd80\ud558\uc138\uc694."}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "1096996727322471", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_112477646108122_1338090120401649664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC8cowrMY5AQ7kNvwHn68OX&_nc_oc=Adpy-oF9OoB9uMIGhfzJ0EefKKtuxOC_f6t0_4154Bb9uPC7irPF5OSJLfnebE68FyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHSguWexwEn6yynE9PH7lPoDbVALjPC-RC4PfjB2hlVQ&oe=6AF87D6F"}, {"file_name": "migrated_image.png", "id": "1065506697145152", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162683_145103372752350_3794066838183215104_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6f0zNTYxbkQ7kNvwExSMrP&_nc_oc=Adq28h38tyDFOvGdOY85dQ35EJBH2LKtIOu_iCq5fimxQBg1_ti7NcSfRXITwU0RikE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR3nYipMCIu3FOt5CdJ1Pfu6fL5Zrghcby-pLXdMFYwQ&oe=6AF8876C"}, {"file_name": "migrated_image.png", "id": "661060734646571", "image_type": "APP_IMG_COVER_
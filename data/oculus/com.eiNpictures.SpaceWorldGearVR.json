ull, "video_trailer_thumbnail": null, "display_name": "\uc6b0\uc8fc\uc138\uc0c1", "keywords": ["\uc6b0\uc8fc\uc138\uc0c1vr", "\uc6b0\uc8fc", "\ud0dc\uc591\uacc4"], "long_description": "\ubb34\ud55c\ud55c \uc6b0\uc8fc\ub85c \ub5a0\ub098\uc2ed\uc2dc\uc624.\n\ub2f9\uc2e0\uc740 VR\uc744 \uc4f0\ub294 \uc21c\uac04 \uc6b0\uc8fc\ub85c \ub5a0\ub098\uac8c \ub429\ub2c8\ub2e4.\n\n\uc9c0\uad6c\uac00 \uc788\ub294 \ud0dc\uc591\uacc4\ub97c \uc6b0\uc8fc\ubcf5\uc744 \uc785\uace0 \uc774\ub3d9\ud558\uba70 \uc6b0\uc8fc\uc640 \ud589\uc131\uc744 \uad00\ucc30\ud574 \ubcf4\uc138\uc694.\n\ud0dc\uc591, \uc218\uc131, \uae08\uc131, \uc9c0\uad6c, \ub2ec, \ud654\uc131, \ubaa9\uc131, \ud1a0\uc131, \ucc9c\uc655\uc131, \ud61c\uc655\uc131\uacfc\n\uadf8 \uc678 \uc18c\ud589\uc131, \uc6b4\uc11d\ub4e4\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc6b0\uc8fc\ubcf5\uc758 \uae30\ub2a5\uc744 \ud65c\uc6a9\ud558\uba74 \ud589\uc131\uc758 \uad00\ucc30\ud558\uc138\uc694.\n\ud589\uc131\uc5d0 \ub300\ud55c \uac04\ub2e8\ud55c \uc124\uba85\ub3c4 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n* \uac8c\uc784\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc8fc\uc694 \ud589\uc131\n\ud0dc\uc591, \uc218\uc131, \uae08\uc131, \uc9c0\uad6c, \ub2ec, \ud654\uc131, \ubaa9\uc131, \ud1a0\uc131, \ucc9c\uc655\uc131, \ud61c\uc655\uc131, \uba85\uc655\uc131, \uadf8\uc678 \uc18c\ud589\uc131\uacfc \uc6b4\uc11d\n\n* \uac8c\uc784\uc870\uc791\n\ubcf8 \uac8c\uc784\uc740 GearVR\uc758 \ud130\uce58\ud328\ub4dc\uc640 \uc2dc\uc120\ud2b8\ub808\ud0b9\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n\ubcf8 \uac8c\uc784\uc740 \uc2dc\uc120\uc744 \uc774\uc6a9\ud558\uc5ec \uc120\ud0dd\ud558\ub294 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.", "short_description": "VR\uc744 \ucc29\uc6a9\ud558\uace0 \uc6b0\uc8fc\uc778\uc774 \ub418\uc5b4 \ud0dc\uc591\uacc4\ub97c \uad6c\uacbd\ud558\uc138\uc694.\n\uc6b0\uc8fc\ubcf5\uc758 \uae30\ub2a5\uc744 \uc774\uc6a9\ud558\uc5ec \ud589\uc131\uc744 \ub3cc\uc544\ubcf4\uc138\uc694.\n\uc6b0\uc8fc\ub97c \uccb4\ud5d8\ud558\uace0 \uacf5\ubd80\ud558\uc138\uc694."}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2636199669981600", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162732_1709784559326796_8483826827951865856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO9PqoJshdIQ7kNvwFqNKKa&_nc_oc=AdrDKJoBPDZeqLk97GjCuy5O-r_pqRcJP0Hs1fhwOd5nz0skXnZpx83GJXxK8Qd1J-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNprx0737b8HGNamkAZ_GNxLWIfoovi_MqsC_zAvUzOHQ&oe=6AE33BA1"}, {"file_name": "migrated_image.png", "id": "881459278965471", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_1915939058721454_3321288718119075840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTeU4tc0xUEQ7kNvwGfDA8m&_nc_oc=AdrcMScOcvsFxb21bhXbbhqGBe3CtXaL4lREyDdfrNDpD5DNwBO0cuiIhElZc3F5LEQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMvKdd6AyNnJSF94toKJMlo9oqB-p6xyg6GlY53xR36g&oe=6AE36352"}, {"file_name": "migrated_image.png", "id": "666494217499591", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162718_112477646108122_1338090120401649664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lvm144x10QQ7kNvwGaK74t&_nc_oc=AdqGhiHuEwCT9oxrjNTPx5daamIBlHbOGCT2lgKeU6ySexUexXsroPMUW5jR_gpGA9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrM7Bzs-4sXADu3ZjJ891mT0LIAlyWy1eS_Te6QM1LOg&oe=6AE3656F"}, {"file_name": "migrated_image.png", "id": "299155387721955", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162727_206327716569126_1454863619685613568_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2kLB-a63e8Q7kNvwGHFhWy&_nc_oc=AdoBsUuRazSH-qR9JWhZ7QqwrbCkofN2jLajt1-TncvuYsWgM2bmXsfVWhNTM2NmrjE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNheHGHg-nRMe_th1D1KPRb1DPR5-6pxdGGlcSHhOn8gQ&oe=6AE346DF"}, {"file_name": "migrated_image.png", "id": "
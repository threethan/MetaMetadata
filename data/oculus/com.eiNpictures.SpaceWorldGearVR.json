ation\nThis game uses touch pad and eye tracking of VR gear.\nThis game uses the eye tracking for direction choice.", "short_description": "Wearing a VR gear and watch solar system as an astronaut.\nLook roud planets using a space suit.\nExperience and study Universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://einpicturescafe.mycafe24.com/terms-of-service/", "developer_terms_of_service_url": null, "publisher_name": "eiNpictures", "support_website_url": null, "website_url": "http://www.einpictures.co.kr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25073498185577409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162727_206327716569126_1454863619685613568_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmiBk4vzom4Q7kNvwGsFqAt&_nc_oc=Adq6NKWPs6tNuGtPeMdkRm-W3zKJUvc_UMkOb37FBanv2dZuGJ3klotglkxTQK60vmI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_VBZBDf8Kqu0LoEKwVbm-faXfQi8uptw4D30Oh1_-sA&oe=6A3FCCDF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space World", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "104310754736248
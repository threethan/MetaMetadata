i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314850_425942525872561_8731403744628156232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHdHSFD7sEIQ7kNvwFVTuBE&_nc_oc=AdmKoKqBEJt55Y-G5oDJd6xuubJYafGNhshI1i2A175vG9f53XvF7lV-_UwDz18NkRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZSMhKUZNYIXkfyw0wa4qtHF4j3i8hG43bLIndYS4Ifg&oe=69B94D5B"}, {"file_name": "09_1 (1).png", "id": "421516019412520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86871412_421516026079186_5482313555239614817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Tay3aNzDygQ7kNvwGEhXkU&_nc_oc=AdkeeXcm-QR2-RtIWJRAqj8Hj7NQPtOAPSXtPd-B03xlhRCESJ0dh3sQC_gaH5qKa84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLonl5hKiua6Dp0lzsGAss-QOXy2i26q5mk5P5VdUV7Q&oe=69B9350E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_01.png", "id": "1216932768802893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240098_1216932772136226_1608278777529706391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3KUxR_VihwQ7kNvwEk-NVv&_nc_oc=Adncwv1GNgnSlFRIz4qGpCcp-XQc2T6P28k1jubz8wA3I58Y9C41A4tRP-2Xmw0xtGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLMwM7sMq_HasCXdpFggloAgb3Dls1tgzyX16xGfjrYw&oe=69B931CA"}, "display_name": "Kurgansk", "keywords": [], "long_description": "A long time ago, the search for an endless source of energy led to a disaster, now the lands around Kurgansk are infected and cursed and the locals have lost their minds.\nYou have fallen into these mad places by mistake and are trying to find your way back, while hundreds of evil monsters stop you from doing it.\nA stranger helps you by giving out instructions on the walkie-talkie, but can you trust them?\n\nGame features:\n\n* Huge open and diverse world, completely changing with the onset of the night;\n* A mesmerizing VR horror game where you can truly experience fear for your life;\n* A powerful system for crafting weapons and equipment will help you to survive;\n* Mysteries of the zone will drive you crazy;\n* Deadly anomalies can lie in wait anywhere;\n* There is an option to act as a ninja, killing local monsters with W-shaped transformer plates.\n\nDon\u2019t be afraid to make a mistake and fail.\nRemember that death is just the beginning in Shadows of Kurgansk!", "short_description": "Return to Kurgansk is a stylish VR horror game focused on survival in a post-Soviet, post-apocalypse setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gaijin.net/en/privacypolicy", "developer_terms_of_service_url": "https://gaijin.net/en/termsofservice/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "https://gaijindistribution.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484581730108926"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031599_5104730802883318_7849103404962984157_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWQJRY6bcMwQ7kNvwHyQTeC&_nc_oc=AdkuKbffYjP12RxPIndOsB3_5gfJ5KsgRUj1shB7wry2y8GFcketV7SkvOIOKxmqths&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDeAkywQfGr4VoXkhSyYcOjXg5x6P29380zIa-h8QO2g&oe=69B93F92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kurgansk", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1645693200, "lastRevision": {"nodes": [{"id": "4402217573197121", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4385011931597478", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "405109401052983"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "5001503983222045", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Return to Kurgansk", "keywords": [], "long_description": "\u041a\u043e\u0433\u0434\u0430-\u0442\u043e \u043f\u043e\u0438\u0441\u043a\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0435, \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0437\u0435\u043c\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u041a\u0443\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u044b \u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u044b, \u0430 \u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u043b\u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u043e\u043a.\n\u0412\u044b \u043f\u043e\u043f\u0430\u043b\u0438 \u0432 \u044d\u0442\u0438 \u0433\u0438\u0431\u043b\u044b\u0435 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435 \u0438 \u043f\u044b\u0442\u0430\u0435\u0442\u0435\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u0434\u043e\u0440\u043e\u0433\u0443 \u043d\u0430\u0437\u0430\u0434, \u0432\u043e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0442\u043d\u0438 \u0437\u043b\u043e\u0431\u043d\u044b\u0445 \u043c\u043e\u043d\u0441\u0442\u0440\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432.\n\u041a\u0442\u043e-\u0442\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u043c\u043e\u0433\u0430\u0442\u044c \u0432\u0430\u043c, \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043f\u043e \u0440\u0430\u0446\u0438\u0438, \u043d\u043e \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0435\u043c\u0443 \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c?\n\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u044b:\n\n* \u041e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439 \u043c\u0438\u0440, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043c\u0435\u043d\u044f\u044e\u0449\u0438\u0439\u0441\u044f \u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u043e\u0447\u0438;\n* \u0417\u0430\u0432\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0436\u0438\u0432\u0435\u0448\u044c \u0438 \u0431\u043e\u0438\u0448\u044c\u0441\u044f;\n* \u0412\u0430\u0436\u043d\u043e \u0432\u044b\u0436\u0438\u0442\u044c, \u0438 \u0441 \u044d\u0442\u0438\u043c \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u043c\u043e\u0449\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0440\u0430\u0444\u0442\u0430 \u043e\u0440\u0443\u0436\u0438\u044f \u0438 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u044f;\n* \u0417\u0430\u0
0a&_nc_ohc=d7Y2U8FRcgAQ7kNvwGuIRZA&_nc_oc=AdnOT5XQhl9dlxWzJ2CFd5V2J6fDi5ALvDRW277c-ugrY8bVpM3xqmn48EB09SkalKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afth8Ow1-DeuJX-94jFaL7ZpnLLMWxyzJgaRz2Z_eQT19w&oe=69A44DB3"}, {"file_name": "screen_01_new.png", "id": "425942522539228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314850_425942525872561_8731403744628156232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1kNz1ac_8IQ7kNvwECAKlL&_nc_oc=AdnCaH6lJOhW7tlYbYFUKregistRIzm6D_sWkHzL-aoSwE9EE2AI7txqCOqMwgLZUcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvbMP-gBV4Z5cjZp5EhZ5kSRF4_k0QTHg0lX44puQxeJA&oe=69A4355B"}, {"file_name": "09_1 (1).png", "id": "421516019412520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86871412_421516026079186_5482313555239614817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9okwMUJDmnwQ7kNvwFzIbix&_nc_oc=AdkvfP3Tey5CtTjjhD0GJDNgoGOsr4y7WlJvxTQLugvCVPMBgK3Q9DjdZBHYMScC74w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9y60cmCvM0DkWwmLe1G-Tnft4tUVgk-nBTrV_qwndcg&oe=69A41D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_01.png", "id": "1216932768802893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240098_1216932772136226_1608278777529706391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaVmxLgRNZ0Q7kNvwEXi8-Y&_nc_oc=AdmJR2nMBy9-_BnRqPi_Y4_DFf4Qd_FbeoWUgyp1F-Ie17_QiX_kcGnVoTcIdfbFbK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu_486x3DhQwAO4zDzA7B8O6xYLBaI1jWGGiiXwPC0w9g&oe=69A4520A"}, "display_name": "Return to Kurgansk", "keywords": [], "long_description": "A long time ago, the search for an endless source of energy led to a disaster, now the lands around Kurgansk are infected and cursed and the locals have lost their minds.\nYou have fallen into these mad places by mistake and are trying to find your way back, while hundreds of evil monsters stop you from doing it.\nA stranger helps you by giving out instructions on the walkie-talkie, but can you trust them?\n\nGame features:\n\n* Huge open and diverse world, completely changing with the onset of the night;\n* A mesmerizing VR horror game where you can truly experience fear for your life;\n* A powerful system for crafting weapons and equipment will help you to survive;\n* Mysteries of the zone will drive you crazy;\n* Deadly anomalies can lie in wait anywhere;\n* There is an option to act as a ninja, killing local monsters with W-shaped transformer plates.\n\nDon\u2019t be afraid to make a mistake and fail.\nRemember that death is just the beginning in Shadows of Kurgansk!", "short_description": "Return to Kurgansk is a stylish VR horror game focused on survival in a post-Soviet, post-apocalypse setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gaijin.net/en/privacypolicy", "developer_terms_of_service_url": "https://gaijin.net/en/termsofservice/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "https://gaijindistribution.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "574303987393604"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4913187042049625"}, {"status": "PUBLISHED", "id": "1036768087186006"}]}, "baseline_offer": {"id": "4913187042049625"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
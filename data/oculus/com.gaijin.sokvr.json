i": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75314850_425942525872561_8731403744628156232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nODtjwcZ8w4Q7kNvwFjUszc&_nc_oc=AdoBHnNMh0Y0GzIEyAOarg8y-KD8yKyuQW2nK2jF_nl15HBRioTne_SZYkS3Vt9JsCE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhLwnYWGt8Qtx2UIqNWOqICmA6JVu5mmZjU8rMmY7Cmw&oe=69C1365B"}, {"file_name": "09_1 (1).png", "id": "421516019412520", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86871412_421516026079186_5482313555239614817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQPgkTdiE_0Q7kNvwEiuwFx&_nc_oc=AdrSzkToRQuR573rnCtSEt_NItMaJoYmdyAeAH8ifvNcR04FIz4uy11RE6pL7grCqTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweibSm_9c883HqHdIUJuLxBgBnba4_1-V_allI4Y_pVw&oe=69C11E0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_01.png", "id": "1216932768802893", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240098_1216932772136226_1608278777529706391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWzB-v7YRh0Q7kNvwHXK9RS&_nc_oc=AdrCwaE6BSEKqANjJLYTP8MF-9gQhgSEucXAGUeeGzHo86j2zwx6Pc-Q5InDV1JKZCA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWV2Kyj3sxY5V9If7XfIQK3MQCtYwQPkTXUEokBq0z8A&oe=69C11ACA"}, "display_name": "Kurgansk", "keywords": [], "long_description": "A long time ago, the search for an endless source of energy led to a disaster, now the lands around Kurgansk are infected and cursed and the locals have lost their minds.\nYou have fallen into these mad places by mistake and are trying to find your way back, while hundreds of evil monsters stop you from doing it.\nA stranger helps you by giving out instructions on the walkie-talkie, but can you trust them?\n\nGame features:\n\n* Huge open and diverse world, completely changing with the onset of the night;\n* A mesmerizing VR horror game where you can truly experience fear for your life;\n* A powerful system for crafting weapons and equipment will help you to survive;\n* Mysteries of the zone will drive you crazy;\n* Deadly anomalies can lie in wait anywhere;\n* There is an option to act as a ninja, killing local monsters with W-shaped transformer plates.\n\nDon\u2019t be afraid to make a mistake and fail.\nRemember that death is just the beginning in Shadows of Kurgansk!", "short_description": "Return to Kurgansk is a stylish VR horror game focused on survival in a post-Soviet, post-apocalypse setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gaijin.net/en/privacypolicy", "developer_terms_of_service_url": "https://gaijin.net/en/termsofservice/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "https://gaijindistribution.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "484581730108926"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031599_5104730802883318_7849103404962984157_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjeCdYHYYIwQ7kNvwEWT_k0&_nc_oc=AdrfboRwWmSRcB9VbUFhySu56Wfeg4r0sp2TWK-E0-ENQh-JXgiyjhiUs84WbFe_eac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJCuG5lO8EyOEcceKlZ3pIKwPZKTjNSilm-XYA3k_Muw&oe=69C12892"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kurgansk", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1645693200, "lastRevision": {"nodes": [{"id": "4402217573197121", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4385011931597478", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "405109401052983"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "5001503983222045", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Return to Kurgansk", "keywords": [], "long_description": "\u041a\u043e\u0433\u0434\u0430-\u0442\u043e \u043f\u043e\u0438\u0441\u043a\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043a \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0435, \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0437\u0435\u043c\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u041a\u0443\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u044b \u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u044b, \u0430 \u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0436\u0438\u0442\u0435\u043b\u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u043b\u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u043e\u043a.\n\u0412\u044b \u043f\u043e\u043f\u0430\u043b\u0438 \u0432 \u044d\u0442\u0438 \u0433\u0438\u0431\u043b\u044b\u0435 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435 \u0438 \u043f\u044b\u0442\u0430\u0435\u0442\u0435\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u0434\u043e\u0440\u043e\u0433\u0443 \u043d\u0430\u0437\u0430\u0434, \u0432\u043e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0442\u043d\u0438 \u0437\u043b\u043e\u0431\u043d\u044b\u0445 \u043c\u043e\u043d\u0441\u0442\u0440\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432.\n\u041a\u0442\u043e-\u0442\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0439 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u043c\u043e\u0433\u0430\u0442\u044c \u0432\u0430\u043c, \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u043f\u043e \u0440\u0430\u0446\u0438\u0438, \u043d\u043e \u043c\u043e\u0436\u043d\u043e \u043b\u0438 \u0435\u043c\u0443 \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c?\n\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u044b:\n\n* \u041e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439 \u043c\u0438\u0440, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043c\u0435\u043d\u044f\u044e\u0449\u0438\u0439\u0441\u044f \u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u043e\u0447\u0438;\n* \u0417\u0430\u0432\u043e\u0440\u0430\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u0436\u0438\u0432\u0435\u0448\u044c \u0438 \u0431\u043e\u0438\u0448\u044c\u0441\u044f;\n* \u0412\u0430\u0436\u043d\u043e \u0432\u044b\u0436\u0438\u0442\u044c, \u0438 \u0441 \u044d\u0442\u0438\u043c \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u043c\u043e\u0449\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0440\u0430\u0444\u0442\u0430 \u043e\u0440\u0443\u0436\u0438\u044f \u0438 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u044f;\n* \u0417\u0430\u0433\u0430\u0434\u043a\u0438 \u0437\u043e\u043d\u044b \u0441\u043b\u043e\u043c\u0430\u044e\u0442 \u0432\u0430\u043c \u0433\u043e\u043b\u043e\u0432\u0443;\n* \u0421\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u0434\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0442\u044c \u0432 \u043b\u044e\u0431\u043e\u043c \u043c\u0435\u0441\u0442\u0435;\n* \u0415\u0441\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u043d\u0438\u043d\u0434\u0437\u044f, \u0443\u0431\u0438\u0432\u0430\u044f \u043c\u0435\u0441\u0442\u043d\u044b\u0445 \u043c\u043e\u043d\u0441\u0442\u0440\u043e\u0432 \u0428-\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0430\u043c\u0438 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0442\u043e\u0440\u043e\u0432.\n\n\u0418 \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0432\u044b \u043e\u0448\u0438\u0431\u0435\u0442\u0435\u0441\u044c, \u0437\u043d\u0430\u0439\u0442\u0435: \u0441\u043c\u0435\u0440\u0442\u044c \u2013 \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u043b\u043e!", "short_description": "Return to Kurgansk \u2013 \u0441\u0442\u0438\u043b\u044c\u043d\u044b\u0439 VR-\u0445\u043e\u0440\u0440\u043e\u0440 \u043e \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0438 \u0432 \u043f\u043e\u0441\u0442\u0441\u043e\u0432\u0435\u0442\u0441\u043a\u043e\u043c \u043f\u043e\u0441\u0442\u0430\u043f\u043e\u043a\u0430\u043b\u0438\u043f\u0441\u0438\u0441\u0435."}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "5104730796216652", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031599_5104730802883318_7849103404962984157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjeCdYHYYIwQ7kNvwEWT
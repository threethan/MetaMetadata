ne exploration with Elements, a captivating VR app that invites you to immerse yourself in four mesmerizing vr short films: Earth, Water, Air, and Fire. Delve into the tranquil beauty of each element as you unwind and experience a truly enchanting journey into relaxation."}]}, "developer_name": "Smart Goose Productions", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/4f6c5a83-1601-4773-8892-9eb5346561d9", "developer_terms_of_service_url": null, "publisher_name": "Smart Goose Interactive", "support_website_url": null, "website_url": "https://linktr.ee/smartgooseinteractive", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8310064902387007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_200342619778400_7024777202473774360_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDJj-Tk33UAQ7kNvwFR3lkL&_nc_oc=AdkGr1QEU_bRtAjJHfyt4-Gh-A4ZtRdleA0xEHAqWUxzACVz_Hkl8ZqtGDL6tdPLBdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDsbqIBwM_dX4ox1yiF4ScX7tVnAvXtqqSyuyZJmlEKA&oe=69AC32F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elements", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellne
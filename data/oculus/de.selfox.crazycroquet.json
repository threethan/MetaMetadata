-7&_nc_sid=6e7a0a&_nc_ohc=xbXdBl0SLJYQ7kNvwGzxMEf&_nc_oc=Ado6ROayrGtvYh8Vjqi4yyjQCtjwHR6qLXy9ZBXXDXUBy-Smrm7Pw951a3xEH4Ypvi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_pkXoeVtbS6jOziiCkfFBwSHHJredvgEYS2U9JXzENQ&oe=6ABBDA8D"}, "display_name": "Crazy Croquet", "keywords": [], "long_description": "Play croquet like never before and enjoy the beautiful created fantasy world with its lovely spots.\n12 different levels waiting for you to play and each level is more difficult than the previous one.\nCustomize your equipment with diffrent rackets and balls and find out what fits best for you.\nImprove your skills and gain more points with perfect shots without hitting a goal, collecting bonus points, complete level in a short time and with as few hits as possible.\nCompete with other players and raise to the top of the leaderboards.", "short_description": "Play croquet with 12 different levels. Each level is more difficult than the previous one.\nCustomize your equipment with different rackets and balls and find out what fits best for you.\nImprove your skills and gain more points with perfect shots without hitting a goal, collecting bonus points, complete level in a short time and with as few hits as possible.\nCompete with other players and raise to the top of the leaderboards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selfox.de/privacy-policy-croquet-vr.html", "developer_terms_of_service_url": null, "publisher_name": "Selfox", "support_website_url": null, "website_url": "https://www.selfox.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
ntent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvPJeBL0GRpBGREVOf1_1akiETdvL1ZPl-q_KhoJvDtg&oe=6AFDCEA1"}, {"file_name": "Immersive Water Park Slide Ride.png", "id": "28577988875190592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_28577988888523924_3599881698379632999_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jhunx_78wN4Q7kNvwHDITOq&_nc_oc=Adqd7PGKZ3k4YUnoPlxPEWNng2fOrIsShjb-Tk6LZVEDpSa9b1o_0JjEZ43wKH6RGTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN1XHwatiLze2F5umIyqmnFVQqw4z6R5IbqHMsg8-yoA&oe=6AFDAE34"}, {"file_name": "VR Water Slide Overlooking the City.png", "id": "953709243923481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_953709247256814_5874856459524499226_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT7n3hSxzloQ7kNvwEce_4L&_nc_oc=Adoy1rLpHILuHaBeJAcSXHgz9LcPEqIDv-LLKYy0MNBkKHSYwuqO2QzHlB98xALKY7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdufmUyDkDRc7v9ppsFS_dCJMYFEP2lxWhMsexGeQxbA&oe=6AFDD52C"}, {"file_name": "VR Waterpark Slide Adventure.png", "id": "961327196400853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_961327199734186_3704517072067351003_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9YqLjGD6R4Q7kNvwEASO88&_nc_oc=Adp7c3c59jvof5FWZv_lV0PpO8OyxEXS1BuHfICtt0KATiKxbcgyAV0nUe2T81_N-4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMbkFHY-FChh4gbsjqYhZYj8hDGRLzkyQ_ILqWhms11Q&oe=6AFDD17C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Water Park: Extreme Slides", "keywords": ["park", "slide", "theme", "aqua", "water"], "long_description": "Welcome to Water Park: Extreme Slides, an immersive virtual water park where every ride brings a new adventure.\n\nExplore a beautiful tropical water park filled with giant water slides, twisting tunnels, steep drops, fast turns, pools, waterfalls, and exciting water attractions.\n\nClimb to the top, choose your favorite slide, and experience the thrill of rushing through colorful tubes, sharp curves, massive drops, and splash-filled finishes \u2014 all from a first-person VR perspective.\n\nWhether you want an intense waterslide experience or simply want to explore and enjoy a relaxing virtual water park, there is always another ride waiting for you.\n\nFeatures\n\n\u2022 Experience multiple unique water slides\n\u2022 Ride extreme drops, spirals, tunnels, and fast turns\n\u2022 Explore a colorful tropical water park\n\u2022 Enjoy immersive first-person water rides\n\u2022 Discover different slide styles and environments\n\u2022 Relax around pools and water attractions\n\u2022 Feel the speed, height, splashes, and excitement of real waterslides\n\u2022 Easy to play and suitable for quick or longer VR sessions\n\nExperience the excitement of a water park, waterslide, aqua park, amusement park, and theme park from inside virtual reality.\n\nChoose your slide, hold on, and enjoy the ride!", "short_description": "Dive into an exciting water park packed with extreme water slides, twisting tunnels, giant drops, tropical pools, and thrilling water rides. Explore the park, choose your favorite slide, and experience the rush of a real waterslide in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
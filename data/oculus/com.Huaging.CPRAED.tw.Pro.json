MUsIo9F7KZAOuqiz6vI5NkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThAY3G_GvxHBazHDfAUaMk7OuV9HUNbSj6yeYcRyf0fQ&oe=6AE73DB2"}, {"file_name": "\u87a2\u5e55\u622a\u5716_001_tw.png", "id": "1894739941451741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822495_1894739948118407_3621995019011358436_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXIfKg2NsbEQ7kNvwFwkGuB&_nc_oc=AdqPk1QlCId4oa5cSu9HgJrFQl0XdLvPSVASmvcRIqLq0eJN8_Lij8lscPfxUWhUxxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFhsuRw1WNsqSbQIOCQcufNQOFtyJ2mf8SBXAh1Bn5ZQ&oe=6AE75B93"}, {"file_name": "\u6210\u7e3e_tw.png", "id": "755267600491970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823431_755267603825303_7518490356467351386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3idyVPET9lcQ7kNvwGLbYWA&_nc_oc=AdqWDa19w-9VJeWUeW8Pi5NUGiyGxmfJtqe6aaE7wnRRA9xO63iCxj4ZUNOxzFof4s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmr7Q_5cqtuVn5pJr1jIK3mvnrdNBn8b-8LDC0C6AQsQ&oe=6AE75480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u81fa\u7063\u7248\uff09(1920x1080)2m.png", "id": "1267392015082963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823431_1267392018416296_6990715663356768213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDP7FwYOXq0Q7kNvwEglrWE&_nc_oc=AdoHdvnsCMamoXQdXMM3zZsH-8iH159lQMoJrNFcIW8pXQnKggCMVJJPJcWlVdKNpKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST1rh1rmMcnk5VV3tLXz9QRNQzNPfvvzfLMARjTJ-XXQ&oe=6AE760AC"}, "display_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u81fa\u7063\uff09\u5c08\u696d\u7248", "keywords": ["CPR\u5fc3\u80ba\u5fa9\u7526\u8853\u8a13\u7df4", "AED\u6a21\u64ec", "\u6025\u6551\u61c9\u8b8a", "\u5fa9\u7526\u7df4\u7fd2", "\u91ab\u7642\u8a13\u7df4"], "long_description": "# \u9032\u968e\u529f\u80fd\u5168\u9762\u5347\u7d1a\uff0c\u6253\u9020\u5c08\u696d\u6559\u5b78\u8207\u5718\u9ad4\u8a13\u7df4\u65b0\u6a19\u6e96\u3002\n\n\u4f9d\u64da\u53f0\u7063\u885b\u798f\u90e8\u300a\u5fc3\u80ba\u5fa9\u7526\u8853\u53c3\u8003\u6307\u5f15\u300b\uff0c\u5c08\u70ba\u6821\u5712\u3001\u4f01\u696d\u6d3b\u52d5\u3001\u5c08\u696d\u6559\u5b78\u55ae\u4f4d\u8207\u5718\u9ad4\u8a13\u7df4\u8a2d\u8a08\uff0c\u63d0\u4f9b\u5b8c\u6574\u7684\u5b78\u7fd2\u8207\u8a55\u91cf\u9ad4\u7cfb\u3002\n\n**\u529f\u80fd\u5347\u7d1a\uff0c\u8a13\u7df4\u66f4\u6709\u5f48\u6027**\n- \u64f4\u5145\u9ad4\u9a57\u7248\u529f\u80fd\uff0c\u52a0\u5165\u9032\u968e\u8a2d\u5b9a\u8207\u81ea\u8a02\u9078\u9805\n- \u6eff\u8db3\u591a\u6a23\u5316\u8a13\u7df4\u9700\u6c42\uff0c\u9069\u7528\u65bc\u521d\u968e\u9ad4\u9a57\u5230\u5be6\u6230\u6a21\u64ec\u3002\n\n**CPR \u6309\u58d3\u6642\u9577\u53ef\u8abf\u6574**\n- \u63d0\u4f9b 30 \u79d2\u30011 \u5206\u9418\u30012 \u5206\u9418 \u4e09\u7a2e\u6a21\u5f0f\n- \u56e0\u61c9\u6559\u5b78\u7bc0\u594f\u8207\u8a13\u7df4\u5f37\u5ea6\uff0c\u5f48\u6027\u898f\u5283\u8ab2\u7a0b\u5167\u5bb9\n- \u7121\u8ad6\u662f\u77ed\u6642\u9ad4\u9a57\u6216\u9577\u6642\u9593\u5be6\u5883\u6f14\u7df4\u7686\u80fd\u5c0d\u61c9\n\n**\u5177\u300c\u6e2c\u9a57\u6a21\u5f0f\u300d\u53ef\u6a21\u64ec\u5be6\u6230**\n- \u9032\u5165\u7121\u5716\u50cf\u63d0\u793a\u3001\u50c5\u8a9e\u97f3\u5f15\u5c0e\u60c5\u5883\n- \u771f\u5be6\u8003\u9a57\u5b78\u54e1\u5c0d\u64cd\u4f5c\u6d41\u7a0b\u7684\u719f\u6089\u5ea6\uff0c\u8cbc\u8fd1\u81e8\u5834\u6025\u6551\n\n**\u5b8c\u6574\u6210\u7e3e\u8a55\u91cf\u7cfb\u7d71**\n- \u5373\u6642\u500b\u4eba\u8a55\u5206\u3001\u7dda\u4e0a\u67e5\u8a62\u6b77\u53f2\u7d00\u9304\n- \u5354\u52a9\u5b78\u54e1\u8207\u8b1b\u5e2b\u8ffd\u8e64\u5b78\u7fd2\u6210\u6548\u8207\u9032\u6b65\u5e45\u5ea6\n- \u5206\u6790\u64cd\u4f5c\u6578\u64da\uff0c\u5feb\u901f\u627e\u51fa\u5f31\u9ede\uff0c\u5f37\u5316\u91dd\u5c0d\u6027\u6559\u5b78\n\n**\u652f\u63f4\u5718\u9ad4\u6d3b\u52d5\u8207\u5f8c\u53f0\u7ba1\u7406**\n- \u53ef\u5efa\u7acb\u591a\u4eba\u8a13\u7df4\u6d3b\u52d5\uff0c\u7d00\u9304\u6bcf\u4
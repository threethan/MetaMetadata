8853\u53c3\u8003\u6307\u5f15\u300b\uff0c\u5c08\u70ba\u6821\u5712\u3001\u4f01\u696d\u6d3b\u52d5\u3001\u5c08\u696d\u6559\u5b78\u55ae\u4f4d\u8207\u5718\u9ad4\u8a13\u7df4\u8a2d\u8a08\uff0c\u63d0\u4f9b\u5b8c\u6574\u7684\u5b78\u7fd2\u8207\u8a55\u91cf\u9ad4\u7cfb\u3002\n\n**\u529f\u80fd\u5347\u7d1a\uff0c\u8a13\u7df4\u66f4\u6709\u5f48\u6027**\n- \u64f4\u5145\u9ad4\u9a57\u7248\u529f\u80fd\uff0c\u52a0\u5165\u9032\u968e\u8a2d\u5b9a\u8207\u81ea\u8a02\u9078\u9805\n- \u6eff\u8db3\u591a\u6a23\u5316\u8a13\u7df4\u9700\u6c42\uff0c\u9069\u7528\u65bc\u521d\u968e\u9ad4\u9a57\u5230\u5be6\u6230\u6a21\u64ec\u3002\n\n**CPR \u6309\u58d3\u6642\u9577\u53ef\u8abf\u6574**\n- \u63d0\u4f9b 30 \u79d2\u30011 \u5206\u9418\u30012 \u5206\u9418 \u4e09\u7a2e\u6a21\u5f0f\n- \u56e0\u61c9\u6559\u5b78\u7bc0\u594f\u8207\u8a13\u7df4\u5f37\u5ea6\uff0c\u5f48\u6027\u898f\u5283\u8ab2\u7a0b\u5167\u5bb9\n- \u7121\u8ad6\u662f\u77ed\u6642\u9ad4\u9a57\u6216\u9577\u6642\u9593\u5be6\u5883\u6f14\u7df4\u7686\u80fd\u5c0d\u61c9\n\n**\u5177\u300c\u6e2c\u9a57\u6a21\u5f0f\u300d\u53ef\u6a21\u64ec\u5be6\u6230**\n- \u9032\u5165\u7121\u5716\u50cf\u63d0\u793a\u3001\u50c5\u8a9e\u97f3\u5f15\u5c0e\u60c5\u5883\n- \u771f\u5be6\u8003\u9a57\u5b78\u54e1\u5c0d\u64cd\u4f5c\u6d41\u7a0b\u7684\u719f\u6089\u5ea6\uff0c\u8cbc\u8fd1\u81e8\u5834\u6025\u6551\n\n**\u5b8c\u6574\u6210\u7e3e\u8a55\u91cf\u7cfb\u7d71**\n- \u5373\u6642\u500b\u4eba\u8a55\u5206\u3001\u7dda\u4e0a\u67e5\u8a62\u6b77\u53f2\u7d00\u9304\n- \u5354\u52a9\u5b78\u54e1\u8207\u8b1b\u5e2b\u8ffd\u8e64\u5b78\u7fd2\u6210\u6548\u8207\u9032\u6b65\u5e45\u5ea6\n- \u5206\u6790\u64cd\u4f5c\u6578\u64da\uff0c\u5feb\u901f\u627e\u51fa\u5f31\u9ede\uff0c\u5f37\u5316\u91dd\u5c0d\u6027\u6559\u5b78\n\n**\u652f\u63f4\u5718\u9ad4\u6d3b\u52d5\u8207\u5f8c\u53f0\u7ba1\u7406**\n- \u53ef\u5efa\u7acb\u591a\u4eba\u8a13\u7df4\u6d3b\u52d5\uff0c\u7d00\u9304\u6bcf\u4f4d\u53c3\u8207\u8005\u7684\u8868\u73fe\n- \u5f8c\u53f0\u81ea\u52d5\u751f\u6210\u6210\u7e3e\u7d71\u8a08\u8207\u8996\u89ba\u5316\u5831\u544a\n- \u7ba1\u7406\u8005\u53ef\u4f9d\u64da\u6578\u64da\u9032\u884c\u9032\u5ea6\u8ffd\u8e64\u8207\u6559\u5b78\u8abf\u6574\n\n\ud83d\udca1 **\u672c\u7522\u54c1\u70ba\u8a02\u95b1\u5236\u670d\u52d9\uff0c\u5efa\u8b70\u5728\u7db2\u8def\u9023\u7dda\u9806\u66a2\u6642\u4f7f\u7528\uff0c\u4ee5\u4eab\u6709\u5b8c\u6574\u529f\u80fd\u8207\u6700\u4f73\u9ad4\u9a57\u3002**\n\n\u82e5\u60a8\u5c0d\u672c\u7522\u54c1\u6709\u4efb\u4f55\u7591\u554f\u6216\u5408\u4f5c\u610f\u9858\uff0c\u6b61\u8fce\u900f\u904e\u4e0b\u5217\u65b9\u5f0f\u8207\u6211\u5011\u806f\u7e6b\u3002\n\n\ud83d\udce9 \u806f\u7d61\u4fe1\u7bb1\uff1ahuagingofficial@gmail.com", "short_description": "\u9032\u968e\u529f\u80fd\u5168\u9762\u5347\u7d1a\uff0c\u6253\u9020\u5c08\u696d\u6559\u5b78\u8207\u5718\u9ad4\u8a13\u7df4\u65b0\u6a19\u6e96\u3002\n\u4f9d\u64da\u53f0\u7063\u885b\u798f\u90e8\u300a\u5fc3\u80ba\u5fa9\u7526\u8853\u53c3\u8003\u6307\u5f15\u300b\uff0c\u5c08\u70ba\u6821\u5712\u3001\u4f01\u696d\u6d3b\u52d5\u3001\u5c08\u696d\u6559\u5b78\u55ae\u4f4d\u8207\u5718\u9ad4\u8a13\u7df4\u8a2d\u8a08\uff0c\u63d0\u4f9b\u5b8c\u6574\u7684\u5b78\u7fd2\u8207\u8a55\u91cf\u9ad4\u7cfb\u3002\n\n\u672c\u7522\u54c1\u70ba\u8a02\u95b1\u5236\u670d\u52d9\uff0c\u5efa\u8b70\u5728\u7db2\u8def\u9023\u7dda\u9806\u66a2\u6642\u4f7f\u7528\uff0c\u4ee5\u4eab\u6709\u5b8c\u6574\u529f\u80fd\u8207\u6700\u4f73\u9ad4\u9a57\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
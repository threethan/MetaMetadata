m/v/t64.5771-25/491823445_1407303833823870_5962740093624453741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjllhYbNF8QQ7kNvwEaVVt3&_nc_oc=AdrT4rHkW3s16ujqmjY-5-uIQ0vtgM8oGKdv8SFsZvyUSWcvvI-7RkAEK_kbKliH-_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkK0ehM2t0QOkO-kfP80BkF0wfx0x_SgjvTg5DAeOQzg&oe=6A676546"}, {"file_name": "\u87a2\u5e55\u622a\u5716_001_en.png", "id": "1110745840911765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822045_1110745844245098_754597407569579532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqiaSGB-wYQQ7kNvwGfkrzM&_nc_oc=Adrvj8JiwInPvX5Za2mIhlxyj5M1DhDtkKW2Qj9Gttu-jqyoJR4tevIACHRVe4kDbfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfrRVPwc-YKb9fYn3K782-rioWAx7HUMemJhqDlJ2JdA&oe=6A674C06"}, {"file_name": "\u6210\u7e3e_en.png", "id": "668667252854956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_668667256188289_4047556469570533398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCATcC0btlQQ7kNvwHXNlUF&_nc_oc=Ado1tFv0i_Kp881OwXwD9HHS1aYmRCZoluXjoGCJ8MNXXeFmDFQmYwwbO2a-asir3zI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdo5gOGbDjOZrKc9ESsH_HyZ5MmoAX-6hfFusxuJGoAw&oe=6A67541B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1820599592225510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821886_1820599595558843_1556147223551996027_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=horeiOwRDXwQ7kNvwH8BSHf&_nc_oc=AdpURjaxznVXF2dKO7_h3WtTWk5kXVnAa0XjtGh5fUCgNv6XtTWr-Z5TLupwgZEhOWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEr1b6-M4MCrk922Adt5OCuxaGAReC0eF9HldFtgHecg&oe=6A674B9E"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Advanced functionality for professional education and group training\n\nBased on the latest CPR guidelines from the American Heart Association (AHA), this version is designed for schools, corporate programs, instructors, and group training. It provides a complete system for learning and assessment with enhanced flexibility.\n\n**Enhanced Features for Flexible Training**\n- Advanced settings and customizable options\n- Supports diverse needs from entry-level to realistic simulations\n\n**Adjustable CPR Compression Duration**\n- 30-second, 1-minute, and 2-minute modes\n- Flexible planning for teaching pace and intensity\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio guidance only\n- Simulates emergencies to test CPR response\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring and online record tracking\n- Highlights weak points for targeted teaching\n- Auto-generates reports for progress monitoring\n\n**Supports Group Activities and Management**\n- Multi-user sessions with individual tracking\n- Admins can adjust content and view data insights\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Advanced functionality for professional education and group training.\nThis version follows the latest CPR guidelines from the American Heart Association (AHA) and is tailored for schools, corporate programs, and professional training. It provides a comprehensive learning and assessment system with enhanced flexibility.\n\nThis is a subscription-based service. For full access and the best experience, please use it with a stable internet connection."}, {"images": {"nodes": [{"file_name": "Cube_TW.png", "id": "24228188300147359", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821881_24228188310147358_7019479013007259964_n.png?_nc_cat=10
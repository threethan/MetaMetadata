m/v/t64.5771-25/491823445_1407303833823870_5962740093624453741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qDnBNdmfeQQ7kNvwGYFS1d&_nc_oc=AdrUwQZGGc7w9B4gRBN7-kz523T-lGFVYts2BaO8XDlWtNZhQKtQryMOwyKtKnCN44o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GcmeVi9qZKzV0Sb_Ysy4g0AZ-ZXdiXEsoKmWX18bYZw&oe=6A37EF46"}, {"file_name": "\u87a2\u5e55\u622a\u5716_001_en.png", "id": "1110745840911765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822045_1110745844245098_754597407569579532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQzGu3T0AeMQ7kNvwEKPGES&_nc_oc=Adph5uuOyzomZGo1k43Vj6Vp3SBLbb0DIYqUKhbsj3uSAbMmLqAKj0lyTs7pSL2VCtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qr6J8uv0gsIlVEWC1iBI37tHh3YBQ1JP1Yi4RkMxN7w&oe=6A380E46"}, {"file_name": "\u6210\u7e3e_en.png", "id": "668667252854956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_668667256188289_4047556469570533398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D4ZGJfGGywQ7kNvwGeP0fQ&_nc_oc=Adpp4JN8GR6Z_IHGOAFqAFE0fN7RLbuR3PVg_K1opCvCaipqHyX7rG8QOdhnrlyi4f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1LJ0-o-Xnvhz8Pw-cyQIXC8e7v1_A9oE399zm6Z2thg&oe=6A38165B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1820599592225510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821886_1820599595558843_1556147223551996027_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcPec-NxmRcQ7kNvwFI7YWu&_nc_oc=AdoM_0x2tNrbZ3iXlxH5yMjjZP3PvNysux5zB49PpdwJmMK1DjC9ua2qDK5ZJEDGJqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3IdFNxHI8CV6-tzrO4Tu6wGBhdkWD4QQwykLQwjy7bw&oe=6A380DDE"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Advanced functionality for professional education and group training\n\nBased on the latest CPR guidelines from the American Heart Association (AHA), this version is designed for schools, corporate programs, instructors, and group training. It provides a complete system for learning and assessment with enhanced flexibility.\n\n**Enhanced Features for Flexible Training**\n- Advanced settings and customizable options\n- Supports diverse needs from entry-level to realistic simulations\n\n**Adjustable CPR Compression Duration**\n- 30-second, 1-minute, and 2-minute modes\n- Flexible planning for teaching pace and intensity\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio guidance only\n- Simulates emergencies to test CPR response\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring and online record tracking\n- Highlights weak points for targeted teaching\n- Auto-generates reports for progress monitoring\n\n**Supports Group Activities and Management**\n- Multi-user sessions with individual tracking\n- Admins can adjust content and view data insights\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Advanced functionality for professional education and group training.\nThis version follows the latest CPR guidelines from the American Heart Association (AHA) and is tailored for schools, corporate programs, and professional training. It provides a comprehensive learning and assessment system with enhanced flexibility.\n\nThis is a subscription-based service. For full access and the best experience, please use it with a stable internet connection."}, {"images": {"nodes": [{"file_name": "Cube_TW.png", "id": "24228188300147359", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821881_24228188310147358_7019479013007259964_n.png?_nc_cat=10
m/v/t64.5771-25/491823445_1407303833823870_5962740093624453741_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obgBeSf5M50Q7kNvwHgPIrU&_nc_oc=AdoTCO2lf-W7BEY5QnoQoTiaiXnjSr7FNrB8XixGkymx--x8xSCFDYIvtLFMKZnJn9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKktvQqSZuEboapgvL4yuJrPLtfkfhzJqX4oSZ8Oxf0oQ&oe=6AB28AC6"}, {"file_name": "\u87a2\u5e55\u622a\u5716_001_en.png", "id": "1110745840911765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_1110745844245098_754597407569579532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZa42aKvZgMQ7kNvwFoWBdA&_nc_oc=AdoW4uMMar3ZD5Q5Xpy41J4CmOLn4uefejLdRZujMXCj0i-KrsAGHLwwkTi6FzW1-tI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrk-Q363Q_yGliBaWL5GzwOfoBl9uBuMwfepaj6qhnzg&oe=6AB27186"}, {"file_name": "\u6210\u7e3e_en.png", "id": "668667252854956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820956_668667256188289_4047556469570533398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv9sKfcoXEQQ7kNvwFjggJt&_nc_oc=AdpXjMsMYvWZRRrprUPGA0-9KwnKu3X3fX1siRQ6XyhyFhg0dQktgydS9xD4y5Oytzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYEVu_DoNUVswPxvj2oiZ-OwX6h1uZpvsopNxBJ0mtWA&oe=6AB2799B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1820599592225510", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821886_1820599595558843_1556147223551996027_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QzHKuEawf8Q7kNvwGJ-lU1&_nc_oc=AdqUAcVzhc9ThF0M0wj0lxN9WXW0ng78MGsYvxh4qjIB9V30F-ixDrzqMFu1rlTCL3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqiUdY2cPUv0KTQE5CCagJx-8hPuN4Q6Q8KLAM8cOZJQ&oe=6AB2711E"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Advanced functionality for professional education and group training\n\nBased on the latest CPR guidelines from the American Heart Association (AHA), this version is designed for schools, corporate programs, instructors, and group training. It provides a complete system for learning and assessment with enhanced flexibility.\n\n**Enhanced Features for Flexible Training**\n- Advanced settings and customizable options\n- Supports diverse needs from entry-level to realistic simulations\n\n**Adjustable CPR Compression Duration**\n- 30-second, 1-minute, and 2-minute modes\n- Flexible planning for teaching pace and intensity\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio guidance only\n- Simulates emergencies to test CPR response\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring and online record tracking\n- Highlights weak points for targeted teaching\n- Auto-generates reports for progress monitoring\n\n**Supports Group Activities and Management**\n- Multi-user sessions with individual tracking\n- Admins can adjust content and view data insights\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Advanced functionality for professional education and group training.\nThis version follows the latest CPR guidelines from the American Heart Association (AHA) and is tailored for schools, corporate programs, and professional training. It provides a comprehensive learning and assessment system with enhanced flexibility.\n\nThis is a subscription-based service. For full access and the best experience, please use it with a stable internet connection."}, {"images": {"nodes": [{"file_name": "Cube_TW.png", "id": "24228188300147359", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821881_24228188310147358_7019479013007259964_n.png?_nc_cat=10
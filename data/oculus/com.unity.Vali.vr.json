PUKoQQ7kNvwFU4jO3&_nc_oc=AdqgqGMRLqXR8Fchw2_vm3xaXmkoI-8xnuIaosEGHN77RaMqSSxUv8eCPQMNApT_sa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLCz36-DWQFIfRauqCj5ncPCVptP3GuDqHKLjRwT6sWQ&oe=6AE9FFD3"}, {"file_name": "Vali_3.png", "id": "1257641863037316", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1257641866370649_4107436943962800486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w3bH-GtitsQ7kNvwFyJajw&_nc_oc=AdrQXGEo-PaEmkY0F061HK0wgF1lw3ntKR7t0QS_ebS_FV_-7Tu1FAmmTtsscOQJMkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPe-kqfkTRWKc1P7lKBlP2s7OUQfjnh7IbpMhGHD6ziA&oe=6AE9EB05"}, {"file_name": "Vali_5.png", "id": "4058984691029040", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_4058984694362373_1254860669315257015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBS-08RnctMQ7kNvwGldfH3&_nc_oc=AdoZCq0TL0iD_e_9X5kyaHScgVfP_-aHxip9lTUP8fAEqosWIfXmigV0CV27s986kn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvq4rqokUVTmnXQ4G8A3hofe1yRB5STlTXqSvfUZdkcA&oe=6AE9F42F"}, {"file_name": "Vali_1.png", "id": "1362407552201460", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820141_1362407555534793_965062326090877553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm28v-3yhOwQ7kNvwFi5A77&_nc_oc=Ado8IFWkKtFGjfKqUXJcTaqBmGIodLMUH8Hz85qkzGLfRhApv2Wv736GbIOIolvuEoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwBN1HgTCB9IXjiqtzBxNoDSDSCRO-fuZapKzMrXO93Q&oe=6AEA122F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaVideo.png", "id": "2133229203822341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_2133229207155674_6662764933188368593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prRm3zvtTUwQ7kNvwFJ78_Z&_nc_oc=Adqn91oTLRp_X8vHFQ3lt0Yi4xpQebqi9hiq_-XqjJPr5kRRdJRgMAE-rIn1rrEpXYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa82XrUTV9OAK3cntbvsJhC57vIqOSV0OrW-tYmORnEw&oe=6AEA0A0B"}, "display_name": "Vali", "keywords": ["detective", "mystery", "puzzle", "escaperoom", "investigation"], "long_description": "You are Vali, a private detective with a method of your own: investigating from virtual reality.\n\nA video shows you a house. Then you wake up in a place full of fairground games and a panel with six missions. Each one is a crime: a victim, several suspects and only one truth.\n\n\u2022 Six cases to solve, each in its own world.\n\u2022 Real hands-on investigation: grab, turn and examine every clue with your hands or controllers.\n\u2022 A wrist notebook that collects the clues you discover \u2014 just look at your watch.\n\u2022 An inner voice that gives you hints if you get stuck.\n\u2022 Seated mode, smooth or snap turning, and subtitles.\n\u2022 Fully voiced in Spanish and English.\n\nFun, weird and a little unsettling. Solve the six cases\u2026 and find out what is really behind that seventh button.", "short_description": "A strange VR detective game. Six cases, one sinister fairground and a voice in your head that seems to know more than you do. Grab the clues, question the suspects and solve the crimes\u2026 but the hardest case of all may be the one you never accepted."}, {"images": {"nodes": []}, "id": "740938658499059", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vali", "keywords": [], "long_description": "Eres Vali, detective privado con un m\u00e9todo muy suyo: investigar desde la realidad virtual.\n\nUn v\u00eddeo te ense\u00f1a una casa. Despu\u00e9s despiertas en un lugar lleno de juegos de feria y un panel con seis misiones. Cada una es un crimen: una v\u00edctima, varios sospechosos y una sola verdad.\n\n\u2022 Seis casos que resolver, cada uno en su propio mundo.\n\u2022 Investigaci\u00f3n con las manos: coge, gira y examina cada pista con las manos o los mandos.\n\u2022 Una libreta en la mu\u00f1eca que recoge las pistas que descubres: basta con mirar el reloj.\n\u2022 Una voz interior que te da pistas si te atascas.\n\u2022 Modo sentado, giro suave o por saltos y subt\u00edtulos.\n\u2022 Totalmente doblado al espa\u00f1ol y al ingl\u00e9s.\n\nDivertido, raro y un poco inquietante. Resuelve los seis casos\u2026 y descubre qu\u00e9 hay de verdad detr\u00e1s de ese s\u00e9ptimo bot\u00f3n.", "short_description": "Un extra\u00f1o juego de detectives en RV. Seis casos, una feria inquietante y una voz en tu cabeza que parece saber m\u00e1s que t\u00fa. Coge las pistas, interroga a los sospechosos y resuelve los cr\u00edmenes\u2026 aunque el caso m\u00e1s dif\u00edcil quiz\u00e1 sea el que nunca aceptaste."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/3dand3m/privacidad", "developer_terms_of_service_url": null, "publisher_name": "3Dand3M", "support_website_url": null, "website_url": "https://sites.google.com/view/3dand3m", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29897711506540072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819327_699694219428497_8700130385035867417_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdRxcSOVhF8Q7kNvwHXvBju&_nc_oc=Adr9YC4zbt9XH5GTbXl0Yfn-JjWEZYUTCbbHh9upGrQ75qB0KKC8HBnwE
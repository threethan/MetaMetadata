=7f20f&oh=00_Af52Xj7aK5vbH9XUxAuAj-lVbyNh6XrW0zy6vtPptgoZiA&oe=6A09B742"}, {"file_name": "491819407_1411290560024264_2762186898885056775_n.png", "id": "1342775680358791", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822559_1342775683692124_1075358685509882398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYhcROnyVqMQ7kNvwHRspZC&_nc_oc=AdpZnb44zUsqsiVKyHAhP0y3UyceLJzPTa8jjrmhwTGRXCqXMLSPFkVxx5-gRxDFM5s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ge22-n8wjK512_utnpvJmR-59JFu0h9i05zqVD1JjIg&oe=6A09C067"}, {"file_name": "473393890_666706275995553_5599421079029846594_n.png", "id": "1232427938889693", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820538_1232427942223026_287575864612827315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee6lwRpxZMsQ7kNvwFuJvxN&_nc_oc=AdpLLjgKK4DI4R3PfbKm-rAcjXdFKLI_cK0NWA1WOzSWfy97i_t-JPYCImgAQEG4hWQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RWcMb2krREYmIiU-I4ns1294neew3vWTOve6PQX8z3A&oe=6A09B00B"}, {"file_name": "473392129_685227204089000_6085604756842976115_n.png", "id": "994014479518529", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820004_994014482851862_3311719362689639561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frMIZObj070Q7kNvwFDhQK7&_nc_oc=AdojqyoTxs0q_U-KvqeWnoAeAsD4PAePIaIMPjwHCDh-St1nDurL-GnRTU9rI0xUGJU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74SQAZ8QmYIVn0thQjwxfoYuzfToWHWp-3jOkGT0seMA&oe=6A09E2BD"}, {"file_name": "473391918_551526610939071_1453574241822431665_n.png", "id": "659687646846083", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824220_659687650179416_8274549334002889296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTK9qkAdbTEQ7kNvwHoGHWF&_nc_oc=AdrBNEY4IGAcJBPXqMCOo5qar1m73mQazgysIHHV69VRcpNMksDIFMA-VxwDtnNuyJA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_UvMNZ6ubauHWiL0qpn2b6XlYdrgB64DMf-hIS1gN_g&oe=6A09D8EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Running V1", "keywords": [], "long_description": "\ud83d\udc12 Swing, Climb, and Go Bananas in VR! | A Gorilla Tag Fan Game \ud83c\udf4c\n\nReady to go full monkey mode? Jump into the jungle gym of your dreams with this Gorilla Tag fan game \u2014 built for wild VR fun, fast-paced movement, and pure chaos with friends! \ud83e\udd8d\ud83d\udca8\n\nIn this game, it\u2019s all about movement. No buttons, no sticks \u2014 just your arms and instincts. Run, climb, bounce, and swing your way through awesome custom maps, explore hidden areas, and vibe with other players in real-time. Whether you\u2019re dodging lava monkeys or just goofing off in a treehouse, there\u2019s always something to do.\n\nWith smooth physics, silly moments, and an ever-growing community, this is the ultimate playground for VR players who just wanna mess around and have a good time.\n\n\ud83c\udfae Supports standalone VR headsets (like Quest)\n\ud83c\udf10 Multiplayer fun with friends or random chimps\n\ud83d\udee0\ufe0f Regular updates, new maps, and custom game modes\n\ud83d\ude48 Monkey around. No rules. Just vibes.\n\n\ud83d\udc49 Download now and start monkeying around! You don\u2019t wanna miss this swingin\u2019 experience.", "short_description": "This is a fun gtag fan game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-running/home/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wcb31", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-running/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "re
=7f20f&oh=00_Af1e3G-SpNFPHunvBBVZ9mVenlrQnV5J2ISaRAO3j_MPeA&oe=69EF5942"}, {"file_name": "491819407_1411290560024264_2762186898885056775_n.png", "id": "1342775680358791", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822559_1342775683692124_1075358685509882398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfcBKpXdM2QQ7kNvwECTdfn&_nc_oc=AdoVwzlnEsDDp0KtOgWcNvWiJpxSL7ZaNzhqyhB_s6-qcwZBQtrRFrzuF55qfofY6cE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-2kp4n_eXAYnBGdOcdY-R2aqdX9Q1MJ0WJjI2-BXABQ&oe=69EF6267"}, {"file_name": "473393890_666706275995553_5599421079029846594_n.png", "id": "1232427938889693", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820538_1232427942223026_287575864612827315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVTdwkDTcZgQ7kNvwGc2Ma4&_nc_oc=AdrPhDnrB-5ZX7xew3wESwrM5_QVq43aCLWK9Vj5spUWHgx8EijRg-gF3QQnp-zlUVA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ko2qyjFrl6zJP0QA-neUq2EuZmYqhXcqfY3_Xd7X2tQ&oe=69EF520B"}, {"file_name": "473392129_685227204089000_6085604756842976115_n.png", "id": "994014479518529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820004_994014482851862_3311719362689639561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHo7n_quLv0Q7kNvwHPdjKp&_nc_oc=Ado3wsA7cqIp_ocqpa64U-HiMQsZcaYeLayFZ4UjFgtfq_ixEsURtxQ7jTZlDUCVM80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iNfVzc_tKbCnt8bv5id9X57xTdEjZ56qah2W_j5g_Vw&oe=69EF84BD"}, {"file_name": "473391918_551526610939071_1453574241822431665_n.png", "id": "659687646846083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824220_659687650179416_8274549334002889296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al7wUDKk6LEQ7kNvwHP7IQw&_nc_oc=AdoKsUotBsg2uH_sQLKEWLsfJrljexnp_hiO_-fKC0ewtHrpZISbpJ8qwS9Dcm5uMcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UwpL6QIQl8ZFw7Wa0APBMHT9ybkE01t9MnHXXMBxDLQ&oe=69EF7AEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Running V1", "keywords": [], "long_description": "\ud83d\udc12 Swing, Climb, and Go Bananas in VR! | A Gorilla Tag Fan Game \ud83c\udf4c\n\nReady to go full monkey mode? Jump into the jungle gym of your dreams with this Gorilla Tag fan game \u2014 built for wild VR fun, fast-paced movement, and pure chaos with friends! \ud83e\udd8d\ud83d\udca8\n\nIn this game, it\u2019s all about movement. No buttons, no sticks \u2014 just your arms and instincts. Run, climb, bounce, and swing your way through awesome custom maps, explore hidden areas, and vibe with other players in real-time. Whether you\u2019re dodging lava monkeys or just goofing off in a treehouse, there\u2019s always something to do.\n\nWith smooth physics, silly moments, and an ever-growing community, this is the ultimate playground for VR players who just wanna mess around and have a good time.\n\n\ud83c\udfae Supports standalone VR headsets (like Quest)\n\ud83c\udf10 Multiplayer fun with friends or random chimps\n\ud83d\udee0\ufe0f Regular updates, new maps, and custom game modes\n\ud83d\ude48 Monkey around. No rules. Just vibes.\n\n\ud83d\udc49 Download now and start monkeying around! You don\u2019t wanna miss this swingin\u2019 experience.", "short_description": "This is a fun gtag fan game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-running/home/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wcb31", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-running/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "re
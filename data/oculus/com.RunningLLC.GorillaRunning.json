=7f20f&oh=00_AQCu0mbP4372PVzW7789rBdZX2EU5rUQu6KCqe-Jkwmc2A&oe=6A6DE942"}, {"file_name": "491819407_1411290560024264_2762186898885056775_n.png", "id": "1342775680358791", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822559_1342775683692124_1075358685509882398_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnjUJ_fdsYQQ7kNvwGhd2rQ&_nc_oc=Adq_9BEiACnuBwNzEUGUbgpQ4r8XPQo-J_4MoTKyIvz-0BFERLgAKTceSklwLo8XOuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQMcJg4iO37HgPow1c6ot3YYja8_vQZ_-rQBjHyhmMQA&oe=6A6DF267"}, {"file_name": "473393890_666706275995553_5599421079029846594_n.png", "id": "1232427938889693", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820538_1232427942223026_287575864612827315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4LdlrUy0KMQ7kNvwEeUA2J&_nc_oc=AdpcxqDDpMe-_O6yEvUYutb5JN63RDuoFLpImPl9H--NBXHiqc6WlUR1SRuDapgVQok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTDMmiFv7XTpsEIDWBumL6iyAD_UNHhxbqYNH9uDlpPQ&oe=6A6DE20B"}, {"file_name": "473392129_685227204089000_6085604756842976115_n.png", "id": "994014479518529", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820004_994014482851862_3311719362689639561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3sGhwTaqtYQ7kNvwH3ifdo&_nc_oc=AdocyjQdE9wlwoE8Ar82eshlE-fVS6UzI6KX89XfN1qwOaIeKECwltuAsOT4y8-Vq08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBD_-B4tdyZ4DtAPDfRAAAas2FDTN-MjQjvR14fT2fAQ&oe=6A6DDC7D"}, {"file_name": "473391918_551526610939071_1453574241822431665_n.png", "id": "659687646846083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824220_659687650179416_8274549334002889296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OPHtPjPOx8Q7kNvwH_l3DZ&_nc_oc=AdrRH-5UTlhHAO7KQd8BzbWaIIUtPVK3tZd7Lw1pe5lymItfcwscJ4o5X2sohsIQRkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeNzGOTM2B5YJ7CpuY-5129Wc64kTNQrRQev9xpaPX2A&oe=6A6DD2AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Running V1", "keywords": [], "long_description": "\ud83d\udc12 Swing, Climb, and Go Bananas in VR! | A Gorilla Tag Fan Game \ud83c\udf4c\n\nReady to go full monkey mode? Jump into the jungle gym of your dreams with this Gorilla Tag fan game \u2014 built for wild VR fun, fast-paced movement, and pure chaos with friends! \ud83e\udd8d\ud83d\udca8\n\nIn this game, it\u2019s all about movement. No buttons, no sticks \u2014 just your arms and instincts. Run, climb, bounce, and swing your way through awesome custom maps, explore hidden areas, and vibe with other players in real-time. Whether you\u2019re dodging lava monkeys or just goofing off in a treehouse, there\u2019s always something to do.\n\nWith smooth physics, silly moments, and an ever-growing community, this is the ultimate playground for VR players who just wanna mess around and have a good time.\n\n\ud83c\udfae Supports standalone VR headsets (like Quest)\n\ud83c\udf10 Multiplayer fun with friends or random chimps\n\ud83d\udee0\ufe0f Regular updates, new maps, and custom game modes\n\ud83d\ude48 Monkey around. No rules. Just vibes.\n\n\ud83d\udc49 Download now and start monkeying around! You don\u2019t wanna miss this swingin\u2019 experience.", "short_description": "This is a fun gtag fan game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-running/home/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wcb31", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-running/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "re
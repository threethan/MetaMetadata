eiZcHm_c3kjL2EP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yErYk0YfQNkYS6pjRNybBpBX4flnTCimc65ffdnj0kQ&oe=6A296467"}, {"file_name": "473393890_666706275995553_5599421079029846594_n.png", "id": "1232427938889693", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820538_1232427942223026_287575864612827315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9w6zzmpdckQ7kNvwHOdy0_&_nc_oc=AdrlZ8cMBpaocNnWpPzcaBWb9As32viJE3vCZh_G_9thyY8P1832DXdlPMDb6ZcJau8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ClkJJ3OkTD7k7zGnWxuPFV1hIroReyiC-B1sPP8C9Zw&oe=6A29540B"}, {"file_name": "473392129_685227204089000_6085604756842976115_n.png", "id": "994014479518529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820004_994014482851862_3311719362689639561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd6uzL0al4gQ7kNvwHu_q4x&_nc_oc=Adp9zGWcKr0TTOzxdtvFlmUJ5jGbcfDxg-jQglM2T49HzAb2XfuodzpVrCBDiJoMZSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e_EkngeDLXrtQX8J9CtVE-rF7Zbq2tbvQxviPQF_-iQ&oe=6A2986BD"}, {"file_name": "473391918_551526610939071_1453574241822431665_n.png", "id": "659687646846083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824220_659687650179416_8274549334002889296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWBiedMRkmkQ7kNvwHGsZ0L&_nc_oc=AdqR63M6KO_muVSL8XopwB7SOCwyV64Rm48gSKJptKb6QisObx8hjDCVQtGbE501_AM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5zIOrpZOah-aka5Kf9nmpCiIakvaI16ZxvFoqOMvLhA&oe=6A297CEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Running V1", "keywords": [], "long_description": "\ud83d\udc12 Swing, Climb, and Go Bananas in VR! | A Gorilla Tag Fan Game \ud83c\udf4c\n\nReady to go full monkey mode? Jump into the jungle gym of your dreams with this Gorilla Tag fan game \u2014 built for wild VR fun, fast-paced movement, and pure chaos with friends! \ud83e\udd8d\ud83d\udca8\n\nIn this game, it\u2019s all about movement. No buttons, no sticks \u2014 just your arms and instincts. Run, climb, bounce, and swing your way through awesome custom maps, explore hidden areas, and vibe with other players in real-time. Whether you\u2019re dodging lava monkeys or just goofing off in a treehouse, there\u2019s always something to do.\n\nWith smooth physics, silly moments, and an ever-growing community, this is the ultimate playground for VR players who just wanna mess around and have a good time.\n\n\ud83c\udfae Supports standalone VR headsets (like Quest)\n\ud83c\udf10 Multiplayer fun with friends or random chimps\n\ud83d\udee0\ufe0f Regular updates, new maps, and custom game modes\n\ud83d\ude48 Monkey around. No rules. Just vibes.\n\n\ud83d\udc49 Download now and start monkeying around! You don\u2019t wanna miss this swingin\u2019 experience.", "short_description": "This is a fun gtag fan game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-running/home/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wcb31", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-running/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9841378325976653"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_appr
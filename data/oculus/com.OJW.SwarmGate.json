n.com&_nc_ss=7f30f&oh=00_AQTLEJOgbaLclbJHJo-GJL6Mni9SonG0GbHp1w4daMdVAw&oe=6B0C77E9"}, {"file_name": "05_Crimson_Knight.png", "id": "1105813502185345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_1105813505518678_5680104816286515801_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjB8bNXpl04Q7kNvwGrGvhH&_nc_oc=Adr4s_eCP2W4D-KZ6fiwbpzXdq27Ek-005JZLdIsHZwvKyRCTgVPff8rM-wq09Zot94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSn0K7xXxyF5Q6rjXTkZhF4wpXJUpez6wce20MwA10NA&oe=6B0C7CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_cover_2560x1440_20261026.png", "id": "2452890852128717", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593832569_2452890855462050_120136395210856295_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMsFx-7MsQsQ7kNvwHKlDLR&_nc_oc=AdrRWbiGTu312_jbFDu571Db21dyo0pQ4JTKVdr7HDybyAaFI1PHWqvQiEgMoVypMgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTW-EFFSTfMHNoL_J75esw8LU4bPLL7tQs171wWHpc7lQ&oe=6B0C7D24"}, "display_name": "SWARM GATE", "keywords": [], "long_description": "The last line of defence is in your hands\n\nSWARM GATE brings a sci-fi outpost and dark fantasy together in a standalone Quest VR defence shooter. Aim the weapons in both hands against threats approaching from land and sky. Break their advance with gunfire, rockets and EMP, and decide which danger to stop first.\n\nDefeat the lords. Command their power.\n\nThe Shadow Lord, Witch, Ice Queen and Crimson Knight enter the battlefield with distinct attacks. Fight the surrounding swarm and find an opening to strike back against each lord.\n\nTake the battlefield as a lord\n\nDirectly control unlocked lords, move across the battlefield, turn your body and unleash their attacks. Hover within a limited height range above the ground and fight back with ice, fire and shadow. Body direction and aiming remain independent, letting you change your stance while keeping enemies in your sights.\n\nPrepare for the next assault\n\nBetween battles, upgrade your equipment and choose your weapons in the armory. Hold the line through the campaign, then test how long you can last in endless defence.", "short_description": "Hold the last gate in a standalone Quest VR defence shooter. Aim with both hands, then control unlocked lords: turn, hover within a limited height range and unleash their attacks. Upgrade your arsenal between assaults and take on the campaign and endless defence."}, {"images": {"nodes": []}, "id": "1388708613147310", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_cover_2560x1440_20261026.png", "id": "1127004346971260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_1127004350304593_5169201067535620414_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agVP0NLBmgkQ7kNvwHiiX2B&_nc_oc=Ado9j7lw9bLAhEtlwWZWBD_ZRnmzbVVImMjMbhSMlPDywvRngmXcCn3lmw75EYyPPNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmZbOv2Q1sFusqy-pBZi0ov8N9WyMfGDMdT0UO2LNc0g&oe=6B0C52FA"}, "display_name": "SWARM GATE", "keywords": [], "long_description": "\ub450 \uc190\uc73c\ub85c \ubc84\ud2f0\ub294 \ucd5c\ud6c4\uc758 \ubc29\uc5b4\uc120\n\nSWARM GATE\ub294 SF \ubc29\uc5b4\uc9c4\uc9c0\uc640 \ub2e4\ud06c \ud310\ud0c0\uc9c0\uac00 \ub9cc\ub098\ub294 Quest \ub2e8\ub3c5 \uc2e4\ud589 VR \ub514\ud39c\uc2a4 \uc288\ud130\ub2e4. \uc591\uc190\uc758 \ubb34\uae30\ub85c \uc9c0\uc0c1\uacfc \uacf5\uc911\uc5d0\uc11c \ub2e4\uac00\uc624\ub294 \uc801\uc744 \uaca8\ub204\uace0, \ucd1d\uaca9\u00b7\ub85c\ucf13\u00b7EMP\ub85c \uacf5\uc138\ub97c \ub04a\uc5b4\ub77c. \ub208\uc55e\uc758 \uc801\uacfc \ud558\ub298\uc758 \uc704\ud611 \uc0ac\uc774\uc5d0\uc11c \ubb34\uc5c7\ubd80\ud130 \ub9c9\uc744\uc9c0 \ud310\ub2e8\ud574\uc57c \ud55c\ub2e4.\n\n\uad70\uc8fc\ub97c \uc4f0\ub7ec\ub728\ub9ac\uace0, \uadf8 \ud798\uc744 \uc9c0\ubc30\ud558\ub77c\n\n\uadf8\ub9bc\uc790\uc758 \uad70\uc8fc, \ub9c8\ub140, \uc5bc\uc74c\uc5ec\uc655, \ud64d\uc5fc\uc758 \uae30\uc0ac\uac00 \uc804\uc120\uc5d0 \ub098\ud0c0\ub09c\ub2e4. \ubab0\ub824\uc624\ub294 \uad70\uc138\ub97c \uc0c1\ub300\ud558\uba70 \uad70\uc8fc\ub9c8\ub2e4 \ub2e4\ub978 \uacf5\uaca9 \uc18d\uc5d0\uc11c \ubc18\uaca9\ud560 \uae30\ud68c\ub97c \ucc3e\uc544\ub77c.\n\n\uc774\uc81c \uad70\uc8fc\uac00 \ub418\uc5b4 \uc804\uc7a5\uc744 \ubc14\uafd4\ub77c\n\n\ud574\uae08\ud55c \uad70\uc8fc\ub97c \uc9c1\uc811 \uc870\uc885\ud574 \uc804\uc7a5\uc744 \uc774\ub3d9\ud558\uace0 \ubab8\uc758 \ubc29\ud5a5\uc744 \ubc14\uafb8\uba70 \uace0\uc720 \uacf5\uaca9\uc744 \ud3bc\uccd0\ub77c. \uc9c0\uba74 \uc544\ub798\ub85c \ub0b4\ub824\uac00\uc9c0 \uc54a\ub294 \uc81c\ud55c\ub41c \ub192\uc774 \uc548\uc5d0\uc11c \ubd80\uc591\ud558\uace0, \uc5bc\uc74c\u00b7\ubd88\uaf43\u00b7\uadf8\ub9bc\uc790\uc758 \ud798\uc73c\ub85c \ubc18\uaca9\ud558\ub77c. \ubab8\uc758 \ubc29\ud5a5\uacfc \uc870\uc900\uc774 \ubd84\ub9ac\ub418\uc5b4, \uc790\uc138\ub97c \ubc14\uafb8\uba74\uc11c\ub3c4 \uc801\uc744 \uaca8\ub20c \uc218 \uc788\ub2e4.\n\n\ub2e4\uc74c \uacf5\uc138\ub97c \uc900\ube44\ud558\ub77c\n\n\uc804\ud22c \uc0ac\uc774\uc5d0\ub294 \ubb34\uae30\uace0\uc5d0\uc11c \uc7a5\ube44\ub97c \uac15\ud654\ud558\uace0 \uc0ac\uc6a9\ud560 \ubb34\uae30\ub97c \uc120\ud0dd\ud558\ub77c. \ucea0\ud398\uc778\uc5d0\uc11c \ubc29\uc5b4\uc120\uc744 \uc9c0\ud0a4\uace0, \ubb34\ud55c \ubc29\uc5b4\uc5d0\uc11c\ub294 \uc5bc\ub9c8\ub098 \uc624\ub798 \ubc84\ud2f8 \uc218 \uc788\ub294\uc9c0 \ub3c4\uc804\ud558\ub77c.", "short_description": "\ub208\uc55e\uc73c\ub85c \ubc00\ub824\uc624\ub294 \uad70\uc138\uc5d0 \ub9de\uc11c \ub9c8\uc9c0\ub9c9 \uad00\ubb38\uc744 \uc9c0\ucf1c\ub77c. \uc591\uc190\uc73c\ub85c \uc801\uc744 \uaca8\ub204\uace0, \ud574\uae08\ud55c \uad70\uc8fc\ub97c \uc9c1\uc811 \uc870\uc885\ud574 \ud68c\uc804\u00b7\ubd80\uc591\u00b7\uace0\uc720 \uacf5\uaca9\uc73c\ub85c \ubc18\uaca9\ud558\ub77c. \ubb34\uae30\uace0\uc5d0\uc11c \ub2e4\uc74c \uacf5\uc138\ub97c \uc900\ube44\ud558\uace0 \ucea0\ud398\uc778\uacfc \ubb34\ud55c \ubc29\uc5b4\uc5d0 \ub3c4\uc804\ud558\ub294 Quest \ub2e8\ub3c5 \uc2e4\ud589 \ub2e4\ud06c \ud310\ud0c0\uc9c0 \ub514\ud39c\uc2a4 \uc288\ud130."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swarm-gate-quest-privacy.robust-yak-8467.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "ojw studio", "support_website_url": null, "website_url": "https://swarm-gate-quest-privacy.robust-yak-8467.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1495591273630053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1817793459419324_7737013607635026349_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-CbiDAyjq4Q7kNvwElCxwy&_nc_oc=Adr0F4PFNz0Mjuq44aHmkoGmuwUwWa1de458G4BoKVD7n2oCmlATrtpZlp7LNnITS5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRFPFKLWcj00coLu8Po2D_KJnWVURHvksibEud3o2mSg&oe=6B0C6ECA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SWARM GATE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "
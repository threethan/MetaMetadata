hc=Dd5pYu4OXbsQ7kNvwHf9wDJ&_nc_oc=AdrFUiarBbF8AdZisdiwj9xv5xx8D9E49q73viSms-kBVSAw-SdsPCBoIM6vz-XCs7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLEJOgbaLclbJHJo-GJL6Mni9SonG0GbHp1w4daMdVAw&oe=6B0C77E9"}, {"file_name": "05_Crimson_Knight.png", "id": "1105813502185345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_1105813505518678_5680104816286515801_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjB8bNXpl04Q7kNvwGrGvhH&_nc_oc=Adr4s_eCP2W4D-KZ6fiwbpzXdq27Ek-005JZLdIsHZwvKyRCTgVPff8rM-wq09Zot94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSn0K7xXxyF5Q6rjXTkZhF4wpXJUpez6wce20MwA10NA&oe=6B0C7CD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SWARM GATE", "keywords": [], "long_description": "The last line of defence is in your hands\n\nSWARM GATE brings a sci-fi outpost and dark fantasy together in a standalone Quest VR defence shooter. Aim the weapons in both hands against threats approaching from land and sky. Break their advance with gunfire, rockets and EMP, and decide which danger to stop first.\n\nDefeat the lords. Command their power.\n\nThe Shadow Lord, Witch, Ice Queen and Crimson Knight enter the battlefield with distinct attacks. Fight the surrounding swarm and find an opening to strike back against each lord.\n\nTake the battlefield as a lord\n\nDirectly control unlocked lords, move across the battlefield, turn your body and unleash their attacks. Hover within a limited height range above the ground and fight back with ice, fire and shadow. Body direction and aiming remain independent, letting you change your stance while keeping enemies in your sights.\n\nPrepare for the next assault\n\nBetween battles, upgrade your equipment and choose your weapons in the armory. Hold the line through the campaign, then test how long you can last in endless defence.", "short_description": "Hold the last gate in a standalone Quest VR defence shooter. Aim with both hands, then control unlocked lords: turn, hover within a limited height range and unleash their attacks. Upgrade your arsenal between assaults and take on the campaign and endless defence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swarm-gate-quest-privacy.robust-yak-8467.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "ojw studio", "support_website_url": null, "website_url": "https://swarm-gate-quest-privacy.robust-yak-8467.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1436775912844923"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1405016404750012"}, {"status": "PUBLISHED", "id": "1655246475983699"}, {"status": "PUBLISHED", "id": "944628961770333"}]}, "baseline_offer": {"id": "944628961770333"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1796068800, "status": "PUBLISHED", "id": "1405016404750012"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1458999550622559", "version": "1.0.71"}, "id": "1439443367608223", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "
 is multiplayer to connect with others. You also play as Computers that can play many fun game modes like Hangout, Robbery, Low Gravity, Parkour, and even so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://computerworldvrofficialwebsite.my.canva.site/#page-PB2DH4srCl5Tb6B2", "developer_terms_of_service_url": "https://computerworldvrofficialwebsite.my.canva.site/page-2", "publisher_name": "Dove", "support_website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25115590161360853"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619534_9786565768113010_5709949618498889333_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HDH72pfRCwQ7kNvwEzlKM-&_nc_oc=AdlCdv7UOuhHYzlxB5NQNSqhAsDb1namp_v-QX0dpYVnQcR8Yqfobe7QI6PQ0d6nUGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuI96Pz5rY_itdhm-ZimMbFHBXHBauZMNOgdbHCME3NEg&oe=6999984A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Computer World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id"
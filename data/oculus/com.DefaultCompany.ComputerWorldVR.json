.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbT3-erUxzEQ7kNvwHsq5rv&_nc_oc=Adq5XSI0y5EZHEyDIDzikYttepS3a0V1KyX1REKjzcopVdNdPhgDRhw-b48-Q9Tp1PE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErYdd71v7xqEUkrZ-qYEC3mretwELopI0y7Txl4arKvA&oe=6A8ECD96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Computer World", "keywords": ["computerworld", "fangame", "platformer", "multiplayer"], "long_description": "\"Computer World\" is a fun, unique, multiplayer game! You can buy cosmetics to make your character look just how you want it too! It also contains many game modes like, Hangout, Parkour, Robbery, and Low Gravity! We also use voice chat to connect with others. Explore fun secrets and collect all the collectable cosmetics! We Computer World developers hope you and your friends have a great time playing!", "short_description": "\"Computer World\" is a fun unique VR game! It uses your hands to move around, and there is multiplayer to connect with others. You also play as Computers that can play many fun game modes like Hangout, Robbery, Low Gravity, Parkour, and even so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://computerworldvrofficialwebsite.my.canva.site/#page-PB2DH4srCl5Tb6B2", "developer_terms_of_service_url": "https://computerworldvrofficialwebsite.my.canva.site/page-2", "publisher_name": "Dove", "support_website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
multiplayer"], "long_description": "\"Computer World\" is a fun, unique, multiplayer game! You can buy cosmetics to make your character look just how you want it too! It also contains many game modes like, Hangout, Parkour, Robbery, and Low Gravity! We also use voice chat to connect with others. Explore fun secrets and collect all the collectable cosmetics! We Computer World developers hope you and your friends have a great time playing!", "short_description": "\"Computer World\" is a fun unique VR game! It uses your hands to move around, and there is multiplayer to connect with others. You also play as Computers that can play many fun game modes like Hangout, Robbery, Low Gravity, Parkour, and even so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://computerworldvrofficialwebsite.my.canva.site/#page-PB2DH4srCl5Tb6B2", "developer_terms_of_service_url": "https://computerworldvrofficialwebsite.my.canva.site/page-2", "publisher_name": "Dove", "support_website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25115590161360853"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619534_9786565768113010_570994
0"}, {"file_name": "SampleScene_Custom..._13.09.2025_16-46-11.png", "id": "767915339462136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618102_767915342795469_7290443086931056465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaaMFOKZW_AQ7kNvwHzyE3h&_nc_oc=AdpQ5s3M_xSY1pgoXKgxiBlXiUes7XVv3SSDFU7bcv_TEbUvt2mRPnlFjJg6gEMDjy4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TKblFQW2lT9umEnGW5ACtZhdm-WTLJDKVCWR2Y5fLVw&oe=69F20C76"}, {"file_name": "SampleScene_Custom..._13.09.2025_16-45-57.png", "id": "1229034865647036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301061_1229034868980369_7048425638859670648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_q7k-FsUEMQ7kNvwG823Tk&_nc_oc=Adqxm-Cz4pUDJL_rmNugLp0G9CdYtjJ8Py8E2VrGNTwHbk5szEsVJ0zYCxpqc39Gkwg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35B5k6gj_Vo37HFMrYW3wFnqY0bnqnD2Ka0zq8KfkLYg&oe=69F20574"}, {"file_name": "SampleScene_Custom..._13.09.2025_16-45-50.png", "id": "2534324536938375", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296520_2534324540271708_8026610405394199532_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qcp0kJkAZWEQ7kNvwGCQ2sD&_nc_oc=AdqxFQCG-J3b6cvBG7R6_IqEzM93cJzEuCisamWdSI_M1IesGZ8ZlIBrH6xGRzidLPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2jpAmrKIeXRm2fEjvsNcMeXF5ELEQcWqrKm6XuiAPlyg&oe=69F1EB16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Computer World", "keywords": ["computerworld", "fangame", "platformer", "multiplayer"], "long_description": "\"Computer World\" is a fun, unique, multiplayer game! You can buy cosmetics to make your character look just how you want it too! It also contains many game modes like, Hangout, Parkour, Robbery, and Low Gravity! We also use voice chat to connect with others. Explore fun secrets and collect all the collectable cosmetics! We Computer World developers hope you and your friends have a great time playing!", "short_description": "\"Computer World\" is a fun unique VR game! It uses your hands to move around, and there is multiplayer to connect with others. You also play as Computers that can play many fun game modes like Hangout, Robbery, Low Gravity, Parkour, and even so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://computerworldvrofficialwebsite.my.canva.site/#page-PB2DH4srCl5Tb6B2", "developer_terms_of_service_url": "https://computerworldvrofficialwebsite.my.canva.site/page-2", "publisher_name": "Dove", "support_website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "website_url": "https://computerworldvrofficialwebsite.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25115590161360853"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619534_9786565768113010_5709949618498889333_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEN09lKEZrAQ7kNvwG8IMhz&_nc_oc=AdqN98Obm40dhs5jYgjdciBYFkYf-KVze7HMJCbtYEpO-tNGXBiHVM_AP1jj_X6Ve5k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1olHDe7qaOmgLopSfETXaQ-CVqguxOrU2LLsdcxhpIYg&oe=69F1ECCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Computer World", "platform": "ANDROID_6DOF", "context_category": {
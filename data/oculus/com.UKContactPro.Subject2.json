fY8F1qimH3MxA8y046QPE7-q1g7KpPbu2mA&oe=6A5257EC"}, "display_name": "Subject\"2\"", "keywords": [], "long_description": "Subject\"2\" is an exhilarating gtag fan game that takes the classic game of tag to new heights. With a wide range of exciting game modes and endless fun, get ready to immerse yourself in a thrilling experience that will keep you entertained for hours on end. Whether you're chasing or being chased, Subject\"2\" guarantees a heart-pounding adventure that will leave you wanting more. Get ready to tag and be tagged in the most epic game of tag you've ever played!", "short_description": "Subject\"2\" is an exciting gtag fan game featuring thrilling tag gameplay and a variety of amazing game modes. Get ready for endless fun and excitement!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subject2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "UK Contact Pro", "support_website_url": null, "website_url": "https://sites.google.com/view/subject2/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6773103532738977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_1061920655003754_2061926424760521619_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-u3J_7AM_wQ7kNvwEyst61&_nc_oc=Adrt1Q2nW7hDyPmiqcdbUeq8Pdn2NrFWSdPwHcjb68
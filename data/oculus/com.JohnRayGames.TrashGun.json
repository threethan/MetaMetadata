610_583468592711568_4877128425952397954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdE99qGhP-sQ7kNvwHvqWYY&_nc_oc=AdqWKheHlxf5XXcTNiRBoFylyaX6kRGy_8b3En0EHa8cSFgrm2-myKLs8YtxtfKOzhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hOU76_hBn3WH66d-rFpnxYUg7gvHJJnCcQwYcR-t4gw&oe=69F1EEED"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8cUBhRW2EYQ7kNvwF7TAcb&_nc_oc=Adr9KMtgHrSMZsW2fVL78o4rXBy44EEwux4y4Qa--qw1aiC2uGteRrQVxXzCeSorwAQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af141cW6r2ocp52a2IJNiwu1FRW1JnB2ojEaBJK1k2kNag&oe=69F1EDAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLVGZyYxpcMQ7kNvwHxWm6Y&_nc_oc=AdrCJTh0mG0yaU7VChtjwfF9doAzuIp3q7jahIHZVpKhIghqBs8qD-G_EpYS0OYLwOI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1Aa3w6qaf6tQHr1Rr8X56JX3xehU1avXz7XnYbnZr9gg&oe=69F209DD"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNHN2PBjjpAQ7kNvwE8WgXw&_nc_oc=AdrdaFuIbgBnopEp_VQw_LAuBVqHsSxiwiuVUjhJpCdpVCPt6lkPxWI00RJZmjFgQ2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1YmovmDWI2tPBGuoTEK1dj-jKEALQwCczAaG0kQY5tjA&oe=69F1E504"}, "is_concept": false, "is_test": fals
_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdE99qGhP-sQ7kNvwFLstSk&_nc_oc=AdqrItxZ5AebtppL5LkYiolR3EGtvUl1Kj8GtuFakbgRJ7qsa17ksqfPS5Waa_li95k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3bhE6nWxb5SQ5CkiwJuZdh3wtT2QXc6rxhFZRMCLRkBw&oe=69F09D6D"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8cUBhRW2EYQ7kNvwGb2IOr&_nc_oc=AdopwRnnzc24OBnc7-82t-SomFHCEcnoWALeW3Y2t-Ma6jxnzgCE91lr-RcGmXF_PkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af05et_MxbKcZKSNVUYSVxxh7RiCPMLWlm8s91m8BVFZfQ&oe=69F09C2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLVGZyYxpcMQ7kNvwF7MsDS&_nc_oc=Adp4vr6lF76Tcq0UK121JPC0ebnRZdSDWRK2qg-A7JW2dGHYmyb6YPAzmVSsaZreKrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0H5wc11Vi8w3fV--WBxq1MArMC3t4omoHHZpAhq_HuuQ&oe=69F0B85D"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNet_WNdy0wQ7kNvwE3RpXD&_nc_oc=AdrZRpyQr1RnGV_8ZtkOxAoGzG1hmCPQsQL1M8_jjrQX-jsE-YyF9PJybqJ6Jc9nu4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0CVC8WcPfFTH_8EHGUbPlao_WVJ3OnH9ceTlpSs3phzA&oe=69F0CBC4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "T
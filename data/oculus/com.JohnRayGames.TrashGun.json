_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dcjcfbO3UMQ7kNvwGygfww&_nc_oc=AdmsQXEpLT-pNYkbiM0V1c1xQJ6LAEQeZ8Zmo-aAZv8IyAiMD5JQIT1rUeDLu5QdCqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR4fTENy3Po_VIv5bcnMKqSU3nNh3yBz_oE9TcvpqEOQ&oe=69999A6D"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzLUsAC9-GQQ7kNvwEHLfum&_nc_oc=Adms0gEgeFj7zBqCO65mqiVKHxBxYIzWiezB2ulWb_WG73FB69gCRXmQzueZl6JZHnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEAjuyJjbvflR2rC1XXnis7pnm97YCII4JhHthcoBVyA&oe=6999992E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHXcF1TZKSsQ7kNvwH_jjBv&_nc_oc=Adn1Izai8nCOQpPVnctGgpD_MiaDLxG0j4ETqQwVfsnm-cjyka0zTR9NNAbpYM_G4Q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRJNcAdrqnim3ltznhdoMleETUM6y-qOVR2SrOk2DByA&oe=6999B55D"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxACFuztsnYQ7kNvwHmbw6C&_nc_oc=AdmbSJx--wooAvbixtccIB2yvAahtk-cGCi55-QWdN49FIhvBpYobAxkZuYZ4JSGLJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAFY7Su0Z7E7z4yBni_zdSfMwv9qmHQ5gzCS9qwKFxoA&oe=69999084"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "T
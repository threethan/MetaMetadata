_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dcjcfbO3UMQ7kNvwHz697x&_nc_oc=Adk1Yd2hv-EEQQcZB6eP8fPiiJQXmJAC6_HMh6VFNrYNKpmfEO6iEmkDUzspKiJ2S-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftAWZQluAx8OG7b0CB1AKzkAcaQrOU4x2btNDCCKCtRYw&oe=699C3D6D"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6m7Te6RSIsQ7kNvwF2dTL1&_nc_oc=AdlPuQidoSzQtWFtlxhCUVpH6mLryGqxAzpF3OoBRtgJe5JDxEynR0XBf6XwSlxh_fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBYktrp_Z6hGWxnumdWlOBYrfC1LnkWeM5mmry5U_H4w&oe=699C3C2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHXcF1TZKSsQ7kNvwHp4Ms6&_nc_oc=Adl0TEB0OWh1s7U_D7vSyYSpngHCTzQdoYfWmIBLU3GCUZsjTFUdFo6PXOnREy8b3sQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvGSpNSUGXL3JTNRM0brB0l_EFgliWhpq_2QxtRs9apSQ&oe=699C585D"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoZ9xEj5BtcQ7kNvwEN9zuh&_nc_oc=AdmnVC3GeX8MH03mXLrwSGTlRxL6ZRpbs_BsPZC0jvKl3OH-oCGc8nmvtdH8XmmyKvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsweHFYwX3Q6mWmstpKqVSe547yYymrxFVTTFodUNqFrg&oe=699C3384"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "T
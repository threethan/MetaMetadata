//scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_583468592711568_4877128425952397954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QirOFLzKvoQQ7kNvwFLIxoe&_nc_oc=AdlOuFHKKrHBqpO1Z9O4lTtbU1mlENutxwPUh8mL9EH6MbY72Aul7s2_sdbfteOO9ME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn6cq46tnHkXKTLIIf0qocIN8DrIQaZsDlwJSrH5GHGw&oe=69BBE16D"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXrxbxrbL_0Q7kNvwGAanwl&_nc_oc=AdnuuJHGaaNV9WOZXsNt85_Re0XHpg-q4zZtqmVjdb3gDs471ZeStMol20u98LiIjs4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKu0VgU2W_oVXUu5KtcfAZ9hx5sgd6azE8JT2FI7A1AQ&oe=69BBE02E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWJclj8KfrYQ7kNvwHr9xXp&_nc_oc=AdmQ4Ux_3p5QH4REjQ1c181K5i0JnuwReTtMCpy__w8aIDfyVxfjemwZIzjv2bv1wOE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBUkwMUcVosZK5BMXGCiY4vBZxHPVMeIZu2mRRvmAI6A&oe=69BBFC5D"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3oE06M-yTUQ7kNvwE-1J3A&_nc_oc=AdlhYq1Y0_rkQLfPVozJEOcUwiuR_d2l7k5316o-sVqkd3P1yEAs7W_WkshvhUNos90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhUB7344b0n_awfPsh-wHl
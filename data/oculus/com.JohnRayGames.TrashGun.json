_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNaKE2atDtsQ7kNvwGseqbM&_nc_oc=AdkCcdKtSpXKybApvkNEeapI74qxuzjLob9OVaN9kSmdkxP174KBDa8hflOCaO8Lz-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-YugQHIbuCtKjU7NpoxuH_VIULnf8STE5vhmHmdnmCg&oe=69A031ED"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KyhpjXsVMYQ7kNvwGTcX0v&_nc_oc=AdkFrzi9orfmbEC81_aLoZ0u_wdhUAtse9uAeswrYqdDjFWhai2DIiKyGfeVdxDJhfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2x6-vcioopS5ruzA0wOHBK0vDicdQg-hIhN5odl4zFw&oe=69A030AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_yi-SopHvAQ7kNvwE3LDtb&_nc_oc=Adl07I_prQdnhMqh3Cb8Gc6Km1goUlohqjN4Bhtur0yptPEcnrqzLWZ3nRgfqV87wqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6MurLpEF3PxZRqmMoa1yazWr1vMeLYzoLUZ-0PgepZw&oe=69A04CDD"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI9UK9tafsQQ7kNvwFF6xuD&_nc_oc=AdmEZV7ICg-yLzr3jsFZ02d892bP4syvrEAJ5fKq4PQ2sCEG54tBf-hLsXNprHpmX1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftqo8ZuzKufUmQ5ZTin0HwddrOm_zPEfeqqQ6IybDYIAw&oe=69A02804"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "T
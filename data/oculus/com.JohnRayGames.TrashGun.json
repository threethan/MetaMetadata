&oe=6A283F62"}, {"file_name": "A5.png", "id": "4230739730279106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_4230739736945772_6160044153145269412_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3ZtPhuiQ6MQ7kNvwFvutkw&_nc_oc=AdpTFVRAGv77KQ-Tz8_jL30-Hxk3cHLZH6fiH8uq4Q3QVkWB4L8G5swJsEIefnLeV6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90oXhPeGzf6vddQ_OstZam8vh4BF61lB-I7_jHO8oQEg&oe=6A281857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "412710949999089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_412710953332422_5619285024999579378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWQv5uuPy_0Q7kNvwH95EqV&_nc_oc=Adp7etNAjvB7mbdp_PXZAYo00WG5MFvrX01nRPxcykR5Mpli1pkWBKwx6SEjOwNY6xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ohcvBXm8XOyoY7cC6RaR-tcQovSJjCk6YSn83rPtyiA&oe=6A282C8C"}, "display_name": "Trash Gun", "keywords": [], "long_description": "TRASH GUN\n\nWelcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a virtual reality fast paced, dual wield arcade shooter that challenges players to use their quick trigger fingers and sharp brain to get the highest score possible blowing up large debris. \n\nYou are an employee of the Trash Gun Division! Armed with your Trash Guns, you must quickly and efficiently destroy the large debris that is hurtling toward you.  You must quickly identify your target, select the proper color laser, take aim and BOOM!\n\nStay aware of your guns and the lasers they are firing.  It is easy to get over taken if you don't stay sharp. \n\nSo clock in for your shift and start shooting!!", "short_description": "Fast Paced Dual Wield VR Shooter"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://sites.google.com/view/trash-gun-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": nu
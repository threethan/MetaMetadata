_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNaKE2atDtsQ7kNvwFbk7V5&_nc_oc=Adm6MSeSez-FV-WxP5ZQHPZ5XfoB-6yXQ7f3HfK_eA5-qwJDgFCxDg72mxaGOFMTkAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDFPU44L5fqcp5EQxwBYno8qdw6y1fjkXSpLv57C_PAA&oe=699D8EED"}, {"file_name": "5.png", "id": "638670770627004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222946_638670773960337_7399156288891420187_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6m7Te6RSIsQ7kNvwEtmJ9C&_nc_oc=AdkAA7klnhvzWI8Sh7ClKv50zUgqDGqB9uX6pJrbZA5uZalfyfeVCKsHHS-YUdLe6PQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyraW6EA1B2yL-LOYhMjcbdH4h2L7sxSR3JaUpCzShqQ&oe=699D8DAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75388624_4777885065565148_3664151489471799884_n.png", "id": "993384798916656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566687_993384802249989_8686519486774586562_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_yi-SopHvAQ7kNvwEBUIAw&_nc_oc=AdkiXu1zO93MutHays4w60aupdiTJ6IOcBT0hjuCScrOUoYdwj8KXR3Mu43T9YWqpYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnQiLBjCtSTjQtMp9OvFRkyN09A7fKF5vT7qX6yV7uWA&oe=699DA9DD"}, "display_name": "TRASH GUN: Join the Space Sanitation Squad!", "keywords": ["puzzle", "space", "wave", "zen", "shooting"], "long_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!\n\nQuick Reflexes Required: Stay alert and avoid getting overwhelmed with trash.\n\nStrategic Shooting: Select the right color laser for each target.\n\nHigh Scores: Aim for the highest score by being fast and accurate.\n\nClock in for your shift and start blasting debris in Trash Gun!", "short_description": "Welcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a fast-paced, dual-wield arcade shooter in VR that tests your quick trigger fingers and sharp mind. As an employee of the Trash Gun Division, you\u2019re armed with Trash Guns to swiftly and efficiently obliterate large debris hurtling toward you. Identify your target, choose the correct color laser, take aim, and BOOM!"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/trash-gun", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8094931653923048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036619_853889276333546_2374509499828446465_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoZ9xEj5BtcQ7kNvwFkgmMh&_nc_oc=AdmasGzL4a7Rd4t_kR9u3oACingB4zbzydRWjKjAihZHMW4hYEhWBd6STvDwHviWkUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfukwakaN2edmGGlJqP8hllyVc__n8uFoLq-t-0Ll77WmQ&oe=699D8504"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "T
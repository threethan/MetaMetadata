CJfAV66peavC099w&oe=6A4691E2"}, {"file_name": "A5.png", "id": "4230739730279106", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001691_4230739736945772_6160044153145269412_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp1ac3632sgQ7kNvwHiPtRU&_nc_oc=Adr3EFHsR8m_YvPR8aoVz_6H1tPRc0F-HPtxOlHfaESdzeNXMMIVguNJ-F9jIxfegqU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wl64M2kra0XHjabL8XsnflKLPtPIdAyPD57caLdW__Q&oe=6A466AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "412710949999089", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003281_412710953332422_5619285024999579378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ou1_zqM4C0Q7kNvwHGeXEv&_nc_oc=Adpga7InzEqy-WHGuqoeZ7bXIYtv0JVoRF1rHUEgVO3t41xmtoD5wsC7vHUe8mt3ZNU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wF_Lx3sxql5ML48XQQW0QWuTH53GoV_jWbgzjC17yKQ&oe=6A467F0C"}, "display_name": "Trash Gun", "keywords": [], "long_description": "TRASH GUN\n\nWelcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a virtual reality fast paced, dual wield arcade shooter that challenges players to use their quick trigger fingers and sharp brain to get the highest score possible blowing up large debris. \n\nYou are an employee of the Trash Gun Division! Armed with your Trash Guns, you must quickly and efficiently destroy the large debris that is hurtling toward you.  You must quickly identify your target, select the proper color laser, take aim and BOOM!\n\nStay aware of your guns and the lasers they are firing.  It is easy to get over taken if you don't stay sharp. \n\nSo clock in for your shift and start shooting!!", "short_description": "Fast Paced Dual Wield VR Shooter"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://sites.google.com/view/trash-gun-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "supp
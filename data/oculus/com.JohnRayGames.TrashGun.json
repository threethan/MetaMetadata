&oe=6A6DE6A2"}, {"file_name": "A5.png", "id": "4230739730279106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_4230739736945772_6160044153145269412_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImmVzCzWX4MQ7kNvwG4QxbE&_nc_oc=AdoJUX8ostdki6P0b46_gTNAEVQrDZkAIVGiPNdgG7eyckZk9-aAqjBvWFNc4yjPoc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCodEoilPDVg5If6BSE58dqL3lzbwuIyoIPzaaRvleA0A&oe=6A6DF7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "412710949999089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_412710953332422_5619285024999579378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F31yqdhnDmwQ7kNvwEh1ryH&_nc_oc=Adou6gTPRrkLzoCtyKZPdeoPlvR2dFHOCRB56URvs6tCuL9RFwi4ZD6wCtcfT-9Kmnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9RqfUplzJV01zhIMCDFFRl-20Ye9vV15hpjAwkTj-1A&oe=6A6DD3CC"}, "display_name": "Trash Gun", "keywords": [], "long_description": "TRASH GUN\n\nWelcome to the Space Sanitation Department - Trash Gun division!\n\nTrash Gun is a virtual reality fast paced, dual wield arcade shooter that challenges players to use their quick trigger fingers and sharp brain to get the highest score possible blowing up large debris. \n\nYou are an employee of the Trash Gun Division! Armed with your Trash Guns, you must quickly and efficiently destroy the large debris that is hurtling toward you.  You must quickly identify your target, select the proper color laser, take aim and BOOM!\n\nStay aware of your guns and the lasers they are firing.  It is easy to get over taken if you don't stay sharp. \n\nSo clock in for your shift and start shooting!!", "short_description": "Fast Paced Dual Wield VR Shooter"}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://sites.google.com/view/trash-gun-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": nu
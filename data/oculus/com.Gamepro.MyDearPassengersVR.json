=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFWOUaqYXpIDtlvrD8eSiE0AI51QYyd0YfiSqugWKYcQ&oe=6AEDFAAD"}, {"file_name": "5SCREEN.png", "id": "2305093593653182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312332_2305093596986515_3073611306704309787_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQepKqeJ5nMQ7kNvwFJOmRB&_nc_oc=Adqj9TDseqqDN2Zkx_D0O1ZSWhpO8Sne1H0xrXuMgSAitbnZsfFKRvvyI5jWKgv7YZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXVIWjVd0bqljfKqMqqn_AXCotKiBVuai7b7eSfkKeXA&oe=6AEDE6C5"}, {"file_name": "3SCREEN.png", "id": "1421446303230885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823984_1421446306564218_5222375582180634707_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNtVCJwjU-gQ7kNvwHS_ydF&_nc_oc=Adoiqj_QAismUFf-YR4zu3S8-TmBF5xg_pn7Rzi2LIiWDDs2T1fYOVfh5vMzWzPyqN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSamcQDhTU4Gmb0GGPbgHp12LcdVi9cJWK7L1jmcmh5VQ&oe=6AEDEB50"}, {"file_name": "2SCREEN.png", "id": "1367817825418972", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311597_1367817828752305_5344671488242605777_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsJnILSuZgMQ7kNvwGa375D&_nc_oc=AdotgJ3Q_479lr2_Eunng6gSpdyqCQr_YU2Omx9QiVRATnaJlcw2oEzk60IR0QDnoGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc3bwEzmaLvwhV2RqaD5UKLqLDZPk5ReCbcUhbejNwDw&oe=6AEDEF78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Dear Passengers: VR", "keywords": ["dear", "passenger", "passengers", "passangers", "survival"], "long_description": "Welcome aboard... unfortunately, the plane is too heavy.\n\nIn My Dear Passengers: VR, you step into the shoes of a desperate pilot with one objective: lighten the aircraft before it's too late! \n\nGrab, drag, and toss your passengers out of the plane using immersive VR controls in this ridiculous physics-driven comedy experience.\n\nEvery passenger reacts with hilarious ragdoll physics, making every flight unpredictable. Throw them one by one, watch the chaos unfold, and do whatever it takes to keep your aircraft in the air.\n\n\ud83e\udd23 Physics-Based Mayhem\n\nEvery passenger is a floppy ragdoll with unpredictable physics. No two flights are ever the same!\n\n\u270b Immersive VR Gameplay\n\nUse your virtual hands to grab, pull, shove, and launch passengers overboard with intuitive VR controls.\n\n\u2708\ufe0f Save the Plane\n\nThe aircraft can't handle the extra weight forever. Think fast, act faster, and keep the plane from crashing.\n\n\ud83c\udfae Features\n\u2708\ufe0f Become a desperate airline pilot\n\ud83e\udd23 Hilarious ragdoll physics\n\ud83d\udd90\ufe0f Fully interactive VR controls\n\ud83d\udca5 Funny and chaotic gameplay\n\ud83c\udfaf Easy to learn, hard to master\n\ud83d\udd04 Endless replayability", "short_description": "My Dear Passengers: VR is a hilarious physics-based VR game where you're a pilot trying to survive by throwing passengers out of the plane before the extra weight causes a catastrophic crash. Use your hands, grab ragdolls, and embrace the chaos!"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_i
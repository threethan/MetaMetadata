Uvsso7Jo3MWLsP112_bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftGcITvz1HYH7WIug2BhpdPDKbzcSU0wsulbm_-Se5Zwg&oe=699C4887"}, {"file_name": "75404387_453624625623172_2538205558139346582_n.png", "id": "240525020870348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375755_240525024203681_4940177851239959190_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QbAJVUxOq8Q7kNvwHKLnnx&_nc_oc=Adm2NN-ZuB5UJOYFta7HIkoRO6G4keNwQ1JY6lwBDOb5ry0YWvSRzgqYBhYvVqR53HA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afth1CsNLCmWaFl_uxcgKVwnMe7NQ-JqrLHVCB2Tt5Qzew&oe=699C53A4"}, {"file_name": "75240094_842914339793001_3493817095934102072_n.png", "id": "237124601226992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_237124604560325_4234804167903130137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEYtT7xFT8MQ7kNvwHkyLFG&_nc_oc=Adn9pGknWL3LWtbrrBrfj0-4jfW7Dw1bO6icH2EMxiwo8KuJLRm1HmLl2C1vvUpSr9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvyZe0MJZUA-xUapykqCbjYFhhUQ0sMLicO6y3BHNsD0w&oe=699C3D0D"}, {"file_name": "57568684_654765005194996_6924332882803739041_n.png", "id": "146828247253657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395587_146828250586990_1687061029070534300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsxLioI4Qi0Q7kNvwGoBzPJ&_nc_oc=Adnan6_PfsMaLa_RsoLTdR5OcYBEA1FTIQhQoQnhy2w45qUSy9CnaOcyyVxBFhi8mfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuy0c3hKOJ82PQ0W_hmrd9XTtCdEofqWhZLXyTM_XSucQ&oe=699C4C9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NokNok", "keywords": [], "long_description": "NokNok puts recording front and center while including all the features and functions of a meeting and collaboration space.\n\nCreate your own room or NokNok yourself in. \n\nSolo or team, here\u2019s what you can do:\n\nPodcasting Camera:\nUse our companion app to set points in space, and easily switch between different angles. Streams right to your pc with a built in recorder. \n\nAutopodcasting:\nThe camera will record those that are speaking automatically. This feature can record up to four people and a zoom out of everyone. So you can record just by yourself with ease. \n\nTeam Rooms:\nPersistent  rooms. Ideal for remote teams that want to have their own pocket dimension in VR. \n\nMemories:\nEasily send images and text from your browser to your avatar and vice/versa. This works like Dumbledore's pensive, take things out of your head like memories.\n\nBlackboards: \nBoards how they should be, when things were done the chalky way. Equipped with haptic feedback chalks.\n", "short_description": "VR offices and podcasting. Easily create rooms and invite others for meetings or use the rooms to record yourself/meetings with our camera. The rooms are loaded with blackboards, writings tools, and you can easily brings pictures and images in and out of VR. Hang your pictures and save the persistency with team rooms. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.knoxlabs.com/pages/noknok-privacy", "developer_terms_of_service_url": null, "publisher_name": "Knoxlabs", "support_website_url": null, "website_url": "https://www.knoxlabs.com/pages/NokNok", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "356892853125797"}, "review_messages":
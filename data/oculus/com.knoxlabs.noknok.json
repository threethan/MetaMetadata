568684_654765005194996_6924332882803739041_n.png", "id": "146828247253657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75395587_146828250586990_1687061029070534300_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lY3uatT3IEQ7kNvwHOLVh-&_nc_oc=AdpSHuvrwWwggCN_60PNgkBKaIGvulJu3zt5oXHg5b63b4vgcrgntUOLueT-Zvzg2dE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKgai_pmFcJL001C1eErePphasxtyxavSGwy4n8npPUQ&oe=6AFB33DB"}, {"file_name": "75240094_842914339793001_3493817095934102072_n.png", "id": "237124601226992", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_237124604560325_4234804167903130137_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnbTZIlxDcAQ7kNvwFyYJeT&_nc_oc=AdpRJfjUB83Q-f2_fdJHZv7RXcdBTIcBGJf8DAgIqjSWDZcN4dm9sryJuWVZan-uZ_Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-ycRfwLhn6tMRArGugEi1w2KwI3ih-nD-rxiiGgLc9Q&oe=6AFB244D"}, {"file_name": "75221325_480925516211859_3540034672841836592_n.png", "id": "411932076549604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210398_411932079882937_8487440125796749397_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9X9ZGAULdoQ7kNvwF5K7EQ&_nc_oc=AdqNVczOMpLaZe5rGtLTzFcm0-mz2MQ6ua1_5BQb32Os9Tykt6I7yw2y5ii_HtuChu4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTns0tk-TWxhGONOwcZ8wy1csg4h-vDiIoL5W3Iklg82g&oe=6AFB4892"}, {"file_name": "39031322_501468720770880_4648276654824930002_n.png", "id": "256345845894472", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375756_256345849227805_5970296405519220123_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeeScaP6_KIQ7kNvwG8Q5U-&_nc_oc=AdpPYF4iN5WUeeBNhECLopI3v3pQyelhitJr7YcM6E0p_jpKsg-W-Uv0CxQSjBPw7Vw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQII6QQgVCafC5xtNFAB5zRp5lOuboy3fNLWC6qJgxDbw&oe=6AFB2FC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NokNok", "keywords": [], "long_description": "Offices. Meets. Parties. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in. \n\nSolo or team, here\u2019s what you can do:\n\nBlackboards: \nBoards how they should be, when things were done the chalky way. Equipped with haptic feedback chalks.\n\nThe Elevator:\nIt takes you places. \n\nPrivate Rooms:\nSpawn a room, password it.\n\nZooming:\nSpawn a selfie camera & do calls. \n\nBrowser:\nA tablet browser in your hand with a keyboard attached.\n\nPresentations:\nMaximize your browser, put it behind you with Google Slides & spawn the Zoom camera and record yourself.\n\nText recognition:\nCursive your way through, then scan it to text. \n\nSave:\nSave images to your pc. \n\nErasers:\nFor when things don\u2019t go right. \n\nIntuitive controls:\nRadial menu + discard anything by just throwing it away.", "short_description": "Offices. Meets. Hangouts. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in."}]}, "developer_name": null, "developer_privacy_policy_url": "http://noknok.space/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Knoxlabs", "support_website_url": null, "website_url": "https://www.knoxlabs.com/pages/NokNok", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres"
-7&_nc_sid=6e7a0a&_nc_ohc=zLmJTQAeGM0Q7kNvwH5oRfY&_nc_oc=Adpb1Kf_O2Gq_jSR_k_OP2lev4hKg3A9QoaSPUfGZnTYwTtuY0muftrWo2OQD4uz6OA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Yc-qPcTnnEklhY2UhK7yxAursJeOA8ITjqd1sjkz__w&oe=69F89187"}, {"file_name": "75404387_453624625623172_2538205558139346582_n.png", "id": "240525020870348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375755_240525024203681_4940177851239959190_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPPZGfjC5r0Q7kNvwESREKg&_nc_oc=AdpiRKJngwkKFDGmceV90V-tQnB0h8GLXqIMwuS4KLaD42KtRCOcfVBDfmfCVER6vUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iEpPoNf-pfFR0grv5fSuqFEfrPJQytsIovu_0XzWcVA&oe=69F89CA4"}, {"file_name": "75240094_842914339793001_3493817095934102072_n.png", "id": "237124601226992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_237124604560325_4234804167903130137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdAtNs1L55UQ7kNvwFWsYpG&_nc_oc=AdqLtA29hV4cDgnGQX0U3TwQU--2kDxzQo01NKIIf5oOVfAzkVatSi5lr7W3B82odIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VgmijEVClZsUT-vaP5lW7eAMq7BmffPhq5nSkNeVgaA&oe=69F8BE4D"}, {"file_name": "57568684_654765005194996_6924332882803739041_n.png", "id": "146828247253657", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395587_146828250586990_1687061029070534300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAL667U-aGYQ7kNvwFHp7LG&_nc_oc=AdpoKjffI_sWb_Ym3W-B7uCPp5ZOxrNx_C7Bea4OZT6xLshdPH-1VY_MwBiRQ5cacAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JULuCn2Essg8h0sFfxNX8pcsHrQqAnlsMU98Af4Z9vA&oe=69F8959B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NokNok", "keywords": [], "long_description": "NokNok puts recording front and center while including all the features and functions of a meeting and collaboration space.\n\nCreate your own room or NokNok yourself in. \n\nSolo or team, here\u2019s what you can do:\n\nPodcasting Camera:\nUse our companion app to set points in space, and easily switch between different angles. Streams right to your pc with a built in recorder. \n\nAutopodcasting:\nThe camera will record those that are speaking automatically. This feature can record up to four people and a zoom out of everyone. So you can record just by yourself with ease. \n\nTeam Rooms:\nPersistent  rooms. Ideal for remote teams that want to have their own pocket dimension in VR. \n\nMemories:\nEasily send images and text from your browser to your avatar and vice/versa. This works like Dumbledore's pensive, take things out of your head like memories.\n\nBlackboards: \nBoards how they should be, when things were done the chalky way. Equipped with haptic feedback chalks.\n", "short_description": "VR offices and podcasting. Easily create rooms and invite others for meetings or use the rooms to record yourself/meetings with our camera. The rooms are loaded with blackboards, writings tools, and you can easily brings pictures and images in and out of VR. Hang your pictures and save the persistency with team rooms. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.knoxlabs.com/pages/noknok-privacy", "developer_terms_of_service_url": null, "publisher_name": "Knoxlabs", "support_website_url": null, "website_url": "https://www.knoxlabs.com/pages/NokNok", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
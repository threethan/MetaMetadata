", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75254874_237124604560325_4234804167903130137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFR8Bm6J3qkQ7kNvwGjMLzZ&_nc_oc=Ado2bG1awVLZ54UprRbTzy7aLcFToXZr5dOWl3ADKqZG9iYkaX9Lng70u2_mtMEQldM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28ZJL1Uh12TtK48sD6OiusYGWV04o1DOSufNgxZB0fmg&oe=69D7908D"}, {"file_name": "75221325_480925516211859_3540034672841836592_n.png", "id": "411932076549604", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210398_411932079882937_8487440125796749397_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co74ma7Y3_cQ7kNvwF_FwFl&_nc_oc=AdpScckZTjjZyqqkioEJfe0TNOVN5NZYYgIDjHL70yqc0kjw4CR45229-1FFjmbzEIQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IhD1VRz7hPh3Axykwqksi98PxgcMJ7iT88-d9ego-gA&oe=69D7B4D2"}, {"file_name": "39031322_501468720770880_4648276654824930002_n.png", "id": "256345845894472", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75375756_256345849227805_5970296405519220123_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4zgM-LNkpAQ7kNvwGv5hNa&_nc_oc=AdqdL3-6Tgk6xUvhIQ7XBMpdJjvqjnxTAQBdxiXlf0slaYI7XzNZEGra6H0Z4KVCQgA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15czjMn-WrV0zzYaL7NKPX2qC__70jsQkAuaGY8YgtrQ&oe=69D79C07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NokNok", "keywords": [], "long_description": "Offices. Meets. Parties. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in. \n\nSolo or team, here\u2019s what you can do:\n\nBlackboards: \nBoards how they should be, when things were done the chalky way. Equipped with haptic feedback chalks.\n\nThe Elevator:\nIt takes you places. \n\nPrivate Rooms:\nSpawn a room, password it.\n\nZooming:\nSpawn a selfie camera & do calls. \n\nBrowser:\nA tablet browser in your hand with a keyboard attached.\n\nPresentations:\nMaximize your browser, put it behind you with Google Slides & spawn the Zoom camera and record yourself.\n\nText recognition:\nCursive your way through, then scan it to text. \n\nSave:\nSave images to your pc. \n\nErasers:\nFor when things don\u2019t go right. \n\nIntuitive controls:\nRadial menu + discard anything by just throwing it away.", "short_description": "Offices. Meets. Hangouts. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in."}]}, "developer_name": null, "developer_privacy_policy_url": "http://noknok.space/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Knoxlabs", "support_website_url": null, "website_url": "https://www.knoxlabs.com/pages/NokNok", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "668975210904837"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_sup
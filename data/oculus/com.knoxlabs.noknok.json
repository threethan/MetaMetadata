", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_237124604560325_4234804167903130137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUKhgabjGWsQ7kNvwF2QVFg&_nc_oc=AdolgRKEZlaylMXT0dCtgUdFo9HdX8SXTj03ouDjFLcI7JXI1ozYruSJPHnzYfxnt0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rp3zYGt6VIuo4a3jU872vzrlz0JxnTW8Qa_n8owcTTA&oe=69FF1D8D"}, {"file_name": "75221325_480925516211859_3540034672841836592_n.png", "id": "411932076549604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210398_411932079882937_8487440125796749397_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn9w7ZK9mMkQ7kNvwFiBsqk&_nc_oc=Adqch4wuJAHY6xAFgLcaAgQxy8gS_otUjgmmwguwp5pziGeMOtqdnB3o395Z_GazFOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y1KP0Icg_-OLOebDdFdjX5oNzMQmAjfPnhQVw62t-7w&oe=69FF41D2"}, {"file_name": "39031322_501468720770880_4648276654824930002_n.png", "id": "256345845894472", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375756_256345849227805_5970296405519220123_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTyVfMPXdqEQ7kNvwFqJ7gq&_nc_oc=AdrpCjk_l2wDqzgp348glqcaDlTPBbpdHvwb5myRdI1uQP1JgNFeM66y4vRzNwSClKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KC0cxZ4OWrUghHgIXa2DypLn5geO7aWb8SeCXOzTMZw&oe=69FF2907"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NokNok", "keywords": [], "long_description": "Offices. Meets. Parties. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in. \n\nSolo or team, here\u2019s what you can do:\n\nBlackboards: \nBoards how they should be, when things were done the chalky way. Equipped with haptic feedback chalks.\n\nThe Elevator:\nIt takes you places. \n\nPrivate Rooms:\nSpawn a room, password it.\n\nZooming:\nSpawn a selfie camera & do calls. \n\nBrowser:\nA tablet browser in your hand with a keyboard attached.\n\nPresentations:\nMaximize your browser, put it behind you with Google Slides & spawn the Zoom camera and record yourself.\n\nText recognition:\nCursive your way through, then scan it to text. \n\nSave:\nSave images to your pc. \n\nErasers:\nFor when things don\u2019t go right. \n\nIntuitive controls:\nRadial menu + discard anything by just throwing it away.", "short_description": "Offices. Meets. Hangouts. NokNok is a place where you or your team can meet, do work, and socialize. Loaded with lots of intuitive tools: from good ol\u2019 blackboards to text recognition to Zooming to elevators to selfie video podcasting. \n\nCreate your own room or join the fun in the lobby. NokNok yourself in."}]}, "developer_name": null, "developer_privacy_policy_url": "http://noknok.space/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Knoxlabs", "support_website_url": null, "website_url": "https://www.knoxlabs.com/pages/NokNok", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "668975210904837"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_sup
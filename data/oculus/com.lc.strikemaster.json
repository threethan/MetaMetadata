Kk&_nc_oc=Adqky4zFso-yWfNPCMwyY6SCpRPgva7-GZAJ9O6OgVVM_mvKY2Y6B2AeCOxtgz9YGWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HOcWs4p-9iFF8Q18LqFkbg5Eyzuk2MdEhKmofPDyL5Q&oe=69DB83FE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly8LrDHY98oQ7kNvwGeYZd2&_nc_oc=AdpxQP2j9LTe0jwHmgcS6INLg0uGo-6Elk0zGdE74kTVjZbXWAsO58ca47wgxGxzpk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HN6d-NrSGVm_PHDnuH2roEJK0rwcO8ZNeonou6eiroQ&oe=69DBAF0C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw3NZhCPPT8Q7kNvwE4bYhE&_nc_oc=AdoXVECZsDNmLnWrO4hw1R_aspSpMlSHZ9BFcTNjv4gaI-OM8qfLr8oWB-g21tNwE9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x3LqO7muZy1diZiqveDoEA8IRGLct_MjcLRwoQJdKNw&oe=69DB957E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yFqSof5XOUQ7kNvwHLlg_d&_nc_oc=AdqCyF8uNywlRzgUW9ZtPH7andlAEjRfsZzH8Oh5YC1_ZqqOzCv_1zXf7XGXKQLODek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RvZ5iCwLYSCVcfV7Bcst_uDDnipCV97ih5lmSqqhOyg&oe=69DB95FB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57
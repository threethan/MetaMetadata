kNvwGU5Rxm&_nc_oc=AdqIfg263_9lO8LPfsDN4I_8JXTo1BmDgSkOQG-zgIyuAc_h3HkuBvpEtjwA5es_N0A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBphkpVX2vJ7IpWmslwe2A3xCezobI2sKFG9h9n69UbQ&oe=6A8ECFFE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVQusoW-kOEQ7kNvwF2NaVX&_nc_oc=AdrK69g-Hlh5Bb8GBUt7MaormtQGnQoy4nAjjFu_Qx90jwoCsnfFhjpesRzpSueS6O4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt6T7rkHo9wurbQ5L-b6mBuYDDKZV1UM2y9FWtffJCbg&oe=6A8EC2CC"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2YJjPuICrwQ7kNvwHFdm1G&_nc_oc=AdpD9zt2rKuH5QWHcUWjeQRieyCknY0L9dUJmcOuP7ARRsJxVIWWj0LMExSnshDuQ7w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG09dEyvBWOoWcEJSMXCNViROOtgANBM2TcFQcaewy9TQ&oe=6A8EE17E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in7-3tmzFCoQ7kNvwGAQkU2&_nc_oc=AdowUwx5PnEwMMIupczrF8syZhomnI-ALIiTUeM5SOY-1Gms2DXj8Ruyeg04iB2s1J8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF96dwOZzOe3eF_2ah6DetKRvwPJH0D-mHD8hHGwfZydg&oe=6A8EE1FB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t6
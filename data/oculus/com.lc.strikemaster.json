dn.com&oh=00_AftShLIbfbGubYzI7xGbJGZwtKf14gy_bteY9s7c5HNI1g&oe=69A181FE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_efCoYX7wAIQ7kNvwGiu1vW&_nc_oc=AdnC9cEnTLjbmGyNyH5TnH27dI9gcxLmWnBi94hVlLDJNkeH1bg8a3A56MvKQic0EP8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsAtGbJgy2hPr_IzUoja1cx8-vKmz4EqphwVfSnyL6G6g&oe=69A1AD0C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB2dng6QyUMQ7kNvwGCAAN6&_nc_oc=AdlFdw7Ma4KoaEsxrFC9G2nWiTsn8nNTHDd8STu7qISEI5xRgytfejVBjpF3i8zSICc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu3wynOSAj2D_hNAKgaBdeRpNsDCm6BTJOhYAo3jfllag&oe=69A1937E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xmHh0b-L9sQ7kNvwEeuA0W&_nc_oc=AdlxnNQmV3E8fMqyT8IeGKo0MumfxLYCV6QVhLxcWK3_4IPiwqbqnoHrWjTw9IPlX6I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftuC3_gqBIkUiIRENkBdG5nrxemxxyHM-I3XqejRKP1EA&oe=69A193FB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57575361_1478273389745838_8899150778094333484_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcI8VwI0OicQ7kNvwHC_zIu&_nc_oc=AdlvLmIoJay_1AB0TZdxqKHO
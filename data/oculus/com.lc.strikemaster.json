pD&_nc_oc=AdoH5fyIsNO8UQC0xBvBkgBK7jdy7Nce6KEdQ72jhCMRQsGle18MFOs14XN-uszuDjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWUA_5Jd_U8SIL4GgyzK1bHP5NkLeQkkT-NH0kzTQOw&oe=6A537C7E"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8I2c4zd-ccQ7kNvwEgFO1g&_nc_oc=AdohkkFSOhQ887rUGdvEiNn3LoLo4f3vF7u-7SFrnm4JkdZAN4KUzocC10EDA7T6VBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw_ne2bTw1Z-z46J73FGugB5Ish5JDACF9eg775bqP0g&oe=6A53A78C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHIGOf8hF6wQ7kNvwG1vUwq&_nc_oc=AdoTY__M3Rygpb1Xj7IxfyJCeUPujcX8JZamDnhDlTdSE8Pep0VLpYjcbUp6ofizcb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAYfPfWcUoyZpM0wvfMIrJJlNqMFIUWUTbrDpQwT_yAQ&oe=6A538DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaQ5JNMcH0oQ7kNvwEz0hmd&_nc_oc=AdpjxB77qSVA0fNX6HFFM1349ismf5CD6PJCOhGYUv3ANfqctwsfrOJzx7q43OEF3f0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyN7JknP5mlumv3UJWde_X6gBwWz6uGUyfpw4kRZSrqA&oe=6A538E7B"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57
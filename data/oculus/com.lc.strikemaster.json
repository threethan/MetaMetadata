AX&_nc_oc=AdqdE6mDGPRpJcKRcVOdUzeaZFsz8855kpJ4EebuD6XI7O3fc3fm899ZP7MuCBYBDm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ojeKaBJfR5PYes1ILmqGCUGRSOejV_4IF70RbixJ9hA&oe=6A2AD63E"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnC1E511iHUQ7kNvwHJCTYd&_nc_oc=AdrRppMnAbXyJ-_YuntuGJWon3VOhpw13_Va5uIuhXY34RpPx4YqUYRbt_yIVSneS6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5QPiGJKM0Q9H_N91tmqKfiRbCAfu97-ro334gVmv8lQ&oe=6A2AC90C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlwbOLCAUloQ7kNvwEtuSVN&_nc_oc=AdrbqWKANut31UaVVSNxyQ47dyAtdeYj8N9merLoqmYIgRbMBcL308fYjRUn7rUzntE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_g4n7YXHtUvpOA4PH6-12pthAkfGk3FdWXtqrdFmYSA&oe=6A2AAF7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMfpf0-u7zwQ7kNvwFAuLGj&_nc_oc=Adq1umQtScmmimNxNHdeaRogsQYFk1_soa-DPBpP3wCsZ3p7lz56kxka6mA6D3RVdww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QBaPJGfNm4JwyA9oU4i0JR48zf9Ele3oj7zUtD-k1ug&oe=6A2AAFFB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57
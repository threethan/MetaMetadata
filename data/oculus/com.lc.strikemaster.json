4765A"}, {"file_name": "ss1.png", "id": "320322097812151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_320322101145484_3548926885375784114_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biUEQ-c-QdsQ7kNvwHQ0ULw&_nc_oc=AdoOCwJ6iBHeF-08Kz-Hr7ASqIE1WjaP_hM9YA3hdyEvxjjte4z47L07E0F0_qTiHjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMPoYDQdf8Gm6l1pzWEPWwTXW5144CUFzQrMTo7ls_dw&oe=6B045DBE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcxuUSKS-pUQ7kNvwHlEZCa&_nc_oc=Adop5w4MqloVdIN-RfgZr4hME5Di41E88JAYEaCkNs5YI0JI006K0YwhItI26_vB9q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThgHmpcNxzXSkb925CVoV39A3cqaYc29BaPlmBFqOt8A&oe=6B0488CC"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9u4Xh0PvpEQ7kNvwFTAOwH&_nc_oc=AdoKqXNDEBUnnHdyBxPejJiMv1ejPymE5v96c-QVlxhoAfjrQ_FzE3r9VXiw8Y1MHQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvKHvRq-eBsysOxCaOeZgWOCWdcqWNo8omIS5B4-WsNw&oe=6B046F3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn8syp1eE1AQ7kNvwEY_uLK&_nc_oc=AdrICw87tVDyAFSfHtcjpDfSRrs4q2HYwZv14BuOh94BsN1FlEmhAuL2HURvnavIh-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqBWHDH5l7snADJQxukLkuiTaM4S5jt-dPhmPYKYvVbw&oe=6B046FBB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
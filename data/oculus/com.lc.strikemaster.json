F305A"}, {"file_name": "ss1.png", "id": "320322097812151", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86796210_320322101145484_3548926885375784114_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVVNM3QaGgAQ7kNvwEkBCUq&_nc_oc=Adrl6B-sWFGW0r8idwOVbN0wAmaZTqoL2hKZDj4ny9iTYPRSCI02I68XNdRYTLXYWWM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKwbh_wJ8JLASGvEJL7JMG_b63IeG5_2NYnUANU1jC6A&oe=6AFF17BE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_31FPFYeu4Q7kNvwF23751&_nc_oc=AdqnCMwNpKOwvjbN0wyNlOhV0X68JtDKqy7DhI9oTSZgxRtcjJvW5tFHwY8DokWSrZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgziW1Oq1Pu9KMvpTGkP8ZBxr1jKpOlv-dvqMYy3FBSQ&oe=6AFF0A8C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBS7TrLb4QEQ7kNvwGUCl8R&_nc_oc=Adr4Mf_UIxokyvE5T3_oWWNkQllZee-Q86x0QIPQyQzDCcpGfBg8jeA-6gk8CXTAKsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS333U1xpcv27Ow7nd_46-r0ACzGclvQ2Ur6G9DBr4VQQ&oe=6AFF293E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Mlp3Vlob0sQ7kNvwEHInzk&_nc_oc=AdqFZMKk8UBwjLcjD8Um2LJ9o3BV2ys4UsjdO5UelwYIEHMtg7XAYYBlgPvmAAv6QMg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgcacQzPtlaT0o3OkHb7nDcN5BnfayOUVJXRpWocufug&oe=6AFF29BB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
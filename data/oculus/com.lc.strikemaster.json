scdn.com/v/t64.5771-25/86796210_320322101145484_3548926885375784114_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8fN9wFoxdAQ7kNvwGHYzlg&_nc_oc=AdqciuLdnATyik0ok5a6N8GqvD0Jc49UoFj6fWAZ00-xX7dX_ZA0DYNHWNfuP9KJgk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxcvkkL2-zEXWMsYAaMFR-beym0GyaAe4p--dXVT_JIA&oe=6B0EE9BE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7IWbqYoAZ0Q7kNvwFlO9gU&_nc_oc=AdojzZ4Cx283D2CY288l0lmRSjhgMyC8dMEkuiPsKnN1kXAvWukrPJ9hxJdfFnMaZUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV37kbX6163rHfh7gxvPqooS4S95zb23Aqe8f4m7Nv2jQ&oe=6B0F14CC"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce2UkXNEw-EQ7kNvwGa8qyD&_nc_oc=AdocPU3TUiG5jylZhb7grVBhfe47klJzmmtagDLWhtX-vZC3yvE4E9ZSHbTuewxdJfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_n80E8pU_UUyilSNq_n4WuWGI4FBbTyuPje4h8SLPzQ&oe=6B0EFB3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTalAgAuea4Q7kNvwEGOVB9&_nc_oc=AdqB3d-Qk6GHtyCvERQdstZZ40LYk5bL82eb_z6rC46-2NRDSo6-vw8SY5EVj0VO4Eo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDa6HRfGzoX-PqLcOO24r0U-B_5lqCfYDx2dDV8kRn-A&oe=6B0EFBBB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
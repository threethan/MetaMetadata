JN&_nc_oc=AdpgvzRXSUVImrOdM0N_tC0K_0A7OWR9CiMPyngG3nl_IcZaOTUGS0FTVGF_pmZR0II&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj9MxdJHcFHAH25Ji5V7kIsB1myxIEPuV0DaB7lorHWQ&oe=6AF9D1BE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDZCKFHE7XYQ7kNvwFd8n2W&_nc_oc=AdoCdr1pK1GxIzbfVYNPm954lEpJBZtRFXknA-j6ExL2LDZpSgn7Q6Bm4yAw3zHALug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTKtyrlNAZXDZ8EF1ALDXo3mlu5rDIJEsx2EOG2s4Zpg&oe=6AF9C48C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF_JfiMc3r4Q7kNvwHVXaVN&_nc_oc=AdqBG3eSzo3MYdhYMJ0guNeDuBNOYpbB3C340jI1Z8kf37ct3DMlN-5IRxKsJrkje2Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoBAMmeUYlr4PPSM8boX3eM8YofX3FUzN4ySUstEXY0g&oe=6AF9E33E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33dc8f9zt4gQ7kNvwE8Wdci&_nc_oc=AdrQC8T0UBCcSpZ5gcfvl-C3bVc3xRtHlgCsSOZ7qviI1sV6lsqdjjGs2jXVSGx8nwU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpG70bloerJSs_T2ZsPPzGGTnW03k07v70PPxPi42_Dw&oe=6AF9E3BB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57
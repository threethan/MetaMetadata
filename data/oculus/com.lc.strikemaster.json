86ADA"}, {"file_name": "ss1.png", "id": "320322097812151", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86796210_320322101145484_3548926885375784114_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8wFn7s6RVgQ7kNvwEpCCJm&_nc_oc=Adp3pBf89R2qzWrO0m7G94_WKmBN4Z_Ig8vUu-g0WacyL9zmvn4Gq_MUl8cOqkjh62c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhCQka6kdVvyMBoHC89IGkQIu7fywU04_1Lgtp5Gkzew&oe=6B08523E"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcxuUSKS-pUQ7kNvwHJF770&_nc_oc=Adrzm4_iXbnl9jTcxzf377HwOMKQzd9sgb-lKGNrNhvjuZOiin9YNshw2gUcnIjlUOg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRPbJCyf0j8Rl2FGkLhEUIX78eU5qSwSOxhoWcJNY-xw&oe=6B08450C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKXvrgV4zqcQ7kNvwG92N5p&_nc_oc=AdryTQWO8lAqvEp1i0EAMYhV0orIMIkj5wU_nnoQQo4nqhnQkZ4AlAc0xSaXxxjaLrE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5JVkWjohlsEBxKY10F1UdfU30oPY6ue1avAjshp2cgQ&oe=6B0863BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvUGnpXUwb4Q7kNvwE37_4h&_nc_oc=AdqBX5rIHSYYsCcffCQ0QTV77_8nDaXsUKRryu47SYAnJyX3rREE2HLM2hOOA2XIK6c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5HusjiPLOHXwBw_Csy-PU0RNfV9yrJls_tjmRMsspWg&oe=6B08643B"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
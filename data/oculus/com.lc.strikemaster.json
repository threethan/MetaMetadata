dn.com&oh=00_Aftuu2yEyTX-8emWp-N0D_E6TKKM7igqS1yfz1VXKTFljA&oe=69A2D37E"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_efCoYX7wAIQ7kNvwHdcTip&_nc_oc=Adm4B7OS2c9nELg0gyL0DB4_Doq5lzaQcq4D4-FLI9sk-9PphUHYfNWc8jDRwtXqK0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK2LZOS-O4W3IYnMM3tKWahm2iLep30dfMTg9YRcEK6w&oe=69A2C64C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70Rbagv0HxUQ7kNvwHilVnc&_nc_oc=AdnGnq3J4q2PxLLsE01dGOatpXIxvwVvKiGWmLrL8XCgbypGi1f-sJjxeLYReYhj86I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZQYBgbzA97T1N2M2ElASddZgsNHxnwR7F2uR0tsHdoA&oe=69A2E4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xmHh0b-L9sQ7kNvwG-UGMn&_nc_oc=Adn3aY-h0JtRMK1ie0sywlqJyB67r8aZ9ab3ghY5ca2cHT0IIbY7UOgENltXIdqG0u4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft72kPFrZ36KpWpWrOt4bVYyzPLNiovQkENqDGmwE0S_A&oe=69A2E57B"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575361_1478273389745838_8899150778094333484_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcI8VwI0OicQ7kNvwHaeEvj&_nc_oc=Adm_Xcmjk7utxm6dYzyp0sae
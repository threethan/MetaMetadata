jg&_nc_oc=AdpoEQzYDhrGtU8JyZohwngKRBdrW_NOnpBdDp9pvO0UV2DPll37vw7wkw_zREb68MY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe16CSSNx8637ZFm9YxXCYyxOmEGbeovfuAJ-jhkd4YQ&oe=6AC515BE"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-x7pdk5K7EQ7kNvwHn7mym&_nc_oc=AdqwdFoqOpfJr4foLZ7FRIJJSols05v194GSuo_aoH7HAyECpYIORBBsh9F1OTBwLok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2bUioZIXb9gSv5aWaECFVuUKdtFnaMzTTS1sx5UVDig&oe=6AC5088C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJsJ1VWhul8Q7kNvwFPGlQH&_nc_oc=AdqhiFVDmLIEETWwjNyIn_xtI895E1LtS_DM8nv8ZQObKEkxm9JYIVs9U43wNeZnJTc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZaq9Vt-HA93EhJtCUn4jOjF5xLvPtY9K1C5L7a6gyWw&oe=6AC5273E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o383imQyZIUQ7kNvwFZQE_i&_nc_oc=Adp-zsNO4S3fkNgnyOrdw9wHtcgNGefdVLxj_v6AuExiImXMUrqEfylWSKwqH2hBNLg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtvXzi9y_4KuOfPjVRQ66wXMvyw_xUUWdRjFor0n4kYA&oe=6AC527BB"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8185645454790467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57
scdn.com/v/t64.5771-25/86796210_320322101145484_3548926885375784114_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU6Xs-A4f9YQ7kNvwFmsY8W&_nc_oc=AdoHqHEjeEerpv56GaoXRO421GahuwsIb6-0RJx-aEPAVeAdnwtQfFVK2sEvhDXu2kE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Jgi12OSqtR-bW439UycTPrTS7UiWEinAdBwlhIknyw&oe=6AFB233E"}, {"file_name": "ss3.png", "id": "865151022235805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974912_865151025569138_1526032060872620185_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDZCKFHE7XYQ7kNvwFKPOUQ&_nc_oc=AdoNzKQOcxlzdfB94pyQBsHfMTyBKrwf2oMHwOZjb_Am9LlUFa67iGC9lxoYnY8yVXs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy7w6DZ2fUiKn72sbLj4MXtKlYVSUlRBrTh_XyFeNkXw&oe=6AFB160C"}, {"file_name": "ss5.png", "id": "2801516019998099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974771_2801516023331432_973229975872388981_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q98TJblRnoQ7kNvwHEwjxD&_nc_oc=AdqnMPK34oa_hpzd0886SrVmWrtIhNKUFu_6OCVgqd-ZKQ5Kws0xcNuqrYhwrLAXQlw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLsXPnm2zcI03-puqGX7f3ynaowEuQkQvDwzPjzaUCPQ&oe=6AFB34BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1450189568960094", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75458102_1450189572293427_321153024598500436_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33dc8f9zt4gQ7kNvwEAgHGi&_nc_oc=AdqpVPr5k5wf0ajYFlu51cLNqfX3q2u3229GTH1TD66xXbq2T0QeDnUjoz69fiFA2bA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs7p7Wggv9GE73Lggp0vbVVfj_Sm4OJuBqwDPfwRi23A&oe=6AFB353B"}, "display_name": "Strike Master", "keywords": [], "long_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Strike Master\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Strike Master: The Ultimate VR Bowling Experience\n\nWelcome to \"Strike Master,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Get ready to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Strike Master\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/strike-master-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LC Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/strike-master-vr", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
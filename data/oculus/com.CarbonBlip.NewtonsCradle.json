c_ohc=BvV2toE-STwQ7kNvwFUGI4H&_nc_oc=AdpPsqxI7KtcGjWVWLP8NBAgMMvSKyDclJOFROGuk6We3QIJaMgC0f1HP2ZtupS_xaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5NtCba7LuESmR8lNXfRs5RyOdwEZKJoJqC3S22JwsDg&oe=6AB92402"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb5t-2IiP1wQ7kNvwEEvT39&_nc_oc=AdpxBzxa-IHA6XJcvqBgG83KHlmYs16-eX1fJI1d6NsUPCIF3C5AyM9zmwpeYb6LiUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1AuqEQky_A7TALQqQohM3P_Fd0RNQhd4d5LDF0tSh3g&oe=6AB938F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bAhWwKtBhIQ7kNvwEPEZeq&_nc_oc=AdqAotBDRGFk01PigjR-5SD6YYR9m3Mx5c3n3kWR1Zt10gZZTZBubjLZjCjV-CShgMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Mypx0L47ecgGsqcoCNLaHVzU7-LYIczWn6VH-800jw&oe=6AB93CE0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0o0EMmPJjgQ7kNvwGXqS5E&_nc_oc=AdqZTgOJYs2_gKDyJkTEflyb1-HKDAcW0vj_Eywf-PgXv-1EG1JahZTfbdE6jh7ACrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR2bvUdxl5Xd5MgHaI0Vf8OpcfQTh9u7OlgaKHOy-dFw&oe=6AB929A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp1Gf7TwGUsQ7kNvwHqlfDd&_nc_oc=AdrHVRgI1liWFRN6wuWBMH3ITLyRUEB2ikYbkzdYKgEwWqD6BlVR_QVDH_CFrwbychE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLobTP8lLNp82aDYzEErR0_a4JC97LvxAJql3a3N4Fn3g&oe=6AB929CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
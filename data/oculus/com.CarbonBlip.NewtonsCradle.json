c_ohc=ocr1GufUaJkQ7kNvwGCO6Ud&_nc_oc=Adr1U4yIfeA_NrCZzkkUWym3zcD1Vax2ZRkeSvKVF3GpmGihtDocSUvPPda8x0p9Bo0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCymwloGdj7DtMOWvY-xuopLLNQ1fPeQTUzGZD_djULgA&oe=6A6CAD02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SygXyd1j9AQ7kNvwFRy4xU&_nc_oc=Adr6ndK_-uptQvz7zy99cgLyJ7rD5wPMWSxfII-O57xM6F62RREdwO7dmbJuC6YMTU4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe4MywDoDd_8Xkcr9KPi-EP7yPhM12AKs3ggbgp7md7w&oe=6A6CC1F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1olCumhgUPkQ7kNvwGozWqX&_nc_oc=AdqUZVflnSAJlh-nfxNWAjCTVmm3d_XyhRRecSKhbjJPYda2rTP9hEPXVeGUfaWfsas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqRnwsDa4lnce9v2spL-heNvEkCuuKg2-mVaOj7JQ3CQ&oe=6A6C8DA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CW081zQsA_MQ7kNvwEk817K&_nc_oc=AdqHcxxg1UG-brmoK4-EWYt9iKxYTOUlhZvqMyIwBTXs-7mO1e935rHnKuVjmKAuyGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXdyBYthGp9IrEGlYoQc8wzHUcQlGtdNIPjhS7oHwJ4w&oe=6A6CB2A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4D3sk6LexwQ7kNvwEACoME&_nc_oc=Adr0-iGhivotYC3VSuHv6TlRHR9T7EhV2sJiMp2JMiCL2hPsrhVKifBbKKI6KFw1DdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6Kq685apIQ-N2ttC3EQ8R6Q360FC4WUIpOdUtEsh89w&oe=6A6CB2CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
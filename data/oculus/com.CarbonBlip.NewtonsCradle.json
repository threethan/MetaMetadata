c_ohc=BvV2toE-STwQ7kNvwG4wzfo&_nc_oc=Adr1-D9m32_pXRsJOmChicA7sE4ClIcIjdiYp3byMMocRGDOLM2m1UUjANZiLpWUfhk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1gwwOyN-MR7snRtu-vkvbp-8WWucXQrDxm_rx6iw64A&oe=6AB68102"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb5t-2IiP1wQ7kNvwEioh7G&_nc_oc=Adrll9wl2B7w1-keAR4cTk6wr07ZyliZdGl5r5lOW4SwscYBXTo6yqhTtU4386hCv00&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4fQcE4dJVEJ1MZkNYYDp4TWJL6pub3D-Wn3W1H4_lg&oe=6AB695F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bAhWwKtBhIQ7kNvwEbfOnI&_nc_oc=Adoyq_H4YRjUNt7CRscP5pd8VTA92P4KOL56xXZ5ZvJOYdRvW3BycR7M2Op4IqlW7kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoQWWIELMDAymp63tVNwvA4HleR-zA1sHhtC7tQ0tnxg&oe=6AB699E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JH7tDbGVBoQ7kNvwEidFq7&_nc_oc=AdrH8U0KEWGDAL23fBJqd43m16oFN8LbAXDQE0MP-fgPYPvxsoVQRc_O94lwBoF2l6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE_DdXZhdY2ivP1eAWEl1dc9KXMj4DUnkoJ5QmHmxvyA&oe=6AB686A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp1Gf7TwGUsQ7kNvwHWy25B&_nc_oc=AdoRZqMbQDlH4tKjPHN6j7rjofuSoKJvsMJ8UzXC3teYPXH2hRHUtuUL0XmKzBcF9Y8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4O7parZbk98GfbcI8yFwudOzHuuvxQxKVEj0oiEWzJg&oe=6AB686CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
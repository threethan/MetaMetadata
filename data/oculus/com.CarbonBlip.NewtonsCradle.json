c_ohc=PnM07tNdvCoQ7kNvwEyuTOc&_nc_oc=AdrUxLYWoSQ039vNpBoW2wBJoH-VOqzNbr73SoYt_vE5aZiUQaRHPrTPcUiZQ6yNeYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOvQpfFz-jutPdS5H8Ix0sammzQ_wyNKi3rn9nIKJs5g&oe=6A6A0A02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnnIhAtE7uAQ7kNvwGNt6Ua&_nc_oc=AdrOHbiPfikkDKEv_7C3JXkDWDEV2vhYi_hjG7ozDoWs2r1edmoUkxRCll9rnZ-MCGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmYX5pEz1KDCNSyFwcyES9f9XttVTTLe8aOzo2g75rGg&oe=6A69E6B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdFCBSEIe1kQ7kNvwEG2hLj&_nc_oc=Adqg9IWofWLDo27rzGS3bpudziKV_99kBPT3uMFsTLfrZ8wO0kA6u_ebV8e71bYQTfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFdbJDMiMNhU7qzVEQZNm_qUdRxOW73CO9tvPjqZu2Og&oe=6A69EAA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CW081zQsA_MQ7kNvwG-snP3&_nc_oc=AdoSXgsByB5X_G_Be3C1qGJbBh7-Spf63_lSG83bKw52ZRJrAufiQixkqGYdglKx14k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuxznozw5eBsgkdFw2JH1F_n46BM3WUDGgqYi9qcXfHQ&oe=6A6A0FA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azPpXJStyn8Q7kNvwFWXFth&_nc_oc=AdrPxzEufYDPBFCbEUthrET9xU4Tje8Nze3_Dyn8aYx2VMEU1tGTqYKlq0iTV4BMino&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0km7gGThPbbL60QQ327nlSAoMeVU10v5RBnv5u_BFKg&oe=6A6A0FCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=2a22X5ZQM3UQ7kNvwFTPzqZ&_nc_oc=AdoOxZUm5yZ6EdykW-0poy71pQFy0YPt8lHe95TW8Wxo5f3DZxL3yowhgKr3Cf-SsJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYn3gLTRYcrsCyXldBM3sQD1uYeglLdY5ZqWNlyY984A&oe=6AA80082"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II0owbari9IQ7kNvwEFebfG&_nc_oc=AdpDN2wjyKvj6ZBukYscSravM_ADO4BGRuMqqw6_K5cspEDzKgrEFvYJV9ebJ6CpXq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSXa8CemgmRdBopcZ9JcwmGo0XfjkH70pyG_4eL4Xdog&oe=6AA81572"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJoGdFyV4AAQ7kNvwG8aadr&_nc_oc=AdoRdvWA2x7m5fDfB2FnA76Jwq9920teirc4SocA56UNe8ZmM-v1_IyaiHZlIPRvO5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6QyPRWqf1uhK5RfyrNq5AEDgkt5F5W8oLBvJdi9QZqA&oe=6AA81960"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndsHiuDFlJ4Q7kNvwHaJWBB&_nc_oc=Adpm8EOiYd-8fsfvJ-djklXKwLMzWzebeLoG73Tydzoo8o0GlrPprvSQWcDJCesRFd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeUq6z9PtDBkB2o0X3d2MyFxx5eif78BfXAJnbO6RSBg&oe=6AA80621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QaT5qPGWe8Q7kNvwEIbsA7&_nc_oc=AdofTlOiifYUAW_j3Fmtmxc5ZeWlzJTA1PaKBbgu8xx5aVjM7eGXxPCJdPlY5bdKLSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcOfvhRC1ABVX8w4NYKkqDybw-O2MhaiN6KRzIoAvb_w&oe=6AA8064C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
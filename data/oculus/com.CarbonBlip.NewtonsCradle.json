c_ohc=rAeNL4NvsO8Q7kNvwG27lUc&_nc_oc=AdqNen7_hKGN8DQzZ8fOBkOJrfCpTth0WeVCiTfhAWnVIJ82mwc9kSu0ZaRMaszDNXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSACP9-zXxZ1mHZpDT4j1wp-h5NZ1gpDYYEaULFKS_aw&oe=6AB3DE02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6ANrl94PngQ7kNvwG-jiHi&_nc_oc=Ado2tjLQoSjqsoZsgiisCjP-0d8M43nA-3ZhKQMdj06u1vYYQfpA6LLZFcqSjAa8eVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf3aUBBj14-cFqLl63Nb5iOGxmj09lYpbnBH1kZQFmNg&oe=6AB3F2F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD-Y6psbJbgQ7kNvwEtaEkO&_nc_oc=Adq0SHU1i1XZCQJosPoQ-NtZb39LEx35p8SGL9845du6lF_dIOmy_PkIhCN0dMNQf0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIndg8FrgfnT8tFVDgzFxQ3JkP5pgF5RjGh_Fr40q1JJg&oe=6AB3F6E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMuJN-5K-tIQ7kNvwFgi8As&_nc_oc=AdoPKhe28d_panbiqGYD15MLAjvLjK--7KY1HPne63I7qRLKThNG50m_I3iXjsxSbaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfQbhvsRTxSbmSC18IUYvn1ZdXPDW7WE8Ml0K0vTySgA&oe=6AB3E3A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo3ytwvG0_gQ7kNvwEDmxeK&_nc_oc=AdoNgbRizAfPgRjSgR4tFRvWGNP5oBuHePeukJuBMhJvJOt4lLzN-gHqV1MUmxFE8jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPf8qNKaCxOPdMqQpzcyEFxuVE8V8qZ-6HvPLW4kM0Kw&oe=6AB3E3CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
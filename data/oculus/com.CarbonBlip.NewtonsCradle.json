c_ohc=Na1da8rZkqEQ7kNvwH6pkPS&_nc_oc=Adq9yWgJh1vLX6DLsd2ufT2yBFi2y1Z-4f6_nu6sNFIym0MH-WIVQMeTKy-Ot3Y7i-Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA8Ana5ahhJMXJgffd9nwZCMn6IGAk5-M9_Sbl09q5eQ&oe=6A803B42"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LsrPI6c08cQ7kNvwGAy70H&_nc_oc=AdpY15B9bMMG1GG06cvOj7qjGtWvGL5IVx9PhOi1oKjcbkJ7mIiUFHAeJcNbKFaJVbc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3LLBfk1s_e572ahNHZFuO2Lhsj9f4hQHPJjSmSeCTiQ&oe=6A805032"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqmgIAE8O7sQ7kNvwGtPiZn&_nc_oc=AdqIYAe0kcamGzEQ8ipj0_zDpYxfl-6kDhGb2HUY5gaZ-pkOZvtG2f6WxXa0XAhNLNM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDsDOB1aISyukyDZIo4YigQUREDmsu3Jh1Gwg1TOsXtA&oe=6A805420"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqqWuO8ACm8Q7kNvwH4bgJj&_nc_oc=AdpFmtwMtXX83hAFVX4fy-O8DN2mGKf0EQj0Op8_sgE8hOtOcPakw9iRdVD89wWOrdM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7W_OjbUWTNZZ7euIdlWDQ0oRKqCZonR3DQhOERGMxfQ&oe=6A8040E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXyVDMdWIvMQ7kNvwF_CtJY&_nc_oc=Adqm24n3sc8roLH4WkgZoi1JoNEcjLOXeWRUyNxgdfWbBi5ydrAJSUErgwKfU5XaVkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6-soJeraCgUcs8Dfn539W3C0qj3__KIj71T_3fQW__g&oe=6A80410C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
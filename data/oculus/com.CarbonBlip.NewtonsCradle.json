c_ohc=IrJ1bcWaQygQ7kNvwGBXC0f&_nc_oc=Adq5KerLZaCnY-w7KAtV06NnlpNzRti9zyTMnemH7F6a0Akz8ZK88IK9KbyRxlpZBAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OCnJVurWrEPN5Afut5Rn8MDv-uDReAXBt43U6afOdLA&oe=6A2EB682"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i-KyCVLWncQ7kNvwFPbO47&_nc_oc=Adrz6elewdy8xewuwwn7e6OKWqZBXzufIr8USMNjLu9YtIREGIBn3dqOSfB7q4vy3q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KzX-q1CGX-2wYDPrXQkTEqjypL2f234ptfJzhy0siMQ&oe=6A2ECB72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_l-Egsn3cEQ7kNvwHAJEQb&_nc_oc=AdrOBPQNjTzbREd5CK0YICP1fsuj6qe12vosPbCSfPJmHj3eUsLRpFQmal08J0DZeDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O1fhH009CS7_EUJHj8Frg3GBeJfyMQ4UciubHGSSHdQ&oe=6A2ECF60"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTSLMpzQDDUQ7kNvwE4lQhR&_nc_oc=AdpplPcgyjiLShzO8GkYd2cKVhj1wkj3IUYYqR310GRWtotGqsooT9WyMnlbCihWYAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uk0-coBmjC9mw4DLF3HEux8M58jWbozW2pBPWLxRF8g&oe=6A2EBC21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jUKYiSIMrMQ7kNvwEojRCP&_nc_oc=Adp7y2AdTAM-GqgDz1DFAp_-L0mvUbW0_7LlFm8q6S62e6pPv6LhjwWO4o1zGI9f-88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91W642ug6rt0-qzlxfDIk3yjBgVVwmmJ5uH-pm5izl4w&oe=6A2EBC4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
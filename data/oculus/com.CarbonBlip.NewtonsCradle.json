c_ohc=qV_MPywSJ4cQ7kNvwGqtkKX&_nc_oc=AdrHBKwHzPGiO3C1OcBYwUHtUr4xy9nlc95EW7Txnbq8Bx-oHtkFkZwEU6h8iDwGXDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RYyot2xzf8xa1ch24Ngdbaiq0y6aIh9mmEwS1hR36sA&oe=6A01E382"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l3oTyh5aKoQ7kNvwHGaozW&_nc_oc=AdrtCHbpzy8LVerqBHx5yXzJ7y0iCbVuQBxgjoflhiA4ZW3SfdxZQj2P6F66n0MRYBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n7AAUE5wFtVKhWdw5zjbbVnq8y9Qp6yk-LMXWp2V9YA&oe=6A01C032"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctF8WT2xNacQ7kNvwGftW0U&_nc_oc=AdoPZnt2cdelkZglsEf_8NLv9J3H_M5fAl3QJMyHLwLTqOZvbKgwLzr7eujMYclxSUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4anCvVXS8Mg_yfuaIDU5yZCBE26FA30JhSBp71aHIHJw&oe=6A01C420"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAV5KIVPJWkQ7kNvwE7E85D&_nc_oc=Adq4zCw43jjTQRG7BZ6WHpdP6vtxgOwrHCasDu3nyD-dobcofVI36nSuqkZmMyJWv8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WMbio9ZgqjKBEQqpxSSxq2kuKOzxdeY6r42PPKc19rA&oe=6A01E921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVo34X9vI1kQ7kNvwEwyjAu&_nc_oc=AdoKwWhfbbl8Bao00HjH36lG--tEQdQERpj4dLlX_ergSOimKcn4a26uRefr7WVuPjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xbYMH7t4yG9wRegfi0salHZQ9xEp9qGP8g2f_RLopaA&oe=6A01E94C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
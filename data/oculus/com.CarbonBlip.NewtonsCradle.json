c_ohc=2GgJpQDX9OIQ7kNvwE73ap7&_nc_oc=AdqR3YrL_3Y_4l7T33MKRsaVuUaC1iYU0sUZ2tbXQkP35bR0TRKu_OMpzVcGNNC2G04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87CC7z7nzrXPEkUpEtRf8cFq-9xmPF3dzEaSWsj5Q9Og&oe=6A3FDA02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ImRopumS4Q7kNvwFPwGC1&_nc_oc=Adp7eebf19X8KOgcvSVtulNeU4s3NBcznaRzU5_C19bZwTf0J57uFstA3lQKjuyQuLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jw2TqJ2hHaGztBINX82JRSq4k_XlwLmPM4nZF3-N_lg&oe=6A3FEEF2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ykh2S6c9pQQ7kNvwHprszQ&_nc_oc=AdqpIlxRzcfvreHCNsjIYtpIiY4LkmCkKITTYYzQiLuh9sSbZFXSBfB6BYwzEcPzkEM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WtdZ2kMbWz_iG1HXJ2DP3f40L8UPxG7dDDfNwB9xgng&oe=6A3FF2E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg-h8EE5oLAQ7kNvwEcQpQF&_nc_oc=AdrXn8Vp9-mnS8-BrHMztxsJwQcyISH2TLueP47hFNpAUYZV5918YnOt-VYVbdib2QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hCYm-1NWn-wGN4T7dOtY6Avv9GUdBqVPXP6m3oczzlQ&oe=6A3FDFA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzFa9oIv-DQQ7kNvwH8Q4Vf&_nc_oc=AdpWEzqsSUOXYrzX9rVcsKbE1ykdFWt73JPtxj5LNQyAQtG-jY-vyUKQra0EAev1m8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nsppk2XdTliuxofs6sztC_TBkZxdAKFNBgt8eSmWpWQ&oe=6A3FDFCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
&_nc_oc=Adk8_K5ebYopcIV_z2UUU0MSjJ811-mKeYG3TuorViaFTjuSLT-A3yA5HJyvVgusL14&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7VK2PdsQ_vtZJe8XEVo7PgbS3ju6-MNl0aA-LvPmnfg&oe=69AAE082"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-3naFgkXpAQ7kNvwHyDjne&_nc_oc=Adl0fXhdUYf1msMg0YN1GKH5njQNbhcmNbQy4GmjwBGgdgHLR-N5W2TcPR4cGjWljQU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBJTp9nKa45OaBjAN3KiGCJwusZZOuBsKKu-da338XAQ&oe=69AABD32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdVtNngS4pIQ7kNvwHxJgUp&_nc_oc=AdnkWubNGP2A_zLC7h0wBAV3QnxFEBOiImK1iLA8hgIu-7ItOe_UuTcSLqw_JahQ0d8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzsexqkiqIHHe5v0mFIV3h0CbNIEzv0MDp76ooQOWO8lw&oe=69AAC120"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M4Ur_MpVQsQ7kNvwGxwLly&_nc_oc=AdmNNgAmvWHa550lOgVk8BSlNGSr9Fm56DZv7LKyTRXb356Glnx1nqNrdD17z5v9738&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxF8gY3ibqRHAdTg-It1a0uzTzgYXHuyrf7-Tu9-HDLw&oe=69AAE621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUVtp0mENaMQ7kNvwHBudeU&_nc_oc=Admyey6THifwZkyTWbkEHwccFeNqYqSpxunGOO91cVhfXt3Z3rTK_i8wM-_VLS3J-ks&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwStf6s5HiGr51msuH4RjHG5zWwEFLpmToXior5Arhvqw&oe=69AAE64C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307369478
c_ohc=l_5nH2njQ_gQ7kNvwGN7yoG&_nc_oc=AdqPlq_mfG6e8jI2lfL5CZs9cOxlqK7hYEYJ0ecrCMa9u82-tg-rb2PNdlirDyenntg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFXBNwc0fUFI2fDFvI2TvRq6WOiya6UQ_OzVsxHEJTCQ&oe=6AA01782"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vSqxR-1GugQ7kNvwEPUsTU&_nc_oc=AdpUkuefaJJTo8IvzblnaxRTtrK92T2953PieoLpz0TfpTYY1LFy3_Hq0zInn3iA9Cc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxz1VD_8PwpxOHanIFajH4FhJHImXISS8zpAl7Lp8BqQ&oe=6AA02C72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YY2-617BB4Q7kNvwH0p-Qw&_nc_oc=AdoXQs9J2orcbYlLop-aLClpPbzbB682rrap3EcJvHVdav3UgBtM9ABqMwO2NIkHorc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZsHTdOwrvXm22ESJe2UoOFUjqIUM9-Kfvsd7FFCyt_Q&oe=6A9FF820"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mbRMqQbmJEQ7kNvwG-Vu_k&_nc_oc=AdohzPw4rigMsM2Kf1MjVmqT7p_CvdHEnKYimvP9CrVnM64oa4TDAjgqwTNahJEyNRA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHGgmuGR_1Cs8ZSXs9GemUSqy7YRbOgbKXuyONQc-2Kg&oe=6AA01D21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE7EBY40jIMQ7kNvwHnrHop&_nc_oc=AdqAlYCEz3lx_DyFdF_Qyk2gcvMpaxWImdw8klC8wllPRvdEQkPxdtDoeTL8K4crArk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxQYNJpmf5JsdolawpDfrQWhAHrvpmLewwm2yOZi7Vmg&oe=6AA01D4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
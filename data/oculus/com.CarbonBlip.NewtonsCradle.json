c_ohc=WFPfQUwlmP0Q7kNvwHdyvQ6&_nc_oc=AdqskoCBQsp0hBE9zHklnvXUoL-GPmeXwrwQidoWo7w_noA-mgLjQJGJXwbclHsy-yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJXClyC_tWnWG_iIauZSfvhd2ibuzz2CUnXFcP7p1-1Q&oe=6A5F7E02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCy9Bg8eKEQ7kNvwHkHDzK&_nc_oc=AdrKh8hn44kGqB8EmzdCnf9VTntC8uFqH6B5e7mHy27ulMAQVkLPZh_nqNXShX8PZ4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjSyVtQO9qOhr5xnX7Oulce0QXqLiOgHJ9m0BDNE1Kvw&oe=6A5F5AB2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUZXT-87G_EQ7kNvwFqyfLF&_nc_oc=AdpuTm8oF0GXPlhUmSbB4R3Z4HvokX9fKNw7rqusnpq2wbh_QvDgbmhqJ_taxZ6tzLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAKmqUnp8cqMeLX95_MRJclpCXxO1As3lvXaBkcnO7vw&oe=6A5F5EA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT_qoHm9y8oQ7kNvwHzJgy6&_nc_oc=AdqyJHFye_owjrocR_2SJLivevVDugHGXkOAUzARtg4y8ngqsk21yHKL7HoT3-GGUgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPOhJb2Mu3p4pldQjgrAGVJbzhyt_b41Au9O2KE-Wq5A&oe=6A5F83A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWNBAplg1aEQ7kNvwHwIkfY&_nc_oc=Adq0DuNKkbj1YibGne7BjwQokrzYBOgcTDNCRgDk4c-8v7Dq3OGdnXyaE-rgLfMnTYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvETOPqG4w7-SAyiVxbXcy_0xc-Moz9btcT-dtIuTk_g&oe=6A5F83CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=cd4xfLBQ2-UQ7kNvwF35a3q&_nc_oc=AdqXoh_5pCVnoNyrELuHD35XTHfsZHTORAqVnhUWk2fDmjdEG51x1fg5c3PG7I1Rv_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlbuUsaB4uwo_3QVc_yTboDY21K7mCrWcVr_VktC3Dsw&oe=69D11C02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNAPNIr_L8gQ7kNvwE9sP5N&_nc_oc=AdpPpkToxLgavUOmCVWyHlGbwemuH11-xKxOgFRPcmv2lbqSEseCTwUOLi19bIBYBek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQgTe4owtfy4R19Pi5mKvN3uVN4dQ3rRjYHiN1KgpX-Q&oe=69D0F8B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXsrA_Vgs9IQ7kNvwF1n_Z9&_nc_oc=AdrxclbUu7S3wnSlQ4zZXLSevetfMJnNGDBWcW_I6xuLbNKt0GdJfE9oh_Ow38xefRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwARFiscCS40WypVEJtmcc8ootbu6ovXPBGa-TVbX_22Q&oe=69D0FCA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO3IOe_JyYcQ7kNvwGtdbCb&_nc_oc=Ado8FXNffu39ppNEWReaddEjkwqUhWYkcnF1a2on7tuQ9_qrcA-5AjI8wquso3TMmvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw251e4jaGltgtqXklvnYrcntbEFyaMFZQuyuMJSzIk5Q&oe=69D121A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-B72qoXrr0Q7kNvwGplPTm&_nc_oc=Adoc9_Vd5qQ2e7FZTTjjf8DGkXumXUo93sIp26ztz9M6-Rtu2nk4Vkz7kTCfupLij_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqMWK4Cum9P0gVGwUMcheoIw7AFpBEO2ti-FLePAeFJg&oe=69D121CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=Hj531YB1q0sQ7kNvwGXR8iJ&_nc_oc=AdpBqxAHceg9mw7f3MAqcvSC1c66Xv3NYGrjP_v4SE4pOnQEM9qLlvExomR2xPLdW2I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q3UWR7HVHOZv5PfZInv1cCr5nXkeAsV5YtiLoc4YOnA&oe=69E78582"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmUatCXKj9oQ7kNvwGDEsCV&_nc_oc=Adot71He94UKNw-yeQOJGXvhVvmv1sf8rSIGL2Nt8G466zQ_BJKegcKz7On7IRBUGdE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aAhOiEWBm5gziJYcUvaepJT5bETaWctQebD0B8ASqmw&oe=69E76232"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4UUZWiX2_YQ7kNvwFmg89h&_nc_oc=AdqQtUmmZjWmax0I2q7ya3WxKAW19yql4LLvvR7RKYxUGvLaUpoz2thO-hBWGrfBIr0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VGJOFDhlBZrZHolzuX60kNvw73MuNwrjcxV2C8jfxCQ&oe=69E76620"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiqhJ3hzTFMQ7kNvwHx4nQ4&_nc_oc=AdqOrSYkgFtpUnhx6F5BaxjwXNOWu5raBtgsl7atfqlOq3PHU7o1MDcL7R5JxeBePEE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-TYd40OAZQH8KtMm8FHgmU05XDPA-AAg6jQledJCpjA&oe=69E78B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfWxASJTLc0Q7kNvwGXu6M6&_nc_oc=AdpvaLeaHVGMSKV9QDO9UlC3pRkVK62MyzEFqvtQWQxZjnLQnWnIPZRsR7cPohXYX4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C1P5XgAUdAWd-xb6Gt0Vus4tN3zQxly6_6StcmnN_MQ&oe=69E78B4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=49OIKDT5XsQQ7kNvwFVN8ED&_nc_oc=AdoGCAcLT-CmR-sUg1d3cinc1cdcbbJ6csjpwbXZEfxiaKVB2U0hRjtpnTKZ4lmg4Wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy7JYSvY5qg9GGO_FMMIUuwTGflV7U7nGdpGdjrdpihw&oe=6A8C18C2"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVqXHbh77wcQ7kNvwF3Awo4&_nc_oc=AdrWVSFzW_OT9KbYolI_8egvtfayjueTk8IWPpDNTNQ9JPWBpj0X_Mj-pNKX18knNGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE17X8CFXI5xn18HqkSnFTc0Ms7QAVIPkWjK7Q4xPxOuQ&oe=6A8C2DB2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ricZVawK9UQ7kNvwH0Qds-&_nc_oc=Adq34l3wWqmlftgKVsa3R1fdcRWo_LiZxTUaaRLrdD31gmRX-H2Lf2NZDKsenSCZepU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJy-Mgx-H-bz4XhqA-WRUIzAIDN7MmWuSZlResc70T3A&oe=6A8C31A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myjdSk3rrjkQ7kNvwFoomBk&_nc_oc=AdqhlPRxbVaZgEIYYPyOs1-zgXCVeZ93dHNKiVJmrkhW9_qk-LdZh8DqZwxUIG1HR-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg5G-ZDuIcTfpPMyKwhfC6eofLBolHMOOiovOCeDSR-Q&oe=6A8C1E61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JssTsTLTKQAQ7kNvwEsev-L&_nc_oc=Adp6iF_FFKgex0OTyJ2kWjk1gTYFqVtJmPsUvwCQGKiZZj_1nl5P-v7-fsXn2qzVGWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtww-EyTkflvmx1EVCcyDiYzJfg6TfPsDAu1gI4M6KcA&oe=6A8C1E8C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
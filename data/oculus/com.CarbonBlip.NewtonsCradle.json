c_ohc=Hj531YB1q0sQ7kNvwFUlQLl&_nc_oc=AdpkWxVzJx4wJX6sB7Av1Z6UfEu-_feEbTEwepFGf5_3WaqGOtBfnxBZNUVlNRXt7JI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SxW9KQRrgsoeR88l6uFQtRAZO7ynDLriE1ovC5EV8UQ&oe=69E4E282"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmUatCXKj9oQ7kNvwF2SXF-&_nc_oc=AdqAyCbOSGgSK0tfqu8nmOB-CnW-Qme5zKzg8Awbu4VxcZ_ax7_Tq5KpbUAp-hteJi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dS2S__c8xC5kX96QRecItK5LJFCdsVgY2La1tnHPAHA&oe=69E4BF32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4UUZWiX2_YQ7kNvwE1KWxn&_nc_oc=Adql_jKORFVp5J8YzkylDgZpSuACdaBYVN8zRMIH7IJWMg0HnKIZgFqjUbQroM4jTPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L7v22n-Qg1Qc4bUUH-NJUqGngM5NHSB4tO2iNVHt1Sw&oe=69E4C320"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPVH6NWLu9IQ7kNvwH7V3Ty&_nc_oc=AdpiWwYd7gt7ZTgVVdroBR_K8QmGQ3o9neRJ7ZLZaWQ08DSEC19GcLFvcXg9iQLeRdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32Bs41GQStCxoKTontoKgCsMEcQR6zZvWb2Lt_eSqEhg&oe=69E4E821"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfWxASJTLc0Q7kNvwHXlf5F&_nc_oc=Adom2ff-lHUKOikbqZz3pglddJ7xcjWo3yHKALEAg9W9pFPDbM-GjvXq0--xMjM_JrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kZg4pTSREpJwf43-6cFNRD8URpSZXFwMkeRTBiUuN6g&oe=69E4E84C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
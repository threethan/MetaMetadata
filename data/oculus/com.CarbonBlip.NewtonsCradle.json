c_oc=AdkqTgsIDOgAStO27NTWUnzRbAPg2ODZBzdyaCCvtTL1SQgHzwByeGfX4XYYk2VISwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftb98wWkUdTp4Iaeams7D_qaz1hWrmBJy_gA6i3apWnJA&oe=69A98F02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-3naFgkXpAQ7kNvwEITbCI&_nc_oc=AdkwGv3agePz9jhr5hlzTxztuDmuJxXgptgro1oYLMh9F8PzpmuZnUAGnnJjuhWVhSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftNMJivrCMAj_dIhTGfnR4Z0PzgI7w65vO5OoqnXY41TA&oe=69A96BB2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdVtNngS4pIQ7kNvwHhYFor&_nc_oc=AdlmOn_XcxO3CB992rG5fwH4UVzn_bQHVgCVKNY9ZwIC01EsDfZTIwBcuugMIPAUaU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftTffUsE2HoIrJM2jVIsHTY4jujnlJ56Y9Q0thi1osEOA&oe=69A96FA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M4Ur_MpVQsQ7kNvwHQwcn8&_nc_oc=AdkP6VtrbWabpJFEDgYapKRJOo74I8Dua3RDXD_M_doaYBBYu49BAYUxq_HkFBP_QGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvAQwVyU_hiTONpYJVxvETvOFzmaDz-xTGasf2iLlNwDA&oe=69A994A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUVtp0mENaMQ7kNvwHwQFP7&_nc_oc=AdmItP7vb9BL1XFXwLKPbxdgW1BeyyCHfkxYK71tDzhtMgUuYEOrPpfymhoc3ndtD2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu7lxiXxwKnpx1VVzmL2j5IbmZ66qiZBBK-3LkvUop5hg&oe=69A994CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3073694780960
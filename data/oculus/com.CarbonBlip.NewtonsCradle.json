le_name": "nc_screenshot02.png", "id": "1012690652633500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035328_1012690655966833_7163896299135152525_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6oEY_b-7WYQ7kNvwHoZjwi&_nc_oc=Adqe5Eu9OUslDSNRcFvdeAfN9rEQqmocCMbIeCcX8gDslmVCRQX_P7MgTzOcRhDr5IE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRGa1lPxyM8YVFEk4t0uihzXmLfpS67r0iuE8aTWrezA&oe=6AFDB202"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U99xEhLC4SUQ7kNvwG3pDIK&_nc_oc=AdpvJktZ48kG5cwNDrbT-e1icERXwxS9yW-5IifgD-UZTqaAF-0UZUo7DzJsrd8_K5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYCwcLlLr5sTp9_McmI-WMwBxRgIkJKzGHQFf7UbbYKA&oe=6AFDC6F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-nHD9lGPYIQ7kNvwGIKL3V&_nc_oc=AdqfWZFseYWsQkrK831i83-Xx0O4cuAO76EMBpAaO0srEPwxRivRGZkXMiwewE62wEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA4pSBoQYulFAlH6h6_xBFKfbLgvS7ZimSI6rW0GrRnw&oe=6AFDCAE0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MkNAb9JuzIQ7kNvwFxFKGX&_nc_oc=AdpzZaB_159bk1SKfZGs4QiIE_hEwAQMyg4gJ1MFZQBdaO9eirc19pkAw32ScSY3_bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROijig-xGlubOxobC_vkQb4Evh723FHMKOuYrdvEN1Ew&oe=6AFDB7A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307369478096069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
c_oc=AdkMP0PyIhJ3-yskLMqALGVQ7WT6CJqHxJ2r32tGJ45hXTg3_I55I20-prtqfbTFoDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftGLYYjZ6-hztr_QnfwYJ6ygA1xx6Y_1BnCISuGTmXVRg&oe=69A83D82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BcaNrSMdlUQ7kNvwHeFA-K&_nc_oc=AdkfgFh6cBHDRiryDhyurQ6iLwQMnQKiVg5FcNSKyLa81y-Avp8bI3BFul56w7XUP7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKt0TKUifPUnYzHgajNUWxus53WbTahGSOBO5kcXF0JQ&oe=69A81A32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6HtzthsH-gQ7kNvwEt5CrY&_nc_oc=AdkMdg90RuhWUMOoJiDPg-XvBsB8JtPEvv8poOgl4WEy4IUrgjPaw7i0iXsDzZHvRmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDhW32UL2VCKFIBD-wqL7s7-HkT_sV0Rx8TxuFgoIxLA&oe=69A81E20"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M4Ur_MpVQsQ7kNvwGvoJkz&_nc_oc=Adnc2lUTOeqiIvjfcNIv3tBq8ABXaWZ3rXGYYjgv-0GkyvJXFvjIuobTFCsBuMhC7Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftT8hs7y2UL3kRF2UQ4LnWFZivvmbL_tqUUkURdxGAIVw&oe=69A80AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw5Yk4hhEGUQ7kNvwE1AmBV&_nc_oc=AdncwuujJLsPVfM-zM1BAnRQFEQ6gfNuFSfVAEli75AzBASJXWwjl2A93hWJAKAIzKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfupKzIud9E1hYULMN2S6wE2xjwhS3rYnyvosxRqKUZbaA&oe=69A80B0C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3073694780960
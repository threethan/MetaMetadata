c_ohc=WFPfQUwlmP0Q7kNvwETlFlj&_nc_oc=AdodiiTwCYeapueErQKKLuhf4ettJu9b0in8HlXK8I_xMYJne7dlYaXQUDQuTcan5eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc2fBxgjWmz6byBEBPqMo_8_VJgC-lc678PZoP4WYMMQ&oe=6A60CF82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCy9Bg8eKEQ7kNvwGvulwU&_nc_oc=AdpR5D4exj4BC0yvvP1GJYQowWjYx77qYqdTho3EvOG4BL3SCFpGrR1KLvNHn_1bS28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp52GxNgIf3bYayQ9QauN3iNC_YVbyJh6WR1FUAWpa4Q&oe=6A60AC32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUZXT-87G_EQ7kNvwFXFJoO&_nc_oc=AdrmV9Cyx0wHq_RvoSwOMS0jSMXjNq77cYsxNPMQ3UlQTKvwUlA1LpBHEb_-saDAwlw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXiiQCAKB65_Hf6nrUHse4smRgcV_2Bc56qXLgP_ZfFg&oe=6A60B020"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT_qoHm9y8oQ7kNvwHRCaW-&_nc_oc=AdpKYVYXeGmt71UmQ3ug09C9ZOBILGqNRTZ6mY2q0VBWPkWxynstQPOw_O7E4nnyl1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCnAJMjvUb9PZjeDoxuRLPOZpxDVSqLltUzBxV89SiXQ&oe=6A60D521"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWNBAplg1aEQ7kNvwGd4vw9&_nc_oc=AdqppC5MMfTRMvjvEWXZeqYvyAHYnjuiYsKnUYBDZWnFuyiE7zO5pqZ_71im6iWgaI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfRmA-Y1B7YhmQVxLYtIP9O12MYF5EUIYrPsur_jdJ7Q&oe=6A60D54C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
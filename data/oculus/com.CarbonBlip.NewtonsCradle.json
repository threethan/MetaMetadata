c_ohc=qV_MPywSJ4cQ7kNvwGUzpAL&_nc_oc=AdoDB-s91U4zroJzOPODw9MxkKP18nsEzYL1GBs2b2L09_BD1gd_3oZBP4q146dxRck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MzYr5EaaH81fih4X3Fwnn8fUoiE3fRtJe0hiRUgAEQA&oe=6A033502"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l3oTyh5aKoQ7kNvwEKlvLJ&_nc_oc=AdqZnBhD9NUIDOsjWKo-31t9t0W0JLgelRXBREYy1ZM1Q-9WAt6o_SgHh_BzEHb0DvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uahw_6ofNyRiynIvzToJw96hc4moxUN1khQt-2fqV_A&oe=6A0349F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctF8WT2xNacQ7kNvwF8s2iJ&_nc_oc=Adq2gWC00C-e38vhSiwVf7FxbTAd4L0xaB_QLAIe8eHWKzGN0UVIn2k27uhM-CEvLsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ubCrkYVkKQQDvGO_xqQTHC4fsP6Q8UPFmDJ6_0RdYVg&oe=6A0315A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtwXpmcELEQ7kNvwFES9N6&_nc_oc=Adq6AmVTLFfAzXsZHXGrIoTOAkAJQPiR1bz4Pt5I3Euu53C7BqnV8cgmEwSLWawPyIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7af-1aNKWbQFPJaE5sWbPcOd_aff4A8IOeIh9jjaPD4w&oe=6A033AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVo34X9vI1kQ7kNvwH1edpc&_nc_oc=Adpz9ArBLy7MiwUkpuuYe-rAFw8H_IzX8hWP4Mr5JdKwfqXmvHxt7GutvmzTdYv69mc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lYt64Wi9kYqnKHlxGgW6SPs3LQ7Ox-15Rermad3H9zg&oe=6A033ACC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
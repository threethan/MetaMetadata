c_ohc=P3KSAQldShcQ7kNvwGKoqYU&_nc_oc=AdpIWciqazXhxOuuyH00K2pG-78RMX_CkrYBmTb2tMgIB9EMp6e3bE8DSVHKA9--LVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF55uX9bL1rMixfrXBv0wwuUsWMpNLR9YKyJxLMhAsT2Q&oe=6A79DC02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngt07aJwIh8Q7kNvwHpnzhl&_nc_oc=AdoxwQMwcpMh4GRYLKpBQRYma52ODaOQfTNQHsGGg4AL6llnul9HpBO_9CtO1gdgEjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZDMWW-7v7cnOZL_AhwqagNyMxLwXMqvTogzeLZQ2Wuw&oe=6A79B8B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0L0zp67AfcQ7kNvwFX331j&_nc_oc=AdrdkRVC_qvBrB6qqZNYpLfoyYbpOYtfvvvXynZvkMofDOw1VR3MIq4Sj1H9df7fSxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAHa6VhZE4xPrECtcMYQRApJTizcOqmVrd1sdBSE0lBg&oe=6A79BCA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJKsA9eu4e0Q7kNvwF6GPuz&_nc_oc=AdpZ_RZZR1BJo7qdAASzj3JOqzLrTA_9_zDIFEoGuyyfPfwoNjiuI7wlJmU9A8QHGA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSKDiDL1F3obuhvO-mAoHulSl37UImro2LC6VMn6ap5Q&oe=6A79E1A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK-iYwMgDAMQ7kNvwFz61Fs&_nc_oc=AdouISVYqt4oe0rL4OE7pdZ3vZn6YP_ZWIvhg_q5haA_1THzuC-epFivztVpSo2wZW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwZ0A6E5lAZwHgj8lSB6ZTOlo5SdEDZkoA3B4gWcdotQ&oe=6A79E1CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
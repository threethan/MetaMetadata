c_ohc=-82VyLKK6IMQ7kNvwGtE-G9&_nc_oc=AdpO8YihiTAwP6p5gi30vqxH8WSNy8x7pEEJe3bTUsCYE9y1tKHPoAlf0Vnx6_G8nSc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AiU_2lI69g5t0WC5Za1kVK1SE-6vzO4Sv2dgFJSuojg&oe=6A242A82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJx5Hle3PtAQ7kNvwE9geOg&_nc_oc=AdorT_N4jLXOmyBXdj13TCMrJoZJDv7TxniVbU-oq-fLbhdMN1544TkT5coKyxXsP80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UqGMHA_RlrnHbDHUpADm23JjRXiOC-GCW4NouIKveug&oe=6A243F72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liVV7gOIFG4Q7kNvwHxwcaa&_nc_oc=AdoFEWag5FVDk2A_F6tFnWnmCJk3C9TpP1H3sktNSyxiSfgtunCES4GS4mAWZCUwypQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OLrmwVbrxPEMxa_yjkiFi9vNJZYDfL0noQi7cbOfdtw&oe=6A244360"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgB9Mu_B1NUQ7kNvwFkO13r&_nc_oc=AdrI3Dyi727NC0NtF1eoox57dN8v_MUIpmzCyWwBt2R5sJwbaHh5q3G0i-jKkCVDLGY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--ckNL21qCfkrTXqL1jtiDvzeYnG6Af5hMWInZD5WBDQ&oe=6A243021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB4huPx1ACQQ7kNvwHsqiKx&_nc_oc=Adq5DAly5wO0uOtHPeYSL3LavzP951JDTAvhHNOA4TzYfXso7E0V7u7Qj0Rge91FHIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qodD37kMcui7r0wJYJQnqoxrLq3Hu7iCrM9Hk40BrOA&oe=6A24304C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
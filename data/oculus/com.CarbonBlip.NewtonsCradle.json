c_ohc=2GgJpQDX9OIQ7kNvwF1CCgB&_nc_oc=Adp1PMS_2vFqqe91DmPcgK0STGl81Qc38JE2lrhUNiTT-f0WJmy4gu9f4ZVDyVHlrJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tvMWjhdzWkxoKlu-J5x_cynW3Hfm8EfUb9XaZNOrZHQ&oe=6A427D02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ImRopumS4Q7kNvwFErHC4&_nc_oc=Ado1YxlFhBAag0hNuj3HvE7vWs7YFX10J1a1Ex4rtyRhGEuOqMUYzELm8waIOTIJQ3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CbGTLUpVRn76Go04tm8TxLMr3tGca8EmZfhN1RgCPNw&oe=6A4291F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ykh2S6c9pQQ7kNvwFFHbwe&_nc_oc=Adr_kH29gVyV4ksd6jQgUH9vgyRLZ4cyAVIQqp3lt61yF1EteZnwneHp3ihzn8koXUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gA0B6Yy4vuJcIBlCdK9Z9pFSfPrS-Rz4V_pWIU0mzRA&oe=6A4295E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvBVTxG7JN8Q7kNvwEH589A&_nc_oc=Adoaug_stovXjxZchd_I--RR6g1zesS5W7BX-1AJBSgn-h9eipVuxG9xBziwB_aU89w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZLrf-XrHPsHUfwMOw9VIPPrx9aGbXY-KEZ9opZlrMug&oe=6A4282A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzFa9oIv-DQQ7kNvwGVx4hs&_nc_oc=AdqfJYS2zGCgqaOwepM-qHNGwaf9mfo8gPxtJ8kZBej8bAQVZIVrj7jYuvkU5XqQgeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UgGLSl9RJQahZHB9BA1G_jKloONZZPowmDuCi1QDByw&oe=6A4282CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=vZv2wKkj_14Q7kNvwFVKJeZ&_nc_oc=AdrjDD5omUafXYuvK9yz92QgCxlPhTUrJjsD7J0-RzFrggb2A8oJHT1G1osgIMr2JzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UvrBZz9sSoBdBGdKyeUU96XSVljDQ7k3Wwa-HHX7LVA&oe=6A203602"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFUffUhUUkgQ7kNvwHqZqYq&_nc_oc=Ado0bACqb3z0uKoE65xTqLzGpOJZIAPA-qGCviKF9_gcz865k8doiiZWXSsSCty2l9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iBx4NU2S7SRc9wUhHUPy7_53I634_8kR54n4A3ZuFwA&oe=6A204AF2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxYnv7kQMcgQ7kNvwHCvA-L&_nc_oc=Adp_XV732woAAn2F_Wffs_iaoPVjOhTKoCg17WzEQCu3DxVQ3-9xohZ_TVcDVMVF7S4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_PNot2uyat1VcH1j5658q7Gsi8GZBwF6f1Hm8PXFHiw&oe=6A204EE0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzPJDsUWQfQQ7kNvwG4RQlB&_nc_oc=Adra1S5kZtxmOcxVEvl5_PHVMLvsEV8IoehM1RP6Qfb4fxukF4j_DDRu19NP_djU37o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7InpzYPZCEOE_Iadi1smn6y3jZE9WlT-bZ-QjzAb4YpQ&oe=6A203BA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgwmou_fpMQ7kNvwFRkvK0&_nc_oc=Adp1t17fK-iNyHop6EB7EVcqre3EXSH2E6X6arGrBjUGRxVEZF3OxVitx6QaK4MuFVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jhqzds9PF41QDSbQP-jI-NItzyM34BPbE9s085FBSMg&oe=6A203BCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
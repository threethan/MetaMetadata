c_ohc=zGrbeO1m_p0Q7kNvwFjqOjZ&_nc_oc=AdrFmuKojQtHk8fQbpteGaG2NLHYmn9rQDhqlyPeIQHq9G72rkQbqun1DmtK3-sBTmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPiwBtNCIp_uPFWzJBIP2AdGzuWed9x6tIzwkAgasKng&oe=6A4BB782"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WO1v-aDu0EQ7kNvwHrVuCQ&_nc_oc=AdqZTA6OnyTPqsdZ5F0raoXknAwl2iSZlQrRZaLDpnBg29UYwetCl5CDllTnZ7N25qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV1W5-_AQNizM77yI1Lj4BtbkgEg9zPVsqT79lD8KPVg&oe=6A4BCC72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agr1mFB--BsQ7kNvwGb1uxp&_nc_oc=AdqRHZojdt8jm1YdRn72eGhO4SGZG2NmsX3CnBNyL5F3IGLlJhPOfg2Dmtt0wjbw_dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOPTHWhtLAkKCbJNpa53v6_pV8MRTSsRtBBxwSo6YN8g&oe=6A4BD060"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlOCy9Jqq2UQ7kNvwGa5Dhu&_nc_oc=AdpooydD8N-OMtt0XVg3xQYCQjWHLVCT8ldCmEp2q-ru1tWf12ckJObxKth0FX8xoKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdQUNXBzFedcwpC7gUyvMqXDF54gpAeBC8R48O_lwOfA&oe=6A4BBD21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVb_2UhZzcEQ7kNvwGmjdae&_nc_oc=AdolrFulbWMKO427eCsNaw4y4mq8Gj5ddotOditf1Mi-qAFxC90gmnVFsXGelT3Uwy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPcAyfAxOf9k6PmM4woZNWwSPOk7K3q2bASuVUbsce0g&oe=6A4BBD4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
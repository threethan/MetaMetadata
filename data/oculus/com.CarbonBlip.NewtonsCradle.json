c_ohc=j1n4S4mV4pUQ7kNvwFiN7CL&_nc_oc=AdrlSrTLipVMLxGWa3y_smLTGy8I5IvHhzmjcq3mhqUp698heelfCQg-T1pYADvQUjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oSz1bYobVfJKqpX-xCySGBKFblh3nqgDWWKXAHoUyKw&oe=6A3A9402"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tlRo-lTyeQQ7kNvwFBNKr4&_nc_oc=Ado9l2SHnXUvR43Av1vAiwVY7rp_VzusOVqcmmOiboik6Raz7cbjCMIiDarBTgNFkOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_menk8BuhNiMnymEW5rV0aLCFFEwmo7B21taspc866w&oe=6A3AA8F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHoZjwV8xV8Q7kNvwG-Etrg&_nc_oc=AdqCd7QUBIM0RLH73ifeLgHbbRy2LzqE8Ee5xsaPK8r-unKpQGL6Y67KuU2ndRq-c4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1G0O3h-EFKZB9mgzjOwn8tESSdKY2Q-1yJS7B9Drhng&oe=6A3AACE0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpIAxxvFZzoQ7kNvwEGDGVd&_nc_oc=AdrtBSJDofXtBIS7a3mfI27pIw0oUIO7PPLZZhgG0F0FVvEiLZZPfRMT6qGURuFnz8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R93UWynJodrR9R4bdj7EGGYcC4Q2zezmz_OQslTMIXQ&oe=6A3A99A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOL44urKr0wQ7kNvwEJ-9Xm&_nc_oc=Adq3JrnuYOjQ6_hB4Tlv3ZZghAaHhKkUWCtY0o94B6edvglAwn6BEOa_DviYer165dU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80x1MAKShzez3s37x_q6c03QyIS5JQuUqyo3UGP5YM2Q&oe=6A3A99CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
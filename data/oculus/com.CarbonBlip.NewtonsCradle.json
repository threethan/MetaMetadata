=6e7a0a&_nc_ohc=49OIKDT5XsQQ7kNvwEuEMwL&_nc_oc=Adr2NyXoOuraJk4y10GokkO-KTyNurtx1VAEgvrFJwzIeBhcvz9L0Ecv0qYDbmZwnxI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmgzhzcsgLIqGVzlfCioHDiN4JnMuUIC_rzcWxDOaMYw&oe=6A8D6A42"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVqXHbh77wcQ7kNvwE2H2Eg&_nc_oc=AdpCRibO4VPTlU7QlAFPdoK7TOp-6CBicLgx1I9x0QFhgr6usNZXPRYKJbBzBGP1wRE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMJmv65AitSgdP03tpF2kOF6VM9fT3dkY8CXYdc_3zqw&oe=6A8D7F32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ricZVawK9UQ7kNvwHAbxHP&_nc_oc=AdoK15WTxEXjj7WbRvFB3j3-836uKyYi5oPJA-kJNHhgZnVGCJY378TU0NIZQ6iaF14&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXK8rA6CKgRVIZ5e-DMKlBcUEgyx5McQJy49-YX5BXgA&oe=6A8D8320"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqG9xKv6OKEQ7kNvwEYWnAz&_nc_oc=Adq89gbfFb2DbjNVI3hWEsYgCXYr64bnexIH_ckzHCsOINVwYthY37VBvNaYbkocdNI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLrW3cVZCdHd7HN8GOVIh4-kVmfjXREV6zqgsslTijlA&oe=6A8D6FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JssTsTLTKQAQ7kNvwGmuetD&_nc_oc=Adpsp3pDsy6CmYTbaA5mqWGvN8KaZqw8V1k4SFLWqH864CzHFRS_sXPke5NhQDJtnFk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgsgiTziEUUK0ZCAYRxwxXNChiRy0ghkgqRcn8lV91Lg&oe=6A8D700C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
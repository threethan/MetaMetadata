N3UThEKbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJ9HWcBzQrOiyH9olbKTovGc-RQ2_tsWJ8fgPF6M6J4A&oe=69A6EC02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BcaNrSMdlUQ7kNvwEz33JD&_nc_oc=AdmMlZ6ABXp7XigujYfWl7WVZhQ1I3VduXRqWsFAoTvWYutd1hrA1Lyshqr0lE_y7NA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsF5xhQw03w6VN3mB-4RDmxRM_LKW_3mpwmrXr6bjQZyA&oe=69A6C8B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6HtzthsH-gQ7kNvwG9EtlR&_nc_oc=Adk6idKVLHhxDcLF922VOUftPVsgSGOhQocgFNqw6ciNnWRTZOE2z1Mek5QOXun9JEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiW0XO_Sml6a8HYmvX3ISEP3dYF56_9YkGySe2uwhpvw&oe=69A6CCA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZDdWPWi6sQ7kNvwGitc54&_nc_oc=AdnhASO08PudM3OYDXnn2QrhJgqPvbpMFDA94xfEfj4CTAyuDSfJ7RKbm7lh5t9GXFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2DnvnoYr9_MYdmJ0Yet7De1e57c02_UmqMIC6W8h5cw&oe=69A6F1A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw5Yk4hhEGUQ7kNvwHa87HC&_nc_oc=AdkKam1W8VQsnCrPJhEcQKvMuoIpRg4RB7iU4K70LhSEMymIKap_BUGR6tRcSjYL_cA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVnxxeOLqhu3xrVi9u3MfWbpvhCJz-Qy01cTga9tC7DQ&oe=69A6F1CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307369478096069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5
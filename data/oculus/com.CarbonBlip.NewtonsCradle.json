c_ohc=0Kf8t9R1bb4Q7kNvwG3k2pQ&_nc_oc=AdrlcwV2iiaK_PWJ4IKnrmV_BNQPlpiDKtqVL29Q2iS_7NztTMMVgEs2ZuQPcs0ezHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYjCknERRwsjPXuo-mKkauWNjzseKWzPnQcoEfKNUJBQ&oe=6A4A6602"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLwMCV7Th-8Q7kNvwGXBIbU&_nc_oc=Adp4XxisJ3bD-FVqigdza1QLDR7DIupgANSdVDadtVCt9Zci12Uheu87TtQkrRGhVjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUUW4v1miPKiNy27M5aOa2-33K5QTyTQ6YVTbvMO5_8w&oe=6A4A7AF2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzF4N6LP-U0Q7kNvwFjI7RN&_nc_oc=AdrOxnGdPKQv-xufs4WkF0Jn-3sJ1r2E1vIfB-_cC2KYe9G2CgkazGx-TuZsCZ_BGOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuoSY-kUtsXRNb_kPQrQUwsx86VxYv5iH7Ms4KMH_DNw&oe=6A4A7EE0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlOCy9Jqq2UQ7kNvwGYYhye&_nc_oc=AdqB1PmQSsSFzRUH6YHTUcjGHgyhCaq-8AuskJTypFaBjj4Z93SVbztmZ3MtXfczDNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQul0Jc_jsqoSdskpuAZfKu16deoXacv6gdvyIxFrVIw&oe=6A4A6BA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEw5qJT7wVEQ7kNvwFBYtLs&_nc_oc=Adp2EnditJoNQfKswl8h2wHYs98L3rLYAF-0TIWW8dMLOADheyWhrvwTbdFDZl0PenE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdYWHXnsEB_Sx3BEOp-f_KVbh-BGwJ_n0HEdLVv92oPw&oe=6A4A6BCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
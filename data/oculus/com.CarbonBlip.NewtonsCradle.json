c_ohc=9GleYxtTJiYQ7kNvwHX1TBp&_nc_oc=AdrdjtizCbFNcdQXRWnlls1V-tjIuzSG3GuflNG2qmMg6uTMawNN_wDvmXBhUhs9cIY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzd4lW9i7C_Hmg_MAofzElV69ocPn0er-WwA7uae-atQ&oe=6A564382"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa-soFOwbSEQ7kNvwE-gp0r&_nc_oc=AdoDAB4ZwUCFh6TLGiTwg0cJzrwHD4GaCnlQeKNJ7J1nEjQcVMNIECmSsTYWf0Ccp3M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVqhlmPUelPyFBp7BR7iou0Wh5ypCM2QF20GnNOMTY2w&oe=6A565872"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z7Xj3n5GXoQ7kNvwFypCYh&_nc_oc=Adqy-ENPle0JOGvlUnzp4ZjYWMlR3loS61RzUzyz6N5XUKbYJz9xOKxYrTa6iXAZEyk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFqgMREyJyxnh9pSJCrKdpRlFj_Y0dGhOsPWu41n0v1A&oe=6A562420"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etREmMzCP60Q7kNvwEPXFF3&_nc_oc=AdpTs6BP0fhdV3OJlsi7WG-J7Y8MIOkYQ82rhmR4G6jU3vBLub82ffQt91-JkpZNHtQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOB2SUysNhraHtDTJekYTpf4OkBlRlZztUCt2zb59Gwg&oe=6A564921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5FEFzqdaagQ7kNvwHtC3K5&_nc_oc=AdpjvvnSwCS2lpTNuWIV1NMTY5nkxCkNMeKl4DGM_jieuV-DT03mH2NmE-B7C989W-Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_7UdfkVUWXSLg_opA4rExhj3vt2SnpJXtBEbirHxm1A&oe=6A56494C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=PnM07tNdvCoQ7kNvwH9TQ-l&_nc_oc=Adrh4yA7XmNub39dogbKcWjcGH85lSJXeZVpdktdxvFeTK-BoPcgUQy9XoopW5VSOYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgQlNXgh4Q4JcEk8D6TFgT7XL_hdYPK6um94qeCKSG8Q&oe=6A676702"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnnIhAtE7uAQ7kNvwEn_QPo&_nc_oc=AdqAImVeApxK9Ez8fNhjlSTOXkY_rrPJT32xM4AWJHwerIRbICSerK2yLzyQPaTJxAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG63d8v2FgpI3kUlWXZ7P6jclSK3vEyjX3C4pWRw9EZw&oe=6A6743B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdFCBSEIe1kQ7kNvwF1Ulul&_nc_oc=Adp5jlpm5V-BIicIVAgg5f3rwTEepbcNZO71gCf32Z5bfg49BAMazzNbSuqPCftYK-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI6-bS9yNgrso5motVWpd9nXvHAMv6Ln30sh_Sn9Chdg&oe=6A6747A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcupo5lAbkkQ7kNvwFqX2VL&_nc_oc=Ado9jSdKdlnZyQxtobO0dZ4C-14Mwjro9-C8Mulb9HfZVpaENqiVDS3k6CejO39Pz0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAanvFQQAxrIQWVkDvcKNbnO8WWe93yDPH9TETKO6JsoQ&oe=6A676CA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azPpXJStyn8Q7kNvwFr9su6&_nc_oc=AdrSNdqQl3KoYS68xpwempnW_PCeTTaZ6O_D-P7WkP7s4lCsfNgV47EAEJaoBtlehi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHQZwbKo2Qz2digCGYnaL0WOIw1fU5J9qyxT8TN5iayg&oe=6A676CCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
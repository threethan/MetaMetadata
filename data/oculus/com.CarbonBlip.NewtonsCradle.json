c_ohc=SzxH6vrniCQQ7kNvwFsaL7b&_nc_oc=AdpVLk_VOaHnlB3ASGC7obDatObnlZPLbwOiui1qNcZdQpzWLQa0nYCmG0aK8x6M6VA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qKhfQ8KPg3QnfsCJgPaXmxBFMyi0_JdVaZHJfSJD6bw&oe=6A0DC102"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX2yTAtS9LUQ7kNvwGEb6_g&_nc_oc=AdqmxHbsDTTRV6Crk9EI096k-lZLOGXzhfSi0de3r_0uOJ2SDBDSs73aPgEtMKpCORw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4feqR9Xi9jJptFORcnbz6cKNmor6iuCtFnPPtMLo02fA&oe=6A0D9DB2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koRQy7I_sAcQ7kNvwF9cfQy&_nc_oc=AdqNnVQtXs_pCZl4hWpotymUgLGKhq1lYIUTbRhSGZ0cP9W2fvpj1SDTIsDteMHqC5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yH0Nd2r-0bv1cUWUj7fPQ9JckZq_VXdQB4IsJQa2Ixw&oe=6A0DA1A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=040Rb68kdCkQ7kNvwETjxUF&_nc_oc=AdoZGgHDTkWY6hmB7ERpbj9UBqAzz9itl_QdOQ8442SghCTnTrjm0XnHQd1nCkrHW-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78teS47ZXlaglR6J1QucFW8nFjEuyhR4huHwbS23nfvw&oe=6A0DC6A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiMVcuFDXQ0Q7kNvwEWIMnQ&_nc_oc=AdpI-HzKJm6-5LCckgU3oBySROARXdD6hUjIMmGgkoISm-IxU89ZlOX4F9A-6ft819Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rzFgaExNqv_Gx5mCt4CguFkiPd772qi0kE_iss08gTg&oe=6A0DC6CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=4MHLsmDMtX8Q7kNvwG91UL9&_nc_oc=AdrQfJMc7yEKeopWBQ8YabT_yyE-TZ9b1quimOJd1A_OsA4M4lY9qW7MszxuZtBXLog&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X91TGJgmg3fYQ2VybFiv8bqqvuAzaAAUo7FpciJ1a5Q&oe=6A1C4182"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spQxBcjXrwgQ7kNvwEeHf6B&_nc_oc=AdryIlMbUY1M1Hjg4iCCkX0LyCzG6s02aK7iG8cBJuhlFutHJ0-KY73VKd6qtBpR4TI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NIxA5tCfJS4-JYGaQAahToMGVUT8__sDzET5mmso6Zg&oe=6A1C5672"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_wo7qcAR5EQ7kNvwEiUYux&_nc_oc=AdrB7QU3KVSz0ObQLaYLr39PTUpFs5EvShmhNjIUyILaPEUAgwJXVVLfJOhLUyQfUsQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWf1RXErUvSLVxcBNrkKTNguoL1Jp-PV2cSA_yuEYhg&oe=6A1C5A60"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Bw9aJ6M7MQ7kNvwEqyOdH&_nc_oc=AdpvIYAe2JTooj34NwLNv8eY-mI2U7hGd9OO8YacXdqvoG7jTDHC5NW6t3aixpsuz-Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pZ7nYdz0WUoo2grvtZf2B4p4HuCUY5NIlZsbrc4M5HQ&oe=6A1C4721"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os1uOuO0QIYQ7kNvwFdiVJM&_nc_oc=AdpKR0GW2ZdyP8f5XTOzU9S0vOyfOr1j6TyxE5KZwsh9n57LzC7VuDEeTq0M61tLHaU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56v8HET5feie7fK4K3L3bMZYeIxgGoGPq-F5sZ9UPLAw&oe=6A1C474C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
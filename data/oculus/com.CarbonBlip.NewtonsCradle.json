c_ohc=ABO1Vr-wTegQ7kNvwHO-j3K&_nc_oc=AdqxAvNPhc1qwRS-kAPu2SLtlOW4Op8evGS2v-q6fOeBVKrsZ_KIKkVDZKKlcAgKhSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvqCzs-hNoqDM3CyuOiXgtahQJu10AdAgUDH6y0AwOsg&oe=6A998002"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNey0t4Hxb4Q7kNvwEhikUr&_nc_oc=Adq4iwinzZZZ69dstkdGEYdgFC6Aooo_RnL7OXEqyh5zSTew_FCOfFt-1WMHPJjcOs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFsIxBhNV5XLYxoGxoGV3HfbU5rdmB1vdiyC78XkPQmQ&oe=6A9994F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6MQ-6Zw5LkQ7kNvwH_nom1&_nc_oc=AdrYwhkXvqzrLNBfoWw-JF3zHvhY2Yir9iwaMSFhYEX3TIy3c1btSPV2xvxpF06Iwas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLegpd885-OlZm_UhrZLXTVEtV7saoh67q-2pXhz8CGaw&oe=6A9998E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HneEeT07bokQ7kNvwFTpAoA&_nc_oc=AdpJwUEJ3NELnGvd2MUh-xS6otjyzoutLi_Vh6Kdd3sYBy02O_YQrl9uEHPHTKKahvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKStwQlF0B1vooC50G0tdr2HTbpoCpoWMZZYwICDrps1w&oe=6A9985A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX2euDja1JoQ7kNvwFlI7cA&_nc_oc=AdqkvPXux-6MivZbR5DtsvdAyzKsDj0iESsdO-Aul7yaDr4RBhxP7_56io_HViyMy6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkpmK4IKBuSWClG2Idrp7qPZ8FCWw9Ks_VW32cAjRw3A&oe=6A9985CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=V_XWhehcj98Q7kNvwG1HRBc&_nc_oc=AdqYCKPXWKbtNKRDEe-V1EhkeNoCtn8b4FKLbwvOkx9vjErfndSkgTWayyQbshzFfVQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEC1CgDOFmJ9lpXD4AumtqCo3_ExIKGQvYNg99IZntHw&oe=6A9401C2"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGJwOuRWo4YQ7kNvwGiaPcF&_nc_oc=Adp3HAK5EyXkh5AGFJtJ4d65HKsqBCC5lK_kgcQuMbzA-mpfgtOpe5OImMqeXrsWt_c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvklXx0vJ6b5uKfbZu4FngH5RHB1Kyavp3b_zXd7EOuA&oe=6A9416B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU6Gbn5mgLkQ7kNvwF0g6PM&_nc_oc=Ado-I2af4QxBq64DpLw8WNWzjvrQQuU2CQsQdHC69dYyxTQ_0GwdNKhw0btOoWbExVs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7l2f0zq3e0WueoEU1VNZAJr8jAU13fboqO-Y-vxK4kg&oe=6A941AA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R98qEYvEANIQ7kNvwH8Zp6u&_nc_oc=AdpCws2uWK2rUydkVjOM63fE19fzbtos0VlLaUqjj6uE28G0mghghth8I7sMuoOWDHc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfgCaZffgQ6MCkPE6-HOU_NOPjArjSxJ00nS5COSy3Lg&oe=6A940761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIasu6KYRq8Q7kNvwFsOtvF&_nc_oc=AdrZTewdKDhdghzV4q1RgfmWE1kWOdSNUactjkWuPp28jc_q0CugQwCuOFg9-UOlpYA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGddL-Vba4XXiTqQvPTcl1fIcpdxgFH7PjgLCWfhS_wCw&oe=6A94078C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_oc=Adk5mRQQjwJbelTaxC36vvJhG9Sghjj3Kw8EI-kN8KBqiXXKCfDiSYQv8ZMGAw9vYnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzO_xPP79qjGYVFmEF4LdFnKjy3G8JRfNZi6xNjwzlG2Q&oe=69BFF882"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRVM4Aj6s04Q7kNvwEj3L_N&_nc_oc=AdkrJ2WIQl536TaF-2cfGlqnHuULns5oUuIar0MKRXZjLs1UnZxCpblxp2xUXjpesEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvHrYK7PIbekGPzTfQLMh9CmbGSBNiLe58XNgi0mT0Og&oe=69BFD532"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkLqmw9phE4Q7kNvwEpRlLp&_nc_oc=Admk9jhGxEGQiLIwuwhEs2CQGSwIaErwMT50xggNYljB1CXAA2U4084GB3xSXPd9MRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn4Z1F4A-H9RJ_n4ZIy-uNnjJ6dt6Oh8R32ztrTav3Vg&oe=69BFD920"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO5Aw7kgnaEQ7kNvwGOoXD4&_nc_oc=AdnebdXnJ6oByw3v_TCQtZ-aPtG08FhbvPxNDO3quGPQOvojug8bCMLPaQkC-UiI1_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzniXg_A3QOw9YclM4a0sKZ3jGn8PqfEC1RRPM86q2Cw&oe=69BFFE21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZboXzYIOfUQ7kNvwGCBYXL&_nc_oc=AdkdGRZlZkt9YFviwj5IYG3PJoQ5NRc3OmFR52FcZKnMf5x9Ea9HDbrWUkNLzYF5igo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxX7YilaopYQnprInPbxPDHZ-E1_EIgnlPZy40tPu7sjA&oe=69BFFE4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3073694780960
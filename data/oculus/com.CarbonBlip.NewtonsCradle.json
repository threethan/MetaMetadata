c_ohc=vtA67T7yl44Q7kNvwGoaVDp&_nc_oc=Adr9TAp-2Picrw552ZI3YbTT5QW7necf2yOMepmYvShWnq58x4jGHPnsIFGULe876gs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vI2fNW8sxUyeCjdXgvr8rAFu42MwM0Qbs71zzwhNvUQ&oe=6A09CC82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZOQfE51vvcQ7kNvwH8XE6B&_nc_oc=AdqszW6XMvllbJbVtqSqvszuDN1xsaSVOA_rXWl7zao48YzAJGiqMIzdReWl3Fqexp4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af713l9k_ixFb_omLMVHBzOPFtupbtaG8Gaet3XjT4OrEA&oe=6A09E172"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEdTFoJWdaIQ7kNvwGWFvez&_nc_oc=Adpi14Zn7xxM5KkSIUGA0ABQ_dDPcH_ltUB7UmfJ70RzWm-URTsrYfKxZrkEsTmfwSA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qTaQCtBsppeapb-rz_P7_1Tio1R6rf4a7zdjpdwO15A&oe=6A09AD20"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsxN5b5XMuQQ7kNvwH-JiD2&_nc_oc=AdpyrZaQhWHVtExQZyKR4bvxHjgVfKNnjhADSVxpAib8yVJu6a9trVhsCD1FGRT0rq4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I_pTtN-rmx4pv0LLcNtv8l23HeFakgtcyCb0rN46F5Q&oe=6A09D221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQJHF3qVA9oQ7kNvwE7i5nn&_nc_oc=AdrV9t7lgZr6NevkTFzEhPGJFD140t3WYmANJtvaQ3D-p5Bbnp_9wLWDk7RtFJbeMls&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VwgsF_cokZck3KZD9XKSM4hUp1cDapBZ5KulHIM-qzw&oe=6A09D24C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
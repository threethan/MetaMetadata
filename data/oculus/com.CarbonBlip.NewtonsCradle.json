c_ohc=m1txoN4lzMgQ7kNvwFSJXZi&_nc_oc=Adp6qZobjV0JD-FlpWDjvKDldtxwJEZziewF5QWzHQMLMQo5Wm6Ulu0X3f_mB1uY3mA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ77iza0mS1BGuMgkqXgyAS1xTWCtxtqyKq0rmTdKRow&oe=69CE7902"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIzkVbxdgyIQ7kNvwEdnMEq&_nc_oc=AdoJF3_DL-UdqgI8Kki1PrZq6V6QpW9pmIWSzGJaaP8jESF9NC7IQuD2tQLqRu0LeTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIJV3IfdDpAGM755UZZuTU8D6fS_KcMDSzuoFjFbe4_Q&oe=69CE55B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9N8Le_EjJYQ7kNvwHZ-Vaj&_nc_oc=AdoD50ZY-jWgEyW3T0VlVGA8CsLN4AP4T1y4sDrfSIWJx7An9MsGnbGejFDG1zcLcqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhNaESS7Vr1rfe0jjVkzbllWDXeCP3ZqGeKi9g2JQ93Q&oe=69CE59A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHezM0U5-3UQ7kNvwHDPn4G&_nc_oc=AdpmCiFdL5ybmnmBz3ccCT9BzhhFYLTem6bH8C5AGK5yW6zb5RyPi6FnfF1t7NlzAPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytaEzvLzwUIbo0Eioy-4iAZNrmcGojgko-sLzXCOcozA&oe=69CE7EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS_ceo0dxlgQ7kNvwHvutgX&_nc_oc=Adr7eKvKsBvPgzM7PzCZtzEbjNZTSxtrJYRArYA9i0db6xjCX0v2m1BmUTTBy8x3RvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMxTQ-0ALL9NuDL7IpTbjVxQBnH-N6M0M39QrJp2jbmw&oe=69CE7ECC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
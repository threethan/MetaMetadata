c_ohc=BvV2toE-STwQ7kNvwHhyKgB&_nc_oc=Adqy8Hp62CA-TSvdMQGJVKwJI0ZjCVfg5ubjmQATmIOBUsz2cceG-s_bfJ0VbWryisQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6r_flvlET3pHBhKo3iZ16C69uyLBXLRh54OIFhPArhw&oe=6AB7D282"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb5t-2IiP1wQ7kNvwGGeHdZ&_nc_oc=AdpmNAajN27SHXvfU65Kucwms_AK6zUEtnsi0GGFr1wDfYdasTy_G75B5zj2n1Tqiuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc8_xbqTqvW1lSrzL7ztln34ToTnsvm1vYL6oGgdfqww&oe=6AB7E772"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bAhWwKtBhIQ7kNvwFqA2-e&_nc_oc=AdpeWCKfwDLmywMmAH1A8GLy-RW_vzY0P9bBwkQd_PyAwqqqFoE-sfYvn3GyPBfPewQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGEn37hq92sZ2wqpntKTAkyOLkRkey9DVU-lP39daeqw&oe=6AB7EB60"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JH7tDbGVBoQ7kNvwFPzlZy&_nc_oc=AdrLbuquwQ6YhWEMTlF-3vslpWadKwvFnW1iHx6e52etyz7qr9CtMksZCbIFdbS7aDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_zlRmsxKIkrMDHltmrnQUkt-Z2vYEgdsfgHBPtayxdQ&oe=6AB7D821"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp1Gf7TwGUsQ7kNvwGOSL_U&_nc_oc=AdorpGdqVB_Tt7OqlEOPR9xFP4OOz-oHkePpQh0rsFVojbpZyaEt9J_je5rQhPVpQM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7e1kttMlTERvUAT5pWSec3UGXrPIBCw-_0eahajuZdg&oe=6AB7D84C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
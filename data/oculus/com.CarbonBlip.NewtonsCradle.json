c_ohc=j9PHSmr3Pe4Q7kNvwGj5MiF&_nc_oc=Adq6qzcFR9xZhKaF-nr9ssIh6AyXe724T1KQZPJ3p1AQAwZe2l0nw8UdpgbXWW8BrRo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rfMX-g8ZboLARqB8TulMljd2hQeI5XECplYC3Agp3QQ&oe=69F36302"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZRgPGsoUTEQ7kNvwGbbOKq&_nc_oc=AdouKwLnSDoO12J5rXUPOhd6cB1UZW-DjZG6KkyAXzhu_mGIqMYwpVPJFFkvLu_bauE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rUgnWQkSYzsfaVaLt6obOgoAcpAlhv4JbAde2U6e1wQ&oe=69F33FB2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buDMlH4swDEQ7kNvwH8zE1f&_nc_oc=AdoWV8xxnRnQdVOGyAmE9f9txYoc3XtBYrXx5udT1j8tok0ckzH4kdnN-vhNMfQT2qM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JHHSDVHexHja0hgY1KVRDK3YubqUMgZkSCqprv66KOw&oe=69F343A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SowMSxs9c74Q7kNvwETB2sr&_nc_oc=AdoGEmN1Ho9o6c42Gnr3vkONq28UCNuUS2K-Tx90NUP0FJpRCCnAqFvBrw3b8l74Nyg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CCt_ooam5NNGoa5u52I7BnM2ANNqYUr3Vyr9X3d3Cdw&oe=69F368A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB9r8bN9cD0Q7kNvwGT-nhq&_nc_oc=AdoOyk2zy9fLK9POWIelh5VTlJbgtEZVrOeiz1-oh6xQPl1ug4WWWwI4SesYijaoCrc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UKLFlmxeZ3zYheLYFZqtToGqdBYhzKE54TQMv76kaJQ&oe=69F368CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
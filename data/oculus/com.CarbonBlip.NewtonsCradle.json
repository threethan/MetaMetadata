c_ohc=3QqKfhxTC1QQ7kNvwEpu31A&_nc_oc=AdqvDzH-FssCLvxrhdzgxYCNHYgRQ02Xu8o92LxHTDP5cFwiMltNl9_ax-UiKS8ckTs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0K9VdFuCnvRLidt5HGoCsrTGQLVk63gDuCr4xo-zK5Lg&oe=69F4B482"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MEpViiJSf8Q7kNvwEDqRpv&_nc_oc=Adp5Spf3fbPjD_Qik56QdallUwzxJ0bMc9fWbjFCF1u5YPZk90HZZciTF4UloVSkMtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18sanM3xSrLhfRKAMXjiZEn1wMHikBFocJs-hWu66frQ&oe=69F4C972"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAiuWyuYE0gQ7kNvwGISnPO&_nc_oc=Ado4g0p0a3O8GP7U44NFaOTJq19vk_PeL15AU6w_PYJ8XwrKneCKTZbQ7FH7z0rhPEo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2s1Weu1XKv610JGRuAryQymeycjzTw42ME1Jopebzh-Q&oe=69F49520"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SowMSxs9c74Q7kNvwEwNYCf&_nc_oc=AdoIklW5L58_FMMIMQwV7wZlhLk6zTa-eU_KU5B8-YxlM-sHmfqfAtltlVLhR9Ri5cI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pVugEp2BMllHz6jHDkd89L_u51w21asXbpnO0os2PtQ&oe=69F4BA21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dJ5R7CCQfEQ7kNvwGck3rv&_nc_oc=Adpfz0JNUbgCRdxb_LEoR9MJaD_2-1HMR71cI7ZLGGdJyWasPxnjPvB3ymj4Nmbt7QU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iyzcVJc1yAO1vfWHAQMbcQYQKWbYSFTVWgwkTBY1Ntw&oe=69F4BA4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
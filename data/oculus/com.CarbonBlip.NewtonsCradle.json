c_ohc=P3KSAQldShcQ7kNvwGILrpt&_nc_oc=AdqWqWkyS7zW1Z3fzJuLLUMN5uwZpmqZ5fxBBql9NHNW6VqC2hzz7GiK8rE3wKkAqBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiPr7hKXXhT3mjPW_-OeA3pngnyQa5yNUOil_z6lunIg&oe=6A773902"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngt07aJwIh8Q7kNvwHz1MHg&_nc_oc=AdoWuNduYyUSppcQnpW45YwoVbh0Fxq7qfu3Y3LcCY4w6FtkxIPgI2hVqkDwvFde1B0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvwAsW9LgH-F9rx--R-ytOFn1CHn8Qg-VCOMGmOtUvyA&oe=6A7715B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0L0zp67AfcQ7kNvwGlx2Pn&_nc_oc=Adrbo5TkZTcCIGXFFFKoYm-xr2k3aFX8m1qk1AiYaijCQ41h-NzHYa6P2azgTF2ya9E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbyxkEpzHQcIckLdS5p5PQ2A0ciRllJRWl1-GP-y3j-A&oe=6A7719A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON8Bj_HTPrMQ7kNvwHhEnjM&_nc_oc=Ado3LIu6R-AZvUJlgjJ1RoRtpJ5M89_AVYqLH-aqh84L9msklbgqq18pNeIIpOoaWfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRlbAGJGqfnDiVA1KHBAUe6qtZ3Dlp-vP1SbDRwxOGsA&oe=6A773EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK-iYwMgDAMQ7kNvwEZ07mn&_nc_oc=AdpqCj2pNnuAMpEF-_GK1RN8QmaFXoSe75eCo795-LSFrPF6Ib_S8PCYH1F9Cqz7r_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUX-qr4UpCYxrXjfeDjl-mv6n0YIQgy87KykuKQ_sFsw&oe=6A773ECC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
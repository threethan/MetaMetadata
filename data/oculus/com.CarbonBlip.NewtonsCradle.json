c_ohc=y3Grd-mH3iEQ7kNvwGpZjSs&_nc_oc=AdpSSs-EtMj6Z9Ujt0hK2WLPtf-b-1c21M5f_TltjbO_TVVWH3Y1B9tJdtKh1fwXvOQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC33ZjRXhxV7hmEl2nNdgR470ZEz1m-FtFnHTDxzSjwsA&oe=6A58E682"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcEWQ59oSfkQ7kNvwHtg8lV&_nc_oc=AdoEPWpMSopcOzwSn5iJBOaSrJ-XNGoh0aphVvdQBQDJBjabBtocL9oOSD6EAh7G-RU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Rpt3Dp9ySdLypHnywt64Vr1x7ePVgIqkqG0u91jEVA&oe=6A58C332"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBI_I8oTUAAQ7kNvwHJU1ep&_nc_oc=Adosg8fjIiqRNpjn0bckQFd8R0NEap47zMqmHWP4VgIGb6hW2A2dVFXFyjygKj_vZNQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_qKZQjKBkcBd5I8pInUqk2elJWSBaBbY_nr_9RzkkFw&oe=6A58C720"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etREmMzCP60Q7kNvwESr1ti&_nc_oc=Adr3YJ7FnF2DZA94dCUVoI2cM-kNh4TmYB49Xis2C2E0m_Z4MbArz1E2hqFpXgar72A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRl_SfJIUewTGOfB7J_AlqL2uwWgu5KeXGG2hftrrEYg&oe=6A58EC21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmdkCAJWzoEQ7kNvwFjwN2h&_nc_oc=Adr7OeX8y0DLDwoXuNBE1N11W-mfR84sHQ6fhkEVZ6oIcE12NRVXdu7DBkBqAkrb9aA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9uTnBaOWIbQdTOH0deDefBI9YnC-mJPpzz9N6lJMKtA&oe=6A58EC4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
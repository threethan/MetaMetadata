c_ohc=Au_a6HRiNJQQ7kNvwGaYHCs&_nc_oc=Ados95-uP9XOCWiG_qQ0zejLKLjRgoVNmTZ-AcxZjmltNA4REom7I0faW5l1-wimKTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbnnxbsGN2CH0eeTKd0UUTDSXdFN7zaIuGGpsx_6pGXQ&oe=6A5E2C82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-P49oCluX0Q7kNvwFowrw1&_nc_oc=AdoMriWUJZ7ZUoyMB0y8snfEsISLOZpZ0PoQf63__6XuHRRLEXpEdAD7wI9KdUPgK7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb4YBjPgb4w2nl4XmeDiIuUx4_uX-y-L6sNhUpGuKukw&oe=6A5E0932"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YdDBIAxWD0Q7kNvwH7iMjR&_nc_oc=Adp3Iz529xiT6DOC_HWPJsT6s8gWTpOlvxWrraacwRi5f0OHnXMoFgTp6tMEO-5DCjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Wahe4BrUhRCunHTS47nD4BZaYX2bJaSKC_J328mXAQ&oe=6A5E0D20"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT_qoHm9y8oQ7kNvwHrSfZu&_nc_oc=Adq8tlGO6IJncEPD6Ev_WYsLRUX3aYGZ9sgo5j51IcSMlQCMTb2-mFzykVgZH1u8A3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmAft2xjuCtmVWRJEaDB2r5kqx52URrOP9bqUolKUQxA&oe=6A5E3221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QtiA9XvyCEQ7kNvwHlcbzO&_nc_oc=AdqndcA5SMHa7mhLzaugUotT_a9n7dqFQCeoZSCwTdvCQrv9MODKeQpusq-aqPPn_RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASZaRoEozMtNvvt2Z3_k_WVxhl20ee5rc6otFc96fU5w&oe=6A5E324C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
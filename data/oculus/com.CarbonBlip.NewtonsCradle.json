c_ohc=9GleYxtTJiYQ7kNvwGSGRS6&_nc_oc=AdqjLsA-WGNT8pG5PSykQQKPWVqDl4skDfopDcSs1Gh0rtF1b7AtWTLgeHdfCkkRt-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBed-afC61j3ip_3m1f9p9zPu5EuyJkhaXJqY0CRU6jdg&oe=6A53A082"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa-soFOwbSEQ7kNvwGT0uLk&_nc_oc=Adql3H_6yudGOCYgMN7xGoL_b-UOdB8szW9u8NlgZPjl4nPkcnMAGMwlAubA-zcvn8Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDJ8NZApEWFSfoYHlV9R-KZg-uJ5EMqLw616P9KhMuiw&oe=6A537D32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z7Xj3n5GXoQ7kNvwENBhe0&_nc_oc=AdrB90geA-XWR9vKCOgUvnnnnNM1YaM_bnFOM5wS3oTY4t25K6IYXOWZjwdu4Nzj0yY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_UgJ8vVkm8YuZStS3SWUar03tq2HYknnDPE4WJN9JRQ&oe=6A538120"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6kG5IFTF4cQ7kNvwGZGPdN&_nc_oc=AdqBlU84l8VQPK1E3EvPSXojX9-9PmDv2mHF9FReQgazaY6uYyOd4GhsfZlWcUChUus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsJHVk39QKBEGyDVwyavRoql33x28PdNUQTrjzuK5Kgw&oe=6A53A621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5FEFzqdaagQ7kNvwE5sXkI&_nc_oc=AdosGOhPGGpSRyGMgcIIB2xCEwXlYwRpUTICXz4gi_icIuJDSZh7miBvEwV50IQb4_0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvX6nV4WNadmOA-ZAqHssjFPbY7acogTNhObnifkxmvw&oe=6A53A64C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
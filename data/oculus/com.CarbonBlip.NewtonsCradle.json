c_ohc=zGrbeO1m_p0Q7kNvwGWjI1F&_nc_oc=AdqN4uYwOVicvetUrY7YraDfXcN10QjkcWk0AyhKQ7Nx4IojedX0o9lJK-SVshhp_xo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmz-Lx3u98eOyWdy03F-2rtVttcZoXakEqQW4jMTt5WA&oe=6A4D0902"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WO1v-aDu0EQ7kNvwHgFJDP&_nc_oc=AdrsiSj7_9mYzLy_eOgjUB07Ln39FMmKCi07_7NTNjfp0w3-SyqLQmzXL1jkI3ITsdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2tpn5NAZkk-OJ07aVK-DB-eM4UONqH8i5QLlETs60mw&oe=6A4D1DF2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agr1mFB--BsQ7kNvwHX49lL&_nc_oc=AdqouW7XaUtCQXRsB7zR_zOFlr3hr54W7TER1G1nsPfCcb2aIzXtYENu7yLpeIFs9OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdra95TcQHnYcQo0W4o_FHr_PzXd0NKbnGwBdq0hkhIw&oe=6A4CE9A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlOCy9Jqq2UQ7kNvwFxWUhP&_nc_oc=AdpmzaTgc4HBCDVA1IKePQgXg4sxHV42r-U3S3Bfcx_Hi8Uom9qS2UTUXdzrDR7jFdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7lSlJ5vL7CoChOhwaXOluH5ij4H8cNrQjWugK2z-vHQ&oe=6A4D0EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVb_2UhZzcEQ7kNvwFUhq5s&_nc_oc=Adq2ceNfxTm4V4pS0iIW_Y1LPFJ-1FLzl2nWkn2BZLWZPlmq4suFZgdS4hxyApD6lks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIkXvGPGu_IYgaeu-kDjwrAHhGJPlQyuNTclLDKm2Lvg&oe=6A4D0ECC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=-82VyLKK6IMQ7kNvwEl3NDr&_nc_oc=Adpd-D2NyhEDyL3tJBB_TfqaNsA0TSoBvB8fxoNgqf_leFer-XJQNbRZNgGpZP8pDas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jmh4MRAlIs4A_8f3e9zSomodFJSG4EcY_jAghMIG6DQ&oe=6A257C02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJx5Hle3PtAQ7kNvwEreOMX&_nc_oc=AdqJGBNmVUp2y2ilU-pz2fjcwJnfAXErRIGgSrM445hLDs0PNVyjXctUT72mBakvaX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92xNc_v_HlALVN_7zg6iJIDhYjyhcMTCR27UBSbse_rA&oe=6A2590F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liVV7gOIFG4Q7kNvwGQgZaf&_nc_oc=AdqSN_conU4RqmybxVXuL7RndG8zL1sKnbFBJiLGNzTuv972OWxqO408utdADJh9q6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A9bg1d_blCN7iN_Con9Cmm-y7jvetj7pybLuU4yD-rQ&oe=6A2594E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgB9Mu_B1NUQ7kNvwEEOFFG&_nc_oc=AdqXNC4d7EH88GGCE3ofZ1LeRT_4FR5_JFEsrqTuyZhobpNI20aklJ4KrDqL90MJoSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_taYcf5BO0yErw8qXb3OD0OXjW4lS3BkM5Zihsm2Rf4A&oe=6A2581A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB4huPx1ACQQ7kNvwEsZuMA&_nc_oc=AdqvrPJpcZTAxslqfnk1p8FMRpJ__enL4D2cKrk-VsSkJfqKG58XT4d1Q8inaqd6Juc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kX2RD8jydnIkwJ9cmSTAaJ9LY0JZODSxlVyujTaIqVA&oe=6A2581CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
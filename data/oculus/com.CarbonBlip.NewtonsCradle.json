c_ohc=vtA67T7yl44Q7kNvwH-3Rop&_nc_oc=AdoSBNgxtCzhTLPfeZ5tQSLgu8yt8Jds8WyVJB5UfaDCrvlXReGKtGjMZkuYBCy4NC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56j4ASnU_0zca1xUdg90zXmpMsvSETi3KH4-j2rX2kzA&oe=6A0B1E02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZOQfE51vvcQ7kNvwGi-2Ub&_nc_oc=AdqxY6cr2KVx6Fpbs3pE2SDaQ728WfEX86VlZwBmttyeMsUKVjPEq0I6aBzoO1JIwRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WpP0ElrJIbD72y9EmSE_Nv4GdJ4hc29cAUZS7PEvy0w&oe=6A0B32F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEdTFoJWdaIQ7kNvwEwQblM&_nc_oc=AdotQRxoujS2Nj9EjqxE1XZcNxMEE5gjO_alMwKGpS603WwVL7nyp43ZlPw2ACo8qcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fnaagjyuH_6Y7--OfOdduOvv6bdWrv1fYDpP7iujDzQ&oe=6A0AFEA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=040Rb68kdCkQ7kNvwFEIDfy&_nc_oc=AdrcNMVpM574vgtl3WGYW1dM7vkH-9KDRJzOmGkRdkV51w65YsH1wvaGkUApzFoDwOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GBz2zSUzbUdhYOf0yDs4lB7H5gTdd_qDlXDEL2KeU4w&oe=6A0B23A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQJHF3qVA9oQ7kNvwEJQQuF&_nc_oc=AdqZe286PPE-MZeCcFv2dqjt1De0RE2aNwXnbVcRlHwoMu7aN14CDyNLBLXD-1Y6jQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TseVb003lJ_LVC5vgf6SYiLSPtW-ApHIURNPpSPl2VQ&oe=6A0B23CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
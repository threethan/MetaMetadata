c_ohc=5NhzKF24gS4Q7kNvwGki724&_nc_oc=AdqvKYr_qRWfrE5eOO2dMDJh17nUnXy87YUWbi53ULcyeJOeiY9foTBk-GjhWtnYysU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bccOeKmU_FnR7vuT3Aej3YbjGbXNRGEB_d6UvdTzxFQ&oe=69D90502"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD0OXYDP05QQ7kNvwGaf_LC&_nc_oc=AdplCNm7EETcaNR1xWhvmstUVg5-9kY8aC6lyxyS0xCOM-yzjNQ1JZ2YprHRJxE8l3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PLPDanpCFSIzB3Ft3hM-2ho8lZPeBYnE_4b74X4RWaw&oe=69D8E1B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI6msMEScvAQ7kNvwH2ngZO&_nc_oc=Adpl6eZDWqGvZCVvepAnGOo9tGnoW3ORj_zGeTmTvneoNoUO8-Y4VA9LV1GvCi_rPig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ErtW5X_5gJheKMfstBxC8QCwtWX_4y9M3nCZQZ6qv7w&oe=69D8E5A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3eYoDLVKUEQ7kNvwFlYtKi&_nc_oc=AdrnS4sONvzLM_Di1NRyoeVirAiM8mzZDYLoxvL8E6j5evFHpmIeDWY4deezPfRMY4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w-8FcxDqU-gpggiwl_QgaaXQjX4PnqeE66RDbqSgEqw&oe=69D90AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuyPl0mZY2cQ7kNvwHyspro&_nc_oc=AdrNH7ew1C_5Rizantvok9P6UA79FoLf0q1jUJ7wYEq9BpjSuK9_JoVAMNZ1lyzvVwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jMPSJqPYe7jWIR2KuyBguUaCHYcUFhwMoSjC2-QTKpA&oe=69D90ACC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
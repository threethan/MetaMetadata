c_ohc=qzoeCVu4W_4Q7kNvwE9wC8Z&_nc_oc=AdpbjIloitt2o8KpTTzj6k0KQ9MUiUbepWtmg24CmIBJ1fsqp36yBwIM0aR0-NPt5GI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LU4MxUTe4i7WZpxe2YDOWa6APdCN0Jot2vViPKDGtRQ&oe=6A3BE582"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAvGFJlt0KUQ7kNvwFKRWtr&_nc_oc=Adq6nO58YU6GH7JINI0qdhS6M8xOZB_9wofBO8DKt3Re7bM9Sr48K_VGj5UhUQr0nJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XpSiA5thto6mZ3JNjs4L-rUXopfPI9xm9Orxay7WX8w&oe=6A3BFA72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vp20iGg7tYQ7kNvwGZD-eF&_nc_oc=Adp5B3g2PBS1NX-kb-HFw3u7wo2IjQLIo7ktspd-R6NZs-jSoBd0Bzr6qkawZZxbxlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uBr9065THFyqFHR1MKg_R76RSBAiX3bx7N6YBzQzI3Q&oe=6A3BFE60"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpIAxxvFZzoQ7kNvwEQ90uz&_nc_oc=AdrY3Q4C0J5U78-RSGKnxOYu_90K64eK-OB_vqXhLBnAQ6b3g4zVexpupamf23cU5Ls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pCK9q9yA_Ipo3eh5Ml89oS_6l3LaFlccMzk-ieqFeeg&oe=6A3BEB21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJs5i3nw8oQ7kNvwGaZZga&_nc_oc=AdpXgYgKfInBdGYSdRJ8fZ4yDM8wSIQ9wavzxiltpzaIuf_Cct3fK_91201d-CnFqH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Uqh_U-in3Oc6qeKXsy3ZU8I9Z30FJK-TUg_lsob1gQ&oe=6A3BEB4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=vZv2wKkj_14Q7kNvwHBRYDM&_nc_oc=AdrrSTBZXK2jmcdrAWT2OkHcqUWvEHcalj9TW6uRWFJKcxO9BTGrEj0_wHe2qMcGlGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5yporb7p7Ya0kfGG8jqBNIGUqkPbHuVXroPFKWdBYqw&oe=6A218782"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFUffUhUUkgQ7kNvwHwxUbs&_nc_oc=AdpPjSOpJlUnoVhDk6HvaGTIsLgYxJE45P8PF_nsCJsQ9ccEtjl7G4LiY3aFPFH6qN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILDsekINnBiWfAZar7_sORn4zKmRMRVjlMgHWX_Yl8Q&oe=6A219C72"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxYnv7kQMcgQ7kNvwFPLeq_&_nc_oc=Adrzz8jIc-cGTTOOIEv7eqhkcSP6EQ5ftVPeAjOftcmAHrp37tezAYV0FGTkJYqYlUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PbwvFWXrlPNHlpwJb_IKPzfJgB5qxYkv5-R_6_O3Egw&oe=6A21A060"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzPJDsUWQfQQ7kNvwHsMzmW&_nc_oc=Adq1HR9sv-JW64zR_HQjNFsJkVk7hOSN7JFSn4EoOSZSEI8s2I6YqoMI2wmtRnD1DI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b-T0hvZ5CT2THutBzqHVbsupsscgfAsb94VPRACtbsA&oe=6A218D21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgwmou_fpMQ7kNvwH64SZC&_nc_oc=AdomCx4TD1oTW-Ic-WZALeVljss2dmOI010Ue7ZYIStqltSLXUmI_pDnPJ19zZqcjSw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hxzIANjIjIOn6Z165XHusV7yIiZolBrd1KCOzQPnvFA&oe=6A218D4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
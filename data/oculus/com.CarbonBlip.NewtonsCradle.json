c_ohc=itqmmup5JIoQ7kNvwF_LH3m&_nc_oc=Adp6ImUwaJUYaQ6Fony_SJG9PiYrkQHNLV94UBHzEASxFb_61plNWO2on10psqjcvQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZQFK9n35U4KyNc9f3PHtSHE8tCHM97Ou3bWMNGndEGA&oe=6A86D2C2"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sY49LsKlLmIQ7kNvwGxrgKj&_nc_oc=AdrDJuwnp0y5xlhG9B54_yebmjjbzv_cdmm-aR7N_oebB7uwS59dWLnD2pLH9MFK8c8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPl9ojwqM--RYLZCk6EET4S1rjMc8S6-Q3OWRzRVSS9w&oe=6A86E7B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwQXfEQ-dvoQ7kNvwFjZ--4&_nc_oc=AdozRsB5gXrwWwVnw5tcP_6ogQoMJ9r1fhQoJNjwK2TjxeJzsH4O5MsTd5daxo0gNhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyt1aXoQDlMBgLdM31f5K_nwUlAOlNtnO1rALyVsOZdA&oe=6A86EBA0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMa2IEPns6IQ7kNvwHwts1v&_nc_oc=Adrqo_-N3n1WImdLpzjqmLqcjbxsOB9P7IrD1VnzsaMTknKDApkVjjmQBDaAkZKpky0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDATkWV5_ocQYS9OP7B0gUpdDueymf8cxT_VigQIA_hA&oe=6A86D861"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyr1J9ePysgQ7kNvwERPZpy&_nc_oc=AdqpZUDlWy7Ha_IbN8Z8wEl3YqTesemUDdYf0RJdEL417dVNtNlTYgxFrzuCyARjf0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKORtX6QouwTxUxFZ-upKux5i1MCsj__oFbn88WtaOuQ&oe=6A86D88C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
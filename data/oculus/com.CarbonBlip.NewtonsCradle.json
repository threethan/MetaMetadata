c_ohc=icuz-F6IPpsQ7kNvwGp1Dlf&_nc_oc=Adrt0BZ-nWCuuQitYvDzFoqPsbWmL12yOjQM5VwUZq-o1r7PFvddtwIZCsWEDWgQjiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6HIJBJYAsJYg6ewO94CW_lYOhaq36bPWdnoLyMHm2FA&oe=6A50FD82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fh7QxJfYOecQ7kNvwGR-MNf&_nc_oc=AdrOMMCGBP363ANlazY7cCXPe2rYu-ttXL3i1Q0nGyOpgjOwLiclM4fy1XYtwMZT2Jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKOCL0fTOmlCTJN42Uh4UCdZN3eQbhOt4j_-YGtY4Plg&oe=6A511272"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC2JXhXMVD4Q7kNvwGtbHqF&_nc_oc=AdpFqzlN3eMoLi6t-sIjn_01U1OXGSJGAwQQZoWS03_7AiAamjvWKJZEWsLNT80qam8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuvqs9ebF4zFDiTmbx9R0dZS-ZkVcFfhlWyGul4CBI0Q&oe=6A511660"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwxVph2qCX4Q7kNvwGeXcB6&_nc_oc=AdrS_6OceJ5fGtwqsCiWKpm9doYW30OnTS0CSH0hf9yIJg6YDsA5ouduI2i9fri6kI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHrJAb0vtMfReYpMGLVLdgnZKQSUktzbZQeVrt5FhWgw&oe=6A510321"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC_vE2t0MeQQ7kNvwEKHbya&_nc_oc=Adq0DsIv3VjXJTt1LxLqBmUo7TgpBU3I2tu3cYiSylwZk8xTDU3J2IF0BHm6MC13dog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj86c8HX_uKj-pidhROlTrgBEh7srrqLC5aubIgn6H3Q&oe=6A51034C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
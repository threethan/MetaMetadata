c_ohc=56V1dWWEaKgQ7kNvwE2rBOP&_nc_oc=AdqVkrjVeah8tHuiLiWsLQiUdBOZ6faTz3qQ8LuVLxhxHq7iw_zIcFO60H8Frlclycc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICvTCfe8QE7RJ1P24SvFasnF3QdUkzmva0859MoVyQhg&oe=6AA55D82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxOrogq0M1kQ7kNvwFOfBAy&_nc_oc=AdrG51m4EuLgJYqXwPR6qXNSNDJbwd1dix2mcFllRRka1HQKWvuuyTJ6tGnnIE4n-Kg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLcqhfu78wEVaveFE6J_tiB7ptwf5Cj2kBUONWzZ1_SQ&oe=6AA57272"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRRCP9otM2MQ7kNvwE21h-f&_nc_oc=AdrW31siwhs998JUqDhGDmHbQbR_2JtFRPP9sHSTPe0D-FVo_M7FCm_d49i3elyu_ZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAGVGVbuomH43YroohLhmUKewkQonnY7AcmVdIt_OmoA&oe=6AA57660"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndsHiuDFlJ4Q7kNvwEMZ6be&_nc_oc=AdogWnUrIsqXB7jgEejPhusmTMe2yS2ifPtnjIEbdXC-sR_m86C4ITMGMGnRIbh9d8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZgqUNjO6amGnB6Y7GgCDVIIcegUD-fSylzD57vOz5jA&oe=6AA56321"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeFt0_q67dgQ7kNvwFhNu-M&_nc_oc=AdrSAgD_HNQnU5BH0-h89CPrgkrxrN_nBi42b13MRyimY_K1Jly3Cg1kqQD_s2PfPnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI325euzLoviVyXjG4Xb4G1lx6OhLZlTzkpvVg8Ox6q0w&oe=6AA5634C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=rAeNL4NvsO8Q7kNvwErn1CK&_nc_oc=Ado7Zuos2qk1GSGuGzi0hx8W3CIyxVjVALON_tEh8hg9RlRQCHFy-vvGAKmdp1cImyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFauo8bFqIF0LpLIxEFLC5Ipul6N9_kgt-jHfem6bU0w&oe=6AB52F82"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6ANrl94PngQ7kNvwFgfy55&_nc_oc=Adq9UxP9fcXmTf7gLDqD9i_JqVBwWE0EDX6lMG0uXvXJGQuwwsiYn2oy9nuJDInjw4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYsu8RFwmbH93O6NUmuFZmMxcaXUQ2_sioe-7gqhxOKQ&oe=6AB54472"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD-Y6psbJbgQ7kNvwEBo2bK&_nc_oc=AdrU6ta06mtiKT8Hc0hA1Ppj4FwiZ8XVLBeKggE5uuMY_Ap1pt6Tp_7WWnPoiA7btfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIoYQqaVyEdHbXBO47Kbj1ysYQGP7taoohBqE8P5-ZLQ&oe=6AB54860"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JH7tDbGVBoQ7kNvwEqHq-r&_nc_oc=AdoNYE0bTTKMvHe20MCwRHcSxmbvJwDEJacv-gO3zUGUM2QR-hcE8eBLvg7m2O9c2KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcdJu-uYtlV1eeAmhyS1LS7oKetOkOtXzeTgGgSu5LCA&oe=6AB53521"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo3ytwvG0_gQ7kNvwFgV2Vh&_nc_oc=AdpQCt2iwzbAuJgJAdGlDJiNySMyMLO5-q3lywDAdts4mtq6htOJen0Y2t7i9JoZUpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo9MSkNRxvAzFYtoflvElJcT_ccOkF0z9W3Tgb7YqIdQ&oe=6AB5354C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_ohc=Tub3R-xKbZgQ7kNvwFpl5ps&_nc_oc=AdroFi-kgpUni59rXYgpgKYUCW7D0Ia78JyFdBsjYTyZOPy2uQNoV-XTqw4VcMY39Kc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rM8JibExtSnzCavKIGfxbOvm2Lnf1jbTpHZb1t5Y_dA&oe=6A1AF002"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxTVtKsBu78Q7kNvwGtKn85&_nc_oc=AdpkPV_s4rNopEfM-aZsHekO6u0Wikk9Wb7b3fGwQNSLJF9uN3rEpLuQgAvPR5RfXT8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zoFe0pfYWX7Er0jskiNLZFQEWePErXPO9AeaTukSzfA&oe=6A1B04F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIDkFowaUOoQ7kNvwHmXX8-&_nc_oc=AdpMm8Bld9IwtXl1jdI1NT_u1qIws6V0K6k5P4JAppUgLy0PbCulZQnrL3FbPu0XLnI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uXADYb2GRAkGZklxjdTzDwf_c8LnZRSoeKGR273dGGQ&oe=6A1B08E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Bw9aJ6M7MQ7kNvwHP5y73&_nc_oc=AdpFqLgEEmxhSQFOrx-lGqm5Ft6HnVCduxadR27fOhkjZ9zDh3k721UNo88-Q3OWo18&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58P0poKtxn_Q1acbscVORmA-659zDH6pF2mkhMYurHSw&oe=6A1AF5A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_ci3Wu14fgQ7kNvwHSDOur&_nc_oc=AdqCKabOxQ0VBBC_sYNn0y1UOIETZ6YN9vh0GfrBqeOa1kbfZLm2rK-syDqET1hpIeM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pwrBtCRdrJmVTu-FILKHWQoB--ooyBEbPVWPlfaeZVw&oe=6A1AF5CC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
c_oc=Adl6AqsDNf3kjO0INDhI5UcadIjIN7ohmgPKkenpaiku1m7E66nuLAlrqeXyvsdJejA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8vAJ_aOJSYZQTr8J6cp_atMMVXi-HBVissnxleiflGA&oe=69BAB282"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlOR2-Hor6EQ7kNvwHB7CpA&_nc_oc=AdnX1BsJJeyXqNLh1lang2WWZb3ttbLrYD8XI1Ytt4hu-e2CQkMcQdyOcJX9LEYWW2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWrf8w8jHTAa0xJCgd-LpcEKFOjien7_H_2TVkv4hNSQ&oe=69BA8F32"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxiZ3ly9bTsQ7kNvwGsOEgE&_nc_oc=Adm4fpnMZ14uVYwCLOS4qSjYTEh_aTUGktUaq51HChg2OJtoYtAPuyYc5Pro8K1HtqU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzVtTzMPR7f465MVe55G-FlINbJXAaODkEKby70ZrlUw&oe=69BA9320"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIM_rvGHRz4Q7kNvwFTqdZR&_nc_oc=AdmqMwp5kka7M0JEXsAvbcAmtJ2515WYjp1VPb7YVP8V4YqTBz6PbJfpNYNFu6xvZv8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXC3rtH0epv5ARBE6fZqx5y0ChiqRAenOD5wYmrkQ1jA&oe=69BA7FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcxbf8BsClgQ7kNvwE2uCwo&_nc_oc=AdmvsgI9W3Ih7UcDmWULLif2lTbuYjiPxwMAZLAM683kffF76c1c0Bt4R0La3dzDQT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBwUcNwhrNmrRXvTUd9pdkJm8mu-QZ7qVItuR5SgDiTw&oe=69BA800C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3073694780960
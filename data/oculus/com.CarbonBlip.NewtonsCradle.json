c_ohc=W4Aw53RY5akQ7kNvwH5FVeW&_nc_oc=AdokvSgXTDB_n39Fe7IpnsguPRc6YmUrYNnkHas7SD8auOkOJXAq7fs0-u7YT8kD1Ys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiO7Cun773WRKnqHOMK-1rfmZf7y19tBe_EIO6-rOuGA&oe=6AD0DF02"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvZON0N3bFYQ7kNvwENGQO8&_nc_oc=AdpxNPpllxv4gKQKTKVjGDxk23RHjvFysalwhpuWnJ43W1oOKxNDb49H_Vj7FZBiNTA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlIbGCaZsfQdvORbJ9YfUucbRtf5MIwNJRfbX6Zlc9Kg&oe=6AD0F3F2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N7u3zoeP70Q7kNvwEH1eoR&_nc_oc=AdoeyHENdyHlOE74AOfqgP-6sxyQMIUyDEwypcY1omE4TacBSyKA6mZTAnhFcw5HFlI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2GG0ucAWmmPDClL59xnBw6bykE5xi12PBeFG4MMluXQ&oe=6AD0F7E0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-34F1drM9vwQ7kNvwHzr2M1&_nc_oc=AdrliE__k7oajCkM4BIrPMMV2RMWNAuyefSOkT7nSGLSmZV9c3bH6W_OuXNk-m9aUvk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCVjA3qt8qL-iXbRaxo1_YLzvRRZvWFs7Zuiu2CMNQzA&oe=6AD0E4A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307369478096069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974519_969103743868047_5478334009049180231_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJXiMmcELC8Q7kNvwHTsU8b&_nc_oc=AdpySZSlQV4Uo69UtROUKUjo5_xN5tF8uivnuzR6zIV-AHo-B_z-tOAosgoOH9jNCJY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&
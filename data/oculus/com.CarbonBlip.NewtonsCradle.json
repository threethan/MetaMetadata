&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfscUwzEdoZ1U-z_lhL7mcl0kW8v1Mb5YkJSt9ISy8IZpQ&oe=69A1A602"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlLiENo3bCcQ7kNvwE7ixjq&_nc_oc=Adm9ZTbmTxw4heHOO228cJ4TDhmbRFCv4IPQ-3FyFZarpVCLgbDxn_UgF6c5mgFPxHc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuvfnyUKrS3pKfAnrkW7HwgqhpgvRGzucAdu9L0rquZUw&oe=69A182B2"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sK1bWOLS4YQ7kNvwE1eU_S&_nc_oc=AdlzQGUgVgdtwm-4it-jOTpa-7kpmzITFpu9ajnn0jHC3KJ15zZ5VOHn4YPGCGGV2fg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvrGwNwEuv7WI92kgQ4CewI1FHZM65ThjEAftcQAdchtw&oe=69A186A0"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gec1mveDZ5UQ7kNvwH3f-uW&_nc_oc=Adk584WRf938E6w1ezDNQjozLf9V3xrxXDHxwEIjuIVRFta0mReS2L9nLisgkNBOFlM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvES2nUaraw5WToF2nqZqZ6xAo6MITv9YAGpPn4CYv7eg&oe=69A1ABA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRwsKGa4CcIQ7kNvwF36ITA&_nc_oc=AdlhfsVXzatVVFB_mzzGPJyBB4nxzjcOu0O79H07L0zHXQWPCbu3gvBCC0rHLva8Lxs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsBhge0qwX29OAnr6uYZkW8QzJBadRLjLJb21rm5s4iyw&oe=69A1ABCC"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307369478096069"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38
c_ohc=oD1u9sd4dJEQ7kNvwFbNhTa&_nc_oc=Adq7RpAUgPDr-xR_-QKR2DObi6vjX30Npn0UjJXvJqQitGJRn8HWSNqZ87MmXHYroJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEdqEaWE0AkxVViXTzdZEKfC8_ibI71rWWjy1FbAP2ow&oe=69CA8482"}, {"file_name": "nc_screenshot05.png", "id": "583808072792988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_583808076126321_3714546398104427843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwHnyvogrfAQ7kNvwF27cFh&_nc_oc=Adqpgy2rXak1n5FvK9VsCEb52XRXT4GKiZEcc5gAWhcJOW1SXmQ5zTkBvJkfU1uxrD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGB4xo1sd4iqdxZab_suMIzmRCOdPfU_jT-RQrpJM3uw&oe=69CA6132"}, {"file_name": "nc_screenshot03.png", "id": "1491983891168511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_1491983894501844_8720180809455563005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jMgXNWo9-8Q7kNvwHaKt_O&_nc_oc=Adoyb_bUYrg7OYexTJBoZlcOo4iqxQn-x_s8nJiR1q7WXCThYQbPhfmHhsFMkMdjxqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiwcwlnWJLJfR121yUhx-0h0MnRiGd_F5rRSbhosErzA&oe=69CA6520"}, {"file_name": "nc_screenshot04.png", "id": "1720787304782393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974453_1720787308115726_6761797374087610772_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDm-AsEmX1YQ7kNvwHPJzw1&_nc_oc=Adr1w7LV2sS_Hi7PBf1eUBl0dCkOxFySuygGhNOi40qzVlIha317DwFpJQnv2ML79jA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1x_o8mW9NQvxKoyjdSnd5zUkCSRC6q8ygglX6ZS_0iA&oe=69CA8A21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art.png", "id": "363462395460148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_363462398793481_5485136492560721182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7niazTKNeGEQ7kNvwGOC3f2&_nc_oc=AdrYt-11nv3-D3n-mwg3SrGwAgXXUKXvLqdT-Fb-1SUTkhhEKOCq_5ydCj6NEIwzjNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ47ElcXWH2y_XrQkmNTHXPhThP-ZDEEIsLQT9BFnWmw&oe=69CA8A4C"}, "display_name": "Newton's Cradle", "keywords": [], "long_description": "The universe revolves at your command!  In Newton's Cradle, you create stylized planets, stars and black holes.  When you set objects loose into space they orbit around each-other governed by the laws of Newtonian gravity.   \n\nRelax in a cosmic snow-globe of your own creation, or study complex systems of many stars.  \nCustomize the size and appearance of each object you create.  Set their speed and angular momentum to create orbits of varying shapes, then trace the curved paths your heavenly bodies take through space.  \nStop time to set up the perfect initial conditions.  Speed up time to watch your cosmos evolve quickly, or rewind the clock and retrace its steps.   \nMove through space in any direction to observe your creations from any angle.\nSet your stars in motion in Newton's Cradle!", "short_description": "Create planets and set them in motion in a realistic orbital physics sandbox!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.carbonblip.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carbon Blip", "support_website_url": null, "website_url": "https://www.carbonblip.com/newtonscradle", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SPACE_UNIVERSE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inter
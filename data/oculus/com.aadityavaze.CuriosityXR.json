_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txSOB0OG8Q0Q7kNvwH-I61-&_nc_oc=Adn8GwUgh5kzPTAA-HvnRZNvftHSCSRrx1liqGAod58bk8rZFc-m_poWnxyhfkFUcos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFdOMP5z1LFrDLbj41jqotiv1Iiz8H7-sxRhg5_Q0r4A&oe=69B2C57F"}]}, "id": "1139861104682028", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYnkFbkiUhEQ7kNvwEnuyTe&_nc_oc=AdnhNUbDLmKLiJHVDrJNIWzyIdA4hgg6c8oUWHC4vNb3QlgA4fofOBh7qXIo9x2EtNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPBaOvrPX89vZWElfRbJOwZaFrGr7H9LIjKEC-g0lA-A&oe=69B2D0A7"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6roOe70lceMQ7kNvwEzqPe4&_nc_oc=AdnngJPBlxMcB07Qt5lTTGSdTZ-cswMDUokEgXHFVjITKncQs6UrF7cqJb9PlhAKMMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afze7AGy0NNMDL4mGvAAO4hX5GcpeJBxwgjBNcEJqtawMg&oe=69B2CC81"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k-MBV0MTtcQ7kNvwEX8db2&_nc_oc=AdliKV_NzdBb0niopjz8AvE8GryMDoW0XCyFTYd5cJn3Zm7Mw7NUNPid81yllLLbvUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzULaiNyJCUXGzlXEYBTpIOpVem2OiaYvYvZ97z57mj_g&oe=69B2C11B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYihsbF1BTwQ7kNvwFLqVmk&_nc_oc=AdkE89lAiKP7ODCDcfmdiySH5G93xYEo9Au5mp8Y76CMn8rjCsinOaFjgnHKMREB6vo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEJUwYz7MBAo2q3BHz5WhvKmrH5AMtH3VeB84OWiRRzg&oe=69B2BDC2"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZUVvIlQ9u4Q7kNvwHw7ejk&_nc_oc=Adle0RKu4obAL0-HZwbOkkB4OEobxaOYeGjK8gIN8Iu3kcEEWPtEXugGAjIxCt8T5mI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyS7Qv26msOJGi3VlAKXSdOTodY_H3WhQSMEKruscdXyQ&oe=69B2C88D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsH-L0Ta9RcQ7kNvwGH_7sS&_nc_oc=Admrs1SYleUU3zWRyIDurPTY8viw2mudOMHh-GtWo2QTvtS38MYXI0-aj1TtQJH_hCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4kK1onp3rKKzR6ZtLJO42PiezQf0BQ2UZeI8nCpZ9XA&oe=69B2A373"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txSOB0OG8Q0Q7kNvwH-I61-&_nc_oc=Adn8GwUgh5kzPTAA-HvnRZNvftHSCSRrx1liqGAod58bk8rZFc-m_poWnxyhfkFUcos&_nc_zt=3&_nc_ht=sconten
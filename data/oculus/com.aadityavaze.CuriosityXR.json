ype": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llIbILzea2AQ7kNvwENz3WQ&_nc_oc=Adpf2vzAYTGeJpsU74irKooYMx9HHpiZgWNmS_5MJZhFkSOaH0jTDHE5zskxooucACI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_hGNL48PZPUCeyWWR7vL0Q2ZQDxh8jrktAVhvEa59wQ&oe=6AABF0FF"}]}, "id": "1067106645864651", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6KGWQ42jDgQ7kNvwGg6GbA&_nc_oc=AdpVUhJN0L5QR2nJ9aibGylcSgyZ9fNpKFrCW1uyPFCS3tgNNaCTP29R4Quv1vrHtXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxkiRQDxudZlLH37eK-hIKEFUGDUvm6gXLbiBehnpoLA&oe=6AABFC27"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaDTnITZOlsQ7kNvwHVBkLp&_nc_oc=AdomK6ZTnTSSpqxpA2zb_IsFsjIgBzYMcViKWlQwQJp7PdEF186dDUV6Oujmy0xfAi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_E8WTjss4UCrhgv5i1DfeDemtGTYWcLgf_WJxwQXsqA&oe=6AABF801"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eheVGiOFSkcQ7kNvwHDqpSR&_nc_oc=AdqExBEmAHquT67xdSgsetFMyfVLMXJ098F3iO5sVy0l_DHdbeI7SE7kCRdbvkUTrF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlRCsCKJbcBY0FcppaNR2maHda5M7LS3T9CuNwwfHUoA&oe=6AABEC9B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9zv0PXKNfYQ7kNvwEYhAri&_nc_oc=AdqjyzKsnlkpq3HzeIdloUv9787UdKQUOMVT4SYN9846cCh-mNDaLDoM7r7rArmEvUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO1WfBpAIoWDzDken-sd7Dthx75M-SdPggqhzl9ueKvQ&oe=6AABE942"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MUvSsiicT8Q7kNvwGAyUvN&_nc_oc=Adq-joYKZf-2n7XwOg0E3-zL10DJFz1PHRKXiIti6hkFTVAFMx7AFjhwEPlrD-CAH4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIES_mWJ3ogYDEh9uBWn1l3vhoe_5BXowI4-uzakjhCBA&oe=6AABF40D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5tAw1QSwwoQ7kNvwEarJkd&_nc_oc=Ado-AgilUFzb90e9AAI_D1x4TxN1CirZqz2OYHNODIGKkG9ZBybugKJ3kAElI5RLro0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWa7HC5ii-2LrjMATLM8Z4kJslae0XE0NS4DPfJfB04g&oe=6AAC0733"}, "display_name": "CuriosityXR: AI Tutor & 1M+ 3D Models", "keywords": ["learning", "AI", "education", "chatgpt", "science"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n- Human heart with labels and pathways\n- Solar system with planets you can grab\n- Volcano and plate tectonics\n- DNA, cell, mitosis, proteins\n- World maps and landforms\n\nHOW IT WORKS\nSpeak your question in plain language. The AI teacher answers out loud and places a matching model in front of you. Grab it, scale it, take it apart with hand tracking or Touch controllers. Ask a follow up. Each answer builds on the last.\n\nWHO IT IS FOR\nHomeschooling families, including parents of neurodivergent and autistic learners. Teachers who want a demonstration students can walk around. Students who want fast, visual help with a science topic.\n\nRESEARCH BACKED\nCuriosityXR is research backed. Our work on context aware mixed reality learning is published by IEEE.\n\nWORKS ON\nMeta Quest 3, Quest 3S, Quest 2, and Quest Pro. Hand tracking and Touch controllers. Color passthrough on Quest 3 and 3S puts models in your real room.\n\nOne time purchase. No subscription.", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question out loud. Watch the answer appear as 3D models you can grab, scale, and pull apart, with images and natural conversation.\n\nNo fixed lessons and no quizzes. Ask about the human heart, the solar system, volcanoes, DNA, world maps, or anything else, and it is built from a library of 1M+ 3D models.\n\nWorks on Quest 3, 3S, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37761382923506449"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
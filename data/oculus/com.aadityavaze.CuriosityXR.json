_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iqm1xD45JsQ7kNvwFqR_F6&_nc_oc=AdkU5kSngVUx8yUcFe2RYAEkcnjSfCuJQkb-eXPkg7GBAIhpBFI6jy8tdEz-kGOYsgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9H4r6s0OESF5-1QJ8mi4UsiZ79uOsJBilV6Piljn6Cw&oe=69B5687F"}]}, "id": "1139861104682028", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r40B0d1m_jkQ7kNvwHYgzqJ&_nc_oc=Adm-OhbuVAvwvaC2GvhD783Lq6Y-qH8-sArCLst7f-Tq64u-4cLet523PNojZjjGdDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3c--kvBUiKl8gfFDLr3RWIob4PT8hcZtRgr6qp5APJw&oe=69B53B67"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPiQ0vlJ-XcQ7kNvwFkp0Im&_nc_oc=AdkVp6vdEV4691SwVc6jOVgwYuyigAuW6hzalMyVgUnp1f6W3kytHQaNlgRsFk5-rl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz9dcsueJAZdusTs71wvaA2DVgktNA7Cg7GUSrPHh2uw&oe=69B56F81"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUG6fcvPv4oQ7kNvwHjaF1_&_nc_oc=AdmKp6F7T2K_Bp58E1A1XOCcdSO56L0kBcxajJXLakn3scej_dn8ArkheJRKAc5Yytw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6_MseNb3Un4s8vAaMKaP1V5YPf46AdZaHgAT7Txqi9A&oe=69B5641B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJztPS3PdCcQ7kNvwFtniSR&_nc_oc=AdlLQ9QnQnvmuiwSVmDeU8IpF5kJ3l0ZioAknneu8RX_xkeiVSjZzvQosLutFNQ7g-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyL-zYhBay-yVr-14d_VPgKijoC_dvjb9ptTckCgkLPw&oe=69B560C2"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a2e5ztA8jIQ7kNvwFmOGyj&_nc_oc=AdnrUclkyxkUCz3WXD8imQJc32Febul9-Ie0JsXh7aI-MNJ_mIGNUoTrQ1XURKhf_Wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8CtUram4eWY5FEaZnoKhotC8ZrPxOoPuWiNER2t0wWw&oe=69B56B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsH-L0Ta9RcQ7kNvwHAgcFw&_nc_oc=AdnT_Y6Mb930ZoiG_XGYZMWIR3ZTh63agAR3kcrWvmbXhRqmSrLgkDl8X6tu6-kSOEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9ejSx37wICSlW0c93Qmw1YeSyRTTVBslmsLXoWuge7Q&oe=69B54673"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Iqm1xD45JsQ7kNvwFqR_F6&_nc_oc=AdkU5kSngVUx8yUcFe2RYAEkcnjSfCuJQkb-eXPkg7GBAIhpBFI6jy8tdEz-kGOYsgs&_nc_zt=3&_nc_ht=sconten
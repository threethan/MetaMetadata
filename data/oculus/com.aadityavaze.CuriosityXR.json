&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3u5F-GkbTxoMDkHCAJ_XOpoK8nLefnC4NpA8B5xV0usQ&oe=69F0B442"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxCsyV3ejSMQ7kNvwF3ZDCB&_nc_oc=AdpgxRsoqPe8eZq1o6NYhPPRPqx5q8etjQKMMV5vX_9i8x7W61wh8yCZALJrmnHwMIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2YE_HEk5HsZtwLEwGKXmH3IwKrXiHVO7ua5MbVW3HwWw&oe=69F0BF0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsKnjdwBOhgQ7kNvwFEOZBR&_nc_oc=Adqb0dtAZoP87uuY5_NA4aQA6Xig6fIEwsWCCo6pztCuriglmtPvVsxLeibbyREYTiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0cRSudjD8x58fpIbFrQ5fgKLfdaFRLPZTzOs-bg_4H9g&oe=69F099F3"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYb4G45r8xQQ7kNvwEOauAH&_nc_oc=AdpYWznDSKWdt9339lWh2VlxvAdOWgtR67l6xAG9dA_aKLRQuq0ObpOhRqJ29WQaTgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0OXjzc9nXDToyRCfWXrPTQpPbWpdPXvJSPdf0S7WBtCg&oe=69F0BBFF"}, "is_concept": fal
f&oh=00_AQUYaId5blOekJAR55mY3xfSeOylI29c7ZQUrFBMQT5XOw&oe=6B0F1FCD"}, {"file_name": "Screenshot_2.png", "id": "1382063192609776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_1382063195943109_4773180700111256082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyEZutomzEkQ7kNvwGuQaPD&_nc_oc=AdqNMRSC5iHV35CNz610NfxBzo_EiciZAvRfsL3g-QKck2YWmi7PQT0-x1hTM0tlXYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZlWL6sGLeiHjjCfd7m371sLwtsnkkO9PSwDu74fHbnA&oe=6B0F12BD"}, {"file_name": "Screenshot_1.png", "id": "1292007644712195", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1292007648045528_8478201302205683131_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UitDdWQnQFgQ7kNvwHV3KTA&_nc_oc=AdoQxdqGC-kO4xGUq8efF20pD1Cn47Uu1ZQBGRlNTN8UkuOyfa80XobhAcdrOTUd_qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWb9YfDbW5367ZB1oX8-WM3UUOdX4g0CfK_MSzxwtAhOg&oe=6B0EF41E"}, {"file_name": "Screenshot_4.png", "id": "1201120524097278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_1201120527430611_4914775645249509048_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woJEYZnpbO4Q7kNvwHyLPdQ&_nc_oc=AdpMr-RLhWaHIahN2nyqwr8fvbZEhB_6OCrGmKgHQdvgJVfe8uYWBGrQvxXK432AsQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVR4ZIRLd_eRZBdhCSBr8EQmKBmFpxvX3guuPsvqchRvw&oe=6B0EF8FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curiosity XR", "keywords": [], "long_description": "Curiosity XR is an immersive educational application designed to enhance your learning experience through mixed-reality technology. Explore a variety of topics with a natural language interface and 3D objects that anchor to the real world. Curiosity XR features state-of-the-art  AI-generated lessons based on your interests and past learning experiences. With a gesture-based initiation and minimal lat
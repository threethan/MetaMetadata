a9HH8ZA3TLUPw&oe=6B071C5B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSf4iSvqkb0Q7kNvwEHR6Ea&_nc_oc=AdpDC8-RZ8NAa30BAPsytI-Mpuu_gLZNucVMsMy2iwcsfwKh0vVq-DDczBAekQ3A2w8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxBD5OWjhbMs72NNtiV0loo4jE4y0kpMF_sv0AkEeO2Q&oe=6B071902"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCslOvvBIEAQ7kNvwGxRFHb&_nc_oc=AdqpbNPhiBJMIbsaQkr2e9zEuFR-J3vz7xcgOJnCh6plIyh7OixaJ2l17yl-OFTTPTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5XaCE58ObUuiKB-qDbufD2ugcVS4W4fXPmoVUm5E5kA&oe=6B0723CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMaH0_UfUEYQ7kNvwHULejh&_nc_oc=Ado3xchjJA2dQtqM-KSfy7Rsxwh5FA4fGteEZL_2NmZmXdrcJKYEZhmtRryQkWEfOQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHUCVNHCM4gs_ZCvcjzjn_WS1d3CV-SiG4OZqbEhPqrA&oe=6B06FEB3"}, "display_name": "CuriosityXR: AI Tutor & 1M+ 3D Models", "keywords": ["learning", "AI", "education", "chatgpt", "science"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n- Human heart with labels and pathways\n- Solar system with planets you can grab\n- Volcano and plate tectonics\n- DNA, cell, mitosis, proteins\n- World maps and landforms\n\nHOW IT WORKS\nSpeak your question in plain language. The AI teacher answers out loud and places a matching model in front of you. Grab it, scale it, take it apart with hand tracking or Touch controllers. Ask a follow up. Each answer builds on the last.\n\nWHO IT IS FOR\nHomeschooling families, including parents of neurodivergent and autistic learners. Teachers who want a demonstration students can walk around. Students who want fast, visual help with a science topic.\n\nRESEARCH BACKED\nCuriosityXR is research backed. Our work on context aware mixed reality learning is published by IEEE.\n\nWORKS ON\nMeta Quest 3, Quest 3S, Quest 2, and Quest Pro. Hand tracking and Touch controllers. Color passthrough on Quest 3 and 3S puts models in your real room.\n\nOne time purchase. No subscription.", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question out loud. Watch the answer appear as 3D models you can grab, scale, and pull apart, with images and natural conversation.\n\nNo fixed lessons and no quizzes. Ask about the human heart, the solar system, volcanoes, DNA, world maps, or anything else, and it is built from a library of 1M+ 3D models.\n\nWorks on Quest 3, 3S, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
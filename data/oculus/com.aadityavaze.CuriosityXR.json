_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDYTf3qWX8EQ7kNvwFYtv8T&_nc_oc=AdkOHCFZh0B5n4ZAJtVGJq523TPGTOxi2gPpqGmChwuR9EbD92NJ2Mo7eehhk9kt9tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKTWSSYWeCKlJUJV6HHTngZ8apPpiuVPml-Pmv4KWTkQ&oe=69BBFFFF"}]}, "id": "1139861104682028", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShZMJ9Kt-ikQ7kNvwH4DRuS&_nc_oc=AdnG_IhoaZS-aJH2IemighISYOJEhs8vSinLg9nq3Q6iGFUhErUS8T1VVK8htNBfKik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzUci0fQ7ZRnjLCAHL2TaYcDQ2lrV3urDy7VnVspqv8Q&oe=69BC0B27"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYIHqpYLoPIQ7kNvwF-5gQS&_nc_oc=AdmtxRoDytbD8Xd7t5x6aBGlwBJQpPSkTyxNSbBzmRO9TG0PbZgrSkGi-XgaR-aGWk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7fo4Yrv5vcNr2ZJze693nPhEAStOwAXNgxxNgmwJ7RQ&oe=69BC0701"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIQYKB2jCyUQ7kNvwFuHz93&_nc_oc=AdkyLbTmVZVTJqtiRvU5lrdBrn5yKmSil0przdV06yVf4GPh715K25P4Zcq6to7p_f0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxf1bKM1Pa8RghXdTCylIcX0trdiTQY7JmgxcF1t_0pzw&oe=69BBFB9B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJYMMyOv4NoQ7kNvwFjw5Z9&_nc_oc=AdmwWwRlk8ELbfK_4F9zpybjXyVTrGvJe8EoitvMlX2C43l6h6BhBJwN_Ser7E8o16A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWn4mLwp4nIVDdqAHsqzrXICsRshWxHC03nLxEc1Y-yA&oe=69BBF842"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQmIzRAK2VEQ7kNvwHUarcT&_nc_oc=Adnw4_8Mor_wdKEBAGmLX0qBVBptsT1-MDHVjRGXexxdAN65wCOohJdAhOyyeBlgvv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzxA58PKpHu-FiOq_MHaaSF88_NKw5qVU9Kwuci1DaMg&oe=69BC030D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBPK6JTUBMEQ7kNvwEESC5d&_nc_oc=AdlSo3apzZQRQKKfZVodTpw9GMWo-_r-iW4u0QGHC67g1ApXYblEai1hcjL_EJlxdWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt6ybiJGUuGnnLmoDyKskT_nF3JNRZIHYs5BWcYGGDYw&oe=69BBDDF3"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDYTf3qWX8EQ7kNvwFYtv8T&_nc_oc=AdkOHCFZh0B5n4ZAJtVGJq523TPGTOxi2gPpqGmChwuR9EbD92NJ2Mo7eehhk9kt9tc&_nc_zt=3&_nc_ht=sconten
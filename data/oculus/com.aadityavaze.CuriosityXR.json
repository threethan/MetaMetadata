f&oh=00_AQQYLluSonQ8vm_T06p5VA6gk2hdTGYA-7sgFo8JKcyeaQ&oe=6B09A18D"}, {"file_name": "Screenshot_2.png", "id": "1382063192609776", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974835_1382063195943109_4773180700111256082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhdeUy1bVPIQ7kNvwHuBRrz&_nc_oc=AdpyNRnFsZ8Wi-Dv7MLznWzw0OFrRMLvIDnfqLTFmxKUH_-3ddd1WHAH_0fAaM_EXnE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS0ZwcmOrO3tYSTA-cEa8h3uKgHhJAIamInUaPakqg8w&oe=6B09CCBD"}, {"file_name": "Screenshot_1.png", "id": "1292007644712195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974452_1292007648045528_8478201302205683131_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiuKwfMxbzAQ7kNvwGKJ6kO&_nc_oc=Adq9mr_Mw8ybPwWmxVOKx8wYLW_eJVijhLiq0O6tAQO4DVCZT7fDqanGKXK6qAZbUo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTQTQoHLPsAIuHZUbAbpvIK3JeJ_vPZaL9b0eR_LT-Qg&oe=6B09AE1E"}, {"file_name": "Screenshot_4.png", "id": "1201120524097278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974887_1201120527430611_4914775645249509048_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbC0spBTOJEQ7kNvwEf4w8p&_nc_oc=AdqA5aDxlWNRa7hM0cKCuFQLI0B5Xgg6SKqQZ0-FpWgnQwanLP9DsSpYyHNMm1mfbsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmPn6QQrRh3LkNC6V5ZbT9PYIrKESEK8Q9PyvK3LOPKA&oe=6B09B2FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curiosity XR", "keywords": [], "long_description": "Curiosity XR is an immersive educational application designed to enhance your learning experience through mixed-reality technology. Explore a variety of topics with a natural language interface and 3D objects that anchor to the real world. Curiosity XR features state-of-the-art  AI-generated lessons based on your interests and past learning experiences. With a gesture-based initiation and minimal latency, you can easily interact with the system and satisfy your curiosity. Learn through videos, images, and 3D models, all integrated into a mixed-reality environment that surrounds you. With Curiosity XR, learning has never been more engaging and fun. Available on Quest Pro headset for the best experience.", "short_description": "Tools to visualize and learn science, history, general knowledge, and mathematics concepts through a dynamic medium in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": null, "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3494096017535352"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "987919994222583"}, {"status": "PUBLISHED", "id": "926877323688839"}, {"status": "PUBLISHED", "id": "1222838949933932"}, {"status": "PUBLISHED", "id": "1208854001389207"}, {"status": "PUBLISHED", "id": "1519264795755052"}, {"status": "PUBLISHED", "id": "1801543450436388"}, {"status": "PUBLISHED", "id": "1039466931595470"}, {"status": "PUBLISHED", "id": "1182177206938378"}, {"status": "PUBLISHED", "id": "633806459134358"}, {"status": "PUBLISHED", "id": "581601481107970"}, {"status": "PUBLISHED", "id": "1727770764711340"}, {"status": "PUBLISHED", "id": "84574829107
BQ3eb-infZyFzSv6JPC4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARYN5vYGlAXNIqY4497YL_vIkjRVE5mXiL65UitobmFg&oe=6A4B9DDE"}, {"file_name": "Screenshot_4.png", "id": "1201120524097278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_1201120527430611_4914775645249509048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQgY4jNg0jsQ7kNvwEc5jOr&_nc_oc=AdqMOi3lEPsWNmo3fmcjiW_xu8CaxF-ecOSa4xBVci1tCabqxJVBkptOABBGTbch-as&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3u_H7f5ovhejUdJsUYQdKr7Te9X96F7zCSJISp97-BA&oe=6A4BA2BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curiosity XR", "keywords": [], "long_description": "Curiosity XR is an immersive educational application designed to enhance your learning experience through mixed-reality technology. Explore a variety of topics with a natural language interface and 3D objects that anchor to the real world. Curiosity XR features state-of-the-art  AI-generated lessons based on your interests and past learning experiences. With a gesture-based initiation and minimal latency, you can easily interact with the system and satisfy your curiosity. Learn through videos, images, and 3D models, all integrated into a mixed-reality environment that surrounds you. With Curiosity XR, learning has never been more engaging and fun. Available on Quest Pro headset for the best experience.", "short_description": "Tools to visualize and learn science, history, general knowledge, and mathematics concepts through a dynamic medium in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": null, "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
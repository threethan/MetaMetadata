_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LgbG2mH_l0Q7kNvwHHru7w&_nc_oc=AdomGllevQlfGYpzM-ymqxAjxy8NmknREZchAJRkyZf2n9kCUKX2gsKfTSAdW-5o8vY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxkb75VFvKxeDP2mgk6KPNhLzVLu5Zi5xOizfr94O2XTA&oe=69C145FF"}]}, "id": "1139861104682028", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFd9z4LJk48Q7kNvwHjXhNb&_nc_oc=AdrSoxjy7O5eIV5Y16_rxNKeGwHaNUvSbe5VS1F8NNNo6ePeFiOAsmblZgfNeFGXn1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz24Y9FcFSSC0wJlrBmCUQc3wlOdJxUH4nSiKkKUR5pgg&oe=69C15127"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLNBUODO-4wQ7kNvwGElJwf&_nc_oc=AdpZtNqtGbJCEzEp1aOgHpIHuPUDVhC4Fw8Dd34Sfb5IjRYiI9D98GpL7FHL1j2vpfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaVselxlLxIH6F5xLd93ITBQMNEGSYZNi3Q2z_MyGhIA&oe=69C14D01"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuwwRnDSeV0Q7kNvwF3bk8K&_nc_oc=Adpe5iWFVFTPW0CKII8dv9KhzO3MRSIv4ybNyAtV1-BGNhTplR9NLwt9P3bB4t8p8KU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwK1NrbNtbu1CmeE_B7WlGuotXlQWb2xsYmfPMNThj4DA&oe=69C1419B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YptSsE4A2xwQ7kNvwEa5Hnt&_nc_oc=Adq1xhyxmPWrF4dD75a2_3GmB9D1_YnQ9A70AILBLxIb2uCjM5syGbcaJTYgxMiK38c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_FpTElUDmUI3v2uSXcth_uw5QgrHIMgxcdHkoMl7Xgw&oe=69C13E42"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0odmdzPvH4EQ7kNvwFL5VjN&_nc_oc=Adoi9V9twp9DBDYOKDSltZU2KIEDRy8NfCAaO7VzkDqtXoJECULjEN8XWYwqB5FYiDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx33HHzcQ6V_4YounAVKFSeuJdXoDYbLYYrWLoV9aQDIg&oe=69C1490D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d3EdXvav4cQ7kNvwGm36Ce&_nc_oc=AdrTRm-yNlnKhMBpDJIoVYi-fUiWuwgzDR_ukmFm0gHkXPTUtrk55_NZsfnxkRY-7Ww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzt4tHzp7ZH12rZrLFNwuhYL7eqDtkkiKy8d7KTroMgNA&oe=69C123F3"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LgbG2mH_l0Q7kNvwHHru7w&_nc_oc=AdomGllevQlfGYpzM-ymqxAjxy8NmknREZchAJRkyZf2n9kCUKX2gsKfTSAdW-5o8vY&_nc_zt=3&_nc_ht=sconten
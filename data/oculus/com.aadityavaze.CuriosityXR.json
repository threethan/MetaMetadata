_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXkfCUXx-JsQ7kNvwEY3v9_&_nc_oc=Adl8nTkUVgQKUm5Lc2CbS6W6Ajx8uk2bx3vw5A4yr01tMUJsswj6hsjc90Xpr9zMWeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOFPYynmzCdqcczSYwFw8d90Qee0Ge3qEm9VZavSjOAA&oe=69AED0FF"}]}, "id": "1139861104682028", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "558782369936596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_558782376603262_6806600266660035470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhaA3b8yxi8Q7kNvwH2121z&_nc_oc=Admt7ZjPrhkR6cOkmk5Nyg8Z1fr1x_8kzs7wFAt6APiGH-ln9iNKX1tj3nQXDbNb5Xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq6Kpa3J8NfVaIBsFN38xsdt2XFpEMkr6ZcTTcnbxcdA&oe=69AEA3E7"}, {"file_name": "Screenshot_3.png", "id": "1274579813728228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404379_1274579817061561_3084945537521693626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkCfFme7lCMQ7kNvwHJ3rvP&_nc_oc=AdkYQh0x4NwY50VqM6HeYdMChwCSfBwr0srq8RNgxAYT5utOniIrgTYNtPzmYMucd3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmNr-xTjnnkPGKDT2rq48zyfnFAGCnO8JUl51nG0hzAw&oe=69AED801"}, {"file_name": "Screenshot_1.png", "id": "1023653402844663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984463_1023653406177996_4063568752596824769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tUbNuCQNGUQ7kNvwFBEY72&_nc_oc=AdmjUMHm4LCtSMcCQhxzolij3ubMEEfRSD_Vt1OUuO8xcIL2JGmc2uBXpycbjlNYR0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwai4NY2b2MoTOaKQQg3_Qz7grz3MyjkE35Mcps34Eebg&oe=69AECC9B"}, {"file_name": "Screenshot_2.png", "id": "1212828333316312", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_1212828336649645_3883228423013625112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqtkQGBz9HYQ7kNvwH53a9L&_nc_oc=AdkwrTskDV0rAYsst07W8-Tyc4jKhK1rQFcA68YFPp54nHyOY53jQvswia5St_wmnC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOYM4F83XAcjykAFWt4FJJ0Zj8cOvi0N4orRkmsfr_BQ&oe=69AEC942"}, {"file_name": "Screenshot_4.png", "id": "1065636734731860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566691_1065636738065193_4719573676480456932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqW8NFrP6_MQ7kNvwEQmVPJ&_nc_oc=AdlyfvqOr60GbcML2cqiitIHpDm0h-JKiUuNvBzy8rF1HXsBZSEVnCps1qKeC6VNOKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE8upMALwfBbK71FNZ_6fM5mavwsrqCEn1QBcu7qk2WQ&oe=69AED40D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape.png", "id": "2201904173649491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619704_2201904176982824_6043290239162422940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJMmb0B96swQ7kNvwGhw8ZN&_nc_oc=AdkxDTOQX1OU7hPx1qCp0euTWo1aTsablbJWfyAWLSjYmS0el8xGgYGR9Dz5k8KM2B0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwot7EvKYpUtBAMk2Sc_w6ktWGGaWeCeb0Y6f5Viy26UQ&oe=69AEAEF3"}, "display_name": "CuriosityXR | Interactive AI Learning", "keywords": ["learning", "AI", "education", "Chat", "LLM"], "long_description": "CuriosityXR brings an AI tutor into your room. You speak. It shows and explains. You learn by touching and moving 3D models.\n\nSome of the unlimited topics you can try:\n\u2022 Human heart with labels and pathways\n\u2022 Solar system with planets you can grab\n\u2022 Volcano and plate tectonics\n\u2022 DNA, cell, mitosis, proteins\n\u2022 World geography and country facts\n\u2022 Photos and diagrams that match the topic\n\nHow it helps\n\u2022 Clear answers you can see and hear\n\u2022 Short guided tasks that get you learning fast\n\u2022 Models that you can scale, rotate, and inspect\n\u2022 Voice or on screen controls\n\nGood for\n\u2022 Students who want quick science help\n\u2022 Parents who want hands on STEM learning at home\n\u2022 Teachers who want a simple demo in class\n\u2022 Anyone who learns better by seeing\n\nDevices and input\n\u2022 Quest 3S, Quest 3, Quest 2, Quest Pro\n\u2022 Hand tracking and Touch controllers", "short_description": "Learn in mixed reality with an AI teacher on your Quest. Ask a question. Watch answers appear as 3D models, images, and natural conversation. Try to get lessons on the human heart, solar system, volcanoes, DNA, and world maps or anything else with 1M+ 3D models.\n\n Use hands or controllers. Great for students, teachers, and curious minds. Works on Quest 3S, Quest 3, Quest 2, and Quest Pro."}]}, "developer_name": "Aaditya Vaze", "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": "https://curiosityxr.com/support", "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31166431176335023"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820953_826435839709898_1237659212490956456_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXkfCUXx-JsQ7kNvwEY3v9_&_nc_oc=Adl8nTkUVgQKUm5Lc2CbS6W6Ajx8uk2bx3vw5A4yr01tMUJsswj6hsjc90Xpr9zMWeA&_nc_zt=3&_nc_ht=sconten
ency, you can easily interact with the system and satisfy your curiosity. Learn through videos, images, and 3D models, all integrated into a mixed-reality environment that surrounds you. With Curiosity XR, learning has never been more engaging and fun. Available on Quest Pro headset for the best experience.", "short_description": "Tools to visualize and learn science, history, general knowledge, and mathematics concepts through a dynamic medium in Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiosityxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aaditya Vaze", "support_website_url": null, "website_url": "https://curiosityxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3494096017535352"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "987919994222583"}, {"status": "PUBLISHED", "id": "926877323688839"}, {"status": "PUBLISHED", "id": "1222838949933932"}, {"status": "PUBLISHED", "id": "1208854001389207"}, {"status": "PUBLISHED", "id": "1519264795755052"}, {"status": "PUBLISHED", "id": "1801543450436388"}, {"status": "PUBLISHED", "id": "1039466931595470"}, {"status": "PUBLISHED", "id": "1182177206938378"}, {"status": "PUBLISHED", "id": "633806459134358"}, {"status": "PUBLISHED", "id": "581601481107970"}, {"status": "PUBLISHED", "id": "1727770764711340"}, {"status": "PUBLISHED", "id": "84574829107
64659752124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630198_2577186362552498_3913228803140222976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJZV0TkzYZMQ7kNvwGojekM&_nc_oc=Ado5i25kVM5pGv9Y0iq67DdAGHB4_GdwtF51vSN8WgZLPDeQF1y7Yp8syd_OS6bZLt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKxfOs5iR_8FAOyKTGDgYSD5r_pvHFDddE0EwHp8_Q4A&oe=6ACFA41D"}, {"file_name": "migrated_image.png", "id": "561784124443343", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458099_2270787786557926_9182956901405556736_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LthCFA1fjywQ7kNvwF-VeUv&_nc_oc=AdoXaDr3oeu14kK-3F4-I_DPac-9uHDMG0EV0sbyiRSA2_vY-d7LwXWC6_XEGMihGFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSI4ymjhdF_RNnVgRAlOYls0SmfWy78AOq62aug13HjQ&oe=6ACFAD77"}, {"file_name": "migrated_image.png", "id": "224781318713799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_523290235257100_254597187336404992_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU2fbltimwYQ7kNvwEfeI-u&_nc_oc=AdoOSya_8zE9R4lBnKa1m95GJjn6NEAwVaQHBJRUfyRK4cxG9TYtQsFYhtrmsvXdKMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ_gRt4q1GRydL7DgW99tVuOjZGLic3uLa4LRiXjwC3w&oe=6ACF9B16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roller Coaster - Epic Bat Shooting Game", "keywords": ["Epic", "Roller", "Coaster", "Shooting", "Game"], "long_description": "Ready to experience the real adventure of Epic Roller Coaster with a new feature of bat shooting? Indulge in one of the most refined, immersive and energetic VR coasters you\u2019ve ever seen!\nIf you don\u2019t want to go for a most spooky adventure, then you can also enjoy the peaceful ride of Fantasy Roller Coaster! \nThere are 3 modes to have the fun of Epic Roller Coaster:\n1.\tSimple Peaceful Ride\n2.\tHaving Controls on Speed \n3.\tBat Shooting Mode\n\nIf you have any feedback, feel free to share. More and long
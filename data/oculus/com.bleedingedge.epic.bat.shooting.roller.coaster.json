64659752124", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75630198_2577186362552498_3913228803140222976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82xvS0sc2IIQ7kNvwGAS2U4&_nc_oc=AdoKps1-kvcPKLEedue8M_47LUIzTPY7H9AFDV647RtEQp8gImYgQZYIdq9hicjUsFI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLciQswvnw1HSet-sDd2wz7AHmNze5kfoIq44S5he2Vw&oe=6A972BDD"}, {"file_name": "migrated_image.png", "id": "561784124443343", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458099_2270787786557926_9182956901405556736_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r16jjRcBD5sQ7kNvwFVrvpm&_nc_oc=AdrwJbzIp64p7CQ-c04YT-BL3t1A4kyih3oYMMMhGv1HvPwm8tOw4CljCp4fGPrpL1U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBKgZBQc_vGlKt0qVpIMPEWoFiLSvHpYJPqeY28m7RFQ&oe=6A973537"}, {"file_name": "migrated_image.png", "id": "224781318713799", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031393_523290235257100_254597187336404992_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZm_BvLwry8Q7kNvwEteYMF&_nc_oc=Adr5PVA5bdactDsdls0C1qL3LmOEy0RkxtK3usV8U_OE4m6D_Es6-j2X5DddLpxfa9A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr_HI2P1frR5nWSLiJK6zxhsa6Lh36TjqUvL6oqgmBCg&oe=6A9722D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roller Coaster - Epic Bat Shooting Game", "keywords": ["Epic", "Roller", "Coaster", "Shooting", "Game"], "long_description": "Ready to experience the real adventure of Epic Roller Coaster with a new feature of bat shooting? Indulge in one of the most refined, immersive and energetic VR coasters you\u2019ve ever seen!\nIf you don\u2019t want to go for a most spooky adventure, then you can also enjoy the peaceful ride of Fantasy Roller Coaster! \nThere are 3 modes to have the fun of Epic Roller Coaster:\n1.\tSimple Peaceful Ride\n2.\tHaving Controls on Speed \n3.\tBat Shooting Mode\n\nIf you have any feedback, feel free to share. More and long
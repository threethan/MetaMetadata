 want to go for a most spooky adventure, then you can also enjoy the peaceful ride of Fantasy Roller Coaster! \nThere are 3 modes to have the fun of Epic Roller Coaster:\n1.\tSimple Peaceful Ride\n2.\tHaving Controls on Speed \n3.\tBat Shooting Mode\n\nIf you have any feedback, feel free to share. More and longer roller coasters to come!", "short_description": "Only 5% of people could survive in this thrilling roller coaster having bat shooting!\nTry your stamina here!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bleedingedge.studio/privacy-policy", "developer_terms_of_service_url": "https://www.bleedingedge.studio/privacy-policy.html", "publisher_name": "Bleeding Edge Studio", "support_website_url": null, "website_url": "https://www.bleedingedge.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3054063184737696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984458_694204307995536_6780012124807626752_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afD5T90ZmgwQ7kNvwF81Rb8&_nc_oc=AdoZZq3iO8ae5-6jKfiGKxg6b0MlRun6fUc4CGKbBsd9rOPhM59VJQK9fp6fN3dNjr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7vqtawjU5v6FLWiFrDxeVCIFW0esAVaUQfoJhyZplrA&oe=6B0B3209"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Roller
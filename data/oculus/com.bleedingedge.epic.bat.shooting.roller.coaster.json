": "Only 5% of people could survive in this thrilling roller coaster having bat shooting!\nTry your stamina here!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bleedingedge.studio/privacy-policy", "developer_terms_of_service_url": "https://www.bleedingedge.studio/privacy-policy.html", "publisher_name": "Bleeding Edge Studio", "support_website_url": null, "website_url": "https://www.bleedingedge.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3054063184737696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984458_694204307995536_6780012124807626752_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alh219VuoMkQ7kNvwGEGotw&_nc_oc=AdmUr-Z7E0t8BfS8RLgrEmx398KkCUgbLcY9XcqC0kCiCQFRkupT5g1ghiisc2L1GpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy38Z-iqtquBWUKqqy4TPEeQMtqv1JWDw4mKMV7UnugKg&oe=69AC1289"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Roller Coaster - Epic Bat Shooting Game", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1590080398, "lastRevision": {"nodes": [{"id": "198876191519203", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2751826864934523", "is_first_party": false, "enables_in_app_ads": fal
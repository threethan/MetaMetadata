ler", "Coaster", "Shooting", "Game"], "long_description": "Ready to experience the real adventure of Epic Roller Coaster with a new feature of bat shooting? Indulge in one of the most refined, immersive and energetic VR coasters you\u2019ve ever seen!\nIf you don\u2019t want to go for a most spooky adventure, then you can also enjoy the peaceful ride of Fantasy Roller Coaster! \nThere are 3 modes to have the fun of Epic Roller Coaster:\n1.\tSimple Peaceful Ride\n2.\tHaving Controls on Speed \n3.\tBat Shooting Mode\n\nIf you have any feedback, feel free to share. More and longer roller coasters to come!", "short_description": "Only 5% of people could survive in this thrilling roller coaster having bat shooting!\nTry your stamina here!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bleedingedge.studio/privacy-policy.html", "developer_terms_of_service_url": "https://www.bleedingedge.studio/privacy-policy.html", "publisher_name": "Bleeding Edge Studio", "support_website_url": null, "website_url": "https://www.bleedingedge.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355221356440721"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3054638611320012", "version": "1.1"}, "i
1_765354573190437_4504117233050966213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHfOSsQ9ilYQ7kNvwHou-iy&_nc_oc=AdnpSKR_jug8n5VBsibQ6Onz5Y1H4O-2VkQkd7XDrCH5dAu3NHpvepyCuaa-24sie5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCtOFGRDoPlmiPBjkP-26zhfYQvbv1RQ2LUVC1g-_tNg&oe=699EDF4F"}, {"file_name": "4 SC - Rougelike.png", "id": "2059753721441049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_2059753724774382_5770947754783579770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9NADd3IWdUQ7kNvwG4IbVb&_nc_oc=AdmCpEC7IBPPj6uCiH5pdGTjCUrvHPoai8HEnhZSm12NIdi3FAAfif9_u76WP03wG-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft4_wrB6AhoEBssVot2Od9dQm6_l74XXfvVojVwcARxGA&oe=699ECF00"}, {"file_name": "5 SC - Evolve.png", "id": "826558106673140", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823905_826558113339806_7111931470554025251_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd0fep5uTVIQ7kNvwHRxqxL&_nc_oc=AdnaPW-Jpf_NEoBVOkyerqjLdf-BU-UDavGZDAFFoNB0wanIWpT2dbrd5_3IOSQosSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGmH4Q3kX1_3pdGAP9bUzUxeCpS4QWZHKZuowmchpksA&oe=699ED23B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX2O3Jwb0V4Q7kNvwEmvwLR&_nc_oc=Admn3t2p9FecjykCnPduDnAmc0Pd1xalbhxSMJhFKWY5IHhmEsESJwbFUPJW1YuzeZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8kILikmjejMLoVxsOXpsCL4KV6jwJpMyDMYyApQpM5w&oe=699EE5CF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "Doom", "pla", "pix", "UG"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
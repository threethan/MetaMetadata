nc_oc=AdoKeBH_p69G-Gir7gFcdK_fMymGknyuzYawEgueHA05UZ9dTTC2peo8d3dRrfl4-aw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yeM5ZFy6ZEz9B8KA6R_qX6CW0eaiX77nSYb7oSlJsFA&oe=6A11BB29"}, {"file_name": "FightingDemons2_169.png", "id": "1754234412192277", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499321159_1754234415525610_5988566041440049605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlVExeqQGL0Q7kNvwEvZpOI&_nc_oc=AdoOceJR1UhPmWL0AXMSX-edvkp4kRQsoKwQReQxPQZ6V0YGInnRkgnboBj38wUoc_Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bEZtQyo82Q9TDvh8q6yMrTrBBFBNgK-n8Ph2sq61EBQ&oe=6A11B1D9"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK-vmRPP42QQ7kNvwHp85r8&_nc_oc=AdqF9_7McP2ITXastoTnzebxg7P9KGEaxUUOpqf2vYWsO80PI8Rb6MV1PobdHBXrVp0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sBFX7B1EQBG5mF777aHNn4LedkW7Wsj1RD9D6whDL8g&oe=6A11C474"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdQvO1zeAzsQ7kNvwGzeSOW&_nc_oc=AdolQa--dN2zFmu1NH9WzoUHwb1oFxYDL83cgy77SRjlk0PL5Q9tUzM91MhMRp0e_BM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79mRao028db82YQqPaRyC3hMU70nGR3hSCRYIgaSIQBQ&oe=6A11ABB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evpJelZklucQ7kNvwE_XUlQ&_nc_oc=AdqVx3Jl2cQdEZ9ei95QbpDcJq6Ezl14E7FY3jKj3IRFlEZE3HD5LM6t5WHBFjwlWiw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4chq2wN6ZJPFYi80lnmSqvOIkP1Scv8heAaMqeXEa1LA&oe=6A11AC18"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscrip
ng", "id": "851223160684667", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307430_851223164018000_111874341513309970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ95nA4RhIkQ7kNvwGCGcXb&_nc_oc=Adr36ynFhlPHzUG72pfG0Ntz-SbrFweLYWDdzm3CMjnLsWSPQanUZAawBlxHOwrKy3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOhPkZoC0vj6yoP1QzJeQ7uiD_d_nDV9zlb7iyTC1-2A&oe=69C53B79"}]}, "id": "1093051909316726", "locale": "en_US", "screenshots": [{"file_name": "FightingDemons_169.png", "id": "1619422902099415", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499325217_1619422905432748_2358029753832430639_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15WVaY8V37oQ7kNvwGjcPl1&_nc_oc=Adp-JsP0ASsXOJ4Ezvh2F2FiM4tMYwVfPZgPRD1-OtiL6ALVwA6ucFHB5X8obGx0P0Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTjb1TQzAOKAs4M2yDAYj-MC9q6cqZD2SM_oS1HYbtRQ&oe=69C52820"}, {"file_name": "SelectingPerks_169.png", "id": "1027843399311543", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499326914_1027843402644876_2779809017985292762_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4yKm17YLPQQ7kNvwEJabDp&_nc_oc=Adrz7IeR4n0i1DENVJuWjWXfFTciX9ni3nEslUrDwU-XMn_fYF5ft4dx3rHDmPdATEo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsuPA1bztz0BzWTDO00jNvVlCezAVrGGWX0jUDAw9UzQ&oe=69C54429"}, {"file_name": "FightingDemons2_169.png", "id": "1754234412192277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499321159_1754234415525610_5988566041440049605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiQeavnRD_IQ7kNvwHdkT0W&_nc_oc=Adry-M_qnmMsUwirTIFIupj5YHdRGbIxLWHr9SpRj5GpvNTVWfYRfr_oaC8TUXJPlmc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvzTXzadEGM7Av9f4dcYkm60Bb0xk8oL_Q5RIM1abZaw&oe=69C53AD9"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8RMRtyTyGAQ7kNvwFQGQ7U&_nc_oc=AdoObfTJulOVI2Lz2OCBfJCTQJpYuhXYEhcDuq3VTrnqA2lHjnL2EJbHMISfHRz06FU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBFA4LuL2-JS8tzZ4TTdWHfyDVD_arhlKJKBqBQLh5Zg&oe=69C51534"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99DHMDcFU-YQ7kNvwEpvBAp&_nc_oc=AdouCxtAq5HlSdzgIloZrDkGWJBTWMAQMdIhDjSkIOUy1I1x6BtAVOeuhcmdxBMeJag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI7oxyAsdJJveFB-vDrcUeTvWnwATPg4_0gdAr6l6rAQ&oe=69C534B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuar9B8t0Z8Q7kNvwEEpqFe&_nc_oc=AdqKFPnvGgokjLQ2kq12jZbjSMpQ0NxNQ877OkAJJLTInIj4-Bn7p-L9Fng60J5QBc0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3S8FEchhp1Iei_ztIEKXxa4FbpeWjUXKCyDvjxTgVLw&oe=69C53518"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24122052847419857"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1460865932336552"}, {"status": "PUBLISHED", "id": "1534000917832720"}, {"status": "PUBLISHED", "id": "2700333913643876"}, {"status": "CANCELLED", "id": "1518322402577839"}, {"status": "PUBLISHED", "id": "2594791524220022"}, {"status": "PUBLISH
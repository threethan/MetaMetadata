605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjvXxnwKvBsQ7kNvwEuGmu2&_nc_oc=AdlZ4UfnUfSawS2LRHl5Tv3-RoDq4rNvLiFFA0JZEzlc0pI1-LN8Z82flMqlvq3yTUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsWO4UjgW97ycYTVTMlpkBpl7Ken7Sc8SxcwEEPJMDOFg&oe=699C5C59"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS5KdwVzhx4Q7kNvwEpQYbX&_nc_oc=Adl5VslZBRme87zJ-BbuzNItLf7INNyQTWoqMoz6cF50yfu5X18y89P_WlP_qgC6ojo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuWmMMvG-EyK3YD5ebVlZVYeq6uiaGXqbcrjtHoAzHktw&oe=699C36B4"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN4K4Qwd5eYQ7kNvwGplb3S&_nc_oc=AdlSU4UwUnkUC8lX2PogOI5bzuBAjHOeymRy8Nheb9VrnDgRX78TRWSNHrmdKgQpmB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuTop6wSUdS-4ibJNtJCelzuKmsJvNdgZ89yqfeKBdRiQ&oe=699C5639"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y47qNNp_LbwQ7kNvwG3WNKL&_nc_oc=Adk4l9_zAOZE6a-4gCSyRQt3elgAr_w7N_J_iD0b9Hmat-OnNFpE-nB10rj61UMDets&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfteyxtcpXTtzNUdR8PhePadlS8qNgMUNaGK9IFAWOiONg&oe=699C5698"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
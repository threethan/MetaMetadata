uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXBq2u1_94UQ7kNvwHrKd0j&_nc_oc=AdpAM6TjujcVY-jzLNp1Zh4Rbzuppnn8hdjtQICXRuiKxjJmQZuwvYW1jv1Mp9k4-d8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0_wKB9_4WD1OV1RYbjitwU81APc1M16UE-NtooiJp1g&oe=69CFD224"}, {"file_name": "3 SC- upgrade.png", "id": "1089105139847913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302770_1089105146514579_4248858233085192791_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2grXCzHo1EQ7kNvwGsBwzV&_nc_oc=AdqQcLhi2RN1REmB29L_HHmuhC8tTGdyLcbbH4Vwp7F3lZbxe1oAhev3_io1EazSNVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7H391FOGielb8Y8Te-KBqFc9eI_IghcegQ5P2Ip9I5Q&oe=69CFB5AC"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzFBgUobliMQ7kNvwFVdRoI&_nc_oc=AdoGg31aoUwzaQetCv0VZmQEG-aUOz3ErdokquDLUCtxtFZt95KSxX3yagqexnGcoKQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRIwv7T6RyHSc4YPrZB8z6Fb8XIA_11p98gIc1Zk25FQ&oe=69CFB49C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIkmw13VDdYQ7kNvwFZofuV&_nc_oc=AdrEZ0owJh9A6X_3z0fkDMlZU31LD-Wl93L3rLbQMH9WkxWyRV7qkTHFFVkuTIXYYS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxmzy3KiYADANBUC0Ah-dN3hH9LkbnKcF5td50H3FQs4w&oe=69CFA81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crWmiatprBwQ7kNvwHaSqwi&_nc_oc=AdrWan5iUibGYBuBzdM_upeSYSHFCPl5Gi2r7PQuL_upctx_i03sKdmJqOyD0501DgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVAw1g5bOjn6brBcvjCreeOH6o2pa1CZ-70cqzWZnzTQ&oe=69CFAD4F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "devel
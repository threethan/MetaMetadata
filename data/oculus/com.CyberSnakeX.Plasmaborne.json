mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyax-gw7poYQ7kNvwHMkhsy&_nc_oc=AdpoPO_87csM5OCOSbj2PsMr5NkFruGpftiZys64dQOWWWtBpRvDHdXJW0Sk4ZoobVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RnYimNTpwDE9tEn1Fruh2MIAqDhEEmCDIOqcWJyZwug&oe=6A1AF7A4"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EMj1p_ad9IQ7kNvwETSlyQ&_nc_oc=AdoJBzLHsws3ukurp2MD_W7M92HReRieIMv5kBjb6DYsxecT2oiB3jBhFANQL9jnE-I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LXZxuEcS_l-pDj4_5HBpezW9otoI01HOzVtOYhE2CFA&oe=6A1ADA1C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Q2WsJ8c5kQ7kNvwH6pDPH&_nc_oc=AdpDb-gcOdZbEdnvp1kx5HXh2Tbhacxo0x7xckjVSAm3n0qxA_vRKSD7LOcSRuNIcrw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5La24ANGmjk_ekKsGR4fWR_YMFn3VNZXTCTFLv5DJz1Q&oe=6A1B05DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vsrj_LPNpMwQ7kNvwHLr94P&_nc_oc=AdoUekMEknP5ioIFXn_L8qCGyaTqnS9uAAIDGzdrJPq9HA45s9ncB3ihx3LK_lapeiM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J3fVUDMLWJ9wNHoO8pnTkzrv-_o-3-pH9LwInkUiFdA&oe=6A1AD2CF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
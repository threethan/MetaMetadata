4566523771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823901_765354573190437_4504117233050966213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHTRXHISw7gQ7kNvwEE1AUX&_nc_oc=Adl8HYMpLPSI6iuYUSEbLMabuQgD5ajXpAzEnJgtoI8InIa77JizncMuRT6eoHOqqRE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-dy8Bq30caLyw2sJJdjf4iXuM3VE9P846dNyHsfEihg&oe=69BA8ECF"}, {"file_name": "4 SC - Rougelike.png", "id": "2059753721441049", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822550_2059753724774382_5770947754783579770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WcH6Mvg1hkQ7kNvwGcV8SZ&_nc_oc=AdnxeVQUUUtM34xq4ouC1GgS5-a_uBrHQ6mxCHCD9_lJiuB-J0mFwigk4UiLXiYjQXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwOUx4RF-zZciFLDau5BwBpxAftpbujRACW4lg6vwuiA&oe=69BAB6C0"}, {"file_name": "5 SC - Evolve.png", "id": "826558106673140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823905_826558113339806_7111931470554025251_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j62R6-GDY0oQ7kNvwGMpPGe&_nc_oc=Adl97DhU5NhqcchZ2sasr6UXf7eCwPUl_zqp-VnIcAkFF8SJQd2pHhtKdzvhiYsT71s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyr2Zol_YnvnSILfbqOVLeaV6daxwMvi4MW64IqT-Lkrg&oe=69BA81BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE2brmGtX84Q7kNvwFgpi3S&_nc_oc=AdkNY1ghP70lBYEjseZ_BNQs9ypmzUulG31n4CZrPsUpvVao7ct_3MR1Xk4xP0EycEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtJpTGiQHAEcF4j2z2W9cDaGr6V6cBNu0rUNKAa2yMgQ&oe=69BA954F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "Doom", "pla", "pix", "UG"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIR
mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_pIA3Ox_oQ7kNvwEze3vI&_nc_oc=Adr7jJQAQiaufdZT-bzRvYC1VGP46603jH8X22t8o6jTdqonmHsNfyZGwhorABmuir8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YrQmJtCc02MUom2Qv-2Dh_aDT7NALsG4T8dWN_V2wJw&oe=6A340424"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3106DALp9MQ7kNvwH-3oFH&_nc_oc=Adr4oRdmx76tnR_tZ0Gbm89299wwVKLQ2qeELYcpz7nUL27iCWkn_X3S_Ei8Ese2E7g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zcOw0oLOCoFTAzGLMAfBuETMWqUueVuwKPuZGQs6JHA&oe=6A341EDC"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvBBzd4hD2gQ7kNvwHRFIeG&_nc_oc=Adrn-DyUbMNgTk3RsMPljDwKR-JCqck0FJ76Vzb3Rz5ri8MgrwIa93JK15maOcwC28s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C1QRgMXreS6B61a4poYq1KPf2WD2iH0Oy7VGCndyB7w&oe=6A34125D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNQSvTe7TYkQ7kNvwEIoLLM&_nc_oc=Adp3yLWaXfAYIXYYFfqHburlmElzp6pPSO4szWnNlBhcCvHclNuz8gQJaam8ke6z9XE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YqaEmV3SYRqFn4bQMdu_v89Q2roWHsDRnNzadzI2yRw&oe=6A34178F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
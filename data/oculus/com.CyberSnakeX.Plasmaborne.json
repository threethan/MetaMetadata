mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AKw-eswneoQ7kNvwFt23ZD&_nc_oc=AdqmJueXDGTloGEx7s5Nr77HUQMq_UvdSsvbAt5Aivs2X-kwaa-lop7A6UED5ZapOtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9erSCPWuwhA_IwtpbBgRRHMMin1sed9J-6pJDvR31p4Q&oe=6A316124"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86W26zYRCzoQ7kNvwG86dCg&_nc_oc=AdrRwLVBr78auk-BD1pbNd4imA1AfFv6xWhwVOkNTPw7D1HsRaHKlUTdH4cIQv3OMm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wz4Xz1tB3zXlB-HgzPobff2tcScxT8Xsr3bg6JFaGqg&oe=6A317BDC"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSn12dVWatUQ7kNvwFqMidf&_nc_oc=AdpKzEmvTkc7yM1aMC4HfXxxJM_nBPvurEr8oACjDICmLE-w-j6dpFLHI9njllPFgh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jJ8pDvsh2EtLd8wdkhh0tRR2SrppyC8iViFlNTTCKvw&oe=6A316F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUdzeLufTx4Q7kNvwHu8utv&_nc_oc=Adr9C3Va7EEjziiNcf3aAn1UWZ4hOzwpQH1HPPJUH8lLS0WLCivpvg0GgTN_oauzLFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XFZr3vRR8vgXCvW8nUHHxoO4OUmeF9AHyFYoyNBYUmw&oe=6A31748F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
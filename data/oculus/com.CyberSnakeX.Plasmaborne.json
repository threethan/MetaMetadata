mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj7wk5zLbV4Q7kNvwFfmaD4&_nc_oc=Adpu6muFqOc8eawbDVGmFFEHq-FcWp6sfx_nm3vEc4j_r6MyHDS3SZiF_m6h4MNhvTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G8I3bcwDuwOZ0X5_bwHXqMmEY2XcpcEk8tYbhKEDaXg&oe=6A3FE1A4"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkjngu06XtIQ7kNvwEYuddT&_nc_oc=AdrZs5yT6xzR6ICv9So-hvw6qhrfB1sKv4u3Qroe5KiRgIHaXn326EC4LQOeBMIw6x4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X_sfuOVskFPnSZivfLOl8-WXDnsKBT4HmTEgnzgwPiQ&oe=6A3FC41C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HytRTA4JhnUQ7kNvwHzBQIW&_nc_oc=AdrvygAfiGJUF-u1cjZChJIr7zCRf_BPw2S0czH2l5n2_sgVASo4-MVniunoeGupD9M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SVjAEctGniOv2_z6Mftg7qH6JZPdECu067IlILg1ZVQ&oe=6A3FEFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd3oE1HNOWEQ7kNvwEfERKq&_nc_oc=AdrL2tUhKMB9If1kZE8j8_3vPR-2ouiM4m-Gu3tNEQ10AZa0DcoU6iL-X0bpS66mF_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZJ0kYqN281hzRcauFX6yUPOxq0-rjxM2Dbcg2iNniGg&oe=6A3FBCCF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjvXxnwKvBsQ7kNvwEP3b7E&_nc_oc=AdlOZ01hPL28yxgfnmjNLQ8KskCX2n0JQRL5Rn7RBS0dMb9vhOtzH91f1dDVdDq25bw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afugj9zNaPy3ubMO6ZjBwM6aiaYTI1-U8tHjMY3M3o174Q&oe=699B0AD9"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS5KdwVzhx4Q7kNvwHprTYL&_nc_oc=AdnwxEJBu6qAfDqcg2xIyQqkuwSiy7QOdPrJkogHcCJ16s2VqK10RkJzAmcTY0ny0lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftEUxWz-3oo2OWN8r_rr5CUio-iw9900k1P_P47ab9d9A&oe=699AE534"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN4K4Qwd5eYQ7kNvwHhB7Mg&_nc_oc=Adl197pW7q1bd73GHJBDqdpmiGqzUZU57UOY2fv047kdPAxHlaw85zwZZulriN_Z_aw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvJ8_kfhSZY7nTI0v3AkYfiDKN4eAVNQ6Gz_jlgzkCZ5w&oe=699B04B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y47qNNp_LbwQ7kNvwEOGwPH&_nc_oc=Admp0yu-hytkkLN3lv42V-zyWiTFLK_FdLhfxuFfVMy_Nvp1ZWuNIoe350N-LqgcCbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftZJILrxJ-vZQoPuAyhgBqcmC8-KCBlMZ_x525OYgT-ng&oe=699B0518"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
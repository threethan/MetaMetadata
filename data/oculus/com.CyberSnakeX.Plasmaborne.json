Ee0drJbqnFh6Oy2UoiOuA&oe=69BC09A9"}, {"file_name": "FightingDemons2_169.png", "id": "1754234412192277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499321159_1754234415525610_5988566041440049605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAotKuYTyUQQ7kNvwHBTkde&_nc_oc=AdknA94GJTij7lJGfw0kptQA2Umwdcjt0wt_1MxrgLoMjxgHD5mOC_KK2MCrWW-03b0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1uT_wxyQImVuvmO6cNm_WFMDsHE-tjglSYkEdD9Wqxw&oe=69BC0059"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C29wtpZW_I4Q7kNvwHfdGmP&_nc_oc=Adk0sj2tCPeHmhZs9BGc7hI0eEijSaP0O3VSHTCEbymliuer_WQwXNZjC9N1xuPtzow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6PfzanIwsgECsKftCu7uaLFgeN3HVm4zSyi6cgJy1fA&oe=69BBDAB4"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_M6V8rFnHQQ7kNvwGiswYo&_nc_oc=AdlwNaE-HPbORB4GF1jeeanr_toQRC6JaglosrX_gORrgPcqtTrkCLOPoo6MhZpFdEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQ5H8ZvpT1fe0AdU4mLnL4HRwRwEOzBvFqiE4aJMIHig&oe=69BBFA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SikweV3EMt4Q7kNvwGYf0KC&_nc_oc=AdlvOl6jo5MHmThcePOiF5mYAmUntbOCAraFZR0DuPbjbBeIsxlfwEygULEtUgsM1DE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHfA4zWIFXrOywYUIyGpNjN3doI57xaRVDZuFLhZlsXw&oe=69BBFA98"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
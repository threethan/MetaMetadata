4566523771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823901_765354573190437_4504117233050966213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHTRXHISw7gQ7kNvwFEWxdF&_nc_oc=AdnvgSYz21gTNscijIjLqxAiWGfbLloDIwGnxj0mhmumq0Prsa_N-YG2leydG5fdnsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtAcpinyleMNWbc3c39UhoL6fV853ouwr9F8RoYqmH4A&oe=69B93D4F"}, {"file_name": "4 SC - Rougelike.png", "id": "2059753721441049", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_2059753724774382_5770947754783579770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WcH6Mvg1hkQ7kNvwHkA7ms&_nc_oc=Adm1qYcm9HEnQwbHfwwVbDQOZ6JeELDeWUs8Gp9dSZ8lGKP3GWvCOJfbFpTLcdM2RDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxa5Nlg-rMEnlXOSGrbxiF0zHwM6Bqr-RucYJU1-RHIJQ&oe=69B96540"}, {"file_name": "5 SC - Evolve.png", "id": "826558106673140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_826558113339806_7111931470554025251_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDvkwB56PIEQ7kNvwGI7ZM7&_nc_oc=Adl6nwcw5vcw61hsuStmRb_8xwcH6HmYCwpOxlwxbuneOOZHjtviTOJAPumGu36R-Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTCL8K8NjeIXkBkM4YLpslj3VS_-JlA-xzJcCrI73Edw&oe=69B9303B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE2brmGtX84Q7kNvwG-3LJ3&_nc_oc=Adl4GKLghOAVs-d8sCRLTv65FtuQauv28tz4pf9GhRtOZb7QZjYnFXdJbzdgN-uUHOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5e-F1JUtE5cPfL9GE7c1GfO2TPVPAXOfPE-JcMT8Jnw&oe=69B943CF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "Doom", "pla", "pix", "UG"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIR
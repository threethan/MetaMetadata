": "1169842101824068", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=770BTlZIPuAQ7kNvwEmVsQw&_nc_oc=AdqEltAhXj8EXBTBUeM_KP4PPn6HwtXxJz5UXYmfw9TYQTY1M8aPgWb6_5rI5JhEAiw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFcNoSrvkcd868kW01J9robeKQksZaipt47QNo6kPgg&oe=6A903BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PisT_ZnQaYQ7kNvwE-5I7Z&_nc_oc=AdrlqhL1elXZm7VyGGr53uSna6F0-IYpg4i-uU5dcwrlgXhhL3Glq5FPFRbEVWGn2XU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnekv9C8wLu2k-xaHTupj-q6T80bocfdHfw-TLg_ofrg&oe=6A903C18"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24122052847419857"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1928643384479544"}, {"status": "PUBLISHED", "id": "1347402786768337"}, {"status": "PUBLISHED", "id": "999151959566975"}, {"status": "PUBLISHED", "id": "1932952600713654"}, {"status": "PUBLISHED", "id": "960714556681642"}, {"status": "PUBLISHED", "id": "1460865932336552"}, {"status": "PUBLISHED", "id": "1534000917832720"}, {"status": "PUBLISHED", "id": "2700333913643876"}, {"status": "CANCELLED", "id": "1518322402577839"}, {"status": "PUBLISHED", "id": "2594791524220022"}, {"status": "PUBLISHED", "id": "1495468588313144"}, {"status": "PUBLISHED", "id": "742690515332870"}, {"status
mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Cws6l5DekQ7kNvwFROKlX&_nc_oc=Adq8YnmCVQLZT_QVIa6efDuaZ-v_75slPyQ3fyX_TRqvZ4L1bwxQI5AkSvg0NCwzt4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPPjdaqzJ3WuIqnyRhIawFanuk9OkycK9XSFChP65vIg&oe=6A4BBF24"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94f9vmgzOScQ7kNvwHpCCIP&_nc_oc=Adp2EAKoDfXNDivcRuqKyS4J-dsirE-E7QyO47dIEnJerZMTsWGUb5faIRYFxZsnZjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwOAVvl_Qlx3SdYSrTe6J-tSgOBHVNfWbmlzUUftXOQg&oe=6A4BA19C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogO-GrsSvYIQ7kNvwFMOwl1&_nc_oc=AdpRiSA9oWFp91fMv8IPgb-ZIhsLu5SfUFC9S_r9UsibcW4DoOa3yHw_a-yJR4hH1mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXRY1JOBsd0n4cARM1Ykyhkk8bzCB2EEslJa0X1BcEjg&oe=6A4BCD5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxcL6wns7-sQ7kNvwF88ZkL&_nc_oc=AdrmH8xTGOlJmqI8IduWczCcfmCB8m0VDYAYZ7HhO5cxKgjt9NQY_-CDEeULsgPr6_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEqXXxdhW14FCGXjq7GMYsFuwBEcjguKEbq2O35Xh2FA&oe=6A4BD28F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
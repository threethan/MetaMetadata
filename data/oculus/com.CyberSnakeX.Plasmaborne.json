1_765354573190437_4504117233050966213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma6_qoeqtqYQ7kNvwExEUx5&_nc_oc=AdnQ4UfQXluqNm6iGB3jBeEy97s2Dngp1wr7bouJ4WNQlqOFkpNVTjDTnm4xHtH5UXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmWrtXb7s-OI4Nb-S_36M7ATjqkQ4-yjGeDoG2EcBEZg&oe=69A6C84F"}, {"file_name": "4 SC - Rougelike.png", "id": "2059753721441049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_2059753724774382_5770947754783579770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj2uIhFJI6IQ7kNvwG8_UVp&_nc_oc=AdkOG3jMyazCD3xdC7eXlfY-D6QlctZzdMQqxXI2bFyj1VIuFyseZvoXyir0ri2xt0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudnC4TsAihw8UEWGzs1rxH7gsF6Dl87heSC5LdUQTFgA&oe=69A6F040"}, {"file_name": "5 SC - Evolve.png", "id": "826558106673140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_826558113339806_7111931470554025251_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm3PE_TVFhUQ7kNvwGqYnMO&_nc_oc=AdkX70Ns4qYNt6j3ApRITkiNYFmQz0J4DLn-WvpEV22zGO-iFGWDT6LKrkLrXaJtCCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftukE1DivmnJJU4F4x46pa-qgPB3eZo19LusSXXSx2QLw&oe=69A6BB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIlaahqkcb4Q7kNvwF3_kuh&_nc_oc=Adl9LhPoyVIq9rA5yq2mTDqAaX5lt8124FPyAeMiYNKDiUt2hgrRktgrsmSw4t92yzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftF43ls3Ay9nI3r2sN63nE24u6WZCAcMqvH4npQJ2tteg&oe=69A6CECF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "Doom", "pla", "pix", "UG"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Evolve with Every Death\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
Adq6Cz8sFwZeVJvNCD1L9HJyo1J4HRcsyS2y6ofrv4GFLlRsNnBu3be8ewejsDm9nrw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAD1XEKPVaCiUPh8bhfEBRzrXR-2Wd7DryTjgfsPlH7w&oe=6A4A6BA9"}, {"file_name": "FightingDemons2_169.png", "id": "1754234412192277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499321159_1754234415525610_5988566041440049605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8mB2hP18qcQ7kNvwF9273X&_nc_oc=AdrUCVTsdwmgtmyqCtB5_Gt3fss-8fEuhVjDbYxN1nHRLwr582hf5M6icKt-BOGt8CA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLI_S09TRYKPr6MWMOVEpmF_kRQ8n-CqQMl5ez-rPG3Q&oe=6A4A6259"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vWeLVsa8BQQ7kNvwFRUAuc&_nc_oc=AdrooY_kF7YUfDCwqRmFQV6gH9rKhPbPs5FG2aVSLuWgg6OfW_nUI3-Dp1IRm_tCEjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTxFHSo48gqmxnz9PAzr8SK3KNRTRIMJ_ydwdy7sVNMg&oe=6A4A74F4"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DprA89iPP_YQ7kNvwFgx3fE&_nc_oc=Adqt4wgXKdHO6_R7_zn9RfENE5mPuvg1i4TJaaRITc9gwPH2vaBynoUfR_6UXcgBNKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFbXroIoMejOEXNynB8Fc1K0DxOjxSxXX99UfRMnnzWg&oe=6A4A5C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfqMsPTwU2wQ7kNvwFZDlZi&_nc_oc=AdqzYUxw8nox0UN3ffVBn7pyQ-MPSpSu1vm-sd2dn2s1-O7FDPzjEUrrRU8rthUQLtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWQaRS0HrPzrSSCyJitJYszAPH6T9j5gmq5Zx0JtjdlA&oe=6A4A5C98"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": 
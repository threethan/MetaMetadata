605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pc2nV4VKPgQ7kNvwGw31BJ&_nc_oc=Admy-RVowtgBdcq8zcRqApdggIkQfvHQOj8-j2aC9_7BmDOs-wvH0JWls-f-p7Isrgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUX3ZROHB35OlKsrB75awjdfDWoq8LW1iuqJy6wU9Fbw&oe=699EFF59"}, {"file_name": "shot1Hub_169.png", "id": "721714186867274", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822349_721714190200607_5172845936169270657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8376rwj_sO8Q7kNvwErfCNG&_nc_oc=AdkjJ9Bwpl8yl3LS_gpzzx3kiGpmbwVA1elUDrpsagXbP1D5MKiJo3EgNdhWhJKSfxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuvZ12wPBP3vQGKjzBOjZZMJIeLt1A9T2S_CPbcqP3tKg&oe=699ED9B4"}, {"file_name": "shot2StartPerks_169.png", "id": "1169842101824068", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312417_1169842105157401_8830608537164499603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzw0iOo7tv8Q7kNvwEleEs_&_nc_oc=AdlsTUn_J8RezRnJH0EMSpaFmBIL-rX9C2G67D35fh84Mz708G3V-weG4j1EHQJuep4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftxJP2wFhxO7rThUH5BMsKo4z3Bs-LQACWxgLkE7on21Q&oe=699EF939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storeImage_16_9_rev5.png", "id": "1322084108858838", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300910_1322084112192171_5775743008516110172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOFLNvqlAdEQ7kNvwEchtA9&_nc_oc=AdnO9vsXTg5WnM8UPpweY8mLrI5h8TITYVeravfdKiRRDiLM7ZfZBnmBfJcMNkTnc0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsjWxrO-O2T3itqLwsFolGtOfo8pkTdPNX0evjkyPnIDg&oe=699EF998"}, "display_name": "Plasmaborne", "keywords": ["Roguelike", "Action", "Shooter", "Scifi", "FPS"], "long_description": "Plasmaborne is an intense VR action roguelike inspired by classics like DOOM and modern hits like Hades. Step into the role of a tech-warrior, battling through the forsaken lands where every encounter tests your reflexes, tactics, and grit. As you fight, strange patterns emerge\u2014hints of a deeper force behind the conflict, waiting to be uncovered by those who persevere.\nCarve your path through handcrafted battlefields packed with relentless enemies and ferocious action. Wield a brutal mix of futuristic guns, demonic melee weapons, and devastating magic. Between fights, upgrade your arsenal and unlock new abilities to forge your perfect build.\nDesigned for pure, fast-paced fun with deep replayability, Plasmaborne brings boomer-shooter intensity into VR with style and substance.\n Key Features:\n\u2022\tClassic shooter gameplay meets roguelike progression\n\u2022\tHandcrafted battlefields with varied layouts\n\u2022\tCombine guns, melee weapons, and magic for creative combat\n\u2022\tDeep upgrade system with evolving builds each run\n\u2022\tPolished, high-octane action with a focus on fun\n", "short_description": "Plasmaborne is a fast-paced VR action roguelike blending brutal shooter action, handcrafted battlefields, high-tech weapons, and demonic magic. Fight, upgrade, and repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": "https://cybersnake-x.com/", "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
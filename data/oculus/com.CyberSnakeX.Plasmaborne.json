: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGXHnWlwSZsQ7kNvwEkqtrC&_nc_oc=Ado--vZm9m69RCj0jPQl1ri671e4e-Z8cscKMm6EEoaBoGOQx9e5_OMYfpfReJauUTU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jnRlxGE0-BlUGy7Zd3_w7g5LWT2kzwemXQxMd7BEfxg&oe=69E63BA4"}, {"file_name": "3 SC- upgrade.png", "id": "1089105139847913", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499302770_1089105146514579_4248858233085192791_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXpuO3IB9ToQ7kNvwGWrXuO&_nc_oc=AdqE1eWIJCWP_SbR2yN1EqerC2B1iS6y5fEDJbDN2MPuQDC_sN4LSNgMBf5py43AeNs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vqtCqapFIVEylCXhdw9owuOTvQBasQ1HE5FFgWl5sxg&oe=69E61F2C"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoGhboZBHKEQ7kNvwEHD13Z&_nc_oc=Adp1MzGmi5elFeG_BoyVhMO-hd2y3-Cvbt_Q57CXRg2gOReyfGxb82Rw2YdwDB2wVLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3frkZmNwYRGnOf9zj0oGROGCcJFIoAkcUanbUXxUzcVQ&oe=69E61E1C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50kHq843m_EQ7kNvwEw8s7t&_nc_oc=AdrLB9oqcSj_fDJ11HsUIXEEM7ZIlPf2fOKqZ8vKLrYXAsuKgzo3BUrOPJWOy3lfaJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_MHtIiebpX4yb0QnP_T3O97h51C2QqUjHAYNC6IIvEA&oe=69E649DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvWrawWAhzwQ7kNvwG3uM9x&_nc_oc=AdrpHvUlDKuxLBKWsDJdsCLk4ETkUNsVWacqTeT-u5I97i5ozvYA-xUankcNN-X18eQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p4VRbj6cWi06tLMIrPj90TUTALO0uVQdGGjF6NorvQA&oe=69E616CF"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26992157773742669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307339_1505308187966119_2714312785867659111_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYDFaADQlugQ7kNvwFYUAjX&_nc_oc=AdolkE3NiK6EZrTlap8OFzFkM3w-2X7Ts2NUIy6FwgZodo-Sc8JwiJ0H60NKBeNaymc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OUrqWga7cAJToolKHXpgTukkIDSAcJVZtGYihOwLCLA&oe=69E61262"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plasmaborne", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1748362080, "lastRevision": {"nodes": [{"id": "24063797689912040", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_loca
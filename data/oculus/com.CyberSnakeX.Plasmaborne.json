mbat_v2.png", "id": "683890531448279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_683890534781612_1845730143550472367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqEk094rtjoQ7kNvwFgCco5&_nc_oc=AdqpZBZeMMPbIOhTYiaUO-qgXr9sa8PVL0MQZsUfh_3a6yzg-m4v8f-NrELovj_iLAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BbWKi7yO4olGQqxTErObm064cucBDTcE3COp64N1a5w&oe=6A203DA4"}, {"file_name": "Screen_03_Combat.png", "id": "910125081636304", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307326_910125084969637_8062525329240909942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSvyoICe3UIQ7kNvwHwU_NN&_nc_oc=AdpLPN8LbVLAfWK--cBR51s18qUZq4nJq0fgUuY9JJ6AjXHdqwUeJ9ma4eopH7QahnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m1gUuSy4_nyjwlTSOX_pcA87LtIHWnTLTgWWyB5yHNg&oe=6A20201C"}, {"file_name": "Screen_02_Combat.png", "id": "782108887855752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818849_782108891189085_1310893654474811832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ph2AEE2LokQ7kNvwEIMEv5&_nc_oc=Adq6BUMBRjgWPHr3pZlxD600iEn_Wv9wBvrRWC0SsVflPUyd3EpPBqIrBIUP6qtvags&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rcu1lzyU60H_i_-fehTBcbJRc4NNqtWoGktzpvfI8Mw&oe=6A204BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2692830891061149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_2692830894394482_8747474291273843826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muZKwBDZQTIQ7kNvwFespGe&_nc_oc=AdqihyXy4XUT9fhfml7fHn9WwtPSbbdFoSsN-Frt1EYboXZbJmcikmzTCm8oXRM4qxs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41KSSNgphsQaT0tsbhl1IyDL0hGFibsjDEyD0ETG4K8A&oe=6A20510F"}, "display_name": "Plasmaborne", "keywords": ["Shooter", "roguelike", "Hell", "Demons"], "long_description": "# Fast. Fluid. Ferocious\nDescend into the abyss and tear through handcrafted arenas where speed, precision, and raw power rule. Plasmaborne is a high-intensity single-player VR roguelike shooter built for players who crave momentum, mastery, and chaos.\n{2188548808336788}\n# Become Godlike!\nFall. Rise. Adapt. Collect upgrades, forge new builds, and return stronger than before. Each failure feeds progress, sharpening your instincts and unlocking new ways to fight.\n{747652215014871}\n# Dual-Wield Destruction\nBuild your own loadout, each hand with a powerful weapon and layer on passives that reshape your playstyle. Build your kit in the lobby, then unleash it in the arena. Every run becomes a different kind of chaos.\n{1178417621063675}\nFusing tight gunplay, brutal melee, and searing flamethrower chaos into one relentless VR combat experience.\n{1591134325586122}\n# Handcrafted Arenas. Infinite Replay\nEach battleground pushes fresh tactics and reactions. Learn enemy behaviors, chain stylish dashes, and ride perfect momentum through escalating challenges.\n\n", "short_description": "Plasmaborne is a fast, high-intensity VR roguelike shooter built for players who thrive on speed and precision. Tear through handcrafted arenas with dual-wielded weapons and powerful passives like swords, flamethrowers, and character augments. Build your loadout in the lobby, teleport-dash through escalating enemies, and unlock upgrades that transform every run. Built for full-motion VR, Plasmaborne delivers heavy recoil, crisp gunfeel, and endlessly replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybersnake-x.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cybersnake-X", "support_website_url": null, "website_url": "https://cybersnake-x.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"i
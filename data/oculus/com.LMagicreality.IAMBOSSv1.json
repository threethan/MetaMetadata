FkcL2g&_nc_oc=AdoLF9zVaA5-_eIZL3AvRhnm3ZyXPv2cfFlTpRtykQ0KyJEv0HRFIbo8ba2Z6V_xLFM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlFAhy8k25XNKH7glaWCLhkeqgpCf2nl3r_V48yojUBQ&oe=6AAEA7C5"}, {"file_name": "4.png", "id": "2788680407986627", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824611_2788680411319960_283484959740209410_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isf4tTdXfw4Q7kNvwHPLukT&_nc_oc=AdpC5AaviUY0gtZubkjVQ4y-5K5AlBUWQsP721mJ1YmdM892aVD-YbpuTJ9Jg3IoGKQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdb9x5i-zr7FspxJFjgAqAd8DSHqPt5r-AGDLiSTBlg&oe=6AAE83FC"}, {"file_name": "5.png", "id": "1267533445047462", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825052_1267533448380795_5191714511439474744_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCQr3u0d2PcQ7kNvwGdgk5X&_nc_oc=AdoR9hGOqApZBWZAucSlgd_VNmugzYx4xK0Mk4nMxPnF96H1l_bznbK-BvTUBWI_83k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEe-eAc8tlhz5uXwpF0UtDfwZvtL6CNGV7NJugSS0gHw&oe=6AAE83D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762logo_2560_1440\uff08\u4e0a\u4f20\u5546\u57ce\u4f7f\u7528\uff09.png", "id": "687535664330969", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308045_687535670997635_1649559633681764874_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P9vvleHIrMQ7kNvwFpVDlZ&_nc_oc=AdorxukzbfzFUMdaEPofs3oSW958YrGEvHjqZ_4WkMew6Q_At52QNtR5agt3lM-gv7U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvtno28bm-Z1MIWvNmZ-bLMfNmrsElzCPXfj2TppNamQ&oe=6AAE7DF8"}, "display_name": "I Am Boss", "keywords": ["iamboss", "boss", "simulation"], "long_description": " **Performance & Payroll**  \nAs the boss, your main job is to assign KPIs and pay your employees. Review the employee profiles displayed on your iPad and mark \u2705 or \u274c to determine their performance and salary. Use a variety of fun and flashy  items to spice things up and trigger hilarious employee reactions. And yes \u2014 you can even stash their paychecks into your personal little vault.\n{1067498525023166}\n**ITEMS**  \nHead to the store to purchase new items \ud83d\udca3 and make the game even more exciting! These items will bring you fresh experiences and unexpected fun. Enjoy the chaos!!!\n{1051981623815369}\n**LCK Recording Tool**  \nBuilt-in camera system\ud83c\udfa5 designed to meet players\u2019 creative needs, offering multiple viewing angles.  \n**Updates Mode & Community**  \n\"Office\" Mode and \"Bank\" Mode is deving \u2014 both completely free! If you have any suggestions or questions, feel free to join our Discord community \ud83d\udc49: https://discord.com/invite/qFH62yNHV9\n\n", "short_description": "In our game, you\u2019ll step into the shoes of a boss\u2014evaluating employee performance and handing out salaries. Use a variety of quirky tools to stir up fun and trigger hilarious reactions from your staff. Come join the chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ShiSuoGameStudio/IAmBossPrivacyPolicy/blob/main/I%20Am%20Boss%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "LMagic Reality Studio", "support_website_url": null, "website_url": "http://www.lmagicreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2407342288
ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbtAW6EddZUQ7kNvwFLxf5S&_nc_oc=AdrA-y9FNCj-Xr712n6b-wpZl-r45lXaSL6eLKm71au-JCCiYGK2tYS8B4WdTwnBoFQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRHghgT1kZsQy7EIcxtIUh2SHQiBRqb-xlt7e_PdxFGw&oe=6AFB20AF"}, {"file_name": "ss5.png", "id": "1499066721119727", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830032_1499066724453060_6403183817872233990_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BvnybiO9MkQ7kNvwF4X73e&_nc_oc=Adpvyy40SCetkgTcPHRVdGKFdf_8kS2Mf5wcHNc6Xg9e70GvhC4wBSFwoU1wwOxucTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqJ9FluwX_Y7vQEEAs95en_SkexhUPaGC_f0DrjR7nBw&oe=6AFB20DB"}, {"file_name": "ss3.png", "id": "1268228201316616", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304053_1268228204649949_8083415372212641726_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LNKp4GBe6cQ7kNvwG7rYXw&_nc_oc=AdroJ5x-4oSJ2vMhD38DVpXUrrqgGsvh4F6uPVFxbLJY45r6H2GdSzLkNYn4Lnl7wrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfWJIC3asP5QE-rzTDdDRt1ol1Er61m2M4uwwak9ZwQQ&oe=6AFB4B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visutate", "keywords": ["relaxation", "sleep", "mindfulness", "meditation", "anxiety"], "long_description": "# Visutate: Relaxing Experiences\n\nRelax, mindfulness, sleep\n\n \n\nDiscover Visutate, your ultimate escape into interactive and immersive virtual worlds designed to help you relax, reduce stress, and improve overall well-being.\n\n \n\n**Why Choose Visutate?**\n\nRelax instantly anywhere, anytime. Immerse yourself in nature-inspired virtual worlds and calm down in just 4 minutes. Enjoy stunning visuals, soothing sounds, and guided breathing exercises for peace and mindfulness. Visutate is like Netflix for immersive wellness, designed to support your mental well-being.\n\n \n\n**Key Features:**\n\n \n\n**Immersive Virtual Worlds:** Explore breathtaking environments like underwater realms, peaceful forests, and open skies. Each world engages your senses and calms your mind.\n\n**Mindful Touching:** Interact what you see, bring it closer.\n\n**Relaxing Sounds:**  Enjoy soothing audio from gentle ocean waves to celestial music.\n\n**Guided Breathwork:** Follow a magical butterfly that guides your breathing to reduce anxiety.\n\n**Interactive Experiences**: Engage with butterflies, hummingbirds, and beautiful surroundings.\n\n \n\n**Why Visutate?**\n\n \n\nMore than just a mindfulness app, Visutate is your gateway to peace and relaxation. Experience mindfulness in an engaging, interactive, and beautifully immersive way. Invest in your mental well-being today!\n\nDownload Visutate now and begin your journey to immersive mindfulness and relaxation!", "short_description": "Relax instantly anywhere, anytime. Immerse yourself in nature-inspired virtual worlds and calm down in just 4 minutes. New experiences for you to try. Download now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visutate.com/en/privacy-policy", "developer_terms_of_service_url": "https://visutate.com/en/terms-and-conditions", "publisher_name": "Noderix Teknoloji Sanayi Ticaret AS", "support_website_url": "https://visutate.com/support", "website_url": "https://www.visutate.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
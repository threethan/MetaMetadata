8646115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619747_1856282411979448_7484147722439662906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CBfRSxiAfQQ7kNvwGhDGKs&_nc_oc=Adp5hHH6yfo5evCHwxeAIOoUdgk7ywPPnJnqxWoYzUfBAToL3_PhN1Wlp-2BHVv82yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7n6HnM2HV4sBD3Kv6gBsAt2WXQXEMG0iyXH-W15FBWg&oe=6AC654DE"}, {"file_name": "caretta-topaz-enhance.png", "id": "1125784262943448", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618884_1125784266276781_7649506586525398372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nwt13FqoRAQ7kNvwHMb58l&_nc_oc=AdpPn4YZ3mcu7JxDyUr4hpx6p0ZWVcLyikb3f-7MEFC9SEQxV85hFVJKHt9US5VgxIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFTW1j0EBQxF8XHYVRl5mwF8O5RPNL9u0OoeGF0ZcNOw&oe=6AC63FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover1.png", "id": "1082859323828748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1082859327162081_3431959789485833867_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGfEG0EufB4Q7kNvwEVbmCb&_nc_oc=AdrOlkwf49xAhtVsQFuun3B06hDqHlqeix_oymKLxzK5BuW-5F7Ue-xodOQMA9JYwRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkPxULzOhAxGUy92yHxDFV9rAiM3AAJuTPjqFsW_EKrw&oe=6AC66DBF"}, "display_name": "Visutate: Relax, Escape, Explore", "keywords": ["relaxation", "sleep", "mindfulness", "meditation", "anxiety"], "long_description": "**Step into breathtaking virtual sanctuaries designed for Meta Quest and feel stress melt away in just 4 minutes. No experience needed.**\n\n**\ud83d\ude30 RECOGNIZE THESE?**\n\n- 2 AM stress\n- Work overwhelm\n- Racing thoughts\n- Snapping at loved ones\n\n**\u2705 VISUTATE SOLVES ALL \u26a1 INSTANT STRESS RELIEF**\n\n- Feel calm in 4 minutes.\n- No meditation experience needed.\n-  Works on busy days.\n- Built for Meta Quest.\n\n**Transform any room into a calm sanctuary with the most immersive stress relief app.**\n\n**\ud83c\udf81 FREE START:** \n- One environment permanently free\n- 40-minute free session for new users\n- Launch Special: $3.99 for the first month\n\n**Why It Works:** Unlike audio-only apps, Visutate uses Meta Quest's spatial computing for true immersion. Step into virtual sanctuaries and your brain naturally shifts from stress to calm.\n\n**\ud83c\udf1f IMMERSIVE SANCTUARIES:** \n- Peaceful forests with interactive wildlife\n- Underwater realms with gentle currents\n- Celestial spaces with cosmic elements\n- Breathing exercises with butterflies\n- 360\u00b0 responsive environments\n\n\ud83d\udcb0**INVEST IN YOUR MENTAL HEALTH:** Visutate helps reduce stress-related problems\n\n**Perfect For:** \n- Morning mindfulness\n- Coffee break resets\n- Evening wind-down\n- Pre-sleep relaxation\n- Anxiety relief\n- Focus enhancement\n\n**Download FREE - feel the difference in 4 minutes.**", "short_description": "Feeling overwhelmed or anxious? Transform any room into a sanctuary of calm with Meta Quest's most immersive wellness experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visutate.com/en/privacy-policy", "developer_terms_of_service_url": "https://visutate.com/en/terms-and-conditions", "publisher_name": "Noderix Teknoloji Sanayi Ticaret AS", "support_website_url": "https://visutate.com/support", "website_url": "https://www.visutate.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_pl
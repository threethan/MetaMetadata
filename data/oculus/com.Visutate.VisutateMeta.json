zhJZmUsVzLAazg&oe=69B0001B"}, {"file_name": "ss3.png", "id": "1268228201316616", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304053_1268228204649949_8083415372212641726_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMkdxhms5R4Q7kNvwEkhVW7&_nc_oc=AdkD1p70Q0QFSo3beWUxK9fbddLAbmTViWo6y9unpG9xiGCTNxGByjlrSafuDW48A8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywCZncu7zOTI2LCnk5odGx6BguEW5o2U4bOTMWxJ0dPA&oe=69B02A8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Visutate", "keywords": ["relaxation", "sleep", "mindfulness", "meditation", "anxiety"], "long_description": "# Visutate: Relaxing Experiences\n\nRelax, mindfulness, sleep\n\n \n\nDiscover Visutate, your ultimate escape into interactive and immersive virtual worlds designed to help you relax, reduce stress, and improve overall well-being.\n\n \n\n**Why Choose Visutate?**\n\nRelax instantly anywhere, anytime. Immerse yourself in nature-inspired virtual worlds and calm down in just 4 minutes. Enjoy stunning visuals, soothing sounds, and guided breathing exercises for peace and mindfulness. Visutate is like Netflix for immersive wellness, designed to support your mental well-being.\n\n \n\n**Key Features:**\n\n \n\n**Immersive Virtual Worlds:** Explore breathtaking environments like underwater realms, peaceful forests, and open skies. Each world engages your senses and calms your mind.\n\n**Mindful Touching:** Interact what you see, bring it closer.\n\n**Relaxing Sounds:**  Enjoy soothing audio from gentle ocean waves to celestial music.\n\n**Guided Breathwork:** Follow a magical butterfly that guides your breathing to reduce anxiety.\n\n**Interactive Experiences**: Engage with butterflies, hummingbirds, and beautiful surroundings.\n\n \n\n**Why Visutate?**\n\n \n\nMore than just a mindfulness app, Visutate is your gateway to peace and relaxation. Experience mindfulness in an engaging, interactive, and beautifully immersive way. Invest in your mental well-being today!\n\nDownload Visutate now and begin your journey to immersive mindfulness and relaxation!", "short_description": "Relax instantly anywhere, anytime. Immerse yourself in nature-inspired virtual worlds and calm down in just 4 minutes. New experiences for you to try. Download now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visutate.com/en/privacy-policy", "developer_terms_of_service_url": "https://visutate.com/en/terms-and-conditions", "publisher_name": "Noderix Teknoloji Sanayi Ticaret AS", "support_website_url": "https://visutate.com/support", "website_url": "https://www.visutate.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24128518496741645"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "567382683051580"}, {"status": "PUBLISHED", "id": "1744744689747978"}]}, "baseline_offer": {"id": "567382683051580"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756990140, "status": "PUBLISHED", "id": "567382683051580"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25040661705527315", "version": "2.1.15"}, "id": "1069423491183591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
ience mindfulness in an engaging, interactive, and beautifully immersive way. Invest in your mental well-being today!\n\nDownload Visutate now and begin your journey to immersive mindfulness and relaxation!", "short_description": "Relax instantly anywhere, anytime. Immerse yourself in nature-inspired virtual worlds and calm down in just 4 minutes. New experiences for you to try. Download now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visutate.com/en/privacy-policy", "developer_terms_of_service_url": "https://visutate.com/en/terms-and-conditions", "publisher_name": "Noderix Teknoloji Sanayi Ticaret AS", "support_website_url": "https://visutate.com/support", "website_url": "https://www.visutate.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24128518496741645"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "567382683051580"}, {"status": "PUBLISHED", "id": "1744744689747978"}]}, "baseline_offer": {"id": "567382683051580"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756990140, "status": "PUBLISHED", "id": "567382683051580"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25040661705527315", "version": "2.1.15"}, "id": "1069423491183591", "channel_name": 
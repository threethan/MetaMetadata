_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqScqtdTAfOewW3bhaGum_Y0G4qya2jXHyNe1gV67fiw&oe=699D8D7C"}, {"file_name": "s5.png", "id": "868089051382606", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031462_868089054715939_4935544365236901930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMnr9cABu74Q7kNvwG7ROa_&_nc_oc=Adk8Gy5QfJU7DDzfqWbw-jK9vLGbefHGfCdRaVYkNqHEr71abqiSlDGYn11msTRhyaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthROOPAQHjUICROlIH-LqCyD_VPb7W4KkgrPXR9cx_4Q&oe=699D8FF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "852145366410491", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031486_852145369743824_4693346598210692709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9w6VRlu56kQ7kNvwGEK82x&_nc_oc=AdnDHz_65L4Pe1MFbaQZwEHocasTmDT9TbN0nugs_88v3L0cQVEkFPbdFZetDTXUl-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfILWrrzYP0dhyqzFbfwu3SnbcDF1sEBCRl5pEz1ggMQ&oe=699D9CA1"}, "display_name": "VR Rage Room", "keywords": [], "long_description": "Introducing our cutting-edge VR Rage Room Experience, a revolutionary way to let off steam and conquer stress in a completely immersive and controlled environment. Picture yourself stepping into a virtual world, equipped with a state-of-the-art headset that transports you to a realm where you have the power to unleash your frustrations like never before.\n\nOnce you're suited up, you'll have a virtual arsenal of tools at your disposal, from baseball bats to sledgehammers, allowing you to demolish a wide array of objects in your path. The satisfaction of each impact reverberates through the virtual world, creating an unparalleled sense of release.\n\nWhat sets our VR Rage Room apart is its ability to provide this cathartic experience without any of the real-world mess or safety concerns. You can let loose without worrying about cleanup or potential harm, allowing you to focus solely on the liberating sensation of release.\n\nWhether you're dealing with the pressures of a demanding job, the strains of daily life, or simply seeking an adrenaline-pumping adventure, our VR Rage Room is the ultimate solution. It offers a controlled, yet exhilarating outlet for pent-up energy and frustrations. You'll find yourself fully immersed in an environment designed to facilitate the therapeutic act of venting, leaving you refreshed, rejuvenated, and ready to face the world anew.", "short_description": "Experience a virtual Rage Room: don a headset, grab tools, and let off steam in a mess-free environment. Smash and shatter stress away!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/61b6455b-0d88-4260-993d-4766d5c0c188", "developer_terms_of_service_url": null, "publisher_name": "Render Island", "support_website_url": "https://www.render-island.com/contact-us", "website_url": "https://www.render-island.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8204991052941628"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "187947334285452"}]}, "baseline_offer": {"id": "187947334285452"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726719120, "status": "PUBLISHED", "id": "187947334285452"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5anVNzZF00Q7kNvwE9BVmM&_nc_oc=AdpGzV3KtU02LSA2GTjzrat7P5Uy4JiV6Kg-A5KAkQOOzI4DHjmbX9litKVUOOWVJtw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEAG0NcnV96Cx4n9DKD7GOCH38pqrHWyi4J7R1VbIHpg&oe=6AD3963C"}, {"file_name": "s5.png", "id": "868089051382606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031462_868089054715939_4935544365236901930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V20a9N_YNkQ7kNvwH338M-&_nc_oc=AdrCkW_I59hXWHmkpVu1t-m57kwnpbFnwFKDsQVO5jaHqXcRZ4Z7zh3pQLW3s_-nGI0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtgjZ6U-fQEousxTuM2-e8ACFTz1QcDh6CtrA4zNLMUA&oe=6AD398B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "852145366410491", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031486_852145369743824_4693346598210692709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFdXH_C0_SwQ7kNvwG_oANa&_nc_oc=Adpgi9W_P2AtVkP5wRnyNQO-m8Bv7K-Ik11UZj6KqXfE3am9IRTcQGa-eHcqIgqmM58&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoYFVS3BwhRdOfn3-_-Ag1kVOqIjMnrdsuph2tPLL-Hg&oe=6AD3A561"}, "display_name": "VR Rage Room", "keywords": [], "long_description": "Introducing our cutting-edge VR Rage Room Experience, a revolutionary way to let off steam and conquer stress in a completely immersive and controlled environment. Picture yourself stepping into a virtual world, equipped with a state-of-the-art headset that transports you to a realm where you have the power to unleash your frustrations like never before.\n\nOnce you're suited up, you'll have a virtual arsenal of tools at your disposal, from baseball bats to sledgehammers, allowing you to demolish a wide array of objects in your path. The satisfaction of each impact reverberates through the virtual world, creating an unparalleled sense of release.\n\nWhat sets our VR Rage Room apart is its ability to provide this cathartic experience without any of the real-world mess or safety concerns. You can let loose without worrying about cleanup or potential harm, allowing you to focus solely on the liberating sensation of release.\n\nWhether you're dealing with the pressures of a demanding job, the strains of daily life, or simply seeking an adrenaline-pumping adventure, our VR Rage Room is the ultimate solution. It offers a controlled, yet exhilarating outlet for pent-up energy and frustrations. You'll find yourself fully immersed in an environment designed to facilitate the therapeutic act of venting, leaving you refreshed, rejuvenated, and ready to face the world anew.", "short_description": "Experience a virtual Rage Room: don a headset, grab tools, and let off steam in a mess-free environment. Smash and shatter stress away!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/61b6455b-0d88-4260-993d-4766d5c0c188", "developer_terms_of_service_url": null, "publisher_name": "Render Island", "support_website_url": "https://www.render-island.com/contact-us", "website_url": "https://www.render-island.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8204991052941628"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
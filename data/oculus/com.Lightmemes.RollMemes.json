67087712_8454520333160473873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXlApJY_qWMQ7kNvwEVvROQ&_nc_oc=AdqaBfjgNcT2YAb7_fMolHILPlb5Go6pplELmXKiX72vr5hCsxg6VkAcIEoJocaWXjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0Ws1ghHdHkHsYxfdohcOS4Po-YJpgBjQrkUwIDpmDJg&oe=6A79CDE2"}, {"file_name": "RollMemes_blank-qhd_1773303679324.png", "id": "1295334262412191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1295334265745524_7509740344396633449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgefjOhDMiIQ7kNvwHjljkf&_nc_oc=AdrExcfnP86MlCln3mzHCwgJbI_W4ObWL3vIVe3lg7YFmqeXtOrMbLS57IJWbJXlgEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp-CRQAwBhg_9Zhcl4fXgB1-owMdtHeEDdPHmrAyfThA&oe=6A79BC00"}, {"file_name": "RollMemes_blank-qhd_1773303768336.png", "id": "4414076122184883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618288_4414076125518216_930605218003042213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmIauOpS9g8Q7kNvwGfGwkf&_nc_oc=Adra1aBch48fnVT3Lf5ekqqlRAtt4zl4ZRd1fsqT6ierJZpcBGS4WRs2FAJ6p83RrPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf-a1yuROs4_OoRdoryzWOtq-QxPYhL-xctF3lncLPSg&oe=6A79C9E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RollMemes_blank_1772961609776.png", "id": "1554448908977261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_1554448912310594_1332999829774519580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bgesK7rWaUQ7kNvwE2Locs&_nc_oc=AdqSQ8leBYpwl9TtDT5oYPyNITEfYGPHMyjKqIgDRnIhKGt-_iq2_TY-KNR1RGC35mM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLgew29zi2eoYzCnP7ZqLahLGN5fUkacGKb9xZBRHPWw&oe=6A79BCFA"}, "display_name": "Roll Memes", "keywords": ["Roll", "tilt", "Survivor", "Physics", "Casual"], "long_description": "Physics-based gameplay\nHold a plane with both hands and tilt it to control a ball's movement. You can make it glide smoothly or shake to bounce it up.\n\nSurvivors-Like\nunique abilities to customize your run and powerful combination skills by pairing specific abilities to unleash devastating effects, you can earn gold to enhance your attributes. \n\nUnique Level And Boss\nProvide more than four unique levels, each featuring specially designed maps, elite enemies, and creatively crafted boss battles.\n\nCustom Appearance\nCustomize your character with hats, glasses, and country-ball style skins to showcase your personality.", "short_description": "VR Physics Casual Game. Roll a ball and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Roll-Memes-Privacy-Policy-En", "developer_terms_of_service_url": null, "publisher_name": "Lighememes Studio", "support_website_url": null, "website_url": "https://www.rollmemes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786984607584886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618293_924492043846038_548103246095202776_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGVe1r9qFUAQ7kNvwFE29oH&_nc_oc=AdqkXUwdgQ3m5e5iQC7uur4sr1Ogegg06vy9JwmzPgW5Inu5yrSC83s4lSWZ4q901Gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmk57GHhed5BHyg09vSEo
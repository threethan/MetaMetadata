67087712_8454520333160473873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfr4DWJeQOUQ7kNvwHgmDFv&_nc_oc=AdrWBaBcvrx93lgXnH2DPZy7L5A0quQ64O7r9lOi6sUleRa_XtZSXNtYW0jIe3KAW44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl_XPfsO2a0qwqa7grbkPfLmjrea9o2isM0aCCfcnJ9Q&oe=6A7B1F62"}, {"file_name": "RollMemes_blank-qhd_1773303679324.png", "id": "1295334262412191", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1295334265745524_7509740344396633449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDTosDFNJjsQ7kNvwEHzYHB&_nc_oc=Adq3KMbf0jKJBPvnnT2vXw3kbb-3Bi70GOWsCjvKc6vb7gAbZsDtYCmtgbZF4DyoBIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl-7XWioYtNOsX414d-WSa9fslzidhNs2VumsrphJUkA&oe=6A7B0D80"}, {"file_name": "RollMemes_blank-qhd_1773303768336.png", "id": "4414076122184883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_4414076125518216_930605218003042213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmIauOpS9g8Q7kNvwFPKgFl&_nc_oc=Adow4H29-mQvTuD3CJ88GoaLTlGNqdyFEjg1MOKaEyeznylPpcBnq90zh1lXJH0I-J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaUqryQk3WuF6bPmvUMWUnTG2PIX9rana4W-wfFRp83Q&oe=6A7B1B62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RollMemes_blank_1772961609776.png", "id": "1554448908977261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1554448912310594_1332999829774519580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bgesK7rWaUQ7kNvwFKikUw&_nc_oc=Adp3lNh3URNAwTBCuBJc7k-pjIu96BLG4NwqktrMjQzTWH-wMdtHCzN8bhduWIMCVmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi3SqI-7uCgO-CaAmCFi7m9KqGK0FmVAhfhOTss61VdA&oe=6A7B0E7A"}, "display_name": "Roll Memes", "keywords": ["Roll", "tilt", "Survivor", "Physics", "Casual"], "long_description": "Physics-based gameplay\nHold a plane with both hands and tilt it to control a ball's movement. You can make it glide smoothly or shake to bounce it up.\n\nSurvivors-Like\nunique abilities to customize your run and powerful combination skills by pairing specific abilities to unleash devastating effects, you can earn gold to enhance your attributes. \n\nUnique Level And Boss\nProvide more than four unique levels, each featuring specially designed maps, elite enemies, and creatively crafted boss battles.\n\nCustom Appearance\nCustomize your character with hats, glasses, and country-ball style skins to showcase your personality.", "short_description": "VR Physics Casual Game. Roll a ball and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Roll-Memes-Privacy-Policy-En", "developer_terms_of_service_url": null, "publisher_name": "Lighememes Studio", "support_website_url": null, "website_url": "https://www.rollmemes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786984607584886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_924492043846038_548103246095202776_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGVe1r9qFUAQ7kNvwEc7WnA&_nc_oc=Adrjw0b5E-tEIqsYJGs0Dc7xUqMQfjEQLo3d1ly05RnbfDQKRPhjY_JRBwhkHf8Om2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg853QsxGzBnMV591HqKZ
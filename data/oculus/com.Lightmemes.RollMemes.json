67087712_8454520333160473873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKX4CflDKpQQ7kNvwEtb1CD&_nc_oc=AdrBzzHv90eqPKll8bAN_D1ZVyPnbLIHYKdPjHJ6KJh6l6lP3DnATR3FRJF7711eDoM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9KIp56owyp9APFvOkbS5LiH-fswJSgQDMeSAv6InaxQ&oe=6A942BE2"}, {"file_name": "RollMemes_blank-qhd_1773303679324.png", "id": "1295334262412191", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617831_1295334265745524_7509740344396633449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnuSnpn6Wh0Q7kNvwH-WZ6J&_nc_oc=AdpB2snHiGCygMpF4eNQLm01VbZPxP5JzXZ7PbpsWReZ95R2RiTymfvFJBRqwLHgoVk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKCsK8hyjCbInzrwP1i3FPDEj65oBrthE5VJmJ-ZM2Aw&oe=6A941A00"}, {"file_name": "RollMemes_blank-qhd_1773303768336.png", "id": "4414076122184883", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618288_4414076125518216_930605218003042213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cE42beeI_QQ7kNvwFuszUw&_nc_oc=Adq3L5B9KAyKwRhzZ8T-hCv6OiWvhb5m8b6S9_2pWWh7Pn7PKn0ED_pgi4O8Bz0Lc90&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-GHqZZv2moeUVRF7kz9_lIsFU3OQa0V07cD9EYCQxbA&oe=6A9427E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RollMemes_blank_1772961609776.png", "id": "1554448908977261", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618515_1554448912310594_1332999829774519580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRzhoPV1bGYQ7kNvwH_J0lx&_nc_oc=Ado_NVQnUF5vARPUAnPwojQJEPpjHuOL3DUK-QMNP53dh4GVmS9dnpBg9JOIyIVYjbw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBjp69rC53CqclwgrnrzX3SHAXt7EgxmlyAWeAKoy0xQ&oe=6A941AFA"}, "display_name": "Roll Memes", "keywords": ["Roll", "tilt", "Survivor", "Physics", "Casual"], "long_description": "Physics-based gameplay\nHold a plane with both hands and tilt it to control a ball's movement. You can make it glide smoothly or shake to bounce it up.\n\nSurvivors-Like\nunique abilities to customize your run and powerful combination skills by pairing specific abilities to unleash devastating effects, you can earn gold to enhance your attributes. \n\nUnique Level And Boss\nProvide more than four unique levels, each featuring specially designed maps, elite enemies, and creatively crafted boss battles.\n\nCustom Appearance\nCustomize your character with hats, glasses, and country-ball style skins to showcase your personality.", "short_description": "VR Physics Casual Game. Roll a ball and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Roll-Memes-Privacy-Policy-En", "developer_terms_of_service_url": null, "publisher_name": "Lighememes Studio", "support_website_url": null, "website_url": "https://www.rollmemes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786984607584886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618293_924492043846038_548103246095202776_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtMyNhxrcL8Q7kNvwE007cb&_nc_oc=AdqQLInx9BMceJTj3Nj58cH6WcVT8rUGvdxc2vKqWARodUnBr08MZw8-bB5JLy0ktG0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAJm_04iNXe_iP1wFU8jn
67087712_8454520333160473873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftTpyzYjZlgQ7kNvwHe2x0i&_nc_oc=Adq4TnkkR8bhZ-cSeAuDDeBSSc8X-ZJH9SFWHlwqZPJRFYs0FfYrGJM3o4jxN7pNfIQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08zt_yo8xIJbx8tf6GZrvkYf3Dtn6asf9vGu-mso-KDQ&oe=69D7A562"}, {"file_name": "RollMemes_blank-qhd_1773303679324.png", "id": "1295334262412191", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617831_1295334265745524_7509740344396633449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulW2PmBgVyMQ7kNvwEjKKHq&_nc_oc=AdolSUvGSGh_RT3CrQHccQmYqhpuCdX0KqkaKlE9DJVpGgdRzmdI7KdCVU3xOiEJ8RM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vGRq6vcjXhuu90m3xJ94xIyqkNCnhtldr70wmInhirQ&oe=69D79380"}, {"file_name": "RollMemes_blank-qhd_1773303768336.png", "id": "4414076122184883", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618288_4414076125518216_930605218003042213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn6Pp7VnqpUQ7kNvwF9cjCv&_nc_oc=Ado8BiGAJebXzNjTswicz-8FjXQh0nLwEkUpkKz5ve3jL2uR9RcK9cO51a8aqAi4XUE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30MpWbe4E9qt2drXNyfXc1M4KXGA3hh-wmi_PuBQFOkQ&oe=69D7A162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RollMemes_blank_1772961609776.png", "id": "1554448908977261", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618515_1554448912310594_1332999829774519580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr3M6HJusTcQ7kNvwE7b7sF&_nc_oc=AdqlUUD-Gb-MQeQdd9FZm3cuxHj5LYASCYO3BmviuoFNyXuMNTXZ65ialLfTP0_73FI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ckra-X0CjJOJV5QIYPfF5EAaT1r0HAVvkii6wVCkEAg&oe=69D7947A"}, "display_name": "Roll Memes", "keywords": ["Roll", "tilt", "Survivor", "Physics", "Casual"], "long_description": "Physics-based gameplay\nHold a plane with both hands and tilt it to control a ball's movement. You can make it glide smoothly or shake to bounce it up.\n\nSurvivors-Like\nunique abilities to customize your run and powerful combination skills by pairing specific abilities to unleash devastating effects, you can earn gold to enhance your attributes. \n\nUnique Level And Boss\nProvide more than four unique levels, each featuring specially designed maps, elite enemies, and creatively crafted boss battles.\n\nCustom Appearance\nCustomize your character with hats, glasses, and country-ball style skins to showcase your personality.", "short_description": "VR Physics Casual Game. Roll a ball and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Roll-Memes-Privacy-Policy-En", "developer_terms_of_service_url": null, "publisher_name": "Lighememes Studio", "support_website_url": null, "website_url": "https://www.rollmemes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786984607584886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618293_924492043846038_548103246095202776_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69-Ri2wGBToQ7kNvwFi86Wk&_nc_oc=AdpcgTxAfxJuTV_YTcptiTuMmRhZwRJ-tjIQiaMx18LppNsUbadvZV1CG0oW48cByU0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zw-5Fjp09eGjt5k1zMxE
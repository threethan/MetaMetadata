67087712_8454520333160473873_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqgzlWXOwY0Q7kNvwHTst1Q&_nc_oc=AdoZFwVR9vSk99YuQGzzQVzNE-2YPc_QSZx5qwRiShAFXfV4u4Zn6vIdZESSw5VS51Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGR3LHB5Cr6YURGmNv7hMcnWjY1GSJLK38uj5oNNXxSQ&oe=6AF35022"}, {"file_name": "RollMemes_blank-qhd_1773303679324.png", "id": "1295334262412191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617831_1295334265745524_7509740344396633449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pORaF0YeycsQ7kNvwFwfD-3&_nc_oc=AdrezARDqv0k-33I5bUDhlxfKE_Hd1AdSrRw6CaGUHIbenJk5KJbYRv3gNEeNRFShno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRip-fS8IoFwEnGsOucDREnSE0OICkK--2U2RL4IOzdSg&oe=6AF33E40"}, {"file_name": "RollMemes_blank-qhd_1773303768336.png", "id": "4414076122184883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_4414076125518216_930605218003042213_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-9lIZaXlcgQ7kNvwF3XLB-&_nc_oc=AdrT6SvaGq6gY8vO8w3UNJJ52vlAdJ6hij4uk33MUR9L-MWDtUNXw0EkfuCgmGuNLkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTATQA0pllHQsLYPfaYLWhzrRzPny0NqzBQwhshqGduw&oe=6AF34C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RollMemes_blank_1772961609776.png", "id": "1554448908977261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_1554448912310594_1332999829774519580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arBRG_tB1wcQ7kNvwFi2IEI&_nc_oc=AdqIa9q-jq07XRALgPmKLbia9h9ZtoFA1PRoyrHATPyrW94ROHlOGuKciMV6uCGsYFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgUXDifny7b9uPPEQVUAog1NsSfmK-JmW02eNwpJaFGA&oe=6AF33F3A"}, "display_name": "Roll Memes", "keywords": ["Roll", "tilt", "Survivor", "Physics", "Casual"], "long_description": "Physics-based gameplay\nHold a plane with both hands and tilt it to control a ball's movement. You can make it glide smoothly or shake to bounce it up.\n\nSurvivors-Like\nunique abilities to customize your run and powerful combination skills by pairing specific abilities to unleash devastating effects, you can earn gold to enhance your attributes. \n\nUnique Level And Boss\nProvide more than four unique levels, each featuring specially designed maps, elite enemies, and creatively crafted boss battles.\n\nCustom Appearance\nCustomize your character with hats, glasses, and country-ball style skins to showcase your personality.", "short_description": "VR Physics Casual Game. Roll a ball and survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CharminLightmemes/Quicksand/wiki/Roll-Memes-Privacy-Policy-En", "developer_terms_of_service_url": null, "publisher_name": "Lighememes Studio", "support_website_url": null, "website_url": "https://www.rollmemes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786984607584886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618293_924492043846038_548103246095202776_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOVEIMuwy4cQ7kNvwEZjfrL&_nc_oc=Adoje4rSCM65anu0otq4A_Nvu0Bc0iKI4ZsWMjbuORArgPCLWJXCBWVaKsLO_poPyjg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuvUYGh7sEoXJDynLDg1C
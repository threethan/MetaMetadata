cdn.com&_nc_ss=7f20f&oh=00_AQMLT_z-FtBzPsrSHMD021oLtp568yqSfCHFbVb7x5he3A&oe=6AD3929D"}, {"file_name": "Screenshot4_2560x1440.png", "id": "1394019281974273", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393126_1394019285307606_3804251985840362827_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iI9pi4pW5HIQ7kNvwF1zXd-&_nc_oc=AdqY8V_GRihlyrKqOvQS2X9jLqVXWf3SQndnOZhz6jSQeJnvgqKRnpdsC6A_e40R4wQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgJ_FXDrcEdBmF97EEnqcyKelVy4bB1FNTmGB__9Blfw&oe=6AD3A3E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage2560x1440.png", "id": "1788002678665418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391769_1788002681998751_6677080106417089689_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8QZ9y-NmqQQ7kNvwGoXalZ&_nc_oc=Ado37j6lHYfT_tzlHVVYk8kkrykNTrdM1MxpwsW6TLjznY2hXY6kLAIwHXYMsQvx_vI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQciFasROZcquRgAZFnXy_pkFolIi9AH5kD3LYOTQIgg&oe=6AD38967"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms
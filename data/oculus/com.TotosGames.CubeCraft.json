x1440.png", "id": "1726937728095654", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1726937734762320_3953979642576922140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPzxieq0uDIQ7kNvwGZthEM&_nc_oc=AdklMqE8xSUDkwFwYveS_FARpYYZn-svRIgdbdq1l6syFpEuB0Z6UGm2fGJubc5ROFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvhqc95KAP9ieNS1SdscUQGP2IOfm3HereRZavMiZjWNA&oe=699AE6DD"}, {"file_name": "Screenshot4_2560x1440.png", "id": "1394019281974273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393126_1394019285307606_3804251985840362827_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB9jnS_l4eQQ7kNvwH8Tk4_&_nc_oc=AdlgDx8Xv4Bnc3A9-k9pxp7eoPqIGrgUqjseGoe0CXhXMvb6URuDRK62WkkpdiPTyQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvvDx8NnkiNaN-EZ6dDJS3NKAlBak71nk29lh1H5imtjw&oe=699AF826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage2560x1440.png", "id": "1788002678665418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391769_1788002681998751_6677080106417089689_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_dr3Ufvo2wQ7kNvwGkccjn&_nc_oc=AdlLbZC_fLqzMdQbkX054V75fxi_hH-0xCXdLgw4CRc33J6lU-HZOjJDJESTxiZnfbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftdFV6thqvyuOms-I5n8e8eKe8ppm-JWJYHeEuBoyJ6mA&oe=699ADDA7"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8666190710175834"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "917735340778590"}, {"status": "PUBLISHED", "id": "2288686131594329"}, {"status": "PUBLISHED", "id": "1212015227257239"}, {"status": "PUBLISHED", "id": "1726254311261891"}, {"status": "PUBLISHED", "id": "599335239482969"}, {"status": "PUBLISHED", "id": "2744108525777630"}]}, "baseline_offer": {"id": "2744108525777630"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "917735340778590"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8660869640707941", "version": "0.1"}, "id": "593649420267023", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
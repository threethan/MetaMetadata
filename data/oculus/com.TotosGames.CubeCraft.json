-1.oculuscdn.com/v/t64.5771-25/491824741_2204580896756520_33453864143487176_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9XgsD1tAYQ7kNvwF7FUjZ&_nc_oc=AdrJyTch7Tjo06zA8bIMrwWkhyVysp1aq1F-hEIzmiQhIix_FFY0H-3oCuCOa-g4jys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvESLh-5C5XReZ4wZBmFZjNlEsPAZrOgfQhyfEJn4obg&oe=6B01EDDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CubeCraft_Cover_Landscape_2560x1440.png", "id": "1079484801627725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825345_1079484808294391_6641037500448679834_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrUL9r4D4kgQ7kNvwHtn0Hp&_nc_oc=AdqXRgN7vS7hokjnPbu8tLQzD5fGr-b8x4CUGi2TWXg7XlrRupPNOtNiAQZbA_0OhZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtQrcxgq6wvE01GhFItQWN0NDnANDoCXpKXghJjw3N9w&oe=6B01C997"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://
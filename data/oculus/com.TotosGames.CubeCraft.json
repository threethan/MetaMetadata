=6ADCB257"}, {"file_name": "Screenshot1_2560x1440.png", "id": "1726937728095654", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1726937734762320_3953979642576922140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yORVATqnNZIQ7kNvwG6e-bD&_nc_oc=AdrxkYPA6mXR6gsmpqjkUyvgf_susmQwBxy01CmI40U93yvm0Z-1DhTOJW9dhr_rJEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqcjtpAbatdTVGnyIxz6K1QOSMG4-IS2X2xVzjZvZa2g&oe=6ADCCD1D"}, {"file_name": "Screenshot4_2560x1440.png", "id": "1394019281974273", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393126_1394019285307606_3804251985840362827_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfsABW3dacIQ7kNvwFL-KNc&_nc_oc=AdpgBwkarM3QpA-e57HlsMlql1LzkXXEgwj-dphj-ntpE-ppa3OgE05hejAEmnCka00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqVS9nzfeFNBOaQsvaF98ZYwgSNBw7p8wH5lWszeqGIg&oe=6ADCA626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage2560x1440.png", "id": "1788002678665418", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391769_1788002681998751_6677080106417089689_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scvxOX-9HWYQ7kNvwGUv9_t&_nc_oc=Adr1Ft0TscXbOWCaiidDj0cLe9Lmw24OirH-9-zYlW9PNcDz5TTkdqp3t0I8oTnPVYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzOW0TjOPnDBRlnQhfCsFZpNoCY_UPIvTbrK8t9_Shwg&oe=6ADCC3E7"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8666190710175834"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "917735340778590"}, {"status": "PUBLISHED", "id": "2288686131594329"}, {"status": "PUBLISHED", "id": "1212015227257239"}, {"status": "PUBLISHED", "id": "1726254311261891"}, {"status": "PUBLISHED", "id": "599335239482969"}, {"status": "PUBLISHED", "id": "2744108525777630"}]}, "baseline_offer": {"id": "2744108525777630"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "917735340778590"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8660869640707941", "version": "0.1"}, "id": "593649420267023", "channel_name": "LIVE"}]}, "i
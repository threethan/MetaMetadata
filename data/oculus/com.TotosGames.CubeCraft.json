3391769_1788002681998751_6677080106417089689_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVf86tNnDpwQ7kNvwFVusQP&_nc_oc=AdroVyu0xrI2Cx_4diPqSk1rVbZqLcSj3jR1EXPVB-BBF9OxKrJ8gEANh-MR7TDdRWI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTETth2eNE3ou5XCPwFXF0vozwRYU2gSQj5q_AWcy0msA&oe=6AFB1667"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
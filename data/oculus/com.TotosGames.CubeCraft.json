-1.oculuscdn.com/v/t64.5771-25/491824741_2204580896756520_33453864143487176_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDUdRdHBPxsQ7kNvwEKZz0w&_nc_oc=AdrlNWgQube_7xvjRMKWESFL8EHSDO7Ri8nODRnpU3GQ4Pbjgh8OOFLO5dwMziy4a9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY4R689ZaNgHE0iElDJTn0eD8UdEnwIuK5dvTBu8ewHQ&oe=6B03071A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CubeCraft_Cover_Landscape_2560x1440.png", "id": "1079484801627725", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_1079484808294391_6641037500448679834_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrUL9r4D4kgQ7kNvwGADmha&_nc_oc=AdploGmNN4lJfq-p93OOqxyR5xgWOIlSEhXfe3yq1Ai3laqcJTDj9o16fWMxuKeKbcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzG0x2oySC71yePQEi2eu2RGUL6NkGwZ2XsElVDKByVA&oe=6B031B17"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://
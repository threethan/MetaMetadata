7&_nc_sid=6e7a0a&_nc_ohc=hXuKBwxQU4kQ7kNvwEwTow9&_nc_oc=AdpbU1K9dUi9k-8tYGL2b12KKMghPpt_f5VlR8a5yRPcytEdbvKAyRnGDGX09hq9OAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSalgd0qYjQpKr162YdI-Nszo4LOaW379D3AfWPLEZOOQ&oe=6AFC6F9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CubeCraft_Cover_Landscape_2560x1440.png", "id": "1079484801627725", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1079484808294391_6641037500448679834_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYAvMeph7GwQ7kNvwF0H96l&_nc_oc=AdqfAv4UXkhvTcWBCgIfmygxMxEAlq6_hYY3b-1IJIMrgIEjT-3QwLZJp7Nk_HWujdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_DknatH_BCCLRxeH-F_pk1GpxXBkVrLdqa06GaLyQ0w&oe=6AFC8397"}, "display_name": "Cube Craft", "keywords": ["Game", "Puzzle", "Brain", "Casual", "Stack"], "long_description": "Experience the classic thrill of Tetris reimagined in stunning virtual reality with Cube Craft! Engage in fast-paced, brain-teasing gameplay as you rotate, position, and stack colorful 3D cubes in an immersive environment. Test your puzzle-solving skills and quick thinking while competing for the highest scores in dynamic and ever-evolving levels. Whether you're a seasoned puzzle enthusiast or a casual gamer, Cube Craft delivers endless fun with its unique VR twist.", "short_description": "Dive into Cube Craft, a groundbreaking VR puzzle game inspired by the timeless concept of Tetris, now in immersive 3D! Rotate, stack, and fit cubes into place to challenge your spatial awareness and reflexes like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cat
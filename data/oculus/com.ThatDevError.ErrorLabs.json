l instincts to guide you, the game transforms the fast-paced fun of Gorilla Tag into a pulse-pounding survival experience where every branch could be your last.", "short_description": "A gorilla tag fan game based of horror"}]}, "developer_name": "Error", "developer_privacy_policy_url": "https://sites.google.com/view/errorlabsprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24000695362954358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "740198991727992"}]}, "baseline_offer": {"id": "740198991727992"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751310000, "status": "PUBLISHED", "id": "740198991727992"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24371384259218798", "version": "4.1"}, "id": "1115220614084643", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23973080402382521", "is_concept": false, "latest_released_binary": {"__typename": "An
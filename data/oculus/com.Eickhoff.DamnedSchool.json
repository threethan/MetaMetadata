content-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1610696490094841_410451601663953355_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR8S8eeTzc0Q7kNvwEnClQN&_nc_oc=Adr7F92cW64EQCvAVaM5b_2HhOEXvlwcNCMYQokjPA3GOZlOSE4J_WULGLZEsqNNRRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DuYwMuWJ7RLCNZWsmcnHSL5KQICGU1mk3tSxurT-GOQ&oe=6A43CF92"}, "display_name": "DamnedSchool", "keywords": [], "long_description": "**Magic. Puzzles. Action. Together in VR.**\nDive into a physics-based fantasy action shooter that pulls you straight into the adventure.\n\n- Face monstrous enemies up close with realistic physics\n- Unleash powerful spells\n- Explore mysterious places and solve ancient puzzles\n- Experience thrilling action solo or in co-op multiplayer with friends\n- Enjoy full immersion in a vibrant, interactive fantasy world\n\nFeel the power of magic, overcome the darkness \u2013 and embark on adventures only possible in VR.", "short_description": "Experience a physics-based VR fantasy shooter filled with magic, puzzles, and epic battles. Fight solo or in co-op, cast spells with your hands, and face monstrous enemies in a living fantasy world."}, {"images": {"nodes": [{"file_name": "titel_2560_1440logo.png", "id": "25353286670939764", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818874_25353286684273096_5729733783226815280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXWPW8oNg5oQ7kNvwHY3Sfq&_nc_oc=AdqpR3tT7gm_9jHV0yYaaEnb8BRbaDgZqq1L1ISo-UAqtEQm6wEC92ya6H2czMZ5-jU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FYFlt9YV7tCFrQQR53pGpXOSRHh2YrfnM6xM6CSA2bg&oe=6A43C108"}, {"file_name": "symbolSolid512.png", "id": "2214463079017250", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819336_2214463082350583_1145808276885830663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Bc8z5DmNGIQ7kNvwEyU4Y-&_nc_oc=AdrLonE1aJTE5bor8koZVR3l-30L
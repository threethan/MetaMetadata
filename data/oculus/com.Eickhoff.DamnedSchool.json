content-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1610696490094841_410451601663953355_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJT_2LbtbE0Q7kNvwHcv8ad&_nc_oc=AdobpBej4jOMY3sVsu0Xp52BoR0fojJNhoF7DsfjVD2QCYj27-gRPkHrG4Zx1eqWs6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yFADvdMZhcUBSAx3CTXonAEVg9MwuGASicQim9n_I4w&oe=6A2EB792"}, "display_name": "DamnedSchool", "keywords": [], "long_description": "**Magic. Puzzles. Action. Together in VR.**\nDive into a physics-based fantasy action shooter that pulls you straight into the adventure.\n\n- Face monstrous enemies up close with realistic physics\n- Unleash powerful spells\n- Explore mysterious places and solve ancient puzzles\n- Experience thrilling action solo or in co-op multiplayer with friends\n- Enjoy full immersion in a vibrant, interactive fantasy world\n\nFeel the power of magic, overcome the darkness \u2013 and embark on adventures only possible in VR.", "short_description": "Experience a physics-based VR fantasy shooter filled with magic, puzzles, and epic battles. Fight solo or in co-op, cast spells with your hands, and face monstrous enemies in a living fantasy world."}, {"images": {"nodes": [{"file_name": "titel_2560_1440logo.png", "id": "25353286670939764", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_25353286684273096_5729733783226815280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyHlgsvO_VAQ7kNvwGl8QXs&_nc_oc=AdroNsX-H_pyu1JO15iOST9TseZNo9BPIMOxsOOmHydi6FnW76FLkzCzb6fQFAaHHTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yyTCyTZMzy8TpCfrjtmjNcXOSCi7NFjUCxmR98qWVNw&oe=6A2EA908"}, {"file_name": "symbolSolid512.png", "id": "2214463079017250", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819336_2214463082350583_1145808276885830663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1S1M118fMsQ7kNvwFnABHc&_nc_oc=Adq6AajMkZtICFjT78WpL5MCw7K3
content-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1610696490094841_410451601663953355_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ8nBvPiC7QQ7kNvwFU4nVY&_nc_oc=AdoGZ4QgThVqeVq4ymFKnBU0NXi9noFtaZivegcuBOth_CRBygJcOKyIDSebD0e9ZBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eDNsd49TQTjh44VGWd7dUsARRwS1vGtECRVMbaJ_pOg&oe=6A2C1492"}, "display_name": "DamnedSchool", "keywords": [], "long_description": "**Magic. Puzzles. Action. Together in VR.**\nDive into a physics-based fantasy action shooter that pulls you straight into the adventure.\n\n- Face monstrous enemies up close with realistic physics\n- Unleash powerful spells\n- Explore mysterious places and solve ancient puzzles\n- Experience thrilling action solo or in co-op multiplayer with friends\n- Enjoy full immersion in a vibrant, interactive fantasy world\n\nFeel the power of magic, overcome the darkness \u2013 and embark on adventures only possible in VR.", "short_description": "Experience a physics-based VR fantasy shooter filled with magic, puzzles, and epic battles. Fight solo or in co-op, cast spells with your hands, and face monstrous enemies in a living fantasy world."}, {"images": {"nodes": [{"file_name": "titel_2560_1440logo.png", "id": "25353286670939764", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818874_25353286684273096_5729733783226815280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJcr1Say33YQ7kNvwFYi-qQ&_nc_oc=AdpF7RSbj11gvMIhhvrb7I31mSv-3DaLJE7ZFoV1lz3lhQSChJc_zHwx98mnJjVRqUg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bzvEPKbdjv6INtzbiTRwHVlZQ865vfB7AVzwu2ZEyJg&oe=6A2C0608"}, {"file_name": "symbolSolid512.png", "id": "2214463079017250", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819336_2214463082350583_1145808276885830663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYqurdoWEoQQ7kNvwGWvOFO&_nc_oc=AdoEfPo9D_8X-iQ-60XNs7DruXTX
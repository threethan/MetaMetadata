content-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1610696490094841_410451601663953355_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0WzVOhFlt4Q7kNvwHnUDjo&_nc_oc=AdoVcvOJFywzc81YaW7LcHneBj4YZGXFfnnIPmzVD_Lp8zYHkTEO1O4Atzp7R6VDQ0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PyvrCg3ei-J1kTDlSzgnbH6SXw2vVAFV5kF7W1JyijQ&oe=6A37F212"}, "display_name": "DamnedSchool", "keywords": [], "long_description": "**Magic. Puzzles. Action. Together in VR.**\nDive into a physics-based fantasy action shooter that pulls you straight into the adventure.\n\n- Face monstrous enemies up close with realistic physics\n- Unleash powerful spells\n- Explore mysterious places and solve ancient puzzles\n- Experience thrilling action solo or in co-op multiplayer with friends\n- Enjoy full immersion in a vibrant, interactive fantasy world\n\nFeel the power of magic, overcome the darkness \u2013 and embark on adventures only possible in VR.", "short_description": "Experience a physics-based VR fantasy shooter filled with magic, puzzles, and epic battles. Fight solo or in co-op, cast spells with your hands, and face monstrous enemies in a living fantasy world."}, {"images": {"nodes": [{"file_name": "titel_2560_1440logo.png", "id": "25353286670939764", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_25353286684273096_5729733783226815280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwbUcCoN1u0Q7kNvwFhGA_S&_nc_oc=AdokzgkrnMcAKXFucpmSQ2F9ZqKf2NKHsB6oE3K6z7bZb3aRORRSp4KXUor4qTb4Sxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gGjT38Q0CPNd-rL8ZBQlwhV3MSQfVtpYN2ZaEPXpxZg&oe=6A37E388"}, {"file_name": "symbolSolid512.png", "id": "2214463079017250", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819336_2214463082350583_1145808276885830663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JZWgzbCdecQ7kNvwEa-BIn&_nc_oc=AdpLOB0uRGtHPQjrETX5lPqPDXtl
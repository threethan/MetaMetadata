 fast-paced multiplayer action using immersive gorilla-style movement. Explore unique maps, master momentum, and challenge friends in chaotic tag matches where movement skill makes all the difference. Easy to jump into, tough to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/alttagwebsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Peanut", "support_website_url": null, "website_url": "https://sites.google.com/view/alttagwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1210028235522755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_963495066452851_909126657121510050_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ykp4bF9dzokQ7kNvwEhW9XN&_nc_oc=Adr4h3Ub7KcvfBHerSTXpB2zmrljb1eMjoB0V38k8ylts6mJpKQL_RIaNnHG1hdHdME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZaNH1mQjzXse-zHQZf_v8jMAjofsHOThLkLobK-Dusg&oe=6B01DEC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alt Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504
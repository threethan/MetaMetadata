oculuscdn.com/v/t64.5771-25/491821796_1433475745520691_2753793385861282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STzLhXsE-SIQ7kNvwHgwyvc&_nc_oc=AdpoCDBsM3I6iYr1In0CxJiUmsQy-ma_ShMzafpqCwVFYobAdjb51Xl_6GOxWmS_u9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKblp9Lntxyw9iwSejRlGrg1Ce9s1TBu-izbeQocFhnQ&oe=6AC66D35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover image.png", "id": "2001223120593061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2001223123926394_137190607955551452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg7K7bJfZPYQ7kNvwFZcfYC&_nc_oc=Adr1QcVGHQtotjHaBleW5FB6Df17Bqub25LRmz3lBjYeEjenv5WbOPOug60ORDCQlcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWLxJ5ReUVio6FFmAIIpAv8CeXJLQWZojIGuejTE_dxQ&oe=6AC66169"}, "display_name": "Scan to Plan", "keywords": ["floorplan", "plan", "blueprint", "SVG"], "long_description": "**Your headset can measure your home. This draws the 2D floor plan.**\n\nMoving, letting, insuring, quoting a builder - something always wants a floor plan. Your Meta Quest can map the walls, doors, windows and furniture itself. Set your space up once and the plan is waiting; if you have not, the app takes you there.\n\n# 1:1 overlay\nThe plan over your rooms in passthrough, full size, in place. Walls and furniture outlined where they stand, named and measured.\n\n# Miniature\nYour whole home as a model before you. Turn it, zoom in, click the stick to reset.\n\n# Floor plan\nA flat sheet you can pan and zoom: wall lengths, room areas, doors and windows as real openings, furniture in its footprint, and a marker where you stand.\n\n# Squared up\nThe same plan as an architect draws it: walls pulled onto the building's axes, partitions fused to their real thickness, corners closed. Black ink on white paper.\n\n# Take it with you\nThe trigger saves the sheet to Pictures/ScanToPlan as a print-size picture, and an SVG beside it - to a stated scale, with walls, furniture, dimensions and labels on separate layers, text still text. Edit it in Inkscape, Illustrator or Figma.\n\n**Free:** the overlay and the miniature in full, every object named and measured. The two floor-plan sheets are locked - the drawing shows, but with no numbers or names on it. One purchase unlocks them and the export.\n\nMeasurements come from the headset's scan and are only as good as it is; nothing in the plan is drawn by hand.", "short_description": "Your headset can map your home itself - the walls, doors, windows and furniture. Set your space up once, and the 2D plan is waiting. Scan to Plan draws it as a real floor plan: over your rooms at full size, as a model you can turn, and as a flat sheet with wall lengths and room areas. Save it as a print-size picture and an editable SVG, to a stated scale.\n\nFree: the overlay and the miniature, every object named and measured. One purchase adds the lettering on the plan and the exported files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ScanToPlan/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/ScanToPlan", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1219453101260494"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1042777428755337"}]}, "baseline_offer": {"id": "1042777428755337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790084220, "status": "PUBLISHED", "id": "1042777428755337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1260112847194519", "version": "1.3"}, "id": "4267918746761949", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1260112847194519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": "\"The four views now flow into one another. Your room collapses into a model you can hold, the model flies onto the sheet and settles into the drawing, the drawing squares itself up, and then it rises off the paper and opens back out around you.\\nEvery plan you export is now kept in the app, so you can open it again at any time.\"", "created_date": 1790940028, "id": "1260112847194519", "version": "1.3", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1260112847194519"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": null, "created_date": 1790354176, "id":
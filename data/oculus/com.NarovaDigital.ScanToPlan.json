ezXTGg2ICpkMjAA&oe=6AF4A5A0"}, {"file_name": "5-overlay-room.png", "id": "1433475742187358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1433475745520691_2753793385861282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgcH9SbwdrAQ7kNvwGyRZxO&_nc_oc=AdrJpUPfeCqABpD05Z0w0x6W6Sz74xjMEVjPa_X4T0LFBHky3Gb1AckJ7O3mYtu7Aq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRgrrGNTg5Ej9T0CL_MpJXpjsXJ4rORluH1EqXk5L4Pw&oe=6AF491B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover image.png", "id": "2001223120593061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2001223123926394_137190607955551452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnfsEhuqUsgQ7kNvwECquZY&_nc_oc=Adp2ZxNhOUUGCFXil28KqOgYAqAkU2zXuEnFHyfvbvro61tD9nQcWe0ga68Grp9L6u8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI9YWRASpKIaWqIGlhtnKDkQcPviDVLte_GokTfp1cEA&oe=6AF485E9"}, "display_name": "Scan to Plan", "keywords": ["floorplan", "plan", "blueprint", "SVG"], "long_description": "**Your headset can measure your home. This draws the 2D floor plan.**\n\nMoving, letting, insuring, quoting a builder - something always wants a floor plan. Your Meta Quest can map the walls, doors, windows and furniture itself. Set your space up once and the plan is waiting; if you have not, the app takes you there.\n\n# 1:1 overlay\nThe plan over your rooms in passthrough, full size, in place. Walls and furniture outlined where they stand, named and measured.\n\n# Miniature\nYour whole home as a model before you. Turn it, zoom in, click the stick to reset.\n\n# Floor plan\nA flat sheet you can pan and zoom: wall lengths, room areas, doors and windows as real openings, furniture in its footprint, and a marker where you stand.\n\n# Squared up\nThe same plan as an architect draws it: walls pulled onto the building's axes, partitions fused to their real thickness, corners closed. Black ink on white paper.\n\n# Take it with you\nThe trigger saves the sheet to Pictures/ScanToPlan as a print-size picture, and an SVG beside it - to a stated scale, with walls, furniture, dimensions and labels on separate layers, text still text. Edit it in Inkscape, Illustrator or Figma.\n\n**Free:** the overlay and the miniature in full, every object named and measured. The two floor-plan sheets are locked - the drawing shows, but with no numbers or names on it. One purchase unlocks them and the export.\n\nMeasurements come from the headset's scan and are only as good as it is; nothing in the plan is drawn by hand.", "short_description": "Your headset can map your home itself - the walls, doors, windows and furniture. Set your space up once, and the 2D plan is waiting. Scan to Plan draws it as a real floor plan: over your rooms at full size, as a model you can turn, and as a flat sheet with wall lengths and room areas. Save it as a print-size picture and an editable SVG, to a stated scale.\n\nFree: the overlay and the miniature, every object named and measured. One purchase adds the lettering on the plan and the exported files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ScanToPlan/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/ScanToPlan", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1219453101260494"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1042777428755337"}]}, "baseline_offer": {"id": "1042777428755337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790084220, "status": "PUBLISHED", "id": "1042777428755337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1333134783225658", "version": "1.5"}, "id": "4267918746761949", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333134783225658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": "What's new in 1.5\r\n\r\nA tape measure in the 1:1 view: point at one place, then at another, and the distance hangs in the air between them. Walls, floor, ceiling, furniture \u2014 including what a plan never tells you, like the height of a window sill.\r\n\r\nThe stick now slides the 1:1 plan until it sits on the real walls, for when the headset finds its map a few centimetres off. A click on the stick puts it back.\r\n\r\nEvery button on the controller carries a label saying what it does right now, and the label lights up while the button is held.", "created_date": 1793549927, "id": "1333134783225658", "version": "1.5", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333134783225658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": "\"What's new in 1.4\\n\\nEDIT YOUR PLAN\\nA new Edit button on the floor plan lets you correct what the scan could not know. Name your rooms and the objects in them, remove anything that does not belong, set which way each door opens, and turn beds, couches and chairs to face the right way. Changes are saved as you make them.\\n\\nFEET AND INCHES\\nMeasurements can now be shown in feet and inches, with areas in square feet and the sheet sized for US Letter. Open Help with Grip and pull the trigger to switch between metric and imperial.\\n\\nFURNITURE DRAWN AS FURNITURE\\nBeds, couches, chairs, baths, toilets, stairs and plants are drawn with their own symbols instead of plain boxes, so the plan reads without reading the labels.\\n\\nDOORS\\nEvery door can show which way it opens, drawn the way a floor plan has always drawn it.\\n\\nPICK UP THE MODEL\\nIn the dollhouse view, hold the trigger to take the model in your hand and turn it whichever way you like.\\n\\nALSO\\nExport asks before it writes, and says where the files went.\\nThe exported drawing prints on a single sheet.\\nWalls the scan lost behind tall furniture are completed from the floor.\\nMore room and object names to choose from.\\nThe controllers answer in your hand.\\n\"", "created_date": 1793273575, "id": "1322557410950062", "version": "1.4", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333134783225658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": "\"The four views now flow into one another. Your room collapses into a model you can hold, the model flies onto the sheet and settles into the drawing, the drawing squares itself up, and then it rises off the paper and opens back out around you.\\nEvery plan you export is now kept in the app, so you can open it again at any time.\"", "created_date": 1790940028, "id": "1260112847194519", "version": "1.3", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333134783225658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4267918746761949"}]}, "change_log": null, "created_date": 1790354176, "id": "1244084468797357", "version": "1.2", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219453091260495", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333134783225658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789993928, "id": "1236692799536524", "version": "1.0", "version_code": 3, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
"}, {"file_name": "cover-hero-3000x900.png", "id": "945650418609663", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_945650421942996_1284101989094383432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmodVazOyVoQ7kNvwFYVojp&_nc_oc=AdoXjQt1ngk1NONpH0gBlEJDAk9HklfQsgVMPSvHWAckQ_DPFLpU-8c_2xIIQ5l0Ml8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4bQlqgMo4q2FledPq3ndFAHTXvdWrabYnm7JJEpV4Ew&oe=6AC64F9B"}]}, "id": "4454368121505034", "locale": "en_US", "screenshots": [{"file_name": "1-floor-plan-clean.png", "id": "1463882858919024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1463882862252357_6507272132973331479_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMuHYzsFZAYQ7kNvwHIQmFF&_nc_oc=Ado4ex5MsjjGUjncs8-qTnLqktyhgrM77afOk_kIBEY_08i3HqM_uPZDAzR6-EgWgkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjj3o8fLEHezNe-Ht0Ksj63VbTR245tNZee575d50wxw&oe=6AC65635"}, {"file_name": "2-floor-plan-dark.png", "id": "1070355045693255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_1070355049026588_4242163528169739825_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAPbm1xEqE8Q7kNvwG8zqeL&_nc_oc=Ado-9BecwxFpCExPss6xy3SvsAOJVrBYrmX3FnrDuRdx1GFryfcW1JFUYCKKB7oEnZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkeivteAOr_v7iploTJDpHyn1Cv6X3aPy55XGcUDj9LQ&oe=6AC64AB4"}, {"file_name": "3-overlay.png", "id": "1124941756877254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1124941760210587_8767587589818035260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Dm_1vwUaQQ7kNvwFWoFoq&_nc_oc=AdqatXfOmLthaSgTosHltdUkh_01nTMGQCO4CswAamTv663IkA6GtNpsH14gDW6ldeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5ugyb-RgdBbkA_vKASTmV7fqoh8OyvJZ_MzkXuWC-Gw&oe=6AC67871"}, {"file_name": "4-miniature.png", "id": "1563844548850413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1563844555517079_5433506928396577042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nrLq8owdKcQ7kNvwG-Hont&_nc_oc=AdrZ0ewHRYYsRv95FEJTPOBmqk5jzpnCMvAPCbetxRTr5nv-DJK1zDUbTlJWJ6LB5uI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj98owab0HRYfanSnmQ7GWVbwbRWSY06midDsrPdH8dQ&oe=6AC648E0"}, {"file_name": "5-overlay-room.png", "id": "1433475742187358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1433475745520691_2753793385861282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STzLhXsE-SIQ7kNvwHgwyvc&_nc_oc=AdpoCDBsM3I6iYr1In0CxJiUmsQy-ma_ShMzafpqCwVFYobAdjb51Xl_6GOxWmS_u9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKblp9Lntxyw9iwSejRlGrg1Ce9s1TBu-izbeQocFhnQ&oe=6AC66D35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover image.png", "id": "2001223120593061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2001223123926394_137190607955551452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg7K7bJfZPYQ7kNvwFZcfYC&_nc_oc=Adr1QcVGHQtotjHaBleW5FB6Df17Bqub25LRmz3lBjYeEjenv5WbOPOug60ORDCQlcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWLxJ5ReUVio6FFmAIIpAv8CeXJLQWZojIGuejTE_dxQ&oe=6AC66169"}, "display_name": "Scan to Plan", "keywords": ["floorplan", "plan", "blueprint", "SVG"], "long_description": "**Your headset can measure your home. This draws the 2D floor plan.**\n\nMoving, letting, insuring, quoting a builder - something always wants a floor plan. Your Meta Quest can map the walls, doors, windows and furniture itself. Set your space up once and the plan is waiting; if you have not, the app takes you there.\n\n# 1:1 overlay\nThe plan over your rooms in passthrough, full size, in place. Walls and furniture outlined where they stand, named and measured.\n\n# Miniature\nYour whole home as a model before you. Turn it, zoom in, click the stick to reset.\n\n# Floor plan\nA flat sheet you can pan and zoom: wall lengths, room areas, doors and windows as real openings, furniture in its footprint, and a marker where you stand.\n\n# Squared up\nThe same plan as an architect draws it: walls pulled onto the building's axes, partitions fused to their real thickness, corners closed. Black ink on white paper.\n\n# Take it with you\nThe trigger saves the sheet to Pictures/ScanToPlan as a print-size picture, and an SVG beside it - to a stated scale, with walls, furniture, dimensions and labels on separate layers, text still text. Edit it in Inkscape, Illustrator or Figma.\n\n**Free:** the overlay and the miniature in full, every object named and measured. The two floor-plan sheets are locked - the drawing shows, but with no numbers or names on it. One purchase unlocks them and the export.\n\nMeasurements come from the headset's scan and are only as good as it is; nothing in the plan is drawn by hand.", "short_description": "Your headset can map your home itself - the walls, doors, windows and furniture. Set your space up once, and the 2D plan is waiting. Scan to Plan draws it as a real floor plan: over your rooms at full size, as a model you can turn, and as a flat sheet with wall lengths and room areas. Save it as a print-size picture and an editable SVG, to a stated scale.\n\nFree: the overlay and the miniature, every object named and measured. One purchase adds the lettering on the plan and the exported files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ScanToPlan/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/ScanToPlan", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
w&oe=69A450AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1334256947955305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75593946_1334256951288638_1116573229560650072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYEAlaChNhAQ7kNvwH0aipi&_nc_oc=Adm2nRzTK991xshN1UAB9DhT269CzzFs31KRVFGcpZfKO-x1mUfEgOM1C72lRgXc4e8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv4mJuPL1cj9g-X9pglnO1Vr3MsvQQ2R-X2ajxW_Z-EUQ&oe=69A41E9A"}, "display_name": "Trash Stan", "keywords": ["zen", "job", "city", "dungeon", "casual"], "long_description": "Step into the shoes of Stan, a lovable troublemaker sentenced to community service for being \u2018naughty.\u2019 Armed with your trusty trash picker, it\u2019s your job to clean up the town from the park to the...dungeon?  But this isn\u2019t your ordinary cleanup\u2014go from trash collector to roach wrangler and more as Stan's community service rolls on.\n\nUnlock new pickers, decorate your space, and prove you can clean up your act\u2014literally! With addictive gameplay and a fun atmosphere, Trash Stan brings a unique twist to VR gaming. Are you up for the challenge?\n\nGet ready to take out the trash\u2026 or end up stuck in the slammer!", "short_description": "Step into the shoes of Stan, a lovable troublemaker sentenced to community service for being \u2018naughty.\u2019 Armed with your trusty trash picker, it\u2019s your job to clean up the town from the park to the...dungeon?  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/copy-of-brite-light", "developer_terms_of_service_url": null, "publisher_name": "One Games LLC", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489
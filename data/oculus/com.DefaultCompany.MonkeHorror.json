fTDgi-6jRyQFen8zlXj87VsIyUmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BTM61y9DvUcdlalb1PVxbpPdQA4s7rPHykQAgGRhEVg&oe=6A3FE47B"}, {"file_name": "pic1.png", "id": "1198122168706225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1198122172039558_6244403153351740047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7YBdl79UosQ7kNvwEiJA2b&_nc_oc=Adpp3l8j4-lW7e1S5AMVB7h0MJFweVk8gzyKdZBCTS3Kap3i45NQc8zcyYHBLBnXAgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87odC2mBgBrfLd-xJJ15HRFSifXkkARrkJwXFeBlt33A&oe=6A3FD8EE"}, {"file_name": "pic2.png", "id": "682995450741819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_682995454075152_7596266526118440670_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y89AfgqovBwQ7kNvwFg0mb_&_nc_oc=Adp37um2UQhJ0iqufgZQPyJrOvDYWg-mlyvkUzJPosLbo4pSvChDO_pscmBG9sH_HR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MZlaDyppaloYN0Jqq-T0Chi5D9tRQGlccRJtSqwf0Ww&oe=6A3FD23A"}, {"file_name": "pic5.png", "id": "988021200064951", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_988021203398284_7536728147778215898_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcC3ZGLxEvAQ7kNvwGgOrYT&_nc_oc=AdrgksFpqEh_6mHUdHQw_oNpWXBReUow7Q8WVxarqbvrkGYCD01W_gnJkNWZUjAiRcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Oj_m9D6zaGGlunX_yATAsRtiCePq8lFIcrLrQD6mqnA&oe=6A3FC8C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Horror", "keywords": ["Monke", "Horror", "Scary", "Gorilla", "Animal"], "long_description": "\ud83d\ude31 MAPS \ud83d\ude31\nMonke Horror is a terrifying VR game where you and your friends explore the eerie and decayed facility with flickering lights and unsettling sounds. Each area hides new dangers, keeping you on edge as you search for a way to escape.\n\n\ud83d\udc7b MONSTERS \ud83d\udc7b\nLurking in the shadows are relentless creatures that stalk your every move. Some are fast, some are cunning, and others wait patiently for the perfect moment to strike. They see, hear, and hunt\u2014so stay out of sight, keep quiet, and don\u2019t let them catch you.\n\n\ud83e\udd1d WORK TOGETHER \ud83e\udd1d\nSurvival isn\u2019t easy alone. Communicate with your team, find safe hiding spots, and use your surroundings to stay one step ahead of the monsters. Will you escape together or be picked off one by one?", "short_description": "Monke Horror is a terrifying VR game where you and your friends explore an abandoned facility, trying to survive relentless monsters. These creatures stalk your every move, using sight and sound to hunt you down. Stay quiet, hide, and work together to escape before it\u2019s too late. Every shadow hides danger\u2014will you make it out alive, or will the monsters get you first?"}]}, "developer_name": "Banan Games", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Banan Games", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7777782315678808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "645234118302041"}]}, "baseline_
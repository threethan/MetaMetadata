354999_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lFloMl20tIQ7kNvwGoiIQU&_nc_oc=AdqsqoYoAQ8WBhG7EsQkeYG-tr5Lbn9KnfHPWAXxdILo5OWJh9qP4wQ7_SUergwpnMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNT-J6GvPl8lpepnXvBCn4gPxwGmSznhwJqj559CL-yw&oe=6ABD22FB"}, {"file_name": "pic1.png", "id": "1198122168706225", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_1198122172039558_6244403153351740047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyKLy1AS74Q7kNvwE3izRq&_nc_oc=AdoBYRhrmWPXAVhR1UmYcAA4gmBV_qQwGpm5kKwVfmj2Apt0y434LouJUB4km2BUhuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-0sRrAcS0Zhjw6zSs4QHm3nLxtdFxBZUynM5GfvpteQ&oe=6ABD176E"}, {"file_name": "pic2.png", "id": "682995450741819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_682995454075152_7596266526118440670_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POkhqWXsGwsQ7kNvwG6zk6c&_nc_oc=Adpe5ultxoAozWoYb2oE_O3lFAujWDzc7SxDWBxrv9G4XNbj1uSKPGbOf83nLvEw6QA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-yNBs1x3jl43Ri2Z8aVuyXdHBvEAyITMDEwdr8rKp0g&oe=6ABD10BA"}, {"file_name": "pic5.png", "id": "988021200064951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_988021203398284_7536728147778215898_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWDMIcIQgicQ7kNvwF-F_1d&_nc_oc=Adpp06cOuvnOmWZivONSEoa2tASHnar-TvLiC8a1KhPbybxZTIVHZSYc9omOx8Ywq24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrzjUQZSVHK_5WfRPbRMK8VIN-4JkEKHDwHBvntKSXIA&oe=6ABD0747"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Horror", "keywords": ["Monke", "Horror", "Scary", "Gorilla", "Animal"], "long_description": "\ud83d\ude31 MAPS \ud83d\ude31\nMonke Horror is a terrifying VR game where you and your friends explore the eerie and decayed facility with flickering lights and unsettling sounds. Each area hides new dangers, keeping you on edge as you search for a way to escape.\n\n\ud83d\udc7b MONSTERS \ud83d\udc7b\nLurking in the shadows are relentless creatures that stalk your every move. Some are fast, some are cunning, and others wait patiently for the perfect moment to strike. They see, hear, and hunt\u2014so stay out of sight, keep quiet, and don\u2019t let them catch you.\n\n\ud83e\udd1d WORK TOGETHER \ud83e\udd1d\nSurvival isn\u2019t easy alone. Communicate with your team, find safe hiding spots, and use your surroundings to stay one step ahead of the monsters. Will you escape together or be picked off one by one?", "short_description": "Monke Horror is a terrifying VR game where you and your friends explore an abandoned facility, trying to survive relentless monsters. These creatures stalk your every move, using sight and sound to hunt you down. Stay quiet, hide, and work together to escape before it\u2019s too late. Every shadow hides danger\u2014will you make it out alive, or will the monsters get you first?"}]}, "developer_name": "Banan Games", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Banan Games", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "77
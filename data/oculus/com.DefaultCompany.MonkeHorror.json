&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHAVgvPqUGdZgZR0GRwnCrFZKQAW80mH1vYMss-8eSzw&oe=6B0B117A"}, {"file_name": "pic5.png", "id": "988021200064951", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392010_988021203398284_7536728147778215898_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU47-A4HLRIQ7kNvwELNm4v&_nc_oc=AdpaFvZ9350SlKdmWY1qOJSAulHzJWckTlVTMITmth80ONU9PQfJgzC_HHiBvaMNBcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSev4txPlztz4Xq3DpPOpTAQLgDeOBCg9wHZ_LaFWxQFQ&oe=6B0B4047"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Horror", "keywords": ["Monke", "Horror", "Scary", "Gorilla", "Animal"], "long_description": "\ud83d\ude31 MAPS \ud83d\ude31\nMonke Horror is a terrifying VR game where you and your friends explore the eerie and decayed facility with flickering lights and unsettling sounds. Each area hides new dangers, keeping you on edge as you search for a way to escape.\n\n\ud83d\udc7b MONSTERS \ud83d\udc7b\nLurking in the shadows are relentless creatures that stalk your every move. Some are fast, some are cunning, and others wait patiently for the perfect moment to strike. They see, hear, and hunt\u2014so stay out of sight, keep quiet, and don\u2019t let them catch you.\n\n\ud83e\udd1d WORK TOGETHER \ud83e\udd1d\nSurvival isn\u2019t easy alone. Communicate with your team, find safe hiding spots, and use your surroundings to stay one step ahead of the monsters. Will you escape together or be picked off one by one?", "short_description": "Monke Horror is a terrifying VR game where you and your friends explore an abandoned facility, trying to survive relentless monsters. These creatures stalk your every move, using sight and sound to hunt you down. Stay quiet, hide, and work together to escape before it\u2019s too late. Every shadow hides danger\u2014will you make it out alive, or will the monsters get you first?"}]}, "developer_name": "Banan Games", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Banan Games", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7777782315678808"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391858_622004687304329_7341809933223832649_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDzs286ND9MQ7kNvwHk_zcO&_nc_oc=Adqkiy-kI_a1tR5mKKWVzlsRZA1jZy6XSbsBYWSRM3UKj5a3KuMM2bibMaIVb8MzuFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwHmWa1nPqfCLi5AbOIfJZoVeKNd2d0oz9_BDAJlusWg&oe=6B0B1CCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1744235880, "lastRevision": {"nodes": [{"id": "7708555695934804", "release_type": "SCHEDULED", "administra
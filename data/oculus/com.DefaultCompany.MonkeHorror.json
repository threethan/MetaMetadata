DVfUfl6kaVZPuPl-eFw9AawI0U7mwuVNYMxY_iqaJW1ojWU9LIKCrN5-89K6rh_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDuzZyEzv8iWN_ikR74Ea5VtOtTH1gnw2-tVkrOWaNFQ&oe=69A04E3B"}, {"file_name": "pic4.png", "id": "908368164592375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_908368167925708_1895023543346354999_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjVg-yH7K0gQ7kNvwEmRlJa&_nc_oc=AdkD8DroPAJwHTlUcLy98gxwVBdnKIo9Uq6jr_1fKG4DHGFvJcr-MOvMoJkJ3405DOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1BT7QUDpPIgp2z6Qw1ivCXEwpkTQVMo0xYs9hvtY2eA&oe=69A026BB"}, {"file_name": "pic1.png", "id": "1198122168706225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392309_1198122172039558_6244403153351740047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bIZWHNaeogQ7kNvwEn__jr&_nc_oc=AdlowHoQRFhV9BFTOPtJLs7yHUp6FyqlOTI5UGwb8bs13FPYiEfja4yjXAapzdmbbLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUcjP0RfR26r-Sxx21K07MbczzrqH8JCUMkQ-SLXAuNw&oe=69A0536E"}, {"file_name": "pic2.png", "id": "682995450741819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_682995454075152_7596266526118440670_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-OeFWG6XkIQ7kNvwEX_b_z&_nc_oc=Adn5JZ5_tyb0N2UaZL5mxsM-NwOp7YlgqSSwGb_KZ2EpjTva2a533ke3y4RU4apoHMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2ReOaDcoGK1ADtJUnkaui3WDTmT0m4QRKvAqtBevhqA&oe=69A04CBA"}, {"file_name": "pic5.png", "id": "988021200064951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_988021203398284_7536728147778215898_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eVxt40czIIQ7kNvwEgsg9l&_nc_oc=AdkRug5BuxuD0TpUIe84WwJA-lUYJsuF25gbedRfUSJd42YuJZ7UhHqHRoyjLQHD63s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7HwJ_U5SoMoq9w0EtRF-4gAMO9ISi4wuYSKy1YACL6Q&oe=69A04347"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Horror", "keywords": ["Monke", "Horror", "Scary", "Gorilla", "Animal"], "long_description": "\ud83d\ude31 MAPS \ud83d\ude31\nMonke Horror is a terrifying VR game where you and your friends explore the eerie and decayed facility with flickering lights and unsettling sounds. Each area hides new dangers, keeping you on edge as you search for a way to escape.\n\n\ud83d\udc7b MONSTERS \ud83d\udc7b\nLurking in the shadows are relentless creatures that stalk your every move. Some are fast, some are cunning, and others wait patiently for the perfect moment to strike. They see, hear, and hunt\u2014so stay out of sight, keep quiet, and don\u2019t let them catch you.\n\n\ud83e\udd1d WORK TOGETHER \ud83e\udd1d\nSurvival isn\u2019t easy alone. Communicate with your team, find safe hiding spots, and use your surroundings to stay one step ahead of the monsters. Will you escape together or be picked off one by one?", "short_description": "Monke Horror is a terrifying VR game where you and your friends explore an abandoned facility, trying to survive relentless monsters. These creatures stalk your every move, using sight and sound to hunt you down. Stay quiet, hide, and work together to escape before it\u2019s too late. Every shadow hides danger\u2014will you make it out alive, or will the monsters get you first?"}]}, "developer_name": "Banan Games", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Banan Games", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
7724_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ6lI3op3H0Q7kNvwGPSYnt&_nc_oc=AdoFG5EqoytIwEnuRRsS_anW3-5seEGlOtBRzy_Y-6GFiyxkSfP7ySdJlphMZ5-i3cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBjI0tABnveFl1xC0aUQuj7moukwi7V042vKWqEAsmFw&oe=6A57757E"}, {"file_name": "1.png", "id": "1541406710594942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393984_1541406713928275_3102148783000087905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jmP0v9uj8IQ7kNvwGOd3hI&_nc_oc=AdpWr-B_5y58v8AnO1b63szcD3J3szDglJambwvodlXXfZDTJ41hPt64qT89mxBwAe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8e4QGVELZ7Nj1jAng3uD06bOeaNNDg2yV4FUjZM_WRg&oe=6A579292"}, {"file_name": "5.png", "id": "2207712706297496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_2207712709630829_8526679622199165043_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaSAXoaB3kQQ7kNvwFqaFAl&_nc_oc=Adq0OEsWALK-Di7PWNVp2BXhdBw447daKfd4Rg9seONUuXHz1CaqHsKkQ6R_mG74nRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA29e2enONi6Gc90x42M3ocgUqQC1L2UUAAU0gvEGuzIA&oe=6A578F66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safari Escape: Wild Shooting Game", "keywords": ["shooting", "animal", "action", "gun", "horror"], "long_description": "Sitting on the back of a Safari Jeep, you are on the run from wild animals chasing you.\n\nThe speed of the chasing animals exceeds that of your jeep, leaving you with no choice but to shoot the animals before they hunt you down. With a variety of weapons at your disposal and unlimited ammunition, you must survive this fast-paced, action-packed thriller.\n\nEnjoy the intense adventure and test your shooting skills as you fend off relentless wildlife in this thrilling safari escape!", "short_description": "Sitting on the back of a Safari Jeep, you are on the run from wild animals chasing you.\n\nThe speed of the chasing animals exceeds that of your jeep, leaving you with no choice but to shoot the animals before they hunt you down. With a variety of weapons at your disposal and unlimited ammunition, you must survive this fast-paced, action-packed thriller.\n\nEnjoy the intense adventure and test your shooting skills as you fend off relentless wildlife in this thrilling safari escape!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9553967258000146"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_461713760132809_4685869189213246721_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1WCKCl9KM4Q7kNvwHhvlvy&_nc_oc=AdqOlDNUVPGlLZWGTc8bk4HsadGbUZF6UnilYTt6tWrwYHl4DZfwr97UtH5CZwEUuGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoBUiPWcNuHwdY2ZURJP8LMY9JEB22ww3Q4bVoRZapDg&oe=6A577B40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Safari Escape: Wild Shooting Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332
aving you with no choice but to shoot the animals before they hunt you down. With a variety of weapons at your disposal and unlimited ammunition, you must survive this fast-paced, action-packed thriller.\n\nEnjoy the intense adventure and test your shooting skills as you fend off relentless wildlife in this thrilling safari escape!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9553967258000146"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222944_461713760132809_4685869189213246721_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o5hVwMDe8IQ7kNvwEZGPBI&_nc_oc=AdqwSSUwTr7_QUeQn7XNLO-1ZMg93SWsR3kg0p5msdMYX63o6porUUOFeOOmRX7EfvQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpgBD-QLO9KtGpWrTL-fGsQF4Fd-3lXoq_dEqNphI4nw&oe=6AECAD00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Safari Escape: Wild Shooting Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332
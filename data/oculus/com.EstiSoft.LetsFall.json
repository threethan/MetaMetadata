": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402515_1117783843200303_2220130724782330489_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHMUp4PJ3L8Q7kNvwE13rZB&_nc_oc=Adrfxhg-ylP2dV73xhajs1eg8yfEUlG4AKuw61dkUHs9YMHVpFYRcXX3npuTN2c2JJY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0fu3zJziJDG4hrus05E4iO_I9v5PUffLh3V_4S0AA5Q&oe=6AFC8A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-15 142414.png", "id": "579802987787916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462204_579802991121249_288296569813625707_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TELC0ZPU_6QQ7kNvwGkumV-&_nc_oc=AdqkdDj9hNbn4m2EpiMn2jLShhdm5kYpskUS_z0pJAJinT1MvYReBk9eIXgNhLxGKmg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHMj9OIVEA1i-iey4t77G3sDNPn0LjyNakIkbE9CuNRA&oe=6AFC6FAB"}, "display_name": "Lets Fall", "keywords": ["Elite", "Pet", "Comfort", "Fall", "Ragdoll"], "long_description": "Experience the exhilarating journey of \"Let's Fall\", a game that combines speed, strategy, and precision. Set in a vibrant world of dynamic challenges, this game invites you to navigate through levels teeming with obstacles, surprises, and opportunities for creative problem-solving. As you descend, adapt quickly to changing scenarios, utilize unique mechanics, and perfect your strategy to overcome each challenge.\n\nWith stunning graphics designed to immerse you in a fast-paced environment, \"Let's Fall\" offers an experience that\u2019s both visually captivating and intensely engaging. Compete with friends or players worldwide on leaderboards to claim your place as the ultimate falling master. The game\u2019s intuitive controls make it easy to learn, but its progressively challenging levels ensure endless excitement for players of all skill levels.\n\nWhether you\u2019re looking for a casual adventure or a competitive challenge, \"Let's Fall\" promises hours of entertainment. Embrace the thrill, take control of the fall, and prove your mastery in this action-packed descent! Are you ready to jump in and redefine your limits?", "short_description": "Dive into the thrilling world of \"Let's Fall\", a fast-paced game that challenges your reflexes and strategic thinking. Navigate through dynamic levels filled with obstacles, surprises, and adrenaline-pumping moments. With immersive visuals and engaging gameplay, each fall becomes an unforgettable experience. Compete with friends, climb the leaderboards, and master the art of controlled descent. Are you ready to take the leap and prove your skills?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/lets-fall", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2776542286000603"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8700064386772191"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "4418716578413891"}, {"status": "PUBLISHED", "id": "725422930628592"}, {"status": "PUBLISHED", "id": "896005466204228"}, {"status": "PUBLISHED", "id":
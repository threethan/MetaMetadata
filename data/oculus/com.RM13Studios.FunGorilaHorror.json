eaa Cartoon cats CREEPY caves\n\ud83d\udeaa A broken glitch level\n\ud83c\udf32 Or relax in a chill forest where you can try on cosmetics\n\nExplore solo or with friends in multiplayer. No combat \u2014 just wacky robots, weird levels, and freedom to play your way.", "short_description": "Robot Run is a VR game where you play as a robot that moves using only your hands. Run, climb, and explore through a variety of themed levels \u2014 each one accessed through a door you can enter or leave anytime.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/robot-run-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "RozzaM13/Roairi", "support_website_url": null, "website_url": "https://sites.google.com/view/robot-run-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24331141503234340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_692168656662212_5543533552271846957_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYvVcY8kD7MQ7kNvwFkBF-P&_nc_oc=AdrVEWpFiKCqsCWwSo0I8bnVJxsjhf027nhjXEATcbQINIC7QVCERIN8GVExaYJYAEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj21zvo_q3a_-f5Rp7tOhooj82p9A9VbhvuCrksB4PDw&oe=6B01CBE6"}, "is_concept": false, "is_te
a&_nc_ohc=1CESOdLkOgIQ7kNvwHOrWZg&_nc_oc=Ado8jImMTKce_ptlhOl_dkszb8XWetUscTFg0FjpPLOd86_z7gEdqG9WPD0EZx-FQUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NhR4XfxIPigLXeypaeh3w9RFiyIkatjMdR-oOR1PQYA&oe=6A315AAB"}, "display_name": "DrByVR", "keywords": ["simulation", "experience", "VR", "Fear"], "long_description": "DrByVR is a virtual reality\u2013based application designed to provide immersive experiences that support individuals in exploring and managing common fears in a controlled digital environment.\n\nUsing interactive VR simulations, the application presents a variety of carefully designed scenarios that allow users to gradually experience situations associated with everyday fears. These experiences are structured to be progressive, enabling users to engage at their own pace within a safe and controlled virtual setting.\n\nDrByVR is intended to be used as a supportive tool alongside guidance from qualified professionals. The application does not provide medical advice, diagnosis, or treatment. Instead, it offers interactive environments that can complement existing wellness or therapeutic practices when used responsibly.\n\nThe platform includes a range of immersive environments inspired by real-world situations. Each experience is designed with user comfort and safety in mind, allowing gradual interaction and user-controlled progression.\n\nKey Features:\n\nImmersive virtual reality environments designed for controlled exposure experiences\n\nStructured and progressive scenarios that adapt to user comfort levels\n\nDesigned for use alongside professional guidance\n\nFocus on user safety, comfort, and controlled interaction\n\nDrByVR aims to make immersive technology accessible as a supportive tool for personal development and guided wellness practices.", "short_description": "DrByVR is a virtual reality therapy application that helps patients gradually overcome phobias through controlled exposure simulations under the guidance of medical professionals.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drbyvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Websultante Software Technologies Pvt Ltd", "support_website_url": null, "website_url": "https://websultanate.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25173342985675150"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1576617336969767"}]}, "baseline_offer": {"id": "1576617336969767"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776228960, "status": "PUBLISHED", "id": "1576617336969767"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26055691364106970", "version": "0.1.9"}, "id": "1323464619586151", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25173342965675152", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26055691364106970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1323464619586151"}]}, "change_log": null, "created_date": 1780060676, "id": "2605569136410
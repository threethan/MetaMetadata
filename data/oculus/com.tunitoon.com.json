dbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon trong VR 360\u00b0"}, {"images": {"nodes": [{"file_name": "logo.png", "id": "37179831824998269", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_37179831841664934_740598208572202506_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmjwvVy3ZQcQ7kNvwH8eh2w&_nc_oc=Adri3VdIHUlUlduqB8XFf049Y_oM2IUp8GSQk16t3H3fsoks7ztwbC-7aOR-8h7v2I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJKBAi0s4J7Tb4geynhsfrWiaGJM7SUIL0ej8AXQFhBQ&oe=6B01DC13"}, {"file_name": "Hero Cover_en.png", "id": "4560184370922822", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628016_4560184374256155_2105370256912304772_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ-fXvETu3AQ7kNvwHoH1-J&_nc_oc=Adpd-U40jEcZtAnJ4T7JAP0xB1xUulQmPRgZwmHZrOSu2sxptKQinvC29M2YwvT-riI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSjh33JJzWq7C7dzfN4dOV9YZUveuHLz73TfLdt2Q7YA&oe=6B01CC38"}, {"file_name": "Cover Portrait.png", "id": "1776128107139264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620875_1776128110472597_8384713945383198578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUT-JKl0uxsQ7kNvwHb-8RE&_nc_oc=AdoahYHHw9b4Eac-c32qraIHSplct2YuMMBwNgFh0KPp-Hg9nT8yBg_1rc-k-4Q5Y1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlux_N7lkKTWC9OrnYJNREIgp7It9_DV36uIXIpwSW3w&oe=6B01E85B"}, {"file_name": "Cover Square.png", "id": "1389421576364685", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://sco
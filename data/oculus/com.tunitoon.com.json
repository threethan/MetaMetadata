dbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon trong VR 360\u00b0"}, {"images": {"nodes": [{"file_name": "logo.png", "id": "37179831824998269", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623384_37179831841664934_740598208572202506_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwphygrz2OUQ7kNvwFA5mfx&_nc_oc=AdovvkkvZgLGw2PQtKAnTS9kfZsbnQ7WurvxguCXjoIDe2w3EzXnUjQy0GbGp816lUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu7U7q0Hb5dpdkC3nlQrGnbqNQYNkNrtLpfYMBGXP7mQ&oe=6AFF00D3"}, {"file_name": "Hero Cover_en.png", "id": "4560184370922822", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_4560184374256155_2105370256912304772_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb-eLTk2eX4Q7kNvwEdkADZ&_nc_oc=AdpIxPRXyyoDR53O-9mcyuD9B8mWLRLbr-Uva-JJMiJVJXgpnKSZbqTaOdPeu_zkQKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZeRC73Cp6P4XlcpSVpXVEEGus8P_jUrgDE0FJDw8pHA&oe=6AFF2938"}, {"file_name": "Cover Portrait.png", "id": "1776128107139264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1776128110472597_8384713945383198578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUT-JKl0uxsQ7kNvwFP0Rya&_nc_oc=AdotC-q3RJvbYFEJbn_Qz-GyWWqlRwn3flRp4zHBh1WM2rTHzc3DVbVspUA9QRabkKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBMJt8Qn_Ubn-aRp21HhVodjDQbdQsvBAchh_vJeuh1A&oe=6AFF0D1B"}, {"file_name": "Cover Square.png", "id": "1389421576364685", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://sco
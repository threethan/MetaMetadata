dbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon trong VR 360\u00b0"}, {"images": {"nodes": [{"file_name": "logo.png", "id": "37179831824998269", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_37179831841664934_740598208572202506_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmjwvVy3ZQcQ7kNvwEejKqk&_nc_oc=AdqFg37Fln85yhetud_VitL_AlgZ-5WClt_RREAY0Knn4Wc5HV77c4U5mq-M8sGC8RQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiD0VAbY8tBJg6GvNr3NaRNGHLC2xmg_tOMjPHdmxdUg&oe=6B05D093"}, {"file_name": "Hero Cover_en.png", "id": "4560184370922822", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628016_4560184374256155_2105370256912304772_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQRbUMQIvVoQ7kNvwE2GLP6&_nc_oc=Adr3zxo-eSH3O5-NaQdMQFgS70UK2zTlUzB3DePrbB_hCtABu3poH32SRbf3Nx1nfig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-0Dz8hO5WmTrtG5J9PuVnLGS1UVnFQBRKTv0Ov6iZyw&oe=6B05C0B8"}, {"file_name": "Cover Portrait.png", "id": "1776128107139264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620875_1776128110472597_8384713945383198578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D50bdnX9lJsQ7kNvwEyFpCZ&_nc_oc=AdqsHUv3A3umrptbcSa_wkjpLUpB5hvHDTsKscjQF2sWWFnZ8EuiXaJTWPwg-d8ukpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd5ShVqIRXmZQbFFcUU--F0tovApb1uX1FY2Mvx4igKw&oe=6B05A49B"}, {"file_name": "Cover Square.png", "id": "1389421576364685", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://sco
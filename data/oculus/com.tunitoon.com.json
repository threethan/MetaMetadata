hot 04 Eng.png", "id": "4154472498173871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617671_4154472501507204_5166571359070002882_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tJnnSzSoXQQ7kNvwF4pDim&_nc_oc=AdoF7aAmIysYRW2BC9byLsfQrTqV0n7Efc2p486NKLLDmSzSwi_2nMpizdKK_yThgAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjXAW6AWrh1SZU5kLtWJcI7IYlgDmZIUfsL-b9mCafmg&oe=6AE5E93F"}, {"file_name": "Screenshot 05 Eng.png", "id": "1484762776009521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294603_1484762779342854_6271209958698214424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkVsb6H03GQQ7kNvwFLRVkZ&_nc_oc=AdqfhV1gU7thnxWOpKEzpps9EIHERRi6J6GUjhURy9lauE3zLhKW2b7rRPYkbMg76no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcUeGCl5h4NiwaWFPMXwSvpO3_qxRucDN3kKlVZasHtg&oe=6AE608B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuni", "keywords": [], "long_description": "Dive into a new way of experiencing webtoons with immersive VR storytelling. This app brings comics to life in 180\u00b0 and 360\u00b0 environments, surrounding you with vibrant scenes and dynamic panels that unfolds all around you. Instead of simply reading, you'll step inside each story, watching as characters and worlds come alive in an entirely new dimension. Perfect for fans who want to experience their favorite webtoons like never before.", "short_description": "A new way to enjoy webtoons in 360\u00b0 VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tunitoon.com/policy", "developer_terms_of_service_url": "https://tunitoon.com/terms", "publisher_name": "Tuni", "support_website_url": null, "website_url": "https://tunitoon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_
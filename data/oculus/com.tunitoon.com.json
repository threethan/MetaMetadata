dbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon trong VR 360\u00b0"}, {"images": {"nodes": [{"file_name": "logo.png", "id": "37179831824998269", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623384_37179831841664934_740598208572202506_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcQvI-ShySsQ7kNvwG3OUcI&_nc_oc=Adqdu7NNjGTdxNIerYnhryzMoXcaAe1p2LO2U1gb8cxqItMPLmVvOjj-lsxftboxbSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYxfZfhUGfnd5njz048XDjHx2pWnHqek3DHos9aYOV8g&oe=6B105C93"}, {"file_name": "Hero Cover_en.png", "id": "4560184370922822", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628016_4560184374256155_2105370256912304772_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfH8ADbnHo4Q7kNvwFkJVMQ&_nc_oc=Adqphk-y4nCeOKfK5IaXKd1XGwPUw2SqUrWh9tVDJkAi_eWIBOjFNWiNtbxIY9jyqXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmvhdXd6V73Y6RsjxjksF-HTmSh3rwppC03R21Ywqwcg&oe=6B104CB8"}, {"file_name": "Cover Portrait.png", "id": "1776128107139264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620875_1776128110472597_8384713945383198578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOzhSE6GEFoQ7kNvwFzud1L&_nc_oc=Adogvpo0Ow8rS2eRMeFV3bOx44TPakyMVcOxwUa_jAwcanOMI7t0ytOiKn0iMjRRLfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2QPWv2Y3_fwa0uw-fsMmTLBsiDxRoRAUdNk7j71Lz0Q&oe=6B1068DB"}, {"file_name": "Cover Square.png", "id": "1389421576364685", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://sco
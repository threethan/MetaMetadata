=1-7&_nc_sid=6e7a0a&_nc_ohc=0jcAvyCDG7gQ7kNvwER6fnH&_nc_oc=AdomZJukAeP-dvx14e6og3VDysWp3LsZARuCqoN9VHsdW0PY-sGvWw2YSc4NZW1Kakg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFzT5mZfBpbZzZTzeVtcFtjcZ74jmGfXkZ79Up7xs_SQ&oe=6AEB56A9"}, {"file_name": "Screenshot 05_ve.png", "id": "2244216989645705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_2244216992979038_8648764824180545328_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Owkn4JiLDPQQ7kNvwEiSDaJ&_nc_oc=AdpbOpbH62PIlk6_3me3fDUbOGFJIEnzUaQU5HY3CWTkISynsuL0eW_0MzvwCDCaQgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvIqkWdDdzALLuftERAG4eWggwFzto1HU2umIYeK3DhA&oe=6AEB4A4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuni", "keywords": [], "long_description": "Kh\u00e1m ph\u00e1 m\u1ed9t c\u00e1ch ho\u00e0n to\u00e0n m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon th\u00f4ng qua ngh\u1ec7 thu\u1eadt k\u1ec3 chuy\u1ec7n VR s\u1ed1ng \u0111\u1ed9ng. \u1ee8ng d\u1ee5ng n\u00e0y \u0111\u01b0a truy\u1ec7n tranh v\u00e0o \u0111\u1eddi th\u1ef1c trong kh\u00f4ng gian 180\u00b0 v\u00e0 360\u00b0, bao quanh b\u1ea1n b\u1eb1ng nh\u1eefng khung c\u1ea3nh r\u1ef1c r\u1ee1 c\u00f9ng c\u00e1c khung truy\u1ec7n \u0111\u1ea7y chuy\u1ec3n \u0111\u1ed9ng m\u1edf ra \u1edf m\u1ecdi h\u01b0\u1edbng. Thay v\u00ec ch\u1ec9 \u0111\u01a1n thu\u1ea7n \u0111\u1ecdc truy\u1ec7n, b\u1ea1n s\u1ebd b\u01b0\u1edbc v\u00e0o b\u00ean trong t\u1eebng c\u00e2u chuy\u1ec7n v\u00e0 ch\u1ee9ng ki\u1ebfn c\u00e1c nh\u00e2n v\u1eadt c\u00f9ng th\u1ebf gi\u1edbi tr\u1edf n\u00ean s\u1ed1ng \u0111\u1ed9ng trong m\u1ed9t chi\u1ec1u kh\u00f4ng gian ho\u00e0n to\u00e0n m\u1edbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\
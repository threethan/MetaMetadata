dbi. \u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o d\u00e0nh cho nh\u1eefng ng\u01b0\u1eddi h\u00e2m m\u1ed9 mu\u1ed1n tr\u1ea3i nghi\u1ec7m webtoon y\u00eau th\u00edch theo c\u00e1ch ch\u01b0a t\u1eebng c\u00f3.", "short_description": "M\u1ed9t c\u00e1ch m\u1edbi \u0111\u1ec3 th\u01b0\u1edfng th\u1ee9c webtoon trong VR 360\u00b0"}, {"images": {"nodes": [{"file_name": "logo.png", "id": "37179831824998269", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623384_37179831841664934_740598208572202506_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWMOD45zX8MQ7kNvwFhgw_T&_nc_oc=AdqHE9K4d0LTb9YEBuxMCxl963omsekOobbhwYLcn-9oNSXBAGRNG00NkbO-1D7HfGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_o1J181RJ4iEzePK5oDRArJezuUtE_GIVG-pbwvNcSw&oe=6B09C513"}, {"file_name": "Hero Cover_en.png", "id": "4560184370922822", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_4560184374256155_2105370256912304772_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3FeKO7WDIgQ7kNvwE_PY30&_nc_oc=AdpVEAx8hMDDkeUtOQur0-U9NsnOGbPDKAWOf0yJAiAJZ5ZP54hhd9n5VXL552jB-VI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM71EX1qyyDOZhdyb30z09BeW9XDHyhL4m2QSrhy-qRg&oe=6B09B538"}, {"file_name": "Cover Portrait.png", "id": "1776128107139264", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1776128110472597_8384713945383198578_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ozIGQ07SY8Q7kNvwG2WaGj&_nc_oc=AdoS5_6Lu594nDeaS9FXRlkYJCFrFsJcfXErj2PMGDZXQoUHbBC5JYbwsHWzCuCFoOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToEe_aqGdBWEVCV0vgCMW0b8keaQJHEhrP5xVuD5JoPQ&oe=6B09991B"}, {"file_name": "Cover Square.png", "id": "1389421576364685", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://sco
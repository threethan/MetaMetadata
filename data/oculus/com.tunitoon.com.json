er": null, "video_trailer_thumbnail": null, "display_name": "Tuni", "keywords": [], "long_description": "\ubab0\uc785\uac10 \uc788\ub294 VR \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc73c\ub85c \uc6f9\ud230\uc744 \uacbd\ud5d8\ud558\ub294 \uc0c8\ub85c\uc6b4 \ubc29\uc2dd\uc744 \ub9cc\ub098\ubcf4\uc138\uc694. \uc774 \uc571\uc740 180\u00b0\uc640 360\u00b0 \ud658\uacbd\uc5d0\uc11c \uc6f9\ud230\uc744 \uc0dd\uc0dd\ud558\uac8c \uad6c\ud604\ud574, \uc8fc\ubcc0\uc744 \uac00\ub4dd \ucc44\uc6b0\ub294 \uc7a5\uba74\uacfc \uc0ac\ubc29\uc73c\ub85c \ud3bc\uccd0\uc9c0\ub294 \ub2e4\uc774\ub0b4\ubbf9\ud55c \ud328\ub110\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uc21c\ud788 \uc77d\ub294 \uac83\uc744 \ub118\uc5b4, \uc774\uc57c\uae30 \uc18d\uc73c\ub85c \uc9c1\uc811 \ub4e4\uc5b4\uac00 \ub4f1\uc7a5\uc778\ubb3c\uacfc \uc138\uacc4\uac00 \uc0b4\uc544 \uc6c0\uc9c1\uc774\ub294 \ubaa8\uc2b5\uc744 \uc644\uc804\ud788 \uc0c8\ub85c\uc6b4 \ucc28\uc6d0\uc5d0\uc11c \uac10\uc0c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc88b\uc544\ud558\ub294 \uc6f9\ud230\uc744 \ud55c\uce35 \uc0c8\ub85c\uc6b4 \ubc29\uc2dd\uc73c\ub85c \uc990\uae30\uace0 \uc2f6\uc740 \ud32c\ub4e4\uc5d0\uac8c \uc774\uc0c1\uc801\uc778 \uacbd\ud5d8\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4.", "short_description": "360\u00b0 VR\ub85c \uc990\uae30\ub294 \uc0c8\ub85c\uc6b4 \uc6f9\ud230 \uacbd\ud5d8"}, {"images": {"nodes": [{"file_name": "Cover Square.png", "id": "4199970063575040", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618235_4199970066908373_7613044711278194056_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k__UFsGJTpwQ7kNvwGmvsm4&_nc_oc=AdorM4oIBHh0cswNrCkkKwPMnU9GCqA4TGnJCjN-acs-ayuHJJcUetI7NpaYmQ1seIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELhUnPF7uJHFZBPfH-gjIm6pwUAjLoaQA4-Rn4SDN0sA&oe=6A70A5C7"}, {"file_name": "Logo.png", "id": "1819485322031155", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618013_1819
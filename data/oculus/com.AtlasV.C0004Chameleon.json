D9F7"}, {"file_name": "Screenshot 5.png", "id": "1761768241918259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1761768245251592_6440625786470970162_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTW_KnOgxssQ7kNvwE8Ed6q&_nc_oc=AdpLl8PFWOwm6tYdICXcugLR2f-wLqvbEupMgluB8dxSX_Vg3nVF3qXq-mU5akKfMRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5iOn0_51jOJDkHC0uTVk7Zt243O5m_Rxb2nnbfaWauA&oe=6AF1D586"}, {"file_name": "Screenshot 4.png", "id": "877385565018172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_877385575018171_4079583937688450696_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8BpDu1hhQYQ7kNvwGzf440&_nc_oc=AdpbY_ISQm0s0OnyHbGn1uzVcZH_d_CiPAaaxxDfCPJABZ-QhBo3I_TE04V0VlRGfOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxLRVF33_ynuaT3Pl1dYjRqroKv1HBht5bMjr7uTR8GA&oe=6AF1DEED"}, {"file_name": "Screenshot 2.png", "id": "1344524687195702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618083_1344524690529035_806525398893309047_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrO_YO_CHrAQ7kNvwGFI6eh&_nc_oc=AdoAHUwi2E3_80lBAS3ukpjZww7lWbki4-TecyCBtzoEpWmc98FgyIgJpF9QM08e6NY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv_qrYlFx-j-VwluJV6cKw71M_VDQXO9K-pokbtcCVQA&oe=6AF1F9EB"}, {"file_name": "Screenshot 1.png", "id": "2569936983466382", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_2569936986799715_5327409706250328960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK7iXpSyhqoQ7kNvwFJZp4M&_nc_oc=AdqXW_Tfm-6fFVDTJo_iVGxWSiNG41t17lxnvrWVelMIHqMeBpvMcAYzTxpofRLUxKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGdxfWx5S_rq_Rc74GhO38gqkUQimm1IpU67zCWKQMkg&oe=6AF1DD8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chameleon Hide Paint Hunt", "keywords": ["paint", "hide", "meccha", "seek", "hunt"], "long_description": "# MECCHA CHAMELEON comes to VR!  \ud83d\udc40\n\nGrab your doll, stash it somewhere sneaky, then PAINT it to blend right into the room. If nobody spots it\u2026 you win! \ud83c\udfa8\ud83d\udc51\n\nTeam up with friends\ud83d\udc65 , split into Seekers and Hiders, and see who's got the sharpest eyes. \ud83d\udd0d\n\n# Even better in VR!\u2b50\n\nReach out and grab your doll with your own hands. Paint it from any angle. Lean in super close to check your masterpiece, then back up and see if it fools anyone. \ud83e\udd8e\n\n**Hunting?** Peek around the whole room with your own eyes. It's hands-on, it's hilarious, and it's way too much fun. \ud83d\udd2b\n\n**Including:**\n- Hide-and-paint mechanic \u2014 place your doll, then paint it to match any surface\n- Hands-on VR play \u2014 grab, position, and paint using natural hand movement\n- Online multiplayer \u2014 public matches, private rooms, 2\u20136 players\n- Party-game chaos \u2014 hilarious, casual, endlessly replayable", "short_description": "MECCHA CHAMELEON comes to VR!  \ud83d\udc40\n\nGrab your doll, stash it somewhere sneaky, then PAINT it to blend right into the room. If nobody spots it\u2026 you win! \ud83c\udfa8\ud83d\udc51\n\nTeam up with friends\ud83d\udc65 , split into Seekers and Hiders, and see who's got the sharpest eyes. \ud83d\udd0d\n\nPaint. Hide. Disappear. Can you fool everyone?\n"}]}, "developer_name": "Ariane Studios", "developer_privacy_policy_url": "https://www.arianestudios.com/chameleon-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
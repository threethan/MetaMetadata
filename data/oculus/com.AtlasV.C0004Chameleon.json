1CF7"}, {"file_name": "Screenshot 5.png", "id": "1761768241918259", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824292_1761768245251592_6440625786470970162_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzY_OlBMM44Q7kNvwF61Qzu&_nc_oc=AdqumaZWozwpfNs8r7d-D2iHw6A-i2dDmq8atvLz935EWTl_Dpl5YAq2c0nXHHyq84s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXrnOqA9_21m9G9mSqY3uTUfF_l4yl4fA6hRYE3Pqamg&oe=6AA01886"}, {"file_name": "Screenshot 4.png", "id": "877385565018172", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620384_877385575018171_4079583937688450696_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk5AqZP0AwUQ7kNvwFRukH8&_nc_oc=AdqoCmG-97OEoMw7gicuXuqleI9fMKQUrCQ0DCkUT4ttb93rxGCm1Fg1h0UmQd9Lqno&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8SCcgX0ciS03u8eOipVcvrj37t_wwQYzfllZMWaKQag&oe=6AA021ED"}, {"file_name": "Screenshot 2.png", "id": "1344524687195702", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618083_1344524690529035_806525398893309047_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JrqJ0HszuYQ7kNvwF6cCkh&_nc_oc=Adp7uCp32lBQB8cqjEp0o7-2PDaU-_xdt33oBPFkdBFCDiAJ9QIMk0WG99jrDsiyh0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCKu1C1vKGov-yELv-pAmlIYA8iB5jBhG-aauoZRNPBg&oe=6AA004AB"}, {"file_name": "Screenshot 1.png", "id": "2569936983466382", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823949_2569936986799715_5327409706250328960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MujauMk_xU4Q7kNvwGAe24M&_nc_oc=AdpNh4LIJSGnMEAZ4Xh0qJDJdUkZ7Xk6ZLHH2NX0ygPtclTnJTKp2Bxth-Su943nXxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnvGZsff7ok633Nlg-Gv2BiOR29Knx1cyWKfldfYK8Kw&oe=6AA0208B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chameleon Hide Paint Hunt", "keywords": ["paint", "hide", "meccha", "seek", "hunt"], "long_description": "# MECCHA CHAMELEON comes to VR!  \ud83d\udc40\n\nGrab your doll, stash it somewhere sneaky, then PAINT it to blend right into the room. If nobody spots it\u2026 you win! \ud83c\udfa8\ud83d\udc51\n\nTeam up with friends\ud83d\udc65 , split into Seekers and Hiders, and see who's got the sharpest eyes. \ud83d\udd0d\n\n# Even better in VR!\u2b50\n\nReach out and grab your doll with your own hands. Paint it from any angle. Lean in super close to check your masterpiece, then back up and see if it fools anyone. \ud83e\udd8e\n\n**Hunting?** Peek around the whole room with your own eyes. It's hands-on, it's hilarious, and it's way too much fun. \ud83d\udd2b\n\n**Including:**\n- Hide-and-paint mechanic \u2014 place your doll, then paint it to match any surface\n- Hands-on VR play \u2014 grab, position, and paint using natural hand movement\n- Online multiplayer \u2014 public matches, private rooms, 2\u20136 players\n- Party-game chaos \u2014 hilarious, casual, endlessly replayable", "short_description": "MECCHA CHAMELEON comes to VR!  \ud83d\udc40\n\nGrab your doll, stash it somewhere sneaky, then PAINT it to blend right into the room. If nobody spots it\u2026 you win! \ud83c\udfa8\ud83d\udc51\n\nTeam up with friends\ud83d\udc65 , split into Seekers and Hiders, and see who's got the sharpest eyes. \ud83d\udd0d\n\nPaint. Hide. Disappear. Can you fool everyone?\n"}]}, "developer_name": "Ariane Studios", "developer_privacy_policy_url": "https://www.arianestudios.com/chameleon-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
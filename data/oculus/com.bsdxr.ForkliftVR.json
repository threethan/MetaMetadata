s30ZWG_jXYhl6bVQ&oe=69C3E43A"}, "display_name": "BSDXR Forklift VR", "keywords": [], "long_description": "Forklift VR is an innovative and immersive training simulator designed to enhance safety and proficiency in the operation of forklifts within various industries. Harnessing the power of virtual reality technology, this simulator provides a realistic environment for forklift operators to refine their skills, tackle diverse scenarios, and learn to respond effectively to potential challenges.\n\nAspiring forklift operators can gain valuable experience without exposure to real-world risks, resulting in improved on-the-job performance and heightened safety awareness.", "short_description": "Forklift VR is an innovative and immersive training simulator designed to enhance safety and proficiency in the operation of forklifts within various industries. Harnessing the power of virtual reality technology, this simulator provides a realistic environment for forklift operators to refine their skills, tackle diverse scenarios, and learn to respond effectively to potential challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitspacedevelopment.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bit Space Development Ltd.", "support_website_url": null, "website_url": "https://www.bitspacedevelopment.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mo
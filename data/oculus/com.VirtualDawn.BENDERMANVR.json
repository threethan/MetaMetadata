n.com/v/t64.5771-25/57569439_380512130988736_2350478158753001460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkdwDCe5uZ4Q7kNvwECZC_T&_nc_oc=Adoj1S7AReB94pmpTAgQgNm0324VGzcqI8iJ5N1UQocySsHFSMkEb_myIQ5B7GsUvJ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDp9_vlrfp8HTMpSwaZ1XijO4KrbemfTVWLskDBmD13Q&oe=6A85B11C"}, {"file_name": "scrShot_v2_4b.png", "id": "1987209154980678", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035418_1987209161647344_8667964815521111038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf15aF076BgQ7kNvwErh5T_&_nc_oc=AdpZKm90ALCORHaJ87x-XbSPNrWKiBgQB3pdGcun_Lv-Uw8QnU2VQP1UkhygPgpPR4o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbckYWgPVVYI3h48dzeY6Z8C-HXUU8N-21DpKKk0Z1vQ&oe=6A857956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrShot_v2_8b.png", "id": "719881019569765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75375756_719881022903098_7135530134492406687_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJg2GqWE4KUQ7kNvwExpya-&_nc_oc=AdpCIKeCRiYMri5zkJCWxEqLep-fJkcPKkF8EdHSE9Af7ttqt23BHqQlIrZ_0_3_Nbw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp2VnFlSbbL8DNyqBE6RCcx7j3UkZU44WLPwtumIB6lw&oe=6A857E40"}, "display_name": "BENDERMAN VR", "keywords": [], "long_description": "Dive into a nostalgic journey back to the golden era of gaming with BENDERMAN VR, an immersive virtual reality puzzle game that combines the charm of classic 2D pipe-building games from the 80s and 90s with the cutting-edge technology of today. Get ready to unleash your inner engineer as you tackle pipeline challenges!\n\n\ud83d\udd27 Innovative VR Puzzles: Immerse yourself in a world where creativity and quick thinking are your greatest assets. Use a dynamic pipe bender and your strategic prowess to bend, twist, and shape pipes exactly the way you need them.\n\n\ud83c\udf0a Race Against Time: The pressure is on! Each level presents you with a unique space in need of a pipeline. As you bend and twist pipes to create the connections, the clock is ticking. Complete your masterpiece before the water fills the room, or brace for a watery disaster!\n\n\ud83d\udd29 Collect Golden Wrenches: Put your puzzle-solving skills to the test and collect the coveted golden wrenches scattered throughout the levels. \n\n\u23f3 Stay Within the Pipe Limit: Think you've mastered the art of bending pipes? Think again! To earn maximum points and Pipe Picasso Ribbon, you'll need to demonstrate not only your creative engineering but also your resourcefulness.\n\n\ud83c\udfae Get ready to twist, bend, and craft your way to pipeline perfection in BENDERMAN VR!", "short_description": "BENDERMAN VR - A retro pipeline puzzler! Bend pipes in VR, beat the clock and collect golden wrenches while staying under the pipe budget. Nostalgic 80s-90s style. Will you be a Plumbing Maestro or a Drenched Dabbler?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-dawn.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25019451454308926"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "902994701792
": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_326768603321136_6018774866335792512_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVXvpWb89xgQ7kNvwFRyRP3&_nc_oc=Adm2h0JusOAtkZCrvwJwO98tPDEW-KCmjBGmwciIGd2heFjTmtSjwWB9xoStL_o01ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSurKQm3Qx3j285P0MkXzG-nYMoTKaZQnTIB4k-zk4SA&oe=69A038BB"}]}, "id": "999430164691691", "locale": "en_US", "screenshots": [{"file_name": "scrShot_v2_8b.png", "id": "1737956320006891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_1737956323340224_69406804953229603_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYrNG6zGUIwQ7kNvwF3GWZm&_nc_oc=Adk2J5veoaQViofmVqZa5iPRRT2GFsxDyf2D3xDrSPWJZDyODP7qh1bOvs2id4_S1mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGIaBt6096wHPa8DOxvtbEQIWiEZQFClLGFSSADx---w&oe=69A05641"}, {"file_name": "scrShot_v2_2b.png", "id": "1098370104462893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001698_1098370107796226_5224214905285542223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2xH6sCIdFAQ7kNvwGeb33e&_nc_oc=AdlQnaJ_v8L0bIFHZg7T8A77KXcjROvGS2XPnl03VFe8hPZmhxSplGa0HTHjqIRHMbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunLx4fwhUhe93NDYgLf3Auka5Ccil0HkJDeeOqsFS92w&oe=69A03B35"}, {"file_name": "scrShot_v2_5b.png", "id": "713671793620730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031500_713671796954063_549940606624389944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll_04Tqy2cAQ7kNvwFJlrmg&_nc_oc=Adm5c4WAlmTHZdaKL5BKX0i0tjCmxv4o_hwv02otdNX0Yw106BiLUn7knwZk6jKtUrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1gKQ1R5owDhRsr-xkXUfPEXQJD3h4r18zX5ZemsuEbg&oe=69A033C5"}, {"file_name": "scrShot_v2_7b.png", "id": "380512127655403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569439_380512130988736_2350478158753001460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cRzhEQ_KmAQ7kNvwG7wx46&_nc_oc=AdnEblmEqpXCDXWezz8oeuwea8gbEOqupWM-DwyK9LjW5IC2nxRiDRgPy4VmMnSGNqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-u7WVroTiSK2JVb0Z8UIX7zhPUEbEWS5LmLsv8EwIow&oe=69A04C1C"}, {"file_name": "scrShot_v2_4b.png", "id": "1987209154980678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035418_1987209161647344_8667964815521111038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPdbhd6GHWcQ7kNvwGQ24ps&_nc_oc=AdkXosE3lBhVzIw8XUHViXgguYb6p4lajZRySaBDboLAWAXciOBoPPKwhGFKYqsCeaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunOOY5FGpN35MMh8DA3uSSBKB7Det-Sea5qDWXW1ajhQ&oe=69A04C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrShot_v2_8b.png", "id": "719881019569765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375756_719881022903098_7135530134492406687_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP-TedkOF8wQ7kNvwH38o86&_nc_oc=Adk4J3_IjzfkQWaehFap34onWdl1LNSEkBuLwmFH5VJMJ2V8aPTx348fN3fAhaN5pKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsf0BF-KN_xRD2Vi4omBxdMlCgWpVJPauS8FPoc-4_Xiw&oe=69A05180"}, "display_name": "BENDERMAN VR", "keywords": [], "long_description": "Dive into a nostalgic journey back to the golden era of gaming with BENDERMAN VR, an immersive virtual reality puzzle game that combines the charm of classic 2D pipe-building games from the 80s and 90s with the cutting-edge technology of today. Get ready to unleash your inner engineer as you tackle pipeline challenges!\n\n\ud83d\udd27 Innovative VR Puzzles: Immerse yourself in a world where creativity and quick thinking are your greatest assets. Use a dynamic pipe bender and your strategic prowess to bend, twist, and shape pipes exactly the way you need them.\n\n\ud83c\udf0a Race Against Time: The pressure is on! Each level presents you with a unique space in need of a pipeline. As you bend and twist pipes to create the connections, the clock is ticking. Complete your masterpiece before the water fills the room, or brace for a watery disaster!\n\n\ud83d\udd29 Collect Golden Wrenches: Put your puzzle-solving skills to the test and collect the coveted golden wrenches scattered throughout the levels. \n\n\u23f3 Stay Within the Pipe Limit: Think you've mastered the art of bending pipes? Think again! To earn maximum points and Pipe Picasso Ribbon, you'll need to demonstrate not only your creative engineering but also your resourcefulness.\n\n\ud83c\udfae Get ready to twist, bend, and craft your way to pipeline perfection in BENDERMAN VR!", "short_description": "BENDERMAN VR - A retro pipeline puzzler! Bend pipes in VR, beat the clock and collect golden wrenches while staying under the pipe budget. Nostalgic 80s-90s style. Will you be a Plumbing Maestro or a Drenched Dabbler?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-dawn.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25019451454308926"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "902994701792625"}, {"status": "PUBLISHED", "id": "1032863154467143"}]}, "baseline_offer": {"id": "1032863154467143"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734372000, "status": "PUBLISHED"
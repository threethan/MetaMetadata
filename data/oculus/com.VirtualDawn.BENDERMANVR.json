1-25/57569439_380512130988736_2350478158753001460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzSrQtmp5tkQ7kNvwHw-lHk&_nc_oc=AdqiukpBjak5I_hzaLVUE9_dD6uC7ewSWhRA2aMrPtrr86TM_tBnmiXSZx1cyLjJdzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mkePYeqpOjCsWY1k8Wq085Gp-T0l1fKOKzhvyE2pZJg&oe=69ECC31C"}, {"file_name": "scrShot_v2_4b.png", "id": "1987209154980678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035418_1987209161647344_8667964815521111038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0v2t_dmCSAQ7kNvwHhSE3Y&_nc_oc=Adpy55vTSDHsjbRjo6LRUm16UUecZsuUP_SwRdeIfRllbxaeSdcBuoMfJPtjRvPSfKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aNXEbLBUR7mnAOCi-484Q7o20BM6sOeyvl2XTwGVsIw&oe=69ECC396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrShot_v2_8b.png", "id": "719881019569765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_719881022903098_7135530134492406687_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TwR95f6zIsQ7kNvwGPcs5j&_nc_oc=AdpR63jZJJ7hZD32RPWsUArNXdDZJVrb78rB6Bi_dpgkgQJ4EZI3ex1IpUDHI3jZYss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xpJwflNdltI2nhuKd1hme1nf62qO-xNoG_EfwdBg_Yg&oe=69ECC880"}, "display_name": "BENDERMAN VR", "keywords": [], "long_description": "Dive into a nostalgic journey back to the golden era of gaming with BENDERMAN VR, an immersive virtual reality puzzle game that combines the charm of classic 2D pipe-building games from the 80s and 90s with the cutting-edge technology of today. Get ready to unleash your inner engineer as you tackle pipeline challenges!\n\n\ud83d\udd27 Innovative VR Puzzles: Immerse yourself in a world where creativity and quick thinking are your greatest assets. Use a dynamic pipe bender and your strategic prowess to bend, twist, and shape pipes exactly the way you need them.\n\n\ud83c\udf0a Race Against Time: The pressure is on! Each level presents you with a unique space in need of a pipeline. As you bend and twist pipes to create the connections, the clock is ticking. Complete your masterpiece before the water fills the room, or brace for a watery disaster!\n\n\ud83d\udd29 Collect Golden Wrenches: Put your puzzle-solving skills to the test and collect the coveted golden wrenches scattered throughout the levels. \n\n\u23f3 Stay Within the Pipe Limit: Think you've mastered the art of bending pipes? Think again! To earn maximum points and Pipe Picasso Ribbon, you'll need to demonstrate not only your creative engineering but also your resourcefulness.\n\n\ud83c\udfae Get ready to twist, bend, and craft your way to pipeline perfection in BENDERMAN VR!", "short_description": "BENDERMAN VR - A retro pipeline puzzler! Bend pipes in VR, beat the clock and collect golden wrenches while staying under the pipe budget. Nostalgic 80s-90s style. Will you be a Plumbing Maestro or a Drenched Dabbler?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-dawn.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25019451454308926"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "902994701792625"}, {"status": 
": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_326768603321136_6018774866335792512_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DpHjY14or0Q7kNvwFKSLeG&_nc_oc=AdnTrGVoaP7DDAU0rb6NPvC6tGZ_nSFlpCH1ZHoEADtwD0n6HavZVRrAuN12IfdMBqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuApvZBOhNnAwj1lLQnTz5od-8iqTkAjyk8v9Qv2muCJw&oe=69984FBB"}]}, "id": "999430164691691", "locale": "en_US", "screenshots": [{"file_name": "scrShot_v2_8b.png", "id": "1737956320006891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_1737956323340224_69406804953229603_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgtiXg5ceT4Q7kNvwF0pALD&_nc_oc=AdnPNja0Bo4hxu48BfTGkBTnvIaE-vMdGUyb7QxaEitQ5M03BWNPp6C26lndzWT4AjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftntEq5T-jxPHUCNfGBiYM8FcnBIQtl7u-3hbwR_jOj9g&oe=69986D41"}, {"file_name": "scrShot_v2_2b.png", "id": "1098370104462893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001698_1098370107796226_5224214905285542223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAGUY_YCyXEQ7kNvwFtEMOZ&_nc_oc=AdlZPglRWgB7eliRZhMxJxfF_FA9DqDl7dtXka8JZ-7imJqKunK9I-n0qRLLdr3jw0c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsIm1xJOpcC-hgRRa93ow9q3RS8Jzs9rHBOqzcIyz76Hw&oe=69985235"}, {"file_name": "scrShot_v2_5b.png", "id": "713671793620730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031500_713671796954063_549940606624389944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6goljtLD5VAQ7kNvwH6kr-L&_nc_oc=AdkdTm7NX2euckx8ymDhUzGlB2HgQIKhpVcd9ZdFCr-y0ZdIQ6C0tk0yPAXnUcGI4U4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftRlWssgneQDFPb7r_eDhxFBAMlwzK0YuBMGUg0SHJ_gg&oe=69984AC5"}, {"file_name": "scrShot_v2_7b.png", "id": "380512127655403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569439_380512130988736_2350478158753001460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92bn6Pr-w2QQ7kNvwGyusJm&_nc_oc=AdkDWMhUVAd66e2ZRWyLEQwHigMZmgBx30jdkluk76EUhYaNuYfuqQYGf-_moUaUASQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvjv6OL7c71rSmyeKrOdmZCUXZxJ_Id0VLgXM3u2JkC3A&oe=6998631C"}, {"file_name": "scrShot_v2_4b.png", "id": "1987209154980678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035418_1987209161647344_8667964815521111038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLsmhO75z_wQ7kNvwEkc7gf&_nc_oc=Adnq3sW7eEkgtH2qjGrOdHB3Lqie2H-IT5kbBgGaAw9JqwERBr5jXpaIJwwV9lhBiJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsMSDGZ0hQnDOsiyf0qHorvj_OyJK0h7djuqHANChm4EA&oe=69986396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrShot_v2_8b.png", "id": "719881019569765", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_719881022903098_7135530134492406687_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ll2IFKUY-UQ7kNvwE_ywZz&_nc_oc=AdkTutfycwM7vH17hu37mNEqDuE_il0bGKR9D_XnB7OlQ5iHtV733w6e2Zx8jTBLtTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftB-z0NuKNmss6qJE8xrAb0Vb6ggDQL0a0MzPD7o-L7Hg&oe=69986880"}, "display_name": "BENDERMAN VR", "keywords": [], "long_description": "Dive into a nostalgic journey back to the golden era of gaming with BENDERMAN VR, an immersive virtual reality puzzle game that combines the charm of classic 2D pipe-building games from the 80s and 90s with the cutting-edge technology of today. Get ready to unleash your inner engineer as you tackle pipeline challenges!\n\n\ud83d\udd27 Innovative VR Puzzles: Immerse yourself in a world where creativity and quick thinking are your greatest assets. Use a dynamic pipe bender and your strategic prowess to bend, twist, and shape pipes exactly the way you need them.\n\n\ud83c\udf0a Race Against Time: The pressure is on! Each level presents you with a unique space in need of a pipeline. As you bend and twist pipes to create the connections, the clock is ticking. Complete your masterpiece before the water fills the room, or brace for a watery disaster!\n\n\ud83d\udd29 Collect Golden Wrenches: Put your puzzle-solving skills to the test and collect the coveted golden wrenches scattered throughout the levels. \n\n\u23f3 Stay Within the Pipe Limit: Think you've mastered the art of bending pipes? Think again! To earn maximum points and Pipe Picasso Ribbon, you'll need to demonstrate not only your creative engineering but also your resourcefulness.\n\n\ud83c\udfae Get ready to twist, bend, and craft your way to pipeline perfection in BENDERMAN VR!", "short_description": "BENDERMAN VR - A retro pipeline puzzler! Bend pipes in VR, beat the clock and collect golden wrenches while staying under the pipe budget. Nostalgic 80s-90s style. Will you be a Plumbing Maestro or a Drenched Dabbler?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-dawn.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25019451454308926"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "902994701792625"}, {"status": "PUBLISHED", "id": "1032863154467143"}]}, "baseline_offer": {"id": "1032863154467143"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734372000, "status": "PUBLISHED"
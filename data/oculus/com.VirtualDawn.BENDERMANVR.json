": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_326768603321136_6018774866335792512_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGsaKggz0oAQ7kNvwFqAlJi&_nc_oc=AdlE-kcNtLMHoX-Jo4qZnLsIKGT9ASAUNnBlq8j1J7L-dS0iQPfo3_1MuzkBppVdj-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWyJMwrA8aGyjR049Pd0XhdZ02-1DMQA2y3cvkMfgrOw&oe=699D95BB"}]}, "id": "999430164691691", "locale": "en_US", "screenshots": [{"file_name": "scrShot_v2_8b.png", "id": "1737956320006891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_1737956323340224_69406804953229603_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYrNG6zGUIwQ7kNvwFfMWY_&_nc_oc=AdnnRd__LpwB1Z-wxdTILg5B0TFULjD7X1Q2KuWEtOn9_UartYfcEqdzdtxzj9WzpP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv87gYqLwrznPJfmyWR_1JSXSolfFOj365vZ-wjDTIcTA&oe=699DB341"}, {"file_name": "scrShot_v2_2b.png", "id": "1098370104462893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001698_1098370107796226_5224214905285542223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2xH6sCIdFAQ7kNvwFW6bYc&_nc_oc=AdnH46rCtOmUq_XDq3y-p3wo9ZPR1XGV5LlVtovZTnFDpD25akxwX02FQi1dHTrze8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu217jOe2xCijeuzKXzxssgiErnTF8TIqoWH5YIYFLq_Q&oe=699D9835"}, {"file_name": "scrShot_v2_5b.png", "id": "713671793620730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031500_713671796954063_549940606624389944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll_04Tqy2cAQ7kNvwHyCzOH&_nc_oc=AdnYgXM4CfpoiXJAE2tSdIX4zc2HOwY0Zb5CW5IsN5HzXIZPKYUqFCoBinR-BTZWisg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlUT3UvpYXeey58hljc1PSYjv3x97v-X6GnKYQy8-nIA&oe=699D90C5"}, {"file_name": "scrShot_v2_7b.png", "id": "380512127655403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569439_380512130988736_2350478158753001460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_PEOGJq60QQ7kNvwE-xvYK&_nc_oc=Adnh_zSQxF_fnvTeiEirbozJWcehx_bKY7C7Ceq6IvO8CEyhbf_SSw_PEOK5rPTSe34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsmiJudpWcGEwSN2Gg_1lTenYnHOqwqxWDIh3J3DGxKw&oe=699DA91C"}, {"file_name": "scrShot_v2_4b.png", "id": "1987209154980678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035418_1987209161647344_8667964815521111038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EsHV046JdQQ7kNvwGI-mOP&_nc_oc=AdlcKRESi64rkAhFo3vIy7-dc3rQoNqv6YD_IhtseSCfRD4Y2A3VSnVQN4tookNx9z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmwUccLJX069qx52d_8USrYeqIZlvn_4CMz3qmVjfmHg&oe=699DA996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "scrShot_v2_8b.png", "id": "719881019569765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375756_719881022903098_7135530134492406687_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCpztkCQgtcQ7kNvwE4nt9m&_nc_oc=AdkaHDjTOjxXgyB6nsZfeTjV6x247lRVR0Iz0ws9_b6STm7_zeg11b0ElaH1eLmH6GY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsegWBd8qW1fnYx5J4MurYD87_flyTehUPvfvN3HlfstA&oe=699DAE80"}, "display_name": "BENDERMAN VR", "keywords": [], "long_description": "Dive into a nostalgic journey back to the golden era of gaming with BENDERMAN VR, an immersive virtual reality puzzle game that combines the charm of classic 2D pipe-building games from the 80s and 90s with the cutting-edge technology of today. Get ready to unleash your inner engineer as you tackle pipeline challenges!\n\n\ud83d\udd27 Innovative VR Puzzles: Immerse yourself in a world where creativity and quick thinking are your greatest assets. Use a dynamic pipe bender and your strategic prowess to bend, twist, and shape pipes exactly the way you need them.\n\n\ud83c\udf0a Race Against Time: The pressure is on! Each level presents you with a unique space in need of a pipeline. As you bend and twist pipes to create the connections, the clock is ticking. Complete your masterpiece before the water fills the room, or brace for a watery disaster!\n\n\ud83d\udd29 Collect Golden Wrenches: Put your puzzle-solving skills to the test and collect the coveted golden wrenches scattered throughout the levels. \n\n\u23f3 Stay Within the Pipe Limit: Think you've mastered the art of bending pipes? Think again! To earn maximum points and Pipe Picasso Ribbon, you'll need to demonstrate not only your creative engineering but also your resourcefulness.\n\n\ud83c\udfae Get ready to twist, bend, and craft your way to pipeline perfection in BENDERMAN VR!", "short_description": "BENDERMAN VR - A retro pipeline puzzler! Bend pipes in VR, beat the clock and collect golden wrenches while staying under the pipe budget. Nostalgic 80s-90s style. Will you be a Plumbing Maestro or a Drenched Dabbler?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-dawn.com/Virtual_Dawn_Privacy_Policy_11112023_meta.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Dawn", "support_website_url": null, "website_url": "https://virtual-dawn.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25019451454308926"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "902994701792625"}, {"status": "PUBLISHED", "id": "1032863154467143"}]}, "baseline_offer": {"id": "1032863154467143"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734372000, "status": "PUBLISHED"
ZAw3MuAndYFztQPZt6owZm8J-UVw&oe=6A30234A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixIIe_hstXEQ7kNvwGTI6rm&_nc_oc=AdqlsZplhIugiv0KHt_2ViNrZZSc6Iuf_erNzfeq42pjr-USS3NjY_JPRCkiELENmps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eSzlw-t1LTh8v4dd5eb9p6Pz7Df1fzLqJKDRfN1SawA&oe=6A300067"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYzzWaKUmvYQ7kNvwFPUytf&_nc_oc=AdrhROUV7GvnB7c8NUBAeuzuQKiWbK1p3BS4NLxGIEu5CSlVT9TVTkE2RbCacCHHSOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jQszgJYxOB8SjrbNNUk5opCDlmguf3rsspjaI7bxUTQ&oe=6A3014E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmjaEuFa5VwQ7kNvwHVqeLE&_nc_oc=AdpR0KcaoCr4eKoLb33ULH9hWkZC85WJ4doHsYQhHX5H78NJN6zpXJZ694xF3iSOwdI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8cO0C4xvLyxPq92ilWvDrjcHdi9IRYYgerY5pdLjBEw&oe=6A3008BC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQKv2WcG5gEQ7kNvwFmv11V&_nc_oc=AdqfOCQZQ-zltYNsG54MwuBxF977mcGFMUDSh7pjs5eypsjFqy9Mh7ZR-TubNdOiHds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Zwq-1rpcqlp5sgzaJComQYSNAQFU96tR4fVDDk8mMA&oe=6A3007B2"}, "is_con
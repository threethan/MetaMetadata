ijnLOUg-4S3fZL8lXW4V5WENyNig&oe=6A04698A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgDfe3k6m1EQ7kNvwE75TOu&_nc_oc=AdqFZe0MAs_tPRhyhI92LsMIerRSp80SojUsPOuAcSdgk3pMDMLXsp1Nn_1pmmVoTaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o7HTfgKyxYJZjSwIKTGc1IGoT81o8voOCuepd9FxBbg&oe=6A047EE7"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEaD7IIPL3YQ7kNvwHf7vpQ&_nc_oc=AdqlsNybp8XuyGgtXQABz558X_1kVz0vcPoP54GKi0tuvjVu88OenXynPJtGpTV8DnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rDcpbxubIheyMtET8_pLe-5nyt_6JREGulc57MhkIog&oe=6A049368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVYK8awb128Q7kNvwH2Wy6J&_nc_oc=AdrPhqyG9681HEhDeXCpaeZUPqYFUHNN8C4myW2awayP4gQEH3nZtPPNCqmXGELFQH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J8Fz3Qm9TyELWXRWdjo5vH7ZBnw6LTunKR2dsyIVxAw&oe=6A04873C"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWWJz3GDD10Q7kNvwG_T1f-&_nc_oc=Adr6aXRLyqnmgZHeN1vdiK4g9Uo8tMTYXNk2yXsbTYn4lMwdEwdzX8OWN-XAIfr5Kws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63c808QtOViucXilGyutK2r9Wxc1vAtB85aPRGAqBI0w&oe=6A048632"}, "is_con
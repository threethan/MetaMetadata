KcdRqFbj9A9rfkhMtTkWR0vAJklg&oe=6A2ADD4A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyntMULuSnAQ7kNvwGFEjYs&_nc_oc=AdrtTYuhov0Y0ne1koD_-WvOymIcLZUEiDM9ARzJVs0F05WdCbVHhpSgI50XfC9KfcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tBh6POJw8M8u8p-qA05qL7IZeoMCpJYJPJnPs5Lg5aw&oe=6A2ABA67"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF0H1LgYml4Q7kNvwHc0hQI&_nc_oc=AdqQVN6Q1YL9fmKq7SLLhrLtWH26DJ1XvSybKOarnHHc_GUp29AvR5IVWbIdwuPqAcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YZKqaaHvpFfww9ARvtPLqBUSeakaOBiMiQEMbEN9-dQ&oe=6A2ACEE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKwfeWsYd38Q7kNvwF6HKR8&_nc_oc=Adp1w15qMROTRubMt1kgpMFBDz2ZC8XOQunaqVWJDSPuVnDEnXTVNEXWQZNTHB1az3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-FEG-lPrQkpYxJQhJl9kIoG9uB9FxCydvW5XHiJcRDw&oe=6A2AC2BC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L9IeR5fc2IQ7kNvwGGEUDk&_nc_oc=AdpvnPYqKq_ACsLNzBbjCoVDMNuJ2KDMFJgRpuCHhn9n7y49zAG3kJhXxPxH-ZwAa70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KHg1ej54dBNtFAHBBNq4SW1CWwv2b0fmBEAWi2wb0Xg&oe=6A2AC1B2"}, "is_con
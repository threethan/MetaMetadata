YCIm9ZwoNt3GAESv3o0zRsz2qOfg&oe=6A42600A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSp6nCpuoJoQ7kNvwGbt8_Y&_nc_oc=Adr23o2Z3dmN-u9Dxo25ttxwaTX_7ANSZSQwhHWBhXb81-VpzPH3Hvvj-UQc2MCRMAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jxHVcRMS6kzf9DXvMQf3kWlXqYqgYzmXfSeuRAwhw8A&oe=6A427567"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chX0LW2DY68Q7kNvwGCVbLc&_nc_oc=AdqGr4aMRp3kTCsMarQ0dM5I35iC-4JVWBvj6kCTnmEE6S4jQGIq-ALhAu_OQ85pAjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DpLUCLcrmyWOui98FlLdS7EEaY2Z0HpYUAaEv3n5F4g&oe=6A4289E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69R9EeJgjsgQ7kNvwF5c1C6&_nc_oc=Adqbg4Ek-xODBcO-GdzC4N95Ge-OXxOdbJS8ahkeH2FJAy4fGEurvZkNYDJcScaPviI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o2VTSxUHLZEHJ4wet40kahPBQ5Z_gI6vSdI7h087l5Q&oe=6A427DBC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNDdRtvLs6wQ7kNvwGXOkLx&_nc_oc=Adofam7Juq7oBGs6_znIg5RV5_z4SdQpYEKHyaNm2vM3X3AsuuYffEol2hhuP9jnems&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L0jd85faRd13JoNRSiy4hQrFbnaYiN5lT7TBs22LRow&oe=6A427CB2"}, "is_con
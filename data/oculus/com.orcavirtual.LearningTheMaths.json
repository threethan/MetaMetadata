GaSMBxzj42jGksz-1iKHIIpI7igg&oe=69EB5D0A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qhMAM56StwQ7kNvwG3hfsS&_nc_oc=AdpDp33B-qDTCUx3R71djkubOgrnr6b3pyb4CrWpJJZFvNnr5jtZd-nqzWiwfha7oaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N5C3TeH3s8X1cwgN9MxNOiNt41B_XL9Eud3A4dPlEOg&oe=69EB7267"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN5BvmTW6yQQ7kNvwGFPVGk&_nc_oc=AdqeJoUprmgXYQrl8yQzTf9taWsUHzehhW-tkvf72d63vO1ymJ0kaMj6MI43oE1Ria8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eaFxO6s_1ndobaO8_5vmaexwBHQhqTW8q550VPPz2QQ&oe=69EB86E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xov7TNXqC5IQ7kNvwECr0xN&_nc_oc=AdpdCEMTcNclaJRNKSbY21wW-SW9_Y4XY-CjMwBzTn4bLbogjb6PLO2-RllULOUPw3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tFoGomsT2RaQeqp57UPVm41XjH_ujhkfGBho5uk7QUQ&oe=69EB7ABC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpNEkFxfvHsQ7kNvwElgrDd&_nc_oc=AdquesGzYU0Dg21sGEOqyY8yyABuwjMKeo82kpFbUknH_4vPyLIIC5UNnpN1fuKiHY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GA7saC6lxZMwPDGjkhvI8g9bRkegfH2r0bWj2XVDN9w&oe=69EB79B2"}, "is_con
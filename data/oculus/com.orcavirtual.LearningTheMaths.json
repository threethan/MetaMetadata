098A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EICLUrGROX8Q7kNvwGW1Gko&_nc_oc=Adkx-A7fh0j_kpK4rbY7XQJhEh3aZYeZ7eo9efn-aQWiK4tM5wxIWWg1203rLf3qUtg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKPVlNAoz9oQWJioTvbVO2GfZU5Qj1bWq8JH6rD1r86g&oe=69B01EE7"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl22A1mzwH8Q7kNvwHj4d90&_nc_oc=AdnofDFQsUWbwuoei8AuWz8P0QOFTsaxUZZnDFjCagIagwV8KHb4RHy7MoefoWrPpE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOweLzOP7nXo-U8fVn_qZiq-qTzT5lXh9d88vYZ29LGg&oe=69AFFB28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvaxi_ubl0cQ7kNvwH5t2aY&_nc_oc=AdnkVxhWWJhskWlSfnCr6rpZRq9ErPbRahY9YT5Nnkrb7_eAZJWbXSDJ5Bbue_-5-Po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLCwTO6k4BpOLyzLBwX2ST2lfuL4mEqz_Eo5XNZGlxgA&oe=69B0273C"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1fpJmmz_F8Q7kNvwF8j442&_nc_oc=AdmcWL326kNCiCO14WoGRK4gXDe31BVpVzS_pDjPrOiHM7OMiVuylL5w52pG5kl1J8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9pAl4mC3aDNIDP-gUJZ2HJSqqYwbcNPa3cEXq8ajnTw&oe=69B02632"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
8usDJhN_f6hWyWvMcIyYBP_FMPbg&oe=69C3D00A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P5RvM-4yuUQ7kNvwFatFGN&_nc_oc=Adrs58MlMtgb4oX4nXZCt9dXrqNk-uwX9CM2Qs4mkGZMAiB4ilcRF4zV6gEUIveT4Xc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfFRNK0jENLNfabtYzogPTiXeS_x9OXhjkn_urRgfxvA&oe=69C3E567"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIpflnJZd84Q7kNvwHbYk8R&_nc_oc=Adonm5dmVqrrLEeslWV0pQ3MpLT5euoU9B3Nw1fbwj8Ksh7PaU59ZK0uYd_0N9YP6bg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnK9dkN9NygZAvIJS1uORcsQBuj6YfrpgpYCKGL4qtnQ&oe=69C3C1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siPmJfNVXmUQ7kNvwE20ZmH&_nc_oc=Adrn9oec1DqZqo38Z-ePySpyLggIbmB9mDs9q3VxjY9hYUttHetuwn2KsER2oYsJKRM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPv9EvFZjyXMfW4b2LmPy7Ms6GkagHsQiIQXc4e2x8Zg&oe=69C3EDBC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzdxH_e6bQMQ7kNvwFb9s01&_nc_oc=AdrjO8ImYsJkaS_940SPApvxMjlk4puTl35FnmebGjd935AfJMh3GFnh5xxdqy_fQbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzibeMUucTPM_Nnw7Oc4XM0fswp5-0O1q1jq5woM4b57A&oe=69C3ECB2"}, "is_con
5rYuacMy7pBaAStgzqU55dsyVW1Q&oe=69E7688A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD3NCwYAEIcQ7kNvwEZOdvk&_nc_oc=AdrIW7-jR3c9d8aemOfRrxIs0YpO03fjpHyKoHViP8M9Jsv5ogf7nJ22-liSTd1Lnhs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09U7Yi6LF4YIgD0OgfNkk31FQR6_sNZ9IXu_lXANXFNQ&oe=69E77DE7"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVHBlwDP_nYQ7kNvwE1KO09&_nc_oc=AdqBQmZoIG7bKlxGQxMMQyb9415Q5-E74Jfj0jab_ft2RRHpDs2O4kN3EvwWIf8rxYQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U-zqWl-OVVhtrlqkJ8By_V6CPKrjYYeeZ1gApuqZhdQ&oe=69E79268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07k5ospwIuoQ7kNvwG9Owwh&_nc_oc=AdoYgaPd8uR706eKd22lEy-iq73QCINP_CqFPgY8JQ3J4zjtXXVFVnhpR9E34E7MCAI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14ATBWoItqQyT116M6SGBGmXxoweJKKy9gGpHZFzynJQ&oe=69E7863C"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8E6e0LPmV4Q7kNvwEae0U_&_nc_oc=AdoUoAcCan7t39izC5-gCdwhkKT_gd4Sv9jGNwPczdOlbNk_uQYZqfeRzxpPMgpHaNs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wn1gyM0G-6lGAw0bAmqAg4MdAhdAR702SJM7g5coSNQ&oe=69E78532"}, "is_con
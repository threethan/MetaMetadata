e8m918QPLpGvriemuHnIsLKL8czw&oe=6A89910A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8DrKnypVwYQ7kNvwHFwW2b&_nc_oc=AdofntIesWFBLBBr5OIhaC6jq4Sx8RZTR0BVJPU2uvab8nWj3uerEF64MEM2L7ix-T8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzyWN6XVt-eHmLd5b79JHB6D0Hu4Tv1bR-za7ox7Cipg&oe=6A896E27"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdfd6DXoaf4Q7kNvwFYaWBi&_nc_oc=AdrFsEDjoGMulsY63TDTOFk88ixTpOa-xA-xFSkfXZsl_vbPejf9d26oL-w6wUWDU78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsMmXUFNODAX6xjOSa3QqxtMUuNCPW5-P2ADsbDLx9yQ&oe=6A8982A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQpbFPHgV0oQ7kNvwEmkYDL&_nc_oc=AdrHj2THhYcJgQZ8JOLfpojBGfpv9nd-l4KMJXE-rG507OM34uvUK7Fr_aZKHcYR5es&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHqA7j1MZV8XCjTaZC7YIzZjqu6b6BL_6TAn9uVPR0zw&oe=6A89767C"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in9JCJmrvo0Q7kNvwH5ZPLJ&_nc_oc=AdrFx-OLE7Y5qUrOywpQOpCHcaFXqdsNxEuMKT0Sc_olnXj0XE0Q60sWJUinnl6TPJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb2rPESg0Me2WYCcKjLWQqc_uzAmsYws8lwVTFBq8a4w&oe=6A897572"}, "is_con
kYP3i0w5Azjk9aFbm5ZdQRC5rGwQ&oe=69E3740A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhIN7e4-WdwQ7kNvwHhsiMF&_nc_oc=Adp_aQ75M12uE3xAg6Uku76SN2ektM_9W9UWF0CkUlj5G6QPP1jCL-zCHRlos2iD2T4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M9_xIH2VBDzvNHo16rmoItPuZoD8Al5WpjwckAo9XPw&oe=69E38967"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpFX2Udas2YQ7kNvwFlwWlD&_nc_oc=Adr71wPJJthajO5A2BJvDPUahXppnKUTbz6S5DrwWadE41pqLARoyjeXglJM9jNN65o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OmPeUrpyV4x1GR8D9hqY-YLdvjNrqQ08PoocZzWtROQ&oe=69E365A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH9M0Dk-ccUQ7kNvwFyMprf&_nc_oc=Adq5VunNSC3-7LftPp3QB6Iv6fFW8YsBzIhe5mvtrwn7ac7sdIvdP4mCHehhZj0FkQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19R-kHQ1vI2uwJCAirD6HAYvcC9wGs3gIEDQwdaN4KXQ&oe=69E391BC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNPNaEkLiA8Q7kNvwGqDt4i&_nc_oc=AdqDIlz4AKJcpmvMObeLlymYge2ELsWXYmA-o-y681wC-UmDSWEcIrqwPQshvhQivyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eLUORmalj2L4AtyWDsKuRFlHGRG7iuP_fEvHUXDeGAQ&oe=69E390B2"}, "is_con
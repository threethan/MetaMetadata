R0udklEOsfNmOP_FJM0teEDuYZ2A&oe=6A070C8A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgDfe3k6m1EQ7kNvwEZ_IBH&_nc_oc=AdquRwCyDNC6o8KPzlJ61-hgfM23d2RKjODWw5W5j5nQDXRJQJ-Y4A17XT2cSJX0phQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hB92FWUzH-cgadno-cENPKGLlzVBsJBAW8lmM-SyDSw&oe=6A0721E7"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCEjQ-CjU4EQ7kNvwGlLT4q&_nc_oc=AdqtFCl2RJIx5xbTmpKSG22gr9YeeRIGuoeIEOTFsALEUpLMLhMDoKLygb3KmN3_mYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IC099t8syUBntKplyzTcDY1-yue4bLLYKjSeUXXR4TQ&oe=6A073668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LpDWJXDxvUQ7kNvwEh4e71&_nc_oc=AdrOO8dXdLJkDuCfrps_CvJDDB518nUnLaqaE9pXbZRE8vSJyh_5hQK_Kq-lmzgVj9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59yVxBWWFYfdn7TJ7qKBDLHcyZokzc7J7S6UeSg6dSTQ&oe=6A072A3C"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRzcqWFX9CcQ7kNvwGpRinu&_nc_oc=Ado7-3ee21F4yiEyU11ppdbj8mRN5MejxWz4mZi7BEsnE11ua-CAGS9-IJb9j0TCI1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rTHtvUPUmeCC8rrf0mqY955G2i0u7HdzDatUnXfxyNA&oe=6A072932"}, "is_con
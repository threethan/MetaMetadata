5/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl22A1mzwH8Q7kNvwEip3hX&_nc_oc=Adm1rr27GK_HqvNizKM_yBSNvxK7WCWWh7Sx_ptk_OgWzvgU1MaK2X5aNfPeHQaYWwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi1LpolZAYV8isT4S5dfbOYhFx02beBt9xfzFnwgWxlw&oe=69B14CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvaxi_ubl0cQ7kNvwH9wDeb&_nc_oc=AdnQfzyvA6Dbl0m6mY3joI15WZdzTezdSQ_nMobUv788CMfc_xoImKqoQbdrutdS15o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBYTQYBkgo3kq7xuR0IoGZN4k0XHEvpn98SK0BMJAloA&oe=69B178BC"}, "display_name": "Learning The Maths", "keywords": [], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category
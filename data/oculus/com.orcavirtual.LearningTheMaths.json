9eUFgpsaa1sXUxbrKx03qsCW5TxA&oe=6A5A1B0A"}, {"file_name": "ThePedestalHighRes.png", "id": "1411528939559130", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031428_1411528942892463_5786402967592862437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg8HA91Ao7gQ7kNvwGwhc3w&_nc_oc=AdqGAXMZfmcGOCOb1T-3qRpXemWqIW5Nk2B37SkIsoUT9WsMAKeIlf2g_FNsn9C30FA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2coiCFZ3CgBvEa4hma12BqAWB7wZZGthFITV9YUPzFw&oe=6A5A3067"}, {"file_name": "TheTreeHighRes.png", "id": "2474785086242934", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003273_2474785089576267_5339940715474007309_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-pDxDQQTbMQ7kNvwEv67d-&_nc_oc=AdoewXCUDWSAB6dkuXNr_CPiAYIMDjDFKwM52z7wNVpaKXohy0v_vqlx3Jmp_YeAc4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0MLlHKnrI3yoMbvHUr3FpwPBN4rzHRF2Tctx2jKgHNQ&oe=6A5A44E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LearningTheMathsCoverHighRes.png", "id": "393815980375492", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984476_393815983708825_1687224200707679740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlzIK0c8GW0Q7kNvwG_mTya&_nc_oc=AdrxYIan7WOnOJqm1QgsAPbeFDSEJ770TnX6Qfd2OzMXg7Jt54VqXYhgwxWAOHnFOgI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_L58_1Ns26LHRt0v834UzvyJxxSxLboyfDDx6d6OLsQ&oe=6A5A38BC"}, "display_name": "Learning The Maths", "keywords": ["Education", "Mathematics", "Science", "Social", "Fun"], "long_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics.  This platform is an evolving ecosystem, and new content will be added regularly. The greatest feature is the social networking facilitated by multiplayer mode.  The greatest value will be the communities you build here. Version 10 and newer version are not compatible in multiplayer mode with older versions.", "short_description": "Learning The Maths is a social platform focused on the teaching and learning of mathematics.  The multiplayer rooms are intended to encourage tutoring and mentoring in math and applied math.  The included games and teaching modules are meant to take interested students beyond the basics. Version 10 and newer are not compatible in multiplayer mode with older versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orcavirtual.com/LTMPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25064559316498985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_800764658829840_2421879972465347623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvExyXagskAQ7kNvwGbQ4ow&_nc_oc=Adr_pAP01H0NOnKq2qaLJETOp7Ftjf-PPiwJUZdDxkF8AIOhlPeWTOmM7rCbuB9peII&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAitiUOP0MfAMO4j-MoC4-5ht2B4YxLESTZh1YzQICTMw&oe=6A5A37B2"}, "is_con
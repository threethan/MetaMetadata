&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWi6XtqNlXgQ7kNvwH8ozUN&_nc_oc=AdoHoaZp0dUkgtebqbdmCA5UdFRDhw9HTCP7SDKHaq6M4ntzqOBEjJLKQ1fdTUS8L-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAIeRSInZU5ZlHQqm4c0KlL01upZLu-tESxFTW1BoWYw&oe=6B086BF5"}, {"file_name": "screenshot_4.png", "id": "172713377912571", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974730_172713381245904_8730668830560331749_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6rJR-oYuzUQ7kNvwG8Qs1F&_nc_oc=AdrIiYpY8rBxDQ4GVOVVQexWJLGcLCWOyLGIgYLLV_C18ZlTScYwyEEPU1IUeoJnaX8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2EG9vusGaCQc4myWHJXJDNNewdB10LPbXY4GRVE64vw&oe=6B0859B0"}, {"file_name": "screenshot_5.png", "id": "479270489785045", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974853_479270493118378_1762075908437022446_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-adSxbw4akQ7kNvwFnMiRk&_nc_oc=Adrh_NPb_ol79WtlnkiD9pZpu6d9lFy95vFPhzk6_c9xzysDghYUr8VcFSudRSwPNRg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDz6pfOB9S2oXyMVu23lzWyM6hI6PwFVw2mrQK2NeIJA&oe=6B0861D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DEMEO HERO ART NEW.png", "id": "2755632404736706", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982701_2755632411403372_1433407816910889392_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rZ7r1cUzygQ7kNvwHsmDtG&_nc_oc=Adorlp8N-oOnqrpDl6O7pD1-v5EMTs70lOxO-KcCpKGvMdaw4OtY0hqr7mBle5y7RsQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyQqyKXNWztWz2wlZbNASlDGA-dPGYob0eItbNBIvh7w&oe=6B084E25"}, "display_name": "Demeo", "keywords": [], "long_description": "RPG fans, it\u2019s time to unite\u2026 and add Demeo to your Wishlist!\n\nA dark force has taken over the underworld in Resolution Games\u2019 upcoming RPG dungeon crawler, Demeo, and it\u2019s a world you\u2019re not likely to survive alone. Terrors and treasure await as you and your band of warriors come together for a virtual game night to brave the corrupted catacombs of Demeo and delve into the most immersive role-playing experience available in VR. \n\nWithin the fantasy roguelike game of Demeo, up to four players assume the role of eagle-eyed hunter, mystical sorcerer, deadly assassin or protective guardian. But choose your champions wisely in this cooperative virtual tabletop adventure, for once you have ventured into the Elven Necropolis, players must work together to vanquish the unholy armies of The Mad Elven King and set him free... or die trying.\n\nThe ultimate outcome depends on your choices, and whether the die is rolled in your favor\u2026\n", "short_description": "Gather your friends and brave the unhallowed catacombs of Resolution Games\u2019 RPG dungeon crawler, Demeo. Add to your Wishlist now!\n\nTerrors and treasure await as you and up to three friends unite in this cooperative turn-based game to combat the forces of evil and vanquish the armies of The Mad Elven King. \n\nBut choose your champions wisely in this virtual tabletop game; once you have ventured into the necropolis, you and your band of warriors must conquer the nether floors... or die trying. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/demeo", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "STRATEGY"], "has_in_app_ads": null,
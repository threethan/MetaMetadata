3381245904_8730668830560331749_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1ctmW1A__gQ7kNvwE3LEkf&_nc_oc=AdpWCXww_VfeqMjnjBdP2wCpN-HGAnC6ymTreEyAr4r8dmA075MZGC7CSgus-1pWhMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HjZM8x_JxKI9rOlaU36I5Uo3mmQVucpN__89doCEXDw&oe=69F9DDF0"}, {"file_name": "screenshot_5.png", "id": "479270489785045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974853_479270493118378_1762075908437022446_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caF1bapnoAAQ7kNvwEKWP_H&_nc_oc=Ados9ig8HJLSJs2A2lo9oStydPc-2gneo7yNa-HzC7rtiT-2qW_m1vDU3WJhaTsz4_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kVvC-pW3vwvue2aWd5DkU5xkQ_2EfM01TM7Wr_f2Xhg&oe=69F9E619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DEMEO HERO ART NEW.png", "id": "2755632404736706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_2755632411403372_1433407816910889392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXfio8j19DwQ7kNvwFM5OOb&_nc_oc=AdoQHaPzZ9w1__9N3ClC5lnMRBH2UVPJ4mxI1nY14S2HiGtToHqB9FPa7TKxtNhuW8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ELEY7RGtB_uvFUWDRFT56RAR6Rjk74mu13dGqLLepNw&oe=69FA0AA5"}, "display_name": "Demeo", "keywords": [], "long_description": "RPG fans, it\u2019s time to unite\u2026 and add Demeo to your Wishlist!\n\nA dark force has taken over the underworld in Resolution Games\u2019 upcoming RPG dungeon crawler, Demeo, and it\u2019s a world you\u2019re not likely to survive alone. Terrors and treasure await as you and your band of warriors come together for a virtual game night to brave the corrupted catacombs of Demeo and delve into the most immersive role-playing experience available in VR. \n\nWithin the fantasy roguelike game of Demeo, up to four players assume the role of eagle-eyed hunter, mystical sorcerer, deadly assassin or protective guardian. But choose your champions wisely in this cooperative virtual tabletop adventure, for once you have ventured into the Elven Necropolis, players must work together to vanquish the unholy armies of The Mad Elven King and set him free... or die trying.\n\nThe ultimate outcome depends on your choices, and whether the die is rolled in your favor\u2026\n", "short_description": "Gather your friends and brave the unhallowed catacombs of Resolution Games\u2019 RPG dungeon crawler, Demeo. Add to your Wishlist now!\n\nTerrors and treasure await as you and up to three friends unite in this cooperative turn-based game to combat the forces of evil and vanquish the armies of The Mad Elven King. \n\nBut choose your champions wisely in this virtual tabletop game; once you have ventured into the necropolis, you and your band of warriors must conquer the nether floors... or die trying. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/demeo", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "331506928878955"}}]}, "scheduled_offers": {"count": 55, "no
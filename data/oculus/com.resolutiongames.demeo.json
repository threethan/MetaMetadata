file_name": "screenshot_4.png", "id": "172713377912571", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974730_172713381245904_8730668830560331749_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbZ9wx6lgI0Q7kNvwGL3V_L&_nc_oc=AdqMUupuNbhvV1Y0uUsxYEjnmLejs-mkZfoupFyFGX7X-VBJ9mPesfhFbw79kM3lV0I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN50nUO0dkK8OX4e3DO6aCncM7nhGX1G3xM8ZFeFGYI2Q&oe=6AC911B0"}, {"file_name": "screenshot_5.png", "id": "479270489785045", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974853_479270493118378_1762075908437022446_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfu2Va4xPvoQ7kNvwF9QrzP&_nc_oc=AdrI6gJwc2eO5M3mjuvXOf1Mv0hD1eQYxb9QOb_sa-Tnz85csTBRBY9fC36UZQGcssg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzBdwEj7cFI1fXnM-IB7xTgi8-PvpmFT7shKY62jmgNA&oe=6AC919D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DEMEO HERO ART NEW.png", "id": "2755632404736706", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982701_2755632411403372_1433407816910889392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rklZqwA62S0Q7kNvwFgBnEL&_nc_oc=AdrLPG55CL0oPm1LrUUkq5cm-B-tbpf3hTSy2H2w6OE638w6uHEFZN2hbqQlQPPyvKw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNJNGsnzfNz6RYGkF8VFzKevl2Dv0zdQXveGTWjD3zbw&oe=6AC90625"}, "display_name": "Demeo", "keywords": [], "long_description": "RPG fans, it\u2019s time to unite\u2026 and add Demeo to your Wishlist!\n\nA dark force has taken over the underworld in Resolution Games\u2019 upcoming RPG dungeon crawler, Demeo, and it\u2019s a world you\u2019re not likely to survive alone. Terrors and treasure await as you and your band of warriors come together for a virtual game night to brave the corrupted catacombs of Demeo and delve into the most immersive role-playing experience available in VR. \n\nWithin the fantasy roguelike game of Demeo, up to four players assume the role of eagle-eyed hunter, mystical sorcerer, deadly assassin or protective guardian. But choose your champions wisely in this cooperative virtual tabletop adventure, for once you have ventured into the Elven Necropolis, players must work together to vanquish the unholy armies of The Mad Elven King and set him free... or die trying.\n\nThe ultimate outcome depends on your choices, and whether the die is rolled in your favor\u2026\n", "short_description": "Gather your friends and brave the unhallowed catacombs of Resolution Games\u2019 RPG dungeon crawler, Demeo. Add to your Wishlist now!\n\nTerrors and treasure await as you and up to three friends unite in this cooperative turn-based game to combat the forces of evil and vanquish the armies of The Mad Elven King. \n\nBut choose your champions wisely in this virtual tabletop game; once you have ventured into the necropolis, you and your band of warriors must conquer the nether floors... or die trying. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/demeo", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "
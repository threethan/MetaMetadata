4GWsGXNoi8Hn2Hvlcq8VuFRduWx_fejw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vzptiAyO4iG9AJxwZhFPUCDOtHbP-ZwKRtFB4uuE6eg&oe=6A0F265F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtUxjNktxWIQ7kNvwGbX7pC&_nc_oc=AdrP5FqiULCnY8TJX8Epz0wrcphfdADHN3xhTMZmowKsSxDAlrDb9t44UzywCNp2kKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rTShfkunZmc0ppbwatnMYIAjISDEagGFdAd3Y690gyQ&oe=6A0F162E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Ev4RnwGVQQ7kNvwGFbeP9&_nc_oc=Adq4TbMbPCdMzKkUo2AyA-bo2lvcG8a3b05s-wh5VFf-HeRLHwxCRa6T9sYItKSARe0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60VTXttS5Qd9lp0Fhzs-tNOuh7EsZtSCrHJeZH9EZgwQ&oe=6A0F2242"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uyr739wYYiQQ7kNvwFW3b6J&_nc_oc=Adph9q2IIhw_FxOTOgOvl3e47fOjk1Dx0ILg-Oq-RdFFlfmnvLFz-4gBThgxt5ZfXMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47twG7byhvbzsv-Za8gDymO943iRyWCfrD9O-qOFU-sQ&oe=6A0F0340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULkMvBh0oPYQ7kNvwFZGX3y&_nc_oc=Adpbimwuyt3v_n-lV4NKgzKjXudMOt9HY0Q2V6LMqlnRcEm2fDMuH0yg521wTniHvG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N2K7KhbitXYRliCoEJxg5hnRnS5q0zFsJyqECJmwJnw&oe=6A0EFC5D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
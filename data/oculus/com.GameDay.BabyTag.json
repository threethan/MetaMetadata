jBfWXQdNquvTMFdlnyWhjWZCj2fFyY4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu7JeTWDb-jmyruv-0gfgdYAUq3hzynfscl831lDSOiw&oe=6A649F9F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRG09-m7HLAQ7kNvwENAOZr&_nc_oc=Adq3nWxswJaHxZhDjeEfFXDFcwbEShXeeh7EPvbBJU3xtomMPpfT_DO_Hv-HPjS8wrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfehEukvDMxVNlhEgl97YVuf8ICyMpgW5bvgus8F0Ydg&oe=6A64C7AE"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSAaHefdg2EQ7kNvwEuf_85&_nc_oc=AdqQfb9wZrkmpzs5bjb30SW6A6fgHzKQ8BXUvC5jskPbgTrLaVkxI4iLpZeJfbIUSek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4CUAn2cPbbf57eyihKif2JAQ4qzaa-sfN0aVbJBvgUA&oe=6A64D3C2"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3bxuJplLrQQ7kNvwG_ud77&_nc_oc=AdqYfrZMsPpq3-J3xzj8vNFCkwF-U0QmA5v4J2Yb-jl0MqSMN40Dftw3-PTOmhdQfng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCla50lWjjpWms7ItzPXWknZ0Psz24itz1YyQfzHQ-8Qg&oe=6A64B4C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onuWFP1aWHQQ7kNvwGTFKnp&_nc_oc=AdqT81xpQYMWlN1c-Y5vpKnDpfrT7JGdpS15YswvDv_n4R3iospXIaC2ykEW6yiavLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCESyGCyZ6PHlKMv9-I1YuUsHkBVk2K3uExwUFSAoylDQ&oe=6A64ADDD"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
70340424637893", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036686_470340427971226_5527383313252539010_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W69X0-u7XHIQ7kNvwFf5h-Z&_nc_oc=AdoaUT0wM5zVc0WStvnBPdOzF3hl_xDygcmpO_hOZ9bXRzvWM_hQO4tzO5AdC_hEqEw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vEz1NSW56bpp9HqQ6Yn8m2G3yQxkQPN5qPswCZJtGQQ&oe=69F217BD"}, {"file_name": "20220215-ScreenShot-5.png", "id": "482186193416937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974537_482186196750270_4100614178132899433_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PPeyUW9lYIQ7kNvwEDZzug&_nc_oc=AdpRGNdGl53KvhvDH3XGjW145_SkzdkFyIykmwhrnWMF3Q72kAVnEVjS2FKlrjGgMKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1PcyE481oJiYtgErIZq3DWunwnCgQ-CgqgVWsyBbFt9g&oe=69F1EB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kFp_M6UF1gQ7kNvwHAP44M&_nc_oc=Adoel2w1YAPuuL_T3ZH1roUCQCn-ZEIYykCnW6i9neaB0y9WZMaYVYcfSzlsob9kPcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3hC-gNj1zZ21T-uvnoUpiexhUzhvLjhIHHANiXia5o0g&oe=69F1FB5D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects to the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n\n- Climb on the walls, the ceiling, or any place you want!\n- Escape from several different baby types!\n- Throw a prop to babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Use props to slow down other babies!\n- Coming Soon: Multiplayer Mode and New maps.\n\nThis is still a demo version. Welcome to contact us in the following ways:\nDiscord - https://discord.gg/4f6y74tZ96\nEmail - feedback@gameday.tech", "short_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects to the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n\nThis is still a demo version. Welcome to contact us in the following ways:\nDiscord - https://discord.gg/4f6y74tZ96\nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://discord.gg/4f6y74tZ96", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2896229670667105"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1099010428159317"}, {"status": "PUBLISHED", "id": "683828169737277"}]}, "baseline_offer": {"id": "1099010428159317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1677175200, "status": "PUBLISHED", "id": "
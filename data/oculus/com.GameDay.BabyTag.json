-PYuSJ9XQtgKDOi4Ol0WmEHtwOMKF4aY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sW_WwXxRjfa4SgFHfDbTky4jxhYHvPAKBUZgotszRRw&oe=6A146C5F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V15575rn6UQ7kNvwGBjvgN&_nc_oc=AdotlZeMKjH72WK1FONxGitkCo5Fd-5W7Qd9csFRNpIeaKq8TvloO9-DQwPW_7POcJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VVQA5kbfwYTFESbkC5aV26xShQRbE1Vk8fXYAreTbzg&oe=6A145C2E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ8tR2AfvKcQ7kNvwFTdumQ&_nc_oc=Adpgb1j0wpA_-japO9cPb7ahG4MzWywrMyt1nZogOoUeNgSvBLpN3luAmkMQLwRgjl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HWcc3mq-HvwQkscrV97Zct5a7YpwlaI-kaqoVkZ7EEQ&oe=6A146842"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwiBF0As7a0Q7kNvwHK8xjJ&_nc_oc=Ado0z1-PES3VO1tq0hTsdaFdD_cdvWobOWu91RCXpMPD5wCWFRmTCCGRx9i8TO8Q0vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hu4UMyU6QZS1gho3aLIykQF7_N89V2depSXcUlKQX8g&oe=6A144940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7m-ECs8JKwQ7kNvwGJTRzU&_nc_oc=Adp4rDuEmC3Sltn2PsZCdHHNOI_2GysZIx805a_CSEl53H7QfAG8bPtpglz_z6Fq0jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62dosC0RuJw-cE18G6sxzXS4CSlxTpLsXI4tNx7N9htw&oe=6A14425D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
_nc_oc=AdrXlJCKRdFsHWMv5rsB3FiozgesckhUec254f7yBbH-pzIKGQzqv4_uk28QogsKzKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdYD_g63-O6xG7CMH-3reYO1BW3palGKIDuRPM3WOENA&oe=6AFB311D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects to the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n\n- Climb on the walls, the ceiling, or any place you want!\n- Escape from several different baby types!\n- Throw a prop to babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Use props to slow down other babies!\n- Coming Soon: Multiplayer Mode and New maps.\n\nThis is still a demo version. Welcome to contact us in the following ways:\nDiscord - https://discord.gg/4f6y74tZ96\nEmail - feedback@gameday.tech", "short_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects to the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n\nThis is still a demo version. Welcome to contact us in the following ways:\nDiscord - https://discord.gg/4f6y74tZ96\nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://discord.gg/4f6y74tZ96", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035
ntent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mtFo8LGNWBGYZp0EwNeRcx32McK24cw0bOOsIIklZ0A&oe=69F1ED1F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP-L7woqqecQ7kNvwElkiR2&_nc_oc=AdrXCu64ELHkcrACJcURd7JxHWA7MCLeD7vOM1Hl52PKKPlvZTRfH6_XWz0Ayi9dnQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3d_hjIxJdD-hD4dLPfR5xOJrAaC-e_ywQN0wQ5iEqJoQ&oe=69F2152E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl3kkLJYLIEQ7kNvwEpVxeX&_nc_oc=AdpzZWqAWOLvRlZG-H1mQS6kqiIYx6sYSK9ntEcMeRjWtzGuKsg6U1KF_-EBdMF_p7o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00wxPj2uGoniNKd7_ZUVKkFSbmk_cta3EkY-U5Nk1QgA&oe=69F1E902"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gNXD4CwU58Q7kNvwG-BKkN&_nc_oc=AdqL83pBv8thNeUt9PiEA1bi0a5bqxPDG_51q5UZQfew2zYPaMWRB7QTf-4mTJyIGbg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1Eupw5koq3LFH_tRQhLFMB45gtE7RdUqKL2HuXiP0kkg&oe=69F20240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kFp_M6UF1gQ7kNvwHAP44M&_nc_oc=Adoel2w1YAPuuL_T3ZH1roUCQCn-ZEIYykCnW6i9neaB0y9WZMaYVYcfSzlsob9kPcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3hC-gNj1zZ21T-uvnoUpiexhUzhvLjhIHHANiXia5o0g&oe=69F1FB5D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "94386458
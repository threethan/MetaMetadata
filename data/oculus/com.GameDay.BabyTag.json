-M_hpr71kLtchOgzkdIzI7DwsPvK6IVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eCp7cgTAHJ9lCuFL86mr6A0U-1bwuojKvoo2fVv-l8Q&oe=6A3561DF"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiHdSf6ul7YQ7kNvwF9mc0O&_nc_oc=AdoLCqau9viVbWkKSOEKxu3NGuuJjyMXMXZM2s1BXpstmPcCJn_O8mhqJQ7Tz1__D24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lmIFxHta8IyqZ2Ly-amJM4G8WHjKOinZ5EbdyQ9jd1w&oe=6A3551AE"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ui0n-LWAacIQ7kNvwHtMBFC&_nc_oc=AdpyXhWyX803M59QHIhR7Oz5TIgUZu0YHZSB50kBYTEwTkwwkWpyEzQ7zOvj60BI7Bs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q5Q4yMcJp8deprYCOC73v9s3OnQsV3L5c1WwFuj-M7A&oe=6A355DC2"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iioNSqkp5acQ7kNvwHr8Tzd&_nc_oc=Adr8jz5CuLgD4pAgov3aHmMeeyCqvGNERVCXn23QIgVO0OIjgrXJagwnHXldHT63F1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ji4RPN6BvkzMSXPPhQjFq_zfVlxUYi3X9JX5Mwe9ggQ&oe=6A353EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r0tWbiUeKQQ7kNvwG3dbWT&_nc_oc=AdrW71Ju864nNSe2bXbO1amW34y2w4999dqfroObqj6mpbDlg2XAbrEgu4kzG-g6N6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sbencXXlLZjD6xJb4PsdzZ8YzpmTq3IdjHPgErWH6LA&oe=6A35701D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
_e6AGK2GQxhKZMC1k9KhDjLwT2C8nN4Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTM-VW6WZkAFrz7Xg5jVJZybkdF_ClT3XEKWRrStId5A&oe=6AC909DF"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKMZsKQkZbkQ7kNvwGHqvUK&_nc_oc=Adrm05Whx-JjjJNj2APV0AmGGdkidKY-1czetw2jh3KBdO_xyKKPVYzrfNybp_C3bns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6wzzxdjDWR_z-Eo3T3hLMrjaB-ZnVPrqqpg-BdUHo3A&oe=6AC8F9AE"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mFPhAx8gxwQ7kNvwH5q1l8&_nc_oc=AdpXKOB67H23VIKM6fzFDU-ep_S08_Y5vN3CD5mSl2eN2S4YWReAulDxfCNsJQdRi_I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrWS6UfQMZ3sjeEr7c5hJ8SdDyL7jlN6CyU7L5sNTYrg&oe=6AC905C2"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cURnA4GtZF4Q7kNvwHBa0Xw&_nc_oc=AdqOx2SmV-rjLG4vNqeyJOZucEueJnQ6pT8Jx557iYvYaWiNhSaEatbLloy97DNz1MU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrlcJ4WgZjjpPwMjOlxmAqaiehO2BFlH94o5nmI_UwsQ&oe=6AC8E6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9B-AIA1EnIQ7kNvwFzjlpq&_nc_oc=AdockUqbu803Q3AIJnYBTE-8Tc0Z0K3w3mqAxCnPDJ_4ztL5cQcZRh2Ggx9KgrvHvBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSNCXcemrU7jOiWxShkcbBmMF5wsLbd4xUneWsLF2LhQ&oe=6AC9181D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
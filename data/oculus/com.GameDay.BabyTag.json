mCAQp17LrmQn7HHe6WLBKFmW8iA&oe=699D8D1F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U43J-W7KdsQ7kNvwE0EgtK&_nc_oc=AdmDnvtb4LYFGxfyvJTOeTM-kdyzjs2h_UqbjYfFvzKxir3jWc3Ea5vbcP8if05jkRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6ZATFsXOMHhfWZs-r97DNRhEuT4JntgCuNFf7QVj4_A&oe=699DB52E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25GICzRakGIQ7kNvwGWjnHC&_nc_oc=AdlCxvJD5B1Na8mlUaHte2bZjD73gSDDmMuRqjEXzeM1cCwnNUAzuoF8pZPRP2vQIRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGKOTxiQLRqk9TsWM6HtTT634b95LgwkRKka1oB3jr5w&oe=699D8902"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VXsOMc4DpkQ7kNvwF97hAE&_nc_oc=Adk6igZvhP9ppqKxrZAV3V9uQ2dDuMEHT8NYwfrkpAX4U6lJ4TJ302vxy8lYvdDC4VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvcPGoGCr0uyi7PaVNQu83_emTYxvsLh27ebhmfaScmeQ&oe=699DA240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSSnlQmzxLgQ7kNvwEGwTGk&_nc_oc=AdkRlKFkezLwjOFpsW4I9cOSeWNv_RUm9ftfuWmSDwSZyYWiD9gMdLqZrIetS_icmls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfssBpRuEZwjzuGcjKgoYVjvb86jbvuIF8j9Kw0F890p6g&oe=699D9B5D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "943864580244878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
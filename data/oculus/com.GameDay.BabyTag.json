jfUAJKh34UOumYkupKEzCF5kf7odoq4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZa5ybnY8SGF8Q41UtJYJmM8kpIQiz5c4YcUeEXAdk5w&oe=6A78661F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhGIoEv3JucQ7kNvwHm6aFJ&_nc_oc=Adpg_X3qBcF6bhoVPSFR9IMbv6LhS41UlEm5tyJxZVd0xc4kbHUtzzSeZyFQvk2bg9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiddOX62oa5VBTbu34MKXO5CMzG477sCIdF9inTMGRIw&oe=6A788E2E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZyHgC6UjQAQ7kNvwHMMcOq&_nc_oc=Adr7SxEu2uBk07zby1mcn3waQZMzDsdLv1j6DpOgiIYo3hoarcU15_Er5a7Kd97JIIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVf3K31RLwO0e00BmccpcyL072HdUKZA3zC0kPxYvplQ&oe=6A789A42"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYCmUyWrd0oQ7kNvwEgZN19&_nc_oc=Adrhz-ARveTGYQIXOd_YkXRX9eRjbtohNm4eQINCCuZFYymi_fZJsovCKvVBgbB24dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIceTsAdEYdMKJytVRm2hMSRjswVWTIHegXtRQZIoHQA&oe=6A787B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCc3c64cgksQ7kNvwH6TLc9&_nc_oc=Adou80cmVRgxVbD4t9zrTVcETiNt9cUJ5klPT1an36FqHBXWd8Z6mI-xocVpU-RRDmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL-H01_KgvW38xuw9vTWUY-8TIX_QOLvemAv9UrVGF7A&oe=6A78745D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
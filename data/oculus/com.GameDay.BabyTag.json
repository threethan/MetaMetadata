w9xPzTzlcnXCrb4rKWQe3agbFkiH7YJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WHo9bGBEPEHGoM1ZAf3pWbYPOmTx_YhKT_r9L79k_-g&oe=6A3E9C5F"}, {"file_name": "20220215-ScreenShot-3.png", "id": "480524596786010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86669353_480524600119343_3048951784524641183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJDeFXnyBBcQ7kNvwE8DwKB&_nc_oc=AdqyBTDtExhZVGYUah7FC3x59ayYVd1GBjGrB3bFmB7wInQJNP_Lcng5-9T-KkA3gkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cIM3FA4TQ4I-lcxOT3u7DvsMdL3Ef6AnfQCsTaFhFgg&oe=6A3E8C2E"}, {"file_name": "4.png", "id": "553619860062049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001656_553619863395382_1876496375979228396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXieDgTgFocQ7kNvwG1dUHi&_nc_oc=AdoRmRbHbRbEx3hSWw00A6cTjne7zX1wdDPwIbvzm6b0lqGRPMr7Sg-zzreE0fsSKkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UEcAfytmKUU2F3uDg5L4bIRnMEo96T4FqAplbwIz4YQ&oe=6A3E9842"}, {"file_name": "5.png", "id": "584259886891700", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_584259890225033_988868963508915964_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK8dli-lJwEQ7kNvwHCeUPC&_nc_oc=Adqk5e8BvnzIZ_lx5JLeycOm7KNiuzXvvENqGG8BdcbOC-P0tnlEt6Jv1Y_R6DtNqMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IeIepwrdh0Pi6UEo_KAcPYSSGQXMsKUOYak_ZKj_kFA&oe=6A3EB180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220214-TrailerCover.png", "id": "460610222433526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974913_460610225766859_5128284085787517535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK2ygVXkYcsQ7kNvwH-iIbf&_nc_oc=AdpJXMURxxsm1yOjnzL-uub-K1QU0zkW5xiNOLSwER5IgusrrPDphF0SWTnP3t9_g2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_47O_6jWgTeyKebsSAfM3IkdkAdcb2UqIiHevCDE7mDw&oe=6A3EAA9D"}, "display_name": "Baby Tag", "keywords": [], "long_description": "Be a baby! \nBaby Tag is a tag game where you can act like a baby! All the other babies will come after you and try to tag you. You need to run away for as long as possible! Sliding across the floor! Crawling up to the ceiling, or hiding under the desk! Throw objects at the other babies! Use any method you can imagine!\nGoooooooooooooooo!\n- Climb on the walls, the ceiling, or any place you want!\n- Have fun on \"mini city\" or \"room\" maps!\n- Escape from several different baby types!\n- Throw a prop at babies and watch what happens!\n- Compete with other players on the Survival Time Leader Board!\n- Enjoy Multiplayer Mode with strangers! (There is no voice chat, so you can enjoy your game quietly and peacefully)", "short_description": "Be a baby! Don't let the bad babies get you or you will get tagged! Crawl away, climb on the walls or ceiling! \nThrow props at the bad babies and watch what happens!\nCompete with other players on the Survival Time Leader Board!\nYou\u2019re welcome to contact us in the following ways: \nEmail - feedback@gameday.tech"}]}, "developer_name": null, "developer_privacy_policy_url": "http://babytag.gameday.ren/PrivacyPolicy.html", "developer_terms_of_service_url": "http://babytag.gameday.ren/TermsofService.html", "publisher_name": "Roar Wild Studio", "support_website_url": null, "website_url": "https://www.roarwildstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"],
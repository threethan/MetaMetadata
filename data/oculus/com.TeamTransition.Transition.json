 and Joost Jordens during their final year at the Utrecht University of the Arts. A metaphor for death, Transition takes you on a journey from one world into the next. \n\nAwards: \nReflet d'Or for Best VR Work - Geneva International Film Festival Tous\nEcrans 2016 \nFUTURE SPACES Best VR Film - Kurzfilmfestival Cologne KFFK N\u00b010 2016\nBest Innovative Graduation Project - Utrecht University of the Arts Awards 2016", "short_description": "A metaphor for death, 'Transition' takes you on a journey from one world into the next."}]}, "developer_name": "Team Transition", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTWepe54tPB-u8nBGQRBas9e9qooowuUrlCmAVinbKgspBQLsZfjeB-xHxI8wyBdk_bhYlkQ--uxQS8/pub", "developer_terms_of_service_url": null, "publisher_name": "Team Transition", "support_website_url": null, "website_url": "http://transition-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MUSIC_VIDEO", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8966603926799819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974694_190305835239371_2591503276935479296_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrlH-KWu6TUQ7kNvwFLWI0M&_nc_oc=AdmWG1HFv_cs8mJZx8o8scXUzudtq7h9yh2bSm3ytuLAl2uqwb_KzDHdpOlJGkFX-38&_nc_zt=3&_nc_ht=scontent-ord5-2.ocul
ge.png", "id": "265418287786162", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138837_1641603622795880_328009599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuVzg5gYReoQ7kNvwEDI7RH&_nc_oc=Adp34MfM7qv1E5s3oL1G5_bLKjctZNvVz4CR9g4T9E3DLZ2fa-MBRCT2ckFyjjyA4tM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKpqjj7R2Q8_6dAPp3rS_dcxDVQ2gjuCnKwtSEhSQM8Q&oe=6AD24200"}, {"file_name": "migrated_image.png", "id": "219881832545825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138799_1483677835271911_1166684622_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCRhxLAxq_oQ7kNvwEgS3z6&_nc_oc=AdppLp1_Xgvdjt933EXNFuVvDesqAXM-PJ62DzGuVwPjAb89of-uk7N1Cwcgo2aDkNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3E6c7bybjaVqnSAO-53In6H7emgpKMmt-dTN-S7i_mg&oe=6AD22F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "terrormain.png", "id": "316914978666429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522305_316914981999762_1160310265695174656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSq8PGgKtewQ7kNvwGWzE_B&_nc_oc=AdoQpUrASFQioGKbioHNmv4snGrelZF1Kf-lcS3wXqPrF92hancHQjLmrYBcbZQhtdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbsJJXqcv00mBQ99QttLCz4psJFGsNpxkY1HB5ShKKVA&oe=6AD25574"}, "display_name": "TerrorCave VR", "keywords": ["terror", "horror", "lunapark", "theme", "park"], "long_description": "Welcome to Terror Cave, one amazing experience that will\nreproduce the effect of the famous theme parks terror caves\nwhere you sit down on a chair and a series of weird\ncreatures will try to scare you, while you cross\ninto a suggestive scenario.\n\nIf you are impressionable person that can easy\nbe scared and are afraid to not support strong emotions,\nwe recommend you the \"Sweety\" version\nof the experience, that will drive you in a\ntour with mild emotive and amazing feelings, but if you are\nbrave and love high impact,\ngo ahead with the \"scary\" version, and get\nready to be shocked with strong emotions!\n\nnote: We recommend use of headphones for a deep experience.\n", "short_description": "Welcome to Terror Cave, one amazing experience that will\nreproduce the effect of the famous theme parks terror caves\nwhere you sit down on a chair and a series of weird\ncreatures will try to scare you, while you cross\ninto a suggestive scenario."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.jined.com/", "developer_terms_of_service_url": "http://www.jined.com/", "publisher_name": "Tecworks/Polyraw", "support_website_url": null, "website_url": "http://www.jined.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "SIMULATION", "CASUAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "654243659053651"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "CANCELLED", "id": "1952902011626923"}, {"status": "PUBLISHED", "id": "530893317099395"}, {"status": "PENDING", "id": "1500206467397430"}]}, "baseline_offer": {"id": "530893317099395"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513152000, "status": "CANCELLED", "id": "1952902011626923"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2584489774981525", "version": "5.3"}, "id": "174024579603057", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
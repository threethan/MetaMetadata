n.com&_nc_ss=7f20f&oh=00_AQSwOO1tSY5NnMI5wSbpW9yFOnqy8nNp-y__4c0OPu10mA&oe=6B086483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "terrormain.png", "id": "1333554830538884", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974887_1333554833872217_1231813942993977587_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIco5OLNsIoQ7kNvwE4D4Ay&_nc_oc=AdrKUGD_MGN-66Q6LjB0IHbjmYdwtb8WMPX1bnh-uIegOZEyR0KlM17B68EmTB15Jjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE3nQz-LAWxhaovWtOiyQUgBHv4nRsZVcvLvUZuC5KDw&oe=6B08514F"}, "display_name": "TerrorCave VR", "keywords": ["terror", "horror", "lunapark", "theme", "park"], "long_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario.\n\nIf you are impressionable person that can easy be scared and are afraid to not support strong emotions, we recommend you the \"Sweety\" version of the experience, that will drive you in a tour with mild emotive and amazing feelings, but if you are brave and love high impact, go ahead with the \"scary\" version, and get ready to be shocked with strong emotions!\n\nnote: We recommend use of headphones for a deep experience.\n", "short_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario."}]}, "developer_name": "Tecworks", "developer_privacy_policy_url": "https://www.termsfeed.com/live/b8d02dd7-b3e6-494e-b958-2afe98ecd73d", "developer_terms_of_service_url": null, "publisher_name": "Tecworks", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": "APPS", "comfort_rating": "COM
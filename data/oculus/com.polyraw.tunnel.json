.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoCbohtzvogQ7kNvwGnlzdT&_nc_oc=AdqGwUN8j5K_gRKxYSftZb-UtgRf6eq6qnLeC4l0MWM1I0WLw3SCi0oCIt0OTP5Yi8M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mar5mLXx5LvekKRq5jwREJmd0PL7AHPjlegdZoq9Gjg&oe=6A22EC4F"}, "display_name": "TerrorCave VR", "keywords": ["terror", "horror", "lunapark", "theme", "park"], "long_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario.\n\nIf you are impressionable person that can easy be scared and are afraid to not support strong emotions, we recommend you the \"Sweety\" version of the experience, that will drive you in a tour with mild emotive and amazing feelings, but if you are brave and love high impact, go ahead with the \"scary\" version, and get ready to be shocked with strong emotions!\n\nnote: We recommend use of headphones for a deep experience.\n", "short_description": "Welcome to Terror Cave, one amazing experience that will reproduce the effect of the famous theme parks terror caves where you sit down on a chair and a series of weird creatures will try to scare you, while you cross into a suggestive scenario."}]}, "developer_name": "Tecworks", "developer_privacy_policy_url": "https://www.termsfeed.com/live/b8d02dd7-b3e6-494e-b958-2afe98ecd73d", "developer_terms_of_service_url": null, "publisher_name": "Tecworks", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "
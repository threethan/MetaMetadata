nd easter eggs to discover\n\u2022 Smooth VR locomotion built for fast movement\n\u2022 Multiplayer fun with friends\n\u2022 Frequent updates with new maps, features, and content\n\nCan you survive the dream... or will it become your nightmare?\n", "short_description": "Enter a strange dream where nothing feels quite right. Explore eerie environments, uncover hidden secrets, and survive the horrors that lurk in the unknown. Every step takes you deeper into the nightmare.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1n0TJiyRsthl7SvqrudKfrCM8msCaT7PcpYk6niVMkfM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "CrunkStudios", "support_website_url": null, "website_url": "https://ethandwiz32.github.io/glitch-vr-website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1827543998659060"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1005435735724085_6956823650981859840_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onu5jnjJ4NUQ7kNvwHvwazh&_nc_oc=AdqVKZdl65EsZc3nWi1TEzpH4g8hP7m91QBa8JuQm8kzH5PSkVsU4JMH2REBXwXDm8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRRKJLpCxEievJ4DwknsBpQlVfPSVaj_0PSDHEiRpIpQ&oe=6AA55FA7"}, "is
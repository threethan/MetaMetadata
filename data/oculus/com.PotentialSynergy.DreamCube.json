9_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWc6Q0PCLy4Q7kNvwE7uSU0&_nc_oc=AdmSyNnCiud6c0-I_97cvyH7GSM_p1AwkTgA9F30Ty9HghK39MB7pvKTWnzw3oSh9ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn3c5UbjCBbwIU_U8C1Voxa9hwfJYqEp4wdeopEPd1Og&oe=69B6A284"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsRCevKcY7EQ7kNvwHoYjU9&_nc_oc=Adm7r8pm9oWZJK2F305VauTDZUNOkbxTcKpvP3xm-SWROQgj-6R91DOuHl3deAHcj2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBxoQsy0Akb5KeQirnBPvIzCLQyzMExafv_-b7L4IMDA&oe=69B6A275"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJQtb0Ir1D0Q7kNvwEh_Aei&_nc_oc=AdnoAQpxWnXXtD12HDzp5jqhKBzbd8XPx8UBwG5fVBd6bWt0nLYHbEDw-CivOv6VmbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyysPaqXfv4uS4ryfIwqchj8_AJga8gGQ0d-VTOwH4hfQ&oe=69B6A097"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf7w0lJ95uwQ7kNvwEPFgHm&_nc_oc=AdlXmPryhHlGQHPIF4ytbJENSh4-4yIv118iZGp50NteJY8HRMNYcMYYDlAco59ywnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZFoChYB-RQSkzKwoolSLpQC-4csnzwUyrVplxNuwZsw&oe=69B6B00A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of 
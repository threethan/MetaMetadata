.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUqKWx58ZZgQ7kNvwHq7wE6&_nc_oc=Ado4h0UOU-VTmyN5FrG5qT8J7gmnCjWX1R75As91J0Zy8dHqTeT_N3IMuvyZygHkKzM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JRbKGNzaKXXU8tmEt1OmMyneONUVdYMW2dGTUD8cMgg&oe=6A119A04"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUKdACBmifkQ7kNvwFNck2G&_nc_oc=AdonJ73sIQSbppmxsgO_V8aHB7AQ7l-tSoX7stsv1QapHVWnBooBHRfarg1Rp2FTTFo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71wMFdLmk1eg-ygYe05uV7hrH3Pp1rFQaQ8nmnAAWh9g&oe=6A1199F5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDFsZKvlegYQ7kNvwHhpQ0W&_nc_oc=AdprNdYQSVBARjv-_d2Z0kC2SD-KW_XswCxvqcf4t01XwAtiQsCdntHfXP482xetZXs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nz92-ieQl_ZqCVHaT5J8NcOX46r34-3G_gT7o_UNWwQ&oe=6A119817"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsBtnyK8YsgQ7kNvwH4icxy&_nc_oc=AdqcDJkHlp0KVdXID8lYrNxCObuI7SUbAiNT-dFxDdH44RwVjSJX5ej6kM6hx6dhw1Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AdgYyyMU4xuo7V2_-_srLsqiXJf6ekexq4xc6ypLGnA&oe=6A11A78A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XJ_2M5k_w4Q7kNvwGz5tWp&_nc_oc=AdrRkMs1KaSt55PvisAFSHvPzY-W3B6VnuPVf4up0-kkshj9Y99iPOrKB_iBWaoyT5Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48yEQpTSrR_OikycJkI9A071h8QCTaK14ck389g9PNqQ&oe=6A11BA01"}, "is_concept": false, "is_test": fals
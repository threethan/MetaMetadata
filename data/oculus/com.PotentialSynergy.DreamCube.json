.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r39qgqdrQn0Q7kNvwGGXUQc&_nc_oc=Adr1pnfNxyYtBAExQmlUfQB_znpl2bbg2l9jceKdIAqRbl-LMdWIdZxCOd9cLFBtoO8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzB-TkgC_BSFsuUqbGkfRAik-Njuc-FXJeEGJFcCyK7A&oe=6AAEB4C4"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lFmiTJeJq4Q7kNvwGIYIcx&_nc_oc=Adqiye_tPSv1kRPGSgyztR9cENA-kJUeaH1E8GOaWamiHVHt9SgeJJLXfyR0Q7GwO3U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtntTgClgSiijvWgx6rcHlIj4XZ7C3GXX8OStRzH_72A&oe=6AAEB4B5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmMuo15l5boQ7kNvwHf4vMo&_nc_oc=AdptTGCBzDP7rI8PzX1hh3aOGvV1wGCJm7UHRBdvGhjJ92hy4ruX4Zy9b_Hhe1JHQDE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJipem0QKfEDuV2HwXzC4842H73cqcN0nSwP76LF5pd6g&oe=6AAEB2D7"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k33l9sZY_jIQ7kNvwGfga74&_nc_oc=AdoFyb6qC_fVHsGygRLyzQ51XazGNwqAPF068y_wCZyGrOyxIbXL8NjjNqCF0W6TjJ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8uJZvvBuWYxjGAUjiLQoH7C6g0BBi1Qga6e3c-WQvgA&oe=6AAE8A0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuySdy9sbloQ7kNvwGPP6Gl&_nc_oc=AdpiKOhIzQnL1uV4GjprcYgE24CQKrFi2uVjbpw-sCLnRErseok6rXJbdyxQOW-0okU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM7RtJUuiE-OvcBFUM1ZSNBuzH-nqX074y0WlHmnXRjA&oe=6AAE9C81"}, "is_concept": false, "is_test": fals
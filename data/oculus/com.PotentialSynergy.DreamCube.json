.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFIz6EjWgWsQ7kNvwFMab6J&_nc_oc=AdrWWBqwgeM91lTwjWBwvv1yqckTbQYMe-IJbKcLdtbGks3idFG6m28CXS-5J04ro1A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbPw37TnXilem8Do3m5B2GL5Pku44yhk-WzufhuruRWQ&oe=6A7DB504"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zqaU7mpVgAQ7kNvwErn_iL&_nc_oc=Adood_pTLEFUoV8qYvKChYJihWS-vJVFo22EmFn-EHiMt8oxOIdWdB6KRu5M3QE7acA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiAfE93lgKRWQkwprIhI1OA1-QP7RhJzBXeSrW7CB1Ig&oe=6A7DB4F5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_p_EL8dYLAQ7kNvwGdnMya&_nc_oc=Ado0TZZRxif7f-Z_b8RYj2PgFF01fPZhcXsNAw_dFVPvIs3CVvWc9kI0NHV_mxX_l3M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJAwGzbFtzYQ8sUJAfTRqrm2dfdmXVziZKkVZcjwmE5w&oe=6A7DB317"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRuYFS6CKj8Q7kNvwF--7dD&_nc_oc=AdozNYHjGLn2c90S7PFpQQlUGkxiFNfdi4Vpfgel4JhgmwfFdSjqcI7gj-QdNtQM26o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyrjY0KXyuPTWZCY2diSAV2OGIMiPfjSGrsQO6cOXdqA&oe=6A7DC28A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnqduNOdgA8Q7kNvwEde_-6&_nc_oc=AdpC-KEovqUnJRf_aLc83AL1jkXVyFBbk6LcFC8LmX8kstpekAeH77dMGQCRPMC2aOw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2XQg7ilkiPhpBARfq-SOY_-BiSzbb96j-lHYrxA80gw&oe=6A7D9CC1"}, "is_concept": false, "is_test": fals
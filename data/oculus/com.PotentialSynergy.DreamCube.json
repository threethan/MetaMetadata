.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzAYgBe_eaAQ7kNvwF2_xLP&_nc_oc=AdolgfXIg_-DK4FfnF6PX06I5FF3dZdKpFefpClUG1zh-TXK442MpwD6IGkxES9FDdM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZHQLUeiGiK3rWncqQzNsWtJ0fgRy7kSPYxTm8wENYIA&oe=6A395F44"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k6yIjdKzUkQ7kNvwFTyXJz&_nc_oc=Adp0ahr1XEIAOZgUXoAFG7PA5z55mBnO2Uh_YXppbQaqt9oklao8Nv4IDOH5iFxJt9c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jK9jcs0VUuW_z_uvYK8A5lOhhn0cDSSoMqjyFtPbsjg&oe=6A395F35"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ7hPNFhXqcQ7kNvwFL_YGh&_nc_oc=AdqBsvdD9_0YSE1KD2vjEf0KFbKmBvd53C-wMqVtJDGj933nUe10fUiU64yZI6O6cYE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_flhVGL3uzjyud8merwtFKqByN810wXVrX0nQwtUd2NA&oe=6A395D57"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV7I6A72YdwQ7kNvwFNwlQ6&_nc_oc=AdoaIVNeGFW61tw7qYuDRO_QqitBi4S7ipBBEawZOmfs_6bN2xZobWNjKKp1sLVnp2Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EEPlm51F8YKb9RTlnwrObJFpfdRj6kRdswSMsXZA7qQ&oe=6A39348A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-bKsTsp0kkQ7kNvwF8czgD&_nc_oc=AdqB0V5Jt0iNOd7WR56tM51Fwwyy6kVcIPDzOkyzfFrlPQM71MbdkoZrBdd7XMSMPqE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rXoDTfXGm7H-ahI0Bongws3QbTdXW1Rxf5CeWznmsgQ&oe=6A394701"}, "is_concept": false, "is_test": fals
a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8ff77bww68Q7kNvwGX-jVm&_nc_oc=AdrUV7FcB8kvWjyg3m2Bp7nUhU5Wt1HwyLJKsUDuyf5rDYvPua22AiGYQrv3wp-OPTM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi-DiLbxzEKZrNke0QdkvAuoRcSFSfAZ5PbmW9EZH33w&oe=69CE7D81"}, "is_concept": false, "is_test": false, "is_t
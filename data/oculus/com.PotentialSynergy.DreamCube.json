nt-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49uDOyR399sQ7kNvwHmj8GT&_nc_oc=AdraCcS3GD6ix8-67cyBR_AuUsajMeUxUHQsJNTay-FrNe_m3VyfD8vyAzhMggT7VFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRR5RJstYFjeIQbzEo3xoDRyPJOA-IlVP3JobWfrv5OQQ&oe=6B0C8597"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw38U1kdr9oQ7kNvwGvBK3y&_nc_oc=AdpfEa9y93Zl3tLaCL0RWPYw-YS8ozADFchAiOKjYFusqp_t-06VilLsW3Ww92BcZxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPuUELLa1E06kv4iXvnen2PPn-9SczYiqetOV8uHEYNQ&oe=6B0C5CCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy I
.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzAYgBe_eaAQ7kNvwG--H0Q&_nc_oc=Adpa6_FS4qk6P6a3QPgkUumAxmPS7MGzGXZ2zxgFPWAUH-HMbxaSoEhQiFfnTc-nuHw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80L8jnb2uV-93xxPYBXCWTxEpjju-e726Kxqr1ri3_QA&oe=6A36BC44"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k6yIjdKzUkQ7kNvwEx8mUh&_nc_oc=AdrWufscJH84O90BURLU4ebk9qK_nxaiCjBHeC7q2DzuNPnJP9NXPMJPfbw_ydPfEBA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BoYF6KPUf63UnNxmG-nJp8qBGFlhTbNfrs4dAx4MLsA&oe=6A36BC35"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk7HXzyeJwIQ7kNvwGzprH6&_nc_oc=AdoV-9vZwpTE_cHhX7WIYmteB3vnaZ9tWrjHTccGpg807CQRJhJpTAaWY65cV6wddXU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QaA875GPKzqP7ppxQRVfc2OkKmLmup9ARe0R5M1ZCTA&oe=6A36BA57"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca2wtwK9uLwQ7kNvwGKqp4p&_nc_oc=AdoOeqT1KrnH4ciyrWVeXdSO_30S8ZtvdpTyR2aj02R_Ny9SEAX21BhWg3n-dwrjFAU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FX7K7WAEy6eKq3E8YMlSqrdAVHHNmLVw1W__bEZ7URQ&oe=6A36918A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb4OXmHqjRgQ7kNvwE8Yrel&_nc_oc=AdrP8XPk8DF_9jA661417HJTc05Ek3n1M_T2HJZYXs2nG1mjMcKWuoRFGglW_WzlM_M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OArvnx73jFZENSF-yTjr4reFDwwCG3QB-jn3XMqQqgw&oe=6A36A401"}, "is_concept": false, "is_test": fals
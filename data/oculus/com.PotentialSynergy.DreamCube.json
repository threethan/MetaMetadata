9_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWc6Q0PCLy4Q7kNvwFKN6s2&_nc_oc=AdmxR8W9IAjXSMGwAjhAB29EJFKV-xmsg2R6aewgtsDXkQnDIZ1p2OzZfU0-Z2hwa7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0rxkZw2hlnMJ3AzqwP6TKrQi0HqgZUFcxhLBGF2QHXQ&oe=69B55104"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsRCevKcY7EQ7kNvwGBDetR&_nc_oc=Adn9yMU5TUHWXqqk_0GSjsy9mC6IboGaro1VsdRZNT8p5LoGxi3_TAZYLK9e3ymicTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHogyVV-3A_htw6-1d7IfXcIWSLuDBqxYnPYOCNQ147Q&oe=69B550F5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJQtb0Ir1D0Q7kNvwH81jcp&_nc_oc=AdmE75NMZpCvV2m-wtbFkLw9sN2dGMIMAWJ9iubI_OPu9mqwxdULjQnmrtogJtZJrmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcT6lNNq7JE-MZZ2yNzBiqk_tk8n8JLJJb_uXTOKb20g&oe=69B54F17"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf7w0lJ95uwQ7kNvwH3gOw3&_nc_oc=Adlq7gug6cfrYHMKqTeKY-CMkcZJmygXy80zA3Ufifa0N8jBhBKN_vt-lAWo1JdOvI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2Di3Ukhxe_f_M7fuGRVp0rpTfbgFNEhgh-PPDMCesag&oe=69B55E8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of 
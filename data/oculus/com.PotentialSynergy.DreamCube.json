-1.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UdpgOL4FqQQ7kNvwFMDiVc&_nc_oc=Adrx3qENul2kPXc9XWdQzew8IpYPHtEdwRYUnHFCH3gAeS6PfEpYz8pQDCx4Dfew_Fg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIbYmA06W3dnEbV9lVXlArPof5WIJz3I5x6hoQFFimHQ&oe=6A8D8704"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYibHNAzLZcQ7kNvwHeqFI9&_nc_oc=AdqWRKChd8YB4Lhr8z7Syw308V88Ouds1kY7m1u0IO6t-Ux-cspm8wurDXNPKFV7lx8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJvO-KzSmeTx13k-AABHtUYxD4TjinfZ6gAjLv0BPVXw&oe=6A8D86F5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5SvmzkPfCkQ7kNvwGvkVJv&_nc_oc=AdpJZhQETdg8giiekIpsQzUVw-Sadf32zCik3CnpDs26juVpawwnlckQqJukTuLn-88&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI0BlPcP__UywoynwIy4VHGk2qLYYZRDeSMyhZvTKGqw&oe=6A8D8517"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSl3tVMbRoEQ7kNvwGP97JA&_nc_oc=AdoHtkrEn2Z-pCXPv9fTIUUXcRtTozvyDpSnhO-0JxqjhkFEf5O1Re2wTIqEb0SPSp4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnLVGLIp8Sfp8M7G_BV5TQVBUQne0p1XmFw5Fy5LJVoQ&oe=6A8D948A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22lore7a9ikQ7kNvwFbAM9q&_nc_oc=AdogwbN5j4KebCBHd69dyGz_NXVXrAG0oL9d4RFy4ewA6L9tdudWX0E3y4Gzta3Dtro&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh7Jb5AL49J6ggIjMPE85IDcPYwzy03HSUCnXkJxFfhQ&oe=6A8D6EC1"}, "is_concept": false, "is_test": false,
.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fnH0iV7MrQQ7kNvwGgLfsO&_nc_oc=AdrGB-fU_Qo7gVBmU2SCoehOmXg-xfF9aQnm61MyS52JtYAK7_ARfJ-yvcX8zMWh2Qw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Q3CC6oiPVh9YueAvZEJoImVx98hOLUfsTMwMOyTA_w&oe=6AA3F084"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjGAOHOJRAMQ7kNvwE_c70F&_nc_oc=AdrKC6PrzsWzEVNXeT2vBWOG3HFzsiElCeXdFVkAQ63Rfr5NVWcQZiCWMsrP2YWig2k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnttJm_4Zx5kZCyud7OhFLrSaCniGMyxGCLH3zmR--0A&oe=6AA3F075"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tuMdHQAZvMQ7kNvwGoSS4x&_nc_oc=Ado35T0xFsuTxyd2B66dKSpi5dmW3MIsh0HR7IQmpzwi8PYqPxcAetgVCiu-P2yMRRw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFBpkG59U4-yiVxZX8W0V1jC-UZZjFXrpnT54EWl6lsg&oe=6AA3EE97"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gynBl6VYuUQ7kNvwGt_bUJ&_nc_oc=Adr6b1rZWtvuFtv9SLGk5EsqMCoaZ2NkLRBQodxZzWNzeRNNxKVvMfo-VcOhoMtxgpc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWm9qbrGV1ofDqRBB_wNLI7f3ejABzqHtkxEbmI99Z-w&oe=6AA3FE0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYpftgimwJ0Q7kNvwETQwMI&_nc_oc=AdqMUqLreVH3FSuZR-9yarD8-sdSFMu3mnbugCfJ9hRbeYnCrdFg2QLam9sHbEAFfrA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0iL-t4hPWHbq9tWrJHwBPyIDNHfB4Ht3rXVohuW9CuA&oe=6AA41081"}, "is_concept": false, "is_test": fals
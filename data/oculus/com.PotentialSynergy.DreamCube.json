62679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtzycQkStxcQ7kNvwEo01wR&_nc_oc=AdlkxTengpfe_CcF68UTDHCNjl94-Hd6tQfzdpgdYvURT_HeLTV_2wtr6X3S3N5263U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afyw2Ci1HdbRedjcZWGiBc-zWv7k_vSa9CP6ECghog8vJA&oe=69AAC504"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZV2agQO1m8Q7kNvwExPq1V&_nc_oc=Adno11KXWyO9wHbf3M1RetvMCpUijA1D7alg0i60n6UyLZZFQVstVFIlwAHbRI1tS0I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCWerJu1GPIDDjZm6TONX9GKlN0lFaQlrUkc7cT4qEjw&oe=69AAC4F5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0d5g8IfNCcQ7kNvwFqBOTG&_nc_oc=AdlhR0OTuLRRFL0MOXvUb05k68UqzgE0jUALWLeWQ_ZdX_86jI0SIgKOzqJdgHi6PYA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw54O4yVMBbEVYk2M1c3mMVjnxB8wQ-u67lpBL20fzvLw&oe=69AAC317"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9--BINsfCoQ7kNvwExFcBo&_nc_oc=Adk09459vdn4P-luPXvGZP1PqSk8vcZF1SBUGSZMta-As82JWNeFhgdHHzDdU2221kY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwebDQsuLvU6ckOiF_KXgNSrGoNC774TVQ4roYCO8Vv6Q&oe=69AAD28A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n5rxby3ykAQ7kNvwEaQguD&_nc_oc=AdmFFOjNEtGxVrk6kgfJi7MlwLRMz5PCxy5l4UMxw6w6vn-Ld1xMP-xqPEmXKUfbcpM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afwc2-KfraguLG-TvzgkZQ7heYGk_Th7R6c8PoYOvQ-tYw&oe=69AAE501"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "D
nt-sea5-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM5kmGi3hY4Q7kNvwFAcIBD&_nc_oc=Adpy8A9bzOpx_BccFPToCc0hq-EOUrcFUGgDT_1t-NmnGAUpQMTJYh4wO_yi6V8fnKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHl-XWJfkl4Oacj10AIWrFXY7GHkznmKSxvUN9EYs_kw&oe=6AFF1E57"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S7wkxWDF5kQ7kNvwHiCGP7&_nc_oc=AdoXLPNNjkDfwH4JMMfVdW2ZePWzUJjjVygvp6369CnJqUum8Aha9q7HpudLwfwdLC4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9g2rKppoo4H9OrEouTpOfwxw7gcKB_agjasgNEUEoHA&oe=6AFF2DCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy I
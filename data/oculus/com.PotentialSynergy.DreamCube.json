9_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lTNor4Ln0UQ7kNvwFc9Jh2&_nc_oc=AdluMif3xPPu8IjK2L5uYwOHrKzmPWXNg9-9nt8YvePB-kAlYRZvzDvZig7NN00idmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYR973d2pWSTMmAuqEbVAJnUdyjFMb5_tNrVlcZ1LUIw&oe=69AEB984"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNLwTDkplg4Q7kNvwGJM-6j&_nc_oc=AdkRwju2lFyvFBdR_UNXNvleTEOvWeAkFS97nWqer5JJTb-YtOdn8jdHrXM-5w8xKq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxf2dpGH4Gx5UoO-vBVy0wW_6lvghPsI81NMkE6koXrDQ&oe=69AEB975"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5euJ3tdo30sQ7kNvwGEdW8y&_nc_oc=AdlTezOk9Fkt0ULlrkbs1TCMOUWFhzhxZPTKPVgEkTj-1QBsTwYPaBLv5uHD-xR5L4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs7BaspweTM6ly9gE_osvpb3Xi_k0Ek2s2Tap2-1o7tw&oe=69AEB797"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUfrLyp-LuwQ7kNvwGaWBBG&_nc_oc=Adkk7VOOEOAiRirRGmc-bCV3tWTEPduZuImIQE6WRGwqszdZPpAwbidQYVdB3a5jIg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIlijDJJ3oTOh06zh2ZuYg1o_eomJtEEUJpPDOCZdS_A&oe=69AEC70A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of 
-1.oculuscdn.com/v/t64.5771-25/11162679_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UdpgOL4FqQQ7kNvwHE7opx&_nc_oc=AdrylazqUV0UE_TvAgF3_wbjGzvCALkI_5OMPi0eSUzw84LK15JtctUhiGqUVTX3mCc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcFsrUgQasDwVfgAaEBYIg8CTPwmbeE__UJ5-cab0PXw&oe=6A8ED884"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR1ly4Fo2_EQ7kNvwHorBh0&_nc_oc=Adp4AM9K8-gHaLnsQXznrhmcN6bHDxR8PcrTgShDO7XlT_adMO9xKwoZ6v5D_Vn_FAU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJZ7oqLT6YRPT1j-0PJCNGyLYfgnUm0bUSc8BLwrZ60g&oe=6A8ED875"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5SvmzkPfCkQ7kNvwEXiK62&_nc_oc=AdoCnov9jpBbJyaperZpiCO_ROM3s-JvY2zeiVpFVf83eWgBpjm3y725CNIrNoutad8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5QOY2MfR6bSBUEkzrTMMGss4KehgUCo72C6ljYFnLRQ&oe=6A8ED697"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Kgg8MByHVYQ7kNvwGme5di&_nc_oc=AdomgriYdxQVoMfbF_ndwwUoyuGPfz0P9H9nHuazBFlsL7rkJoMtqwDrTRtQNxcxZdw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOp_2fge-CM9xOJYAl_wICcex4LtvVN847feLJrtabzw&oe=6A8EE60A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of the few, if not the first, native VR experiences. It's our first attempt at tapping into the medium's true potential with what we call 'dreamscaping.' This is the ability to seamlessly transition between spaces, like a dream, without breaking cognitive flow or immersion. Learn to navigate the increasingly intricate realm of The Dream Cube using nothing more than your mind.", "short_description": "Lucid dreaming for virtual reality is fun, but can you escape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "developer_terms_of_service_url": "http://www.mindfullyaugmented.com/sample-page/terms-of-service-and-privacy-policy/", "publisher_name": "Potential Synergy Inc.", "support_website_url": null, "website_url": "http://www.mindfullyaugmented.com/potentialsynergy/", "category": "EARLY_ACCESS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1946384518882348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162727_127923101147242_2187742274840952832_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22lore7a9ikQ7kNvwFZ7VR9&_nc_oc=AdpckOgz_UspTpL3DOxpm2kV_1u-Hru-swMd9FOvs_NivHqTJQ2aYDk4I991hVENnwg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoF_xbRQ2Fo0q2B0t84aWNHBomoG7m092PgPMRIK7dlw&oe=6A8EF881"}, "is_concept": false, "is_test": false,
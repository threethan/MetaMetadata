9_470041520036964_617050826065575936_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkVRBqzvoKYQ7kNvwEKWKzG&_nc_oc=AdnmCCOx8JSskNiv_QzhHHi1GAUSn5-TKQ0bIh2sWkCIVdG9WkSS--XzbKZZMzRqyu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyW2PY4Q0ad-zd_kYX_d5s7CliiKdHAYeU2UY8Nu-sqIw&oe=69BFDD04"}, {"file_name": "migrated_image.png", "id": "504564977095367", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_158085754757108_9034383150729396224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPAMXL6YqR0Q7kNvwEQY-Lw&_nc_oc=AdmW7aaiYlv4F_CRulPUwxRyn36EmR4zZouvr4kjQPRPHTgCtnzTuVCgSSpYdldVGi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfYmPv4UHAZgdEcKdmEjJiRV3N0rvQrtd-HoXxKfkIVw&oe=69BFDCF5"}, {"file_name": "migrated_image.png", "id": "618042775706561", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162683_970754993067293_1528367535370534912_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFxCmRy2BQwQ7kNvwEIArJJ&_nc_oc=AdmIT6KhjWPnt2Yovv4FaNNp8PCb6c6vLyn48TqPU6Haf1fzglXTHop3ZS1MiKNn664&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2kzIXpaXygSLPm9whnzx1GA9giGHxbaRKLupGDKiFtA&oe=69BFDB17"}, {"file_name": "migrated_image.png", "id": "193167735317169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_1448161291897002_2285584773759893504_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl4HBlYS1UoQ7kNvwHGtQOx&_nc_oc=AdmpRZBIv84K0mdvEFvSY3G56t3wiEGfZUza66uImGBf4aI2ZysLCTSH7s-eUUL_17s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBOvG71AkdtARqvh5ykP1RT8x0M1lQm2f2MDjhQ4Vu3w&oe=69BFEA8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Cube", "keywords": ["Dream", "dreamscaping", "cube"], "long_description": "Can you escape the dream? There is nothing to touch, nothing to press, and nothing to swipe. There is no reticle to obscure your view or tutorial to hold your hand. This is not a 360 video to passively watch.\nThis is one of 
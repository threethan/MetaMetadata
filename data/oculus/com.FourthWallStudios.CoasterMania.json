=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYnTpVBfyvcQ7kNvwEJ0CIh&_nc_oc=Adq8fWK1odamCndAMwHT4gnR0K3F7r8y8P9CoiPpmWeJseunlUXRZXx8xfAEwBKFoz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz76EUu7Tq9hkGe8cKtZmIywVhWIvVSf85B0WbR4I6-w&oe=69CA841F"}, {"file_name": "CoasterLoop.png", "id": "1452108869718105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1452108873051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5draTiNvXQQ7kNvwFIFMy6&_nc_oc=Adrq9bLDIRh9fFZtsvCfUvcclC3gpFcBjfvguIXQTam_UWjNV7KA5HCugPGskVSJqt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiDN_ufinnk_223zgf60g-7uEG5qap_XoNaiZjxt4eXw&oe=69CA631B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr5vvkauC-kQ7kNvwGU4SQT&_nc_oc=AdpSrMe-guNyPOURfex2GrGe6nh5QqLz1gQZuTfomyRJZLRWkXZUb__mtb6awzDS-Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynwumeRFnDURd9fUih4ifhh4yAWnCtYsH9tqaEWZ3toQ&oe=69CA6EC7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1mCDZtA0MQQ7kNvwH5zC9p&_nc_oc=AdoGxt30CR6qpRw1N_apX4WVpUj0Hu0dfsQhAlvQ43RttZQra6eqDS23ssebxPqwgNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXvLRngzeVZMGIF7G_R9Q_A8sBHfZsgPI1TOcthayz2Q&oe=69CA79CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hand_Tracking_Landscape.png", "id": "25999640789732149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830593_25999640796398815_2489229061819529305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EC7s7jQdg0Q7kNvwFYg6Yo&_nc_oc=Adoa6TohD5_mvP_ACiPYxkrr80x7KnCxQ1tB81Jt_VDj_A9u1pf8o24ac8fxQ3cD1gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEo8kpUs9OuPqIKMfsDvgDLySinzyj-AGtVrrFN3p93w&oe=69CA7742"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscriptio
9twylEAKeGcdgdnfZjzQ7vrKFETJEkMGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8hEDTXHAtbJCDkUPigkmkdI3RSSKJnYrPuqcPXA1SeA&oe=6B0F1C82"}, "display_name": "CoasterMania", "keywords": ["Sandbox", "Build", "Themepark", "Ride", "Rollercoaster"], "long_description": "# BUILD CRAZY ROLLERCOASTERS IN VR/MR!\nWelcome to **CoasterMania**, where you design thrilling coasters, then jump in and ride them in first person! Use physics to solve puzzles, or let your creativity run wild in sandbox mode. Then share your rides and explore thousands of creations from players around the world!\n\n{980830694715908}\n# \ud83c\udfa2 PLAY, BUILD, RIDE, SHARE!\n- \ud83e\udde9 Beat 50+ puzzle challenges to unlock cosmetics\n- \ud83c\udfa2 Draw tracks and add loops, corkscrews and other inversions\n- \ud83e\udeb4 Decorate with 200+ props and a full terrain editor\n- \ud83e\uddf2 Use gadgets like portals, cannons, springs and gliders\n\n{2725109701238040}\n# MIXED REALITY INSANITY!\n**NEW: Scan your room, then shrink down and ride through it in first person!**\n\nUse mixed reality to the fullest as you design a rollercoaster through your room! Build across your furniture and throughout your space as supports attach to surfaces and carts explode on contact with your walls!\n\n{916606438205600}\n# SHOWCASE MODE!\nRide coasters made by the community, right in the game! Upload your own creations or browse featured and trending rides. **No headset? No problem!** Share a link and anyone can ride your coaster on the web.\n\n# Join our Discord Community:\n**https://discord.gg/qaBgpCE39Y**", "short_description": "Design thrilling rollercoasters in VR or MR, then jump into the front seat and ride your creation in first person. Add loops, cannons and rocket boosters, test every drop, and then share your creation with friends and family!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://discord.gg/qaBgpCE39Y", "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "40174577188854098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835801_972893122306837_6892043390214807844_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI-tF3HsjhsQ7kNvwHNnRo7&_nc_oc=AdpRAaTce4PTPACzsd3zLL4ujGvHeZqCzTT9aLnJ40SrTwRxfL1En490-Sl2FCdg2ig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9oC_MXXJbu22v33nXpoyQA1ndK53dp-7NejiBwFQrtA&oe=6B0EFDFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CoasterMania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1733421600, "lastRevision": {"nodes": [{"id": "7856648804407022", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG7NMS1oUJUQ7kNvwEB6gzJ&_nc_oc=Adqmw4vPygUiFq43nNYHzKSDN1p8yYHbTUiAfBT-h1QT9sLCDcI5PzREPq59TgMDI5g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZUjCai6o_gUnVGDIatZ75RQDCC_eStUFjiEfWKlJwCw&oe=6A8D811B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-wG4OsjYsgQ7kNvwG5BnQz&_nc_oc=AdqtpqQagUYJG8jKyADL0qeR1LpegwSsmI0s5nw4Y4gef9nekQI7CxK43GwM9teiyoE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5FS3A6GD2-s8HDiZsLyj_8a4PekF5bAFsJQ4yZp5dFw&oe=6A8D8CC7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbURkZj5oa0Q7kNvwEPyko7&_nc_oc=Adq2GkPgv-eLEOlv3JdE4dr0poG8Qe3WialHjJVEZSFyb9UcFqOlqtrWZd1YMF-zOaE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl5MuWAWoQdf9vzCGACI_Kalq7HfOXlEsTnBn9As-dSA&oe=6A8D97CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoomScan_V2_Landscape.png", "id": "1264881522313250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499299891_1264881525646583_1207586500219889839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qbJUZpLvYkQ7kNvwGHPlDN&_nc_oc=AdpQ9sbuS8epxAGxDvwX7Gchkd0Ofw7rWpn8RTo2Y_uNlqmNsVVfrOpt5bKy5dVEdBY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGhdXMxJN6-CjUJS4wt-lO0Qgo8GNVclj6x2PNDfhK5Q&oe=6A8D8F60"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Turn your room into a roller coaster.\n\nBuild tracks across your furniture, around your walls, and throughout your real-world space.  Then shrink down, jump into the front seat, and ride your creation in first person.\n\nBuild naturally with your hands or controllers, experiment with physics-powered gadgets, tackle 50+ challenges, and share your wildest creations with the community.\n{2874787972689001}\n# BUILD IN YOUR ROOM\n\nTurn your home into a coaster playground. Build tracks across furniture and throughout your space using intuitive hand tracking or controllers.\n\n{1637917944564412}\n# JUMP IN AND RIDE\n\nShrink down to coaster-size and experience your creations from the front seat as your real room becomes a massive theme park.\n\n{1078555903573759}\n# BUILD THE IMPOSSIBLE\n\nLaunch cars from cannons, blast through portals, attach rocket boosters, sculpt terrain, decorate your park, and experiment with physics.\n\n{1092357901949034}\n# TAKE ON 50+ CHALLENGES\n\nMaster coaster building across Medieval, Western, Atlantis and Sci-Fi worlds while unlocking new cosmetics.\n\n\n# SHARE YOUR CREATIONS\n\nUpload your best coasters and discover rides built by other players.\n", "short_description": "Turn your room into a rollercoaster! Build tracks around your real-world space, then shrink down, hop in the front seat, and ride your creation in mixed reality.\n"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
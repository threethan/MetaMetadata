=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYnTpVBfyvcQ7kNvwFBprdQ&_nc_oc=AdpuwpkapIV770ngKeTXaCvjeZnH76AtA9ddButvWKXVH4ThQBSud38shcbL26bXxSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBZREFjXIHhg3c1d8JsRt_G12rOPGmSGtdpK8Gu6XzJg&oe=69CD271F"}, {"file_name": "CoasterLoop.png", "id": "1452108869718105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1452108873051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eorLJ1xk0RwQ7kNvwH0jVzU&_nc_oc=AdquQtTM-NAFw9PT8mBhiJUr50a9JQw_F7p3h5VXRXPlPhb4rV98klpq7JXfAcnGf4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiLHkpXeEYs1QTrHKkuYjcqTgJ5lb7BhV6oTFI5TWxHQ&oe=69CD061B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSk-8ohjYk8Q7kNvwF0Yg-z&_nc_oc=AdqUMhY9n-TXgtQ6f4EOU7cmycIUbidgiSAqOK7NreS1FvYv3Kx3Dw3XpLrwYMuhJUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtVz4chVB2EUN6XCwUGDSv-iTGZJQfEID9SowUgGoLoQ&oe=69CD11C7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBQtUSR0T1AQ7kNvwEF7Q6f&_nc_oc=Adqyqb-XrJjzAtBTVIpwN01_DCjTrkVyAc1eRM8oPUHFVM6hLOAnaVJ9XfNi_jQozfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwThImEbDGWnLDJrfsksCwVYaDkx4Q_b3YAzeSWuFKwVQ&oe=69CD1CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hand_Tracking_Landscape.png", "id": "25999640789732149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830593_25999640796398815_2489229061819529305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EC7s7jQdg0Q7kNvwFJteIl&_nc_oc=AdoPLC_urx9_0LJYeO15fCZmNescgcQzIwWandGf645eD3kajum74QCQnJH8wLhhwlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMEcDgEF5A5feHU5tVdYI-Urc-gV399EASWCLxgjDyUA&oe=69CD1A42"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscriptio
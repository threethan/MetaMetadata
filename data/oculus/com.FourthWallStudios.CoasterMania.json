73051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6An4sZzaTgQ7kNvwFIezAs&_nc_oc=AdpQQbWSGuCDj5a1G094Kq0FYHFFhiL4KaXEpC7j-urO2-ncn2e7ArjRDisK_Wpyhtw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P_1vgweeU3-LJE-cE41V0HdOOuAMv8mGi_WZFB9w1mQ&oe=6A0F295B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwrjvREWpS4Q7kNvwFEfCGk&_nc_oc=AdpUYury33By07qh3zOCCFcPWjviVHsW7toxj89On6n9qGaWpRtnXljJhA2watzqCls&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s9C1ipZxcli7kwp8S9CxjSQFdIrXimBqt2SfmizvYMw&oe=6A0EFCC7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meF4tFTfLkYQ7kNvwHEoe71&_nc_oc=AdqWW-GyrbK5JntyT2nbQd7_1uZnIT4KxQbX2OA0sHKsmaa8ArpRcn6UxZzdbIk2gNs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rMH7-AKC2NrZ75-AFLLCiBBoMnVkbE3dZGofvVVaPBQ&oe=6A0F07CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1406593007904405", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308103_1406593011237738_5099479628353467370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTk87CtXiV8Q7kNvwEW_5oc&_nc_oc=AdotFG8C9gTJlssBEdyPgGSNpeWvSRlaYAFHfrkrDcL97qbymJc9oAnF47JRvmvwgS4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-56iIkc3lKRQGx4TeAv-BaxE1PvIo1aA-YBgXTO9qeg&oe=6A0F0E12"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
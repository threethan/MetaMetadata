cVNZZIm52W9Ve34Qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGegWMEt2gDVxwzoyHdiCoF5uzrK6kk8_xsata1C8vnBQ&oe=6A7332C6"}, {"file_name": "screenshot_passthrough_final.png", "id": "622384759404541", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_622384762737874_4507191442478279626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Icq0HTyDFBsQ7kNvwE5KquI&_nc_oc=AdqPwaTtHYTyHj7BjKn6p3p4gAV7iwTE6gi6UzCH7_Xgu9rBxGjTVJqklxAWoU2nm0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFAzOzSmgIhtZFsDuhH4u3Q4-XBBEfqa-la0gWSVsjJw&oe=6A733993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "765448778062707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003257_765448781396040_4839994669853171722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWQ_CjbjLbcQ7kNvwHuaSlY&_nc_oc=AdrneFoSQfVrdcYPVdV-dH97JYNabtk1YSEphsfEACQomrgyHgRXnmnoT-mumbkcijk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF6mTvnrBaRFWgzda6dnMJ-7dqgLxP1TPO4gzQPUN3Tg&oe=6A734E6F"}, "display_name": "CoasterMania", "keywords": [], "long_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  \nSANDBOX MODE: Build your dream rollercoaster without any rules but the rules of physics. When you're done, share your coaster or experience the engineering marvels of others.  Design your own rides and upload them online\n\nPASSTHROUGH MODE: Place your rollercoaster in the real world & build a track all around your house. \n\nPUZZLE MODE: Coming soon!\n\nONLINE SHARING: Infinite replayability with lots of depth. Access unlimited community-made rollercoasters in Online Sharing.   \n\nADDITIONAL FEATURES: \n- Terrain editor. \n- Decorate the environment with trees, rocks, and other props.", "short_description": "C
c_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6XurrvJu6y_lLnFHHtPROv16ACAzu4W13eOnq3LG2dQ&oe=6B10504F"}, {"file_name": "2026 COASTERMANIA - Screenshot - 3840x2160 - 4.png", "id": "1190437676999510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835814_1190437680332843_8630967553117354512_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sriTYfG8t7UQ7kNvwHeAM7x&_nc_oc=AdrCaUlx939_oqPZZO1QkDz9XwYYhfJwMc89gB38jxqWxKHcUld3FWBZVujc-meg6WY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9XRghTX8L_EnLHuQGdvqJnTcxq1eo7F1Bn11t9ox4cQ&oe=6B1039E1"}, {"file_name": "2026 COASTERMANIA - Screenshot - 3840x2160 - 3.png", "id": "1060114209821371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835883_1060114213154704_5844724888495263647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLecFAIio5oQ7kNvwGVRPbH&_nc_oc=Adq9wmCZooL_lOCHr2S67q5POhTNjkP6_fJ8vhAH8X-Oy-QjVuO94eV409sAi5p83Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4kfUNtJrRL-pcZjuwKDAemI1E6-6ZMmtjguMCGxhtcg&oe=6B1061FC"}, {"file_name": "CM_Livingroom_Sandbox3_Landscape - frame at 16m25s.png", "id": "2315926119254884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835851_2315926122588217_5035015195865568200_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvqKhZ7JxDsQ7kNvwGhpWN7&_nc_oc=AdplsOLfc3X5UkFnnR2dJfloH_rDRO2sZTzSxisNK5YVZR0ii63vG36NJkkxLp8F648&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUc1iThfvgaUfT6XeOx9THjizv4f52NVgLx5GQ6S6daZA&oe=6B104F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM_CoverLandscape_2.png", "id": "1649898980167743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835856_1649898983501076_8191210786096116757_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaojeoWeDB0Q7kNvwE7I31X&_nc_oc=AdrG-hRDyUQ4KDarFtRO6MWG_3v3N5p3DrwraFMvlkObJoMY8rsoG9gAWOWBsRtVSYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHszJ2tUTSJBXCObuGbXrOD_y02UssueOoh5zOqczbbw&oe=6B1035C2"}, "display_name": "CoasterMania", "keywords": ["Sandbox", "Build", "Themepark", "Ride", "Rollercoaster"], "long_description": "# BUILD CRAZY ROLLERCOASTERS IN VR/MR!\nWelcome to **CoasterMania**, where you design thrilling coasters, then jump in and ride them in first person! Use physics to solve puzzles, or let your creativity run wild in sandbox mode. Then share your rides and explore thousands of creations from players around the world!\n\n{980830694715908}\n# \ud83c\udfa2 PLAY, BUILD, RIDE, SHARE!\n- \ud83e\udde9 Beat 50+ puzzle challenges to unlock cosmetics\n- \ud83c\udfa2 Draw tracks and add loops, corkscrews and other inversions\n- \ud83e\udeb4 Decorate with 200+ props and a full terrain editor\n- \ud83e\uddf2 Use gadgets like portals, cannons, springs and gliders\n\n{2725109701238040}\n# MIXED REALITY INSANITY!\n**NEW: Scan your room, then shrink down and ride through it in first person!**\n\nUse mixed reality to the fullest as you design a rollercoaster through your room! Build across your furniture and throughout your space as supports attach to surfaces and carts explode on contact with your walls!\n\n{916606438205600}\n# SHOWCASE MODE!\nRide coasters made by the community, right in the game! Upload your own creations or browse featured and trending rides. **No headset? No problem!** Share a link and anyone can ride your coaster on the web.\n\n# Join our Discord Community:\n**https://discord.gg/qaBgpCE39Y**", "short_description": "Design thrilling rollercoasters in VR or MR, then jump into the front seat and ride your creation in first person. Add loops, cannons and rocket boosters, test every drop, and then share your creation with friends and family!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_serv
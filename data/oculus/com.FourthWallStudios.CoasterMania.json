73051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_RUy1nYbpgQ7kNvwEO9SJK&_nc_oc=AdoqT6R9OD3zgmDlYQMy6IMH5mqoHX6AqoI8RPafgNJWOT3Sv-zlDm0cXh0G0hOTw8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xf3qI3zmtaPvg5gwXpGNkWfuV6cMxmvp5OfsY1Eou6Q&oe=6A19B55B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGVPLzjt5WcQ7kNvwGE0idt&_nc_oc=AdpsKAKExuhi4Ovvrj-bLC8I754sLlyueS100F8DvP3ldjeP0TrFPrjOpKp2mBalKkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jKWphtQI_b6TXisDGf1xzupUKs_P_CUym5Lxf-KPWZQ&oe=6A1988C7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew7HkgzVcr4Q7kNvwFHd0sA&_nc_oc=AdqnrIrC96mS7lv3tagEMHGUXUuyYvPAtgqqtvGoFT2lVDaCD_CeLpTsbyxmD9Ofwrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tZ0JeaIikfB89zLryOTucNYj6vU8y-7kdRsvf1YwszQ&oe=6A1993CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1406593007904405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308103_1406593011237738_5099479628353467370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqGqYgKeAhUQ7kNvwF1gM_W&_nc_oc=AdrbYXPAB8IJrGTNzouswIN9EAbLOdwv_YoU8Enoa0552B9tkNQZ2jttTFNBc3-kK-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-tAYNsbi-n43z_NIKVB15Go3K70sHEugEIG4zqeiDPw&oe=6A199A12"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
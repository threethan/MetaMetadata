=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y21DYXjPUgQ7kNvwEEam3e&_nc_oc=AdoRXTOq5ssx4AtyvM8Z-bC8y9_bgPtLKN8OCwwPj0BgUZIRM3tUZGdJWm6eCwLAapM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_jibuUz74hyOResJHKHG8LSGo_7ZEUKAlaj5T3dTHJQ&oe=69D5101F"}, {"file_name": "CoasterLoop.png", "id": "1452108869718105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298329_1452108873051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVP8c2if0F0Q7kNvwE6d10K&_nc_oc=AdqxRfrf-uFx0h-qRd1eYW9z0J_ftgleyHDgVKlmwezWoLQpryr-hrFliZo-Rm8Jaz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Dckw9yBZxJLonB9XLernkSz7ek2pPAC8a0QTtBPmoA&oe=69D4EF1B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fH4I5CN79UQ7kNvwGAskPU&_nc_oc=AdpzbVxNYUz_7LnbWsrBkmdVOnflSnBhHqQzf_IMgujJ8N5-uKrTYLHHYmvdoZ7_JoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aaSloAW0-OmeQhiq-AvCE290q7JOi7P4pzdFTDuiwlA&oe=69D4FAC7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaFwJGB7sAcQ7kNvwFmugPr&_nc_oc=Adq--Z98j0FLh-nfCu1rRRscWx0zI7MuQH1KQGgduVXz1bs2hBxFFDuMh2AzXUTerSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CDNgcAOdNei1neyg6QmG3uzwdhsI8sOe88Vw9w2smXA&oe=69D505CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hand_Tracking_Landscape.png", "id": "25999640789732149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830593_25999640796398815_2489229061819529305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU6oDeaVyg0Q7kNvwFCGIwQ&_nc_oc=AdqyjoElPRll9I0UpU43MwzsVcCu2Wpl4B-jberXJsFZSS4y26EscPlJYRGUOObnZGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P6JCeKZqAmDnmCYSbhcLyTFMq0uv_AOrHucqkFg_Lag&oe=69D50342"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscriptio
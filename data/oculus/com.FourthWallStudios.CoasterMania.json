8032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-Dv00i5zF0Q7kNvwGFlwwA&_nc_oc=AdoRzyFKZaA8JAZN3lqFVqFbAz-QQK-Esek9NwlRwuC5vacEo1ETGqDBg3v-dJGskUg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImp4ezPqAyE9FH1QsLo_6CPqw_1u3EXZsTZm5Tgbn6Ag&oe=6AA422DB"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpms64tjHUcQ7kNvwEsaJ91&_nc_oc=Adpy6eq-AjV_YLTeyR9STcqQGu250SJvNZWMCJTJSJhg-ASo09AocYqmV7r6dNBqL88&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRTeYGEjqz4RnLKC67sbX5i9lkJKsSiDv53_P9_SIE1A&oe=6AA3F647"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBbyhVRnPtAQ7kNvwFsFQfd&_nc_oc=AdpiZnklR58plBl6VTVrqF8_DicK1BfsqtjhSSvDD92zw2uyS-QJuXpw0Biu-TR-1Yc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyypQJq4SGw7xkoxnEvgw6fs1GE7HAVjYQ6cE1EpfsqA&oe=6AA4014B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoomScan_V2_Landscape.png", "id": "1264881522313250", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499299891_1264881525646583_1207586500219889839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRKQlYhk74wQ7kNvwHNMeSl&_nc_oc=AdoFSd1Oiki9PR3taqApjxBKUtdGleu9a1pZFj3kzr0YmgNR7Qqw311-yr8ix29TPAw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJkqGD23r_DryDNhV6Z5lRs8mbRO1r40GehGuaL5Ocqg&oe=6AA3F8E0"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Turn your room into a roller coaster.\n\nBuild tracks across your furniture, around your walls, and throughout your real-world space.  Then shrink down, jump into the front seat, and ride your creation in first person.\n\nBuild naturally with your hands or controllers, experiment with physics-powered gadgets, tackle 50+ challenges, and share your wildest creations with the community.\n{2874787972689001}\n# BUILD IN YOUR ROOM\n\nTurn your home into a coaster playground. Build tracks across furniture and throughout your space using intuitive hand tracking or controllers.\n\n{1637917944564412}\n# JUMP IN AND RIDE\n\nShrink down to coaster-size and experience your creations from the front seat as your real room becomes a massive theme park.\n\n{1078555903573759}\n# BUILD THE IMPOSSIBLE\n\nLaunch cars from cannons, blast through portals, attach rocket boosters, sculpt terrain, decorate your park, and experiment with physics.\n\n{1092357901949034}\n# TAKE ON 50+ CHALLENGES\n\nMaster coaster building across Medieval, Western, Atlantis and Sci-Fi worlds while unlocking new cosmetics.\n\n\n# SHARE YOUR CREATIONS\n\nUpload your best coasters and discover rides built by other players.\n", "short_description": "Turn your room into a rollercoaster! Build tracks around your real-world space, then shrink down, hop in the front seat, and ride your creation in mixed reality.\n"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
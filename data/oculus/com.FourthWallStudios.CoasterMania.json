qXbgeFT3AQ7kNvwEXTA5t&_nc_oc=Adoe96eRcAXBrAVdNUuOYOBWUkhOHSFmFoLeCOe2fJv9_VXOZaoL6k3jJhGGWNe9Qpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpTJ3agtdhRDohBtCcMagv-Z949jHVKu2o2AjdyaG9HQ&oe=6A77389F"}, {"file_name": "CoasterLoop.png", "id": "1452108869718105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298329_1452108873051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_Ezrx2QViQQ7kNvwGEI0Rj&_nc_oc=AdpWV63TllXZemeg02MxWFwwPzFa6XL9cmnXxzBmuZ0yOKg-lnw4qd6r9w2KDKM3bWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF95d5oX094DWyRZH3yL_6o7N449omnQpaqSeSjDVDWxg&oe=6A77179B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aziIVtkt73EQ7kNvwEQgJR2&_nc_oc=AdoN9OQs0LXdcTlURbsq-VVXYZnyHX8tRv49QiNOMxLwiEwWdqhocbdfKRg__CzUXdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHAew3c9x8ZNJiWe1GPthHnz8FKB7irTISJP6BdcI6Hg&oe=6A772347"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Nqt49_rWxAQ7kNvwFr9oBG&_nc_oc=AdpMRqOY7dseM-b7hXt9a2hX4PVCGenU8_KYkQngfPtWv3yTStj4VeMVEwIVVgDC_0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDByNUlLrHIpJWlMKdQxGCTGwUcK7hyEuJu-9Y_XmWlg&oe=6A772E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM_Landscape.png", "id": "974643992287232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298150_974643995620565_6027919819365574869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LWelpeBFJkQ7kNvwFczuBS&_nc_oc=AdraSGPRPzWoGL3G6Hiv-7-MPbXCnzIexK0-mxzANvHh42myT9-7ShbD5ILBPM-lbtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiggYBFaTL62KdMQ0tcGpF4-GddlmNPojvRpg0vNLDVg&oe=6A773A49"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
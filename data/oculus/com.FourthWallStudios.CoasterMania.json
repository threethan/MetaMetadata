ZirUgvm7-5D-kgf5uwQe60dgxDKEF8dRQeK6U1fkiFmRBh9ZmHaWrE8cRv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1m0DtNW0u6NFZEDIwE1R3kauMUZmvRxf7VOltb9zVAgA&oe=69F09E9B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPJS6PUkLk8Q7kNvwEbLkWA&_nc_oc=AdoLYDbt-aqbyGpS8uOAS7RjpwdHxlDNzh-PF6PLZyGMicMQ179jFHn6sN3Vwjw2kUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0lFJAODFnYant3X4yKPhjg2NyAI8GJZCwFNXnVNMCtKA&oe=69F0AA47"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0lGRxKgyr8Q7kNvwGJhT8g&_nc_oc=Adq6inVKZ_zJuosllGkamt74Ue25DQHtZrjz_MI20hSY-Tmy-ndwNRzwnIVib1x7JaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2BGmLsujsmH7Ou_JdbFXSYNbwVzRDdw1vvUJdLZ2IaXw&oe=69F0B54B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1406593007904405", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308103_1406593011237738_5099479628353467370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMSZXVFzrp4Q7kNvwErknf0&_nc_oc=Adqp4ep45oz5VOe-EExfpgNfKiWcL7olUaSVDOObCx44hLPvOKBGA9kd06Wp3pN7G2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pfSGyw_SFram2pkOma-8cfO6o7e_5ehMy6n-f6DqwRg&oe=69F0BB92"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34445165945128613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/
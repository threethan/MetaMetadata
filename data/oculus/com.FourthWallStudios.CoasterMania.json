032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyUUFP2qg28Q7kNvwH5ltYk&_nc_oc=Adr_lcfYoktGcppCkIOPQY0vV43WLzGRpLgLpUDQ5TNq-gICPIFalL6oLAlUPEk5q7Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF_yR0UPjU8OGWV8TrENu4BB1vaUIkLt2lqHO8I_W0pQ&oe=6A85981B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLNzIQwW7acQ7kNvwH3Jl5n&_nc_oc=AdrHEipGuvwDJRfyUeguu4eaAlMANXeRa8qfD9cRhVK9GQ3EFDtsitxml3-1ycqJmNM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1Y46kK0Ms1_S4elHKFw3YLRYr8BQPa2uHZ3mmmkjDYw&oe=6A85A3C7"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AiIwCPloa0Q7kNvwE0kV4n&_nc_oc=AdpXRZ4rRVHRbHaqkouqOn-osbzcVhO_AvZMXGcDbek8LtX0pWCrw6gyyYVeIj4dHtk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgECOqC_sgreWOnu_TcfhAs0fKjgBkDgi-JSO2zVDBCw&oe=6A85AECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoomScan_V2_Landscape.png", "id": "1264881522313250", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499299891_1264881525646583_1207586500219889839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3CrA4np4fMQ7kNvwGBDv7S&_nc_oc=Adp4I_1BsMlDfl1KK1arWaQAyJLuqd_5dGnVOCedvfqzqrCcEuAG7LFIE-fVTfkHbRY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPl2MLr4rydRkBQrq6rI_ZYIPqLydLxZFRvrEFPz0H7g&oe=6A85A660"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
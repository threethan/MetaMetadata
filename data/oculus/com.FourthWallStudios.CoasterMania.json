c=AdqJxhQZn24CmJfkU1OQWvdjWVfx4Hp0aZsFVpQPXFuZ8CoATGBhwVy1hQ6cRwv7TTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU9jMhw57VZFWFZMzKswEJTWfilmr2ePgn8iA8lIfHlA&oe=6AE48C99"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVJGVLlOYXMQ7kNvwHJyne9&_nc_oc=Ado4f4JP8vlQ8UR_wMEN0HpB93ZVr2iXvp38dhRp4qj3Wt2u6BZo1i63kuJnpAhjoos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHpwykbsZV__sBhYHRoOsg-JL2-U_zT7o9vqoy6Ep3Rg&oe=6AE48FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoomScan_V2_Landscape.png", "id": "1264881522313250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1264881525646583_1207586500219889839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4FaQbwsP4wQ7kNvwFcUUIU&_nc_oc=Adp_jrTxnSKsPLvNWoRXE3zYLJYDRUzjUFNA-HIBK7PFurlLT_eE0gfB2FFAMybTm10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORWDhxzcqoIf0uY5hTNp6dFTGci0hfzx7lmD5mbE5-wQ&oe=6AE49260"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Turn your room into a roller coaster.\n\nBuild tracks across your furniture, around your walls, and throughout your real-world space.  Then shrink down, jump into the front seat, and ride your creation in first person.\n\nBuild naturally with your hands or controllers, experiment with physics-powered gadgets, tackle 50+ challenges, and share your wildest creations with the community.\n{2874787972689001}\n# BUILD IN YOUR ROOM\n\nTurn your home into a coaster playground. Build tracks across furniture and throughout your space using intuitive hand tracking or controllers.\n\n{1637917944564412}\n# JUMP IN AND RIDE\n\nShrink down to coaster-size and experience your creations from the front seat as your real room becomes a massive theme park.\n\n{1078555903573759}\n# BUILD THE IMPOSSIBLE\n\nLaunch cars from cannons, blast through portals, attach rocket boosters, sculpt terrain, decorate your park, and experiment with physics.\n\n{1092357901949034}\n# TAKE ON 50+ CHALLENGES\n\nMaster coaster building across Medieval, Western, Atlantis and Sci-Fi worlds while unlocking new cosmetics.\n\n\n# SHARE YOUR CREATIONS\n\nUpload your best coasters and discover rides built by other players.\n", "short_description": "Turn your room into a rollercoaster! Build tracks around your real-world space, then shrink down, hop in the front seat, and ride your creation in mixed reality.\n"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://discord.gg/qaBgpCE39Y", "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "38914678971510599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296236_1482104580394977_1500412807419179882_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfZWbFNN7N8Q7kNvwGbOrAc&_nc_oc=AdqJ
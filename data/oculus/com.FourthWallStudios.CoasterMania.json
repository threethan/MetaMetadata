0f&oh=00_AQFiEcaIcWBnUKFAV7nzMZP2yk_C15ZgPKKDB5kXvxwTWg&oe=6A81A169"}, {"file_name": "screenshot_terrain_final.png", "id": "1302744327198101", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569486_1302744330531434_4640078511257853477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZQ0S2H8aAYQ7kNvwH7PgPi&_nc_oc=AdrbMkTEZRcyqNKiRnwaizLb6QCDkSfNhi7EDM_sIHoUA6yr3mAYLnPXa0Th1s5LTso&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb57Lqgpxf39gUfrqwB1hhA3HYXq03uvhMbE6fheb5cQ&oe=6A81B346"}, {"file_name": "screenshot_passthrough_final.png", "id": "622384759404541", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974676_622384762737874_4507191442478279626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm1EyUMFfEAQ7kNvwF3Gc-p&_nc_oc=Adq1wFx9sktbsKycOWWusGwDMwSumAeuXnKJr49wi5yoDYLi7PE5K1FFP3dUqyug4s8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYlEFZw9pfRtv3R2-qEa1Yu_oLXCz_xG82abvq3Bx8LQ&oe=6A81BA13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "765448778062707", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003257_765448781396040_4839994669853171722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA0ckfqaNlwQ7kNvwFh3ZZA&_nc_oc=Adqatyo4ElukVlTchFBoWdb8n9M-mh5y34zRbJj0CpuF-bz98Wiafs5F1V51l5qKflQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHJ1rnuQuxJNNfVSiH11UIcl8We-OVpD9Nu_UZ6gFw4w&oe=6A8196AF"}, "display_name": "CoasterMania", "keywords": [], "long_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  \nSANDBOX MODE: Build your dream rollercoaster without any rules but the rules of physics. When you're done, share your coaster or experience the engineering marvels of others.  Design your own rides and upload them online\n\nPASSTHROUGH MODE: Place your rollercoaster in the real world & build a track all around your house. \n\nPUZZLE MODE: Coming soon!\n\nONLINE SHARING: Infinite replayability with lots of depth. Access unlimited community-made rollercoasters in Online Sharing.   \n\nADDITIONAL FEATURES: \n- Terrain editor. \n- Decorate the environment with trees, rocks, and other props.", "short_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  "}]}, "developer_name": "Stephen Rogers", "developer_privacy_policy_url": "https://stephenrogers6.wixsite.com/coastermania/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111892749745810"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1352697986777137"}, {"status": "PUBLISHED", "id": "1569962817997604"}, {"status": "PUBLISHED", "id": "932992452543758"}, {"status": "PUBLISHED", "id": "771859168786907"}, {"status": "PUBLISHED", "id": "4091311991134718"}, {"status": "PUBLISHED", "id": "769518238967637"}, {"status"
hNLe8udy_Ojt_-wc2OZDwpPs8nNNHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuylq199WbtLb9LfG2F0FS10g7-IKzSH-KciVSqWvd75A&oe=699D9FC6"}, {"file_name": "screenshot_passthrough_final.png", "id": "622384759404541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_622384762737874_4507191442478279626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1rQTMuzLOEQ7kNvwFfMiYY&_nc_oc=Adnl85doqqr3S5_-Gs5XLVoJdd0kC1Jse-fpH73xh-XEefaFmQvNu8EH53eHY2lxREk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsiqcyoqp83LAM9icQsl6j_nYCoKAvC02ChxBbhxLHA6w&oe=699DA693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "765448778062707", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003257_765448781396040_4839994669853171722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cj0tRcwKvAQ7kNvwEN5JwP&_nc_oc=AdnW_REb5o8f_KVKn5YE_3MOlIumKSQUw9LEXgbexWETYIVuMxdyeuxc2-q0QNbvWCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufWqc_9PBrzkHcdr4aNSRpcnbIXCLAk6voVsSmNOw14w&oe=699D832F"}, "display_name": "CoasterMania", "keywords": [], "long_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  \nSANDBOX MODE: Build your dream rollercoaster without any rules but the rules of physics. When you're done, share your coaster or experience the engineering marvels of others.  Design your own rides and upload them online\n\nPASSTHROUGH MODE: Place your rollercoaster in the real world & build a track all around your house. \n\nPUZZLE MODE: Coming soon!\n\nONLINE SHARING: Infinite replayability with lots of depth. Access unlimited community-made rollercoasters in Online Sharing.   \n\nADDITIONAL FEATURES: \n- Terrain editor. \n- Decorate the environment with trees, rocks, and other props.", "short_description": "CoasterMania is a physics-b
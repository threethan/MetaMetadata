Adp5WpVJyy6xIZu1rngpizw_hK-74QQaIbqylUwA9B87wX4y1CJVdSlLWYUqH9Y_p8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFlVcwIpH0qFUcfmi5clQw4A1fcwsAoNlegp-GUJJUKg&oe=6ACBB859"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxR3UiDjMZgQ7kNvwHZwiNG&_nc_oc=AdqD8MYsaBSD8j_ywYqBrOaDTtz2SAItS3gKuROvWGeQCCgJ6Ifx8jBc3lsJj3fB6E0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtXPwkIdLVjp6rONfDKg-TX6TcJ8YqbWSzygS0hU7HMQ&oe=6ACBBB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoomScan_V2_Landscape.png", "id": "1264881522313250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1264881525646583_1207586500219889839_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8AvvxJJppIQ7kNvwFeJ_Tf&_nc_oc=AdoinRu72pndEGJLT5vvFAhPCNYGCSQ3PNE3yDm11f9GSknWzqMPfnBJFCHyvEq7zyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjEa3x2DJkwu2x689kDWFNKED-hz_nWhCSVSySbWLMIg&oe=6ACBBE20"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Thrill", "Build"], "long_description": "# Turn your room into a roller coaster.\n\nBuild tracks across your furniture, around your walls, and throughout your real-world space.  Then shrink down, jump into the front seat, and ride your creation in first person.\n\nBuild naturally with your hands or controllers, experiment with physics-powered gadgets, tackle 50+ challenges, and share your wildest creations with the community.\n{2874787972689001}\n# BUILD IN YOUR ROOM\n\nTurn your home into a coaster playground. Build tracks across furniture and throughout your space using intuitive hand tracking or controllers.\n\n{1637917944564412}\n# JUMP IN AND RIDE\n\nShrink down to coaster-size and experience your creations from the front seat as your real room becomes a massive theme park.\n\n{1078555903573759}\n# BUILD THE IMPOSSIBLE\n\nLaunch cars from cannons, blast through portals, attach rocket boosters, sculpt terrain, decorate your park, and experiment with physics.\n\n{1092357901949034}\n# TAKE ON 50+ CHALLENGES\n\nMaster coaster building across Medieval, Western, Atlantis and Sci-Fi worlds while unlocking new cosmetics.\n\n\n# SHARE YOUR CREATIONS\n\nUpload your best coasters and discover rides built by other players.\n", "short_description": "Turn your room into a rollercoaster! Build tracks around your real-world space, then shrink down, hop in the front seat, and ride your creation in mixed reality.\n"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://discord.gg/qaBgpCE39Y", "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "38914678971510599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303116_1049779948084611_4379937013780604619_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEUzU_2GIuEQ7kNvwFPGERe&_nc_oc=AdpVa5
3LWNCD0fNwJ6aFvSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-8qkeWKDPUXGG7yhP-cgZkTzfn49c9yMlyzjPufIKKg&oe=6A68A6C6"}, {"file_name": "screenshot_passthrough_final.png", "id": "622384759404541", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974676_622384762737874_4507191442478279626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ4Fm8yQubUQ7kNvwEw8zzz&_nc_oc=AdpiA1xLB2RGianYpTfSGIsxslzpAAnzD5asxu9Filw_LC3bo6x9ky1zTLiMaFfObhw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9nsZJ4WsT_cYwWu6aR5ibwukyChKzO9KWjF-CWNTSoQ&oe=6A68AD93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "765448778062707", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003257_765448781396040_4839994669853171722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3e790pQ9g0Q7kNvwFQvd5z&_nc_oc=AdpQcrQoZoCBwica5RpQziAxpqbvlyE9ngMkx8Z3bvLfhNRliMFk7QPhytx_N6gXDHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Y02Zoz41tL1znY5tKEM6QbYwKc4cSU2DlJ3McXR5XA&oe=6A68C26F"}, "display_name": "CoasterMania", "keywords": [], "long_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  \nSANDBOX MODE: Build your dream rollercoaster without any rules but the rules of physics. When you're done, share your coaster or experience the engineering marvels of others.  Design your own rides and upload them online\n\nPASSTHROUGH MODE: Place your rollercoaster in the real world & build a track all around your house. \n\nPUZZLE MODE: Coming soon!\n\nONLINE SHARING: Infinite replayability with lots of depth. Access unlimited community-made rollercoasters in Online Sharing.   \n\nADDITIONAL FEATURES: \n- Terrain editor. \n- Decorate the environment with trees, rocks, and other props.", "short_description": "C
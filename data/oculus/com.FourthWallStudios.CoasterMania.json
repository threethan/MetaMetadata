4_4640078511257853477_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qswgZquim34Q7kNvwGmd3KK&_nc_oc=AdrnFigCjuhCYl-PVoVTWkpI4518dg4ksF7HcT5lBW0UWFluSi3t1_IzHqWEI58PiXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsZYhJV2q_nFXCqOCUbI9KUVKCLMUEMyzHHcAX2HjOLw&oe=6AC52806"}, {"file_name": "screenshot_passthrough_final.png", "id": "622384759404541", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974676_622384762737874_4507191442478279626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKc8sDMNxgYQ7kNvwFNDJXJ&_nc_oc=AdpJOK9gxHetkD49Ue7hEgZpjoFXAyLu5HSA8QCpVT52IDAOs_UFaaBNknM16ChGka0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAn8alNrgbhVFL4ZDKGIV04IRv-Mn4AlgVSu-ITA-51A&oe=6AC4F693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "765448778062707", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003257_765448781396040_4839994669853171722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEt305wgNqcQ7kNvwHOrfIw&_nc_oc=AdraUKBFZey8-iTd0RTWiTK0lM9-EFNLiLxASPEIOeexHbbvRrqnr2u9Wp364JHbn7Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKdoq6aZkf_Uc20QObvq4B_6il9BMlvVKeASekpvV9CA&oe=6AC50B6F"}, "display_name": "CoasterMania", "keywords": [], "long_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  \nSANDBOX MODE: Build your dream rollercoaster without any rules but the rules of physics. When you're done, share your coaster or experience the engineering marvels of others.  Design your own rides and upload them online\n\nPASSTHROUGH MODE: Place your rollercoaster in the real world & build a track all around your house. \n\nPUZZLE MODE: Coming soon!\n\nONLINE SHARING: Infinite replayability with lots of depth. Access unlimited community-made rollercoasters in Online Sharing.   \n\nADDITIONAL FEATURES: \n- Terrain editor. \n- Decorate the environment with trees, rocks, and other props.", "short_description": "CoasterMania is a physics-based VR rollercoaster game where you create the ride of your life! Use wacky contraptions and elements to fly through the sky, then experience your creation by jumping in the front seat. \n  "}]}, "developer_name": "Stephen Rogers", "developer_privacy_policy_url": "https://stephenrogers6.wixsite.com/coastermania/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1111892749745810"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1780358996655266"}, {"status": "PUBLISHED", "id": "1684567999759392"}, {"status": "PUBLISHED", "id": "1352697986777137"}, {"status": "PUBLISHED", "id": "1569962817997604"}, {"status": "PUBLISHED", "id": "932992452543758"}, {"status": "PUBLISHED", "id": "771859168786907"}, {"status": "PUBLISHED", "id": "4091311991134718"}, {"status": "PUBLISHED", "id": "769518238967637"}, {"status": "PUBLISHED", "id": "1264212938606121"}, {"status": "PUBLISHED", "id": "1788158631735283"}, {"status": "PUBLISHED", "id": "1
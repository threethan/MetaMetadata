=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOimBSz2ZBQQ7kNvwEPZopB&_nc_oc=AdrXmJSXTpxgEjnA3kCYE0mo5hvG-AOQ5B5s3wsB22xGLc4hhE5AcHx39B7wOCdqKSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqdXqFnV5nBK90VChCL_fJfnMt6mQjgCSsveLLCbl4yg&oe=69D11B9F"}, {"file_name": "CoasterLoop.png", "id": "1452108869718105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298329_1452108873051438_8478032576293799089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sexL0luctSoQ7kNvwFUmzAm&_nc_oc=AdrfXq4_vhqbU3gVuXY6zgzHtq2RCMZBZbbh6X70KoK4Th3ijcpYuTgl1GCitqXex1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyowRp2-Ixc5HetUQgoF-3Rbkfl7slu_WSh4yC1bWMwpQ&oe=69D0FA9B"}, {"file_name": "FirstPerson2.png", "id": "1810120306323940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292329_1810120309657273_5632298488863955281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3rIcH6N64kQ7kNvwGHSI2m&_nc_oc=Ado_3a55lYIWu-3gZrshyGMBOQF4iuMqLJnjSQADC22sEaaDzTbB7_9cvMrN0fxmv3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMyrPsj3kmY4_MEiSUdkPKYM7W3Pxd3f2nhn6hqyUgrg&oe=69D10647"}, {"file_name": "Menu.png", "id": "2349871638813478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_2349871642146811_5650608876312175235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbulcW2_nQYQ7kNvwFrsZat&_nc_oc=AdrtIhmVMqH6GUJRgdIutCiR_IBhMoOM2-hlsz5AjyS0beQAahi6vLf2oKxl9QIs3nM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygDy60gQvJ-cWT5MoEYPIl9VAew8oqowDjrXGcvqR9-w&oe=69D1114B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hand_Tracking_Landscape.png", "id": "25999640789732149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830593_25999640796398815_2489229061819529305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCtNHoZ22kMQ7kNvwFXNMzt&_nc_oc=Adpmq93YTweTjdtePH6rlj4S5fYaQT9BWZc_biisW0k4bHfxta3Fsxws5vWI5Ed-Pcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUGJ5ip_fxYo451x3ZO3kwn3GyZOVXcHCptgwq5D7MfA&oe=69D10EC2"}, "display_name": "CoasterMania", "keywords": ["Rollercoaster", "Sandbox", "Track", "Coaster", "Thrill"], "long_description": "# Build, Ride, & Share Rollercoasters in Mixed Reality!\nCreate and ride thrilling rollercoasters in your own space with **CoasterMania**! Use physics-based tools to design jaw-dropping tracks that adapt to your room, then hop in the front seat for a first-person ride like no other.\n{2874787972689001}\n\n\n# Campaign Mode\nComplete over 50 puzzles across four themed worlds\u2014Medieval, Western, Atlantis, and Sci-Fi. Solve challenges, unlock cosmetics, and master the art of coaster-building!\n{1092357901949034}\n\n# Sandbox Mode\nTurn your room into a coaster playground! Build tracks through your space with gadgets like cannons, rocket propellers, and portals. Decorate with props, sculpt terrain, and experience your creations in VR, zipping around furniture and even your pets.\n{1078555903573759}\n\n# Showcase Mode\nShare your coasters and ride creations from players around the world!\n\nBring your imagination to life\u2014your living room is now a theme park!\n", "short_description": "Bring the thrill of rollercoasters into your world with CoasterMania! Use mixed reality to craft epic rides that twist and turn through your room, then jump in and experience your masterpiece from the best seat in the house!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": null, "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscriptio
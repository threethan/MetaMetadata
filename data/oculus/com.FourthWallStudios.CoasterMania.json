c_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVvZhrWlkhr45V9gmlUFneiP7upsdDwsqpOmlqDNP0Ng&oe=6B0C5BCF"}, {"file_name": "2026 COASTERMANIA - Screenshot - 3840x2160 - 4.png", "id": "1190437676999510", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835814_1190437680332843_8630967553117354512_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVrXnd0lC1AQ7kNvwETJqWm&_nc_oc=Adpmbj2-KHBHE7nlfILMIX6CN2qnrltcseyoaKUDhN7oiSD2jOkjdM4Uj3cVsFSk93s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxGIKVQhTqk56Wr_XdkEue9Zfgp7bdvo5ku-UBMMSgBg&oe=6B0C7DA1"}, {"file_name": "2026 COASTERMANIA - Screenshot - 3840x2160 - 3.png", "id": "1060114209821371", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835883_1060114213154704_5844724888495263647_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM4bNE8U6HwQ7kNvwG250aj&_nc_oc=AdrKnU1Reui7uKbkosfUMTL_-CqRXdlD6z7hnKEJihcIauuJTgWyHArFPmoahJvYEeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCQidrfAgcoQHGTmR8St2ZOo74RhtVI5tJu_akldQhYw&oe=6B0C6D7C"}, {"file_name": "CM_Livingroom_Sandbox3_Landscape - frame at 16m25s.png", "id": "2315926119254884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835851_2315926122588217_5035015195865568200_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxo1_G0UhSYQ7kNvwHRQSAC&_nc_oc=AdqqY4I-I3jkXaiJP-HnN-CzzywNo2oys95I1EiQSEBJWG9wcnhyjYYixGymckAkoeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgEXstC4ySIcr2voeRdDkGVbIox9AQTrJPo5nR-OPiuA&oe=6B0C5A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM_CoverLandscape_2.png", "id": "1649898980167743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835856_1649898983501076_8191210786096116757_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h33mlkdHb4Q7kNvwF5Um9e&_nc_oc=Ado8VZnNI6dTz98yb_udAR2Mg2P24SuVeIWvIeaVYzwAKG1zfhKxTUmZjWREHmtwlGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStCDgf3TLM15ur6YSEryyEW6l-yv5rT5QHANO7bQlmYg&oe=6B0C7982"}, "display_name": "CoasterMania", "keywords": ["Sandbox", "Build", "Themepark", "Ride", "Rollercoaster"], "long_description": "# BUILD CRAZY ROLLERCOASTERS IN VR/MR!\nWelcome to **CoasterMania**, where you design thrilling coasters, then jump in and ride them in first person! Use physics to solve puzzles, or let your creativity run wild in sandbox mode. Then share your rides and explore thousands of creations from players around the world!\n\n{980830694715908}\n# \ud83c\udfa2 PLAY, BUILD, RIDE, SHARE!\n- \ud83e\udde9 Beat 50+ puzzle challenges to unlock cosmetics\n- \ud83c\udfa2 Draw tracks and add loops, corkscrews and other inversions\n- \ud83e\udeb4 Decorate with 200+ props and a full terrain editor\n- \ud83e\uddf2 Use gadgets like portals, cannons, springs and gliders\n\n{2725109701238040}\n# MIXED REALITY INSANITY!\n**NEW: Scan your room, then shrink down and ride through it in first person!**\n\nUse mixed reality to the fullest as you design a rollercoaster through your room! Build across your furniture and throughout your space as supports attach to surfaces and carts explode on contact with your walls!\n\n{916606438205600}\n# SHOWCASE MODE!\nRide coasters made by the community, right in the game! Upload your own creations or browse featured and trending rides. **No headset? No problem!** Share a link and anyone can ride your coaster on the web.\n\n# Join our Discord Community:\n**https://discord.gg/qaBgpCE39Y**", "short_description": "Design thrilling rollercoasters in VR or MR, then jump into the front seat and ride your creation in first person. Add loops, cannons and rocket boosters, test every drop, and then share your creation with friends and family!"}]}, "developer_name": "4th Wall Breakers", "developer_privacy_policy_url": "https://www.coastermaniavr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://discord.gg/qaBgpCE39Y", "website_url": "https://www.coastermaniavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "40174577188854098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835801_972893122306837_6892043390214807844_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkHjD9fXcpYQ7kNvwFvtxhs&_nc_oc=AdrmW57J_S44pR8konD4bc_Krzl3JJpnI-jna7rUAfAihheW1zPIHyCySntGE8QrZik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7yZLbIjfIKQh-32LvhDnRYZKUY932WiPK_b6Q6AYhJA&oe=6B0C5AFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CoasterMania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1733421600, "lastRevision": {"nodes": [{"id": "7856648804407022", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
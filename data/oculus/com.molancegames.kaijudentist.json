20f&oh=00_AQTYXy7cVblw8xCV08j2Wxtngdy5XSwbLJgThrgOloxPkQ&oe=6B05B94B"}, {"file_name": "2_mega_molar.png", "id": "4054912008147061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_4054912011480394_1344370318799824111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xhd0CTShVEQ7kNvwF_RbcE&_nc_oc=AdqK0aQ1KhzYTKsrHYkJLGxuHXYyCMhddEosL0gykLgUhAFal-Wdd4V5n4aIfzxun9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPlQduCQD4RFSq-w7tkHXRRRAxaSxUanuMpcqbX-6T2g&oe=6B05A883"}, {"file_name": "4_kaiju_mart.png", "id": "1685395043143375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825470_1685395046476708_8589051527012616055_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0iKqwppNyUQ7kNvwFGljbU&_nc_oc=AdrBnCuEriyC4FHA2gidICdHRGDiIWMmE8NhqCpwEr2EystyAEjjwahF2v4zTfMP7nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFofKj4euKh1DKZOu0WWGh-VJAK5xIZ2D9mRD5cEOzmQ&oe=6B05C482"}, {"file_name": "8_sticker_book.png", "id": "1728237681738379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1728237685071712_1471547739371952057_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rF0aMNNgL0Q7kNvwExsqgX&_nc_oc=AdoVp2E3x2MRovbUJ7d_lDTp1YW8MAeu-TivF6824W4XcU1pqdsds6Q0_lChBwrwa7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwDstK-O0hvIsfh6RSS-0jG7_L5_2dCkTbOXVD1gbtOQ&oe=6B05D3E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8497.png", "id": "1087495693912929", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1087495700579595_5086417363384682906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf1HUdzWX6UQ7kNvwE7rOXj&_nc_oc=AdqSldIiP44jHBX1za0nuixKsP31vdjckfJlv26L6OMUtoaw7mxxnzlKNm0o5bSIB1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuAhIV_MGQPuGS-osH-ifPBhNSURbvD8ejvGjjqudqww&oe=6B05BC4B"}, "display_name": "Kaiju Dentist", "keywords": ["titans", "monster", "doctor", "clinic", "giants"], "long_description": "Open wide! Welcome to the only dental clinic that treats kaiju, the funniest VR arcade shooter on the rooftop.\n\nEvery giant monster stomps out of the harbour, squeezes into a skyscraper-sized dentist chair and opens its enormous jaws right in front of you.\n\n{1538721311603166}\n\nSHOOT THE GERMS, NEVER THE FILLINGS\nGrab a tool and pop germs, plaque, stubborn rot and sneaky runners in this physics-based target shooter. Chain combos and hit FEVER for double cash. Watch the rage bar: bad breath, chomping jaws and grumpy monsters test your aim.\n\n{1995785444464774}\n\nSPEND YOUR TIPS\nAfter every shift, Kaiju Mart has 15 roguelite-style upgrades: laughing gas, tip jars, magnifiers, golden guns and party hats for your patients.\n\n{2035179557120122}\n\nBOSS FIGHTS\nVIPs in crowns pay triple, and every fifth day brings a MEGA MOLAR boss. Pull it!\n\n{1264984662428281}\n\nPLAY YOUR WAY\n- Endless score-attack shifts with a new twist every day\n- Rush Hour: a 3-minute time attack for high scores\n- 30 stickers that boost every future run\n- Hall of Smiles photo wall of happy patients\n- Casual-friendly: optional laser sight and infinite ammo\n- Great for VR beginners, party nights and quick sessions\n\nA funny monster simulator, dentist game and VR shooter in one. Giant patients. Tiny patience. Can you keep them smiling?", "short_description": "A hilarious VR shooter meets a dentist simulator! Your patients are 60-metre kaiju monsters and your clinic is a rooftop above the city. Grab your tools, blast germs out of giant monster mouths and never hit a filling. Calm them with laughing gas, pull the MEGA MOLAR boss, buy wild upgrades and chase high scores in this funny arcade game. Be quick: one angry kaiju ruins your day. Giant patients. Tiny patience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "develo
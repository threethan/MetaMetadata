-7&_nc_sid=6e7a0a&_nc_ohc=CEGTrZAIgXEQ7kNvwFbF_9k&_nc_oc=Adqg8awLH4MiisZul2e7oLeCk85mXD2EK_XS4oqBglDAQ-VFZzQjhMF8bu4Zl6Lp-ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLMrLXIBL3JPrVUnYcPdBkrIeRbxzYcbXVMzTpHrljCw&oe=6B0C7843"}, {"file_name": "4_kaiju_mart.png", "id": "1685395043143375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825470_1685395046476708_8589051527012616055_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0fP6_keeR8Q7kNvwF9ecAy&_nc_oc=AdoSIUl00AjP4zjISzj77dMXp5RPD5KdXTLI-ancQiAKRFJd8JUVFAf--LzxDsjMdOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSriG15RmJ2x0F61MR-O8xK42M6EG_-4EdnUzpIr2S9LQ&oe=6B0C5C02"}, {"file_name": "8_sticker_book.png", "id": "1728237681738379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1728237685071712_1471547739371952057_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGapYz0HPYgQ7kNvwEfoYbO&_nc_oc=Adqx-6EPpjXVg3Rq17Ol7YMpqpD1APi2fKIdDxLhq9Q6ZPv_0SZ-yIwBWvtoV3DVLrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1RIvGxWLKhBA190vkc2sHwgm3A44L0KHM6VkFagzJ-A&oe=6B0C6B65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "enhancedBanner.png", "id": "1791845005336080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823279_1791845008669413_4957206416162012797_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCe8YJbn4KgQ7kNvwHf5WSw&_nc_oc=Adpv4x0CBVUCj8pa8kjExcr4hXXEn9N7dhbXHIdh1ZrRdh-vOO_E1eOQDrho8XS3e2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSITF7pycHG78v_ARR3eZdKgufr0SkbqggasseTv3iSiw&oe=6B0C5F49"}, "display_name": "Kaiju Dentist", "keywords": ["titans", "monster", "doctor", "clinic", "giants"], "long_description": "Open wide! Welcome to the only dental clinic that treats kaiju, the funniest VR arcade shooter on the rooftop.\n\nEvery giant monster stomps out of the harbour, squeezes into a skyscraper-sized dentist chair and opens its enormous jaws right in front of you.\n\n{1538721311603166}\n\nSHOOT THE GERMS, NEVER THE FILLINGS\nGrab a tool and pop germs, plaque, stubborn rot and sneaky runners in this physics-based target shooter. Chain combos and hit FEVER for double cash. Watch the rage bar: bad breath, chomping jaws and grumpy monsters test your aim.\n\n{1995785444464774}\n\nSPEND YOUR TIPS\nAfter every shift, Kaiju Mart has 15 roguelite-style upgrades: laughing gas, tip jars, magnifiers, golden guns and party hats for your patients.\n\n{2035179557120122}\n\nBOSS FIGHTS\nVIPs in crowns pay triple, and every fifth day brings a MEGA MOLAR boss. Pull it!\n\n{1264984662428281}\n\nPLAY YOUR WAY\n- Endless score-attack shifts with a new twist every day\n- Rush Hour: a 3-minute time attack for high scores\n- 30 stickers that boost every future run\n- Hall of Smiles photo wall of happy patients\n- Casual-friendly: optional laser sight and infinite ammo\n- Great for VR beginners, party nights and quick sessions\n\nA funny monster simulator, dentist game and VR shooter in one. Giant patients. Tiny patience. Can you keep them smiling?", "short_description": "A hilarious VR shooter meets a dentist simulator! Your patients are 60-metre kaiju monsters and your clinic is a rooftop above the city. Grab your tools, blast germs out of giant monster mouths and never hit a filling. Calm them with laughing gas, pull the MEGA MOLAR boss, buy wild upgrades and chase high scores in this funny arcade game. Be quick: one angry kaiju ruins your day. Giant patients. Tiny patience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": null, "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
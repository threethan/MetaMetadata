t64.5771-25/38982685_472193901119701_8744251291127712515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCwQh8g8_WwQ7kNvwGrmA7i&_nc_oc=AdoA0Ng6JsbkvPJFzcFb2c8HPNGKiqBrgPpGBBKP0WFRt-HSUKiQqWpK2tt5qnOO2oY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc4vWC2YZulwZpQe3wee3J8yVXqrTUPeAywOA-2ubB6A&oe=69C68C72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRAutismALTestBuild", "keywords": [], "long_description": "In the Virtual Reality for Autism app, persons diagnosed with ASD (Autism Spectrum Disorder), can practice coping with being in certain specific social situations that might normally be difficult for them. \nIn the VRAA app, you can find the following 6 situations that might be challenging for you and you can practice them as many times as you want:\n1) Public transport 2) Visiting the doctor 3) eating in a cafeteria 4) First day in a new job 5) a job interview 6) going shopping\n ", "short_description": "Virtual Reality for Autist - by Autists, is a training environment for people diagnosed with Autism Spectrum Disorder, where they can practice certain daily occuring situations which might be difficult for them to navigate socially."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.ludusxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
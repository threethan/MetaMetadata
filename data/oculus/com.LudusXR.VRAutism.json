 the VRAA app, you can find the following 6 situations that might be challenging for you and you can practice them as many times as you want:\n1) Public transport 2) Visiting the doctor 3) eating in a cafeteria 4) First day in a new job 5) a job interview 6) going shopping\n ", "short_description": "Virtual Reality for Autist - by Autists, is a training environment for people diagnosed with Autism Spectrum Disorder, where they can practice certain daily occuring situations which might be difficult for them to navigate socially."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://www.ludusxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "973644690250924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974515_172262528081529_7681957929602814878_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg38U0-lFzgQ7kNvwFHBFLl&_nc_oc=AdoKXEuBxlJ7AspY-bNf_nbC_P97YkhDaFTpvEEMDs6aXK0l_hswYy_hRUtAghqsGI0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3_ud_vqKNufphGD6LbvWG8aosGlrxC9q1WMlvn5ITEyg&oe=69F1EF42"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
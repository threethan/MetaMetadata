5066979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982693_240905058400312_1881141824864808635_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IgqgDoEhTkQ7kNvwH1x14W&_nc_oc=AdoNubOBIoElv6g7-TR921Ta8N5uMJMejpv8-ZmgXi9EMRP1lFBkhe2ftED5D74TLZ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdlRCP0BWaskFjkLufl9wFB8NzrDAs7uMy7A3ZW_Faxw&oe=6AFC6B5C"}, "display_name": "Octoseek", "keywords": [], "long_description": "Play a crazy game of Hide and Seek as a mutant octopus where you win if you escape and lose if you get slapped too hard. Become a hider and support your friends by distracting the hunters and healing your teammates or become a hunter and slap anyone you see. Use your mutant powers to get around the play area and escape through the gates. Use an innovative chase system to lure survivors out or to stay away from the hunters more efficiently. ", "short_description": "Channel your inner octopus as you hide and help friends survive or relentlessly hunt down and destroy your fellow sea creatures."}]}, "developer_name": "Rigged", "developer_privacy_policy_url": "https://riggedvr.github.io/OctoseekPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged", "support_website_url": null, "website_url": "https://riggedvr.github.io/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "
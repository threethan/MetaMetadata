iad3-1.oculuscdn.com&oh=00_AfthtHF5GvrKK9ONlRKA2CM_yhOVBYsjqKHlmVffe9-JMA&oe=69A2FCB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Octoseek_Landscape.png", "id": "240905055066979", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982693_240905058400312_1881141824864808635_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsAR_7K7ypAQ7kNvwGFVL6l&_nc_oc=Adls0_GDozLav9eJ6L5Kud58msUx7eHzSgEQB_9aethrJBF34C48rF3CDbNJ9uEzhsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfswBNRPQtWyjXfRD9bEZi6xafHvPaxXpIPfJDRx2Bm7WQ&oe=69A2CA1C"}, "display_name": "Octoseek", "keywords": [], "long_description": "Play a crazy game of Hide and Seek as a mutant octopus where you win if you escape and lose if you get slapped too hard. Become a hider and support your friends by distracting the hunters and healing your teammates or become a hunter and slap anyone you see. Use your mutant powers to get around the play area and escape through the gates. Use an innovative chase system to lure survivors out or to stay away from the hunters more efficiently. ", "short_description": "Channel your inner octopus as you hide and help friends survive or relentlessly hunt down and destroy your fellow sea creatures."}]}, "developer_name": "Rigged", "developer_privacy_policy_url": "https://riggedvr.github.io/OctoseekPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged", "support_website_url": null, "website_url": "https://riggedvr.github.io/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
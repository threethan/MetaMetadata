null, "video_trailer_thumbnail": null, "display_name": "Banna Monkes V3", "keywords": [], "long_description": "Experience the latest evolution of Banna Monkes, a Gorilla Tag-inspired VR fan game like no other. In Version 3, dive into an expansive forest, float freely in zero-gravity zones, and brave the chills of thrilling horror areas. Customize your monkey in the shop and explore vibrant environments filled with surprises. With intuitive VR locomotion and immersive gameplay, Banna Monkes v3 delivers an exciting twist on monkey madness. Swing, climb, and explore like never before!", "short_description": "Experience the latest evolution of Banna Monkes, a Gorilla Tag-inspired VR fan game like no other. In Version 3, dive into an expansive forest, float freely in zero-gravity zones, and brave the chills of thrilling horror areas. Customize your monkey in the shop and explore vibrant environments filled with surprises. With intuitive VR locomotion and immersive gameplay, Banna Monkes v3 delivers an exciting twist on monkey madness. Swing, climb, and explore like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.express.adobe.com/webpage/MwAPXDSoCs5N9", "developer_terms_of_service_url": null, "publisher_name": "PickleB", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/Mm4PxWNh57HfT", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDIN
3626_950603919833936_2914320779498214316_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIR1QTnlE60Q7kNvwGNAQMG&_nc_oc=AdqSH0WzFXviKXYyW3FjwEo2NGbDY5PbAehShBbUGUGscF_cWO8dg2i4Fro45TSmP00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJMMvTLlfcOf5s-yte-oIlgiYRpZPPCVVdcl5SKT9c3A&oe=6B0DA569"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banna Monkes V3", "keywords": [], "long_description": "Experience the latest evolution of Banna Monkes, a Gorilla Tag-inspired VR fan game like no other. In Version 3, dive into an expansive forest, float freely in zero-gravity zones, and brave the chills of thrilling horror areas. Customize your monkey in the shop and explore vibrant environments filled with surprises. With intuitive VR locomotion and immersive gameplay, Banna Monkes v3 delivers an exciting twist on monkey madness. Swing, climb, and explore like never before!", "short_description": "Experience the latest evolution of Banna Monkes, a Gorilla Tag-inspired VR fan game like no other. In Version 3, dive into an expansive forest, float freely in zero-gravity zones, and brave the chills of thrilling horror areas. Customize your monkey in the shop and explore vibrant environments filled with surprises. With intuitive VR locomotion and immersive gameplay, Banna Monkes v3 delivers an exciting twist on monkey madness. Swing, climb, and explore like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.express.adobe.com/webpage/MwAPXDSoCs5N9", "developer_terms_of_service_url": null, "publisher_name": "PickleB", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/Mm4PxWNh57HfT", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "exte
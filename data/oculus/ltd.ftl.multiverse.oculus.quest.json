&_nc_oc=AdpRFj0lzQQUQkDA1oEXT2KLyLh8Uy1mq-5i-QeLCVyN_liKeHJCek9s2aI71luaGcs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd-4wBEiD1nw4phIAhh7HpFNrlIzKBBrQge3H69UJ3Kw&oe=69C1316D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/pzLmhi", "id": "1009431969415848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982582_1009431972749181_9083486352183394304_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrN9845KgOYQ7kNvwE3NRjz&_nc_oc=Adru0EEtN_XztYC_Mh6SgHf3Hn6QcbQ5CgHJlQV8ITAtapRUOye8PvsSc42K1xZzYHE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6V6Irlx2TkxcetlpRWEaMDKwcTBzdW9cDb8WV_B3FHw&oe=69C12CD5"}, "display_name": "Multiverse", "keywords": ["social", "friends", "space", "astronomy", "chat"], "long_description": "Multiverse - Come in and experience our first domain: The Planetarium. Explore astronomy like never before - socially in VR with your friends.\n\nMultiverse is an experience like no other. Learn about astronomy while navigating through awe-inspiring environments that showcase the solar system, its planets, their moons and other solar bodies.\n\nEnter the Planetarium to discover mind-blowing images, videos and models, all rendered in stunning detail, with audio descriptions, toys and interactive exhibits.\n\nChat, fire off rockets, chase each other through the solar system, or play hide and seek behind Jupiter. Multiverse's focus on streaming and social interactions make this a social experience not to be missed.", "short_description": "Multiverse - Come in and experience our first domain: The Planetarium. Explore astronomy like never before - socially in VR with your friends."}]}, "developer_name": "Future Tech Labs Ltd", "developer_privacy_policy_url": "http://www.ftl.ltd/legal", "developer_terms_of_service_url": "http://www.ftl.ltd/legal", "publisher_name": "Future Tech Labs Ltd", "support_website_url": "http://www.ftl.ltd/support", "website_url": "http://www.ftl.ltd/", "category":
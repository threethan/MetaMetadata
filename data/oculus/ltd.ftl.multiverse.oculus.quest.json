7&_nc_sid=6e7a0a&_nc_ohc=zGyAkNL0nt4Q7kNvwE1gtRm&_nc_oc=AdrT2M2MEKpiUWdLpg8C19UMyPRQh8B1so_FwjqLMbx02ZPjVudh5eX-n2B_gLsh3rI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD1LUr7a8U-oNaHWZbTKG3YN39uRjO1c2gkY8-GFp3NQ&oe=69C7C8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/pzLmhi", "id": "1009431969415848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982582_1009431972749181_9083486352183394304_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDEbY4fJ3lEQ7kNvwFliXj1&_nc_oc=AdoSpTzCee2fqQe9yHo53ZjLPdHsCkdncghuH3C1os3WLtOCHobtRZ0oVDTbl7dPCaA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhGmwSHeUjM4p8bmNjSklZ8ZXXl5K10upmZ_jFtWH5mw&oe=69C7C455"}, "display_name": "Multiverse", "keywords": ["social", "friends", "space", "astronomy", "chat"], "long_description": "Multiverse - Come in and experience our first domain: The Planetarium. Explore astronomy like never before - socially in VR with your friends.\n\nMultiverse is an experience like no other. Learn about astronomy while navigating through awe-inspiring environments that showcase the solar system, its planets, their moons and other solar bodies.\n\nEnter the Planetarium to discover mind-blowing images, videos and models, all rendered in stunning detail, with audio descriptions, toys and interactive exhibits.\n\nChat, fire off rockets, chase each other through the solar system, or play hide and seek behind Jupiter. Multiverse's focus on streaming and social interactions make this a social experience not to be missed.", "short_description": "Multiverse - Come in and experience our first domain: The Planetarium. Explore astronomy like never before - socially in VR with your friends."}]}, "developer_name": "Future Tech Labs Ltd", "developer_privacy_policy_url": "http://www.ftl.ltd/legal", "developer_terms_of_service_url": "http://www.ftl.ltd/legal", "publisher_name": "Future Tech Labs Ltd", "support_website_url": "http://www.ftl.ltd/sup
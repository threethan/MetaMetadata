s playful aesthetic and fun, competitive gameplay, Monkey Tagg offers an unforgettable VR adventure where every match is a test of agility and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nrXf06gd0gpAI_SEx4_3OWxxtBtHxqvRTX2JzsiQhGs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rezy", "support_website_url": null, "website_url": "https://html.cafe/xaf486a67", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1301639093039213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593749142_1819517949234554_4035381757465728897_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Qdmf9KbJBAQ7kNvwE-YK2G&_nc_oc=AdrYKfiT5w_xhRdHEaAbKPR1EMyJRv1tI5a9iSHMFlZmCAN3ZSogb3cVHRrr3GqY9xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKWLdRLOAzFpx7kBwM8xYVt9NQIN3um-CEIHVn-by--g&oe=6AFDDD50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Tagg", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 17906226
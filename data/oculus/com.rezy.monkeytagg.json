_name": "Monkey Tagg", "keywords": [], "long_description": "In Monkey Tagg, movement is a key feature: players use their hands to push off surfaces and climb, simulating natural gorilla locomotion. The game's emphasis on physical activity and dexterity creates a highly engaging experience, combining strategy, speed, and social interaction. With its playful aesthetic and fun, competitive gameplay, Monkey Tagg offers an unforgettable VR adventure where every match is a test of agility and quick thinking.", "short_description": "In Monkey Tagg, movement is a key feature: players use their hands to push off surfaces and climb, simulating natural gorilla locomotion. The game's emphasis on physical activity and dexterity creates a highly engaging experience, combining strategy, speed, and social interaction. With its playful aesthetic and fun, competitive gameplay, Monkey Tagg offers an unforgettable VR adventure where every match is a test of agility and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nrXf06gd0gpAI_SEx4_3OWxxtBtHxqvRTX2JzsiQhGs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rezy", "support_website_url": null, "website_url": "https://html.cafe/xaf486a67", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1287155147820941"}}]}, "scheduled
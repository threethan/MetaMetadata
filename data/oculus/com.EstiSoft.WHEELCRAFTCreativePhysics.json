45_1020795657783112_8503205899748695903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMaKK6hdbOkQ7kNvwEzgrFU&_nc_oc=AdpwjP06i0sYR0wBSEc1S1JVquQ5jNH8WKN2o3DRhTgXFIZ8KjsVe0x2n5zBIi5qjRE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBEknH37nX9aWUMacg49pPtyS21FK-2PpnyajdSmD9Tw&oe=6A7205B2"}, {"file_name": "AIEnhancer_ss5.png", "id": "912930684987475", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827611_912930691654141_4589824983435713394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xmCJt6Pv8gQ7kNvwE96_Di&_nc_oc=AdpkZ7O1efRfpTu9ZQtyPOzeym0C-pSsKVxe-7qx3DCjkkEUcIUPcHJ21ETysmoXEkw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV5VlWewkX9uhD7AkKMSoukzad_HxoKYQdZ8zw2xL57w&oe=6A7200F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AIEnhancer_ss2.png", "id": "1513906823404480", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_1513906826737813_8694139441413645383_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xD0l9BmzTn8Q7kNvwFvNB41&_nc_oc=AdrFK_I9xt-CO0laa35tXrnfImFR2Zxs6wTDghHRaRAuQO80DtC-cxLXNkMmATN-qiQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWZEoknIlWEUK97Lolnv3e1PchkHOErZWAj4WErFB2Cw&oe=6A71ECFB"}, "display_name": "WHEEL CRAFT: Creative Physics", "keywords": ["Draw", "Art", "Painting", "Sandbox", "Physics"], "long_description": "Wheel Craft: Creative Physics is a sandbox-style physics game where your creativity directly controls how your vehicle moves. Instead of choosing pre-made parts, you design your own wheels by drawing them on a digital tablet. Your drawing instantly becomes a real 3D wheel attached to your car, and the physics engine determines how it performs.\n\nEvery line you draw changes the way your vehicle behaves. A round wheel may give you stability, while a spiky or irregular design might help you climb obstacles or jump over gaps. The challenge is not just driving \u2014 it's inventing the right wheel for the situation.\n\nEach level places your vehicle on floating platforms, ramps, and tricky terrain above the ocean. To reach the finish line, you must think creatively, experiment with shapes, and adapt your wheel designs to the environment. Sometimes a strange or unconventional wheel design may be exactly what you need to succeed.\n\nThe game combines puzzle solving, creativity, and physics experimentation. Try different wheel shapes, adjust sizes, and test how your designs interact with the world. Watch your drawings come to life and see how small design changes completely transform your vehicle's performance.\n\nThere is no single correct solution. Your imagination and understanding of physics are the keys to success.\n\nDesign it. Test it. Drive it.", "short_description": "Create your own wheels and test them in a physics-based obstacle course. In Wheel Craft: Creative Physics, you draw wheel shapes on a tablet and watch them transform into real 3D wheels attached to your vehicle. Every design affects how your car moves, jumps, and balances. Experiment with different shapes, sizes, and strategies to overcome ramps, gaps, and tricky terrain. Use creativity and physics to build the perfect wheel and reach the finish line."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
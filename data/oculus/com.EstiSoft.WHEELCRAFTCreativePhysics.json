45_1020795657783112_8503205899748695903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-UoPwOYmf8Q7kNvwFCUuiE&_nc_oc=Adow3KQVA5IKklITEa8FqDlH8gFX-vLZZT9_IlL4MVqQQRgRlN3qocWTKzKmE-aQVi8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfKRznPF1CYI7OLfaCGfe_DFLb4GFB-P-F4wPfaGPSvw&oe=6A5E06F2"}, {"file_name": "AIEnhancer_ss5.png", "id": "912930684987475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_912930691654141_4589824983435713394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE1XQKHEw6MQ7kNvwFWHG7W&_nc_oc=AdqMuEuFxAU_6rACCAIaNaeNKMcYmbRqy4ADZqF1LpvucLD6oGnOUZ1VBpNIdtAQ73c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqKHC6j7FSTaB3gTIiyXc9W0vzPpnIUxz6rYuSveWMVg&oe=6A5E0239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AIEnhancer_ss2.png", "id": "1513906823404480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1513906826737813_8694139441413645383_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9HwRqbVBkIQ7kNvwEIRy5z&_nc_oc=AdpHa-l77ZF3t21dixWQ2qo1LefFd1DkN2ri0v-ISwMu4sIEvDbbsRPIL2TnMRmoanI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcjxMrlznbMchP4HOgMVRFOZbJBi8RUkXyiO4MtgBWUA&oe=6A5E267B"}, "display_name": "WHEEL CRAFT: Creative Physics", "keywords": ["Draw", "Art", "Painting", "Sandbox", "Physics"], "long_description": "Wheel Craft: Creative Physics is a sandbox-style physics game where your creativity directly controls how your vehicle moves. Instead of choosing pre-made parts, you design your own wheels by drawing them on a digital tablet. Your drawing instantly becomes a real 3D wheel attached to your car, and the physics engine determines how it performs.\n\nEvery line you draw changes the way your vehicle behaves. A round wheel may give you stability, while a spiky or irregular design might help you climb obstacles or jump over gaps. The challenge is not just driving \u2014 it's inventing the right wheel for the situation.\n\nEach level places your vehicle on floating platforms, ramps, and tricky terrain above the ocean. To reach the finish line, you must think creatively, experiment with shapes, and adapt your wheel designs to the environment. Sometimes a strange or unconventional wheel design may be exactly what you need to succeed.\n\nThe game combines puzzle solving, creativity, and physics experimentation. Try different wheel shapes, adjust sizes, and test how your designs interact with the world. Watch your drawings come to life and see how small design changes completely transform your vehicle's performance.\n\nThere is no single correct solution. Your imagination and understanding of physics are the keys to success.\n\nDesign it. Test it. Drive it.", "short_description": "Create your own wheels and test them in a physics-based obstacle course. In Wheel Craft: Creative Physics, you draw wheel shapes on a tablet and watch them transform into real 3D wheels attached to your vehicle. Every design affects how your car moves, jumps, and balances. Experiment with different shapes, sizes, and strategies to overcome ramps, gaps, and tricky terrain. Use creativity and physics to build the perfect wheel and reach the finish line."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
}, "id": "515836604596701", "locale": "en_US", "screenshots": [{"file_name": "doktorek1A 1.png", "id": "641768088447994", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391859_641768095114660_6384892358260319775_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K0eX42YNi0Q7kNvwHcAsSA&_nc_oc=AdqpN0wUJ8ZXMQERpMJNLS-aklG-Ea8bH98JS8R3Ry2YFsszMS-g6e0o5jenlX-STOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQN9iQ1tSVPoovZStC1Eieej6kp1x1z3OYGeI3YlhRGQ&oe=6A7B1104"}, {"file_name": "kapitan4A 1 (1).png", "id": "1739405999952560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473397159_1739406003285893_5707384688727818983_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG2PmPJ66dMQ7kNvwGHmqN0&_nc_oc=AdqbNEwpHhRdbp7Z73RDc5O1Jfvof0bN-KilVmk4yGo-q1aeZxxZS-g3sowGGGMLcTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJmg61XwOMNPGbSKfHM6eXIa_2T4hcpp-8EYiHj26iJg&oe=6A7B1102"}, {"file_name": "sand2A 1.png", "id": "593343593703727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393096_593343597037060_2195888331336921415_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MF5e667HdkQ7kNvwHTPy6C&_nc_oc=Adq7d_ddHcS7pgYa15rVf2JF6MR_abGwlFXrdKYlAukaGlqI8e0qHYydZ-sbB9hDk0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7nP_maLnDac8wFaNpp6Nk59OJBhigsBFuiWK1qa7xyw&oe=6A7B23DD"}, {"file_name": "iceman4A 1.png", "id": "2339971966384318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391849_2339971969717651_6424006343098129118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q0IZafk4UsQ7kNvwGV5BNc&_nc_oc=Adpw4hmJWebQbl5J3usbeALDwI63LlxajEC18t1_htO7VBWPgQxdLpco_doqiViXEz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTFtiksHigPMclasez2uFnnKJKj49f--tuCnbDJEeg_g&oe=6A7B3112"}, {"file_name": "sand4A 1.png", "id": "1026718396178178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393279_1026718402844844_6328801167740158623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RhlDtoaUBYQ7kNvwH2BXOW&_nc_oc=Adp24FvQKpxMXW_pToNhojaa5Nc7Y95cLethQ9BDWf0g4PNXuHk6E6ogy_WMazgomqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElL6zFoPjtLAXMOSFswvjSOgA05dkbxyJHKVMXCYWNGA&oe=6A7B13A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1740789339810915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391794_1740789343144248_3930249113005031239_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoX5kn1vq28Q7kNvwEltLWM&_nc_oc=AdqJ6a9sTkcMo2FWIbKU90X32wBXUQCEySyKfy33obSqgf0X5jAkeRUbjOpEhPBQMSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY_AZvxD3t37lxiPnZD-8szJv2nu5LX7yFRk1TGtTZ5Q&oe=6A7B36DF"}, "display_name": "Slap Fighter", "keywords": [], "long_description": "**Step into the ultimate underground fight club and prove your slap supremacy!** Slap Fighter VR is an electrifying game where every slap counts. Master elemental powers, battle fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless **Slap Syndicate**.\n\n# \ud83c\udf0dWELCOME TO A WORLD WHERE EVERY SLAP UNLOCKS A SECRET\nPlay as **John \u201cThe Invincible\u201d Krasinsky**, a fighter waking from a coma with no memory but an iron will. Guided by a cryptic master, navigate a brutal underworld of crime, corruption, and ancient martial arts\u2014where only the strongest hands survive.\n\n# \ud83d\udc81MASTER THE ART OF SLAP COMBAT\nPrecision is key. Time your slaps, dodge, dash, guard, and unleash **slow-motion combos** in a combat system that rewards strategy and skill.\n\n# \ud83d\udd25UNLEASH ELEMENTAL SLAP POWER\nHarness **fire, water, earth, lightning, and wind** to create **devastating combos** and turn the tide of battle.\n\n# \ud83d\udc4fSLAP YOUR WAY TO GLORY\nTake on **a wild roster of fighters** from across the globe, each with their **unique backstory, combat style, and rivalries**.\n\n# \u2694\ufe0fMULTIPLAYER MADNESS\nTest your skills in **fast-paced, high-stakes brawls**. Challenge friends or take on top-ranked slap fighters.\n\n# \ud83c\udfafDIVE INTO SIDE QUESTS & MINI-GAMES\nTake a break with arcade-style challenges like **\u201cSlap-a-Mole\u201d** and explore even more activities scattered throughout the hideout.\n\nDo you have what it takes to become the ultimate Slap Fighter?\n\n**Get in the ring and find out.**\n", "short_description": "Slap Fighter VR is the world\u2019s first story-driven slap VR fighting game. Master elemental powers, take on fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless Slap Syndicate."}]}, "developer_name": "Curious Games", "developer_privacy_policy_url": "https://slapfightervr.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Games", "support_website_url": "https://slapfightervr.com/discord", "website_url": "https://slapfightervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9770668006300557"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1449391299985484"}, {"status": "PUBLISHED", "id": "815345598064559"}, {"status": "PUBLISHED", "id": "683096608169612"}, {"status": "PUBLISHED", "id": "1409437836807117"}, {"status": "PUBLISHED", "id": "2056542698087616"}, {"status": "
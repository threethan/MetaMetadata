}, "id": "515836604596701", "locale": "en_US", "screenshots": [{"file_name": "doktorek1A 1.png", "id": "641768088447994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391859_641768095114660_6384892358260319775_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1ShXuk8NPAQ7kNvwHKrX6X&_nc_oc=AdqaxbZo3ofFXtNz-57DdmyNf_VkrcwCD5F2WIQXriL6IlYvh9SuRGXiKKiRrr9f8ZM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NL-6CIYH69AP0akDIQnCyWlQsLcXXoxQQCiee62oDUg&oe=69E76904"}, {"file_name": "kapitan4A 1 (1).png", "id": "1739405999952560", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473397159_1739406003285893_5707384688727818983_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfB5v8HEA7IQ7kNvwE8l62o&_nc_oc=AdoYcz8Sb2bY1z7z2uxL1Lm1p1KA5kjPjBQPbJhIf_mkTthgFuH4atAY4YNDPu4j5L8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mSn4PE52gyUdFgaVbDOPzOS2ctQL9c_9rZKmawb_dLg&oe=69E76902"}, {"file_name": "sand2A 1.png", "id": "593343593703727", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393096_593343597037060_2195888331336921415_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acy5DS1Qm44Q7kNvwEYSqBe&_nc_oc=AdrqI14Z2D-lMtatXiP52zWRUHofl5EnaZthERYidKDJG9p2p_21QqFHJjwKYB25KUo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a465z-5jK1cFuTFmUIXfsWbDSjHdcYIyOtbLFcUGk5A&oe=69E77BDD"}, {"file_name": "iceman4A 1.png", "id": "2339971966384318", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391849_2339971969717651_6424006343098129118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho1xXXfOcvEQ7kNvwG7BBpA&_nc_oc=AdrEDMdSqnl-nG3u2jm0s250CmLGjYnJ1l22yQWNg9ZamCI9ieYWPVcGxYuwYpRo0fM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oxAJSikDh0offqyFqAB8BYz58TvsHeOnudZvXHWFkKw&oe=69E78912"}, {"file_name": "sand4A 1.png", "id": "1026718396178178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393279_1026718402844844_6328801167740158623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90oZiCTGqWwQ7kNvwGiDIRT&_nc_oc=AdqASUWpEFbCYMjf7EX1e4UxQH5LH_X53lLoLzfU5v5pcxGYFsGeAfn9u0BH6_kW3vc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ODpO1TgV-bUTEpKFc539uVjRgSPp-0ow2rfKt9T689Q&oe=69E76BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1740789339810915", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391794_1740789343144248_3930249113005031239_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5NikMQwG9EQ7kNvwFHiIt1&_nc_oc=Adr8MGGDriQofiNE8Hfe4jrw0a_bvD9Y-Mgpr_Fw3slcSvEeesWN_v_m5h_W1Kg9SoU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HK7Z1VQ_jn726xqw5whSs3lLSBZKPgYJx4O5wMCfl9Q&oe=69E78EDF"}, "display_name": "Slap Fighter", "keywords": [], "long_description": "**Step into the ultimate underground fight club and prove your slap supremacy!** Slap Fighter VR is an electrifying game where every slap counts. Master elemental powers, battle fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless **Slap Syndicate**.\n\n# \ud83c\udf0dWELCOME TO A WORLD WHERE EVERY SLAP UNLOCKS A SECRET\nPlay as **John \u201cThe Invincible\u201d Krasinsky**, a fighter waking from a coma with no memory but an iron will. Guided by a cryptic master, navigate a brutal underworld of crime, corruption, and ancient martial arts\u2014where only the strongest hands survive.\n\n# \ud83d\udc81MASTER THE ART OF SLAP COMBAT\nPrecision is key. Time your slaps, dodge, dash, guard, and unleash **slow-motion combos** in a combat system that rewards strategy and skill.\n\n# \ud83d\udd25UNLEASH ELEMENTAL SLAP POWER\nHarness **fire, water, earth, lightning, and wind** to create **devastating combos** and turn the tide of battle.\n\n# \ud83d\udc4fSLAP YOUR WAY TO GLORY\nTake on **a wild roster of fighters** from across the globe, each with their **unique backstory, combat style, and rivalries**.\n\n# \u2694\ufe0fMULTIPLAYER MADNESS\nTest your skills in **fast-paced, high-stakes brawls**. Challenge friends or take on top-ranked slap fighters.\n\n# \ud83c\udfafDIVE INTO SIDE QUESTS & MINI-GAMES\nTake a break with arcade-style challenges like **\u201cSlap-a-Mole\u201d** and explore even more activities scattered throughout the hideout.\n\nDo you have what it takes to become the ultimate Slap Fighter?\n\n**Get in the ring and find out.**\n", "short_description": "Slap Fighter VR is the world\u2019s first story-driven slap VR fighting game. Master elemental powers, take on fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless Slap Syndicate."}]}, "developer_name": "Curious Games", "developer_privacy_policy_url": "https://slapfightervr.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Games", "support_website_url": "https://slapfightervr.com/discord", "website_url": "https://slapfightervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9770668006300557"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1449391299985484"}, {"status": "PUBLISHED", "id": "815345598064559"}, {"status": "PUBLISHED", "id": "683096608169612"}, {"status": "PUBLISHED", "id": "1409437836807117"}, {"status": "PUBLISHED", "id": "2056542698087616"}, {"status": "
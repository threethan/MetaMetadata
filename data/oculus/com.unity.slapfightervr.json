n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_trF2Jei538Q7kNvwG3gVc8&_nc_oc=AdouXX_PUrawz1crM_3jA2HVBlNPRuwr8tdjMDPb4gUwi7IJ_NsX2EwR17RLG5e6bYI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz0A4U8to4Nc9kODZEZ6S53Y6GEMe8xy_G2eK9dGxhfg&oe=6A8EDA24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1740789339810915", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391794_1740789343144248_3930249113005031239_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWMroo6IM_QQ7kNvwES61Ln&_nc_oc=Adq4NPmxBzpBlC-ecIM8ZGobnKYvqRqUB1U6Fs5nzk0-KBjLMI79cEwVCPAaj6xKS_8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5LPtYFDH-xU1fCt0TqFSTVyt_R_Tyw7-ZWxALdCjkWg&oe=6A8EC51F"}, "display_name": "Slap Fighter", "keywords": [], "long_description": "**Step into the ultimate underground fight club and prove your slap supremacy!** Slap Fighter VR is an electrifying game where every slap counts. Master elemental powers, battle fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless **Slap Syndicate**.\n\n# \ud83c\udf0dWELCOME TO A WORLD WHERE EVERY SLAP UNLOCKS A SECRET\nPlay as **John \u201cThe Invincible\u201d Krasinsky**, a fighter waking from a coma with no memory but an iron will. Guided by a cryptic master, navigate a brutal underworld of crime, corruption, and ancient martial arts\u2014where only the strongest hands survive.\n\n# \ud83d\udc81MASTER THE ART OF SLAP COMBAT\nPrecision is key. Time your slaps, dodge, dash, guard, and unleash **slow-motion combos** in a combat system that rewards strategy and skill.\n\n# \ud83d\udd25UNLEASH ELEMENTAL SLAP POWER\nHarness **fire, water, earth, lightning, and wind** to create **devastating combos** and turn the tide of battle.\n\n# \ud83d\udc4fSLAP YOUR WAY TO GLORY\nTake on **a wild roster of fighters** from across the globe, each with their **unique backstory, combat style, and rivalries**.\n\n# \u2694\ufe0fMULTIPLAYER MADNESS\nTest your skills in **fast-paced, high-stakes brawls**. Challenge friends or take on top-ranked slap fighters.\n\n# \ud83c\udfafDIVE INTO SIDE QUESTS & MINI-GAMES\nTake a break with arcade-style challenges like **\u201cSlap-a-Mole\u201d** and explore even more activities scattered throughout the hideout.\n\nDo you have what it takes to become the ultimate Slap Fighter?\n\n**Get in the ring and find out.**\n", "short_description": "Slap Fighter VR is the world\u2019s first story-driven slap VR fighting game. Master elemental powers, take on fierce opponents, and uncover dark secrets in a dystopian city ruled by the ruthless Slap Syndicate."}]}, "developer_name": "Curious Games", "developer_privacy_policy_url": "https://slapfightervr.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Games", "support_website_url": "https://slapfightervr.com/discord", "website_url": "https://slapfightervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9770668006300557"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1449391299985484"}, {"status": "PUBLISHED", "id": "815345598064559"}, {"status": "PUBLISHED", "id": "683096608169612"}, {"status": "PUBLISHED", "id": "1409437836807117"}, {"status": "PUBLISHED", "id": "2056542698087616
ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296125_1529179158910724_8430884122347727679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2yQZo4qs0cQ7kNvwGbwiNy&_nc_oc=AdrhZYfUNS4zKSca1Y6Cl5wyq52y_ypIlbsw6KES9eAk8SB1mqB5Y7-CZyi8YIewbMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCPdsGIN1GlH0id9-OWh2MM667xIJXsp8qhyxlkcnCiw&oe=6A68A9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_capsule_main_\u526f\u672c.png", "id": "1648042663186646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1648042666519979_3340728336771045194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLrIrPCN7yMQ7kNvwEVSEiz&_nc_oc=Ado50GA0nc3Mbulxdgzepet_x7dsU3me5Q1TPTPPQWfdA1ozUslLMPdHJm3sLJBvA_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3lgLZQ8iLRU3fS3IiHXgPQ1zV6Bb0X_wo3WYWVZ_mBg&oe=6A689D97"}, "display_name": "CatTag: Create", "keywords": ["gorilla", "cat", "tag", "cattag", "free"], "long_description": "# About CatTag: Create\nCatTag: Create is a multiplayer VR sandbox game about movement, building, and playing together. Use both hands to move through the world with cat-like VR locomotion, join other players online, and create custom spaces using the in-game map editor.\n\nBuild your own worlds, test them in VR, and use interactive systems such as physics, animations, collision events, and programmable circuits to create different kinds of gameplay.\n\n# What You Can Do\n\n- **Play in multiplayer VR** - Join other players in shared VR spaces and explore custom worlds together.\n- **Move with your hands** - Use hand-based locomotion to climb, jump, and move through environments in a physical VR style.\n- **Create custom maps** - Use the built-in map editor to place blocks and design your own rooms, obstacles, and playable spaces.\n- **Add physics interactions** - Configure blocks with physics behavior to make objects move, fall, collide, or react inside the world.\n- **Create animations** - Add animated elements to your maps to build moving platforms, interactive scenery, or timed challenges.\n- **Use collision events** - Trigger actions when players or objects touch specific blocks, allowing maps to react to what happens during play.\n- **Build programmable circuits** - Connect logic systems to create custom rules, mechanisms, puzzles, minigames, and interactive experiences.\n\nCatTag: Create is designed for players who want to build, experiment, and play user-made VR spaces with others.", "short_description": "CatTag: Create is a multiplayer VR sandbox game where players use hand-based movement to explore, build, and play custom worlds together. Create maps with physics blocks, animations, collision events, and programmable circuits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cattag.cn/privacy5.txt", "developer_terms_of_service_url": null, "publisher_name": "haha sudio", "support_website_url": null, "website_url": "https://discord.gg/Y9zvXnBFt4", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "26621995167451230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617847_1286633819562343_6217076446224106381_n.png?stp=dst-png_s360x360&_
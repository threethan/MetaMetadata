_ohc=CY719GFrqz8Q7kNvwHM0KZL&_nc_oc=AdrwBCGjsuzVUtncm2LzR4DftjWapSlyON0ZCvKw4mYVbKa0vrBJ33zVmQHhbKLkzaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUmy_nteYioEePHL5jFuijkLF7tWLU-fIlh2D6JWSsEQ&oe=6AFDDA15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3_BANTER_TRAILER_cut_2_min_Quad_HD_tetiana_edit.mp4_snapshot_00.10_2024.12.12_12.30.09.png", "id": "9342110755800661", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031554_9342110765800660_7270521561777981184_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLpjZGS7D50Q7kNvwHEDj6Z&_nc_oc=AdqzHc6LoZgSvwah8vAfyU2N4hvq1tC_Pe3xk0KNRgVdKsoffovqZJcRdml13wRPEDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOKNPxDSuQ3aYpPb6IT-WItX9Br7pO-ITIhY-U2re0Ag&oe=6AFDE26B"}, "display_name": "Banter", "keywords": [], "long_description": "**Physics-fueled games with friends**\n\nHello there. I assume you\u2019re here to learn more about Banter. Well, SideQuest made a Social VR game. With excellent physics in it. So, go ahead and click \u2018more\u2026\u2019 to learn more. See it down there in blue? Isn\u2019t that meta?\n\n\n**The best physics in Social VR**\n\nHarness cutting-edge FlexaPhysics \u2122\ufe0f (made with \u2665\ufe0fby Nimso) and bend gravity to your will. Or get rid of it entirely. Who needs gravity, anyway?\n{876545318026664}\n\n\n**Be who you want to be**\n\nPick from Ready Player Me or a **fully custom avatar**. Import your creations from Blender to really own your look. \n{2316290185404547}\n\n**Banter\u2019s better together**\n\nMeet friends and make new ones at Banter\u2019s regular hangouts, meetups, movie nights, karaoke-thons, and more. It\u2019s called Social VR for a reason. \n{1291371985209325}\n\n\n**Get your game on\u2014and push that tush**\n\nFrom Ski Jump to Tush Push, challenge your pals on the Banter leaderboards. Can you become the number one number two? \ud83d\udca9\n{1127482545609900}\n\n**Share in the adventure**\n\nPortal across the Banter-verse and explore thousands of community-created worlds. Can you survive the Banter Backrooms\u2026?\nIf you build it, they will come\u2026\nBuild worlds, make games, host events, and share it all with the Banter community. Go on\u2026 Flap your wings like a little social butterfly. \n{533147473056131}\n\n**Slam your body down and wind it all around**\n\nOr don\u2019t\u2026 Either way, you\u2019ve got options for full-body motion tracking.\n{477577528247178}\n\n\n**Join the Banter**\n\nBanter is free to play\u2014and always will be. Welcome to our worlds!\n\n\n**You might find these useful\u2026**\n\n\n**Website**: bantervr.com\n\n**Discord**: discord.com/invite/bantaverse\n\n\n\n\n\n", "short_description": "Welcome to Banter, the ultimate social VR sandbox where goofy physics and good times reign supreme! Adventure, excitement, and hilarious experiences with friends await you in the Bantaverse. So, what\u2019re you waiting for? Time to jump in! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?usp=sharing", "developer_terms_of_service_url": "https://sidequestvr.com/terms", "publisher_name": "SideQuestVR", "support_website_url": "https://sdq.st/support", "website_url": "https://sidequestvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"
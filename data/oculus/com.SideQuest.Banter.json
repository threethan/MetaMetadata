PUwX_MP2cIhi3pUqVt00bGaYoyofY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9eGNHyDWts9z1ONI5CizfH0ukbD_pnIHnBDy4VhdBxw&oe=6B0DCEB5"}, {"file_name": "b 13.png", "id": "833899171091185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031368_833899174424518_6410374894843913738_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOU78CAbJGgQ7kNvwHoocuR&_nc_oc=Adq3dTOZzFKuKrh7GWAZ5mRbfC0WXbVmEDOWrR9LNzb-ryMDlaLskh-BOQ7mNsljhPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUfNJnkmh_xD7F-xTMHXgBZ38HJ5skKkH67I0c1zwhNw&oe=6B0DB52B"}, {"file_name": "b 12.png", "id": "500435064971379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_500435068304712_1915409334878296060_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTLzyGxp_rMQ7kNvwHarI4q&_nc_oc=AdoIqNPo-I2MJwt76c-gqv3W4jYKwMibqDpAc49WonDI0oRXBe1YbOSFmiJhkuC63AM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYoiyBNqgiyriL6_jCGrmrasYxsBwygOGnrVVNMw4SeA&oe=6B0DBC6C"}, {"file_name": "b 11.png", "id": "407106681575207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974825_407106684908540_7707055758076610265_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0Cbjt9UJN8Q7kNvwE51ojQ&_nc_oc=AdqIFxUScrk8wbDPCIhj0JZpJuX5YKnPjTX0F8zWvpgnd3QpKQ5EdYL-wiJ3-rdqPpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLbx-zNIsjrxKBTa0vdHgohwlwIv1MTr3FuP0pR6_krw&oe=6B0DB5D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banter", "keywords": [], "long_description": "Banter is a Social VR experience that allows you to enjoy hanging out with friends whilst having fun. You can select from a huge number of custom avatars provided by Ready Player Me. Rather than appeal to younger players, we want Banter to be a place where adults can hang out and enjoy each other's company.\n\nBanter provides more presence than other social VR experiences because it provides full-body avatars with arms and legs, something we think is essential to feel present in your digital self. We look forward to supporting hi quality full-body tracking soon without the need for an expensive PC or equipment.\n\nEnjoy crystal clear spatial audio so you can hear your friends in VR, find your crew and enjoy casual mini-games that don't impose on the social experience too much. Run, jump, climb even zipline with a physics-enabled character allowing you to explore every part of Banter.\n\nBuild your own spaces and games with our Aframe integration!", "short_description": "The magnificent art of using word play, opinions, exaggeration, irony, sarcasm, and other comedic themes to have fun with your friends in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?usp=sharing", "developer_terms_of_service_url": "https://sidequestvr.com/terms", "publisher_name": "SideQuestVR", "support_website_url": "https://sdq.st/support", "website_url": "https://sidequestvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "498872442181882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080858379272272"}]}, "baseline_offer": {"id": "1080858379272272"}, "is_approved": 
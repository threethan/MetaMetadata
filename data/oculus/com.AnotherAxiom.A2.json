X-2ABfNlJykA7yOFGnovox_rddD6BZvIEQ&oe=69A4335D"}, {"file_name": "ORION_DRIFT_scraprun_2.png", "id": "1698222880765673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397610_1698222884099006_6662435408746645769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RJ6G1SjCKsQ7kNvwGdqoi-&_nc_oc=Admp1t7bh5gdygkGJJNxSnIfvVyQnQ1MLDb62W0XPnG1FlQZVywWYvsYeqlpOhZnsRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvf4tDm-sOb1jOLHglDJwMujvtHOmmU02TGOHAyj9jspQ&oe=69A43AA7"}, {"file_name": "ORION_DRIFT_lounge.png", "id": "1344925466834853", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392097_1344925470168186_6354084680938328346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2VeOaBt564Q7kNvwHuWE98&_nc_oc=AdlcXbRyLHRBEDUbYqWcAW7HAuldOD2TJTISa_GhsOIpmJELvS7jvPqCpvP1n8tcvmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvzz6WzVZQ0XzvaqAZgEY8z5orrVvW-cl6fipp8OJCrrw&oe=69A429BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ORION_DRIFT_TemplateLandscape (2).png", "id": "4063761207189842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_4063761210523175_3884062389068370843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsVFVMzIuLYQ7kNvwFVObp8&_nc_oc=AdlB3pvNwt6Ax9jwgzNxtggIEo4IzaY3ATXBAJZSN0paq2iep-nUxLHk5fv2LdszXG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfutIooi8FS8nsEqHqi4zN-JPtrqSrJ71W2xWUw_nkWKHQ&oe=69A44377"}, "display_name": "Orion Drift", "keywords": ["Sports", "Community", "Social", "Orion"], "long_description": "The Array awaits.\n\nEmbark on a journey among the stars in **Orion Drift**. You and your fellow robots were once Earth's premier athletes. Now forge a destiny among the stars together!\n\nFrom the minds behind Gorilla Tag and Echo Arena deliver a new era of social VR, a massive station filled with friendly Drifters and heart-pounding activities.\n\n**EXPLORE LIKE NEVER BEFORE**: Run, jump, climb, skate, and fly through seamless space stations with up to 75 players, packed with activities.\n\n**STRATEGIZE YOUR PLAY**: Engage in Array challenges, Driftball, Scraprun, and more to unlock charged-up abilities in the Mainframe to fuel your Drifting strategies.\n\n**COMPETE ON THE ARES**:  Hop into the new 4v4 Premier Fleet that is completely dedicated to Driftball.\n\n**JOIN THE COMMUNITY**: Gather for games and events, explore and complete challenges, or use your heart-ball to play with friends anywhere.\n\n*Please note that the game is still in development.", "short_description": "Orion Drift is now in Open Early Access!\n\nThe minds behind Gorilla Tag and Echo Arena deliver a new era of social VR!\n\nYou and your fellow robots were once Earth's premier athletes. Now forge a destiny among the stars together!\n\nRun, jump, climb, skate, and fly through space stations with up to 75 players, packed with activities.  \n\nGather for games and events, explore and complete challenges, or use your heart-ball to play with friends.\n\n*Please note that the game is still in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anotheraxiom.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Another Axiom Inc", "support_website_url": null, "website_url": "https://www.anotheraxiom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
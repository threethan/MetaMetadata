id": "1265022958690381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821147_1265022962023714_5971479527258774333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDKu6uADIogQ7kNvwFCpncB&_nc_oc=AdpbTjgFn7_tNEE4oXIOzS7Ifd3Uc_bfYenyX6fydcDAMqBrLRiPj1yqI5iByCG6UuA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qrIr55IS4eRuQ5OGPCvCelGqIlKva_6SvOGAijTi4oA&oe=69D8E57D"}, {"file_name": "Preview02.png", "id": "1443079026920479", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819311_1443079030253812_3773459361383003966_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L25cY0YK1tUQ7kNvwGd51Aj&_nc_oc=AdqCSYs7j6xfVzKCDe18JWL8KQ10M7INiErO2KQl53j2YfUq-C7wpWEhaq_L0OpGN7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uHgmtNZ7jW5HEGiOwzkLOm5hCKuG68BnyiIoShHK_bw&oe=69D8F208"}, {"file_name": "Preview03.png", "id": "745039141866023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820863_745039148532689_6245488350710032633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeNYL-PEfCYQ7kNvwFf_kjd&_nc_oc=AdqQKBzprbuoDOVh1aM7iZd3hV-eUlf8UOagQZySo0M9cPDSYNrY0QA4erqUX4oGk7o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VVk3B48ighKM_1EKeZ1RX_XJXi2ous9g0a4w2zjfEgA&oe=69D8D9C4"}, {"file_name": "Preview04.png", "id": "1944506896327238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821706_1944506902993904_6906109372075434994_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EesDGGuDsQ7kNvwGHgNv4&_nc_oc=AdqdLD1rNKDItVo4E_OGAd2kSwnPNMVZz-EsljY9dY8vjFT6G30RdiqtxMKiOK696qY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af054RMSPbzD8k3oGTUL9OWAbEZZfXkr-GyPFcI1cCJPZg&oe=69D8EA65"}, {"file_name": "Preview05.png", "id": "1025082432959795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820875_1025082436293128_45650063843580037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtGDnptrW3IQ7kNvwH0seBc&_nc_oc=AdrmK4K_R8PRkTtk1EmlgNORWzwwt1m-Zro3jPoHY_MsiSHnPXaw5MAqmqy-jRNgUYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PIsjVzwOnsvqrzwI7J1_DMXNdFRVU0tinWdGNNm6exQ&oe=69D90A6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtuWerk_Logo_V2_16_9.png", "id": "799259012599325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821147_799259015932658_6309383105290963938_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7PiCqhiBcsQ7kNvwGVyPng&_nc_oc=Adpgc2Lq8s6lcNiH-f8D1PFhl1-aSL76wFnGtWwIlReUB2DnRrV0iWHFrSO3PLTwg18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hiQWYfKN109cVAM9KOunPGixCLFxKvkn0Qqkp0u4H0Q&oe=69D8F743"}, "display_name": "ViRTUWERK", "keywords": ["NewTecConsulting", "Ausbildung", "Metall", "Industrie", "Lernwerkstatt"], "long_description": "ViRTUWERK \u2013 Die virtuelle Lernwerkstatt f\u00fcr die komplette Berufsausbildung\n\nViRTUWERK umfasst alle Lernfelder der Metalltechnik-Ausbildung. Jeder Lernpfad ist didaktisch durchdacht und vermittelt Inhalte anschaulich, handlungsorientiert und praxisnah in einzelnen Lerneinheiten.\nDie Lernenden arbeiten in einer immersiven Umgebung, die Sicherheit, Motivation und Wiederholbarkeit f\u00f6rdert. So wird auch theoretisches Wissen verst\u00e4ndlich und leicht zug\u00e4nglich.\n\nAuswahl der Lerneinheiten (Auswahl entlang der Lernfelder):\n-\tGrundlagen Metalltechnik: Werkstoffe, Arbeitssicherheit, Handhabung von Werkzeugen und Maschinen\n-\tTechnisches Zeichnen & CAD: Normgerechte Darstellungen, Bema\u00dfungen, 2D/3D-Konstruktion, digitale Fertigungsunterlagen\n-\tFertigungstechnik: Spanende und spanlose Verfahren, F\u00fcgetechnik, Oberfl\u00e4chenbehandlung\n-\tMaschinen- und Anlagenmontage: Montageprozesse, Pr\u00fcf- und Messverfahren, Instandhaltung\n-\tPneumatik & Hydraulik: Schaltpl\u00e4ne, Bauteile, Steuerungstechnik, praxisorientierte Aufgaben\n-\tCNC-Technik: Programmierung, Simulation, Bearbeitung und Qualit\u00e4tskontrolle\n-\tQualit\u00e4tssicherung: Mess- und Pr\u00fcfmethoden, Dokumentation, Fehleranalyse\n\nSo erleben Auszubildende die gesamte Ausbildung interaktiv, vernetzt und praxisnah \u2013 mit Kopf, Hand und Herz.\n", "short_description": "ViRTUWERK \u2013 die virtuelle Lernwerkstatt \u2013 macht alle Lernfelder der Metalltechnik erlebbar: umfassend, praxisnah und didaktisch fundiert.\nDie Inhalte orientieren sich am Rahmenlehrplan und verbinden Theorie und Praxis in einer realistischen virtuellen Umgebung.\nEs steht die gesamte Bandbreite der Ausbildung bereit \u2013 interaktiv, eigenst\u00e4ndig und in lebensechten Szenarien."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.newtecconsulting.de/datenschutzerkl%C3%A4rung", "developer_terms_of_service_url": null, "publisher_name": "New Tec Consuting", "support_website_url": null, "website_url": "https://www.newtecconsulting.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24124574413909036"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1779307392679906"}]}, "baseline_offer": {"id": "1779307392679906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774010040, "status": "PUBLISHED", "id": "1779307392679906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2571
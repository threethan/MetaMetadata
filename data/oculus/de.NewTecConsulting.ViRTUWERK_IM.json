ontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820886_24829428693340870_7271242635818253003_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuRG25p7PLMQ7kNvwHtksFs&_nc_oc=AdpOFw8u3-dKLdbwtYf3CbSMaUTEwV33Xw3mPBbHuFVfW_suZhKJFsGW5XbSHNkgxKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33g3JcL_5bv4-yKf-D8R4S4ZQl9PxYJFGdT5RSzsJSvg&oe=69D8D9B4"}, {"file_name": "Preview04.png", "id": "778134678308292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820019_778134691641624_3510667796592059790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-9IKJyH0SUQ7kNvwH21hhx&_nc_oc=AdrFYSHqXGFXCuLMZor-UfHStL4Px7WkJj4C8YizXbhi_tsw29jVWNbCdY9GwVLUYx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UwYhKNkql0ulvtT7pe4X8sGTda_lY38MRaJmIG8-EFg&oe=69D901C9"}, {"file_name": "Preview05.png", "id": "777038441858886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820063_777038445192219_6332035679313662758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0_qPxQKcI0Q7kNvwG6vUFn&_nc_oc=AdrnUjZCKUy3lzmCWrmAJSpSRXDkdrvSvgnJjLtnvGd7BRh3w5tZqau-1DmzBd1RymM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ISuIFn-lNFWbb_wfjZ4YenUWpbgtjf7eD_mjjQGl13Q&oe=69D90EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VirtuWerk_Logo_V2_16_9.png", "id": "1720877455275909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821735_1720877468609241_6337242482202013137_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBzx8Rb5e6sQ7kNvwElfknq&_nc_oc=Adp5rfqdI1wOj5-lnouY67qXu7BMFlBeoA4IQBAmjG288SY3ahme_zi2JHh3oqmZlKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bxhld7yuxshmse-SlyPAjb2Vnx2uYwmfZe-622yBKYQ&oe=69D8E626"}, "display_name": "ViRTUWERK", "keywords": ["NewTecConsulting", "Metal", "Workshop", "Education", "Industry"], "long_description": "ViRTUWERK \u2013 The virtual training workshop for complete vocational training\n\nViRTUWERK covers all learning fields of metalworking. Each learning path is carefully designed and delivers content in clear, hands-on, and practice-oriented learning units.\nLearners train in an immersive environment that fosters safety, motivation, and repeatability. This makes theoretical knowledge easy to grasp and directly applicable.\n\nSelection of learning units (aligned with training fields):\n-\tFundamentals of Metalworking: Materials, occupational safety, handling of tools and machines\n-\tTechnical Drawing & CAD: Standards, dimensioning, 2D/3D design, digital manufacturing documents\n-\tManufacturing Technology: Cutting and non-cutting processes, joining methods, surface treatment\n-\tMachine and System Assembly: Assembly processes, measurement and testing methods, maintenance\n-\tPneumatics & Hydraulics: Circuit diagrams, components, control systems, practice-oriented tasks\n-\tCNC Technology: Programming, simulation, machining, and quality control\n-\tQuality Assurance: Measuring and testing methods, documentation, error analysis\n\nThis way, trainees experience their entire training interactively, in a connected and practice-oriented manner \u2013 with mind, hand, and heart.\n", "short_description": "ViRTUWERK \u2013 the virtual training workshop \u2013 brings all learning fields of metalworking to life: comprehensive, practical, and didactically sound. The content follows the official training framework and seamlessly connects theory and practice in a realistic virtual environment. The full spectrum of training is available \u2013 interactive, self-directed, and in lifelike scenarios."}, {"images": {"nodes": [{"file_name": "VirtuWerk_Logo_V2_9_16.png", "id": "1763773747843777", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822553_1763773751177110_4229673143740353367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXcslRvky14Q7kNvwGaZ4bS&_nc_oc=AdoWaZcqbkATQQaZVRz289azTxUjS_hOfpqDsZYy4GznyKftM-Bme1fX_Y-MdEcGNyg&_nc_zt=3&_nc_ht=scontent-or
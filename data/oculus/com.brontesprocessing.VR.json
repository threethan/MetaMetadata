86_3604501825942642090_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8ZMQMeb_5gQ7kNvwFhKxWk&_nc_oc=AdoXlKorJPms1B6OaRNNuCW8-tVEZoSwAbFSGGMEfPImn69AMyv0YAKg31BcrFz-kxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6if2WARQYMILwCs9Hn9y5NZBJOPrLHBPC8x_tdNiJ7A&oe=6AFC72DA"}, {"file_name": "100a.png", "id": "1489363171409981", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38984454_1489363174743314_2981469795036661692_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVIjE3JrZqMQ7kNvwFTJwrv&_nc_oc=AdrZaiV7hBmUA2yKHdY_fvdSPrIEat3Vo1mn3z0CSTcSmbfv_geNDKtJ0OA3kGS7D4g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe0lSG3qeXbWhukVIlHO8CLPq1Q-g202F1TK1Viqp8AA&oe=6AFC617A"}, {"file_name": "102a.png", "id": "1259201234519200", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003280_1259201241185866_8254793301732168802_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcX34Lzn07kQ7kNvwG2jCmc&_nc_oc=AdoUp1_Hyw1B0gnVZ5QT16kdCJvqV3QXbVVr7EqPkoXsO-bLOr9QARb4qFeLFGVPVzM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgAzlo47PRLn_ZLyKL52GyMkOeSs7U-43k5QUhu1a9nA&oe=6AFC68AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VAST.Rehab Patient Panel", "keywords": [], "long_description": "VAST.Rehab is a fully-featured virtual reality rehabilitation system with the flexibility to work for everyone from small physiotherapy practices to the largest hospitals in the world. VAST.Rehab is easy to learn and use, making it perfect for therapists looking for convenient way to make their patients more motivated to participate in their rehabilitation process.\n\nVAST.Rehab automatically tracks patient's progress, so therapists spends less time doing the paperwork and more time treating their patients. With Vast.Rehab, clinicians gain access to a range of valid performance metrics from multiple categories.\n\nOnce a patient learns how to use the system while working one to one with his clinician, he can take the therapy home. All data is synchronized with our cloud based server, so the clinician knows whether patients do the exercises as prescribed.", "short_description": "VAST.Rehab is a fully-featured virtual reality rehabilitation system with the flexibility to work for everyone from small physiotherapy practices to the largest hospitals in the world. VAST.Rehab is easy to learn and use, making it perfect for therapists looking for convenient way to make their patients more motivated to participate in their rehabilitation process."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vast.rehab/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Marek Czech", "support_website_url": null, "website_url": "https://vast.rehab/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["ACTION", "EDUCATIONAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "310753914347928"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "395633938837759"}]}, "baseline_offer": {"id": "395633938837759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633039080, "status": "PUBLISHED", "id": "395633938837759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
", "id": "1489363171409981", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38984454_1489363174743314_2981469795036661692_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVIjE3JrZqMQ7kNvwFTJwrv&_nc_oc=AdrZaiV7hBmUA2yKHdY_fvdSPrIEat3Vo1mn3z0CSTcSmbfv_geNDKtJ0OA3kGS7D4g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe0lSG3qeXbWhukVIlHO8CLPq1Q-g202F1TK1Viqp8AA&oe=6AFC617A"}, {"file_name": "102a.png", "id": "1259201234519200", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003280_1259201241185866_8254793301732168802_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcX34Lzn07kQ7kNvwG2jCmc&_nc_oc=AdoUp1_Hyw1B0gnVZ5QT16kdCJvqV3QXbVVr7EqPkoXsO-bLOr9QARb4qFeLFGVPVzM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgAzlo47PRLn_ZLyKL52GyMkOeSs7U-43k5QUhu1a9nA&oe=6AFC68AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VAST.Rehab Patient Panel", "keywords": ["Training", "Fitness", "Movement", "Exercises", "Coordination"], "long_description": "VAST.Rehab is an interactive movement platform designed for immersive use in virtual reality. It turns physical activity into structured experiences where users interact with digital environments through natural body movement.\n\nThe application is built around clearly defined sessions that guide users through movement-based tasks focused on coordination, balance, precision, and spatial awareness. Visual cues and interactive elements provide immediate feedback, helping users stay focused and engaged throughout each session.\n\nVAST.Rehab is used both by individuals looking for structured movement experiences and by organizations that work with guided physical activity. Its session-based design supports repeatability, consistency, and predictable user flow, making it suitable for independent use as well as supervised environments.\n\nThe experience is intuitive and accessible, with no complex controls. Users enter a session and begin moving, while the system responds dynamically to their actions within the virtual space. Activity scenarios can be adapted to available time, space, and user preferences.\n\nKey features:\n\nMovement-driven interaction\n\nStructured sessions with clear objectives\n\nInteractive 3D environments\n\nVisual guidance and responsive feedback\n\nDesigned for consistent, repeatable use\n\nVAST.Rehab is not a medical application. It does not provide medical advice, diagnosis, or treatment. It is a digital movement experience created for general physical activity in VR.", "short_description": "VAST.Rehab is an immersive movement experience that turns physical activity into interactive tasks inside virtual environments. Users engage in structured sessions based on natural body movement, visual guidance, and clear goals. Designed for focused, repeatable activity, VAST.Rehab supports consistent practice through engaging, motion-driven experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vast.rehab/privacy-policy/", "developer_terms_of_service_url": "https://vast.rehab/terms-of-use/", "publisher_name": "Brontes Processing", "support_website_url": "https://help.vast.rehab/portal/en/kb/vast-rehab", "website_url": "https://vast.rehab/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EDUCATIONAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"],
749_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITwjXkpHNCAQ7kNvwFsQD9k&_nc_oc=AdrI3vPQWnwXoM0sJnu5sAHBzrsQzNz-vkfvanJsR6oHR7fWCIZhG1H7XJUn8-PWdPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW2MijSUQQxKVCRjYxZ7OHvg_hEpegTG8gmG7WHwYEHQ&oe=6AC66419"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYCB4rfu3-4Q7kNvwEZPBA7&_nc_oc=AdppIceIu7Q5AMFgZc4BdsVdMotVm5BWYZ3LkDFLYBtnfu_T0xTNODxxITNnMIUfgtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOONqQPQUrVHmK-ydh8Ns6n8ZkM3_V2cGRfir0s1zgTbg&oe=6AC659F1"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtpIBa7JtJ4Q7kNvwGETs9p&_nc_oc=AdpTFn1eFxw1cHX-SwODNoY3vNROPa6wNQFWVBz37QAcoGdmx_OAGD-6-p5TTWe2go4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_3BmL7ugOd0Hl9gV8TP_xRwa8HL0AupzHRRLTDy7SHw&oe=6AC63FD0"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wouV6lfdf8Q7kNvwH1i0Vs&_nc_oc=AdqjPvs5QeQp0mCHCSoi7ZC9L5x41KTfoNxxvwKTd9UjEPjtiABLRIp3uCcFofhpvPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY95oL9wgIHK3axIZ4kXLzUvSoTthM0mq9sV2_ctmMMg&oe=6AC66263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoI743G8B1oQ7kNvwGYxkul&_nc_oc=AdrBnwCM0lrxa0Ocj6MDHiPE3qvhpEc2Eqev3ogadbkKm8MYRKJYLU6WBrWHgoSe2zM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOBRqCLBGz9-RpPNxm0P2DRA7cO0TjJeJ7EFN-76_gYA&oe=6AC648F4"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_ur
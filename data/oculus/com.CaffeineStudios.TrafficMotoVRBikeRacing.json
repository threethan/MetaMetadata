iHAFAzf_o3vLQ&oe=6A9AE299"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LkYZqYPnZ4Q7kNvwFv6U8B&_nc_oc=AdrjMWPYEu1Bx0XTeTeu4wFIUEDgvvInVgHvmgLsfb-rEdvewEAtmOpGgaqRnUjIftk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV3N6wh1Q15Q8Uw2u-KiBTehA2DmDGHOVLG9dwwQKTuw&oe=6A9AD871"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ5ZxIyuMlsQ7kNvwGG3_H8&_nc_oc=AdrBw2CVMwJMfkP7MR06pc_BWkUU8ExMOauh42LVJgzYbEPrCUMB6CWUDyTAafM0kAw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj45TORsuqRvp1_Jbt0QrTjbzFnHmRIl3HrtFmCWgaSQ&oe=6A9AF690"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cu3onlOBQIQ7kNvwFz4wUt&_nc_oc=Adrdd9bs4QVCRRuxNOhJyD0_oBv6g4KD8WpFRidRLX7lggIaAfr1pTNVCtlcYxhLLGU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiZ_U_cUIAThLf5VAe2ZNzDkwldDSOwR82KssrXpVOzQ&oe=6A9AE0E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-6gqEw0Ab4Q7kNvwFJQwgE&_nc_oc=Adozf77aKuF-p0b2w1pmXbF6mM9mbLfqKSn57ZHDEGzy_O0sDPnMSyoJAK5gSPdhHgY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeH3Wx8t6nUFgw0MgozAEkT5U-w1KVYQ5U-tTLzd61ZQ&oe=6A9AC774"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
CB3RlcWGjGTdH82HaFcJjABCzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfez9blXEdY198xpu9uZQ_Q5fSm2SKQ1Z4l8Oo_LO1Q&oe=6AAAB499"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9iJ9vjcTN4Q7kNvwFWnLvI&_nc_oc=Adp6Hsr8kwA18YGEAW_k9LmfZQQWFWLZ4C1H1kmj-3tBm_umDK2jy1ekVkv0P-mCR4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhvqP1f-62zO8NUVcbGAQEi_QC8uTcsTEVt2yciRO2Dw&oe=6AAAAA71"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g7gUzOo2QEQ7kNvwGWShJW&_nc_oc=AdqJoSwSVGfFoGL1sbGDaPxVAp7QUZkhT5ED9i9OLr_qYMS3PcIvV0Vgl_hRyxmv1QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw8175J7EpiQrHwSrDlxeP9WhsOrR_KNrvmsu5yi-RvA&oe=6AAA9050"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em2EkzcWKe0Q7kNvwHu8Su9&_nc_oc=AdrVAzyDmVyA9O5_c9P38wrpCG2GyaD4lAt457T-KVlfuABh4An4mCKlPB5vXQw1dh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYU55PvfHlRsV3cVuaJL45Vaw5BTY1LhVZI0nx-HD9Xw&oe=6AAAB2E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5k2xCzT35kQ7kNvwEmNtxM&_nc_oc=AdokacnSmfHNoewjWNQyqQnv9lyvEzsBgAZXO6cVZm_mi7kujwdZ35z76QM3gcXxWOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJknnTgflyC-MYNwRPTVJ2fnTBKHp-VYTIrALQ8l_68Lg&oe=6AAA9974"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTA
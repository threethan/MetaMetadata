749_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bvq_dIwmdMQ7kNvwHZioN1&_nc_oc=AdqSxmpOJWKh0rYSTjbJgTXncuVbiZ9Peg6eLPftLGq6ZR8OaTPtB6XKIf3nThFX6x0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4l5CZanGZ7S1ByS7_hIzs2CF7zrZVsQWUyzLDthETiQ&oe=6AD0F019"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLd63rMM9S8Q7kNvwF9BCFH&_nc_oc=AdomcxJFH62fTOEejXLeCjUO6JNFqpYh6UZRehzCS78YdSloTVGIq6u3mmsUS3Kp5KU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOmWbFIgGMsCCf1S_EwrFyS2vX286vqP3d97CfgbebSQ&oe=6AD0E5F1"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKSEreDUQJYQ7kNvwGVq22N&_nc_oc=Adq8kKlWMC5AiZlkTEbAjevkUOnEK1XmjZFgQOwbvq5uXHJ-SVvKauMPyrN05rzlmII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsJdZJrDvu8CUNwB2v73uEv6tCizP5vKrDp9KTAtT-0Q&oe=6AD10410"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zTAIyxds38Q7kNvwGkyKQo&_nc_oc=AdqI8jLSsR-8wwY5H4Lb7OR149beiG70GHAUnwNkkIqYE1WisI9X99EP7gOh8PVLkNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQiexaiiv5ATZjPdnBRSznasZ6pi4l2nEp3X1t_x1U3Q&oe=6AD0EE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNFdpw-KUckQ7kNvwHMY776&_nc_oc=AdofD5tAm7M7DKmyzGIihsr9bvTTD1LcViJSS39qLHgijbHYhtcI16Z3BoIIWCbOoRo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOFOiRWt7UuJ4GO5bmPXUXdfJQcHwikPh8UBINrIDu-w&oe=6AD0D4F4"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_ur
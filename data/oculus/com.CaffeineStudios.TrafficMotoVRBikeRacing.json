-kyWAFRkJIxRSxqC9iWqSAvmtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsbybbEy6WFRTbbOnlWvLLoGc9rGUDWA23Y6bAfrsvBA&oe=6AAC0619"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9iJ9vjcTN4Q7kNvwEMi7q5&_nc_oc=AdqznizBlZnZZh8jVhqAkHXv0pndaHaZrERAMs67Jhpcth6-616wIbItHyt8PxzHINs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKAWvcShKF5MPr6paSGHGcnKZ0yU4ciHzYr4a-ubwS6Q&oe=6AABFBF1"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhtzI60RB8cQ7kNvwHyCQZ8&_nc_oc=AdqaIMKlpbI6jDYfOzqI92ChFrIxx-5J47DJ_-Mm62PP3T2tvypkXnaFEKaUM1orobM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIg2ONAE4uUJeGK0KrTGXv5jJcO1zuQAep3wfsYpcolA&oe=6AABE1D0"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em2EkzcWKe0Q7kNvwEFT50r&_nc_oc=AdqIF41_fODeO4VarJ2QehZfsCIH5tF9uPwp6BtLV281rpYITZz-Bf5DGc1khxL271U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL6Dbi7GihHcExdhXk0Cq4tQ8LVHGJ2MgLfeVbjz7RpQ&oe=6AAC0463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5k2xCzT35kQ7kNvwFU19FY&_nc_oc=Adqvey34Tm9uny4rFD0v1mWcR9jh7JdZxbM4--Dz500GyyrwYXdfOU9BWGby9PRymQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFUJEOCK53Cc0nlCiWL9QilT-NKEludmdli00PVCNa9w&oe=6AABEAF4"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTA
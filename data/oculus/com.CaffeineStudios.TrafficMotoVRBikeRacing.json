749_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITwjXkpHNCAQ7kNvwEVhr8v&_nc_oc=Adox3ykDbVLog5GyynhOnbZXL-UACy4kBFBIYaifiNlA4H_oCag7qopyLmZx6uFpAlM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNerYVzJ1qV_dD2M2XLoRj2pHZmIhleowzYp8zO4VkXzQ&oe=6AC7B599"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYCB4rfu3-4Q7kNvwFmWi36&_nc_oc=AdrLlA7NLEThat0oSQTFcVzIAFPdOEz3Dccx5eAy1ujNEzARtQuh22iZaLj6x52ujFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeTYs8HbwuOShxQs0dAW_vdOfhFc2hR-Xzjy80Z3ANRg&oe=6AC7AB71"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4aIr2XIWUgQ7kNvwE5crvt&_nc_oc=Ado4J-SYDdbMZn0OzLJnSAa5HGeUSjiTbNqzX9M6ENRqfq1m9pxN7lBsVHK6P_0kqfo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH4Ut8EDdqGFj77IYngekja-6457Z4ieMXav8jCVRcWA&oe=6AC7C990"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wouV6lfdf8Q7kNvwGKPItz&_nc_oc=AdoUTL0WSI-IrTY7qCB0kStXPc5or7pL3LNt80t1OaNEqmD6FKitIEZy1evXygrIyf8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxJoVVRYVSTUNoAK3XaoGSgjqDZ86Tx0ZpVFPsRzzddw&oe=6AC7B3E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoI743G8B1oQ7kNvwF0UCvd&_nc_oc=Adri1HH_3aIT49p-krNSe9KeJdQZgPWUBHmnDvGn_I0OQAAWe_1wS6GhqkHZXJqTAoI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGceJTl_2v6gS0hRnnjHNDEyqAGjvZAzHunQxEahMZpg&oe=6AC79A74"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_ur
749_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kAZPxyklgsQ7kNvwE1haQe&_nc_oc=Adqt6qCUdd6wtzAAdqVul9aJQZkVecQOVNLvJ_x70C14H2pA7T_UOA2JnkZFb1_ldCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjEpvjfOxddl6VhuA_VenHfIin5rqshrQM9m0LboOkOw&oe=6ACBAA19"}, {"file_name": "Traffic_Moto_VR_Screenshot_6_2560x1440.png", "id": "1484933206289976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829686_1484933209623309_7208853201636942639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfJ48fziYJUQ7kNvwHQGAMe&_nc_oc=Adq9B4Mf73q9mdin5NdAVPFGt8gClQm6tkFFIfVADpTayuf-cc1wqNzBJR23YBmw9OE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN82gTUXyVH8cmJrURT4HRKNBVihEuqLurtp0NFNFfy4g&oe=6ACB9FF1"}, {"file_name": "Traffic_Moto_VR_Screenshot_4_2560x1440.png", "id": "1293378055897707", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1293378059231040_3777624011693699378_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOk966jlF74Q7kNvwG_ZeOx&_nc_oc=Adp9R2UTUkQ4EMYE2ZzKQKH58Kot2QsZLDU_FyHySO0jYdFVXufboWfkBuEKqvXnKOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB8wtcjuA2iB32tD6mcnHta__2wTEafwPoTm1tITu1WA&oe=6ACBBE10"}, {"file_name": "Traffic_Moto_VR_Screenshot_2_2560x1440.png", "id": "5316935941864310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_5316935948530976_2992900085189340830_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM9hh7kpaqAQ7kNvwFRe2AX&_nc_oc=AdpkdV0Ei-juWNffnYBC18Bkg2c75T7Ah4bUJRSdpE-QnnAR8D6txwb-uq3YPmfYwas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM24_ShanokkdLf9uiC4AnvLGFC3IHuUuocYF10ETLORg&oe=6ACBA863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1024752040416381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1024752043749714_2425047325569598385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQFHEnnpakMQ7kNvwEodw9F&_nc_oc=Ado9AwyMyrcYj5JczgNgVFHlA7xKj6dgQ4p9CyWQ03yx48CN9qwacf8__G9ZwXqM_Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGnrGJCG9vvx7dHXEhI1dyKqeYTPqunLXM-xL37lM2vQ&oe=6ACB8EF4"}, "display_name": "Traffic Moto VR: Bike Racing", "keywords": ["trafficBikeRacing", "HighwayMotoRider", "FirstPersonBikeVR", "MotorcycleSimulatorVR", "VRMotorcycleRacing"], "long_description": "Traffic Moto VR: Bike Racing puts you on a motorcycle in first-person virtual reality and drops you into fast highway traffic. Use your VR controllers like handlebars, pull the trigger to accelerate, brake through tight gaps, hit boost, honk, and pop wheelies while chasing a higher score.\n\nOvertake cars, buses, and trucks at speed to earn coins. The faster and cleaner you ride, the better the reward. Spend coins in the garage to unlock new bikes and levels, then return to the road for another run.\n\nGame features:\n-> First-person VR motorcycle racing\n-> Controller-based handlebar steering\n-> Highway traffic with cars, buses, and trucks\n-> Boost, brake, horn, and wheelie controls\n-> Coin rewards for speed and skillful riding\n-> Garage bike selection and unlocks\n-> Multiple race levels and drive modes\n-> Time trial and score-chasing gameplay\n-> Crash feedback and quick return to the garage\n\nBuilt for riders who want a VR traffic racing game with simple controls, fast bike action, and arcade motorcycle racing feel.\n\nKeep your hands steady, watch the lanes, dodge traffic, and become the fastest rider on the highway.", "short_description": "Ride a motorcycle in VR through highway traffic. Steer with your hands, boost, brake, do wheelies, dodge cars, earn coins, unlock bikes and race across multiple levels in first-person bike racing action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/traffic-moto-vr-bike-racing-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_ur
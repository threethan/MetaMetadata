=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXt5er88xeAQ7kNvwH6ZeJ4&_nc_oc=Adow4EbASyWbLkkToWbnpza3EW6wk6Ogfqld4ihOO3OKhes357iLJFPFnFPe-Skplxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQraNPyEbntelKwKmQaVTM0hwP_OC8UYZ7j83yGsrLuaw&oe=6B0051E1"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1444309107825193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1444309111158526_6875167375106124230_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vxTfbwsZUsQ7kNvwHzeFvb&_nc_oc=AdrGUmsTEHLUJCYl83Q1567hf75pdZsWY_w4xdT_QysFdQl3LsZcL6QV6RIBJVrozCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScmcfixZLDHFfCxp4BG0gJ_A0nmPpkN3ow_1ZSmJnN_Q&oe=6B007FA3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1770093764075645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1770093767408978_482904992005611501_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnHry0t4onIQ7kNvwHAOJvw&_nc_oc=Adp4hWZ_YkgrFb_6YIsbDSeZIRDhOKfbZyvb8qJV58i7uwjuPdYgUE8eWZfN4-EBo6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPpHdOIDtU9DW4nIvAwOWku1wCjQjatfViQ-6otIhjSQ&oe=6B00589E"}, {"file_name": "screenshot_1_2560x1440.png", "id": "29076992181970710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_29076992198637375_1981096870852528347_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGlQOBgdVbcQ7kNvwFq_-RM&_nc_oc=AdrAgP103eS8gMaBTL5SJZOVZh_X5OdjR1M-Y6xkCjk-NSgM1Wsljn1_qK9aOq7uZdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Vwh2qA3PQ86NP_QI8geLqsk34p7mIEBbmOl01-1otw&oe=6B007CB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Whiteboard", "keywords": ["whiteboard", "planning", "drawing", "notes", "brainstorming"], "long_description": "Whiteboard is a visual whiteboard built for Meta Horizon - a clean, fast canvas for planning, brainstorming and mind-mapping.\n\nFreehand drawing with a velocity-sensitive, smoothed pen, a palette of 12 colors and three stroke widths. Add sticky notes, text, shapes, straight lines, frames and connectors to structure your ideas. Select, move, resize and delete any element, with full undo and redo.\n\nPan and zoom a canvas without limits. A fit-to-screen control keeps everything in view.\n\nYour boards are saved automatically as local .wbj files, each with a thumbnail preview. Export a board to PNG or share it directly, and export all boards at once.\n\nWhiteboard works fully offline on-device: no account, no internet and no data collection. Your work stays on your headset.\n\nFeatures:\n- Freehand pen with smoothing and velocity-based width\n- Sticky notes, text, shapes, lines and frames\n- Select, arrange, undo and redo\n- Infinite pan and zoom canvas\n- Automatic local saving and board management\n- PNG export and sharing\n- Light and dark themes with an optional grid\n- English and Russian", "short_description": "A fast, offline visual whiteboard for planning, brainstorming and mind-mapping. Draw freehand, add sticky notes, shapes, text, lines and frames, pan and zoom an infinite canvas, and export boards as PNG. Works fully on-device - no account or internet needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://savvazaicev.github.io/whiteboard-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Savva", "support_website_url": "https://savvazaicev.github.io/whiteboard-legal/terms.html", "website_url": "https://savvazaicev.github.io/whiteboard-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVE
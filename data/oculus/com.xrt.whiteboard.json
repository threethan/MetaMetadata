_6875167375106124230_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vxTfbwsZUsQ7kNvwHvXq6W&_nc_oc=AdpdyNU8BlImEKTduTJlzP60knSXhsJnpaGQKOvgxFR6j6kSvbdvR6qVlxJuL23_kKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREMLsOWpdhKoVsEMoUW7UvGwYYeywXKYoqKr-GSVUj9A&oe=6AFF2E23"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1770093764075645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1770093767408978_482904992005611501_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnHry0t4onIQ7kNvwFIbrD1&_nc_oc=AdrVfaJJAkChKB9LkukzoDHcHEgKzYWMAbvazu05ptdPhVc0RB_Bj0oocOHHFI3bZi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSickOw1eqRGYeqWEFiGVEIc0PsSXuifTrpbjaUNN63Jw&oe=6AFF071E"}, {"file_name": "screenshot_1_2560x1440.png", "id": "29076992181970710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_29076992198637375_1981096870852528347_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKQil8l8bjoQ7kNvwEvN5ll&_nc_oc=AdrD17KV0Y1dUbZ3humRYcnXASAh5YHsmjPMYMygPv2KDo_V0XP7AvUSzVe8BzY1oRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5enyOAIFmLwxxe6R5vXMegzklKBbKu_8oab8OwjOfIw&oe=6AFF2B36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Whiteboard", "keywords": ["whiteboard", "planning", "drawing", "notes", "brainstorming"], "long_description": "Whiteboard is a visual whiteboard built for Meta Horizon - a clean, fast canvas for planning, brainstorming and mind-mapping.\n\nFreehand drawing with a velocity-sensitive, smoothed pen, a palette of 12 colors and three stroke widths. Add sticky notes, text, shapes, straight lines, frames and connectors to structure your ideas. Select, move, resize and delete any element, with full undo and redo.\n\nPan and zoom a canvas without limits. A fit-to-screen control keeps everything in view.\n\nYour boards are saved automatically as local .wbj files, each with a thumbnail preview. Export a board to PNG or share it directly, and export all boards at once.\n\nWhiteboard works fully offline on-device: no account, no internet and no data collection. Your work stays on your headset.\n\nFeatures:\n- Freehand pen with smoothing and velocity-based width\n- Sticky notes, text, shapes, lines and frames\n- Select, arrange, undo and redo\n- Infinite pan and zoom canvas\n- Automatic local saving and board management\n- PNG export and sharing\n- Light and dark themes with an optional grid\n- English and Russian", "short_description": "A fast, offline visual whiteboard for planning, brainstorming and mind-mapping. Draw freehand, add sticky notes, shapes, text, lines and frames, pan and zoom an infinite canvas, and export boards as PNG. Works fully on-device - no account or internet needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://savvazaicev.github.io/whiteboard-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Savva", "support_website_url": "https://savvazaicev.github.io/whiteboard-legal/terms.html", "website_url": "https://savvazaicev.github.io/whiteboard-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1501152883073095"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.c
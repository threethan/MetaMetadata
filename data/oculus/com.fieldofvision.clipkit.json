AiGq8uQ1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA28ZF59suTdCJToy0yoa4-k9KKBVOrrNVCnFXqtb1wKg&oe=6A636361"}, {"file_name": "2.png", "id": "827345289800568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_827345293133901_5408793381504283787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8_TJ8mylVUQ7kNvwEDh6JR&_nc_oc=Adr1RmqL3X8ZQbjLs_BRVe3frScyavvsFiqNCPrdltAtc_tl-F8gVNOLudsIRPwe-Uw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1WIrc_q_ruW6J2RU9GUOFZAshJMUGYQCnp7OjRo-BYA&oe=6A636A37"}, {"file_name": "1.png", "id": "956374753428769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_956374756762102_5057194945664414780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Z29VDlH4f4Q7kNvwFdy2ry&_nc_oc=AdoNpNZakIldXXzOCgblz7vLaoA46-9b1BXpEc22dkTRmx_DY4fWii21LrVV37Xg6m0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABP_EJbYAXRhHXvSBYR595YvyoleC48qyKkoYLNz1opQ&oe=6A6363F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "977752578145673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_977752581479006_3040198152911716829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk5NpJEBd6IQ7kNvwGEYLtc&_nc_oc=Adr6DM-u3VMoEbBh4xzUn2-l7zgYvVsBFJdtGHsEqi-tz8jyXHh4ylii1uYT6QSAhBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwAXHItGm0RMdYcureQdldnW24YIJh0Bce0TT3gDrG-w&oe=6A63618D"}, "display_name": "ClipKit: Video Clip Editor", "keywords": ["Video", "editing", "editor", "clips", "creator"], "long_description": "Turn your Meta Quest recordings into videos directly inside VR.                                                                                                                                                        \n{1492391138965409}\nClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n{1251830063829236}\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  \n\n{1831748694451630}", "short_description": "ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27045942258370651"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_1495243229182943_5534040102824242326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHZbIMTHXfUQ7kNvwHCDBHL&_nc_oc=AdqVHnGaFLNKJvpF_p8NTqSA6pt-f70
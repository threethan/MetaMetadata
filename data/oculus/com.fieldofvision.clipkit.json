DSXWeqKIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA46YrD-YJLmhxO723NMbsf4OdUdKufJx9LRYlTRXHYGw&oe=6A523FE1"}, {"file_name": "2.png", "id": "827345289800568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_827345293133901_5408793381504283787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGrk5c6gWBcQ7kNvwHX4SvY&_nc_oc=AdroyPVy-f80AKaKzxdngUMHkbpti_ZYzupLZ4hdtCIxV1833j8dNqwfhI3GV6QP_Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtrALBmXXDajZto9K6-FVCbTZ5VMTHf4bS1KlX3SUgbw&oe=6A5246B7"}, {"file_name": "1.png", "id": "956374753428769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_956374756762102_5057194945664414780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbzqZjnsTdoQ7kNvwHfB95S&_nc_oc=AdqXbN15n6bnSu0XqEfCsEl0kEvObSw4_U8ZSbajhPy_w-f-Eqm8mNiCQ3qVQwyhgio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDP4IboUaRt-PyNivhepVKRsCpGyENVvdCYnw-w9CFLg&oe=6A524075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "977752578145673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_977752581479006_3040198152911716829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUvqYczU3vcQ7kNvwE0J9oe&_nc_oc=AdrueNEthu5lyOoy9Ga_5bsqvDKuZtAa1aPh8xd78taxx8ZaZ4i2cr6rMRwil75e4Ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7nD1Dk6Hq6DN91tr7oLmaR8AIfBPt74C5bmdEUML9mQ&oe=6A523E0D"}, "display_name": "ClipKit: Video Clip Editor", "keywords": ["Video", "editing", "editor", "clips", "creator"], "long_description": "Turn your Meta Quest recordings into videos directly inside VR.                                                                                                                                                        \n{1492391138965409}\nClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n{1251830063829236}\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  \n\n{1831748694451630}", "short_description": "ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27045942258370651"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_1495243229182943_5534040102824242326_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVvYBstP_EsQ7kNvwFmhakF&_nc_oc=Ado5Q3RKMVVRab0Ewlqyo2L_61bRCNk
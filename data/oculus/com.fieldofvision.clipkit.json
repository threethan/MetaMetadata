BAY1xdirAtESQ&oe=6AEF6177"}, {"file_name": "1.png", "id": "956374753428769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_956374756762102_5057194945664414780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BJ8A6V54v4Q7kNvwGqdZ2W&_nc_oc=Adq78qqhX9YV2SmplpHa20rpwBTfrz9251jyRLwGPwHeZsfvDz9a3-T-OEYmJtq5hu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe-iDC83LBHd2bjgQ2193NwAnG-dtHnoAU_44mzWvp3Q&oe=6AEF5B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clipkit-approved-2560x1440.png", "id": "1439912504231238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/774969737_1439912510897904_871116581908365548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7lHSYdhfZIQ7kNvwG16K46&_nc_oc=Adpp6kBxQz93qRXIKbIchrL_GEc8DPuu_mtP3lp3TWy1gbgkCjyljTRMeOCMjyadunI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGkmw2sW_zS3W0pv_NEm4Rr5Hlv3YPAJvRNwf8-ol7vw&oe=6AEF3EC0"}, "display_name": "ClipKit: Video Clip Editor", "keywords": ["Video", "editing", "editor", "clips", "creator"], "long_description": "# Free editing and exports up to 60 seconds. Unlock longer exports forever with a one-time purchase - no subscription.\n# -\nTurn your Meta Quest recordings into videos directly inside VR.                                                                                                                                                        \n{1492391138965409}\nClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n{1251830063829236}\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  \n\n{1831748694451630}", "short_description": "Free to try - export up to 60 seconds free. One-time upgrade for exports of any length. ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29140751372223052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654854429_1444298843716204_1377400836209015910_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTukgUS9x-UQ7kNvwHFhwcH&_nc_oc=Adrd6U51KSqCdU1ZxykLFoLKQ5XVHXifmYwi1ZvLg41fVlR9iIWpgUy11g46NyX898M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeKmpyvy1Mk8vnffMoaswA5338sRcITj3G5enHOnLzRQ&oe=6AEF669C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ClipKit: Video Clip Editor", "platform": "ANDROID_6DOF", "context
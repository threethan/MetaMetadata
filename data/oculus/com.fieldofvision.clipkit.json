l493D2tMy9Wtw&oe=6AF355F7"}, {"file_name": "1.png", "id": "956374753428769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_956374756762102_5057194945664414780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmbeQXDiqDsQ7kNvwHOjLfS&_nc_oc=AdoBiR9wEjGnXXOcmysXqigTUa2UiDQG1ziEqSSl7vV1kZIfCSOmnU9FZ6ulqGUYEl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT93OR4s3T4o_5XAeO0aRtCBtcJDj43VdZ2kOp8tR0WPw&oe=6AF34FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "clipkit-approved-2560x1440.png", "id": "1439912504231238", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/774969737_1439912510897904_871116581908365548_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-ZJg7ILpQoQ7kNvwHWhzLW&_nc_oc=AdrOV02rcW_fjdETOO-Az_0vHxkoB6fqpw3y5B5sTEmRACFGG3qfMjbQV89fH1twL6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG41iNtSDK8ndnmbfze8KZqfYX85GJEQzTeseZXR6FPg&oe=6AF33340"}, "display_name": "ClipKit: Video Clip Editor", "keywords": ["Video", "editing", "editor", "clips", "creator"], "long_description": "# Free editing and exports up to 60 seconds. Unlock longer exports forever with a one-time purchase - no subscription.\n# -\nTurn your Meta Quest recordings into videos directly inside VR.                                                                                                                                                        \n{1492391138965409}\nClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n{1251830063829236}\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  \n\n{1831748694451630}", "short_description": "Free to try - export up to 60 seconds free. One-time upgrade for exports of any length. ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29140751372223052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654854429_1444298843716204_1377400836209015910_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLFMlbFDLzMQ7kNvwFVgoUs&_nc_oc=Adr-ACnSNAIaodVLNTTZQItxlhMPRUkTULo8e8dHJCrrwWCHs2ks8KVYTznctlTNGqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyxAhJ5ZPiiZLHpU6UYBvyUHX4wm6WH0aEjheP5fVNuQ&oe=6AF35B1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ClipKit: Video Clip Editor", "platform": "ANDROID_6DOF", "context
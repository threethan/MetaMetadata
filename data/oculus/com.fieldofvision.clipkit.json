you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n{1251830063829236}\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  \n\n{1831748694451630}", "short_description": "ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27045942258370651"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_1495243229182943_5534040102824242326_n.png?
KN-gMeo80j5j7_3vs9uqfQtJT7NDTl34jTyL3gVXY7mvPhGDSRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11Z8r7qyN2TEHjYyExDKYD-SuPsnZlP0I8K6ZCF9fXXA&oe=69F4AC37"}, {"file_name": "1.png", "id": "956374753428769", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618064_956374756762102_5057194945664414780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ipInJrbZiMQ7kNvwH64FB7&_nc_oc=Adoop7QAvSSMTM-neAWCI6za5L--I3Oq_rFhb9f_ATgyY_ohbb762bk2g_Coca_Aako&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29d7laCAnRVu7Mxt5XNUrmjRxOrRIMxJjzbiolstDLOw&oe=69F4A5F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ClipKit", "keywords": ["Video", "editing", "editor", "clips", "creator"], "long_description": "Turn your Meta Quest recordings into videos directly inside VR.\n\nClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips.\n\nNo PC. No file transfers. No complicated setup.\n\n## Features\n- Import videos directly from your Quest media library  \n- Trim clips with simple controls  \n- Arrange multiple clips in sequence  \n- Export videos directly from VR  \n- Built for quick edits and short-form content  \n- Clean, focused workspace  ", "short_description": "ClipKit lets you import clips straight from your Quest library, trim your footage, arrange videos in sequence, and export shareable edits without leaving your headset. Perfect for gameplay captures, mixed reality recordings, and quick social clips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
NvwGW4oqk&_nc_oc=Adp6Fv2T66IKRReaATFfTa52CGz1BMkDCWJKzYTp3BL0uDe2TAv4RWjhcWTMNGmAvDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGhBR54ettU6JOzuEaW2-Fak6aKM52kIzL9-e9mBgSqA&oe=6AEF5990"}, {"file_name": "actors04.png", "id": "2898606493804607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_2898606497137940_2627676820737929033_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByXsslFJU-sQ7kNvwHuxz4U&_nc_oc=Adq7k45G_RuRqiLlJRBJ0cJjeyu4Jme22bY--EWdASSQO_UZzjGJG9bWgi0t-26grjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwAFp573uMgyfDoUGCyOKeDd_97z2GolpV5596tstNAA&oe=6AEF5D34"}, {"file_name": "actors05.png", "id": "830273629724672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_830273636391338_8240110457216038272_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z_S6KuGliIQ7kNvwHje6mA&_nc_oc=AdokZVwq9hbQz73iPv5fQrHEUclq6i4NohPyBlQUhB-YzeMXDd7qsDm_YlkBVQrnBRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEHHAaCdISye6allVIcIDbvPmNVfNm13cWY8hWEuH5mA&oe=6AEF3C8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaQuestStoreTrailerThumb.png", "id": "1508253016965686", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1508253020299019_3237526226114227895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9Mx9fSqJNQQ7kNvwF3UUSE&_nc_oc=AdrFEFOArWKTP9TQ-049wyO8Anj_1r8Z5z5pW-iVWV7U3LguH_KHIjX0PgdBl9g3zZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFr4vRlu2kIKbkOplPhlgQHX8t3b3qDt6LIeh-97ORg&oe=6AEF5CBC"}, "display_name": "Actors", "keywords": ["acting", "story", "films", "movies", "narrative"], "long_description": "Step into the spotlight with Actors, a VR movie actor simulator! Every line, every move, every dramatic gesture is truly yours, captured to reveal your inner acting legend. Experience the thrill of seeing your own performance on the big screen. Gather your friends and create cinematic history together!\n\nActors puts you right into the shoes of a film star. Dive into the daily grind of production and feel the rush that comes when the studio lights finally go up. Master your script, walk the stage with your director, and deliver a performance that hits all the right notes. Lights, camera, action! This is your moment!\n\nWatch the dailies of your performance on the big screen at the end of every session. You can also experience the thrill of acting with your friends in our dedicated Party mode played on a single headset. This is your big moment \u2013 become movie stars together and share your performance with the world!\n\nThe game's story unfolds during the production of the movie based on a comic book. Benedikt inherits a taxi from his grandfather that can drive all the way to Hell and back again. And just like a real actor, your experience isn't just about what happens in front of the camera, but what goes on behind it too.\n", "short_description": "Step into the spotlight with Actors, the ultimate VR movie actor simulator! Every line, every move, every dramatic gesture is truly yours, captured to reveal your inner acting legend. Experience the thrill of seeing your own performance on the big screen. Gather your friends and create cinematic history together! This is your moment!"}]}, "developer_name": "Skeldal Immersive s.r.o.", "developer_privacy_policy_url": "https://www.actorsgame.com/ActorsVRPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Skeldal Immersive s.r.o.", "support_website_url": "https://www.actorsgame.com/", "website_url": "https://www.actorsgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
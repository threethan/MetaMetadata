JMJCdTeT33A93BmiLq8ENw&oe=6A2EC18A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaQuestStoreTrailerThumb.png", "id": "1508253016965686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1508253020299019_3237526226114227895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YasiDOmk4kQ7kNvwFnnIk3&_nc_oc=AdrUTAYmFqZYHUg2smMhotdygeqTdwyf0s1_H4l1RavN4OKJTS5vLoho6kBQWT7e5Hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tq8BAJ7BPDn9dsn42p0trfUjyui_x79UcP0W6ZMOLzQ&oe=6A2EA97C"}, "display_name": "Actors", "keywords": ["acting", "story", "films", "movies", "narrative"], "long_description": "The original VR game, Actors, puts you right into the shoes of a working actor. You dive in by first reading the script. Next, the director explains their creative vision, and you get plenty of time to learn every move, every line. Once you nail it, the real shoot begins. Lights! Camera! Action! Now, the stage is all yours! Embrace the challenge! A single mistake might mean starting the scene again.\n\nYou can watch the dailies of your performance on the big screen at the end of every session. And there\u2019s more! You can also experience the thrill of acting with your friends in our dedicated party mode. This is your big moment: become movie stars together and share your performance with the world on social media!\n\nThe game's story unfolds during the production of the movie based on a comic book. Benedikt inherits a taxi from his grandfather that can drive all the way to Hell and back again. And just like a real actor, your experience isn't just about what happens in front of the camera, but what goes on behind it too.\n", "short_description": "Step into the spotlight with Actors, the ultimate VR movie actor simulator! Every line, every move, every dramatic gesture is truly yours, captured to reveal your inner acting legend. Experience the thrill of seeing your own performance on the big screen. Gather your friends and create cinematic history together! This is your moment!"}]}, "developer_name": "Skeldal Immersive s.r.o.", "developer_privacy_policy_url": "https://www.actorsgame.com/ActorsVRPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Skeldal Immersive s.r.o.", "support_website_url": "https://www.actorsgame.com/", "website_url": "https://www.actorsgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25892099717057572"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1217934346907289"}, {"status": "PUBLISHED", "id": "1195411102532298"}]}, "baseline_offer": {"id": "1195411102532298"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1217934346907289"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27844165438517647", "version": "0.9.5"}, "id": "1979112756265875", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25892099703724240", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27844165438517647"}, "release_status": "RELEASED"}, 
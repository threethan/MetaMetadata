loured accelerating cubes while they are trying to hit you from several directions. Your task is to duck,\nswing, twist or jump to avoid the collision."}]}, "developer_name": "Arworks", "developer_privacy_policy_url": "http://arworks.hu/sensodome-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Arworks", "support_website_url": null, "website_url": "http://www.sensodome.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1743386109375078"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035453_4929887880446756_8373412042233299907_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMIlPurMHbUQ7kNvwHj1Vb9&_nc_oc=AdqV6HQiMh6s-9U3k8sbptWkLnaJBV625PlKVjkhxu9ZcV33gOaTBQZ0Jv4173607k0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3jaFwNJ07dRlMVv9WvWkjrmZ1XZqsUgKedPErcFBaT0w&oe=69F0A163"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SensoDome", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1669903200, "lastRevision": {"nodes": [{"id": "5598083320251220", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
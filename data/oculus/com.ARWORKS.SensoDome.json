}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Senso Dome", "keywords": [], "long_description": "SensoDome - The first game arena of the Metaverse where you can sit down on the grand tribune and enjoy how\nothers are playing but you can enter the game at any time later. As a player, playing as an avatar, you will be faced\nwith coloured accelerating cubes while they are trying to hit you from several directions. Your task is to duck,\nswing, twist or jump to avoid the collision.\n\nSo after enjoying the show, become a player \u2013 to impress others and mirror your personality, design and use your\nReady Player Me avatar.", "short_description": "SensoDome - The first game arena of the Metaverse where you can sit down on the grand tribune and enjoy how\nothers are playing but you can enter the game at any time later. As a player, playing as an avatar, you will be faced\nwith coloured accelerating cubes while they are trying to hit you from several directions. Your task is to duck,\nswing, twist or jump to avoid the collision."}]}, "developer_name": "Arworks", "developer_privacy_policy_url": "http://arworks.hu/sensodome-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Arworks", "support_website_url": null, "website_url": "http://www.sensodome.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "61018365414487
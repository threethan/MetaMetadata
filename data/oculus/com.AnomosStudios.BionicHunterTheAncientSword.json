c Hunter : The Ancient Sword", "keywords": [], "long_description": " It's an open world Sci-Fi first person survival shooter. Unlock New Weapons! Hunt down diverse amazing monsters and kill towering giants! Upgrade your weapons!Use your weapons, your Friendly Compact robots and Drones cleverly! Complete your Missions to unlock New functions that will help you survive longer and conquer the top slots of the worldwide Leaderboards.\n \n - Smooth motion and framerate\n - \u039ffficially Support  90HZ\n - Free Movement\n - Leaderboards to track your ranking among other players worldwide\n - Friendly Compact robots and Drones help you in the Battle\n - Real Bionic Punches\n - Melee weapons\n - Story\n - Missions\n - Dual Weapons\n - Hand Rockets\n - Snap turning and Smooth Turn\n - 14 Sci-Fi Weapons to choose \n - 25 Gigantic Monsters, Parasites and Drones(with Surreal abilities) \n - 4 Planet size Maps! \n - Latest Gen Graphics and FX (4 GEN)\n - Tons of PowerUps to choose \n - Open world Maps\n - Over 10 Hours of GamePlay\n - Support Standing and Seated!\n     \n\n", "short_description": " -Hunt down diverse amazing monsters and kill towering giants!Use your weapons, your Friendly Compact robots and Drones cleverly! Complete your Missions to unlock New functions.Upgrade your weapons! The smartest and most apt will win.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_con
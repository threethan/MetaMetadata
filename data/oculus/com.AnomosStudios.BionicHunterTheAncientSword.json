ontent-ord5-3.oculuscdn.com&oh=00_Aft8Q6jXcRXRCZNdE76u2T52h6zXDUiUSvBDqA018UDuFA&oe=699B0FFF"}, {"file_name": "3.png", "id": "374392570888987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_374392574222320_1731665917033066634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALij3cknXdcQ7kNvwEBFLUK&_nc_oc=AdlcvVweKZejhczy9IqpS3SC9zd2ec75p0SDR-1ttfiEBaqkMBYhlROpwXsZ8ht36rU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTHvBGWJzg4HI4fMhO50XvC2y-RiOqt3t6AJObqXFgPw&oe=699AEC95"}, {"file_name": "5.png", "id": "244536330783556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572936_244536337450222_159718904677724051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xLSSlsl2toQ7kNvwGt8ewy&_nc_oc=Adl8sJF1p_n4ulrJkAmQcBz0WcFOCwcMvv8jrZk3m_F21i9Oc4Vhcx_C2WiwmUshDy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgM9l5phYOTi-9vDA-fSbAClkyRVe3E7LzSQz9DQPH-g&oe=699AE663"}, {"file_name": "fotino.png", "id": "1522708928720636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507817984_1522708932053969_3686655024367238829_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A64g_a0TfjcQ7kNvwEQZUjn&_nc_oc=AdkCSIRsjPrIDsN03QqxPhvtUwLCweJgC831xz8sW1unwtCS3MiSWdvhDGcaQVE7-rY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuW50u6L5aUbmOfG7p4VG3n9O0tjCr0MB4G8SbmUIXlzQ&oe=699AFC78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for quest store.png", "id": "5348558361825643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_5348558368492309_2513676498181331125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtVMC0oTPAsQ7kNvwFlCkht&_nc_oc=AdnEUmXukt4shDdE9mikYrInBIMFDiMBF_yP2I0q0aq0ddcQmfTbChQtsP7Rsfguotc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvlvpMEcwf1MbLmEzVh2qfGYhQon60rOIv81a9l62Qdig&oe=699B139D"}, "display_name": "Bionic Hunter : The Ancient Sword", "keywords": ["shooter", "fps", "action", "survival", "adventure"], "long_description": "It  is an open-world, Sci-Fi, first-person survival shooter with story and missions! Unlock new weapons, hunt diverse monsters, defeat towering giants, and upgrade your arsenal. Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions, survive longer, and climb the worldwide leaderboards.\n\nFeatures:\n\n-Climbing\n\n-Bow & Sword\n\n-Smooth motion and framerate\n\n-Officially supports 90Hz\n\n-Free movement\n\n-Worldwide leaderboards\n\n-Friendly compact robots and drones assist in battle\n\n-Punches & melee weapons\n\n-Story and missions\n\n-Dual weapons & hand rockets\n\n-Snap turning, smooth turn, and teleport\n\n-16 Sci-Fi weapons to choose from\n\n-30 gigantic monsters\n\n-4 planet-sized maps\n\n-Latest-gen graphics (Gen 4)\n\n-Tons of power-ups\n\n-Open-world maps\n\n-Over 10 hours of gameplay\n\n-Supports standing and seated play\n\n-NOTE: You can play offline, but an internet connection is required to submit your score.\n\n-Join our team discord here:  https://discord.gg/bJKPK7UH\n\n", "short_description": "Hunt down amazing monsters and take down towering giants! Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions and upgrade your arsenal. Only the smartest and most skilled will triumph!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVE
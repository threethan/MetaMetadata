J&_nc_oc=Adox-1_WJdFMnK20PGIunE86kQ35p9kOFtFV6AMqpvniv_Dm1V9_N-L4pGlhNmzdCoc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cY13Mdf7XWTUEAXXPbPscooQRc4sGj4-Lnf3eBQ3W4w&oe=6A22DA7F"}, {"file_name": "3.png", "id": "374392570888987", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57566679_374392574222320_1731665917033066634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COGo5r5ue9wQ7kNvwHC2d4o&_nc_oc=Adoos_V6ideM6cKl6ensopvZhnWuo4fkqbnUGRQImwjk2dzRMaUU_orYQhqjtVlXDxE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K4UP4WcZfrVIdZxeO0BYU_MjaotVSullVcaIhfyBNEg&oe=6A22EF55"}, {"file_name": "5.png", "id": "244536330783556", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57572936_244536337450222_159718904677724051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY77qrxhnR4Q7kNvwFiVPQF&_nc_oc=Adq94g0rg38nWSwjwja4kFGF4DLhve9AVmPbKOWCG5tLiUfcAlK-05TxCrr6HFHtAWI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xU9heAwsWDbtKyAyU5whyMKfa8xtD_uOy_lI4jNr1eg&oe=6A22E923"}, {"file_name": "fotino.png", "id": "1522708928720636", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507817984_1522708932053969_3686655024367238829_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYIr59jqWNUQ7kNvwE72LXL&_nc_oc=AdrkeD6AGCPyMg816cT6FEl0smokuVqbe6vdHC38EC70AyDmvVCdRgfixb9d27XG5TE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6mY5SwXl3UuhXJkU1z6tQ5vQJsl-YaR6CtsIwk-EccA&oe=6A22FF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for quest store.png", "id": "5348558361825643", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031421_5348558368492309_2513676498181331125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Duei0bf-VAQ7kNvwG19IT_&_nc_oc=Adp-_PoFCG9PpLnQv-CdwaYnOdqqRLPKmijR15ih-2zJwnz10fvyFFlfNTpIv2Nka-U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JHlwMcIZGAQKZmvLWoJMj_s9tOeN_xV3gRVCDF3RkcQ&oe=6A22DE1D"}, "display_name": "Bionic Hunter : The Ancient Sword", "keywords": ["shooter", "fps", "action", "survival", "adventure"], "long_description": "It  is an open-world, Sci-Fi, first-person survival shooter with story and missions! Unlock new weapons, hunt diverse monsters, defeat towering giants, and upgrade your arsenal. Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions, survive longer, and climb the worldwide leaderboards.\n\nFeatures:\n\n-Climbing\n\n-Bow & Sword\n\n-Smooth motion and framerate\n\n-Officially supports 90Hz\n\n-Free movement\n\n-Worldwide leaderboards\n\n-Friendly compact robots and drones assist in battle\n\n-Punches & melee weapons\n\n-Story and missions\n\n-Dual weapons & hand rockets\n\n-Snap turning, smooth turn, and teleport\n\n-16 Sci-Fi weapons to choose from\n\n-30 gigantic monsters\n\n-4 planet-sized maps\n\n-Latest-gen graphics (Gen 4)\n\n-Tons of power-ups\n\n-Open-world maps\n\n-Over 10 hours of gameplay\n\n-Supports standing and seated play\n\n-NOTE: You can play offline, but an internet connection is required to submit your score.\n\n-Join our team discord here:  https://discord.gg/bJKPK7UH\n\n", "short_description": "Hunt down amazing monsters and take down towering giants! Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions and upgrade your arsenal. Only the smartest and most skilled will triumph!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "374404007583
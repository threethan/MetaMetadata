ontent-ord5-3.oculuscdn.com&oh=00_AftExnYe8aSB_niHmpBqJebGfeRne8s5gM8t8HTzVQeY1w&oe=69A44A7F"}, {"file_name": "3.png", "id": "374392570888987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_374392574222320_1731665917033066634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0fEh7m3A0kQ7kNvwGjNWYb&_nc_oc=AdkQ1tCAo-iKrXwYAw_IquM9cRkebU53WEjUmbb94zLa-W2cGJcWqfmyq5FiahxHObE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs8uJXwUGeEgHZ9k4h_TVsfdHKUeLCV8EQnBksstvNdHQ&oe=69A42715"}, {"file_name": "5.png", "id": "244536330783556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572936_244536337450222_159718904677724051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iho5gyuQvgoQ7kNvwFV9ZiZ&_nc_oc=AdmlLBMuydDwnhH5uPxNCfTsSUvx-1n5hIK81Gcxnx0Z37pkhOXNaEoQnjVwKEx3Kn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvyMyJcl1IVOj0tAb5QNoJW4GtLoY2h5fDp8iFHc-ILAA&oe=69A420E3"}, {"file_name": "fotino.png", "id": "1522708928720636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507817984_1522708932053969_3686655024367238829_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrUqVGCx8m8Q7kNvwG8suGl&_nc_oc=AdlT24ziTlUwmAyYHVB_xQ1FHzyF2JYMyurtbUavmkZwIZjvSfguiptlNR4KNwZf9uY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-ri3oICp51LIWDFqm3dKXw2myG-gYFJ59tDCwSUWrQQ&oe=69A436F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for quest store.png", "id": "5348558361825643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_5348558368492309_2513676498181331125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yqyfHjg7_4Q7kNvwHPDezo&_nc_oc=AdkedmowZszGx8VG6GfXp8_dbkN0RCLcALx5TFpb-OxT9QMXBS7C0HmLPKXzX6TWbck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-AWxKH3xk0F84mvVITRl4G7TeSDOuQP5m1pQWqNnCfQ&oe=69A44E1D"}, "display_name": "Bionic Hunter : The Ancient Sword", "keywords": ["shooter", "fps", "action", "survival", "adventure"], "long_description": "It  is an open-world, Sci-Fi, first-person survival shooter with story and missions! Unlock new weapons, hunt diverse monsters, defeat towering giants, and upgrade your arsenal. Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions, survive longer, and climb the worldwide leaderboards.\n\nFeatures:\n\n-Climbing\n\n-Bow & Sword\n\n-Smooth motion and framerate\n\n-Officially supports 90Hz\n\n-Free movement\n\n-Worldwide leaderboards\n\n-Friendly compact robots and drones assist in battle\n\n-Punches & melee weapons\n\n-Story and missions\n\n-Dual weapons & hand rockets\n\n-Snap turning, smooth turn, and teleport\n\n-16 Sci-Fi weapons to choose from\n\n-30 gigantic monsters\n\n-4 planet-sized maps\n\n-Latest-gen graphics (Gen 4)\n\n-Tons of power-ups\n\n-Open-world maps\n\n-Over 10 hours of gameplay\n\n-Supports standing and seated play\n\n-NOTE: You can play offline, but an internet connection is required to submit your score.\n\n-Join our team discord here:  https://discord.gg/bJKPK7UH\n\n", "short_description": "Hunt down amazing monsters and take down towering giants! Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions and upgrade your arsenal. Only the smartest and most skilled will triumph!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVE
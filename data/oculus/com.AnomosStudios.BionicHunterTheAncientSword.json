ontent-iad6-1.oculuscdn.com&oh=00_Af28ivetqTm97iIFpOzQhHhqOatkwyp_lXSPyOOKUqLGrQ&oe=69F0C17F"}, {"file_name": "3.png", "id": "374392570888987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_374392574222320_1731665917033066634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzHd-YOfvAMQ7kNvwE8y9v1&_nc_oc=AdqzLeH6Cko2l8wozYi42MSXVI1HKW07WvYBXGpqe89Gsnl_mYU1NSEhcxiyhtKFZ4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YvAtIeV0_71t8rlKLF3c128QL1-WOHfEUMWfU6F3cXA&oe=69F09E15"}, {"file_name": "5.png", "id": "244536330783556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572936_244536337450222_159718904677724051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmwBKxqvCr0Q7kNvwGQeoUt&_nc_oc=AdpupkHFhVmHpMEOW1i4EMtbGJUHYgXinondhOTi8V9VDhH7dBYgfK3SW4DUFeL9wX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3XPXSivaKG-qh8rA_-6QqnZSx__Pw-rAE-2tUA6kLstQ&oe=69F0D023"}, {"file_name": "fotino.png", "id": "1522708928720636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507817984_1522708932053969_3686655024367238829_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpTZHnUf3fAQ7kNvwH54rAS&_nc_oc=AdouSTOsyrOEuyGxz6QS9p38a-PAK2odWVL--QmfEfM0yQts6WvgbjiaoHY_61P4Dxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2zEZ1W4YuaHK1tQv1Hn_wfPdsLQ3tuFf72U1PVt4GBrQ&oe=69F0ADF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for quest store.png", "id": "5348558361825643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031421_5348558368492309_2513676498181331125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLR5I9i2XY0Q7kNvwFAVMGL&_nc_oc=AdqXMs9hLpQPKPrdtW2T5sECneQ1WUoNL4WSlebQFwyFfBDBerUiHsZd6qJbzGFaKKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1fk0OXuv2XztwRvrdAiIdZTEf6hBUD-na1J-yLAACyXw&oe=69F0C51D"}, "display_name": "Bionic Hunter : The Ancient Sword", "keywords": ["shooter", "fps", "action", "survival", "adventure"], "long_description": "It  is an open-world, Sci-Fi, first-person survival shooter with story and missions! Unlock new weapons, hunt diverse monsters, defeat towering giants, and upgrade your arsenal. Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions, survive longer, and climb the worldwide leaderboards.\n\nFeatures:\n\n-Climbing\n\n-Bow & Sword\n\n-Smooth motion and framerate\n\n-Officially supports 90Hz\n\n-Free movement\n\n-Worldwide leaderboards\n\n-Friendly compact robots and drones assist in battle\n\n-Punches & melee weapons\n\n-Story and missions\n\n-Dual weapons & hand rockets\n\n-Snap turning, smooth turn, and teleport\n\n-16 Sci-Fi weapons to choose from\n\n-30 gigantic monsters\n\n-4 planet-sized maps\n\n-Latest-gen graphics (Gen 4)\n\n-Tons of power-ups\n\n-Open-world maps\n\n-Over 10 hours of gameplay\n\n-Supports standing and seated play\n\n-NOTE: You can play offline, but an internet connection is required to submit your score.\n\n-Join our team discord here:  https://discord.gg/bJKPK7UH\n\n", "short_description": "Hunt down amazing monsters and take down towering giants! Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions and upgrade your arsenal. Only the smartest and most skilled will triumph!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVE
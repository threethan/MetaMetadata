tcKa3HsRelIjROn5vgBFXIf0mFv1ojxhE_SSDoZK5XMc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxgbWuqfHpYRfjaBp9qqxKI_JVoJd2RWgvlMvBoQO-iQ&oe=69BC057F"}, {"file_name": "3.png", "id": "374392570888987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_374392574222320_1731665917033066634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN3qk6yTVs8Q7kNvwEkywLm&_nc_oc=AdmDcVKrabmGCzrsTTE7qNBq1UHA2UAjyWXedZrIotZosRgHLRwunJOn2iR39YmgrpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaQJh94dSYfJzY00DMkFPjhAFBKz64iQzeo7U4r0qamQ&oe=69BBE215"}, {"file_name": "5.png", "id": "244536330783556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572936_244536337450222_159718904677724051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iglaZOEoMpwQ7kNvwGed_J0&_nc_oc=AdkXyqxHoLxy3sgH8wBBxA3hn3Piz5AUtJ3w7Er2d-GYZIAORUN73MX9wOuJEmfL9Fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMwSGqaH7EVUFMRpaKw6AYmAEwHn8mjnMfPa-NnVtNow&oe=69BBDBE3"}, {"file_name": "fotino.png", "id": "1522708928720636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507817984_1522708932053969_3686655024367238829_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXaCynmvzMAQ7kNvwGmbora&_nc_oc=Adk9-g5U9-3R3TeDdEDKW8nuUnzKtdKst_9MsZMG7GNBnymedbGkSAcQSKO4ItwxSOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxl8Z6wBMoTWIdMNxkhvaRsC5nSDPFS0dr9tqidKYoplQ&oe=69BBF1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for quest store.png", "id": "5348558361825643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031421_5348558368492309_2513676498181331125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j2eX88mKSQQ7kNvwG-f9yc&_nc_oc=AdnMDthHSzHu_NhPTySpd1R01fV6MHDRbUhj42UUs8w60Hy3W_m6-FB0-SnXPN1mCq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy70vmWWqPOxCpo0xjYgGJopL0rDzf8BNU_1RH920veQg&oe=69BC091D"}, "display_name": "Bionic Hunter : The Ancient Sword", "keywords": ["shooter", "fps", "action", "survival", "adventure"], "long_description": "It  is an open-world, Sci-Fi, first-person survival shooter with story and missions! Unlock new weapons, hunt diverse monsters, defeat towering giants, and upgrade your arsenal. Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions, survive longer, and climb the worldwide leaderboards.\n\nFeatures:\n\n-Climbing\n\n-Bow & Sword\n\n-Smooth motion and framerate\n\n-Officially supports 90Hz\n\n-Free movement\n\n-Worldwide leaderboards\n\n-Friendly compact robots and drones assist in battle\n\n-Punches & melee weapons\n\n-Story and missions\n\n-Dual weapons & hand rockets\n\n-Snap turning, smooth turn, and teleport\n\n-16 Sci-Fi weapons to choose from\n\n-30 gigantic monsters\n\n-4 planet-sized maps\n\n-Latest-gen graphics (Gen 4)\n\n-Tons of power-ups\n\n-Open-world maps\n\n-Over 10 hours of gameplay\n\n-Supports standing and seated play\n\n-NOTE: You can play offline, but an internet connection is required to submit your score.\n\n-Join our team discord here:  https://discord.gg/bJKPK7UH\n\n", "short_description": "Hunt down amazing monsters and take down towering giants! Use your weapons, friendly compact robots, and drones strategically. Complete missions to unlock new functions and upgrade your arsenal. Only the smartest and most skilled will triumph!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anomos-studios.com/terms-of-service-copy", "developer_terms_of_service_url": "https://www.anomos-studios.com/about", "publisher_name": "ANOMOS STUDIOS", "support_website_url": "https://www.anomos-studios.com/", "website_url": "https://www.anomos-studios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "27562921020
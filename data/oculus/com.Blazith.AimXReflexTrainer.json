dYxSWXGA&oe=6AD39553"}, {"file_name": "screenshot (4).png", "id": "674748575653955", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822817_674748578987288_8246810139867487580_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aEanUxXtR4Q7kNvwF9nVLd&_nc_oc=AdrvOnNmvywdUng_msMaU1NtIcGKJjayr82l_wIbGXxxajn4BTGsIcULtJv5N1VtI_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXrKaa1N3lSLSla3D8x34EAHo_AQJZds3MeIzyq9bguw&oe=6AD3A54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "789398296792787", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499304162_789398300126120_4180304088370728946_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnqXQDJE6ZkQ7kNvwH-tNS7&_nc_oc=AdoWh_T4ncgMra2IIqPdN8h7NVM8DjLx1JTLga3EnEsmO4TfbNfZYCkC7vUaowe3soQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm998VTfBwAmcNzw7-6hVvbDb1HvUpE-985255QqkEbA&oe=6AD39D14"}, "display_name": "Aim Reflex", "keywords": ["Aim", "Reflex", "Shooting"], "long_description": "\nAim Reflex is a VR aim training experience built for players who want to sharpen their reflexes and aiming precision across all virtual reality shooters. Step into a fast-paced environment where every millisecond matters. Equip a variety of weapons and test your skills against two distinct target types: humanoid training robots and reactive spheres. Each target is designed to challenge different aspects of your aim, from steady tracking to quick flick shots.\n\nOne of the core features of Aim Reflex is its performance tracking system. How quickly can you take down 100 enemies? Your best times are recorded so you can monitor progress, set new personal records, and push yourself to higher levels of accuracy and speed. This creates a training loop that rewards consistency and motivates constant improvement.\n\nThe foundation of the game includes multiple weapons and targets, with future updates introducing even more variety: additional target types, new environments, and alternative training modes. This ensures that your practice never feels repetitive and always adapts to your growth.\n\nWhether you\u2019re preparing for competitive VR shooters, seeking to dominate multiplayer arenas, or simply want to build lightning-fast reactions, Aim Reflex gives you the tools to stay ahead of the curve. Train hard, aim faster, and turn practice into performance.", "short_description": "Aim Reflex is a VR training game designed to sharpen your aiming reflexes. Use different weapons to shoot down robot and sphere targets, and track how fast you can eliminate 100 enemies. The built-in stat system records your performance, helping you improve reaction time and precision. Challenge yourself to beat your own scores, train smarter, and stay one step ahead of others in any VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "Blazith", "support_website_url": null, "website_url": "http://blazith.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "hi", "fr", "ar", "pt", "ru", "bn", "ur", "de", "ja", "it", "tr", "ko", "nl", "el", "id", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31094214486893822"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2033917034186
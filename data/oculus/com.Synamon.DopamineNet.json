ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-ohv-7--Md3qLVYQ3hojH44MrLHlBoHjkJpmz0zilCQ&oe=6A6DE024"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-T6_jtVFUEQ7kNvwGGfuYS&_nc_oc=AdqdngUegDCbeuSzbG9LASJ6inACOFBCFymlhwsKRV8PHmOHcRqh77J1KNySSYgCzxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWt0-NxZRy6SRKbINXsPMThkh3bJjaqys2qg5k-DQDYg&oe=6A6DE57F"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiuvGD2-lM8Q7kNvwHCFssY&_nc_oc=Adq1zm-NoF1D-FWd90cO77LDT5MevriVM9aAm0tJYgr3h1fkAW5K1wQlrVo9-XWs94E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCbGepBjlY3pzmndlr12TC18DL2nJwlIL8Tw5E2Z2D_w&oe=6A6DE0FA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vhsNs6tDsEQ7kNvwH7JQ5P&_nc_oc=Adr6yGQigYJQvmjZxdrjPvQ1xLIKZlrgVZxd1CIPKTo_WQINDmNDANrCRVpMCxHRuRk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCluYd-naRlVw6wpZGaFTnF7wRRVc-wkoubh4VbDUU7nA&oe=6A6DDFEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
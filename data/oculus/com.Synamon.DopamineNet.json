ent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsSkSpXOr4OzZMtlBMWkLgg3dhIzjlYPR5sxU-jXugRg&oe=6AD24A64"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2EVFoJ8ByoQ7kNvwFUsdoR&_nc_oc=AdraIIbkZsNY-YU2PQmmsBIeaEajEBl4YZRd6zcZTvOD6j9PUfHOGPAl68_R-aZpi5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOov90-a_Bfh_57ZHjVIXen3pUpnVQ6mqCmHjfR1w2PbQ&oe=6AD24FBF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VDCVPUM-ikQ7kNvwHpWW2-&_nc_oc=Adrign2c3a8OlHX72FZ1jNUATVYzqou-mjqmLqOIuDcsvMjc1FjAgxq0yd5VF4a37MI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSrjkPxh6hYPDNFXVCBsfhXV24bj7GxyOEYZL_XlzI-g&oe=6AD24B3A"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WkAcOpnOtgQ7kNvwFzr4DF&_nc_oc=Adph26NvJFAkq2zr41vywwU4NtcjUHRi_Ekm5wOdjM2bgBoXDv_CLsz6aBO5tqiRXEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzrpOom36NxFAR-tBSIGI6JaoiPlJ1nUm6cHezSQdoPA&oe=6AD24A2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
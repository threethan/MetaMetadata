ent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q2-cFq8nwq8klllDB5HvhTBDpWPcL7IUYXQyA75xgVA&oe=69DE2CA4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZkxT5Rul8Q7kNvwHCuX1k&_nc_oc=Adp9igPksfnw_anz1Nq3om6tyXcpG9PUnplDYjknYs6edc1mko6Afc24Ab7qEJ3g4R0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fe9R-XfkNPQoJOIVfaEXWnAfLwVzedTB5-WTkRr09iA&oe=69DE31FF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3oC6o9I5ggQ7kNvwEyWS8v&_nc_oc=AdpyE9I6zdXS3PMopA76UCaDF_ewCVBl2S0mUcJQcwZHZ1qtHo55Zv7cz6Fq1SoF3Mo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SXLYzaOdYzTTh5mMmcmsEWWw_zq_7CP5tLKT-xwAgig&oe=69DE2D7A"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qYe7gVHSJwQ7kNvwGUnLua&_nc_oc=AdoH2Qo9mlIvENvaBPPyJEIlgv9BXLtniGc166vz2DDfMZN1tTZ4O4i7D4A5ta0Ky3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21nc7V5QtkKWF0BGzaFOaXj6h4QhVhPaeOYFRpUJZ8pw&oe=69DE2C6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
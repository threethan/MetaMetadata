ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk3YBEhH0KG7HkuzOv1AX61pbGzyEWxascB3x2E0WxyQ&oe=6A5CBCA4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_w1s2Cpy9kQ7kNvwHBtAl-&_nc_oc=Adr4eUsBChNk1LwwwcGJNrYPY4T1tNgTVxfbxUsY92LLbi7l2vswZ-6Dfu2SjpsTDt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDLv-zBbWEQ7ctDEfvDA-wv0QM7UeVeboPsqd0-ImzHg&oe=6A5CC1FF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB-4MXnUdHUQ7kNvwEioloJ&_nc_oc=Adq9zLkFdt3Jbc4HxzZWMXR9kxFpSbk3kw5qKPYniDnTbHniiR2-SQdk40b09hCzRMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJzgu38cAKOiFYDAJTrrY4hcs6F8eW6owvPpM1vdtDIg&oe=6A5CBD7A"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NaKaqLRrgIQ7kNvwHgNbpa&_nc_oc=AdppiFOMLkOLjdz3RMs1KJUkS8DGjAjrteueMTF20TwKb-gHT7Zsuhlr1WNeA2cgU94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCeAd66yLQCIFB6L9SY6wdFu1OxomczICRfdvsx_Pa4w&oe=6A5CBC6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
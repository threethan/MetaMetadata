ent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zxt3rGNa-pfidBtxNOiI4WYsYKFTeNR4BKDTMASqOEw&oe=6A2D7EE4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMMF8Zn1M3QQ7kNvwEwtGyt&_nc_oc=Ado8cYXNWm8grWBwjak5gnHDgCCWvngSTLN0W696I_2Bhc8sSHE3PmuAvwuPpkCn57w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vko3KNq5PiP1DF80_RwasEaUa2AkCW9slasZfiKCZ6w&oe=6A2D4BFF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjr74kYZzxgQ7kNvwFQe48Q&_nc_oc=AdrWVLXuHU60delWqJF-vk-NARZZC1Q-oVM5qhuIHPVufoe5HxNQafDiX5ZELcQ-rhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KVgaFSwx2QfjleAD40AVZMCi7gR9W8yn5faWpPd5jgg&oe=6A2D7FBA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pa01mjfulQQ7kNvwFJIjnA&_nc_oc=Adqt5hfugUgmZ_2p93N3QAjAqtMYEksl4-tGFvdjecEr5QHH4gok1EechQCIINi7zHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_433lYmvIUAABqM2RP8GcVWnXtDdcV72VaRPWhlEC7rA&oe=6A2D7EAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
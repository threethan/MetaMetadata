ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af809k3D9ov7oX3j4QjlKVUtg414sxJocloHX33cR9cL8w&oe=6A4296E4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um4UOcsxuX8Q7kNvwG-EK7M&_nc_oc=AdobU-fACBSnsLfUUc1FD6C965HXmDM7cMKmiXo96go9VcDKLHMKG7PF91sCT4NaW3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kQ3wIqKaEZXj4Oz-t8EmrH_9q8ttAcJGEdBHIWrfeCw&oe=6A4263FF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GImtwR5gjAgQ7kNvwFEpJGu&_nc_oc=AdpdZ9Xe4htvhGyL5R5vlVzE6nMVea04aw9Sk2tv3XlWUDFywrbncuDXo7nI3x5MNDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iOCMdvUVhdmaS4o2zzv5ORmtnidPp_G1a6WGBQrmZvg&oe=6A4297BA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6Tr8u72FbMQ7kNvwFcvRKe&_nc_oc=AdqnXLWPZQ7S1j91SV5_AI-xOJ4djFBXj4kAx1qRGHOo38oUI44hwKrn65pC-FZEDSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ih5BPMaudWVp8Z-_4NThHB3eKftF59tN5shOKcWRlHA&oe=6A4296AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
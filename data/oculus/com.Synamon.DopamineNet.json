ent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCNI1nEhkwjLf0JeY1LkODUhDh3VY55PWE6eOnWArRhQ&oe=6AD39BE4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0IZn6j14gIQ7kNvwFea7fA&_nc_oc=AdqSXbbbF-H4jE-jlxGqiCgzUduXacRsTHS0pNWIehvRU016l6nEB5jCVAiBt3wkbMM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMymrslaytY6eGRNgBM3HX-l8_-QpVJOOd0Ghci05L_2w&oe=6AD3A13F"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VDCVPUM-ikQ7kNvwGJcZ4j&_nc_oc=Adof1ZZ59kVUbKhRMfzBJbdbPJldLozRA_sXNAut_vwoHXsuCjqzNG8Ed8BFtcKEV8c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPekDQOxnFOrlHZT0bkQAsl72hFHr9476KMWDz1EHFhSQ&oe=6AD39CBA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYfTy_EX2EUQ7kNvwEPgsx7&_nc_oc=AdpYd_eCt6TmNnbF90-L5Lml5JB-YopNLOgFXozIEPOrmL6hrmSAIQNm3PEnbWkEd1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8T1HocZUCM6FDOOo4KXpNEENQnnlEQA7ClV-o-_5GMg&oe=6AD39BAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
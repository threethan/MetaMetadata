ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5rREoMr1WcSdLlWmBkEgexPq8NzIy9oOo_GZ7nn5krw&oe=6AB69AE4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue91znntEPAQ7kNvwE7PnUl&_nc_oc=Adqq5-A4CkxJP_szEPa1bgiv4aydLB9SCeBZGEVX9-S4mFHUBSaAC2z7x-f-0parbeg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkJo0yJPOWkT8H7_HWWyR8zyDQFNwbCF5RKXEXb9R3yA&oe=6AB667FF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOZPjI62DUYQ7kNvwEqNuFB&_nc_oc=Adr3FERoQCc4VdcMG-20Vd6bqQHlxBqshODzMTZfcuWKRd-zWPDpIz19HZfGiHihVCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxGbUyYDff7r6r0gHQ1Stswa7b9HpjakfeMFIaSMfW4Q&oe=6AB69BBA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQschoiN1eYQ7kNvwFzhST7&_nc_oc=AdoCHz-gk0-tQxk_Cqu6KrCMqByDjmbYbAh-R9N8WkFz14B63EQNboS_CJsvhtDH6G8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLimFsJdaj80YaN-EEtnRdT2uZXn9zxgivAr0AGcnjhGg&oe=6AB69AAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
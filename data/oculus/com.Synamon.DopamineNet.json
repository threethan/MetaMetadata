ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk-QBN-zPOXtU4_a6mdcm57pSHfSVvqr92T4VjzSK1WA&oe=6ABBE0E4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVUNcDw570MQ7kNvwHsJb8d&_nc_oc=Adoo-_p3SXskd0u7IMOubH8LQXn4GkwZjRKoSiozcVvMm8MZFXm7FDtTruTs4RzNTlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8P22eWyzErtCmubaEX8xP3IKRKY2jyWf08Z8l6ojEDA&oe=6ABBADFF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMnN_hyBaxcQ7kNvwGuBFQg&_nc_oc=AdoG046z357a8cGLag9CY8MMBG0j_IQgixlhxzbHUfR5upkgHBrlDb6_DOCxuL3nlDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Ix04hFEOIJdE7cDS8VEVVKcmNVPp4PvBg9yNDdA9wA&oe=6ABBE1BA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBOQ0aOVT10Q7kNvwGPGX_m&_nc_oc=AdpZUcuDJyfadvNZvE1eo8xOSpJ0wX75VgLvqpZDysk4mtt9Aj1BhLSi3y4s79pox84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcAI8u3A_7N0O0TEj3Pf7OCORizSgEM8E6RGjpW1OBKA&oe=6ABBE0AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
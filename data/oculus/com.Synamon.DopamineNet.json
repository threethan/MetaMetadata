ent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN_pTXQcB5jhigCFMetHH4bXkeIjT0S-y5O_00m7RjBg&oe=69CFAC24"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIC1_zEpq3sQ7kNvwFsZgGC&_nc_oc=Adp1EEJOF6GVa7e5Xb6FJ9TIakr1bIETguCmLteO2CCbAu0M_pdF8RX8gPa6JdrDJcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqmJQWtRNSaBXYdIKp9mrNN_FbjDoq8H9PlRhGwIlj4w&oe=69CFB17F"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59a8J5iLHRkQ7kNvwGtJYAM&_nc_oc=AdriteKZC5gJYp13MdJW0UBK2fswRlpq5YSSoGXid9kbAUruAEIdd3riHLaDizsdVfA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMRG39a6YgPAq4XPqrlXLs5pB8Hj2fCdfYCcXJd068DA&oe=69CFACFA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdRGKoLMiq8Q7kNvwHK_12U&_nc_oc=Adp_drQQQM8ozonKgk2cseA0stquOdjps-QfdqdgPmhp3avLk8sa3lPUUGN6lw6kkkg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1NRSZ3adQg7JuwOkRgOGZX9b0eLSxU6Ifma0-ekf91w&oe=69CFABEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
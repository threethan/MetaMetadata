ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U1nMkYMTtw-dZ_jGf3J9roUf5zb8QKceBzF1BJJ9VoQ&oe=6A15C3E4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kko1gQ8io_QQ7kNvwHg3MRP&_nc_oc=Adrn330K3RLJsiqn6vqlrS_ceLwJG9Fv-wVqRbs_3899vHyWPeIn51RfQ2NeUDhynyY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jaiRxGTjVw_kECx_BXgqmtTAAGOl_ojlLcaTtHqL2ew&oe=6A1590FF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eajeytPKou8Q7kNvwExyntS&_nc_oc=Adpmc9ddaLE6JDMvDazzpGoB4_n2eGkTJlZNwLIVGgH7Mg1SirIUJTEb4fvp6NDURus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zceSMj6xfHnIWSVsb4dHexCvj08J3v_1RgTX06hlaIw&oe=6A15C4BA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9ZvDhQkzF8Q7kNvwGn1PaL&_nc_oc=AdqRZ-XGMhLN_6QVqCXZxAJr-xP52_qWd8iGRmWmTUoM_larE7a3iPwwuj1fr0u1_8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qRmTJwK2A87zPR6Uou6jNZfSqbGS0VR-wjo8TXAauFw&oe=6A15C3AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
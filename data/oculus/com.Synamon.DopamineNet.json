ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFmE8RmFmxEMsIZ47TtUi8zehrLmmoIUakfP6gaviL5A&oe=6A7477A4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOlFG5uxMnIQ7kNvwEW7BQy&_nc_oc=AdobPTZZGkSgQc1K0KAME0TdML07B7Rb716z1dmiUwF97v2LWxXsEgF99dXiFl6TdAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXxhMbg55itAtKKdrUfmern-ki13Tgnoth2Re-GkpFWg&oe=6A747CFF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wvKZehCCTMQ7kNvwGXRhn7&_nc_oc=AdrRuEig-EGcM-6IdM62sWDsEkJM_Tw77Fcwt8VruM30rBGvtCSS1nuqJLq2x2TGSo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2u6A6K5_o1Tr3CEieMZ2lr-N-6168a_MVhHFJFxJ0sg&oe=6A74787A"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi7Ir4XmMBIQ7kNvwE2X7bz&_nc_oc=AdrZWiDZ3evebz8iyy5rE-laN7LyGezDKDFGLc5SOCL7j6BiBRaw_Bg9iP3_eizOAI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGr44XIIrbyrOg7mEBtXom2sGef2p942y29FTn3-vR3A&oe=6A74776B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
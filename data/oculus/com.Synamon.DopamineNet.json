ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHAsm8njc62nLy6gZnhkjCdhRVzf9xg96lTs7g4QlTew&oe=6A92CA24"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Xn-qR6Vv4Q7kNvwEhP0ps&_nc_oc=Adr_-rqpynaQIaMDa_WQwyfXPfpaSrgZxTvZzXWs_zo2TUhrKQB8LFlaqXolbUwosQ4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUefGacfdxaQxDGAOLR8vvw4SEzcFLrJ-WAqV2lcjyQw&oe=6A92CF7F"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIZwLn64IfMQ7kNvwFf8FV4&_nc_oc=AdpH20cxtvNztQgoKV2svPIs0V_5UVePZtxLQ-P_nMyUBjh8A2EV9jD18SqIq31SYmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtD7e86H9iZIc7Vrd3kynfvostOicC2vlM2iYQ0Q8p5g&oe=6A92CAFA"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCy18k0x9wQQ7kNvwFk5_AZ&_nc_oc=AdrZ4MgpxuVbhEko_c5sOvzmdYFu8ftfRblmWvGRtS1OXHSXE7LYuHDY8hWGbtuwNJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRcvVLPE0W6MYbgTMcXz-RLgWY71itaTCxOOm8hytELw&oe=6A92C9EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
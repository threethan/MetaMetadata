ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-CzCwBkbmeum_34w6rYoRV98M5JZQIBU_ot2gb5tlog&oe=6A8449A4"}, {"file_name": "migrated_image.png", "id": "219310672646367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_1744218059159752_955036331_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cEH-TEE8I4Q7kNvwEkp5hv&_nc_oc=Adoh8a3y1xp8-XeRLV0pPkr8h2CtY_z_Z6mQIiMfR98vmKJ09pj3U4HQHU9QmwSVhlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBB5tkASre9ekYUgOsP4vscuCwZiAK97-IPLIjwS_mig&oe=6A844EFF"}, {"file_name": "migrated_image.png", "id": "195342455231157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602240_906893926123061_250512793_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-ZYX2XHLN0Q7kNvwFZQMW7&_nc_oc=Adp__oSzSNoTCJOorlo4MRA0cE0lKf5PgMWwdRWHl3s8ejxQN8feckORGupBRkB7h30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFr9IP8UKo-j_siFix9vZIAVEHdw4mS1m-c7mSk3RrAg&oe=6A844A7A"}, {"file_name": "migrated_image.png", "id": "260279541634855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727794_328832057456154_1909041952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1a8eZwwH5EQ7kNvwHvkiw1&_nc_oc=Adrflijpv3LvTs18xLlUOXI-Y8iaXQp6H7tVBna8NiATvz9xQeZ1ygi2_uYGzZkIf58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJAByO_SM1aZHjctRBZjVqj16uAhumIRIGs8nCX5pTg&oe=6A84496B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOPAMINE", "keywords": ["shooting", "action", "dopamin", "Unity", "VR"], "long_description": "DOPAMINE is a competitive high-speed action shooter in VR. \nFly and boost-dash through space, fire your beams and homing lasers, and go head-to-head against your opponents!\n\nTwo game modes are available: Single Play for just you, and an Online Play mode to compete against other players.\n\nSet your username and character from the settings, and learn the basics by playing the tutorial mode. You can use Key Config to rearrange
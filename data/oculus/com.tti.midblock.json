35301769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036651_411575138635102_4605633332952792327_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP0glQl86rkQ7kNvwFJ_noB&_nc_oc=AdqbAiC5V58xBPFWbQkpQA8j9_hwBPbNAtD4Kdd9A7sx1eel-e7qXsjhNgL3UZDkUG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0q8R8NW7AWAXxFoN1LevFLe4RFjuqTZSA3WErUgMbXJQ&oe=69F1E8E7"}, {"file_name": "screen_capture5.png", "id": "869841044858829", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974819_869841048192162_7642190481697555475_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yOsohGvHnwQ7kNvwFFdoxw&_nc_oc=Adok-2qh-OF_ehHmCJTRQ009AvZw5CeA4jhAG--HakZ8rMAYewg-jBvw3Dn1sm0DdLo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1_ODidAz5HncDJfTczJ29687NuWCN5IU1shzFSwcxfvA&oe=69F1F23E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Midblock Crossing VR", "keywords": ["Safety", "Street", "traffic", "hobbit", "harley"], "long_description": "A pedestrian is more likely to be involved in a crash on city/local streets with posted speed limits under 40 mph and in locations without a traffic control device.  This VR visualizes the street conditions in the local community and midblock crossing scenarios on the street. The scenarios in the VR take place in the \"Basketball court in the community,\" and a user is playing with a basketball on the community court. The ball hits the user's left foot and rolls away to the opposite street curb. The user is trying to cross the street to pick up the ball. However, the user's view of looking for an oncoming car is obstructed by a parked car.  This VR educates people on how to find a safe spot to look for an oncoming vehicle under the obstructed view by a parked vehicle and how to communicate with the driver of the oncoming vehicle before crossing. This VR experience provides an efficient and effective method of learning and practicing safe pedestrian behaviors in the virtual street.", "short_description": "This VR experience provides safety tips and how to communicate with a driver while crossing a mid-block location."}]}, "developer_name": "Texas A&M Transportation Institute", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/de02bbda-b618-4036-8f7d-855cae32502f", "developer_terms_of_service_url": null, "publisher_name": "Texas A&M Transportation Institute", "support_website_url": null, "website_url": "https://tti.tamu.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8550976301625569"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4068310110063185"}]}, "baseline_offer": {"id": "4068310110063185"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730332380, "status": "PUBLISHED", "id": "4068310110063185"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8754113897978474", "version": "0.13"}, "id": "517528037589538", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8427362227320311", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8754113897978474"}, "release_status": "RELEASED"}, "binary_release_cha
SOoAlm16eNrf7A&oe=6A5246DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sv_D7tJ1aEQ7kNvwErivwd&_nc_oc=Adqvl75uX3gmDzCaECeVMacLZtCr8Y4EK8WMxhcCMbOaKA9V2vl8Slm3wQKc_9P9RtU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM50rxg6Rb5aSb4hk_Hmo_6fGg3Kee_YYYVnWsQx0bkA&oe=6A5263EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rP0ZJ5w7CS4Q7kNvwFwho7r&_nc_oc=Ado5BQdR1_W_HbrMkFX2XpAcUJAUrd6dtKbqqWVeNeT9rJ8PpMCNTVrsupSaWZWGozA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_OYqG6F5c0GIH0xHsFvWEqaVFNykD5KGlE8ZULA0gJw&oe=6A524DE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-un
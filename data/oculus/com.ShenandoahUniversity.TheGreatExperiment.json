ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgXtsw24vA0Q7kNvwERzFWI&_nc_oc=AdqpGkbFd-Qe5NhY4z4L3ZFOBT9GXrWETUOqnG5CIQNKkfqACUUeG2UXtJfUwkaPD24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW8RFo3Vg8kMtrovGx6CFZSbV8ei0UuRZK78B1wIcLtg&oe=6A7082E3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lNj0zq_Z_AQ7kNvwHkeZVA&_nc_oc=Ado7tIO4iPVCBixe2_MlGZOvavheSNjXavLdfusogAmVgxhHFCcaEHbMZncQ-nddg8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl6IRe3mtM2LFGoNsVtl7qIKjqBHmoI_TtCrIh80YSZA&oe=6A70784C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pEQwPQzCCoQ7kNvwFC6A2m&_nc_oc=Adqb5gxxSBAgkjWkrSiPIhDKSCGNHzyHLMaJyncuxMjbmnIPnMp3IUZmmYfuStaWm68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-RarNs1qrJAXBwHujKN3SynCjT4IXtAcOjcBvyhhLVw&oe=6A70995C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4PfHMjq9ZEQ7kNvwGqTOLw&_nc_oc=AdoCBVaLDKXpP3NeL-8z_svLyyON7uS9gFoUY-dupq6KtWyoyHctZbmDUxVnATAiTiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK5847WIDN5ueik5NXvVxH0CU4JMztOXV8hSEXl6IoyA&oe=6A707E2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOyAAzJOjUsQ7kNvwHVwL4A&_nc_oc=AdoQ3_4I3QPoxTBt7zh2bnJeg4zcI2-I4kHG8hRLo0jYOS3zLG1mSMc18OD9GSIicqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjeh67-vU9j8Hc0wnRHgqmiVdwJ7ypacyuxnNutynMwA&oe=6A70A069"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
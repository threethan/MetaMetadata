ontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EKLkz1TMZoQ7kNvwFreyET&_nc_oc=AdrYhJm7x3hlgPcfJpvZbjAT0SbawCmdIRCAdgF6PuitfaTCpdwc3EDK5dfWVXwCxPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL1ljKsqhMXZR8SKxEgp6rltOkjsjgGQ8xZ8_VAQcrHQ&oe=6ABE83A3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n699YDF7GhUQ7kNvwFCBlx4&_nc_oc=AdpH5fiA-uUE_rf11mQT6xHhS95XMMzyIpCKLjJiTGvl6kKQyU8CwCLTpruG78uMoN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlpg62QGk01rBYuFjLINxK94GDaOicrtA8PoHiMzi5KA&oe=6ABE790C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG6wuawrPiIQ7kNvwHNRd2x&_nc_oc=AdrErV-bSVB1x79V0n21p7je4bezXCvdTKdFGDlxp99_krHG8ShHSBFYBz36E-NKzls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu9Bt0f0nf6CGmLFmGWER1Nu3OBS-2w3vhuWVgV7qe6A&oe=6ABE61DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOQIknVLWHMQ7kNvwFkBfbD&_nc_oc=Adpwis7shCMxaCgIsnDnBRtGrDNUVO6pNPbCSCPik1uI1mmUf7j-NDQ3OH4UrUagc9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMaHhMwRBt8KWlo7r7QeQjNeJJx5Ph2o0nqgNleMXwKA&oe=6ABE7EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqQtWhPLa6IQ7kNvwFCphD2&_nc_oc=Ado1Q5qphB05PTqZTg4OpUMkTV74lmfTB6X70KKs0sfAmHTiJYxbJhYZQwaDrTiRjuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwCZqK30HcwY2kwgL0S4c7Eq5dp9l3DL_vsQ5ktegttA&oe=6ABE68E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guvRIa3Pwu0Q7kNvwEeTSGv&_nc_oc=AdrOVnW3XoKqRS4hXvkPDXSaBbg4XEXFG5FPJxWorKeCZEF3E2Creujl5D2T6euTmOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6p_YFS2wen_KT0R3fwTbWo9k30BHzygK_Db1iD6bojQ&oe=6A7C6063"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F01igladqq8Q7kNvwFOplsA&_nc_oc=AdpfI-WrifQi73RymJrwOB7RhZHN27Ka8tnBhZhQ4UGXQngbxMsxHVcou5kHkuKcloI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx-eAZCIxlGTNtogjPoj7mz4oWMN4efn5VedZgjIkClA&oe=6A7C55CC"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbidpOChmJUQ7kNvwGL8tgc&_nc_oc=AdqEhTHgxQqSjiM2yv4LLLUeS6_A6Ey7iJp9X9pxBctasc2lpw47aa4JxOA2BrJ33Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRPGHLk7bUAfFgB_oN4zwC9MjCcWIpEM7gRsr098crGQ&oe=6A7C76DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayzmhdDP1i4Q7kNvwEyiXbu&_nc_oc=AdrNmNkgvwYL4NnBii5Li5V6gW7HNUpFCDOAuOzyMuErxdMsVPL3QujxX59p9zLeDYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECFL17ikACj4Qe0mFiMB65cMET0zpFOGa21-a9KhZ1hQ&oe=6A7C5BAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NisBM74oYWEQ7kNvwF1O7if&_nc_oc=AdqJ_yTG5xY4y5hLG3aHxG--3quDoGBvLohjoavrEmfS6gLI60GsZZl6xaBSxutXPgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3XTeBk68zWTgSbrnVBG2CZUBu6LmaFReiSIxUMLTHpQ&oe=6A7C7DE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
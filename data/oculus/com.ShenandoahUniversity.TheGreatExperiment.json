ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI-CmweDgp0Q7kNvwFTdxG5&_nc_oc=AdpdazDkFGKbEL_6c3XaNpLTFY8Rc0FDL4TWHBO3oR-8Hy78I8WkTbgwejnv4Ts10FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4bd0_s4wvxzf43mq2EX1EaLLlfR4Qnzf98Q1r8HxhgQ&oe=6ABBE0A3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCPirGDWv8gQ7kNvwHQDbce&_nc_oc=AdpOIJo-yppxkq25Fgpg61r5I4h99gewtI73WLCq6rWOcXqWp-WlKCTPt8nb_MhxzRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtuEVCY9MrKXxJYm-5zPN2pcJSwpn64bTkUiWepe6Mig&oe=6ABBD60C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ld5DBkmGoQQ7kNvwF4sU4L&_nc_oc=AdomGPUKPRi8_ulV7uxFrj46Qz4PHPxIi4pi4oe6kP8XO_TuUrPIxIZ1S8qEgfpWNJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ_LmUnwev5-fEd0QQN8gRDixH4VR4e_2AKQ051O4PpQ&oe=6ABBBEDC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOQIknVLWHMQ7kNvwEqiwPF&_nc_oc=AdolgqhCCoUtl5itrtwam-mJq1gWx_ism7KiNuzMAYoEvIGpW6yLkWhy_dEKBWVQHp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwr4hXr7WEl1Cp2vpVNs8Uhjpiwqr_rtph5gei8m-mIg&oe=6ABBDBEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqQtWhPLa6IQ7kNvwE9Wre9&_nc_oc=Adpa27xWKl45dLCFvQZcR6W5EkY0vzndnvsE1pxnfgdPQJMG4dVl2x3gla9J_NFFKog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWqUBmvx3Z4chxLr4zAts6Hz7ViQiHW1fHf-teGO7WrA&oe=6ABBC5E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
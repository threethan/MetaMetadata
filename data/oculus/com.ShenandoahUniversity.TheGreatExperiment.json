ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDkMTjvJ9WoQ7kNvwED2ClZ&_nc_oc=Ado8Okr_CAHcWWcIuH1C61SHXLTQmX_VrB81gJ8sf05KNGyeR_GvAV8hGsQ7-g6DJzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrqdluCWQWwgQ1WuMPQcvpKWy-KviyHFLIrBdgBcYv7w&oe=6AAABD23"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3epBw52HAEQ7kNvwGA-xgZ&_nc_oc=AdqOXK8LQIdYz_HshPoSCRoMkfaQI92wdoGKmA2R8ZAIb_pzagLacQUkNZ71CZTLmjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoQhNzeJ2OrkwC9N2CAtXp3LPe4VO-Q512RpzpxsTKIA&oe=6AAAB28C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcxvlImTuz8Q7kNvwHl3dZ4&_nc_oc=Ado1aYM_hdwtnFtJ6FeCUaTwKTP07S0E0gwb3yGXhnXGG7gST_f1p2lfADbsll3aKk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnLrKq1MuhKwf_WumcI_Mkzi6wIzQfrwL0NQDpiUCe8A&oe=6AAA9B5C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBB61ohcmbsQ7kNvwE-yIcH&_nc_oc=AdpYM52cSqy1YhUu6eyOALCYEYq45_4y6JD4gQTedngSyntSmCCEwNnuaCXsUOD5RRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAZIAQblodZUy3li8I2IqTJq40OWtQopOHiVlmokTA-Q&oe=6AAAB86A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVCOEY6uCAkQ7kNvwF4tRvf&_nc_oc=AdrDhQwJARzGXRHX_Znr6QTr9h19c2r2G_kpl7fkv8PGZpwxt-K054laZ8R802DEbuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzjDCNByySqbQFujy7PytpJxGYsELAzB2lD-EKfg6fdg&oe=6AAAA269"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
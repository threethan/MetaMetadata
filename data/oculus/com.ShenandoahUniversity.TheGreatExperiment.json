I8W9nwj-U9AK0P7uggc8gpVpUFNA&oe=6A7DC85C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayzmhdDP1i4Q7kNvwE_stWS&_nc_oc=AdoulhyaRLaAHUpxBrBjgw3dva19qVXjeQnWw0iwzBTFKsly9HL6Wr7JdRdFWR_htWA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEelUQ0y-XPgdc6BDpw7cCxfA6WNuPyh_Jz4ECMtcgv6A&oe=6A7DAD2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NisBM74oYWEQ7kNvwGicVI1&_nc_oc=AdqCvk13t1EJyZZN0K0NWa0Wtn4TnfsUWxbqrCRWpE4XuJP14wrfxbnKBSavk34Xjr0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtFveFEXs0aHYejpbPPMiK0W_hvflFlqpr9cqaY8_1NQ&oe=6A7DCF69"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-f
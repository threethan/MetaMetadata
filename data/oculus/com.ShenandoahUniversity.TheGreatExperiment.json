cOqrT6EUpHy435pkkG9TCtgo3LLg&oe=6A46695C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5jfq5YjoEQ7kNvwFYi3EW&_nc_oc=AdrnOsvNG3xjQoD1Wsy3DMfxvI1m61iUr7ApmjJwmNf0RTo31mu9VIYNWPnrGzK-D1E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a-PRZhw3EX20NPHDj8-wt0ij1919Fj2s4jhHfdtf7Ag&oe=6A46866A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui1jHXVPjUcQ7kNvwE7bZIh&_nc_oc=AdohK-OP657jCjM_K_IAG9kcfkjWu9zGHZcWk5VqB6yUge5oGjIGTjrHfVA0VhPLrCM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hNfMU_WBJmiEgibsIvtno0PsTnXz0CC5kF8rSByWvAA&oe=6A467069"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-f
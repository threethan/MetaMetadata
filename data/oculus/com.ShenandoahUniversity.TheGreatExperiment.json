TkPNed7w-Hmr4A&oe=6ABA6D5C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UpzaoGn7sUQ7kNvwEQiiME&_nc_oc=AdpaqmLGTGvT0q_XuJtvn39yi3HrGUJWD7HYC_E6ZP8J4nmCrPz4ATjXlJRuY5zvLB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuNMo8kMXg9d4hT7p-ShUbqcqMgeiMB02ZZP83kMmuwA&oe=6ABA8A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6aSxrvr7SgQ7kNvwEJ_vWw&_nc_oc=Adpqm8f8Ssjlls-crZnwkOMUS8Dbxn5u5CZojCo4d1ReukpbpBd1TlZ9gwvK5QEyevM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUbFF25z9tH_CqNwdbZVpB5uTdYK_XvaWe7Glp7cf8uQ&oe=6ABA7469"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-un
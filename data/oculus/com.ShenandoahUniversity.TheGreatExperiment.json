ontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GA3fVbwzpMQ7kNvwEeY5__&_nc_oc=AdpEr7dSKGMSSzrr2RFjSsagonNwPfD7E2usD8hX9uDCas5_maQTp75dOTHn_Xbtt00&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM1magq3YUw6WkFHrza1jyhe0U_YczuZYQyR_YAI70Yw&oe=6AE8B3A3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPzQV16KbtEQ7kNvwFeAmE1&_nc_oc=AdrICFRe6SDYV_ileNNXj5KmhN7ac4gL36NNn4W2kkVCpPW-HzRq1lOOieF3RVGCiic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScJ0f0UmMHZWwoFHBoJvUEm9af8te8I9UZUzOLmCTd1A&oe=6AE8A90C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIzJj1rex5cQ7kNvwGB0hYV&_nc_oc=Adp0xlOye2h8up4ICKfUzLqwppBXPKh-N_dFflq7MtqChJrXN-V5411MeO8mOV_D2Gs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEX7CLbXVitZoMBYVdO28nF2mevMoQ8yhf8arhwfPCCw&oe=6AE891DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJmKZa9iy4MQ7kNvwHu-zXf&_nc_oc=AdqBc2VxLRR4hz1wcpx-m3LEu8oW02ugvq6j8KCyvcv5QMFaeRzVYE9C5LEJ2O6G9wo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS__3i9XHrqm3K1kEfcIKrLjvQSih3ZjztOUvGxCEGcbQ&oe=6AE8AEEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W7M-FgcHRQQ7kNvwEkBHvq&_nc_oc=AdqQHXrVZ4GAkzdw5Su2niSPHlW5R6d_WO4JjL7SdoC6rhK1aEe6SdbCGP5VDiw3wt4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_ThlJhxs2nFoPmQod0-HX6d8DRkFMzVYzkuATTS58FQ&oe=6AE898E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
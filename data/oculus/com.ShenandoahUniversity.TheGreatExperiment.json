ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icGfgEdF5eMQ7kNvwG6JoI0&_nc_oc=AdpjEVbxF8G6yKq4vLwjbj-9DsG2e_JascU6BBqBB_iyQ6AhIctZihG3yNTGWRGBmgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO_Sfft3PhcnxbAKDuLr2KOTH1NLyKoxIBRIcHNPGfLQ&oe=6ACE55A3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIKnrWSj_zwQ7kNvwFWNjgw&_nc_oc=Adq7evP9yo3ZLAFY7DiGJrYUm04U4PKrzj1Oo4E01DEyCxv_Y7JL15PeSO-82VVFPVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIQ8cFTT8kZa5Po_OVdEAZGMiCDHfdgVx2MwHZndU_aw&oe=6ACE4B0C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_IWvzKrS5MQ7kNvwHAyNha&_nc_oc=AdrGCm6UWBXPRWNKBq1zX6NApcM5DTh42-s6GrVHL-3QRkFl4zkE3RMr5kfov70__lc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbK8IVe2Zr7Yw3t4eY9IN_2ufhUvksvMH_8fv309M27Q&oe=6ACE33DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlBDUcejc3YQ7kNvwFGC_J_&_nc_oc=AdoXo6Kv-jckpwVmYv0zPW4ITBbMDH_uU5iZSUOUjRuk6FcTO79abJAXs_eVYX8VGlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9OdJzD85HSuqRIcVLsR84Q3dA-2fXolPCKQ7q_SlAgA&oe=6ACE50EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukQBHX1u9QMQ7kNvwELXRV7&_nc_oc=AdrSs2JjOU9eDDDw4k6JdQmASn36tAvaZgJFy7gltd2V60Ym8Dubr-2WOBET7J4Vf24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOWWFYmj0ddZX3p4I7o-GiEtDXqb858jlTmIjDQq6Gow&oe=6ACE3AE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
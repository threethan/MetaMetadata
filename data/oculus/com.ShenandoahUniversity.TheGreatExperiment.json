ontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDvcB-1XoMIQ7kNvwEgtWUU&_nc_oc=Adr1gYTORxbNu07882kvs8d7pyDOAWEr_cETkC6-PV8H6it06Zy4v4EBdKEgWhCh0No&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQPGeYA4Txew0SSRPf7hdv9adBIzqdJwLfJrKMIVro_g&oe=6A883DE3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSYT66bkzDAQ7kNvwHBMuXQ&_nc_oc=AdpVZXZGFL8ULEouGP0gn94Hwvh7TGBOBtXwYsxg_DrvtZ9QUfEehMycyFmjuWeb0e4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaBxqgMqKHtoJINfbghLbYXvmujCnUQP7Y-pQC8E6i6g&oe=6A88334C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE7NCU3ETOYQ7kNvwECN26w&_nc_oc=AdogFfauqF1G9cewRMsVY3ahoKrlRbx9U_LDvahNUfbovhSayNg6UGJs-ntXZljMaHk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd_yrsik0s_be1CgQ1amIB2PFNgvKJeCudf9w2ccmndg&oe=6A881C1C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkjgKzV8MVAQ7kNvwHHxBnG&_nc_oc=AdoazcUk4tzOGTah9n-5Nr7VvmGhzF5Mor4O8RMEqOjspI11TZq_kuEq9MnP-MFFJgc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_hn1QsZkuzY-Ot6o6o-kCHuzmiCL6_Ay0bz2MG0BIFQ&oe=6A88392A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVJcOR7H6BYQ7kNvwERqUob&_nc_oc=AdqSL8k7C_WKOAbdm403Tp5kXnGyW84Tha__ukh0VxNS899UgZ0QgZ4gi7UMnXUyPMk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbsIF4CJ20TR9_35OIhtjJjCdHYrvjGMAST_582KViFQ&oe=6A882329"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
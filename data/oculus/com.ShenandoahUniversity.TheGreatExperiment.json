ontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icGfgEdF5eMQ7kNvwED9kl8&_nc_oc=AdoINrGxDOOGddB_wBWFSpo3ILXqML6lGGsGF04o7O9nu1o2jJpY2ZVLUcNTfickLIU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1QSM7KVZanVvDski5ztQScuyxtHl1txrTOYWheC3_tg&oe=6AD0F8A3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIKnrWSj_zwQ7kNvwHNbWFs&_nc_oc=AdqGb5Jh9Xj5v6K5pkIeyhjhLZTDgq7HehdjAjceGIQXVFv7EvtraHyc3e3VN_l0S1s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXSuRNgz-73j5AymWucFVw2GPyv8rrnTBizVijpAFt_w&oe=6AD0EE0C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_IWvzKrS5MQ7kNvwGezoiP&_nc_oc=AdqmWo0s_VHsw12kYcdZmkdVC3S9u5C0nn666bcsnES4bTysgEUBVHNYcVXfFdcASxg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONotMGpuyL2XtQtWO6QbIx6KvkcdDCFZqgnITJdySTOg&oe=6AD0D6DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGpFFrJuucwQ7kNvwFNhAr3&_nc_oc=AdpJwMafuDQxiYQ2IOawDTTJtbhoILUEzFaX2f26hw-PFg0E1c-xeZc2Ox3rOwYIm2k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-GdLbr-RPwC7vTig5gxqk66Ho2x5AN-RDRSaHBOAZlw&oe=6AD0F3EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkH_qrlYiQAQ7kNvwG4QvLp&_nc_oc=AdqsLhqkssWa9OmuznVl9sOh8rKzZoW-hsOkShBybeNs4LqFH3TLNsQ1E98D-BrfoeE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmtx20CQZoBDzRY6LiG0cSOSPf8prwuhSDxzrb5TUgpw&oe=6AD0DDE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
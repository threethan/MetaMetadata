8wtx-3ocXFEQtQ&oe=6A92E05C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9gUSogiQdkQ7kNvwGcbrt-&_nc_oc=Adp7xwsrd1QI0EVC49uVMYj-5QG9HYG8K7q5x6XBcNc2ylFbr2gXLtq8KC6A3fyGxRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEThE9849ctNroH-cGK0xEhBv9rS4JfAxNF4F8i5IfVBA&oe=6A92C52A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prDSf32DWzUQ7kNvwEblafS&_nc_oc=AdpgY896DkkJonhVw817A7WM1aFZr-33IAHCdWotZGjkRUar-c4t8mlf6-HjcZSHPEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnqJxG-kPt-5_xz_WZyn1fzvNS3JGggP9VALSxCGjBrg&oe=6A92AF29"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-un
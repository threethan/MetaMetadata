ontent-qro1-1.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifYjLV5IyUQQ7kNvwGZ71VD&_nc_oc=AdqoE9ban2QIBNrQdiMgMkrjda0MF1rgtvBQ4v8e2l4e8N00mMZMuIEkvZRw_xx_oEw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqLelScWmD7dprezwoT2xDCcHqgKOHGwABNphbPDkxqg&oe=6A972EE3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcewdHZggVIQ7kNvwFiUOQp&_nc_oc=AdofAykjpOa9vYILkL0iQjnxs8I09DhSV3z0U4kIL57XBxdOakxO-4kKI7-P0cBjnUA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDMFKZOfRmlaOEwYdGqISAU4uBqmkTKp8UGmWSSWIs4Q&oe=6A97244C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO9g7q0m3b8Q7kNvwEP1lt-&_nc_oc=AdqRSUWxW6ocM0j416Ow2FEBLHFUTI98ZtEW-ca0Lcwfk7F-WnBGK1lIpqd9Tm29myo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt_GAPEXB-31z7aG7ixtVl_aUyT_GqoMTJV2Xr-tWYeA&oe=6A97455C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rri5EC-AetsQ7kNvwHAxW5U&_nc_oc=Adr4_y03t3NO-xQt-9MI3qnyATownGRQvLODtDUzFQIvLP8o94a0fa7521km1IFyxlU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2fXKtnd833rsY4KlLls6JPhWca_6txVgPnfhgWW3ILw&oe=6A972A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUw725sgdQgQ7kNvwFnfmwv&_nc_oc=AdooqzXVFJylfeoXnWasWrN4ZK6fxI3EaS_Pyxwud7b9crp1uslFvLC4UTWogvAvac0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqvQbbWeO_ZMbEqsTN2YMFN_FoMPcxnBmqkCHa_zEBIQ&oe=6A974C69"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FhFsviaHLQQ7kNvwGeDk6C&_nc_oc=Adow_QKXIfUqlK80Rb3Z2QgL4SQZVs9FsUpRpbryR7x3150khhlqXuKL7r2xXdgoIBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSbH-Qv6HGNCEWtDT2OfP6BFGPxBHrl7ysN9WS1pebfg&oe=6A95DD63"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbgyqITiJqgQ7kNvwG21StO&_nc_oc=Ado57pKIQ1XpRIzSrW6jNU8mnBaHywdCpuY8d2Zfv4nCJm81z2n57XI64yApoYZXMgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxavyNoY8oeDcaQi_NLEKpdzc-wZob5t-3CF1D62ce7g&oe=6A95D2CC"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kth4GVn7iDcQ7kNvwEGgo8s&_nc_oc=AdptLRPENNO7BBENTi5N8YJJKq_Y2gmUOWaeC5R2OD5v4fT7chLVMe7a_fV0OgTMmxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiI-G32YmaqGepmvkAYgRpWdDvzp8eylVEJjmhIVuOXg&oe=6A95BB9C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rri5EC-AetsQ7kNvwHVkkF3&_nc_oc=Ado050tagzqICo97Z71OMF6_Z8pm7nGDTBgPOdRax-rRSU267zzjiQDDunGv5R6SiSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXGMkene8j-RRG4n85tuS6ClfISez90eg3ydlXON-ACQ&oe=6A95D8AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUw725sgdQgQ7kNvwHoTSPF&_nc_oc=AdomuQiZUraBhsQX0T0wJn09QREs3N_jjpPeeR4SR1w1S4_kD5LkrATgYN3ZyKDGiSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC4_sQAhM83uKVt4ERDrybT4-vPRWyADNnOEOydz-eSg&oe=6A95C2A9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
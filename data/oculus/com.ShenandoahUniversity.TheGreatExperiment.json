ScJAoIRzDMmtjQ&oe=6AF9B55C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWSTryYo5tQQ7kNvwGNgKnF&_nc_oc=AdojWk567wBkSMlRVFoOSlGgL_QqwhQKLjff0vaLLDlPstSuVciJN_eMSFEGEfNzPPY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIbBT0p2itva_VLkfc0yKlg0BDUH1mUJRlyE4dm0K6zA&oe=6AF9D26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exGFv0fQzhMQ7kNvwHAyJAx&_nc_oc=AdrV3Ah4F2jDZNeSxNksOTVGChXeJcWQxCLwGTV7mxc3n4Ez0248yF10KOqHCPEQXIs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1LHS4Rgk8hwJ77XGHvdESLqsIOvPCR-KQOsGtuLINTw&oe=6AF9BC69"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-un
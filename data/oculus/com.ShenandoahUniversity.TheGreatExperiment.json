clQAWGpTsEsqSfm7l0svf93yHIV8SRKelKN2poDg&oe=6A8EEBDC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTnW4ZxDhEkQ7kNvwHSNXTs&_nc_oc=Adp0J2vPG7X-MoI5X_iFDg7tFWdM_2N54VD2wsfVb8_aw28lDMHFbC7tEfItLmiTR10&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy0LB3dlacdfAko3kisiIXWBc3cVjCyuhcoh4ZXhiTRg&oe=6A8ED0AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp62eKo5X3wQ7kNvwG6G8uT&_nc_oc=AdrtCSsOFvnRt9AuYKLYxuf-NzcZRwAX28i1FF5822z0IdPjK5Qo7lW-M7x0U30kdgQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF75Ft-uBHtKtnGm5ayOuDyuc53h_ykkYjQw7OuSsc7-A&oe=6A8EF2E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-priv
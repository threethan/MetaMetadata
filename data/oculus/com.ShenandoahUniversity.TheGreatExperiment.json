ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M2KOvozGMsQ7kNvwHg35nO&_nc_oc=AdoQ8i8nnexaA08px2KGZrprgE9dI9kzOi-QdXrbXosLZqpEXVN-uAozQluSXL6uUlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB-TtEBWUjg0-5D5nRQ__f1PDgF80lXiaOSY0Z96fksg&oe=6AB93DA3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMaLd_qxFBkQ7kNvwGkLVey&_nc_oc=AdoGtUoJqvMPUpW4Ed14NfK7l94lTQIu0IOfgVYFqSu9OOzhF9KoXjf0u6XyOKQtkQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAKI1sOEKdKUuuF7mmHsPM-RTNGxwAmwhT_qBmep3BbA&oe=6AB9330C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUWm69WKmH4Q7kNvwHNXPvn&_nc_oc=Adrb1IlYQdB2XDzM5ME1XWB0uR25mAPCEWRB3B2OhJAvRhKQeDdaEoSr69iUBE6IFeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv5I87_gfbjdCOpWDZvDgndNCpxMuzLQWob_aPSr8IEQ&oe=6AB91BDC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UpzaoGn7sUQ7kNvwGcnMa2&_nc_oc=Adp9S2z0hO8m09BypdvLJHoO3ZDC7Go7uknnafSVHC-cI87wqXsf3x_JBoOLSPwTFUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdpJSYtdh2A-6CV-Hq6pnLCi-X2MAdFdxd8i680FvAmw&oe=6AB938EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6aSxrvr7SgQ7kNvwEgb77O&_nc_oc=AdpCPIEKJia4KoEl0bJhppiHFPORKWHBXsDel1wctImvFw6YVbfS5rEY3X61NGc0qOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrgUMRAM4LJoW7qMVrRJ6PINQsvH3yD9MNDqgjZEDxPg&oe=6AB922E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
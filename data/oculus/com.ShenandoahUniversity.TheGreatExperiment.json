ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpKbaOQFqkQ7kNvwGflTMG&_nc_oc=AdqteAcHE6lff4jmjEnMSzqLaz4SJDL128n8BoclktxrRfOX2BCDN7BhndZgB889p9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHgTgBg5fNncVwSQJZTWKyQ7aU3cviv-bOQ19vlZHG5w&oe=6A4F8D63"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iHd9JrHX6YQ7kNvwFTu3ML&_nc_oc=AdoOyeGfMZau7fhte5HE95RELfpgBXsKo6rC6briTrP8tDdKvpRQOYp2553LqwgEXz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmCOf4apKcFgbcgLUoqATxDT2nHU66mFBgDeWckCL5TA&oe=6A4FBB0C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh-h88VwyQcQ7kNvwFDp-yq&_nc_oc=Adpp2E9t-ZmE4e5eoUcvQ9csXbNn_kp7CB8gXU8MPIDpyxzvrXA0uzSZU1CiHWHQxwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYkQl6j0Kd4k7Gb5EBR43MGQWpyZyNPTaHTudWSGPhVA&oe=6A4FA3DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q-Sk2s6pL8Q7kNvwEsh2Sj&_nc_oc=AdqVRr1BmcynARqwpgeiNouP1cq63FCT4-YRC5hL7x5kz5K8LusomqqERKL990kn0pQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwvPfa5qgXGLwRB_itP2uP_FUlaF4nMyJpjifKzhyp6A&oe=6A4FC0EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTYj1LXAmOoQ7kNvwG_b0Pv&_nc_oc=AdrOTQBKSsCG8jNX_CbWosQFFjrwWQ0f_x7imzxKdtbiL8DulD2dhHBtoyQtaNReX-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC7qlOhTpnm9jxefgr9jUNOswFwsgTgVUY4wEzvIWZSQ&oe=6A4FAAE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
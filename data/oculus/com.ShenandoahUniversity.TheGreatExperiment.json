ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDkMTjvJ9WoQ7kNvwF3kgzn&_nc_oc=AdroXRkm4Xp0iZwaSgfU0WbvpM95OmAdOgGmmibre1o6ZMt8wM18FHDrG1HncD9PkB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM4oR1eINFjIWltxbV9NmkhCkCA3T9Zt_vWXYEDKrtCw&oe=6AAC0EA3"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3epBw52HAEQ7kNvwFNpnkG&_nc_oc=AdrYTwLKVuGOGlb79EADrMatZ7zcu6YPIQvbv4nf1miKMOo-ZV0idLjxzOfnhrL8Rtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF4Ug4wDN3UdDBiJroc0b-T7QJXOMuqjdzTRQO4x-GeQ&oe=6AAC040C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcxvlImTuz8Q7kNvwGZVbZB&_nc_oc=AdpDnv6gq72ecSbTidVU_WhEZM1VUFgDD_j4N3-1q2mz19mS6TQUi_klumw_nKmTk-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgF3O2Qe1ByLew5mNJ33QOT-179Z8WA_5oNJODIs2zBg&oe=6AABECDC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfc63YLN6d8Q7kNvwGtbn1N&_nc_oc=AdpV--yWXvhSYxvxHCfhZphOiHa9ZWzy8mpx0xSRaXcp-8s2MYneLE65dqLuovnSSOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZSDsYoNjXCzn65S0gMm9anJBsmNmyjtQSweYGw7Wufg&oe=6AAC09EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpPj-HSL710Q7kNvwFtymhp&_nc_oc=AdoLk3YhQGcxKcVoj09lLVSCXGo8fSCnk1aJvuGHnhbnfNUfL4vcXOicQ4kwUIpll9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmerrhUxzSani7aQZa11mCfFQ1zVVF0pkxEEx2_eVA9g&oe=6AABF3E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
mhbYat5QbvciSVbXIUhi-bgFkEOw&oe=6AA403DC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwoJV88XHuYQ7kNvwGV6tqg&_nc_oc=Adqt2De2JXdI3Ukq-4N3y8lUPgfLBrkO-m-0PBAl0sx6PrHZqp9mqe1OtGrI1c65A7g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUGnV4Cb9oEmN4fWNYYwGWNPuAqrTb16RPOlDW6lxIjQ&oe=6AA420EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4VyL8e0oqgQ7kNvwEDsqLh&_nc_oc=AdoCCYj593b8dSJl3sezYWZHy4GUuMNoJuCD6VURs232HuzQUnCMhThC_o75yKEAki4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkFLPYrz-nbX2cLyYjTIH0wkAEm1ZJmEeQ1VukO8DDZA&oe=6AA40AE9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-f
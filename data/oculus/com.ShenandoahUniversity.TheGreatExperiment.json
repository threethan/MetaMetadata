ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GA3fVbwzpMQ7kNvwGc3RV7&_nc_oc=AdqjzuhBIvWs62ma0c9Nz86OI0Boci9hOakUtPR-IHbsTS0hzgRuA017tcdN4dC99Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6WncYs6iI-WyR7Roz7Jy172j2vXmyAvzOojBzG7p8Gg&oe=6AE76223"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPzQV16KbtEQ7kNvwHm-hsq&_nc_oc=Adqg7CUOcqN31CaSPWXIkaf6pj9z8Ejlqum6f0e1Sl1Z6LVnIdSbzs5rZnGwnLXrWkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7drKN1J1NnM27ZmPXxENOetE8QkG3QhiTcemmFnEuZg&oe=6AE7578C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIzJj1rex5cQ7kNvwG_7ik7&_nc_oc=AdqPASr6jgCozinbkzdddmuyTb8b2BA2Bnr5vZZTbKd0YD6KdQOOI4Wk8MKWWT3C_9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPqKIZ6hDlRyWzn5bm79LpBH45yoarelZxymAbEpY1oA&oe=6AE7405C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJmKZa9iy4MQ7kNvwFJQ6zY&_nc_oc=Adr7cXpTuGkFqqwuXgwRooucYJGcl8yvz3CcngroFE0w-p7iglahee_ok8wAi0WCKfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0duROLYmWJ8IuDTvUpBjyRj4nf8HLqMQOnvwIkJbWkw&oe=6AE75D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W7M-FgcHRQQ7kNvwGo46JQ&_nc_oc=AdrxqKk9zIdSXpSP4wfZ3z6chTv9Sn0uHITDyasiMQJeoQHr54Tr0bK9KtdSs8vlyd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQXGrIzW5OduQPx7ZqpcSQrHMcZe64R0Fs-srF1J1vUQ&oe=6AE74769"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
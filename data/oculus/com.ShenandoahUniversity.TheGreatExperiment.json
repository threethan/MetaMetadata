ontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPhLfB8ztt4Q7kNvwEuAR6f&_nc_oc=Adqg7iIXDFF7IzSji_mjerLc0t4gvh58aBXkbBCQ-cxEFhpChGFdmoLqABBAEVDaD0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8gJr-LKCv548Wcm621UcjT7hjPBYugxaoWrLNA4sa6w&oe=6AD24A23"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UMRgHEIdd8Q7kNvwHUKKq1&_nc_oc=AdrawKz_Pcx48FQIvQvWaF4LR07xGId40KxZCOHW2lGSgAlHx1k2b1ZQL4cW14seXf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO9X6_fH0ndL7dpXRByRnnxz9fePGFD9sv3WfUzML9RQ&oe=6AD23F8C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VHpLZ-gaR8Q7kNvwGguErt&_nc_oc=AdpcF9YonkhzFO6v5eE8tbn8sDLi5xF5jUojHfT-kGdKPIcsWBEPTWMHdQlvkZgR_ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqrqQfTnh5ZGFqpkILvkMjLB4KIoLRQVg4IqUoNRRAdw&oe=6AD2285C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGpFFrJuucwQ7kNvwFjkNnV&_nc_oc=AdoGaBwX6qfJm6E7R8Raxui5zJmsfHwbMCCHPVCTG_bXZL0MMQa1Zdyk3An4CzZJrvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDLNyy8X_5LpdneaNLi-90TYSk9xLp6hO3-5esVctTYA&oe=6AD2456A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkH_qrlYiQAQ7kNvwG3dShK&_nc_oc=Adq-62f-11Gdu0iJdoqhZ6E-gyeUvpqlRHDTdrx40zcSEjngm39w8qV2UqRFD-Evf_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlHxObFnAetZ0kwxZqCfQEYMR82El61sV-oqebgzdB8A&oe=6AD22F69"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
NcIoySTABjtmHw&oe=6A3D2EDC"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHJRFnfR-X4Q7kNvwE_Ggsu&_nc_oc=AdqVpFdjHvKv_q0zrZmHsX1_sAXAmD7XX-OxlB_tTKKjogpdq1AKjWYIFXzhQ6KP8kw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zhZR0JGf7-yp4u4NHvVZZiMS5LLkLZ1-xHap7e70sEA&oe=6A3D4BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvR7a7WiZlsQ7kNvwFsU8w0&_nc_oc=Adq8IqIu5hCgeMeKlXRgVXqd2_ThOBvqLL4KFxdJOWvXbknrXCQXylKLV-IBJGjIsKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ME7u3BxQs_TQCv37jMkkSUchHGAZHbV8ZoV583O2LfA&oe=6A3D35E9"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-un
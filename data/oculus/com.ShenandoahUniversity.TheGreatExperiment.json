ontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308307_1989633795256782_7064989821291789312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSJGyiiuc9IQ7kNvwFv8tzb&_nc_oc=AdqDF2KvPAiIWORaXpM6miSWWz4KnYT2h0sUxNuoCoteBE_wHuDOj8McJFQrSLiRVUo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90NJ7fXVFrKU45G6Hmrz5BhlJ3fRuBNoAECdLYnvpFEQ&oe=6A341623"}, {"file_name": "tge-screenshot-4.png", "id": "955381657101136", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308090_955381660434469_2999432430415186536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbdWLHQlgRQQ7kNvwHVDeSw&_nc_oc=AdqhhicVvU8rLqHoNH5rwiS_vhN4rZhDAb7auPHCI-tcqLX8RemUBfd0adFP75bWnK0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nPrNHvswhEgX4jUxEDoLKachf-TiPXfitlfsKoJX72Q&oe=6A340B8C"}, {"file_name": "tge-screenshot-3.png", "id": "1861419061159262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308575_1861419064492595_6209035284317571524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS8oboiqRVQQ7kNvwGWczbD&_nc_oc=AdqlX4u9QuOgc73W3jBKRTyYgO_jJBIyZuOLgi000m81zqFxIM8h3LXtvNWMAgszzw8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ml6W8YK5_X2_cOQEeKdf2jiqkSaAJtQQ9474hfMLLag&oe=6A33F45C"}, {"file_name": "tge-screenshot-5.png", "id": "4307245542924677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308050_4307245546258010_1466829292127132505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGGfddMIcQoQ7kNvwH-HeZ_&_nc_oc=Adp_S0errCQ33UMLbR0h6HlIUPTs1b3XAT_jTNmQ7wc5Nm6NbWNJHLrufLWMJx4cxPY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cWw68oD5M2B2QeeuOTNc00V3dRovDNihbxwsecwEPsQ&oe=6A34116A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1924791968229811", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1924791971563144_6217405879742732082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwIcxldJPt4Q7kNvwHe6yNH&_nc_oc=AdoXyr1yxnc9siY8dxuKiOgQJzEYnKzCzyBcmcAIidlss1OcdDxfnnsOYeDt7urkkS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qiz9CiXqrjk9sXjMHBym0HCcs4Y_ylyKZQanlEI3rGQ&oe=6A33FB69"}, "display_name": "The Great Experiment", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
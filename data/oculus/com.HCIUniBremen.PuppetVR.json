in6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaJMON2NWlaL3O25-0QZOM1D5pLcklU1KtbV8gjx17Kw&oe=69AAD9E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1tRAzlYdPYQ7kNvwHeet34&_nc_oc=Adm4eTmv_LYWdFjwZCxBMAI1xppsT-VCQWlCgkrmqTx2mZ_MgZgAG5s_Xo-rokrIMJQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq8gmk5DB2fYLnDN_BEoLTG0TY2pq0e-kFezs-Y5_PaA&oe=69AABE5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYtwSNi87IcQ7kNvwEPpnhw&_nc_oc=AdmIT5JUgs2Z4rze1GvnOfEdv3xWzKXTeLmmBctLF7lOLcNduCmIvjauLb-aCHcid1s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwwqd3g9Qw8q0BXkJTC8eXF7ol6-2U8Qwi4RjPwojpywQ&oe=69AAB936"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_s
38677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqblM43O3o8Q7kNvwGz7uh3&_nc_oc=AdnilIhKUjripmfJ8UbK-KS_RGV7Yv6RMPcNT1if2DAXlC2Qwqbi_5gzMMLAM0LpQR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs2Hf_IHqbQ52v4gv644r5iTxDMaDAMaEo_-sRaEyBAgg&oe=69A5785C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku4B72KLtHEQ7kNvwHfIvzl&_nc_oc=Adl2BSPGMjr7XuZHsJUjiofJMCDEmHBf8y91V59AZ8T8604-zpWtYge9WO8Nj8QZqMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftJCUZgcbkY4ix83iSO2ieT7eF3wGG43IHy9GvTWvhIwQ&oe=69A57336"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"
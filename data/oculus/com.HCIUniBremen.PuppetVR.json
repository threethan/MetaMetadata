zHyRr0iGevL-LcAwFlTh0BPw_pd3fWt1aDp_Ynk-Sdes0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1T3Hspusykw0bDdVCwrGpd_OqBxMgN5NemrHpQOYutlA&oe=69F35C67"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn5TSjBGHIwQ7kNvwEP2rft&_nc_oc=AdonygNISEDRmPdQLyBVGbR7oxO-wJYaaEGua0s5NmBvAHMTlKX0fYom548Y_civUcE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08P4gk64g3M45han3njbxozXcqu29l_y3BTBEqup0eCA&oe=69F340DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODDy3wKPO5wQ7kNvwGGTyqN&_nc_oc=Adpgxx-kOJGqsVPYDxWIkK89DHq6mD10QjkzhG9iEG8uVweXeOHxsQ8fMl8q20bBc0w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34zUYaqnhno34s84kcUL5R4E55NLKy4iiNs0PqDV5b6w&oe=69F373F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
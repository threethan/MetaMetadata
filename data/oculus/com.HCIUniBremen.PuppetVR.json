nV2u1m4j1svlwS0g6uUh-ydNWCcwNjSwxWyIB-lMjAFxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElLu5aHThhXZsG24S-L1yh5YlLuNGGDx1EMbdJ0f833w&oe=6A896F27"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ6Kf0NS8kUQ7kNvwH8Z1J2&_nc_oc=Adq9y72dykqteiM37YnWI_iC22hzDKxbaXU5XBXtLeSmWHcqVNM_9uSBEIWTpOMJl0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOgv_rA3upTrspd2x2dF7v4zuoMDf2fdOPlnQc091tuA&oe=6A898BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9lrDNOHKVYQ7kNvwEBRxV7&_nc_oc=AdowFQ9ok4cODmjhik4dMeQcNJSi0lNDAdz7n9ZcxxBoi4zGr144P_ZjPg7fADjz0Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDW2d7mIrRD_B79NaV8vm4XWZRR542sLiFLiERHyamyA&oe=6A8986B6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
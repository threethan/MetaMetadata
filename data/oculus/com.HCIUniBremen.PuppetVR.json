iLnf6fB8JjNCi5IE6JNmHquD6gRQhendd4GkDGBdbZLQM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x_SUbAukUiYCB7KdxDbfwgMPDd-HvL7lJVw0Kpf3SNQ&oe=6A451967"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv45meD-bskQ7kNvwFuMgWy&_nc_oc=AdqKh3Vw81MrG2P7U6OqqPDsV7TQArAsd7LscERx-Utbo_d-XMUdHtMzogwcT1N_Bbg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hX-sRMtRRfWPqSeXzEHPZI5qsCZH5KIyu2AYI6cSwdA&oe=6A45361C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bnv98llGejgQ7kNvwFSYaGV&_nc_oc=AdrAT4zDMKhE7tlzORiG358FzDLsUTJa6RhVTNHjHX-wwR8P9-MNjWgjUGIEZfTW0DE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BoGNF08WXg4QuYPIXG3rxsZSQ4z8_2nexEShbwm5zTQ&oe=6A4530F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
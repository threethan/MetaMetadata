G41C5d3bszDGpSdML04ZXILUlkzB5T6XzQZY977Rp-8JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIXGu9jIJWjPnNw8XEuKcrzYVQmyPPAilZlkwuIgzRGw&oe=6A64BD67"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oW5XWqdrUsQ7kNvwG6DYP-&_nc_oc=AdovZKZWcriq0JEneXWve_nqV6wtQrtnAL9eToXBacD_X-NxCmr3ROCdDl0k5mR_-pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyvf3P-htUHg7QG-_uLunoAcaEDcRzz6N9Brep3zXOkQ&oe=6A64A1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JycAtwA6870Q7kNvwGEvolb&_nc_oc=AdrgvLUYLYZIz6KpV_brxrwDyoE3VdcN3aPKsV66JA99DyTnm4QR2eYyBrbgRa4UVvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvnzObS_4Lu_rVsc6V5Xqto4JC_5JRnhO80RylxnjoyQ&oe=6A649CB6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
ss=8&oh=00_Afw3-Z5XHnBsTJ9mrvnpEKQa62tQUDZmHzYcyL91VvnRtQ&oe=69BFF1E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICnDcb3200AQ7kNvwGDnxtE&_nc_oc=AdkDVOQ8YOLm504QHVhiUz_tR7S0hNQAGsfBWGvVK-7F_WHkUfdQryAwXqJRtMX4bKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxO1SBUpa2FadyAfMhf5bD98CGm85dYlEvf16IYHUOIiw&oe=69BFD65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7HtJdegE4QQ7kNvwG62jwg&_nc_oc=Adlk-yVA_F_z8MHYIKTAhuG2eLVjNEByy1lV1HpRhUXZbBhIDZ32NnsoIlIXItHp5l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2Ppfr0laS9SRWVrZ-Zlbp3iccXPvKCJ7i7F7YQ9YxEw&oe=69BFD136"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publis
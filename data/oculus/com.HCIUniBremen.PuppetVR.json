bVyOHm6iXMSuBRDyyWQO3uX6JneLFh1HDonoT49XYQuvzPjyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22W0L_DJZWM8RRefJOorh0QMF5HG7kDFb_y5JCosQ9_Q&oe=69D27ACE"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMwNcGKbADgQ7kNvwFM9Bk2&_nc_oc=Adq6_3mlIuevn8RK6puVUPMAZuqgV1pNpQpzAq-gjDF4GI4hT7hQBC1syR-4E6iTaFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15_qUFbjYdeeXpB34ukhk_056Q8vsZTvpnCI_Lc7kK6g&oe=69D2797C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTruZ_1PngoQ7kNvwETtWVf&_nc_oc=Adr0M6aXNRdJ-GAHXOk4slSt2Ifm_bbwBFEl86fuywZJFpJBphZydB0LuBVHYPIpBXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3731mPGtfWcGZZ6inQ7RB2YmR4yWWXOaQhkITjiXqp1Q&oe=69D266E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_065uD7vA58Q7kNvwGLYDar&_nc_oc=AdpaLPKKyXl_HLf32bTm2eecL8RVhHND1vx8M5pdWGkSe8YPU_C8Ams99AZQw5uSy74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EAkapeebBDnCBPtK9PBFCKbC_Foat14PAQNincyx0sg&oe=69D24B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYbyCDksKwUQ7kNvwFe6Sot&_nc_oc=AdqRt3Eth1-O9AkGMtCPJL9laieisogGLebW8zvNm11bVBudSRiI5AZ62B0OeilPNA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zf4vooUT39obcWfnL03gLhHpNKcVl-Fp6IPCl8dqn2A&oe=69D27E76"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
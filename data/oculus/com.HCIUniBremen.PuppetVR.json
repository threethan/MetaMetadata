-13YlrJzgPl8AQPu5TlXVcDIsQa0zINUrI-2fPKDoOw-QSgak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3krLJ1DvoaMaj-j3Kuvvc4ftYCLeCjBhSNZZU2ldOvKQ&oe=69E0FB4E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ry0wtP5PSQQ7kNvwGghAhn&_nc_oc=Adq8xjUbwnfHJgF5MkK9Lw5QkKuK-60B70SomtcD68COzn4Pf8ZWOQ5dTJdCmdnMcxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MsNJoD4_IVHpAhEXNmqZJgP9NDSX9jlsh2fF-WVEIoQ&oe=69E0F9FC"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k51wyJcwahAQ7kNvwGSxjID&_nc_oc=AdrcJg-Q1viKSb3qGKgz57MeXUAeQZBkzyUwzn93h0YLTjNuTQoU809gySQW9Tm-rYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nhTFMnJmENsAa-kanXkqiWaPH4w9N4kLD_UngASyAjg&oe=69E0E767"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shUIpyq6ZmcQ7kNvwFQQris&_nc_oc=AdrVwAOMjbzNmQEEeaN3Kru552oiOf7enhVdYRpWTRuFQ-sBWgolS34j9InV3o7rWBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d1VrpD0bSh7vEdH2e6LJiE27XQoqr58vVcJ3mwW0N5A&oe=69E0CBDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8FsQCI6p0Q7kNvwEobf1M&_nc_oc=AdrtJCZKYfW0cmiIqMWnDbzN0MBQWXvDhg1SWQcp6i5k9gZ2b2bj6ncu-cQaEBPizxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dcdMHiB7Lu3Je93AZND3RWSHQND0ZXKxnqVfTq2HZJQ&oe=69E0FEF6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
38677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqblM43O3o8Q7kNvwHQ054a&_nc_oc=AdnQkyk-aHIWPaXU1q6r60hdgp4qavd5tYqCSibnPxEHxL3cPYEUerTWARtk1hx1Ihc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftt3nKAicvM6L2bRNa7s7zrfyrX1Y1reboJivGiADu1AA&oe=69A2D55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t32QgXaDEIQ7kNvwEvB6hR&_nc_oc=AdmDWvHzmc9Gr5V_OOcfYFscViSAC-7V5zldfeiICo4_VvqexQPbAhnlt5SRnS-KRns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYa2KL9aISPct096qGr60QpgXF1WeOJe82_NGFV09vJw&oe=69A2D036"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"
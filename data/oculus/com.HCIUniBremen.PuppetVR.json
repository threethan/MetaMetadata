u_APuhf75M9CclXX8IqP0TLstsb5HeBnWttxCa8jxYbg&oe=699AE38E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtenuweKS54Q7kNvwE2aMMz&_nc_oc=AdnDImAmJdI_KXLzmO5cY-10U4eMxfhIytqxLDkbGEAGwun6y9LISryMg07mbp3ZUbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftzMbrYviiOHC-6V2bN0RuwDtOfthW1dH5aur7RJwXG3w&oe=699AE23C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bsaTAx2jhkQ7kNvwFEW4NA&_nc_oc=AdnJ2Fi8anAOmxboJyeL6jSmZ8NxENQLOScCRbIl2PQYEhe4OM6GrROd02onr8E6968&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9oLhufjZlafCysZF8VdL2Vz96EbfteebwsMjCvY5Uug&oe=699B07E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qyqQ8zoZeIQ7kNvwEnLcLV&_nc_oc=Adkx6HWJAyTX_0vugewakN2MoY0zzCgsABj3MPbT2YmEDo_UIVsCzQ4VkSaxR5CKLzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsARVMtW-LtCXqr8UhGI7761qBQEVj3-frQU2H_ay3Q3g&oe=699AEC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1IM8YAe-zQQ7kNvwEjis2k&_nc_oc=AdnjmNa9_UYnmMBqwtZLnbU7OUIMtJBKVhkVErPMl4QjZlLq6FC_lV4vn3zrHTjWiiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujQSKpDW4JpGmoCJ2DXtjIuXrJAirID6ggXMhkKIHCkw&oe=699AE736"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSIXylTCj6EQ7kNvwEtie6V&_nc_oc=Adn9YHR1JvE3Bs0xoYK10urmRXwdiIuZACqgbpuvme_50KuXym-wCeoWL2VZ_-ZKzmk&_nc_zt=3&_nc_ht=scontent-o
BlcYC_WL9yzgdvgiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywRte-ULCRGNU1z8xSDeagqq0d2bDiJJZEnsc2Hhp_XQ&oe=69B14D0E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F-fcV229_4Q7kNvwECRK5x&_nc_oc=AdniTNsxL-eJExgH84pSG-kCORc4KXu-5VhoiVNeLTQFGuyqOtRCj-Nsf2q3g8yrrAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy76m2XxOsdUrKdpfIMyjJN7ZIuHNRr89CmJlBO3Uo0nQ&oe=69B14BBC"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4RexBFBCh8Q7kNvwHnehMo&_nc_oc=AdmElzBOzxInLOCJ_BOKdseOyrXMvH7wTm4k5Y9HhnVHZQcjNImCy-Huu3u-Cpi4KVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx9dM_0Ga0rVa5ZcYgiJI-k9ZlvNhLqbxoHFjgKajtAg&oe=69B17167"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi6w5JLsHZkQ7kNvwEAdECo&_nc_oc=AdmkDfPtxOnqlse00Od7Fdw3Z_oQePOafVvLNIRfQ33XsFxKGThKcvbFNPNuol7KfEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW8wu96EaSGEDrsXUw1hzowT-7pHc6Zi_xov91hlZ-6A&oe=69B155DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB68BVCo2vcQ7kNvwHURQWr&_nc_oc=AdlzhAPH5v964YJSFuaFu_mPl6Rtms0k1LeCUqHMF07jwVZWETKyeKxR1gvQ_eFW4xE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEpFCPmrvj__UqD-1lYoxbr1Wj0X7VFydG5XojBkzW_Q&oe=69B150B6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P40Nm4m
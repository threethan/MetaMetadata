ss=8&oh=00_AfzdeHokyr4WcFUBWgE3_fjqTKjga6b6QivKgANWZsu4Aw&oe=69AECE67"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi6w5JLsHZkQ7kNvwGDZark&_nc_oc=AdlYTwEwphNkpHFSCM7DUYmgyy5wBBGcH-i4pNykTewCJSjO0zB-aX5iVbWtU2vljJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTPr8r5LysNPDw6OGNGk0aSe2aroT2r8jWvL1DzIogsw&oe=69AEB2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtztU5wYUBMQ7kNvwFpWVQE&_nc_oc=AdmEilG-cBwqBQKSBn6-_NAkmYhVwEb6M0pZwQcObhnr7wAJCmDs0JXX8vhODq1d1XI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-mUnkoepbyAg1Se98dntggL3H5mf11vPZweowAixLYg&oe=69AEADB6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publis
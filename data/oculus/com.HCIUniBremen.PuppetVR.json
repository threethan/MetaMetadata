0E7dnpqPE7JT9-Od9VnFF-qKICOIYBoy0BRcbDDwG7J9pr0F0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5s-KR7lvKtGCnWTumtIwqbCh3NsMVNFNjz-PFkxm-YQ&oe=6A69DF0E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsRrvL35s1wQ7kNvwH7V2de&_nc_oc=Adoh_2jlBxn1CunLAdn4hoxdyA4EZaFJwkrYlUT-KXZlZC_cFf_o9u1aAkEzg3KdfEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4EXbSWqouLBbxCMsUE8Co-Vz8BtHVGFC64U1gD5ls3w&oe=6A69DDBC"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvTpMLBbnBoQ7kNvwHOeQaS&_nc_oc=AdqmI90m3fZl0snCAPwYUn1E_psu2j0S3gzlJYrb1T3z5b0paigIfArK4OTgnXh_st4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcSnY6wGjErf4ZZj5RccXEQbU4qXdEZ8rJKIKqnI0eEg&oe=6A6A0367"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap10yKswcFcQ7kNvwETpaxA&_nc_oc=Adot22sbf8DABzrNSchNh94sqXvPfRnFmttVC82sponjXtKBRF4Z6GhjA9TXXCTcwA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz91pIF47jH5HuccwAJCU74FtAUSXaF6T7IQipVDDmLg&oe=6A69E7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-I0NOVSKwEQ7kNvwHa6lEE&_nc_oc=AdrfNi0mUMcK7brJ5nY4mAj1wQgUICGI7LpN4kIiyYkMG2J3HCkcIg-5eus4nVP_SJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpiZLX1vaf-4VSaufQHj4yD0kiX8M7BEwwXLsjL3c90g&oe=6A69E2B6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
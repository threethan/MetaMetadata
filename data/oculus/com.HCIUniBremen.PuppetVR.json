e6YEcrOWXywLjhtmD1324dvTKZ8SET4fmJGxgXrX8QFVo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5X0jGpnmUIur9eUuHJ4IGIVvTui1-YYMAIDJ_YP_tNQ&oe=6A9746E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiVyE4GXovYQ7kNvwHc-Roz&_nc_oc=AdqXL7CczcX0ImGygZ_f3ZT29BQE5S3gV5yMfTDuQO4JWn6LI1b8rYReSocn4u0uKOM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEphLdUXcrHOXTIYrUZfr3gmOVY-NXIFKujTguaUMulNg&oe=6A972B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0kZQJcJuf0Q7kNvwFA6jNR&_nc_oc=AdpdqKg_qLdgREeDh-ZPQ-DBovi9w-2AunQHPip73OLW-Andpr63E4obfyhp3pRoWF8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjvG8aLNr69Sqo1O86jBrg7ZrGePz1ztgNGgHP2Rk4qg&oe=6A972636"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
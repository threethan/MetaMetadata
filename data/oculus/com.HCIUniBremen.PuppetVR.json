0lR8d-gdFRRMhN_VeKKbnzafpQ6i6G5qmLBmOlALET8jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25h9lJBr2lFRERB8FKsxOQZZm88SyhXvuKOPoqY6r0kA&oe=69E4DBE7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0vlrIjaZVQQ7kNvwHjwDZm&_nc_oc=AdpINspPofM4wURaKDnl-4SFa-jk2F3PSheFRXQ8E9-sAmX8QEOchqR6iWY_vNKHy5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ud7hpoyIG3ncUfEF-DLWhrXIUzGpRi7qsZuv8FN5u_g&oe=69E4C05C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4gYnQyUoOMQ7kNvwElerk7&_nc_oc=Adrr1Bc4GKWRLrvAA3748lBH9ZfHAK4aqOb6M9VP5OxqtzXfnHQLuIAyd2VfcF_mQy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p6aTkXmSXFzKJ-TvvxNGfJLXdqYTc4Gc7Qyue8yeUXA&oe=69E4BB36"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
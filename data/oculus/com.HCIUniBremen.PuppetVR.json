BEW45CgSIfHTAvBmy-PKs5PTqh6M4pw_I0xW2jseai9wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsQrf8oOff5Q4aJcgdVkpjx1rPdho4f0k8V3Kely_H5w&oe=6A830FE7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inC48NrU7HcQ7kNvwHIoGe8&_nc_oc=AdryCtEXp4pRe2AudaH_XLcYihqEmZkqOvs9CzKy6Wh5G4mSRDTFijdWavDbOv00wv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkVShrWP_HX-XFfCU9Ryad4uD7B_kPTWg7UZu388UAoQ&oe=6A82F45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lMJ8EF9DacQ7kNvwF_8yGw&_nc_oc=AdpWQBVqja-denP200CrGMBZu5CFJjyeDOP6ibzZxHftSYHnEm9z21yAshz3yq7HWCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDPzXODRuQk1DRLw4GHYNtmhRsEp_hAWCsw0kBZNPUVQ&oe=6A82EF36"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
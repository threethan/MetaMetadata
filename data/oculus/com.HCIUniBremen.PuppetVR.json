aI59RI4HEIDzZNMOL7vSWU9gewxXbBmWjrs9w5uwn60oY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUFSHf_8DeihDhxmnK9HKkQC9g0ZPlEgbtF7evhQTfEw&oe=6AF0B4A7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cLov4xRvkAQ7kNvwGoSft6&_nc_oc=Adr7UWvFyeWfgSzFB1YdygO__HNXiYPZYMR5j5WQd-iOZnsHgaknnOyfCvvP5cOoa1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDRuyBG5m9TV7yRP97zL8Ho0U2n2YlVK_jJY6VBRpnBA&oe=6AF0991C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUJjUyUwIIQ7kNvwHQ2TLS&_nc_oc=Ados-9CfEAK7VsvOFTu-lAeqHCWMN2_J9UFjr6RciwGtZ2svQ3hz3w_hlOnhWLkiFCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREsL9NzSmY-3vjJ8GydyXmfyshzjknSuSFa6lwHoUOeQ&oe=6AF093F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
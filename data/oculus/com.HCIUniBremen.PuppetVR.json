NWwWmptgsNEULa8zhZB76cGxvJaf8ARNHl0Etvm4Cc8jxocGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwYHmwMmXaUOkBkuJQgBqp_qetNRXUUIZBm4gDFNhm9g&oe=6ABFC8CE"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u2fecX7KgQQ7kNvwGsamXz&_nc_oc=Ado2Ozl1zRFSDql0jesjUJwLoLMnH7gsTNombIYIWEfnTFx3MPdqJQ_CoKSv0YF1iXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0xgRh8vW1HtP8442dtsfLu-AWcfN8b1y19JXa2oL0Aw&oe=6ABFC77C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW2cmk9BIU4Q7kNvwGtkp9Y&_nc_oc=AdpR7xIeh_mBazdjnoQagfBjENYJnGminriznapcpKN8FLx8g_uglGDLhY9VZ9TCDMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFok_bnYeeNY4SniuRixnxc4v9YC7UBxJb1PAFpF7kQQ&oe=6ABFB4E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5WJvoyysa4Q7kNvwHKNyFy&_nc_oc=AdrxXjSAUxLMwaNBKFT4wTJ7tF1BKPL8Hr63WKSBqc5StvLxiTNBFTGjhjpaNc-Wfnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEfFMaf6V8FMVrZ_eV8MeurPVIsiy0NhAsnoOu1sLLOw&oe=6ABFD19C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0nEW2cRYT8Q7kNvwEia8Mj&_nc_oc=Adq3JFJhCMysdLx5J2TGDkf0liOYf150qwZZuTDh8GkuPnbqKG8pPnUu7g0ovoGJZkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqh2mhXH5xu2XS7IFvn046za1YhtiAnwtO8FHoabXKbw&oe=6ABFCC76"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
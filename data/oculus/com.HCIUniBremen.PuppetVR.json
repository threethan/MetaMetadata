JQkJmXqu8M8d1sFwbpI9rpoYCn09mE0UJe9RABRZUPlSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2iG_o9RTCQznaG9amNz1ldtLFyPpq9nFhtDKRxzNvKw&oe=6AA6A867"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAGen0i-dZEQ7kNvwHn5Akv&_nc_oc=Adqr3Nd6jJNAYtV6cpXhhQGjWx01l4hQDVIv4dR7Ihuy02YraIdls2jcxDqbRqzhABw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1T4C2w8snftVMJBFRG6fjxDrl2pm7YilgHN2OclRcsg&oe=6AA6C51C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb0S9MZqUbEQ7kNvwHm1cLa&_nc_oc=Ado4wtjauN8stIrZRkMxD6pbwR1OdBTYvqS_dBAzCsNw52Qh2KV0al-2ZNk76JBhrUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWC5FG0ycBbF6HpgHRSRbXJP3dd7jfKRK2sRnR-_oDAw&oe=6AA6BFF6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
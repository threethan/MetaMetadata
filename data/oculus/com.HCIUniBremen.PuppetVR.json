qjPRXqL_oIJ4bDXZHPIXuQtP1MWd4os86tojHaBUrAfrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E5maSreYQnBE7PgvjMMmty6L9ourZqE0SqCis6J05Hg&oe=69FC96E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmUPW5nN_x4Q7kNvwH7crMU&_nc_oc=AdrllMlhWxklQzw3a2ldoBMal8VQiC1y1oHKK_PnU7eIMii-nhA2LUxKI2Y8ugVuxVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wIj747Q_62HVzQGQkGT4g6S54yoKxQRTwrNasQfgwkA&oe=69FCB39C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jthOkEz76MQ7kNvwGNn8oB&_nc_oc=AdoABUwyHwPdJQS6EWTOomCULngTENndwwqpjdcXD4N9fDD6gKDQNA_w1W5myP0mhio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YRmJHAr8KvLMiDVbN-ohMv6na-FSkwPvaMkKqTDKYkw&oe=69FCAE76"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
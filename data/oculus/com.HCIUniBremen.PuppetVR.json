v_PMdVQ_Z5oJLds2nrjHWLugsqJZ2ugPI5fyw4TxLmyJWYQLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTJlcOEhFGvm5CSPGuigDsQoywZw_1lH8SghiD3efxyA&oe=6AF3334E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wi1sQOkeDIQ7kNvwHfJ_RW&_nc_oc=AdoPdui1QWhEsovvbxeeF8XWnykOT8rN2ntRf_2ry7m80oqVVoMV35Lx7fSU9Oendzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgce-U7KKYhj75ZcD5JTgNKe0dhDFBD9QtCopax4kKzw&oe=6AF331FC"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv1Hf92f-DsQ7kNvwFlxK5S&_nc_oc=Adpe4KcZkoSFZ4_DWIOiSZAKu_gqHqTjj-wjd-D3HFOgdtLjj03JO7xB5j5Wrc54Ru8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvxcoBuQ-jVCQqzBZiAFwnQr_YOBurr0OnD94bcr5Lnw&oe=6AF357A7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xs3K5FMwZM4Q7kNvwEOveaF&_nc_oc=AdpHrdvdsazreaX17Y-XoJNFeJ_Rf6jXLf_jU1COJfK8wt63Br1Ak_4KyQnVRBadDX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX9TV84Qbb0mburG6QrlG0eYigcs3Rte3v41N6OK0omA&oe=6AF33C1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUJjUyUwIIQ7kNvwEvdoKl&_nc_oc=AdqB6McSQRF2YTPUd1KZW4UKmFEH0iBbHlLU_PpH90F3Row7g_GBPZkQTGlyEz4IXY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegx3fRCTgm9V_lobDwPAryKQ471UxHg-QHRpHEXtJCw&oe=6AF336F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
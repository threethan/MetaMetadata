mYdFAh4U2O8MlkEzGdOi-TlJeIZIVhFLXKM6bGS0uiFUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bpv5RYlktKDlmy71zMfmRG7UsLXRLTeeyxaWOvTmbkQ&oe=69F750E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B7jGYi3bLoQ7kNvwHDrxDY&_nc_oc=Adox_wODhOk1N_f6XLW61MQJxbnyfRkJTAvs51DTipixjWhkWOHJvK40wtPFmQ0AAR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cTFBg06lkmK2XI-SGKv9yg3F6QiMkDnRqDbx4Vx4diw&oe=69F7355C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--xVgTnqvCkQ7kNvwGZtBQU&_nc_oc=Adqi7HF9fVSxi9nQRhyj301eU9cgNysYIkrqJLPFuEAXhzYLfvs28Xoan4XDzJ1zphg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UAOFqP6P6CqKAIkKIqssnoXG8VYf1VI_xpD0A70UbJg&oe=69F76876"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
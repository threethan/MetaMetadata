xkvk7R8m3CFlRaZNxequAf4jJd-ql5bYswcxREIKaf5Fg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Rdtz7hS7ax0132tbI0fhxvn8ElikVc-x8h7Zpu8bhg&oe=6A4124E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7HRF8fUAccQ7kNvwELUFiN&_nc_oc=Adpxo1Ug__8XkW7ZXDhgftvp2D8g1t-yIb3VkZLG9UCxf-es1_Ex4ibACpXuTFjoozs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qEzUnlB4Kcf_ayK_Phq-DegxRa9TDOR1AxTY6Qc-3nw&oe=6A41419C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWgxdGtWmcwQ7kNvwEV9l8a&_nc_oc=AdqsVNkU6aASsFZspbK9FYEU1vJk99AzVoo6NF1n53cBSZHajmP6-CApUMeQ7Vc2fBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UjdZeEcj2YGY1XAk2Vxq_GpYKhtcoi7UoGK3E33YBRQ&oe=6A413C76"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
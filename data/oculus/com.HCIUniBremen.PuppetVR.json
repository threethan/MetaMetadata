n8N_IZgIn7QSXkJ0V2zNZST-7HWeyWKJL__2TzRDFYrD0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVXoCujogxlY6pidQauSXpm2fTnS7DBC61xXb44Wa6Mg&oe=6AA16267"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vPgQoFws34Q7kNvwHr7cNw&_nc_oc=AdrMSvJ_mUnpkvyh62pahiePAvn8eMU2Cb63coduEd2RPjkgUF1xskAk6t8z8lAGzio&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF27iPWDNkKLdF-RHIO51D0XRHtsKtufPc81VytcS1rQ&oe=6AA17F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB7Ed63CT8AQ7kNvwHxLiel&_nc_oc=Adqx9gJJ1kiddkVWB9FmjThi-oqixTLoEZlNoen-Cp6yHLaks0MmcokGS4JSw18O26U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2tczYiEeQwwYUwnLnwqVX644nqOktZ0uOMrLiDOYGoQ&oe=6AA179F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
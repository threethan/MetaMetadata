N9_4XCsKtyJ_hQ-tupsPLZAG7jUfkR2BNa-pTQ_OIeFr1clG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGZOV5mHJ_bTi3cLvFBGHtNeGAQnuOAOsXgWf78-8eIQ&oe=6AF0904E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wi1sQOkeDIQ7kNvwEr8nyT&_nc_oc=AdqejNxjBh3ZR_ppDeVfYTPsnujosKPM7UL_vlVfRP2EWjSCAOaJYepLg_-4iqm3lr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkWwukjkbWvBWVsQPA_BAFYMHDjwrOgdHiJErZlVNv1w&oe=6AF08EFC"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv1Hf92f-DsQ7kNvwFuD-_d&_nc_oc=Adr49l1V3GDPkqLdywb5f5aI59RI4HEIDzZNMOL7vSWU9gewxXbBmWjrs9w5uwn60oY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUFSHf_8DeihDhxmnK9HKkQC9g0ZPlEgbtF7evhQTfEw&oe=6AF0B4A7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cLov4xRvkAQ7kNvwGoSft6&_nc_oc=Adr7UWvFyeWfgSzFB1YdygO__HNXiYPZYMR5j5WQd-iOZnsHgaknnOyfCvvP5cOoa1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDRuyBG5m9TV7yRP97zL8Ho0U2n2YlVK_jJY6VBRpnBA&oe=6AF0991C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpUJjUyUwIIQ7kNvwHQ2TLS&_nc_oc=Ados-9CfEAK7VsvOFTu-lAeqHCWMN2_J9UFjr6RciwGtZ2svQ3hz3w_hlOnhWLkiFCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREsL9NzSmY-3vjJ8GydyXmfyshzjknSuSFa6lwHoUOeQ&oe=6AF093F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
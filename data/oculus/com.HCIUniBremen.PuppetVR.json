xXGrwG_CmhjEEqgrpJNfhMDeNd_zmaFJykX-vnz22gkP53ayw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFohUAWWF1mNqWq1_3f8jVV9w8RxcxT3wQdBFdUJYwJ8Q&oe=6A8AD48E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qlk9Xgir8sQ7kNvwGW92zh&_nc_oc=Adrgs8xU009Rd3iYq5_GagNq7KrfvmTctDBp4YjW5akuIPQA39e9txL-edvrIIHA6Fw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNCLWx8sUpkV_m9cSEMygRt-pEVSwKmGJyFdIH6W8p-A&oe=6A8AD33C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BgoaMlSE1IQ7kNvwEXmIWp&_nc_oc=AdrG1WdQ_HDr7r1-RMbxg0_F80H5D7Rc6OAdY8WBs8K020AOxDZvwAhKMtBJyfw7zo8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp8yKYhIZl8wDqiJxRGl2rBC1Z5Kpaik9eKoUIsaj2Wg&oe=6A8AF8E7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ6Kf0NS8kUQ7kNvwHUj2Y9&_nc_oc=AdrBBmmILrrIOTwfP97C65nmeJ9Zqz10_XgRNJ0VV1C-3VZwXApL97J6THTShiq4gGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyqZIXItEhIdrV9S7y3KFoT1lXxiyF_coEdOnIU0qmFw&oe=6A8ADD5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9lrDNOHKVYQ7kNvwE8hdPy&_nc_oc=AdoBElNWm8pCOQa5CW7gcHS13gdTrXz-5JeUkAgG6qSsySMm6atbH7OaXmC99iB2V24&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPLJ6nxNj6h6SHC1Z-VvcVrJUABm6iiRugdfiZJp21Sw&oe=6A8AD836"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
ymWizPROKiTUn9NQSD0a-2Rfg3VbiFzeJkxIZAABve2kOiNdZHjDTB7R0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZX0q812Yws5Jke0p3tQo2IDXoL6kdWsgaOBbU_ZvTpA&oe=6A858E8E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xSNrgJY620Q7kNvwHpWe1y&_nc_oc=Adq8EcGnBtbdgAIGZnn49Dir0SU3fbV-gzvHPmgqR-WqJeYEzhyZJfHbBpROr79TYtI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXbAbICF9Ev6uPX3xD-UPKB4VPLuLXw0dV4S6KZbeC1Q&oe=6A858D3C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUrt1uUKCisQ7kNvwGw90gW&_nc_oc=Adp6EXspDBh7e7-4wKSJkYcLjs6jmDMta3r8HCSkzALG0m7qxvMEcLXUyskcw0FLFfw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW0NsB1baRdjfPKJi4Nc3a2ahRwNrhzbPJRB8B_16WEw&oe=6A857AA7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXWOS7shGZYQ7kNvwFbarPr&_nc_oc=AdqyT37v-WD8mN-PDGMNvDORKWzjzl9O_sMPoX3tRgc72gPgrnIR6IYDusKq33yZbik&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI0NhzCJCU2nWCK_1MHy6q62CGautk87lj_FFi6Ez29g&oe=6A85975C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vKrQLguOZkQ7kNvwHiO4uk&_nc_oc=Adocpq49jc-LIeEEguHnd8HcLbRtN5i206chK44PXU80gsS8w0KTbXB0j4fZRTcKCak&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLXPbR-h5DKagrzQnI0h2x6x5eCWE3lrIyXu4uqKIHvA&oe=6A859236"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=
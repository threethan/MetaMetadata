wQF4ktsVnIiFBT6bIv9RM9gMiqNUGRssFN-y-0Ni8Hd7n3cms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKHKNbHRXnpJqrYqg-1we29Ose2ZH4iXpuNhYVqiVog&oe=6A88318E"}, {"file_name": "group.png", "id": "1007647490173357", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75556794_1007647493506690_969901375931825336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xSNrgJY620Q7kNvwGBkxLd&_nc_oc=AdohDQg5Dj4i69_ZND_MUo1deOETJau5tP-WfurQNub7jN15d3Bg2HbQ-WYuDwprG9s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAH4ZqtrdTiX87PiLC5pI1_1nuypvam1NrWWRVV24ZBg&oe=6A88303C"}, {"file_name": "panorama.png", "id": "496955411874442", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86629760_496955415207775_421616206781036106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUrt1uUKCisQ7kNvwH4xgBW&_nc_oc=AdpFNx-D3N5EUOakpOVQ080g2J1nugaZub0Uk4q3e4uS6mUZ8Sxf8j5DcdkDcIYxGIU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTirUEPzoSXDJi_PtlOjIRwp7H1aImuHKqjwbRkfPNCQ&oe=6A881DA7"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ6Kf0NS8kUQ7kNvwGqNwgC&_nc_oc=AdrLjmjGgHGaYntbb9VD1xuXprCD1VV1IORmlBQuv7CajnCExSKs--eIqlvADb-CrPY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnRAwwP9AIPB8-3H1Ip_9b-VN2I9x8Rtv_7MjjCEoUCA&oe=6A883A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vKrQLguOZkQ7kNvwE8BT6l&_nc_oc=Adp4X6DAzZqy6zPOd0xuCAojnLRq7yFTZ26Bv2zc2ng7ZJhpyBs3DCitOrqaFT0v30k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECRHl_YgViZ5Gf2CuB7T5Y0GOB8oWUProZb2cXX8Fu-A&oe=6A883536"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url": "https://sites.google.com/view/puppet-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HCI Bremen", "support_website_url": null, "website_url": "https://hci.uni-bremen.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "736947294141850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210389_1354052845059219_3833622464857012211_n.png?stp=dst-png_s360x360
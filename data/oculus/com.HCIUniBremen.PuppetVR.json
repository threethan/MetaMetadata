m-7W7UR5JKEBTIHTqybGFth4rkUh9VFNnMIb-9a7yTzPU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3s6yYIzsSSM2-Diq6PQ7Rvb1n4394YLPMFnt3XkVeGg&oe=6A71EC67"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGFYqs2GtZIQ7kNvwFJONoe&_nc_oc=AdrEH-fPoBcopokRxQSkJsGF0gxs1UjWARxVYydZHiXPvwn6kQBCYxQ9KhegVitlR4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFhpeVUzv259Q6QvRP5ggm9hmwLV02MEt-7HFkslByQ&oe=6A71D0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWP09UaIUtIQ7kNvwEeyHU0&_nc_oc=Adqu5D_E3-WTzBdRU_pEcRoa5x_j7DseFY7wZa7sI3UsPq7aamwixHbOSJPQJTs--d4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoDf8Yl6KjLRIb3gf4kPww7giuB5CPHGLhcfejG7grWw&oe=6A7203F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
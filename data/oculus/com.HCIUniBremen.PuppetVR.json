aGD7XQxgx2wIGWNeCYc3SFx0RG8bGZ0ICBQFO5oFrzDYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4NbXoa5DJny9Gn7HCgIjXOF5uXNo2NoTFvUFllPEryg&oe=6ABBC067"}, {"file_name": "peek.png", "id": "1009464856621649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_1009464859954982_7090744758627338677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ypXfvjQOYQ7kNvwF0NfQ0&_nc_oc=Adoy_GNctiO6P1ssorUKcKmmd7tjsXFgLBCTTQa1L0jzfkpo0Eq8FuLEdlMc7wKDkMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ2_Y3vDHQA2AIkpUKSJa7dZ0Kdb5u0X3-zgZmBW8-gQ&oe=6ABBDD1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "636604377435150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_636604380768483_6976895474501699949_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5HCTxMqaKgQ7kNvwHf7UWO&_nc_oc=Adq8RZDcg1OSBXpDIhcQtszh8D43X8GUAMJMNeH5ML5Zw8U81Ze9YU-8EOcnphW91SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWgQd93OjSaPMXuYP5Vz_W0OnXLVs_pfQhic60rq3Kvw&oe=6ABBD7F6"}, "display_name": "Puppet VR", "keywords": [], "long_description": "Puppet VR is like a virtual puppet theater. Pick a bunny, make a recording, repeat. Improvise a funny scene, or have conversations with yourself!\n\n**Features**\n- 4 space bunnies, controlled by YOU\n- Record your voice, movement, or both\n- Play back your recordings - all 4 at the same time\n- Play in Quest Standalone - no wires needed\n\n**Your creativity's the limit!**\n- Create funny scenes, with yourself from the past\n- Go a capella, and make the bunnies sing\n- Host a bunny dance party\n- ... And more!\n\nPuppet VR is currently in development", "short_description": "A virtual puppet theater where every actor is YOU!\n\nControl up to 4 bunnies at the same time, and use them to make a movie, sing a song or host a dance party - your creativity is the limit!"}]}, "developer_name": "Daniel Tauritis", "developer_privacy_policy_url
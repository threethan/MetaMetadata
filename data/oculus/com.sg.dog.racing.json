5302829_3082498694059130880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNEEpKI-90oQ7kNvwHXPC9a&_nc_oc=Adpv1mmj-oJrO_iaDlZDhSf80dpZzEwBnIOv5o7CYAqlS6JbW9elxFV-DEqkGO4eTIg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw479EajomwiYDhvCLme_lMc_Lr-uVRtULyb3oGnCVREQ&oe=69CBC1DE"}, {"file_name": "migrated_image.png", "id": "2683076705079400", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162696_141055923175427_8157192194269118464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL4BievxRNYQ7kNvwFsJIIr&_nc_oc=AdqBwc7kEHPMK2Ae-yDrmN-SmxOV1mwWiwA3yqfQbmBfsvpkwKnhGfZ0lDZo9MxKa5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE53GIZP_OHA62pPnViaNn7ndwrrSRpn7pgCXl6b9vWQ&oe=69CBCE78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Racing 3D", "keywords": ["dograce", "racing", "dogs"], "long_description": "Have you ever wondered to run on the race track? Experience the ultimate dog racing VR. Get the best 360-degree view of the virtual stadium.\n\nRoam freely in open racing environment to see all kinds of racing dogs lined up for the ultimate crazy dog racing a newly VR designed racing game, get set and be ready to run as a speedy crazy dog on the racing tracks, see the audience cheering the best dog breeds on the race. The derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure to be into the racing stadium along with several dogs ready to gallop for the run and chase.", "short_description": "Derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure of racing in virtual stadium, get ready to gallop for the run and chase."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thegamesbyte.com/privacy/", "developer_terms_of_service_url": "http://thegamesbyte.com/privacy/", "publisher_name": "Solo Games", "support_website_url": null, "websit
87_1716732425302829_3082498694059130880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6om8fRijoA4Q7kNvwF7H4qA&_nc_oc=AdrBc3VBqPCvepLsrMnNkL6z_6f65VR3kWv_I7cEhhVX91phwaNxoE3mOocIG1mLrlE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MaMT2pXmGgOjWIvW-zx7Mn_BcuTQnNQNXCnSm_I9YUA&oe=6A36C39E"}, {"file_name": "migrated_image.png", "id": "2683076705079400", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162696_141055923175427_8157192194269118464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpNN-rtd9ZEQ7kNvwGniumI&_nc_oc=Adqk1qaZdmgfzz8UaUOadNZ-THZccaEvCodg_yvD_0mMpbrY1CtLuXLnNxOv7BpceZo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gputQNZ6u0umF74eGMW8JPRycHaAFv_QxLtB3dHpQlw&oe=6A3697F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Racing 3D", "keywords": ["dograce", "racing", "dogs"], "long_description": "Have you ever wondered to run on the race track? Experience the ultimate dog racing VR. Get the best 360-degree view of the virtual stadium.\n\nRoam freely in open racing environment to see all kinds of racing dogs lined up for the ultimate crazy dog racing a newly VR designed racing game, get set and be ready to run as a speedy crazy dog on the racing tracks, see the audience cheering the best dog breeds on the race. The derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure to be into the racing stadium along with several dogs ready to gallop for the run and chase.", "short_description": "Derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure of racing in virtual stadium, get ready to gallop for the run and chase."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thegamesbyte.com/privacy/", "developer_terms_of_service_url": "http://thegamesbyte.com/privacy/", "publisher_name": "Solo Games", "support_website_url": n
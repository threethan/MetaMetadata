8D2ZlDRTxCrulbQptaShAYLe0PkJiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhhErSQiZE0tv836ZLVRgOHsI7LuRRiHNa8ifbmNg8w&oe=6A8C4978"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Racing 3D", "keywords": ["dograce", "racing", "dogs"], "long_description": "Have you ever wondered to run on the race track? Experience the ultimate dog racing VR. Get the best 360-degree view of the virtual stadium.\n\nRoam freely in open racing environment to see all kinds of racing dogs lined up for the ultimate crazy dog racing a newly VR designed racing game, get set and be ready to run as a speedy crazy dog on the racing tracks, see the audience cheering the best dog breeds on the race. The derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure to be into the racing stadium along with several dogs ready to gallop for the run and chase.", "short_description": "Derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure of racing in virtual stadium, get ready to gallop for the run and chase."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thegamesbyte.com/privacy/", "developer_terms_of_service_url": "http://thegamesbyte.com/privacy/", "publisher_name": "Solo Games", "support_website_url": null, "website_url": "http://thegamesbyte.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mod
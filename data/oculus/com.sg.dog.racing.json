5302829_3082498694059130880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuxX68y1E6gQ7kNvwFRJq8_&_nc_oc=Adq9dT1Cp-_pCwgggMxSBi5Y3S4GgA_YpCmBs3qG1O0H6lloHFm9W1lMHu9Cn9FUVD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLbYc4pQcZXiHFGKMS_UJNnwfCE0L-c23fOYIAPnzFIQ&oe=6ACD0E9E"}, {"file_name": "migrated_image.png", "id": "2683076705079400", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162696_141055923175427_8157192194269118464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0urWk4fylsQ7kNvwGSGgTH&_nc_oc=AdrP89HPP99DLEgGzsiiCufHAr41witYVmsikTyG0jS627xusP4iQ1w1H6OssfuTCLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAjVOTx-s1QABDTBsks0wNk9KStE72pTd5OWPfc8nRYg&oe=6ACCE2F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Racing 3D", "keywords": ["dograce", "racing", "dogs"], "long_description": "Have you ever wondered to run on the race track? Experience the ultimate dog racing VR. Get the best 360-degree view of the virtual stadium.\n\nRoam freely in open racing environment to see all kinds of racing dogs lined up for the ultimate crazy dog racing a newly VR designed racing game, get set and be ready to run as a speedy crazy dog on the racing tracks, see the audience cheering the best dog breeds on the race. The derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure to be into the racing stadium along with several dogs ready to gallop for the run and chase.", "short_description": "Derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure of racing in virtual stadium, get ready to gallop for the run and chase."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thegamesbyte.com/privacy/", "developer_terms_of_service_url": "http://thegamesbyte.com/privacy/", "publisher_name": "Solo Games", "support_website_url": null, "websit
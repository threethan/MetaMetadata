5302829_3082498694059130880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq796hoktbQQ7kNvwGP_BkD&_nc_oc=AdqEdkBCG_B_W_IQtWNCPQyYUuW7bvnS6iDpMek7yKx1DC47SLdKCNIAOz2T_M7udG0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Iu4RNHf93UAyTGK_gAaKp5rxroc3yiET1diVlo9srbw&oe=6A2BFF5E"}, {"file_name": "migrated_image.png", "id": "2683076705079400", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162696_141055923175427_8157192194269118464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fz4rJVQkf2IQ7kNvwEGwJ5-&_nc_oc=Adr7QqmBJ7I1ySd6X-pS6M6XpzhY_aaCWNQV0RB5Ub7rcsY-IEnL1xmMEkH9mxAvUN0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uyVo-Ypc8sOtFRqUPVZSsD3nNll98xLakDHo-v-moiw&oe=6A2C0BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Racing 3D", "keywords": ["dograce", "racing", "dogs"], "long_description": "Have you ever wondered to run on the race track? Experience the ultimate dog racing VR. Get the best 360-degree view of the virtual stadium.\n\nRoam freely in open racing environment to see all kinds of racing dogs lined up for the ultimate crazy dog racing a newly VR designed racing game, get set and be ready to run as a speedy crazy dog on the racing tracks, see the audience cheering the best dog breeds on the race. The derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure to be into the racing stadium along with several dogs ready to gallop for the run and chase.", "short_description": "Derby style dog racing mania is a fun filled virtual reality, start your dog racing with stunts and jump, feel the adventure of racing in virtual stadium, get ready to gallop for the run and chase."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thegamesbyte.com/privacy/", "developer_terms_of_service_url": "http://thegamesbyte.com/privacy/", "publisher_name": "Solo Games", "support_website_url": null, "websit
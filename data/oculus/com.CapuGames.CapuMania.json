dn.com&oh=00_Afu82Qm4lSVGlhboCiYxig84x0lUTjQkEF5nBd6GA2VaGA&oe=699ADF22"}, {"file_name": "Untitled design (5).png", "id": "886276807550728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299922_886276814217394_5435089921259868100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxy8LmQJHGIQ7kNvwFox9bX&_nc_oc=AdnTKzCs8NG7urTHbECllKZEMnXCyFpwRnh9PVE6HWXLeXlgho67aDDLpJFRieBpo-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuRRRNRs1-AUEp6SnI15jvO5F2VK68R-97Fhf9eKU-cxw&oe=699AF958"}, {"file_name": "Untitled design (7).png", "id": "1447475170310297", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308184_1447475173643630_4155520991760623319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ImclWw5mhgQ7kNvwFWhWF8&_nc_oc=AdnQZDdkI0WWoQ8G36iDMbagVDS71IWuy5OAZxjxHHalu9aYQ_w9BG3TCNWGlofCDk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs2Dxearx0SRBuXoMI1ke6ZV8N0fY-3ghVXfEv5U8Nd5w&oe=699AEEAF"}, {"file_name": "Untitled design (6).png", "id": "25579129355103832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299922_25579129365103831_6852211002599575496_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPVLTV-cw-wQ7kNvwFItDEb&_nc_oc=AdkSM-4qCms0zUHvJSBYgv7KT2W9I4ZfhoBA8kWdB5lOUS3OoPPxyTwgAT1jabuuSmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsUScp0_D55TQQMRaKCPsThdNaB_kJVEprmtoQNty-Ryg&oe=699B1433"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capu Mania", "keywords": [], "long_description": "Capu Mania is a fast-paced movement-based multiplayer game inspired by the tag-style locomotion you love. Swing, climb, and outplay other players across unique custom maps designed for nonstop fun.\n\nJoin a growing community, unlock tons of awesome cosmetics, and express your style while competing with friends.\n\nWith frequent updates, fresh content, and exciting seasonal drops, there\u2019s always something new to explore.\n\nJump in and start moving!", "short_description": "Capu Mania
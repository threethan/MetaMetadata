dn.com&oh=00_AfuQnDx7-hSS1tSEPBamovAZhPLQncEunCJq4X5wDKhaPw&oe=69A176A2"}, {"file_name": "Untitled design (5).png", "id": "886276807550728", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499299922_886276814217394_5435089921259868100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqKsal-7AHsQ7kNvwGhZqQS&_nc_oc=Adk9Tfc-6PMpcuSW9Iy551optpOHj5z74FUAIN544KRYNNGpeZspr-3lfjOkp2Fz6wU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvRShyqUtZrdbQiOMGGGllPK9NN-BAvPgpzg3aTNfjgyA&oe=69A190D8"}, {"file_name": "Untitled design (7).png", "id": "1447475170310297", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499308184_1447475173643630_4155520991760623319_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y7fDFyEwvYQ7kNvwHLHReG&_nc_oc=AdnIggXTkBZJMgLZN0z8O5V482U0jw7XCgNbb_utIRp5pwC7HHISEJVc41vni5SRxIE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsY8J8ewNT2Dr2dRG-Wt7SisHHVQjxFA6xh3xZkmJXHnw&oe=69A1862F"}, {"file_name": "Untitled design (6).png", "id": "25579129355103832", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499299922_25579129365103831_6852211002599575496_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHlO22-IfigQ7kNvwFmBNiC&_nc_oc=Adl03OkHvclSiwxtwffaWzcXh6WfW7KcWW4WDLhy_MHE6HL6KuPOMKV0WGQgaIbTbjw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv2BcRBRhPAWOrUkpmBbXnzPIIO28Nq0QUti48NG1wYyw&oe=69A1ABB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capu Mania", "keywords": [], "long_description": "Capu Mania is a fast-paced movement-based multiplayer game inspired by the tag-style locomotion you love. Swing, climb, and outplay other players across unique custom maps designed for nonstop fun.\n\nJoin a growing community, unlock tons of awesome cosmetics, and express your style while competing with friends.\n\nWith frequent updates, fresh content, and exciting seasonal drops, there\u2019s always something new to explore.\n\nJump in and start moving!", "short_description": "Capu Mania
6_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI3o7FM2zPgQ7kNvwH3m4wJ&_nc_oc=AdrBxX1tBLgCWJGu5QNay8OjFBrkP0zCSrP5yZNGCM4ML3TtpPmV88sRVtWbd5h7F7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJIgTtMf-nTuPbxWHnA_LClVg-WrwIM3hGfUcCYZsWng&oe=6B01CF99"}, {"file_name": "Screenshot 2026-06-15 221617.png", "id": "852351740855785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_852351744189118_5962130948350866509_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olOZCjrSP9cQ7kNvwFxvSK1&_nc_oc=Adq4LBDvYyQibnrJWp_fW2JW64XLh-jHNIIdyN8NRSEWIXZA12JulYw2Sp61fzwm5EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIAXl1RepcYQVV23z4Mvw-gLetLSRUu3jQIYXlbXnCqQ&oe=6B01EB15"}, {"file_name": "Screenshot 2026-06-15 221705.png", "id": "27632229343078750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312470_27632229349745416_4885155884338593851_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwqS35Bg48sQ7kNvwFP2KC0&_nc_oc=AdpUP8Mm_VhFikC-e32kK3liFCXWZZv2k8P1ucFfJVHatDdZkIWAZODXEDGL8OUN4Ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5OA_Of8TwHOfXDU3MJWLbb0AI_ba6vq0wZYCpchYAfA&oe=6B01B866"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreamspace", "keywords": ["backrooms", "multiplayer", "liminal", "dreamcore", "gorillatag"], "long_description": "# DREAMSPACE\n\n**Welcome, to Dreamspace, a liminal spaces, backrooms surreal game made by Emre Aras, originally inspired by WorkingClassDuck's backrooms game, I bring to you a new experience solely focused on eerie horror, liminality and giving players a sense of unease and nostalgia. Go through the works of ASYNC mixed with dreamcore liminal spaces and uncover the secrets of this dimension..**\n\n**The tense buzzing of flurosecnt lights never stop and each level you find, feels like another world, and every corner you wonder, every corner you don't see, your mind fills in the blanks. And that, is what a true liminal game needs. A different game, that stands out from the rest.**\n\n**There is much more content to arrive soon, the game is in early access and is not a finished project at the moment, so you can expect many new updates frequently.**", "short_description": "You find yourself trapped in the deep trenches of liminal spaces. And you have one goal."}]}, "developer_name": "EmreAras", "developer_privacy_policy_url": "https://sites.google.com/view/dreamspacepl/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EmreAras", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamspacepl/home?authuser=0", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27254644287526474"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507823854_988444257500519_8120423152393937537_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhWnstirlUcQ7kNvwESVWMS&_nc_oc=Adq2lau0UGYVGG3J46dgHcz2-lEOCNiY-y4WqAkEFlYFFf688OGDJT1fl1vs9Fvtrl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP5T26c8kNePAi5zFn014hX4uZtqBVPlKzPdDHK
&oh=00_AQJ6WXsQxML4zt85PXjxiPnvvqOSAXjDoayFo79lJpJiPg&oe=6AB12BD9"}, {"file_name": "Screenshot 2026-06-15 221617.png", "id": "852351740855785", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_852351744189118_5962130948350866509_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OGLdT-0FiUQ7kNvwFfssc5&_nc_oc=Adr8sB4NapxUkuJ2iwfNnhGMaCA4-jVHK7Qj9wewswQ1CYxieTmYUcggT2xIFPHbzFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLwtoARKCr3zP_HzENCm6oZke9WHVrjj8PwDt8fAD1ZQ&oe=6AB14755"}, {"file_name": "Screenshot 2026-06-15 221705.png", "id": "27632229343078750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_27632229349745416_4885155884338593851_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKo-HWGEzEwQ7kNvwE7Vu6L&_nc_oc=Adq2sc25aoRYX3S-ofww27-8YKgbG00PwqjQIRWdpLZrVzkxJaYveqkGypWMVZjGrAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh6Iz_9ruAmn5VujOrLBemQHAo61wndANhbVgkQ7Nh4Q&oe=6AB14CE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dreamspace", "keywords": ["backrooms", "multiplayer", "liminal", "dreamcore", "gorillatag"], "long_description": "# DREAMSPACE\n\n**Welcome, to Dreamspace, a liminal spaces, backrooms surreal game made by Emre Aras, originally inspired by WorkingClassDuck's backrooms game, I bring to you a new experience solely focused on eerie horror, liminality and giving players a sense of unease and nostalgia. Go through the works of ASYNC mixed with dreamcore liminal spaces and uncover the secrets of this dimension..**\n\n**The tense buzzing of flurosecnt lights never stop and each level you find, feels like another world, and every corner you wonder, every corner you don't see, your mind fills in the blanks. And that, is what a true liminal game needs. A different game, that stands out from the rest.**\n\n**There is much more content to arrive soon, the game is in early access and is not a finished project at the moment, so you can expect many new updates frequently.**", "short_description": "You find yourself trapped in the deep trenches of liminal spaces. And you have one goal."}]}, "developer_name": "EmreAras", "developer_privacy_policy_url": "https://sites.google.com/view/dreamspacepl/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EmreAras", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamspacepl/home?authuser=0", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27254644287526474"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507823854_988444257500519_8120423152393937537_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9sJI1nRtC0Q7kNvwEsq7p4&_nc_oc=Ado3XoTpHUznGqG2uAWNRlTkVZNsiDJYYN46SrtkMuIWzlCjrANncRAJV-BGgLd13lQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA6MstTAicdDg3WcewVTNMoRC2hJX8mSUip3nrmTPODA&oe=6AB13B9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamspace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name
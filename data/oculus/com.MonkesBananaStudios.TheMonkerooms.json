o you a new experience solely focused on eerie horror, liminality and giving players a sense of unease. Go through the works of ASYNC and uncover the secrets of the fluroescent buzzing of bright lights, damp walls and moist carpets, or commonly named \"The Lobby\".**\n\n**However, many more levels await you, (the game has a limited amount of levels due to a rework), each level giving you a spook or a sense of... nostalgia.**", "short_description": "You find yourself in the damp trenches of the Backrooms, filled with aggravated monsters. But you are not by yourself."}]}, "developer_name": "EmreAras", "developer_privacy_policy_url": "https://629b3ad33c175.site123.me/services/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EmreAras", "support_website_url": null, "website_url": "http://629b3ad33c175.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24963566759967583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1184945876838195_7627467005832963258_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkIQqATdTaEQ7kNvwGej3O9&_nc_oc=Adk4O9EEeG7FkuX2ViPG1enEfvbXGI-FyXldobdoTj_Xy_NznWkHq8x-Oi__KWSFa8w&_n
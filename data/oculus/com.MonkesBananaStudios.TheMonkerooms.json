n.com/v/t64.5771-25/38982658_5493934930665785_8107963090134508430_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV-C09XWKBkQ7kNvwHfPfZT&_nc_oc=AdndnllnoKLfd0bx4WiHYSYY8lp5MbVmyZ3KoWBuVpH6I-NqQuvLBRIMCAuiUGpdfp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUZhsY2Y9Ehf27IUJxqkhCmmdVI0n9BUDvInI81GvyLw&oe=69BFE171"}, {"file_name": "monkerooms screenshot 5.png", "id": "470115025022582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_470115028355915_3696168826140103867_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXIGVbUxfG8Q7kNvwFfQVxn&_nc_oc=AdlZPWNYCIVOkSIXDI1liUUcdISceZE_GwyUki84TjbNMWkMvf3SNFe9XmNcuAUfx-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxB01IUykaPprgNlPYbvJKrFVbDAJD8imwLulkEiGJaUw&oe=69BFDF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "monkerooms cover image.png", "id": "363647805977785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974792_363647812644451_8970635053901339711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vsCeLpJk5kQ7kNvwEF0WKo&_nc_oc=AdkItLKbY2uUkh7XyqZ2VFJKNho4Aba6cmPsu_9InCv7fsM0_0oXsbK9UiLtBdtByCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbF7cDoTS-TgdDne22ZRsEZ5kJsm4bpUHtHx73rBla8w&oe=69BFEA2A"}, "display_name": "Monkerooms", "keywords": [], "long_description": "Run, hide, be a explorer and don't get lost! watch out whatever comes in your way!\nYou and your monke friends are exploring the liminal spaces, but god if you hear something it sure has hell heard you.\nYou need internet access to play with your friends, you won't be glad if you don't find other explorers.\nYou will be chilled to the bone if there aren't any other players but don't worry your never alone in a liminal space!\nthis game was designed to give information about the backrooms and what would it be like exploring it with your fellow friends.\n\nThis game was inspired by workingclassduck's backrooms game.\nHis game includes monsters, multiplayer and gorilla locomotion!\nSo I got a little creative and have made the Monkerooms!\n\nCredits to stereo monke aka ( creator of mouse runners ) for helping me with the game!!\nGo check out mouse runners!", "short_description": "run, hide, be a explorer and don't get lost! watch out whatever comes in your way!"}]}, "developer_name": "EmreAras", "developer_privacy_policy_url": "https://629b3ad33c175.site123.me/services/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EmreAras", "support_website_url": null, "website_url": "http://629b3ad33c175.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1136061217041631"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1328090234668897"}]}, "baseline_offer": {"id": "1328090234668897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1669677480, "status": "PUBLISHED", "id": "1328090234668897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25025728150418110", "version": "17.6"}, "id": "315601014089955", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5389750207775863
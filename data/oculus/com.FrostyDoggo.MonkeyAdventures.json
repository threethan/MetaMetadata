xiom LLC and is not endorsed or otherwise sponsored by Another Axiom.", "short_description": "This game has unique locomotion where you play as a monkey and run around alone or with friends. What more would you need other then to be a free monkey in a big world!?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/calebplayzgamez/Monkey-Adventures-Privacy-Policy/main/Monkey%20Adventures%20Policy", "developer_terms_of_service_url": null, "publisher_name": "FrostyDoggo", "support_website_url": null, "website_url": "https://www.tiktok.com/@frostydoggorr?is_from_webapp=1&sender_device=pc", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6489088331169655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031620_246370521321707_8232575531411222805_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tYFhyf7TwgQ7kNvwEdb5ZJ&_nc_oc=AdkjjJEjSqnGAkuS7bHBVEzpRfBPOGSjN4kO1Z1h43VgzGsitRysv-cet1aJWk_ZEOg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzT_fhGVVEiWgy4SfCez8QDPytt-7O9QQWi7zGmG1Cgig&oe=69BAA323"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Adventures", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1685556000, "lastRevision": {"nodes": [{"id": "6112219885523170", "release_type": "SCHEDULED", "administration_status": "APPROV
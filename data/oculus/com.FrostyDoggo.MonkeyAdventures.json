C14F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled82_20230531012809.png", "id": "1332244060660435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035456_1332244063993768_6786363199502519352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYUGMKzPzE4Q7kNvwGSvL9J&_nc_oc=AdpN97iH1PT6_4sjGpYYtoYCtBt3a4FIKJmrqAOG6loHRrAaiuN0hSyjUlCSd_Rbq98&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2vsPO4H-T36doO-ShDjasn_vUveyX3cC4rIDRBEiLnQ&oe=69C13BE0"}, "display_name": "Monkey Adventures", "keywords": [], "long_description": "Monkey Adventures is a multiplayer VR game for Meta Quest 1/2 or pro. There are multiple maps to explore being the main map Forest! The best part is there is a custom username system and custom server system. Explore the map's with friends in this hangout like game! This game is heavily inspired by gorilla tag. \n\nThis game is not affiliated with Gorilla Tag or Another Axiom LLC and is not endorsed or otherwise sponsored by Another Axiom.", "short_description": "This game has unique locomotion where you play as a monkey and run around alone or with friends. What more would you need other then to be a free monkey in a big world!?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/calebplayzgamez/Monkey-Adventures-Privacy-Policy/main/Monkey%20Adventures%20Policy", "developer_terms_of_service_url": null, "publisher_name": "FrostyDoggo", "support_website_url": null, "website_url": "https://www.tiktok.com/@frostydoggorr?is_from_webapp=1&sender_device=pc", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
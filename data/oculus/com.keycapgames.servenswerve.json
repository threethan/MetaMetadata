_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OLdSXWujHkQ7kNvwFBE1tk&_nc_oc=AdqRcPuimPukoQ0spIsAbACwwTHHdGtnValFOrXWjhx3bajZ0tT-txN_Gvqf8rsWgpc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG7HEyhGEiEhEfAT2vnA35803bssvx1mUSXN82JS3jQw&oe=6AE8AF81"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf6QhC86p0UQ7kNvwH254bE&_nc_oc=AdrDi75czXP6SrnUlsBymZaOjc2VjD5-bMuu-YSlEb8O7wZLeODwnwwnknqcRwNz00o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLBxHgpqnhHxa_hmlwiNXjOEcITPmi_cfQnVfSTE5MA&oe=6AE89928"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-ElcvYsbw4Q7kNvwGj9Poh&_nc_oc=AdrTWqxd7QCHASuBwyxveeIDIxya34BaBDJePAReCkKI-b1VyR74VSQbrHcpY6eFCF4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Ms9U8kuFsjMONYm1-2VkI6vakak6OpJO5EisVg74TQ&oe=6AE8AA61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekudyTbZkNYQ7kNvwGfXHLL&_nc_oc=AdoidQxYebI5OXDC2s9wcKxvVC_4zD7u8g1JR7J-I77i0sDlbCO8Mi9bwkwOe4Q7A44&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyUElKmAh3nbW6PssnwilFtEfXqpMSwBUte1d3DUrLYg&oe=6AE8B15F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMdLOKJ8eVMQ7kNvwESAUWt&_nc_oc=AdoknPhRmndelg_Yw5RB8GrF9d8KKDU6i0KLxZjy2Z9iceJYGSGiIlikSE9O6MVP_x8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQBU-FfmEn72cztmpn6BrcTnDzILBojpU6FkAmg4JHMw&oe=6AE8AED7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6xzpzz7tfMQ7kNvwHH3hI4&_nc_oc=Adpq1AZfVP0xoOsSqGi5_UOmK7kjC2DhFqTRG9lGGjjKQ4tf6tIDBOpldRkqg3K5XGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PYp3mAVZYPgvtp5Jw26Z39b029FtBGVQyYAgNwSP1tQ&oe=6A2AD781"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAglNJ04gpMQ7kNvwEftIc2&_nc_oc=Adp8Rkh2NF4fNgPUidWSX9NntNkYmQgapyryX-J43XPp_HnURYsv6w-I759eHPKHyc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cpo9_mO6wRnPGAu3p-jZnHGtfwmfC7lbG2wTl6Kr0IQ&oe=6A2AC128"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l05-ae8emgsQ7kNvwEclcO9&_nc_oc=AdrRI2bIq-sPS-qNf8lvpFUcljx9johwuRZi4s9G-N5wp9GpMG9fvBQMoZCp8k-LOA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cVfwBfpuyebbSuBnzfc0KEyP05boCuviwweOc-8d53g&oe=6A2AD261"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0YxF8MMfFMQ7kNvwH_1GfT&_nc_oc=Adp5cdpiyAHdIY-AleW4qPknWzlwkwjgHmXK2O-oqjQ09g3LLObCal3DtXZv9Yk08ZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cok7bjLzEKKwoXplhc9z8PwKlpzhH-ZLI2pGSILZbwg&oe=6A2AD95F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqIXVIrdbRcQ7kNvwFNjgDi&_nc_oc=AdrRoNv48df7J9zaUXb44KnpPncDnlTi99NJQcEL3vfMTfPSQbSA9rx5gYvuq2-7_Gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V6pVZqsdHtDqu86LfwxUtixSwbEraOqeapDrlYu6xhA&oe=6A2AD6D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
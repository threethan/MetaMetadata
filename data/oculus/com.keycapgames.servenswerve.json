_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR6IZ8lQyXYQ7kNvwGBGMl3&_nc_oc=AdplYDrJW_gH1HSd9lQpKSVTHuTctOKCo6PdWsYAIsUHHHWD5ohMSIZydTauQqUiA9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cZjD79UVV6brsHduawCMPkfFIrKI4T-PjbRbndTSXrg&oe=69DA33C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W28e6QurzIQ7kNvwGwXUki&_nc_oc=AdruDmtQCSmAJKk3IuoO7AlR705PR8qQusHJVm6X3BXvM8g7mBss8Sn7Mh4vSaAWbos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fycaE-nzD5TYmZe8aUJ7Tst4SV-llWq1cLZKNVVlsGQ&oe=69DA55A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLwpd8JpZS8Q7kNvwGeqn1X&_nc_oc=AdrCGGhnn01mZF-5YrxsK2KFr6XHP75evfXjOfUp96f3BNY218yJ9tV_OSDIhuXYvXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ws_xsB2g-rgJ6ysbKkPMWWYHFnZ8GFO-4D_YdF_yKYg&oe=69DA2EA1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q_EhIEbhJUQ7kNvwE89xoy&_nc_oc=Adqcfg4QB7Regqu_T6jDbV4fBXYIXID2JFdOjkXA64vG3muplqSe6uJJ6HZOl1OqL1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UxAUngEpMkV7zRyoO8HeLcpvlmoCXFQqW8U7fHdjLsA&oe=69DA359F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foSVN_X_C-AQ7kNvwFOwDzP&_nc_oc=AdrpPaZRdkl4-_o8F-1-_znH7gGyjSRRqPnyfuO5FPyFepTO9CCNZfUx1_cpzHERFtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v0VHO0DKhujb79KVX7XYxRVHKXsdSZeh4EtmX61TcYA&oe=69DA3317"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mA0TGVv2rGgQ7kNvwEd7Xhm&_nc_oc=AdpxXdWjh73RsaZArGmi1xEcMD_m0IIA1nC3qPobibxqgr-Jn_Avyi-tLoR2IUcAAAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3awepii_XmsrWtkKobeDyDx5W4tnil1GGh7x_g2tS4_g&oe=69E8B441"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loZ0VqxqPpYQ7kNvwGjdkLe&_nc_oc=AdoUGNMjZItUJ78wBLcU_m1cI-l2Rp3TxpGVIxjznRWKWQD5VLZnHLWY-bj9pTuS5kM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L5gdCko-9dfbuFIQEhdVdwMK7ieLIb9hdOahnagz2Ig&oe=69E8D628"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsOp3rp_cwIQ7kNvwF3Ecs3&_nc_oc=AdoYcWDipJ3UGuHNOzpxhfomeYwRL_c_mXAPDPO9PxmTPBoU1Ess2wZgar1WuWS1RxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Imr8dekM08UKg3aizGDr5YQmM-addsiyZldC40CaAw&oe=69E8AF21"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9NBNy3QuDoQ7kNvwHWaV0v&_nc_oc=Adr1fyNDMnUbUObVsxzWjMYiScMjkrTTC1wmoNd9plPCA2VRCN9EBq-8rDO5lKSBDPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q96cmjmcA8O3vE7DNWKThV7Wsirrnkv_-ieTjeBt45A&oe=69E8B61F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te83KFbDlbQQ7kNvwEvNrZW&_nc_oc=AdrfJeCbGn2frkgOG1weNsVs-vrb7azbOcs2__42wXUa_FPQ2JrAhcWQFgGyObJFVJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rmt8DeRL5QphLgewkoSLEQQY0BbAgx7cv3k18yGhxEQ&oe=69E8B397"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
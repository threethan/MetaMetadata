_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OLdSXWujHkQ7kNvwHxSHQs&_nc_oc=AdqRmCQ5xhKXYEdkFoLPv1-m7-_n_5dXUya52yLFIC6R3F5ytS4SLKIW9diVVLdruus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM51JKZQpatl3ZOkx2VafuS-L4u9ftx6m5AwVZP-ONEg&oe=6AEA0101"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8r98i0g3mYQ7kNvwFmDbO0&_nc_oc=AdowHyrfGefmf_teOops-VrzZ_Jh2sc656bRcM7O28iGBdqS0k4bhq0eAi8h-Aa5m7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI1UFrp0Y1Q-0s7pAVLXktVIzQro0IYbAHHuohXO5pVA&oe=6AE9EAA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-ElcvYsbw4Q7kNvwGWtkpB&_nc_oc=Adq_E262N-ihL9T4_gTYPqVdT5n521zdrYDXuZytvVpufizh_VZT8ovjHdMPT8Ye_yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpEY_EdReIDKxFvcqR6KugzcyBN0NrzSbfk6ZI1T1HLw&oe=6AE9FBE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekudyTbZkNYQ7kNvwHlmyYs&_nc_oc=Adoad3MGCdFw0NI00PCP4-hOTmcRzO_896QE2O3cUm1F6cH84MSAZhYHHQT5I963CAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1drtVlxUPYfP1tKlmbHMzjaxrbT_CWasjldWMZynDtg&oe=6AEA02DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMdLOKJ8eVMQ7kNvwHVaxZF&_nc_oc=AdqeiN0n_c-iGfB-mzXwlgao1uMsPC1RQ-VTErncWB-e_49dEsBHoAj648mbUKhdoYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ41MyXrl8ySe1NraApYGkhDv3gopi47L9Ko45XTh1hMw&oe=6AEA0057"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
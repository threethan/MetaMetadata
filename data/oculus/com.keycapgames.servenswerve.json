7393_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAKgUoHayiIQ7kNvwHUMqPH&_nc_oc=AdowLCRW4S_2svAHq7pnUoLutDIvQuaf_XnhN6jGm2y2zX4sGnPIxaGL198qu88Wgtc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNeIaLcHurKPJ9aqkPr_zoFoM8qABjJlIzNH5VZ3NvEA&oe=6AA96781"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jul9O-vTvpcQ7kNvwF2Pywf&_nc_oc=AdotJpZrqSH-wzvvM5uiIOqUL7uym-ZnglQg1OGX3MAnyT1iZFLM_ZE4quhOat7lNqs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLIM-0VIVQi2mzmdhlAY6tp3m59QTQy0VHu6L5JkAdAw&oe=6AA95128"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwV7-uUERWwQ7kNvwGwNQj-&_nc_oc=AdrKatzAulK3ZVcllB9lUBdvmqcPSkRm9-k-tkmALvMnzt_Ae30GBivRFPuOYkEnQxM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvHZwb_mZqUskvaGye46iKAVj1bsTKFdIQGIDLVo8Esg&oe=6AA96261"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7nsctyOWEQ7kNvwF9MVrf&_nc_oc=AdoZpodZWDiq9E3QAPR7y5W8P0UqIs01zbMfmWkHEnyiKbmAwH8VRW3FcrGEnU99dJY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyk86wtVD95e5F22--idq13KTDx5qvJX86BiM9zRboHQ&oe=6AA9695F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeuifTqQDZkQ7kNvwGRqv9x&_nc_oc=AdrZ5HvxUFvnr4WzU3hxJdHNqHjm7fJq6QTnujYMCiWoDPlyu8PK6jdRnH4u5RF99XM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNh5hT2r71eFEpPn1qZExppnBJ3A4Y3UvSALhHgpgrrw&oe=6AA966D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
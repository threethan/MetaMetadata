_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI_FB9_42F4Q7kNvwH_HWEH&_nc_oc=AdqBKHfe0f8TqKvu_jXgW85Df_REyvZzLqbhttxJyUoG8Hli0Y4J-NUCOr2M6Jti9fY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaCyuYFQJ5xAUKujXJvdvjXqQrF-ufARhkRiY9XA_R4w&oe=6A75C4C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuIaLejxS3oQ7kNvwHSike1&_nc_oc=AdqjtgK4eG8XFGMJQYchZZ2yjkhzoUPlx1uaRq-8fnHbinT0kKE5JLNPDKXyDBMj-1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGanvi-1KLld7f5YTGqz1XLe7Ual22ambhutjyguTh6sQ&oe=6A75E6A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En8VquCyeKcQ7kNvwFGRPN3&_nc_oc=AdryQQZOf_oX1v-F52QE1T_dEJ-MfZLd-mgKg-hC5J3f5Z20CwlqCRRAp8AARVldxHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3dcwEJnpztHrrBtGAUr4Wpu5ISUFMyboMhQm3v_CzGg&oe=6A75F7E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h6Xw1k9ZjQQ7kNvwFxuJ_x&_nc_oc=AdphWgRV8nRnvVLN98lFF-m7qCfVIdxLaZkTTorcdcGzAXOW-htNbATOyC7Yr4e-9vk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6MgwJI_GJGBlV0aJrXjTAsu0zC9APLXGKefNE5jwW9g&oe=6A75C69F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IMC3ju_kigQ7kNvwHHmaFh&_nc_oc=Ados-RhJtbiV7z0JGPyV9oxsXVTL34Y2Hclcs1-lpIZAXRjYYaYQY5PO74JqwPY8c-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI0d3YfGI1AI3vMnqmI1SnuysEPvueesbP1a2vyM241Q&oe=6A75C417"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
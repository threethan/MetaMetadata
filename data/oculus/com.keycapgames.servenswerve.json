_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhWN9E4bjGcQ7kNvwHAOUxX&_nc_oc=AdoA5b47cYNDHphseGrUeJg2IK1VJXacBI9_wUERfNv8ck3_gcjRqw45dAfQL97MMgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA24NTcHtjy2tTY-PV1ectVVwDDHMXr_nXHKd6DQyM9A&oe=6AA57301"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4kUm9aMvP0Q7kNvwHr0cGX&_nc_oc=Ado33hogO-Br70Frj1b7AIkcq_UjOLULX66E12MCLr5dnl9Z9o9f6Ls3M-1YoPYaofM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2gdCYeifC4KzS858F_6hFgtK5YcNggAqJcvyUQfNQZQ&oe=6AA55CA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgUT4VOWh_8Q7kNvwEuBoNZ&_nc_oc=AdrTGKmGWQ4IqdemvmCehQZHUTDhFfd930x5715Kzxwo4nr5_tutZewjKvhEMDlMj6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHH0G9p-Tckt3Ed3AhU6TfwM8s0P0p_msKM3Xnu8xTRQ&oe=6AA56DE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QukoC1hyjKgQ7kNvwHe10Q7&_nc_oc=AdoFCsbyVVXh5ch4s95aRFTDFM7O3QUU3rqgiuKwPpuBBETAlYkBI5Ke_vwkD589kYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWjUFSF8gp8djiyL0kddFS_jAPOISQZeqFSwPnUM_iZQ&oe=6AA574DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Iv6gimelXwQ7kNvwGcS8GS&_nc_oc=Adp2p5O0uqb-6WBqn8QkBG866kLbwy9D4foSjdcqtjCb0dkSp76AJ2CwkeqgWLoYc0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzssGLY-FDFpXpItzKtC4UxOXW93AZ1sarN-7rYqgOJQ&oe=6AA57257"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
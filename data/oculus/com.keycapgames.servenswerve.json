_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-k9FmQV9-wQ7kNvwEEXtep&_nc_oc=AdrqROUX6tQINPWP1TbV0OJlux4rJuhyyTqk_DzNmE8be8QdjerG0wi4etw6GFntTdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfY4l-b_mK--MfzhNCTTp8SwrMTh3gHElTOBEXHy1zfQ&oe=6AB54501"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R5kdwGZIWgQ7kNvwFPQX6A&_nc_oc=AdrbA-kyV_8kKZqGMWYuUNpMdyTuc8L3sxDH6lTO1XedNWbFLVhbiBuZPpId69NCUWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXDvfhPKkXn2zrwpE4OEWh2POQGUd_89SyJx_R76e9fw&oe=6AB52EA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrnX3vaVFQ4Q7kNvwFDLF5m&_nc_oc=Adomk6nGucDBNGSJQ3dFBHMPaHf1Fx9UOpKHm9wG9nxzWI76RjMdMS6tgosmSVym1Bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIApxTZq-Kdr291J_HCjvvf9btmC-rWf5eBzRbt91NQyg&oe=6AB53FE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRFERoYqeQwQ7kNvwGXvRKf&_nc_oc=AdpjcJZtzH2oj02D8m4__wZLwDRKkW-ezfwIIXQm_GX52NsYkDabKhaz4gFf7MlB9DA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKea1U00zedc0NXTWiWEkOXlm2aMSh91jm_lRbwaTpk5A&oe=6AB546DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4OrJOY0bvoQ7kNvwE73d1u&_nc_oc=AdrmZ6jD9Iz-fi7qIlqc1RgyC8_1sm_B2HdRo9nw1OlmosX87oo0XgmGAsJwucobAk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmWfkUxVZYisW_IEdeOAzdFmIG7ime_q6Fa2iqeuN3GQ&oe=6AB54457"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
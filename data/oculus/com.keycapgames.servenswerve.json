_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tuwx2TCjG2wQ7kNvwG5RKUz&_nc_oc=Adp6gezbMcyLxMznK2o0OJ8agSFh415UePSjo7EjpFihx1XMJixUdeJt3PC6NwiaZMQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD76sOFZS2SeI6IR358BtxCoRruWRFEGu36jD1QmsN6iQ&oe=6A6F2D41"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sSE__p3lQEQ7kNvwHkFMYZ&_nc_oc=AdrxIAEGyUYHaQ2KosJJ7Bwn5D6B5OqEezs1uIsTtmiSLMavZK6riAyO_7XAaM9K9bs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL-WympIVJc-VCtnsle53YdieYu6QhNySKA79qmcwIZg&oe=6A6F4F28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUwvGsCkj98Q7kNvwHnUnem&_nc_oc=AdrM1G8rVScTUavjuanWO6sRbjtWU3_raO4Hbrxcpsiurcu6FsdIAU8hUQKpfUTn1l8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwDGxwWZpUkpODqujCcm9tEabwbOgL_ubxfyTLtBAE8Q&oe=6A6F2821"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbX6rEfDGJIQ7kNvwHf7-z5&_nc_oc=AdqCz1wK5ffJBy45Bn-MXyF8l5I6jxoOrBc7sRf9O8j4zqDzKjl1lmUCVnnYalL-L7o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI6eyWKz2WikWdhZ2JR1xs2YqyJf7PsW9lhhWagEGoew&oe=6A6F2F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6OEqgjC3YAQ7kNvwGLAxW4&_nc_oc=AdqlC8L-4j5DZN_NJQiSFeUVi4F16mYn96i6P7LPbNdTDFPPz3zCzkeISe1rftoS-oc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARK0bJDaGoTNPQq1bBTybo52GzUF-qeDebn1V_H9lUpQ&oe=6A6F2C97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
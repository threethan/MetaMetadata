_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rse0MMY3q04Q7kNvwHkdtUt&_nc_oc=AdrzFRxurAweriR6iY-FhopKUO60MXZEn_zbY_UwHblzQ8Rsa-PFvg6ocH_YUdy-lNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y0VYyRE-mkJhvt87EwCyICdgdtCtNBHfzBfYe7hPf0w&oe=69FB2941"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvBuK3ZMl0IQ7kNvwGtd5zy&_nc_oc=AdoaFRZii3yekA4BJWM9E8sb3M9Dhjb4MvsEDhUCngo0Cg0WOa0hvxNvEwloDfZtFpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i5JFl15X93k_v7uDjvDG61BuUqWqDXbc0vAtP6DhNng&oe=69FB4B28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BpTuA29uWQQ7kNvwHrdq0Q&_nc_oc=AdrqwjXHIW41pbHUurjzubQqHNgIx-vM9gBhOmcy6EKJbVNAhvgeCvIRIuw_SHylQlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ySPL4wjdqmW5swAYhd1Tx3NOtky90ywry2V-rjI1gUg&oe=69FB5C61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuhCD8m8cdAQ7kNvwFOotad&_nc_oc=AdoDFFFWfCu0m3IjyOCqnkoEdWxxfFAAQ3Hfsp5FYzRVdTBnO5Jxm7gLuz2vKiDoPyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qh-qkMCuked8vRh_7_7iNdj7CyrgAXnXXIyz11dt5Dw&oe=69FB2B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuAVe5P1ryYQ7kNvwGYrnLq&_nc_oc=AdqToyFdsi-SK5YCMAzFLrm0YprB3XLP6aNvUd9FjvScI2p--wG3d3LU5DdxhV9Q0UE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jUMlxOZqliBoyGwj5KuoFXj9K_wxvSjskYYKBCtcNSQ&oe=69FB2897"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
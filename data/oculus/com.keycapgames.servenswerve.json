_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMTuZuykcQUQ7kNvwEV1fMH&_nc_oc=Adp3Cd1J2geyk_MGBywDuwam4vOHS2qBHfQJ0n33mrePNMTsxppwXq4HpznPIUnfqIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EPdRwhaX5TIEjTY6dtO-sVvQcUtzQmv86jyMkiRDJEA&oe=6A089081"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO4c2klJuSUQ7kNvwF6aQfm&_nc_oc=Adqkv_pEAP-RfQi-Kn-Y6tnKOHhA9vj3m4aeNoZD4-PLxpQTmsocdtgPSJUyfQlWU_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5noMqrRbpI52sljOs1ih2iG4D4aCfpj1zjxER0B7oZnw&oe=6A087A28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQmTqKvEWCoQ7kNvwEN3caq&_nc_oc=Adp1hb3n2NbgBDdOMzCMiTWYA-PgiGl_Qd_0h1x0vchAzfWQv9vAlf6qoEsV_HychFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NqVt7WsS6xC2dfC3U9jIy7L0iJdq9qpb9MR1MtGvdxg&oe=6A088B61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2JTyexDCKkQ7kNvwGkpmxE&_nc_oc=AdoFxJe2A3CAaK9Rd6m1kA9FaTgE__37Xo5Yf8JqQlNDIQqQu0y_NrEcWTVeYTL27wQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wk1j9YAVtGPagDbyzB012DG0w1qYQD8Gh6Pn3GUqfBQ&oe=6A08925F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ybfm4dRLYAQ7kNvwH8VL_o&_nc_oc=AdqmfKJTx8EBU7Pmk8BBzEG4Ji3f2HJH_K8S-lzJzYOIgp5JfYPamVXhTXNgic409pI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dUeYVzd6Q_soNt95EEpBneeK6guhsVy9rl8oDhJ0asQ&oe=6A088FD7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stY1I_7qIysQ7kNvwFP4PN5&_nc_oc=AdoysCXM2JK3A3bwvme2RnzmMgn7i6df82lNS-eIrRFQGImzkaMkVAsP60TgJgZyIPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TO6JTbnFjmcV02RD15FxIUf6D4n2luo1JlYpfRSOGgA&oe=69F76D01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dd4G6jJ7WUQ7kNvwGcsd8N&_nc_oc=Adol0nnqOiVmw1UHk_4d36R0GGQhwP7a_D7rlteFZ9foS6ORPYZyPzUO3hvj928Svkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bTA9JZnyb5AVE0L_CnKrR3Bbas_QYkL3UWTyRBf27eg&oe=69F756A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNdViH-ofX0Q7kNvwGXw_dq&_nc_oc=AdrQkXGNMgMNTLWtA1X9vuvi__wirBU-fsskCKlsKX5hRTs3DX5Q2UGExIITBEtukmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ungcg8ycA3lYSNHkgcWPw2xHwEUm4NQAHcOoQHL3bmA&oe=69F767E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2CjdPpK8DYQ7kNvwEGidUR&_nc_oc=AdpEVVgEXz7PHUOSONaIn4jUWYx0Gv17Phu3cSDPY4z8iTlc5X0olPSFIOOQTQDcN4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jt-7qd7HgdA0ccKXHIvGOKXc5EcC8nOvHiGSG1ih5Xg&oe=69F7369F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqnqeTIo7PMQ7kNvwFxPIwp&_nc_oc=Ado47DjxvnCj2_M5yQx2ls0nVRhT50plc26x89ap0hLQy2zzO-Ohm80yW4eFK85ZSFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32--VZ5ipzE6Jz3lsT0VnaNhs57jKWZQWxt2ijMG1F_Q&oe=69F76C57"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
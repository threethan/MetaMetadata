_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1GE4GdGv-sQ7kNvwFTamIL&_nc_oc=Ado8_COCE8kIyUwbhOCvBvV_BeWCcu6KQM1ZDL4Tl3TMSLJgrJxsRMCzoLZgehdzVho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LSRUVa1YZ2otbmUkyevV3S69pfZJD0i8-qKTctvz2gg&oe=69D4EDC1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d3C5Nv_JfUQ7kNvwFnC3Se&_nc_oc=AdroTbLdJzcm82LKcCCh2ELLjAABLu_Wu3o1K2ixZ4Nv0UdBfMF0rbcRn1PLP_F2Yqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vBeNmf7ndMBOeFMzDknVJzFbVllhWi9Qlk6VgPEshvg&oe=69D50FA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyXy9TIaM0Q7kNvwHrJURj&_nc_oc=AdrTCsdO-wgh-z8rBDWIj83jgQ3of_aqllfIZlN3wtJzf_dedr9pPLdyWplmxwk7dxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BMkEZWt3kKGD-wOpPV7ID1bK7iTzRWnpje-PwvK9SYg&oe=69D4E8A1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJuC3gMnThUQ7kNvwFznnhS&_nc_oc=Ado-8Mftb_N2_fjuPmMeu8_Y_gaH43QJ-m2LqqoSycK5Wr6fB3bh0yoraxVKYlLoOFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zn5t5wHiS_OTwsdpdtGN_APaKN_Mz5I9KLewZK3F_iA&oe=69D4EF9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M82w6KnR2nkQ7kNvwGUfEpA&_nc_oc=AdpTCUksDikA6CBOMl28iUhokoF6jYLWLDrhhrfV3FVHCRX9-vOf5Qm6HB3Odc5PI_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tNFTNlxUAfDNXUw1nMRloKHYjVFQBCnGj2E_F-UqsNA&oe=69D4ED17"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
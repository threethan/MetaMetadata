_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI_FB9_42F4Q7kNvwFYusD5&_nc_oc=Adq8-BfpOEYexNK1cWAllGJucYTRqnH5DQm0M5hgZaSozNE0DznuiO_nhIPhbjNbfMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH4KOOtjEz1eGTL4cOhUAkPeZTKSSuy4q2Z-4xKM5ElQ&oe=6A771641"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs9UzQk8O9kQ7kNvwFo6jsk&_nc_oc=AdoRBevt8m4-vHEjCobJSNJI0vPQ7sdw3Ih7TUp2kG6HJO8NldhHLE1y1g8ZuN67kBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRy-izB1vyZA0o3B4AhqkscfoFfiG2tbGAhH6xeMIOYA&oe=6A773828"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En8VquCyeKcQ7kNvwEH1YLG&_nc_oc=AdoA0a2WryNA_InUwgd21s8T2G9WsJGRoP2cbkNkXepBpY-ovM_9_afjFJr3FPqM9KQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJou_kHSmI47sIlEex_0vLCBCfw4GEX-GP-WRG-Lsnkw&oe=6A771121"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h6Xw1k9ZjQQ7kNvwFHmS0S&_nc_oc=AdqsVNk_9e1edvovNcj-VoL5BqInPCjW-qh6fVfmB4dIS6hO3L68Th5mNU9i5Y_L1TE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSr8Z1HCemajcn0kVoP9ijQro0b_XnkZmF7_wWgRddEg&oe=6A77181F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IMC3ju_kigQ7kNvwGY4euw&_nc_oc=AdoQI_1vaKQbRh--FEwqFtigfcExu8U_NlsMnwtt-sjkELqTq4mSTLW_sU3nx7neszU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6-V3WOUQ7NJ07Bhg2HAkAKeLURyAYZOoc3iiCOCpgNQ&oe=6A771597"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
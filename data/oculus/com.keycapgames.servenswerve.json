_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaQgzn9-i-IQ7kNvwGi2-Ak&_nc_oc=AdqJFnaVWhKP2vUuHEDYoaf-yVdONRtbrpDhDnxEgsfR7GcWlaLBjFqNf8dDO93Pqrg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIv6YLrxpLMuI6fZBtTmFmPiEUTIs4tWbzLq4w_3dpwg&oe=6A565901"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg7VIZXrWZgQ7kNvwEofmBK&_nc_oc=AdqUWiwRBQe3bUffPmXglHu9YcP6xzo2Mlhww2qbAmppHUs11BQ7TPlr2NE9sSMQgys&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCak__ju42WNcoNZDv6wSUsbzomGcTg4G4rHwcbL3AlJw&oe=6A5642A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2ny5vWbhAIQ7kNvwEKI9J_&_nc_oc=AdpmdPxa8M6yqEvJ2LeK67z1OIiWMhQvn1a_q3e4tp44l8Lqn1OFIHoj-9qVJRKCyGY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6P3djy67R29WdoNT8gPmUzk_hru-4OSMyZFPtDLhz1A&oe=6A5653E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLa_K_OaSscQ7kNvwEbvdVa&_nc_oc=AdrtP_utFVwgzfXsvhXU7VaVnKXU5UbyCPXnPPQlpKgxKjCORlrwIpVXijIg3Dd1MhE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeC1WYRVMjxO3jFK3Sb5fm7p-tJlluRTkNOofz6jezcQ&oe=6A565ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s721y7XHFQQ7kNvwFIWSUL&_nc_oc=AdrGGVShQg-T3futnSoa91-5XREJMXU1NkefoDIrOMJCQ2nUU8xJ5nmHJuzC3icuGAw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3gooxeGKn-_Qb8992tbekY34k6GeOGqengwvW9BpxsA&oe=6A565857"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
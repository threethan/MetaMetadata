_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5fBsKcz-94Q7kNvwF_jVSN&_nc_oc=AdpVrYin4J4JKCEkB0tJYQISXOiUsMZF4_lfDGMflqwDIi0xUR1NQkprqKcA0qfoADg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdL9mSNkJqSOaUHpBOqbD_4E_Ymq1YwANE5hbplET2hQ&oe=6A984401"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKDScl1M1rQQ7kNvwH3rhgi&_nc_oc=AdprU9aRVhzyIHS5eK_W_W7WFL6YigWOeQhXiXyUEtY4ppAxAxrp8UBOgBwUE6VoouM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs07zAO8sy1PlnNZQ7hKWGHdkHGTXP2XTtc6jFTKn4hQ&oe=6A9865E8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__nIM07RN9kQ7kNvwH_CA8E&_nc_oc=AdqYv7CRKCUik5u6dDLmvdwmaSgIrHy1KhYlxBqnnr2CMYaFdOrUuaqKje8LLfg255Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoA0lCATTsUnX8aGxE_6Omao6yo5kcd0ZGvIZRhAmSyQ&oe=6A983EE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPV3ioITEqgQ7kNvwHvBxBh&_nc_oc=Adrdftbf1DQs_w4GBIpHK-PfTTNqyIpLTovc0P4en-i8NUsuvm4GoAqDbih--_TMCLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3iYgKd58-cNdDD9HJpOT9ewiyiIquxjfknZHDIUgzqQ&oe=6A9845DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TANxqxepQOAQ7kNvwEe-Jjp&_nc_oc=AdrzxD7j-y4gUdZHVaye7AEOfdS5XyJAKy_aJwYs12YYwbS_A4uNWu8D6FL16TRlOvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxbZ_ElGQi5gkRVWtrfroVoi90NptzM00WOOIWPAG3Ng&oe=6A984357"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
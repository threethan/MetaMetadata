_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5avN5dU4uYUQ7kNvwFsfXcD&_nc_oc=AdrotxjyhANwnmKRAYw03QV9jyCk1BucM30TTVj8b-ZMPMMg71w2onYTsrB9SqwR1cY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi6mZ-I_Pq8LtkcK3y1txDh0R4rm6k4sVbmwMGq2ty-g&oe=6AB15081"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7O9fZ-dXN8Q7kNvwE0rEHu&_nc_oc=AdrO6Is7ZrfaiGnEsQFh0mFgoxBHjoa5h_6MSIkZE4lXry1H2XuGgMXU787xKt7r0Jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrE6s0HG5p3psOZxGtCgH2odca0bn86OOZhYDRXWIXSw&oe=6AB13A28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBnkNO2a9twQ7kNvwFqbbeB&_nc_oc=AdpSLJUMlYqKVQ_oAFJXmI7zkeeFoQ217yfI0q1F2sT8l2_PlvlTbDffSpih9xLeod8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmuzAPwYRS2p2vTqx_dvTmc8Jc62ecnKr_Q-RrGrhM2g&oe=6AB14B61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr-iJruHSWoQ7kNvwHsPaxm&_nc_oc=AdoX88aw5qyasVWFcPclHw3kdZms3BtQFLS3oxrR4JZcFqlsZGuTe9gTrnGtsX2IQvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYCwB3cBm0rZ_Os4l15g639msVy-pFUll0ZFuIarmTtQ&oe=6AB1525F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ErFs0DRC3gQ7kNvwEZtkWB&_nc_oc=Ado_XMYz9jCns5pMKcvI9OFZLJ0cbjDykRTYNcjYRwj9S5QGK-Dp2ipwwDftL9BOZFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjd-9flHGKgeNNdBgGpu1Lg0-NQzaae15loDfZT9FHXg&oe=6AB14FD7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT0JqBxIjGMQ7kNvwE-8nMU&_nc_oc=AdrPOLEWXL9apylAa1APCdk5bRPMZcHXwiYS3oe0KuMPO60cfIg4IivHcvW8oRkrO5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xd4-KxhAozTNTY8yGMtpaPUAB0zGCQ9VJRSYSidAAcA&oe=6A3E9E01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbkyAG8d-VoQ7kNvwGvjSkb&_nc_oc=AdpEZM3ZtXPhM2Uq6Aq9n7CgTY-eIpC38EHdxKSU4w5CmoOGiv3U_F-Tel5uOMWNKbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SBvn_uIow-PI2w1rFtggeBTLgyI9oggtrWnT_XX6Zww&oe=6A3E87A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSbnHmOF8osQ7kNvwGoxxPT&_nc_oc=AdqeAoRAfVsCwVFh9WmuZP_P088Vowe4Vno85FXDSH1SF2j0xT4YXklBbtO3JwSWcxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mocXz1Nt2x-5kNARmmXNsJzDEjQ5wr_uVe_hnCLsJLg&oe=6A3E98E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lI0sf01MOAQ7kNvwHeQ0Y5&_nc_oc=Adp7UApqTFUIL4B4WhxmP3fm6-TTtQ80QRdvqAH1nab4FUfhvRm1B5gwATFGDfgijrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cgykosnlS6eN1EuB5BS75vHjQMt2rjzHTwJBUx14TbA&oe=6A3E9FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj7oaVx2RHkQ7kNvwE6LbV2&_nc_oc=AdpXfwOBlA-5jIqtVThmx-2uTxVjBS7aflu1kNeVyAi3njTs4Xo5u-Hm6MfT5Jvxgh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P5bjU9ERoqZkGBpdLpm_ySMV69SW5I9bU8n86c6jQVA&oe=6A3E9D57"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
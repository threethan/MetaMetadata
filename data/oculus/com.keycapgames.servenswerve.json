_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reLPnL_2v-4Q7kNvwEEuWwV&_nc_oc=AdoV-O6OKvRrVV65RINTht0o1p2AmSD091Z_bmNli4Dg23SPx4p_84-9Y2jL8Uicd40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz-jRQBZZZs3C5E6u8xNHy92yLEzZJXiiaky3_gfgw9g&oe=6A8C2E41"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQZic1wGZXQQ7kNvwFWejs7&_nc_oc=AdrrPuzp3UrxlKvVeu8SSfA2vpMGcBS8w_pLldHK8JGrtocLjGXUaKH24lAZ3WEgpuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBsYNgg_r5uqDjOc_E2GKRtmcyK-MLUuRwuAg_NkI0YQ&oe=6A8C17E8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRaW8U7L9ioQ7kNvwEJI8D4&_nc_oc=Adqi-The5phZ_fC8D-JQFcJPdjI5mpM2033y2wb3sM9EEatV2dNYo5tET5rrQGI-VXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVjx2jGbPIcdzTLRjr_mMMSSthMI63tyFqXlEr4X-MjQ&oe=6A8C2921"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSwjQMHZ4HEQ7kNvwHbxFE5&_nc_oc=AdopjxYLwTiH5Xlc4ZaIMvsc6mxSfW_9CPE6t2pgDqJG36V3FGdaMbFi85gHlYCTiR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjDdyGWC0iLr8nqxh_woD29sVgWjLpXaDk3UTNxac1g&oe=6A8C301F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf2m8V1OvE0Q7kNvwH6bZeE&_nc_oc=AdpWlMWZGzxZsfQKUQfIDzGvRQJgMD-Yi9NBOHk64CgJXSZm-n5eUfYDrTU4botoO4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtco7SIY_iJj4oNtAdLMdXwYws74P_aVrNduTgcBWRVQ&oe=6A8C2D97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
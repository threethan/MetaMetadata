_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6TA0X4BGJQQ7kNvwGWSksv&_nc_oc=AdqXv7Fj65_IngdRNokU7Cyd0r5XYXt03QJ98yg_9fvOjAnOXxeZPDuu2wj4-JD2siA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JEZRwqIzt9sgLaSOls-ruHjDkvzgnJb_5U-crzkgyLQ&oe=6A19B401"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkIqeRXD-8EQ7kNvwFA8z1E&_nc_oc=AdrCHzHVeVobIHNpxX4BoYmidEhan1bInEg56jDEgpypUwp_XHiOxhmpWlOwXnv9Ad4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zVFa7s5QZ_3QpJMUhb0ZBQqkuiWkhHUVzeGDXH9B-GQ&oe=6A199DA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMFSdxJAfg8Q7kNvwEcnqlJ&_nc_oc=AdpSwe6bQJiB-YVSGHQE2xEfaQTUE-w74aTkJO8hwz7g3Q4H2Fc_jAModZZJvK-q5eY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KwkECYxcY6vxbbugQvwNimVwfipIyfxtUHxyuOVLndQ&oe=6A19AEE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN4r3ewv2bwQ7kNvwFc86fv&_nc_oc=AdpH3gKOAyTUvb29ohEYHlpPZfcRPM0o85OYZ7tI0NHKf1v1ekI_Kc5xb3gJxso2gWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63EKjwSumYim4823lJMPu1QWO6uy9CZ4H2iXqJPbEmBQ&oe=6A19B5DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8U9z6lc-40Q7kNvwGB1pr6&_nc_oc=Adoltzu2gu1bEjW0R80rREQO_SJ5-KsarBDAEBfkEWfhbdfRUbJWP2N7qYJTcdP9qe0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HHaYHzS4bODbmD8HlbrNQiYc18GPd5F5Fn1PKCqDCYw&oe=6A19B357"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
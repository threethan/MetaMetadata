_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZHYCPxsCo8Q7kNvwHUbWUU&_nc_oc=AdrHuI14ht96yGTt04Kohn4HraP9Cp8vSmHvKL5RIsrZP73EI3lLKbYhVdESLP5bTiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTecbMbAGxETiCB4SoQTvpn5__q9GK52iuY_QeeI1rdsA&oe=6AF09881"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsHpAceOGNwQ7kNvwFixQ-k&_nc_oc=AdqmyEkox0XR0FAVfVe1n73EmU_TDK-mDpRUJQl1cafhz-W4l2QFuK-ABJUh1l9_8zI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhLjubYlIvCynrpqcBE9IIJ27aUlDknwao6BHLRb2-7w&oe=6AF08228"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwCULzWbgrEQ7kNvwGWWGED&_nc_oc=Ado2Hz-mhOcZCc7fWI3504Y6pOliEHOu3WmoxfkovAY9lc6UHN99e429uXOkJHWmoYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYQQoKbNM9TVM1Fp6tRWGQwuKEvutJW6zBhPcGrqIv5A&oe=6AF09361"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNg-JEfAt8kQ7kNvwHuqZpJ&_nc_oc=AdopUxZmUU67QEASdBuJg-ukiDLkbH8BqwRv0rphxKLmn3xLrtOxGgdaHsDvQMUmkX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNgQFMkdOTnisa38E_MsGN7Ba14rP2I90kLrbKO62fkQ&oe=6AF09A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H2ZiJMBpUIQ7kNvwERdQc6&_nc_oc=Adqo2OYJJnhoiTeT7T-BH3eIeIcGsubM2OhIuOuByrH_TwSWTy4PlK_6A4Y2EaDnp9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaMN-RahWpQBx0vQhTraf5RT7I1aEH_InebfUtIGCnXw&oe=6AF097D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
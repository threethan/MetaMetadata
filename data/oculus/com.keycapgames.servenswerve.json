_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YfL9_MCSCUQ7kNvwHHG7tf&_nc_oc=AdpF-NmVvcZ2jzoiXuB2G47mJyTE0by4lkucL2JjL9PQ2KzUjoZD6GmqK6hQARyLg1s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xIXdISaflOAnkBELwf9mQZgWqy6tyukYS4VO-Nh9SpQ&oe=6A0C8501"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBemTHdxhiQQ7kNvwGtlak4&_nc_oc=AdoGfpqEP2erkWWHDOOUQn644g8eNzq7o6kmA8yhbBHrG34N25fnSUVZMrXIJ4seV_A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QQsI7xJ6oIz9pDIYOX-0Gzlpxgt_C0RWudMP9D9ndgQ&oe=6A0C6EA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCYJHLlGPC8Q7kNvwG6Y559&_nc_oc=Ado6PYcNuw9_TZdePLJPqnnZNZLK9xML9EIOTJymwVgGTkgazR2T13ACYxepvZQpoA8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UhpAOsQLhEfC95pzJ_mY28bF-9HXu58kMfTfLSI9t-A&oe=6A0C7FE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wesQCOKpmnUQ7kNvwECwTgd&_nc_oc=AdpGl8q2EahnIWJJWu-EBp9bGdHlXf9o1ESrj3_MAAQea_gQvkrjBS50W5eAvi_JiIE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cg_xQ0vbU_eBHFdTTjSWEeQ34Fsy_-O3ME8N6zLRcyg&oe=6A0C86DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9o3YvZI92EQ7kNvwGKH34G&_nc_oc=Adp96UUWMw0tbJeBVdPiGjfAzgx6nSGzrWB-Flq0HYnQvT02EuB4C8nuyCKaFUjErbE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46JUYV4j_dg5vvDTxyUSkXhz2R8JGQe9q296OF3Bzymw&oe=6A0C8457"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stY1I_7qIysQ7kNvwEqO5__&_nc_oc=Ado5k_b6E0TOvlEU95D3s9HbRf9CelLYd8fd1l46o9iCGqGYreFtIpNKhGdpEqxiAck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WEk4mFuLUTuTl8w1axWkjMxqa_9xLCgiqZF4C4uO-xw&oe=69F61B81"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dd4G6jJ7WUQ7kNvwFSu_Yg&_nc_oc=Adqv7gh-5ZWCwu79UYVakntLmn3vuA2ihxU0uKpapr91eUXzjhCZQoS0578w5m0xGsg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kBw9zo05WKGGivcD7JPHlF0etVfYhkT9vaKoyxDouFw&oe=69F60528"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNdViH-ofX0Q7kNvwGMoiFH&_nc_oc=Adr_XywjToXCam4KdxmjDhc0o69DKkF6YZ0yTLb83wdVaXZuIJE1Y5vWlLIQwWBUwKY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OZV5pBy_12RdWy47rKEve8J09T8OWs74HtxyKUXE20Q&oe=69F61661"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSd2DoPmJwEQ7kNvwF14tiC&_nc_oc=AdqzQqrVx0HfwbH7hw-3NcwjA05d_GuXWjJ5Yb43rjvbiIxgjAtNx2izYq3ZWklxLrE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Xw4EomwLyYSlzvCsHyu6TwHRw9SuCOBm3PRaqXlrtfg&oe=69F61D5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqnqeTIo7PMQ7kNvwEQ-hpx&_nc_oc=AdqeXeT3yJkEDw-BxUszlXvDNAYt4-mqOCvDxvKBGcdeSteAgTDjSLKzlqhZLPxumaY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HYoK85gH7yeQfWIggKIXZRdoww3M64d8a-jHLMIPsUA&oe=69F61AD7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
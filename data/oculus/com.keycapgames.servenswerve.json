_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAKgUoHayiIQ7kNvwE5SuPh&_nc_oc=AdoPqsdPYMkT2TvpYw8EIyhydr82LS7XkSSmoPMAemNWBv3IYpxhlVw02xde8fFLTKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzxIVjt1y8-il3b_6fN3XApLAxCnRpV2pZcQZHDkL1wQ&oe=6AA81601"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jul9O-vTvpcQ7kNvwEDAH0z&_nc_oc=Adp5EgSkipgeSTfTPTEAltQ3mS6C3gd0UsDhSWXjPXOkAhowtEHgTE5Rup9lriXLvBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPHVcJE3I7biV2ikCA5TRjy1VmNxUCX0dt3jqKh3X6rg&oe=6AA7FFA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwV7-uUERWwQ7kNvwFfN14g&_nc_oc=AdpXTmI4PqerTZvy8XRaDwJNw4GGk4JXgMFh2HhKfscTaecbZE7d3ol6NlE_YUG-nac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrkEEA1Murjrjg_vmgy4ZzqSd9srZ_z6zA2T3a6CgMvQ&oe=6AA810E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QukoC1hyjKgQ7kNvwGXFyg4&_nc_oc=AdoU5FcwQb5sM2AoAhXIFYSylLGk2dURi5EFKGfZis8bPdvhdgyy-5gLOdNg_t_f8hU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQMeyEkSxs4Xb4TE8A5mLv3kw5LYjknSvVFDBmpINGOQ&oe=6AA817DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeuifTqQDZkQ7kNvwFZsSCt&_nc_oc=Adp16KJx5lLmlOtscrBFOuv8SopOkW3JA5CjMipr8NsM1EwXbqcXWn7rSG5IYdryP08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6a30DStPXjqPMMCbarVBWAy2Ne-oMXo18C5ycWZiu1g&oe=6AA81557"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
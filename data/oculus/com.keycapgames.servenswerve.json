_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wKSiB7Xt0oQ7kNvwGof3e-&_nc_oc=Ado2fFozR9hVnCvWxHKDp12e373wHryebuS4rhL4sVJqmoc9abI53uDUV_CEoeK5YIA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOthZVvFlu1v3d2utcf3aa08FY-bPOMOWvLOxTsLL0yMA&oe=6AC90B81"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv6_UDRyrDkQ7kNvwG8ipgM&_nc_oc=AdoHANWMG5wE0Josc_R0rI8gsHhOMRtDAG8WkbS3y25w6GR-Ug0JzFQTfPFExBky7CQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl3H6UooJzZED83T_G4Fo1gUD3XNro3WSLFgXpQwS4xg&oe=6AC8F528"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_NbWt87gGYQ7kNvwH--vSN&_nc_oc=AdpbKq4xVRP1nGtgsL-haupR7mkPdZFVCrGfrRUPpeZZX6x6G-clNTNPUULGAyz8tl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODa3t2tQ-ofL4HBwB-QH2wa9OAEcI2wtct-UHNU9DKJA&oe=6AC90661"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6smMQyeKm14Q7kNvwHt7Pyz&_nc_oc=AdrjoIn9k0405yMr3Y7CeboBwzhzKwZq4XTM7r7rWaf_NLaSkrJsf0qdE3tiXH-hleA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2MeXSsmtvOjuYoVwtavRtKhZlLL2DwFE1Eq1rgXOjNg&oe=6AC90D5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N10aOFnAhkYQ7kNvwHuayE5&_nc_oc=AdppCD25l23eMt6EctEd7VohEr0hGYSyX2IWYz3pz8DguvuB2dLm4V6dUSUJSE3vBpA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAyQqsJh0rteX_WjWChL1V0W4nW3Pqq99gjgupwZ34Ig&oe=6AC90AD7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
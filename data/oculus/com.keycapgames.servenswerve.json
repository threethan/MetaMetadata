_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whit3C0AYUgQ7kNvwFu1NQR&_nc_oc=AdpsyA9V4ZLt-bILVRu_eG0Emh35JdILI1rS5exnk9_90pUG7SsF7okZjvx_OVk1DoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAon1dx_KMdop4sehKI1iYuy4hvehnBKt4H1iaTdLd2YQ&oe=6A526481"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsOiLMoIYAUQ7kNvwHWolS3&_nc_oc=AdohUzYsk1JNTs0kebKCYwaOMx2HrFzMML8q_XqNVkJnUsmYSGxFrmeLcnfo-UYJnjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw8sRpkOPBcT58ibvQysCd_vfqHBkvHjo8O219KJyJMQ&oe=6A524E28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KySHQ3y5aNgQ7kNvwE_xEnP&_nc_oc=AdpzUwp3avF6-1BnlDBgdgg3FXpjkK1H9RV-IrdqnIQTmYYgmBvElfZpGuzHBudouYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwndDG2zC0gl8erNvwL6w4pEcZ8WNWzXWSL5ihawTxJA&oe=6A525F61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhPnJaWB7Z0Q7kNvwHQ7vWB&_nc_oc=AdquYaU4UDc523YbwQdbgt5gGp7JNGrCZZnLaUhdiiVozkZS1ra1Hn_eNUtcutYcdtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4Di9ifsf3CgQ9fdDZKNlIijrYdnAcvxQlffpOMBhd1w&oe=6A52665F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_AaXafFhToQ7kNvwEwtdwT&_nc_oc=AdoFYW9JKwhj7zIsff7q7LmxaNyeCMKbX77kJS1V5fJWmtjJcFRUF-qNK203jnqKmbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADg2JwITRZb6GvPsxeaxFP_KVTejV-3NGyZEdRpkBzVg&oe=6A5263D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR6IZ8lQyXYQ7kNvwG4Rc_1&_nc_oc=AdpNoa1LCg9NfLQH5t4qtSOMoCrYAk5TqyNLA7_4DVy6ZM9YiJGokC2hwp7DjXQvVjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27DnmaBJEl6_9_qfNSKm51D1FE2DI3_t6MTVf2gspleA&oe=69DB8541"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W28e6QurzIQ7kNvwFlm3O6&_nc_oc=AdpBrk6BFAWarN7CkYXW1oHfYhGEMo2BEV2XfWDtfw_Cpp4_A1q8C2QrY4ot4M2Wwig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xzbvcUIVzXEihaSXCJ8J0aynMN_BAW1JvlkvW0Hu01g&oe=69DBA728"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLwpd8JpZS8Q7kNvwGBlgJU&_nc_oc=AdqmONRG3RUfsqk86Z3DUHDjQRqUZegAUF1mwgkmTSKdzNBTyCYVjdAKAy2odETaODU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zTFc3XV3GuBeW6t_MoX1CpjdF08MOSU6MXJmPDkl-7w&oe=69DB8021"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irW_JfEbtyoQ7kNvwE7V9tz&_nc_oc=AdoNK2EnPVIj7NSxnRWIG1J7JE3p9mvraChOITuikKuxbUtCAQiGWXZGJI5elXq_aqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vfg0ziavzYBgiASvAqV7PUJHZtEzCGElpsgbX6B7l_Q&oe=69DB871F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foSVN_X_C-AQ7kNvwFabHOC&_nc_oc=Adqib6iGTxQnTOEYOrwYttFZym4iV7xKj0KHoJ1hFOIB7mnGqIlq7wiPej6h2BuALYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kYd_teQ0ZKJfoXndtWvFBArQ4Od4ohv_8q2Oxhwf8eg&oe=69DB8497"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
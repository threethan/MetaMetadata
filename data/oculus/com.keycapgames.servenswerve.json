7393_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZyzppnDRKkQ7kNvwHHoV8Z&_nc_oc=Ado9OWCQacBJ_TKMSJDvr9xLh5LyfZz93mKSZRGPG8hBCFOfN4g-ayU6MK2rNggzySQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zOsaWE5o8w375mA_BwjUyWangDWZN3OxSmstvmodpHw&oe=6A11CB01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcXkXPZY-bkQ7kNvwEynzes&_nc_oc=AdqBcFv96SMB8UUciB5LAwMUwetXQxzFKfI9fs1In4YAQJT5j9CoiePl-PmnBIdJ5dM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h81ZOjs-Q-jRpUaMgwbo6mH7XD7FqfawRDsdYqJEqlQ&oe=6A11B4A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mQv9H-cH8EQ7kNvwEeanwB&_nc_oc=Adran3M0QzKz1N01mfyV8ACZnysv264JjyVPppbvyvOSdOzLJUBpLgHNYeCoOrVrtgU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZBaubXK1kHLRkBUX-oe1n9sda1mF0tsATPOaizXD4hQ&oe=6A11C5E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6SzIvB4RIEQ7kNvwHMKaXy&_nc_oc=AdpMnNVxJtvKNmJPCL231V4sPAKIMwtLmyVFq_p2dmx-hjAo2PUAPoSja8MTfDtSrAE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gm2HYFPKRB733tP9VknSLKKSmMmUPTcs5qa83KJpGMA&oe=6A11CCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xhn3_Vnjt4Q7kNvwGBl1qr&_nc_oc=Adpb2LQ5DXTec-u--a_3SIe0BgPMIV0z7CbfCR3a9FciXEgZgr89LkiAoPe2JhUM5PQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T-I5to9iqbcjN1-ATJSYSDv7x8pjyUoewSmOwavPnzQ&oe=6A11CA57"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
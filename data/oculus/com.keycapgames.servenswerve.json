_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-k9FmQV9-wQ7kNvwHC_9lE&_nc_oc=AdrUDKkmCIdgN02tZKlOKxm-JxDsIVu40MwT89OTxYbtDrPo6tHOy3OLrduOMQ0Whio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzZ8I_9GhFSjGHu4NoCy0eYH7rnFJ3JxUzrENUuDywvg&oe=6AB69681"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6c1Spnh7sAQ7kNvwGcP_ys&_nc_oc=AdrDl7js7eRbWXpSwdIIQdFPaU2r70AL1zTC2uOqlf_bIYvjg7wZdYGXTOVsWCEtutg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHknlu-CKjKn1iImnoQ3qd7iNwxiyl9uy_Oc8yywWkIw&oe=6AB68028"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrnX3vaVFQ4Q7kNvwGt-8FQ&_nc_oc=Adpk1TZVHFp0CrMmFZyBf1DIjYu9VeKQAijTLa6ZQ83Z7NzVOSqWDbf4RXv2wCGyaM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1EEDg8Bw04ooVeYwcx5gZCj93EZ1VC9Ml52s5UM3Ang&oe=6AB69161"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRFERoYqeQwQ7kNvwFMkVcN&_nc_oc=Adq8ima6Z-83mC0tf5g3mn7t2J6v-2u2YV8N4tWYmjuKh1ivV4g7v38HjzFFJ3xutWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc8rsJGjv0vWXEWcOttbcz5hO8Pk5PvBSNCBtTSRisHQ&oe=6AB6985F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4OrJOY0bvoQ7kNvwEFiubM&_nc_oc=Adpay-yucHTPPcOX8SSiAcCRsCVJJtjCFQKXFS08Kblx4ozFOVxWKnAwe8tA-8d2Rj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKykDb-KvYj3pazOO-nek7YOHeHobRru9JkzRtZd6hj-A&oe=6AB695D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
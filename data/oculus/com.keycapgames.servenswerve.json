_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5n5-M9XzNEQ7kNvwG1yZ1r&_nc_oc=Adrvy2sYNmRkaYLgl76awArjZW-g1tAV__dXNFJdjDUgEO1S_7YXGjj6x_xRvDQJQN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KVTIa6BbPN_y7nYl20mHGeSB9udiD2wCGamhFyGAz9Q&oe=69E36E41"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqLu4ZhVi3sQ7kNvwFjH7pi&_nc_oc=Adp0AxMcyTyKQ8KSyJlG_q42N_dnw38NYCe4WNQpiOhJvNNmUDG4zXKIB_GEvoPwV4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W4b8wcXJhJViN0u9yesl72i9vIBywuYsfBCcKbI_ITw&oe=69E39028"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9JgC1JiS2QQ7kNvwFwuQBK&_nc_oc=Adok7_e2MBEP7SLuF7qcwuspfJkVTg_E8DZAhPBVwgeavQkIUkKzk32F8l290xoeQXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XrrL5k7daPuwqH9xsMad7yJJY4wSpK5WETqrJGBUkjw&oe=69E36921"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQerLY6wH_sQ7kNvwHF-ide&_nc_oc=Adr-HguFgG_NiJMLM0GOhVpXLaRgnoiUPdERuDVq5pEk502d6u6i6wCiX7WMcjXy2vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zHbgXeS6L7goQf7_zN-k0_86qG25aYWjB6tCxlmdEBQ&oe=69E3701F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0nU--cytv4Q7kNvwFqsjFd&_nc_oc=AdomvWEGhO-H6vriM_xrQYR0cvnQd1lKbZK1G1tPt96gCxlQP60vQSY7wlmfXRa0tpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KfrwazTgW1NihBtHkZ59D0VZKY5Z9Fl7v7hkz9Hq0Xw&oe=69E36D97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLA3in-2bqAQ7kNvwH-yhw5&_nc_oc=AdqRK_n9gv3ZLZAAu-qo8pJ5oUo7IN9zHGa0-v5Lo1I0GmRJ9JnhfGHDQKLQ2p4fKkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTti8zhvV1QOR-UxeltSg_Rme8SE6J5Wpvm6-aJ-u3Lg&oe=6AB93981"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6c1Spnh7sAQ7kNvwHzFMkc&_nc_oc=AdohOKeu-e3fUv-ym_Z1XNfbpuM1B9j38P0kTh-DZ616SwEZGLdA7sBrQ15FBp2L33w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsaAsT9j-tlX7FgjC94vgJBrVqo1lWBsAEwg9wD1CAlg&oe=6AB92328"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0b4fKys0d0Q7kNvwGIDiSY&_nc_oc=Adq3eLKHnDuLSk7E4vDe9I5-_yWHuOZVYRM7LcEEVbWAR3mReKF-KXouCZwdyhEcTB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3sh0zPJg6EnubT4uoShV45LCn_JoRFkoOTozfUCXegw&oe=6AB93461"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7BHGkEenhkQ7kNvwHz-253&_nc_oc=AdrNTShFfmVySroHJ8sTmXjG_tHYFmJvLpdVagQ26mIN4odK6ZDXiktQ52TdDRVfP1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdIV_oE5KEzRCUEhJlHmtwd5aRYggN3_6qAUWmgC76dQ&oe=6AB93B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg0jwqphKTEQ7kNvwG0U94w&_nc_oc=Adri-Qs3OynmyNKLGJ87wef9XP-rYZyD3IlpkSFhTwhZ8Ss5m42sfZsmNS69irja4hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA0_2G4YYyStRDmiMg4J9CqyHyIABDvZoOgE4ZHOL74A&oe=6AB938D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
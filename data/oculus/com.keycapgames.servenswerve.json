_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3u7X6k5-ZTUQ7kNvwGS40k7&_nc_oc=AdpE1DKdVit55N_KOTq3pF0z-qbyjsR7f3AhhDxVSftJ7A_ymYi5ZQ6xRk6eRIyKSsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk_1QX7BvOYc2Q2YeCXJOaLQSh91P7PP40zWHnG8QIEA&oe=6A5F5B41"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etg1KktraUwQ7kNvwEgR3FS&_nc_oc=AdoMMi9g-vplzOjZ9P9D4pb0aLrrCjrYwFmMhXmnxfV88mu2RbdcmHi8AU9pM446Kpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRP50UXknSQ-lgJMzmlG-cVkdDdeSxyGvEiWG-YSumyw&oe=6A5F7D28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e59RxZWn5MQ7kNvwGkq091&_nc_oc=Adoe-HIwn_1JXi1B-hNq5fy4RjVJSuDN0BbwGkRjtqwGg5wbzXxncAtIhnnC9Z2_vh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd_DRdkBPu_I5pN4znn85y9N04IhAMNPJOmblEoe700A&oe=6A5F5621"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM-cCtW-eegQ7kNvwGBeHmy&_nc_oc=AdrN5lbAY67ePlMBWHRW4_HOQFtFLQYheQaQyuVsvqOt30EP1hn2tmo8yzBPO1T2Bg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANJ-iTYNW9hw38awUSEk1E0czKm_NHXIY1FEMGQ3dZHQ&oe=6A5F5D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C29FgT3i4b8Q7kNvwGk6jjZ&_nc_oc=AdqmcUohNF8Ag4PEU9E2BOXdygGV02t1DRjOzm7puy6DzVzvLdLU6JY3dti7O0rfxR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4Y0NdSTkvtBJpK3WEljRFgYymm2kjxKaerhQAXiMrxQ&oe=6A5F5A97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
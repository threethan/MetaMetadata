_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o4_bl0MXBAQ7kNvwEzt5qm&_nc_oc=AdqJZa1-nN5ZbPsVjtYwBBeSo75yyGjgGV-1avLezuUO67ebklUWYDqeAOb7ElwMkVE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af864-3X1Riq9GoqQmnCUJpuvGKvJLgJFJ1eEBkjngMHBw&oe=6A414101"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umOfUIUxroIQ7kNvwGXc7co&_nc_oc=Adr6tZtN7iA1_sKQl_egj036KCa85FOS9KImqVyfmwDLhziGW06V_iKeZtfQzpwV6ek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ax46IlJnQRyLeBdSKv4gqyh-WmfImYcOppIAT8XOh9Q&oe=6A412AA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJXFn6-VRtcQ7kNvwFXA85B&_nc_oc=Adp6ErtljDk4zElI9fVqMZIa7pOO6X2Ij-knECDHrqD6Dj0LWovNBrdlNFaRfvw00mY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8B39JViflQQB-7T_y3bO4cjgGNsqPrETfyE9slfOdTw&oe=6A413BE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lI0sf01MOAQ7kNvwEHJM5l&_nc_oc=Adp1BdpJXuwkAemTvZ5fUbMvu_QQCbjhKErk5rHBHLGDMKndSrbzqrqgX48r2PQIAi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U8PSkN4-XN93lOwdEJiVTPolwY8IwJtlNu1U3ngJo7g&oe=6A4142DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhVQ-Ky1XyoQ7kNvwHgNakv&_nc_oc=AdoPQ0tjWxj79tDjYxRxzIhhZHwH8c1_HFaQdFjHkDjxq-s0vv0i_UqBfJyD2SpwQmQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JDoHKm3URzhMJpO7GERrkhhdEdKFQeu7c7-9FDtF8Aw&oe=6A414057"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXSHLqEDKqkQ7kNvwHV-vZ4&_nc_oc=AdqFlQx5dqb-g0VHDdoLRybaeDqsA1grq1ofOmrSPFe_ABAF9QfXnBFGJCsgKksp5X0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmKRUK40rmndudhCdtvT42e_WosL7X1IfOtZnQ0s95rg&oe=6A79B941"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs9UzQk8O9kQ7kNvwFK-1O_&_nc_oc=Adq3KHaRpXfzCouHdru2jtF_3CJccUsfVripdZO7kxTms4k7Qpcd2zZU3tTgQlCwSVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsUV8bpN6UFobp66AtW1vSF3_4QjK7nqsPvYwexbtKyQ&oe=6A79DB28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7VoF9TxxzEQ7kNvwFzx4ns&_nc_oc=Adq3BLA5hBVVrZDwjnX6nRBzqAXsAwC7x-_aXKXZaVH3SA_ibmNapm5blfdTsE9Szf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjryMKIt8V_CIds0q_IS1d-08JlnOFZKksHOeV0yEaIQ&oe=6A79B421"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqxVyXf10swQ7kNvwEciA4M&_nc_oc=AdojU5DIlrdxAbUv7ib2GVp146ViwxtAfzsLqjaX3lNngD6owas8zI0qCDJoZdM6Q8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_8y4LCED48ld0kgpoIEkSK1WyUc8K8BceJa5c3QC12g&oe=6A79BB1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMxRn7ld2xwQ7kNvwH6oJp7&_nc_oc=AdpZ1YSs-EMI4oS_-MRjCxgEKbAy6eJ51iPzSWGcpwaz9hxnCfnmCkgtyyCR_JcSetM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3fDgonlldWJaHHc22vbWPt8Zjfn9qrN-rMaUNhUsjEw&oe=6A79B897"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
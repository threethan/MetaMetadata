_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVi83d3khEEQ7kNvwEpUa3K&_nc_oc=AdpOG1rkd9CqksmgSegGm4CD-RHJ0NCaDMKV2zYqOZoFRcXjfKP0yYUlVF0PB3ru8cg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Z3gPD9237bi4CRzD4KtNXeuVAyAjpohZST2fASiJ5w&oe=6A32C081"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Vne-P7UAgQ7kNvwF4liHd&_nc_oc=Adp2NNwJ9PoeaNCkHCMAjNAh6z45pZG0EO_X3BO3Ax3ABSHzvwqiC9Jahz33XN2lImc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2WfOJ9wPDi5g-M7l7htAwPD0oRWEhhT851ofy4HmmhA&oe=6A32AA28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksVWWhqfNTgQ7kNvwHCgOKm&_nc_oc=AdoW8nmAs6hZKSi1kvwf-1pDj7udjqzUY0iukgom8agrFabnFGGrAP-NXGurNxZRWbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MHDhPWU6RQl889LVujky39ociAkt_BaJ3Eq_LosyiWA&oe=6A32BB61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Up0BW-u_Y4Q7kNvwHPx8yn&_nc_oc=AdqczganwMrP4udW2SsQNoqBx74VmAMo9jMiy0MpjBxBzkMiKzOqGKCLQjfrJn9qKm0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aRyAZ92CVcC1_wO59-Ur_z3HYz45Nydnv9oXl6fzHfA&oe=6A32C25F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gpgpg6SRPIMQ7kNvwE3V_O4&_nc_oc=AdpVPatyM0ruBUldYgdZzWHngkFqmmOBgEesDdjm3ltEOZv6l0XGe4685qijZnP1Zo4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3TrmPisJMVzSSLB9Z42qLG7cVj8nHM4d3qDrLk1ytMg&oe=6A32BFD7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
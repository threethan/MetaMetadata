_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkFYLVVuGUwQ7kNvwE77eUP&_nc_oc=AdrpyElI80SyLsZuyRZlPyCy57d7atijQix1tGwsYXRIlcAeIejw4XdIILbPNsBUm6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPV_A29kzNsdD8DJcD87IdCFpXjt79_iu0XVphH8jfBA&oe=6AE36981"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUl7fxCyRIYQ7kNvwE6OzpJ&_nc_oc=AdofeRw9EFO9XlOqieydPJWhbfSqFwIEsSkLun-k66JPPJA_XWqisqdu4WnB1-jILCk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODNOqICJsT9lUQqCbOs5r0V7FWk9momPkZ1xFwWLdidw&oe=6AE35328"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLLSqvjUEcgQ7kNvwFwynuA&_nc_oc=AdqW4O9u0-zT_LcYhvg5WDyU8PAxO99r2YQwkVbeXz9hoXQvETHlVDdWR6t-91v8ZiY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyzns7gWUt_op7s_PARPxM91bSnKRxlUtDtsYvlwRwtA&oe=6AE36461"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uVUBcG-j6AQ7kNvwFhsCT-&_nc_oc=AdotZUS-yyXlBESrU7A-YHeH2pid6YwQ8Ppd9MjA5lEydY9E9kA5Ro0KkwZLliaJXF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7EI609FEtHExfOYRQroWS4gYkW60_tKFRoOjWsg4LaA&oe=6AE36B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b8VxFNwlGkQ7kNvwF4cVCS&_nc_oc=AdqZt3CgpSq7GlUmgpCz6XygFUZtzUPQ97S7nTlpvL3VwDVUeHoMYvzuvhfEyaJ_CyQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsOvajfdkzqlM99po4LtCzbWu_wYzWF1HoXH7e6fwOtw&oe=6AE368D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
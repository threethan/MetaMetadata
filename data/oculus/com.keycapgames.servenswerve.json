.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFMSXyEc7cwQ7kNvwGSch1j&_nc_oc=AdqmaH050pKOIFxVzmAyRXBNxcOH6i1Kxa0DkYQoDuJdF1qbw5Y0a36bqpw-nM6ACcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iKJikre75PrNVGEHU8RhVj562QQdLvTEgK0Uvy_KU5Q&oe=69E0FE61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2g4Eb_ySdIQ7kNvwHr-ahj&_nc_oc=AdqlKfRx_WcS3Q1KsUSfhc4UQ0NfwjF38g_99dc12Cz3_TIx4Fl_vAzhevwQSmpERWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cNkmS8mfDNkioGl3zQf7xdAhGdxLuj8GftMIhe2g_ng&oe=69E0CD1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBfX0RKZl8cQ7kNvwFGwzp4&_nc_oc=AdoPWcXeZWvLy5G3z4_TXUzobOZUtnFBYW9N5Rb1EsjlEDhGa923U5YCkjlknoWHJqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F-zlOMdjhijMx1vVA-lIMWjOSXhehPf0GItlLhGipbw&oe=69E0CA97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24893372386947976"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1675409743455232"}, {"status": "PUBLISHED", "id": "1415281206816734"}, {"status": "PUBLISHED", "id": "1206647127550131"}, {"status": "PUBLISHED", "id": "1209496977696752"}, {"status": "PUBLISHED", "id": "1397178365746393"}, {"status": "PUBLISHED", "id": "1431289937945102"}]}, "baseline_offer": {"id": "1431289937945102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1675409743455232"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
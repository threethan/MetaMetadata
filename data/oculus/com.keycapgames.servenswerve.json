_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipjjDn9lqrYQ7kNvwE4kTh6&_nc_oc=AdrZnY8uu2gRO8ZgR-x7dUvLdzRwGm_9FekwLkL2rc1z2To4HklfnyEZFfYJbvGUlts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rgTDwNjtZ4h7cO7ghcq86Oez-BbzbRyAm99ZuoWkYpQ&oe=6A3AA981"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYH9smEZeeEQ7kNvwGTRClw&_nc_oc=Adpmn6_pKYHFF7zMDfJSn6Vj9w6dXksw_yXgZ8qyE020YKMfC36unn-XzyI6D7eIhkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O60yQBTO872Gbo4Z9e3C3Mye2UbMxnlnNIewompurfg&oe=6A3A9328"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty-eI6vbjwAQ7kNvwH6DAu_&_nc_oc=AdpmwLuypCDH_G3RPzvKLl6fmbely_IsrDw5yI3h2w04HbaMTwWA6slCnNMZT54cvZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RMAGSdpM-GYqmCNIy8Y4I7AJssKXi2sQPRlm2IvZ2yQ&oe=6A3AA461"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jVWKo74sSUQ7kNvwGtaO20&_nc_oc=AdpY8ftsFNc8thuXmCSo6y9COUuiVmN8q_uHKW-hb9oHymCb3Q4U-4vhp1PXlgmH068&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EVcTgQntX_2a4qwM9rHb6PVBP7O9Iv5ZY8YHFrqyAHQ&oe=6A3AAB5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7UuXgNn9DkQ7kNvwHq2LRD&_nc_oc=AdqatCmnKpXw_4szdZndGiE3lg48OYVMlP6VhoDscFcPrbT3DZiHhwcYbsXdLARrtfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K9mvw1UsHuZvENSewPDcnDZlbogAFfQhUDfC81No7nA&oe=6A3AA8D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
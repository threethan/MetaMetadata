_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe9Ad6YGJNkQ7kNvwFwPFrY&_nc_oc=Adqa60vIWgi6NFunif8Al9MSIBumpHB740LvQovnU0pmMp_RG8XE34yftw46PUvRsDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwaPGMR8tWHSNU-978BFyJTn8FWMO-C58ZuPk641TxZg&oe=6A64A141"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjyF7ya7V8MQ7kNvwECPnP9&_nc_oc=AdqAvNxb8IS2sctS3sm34OVPEva13IhiXjrjyBuJ88lPj4_O25ssmQ1io0TVVKErxSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4605BA_580s5pSqntTR8lZ4oSN4hn9o8SdJvMwhHmIA&oe=6A64C328"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qPdvNmmKpcQ7kNvwGfSR-z&_nc_oc=AdpUfsxqnHIuVBnmNmOR_DoKebXieKv0cndR8XfN_0CWh6T8vJ1SIs9DE3Ny9c9j2FU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAGXYfCRHYGIVP-aQ4PTRFW8OBmDR4PsO4i1dh55o6LA&oe=6A64D461"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndzyN0144IkQ7kNvwH32V9s&_nc_oc=AdpE8zltN1099R0vsuSmYieAlvGlrETEkkKTIL8WBLlEUqqL0LHZ_JWt0kWylHaIQt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0G3x7fbup-yFpQ_XKw2q1MerBMeJlWh8hk7MWDTfs-w&oe=6A64A31F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X5LSrFpKyMQ7kNvwHddAOQ&_nc_oc=AdprB9ZJSbwbDJxQG-eFFMk5wbdFhLulJmSDjqJKy_W6_gTTUTwauRIiPVsqv2_8ZPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWeUqKOUJa7dPAHHy-n2UXvOuxDLuJrG-OiJ0Nj_vK9g&oe=6A64A097"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
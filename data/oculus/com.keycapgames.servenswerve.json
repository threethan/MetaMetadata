_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezJsDWnD5d4Q7kNvwEi1yZl&_nc_oc=AdrQbO7uNbhxxxLP7m0moHF3JaKCQrNvSWZPVlEQa1PNh4_S_9ADQ3z_FH429v5ZLZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HDwg4ng8NJkFwUSavh99jUqsStqrxOcTa6mrymMskbQ&oe=69ECA8C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReqDlJXzmIYQ7kNvwELk-99&_nc_oc=AdrEYc17jJNGXQ7o_3nJ2tWwLKXE2FAX6rXuvKRNQYsYFa3LOn4Kq2m7dg1IXHeU03o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P4unPkaLcAynjT4TcqeqRtuLQK2kCk3FvW4PvWZ0l9g&oe=69ECCAA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH7wr-igfNMQ7kNvwE_hcRS&_nc_oc=AdrZNJ6r2sKHVizjVTjwPObYRY8n4WiNMTh9KdwAMaG_JRzQRHvTDVffJsFbLEBICWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LwZjswL9IsWLqCEtSIcoTDZLsuCJoBRTCg-u24qaIog&oe=69ECA3A1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOVpEdYj58gQ7kNvwG9-aO4&_nc_oc=Adp3T2keSq_ztUSQ-h4SHvUK_kbLpLPwCHEmYKieOIZA4QH9np_8POMkPza0dpGnlPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ecDzwDEzdXfx4G3nltEnL53rbWr3CoF6SMzYoWa4yKA&oe=69ECAA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC1uxeHgfaAQ7kNvwGnlvqc&_nc_oc=AdoR4iMVwIoGeMnNGW2Mv5IFPM5EQ6ndmZMgkF6cHfmzPMMz2apgao-DwFmh8AJLO0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mDgdlhccLKmW2Chy7E6N9v4so4YAH0vpkJpCMyAArGg&oe=69ECA817"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
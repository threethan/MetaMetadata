_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLA3in-2bqAQ7kNvwHenl7r&_nc_oc=Adqtc7Va-ovCFblAmgAsK7GCZ0n3Z-qLa-DuD3eq1ukEmFl9zatdXiA6NvdbVRqbc_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAufmYWybEE_DNgF4M9rlvZ2MI9jO9VwtHAAzy0566bA&oe=6ABA8B01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxmzkGtejlAQ7kNvwGm_qjH&_nc_oc=AdqbJ_7IhNjH4BvItEC3yVAzymAwiYwISvmojAuPxCHAktPg-QCUCUsnvjbP6W8DK_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbX0dYfLqR1ldLJgWIL1U2ANxgT6pSiqWc_71V9yLzCw&oe=6ABA74A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0b4fKys0d0Q7kNvwGRN0mh&_nc_oc=Adr-2tLPSKWkBBgo-_mkTEVXRUWpBlXr3JPCh4Ttjiu834GlG3yY_9WyM001UIlyxJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUCi9gHoH1GjTR_9khWxrWPHfhO8zW5UM_k5AQlf0tlQ&oe=6ABA85E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7BHGkEenhkQ7kNvwH6u-fC&_nc_oc=Adog7MOhXlWEQeY1cOeGtP4L-YAEwldGZ1lyfP_vT7vi0idUAhgeLgy9ratL5JSNlhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItyLi8R9z1OkCL89tVf1GtJQs51mib15oMop6qfGedCA&oe=6ABA8CDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg0jwqphKTEQ7kNvwG1-DoT&_nc_oc=AdqwBFmJrvStFYNkdxSFS0v5dmLSeEH_tG0TzChx_roj9frrrSZJzm4sB_WAkOQO6Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0D1hykTmAHKGpNy7IGVWZHL3SBS2Zj9bpUKkBkeBYLg&oe=6ABA8A57"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM7BCtL3_jEQ7kNvwHhI_Uq&_nc_oc=Adod7QYWbJkKD7Df519mHutzAVnmHWFQBvGv0oJlIuBVKjezjtcP3PvWLyvz9VaqAMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUjjKB5ZpGjoKEEdRy11_huoMi8wnKkEnK_J9ms0d3oQ&oe=6A9D8A01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9nFDwOnB5cQ7kNvwGJo-Tc&_nc_oc=AdqFWJj0-k5kOuZgRyPKJNtX4oundRkBMHsOf1TntsvOh6MxstLvuhLJ-Pd7X1rjXJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAt7x55ZC9kzRUo2oHaKSbp2CEGS3TPebd_-tY_b1Qzw&oe=6A9D73A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsSR9HtkGskQ7kNvwEpeWQn&_nc_oc=AdoCbC_UMirh8qcoSGwYjavuPfecwPsfR2jGErmg3DsP_Sz6sICI3XHmpzCCw_k005Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVsIFO_Z4bkLDADNGAvwB4FnEik8QdvzZfSFRPXLLqzQ&oe=6A9D84E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg8lH8azAwIQ7kNvwHkdRta&_nc_oc=AdqsJ56sRqzgO-gN8NnzmPc-7j3aMG3rl8HRE7H_XkZAW92rVJVqwBgPk3ONAkptPzc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAoEQ1vZkp_IV2BhCnYRdb8YTc3mKrdwwIjVfiz4mWcg&oe=6A9D539F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOMJV9FUgnYQ7kNvwHzVYB5&_nc_oc=AdpT_9tfs4uWB0fYwb_egd5ARTiiLLAebhclUFlnnRtaUHEUXWk10xJ3F7SnwWrY0nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLms2RSp94UFSPsutNtdLEf86sXRV6ayJDO3AacTDVNDQ&oe=6A9D8957"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6xzpzz7tfMQ7kNvwHW2F-H&_nc_oc=AdqNXKsHH1_iFSWzuzxdKRLjQZSm15REQpNdLUcjV2ccC0laZALHJQhwKW_u3lG2-yE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZwxMm5RZYAIIcj4uBakYWe7G8sKUcdZhoiKthQQz9YQ&oe=6A2C2901"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsW0ru9Zh8UQ7kNvwFB6reo&_nc_oc=AdrQV0DXlk-KcNXeJzqIgw3DX9F3N7_1e8htLLnCqvum4K1_Fmal7TCusWZ0d_uJNgg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87jlMZpzP3SXgXt8NB9DYlKk1Erkqa6_-PIFGzfdR6pw&oe=6A2C12A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l05-ae8emgsQ7kNvwGZhz6q&_nc_oc=Adrt6cW64XIiW_v3oYCRJAdzxZ5s6eo96QkWolu8dv-GS63fggkjGvpaad2zelTSDQc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96VQUbAdKMH5ZvrvtGMon71qg0ivNvadsiCxA3-ScUvg&oe=6A2C23E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0YxF8MMfFMQ7kNvwFKyly3&_nc_oc=Adr_QtR7JF74FaDKMQ2UlSkKc2wm1KiBakrZDv_ZtKe6n-hEeE--CPcQeP5oty19PFo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_mXb-z8w85rRRLVVgHJ47HiIZziFVEP8-ZaKrywRYHQ&oe=6A2C2ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqIXVIrdbRcQ7kNvwF27Mtg&_nc_oc=Adqky5mzBkRS_RHDPPoXEYG8BOn3biMDLm8zi5PH0bF9EZu4dA1VT-p4ZNh_35m8yJA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tMbEOYEJdmjG29-A18pOKVuIM1Pvf4aswcKjh3ulELA&oe=6A2C2857"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
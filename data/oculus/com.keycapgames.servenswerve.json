_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0xUPUjbObsQ7kNvwF-kBj0&_nc_oc=AdplRcdCWWrN1hoMaaHmDQd9-fQD1zTJv0uEYBpOnEIUeJqdNu0HJrQkFHxzRf581fQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eOal8zwzl357Wtyi9SY9_wIXMNal7yuaVZHqfvNPrYQ&oe=6A26E301"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yWu_xawRWUQ7kNvwH3ofHN&_nc_oc=Adqofpbu4z3qlgk-xviEdMdMge5z63Uk5EKElUZ9lUZTBM6XHXX7ucXFDhmvk2NU2EI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZfhUS15eshHtKcYjLyIE62t3NV8XhsPq7azkcMf45kg&oe=6A26CCA8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vijs4d4J8aMQ7kNvwHQ-LBX&_nc_oc=AdqNW7aT0mPQB9uDcBmW-VMjbATJHpJvum8eBlzLSIbzFNSFQfE1w2poz7a9pj8A6vw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hFpnGId7gVI61jArETvFw9_6DsVYQvR3_Un5Y5kuQcg&oe=6A26DDE1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diSatQsZD10Q7kNvwECkpWN&_nc_oc=AdqDOiVQB4rAYhizI_AWUxXZshV1rNkrCg-PYVbW3hY2ZYz2soJBRuDas3qi4oxQjYw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t2aZi6d0__sisnCddIaBG_Cl0KOKodgiFO45p_T8wvw&oe=6A26E4DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVrWYDO7J_wQ7kNvwFs8zml&_nc_oc=Adp-3iDdHqdlp9N1A_G089NTAuW4dQ7AkToPXs-7T4HiEr7g3B_ey87k6dX95n1gScw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pC0Lc_EUwB94wzDJO4gFE510t7at9ofdUlaI0M8paoA&oe=6A26E257"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
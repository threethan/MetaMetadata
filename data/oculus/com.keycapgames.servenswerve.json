_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X2LZhLOAdAQ7kNvwFWI4J7&_nc_oc=AdolH9bDYJuAXIOU2RMgASaXO5kZ9hxXHpNiVnMuKjDkrDp9j7oGlLAvAizB3PbHZDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtCGXmA6BZVl1voK2GR6c_fvsvzQ1cwLSHCe8LvrNHGA&oe=6A5B66C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdZWlxGB4HAQ7kNvwGjX1FS&_nc_oc=AdpTNng_yzmak0UnPW0GGujeCLgAwVMoYYB7z-v-3MFDGzknxBgmGdbRRnmPus1pIjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtXrBchgZrPfF6blvyoXrruhJCWW75U8GWKmte7saXqQ&oe=6A5B88A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCsCW8sg3A4Q7kNvwFf48mD&_nc_oc=Ado2ghwt304M108HgvYvLndE7coxr1YBJ5EBsMzRLRWmG2l8Bd7xyLAd3tUF1qYmIM0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVWMGdGGqKuqr471jPm5ysajzhBZQsexZahIq1O4vnOQ&oe=6A5B61A1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtSjS6zsoDIQ7kNvwGLtb41&_nc_oc=AdoT-wr7NMNgvFZuHa5vFZnjvFDQSWK_hULuDXs8tCAhf-jfiLiwnDMe36lCHCXIq-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzeLkMSrwkUJ7Q_XptzOx86QTUErubTV8dUABWuaeuPw&oe=6A5B689F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlMczIkY6m0Q7kNvwG1T9RD&_nc_oc=Adr3ABitIqMqmwdam7xB3KkR5ypt_kE4l5v6ET2v5OzmbenLkWoJ-TcCg1MeYAr7HYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_Tbh_FZ3GsKsp-bWCoKoChoBKozDIoewkcB5z1Q8WnQ&oe=6A5B6617"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
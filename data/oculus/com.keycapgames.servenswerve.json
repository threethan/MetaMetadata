_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezJsDWnD5d4Q7kNvwGW1Pzm&_nc_oc=Adq3I3ar2hB1_4U1oc2ownawl40R66G8vaXNXvVc_RWq8H2nX5Pccrit2k2SXVJRa30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eOK7YZb3R0Q7Qv3TWbJWA08s9xXj3NzG5WnLL9Pu_7w&oe=69EB5741"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loZ0VqxqPpYQ7kNvwE04otb&_nc_oc=Adq2j1yTMIoVLhaMK0QCP3-0m8I2sGXly2COpQpvC6dyJRdeX_AbcXK5_gxkV5qQbb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wBH4mhM8JVn6suOOczbMBHE9O9Ds6qSkdd2rWKdZUUQ&oe=69EB7928"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH7wr-igfNMQ7kNvwHDMoA4&_nc_oc=Adq4dcZjyYfA0iM2l9sf3K2ReB6ggQz9sNcu-sAEodU_5UQbJ8EC3Q5aPg8f03-R_eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_Z8pXzZhgItvZQf87sr8Q1YIj6mlteZpkpDND_SVQAQ&oe=69EB8A61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOVpEdYj58gQ7kNvwHZm6j4&_nc_oc=Adr0B1al6nAQ_IyTnTJiQUz2yMMsMdPoZfOgTQYBAvajOMPTqXVc-yLoKI-VBz-rCkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aecMABw5HQPmhcPfbzjGIFl6A2vWsV9DDkrA878J3hg&oe=69EB591F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC1uxeHgfaAQ7kNvwGrgBJW&_nc_oc=AdoW6qvpfo5gdcxQvB3LRywLhav57I2P1UOQ7dyYKK3n6oZb5cLp11tLxajiDQYMtgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38Yn7dPH4ruK3m3FQ87GnwMgl4Z1IQBE3Qh-GPKFMziA&oe=69EB5697"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
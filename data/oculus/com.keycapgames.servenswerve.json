_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mA0TGVv2rGgQ7kNvwFPzxKV&_nc_oc=Ado1PKRMOjzSiDzJF5Z2CF4pHbFPTMZP_Ayliev14NEFcAib783CFfi1U-rXRW_gvDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jQFrDkdwLJqEd8E2ld4Geej2VHgoR86SNK4P3uH2TyQ&oe=69E762C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRJb8usJhgwQ7kNvwEvC3XJ&_nc_oc=AdrzCKkqx5dlDEujOg9vhI4W6Q91R8mLBzorpNPwGVxdb_5VBpU0L8ZY0330UvjtNnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CSNgJG1-yx2aR7pawX7cTjq_gU4zbycSbYRBMSeErMw&oe=69E784A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsOp3rp_cwIQ7kNvwFY7Leo&_nc_oc=Adq0tegwuzmfv-aEw0hSp0ryb5gVseIBRFykAIybbomvn3yzjnVyKoguB09mFAOPLdM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M4VpYNywI3igwCL4zFvMM_Upv9mx9eSzpNxEFw7bkXA&oe=69E75DA1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9NBNy3QuDoQ7kNvwFDA6fe&_nc_oc=Adol_7mlIv1i_av0eSHe-95PeTfirb0ki6dkKTlR6U4XrFzjtrK1KjIozVQTJL7WsBM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F2f-YmdHMQ-Xy9A3YOA8lpW0abADQm4AKGFjVIRYPiA&oe=69E7649F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te83KFbDlbQQ7kNvwGUpF3v&_nc_oc=AdotCEnAEqrKqRmkg-v8nugiSrxgwiLpedIzCCNkwgsWiT8P3TmlsQZKTefT7EwR1yw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LfLlOJ89JL2vfpyqwdn2YwYZeh2EZ3mnF-yZGR7641w&oe=69E76217"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
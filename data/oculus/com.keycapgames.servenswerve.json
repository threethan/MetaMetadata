_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5fBsKcz-94Q7kNvwE0qJXo&_nc_oc=AdoxdR-EZt2pm5nBR5yMXqw-3ZGeeUvysPoxe-FzJjo2Ef5_TLls1x5NaCBjWWzouIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNC9j2rSP_oCPtI7KOLtGUatyi7QtFkImdFZGldCWmCQ&oe=6A999581"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKDScl1M1rQQ7kNvwHMmspH&_nc_oc=AdqNUmqNoW9-r2Oho-wN8Tjg3eW-NNcgfauALyuy-inclVfCD_RETxpyOpsSOVJBY9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXNbTwEgkk4p3MuaMN8WvmvPPQ0cn8JAjG_LWZM223tQ&oe=6A997F28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__nIM07RN9kQ7kNvwFtnIyP&_nc_oc=AdqBFAWbhsM4fbrixSnFFNXRxZqDTKfKcfFW2qs7p8naN9zjBwgkoGODruGZCvZz5E8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKokSLcZoIfnuuFHN5VvrDAW45YktLWQrQJ5pRANDZZ2A&oe=6A999061"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUbiPc3QPoQQ7kNvwGQrbc-&_nc_oc=Adqh0wB6egmfgcmWxrRxUDUGZff7bdx7KbuHk2ioKweBZt9tQ_DXhmBzfnkUUy9Fdtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA7_uIX2lbhuUfiNW_vyFrQ5Wpne5-7GIfaUoUVYtOew&oe=6A99975F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TANxqxepQOAQ7kNvwHPdpgZ&_nc_oc=AdpQ6VtFY30NAfk0L1tshKxunOY9FHAEhL8PaOJb4FB5rVD1MzvJErL55tHhEV-kST8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf9R0JkOF2X7XqC3Db9LCfkYTGHDPhbpls_lSO2gpCEA&oe=6A9994D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei9U6_zA5qUQ7kNvwEAidEw&_nc_oc=AdqvqrJWy6Ba_oGnBuDooJTJ1yxxOwHdpdoKTLkCjZjTWrRFj8eX4vzx0J0cSmGh1Yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb_kZZwOVG7B5xhfJiRbijBPgcktKv9q5uU8uP1cq3gA&oe=69CD04C1"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-peHazjTLGsQ7kNvwFbBRqF&_nc_oc=Adogw_Zn0kIoGu6jQ0nN9i9HiNJpJD4JvPOoIgt2Xm_uEcNaDLu_kbvCaVRErjusA_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMxSPjLiLgfg_Ha2ygM-KwWo6uiYsrrqTA9o20MOgr5g&oe=69CD26A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv_wjqBdoGIQ7kNvwFPyzu-&_nc_oc=AdpPBJYJ-R51p6a305LV9GnipDPPzMRHxm6bNp1J4NMSZ3olWZ43Z6rJ3aDLPXrN1NA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjYY4w44_j-hi8MqumMqA7ktQeTnteje-XGw2cbzp09Q&oe=69CCFFA1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og2OIdHhCIUQ7kNvwEnSfNy&_nc_oc=AdqaF6m2SB5xwJHWmCgHFqn33w0jprWNcBO3RcmsIoRLxtXEcb46wlgbAYvyQs3zt40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8DwZ06l3c2xEZMkwjtRDAHP-gYUxbzqBKo0ik_kIq6g&oe=69CD069F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HW7krw_B7kQ7kNvwEX5ACL&_nc_oc=AdosCq52cji60orC7ZfMhu80RqQNf5SFT_dBrhDXo8OOtcldEb_BBWCCDv3cT8Yn_Mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPefn2lfatV47YprZAJ9MN-uR8a5rDlr54AzeorbLRRQ&oe=69CD0417"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
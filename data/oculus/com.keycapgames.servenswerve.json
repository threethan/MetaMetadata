_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FomAEaCr870Q7kNvwFe2xrO&_nc_oc=Adp64bTnV2dKuwvZ_GZJ7PIUEB87Ek_HPlgXsw8VSyr91e6Vx_kfrD4hvrJKHeys6T4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgNUvGWKrdmt_DmEQ5JEYPSKuRf6XlE5UKSBhUw_wzZQ&oe=6ACE5181"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9xM3JHaEy8Q7kNvwGBwCjq&_nc_oc=Adr4Xhv_GEFTw44QewcMaRqTGNtENkz3Rec8w1EAmg-fA1DniV55dSVzjjPfl7FbExw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqc-vBS8aSOC_dRBn00dKdnyx1LQBbSTkCgzBB6Bec7A&oe=6ACE3B28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ovavl0eM-UQ7kNvwHQL_xl&_nc_oc=AdrgCgyuMZmdpF8NjAy-99w-VDHoEAnH_kVf7olyHzAq9RVlc050AxReww6r75JVHTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRcgEarsoi36qHm0NvEatMXUJui-8a-aaE07RDJDo_Xg&oe=6ACE4C61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elDMRhZXOnUQ7kNvwHZ8Sbx&_nc_oc=AdoeCmn9Ahf8MiURQwN0cKVPho6te825NarxxSbfeUmsyisvBsgAgVgOar2ts0Ah1x8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHwhKUr6NW8_3YCS6Fdpz9os7NbnxAm1gHbPX7LPkXrQ&oe=6ACE535F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5UkSV1ZJVcQ7kNvwGug-GN&_nc_oc=AdqEc0YDm5UFS4mCVvyprOAkMMSm9g-jUcgYikBs0E3qD9k_G08JAOu5PJJBj-AoBKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwOlI6rMzPkqV1O8M2R5_6V4J5uW9f4mnJHhQxq-xZ3A&oe=6ACE50D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
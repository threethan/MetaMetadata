_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZEMbftacoYQ7kNvwGYtgwK&_nc_oc=AdrRBEDKfm7GUP4e8LPg0xOPFV-98kvZunxDp1FIyccE7b8sNynA5KJ5ATzgJ7dBdWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCULPwr_7efE-Lz9J_LtNejBsP-WBnUxfsbxAUx7TGdCQ&oe=6A69E741"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqjTFylIXbUQ7kNvwGQisjQ&_nc_oc=AdpQniBvCYAey0_vxv_ShLXxWUG0OtllfMJWJOfs7v6DS-zBDpq6TZd0FbzMucoTHj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrmKNj6cBQirQAIPWDCN-1VfZCUMfaiAWsOsk9tcdbuw&oe=6A6A0928"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC__88Duu2UQ7kNvwHP_Jhg&_nc_oc=AdrR40xprGix1ZwQv-FKsW6sefPjmufHdmir6QmsIn3NzlVqY86E87keXdyRSeXXRkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6UMry4_D3zjKbVsAYN2S2-2PR2hkhNxF30tednFr3DQ&oe=6A69E221"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMXKzfHpPsgQ7kNvwE5i5vh&_nc_oc=AdrvdMUakB9QoF5MR8lxilZf7Ppd4tU82MjMzzE1HWw0c54c9avydEFiUrofhpUXx34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR3eHmZJbkaVCQ4aRZjf8AgQ-RhsZso3BNYDKSoTtZOA&oe=6A69E91F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDeEDPoHyN8Q7kNvwEf2yXD&_nc_oc=AdprAqE-fK3dp5AJZXB1YUWvE5oXDUuGTPPvoYE1symPkXW5jRDfALYla07ee2H4SuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhF76-WbfZjZFh1AObH4MeYqnLbj4N6vt94Ul8DuYZMw&oe=6A69E697"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
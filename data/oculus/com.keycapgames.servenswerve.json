_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHJoWaYXvPwQ7kNvwGFaMDS&_nc_oc=AdoSZIc_6ajT8ueM52IYy0elEYzBLk8SrSa3KN2NujoAMKEYlkg5dYJ0kwMiq6JIT1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxckpw9Vx2FzSq49lBTYGzV-yj8hh-G_9umW_uQ9LTs6A&oe=69D0F941"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZE5jVXOAWcQ7kNvwHldDhb&_nc_oc=AdoJEsyu6u358zsOOgKz7GAPoEhpPaHsen3JW82o0jblw4Y_XYEiE7mDjilztTWtiCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp3WT_b-iQHjSynGjjRaJVEGklEknJW488PHB9WXJ7ug&oe=69D11B28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbsANBUD1l4Q7kNvwEO26py&_nc_oc=Adqb9ReTQK827RKaC-vBcpg9Hyag6pCyuFhtIox1i96imOXSYCI4ybnrmlXzvvMYhfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSi7-dPh5Nf2hqyjKl7gjjJoREv2wk2fJYJ8UUu4-NLw&oe=69D0F421"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHTbaytKC9gQ7kNvwF4kc6h&_nc_oc=Adq3df0IJIQhDoIsxKllrvWn1YXF1x8TpLYoS3DX7_xIt6dArolNqS6TycopoFoYngk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt-I3qUfbfzaYQUA-aqtLFHHasurSZlE99kM_dauzGZg&oe=69D0FB1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGqnjlnuwd8Q7kNvwGr0_Qp&_nc_oc=Adplh8fD5IYVgmG5AnPovq6WP9b8uQoXZuFlir8W9gGEzm7knHM-6uFKh3rU9gnYeaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6xbsHPVq0qrYnDMMQea_WOwv8DZegJZtSbcfwlQuqBQ&oe=69D0F897"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
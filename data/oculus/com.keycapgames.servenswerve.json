_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkFYLVVuGUwQ7kNvwFCDWE5&_nc_oc=AdqPp-ptyLd5CUmSvwfj96EgV41n22WHouh6MABT6Vpoc7uPSx8D4Hv8j0psoVgnGfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXLm7C_BvSj-0MXnF10M5QiRvkciawT-W9nTsszEanZQ&oe=6AE4BB01"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUl7fxCyRIYQ7kNvwGdoOQm&_nc_oc=AdoWoZKHx31GW4IGLtV9mD-HwV6Eo1tcBn4eClZkoUjxAKSHvtnskS2IX7j0kqLL688&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQcNpxyFIfrsR8P8ynkpo9ClKipU234Jsc49SBSiO00g&oe=6AE4A4A8"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLLSqvjUEcgQ7kNvwEOdcQU&_nc_oc=Adox_IrXKzDNR-5hHeDt7J0XloKe6X94bfMthhX2ckWl5d0fibc3bGOosF0CjnTyh1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5cngKnsqMAuX0jWCZmrGkbsXZ9BGb7wLCwmN4MKu3Lw&oe=6AE4B5E1"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3eC5pTT59oQ7kNvwE0sFSB&_nc_oc=AdrNEPotfV2HfaMA1nkNsSlQsGysufe3TWVZCAROxGPxvfycJ48tXQkqYF4WensekHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlUNditnEcLU3siDSYmbg93EEdlRjQd94FByxxLjX-Ew&oe=6AE4BCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b8VxFNwlGkQ7kNvwGlIFVr&_nc_oc=AdolWp2SFfBw9ZEtRB2WGhzFEXWgR534w2iueMViorS2BS2PvU_Mm12-I8lDLnjhw6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPymAavtjEVRXnW2MKAVUGEbcC17BtoUaiaoOqpw25DLg&oe=6AE4BA57"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx8AObHdzmAQ7kNvwFAfhER&_nc_oc=Adpb1Chn0YkKX0CBaNdnQU96goU5drWeavN41xthVqAlUonTclJf624NyT2MolLILpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqCGvROSI6KrtGh2sIy11V8i8Yia3BFIlnJ9monhPk8A&oe=69C66D41"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmlyQDjesDIQ7kNvwEMXuPS&_nc_oc=AdqhvLyE9aSUzZhUJ5H615lsQS_k7F02ZL-7hEjPkZF14hD5AcnWG-Ne01lhSvb9QNU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvT_8M3E7MRF5ApuJkG_Om53024scDx9fWPu5WtlH3NQ&oe=69C68F28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8vN2Lwny-MQ7kNvwHNddL3&_nc_oc=AdpSbQnKvTVEgb0XinxSHpseNLnVPL32LW2KayShDjt-YlY6C-B-fhG_pmcsiwvjX68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsvSYMtSpU0oKWNDIS9mPMK8Hghplh5C2co2ssuz7vGg&oe=69C66821"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5JDSijk4RMQ7kNvwHzIete&_nc_oc=AdqkKipczk_q0WQz-vz-XLsm27GbS3s1v5tE4FNT9_YsfYPPUFh215ACgPgeNfcwVmo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuMKSyA0fA9-OOomM_fjn4Jjgic2LdMOAwr956QnpUZw&oe=69C66F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLJy4RvDDmcQ7kNvwGOSeUM&_nc_oc=AdpLF2iyqfURIL4ERg2ZAGz_v7a9Z5Tbhs-HuBOe-b3HnSqCry7Lq945JMCsO6hwRZ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1gc73mr8zwdgCArGQSmGSR1OHSallN0V6wbafcw_jYA&oe=69C66C97"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
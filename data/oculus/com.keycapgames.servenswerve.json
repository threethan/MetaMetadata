_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOt1bwonnDQQ7kNvwFTOfnw&_nc_oc=AdqltEC4-yswRFonpmd54Ab4bqLJZLI586ee3UBx9ACJLPWolXmSGA88ZLb-n_l9u24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjWXtCP-L0vGWfPpnasH4HndKbuQyzhaa3xOU-1RL7LA&oe=6ADE2381"}, {"file_name": "SS3.png", "id": "3751570051806658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297507_3751570055139991_4969058389535930146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p82c0aPwz40Q7kNvwH5UW6b&_nc_oc=AdoDI3Rq35hq1pptELlqGmGERcJAA1kX--NcrE_eXCpVJDrocN6BMW4-YXph0NB0Co4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9HV4hM5svGLhTnuRLVmACkJUVmKtn_Ks8JAvnhCELUQ&oe=6ADE0D28"}, {"file_name": "SS2.png", "id": "783333494488712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821881_783333497822045_378191891586146550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs_EDg3gAJ0Q7kNvwGjhNhU&_nc_oc=Adrv7M9OU5MVGBPY5RCPMOcgzD7IQhQIP2xNOTosg52yHiazgCmo1x0Gtc-cPjYp6KU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVFue-_SlMftxy_C7uLEHxWOxyTu8CpSI9kAH-c-t1bA&oe=6ADE1E61"}, {"file_name": "SS4.png", "id": "1339078157565477", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822737_1339078160898810_3041614870975521418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAgC3ObIhBcQ7kNvwEnodP0&_nc_oc=AdoJqR5z7K63Nvyxlop-5ZR2vk1Qn5lBZuG3uOvCthFjYfteAzDh--mavKwjZF-WESg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmmi2lM6ymSwbGjnz3A4cLntPAZSRZZK6c-MLxT5ShIg&oe=6ADE255F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Serve & Swerve Landscape.png", "id": "24961568720118278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_24961568733451610_5507802112899481036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agw48H8UemIQ7kNvwEUL0cF&_nc_oc=Adocs-hCLN7rortqgYTKhxtzb6y6cXmKcvoU3adXEkMuo4EhtBbmJVseh-usYqI1UIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4hkJDrXofv3_3474tbTVghVUmeix3Y4RErYI8yVW4uQ&oe=6ADE22D7"}, "display_name": "Serve & Swerve", "keywords": ["Cooking", "Cook", "Truck", "Driving", "Zombies"], "long_description": "Serve & Swerve is a quirky food-truck game where you drive anywhere in the city, cook on the grill and fryer, then load a fries blaster and dog launcher to serve customers by nailing a simple timing skill check.\n\nFollow the GPS to hotspots for big crowds, manage fuel, wash the truck when zombies slime it, and keep your rating high.\n\nSpend your earnings on upgrades for guns and truck or restocking your inventory to keep the loop of drive, cook, shoot, serve and swerve.\n\n# **Early Access**\nThis game is currently in Early Access, it's still growing and evolving! The price will increase as more features and content are added. Upcoming updates will introduce new types of food trucks to unlock like ice cream and taco trucks along with purchasable player houses and more exciting expansions to keep the experience fresh and rewarding.\n\n", "short_description": "Cook, load your food launchers, then blast it. Free-drive your food truck across the city, grilling and frying on the go while timing skill-checks to serve straight into your customers\u2019 mouths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.keycapgames.net/privacy-serve-n-swerve.html", "developer_terms_of_service_url": null, "publisher_name": "Keycap Games LLC", "support_website_url": null, "website_url": "https://www.keycapgames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
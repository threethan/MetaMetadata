c_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe9iQXh85N0hdiacuRWRBiCGrRHXVBf6iFQWlY6eOPzQ&oe=6AC7B9E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I95--7DspxEQ7kNvwGT5Xsm&_nc_oc=AdoITZ8xeZ38vDR76ijOdTBpmIDo1-j3h-We6O2rhGtllb92AZkt2vpVM_rJvbkMSgE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSEkVjIeG4sOp8Qj-KI2V5Wvf6Y7eBVfcnaoVi0lf3rg&oe=6AC7AC72"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRnktcBmAmYQ7kNvwFm-Y7E&_nc_oc=Adq72kFBdyQVuPBMDHcxKEJDTIc5NgJ1mWPwP7sh3ui206macwNh1fp3JCj6yGZwuPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEDUyn7t-s_uwc9LTGI430Km59GMk3MrjPxsK6c-jKkQ&oe=6AC7C465"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZLao2BLMTYQ7kNvwELFhwN&_nc_oc=AdoECQO3VNxUrK0NEoTKukW5KYKTouWPRQ2lhonAcJjV8KGL6sUwWrUuNz8Y-mRq7_Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtWK4poqXjUpahHEI7Wt9o9IB28klXryt8qN0HUFqiIg&oe=6AC7A940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnUBj6U3MVQQ7kNvwGvKfV-&_nc_oc=AdqTwBzMuLKd8Y6ui26djuU9oK1crBFtZ5fkUWTeHKEO1e5tVsqDg8-D24ehvqX74-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMiZKUmPItM2caGqCA9YGQrjgJzBNzO1eFbOSLOE8b7Q&oe=6AC796A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
uluscdn.com&_nc_ss=8&oh=00_AfygXAA8FzkCec4W3Ug1yu-fIBCr9z__eiuG_Pb7OCUNpQ&oe=69B15529"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh0Ew6MZhpAQ7kNvwHzylCX&_nc_oc=AdluxDzaG36AYiuz3k2v9DqdkAOZz94esVfGCXM7ADRKHrAahkwKl8VN5LWLiVCJpLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx1_fNOggrsD-m7EH65jskzKIA15FHvngnnbhzLJH85A&oe=69B147B2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wanpFWqzlVQQ7kNvwFtLgfh&_nc_oc=AdmsFyFVYXRvZB2dZo0yo2PUurhEHen8tHTD6F03SGhSvQBJPz5CEyiFb0dTqekJZSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVf7KzxO7hg7IZY7fVDm77Jsi9XbYr1uBG302PJA8ZkQ&oe=69B15FA5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFtePtTkrnAQ7kNvwGEFm-s&_nc_oc=AdmRt6ivqkAvgHIiQ-DhW_f3EFZ84XUrFCNO5MAtFgZlfJB4f38o7YZaxZpwZpig-WA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrU4iuRKrPuItWGT5EMHDmiKua-kma60DE_Zjo0GrEpg&oe=69B14480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbud9HXYcq4Q7kNvwFCUsrL&_nc_oc=Adkga54mw-qklLA1DGUN7WzmXnygXT8SW-tFfTjf94VIZTgaO_sxo2PDB6cKa1z35NY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh0D2EYwbjaWDFk9_sPIJUbGYGZ5xdVuBC-YjzVHPPWw&oe=69B16A23"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "27562
uluscdn.com&_nc_ss=8&oh=00_AfwxD4CcYA1umBrZoeUShswURrUGG42zKg4mPllqJrc2pw&oe=69AEB229"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odK5VmtTl3MQ7kNvwFu-Rnf&_nc_oc=AdlZrevRnAY0ExEl-XtmaF8wnNz9VcUvDo_SfnwzsD014he_D1Mip7a97RI1t9-jFmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi8LAl2s7XUKRCHk-Mlf58yOy9p43aWrN17rPySTeEaQ&oe=69AEA4B2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whh4241ejXMQ7kNvwEcvZDX&_nc_oc=Adm2liX2c8lSXIXNMaTBLzqvw9mUNNGypqiEDmeuph7Ow22DTnk8s8A_U1dEyHAJvuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxonOjk5518gPqatDDgxkeh2G5Uip4pTClccTW94GfOg&oe=69AEBCA5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFtePtTkrnAQ7kNvwE4KnJS&_nc_oc=Adknxii4XWLefW-kpr36yUQqUUpGbCh2X0b_1GwaSvjeIs7G0r6QDkynT0BXx5zvU3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9FZv6yy-JxQOIwv_RZjv1AcBDiW2qkVNTpQTF9sbHRA&oe=69AED9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbud9HXYcq4Q7kNvwFEHjrn&_nc_oc=AdlrSZewnSfYOVoQrX_ioimg3ywgskSDZhVxvda3MRj5_AqSehRF7w3XuGSJQIT6lVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzDQxZg_hJ2m85w9IRBuVBwKKlToNzfQiSYm1SyYjO5g&oe=69AEC723"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "27562
t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI7Vfeku6Y8Q7kNvwGcG1cd&_nc_oc=Adplvy9EW5g1YhrAvWBv9H_96QuK9Nh9Y_RNRIjJ9tV-Vs0iuyax4bNHsqSdQlQ1UnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_SjNskqYEt5XgbTfPfhX6QOOM3CPr7-s_3PwoWMYt8Q&oe=6B0701E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCaOHHx3pgIQ7kNvwGTIn2x&_nc_oc=AdrkLnO0bPTlxrUrOxYqxxXRV-advSNPWh01F45mwedPLJiB84LtQyd1zQz1gF37PPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUi_5jWle-_StRIcIDPyO_nnmb1h4bZn4QKVNdYVFvRA&oe=6B06F472"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nas33-yIZaEQ7kNvwElf_gz&_nc_oc=Adqnv95CmZPRJEkKDBc0Kw_vnCdHVjUzrhFIVsamnoQC3e8wrIgPZ8McXt0W8rt3Mv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb1k1dENp-TILuulhDj7QCy_-dGDt8wMbJRYdVePLbbA&oe=6B070C65"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb1kh4q1L4YQ7kNvwFyDLuh&_nc_oc=Adq315A7g4UyFtd1ODWyQ9aUh7dfeI-YAy2rKV2k1U25AxhEa1Pe3EQuxyXYrFkBgTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFNAj7Gtrud_-G60xKGE_ppoganHWnE0w0RwpnjHybvw&oe=6B06F140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYKjXf6YKuYQ7kNvwGzrc23&_nc_oc=AdrqwWk7yCBBvHM3YzmE3xC_zIt3aWFUswTaPeyJzSK2ajHhTOse429SCMiEq08hYMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUEEP9HBmDuLNJJfHOXtWxnB_1pgppqDyesEIgvoIMKw&oe=6B0716E3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
c_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X0ZEctnwt7TTTSWNa7igayecbYsWupTIISKTRCDuszA&oe=6A2C28E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWOjXduTKaYQ7kNvwHA_Lx8&_nc_oc=AdrXxR4PWV0T7e0YAv8DaEy7XO4jmUkKPPZZ9m8bQDxdaD_4GX8_onr28kQUI68Zlf0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SBdq2LFoUF7-BJA0_QuZ-HLWivxQjGgzi70WjzFc8sg&oe=6A2C1B72"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFaGVmYAR9UQ7kNvwENVJ3a&_nc_oc=AdoirDc9tDhvB1mbT_bwIWXgJ7sZlMkJM_1GWfVHKtRX1D-SrA4EBRThd7GbQOt0aDg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tFDSkCBnu4EZglHMA385s4B_3T40Ej2r5bpUyrHbwjQ&oe=6A2C3365"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR41Gl_5wzwQ7kNvwETZgic&_nc_oc=AdrD6j52Zvma53SQi3dv7Db0owyVVjNgJB82Ki6F6mWjuecQWmLvzZywd1LYSMO16K0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94lGlb0kDKjEf5UpHg-92mR1qzVWsovWQdGhjlPVZmDw&oe=6A2C1840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q_nbNhwvbQQ7kNvwER-vzA&_nc_oc=AdortxQV4rDkR_-tyfePa4w50ibhOepHK3xu6k1DPq0Yy8Ui5D_rlEmbvxtDeUW7sZo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qxEAgmBI0IBOIx7a9yB5SPTq_wEpufZNaq8xlBwG0hQ&oe=6A2C05A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
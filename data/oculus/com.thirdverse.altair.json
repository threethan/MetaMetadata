t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic_ipkACQzQQ7kNvwFujqQH&_nc_oc=AdqSb57eJUlgVpOpjA9p5zaD33ytXEdixSwfZOm2t_OAjaMnb4Pl_Qm-1CvF-lCaaqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0RigQrwKwFVm8FQioOBwnBDEcHlax_2ERt1g1bXSYzQ&oe=6B0DD1A9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T20-u60mnS8Q7kNvwFX_bC9&_nc_oc=AdoLTZ7wsEeJrFQYae9krf6d6MMlLNBuHKG2VBabNt8u3TuNVgB9qfiG43hZO2NB754&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsrKtj5PWC-As4NWbGGnqkvlX51tNWFXVBPMaPDuiRSA&oe=6B0DC432"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96I5ncrOyIkQ7kNvwGjgO3W&_nc_oc=AdrJqFIhI_DjKp3720dXEFpCzAGjZ9UdVFwMB65B5nlYiyEjcyvcdHLydix5Qv-Bz74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfTwpD9L9S-fYfgeqwRfIv453zUI352oyMtm2ZnN4Xgg&oe=6B0DA3E5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=336skTRn7coQ7kNvwE7kqCi&_nc_oc=AdqQjz3bW1_muDpU7_URqG-rYxupkYDWXAOreG24N0l5oUCiF5Acb633xtUmeth_Sms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDeDJhp1Ivlm-dG8-YqWeDDQQPWwB6MDpi-6MBH57mJw&oe=6B0DC100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIsnG1EaBlcQ7kNvwFEa9lM&_nc_oc=AdqHfBDWeOgw3ni8Fnx55J5MPCRCP1KSbidPW738GLLQkV78nXjxfm7uo8-4AX_1v4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8ptAgFjgXfqNfreJElzQvWlpv3yUJlUYd4DJqYJX2NA&oe=6B0DAE63"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
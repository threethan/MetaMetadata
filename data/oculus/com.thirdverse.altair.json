D4A9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Cahq4rfUyQQ7kNvwFXehRS&_nc_oc=Adl0NHhWC0362rwwAnvBuBp8pQUX3JGlLlTfA9dDmchXCfxMV0-0afP6jlgnMmv4KmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft820r9cTg0m8RLj4zIY_6265e-xyXZ6B3Y3y2uQ8Jvcg&oe=69A2C732"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ucE8d6hK1kQ7kNvwELjdGU&_nc_oc=AdkTioKCG6Pg7mfBLPk_HiqT_MX8gS2Bw4G6bWT03ja_CNskJ50-Tjc0VMjqnkwF5cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrubPB4OeMvsw0oN9LbW9s4I4EGJphEBpRaaYgsGAOgg&oe=69A2DF25"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcRXSVgD9K4Q7kNvwGdsb0B&_nc_oc=AdmqNfxHkD_Z6Oc-QtHzniwIoZD033r5XDlK_zJHY_dIDnFA0kSLPkrqZJ0Xmc2TzYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKIsLjF9UW1s_O58e1PyYS65ga_zhUdRwJxPZZEk27xQ&oe=69A2FC40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQMwQ2Piz-MQ7kNvwGTaWKy&_nc_oc=AdkIsagh6u0Pqs-R93hTKB3ZNfV8hl_M71KK3sv92RopgOJnA5Sdd6tiu73FsgKPVK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugLouXJNq5kqHFh_-Spj5I28ND8mxxNK10ONtHmP4v1A&oe=69A2E9A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_
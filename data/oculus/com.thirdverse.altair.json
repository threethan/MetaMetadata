t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI7Vfeku6Y8Q7kNvwEKJ4Yr&_nc_oc=Adot6CHPg4vap_KO6opYYh7kx4bGtJ_-V4QUgbY3jMHW3eNVpm9LLVIqdhQ7OpHmHnQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG7hA56h1sK0V25l_ZbLJL1gbhVhlEQ110EH_cbx34Ug&oe=6B09A4E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpHiG6cp2-cQ7kNvwFlN6HR&_nc_oc=Adrqe53-DVKZ_8fmz8PUCODa6pkbiCLp_qkw4v4q-SSazYetEWAinRPqnEAmozxNN_Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKkofuIbW9Nr2BQZAatDQ9_gElkmy6Vq6jRmlqkuuEVA&oe=6B09CFB2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=161cFRnKJC4Q7kNvwGWGJxR&_nc_oc=Adq4X7Cr_jKe12Xd8BaYooudAxJoEJYNuIT2kCvV0gqb4OIP1jG0qgqYs1fPU3su7RA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc65OlpVgENO-6ZcFFKodi28mkIm-AX9bZDyYHjx-Ueg&oe=6B09AF65"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb1kh4q1L4YQ7kNvwFJGtnw&_nc_oc=AdpzkG1-U6GFR5DChorO4CctndxdPGnPNrzr39fA-9gd9-eFpp3RqlQpOnYUBH8gSFk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRer5Fcc9hI8DLdi7AfiQI84aeax_UR4Vfts8GFsFUi3g&oe=6B09CC80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYKjXf6YKuYQ7kNvwGh_CnD&_nc_oc=Adq9Zhk0sAzYxyPaQf3tCMfzRNlDNP3839kupxs42zVDonX-E9w-nJlcIu2njCHkQQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOKFPJ2K21vj5N4IgrXT5in-KAfiEdeYlnWCd7AFFRyw&oe=6B09B9E3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
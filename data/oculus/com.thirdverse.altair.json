c_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRolvMvWcpcGfkT6j21VkuXS6FqVsVQ3xxYtAtZkml6Hw&oe=6AF9D2E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6bFLunJ72AQ7kNvwHTCA4p&_nc_oc=Adr-bEUi53TP6yUkwoAD68hWxhGeOOEmYuA2d-992k1uLWyRE520RqhvhhNJgfNBd6U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy_O556wXqtpUepOvyrVlmNji7G4Dc9MetDswwSvSN7w&oe=6AF9C572"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thh6kyxR004Q7kNvwED99Tc&_nc_oc=AdpygSWpzcTwgq918WIpZjmJBMAubv2iNgsVeB4EAH-ZeRJjraUOVzdNdGnM9VWTYuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Oy9qp41uQigidqCYccd9_Yj9AeORZ4dgTcWjrU0UbQ&oe=6AF9DD65"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nOuKN1tP3QQ7kNvwF4W0VU&_nc_oc=AdpVs7J9sRqSDQBuYhQzmVFXQk-GMnFE6-8D-skk3oHTeq_g7yLGSHNGiBqZ0Q-guTs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4KmzrCXGEw5cVfhS_FryhBU9e-HhySkH8rB1--kOSKQ&oe=6AF9C240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WApVl0jvOnkQ7kNvwGU9_m_&_nc_oc=AdpD2hi9nDHGRGUMIekS-KfZmU69jr6chPAIDWVC_PxB46Z_TvTC7KGdEQ96ilY2ex8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Y111SBNGP58nvVdv7BdrjzPSFX-H0PTlycRgjXCUEQ&oe=6AF9E7E3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
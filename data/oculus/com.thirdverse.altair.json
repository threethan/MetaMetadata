c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gbdbE7UxFBDJ3avOk82Aw5eK2ihm0vf5an2HFjPNgOA&oe=6A186269"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcXTMl0Xbc0Q7kNvwHBdP9a&_nc_oc=AdrJyMJnT-qtYMmWsmWO5vuukYGkq6xbMSz04oNARm1B0IP-K5r5BQVCWDtXgZMR7GY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cSDn1kUtq9vrg2upmxoCUsS8VkrhgD5qw9Z9lK1MT7Q&oe=6A1854F2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM8WJZ0eOu0Q7kNvwHl2TNv&_nc_oc=Ado2RE-J85_1SrmDTTppfXe5rV-ioX-peWCT1P_Q0vzyzvjV8QG3L_o3OoPsjkqJzgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bkwYAL7BT3ypesN4XlTMZ879690gMMYfNYHbCipwrpg&oe=6A1834A5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okl9Nc4vzb8Q7kNvwFsE5dV&_nc_oc=AdrAObA1Iu8xyVWAR9o5vgIbzU2sfdrdnfqYFHEVf-AyWQF8f5h9dboei8tpRGkyzYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E_7NJsoy7iwBgirCnCY8zNt7QROGQNR61O1kAj9K3Xg&oe=6A1851C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n-Np4iFydMQ7kNvwFn8EKH&_nc_oc=AdomAbgDmB2ATmI9CNNn6E2c4RZN_dVLSeYIotLmyFbU_lvoild69o7ZSYRDdjFAa0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dsIKzAvYAZVU1PNA0ghwU6mLiJPa3VjO6qKKPsfWDHA&oe=6A183F23"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
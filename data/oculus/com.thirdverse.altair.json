.png", "id": "422836609754517", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=161cFRnKJC4Q7kNvwGWGJxR&_nc_oc=Adq4X7Cr_jKe12Xd8BaYooudAxJoEJYNuIT2kCvV0gqb4OIP1jG0qgqYs1fPU3su7RA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc65OlpVgENO-6ZcFFKodi28mkIm-AX9bZDyYHjx-Ueg&oe=6B09AF65"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb1kh4q1L4YQ7kNvwFJGtnw&_nc_oc=AdpzkG1-U6GFR5DChorO4CctndxdPGnPNrzr39fA-9gd9-eFpp3RqlQpOnYUBH8gSFk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRer5Fcc9hI8DLdi7AfiQI84aeax_UR4Vfts8GFsFUi3g&oe=6B09CC80"}, {"file_name": "store_5.png", "id": "808510233851899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001698_808510237185232_4332461869180106686_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_FkZQ9-DisQ7kNvwEOvnmP&_nc_oc=Adrr_eLsoocW0yWB3t8K2ADWOy0rbXxam_IMNBxVbKagvzWBM96w6a5M2761-ASL9R8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1xklYt591QCwFd44NasPaRrfjEnJiwaJuFGDOSmGpdQ&oe=6B09A3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440 (1).png", "id": "1149947469195227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974751_1149947475861893_3742548628872915671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e4QK5LLbysQ7kNvwGF9NOw&_nc_oc=AdqITD18Lmscua3_OgJpFSTzmlqGG0FFDNclq-RU880pg1wruj8L467T2NTmycuyOX0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSyrwsv5ND5zG2XMPKdOvNgp4TK-S4gYsTHb_O4YyFbQ&oe=6B09A436"}, "display_name": "ALTAIR BREAKER", "keywords": ["SAO", "melee", "blade", "saber", "fighting"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": 
2629"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Cahq4rfUyQQ7kNvwG1wfGR&_nc_oc=Adk8h2tUwrXDxdm2Mq6zjkzrkUIZMWkq8713o0XAQL6mLyG3Yvh5-o76qAc917rOBaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftc6VtfetzKjoTJx1muTUXVTNFsnZgyODmSyTbDGNo-cQ&oe=69A450F2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ucE8d6hK1kQ7kNvwEddQaq&_nc_oc=AdmXfzUW7Fr3_5ts6mBduxq1TEXzVm1BlyLbDfXHCI5-jcNn2umXJPiBHclPrsKYqEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfszcNNYvdIzRY7x0Yr3vz539ENNVk-mtwBXDxO1MhO8_w&oe=69A430A5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcRXSVgD9K4Q7kNvwGog7Vb&_nc_oc=AdkzgtKq3QNB8QbucQm3wSIBe3J2UkPYocVJ2aFd5lDQj45HRPuqmOdAcj9v9RMeXLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftweVDsGYzJvy_1qBi4PS1OfsIWM7l6YBIQpcMV-yeUzw&oe=69A44DC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQMwQ2Piz-MQ7kNvwFcgV1N&_nc_oc=AdmkO9Iyhy3sCb66YmAol4TE3Dp0I1Uqzq_Mkq9A4EjyJGMM_4_tKBncCM4Yk9JANOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvsz7RJPYXl9x0dQt37sw2woWJujWUxoEX-id1Dqn09Qw&oe=69A43B23"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_
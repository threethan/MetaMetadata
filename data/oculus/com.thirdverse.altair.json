8329"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Cahq4rfUyQQ7kNvwHVAoEK&_nc_oc=AdlT5WN1weADJsNOk9mfL_29qGVqAJl3NM7dZlvwjXm5ASmLHbf1-Xv7CYD50RTX6-g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuQMen_rM5qQINmUCrPq1eRSNJH7vY36R1dgD7ZGqCMng&oe=69A1ADF2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ucE8d6hK1kQ7kNvwGK2Dnr&_nc_oc=AdnH5-ltHRZxd3TIJmuXC8U9OE41AwmX1zpfvfxNPsVvg6CEeImoTI6Xcs7RpPVeijA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftYx6XkkMyQj8yBatB78fS9K3eMiIzBYmfIzdMMqfzs9A&oe=69A18DA5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtq1FbGJjJkQ7kNvwEpW4LR&_nc_oc=Adl9qt7cwSvMR88M_WRO0HD_3WQBMehSGyME-X_iaA74N7d52OLAQrxadkv-iZ0s5uE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afswhsd-4iUkZVylkIDiAjXWK1GMNaeKNHgFHGnKF5fwgg&oe=69A1AAC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfJrnjN3c2AQ7kNvwEkJRnM&_nc_oc=AdkT9MYQ9aoGfiznCiSZQvE9SM1C8yYzmFL24VL0nLNs9sUCN3dVtcWTPImF7_gU6PY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft_r6DdP2wmNZ0pX2hYV8ssjNtvjHzF-UQpTXPwXbdrYQ&oe=69A19823"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_
.png", "id": "422836609754517", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thh6kyxR004Q7kNvwHmEeIe&_nc_oc=AdroqAz02dk7nfOpAuPWIzhGT9yU9BiSlr4ZoIaWE4KuMmgzsSgtsDce6Uol9N308n8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8ejkBDUQpne8A84K4R8bJe6_rt6TjwWCKuDBaHfRJ-g&oe=6AFC8065"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_3kHYDjrq4Q7kNvwFYCMsz&_nc_oc=AdrDkRezV_ON-mdSwyHSz198Tl0kLwRdfs3K_XTjLZ2dXRpIwCUKRg7uVWZtnyFUFGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg4wJtLJP1G0KHZEtv8ESDYCOJvLwfkfAo41Ni_Qrjvw&oe=6AFC6540"}, {"file_name": "store_5.png", "id": "808510233851899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001698_808510237185232_4332461869180106686_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxK6fwxGIt0Q7kNvwF1FFFy&_nc_oc=AdpnyLf2rqRC02Y94ApSu2PZVSHuxTXYwDp_n83TpUzoK_ZNXVdkp6WQCPx1dGrKVIw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkH0TKdFB-_eB5gjmW3LqssNr1Fdu2XlJTJkc-CPw_Dg&oe=6AFC74AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440 (1).png", "id": "1149947469195227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974751_1149947475861893_3742548628872915671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcHQtOHp2XkQ7kNvwEMQbo4&_nc_oc=Adrldr6ECXgMRN-fXzLHfK5YJYo0qJX1TYJmqbeHhpOE0XzwP2uqdEWvKsOAgpNibEI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5P-vfzA7kanOvX2ezR2i7ad_nePBMupwbOPDwFoLVg&oe=6AFC7536"}, "display_name": "ALTAIR BREAKER", "keywords": ["SAO", "melee", "blade", "saber", "fighting"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": 
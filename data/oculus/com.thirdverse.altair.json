c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfvB60PYLc75fm6dL8qqZuBkANoN88RiEu5o_g6czvAg&oe=6AB2A1E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3VTS8lv9toQ7kNvwHPnCgR&_nc_oc=AdqX6aynsgGnIb0_7cGgUIiLqYXzGQEYGWAuwwp5yTSQ906n8Q3FGJcgqwVYoSkKInY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZYAAxkRbT3fnF5sOcB_l0DW-VFiEHTZw0AAygvTLZOg&oe=6AB29472"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Rci1aySAcgQ7kNvwHQmHtx&_nc_oc=AdqGeXKIJU1_QCODpzRs_fMcCJN-FMSzJvDQvQqwzYo17r6uXc4BKwL3caXfv8igQmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg1ueh-Zx4rkfOp7SbM0CRxN9Wk28bsNZbIMdaJD4bEg&oe=6AB27425"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdbIMMgsOQoQ7kNvwF20Muy&_nc_oc=AdpkUrQBDeMNGKKkBTsY4lYH-osL-ERvaP5ap--7n0bc-SsKOgpO8Iy5CbghGyjHd3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnlqtI5AlMIqqRNTZcvM_Lbo8-3SrZWr_DhrtongYw9A&oe=6AB29140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf8AWhs7FfsQ7kNvwGDAPZZ&_nc_oc=Adq5S8Dg_Nt1a4pC_bDaENpbHZ4uZFx0b9cm_FVXKruJxyeNt5ITyebLEqmiKglT03c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItEguZdwRpah0XFynE254QWLOd7S9dNE_w-HIpcg-GTw&oe=6AB27EA3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
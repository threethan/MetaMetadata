c_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UW5qDeBpje9p9cq0aZ_6Nm8IQYMdyvU6OXIOtlS-vzQ&oe=69F491A9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9HvD65Lpw4Q7kNvwGHPQBl&_nc_oc=AdrF-OuxKKEDvFKmsaaHnzMlrlAUOCiw5xvwUQ1Nle8wEIjjSZLYn7D0kn_Xlx6dyeM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lp3G7JNm0SzJcRbukk-gCu_EBn-for75XsHLvJnsFbg&oe=69F4BC72"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmzVoDgpLO4Q7kNvwH4YANU&_nc_oc=AdqryIxvT2xsMXh4dhR9ZdZkdnpagotmbWllV1EvVBaBNPM1KI6CQXJsb5hIozYR20s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JqsHPLSkQ0nqKMAN968LXA7Sz2ESvJvcvVuP05obMaA&oe=69F49C25"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYJ6WTEnENQQ7kNvwFxtIEa&_nc_oc=Adqhoq1QxdZOH_5-JwM0auNdhMOElvLyjCmJs6iAwsOfDuozbFjOKD9aaddb497h1Gk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tAu50eqWMf913bC3s4fkVN28wKcFio8H_NVtOh_Q0xA&oe=69F4B940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxONY9tnD3gQ7kNvwHtz3lQ&_nc_oc=AdpuGVL0Sw2hFDR1zGgZ1v8kLra1vNi9zsdW4lkEc6Zr6ZOAC47w1vpyRcZ7P0W8CQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30GvYcXiwkA381J6PrFEp4g8a2sGQckCpZ01WP4L2huw&oe=69F4A6A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
c_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSePktnNGd5h3Lx-OL5NGQ2wpYtD0emLRwGiYV2KYRjA&oe=6A9AE6E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c5YMtyUj4kQ7kNvwEHH3VI&_nc_oc=AdpZYBhQZDzwX8mlr9BTTtGP_LuwueP1He0YHRAkUElwCAWhjZjCL0bHLyl9Rl4h598&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-NFToqbcuYzlL7Kh8OFyAmGw6l3hA71Qugw_eUkBJCQ&oe=6A9AD972"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFZttGL9uGYQ7kNvwHtLGTm&_nc_oc=AdoY0svTSeXaFo5eh6s_OMFskid-2NfW4YWYRyqMlzqqUx3pAv7rsUqxlXN0j9vELJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-3aHF-Rw3brjoNPHnqKLqemAab0AUWKPPJ7bPzGRH1g&oe=6A9AF165"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CW8iG3ZMV8Q7kNvwF2WZnK&_nc_oc=AdrhVQf16zf96UgOQ-7gx-x0_usblkaZa38aaGEEsDKPqQ6TMQs2a4Ez9UHctpbqv5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhw8yRtKO5ADylyG-EoAnVys8qiLu0xli6D2EH8ZISKA&oe=6A9AD640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw6K-k7h6rkQ7kNvwHmaisJ&_nc_oc=AdqSmAOIFefPRL5wpymMw5ArWPMeCK-QYuPOZ4Ck4uZSak3wxt_LdaMcgaZHKANA1gg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpIm6PioObgO3DDTpb5jOUmJs8OqnpkXyy9dmpEyjATw&oe=6A9AC3A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
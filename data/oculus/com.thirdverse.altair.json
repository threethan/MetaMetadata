c_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBidruHPkJD5oKWYFnYxBxIRkunyahKlC-fNtPdYBp0WA&oe=6A4A7B69"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zpWmOUvLMgQ7kNvwGBIWpk&_nc_oc=AdpI8nmix_3m_LUGUvVS4m2TPSArXEfwCw8wdLXnNdapiCJQV-x_6tfqTvGSifUBgOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_62YoNrFmPweq0134bT8etiNfpvQEYVFdzQ6xRtfgTQ&oe=6A4A6DF2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBWtfZ8aLHoQ7kNvwH2KOSy&_nc_oc=AdqHNClCGdWFxvuGtIy0s5_SVuT7IN0OQl2AieCfLr5LwwsdQaGEO_9qpvHN8TP2VF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOFaa3R9gR-vfhDTubQYzNQkgWeJSKFMV15QvrUU1jfg&oe=6A4A4DA5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYNZx2GLgm8Q7kNvwHXjh57&_nc_oc=AdoiJ8whgy-XYbX2miznd1bSZG5D-iydSPVmPRtT7t6cBf4JFMtf4tAmEgVOpexongA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDquIArh5mC7cdmvJPh35IsRfOM9-Gb4MJvRscVZrjFRA&oe=6A4A6AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoxQsI2VYxkQ7kNvwH-2CH5&_nc_oc=AdpqijHfczoRFqh4VdZl8McUJ-9-w2jfnS1JbilulkpPWvIYC5Bf7E_u-baECFZNGoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAckMKwed1Ja3n773CYOGLVpRNS7PiWTdCvhHB5plf2JQ&oe=6A4A5823"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
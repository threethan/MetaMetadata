t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPHI_PCJDrsQ7kNvwHzW4BZ&_nc_oc=Ado4gjM6QRVeEYoDyYDBknHr-EUeLOJWpM6xJOrnt5EcbbfT_M9l13RVVg8XunNtIg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTihC73lEFIsFe3A8fNB117XqjFbR1thWHpCNR2LfbzbQ&oe=6AFC75E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6bFLunJ72AQ7kNvwEdUGIm&_nc_oc=AdqeTL7Qu0JcDyGTrANIlehgsCpbFq94ZOpZLhquEwsxtQqJ-ju4_cMUMduXESj0ew0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8xfJ3jg-ka2S8ESksATaTyhWeW2ORoGYeYsIQQoY-A&oe=6AFC6872"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thh6kyxR004Q7kNvwHmEeIe&_nc_oc=AdroqAz02dk7nfOpAuPWIzhGT9yU9BiSlr4ZoIaWE4KuMmgzsSgtsDce6Uol9N308n8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8ejkBDUQpne8A84K4R8bJe6_rt6TjwWCKuDBaHfRJ-g&oe=6AFC8065"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_3kHYDjrq4Q7kNvwFYCMsz&_nc_oc=AdrDkRezV_ON-mdSwyHSz198Tl0kLwRdfs3K_XTjLZ2dXRpIwCUKRg7uVWZtnyFUFGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg4wJtLJP1G0KHZEtv8ESDYCOJvLwfkfAo41Ni_Qrjvw&oe=6AFC6540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaxUGHtF21IQ7kNvwGOFOr7&_nc_oc=AdrpQYHKDwJt0Wa8e8Ak5_Beclm4pp66qBV4MaNKCAdc6YtHoep8rycISiJxvt9Cq-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4IpoLd4c17JIoT-s5Uoum0E6ayKIoYA2SZtMw3RNrcA&oe=6AFC8AE3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
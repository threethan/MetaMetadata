L8U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xgAsSc592h6GFLzKYHJ7jqEdNbAU52ZW2irWOUWdzrA&oe=6A4686E9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6tDKs7jsOQQ7kNvwG3vcxh&_nc_oc=AdqXAjnLLOpb_FjdvWOlAezId9RAJVf-8aS9GWrq8UDSOURB2Pm753B1bC99eophDJs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eUGTPS6gFbdlw8tEgk0XJDasjLgqc1q5i4j1mi-NnNA&oe=6A467972"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voT73sqVircQ7kNvwGXPXYk&_nc_oc=AdojBLHcZyePXyjFjLuWMbaGjeNe1aR9N3pY-Ub3kp2QkU8DbopJ8xsMva2PgDzTSbE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J-J6qR57sxV4b1WDprKHVWDJzE4kY2cYr3UiXi6-j0w&oe=6A469165"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwNuG5B2UQsQ7kNvwFSRDJ7&_nc_oc=AdoeW9ar4Dn7DAy3AzG5qx13q-GobtDxE20a2N9Irt1WxZ1haK-VMaVOJtnNZE32DCE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aMMSSpfVBIlt7wu0glIcrvGtHVDiPewclsLFF8uQiug&oe=6A467640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2yXZ7Hdxw4Q7kNvwHmDo89&_nc_oc=AdrzzIWDek2rf-e1RRSkWdWO-0hm4R4s9Z6Xa2d3ZqOuxxpMfn9VBV9DRi3e4bfrAzY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af864wja11_P85iHuAvUmv7w6ovqVJahDn5eH7OsHz2AMw&oe=6A4663A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
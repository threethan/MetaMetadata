uluscdn.com&_nc_ss=8&oh=00_AfzubS3fZ6fdqjRsnP42S3F1IIn6I1sFFnsg-Vz60DNyVA&oe=69BFD5A9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNkd3RDN5RAQ7kNvwHE7XfZ&_nc_oc=Adk7QuZrRZ6J7azaB8nLxqmyZ7lY_IrYWsdtFW_dqYBHP47dBSsywabhJiquXidY5hM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmSzKScrqb1t3x2aBeUq6YfwKjK5jruJZ9qavV6eG9bw&oe=69C00072"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FWQbQtBF70Q7kNvwGfSZfN&_nc_oc=AdmZSXrdGEhdZTsyvuqTwzL-VSrLFwLpCajIic5An3fU11FKLywBRjEQKIjMQDY-rSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4WOSgTxDeaZpe2D5zw0GAsAqP6kFoyqbTqttdtYEIRA&oe=69BFE025"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUdgCi8yi20Q7kNvwFh27Vy&_nc_oc=Adk3fVweCFXFStVa4RVJbPVESsnJd4x4IaxiIvfLjCc8KwcYWgOQIbg9hxLlfsNJg74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2YngdXtS8sgdCyIznF8z7WWC_wVKiL6aAbjw5j93OMg&oe=69BFFD40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeYnZTP9P0gQ7kNvwFWCdvc&_nc_oc=AdlMBglyV_N87_aid4uf1UDNJahcKFiJ7BaV1JBBSA9fuLo11uELdUFvdiUaU4YG12g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGm20zvhHeko7jgxMChJ3rJ3-evJ1wmAcxJg97aPkW6A&oe=69BFEAA3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "27562
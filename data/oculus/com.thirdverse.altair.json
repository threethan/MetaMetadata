c_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItx_Xgb4WVnkY7rUswsbPKQQw5OpxjoT8dmU1RES1vnQ&oe=6AA02CE9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU2hDYjqBSMQ7kNvwEq7gnG&_nc_oc=AdrRNpTPtq2n7bg9WYuLSTchzAUcYZuQFUyPX_dXCl3tEDotaKOTYX2ZODLB-GXsqRw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi_0Olnd7zN09UtaAzhaqg8H_jUT7NbalS_fVYIkP2Fg&oe=6AA01F72"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ2ej6hSGssQ7kNvwHc3Ety&_nc_oc=AdqG8cNrMIJ3FUxsBuRINkPCe9Fv3HyhjzAsOt2mXQ2wY1LPGBVEDxjLYj3Y7upZAfM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtuZFN_fd35xOHSd4-g6Yu5FBZFErMXlZsthwxaFErMg&oe=6A9FFF25"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZo_2VjPwXwQ7kNvwEwnNT-&_nc_oc=AdqnZWGOjf3awNh-7wFRpiiEZ2P7Yd7FyDygbRNvHUq4UzFEM0LqmBtvlAtv364BOv0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJprrZYhKv-G49mo7DdwFUEVXQCZ5Ob0SZtwimAdk_yyA&oe=6AA01C40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Mpi4DKsE0Q7kNvwGkAe9q&_nc_oc=AdrtP3xKn9vs9_Rd2CtiyoOgQrSydD9PDX5cRbXeggw8yXqKHnquVMbFonqt0NTZxEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiRDxZuUmasDoltULsCF93qi0Rj04UkPNfxbPhKuEC8Q&oe=6AA009A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
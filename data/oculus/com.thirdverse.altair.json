t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic_ipkACQzQQ7kNvwFie21i&_nc_oc=AdrPgm88zme6BwUuIz8LJJuP1me-qtcsTlKh8fhE44uvvru8lTBoPgVTeMGmP425I-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdBTNmlzcNkhJVYL47bwt57ijsNn9_cSstBEI8wMtiRw&oe=6B0B2EA9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpHiG6cp2-cQ7kNvwEya1WP&_nc_oc=AdpjcrLO9SJk0FQvm5jjutP5O2LFgAyFlFP51G_cWDJn5otJMBxopuNxZXzV2E0zqYo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTS9mGbwdlBrDR7SscqFv13sSaSKhJGuqksHL7ByM1ZbQ&oe=6B0B2132"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=161cFRnKJC4Q7kNvwGR440y&_nc_oc=Adr8iDTvUBIrT-PLXH79ESOnPUkXo7Y_3wOvC1nB2sdk_DuO9Ize5TucLp6Uhiuu9V4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzy1p9ayG_0X-NAT3zEGvRJiIsdJmLcbj_iknX0uTaBQ&oe=6B0B3925"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=336skTRn7coQ7kNvwFovwHl&_nc_oc=AdoMyYUHTSQpGrQiEZNcMMF9OMCflfDlUrk_DJAyBro3dIA6yiJamYjAYlfi4nXPOVU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJjCbfLeea5LRGGrlRGgx4CtZGVcBOYQ2J6nWChHtTQQ&oe=6B0B1E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIsnG1EaBlcQ7kNvwGER9D1&_nc_oc=AdopCNbKKJv40SekvRCNGnPKS0ORurZJEKPMyiE0IqrMYY9tDggisb1yArDvYKhb3NE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_aVRDObfGy5scFuN_V_FJIYRLYTrJFbcizrwh3uLvyw&oe=6B0B43A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
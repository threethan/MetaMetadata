c_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmaQUoskj-IuGz526cpGFr7-yhsk7W0GPyp70UvGimGg&oe=6A6895A9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUcBjC7GVlMQ7kNvwGC0d93&_nc_oc=AdptLpDqgmQkOlmHClI3XdKc0l8qmJ577T6NQgD7Kx1wAIspwN08eCHqNQ6ulzf9-Os&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVKsrhPEtWaW34tKP8Y4JL_o-4EkExHZGldRJbxoxwsA&oe=6A68C072"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItZek_1eyPAQ7kNvwFT5ia-&_nc_oc=AdqcOox8u6PO8k40of4FUgdz7d2kRUTg5OV2j_JX_Iz14X-JAt1aOJdz53_regzlvAI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChMEdbUO-EWzIsWOVg8bW1U5MQQEnaPiG514NfVYp6ZQ&oe=6A68A025"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLSx4jgNnAMQ7kNvwEwAUPU&_nc_oc=AdqJ75F9UAq4SVFk1vzjtD1IKq4bkGkT3a5Y8NSGhJz8KWAg-L6heee3UJWEPz23VHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsXLjluTxN9oymCkuPpkS9qf_pJOgaOK0tt0lwBln0zA&oe=6A68BD40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWku9jpaLwUQ7kNvwEL3MLk&_nc_oc=AdrCrwDcnQBc1TsAohTGbetm8CtxHWxCHnCp_7PiR_QuxrAwD9QpgDRt2foQ__F6cRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8KuJIozG-sFkck8ZnlFhEujKZAsrTZ0c97Ach3_VHaA&oe=6A68AAA3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
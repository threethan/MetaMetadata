c_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47C8gzR7AWKBEztk4ITAf8MzQ80y1chLzASGvzbQ4i9g&oe=6A131C69"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRPvBhPW24oQ7kNvwEQP2Fr&_nc_oc=AdqHXvTNC96fV3hyoPY6qdPt5lzhg63Jtr9VunB_Cks1gIEWWWREFYfQ1edf23BaV98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W7sA3MC3BMk0cqhoEkho0je-hb5HGuL0NqR8ANHjsWQ&oe=6A130EF2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxWnkO13lgcQ7kNvwHsohoz&_nc_oc=AdqmUxAihCT_ZaydeZCcBXBE8PKfX3kMnvC_5Hg2GVe-RL9TE10qOMsSPFZRmLsPS-k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NgNFCD1QVY20J7zdgua8sgCCCPn75a_dTD73_9sL0Tg&oe=6A12EEA5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XHTU7zL3dEQ7kNvwGHw0fx&_nc_oc=AdqWZ4y9f6_ho5B6PZ_pfSqmBG9CPerxZozla_Lxpci5Wct4PSo4pgd5mnDQF19y4lc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PHRuzCs9Fn4DIAMVOuoznNvAo9N6i7TudEodlFky0LQ&oe=6A130BC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqD3v317A3MQ7kNvwE9XsRw&_nc_oc=Adpl6vl16bVwfKxpuH1j_WMex-bf4Jiq677RGl452WtJwul2ZWdm-TuzGTRrCu-ZaOM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eJSoJomGrr0NyGuzN9ZdgyKCC6rREGXil3DTGAo132g&oe=6A12F923"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
c_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDDCjIhmrd0qpB3CDC-euvTjX0SFUuuaTU2kap7a3MDA&oe=6AD39769"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUVxhg7Q69QQ7kNvwEY2OW_&_nc_oc=AdoxDdDD6O8biH70MKtwEMkrDO-rTB79lHYPInSb-P_6w9ukvVJA2-bF4lpVKF6NL7E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2sqhDTOher5B12_tGRfOIxUoHBlG7mqgl1g3fZGKVzw&oe=6AD389F2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxdYJjz0qtEQ7kNvwE3RwPe&_nc_oc=AdoyD175atVsXaPv4H_qPIshzJqkbHk0c-kCW930pTpiqYgfzNLSIL8-EXvLhSTsn98&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4r0zYbDky0b1K_rEJR_zVVmDLRHllzRvXBDCDQ-AZkQ&oe=6AD3A1E5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTuqJaDErzAQ7kNvwGIDn_u&_nc_oc=AdrPfsH2s37fpjq9My9NDDHdigAS7cpKlfWKzTl2dOCv7y1MClt9eU-fqWTonsR4Vv8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnW3nqkI4Cx-9M3S7TGxQuwe0Zj1STyDrT8b6ZVEln9A&oe=6AD386C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAFjYTlkELUQ7kNvwHWEbgB&_nc_oc=AdoBi6ryF6u7vj7m90xux7QrdU6RcCQ-RGF_5ToXNBpvyK74N7LGgd_e2Arg2bwMaYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML2zYMqRYXwTyRaDRPSTWL89M55HxHzGdsEoj8IhihGg&oe=6AD3AC63"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
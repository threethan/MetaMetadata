t64.5771-25/65227368_3255746151320869_6996041940704008745_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqAcd5-z_6gQ7kNvwGQTaaF&_nc_oc=AdqhEjfoWLnmtsUo_EVEuEEeMqasuWcQFKT2D4IvH7HQfsGIsX2VeYUywcHpj8vYdvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9lMUPTdvuj-xmcztXXg4-nHklbCtODxc_c9MDT9Ai4Q&oe=6B103C69"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T20-u60mnS8Q7kNvwFzBTpG&_nc_oc=Adrv-o1OIy_EWgk3iOfNhc7R1XhZHrOWEDNqyd5vG6tUsOuuCGPHs3uttk4dfltVg2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLXV3sns6kSRVzSvUIza6f4ee9T6DfcLDaej7oRPxudA&oe=6B106732"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96I5ncrOyIkQ7kNvwFr2It6&_nc_oc=AdpDiTkqqlXZpuck_TPNzJ2_YRvkcLkTV56Eirx3Inr1Y4GnM7LTE-X-pCRhfQmhL-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCKVyF09e3eONjpEsP54T9YIBGhnSWt7rr6tCouPjosQ&oe=6B1046E5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvAJfat5TPwQ7kNvwHFstDJ&_nc_oc=AdrQJmvEy0HLCbMESLnTFU0qLsAZS_aWEejp50HjiPO8cR47ejvjv72GUmImgquHiy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqVXSh2UjnLDNjBEgXFFFhFMAkfCsTXZGPXsyjA79pUA&oe=6B106400"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o3xEVeyecUQ7kNvwH9KQ66&_nc_oc=AdrFNq8WdbCaAo1tgvJ4_1_pdXH__2S0yBfvQcatVV8TOoXE0YCKfCIWkonSWJcFNAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvd9BhB04EFLApV7MqqNE_ZvwL1qDPGaAeCn8y-CtB6w&oe=6B105163"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/j
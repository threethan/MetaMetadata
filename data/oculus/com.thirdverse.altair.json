c_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93J2NuO90zfGwNfj4sPMJ-oKF6Mj7x0Oda_Pe8KC8pSQ&oe=6A2ECBE9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWOjXduTKaYQ7kNvwF3tna4&_nc_oc=AdoyGd2qUJT3VTqm1MLZsCfAF9SSPuvcsHeJR_ILOD15-4nI9IyH2DuzvLydAP7zzoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zX1Pb2nhAasUKcILpa1fnkziJHL5Gf_KBkgUBQCZv1Q&oe=6A2EBE72"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFaGVmYAR9UQ7kNvwFvhKMT&_nc_oc=AdpOVqQfcrb6k6HqXkGRAVVUP1vhSa3GI3gYh5hKFWHegcKMZU0lMcUpHBpWBR_2fN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MAbiFcQSC04PULVY7y9ccWS65UTaFn0_0Ngzot4qdtQ&oe=6A2E9E25"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyRNnIOhZrsQ7kNvwHo6Ehr&_nc_oc=AdqvUXlsAXVTGRcddYT500istDy4nUd9z6WeUlIowpGO6wiCMwjyhEwdXF5h6ho0_KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y8UjCCx4OHRqomLlLeGeCGSH9nyHtnCqsLnINu-nHGA&oe=6A2EBB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpLsgCM_iwIQ7kNvwHGPf75&_nc_oc=AdoO3jC2w-dFcZJUkvkfFcGktQcUvztzjrUt58IxoQ3Y9BylHqQ3B6Kjefcfxc7nBgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6eZZDbMXmCCbYIu6X4Nva1CoacSl75cAGhFjHHkuC_Q&oe=6A2EA8A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
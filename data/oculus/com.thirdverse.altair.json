c_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gih2snb0Gqv38Ogr80yZrsVDz661gaNXZuq7mFgJD8w&oe=69FA0FE9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnbujK5J0zgQ7kNvwGFR7YT&_nc_oc=AdqkNtmkZ_2fcsCPWaY1OXmCNT_PgNdPazeA_sG9FyzQSRj-0URivdNEnAXEiYos3YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4apw8kGH5v6EkNH8c-Q46lizVmTNcG2EePp5xdd9keFw&oe=69FA0272"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtftT7-KI_gQ7kNvwG67IQB&_nc_oc=Adov9KRfASag418waR19KN1qzl84ZH7jeR8FXVio86IopLhVV12wsSm5hDim35NENE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jhKF_Vntm4r2bQ_U8avDb-GCxp1mxvhTBHKs9lpQz7A&oe=69F9E225"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU1A_PsF3csQ7kNvwG1khmu&_nc_oc=AdoXF8V5ltynaHOTs5Se1KGxUPKOLFDOns1lJovhB3FZY-HepUwslR2iBOWiDdGL3SA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sAeJPD-6NnDfJo4_UIw0OBruqzN0M8igUOJ-jgi7FPg&oe=69F9FF40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcZhNhbRZc8Q7kNvwGAknGM&_nc_oc=AdpARpMp9-q3mZT2doYjdHhJpGQpDK5shuU5AjR5ZZ_px8QU3_rNjooghbC4JANFdzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oYaX0iS-_cERvxH1HMyEIi1HvTOFZgWyt79rAu9Yt8Q&oe=69F9ECA3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
.png", "id": "422836609754517", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thh6kyxR004Q7kNvwEnJ0Lt&_nc_oc=Adre_l6uhL_lmCzGrIaVIwqaceC9g3LcWDS9HAEZ5lv8mMyi6RVkpLmz3uBmiZJlaaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2FFOzNhSik512PNrpmasfDfyyPMfsDpRT545GYLLyPw&oe=6AFB2EE5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_3kHYDjrq4Q7kNvwEfepcV&_nc_oc=AdptkNe6ZKNrwSELsK4_SM_uMTDT1swGtQAolrQAjs6z9h6hX-rRbG4ilRDBuMUTVMM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKEs333jfiHQTeWGsc0mK166j42VedbHwSwYQbpTsAEg&oe=6AFB4C00"}, {"file_name": "store_5.png", "id": "808510233851899", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001698_808510237185232_4332461869180106686_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxK6fwxGIt0Q7kNvwGu3SJB&_nc_oc=Adp6XDK0OmyyDknbgHXAhYWRrrgFutpiXxbnbGxqgCINK-Fp7j99hool6o-OrJrqu8Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd_4V1HpkFW8BehWCEASeFkbJlHi6ohdFUDYggiIphLw&oe=6AFB232C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440 (1).png", "id": "1149947469195227", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974751_1149947475861893_3742548628872915671_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcHQtOHp2XkQ7kNvwHypoTD&_nc_oc=AdphFFItiM4qXKZepTYgaQ_KlORCK_ozvk931SdIVAD_im00c4fIp5rcGAiGdDFOSf4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS65FUM7H5waJPrUmq8cOVCnjlMYcvRtViwrK4uVqbrQ&oe=6AFB23B6"}, "display_name": "ALTAIR BREAKER", "keywords": ["SAO", "melee", "blade", "saber", "fighting"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": 
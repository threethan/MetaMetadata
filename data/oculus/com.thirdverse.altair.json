RHQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeGYbGlUlehHUjp1sgk2YQ7RkUwNs5pNpBST6CvhbF_g&oe=6A7DADA9"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYGQgAPZ9VEQ7kNvwG7VoJy&_nc_oc=AdplmX8uMlCE1AkK8UeSVL5xojlvu-2iVQCeC9LVOQOy75cr_apEb052cxHVswQ-1UY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvHyf8geyXkshfdqgzioUpIjLfEcPt7RsHf90JKhxvig&oe=6A7DA032"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt-QXDTW7FkQ7kNvwE0UxGO&_nc_oc=Adp0kSf6PXyg7X9ZsBTGcINT7F8tiOCY6C0IvinFLqaCHMLq7do-Rzn0gTwFPNPnGe8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzGKby_ui5gvyi6Tdw0WMiCvC1SXDoIOXHCgm2g2jliQ&oe=6A7DB825"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQIDfNbcuBsQ7kNvwEXwErV&_nc_oc=AdqF8wm7EYi9BzIJdz3SzLF8iQFsB-iy3FtbhxRly_bvAdXne8DA0t_kHbSQfUn-_XI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEa7cYq486sXRx8bTIf8iM6UqCTZW_3-wcNfwBCnITkw&oe=6A7D9D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgUd-lxEgLUQ7kNvwGypf95&_nc_oc=AdpPSqT3pyPGyqD30ZSy34yM5MUg37hwl_z_TtTH3GVqSALTnKFB61NUCC8TC0EHr-0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPPmzXE85Dt7ih_Yqk3IsHCCU_yV3hJYbG3dyUU344cA&oe=6A7DC2A3"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPgPk9wJgv8sUgGa_EBqjHEeRrP9CQUW-mOSVWARQdMQ&oe=6AB15069"}, {"file_name": "store_2.png", "id": "462974492240045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_462974495573378_1034767390867189488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0hWoKdUwWMQ7kNvwHPlCkH&_nc_oc=AdpYDz-5GdJC3OnlCmvYFlR-I9NOP8jneai_x1msBnm_7WFSWFtX5OmUKfsxzF3-g2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYlV-lJlHU4WlWI7c1_FYbfdhT6LUs7wOwuetdpNUvmw&oe=6AB142F2"}, {"file_name": "store_3.png", "id": "422836609754517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974524_422836613087850_4080946146330262927_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPUWBvS9qe8Q7kNvwGRfBw3&_nc_oc=AdpEEW2aKM3sgJCHCsltz2yRGrbo5uEz1q5cmPOE7l4Rnrffj48vbYIWZ1hnIZAPMbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM-2oHlnooDTx8z9T2JLYoWVprsiVodR1Fobes0syxXQ&oe=6AB122A5"}, {"file_name": "store_4.png", "id": "5075395275903256", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_5075395279236589_4641673077474597517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdbIMMgsOQoQ7kNvwFv6h4b&_nc_oc=AdoIbDy46Obzh_H0YhlHfZANpqedty5xpOd_UvD-5hChxCkYwE1wRqdjKPwVEdz3oVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJ5QgJ9XIokxopnTwERkHq7dPOrClFL8fyffZi0AHLw&oe=6AB13FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus LandscapeW2560xH1440.png32.png", "id": "618447913408864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_618447916742197_5974117523784124568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf8AWhs7FfsQ7kNvwGcv5W_&_nc_oc=Adq6oTMVzw-MH3yryhmeN4qkvzS-YiZcgPyBx9QMsr2tAFphmdmEJwDV0CGmUJ-tyyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwEs1JoGIiy0l7vxYPnUasI30c1nU-pAE9tpwpYwJJ_Q&oe=6AB12D23"}, "display_name": "ALTAIR BREAKER", "keywords": ["melee", "blade", "saber", "fighting", "action"], "long_description": "THE WORLD OF ALTAIR\nSet on the floating island of Vastus Isle, once a magic workshop now in ruins and exploited to run AI experiments. Take on battles to push back the army of LAWS (Lethal Autonomous Weapons Systems) that are roaming around and help Stella, the humanoid AI left in charge of ALTAIR, to maintain peace.\n\nBATTLE SYSTEM\nMove from map to map while enjoying the feeling of transcendent sword fighting.\nTake advantage of your surroundings by climbing and gliding to easily take on enemies. \nExperience a wide range of attacks only possible in the VR world, like Shockwaves and Surge Mode.\n\nUSER-FRIENDLY UI\nA simplified and intuitive UI was developed to increase the sense of VR and not interrupt the game flow.\nThe Tablet will be your main hub to change equipment, check your status and more.\n\nCO-OP MULTIPLAYER\nTeam up with other 3 players from around the world and take on enemies together.\nThe game supports crossplay between Quest 2 and PCVR and features a native voice chat system.", "short_description": "Enter the world of ALTAIR and battle against the LAWS, an army of corrupted AI left behind roaming the floating Vastus Isle. Team up with friends and experience the feeling of transcendent VR sword fighting in this map-based multiplayer adventure. Climb, glide, and slice your way through beautifully-crafted levels and collect resources to upgrade your character while playing with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://altair-breaker.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815
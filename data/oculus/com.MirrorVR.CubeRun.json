06ob&_nc_oc=AdoW7fBf7DuOfQEQks1GZMs-N2QCGPSkeApLBWiBrFaHAnYqysAcBvQmdKuYF1mHxao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAhJX7loBWf3eqf0tnQlmz6I_Adc_Cttale5V14wP7FA&oe=69CA8529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_ImageGallery.png", "id": "265477053820497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427554_265477057153830_1021843083_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_iCXnMtHSgQ7kNvwFjzwua&_nc_oc=Adq5mv_m2TVFA9D902Igs-y55emX3QlI2ILqSvpae_s8LQhfo6jQ75BzFX9VzIxufQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0alAonUpZiH12JZ4hyX73oigXziVVw0HeYZrCvLo4jA&oe=69CA7849"}, "display_name": "CubeRun.VR", "keywords": ["Cube", "cuberun", "run", "mirrorkey", "VR"], "long_description": "CubeRun is a running game which is build in a world of cube. You will need shake your head left or right to avoid any obstacles in your way. Especially don't tilt your body or head because it doesn't work.\n\nYou also need collect the coins and run as far as you can. Because your speed will be faster and faster, also the map will be more difficult.\n\nYou will get into 4 different maps such as spring, summer, autumn and winter. And each season has day and night. During the night the part of your sight will be dark, so you should better be careful. \n\nThis game can be much harder than you can imagine,we will update the ranking list by the next time.\n\nHurry up and keep running!", "short_description": "Start your journey in a world of cube. Slightly shake your head left or right to avoid obstacles. Collect the coins and run as far as you can. Your speed will be faster and faster. This can be much harder than you imagine. Good luck and enjoy it!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://mirrorkeyvr.com/", "developer_terms_of_service_url": "http://mirrorkeyvr.com/", "publisher_name": "MirrorKeyVR", "support_website_url": null, "website_url": "http://mirrork
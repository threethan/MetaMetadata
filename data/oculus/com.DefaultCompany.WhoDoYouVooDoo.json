.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsPCSNk2smcQ7kNvwFsF5nK&_nc_oc=AdpUyK0OM52VvIbBJxHl1tYZQpceO_8YLmeptf15-JRmIblYheAqwxzyETb7EWxAjas&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEFCoqPSsrtvSxJ6azyhYS4xpyL_g-15i6FoNX0CnzSg&oe=6AA95D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPx4_6190oUQ7kNvwFggFgg&_nc_oc=AdrIXaAANGq6ss1s7m1sDUnQz-vYuIVuI0Fqu5ERgRWZ-KFNtGN-EJ4_ttd-NJs_OqA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFBH0JzduQPwKCKMzPY9ARAESZI2sudrWqffkJ8BbN7w&oe=6AA96A82"}, "display_name": "Who Do You Voo Doo", "keywords": [], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ra
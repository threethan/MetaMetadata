.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2sh5IiodswQ7kNvwE69MSf&_nc_oc=AdnhEpzu6k1KnmKSusz7frywuPLKpyfv3-aTqbMjmQYNkl_Ol1rocZcnd6ZRIdQLxv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft6pxhahL781Q3CnwM-grrgVKzYNOjuAdpPGu6YH0Peow&oe=699AE6F5"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVBDd_XHyVYQ7kNvwHDD8j0&_nc_oc=Adm5vOWyCkQ8Yvia7qJf4JT316X0ZCwpm_A8PY-s-5s03ycY7RwI-WFQomWb4qJbaxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuZlJO8oPlmP7K9R7pOp9rDzXdG6tSPR-sowxte3e8iqA&oe=699AE18E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv2cNfjBhhIQ7kNvwGKdcgt&_nc_oc=Adn8jkvX02QssJUlm3BfBZn2avW_79QyQkPo2XtnqhDYmWEOkuLD-ST_-fy4u3y46qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuU7DBdiRqwtR9O-JJuD9l2q5NB5SR3jc4Yoky718JDNw&oe=699AEEC2"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwf_vuhyL0UQ7kNvwE4nUW0&_nc_oc=Adl-4OnWVE75H6WBS9f4-sPsvI-uWK6lH03IQRMHFA0fOEgbrsEA1AItsuj9H8t4QZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsXUN1IBtcWQqHHr5jNCbte7_ZzQ6KVYIGvKaJVTSRgCw&oe=699B06CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Who Do You Voo Doo - Archery Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
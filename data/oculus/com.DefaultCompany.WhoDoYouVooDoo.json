.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2sh5IiodswQ7kNvwF-5o6M&_nc_oc=AdnMaP6vSJfh0G1ENgWjJkL9hxNfyFbXDQcv5wMDbaTN-cAQ34OgfUs48AUHLN34efo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftZP16cHDr-SGGR7JcbLHhQAOgQk__d4H5nBC35qpeN0g&oe=699C3875"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4vXi4vOp84Q7kNvwEFqNtU&_nc_oc=Adl4oawXu1_Sd5GQX333J2MtXu7LWP3Db8BWnuiIuWpY-_D4PBaU1PYuHRI7TtlVdKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv7S5anlHuOp_EorLiFdSZEL5cLHkm-SlwgRG0SXq2EFw&oe=699C330E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv2cNfjBhhIQ7kNvwG_WApK&_nc_oc=AdmeltAegpWY3ARcf4FJ0ENw_40a0A1KDo2wZfmLzKF65ekwhBvcYa2l4fnCjOJMXns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftcpsQhssCbV48_nq_y6JyPVNfiR1o00pHEjgSoQjZKnA&oe=699C4042"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwf_vuhyL0UQ7kNvwFLMd6X&_nc_oc=Adl8R3nhek0QdhW7_TU46mZ3cJnJ1zZ49Yjg0cE8zJVT-LWreD8wOFn0H_mxKVK-hb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsv0txiyXGOlSDDAetLmq4CNdKOBQEOKrPvu07WLRIbXg&oe=699C584A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Who Do You Voo Doo - Archery Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
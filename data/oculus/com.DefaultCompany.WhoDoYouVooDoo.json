id": "932256014030730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035453_932256017364063_4233604746690858061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiDVkhXr1GAQ7kNvwHMAi_t&_nc_oc=AdqMCIN9a1pFFpL88Ag3_TFToSsH_gj_PkXC1QJWlCvQM74fkKQMoXLgcDl-RIX-ac8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFisy-fCiPMR8xQhMyrlZDxrEAN2h8miiZuWDuZpBOoOg&oe=6A7EFA75"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auSH6Hu6xSQQ7kNvwHQdZ1n&_nc_oc=AdrvZs3sPmTaQdDFcRlJFtEnjC3uNYqKG3zfVgRR8P9bLSWxe4mBv6iW1WItxb2uNyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXvFrx_-2Tg6uWaJXJ9btRMge3-g3jP9PPhQ73TKdlhA&oe=6A7EF50E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5iaBQGEcC0Q7kNvwG3PGj4&_nc_oc=AdrnhXr4gXUVTXFVeQ32rzjbJ10KZpBdIxMJu2g40Jqkko6Y7QKVuo-TcWQEJ2t1No4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLHexDVcQvVERF8Y2HJVpW_5G4vNZ5LaYnYCl3-5TD9g&oe=6A7F0242"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rud3cJ3rUs8Q7kNvwEO1IDj&_nc_oc=AdqIgB_5mbHzzsp8E-drjorhAnPhC0T4XaPrr86Ah9O7eX1Q7f7dKYdaB2hiv8_D9FQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFXX0IuMllACDQl4T9OAp2L3xYYxN4WkbVDcO9jJBeHA&oe=6A7F1A4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
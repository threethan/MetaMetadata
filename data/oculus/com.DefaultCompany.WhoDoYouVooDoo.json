scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035453_932256017364063_4233604746690858061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N28OyFB45SYQ7kNvwGAQZHT&_nc_oc=Adme9h0ZbN8G7rGpXdS_Ecsc5W_sed0Wfpuv0rlxJTNUslGZShj5ZlVdZpVh_4aXLt0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY-r_Sqkfwaqd2ql_9flMsyfkXILs68Mouj8_fhnIXBQ&oe=69BD2DF5"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti-G3-1ha0YQ7kNvwFWHE9n&_nc_oc=AdkrWldPqWIJgLItEZLjE-RvCDZ8Ea6jIw9yuV92iXP4Io8l3Mc5kj94yXFvEgIc5KM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgrJx-2UWlQ3CTrE66a0IBFwgDbcuiRoH1PrDRPA0UvA&oe=69BD60CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzWkBbLztSUQ7kNvwGvRJ9E&_nc_oc=AdkUjrpySq1dyeyPkOj9IUc14BCXlf9gdSgYzLSZHNP6TDWS1YIT60shr2ov7e-qcXY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzbJwAQQ1QAj_iMjvyy8sUGEsYUr3PEb9qVYnUFOUEPw&oe=69BD35C2"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHKGAVT9bJQQ7kNvwEhUyPc&_nc_oc=Adkqr24pvV99RhRkW_S4qV89fqCTEVGWzY2G6BenP38vfzYgEkd0AhDDOmtTc6Vcvy0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwPUIAasbOboJbufNu9MVadR_atAHQsfqY-hJ0gYT4nQ&oe=69BD4DCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Who Do You Voo Doo - Archery Game", "platform":
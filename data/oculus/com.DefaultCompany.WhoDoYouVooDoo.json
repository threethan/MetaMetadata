.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXffjUHsbDcQ7kNvwGJ_SJY&_nc_oc=AdmgmX7mf2NQhSEJdZH2_FMBUOLoTTlLj0oO9qBzAV6PVHE51CkMBxqT8QAKuDfNbqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afspk5qyo04qgkbiBVPs67nvRsK1D4Gil4CTqehpXayByQ&oe=699D89F5"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4vXi4vOp84Q7kNvwHjTPIM&_nc_oc=AdlYxIpQI4Lta-yO7VcOSQlLmJRW0zVOnkJAg6ISAwQRf4rhCr95lzwPDyPEq5K5tFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqVIEsf6Q7N27Yjas66feFZLTEC39MFtzaJTiO3ZtWvg&oe=699D848E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HAw2aSbzZ8Q7kNvwHRi79Z&_nc_oc=AdngLK6w4upRrTbAiUU_xYLOgoQ-0om-GLNqnUOS5RTuwawZBIxIw5LFs1HJbJLl1Dk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVije-5LgCw0W2Yoka6BUhjRComSJWLfePVHgjYROpXA&oe=699D91C2"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP0esw2p520Q7kNvwHLxJvb&_nc_oc=AdmZJdszQ7nM-sZXSx0gNtWWnwkkTcAuUPkoDCkQ8kuRw50clY_KMJPKVX4Pj5mCHiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYdW380ZrUrsgal15CRaYHAGwVm2U8CY_iqqGbu8f-1w&oe=699DA9CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Who Do You Voo Doo - Archery Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS9eL0igAcEQ7kNvwE4Jaeb&_nc_oc=AdmyomSooMiIMYEacoSmXYoN_3TiBmJshsvTyLJPJvUbgSooeoInuSqFSEU_QpC5zjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftgIBlO8SAKaGcrBHEDsisishnRR-nmcOm4aDUwIKcTlg&oe=69A572F5"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYUPljPn9yMQ7kNvwE2xSzX&_nc_oc=AdlKxs_G0Qyr991xAcsfbLZRd2o3by6L1kgbNphZwFoJMkTVmYSHjtbLvJhNiK6c8UQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4qaHvRS0KraMdAHnzaYCgTofKOkQQpWK1-LU6_fFG8Q&oe=69A56D8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4Z_GlsNGSwQ7kNvwFP4yD2&_nc_oc=Adm78JumOJeSA03Ul3h2vu2n2IP9A-clBwngJwnwvSqhvvUCr8ShEAt8f0XAlHMdbiY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftGKEbSzukL9iTk0EdWnMfWOevuYVzLtzkJk9M7LOrPhQ&oe=69A57AC2"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qezcHRVerAQ7kNvwEbjdrq&_nc_oc=AdkgoPyM4fAV0TaCMk0tuEAfKMKzvJb_mID7SJlhpGLxPzTQkpTcBu6mskQLWAYv-mI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afta_quXtga6-gHeAZfTbJht6OvIm4UhyZprAINFB1jTBw&oe=69A592CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Who Do You Voo Doo - Archery Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
id": "932256014030730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035453_932256017364063_4233604746690858061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4hDPZ0ZiHkQ7kNvwHIglsm&_nc_oc=AdqUQT4VdCx2H7-AmVtk7PoHq5viFOVTcsJvSxPGI2-a6zoWJ66m9T0I9VmXLH0ylGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DcU2pvvXbPmZDTk2JnjGCjkKHx20EqVlKmLVwDCyi1A&oe=6A3018B5"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDcdEi_41HwQ7kNvwFzRQa3&_nc_oc=AdrG9_wre3jLo6KfAZ9zp7uRVZ0aW8WpFmEjBEZ-fEYp7FrleW2aNJHXvafsBjxXA7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KR_TlHX9Hj6YRT8-hqGgCsTrw5YOFBzNKF2nj8dqEpQ&oe=6A30134E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOnX4qtXaAoQ7kNvwFcB8Hq&_nc_oc=AdoaMCesNMLAxMm7RIvy3lOCFElvJw_rqaaCB6UaekXHLl2uLBXEhMCzT7Zu_Qi2bGw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vRaQiIzEQnkE3ggCN2xiQ22e5oNQ9fW3dlpgrRuaKDw&oe=6A302082"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GtieF90twsQ7kNvwFWzUXF&_nc_oc=AdpYtSifB9z6fZrZxp3JaqDlRQi8tKDzxZcqBaSlYhVhupD7P_wWISU91k-KxVQWM30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xr9zjfs3ercPu0JveWM7gfvu01KSmSXSgu1UuUPDHTA&oe=6A30004A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
1-7&_nc_sid=6e7a0a&_nc_ohc=KDcdEi_41HwQ7kNvwEU74_1&_nc_oc=AdrDmX2EQZ3vgdwWKniYzEt7uk-o3FOyCYiice1xs0sawrMRAZngIMKPhYlQ6VJqBKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cly1meRPwv6riKt8tSDQNp-jimbkJAPHiEQyr21YHIQ&oe=6A3164CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOnX4qtXaAoQ7kNvwFryQ8x&_nc_oc=Adoc1VdvNPH7lnPz7RIblqNGBxOQlM6xqObgcXvW7QVaqoMglJDPLRIOnoZEiYZ8bNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IdB-DPiLElEXrdglBBkwu4R0yCIX1ypsj9E2YKRNA1Q&oe=6A317202"}, "display_name": "Who Do You Voo Doo", "keywords": [], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url
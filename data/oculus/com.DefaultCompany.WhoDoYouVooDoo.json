id": "932256014030730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035453_932256017364063_4233604746690858061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LmMWTVevSIQ7kNvwF30fA8&_nc_oc=Ado_s-bWTI3es7XPC0SEs73fbh2LEW6oFAkhRGaifrVLXsiP7djIzmYG_3EYncQZYx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B0kuuB4TXN_N1zP4CXEONaVettaUXZ5hAS5symP-YfQ&oe=6A146935"}, {"file_name": "4.png", "id": "1169575973534479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984468_1169575976867812_6750159418789933673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYz69LefZaIQ7kNvwE4Gj02&_nc_oc=AdonenDZGKEcUFsXVuEIxMARwm1vL5ytRpvUPixsJW1tFaxFSTkECqyYLpTTZFDN8Wo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dl5VjrIn4r9VgDN72Uu_X2C4sXUC5zOXKbVjhQklZqw&oe=6A1463CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1501689726873501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1501689730206834_7616564423229378808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5OuQyey0m4Q7kNvwGtRBxc&_nc_oc=AdrTNyIsu7LULnECCNLUTAPxYQNmEE0iI4MHAYlCl2n9_edv3nPJH9pSYPc9JaJrL9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pDwUduYixu-jg56mPtTBqD75s1LYn1tRgw_w0zKSuuw&oe=6A147102"}, "display_name": "Who Do You Voo Doo - Archery Game", "keywords": ["archery", "voodoo", "zen", "horror", "arrow"], "long_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!\n\nWho Do You Voo Doo is a fun and therapeutic game that lets you release the pressures of your day by shooting arrows into the Voo Doo doll of your choice.\n\nThe premise is simple, but the challenge is high.\n\nCan you land each arrow precisely enough in your doll as to not touch another arrow?  Join the challenge and the fun...\n\nAdd Who Do You Voo Doo to your collection today.", "short_description": "Ever wish you had a Voo Doo doll of your enemies?  Well, now you can!  Who Do You Voo Doo makes you the Voo Doo Master.  Name your doll, take aim & fire your Voo Doo arrows at the doll.  But be careful, if you hit another arrow, your enemy will live to terrorize again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/who-do-you-voo-doo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6349789538478693"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_1224598185222306_5957739153293738442_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpztJRCIrBoQ7kNvwEAY9vI&_nc_oc=AdrFGxRMwGw6WdCMhgKDKkmpNmPpLGNEl6hmgpFeh-FsUrL3luN83t5Mt-EDCwFueZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SL3_gdGnI3438ZTH8GWqKjkABj58ReJ2gLnYitecZ1Q&oe=6A1450CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
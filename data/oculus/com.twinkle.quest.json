=7f20f&oh=00_Af9JW2pPnXNBR-1mMMB8TVfRQZAtSmkLa7eVsZSJl8UqRw&oe=6A412155"}, {"file_name": "VR180-HOA-2560x1440.png", "id": "1083182463228571", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295272_1083182466561904_7722284336074449379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLwFTK_OPwwQ7kNvwGyx1lj&_nc_oc=AdorYLnqPxY-ddVZtYBrzyZosaRtsDh5fkGuA_pbwtVTe3plLNWkzYUkkbgKAtF2DOY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8joOdLx1QeAVmeAHEAK_Ca-AV3r2QkFCUp6qjIqHBRDg&oe=6A4114F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Twinkle Video Player", "keywords": ["NDI", "Ambisonics", "Spatial"], "long_description": "# The Pro Video Player for Universal Connectivity\n\nThis isn't just another streaming app \u2014 it's a portal that makes your PC feel truly native to VR. \n   * \u26a1 1-Frame Latency.\n   * \ud83c\udfaf Zero Mouse Lag.\n\nDo you like this screen-to-screen latency? \ud83d\ude09\n\n{1031169699219721}\n\n**\ud83d\ude80 The Most Powerful NDI Player**\n\nTwinkle's full-featured NDI capabilities unlock new possibilities for streaming on Meta Quest platform.\n{4327704144173412}\n\n**\ud83c\udfa7 Spatial Audio: Local files & NDI Streams**\n   * Ambisonics: FOA, SOA, HOA, Audio360.\n   * Automatic Stereo Spatialization.\n{756681966764437}\n\n\n **\u2728 First VR Player supports 3D LUTs**\n   * Load .cube files for instant film-grade stylization.\n   * Rapidly transform your videos with professional color looks.\n\n \n**\ud83c\udf1fFirst VR Player supports STMap**\n* Real-time fisheye unwrapping, no high-end PC required.\n* Direct camera footage processing for true WYSIWYG.\n\n# Support & Community Hub\n\nFind all resources and connect with us at:\n\nhttps://www.twinkle-vr.com\n\n- PC Streaming Setup Guides.\n- Troubleshooting & FAQs.\n- Submit Feature Requests.\n- Join Our Community.\n\n\n\n", "short_description": "The Professional Video Player for Universal Connectivity\nExperience the freedom of NDI, SRT, MTP, and more \u2013 all in one revolutionary VR player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.twinkle-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starkle Vision", "support_website_url": null, "website_url": "https://www.twinkle-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24205076325793716"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1653612445894429"}, {"status": "PUBLISHED", "id": "3752471281718335"}]}, "baseline_offer": {"id": "1653612445894429"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778768040, "status": "PUBLISHED", "id": "1653612445894429"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27262527750048543", "version": "1.7.3"}, "id": "1884073112134608", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24080849371549746", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27262527750048543"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"
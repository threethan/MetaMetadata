uscdn.com/v/t64.5771-25/75441584_305925128442050_5202064543711816239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoWvFFhiaNMQ7kNvwEYrLlL&_nc_oc=AdoNwTPnK-suFbXXNsOxS1XX4OMNLisgo0peA1pwkI3NEsMsr5lJZyhrkRi_4GrkEk0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y5g0qG3TAlu2ofAugc2g3T9l-sraPOk0LryGDGR2YCQ&oe=6A0F0F51"}, {"file_name": "Shot5.png", "id": "886957229416492", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196223_886957232749825_984619726465184372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXoko7nLynEQ7kNvwF0t3yZ&_nc_oc=AdpuN_cOrEVZIXfqtrVMzBJgELSQYHFuV_KrlkuZ5F3Kx3eVDngZJANHq9EpFDff5rQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78TDT5B3l7u2bxe58HK0ntOc3l6cZ7KoVsadXYJUPi1A&oe=6A0F12BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u9884\u544a\u7247\u5c01\u9762.png", "id": "212319575253886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974505_212319578587219_6595120904055980883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHdcMzZLA3EQ7kNvwEdg47G&_nc_oc=Adrf4ds3IwSw8rFh3fqx1zsMSwVLHM_8Z3jl6ho7j_SEg1tNGblDnjGi8jIUC6esa8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rR5i3mshdtdyyWomX_LrYJjPzCPVLKuVjoPdRZhs8Ug&oe=6A0EF4BC"}, "display_name": "Grimlord", "keywords": [], "long_description": "PLEASE READ BEFORE PLAYING\n***This is an Early Access version for Quest***\nWe are grateful for all your enthusiasm and tremendous support! Your support isn't just a purchase; it's a key to unlocking the future of the Grimlord universe. We are working tirelessly to polish the entire EA version of Grimlord onto Quest so that Quest users can enjoy the same experience and content as always with minimal sacrifices. There will be glitches and bugs, but we promise to proactively fix them, bringing you the optimized experience to the best of our ability. Meanwhile, we appreciate every bit of feedback and suggestion, and they truly help us make Grimlord better and motivate the team.\n\nABOUT\nFrom the lowest of beginnings, fight your way out. Your fighting style is unrestricted, your crafting options are limitless, and your enemies are versatile and fierce. Your future and the future of this land lie in your hands.\nThis is a story-driven, classic action RPG that is native to VR interactions. This is what\u2019s been missing for long. This is Grimlord.\nKEY FEATURES\n* Creative Combat Styles - Hold your weapon wherever you want. However, you want, and use real-life fight styles to defeat your foe.\n* Immerse into a good-ole Souls-style map loop, where every short-cut and fire point gives a sense of safety \n* Weaponry Customization - Dozens of weapon parts to unlock and hundreds of combinations\n* Variety of Enemies & Epic Boss Fight ", "short_description": "Grimlord is a dark fantasy action RPG built for VR. Use every type of weaponry and armament with full customization and limitless move sets to annihilate anyone who dares to stand between you and your destiny."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beautiful-site-kylinhall.webflow.io/privicy-policy-grimlord", "developer_terms_of_service_url": null, "publisher_name": "Kylinhall", "support_website_url": null, "website_url": "https://linktr.ee/grimlord", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interacti
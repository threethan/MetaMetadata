uscdn.com/v/t64.5771-25/75441584_305925128442050_5202064543711816239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KDlcAPRI9sQ7kNvwFIPxrE&_nc_oc=AdpM0HlDbS2Sv15XlJWqd0GpMwmvGQNCmvmnMr8YXw18iOHnoli_W1JK0eOMc2rdEuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SYaBI7ihXjMe-SM2rmFRofo8fRlckgIfy9DfLoWvcgQ&oe=69DE47D1"}, {"file_name": "Shot5.png", "id": "886957229416492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196223_886957232749825_984619726465184372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDKgHe_-lBMQ7kNvwFisORp&_nc_oc=AdqPHl1CkZGRX4lw3ETPkxHVEkJtHBSn7-TCzZAMVUJy3nEk7lms60tdtZ5ddk0H1yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aoN-aNZKYAhHODa9D35joE7PHQlBzZ29bUiSWZNuYUQ&oe=69DE4B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u9884\u544a\u7247\u5c01\u9762.png", "id": "212319575253886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974505_212319578587219_6595120904055980883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTQ94qfg-sgQ7kNvwEsRTa3&_nc_oc=Ado6i-7Og2ynXVfvFqsjpABjzeEy_agQGAYDRDv1tEuH8c8Cwi0sk-TkWeBj8OCrtgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c8i-Ql7i5BhWDVv8XYMVanjQUJzjp4WOl0vy7YYsqiw&oe=69DE2D3C"}, "display_name": "Grimlord", "keywords": [], "long_description": "PLEASE READ BEFORE PLAYING\n***This is an Early Access version for Quest***\nWe are grateful for all your enthusiasm and tremendous support! Your support isn't just a purchase; it's a key to unlocking the future of the Grimlord universe. We are working tirelessly to polish the entire EA version of Grimlord onto Quest so that Quest users can enjoy the same experience and content as always with minimal sacrifices. There will be glitches and bugs, but we promise to proactively fix them, bringing you the optimized experience to the best of our ability. Meanwhile, we appreciate every bit of feedback and suggestion, and they truly help us make Grimlord better and motivate the team.\n\nABOUT\nFrom the lowest of beginnings, fight your way out. Your fighting style is unrestricted, your crafting options are limitless, and your enemies are versatile and fierce. Your future and the future of this land lie in your hands.\nThis is a story-driven, classic action RPG that is native to VR interactions. This is what\u2019s been missing for long. This is Grimlord.\nKEY FEATURES\n* Creative Combat Styles - Hold your weapon wherever you want. However, you want, and use real-life fight styles to defeat your foe.\n* Immerse into a good-ole Souls-style map loop, where every short-cut and fire point gives a sense of safety \n* Weaponry Customization - Dozens of weapon parts to unlock and hundreds of combinations\n* Variety of Enemies & Epic Boss Fight ", "short_description": "Grimlord is a dark fantasy action RPG built for VR. Use every type of weaponry and armament with full customization and limitless move sets to annihilate anyone who dares to stand between you and your destiny."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beautiful-site-kylinhall.webflow.io/privicy-policy-grimlord", "developer_terms_of_service_url": null, "publisher_name": "Kylinhall", "support_website_url": null, "website_url": "https://linktr.ee/grimlord", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interacti
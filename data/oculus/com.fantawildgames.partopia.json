eenshots_joy_thrower_01.png", "id": "330956172654080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_330956175987413_6222418874249398673_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEN5zmaF56oQ7kNvwEcCRL3&_nc_oc=Adl0wt84sQfqDvrck_yDMYbH_0VDVwC7VP-NsCpKAsJxYyCv_Vm3juJ5l3KGWmFXixc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftSGZZqUk_YHHu4assI1KmUj89nVAgwb7_hzIU4XwAMmw&oe=69A435D3"}, {"file_name": "Screenshots_joy_thrower_02.png", "id": "529451399364801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974534_529451402698134_6819045446559275791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaPkuo9be8gQ7kNvwEr5XnH&_nc_oc=AdlXoDh9OZAD4ESq11GDsN8pBxcrHqYKvxfgZCFuWRzddxxqlYqv8wyNe1Bqmg0XVww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvtHJhXPvWdNZcLQp4hQYaGS61161jO9074rqD2Aqs3Vw&oe=69A41E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u97622560x1440_3.3.png", "id": "1266808540688515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210393_1266808544021848_5881271589942806823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leUxe6VkWTEQ7kNvwF1q4m5&_nc_oc=Adn4JBVMV_m4U9xoB7E8teplqL0uJCJob5mgnlcV__6KxoW8oJ79YvK3Agbqi0-E6tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuP22PB3o5TrkJAON14vHbEMQ_okU5cNIk3YxNcSyvWVw&oe=69A443CE"}, "display_name": "Partopia", "keywords": [], "long_description": "This is the Alpha test of our studio's first multi-player PVP game partopia. \nThis alpha test includes 3 basic game mode:\nCreazythrow: 10 people fighting against everyone and try to gain more points by eliminating other players.\nJelly Wars: 4v4 team fight by using your jelly gun hit your opponent. Save your teammate from huge jelly before out of breath by using your jelly spoon.\nBio Cube: Up to 16 player infection game. Random players becomes zombie to infect all human to win while human resist or kill zombie by using weapons.", "short_description": "Multiplayer party game Partopia, your party utopia! Now available on Meta Quest App Lab!\nJoin in game for free at our alpha test, try 3 game different mode!\nCreazy Throw: You throw burger bomb, they throw apples.\nJelly Wars: Turn your enemy to JELLY!!!!\nBio Cube: Be the zombie, infect all human! Or kill the zombie with your gun! In low-poly world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Games Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "6829124227138148"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7104114466305788", "version": "1.2.0.27"}, "id": "235033546202403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6812063548844216", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7104114466305788"}, "release_status": "RELEASE
6", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619432_1120433429585479_1371492074222808765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7ErVVhzI0YQ7kNvwF2euxd&_nc_oc=AdrjhCEtlgb_6s2cNGJMwx8klI8uIBQ8f0LstTX_zcvXR4ZyeKS_GTI6rvpIRQ01VNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ir_0df459tiEhctRL3w0FaGAkF9U3F3d6vkwbx9Zf_g&oe=6A381476"}, {"file_name": "com.oculus.vrshell-20250917-162203.png", "id": "3401939519945210", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297224_3401939523278543_7036109462844074672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-saQvneY2kQ7kNvwFEw0ib&_nc_oc=AdqThreC9nzE2_B1jdOz70-ZItc7NYK-z6Iq9yIAfbgrupdYnXkWOUbIIc8s0ZKHT0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UbgcBiBIIh55Uv0v1_WGgffDuCvrHKm7_SemNMVNV0g&oe=6A37F241"}, {"file_name": "com.oculus.vrshell-20250917-162229.png", "id": "2071105243420621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2071105250087287_8661864920009257474_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUNzFFL0qKAQ7kNvwEYkquV&_nc_oc=Adol9V4SsBqhDo7niwVQHZ6wZgrE57jQUFK4JKrCn11rYt0g22iWp7FRFVACZ-7o1wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81pvHb0b4Cta487xVQoYYQzxNcSldTgiaZhkbUnlg9ug&oe=6A38005D"}, {"file_name": "com.oculus.vrshell-20250917-162331.png", "id": "1026889842754373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296342_1026889846087706_7202140471246845263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B892dwMW9kUQ7kNvwGY6qtK&_nc_oc=Adp2Tyv5HYt02gRv8FApc1tBlV6lUBFx7W3pb50dQr2YOLybvCVTEaxtVVnKOpLDZM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MqTZUXJAku0ARU4KBkiQ8smsJJ_7_tEYy44W6QxeOiQ&oe=6A37F395"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Anatomy", "keywords": [], "long_description": "Real Anatomy transforms the way you learn and explore the human body. Step inside an immersive 3D environment where every organ, muscle, and system comes to life in full detail. Designed for students, educators, and medical enthusiasts, this app makes complex anatomy simple, engaging, and interactive.\n\nExplore the body layer by layer \u2014 from skeletal structure to organs, muscles, and the nervous system. Rotate, zoom, and interact with realistic models to gain a deeper understanding of how the human body works.\n\nKey Features:\n\ud83c\udf10 Full 3D models of major human body systems\n\ud83e\udde0 Layer-by-layer exploration of bones, muscles, and organs\n\ud83c\udf93 Designed for students, teachers, and medical training\n\ud83d\udd90 Interactive tools for rotating, zooming, and highlighting parts\n\ud83d\udcda A powerful aid for self-study, classrooms, or professional learning\n\nWhether you\u2019re preparing for exams, teaching in a classroom, or just curious about the wonders of the human body, Real Anatomy provides a hands-on, immersive experience that goes beyond textbooks. Enter the future of learning \u2014 in VR.", "short_description": "Discover the human body in stunning 3D. Explore anatomy layer by layer with immersive VR models and interactive learning tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://machenn.com/privacy/", "developer_terms_of_service_url": "https://machenn.com/conditions/", "publisher_name": "All Real", "support_website_url": "https://machenn.com/", "website_url": "https://machenn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
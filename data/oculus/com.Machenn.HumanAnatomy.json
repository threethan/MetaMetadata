6", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619432_1120433429585479_1371492074222808765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVsvHovGVP8Q7kNvwG_F2Vi&_nc_oc=AdpCVT5yGm1H9tta6xUOOIYZNWPpr32b2Fy7K0csZwdMrzTIgxftd5nEc5VUeLt-9lI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbt3rudTSBJn0ZCDjC94uCVVWaYiS66TT9VVK24PmjsQ&oe=6AB51AB6"}, {"file_name": "com.oculus.vrshell-20250917-162203.png", "id": "3401939519945210", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297224_3401939523278543_7036109462844074672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0d71cR1NdMQ7kNvwE0-OmN&_nc_oc=Adrl9l2r2-t7dgkBeI9EYjJAjhxppYw13pxm_EHagqpKByQvP5_NuEc8If2adtHPt44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdS3plM33hcjVtH9BACPV-T5SLTfzx8shkeJmcoa9VwA&oe=6AB530C1"}, {"file_name": "com.oculus.vrshell-20250917-162229.png", "id": "2071105243420621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2071105250087287_8661864920009257474_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcGHGaBrcSQQ7kNvwF-z4s_&_nc_oc=Adqsre9thNi8cDCZhUpbQwDktwBrBNWWucDDeo3fc-4II9E2tJO4ShMKEFBBcv2m8_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwakYBx9twQ9rNNtipphANnKNohD2j3ABtZot5chbxeQ&oe=6AB53EDD"}, {"file_name": "com.oculus.vrshell-20250917-162331.png", "id": "1026889842754373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296342_1026889846087706_7202140471246845263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK27PWVBTkgQ7kNvwExoEC5&_nc_oc=Adq_9_jU1wUqCUItBRry2Oz2qW4zIg7D62v3CptkQXw7u0FpLidSPMmisEUIi0HnzvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQT7BsV-eWIXBQcd4sB0kMRhHvi7P7OM69772N96c9BQ&oe=6AB53215"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Anatomy", "keywords": [], "long_description": "Real Anatomy transforms the way you learn and explore the human body. Step inside an immersive 3D environment where every organ, muscle, and system comes to life in full detail. Designed for students, educators, and medical enthusiasts, this app makes complex anatomy simple, engaging, and interactive.\n\nExplore the body layer by layer \u2014 from skeletal structure to organs, muscles, and the nervous system. Rotate, zoom, and interact with realistic models to gain a deeper understanding of how the human body works.\n\nKey Features:\n\ud83c\udf10 Full 3D models of major human body systems\n\ud83e\udde0 Layer-by-layer exploration of bones, muscles, and organs\n\ud83c\udf93 Designed for students, teachers, and medical training\n\ud83d\udd90 Interactive tools for rotating, zooming, and highlighting parts\n\ud83d\udcda A powerful aid for self-study, classrooms, or professional learning\n\nWhether you\u2019re preparing for exams, teaching in a classroom, or just curious about the wonders of the human body, Real Anatomy provides a hands-on, immersive experience that goes beyond textbooks. Enter the future of learning \u2014 in VR.", "short_description": "Discover the human body in stunning 3D. Explore anatomy layer by layer with immersive VR models and interactive learning tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://machenn.com/privacy/", "developer_terms_of_service_url": "https://machenn.com/conditions/", "publisher_name": "All Real", "support_website_url": "https://machenn.com/", "website_url": "https://machenn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
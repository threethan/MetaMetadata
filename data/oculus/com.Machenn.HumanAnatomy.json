6", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619432_1120433429585479_1371492074222808765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90lCgaw0bj8Q7kNvwHlnAKc&_nc_oc=Adr_DPDuTPvBWLEUwxYQqPoA8gVSWUopZnar5iX8tx_ZYF7FmOKkGcKpR_DFFlS_CRk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECojxxzbXM4yPGM5nqZAAQdp460ETWd2axXVv4sKOUyg&oe=6A86F636"}, {"file_name": "com.oculus.vrshell-20250917-162203.png", "id": "3401939519945210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499297224_3401939523278543_7036109462844074672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5PpnuB2HU8Q7kNvwEJwYOE&_nc_oc=AdqXy3bI_4NgzsHgjI4Z-puAZP1JYJAxUr01_fwKAHaLHKdGfUmgFbSAN9VnGk0QFHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw2IC7L5fgDicI1IAU8I-gCCTwvJlht_BmcftBvSPapg&oe=6A86D401"}, {"file_name": "com.oculus.vrshell-20250917-162229.png", "id": "2071105243420621", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_2071105250087287_8661864920009257474_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0KhCJjdEk4Q7kNvwGzz39e&_nc_oc=AdoNsiQ3-R8zZ7-J3hPl33r7vDLFrpj7Zs3Lv7Sq8q8lKfT4v1oXbnsci6MME5nIGVY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqkKHmj3BCtY0OZYyqKovkzwFcU519rGhmFZBeQIR0vw&oe=6A86E21D"}, {"file_name": "com.oculus.vrshell-20250917-162331.png", "id": "1026889842754373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296342_1026889846087706_7202140471246845263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vklGDnCnOVcQ7kNvwHYT_er&_nc_oc=AdoBXtBZbWPJCPWfq4yj3GERYayokpnnoxlUcUmTLs5CuILr9vj0jiuZ8uH4z9aTHVU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPyuMLIChVpIEjwa24rXmgPELwHUr_D_8DUNLdN5X3qw&oe=6A86D555"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Anatomy", "keywords": [], "long_description": "Real Anatomy transforms the way you learn and explore the human body. Step inside an immersive 3D environment where every organ, muscle, and system comes to life in full detail. Designed for students, educators, and medical enthusiasts, this app makes complex anatomy simple, engaging, and interactive.\n\nExplore the body layer by layer \u2014 from skeletal structure to organs, muscles, and the nervous system. Rotate, zoom, and interact with realistic models to gain a deeper understanding of how the human body works.\n\nKey Features:\n\ud83c\udf10 Full 3D models of major human body systems\n\ud83e\udde0 Layer-by-layer exploration of bones, muscles, and organs\n\ud83c\udf93 Designed for students, teachers, and medical training\n\ud83d\udd90 Interactive tools for rotating, zooming, and highlighting parts\n\ud83d\udcda A powerful aid for self-study, classrooms, or professional learning\n\nWhether you\u2019re preparing for exams, teaching in a classroom, or just curious about the wonders of the human body, Real Anatomy provides a hands-on, immersive experience that goes beyond textbooks. Enter the future of learning \u2014 in VR.", "short_description": "Discover the human body in stunning 3D. Explore anatomy layer by layer with immersive VR models and interactive learning tools."}]}, "developer_name": null, "developer_privacy_policy_url": "https://machenn.com/privacy/", "developer_terms_of_service_url": "https://machenn.com/conditions/", "publisher_name": "All Real", "support_website_url": "https://machenn.com/", "website_url": "https://machenn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
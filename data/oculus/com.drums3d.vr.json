33_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYva8nqRzcgQ7kNvwGgZKht&_nc_oc=AdpeDA9LC6MKaiGN4ydooFbz7xhGIBRe6pSKVcM6NW7xaztIQ_ggvYgmxBh90ubWf-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIxtxl2MPc7M8ybCCd1GDSekmf_9iXiA2jybdlesBNtA&oe=6ADDF849"}, {"file_name": "shot-5-lights.png", "id": "1786321042402146", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827601_1786321045735479_572018127454533507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rcnGjSXCWgQ7kNvwGS8WK2&_nc_oc=Adr3XWs-Q8tO2H8eMMvVqecm_E10Z5Rjh_KJCVd3n5W2i1KpyXQ2MDB72QuK-TP8h30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI3l1a0qOu3WYm1oS2Bkp0yUuxE4hvErDy0cG4p6PhIA&oe=6ADE224D"}, {"file_name": "shot-1-play.png", "id": "2158744238391245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827601_2158744241724578_5638963723890144833_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MF4ptof1PMQ7kNvwGxLESf&_nc_oc=AdqGGABQotPxbkD3AkrMRQR2U6xmcvfBRuJKxBEQMeMD4UfyIMRU6Z3eBPreaoYgO74&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN55KdFsOheiztwUDzeF3wVheGeFxj8W0oabdWejt9j0g&oe=6ADDFF3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drums3D", "keywords": ["drums", "rhythm", "music", "practice"], "long_description": "Drums3D puts a full drum kit in front of you. Strike the drums and cymbals with the sticks in your controllers: the harder you hit, the louder it sounds.\n\nPLAY ALONG\n\u2022 Grooves in the style of 150 famous songs: rock, pop, funk, metal, Latin and more\n\u2022 Let the groove keep the kick while your hands play, or play everything yourself\n\u2022 Slow the tempo down to learn, speed it up to push yourself\n\nPRACTICE THAT MEASURES YOU\n\u2022 Rings show each hit just before it lands\n\u2022 Your turn: the groove goes silent, a click stays, and every note you play is timed\n\u2022 A report per drum shows whether you rush or drag, in milliseconds, with one tip on what to fix\n\u2022 Silent bars test your inner clock; the trainer raises the tempo as you improve\n\nYOUR KIT, YOUR WAY\n\u2022 Pick any controller buttons for the kick and hi-hat pedals; the hi-hat opens and closes with your pedal\n\u2022 Move drums and cymbals, raise the snare or the floor tom, set your seat height and distance\n\u2022 Comfortable seated or standing\n\nThe grooves are simplified practice patterns in the style of the songs, not transcriptions of the recordings. No account, no ads. Also on the web at drums3d.com.", "short_description": "Sit behind a full drum kit and play it with the sticks in your controllers. Choose your own pedal buttons, play along with grooves in the style of 150 songs, and see how your timing really is, note by note."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drums3d.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Grigory Frolov", "support_website_url": "https://drums3d.com/about/", "website_url": "https://drums3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433965789790964"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1102479475708957"}]}, "baseline_offer": {"id": "1102479475708957"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791209040, "status": "PUBLISHED", "id": "1102479475708957"}]}, "li
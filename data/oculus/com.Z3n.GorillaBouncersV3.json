 jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Gorilla Bouncers V3 is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": "Z3nLLC", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-bouncersv3/home", "developer_terms_of_service_url": null, "publisher_name": "Z3nLLC", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-bouncersv3/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1219348477919639"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1234697376384749", "version": "6"}, "id": "965154572948096", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1219348471252973", "is_concept": false, "latest_released_binary": {"__typename": "And
64.5771-25/499297170_2065283560736284_6380145615052326044_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFn0O2iVUlwQ7kNvwET2s7o&_nc_oc=Ado6_B8kNU3T_PeqBD_Ote-D4eR7xc0cziJoz7gNGjhXSx2UVUK6HZomsxucrSSjvJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDF9Ikbkq_q5gI4ydyODwl0bFC_bDp1XOAJiswQUZtwg&oe=6AB51B65"}, {"file_name": "hovertome-screenshot-09.png", "id": "2219820072194135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297507_2219820075527468_2771830741965615577_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avD9y0hEO5UQ7kNvwHiIMh5&_nc_oc=AdoYdGYi8ispogO5iS8ohYBApFnzesgV8l8vW4j6YRdOT532qULSmH7PsH_TIAsDPOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7QdbYSG98YffeIPXcvSenww_XXeEH8xFtosJSHOg5zw&oe=6AB53261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "789885770870068", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/646428823_789885774203401_1593903286670541774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6vGnrgaxdQQ7kNvwGVC9nF&_nc_oc=Adr_3hbSMWwZCS-4Z3W1R1rh8lVPcHEmcV0vuq4SYvGz1P6KQ0qmfCfIfl9b1KRaQl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn9s57e6m8ZLmYl3BQWAl3K6Vjl7rKp1p6CE41jeShTA&oe=6AB5443F"}, "display_name": "HoverTome", "keywords": ["epub", "books", "comics", "reading", "ebooks"], "long_description": "HoverTome is a reading room that goes wherever you do. Your books hover in front of you on pages so sharp you forget you're wearing a headset \u2014 no blur, no shimmer, just words.\n\nREAD YOUR OWN BOOKS\nBring your EPUB, PDF, and comic (CBZ/CBR) files, plus MOBI \u2014 older formats convert automatically. Your library lives on your headset. No accounts, no subscriptions, nothing to sign up for.\n\nSEVENTEEN WORLDS AND THE COSMOS\nRead in a mountain cabin, a jazz club, under an aurora, in orbit. Or turn everything off and read in your own room with passthrough.\n\nMADE FOR READING\nEleven typefaces, adjustable size, spacing, and margins. Page colors and brightness for day or night. Two-page spreads with real page turns. Bookmarks that remember everything.\n\nCOMICS DONE RIGHT\nWall-sized pages, and a magnifier that pulls the small print right up to your face.\n\nA DICTIONARY AT YOUR FINGERTIP\nPoint at any word, pull the trigger, get the definition.\n\nNO CONTROLLERS NEEDED\nSet them down and read with your hands \u2014 pinch to click, swipe to turn the page.\n\nDISCOVER THE CLASSICS\nNearly a hundred classics, free to download inside the app, with a library of your own to grow.\n\nQuestions? We're at support@hovertome.com.", "short_description": "Your library, anywhere. HoverTome turns the books you already own into crisp, floating pages in worlds made for reading \u2014 a cabin, a jazz club, orbit, seventeen in all. Import your EPUBs, PDFs, and comics, pick a world, and read. No accounts, no subscriptions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hovertome.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Loopytunes", "support_website_url": "https://hovertome.com/#support", "website_url": "https://hovertome.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1084102381241282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t
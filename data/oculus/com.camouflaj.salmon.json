l4h5sY4kWHC33_MjWobQhNZvdLJC6dnGFPusp5SM4sr0KfxsbmfRj8pl6tKBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrWpZwA3beuDmovk4rPFEbemGcgFBfrBSs9uLsVn67uA&oe=6AC7B82F"}, {"file_name": "Marvel's Iron Man VR_2560x1440_APPROVED.png", "id": "5507996149287789", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_5507996152621122_6222831684702021903_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEy4W5B8c_EQ7kNvwH-z1OT&_nc_oc=AdoNqJ2Qe1igAzyA9IucYyIUZfhPK3Gxgr4CpX_Xi7E5ujNdl2CjwzGgcn94Dw7hNUk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi1IGZovjhqHDz2s1TXmxLfOnPA_f_OMIzor4DenceZw&oe=6AC7AE11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Marvel's Iron Man VR_2560x1440_APPROVED (1).png", "id": "831980287825985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_831980291159318_4795131847292958762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEPqHVsZ_nAQ7kNvwE2eLy-&_nc_oc=Adq8xM8kzd7yayJEcU_7kMnY3X5yHZ2GG8UIZ1gpHuevlUoCpnNgXB3SYQL46BHQeGg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPtl10HCKHmoQFsyVhNRNG2XQ8EYu1jSL6y2ziAIPWSQ&oe=6AC7B08B"}, "display_name": "Marvel's Iron Man VR", "keywords": ["shooting", "fighting", "flying", "spiderman", "action"], "long_description": "BECOME A SUPER HERO. BECOME IRON MAN. \nTake flight in Marvel\u2019s Iron Man VR!\n\nTap into your inner Super Hero as you step into Iron Man\u2019s armor and blast into the skies. Explore Tony\u2019s garage to customize and upgrade an arsenal of gear, gadgets, and weapons. Hit the afterburners and feel the rush of flying hundreds of miles an hour. Use all of Tony Stark's resources to find the mysterious villain Ghost and her army of hacked Stark drones. Experience this action-packed immersive Iron Man adventure now  \n\nKey Features: \n- Use intuitive Meta Quest Touch controllers to soar through the skies and locations around the world\n- Take down enemies with Repulsor Blasts and other powerful weapons\n- Tinker in Tony\u2019s garage to customize and upgrade Iron Man\u2019s armor, gadgets, gear, and weapons\n- Experience an Iron Man story made exclusively for VR\n- Immerse yourself in the Marvel universe with characters like Pepper Potts and Nick Fury\n- Challenge other players on global leaderboards\n\n(C) 2022 MARVEL", "short_description": "BECOME A SUPER HERO. BECOME IRON MAN. Take flight in Marvel\u2019s Iron Man VR!\nTap into your inner Super Hero as you step into Iron Man\u2019s armor and blast into the skies. Explore Tony\u2019s garage to customize and upgrade an arsenal of gear, gadgets, and weapons. Hit the afterburners and feel the rush of flying hundreds of miles an hour. Use all of Tony Stark's resources to find the mysterious villain Ghost and her army of hacked Stark drones. Experience the action-packed immersive Iron Man adventure now"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meta.com/legal/quest/privacy-policy-for-oculus-account-users/", "developer_terms_of_service_url": null, "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://marvelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "ja", "ko", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "505865080881703"}}]}, "scheduled_offers": {"count": 25
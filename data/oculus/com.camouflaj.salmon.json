6AFC6F34"}, {"file_name": "shanghai.png", "id": "674786584081872", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974494_674786587415205_3311560529705655842_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2bqFYUm4SEQ7kNvwHhm3oY&_nc_oc=Adqd6it-WvFbtTd6mv3t8a_Ss1aGmaIbEC9jPkg4YGQyCY5A1nJLzhbGMD23SA_TbHA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTupzjHpQq_tn5UlGJ9yEB-rC-7cbLcbpP60TOF75M8jQ&oe=6AFC64BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimageironman.png", "id": "1600950267039284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031594_1600950270372617_5703237392649480921_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnUiNMKM6J0Q7kNvwExVvez&_nc_oc=AdoZvmzFFsrwutH6J8G7KpzhmH2hgt5UIjBdWCXWhPn-pCbMgzzVC7viPpxNREumxYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNXc3sd1h0tu7gSxVfBXYkOVgKMJxBmB1ZhKf4NVBu8g&oe=6AFC6F71"}, "display_name": "Marvel's Iron Man VR", "keywords": ["shooting", "fighting", "flying", "spiderman", "action"], "long_description": "BECOME A SUPER HERO. BECOME IRON MAN. \nTake flight in Marvel\u2019s Iron Man VR!\n\nTap into your inner Super Hero as you step into Iron Man\u2019s armor and blast into the skies. Explore Tony\u2019s garage to customize and upgrade an arsenal of gear, gadgets, and weapons. Hit the afterburners and feel the rush of flying hundreds of miles an hour. Use all of Tony Stark's resources to find the mysterious villain Ghost and her army of hacked Stark drones. Experience this action-packed immersive Iron Man adventure now  \n\nKey Features: \n- Use intuitive Meta Quest Touch controllers to soar through the skies and locations around the world\n- Take down enemies with Repulsor Blasts and other powerful weapons\n- Tinker in Tony\u2019s garage to customize and upgrade Iron Man\u2019s armor, gadgets, gear, and weapons\n- Experience an Iron Man story made exclusively for VR\n- Immerse yourself in the Marvel universe with characters like Pepper Potts and Nick Fury\n- Challenge other players on global leaderboards\n\n(C) 2022 MARVEL\n\nFor ages 13 and up.", "short_description": "BECOME A SUPER HERO. BECOME IRON MAN. Take flight in Marvel\u2019s Iron Man VR!\nTap into your inner Super Hero as you step into Iron Man\u2019s armor and blast into the skies. Explore Tony\u2019s garage to customize and upgrade an arsenal of gear, gadgets, and weapons. Hit the afterburners and feel the rush of flying hundreds of miles an hour. Use all of Tony Stark's resources to find the mysterious villain Ghost and her army of hacked Stark drones. Experience the action-packed immersive Iron Man adventure now"}, {"images": {"nodes": []}, "id": "1044617665269282", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marvel's Iron Man VR", "keywords": ["\uc5b4\ubca4\uc838", "\uc5b4\ub4dc\ubca4\ucc98", "\uc288\ud37c\ud788\uc5b4\ub85c", "comic", "avenger"], "long_description": "\uc288\ud37c \ud788\uc5b4\ub85c\uac00 \ub418\uc138\uc694. \uc544\uc774\uc5b8\ub9e8\uc774 \ub418\uc138\uc694. <Marvel's Iron Man VR>\uacfc \ud568\uaed8 \ub9c8\uc74c\uaecf \ub0a0\uc544\ubcf4\uc138\uc694!\n\n\uc544\uc774\uc5b8\ub9e8\uc758 \uc544\uba38\ub97c \ucc29\uc6a9\ud558\uace0 \ud558\ub298\uc744 \ub2ec\ub9ac\uba70 \ub0b4\uba74\uc758 \uc288\ud37c \ud788\uc5b4\ub85c\ub97c \uae68\uc6b0\uc138\uc694. \ud1a0\ub2c8\uc758 \ucc28\uace0\ub97c \ud0d0\ud5d8\ud558\uba70 \uc7a5\ube44\uc640 \ub3c4\uad6c, \ubb34\uae30\ub97c \ucee4\uc2a4\ud140\ud558\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc560\ud504\ud130\ubc84\ub108\ub97c \uc791\ub3d9\uc2dc\ucf1c \uc2dc\uc18d \uc218\ubc31 \ub9c8\uc77c\uc758 \uc18d\ub3c4\ub85c \ud558\ub298\uc744 \uc9c8\uc8fc\ud558\ub294 \uac10\uac01\uc744 \ub290\uaef4\ubcf4\uc138\uc694. \ud1a0\ub2c8 \uc2a4\ud0c0\ud06c\uc758 \ubaa8\ub4e0 \uc790\uc6d0\uc744 \ud65c\uc6a9\ud574 \uc218\uc218\uaed8\ub07c\uc758 \ube4c\ub7f0\uc778 \uace0\uc2a4\ud2b8\uc640 \uace0\uc2a4\ud2b8\uac00 \ud574\ud0b9\ud55c \uc2a4\ud0c0\ud06c \ub4dc\ub860 \ubd80\ub300\ub97c \ucc3e\uc544\ub0b4\uc138\uc694. \uc561\uc158\uc73c\ub85c \uac00\ub4dd\ud558\uba70 \ubab0\uc785\uac10 \ub118\uce58\ub294 \uc544\uc774\uc5b8\ub9e8\uc758 \ubaa8\ud5d8\uc744 \uc9c0\uae08 \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694.  \n\n\uc8fc\uc694 \ud2b9\uc9d5: \n- 'Meta Quest'\uc758 \uc9c1\uad00\uc801\uc778 \ud130\uce58 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc0ac\uc6a9\ud574 \ud558\ub298\ub85c \ub0a0\uc544\uc624\ub974\uace0 \uc138\uacc4 \uacf3\uacf3\uc758 \uc7a5\uc18c\ub97c \ub458\ub7ec\ubcf4\uc138\uc694.  \n- \ub9ac\ud384\uc11c \ube14\ub798\uc2a4\ud2b8\ub97c \ube44\ub86f\ud55c \uac15\ub825\ud55c \ubb34\uae30\ub85c \uc801\uc744 \uc4f0\ub7ec\ub728\ub9ac\uc138\uc694.\n- \ud1a0\ub2c8\uc758 \ucc28\uace0\ub97c \ub458\ub7ec\ubcf4\uba70 \uc544\uc774\uc5b8\ub9e8\uc758 \uc544\uba38\uc640 \ub3c4\uad6c, \uc7a5\ube44, \uc0c1\uc9d5\uc801\uc778 \ubb34\uae30\ub97c \ucee4\uc2a4\ud140\ud558\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694.  \n- VR \uc804\uc6a9\uc73c\ub85c \ud2b9\ubcc4\ud788 \uc81c\uc791\ub41c \uc544\uc774\uc5b8\ub9e8 \uc2a4\ud1a0\ub9ac\ub97c \uacbd\ud5d8\ud558\uc138\uc694. \n- \ud398\ud37c \ud3ec\uce20, \ub2c9 \ud4e8\ub9ac\ub97c \ube44\ub86f\ud55c \uc5ec\ub7ec \uce90\ub9ad\ud130\uc640 \ub9cc\ub098\uba70 \ub9c8\ube14 \uc720\ub2c8\ubc84\uc2a4\uc5d0 \ud479 \ube60\uc838\ubcf4\uc138\uc694.\n- \uc804 \uc138\uacc4 \uc21c\uc704\ud45c\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c4\uc804\ud558\uc138\uc694.\n", "short_description": "\uc288\ud37c \ud788\uc5b4\ub85c\uac00 \ub418\uc138\uc694. \uc544\uc774\uc5b8\ub9e8\uc774 \ub418\uc138\uc694. <Marvel's Iron Man VR>\uacfc \ud568\uaed8 \ub9c8\uc74c\uaecf \ub0a0\uc544\ubcf4\uc138\uc694!\n\n\uc544\uc774\uc5b8\ub9e8\uc758 \uc544\uba38\ub97c \ucc29\uc6a9\ud558\uace0 \ud558\ub298\uc744 \ub2ec\ub9ac\uba70 \ub0b4\uba74\uc758 \uc288\ud37c \ud788\uc5b4\ub85c\ub97c \uae68\uc6b0\uc138\uc694. \ud1
XAy&_nc_oc=Adpn2yt_6Y36pkaMnk2-mRwft6_iXC2uYMHssxJYBixKMArEJb-ECCIRYTp-g8g9Zy0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLmtGGDY99dBob3xGhYnVV9eYVJDlA09aZWucLO_oV_A&oe=6AF9D09D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR Vortex Fighter - Demo", "keywords": [], "long_description": "The vortex is open, and the fighter is you. Are you ready to claim your place among the stars?\nKey Features:\n\u2022\tHigh-Octane Star Defense: Experience an intense, fast-paced arcade wave shooter where you stand your ground against a relentless cosmic assault.\n\u2022\tImmersive Cosmic Environments: Battle on the edge of a futuristic space platform surrounded by massive fleet ships, distant orbital stations, and burning celestial bodies.\n\u2022\tDynamic Saber Mechanics: Dual-wield high-tech energy blades with seamless motion tracking. Deflect oncoming hazards and slice through waves of projectiles in any direction with satisfying precision.\n\u2022\tBuilt for Meta Quest: Developed using native OpenXR and Meta SDK protocols, optimized to deliver smooth performance, crisp visuals, and immersive haptic feedback on your controllers.\nHow to Play:\n1.\tTrack the Threat: Keep your eyes on the horizon as glowing energy projectiles rush toward your platform.\n2.\tSlice & Score: Swing your sabers to destroy targets, maintain your streak, and push your high score to the limit.\n3.\tDefend Your Station: Watch your health bar closely\u2014too many missed targets will compromise your shields and end your run!\n \nRecommended Store Details:\n\u2022\tGame Modes: Single-Player, Arcade/Endless Wave Defense\n\u2022\tSupported Controllers: Touch Controllers\n\u2022\tSupported Player Modes: Standing, Roomscale (Comfortable stationary gameplay)\n\u2022\tComfort Rating: Comfortable (The action comes directly to the player, minimizing artificial motion sickness)\n", "short_description": "Step onto the cosmic frontline, ignite your energy sabers, and defend the galaxy from a relentless barrage of dimensional projectiles!\nIn Vortex Fighter XR, you are the ultimate line of defense against an onslaught raining down from the depths of deep space. Positioned on the exterior hull of a massive orbital battle station\u2014surrounded by colossal capital ships and volatile planets\u2014you must use your dual laser blades and lightning-fast reflexes to deflect, slice, and survive the cosmic storm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frumusete.ai/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Frumusete AI, LLC", "support_website_url": null, "website_url": "https://frumusete.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26965706023097690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823949_752169157923626_6651462231464795847_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R6P4OLGEzQQ7kNvwGgzH0-&_nc_oc=Adpwrztva8Zze1ybmuJrGvwJc3-WVNFajCqLvg0yEz1eYbt1O8RsL0w7AUZKkUEYu6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgf1sveRblZQlP9MyiclRO4QOemsL5w8QCw39JrY8-bQ&oe=6AF9BD23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Vortex Fighter - Demo", "platform": "ANDROID_6DOF", 
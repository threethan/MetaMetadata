&_nc_oc=Adrf9xYbZOEMeYfdIqTUAhnFvgCbqmK2c0ab_IyywO6LbpmhEcsIYTvSXUNWbNTryVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBZPFLfEm3grsSdHUGbE2OBwA-7_4ZAI-YMlz8y0SRXg&oe=6AABE5FB"}, {"file_name": "FlowerVR.png", "id": "4443246072620826", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622184_4443246075954159_5028170474425591563_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZG_C7nK11MQ7kNvwG_CM6u&_nc_oc=Adr_jYqpXnW-jmpKRu61UUBEyQlJNXI6NhPtIUbINrZZzNjlIczS3W1zvGIjb0MjPBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1e3XzFE_j2TLnex5gUKeJAMLaI216k6D-cJK2Z3AFhg&oe=6AAC04D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Construcubes demo", "keywords": ["Build", "Cubes", "Construction"], "long_description": "In Construcube, you can build **anything**.\n\n# Construct\nIn the construction mode, you are given a set of bricks along with precise instructions that will guide you through the construction of a given object. Find the correct brick, find where and how to place it, and shape your art brick after brick !\n\nOf course, you have to follow instructions, and we're sure you'll be very cautious. However, don't worry, you'll be the only final judge for your work, so, no stress: this is a chill game about building things. If the object is fine with you, it's fine with us, we won't make you start over !\n\n# Play\n**not available in the demo version**\n\nOnce you built an object, you can add it in one of your personnal rooms to build your own layouts and landscapes. Are you going to build a whole town ? Or perhaps you'll prefer to make a zoo with all your animals. Your choice !\n\n# Create\n**not available in the demo version**\n\nIn the creation mode, you can make your own constructions. Pick your bricks, connect them as you wish, and let the game generate instructions !\n\nYou can use bricks among a large number of distinct shapes, materials and colors to shape anything ! The sky is the limit.", "short_description": "Grab, move, rotate and connect bricks to build many cute objects ! Follow instructions to build things such as a flower, a robot or a well-known building, or make your own models and share them with others !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maximeetsgames.github.io/MaximeetsGamesPrivacyPolicies/construcubesDemoPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Maximeets", "support_website_url": null, "website_url": "https://maximeetsgames.github.io/MaximeetsGamesPrivacyPolicies/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1214611135063323"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827960_1338801578214971_1302596220343137580_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJxI8uKi5ooQ7kNvwFViYhB&_nc_oc=AdpPKFciuQZm6YAhJ4ILDX8NE11IDJCv985noCGU2O3hTzxVjaGFIrxqxMOLV0TS0Jo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTTeEBCd7jNWLh-fbfenhFw7J1-iiXPMMSBsg3d0EFRQ&oe=6AABE6BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Construcubes demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics
=7f20f&oh=00_Af_6mx6bgLIdNHt7fFamwH5VN7UW7eCdPVz5A_SxMS4AIA&oe=6A2EC045"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOJB9XD7stUQ7kNvwEqwh0J&_nc_oc=Adp9jfjL1kI-W-RgL5X6BPdCyg58gadngc0CHRpUR1tTKLkL0XL1dEW1DlIN2mever8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HZdBYXqELpgbawmA92j0djzM9M4GBRhmuEhwsnL0_Ug&oe=6A2E9AD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB9AcdZlVYkQ7kNvwEsiXlW&_nc_oc=AdpDpBLxmVEAIKuMBnqWlsNc_XqHbDOxOjZ-rwzNL2NplZ7VXP_d157rAUhzMJPq_Oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H5tF1iH9kG7w2Gl0-kyCYvQ-URPbnoC8KPQUaIlk1gw&oe=6A2EAEE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVjmYM6g3lcQ7kNvwG-vtsu&_nc_oc=AdqmZH1_97qD97bJp-cvbD2QEHXOe0Wl39SgDTaGb1jp1ysDLt7L1yXeEWDGH38Irh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GxT1Jp9wWnugDcWzbDiUOBh9hhYELQg2UUNiuYtwFuA&oe=6A2EA48A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IaSk6ZBxeMQ7kNvwEjzb7K&_nc_oc=AdqMJ7dJdlFszc8owHYgcNr9Md_2plL19Ms0Mt6n1D3cEp2bq3HmijBIfYUnRP2jJmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QCLrP_dvFI4kK4EQuK10HD0hjY692sLGcqiO1MZqMNQ&oe=6A2EBB40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
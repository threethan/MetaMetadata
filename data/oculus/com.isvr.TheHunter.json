=7f20f&oh=00_AQO1JLoKLONQDgwp7mo1TPKQgSLV3OMM5ltSo3xrVsd5wQ&oe=6AE20C45"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvdm4suAcAEQ7kNvwEM2ZvX&_nc_oc=Adok7_b2z1uR_kHy2UAYlxywBN-9caNUjEx_izfkCsxEYFkEgALyBsYKIh_ILpo-IvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRbVBOVLXKuZ9MqPXGUXEOnf42Jqzcui1HNy2LC7yS_w&oe=6AE21F14"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sitwq3vVZsUQ7kNvwGtD5dQ&_nc_oc=AdozZJ9jodd_-iyzfnGpb_qz_3_B1uryYWlihuHkvKSN3DB8iTtwDyRJKN-M6-vEkCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu3RtnUgk6ioF0DV7d6WOoWfJt6VbThqbTUSVAmVbaVA&oe=6AE1FAE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NplSWcjMX5sQ7kNvwEiokpt&_nc_oc=AdreXDr0Wv8DLMR26g6hpj-_bM20huo04AuwUA1ue7_H_gYCjuNDiPMwHiOK8YE6hy0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJCvP5HmOuS754LoNloWPFd9OAGPIYkZUDUWhQzc9gNA&oe=6AE1F08A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOqrQF94FNAQ7kNvwGKbpnG&_nc_oc=Ado7CSiSC9IQrJtarc37D-NICLmd_dJOGJawOXbB0nvYF9Kj1cRkJNm5B75qH72mv_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyOELe7EsGlFl4QA74TtGVSJ9oRS0JCDdD3FypRZgtfw&oe=6AE20740"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
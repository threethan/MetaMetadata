cdn.com&_nc_ss=7f20f&oh=00_AQG3oEbf1qG4O7RGdgp-53_eJhamyjl-bi5SVHDIPpSc8w&oe=6A8EC585"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwA7n1GV5fwQ7kNvwHXMByW&_nc_oc=Adqq4f98TMmpN5wUR4ScjGDD3A6WCksoxKF28oRYltvUBSMKETBQOUCT-rfm9jQV850&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFrxF2PynZGLtsRGFTOg-9BhBpdBHcxK-hbx6iFYiSIQ&oe=6A8ED854"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqQksMC-wagQ7kNvwHy2Wx9&_nc_oc=AdrZXTIZ5-x4gy5QdelIqsvNALJFjm84X7VmjtOpL25d3BeED-pQ2AF2N_-R7FDKh4g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM_k4sVs66gxJyk9UeDS1NDrpcw5qnMhPlU0lbqN9XyQ&oe=6A8EEC64"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dns-Jp30S44Q7kNvwHzx47K&_nc_oc=Adr_XOC8ZUaeK6EW7l_jmLhPJYNawau7N7hrWqvwcrqwcupFudCXfC41f3KbaI6bA6E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXRqlySV7ommST2pIN3wUabqlIfG0ln8dv9z3qzmKaNQ&oe=6A8EE20A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySeSi6a5wfsQ7kNvwGIvZPT&_nc_oc=AdppigGxtrj7Pn1rghuCJ89uJjmf013SVx6jGM5mfq-jhfh68pSGgH5uSifHQrFLpEI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEECR4Rw2qr_KsPrzKXmNG0NRJ4EU0sZARLZl0vysYIkg&oe=6A8EC080"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release
=7a30f&oh=00_Af0JnkFtTKfufhZO1PCmm0khHbdjJ3PsWAOlm_VFYNVBkA&oe=69DCCB05"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4ePZdY-gAoQ7kNvwEW86lq&_nc_oc=AdrnCAgbSHYw1zuLyWkP5HU4iJr11KE4W7Hjxgccu1gIS8jN4SXhS5gqcdf1v0NhvQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16Yrdu7Kl8W9ErDbwCvk9MDGOzu5OaxcExrfyUafzdnQ&oe=69DCDDD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D9zAubyh9gQ7kNvwHc6Nhm&_nc_oc=AdqR-j8djrV9fDLAPTGPmlRLBAljdhbHBhN8eV30XROra86-2WRqQ6Sxu6L2LEKy2gA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gfa6UYah2_xeksS9DGVVYoN9JDWQCh6VTsFrx-j5Oqg&oe=69DCF1E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-PeJOk_rP4Q7kNvwHGmuZk&_nc_oc=AdrjqnD1Q_qmHMcHt7Gm8ckK3ce5uVKyZBJMvRXa1oU50LY1kmAMCm5xDd6mlZeR0jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mYcv902wGuKJHcVhNz61LRWT5Ryd5T1dL-_iEVzhXsw&oe=69DCE78A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_aKZBnUPH8Q7kNvwGUKoX3&_nc_oc=Ado9JVERC2q-Dhe9LqqR3KIFRx8oUw4n8kZ-KhLrhsoy6X-9YTExY9Y1tQWqZt33Kjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Gu8QjFNwjD_GqEsAA8t9kzjAGEkgvvKYmHBQjb53lA&oe=69DCFE40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
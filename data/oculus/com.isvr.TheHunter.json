=7f20f&oh=00_Af-upoodJVT6AIemic6-Izoglh8cQtK3EAvsY3IlBL7V7Q&oe=6A413545"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3dYv8zRWjIQ7kNvwF4R1M9&_nc_oc=AdqQ5pTrocOXjFvfgkSHhycwQqZdrfvAA8gzc6L78-ZNVQ15MPVaKx9Ck7nF_sE3eLA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TEoZmSm0Uuqd325NBkIkBxZQc04_Z1FOwhUgEg6fNiw&oe=6A410FD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY1Zf8mlADwQ7kNvwG6v07r&_nc_oc=Adq_zXnKjNTheuG_it-wivTTDgZuF5gYCg4edxlmv_0CNZb_yeKhl1FUBiQHI5bg-7k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XSz2J_xiC2hcyV6Iov5inflfidhrK7w9N5GMY-8SLxg&oe=6A4123E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgkGmb2nP3EQ7kNvwEPHcBV&_nc_oc=AdqETGvgcacvQs_XxORljq_d9FnGU6pCaE9WGlpzsSBLxMHqrMthL8oh-Qh7shh8AGw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uGyVI5DwNPRw1wrINEKa_s9A531SQnstuOeY8OwhiAA&oe=6A41198A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fzIKybGGvwQ7kNvwGnCyqe&_nc_oc=AdqxqE-rKf6hJzIxodnYclWtI5_1Bs0xM-YRq_S3iibIa67wWG-Ozc171fpkqdvvIw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xzt9gZIlWpstmCXjwC3bNIV4BMzOHD2VniDLx-Vy-SQ&oe=6A413040"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
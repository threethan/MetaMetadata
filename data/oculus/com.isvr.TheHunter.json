=7f20f&oh=00_Af_CSqbw0TW2eATnkv-QEpESnC7yv0QefGjCCCoyHdFwAA&oe=6A4286C5"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6xukHNT2dgQ7kNvwFMKDt5&_nc_oc=AdpISAGssCfJnV6HKOKZqtZUri4gaqfSwdxbhDE6XZPN1mf5KKbiQx1M8cObez8czKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Czjv07Vambh6zlE_-0q31P8264qOtHKGD_KTR3OSHYQ&oe=6A429994"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY1Zf8mlADwQ7kNvwEBRX0I&_nc_oc=AdpXKLtOA4H_XJW-33liv07tEy3eIbLszbdZss-IOHWKTwO32aW9rFhn5bGBz13E9xM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hdj-b_uPKh0T2j2CP7o95yY5Wmj1svinWr9_CWmIi4g&oe=6A427564"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgkGmb2nP3EQ7kNvwE6KTF9&_nc_oc=AdpvGMPKmQIGabeWh6tP7aj1tF5MwpcgNQ-B0gUXFEawZr02fBuAlCa-tK6VvFva0rk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oPhh0mJCL24BXBmqxMNYLUi3qZYPZY6b-T-pUr1osRg&oe=6A426B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fzIKybGGvwQ7kNvwFWTSpb&_nc_oc=Adr2hDS2wB3g0DvN1ZPT3ZXCx1qbwhptM2-xk7PZORf4d95XmMhcRxfmpOLhhN7KD8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9gCC8-nXgLrnq99_Ngwqdg5-gli4pbtYsH6ticzC6w&oe=6A4281C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
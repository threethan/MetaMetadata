=7f20f&oh=00_Af4Ph8k1xTNe5XV-U5ssq73-HO5Y0fLW9rABymTBOeUMtA&oe=69FA0445"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFexVK-4TWoQ7kNvwFs0Rju&_nc_oc=AdqIi6secIh9j_PTJJN3owFu03obivC11sMg_eG7UAhJ7MOv2Q3MoHFbSQ_JotyH1lY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G4TbnMwwuW4p35ssKEy-Q_-hTsIrYB-ybD4E9gMFp9Q&oe=69F9DED4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QyGqgAUqcgQ7kNvwHv9VYl&_nc_oc=AdoZ-k3CAJ1ft0G0OwjMxQhbIH6UWcQwImgw4h8AKx_nXax2XA7hjCwYSrwfexR3HT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_2kJjWjMUYDomkiG8C77X-lDik8QFFbcG31tvhWkkmw&oe=69F9F2E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnL8OKfHxq4Q7kNvwGIkOwB&_nc_oc=Ado1cm57a67NosJOW4CorxpsI2JSyeVIN4_vVHU5SvSm4tU3qxgbBNkfwRHRP3uw6BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a1SuTpPoGE-QzLAMr0reTXMnV3FTsCZFEc--DaUibsA&oe=69F9E88A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpYNrKBT2dwQ7kNvwE7iZdC&_nc_oc=AdplsFyuHDOpHFkBM9UwqoVK7Jqa3R7J4Lh0x9TamZAWhE1-_yLcQRnZF6S-deFcBEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af740yPLlMvqhT8T_Bq5KWK0gUDwEw413VgkhYY_z6flfw&oe=69F9FF40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
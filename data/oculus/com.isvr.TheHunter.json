=7a30f&oh=00_Afws7MgnN-OtXb4HW7BOSIUGY3DfaeCcj0MbpsDGVMjIZw&oe=69C90485"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiBnDcQ82iEQ7kNvwFkArRh&_nc_oc=Adp6Yo18B3J9Sclo4UlsSSMKNqTOcm0k5UIS_J8drk3LtEb6OEHFkLoM9j4ei1guKnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxpdpWbni1FWsfPD3zZ68hzPIP2OhHGTFm7QGqGrKqSg&oe=69C91754"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv0M7yrHKkUQ7kNvwF7Ywfx&_nc_oc=Adpp2k0AEchs2ydw3vOIXgJH9cVdSKm22cn2cXndz4i0PK9KIzb79sRbT-5sO58KJOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTmpbHPhXkJsWwkpwWItcnjiGsh_x2G5d3PW6RJTEE1w&oe=69C92B64"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewe293ftpV8Q7kNvwED4tNA&_nc_oc=AdrD-m2GRDWaFyNb_TBio1oXVsgfku4-7YxjTc5f6C3PXtYYn2b6t64oNEqprWeHFcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-vv92Oh2aShnC5Uz7KTYwf6YnJ36UktF8RH6lJNOuzg&oe=69C9210A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPt6eFEADEcQ7kNvwHk_aIZ&_nc_oc=AdqPg3-pzkcJaLilT2kGYqIIFTIk0sy_SOPHg6F7iZRgkPkBHFH0S5zJyNgFoWBQYsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwPiBdwantMGipyzW5dwShShaMvNWwWsMVYLHAVRBkaA&oe=69C937C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
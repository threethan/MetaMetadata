=7a30f&oh=00_Afznnkq6fySoZNzDmWfTebleipjatG6KlaQDL205f8rgbg&oe=69C51005"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQRbHYLxPiUQ7kNvwGafpEz&_nc_oc=Adq_EBhNN6QkdB-cd6YTpBNzLUBFnKokFhA1VzvGNxmxYB-B4FpG64zbeOTBgzFjwuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJTQkp2yBNwDj_oANNhitMIpA90pBc9Fu83J-l5Toi4A&oe=69C522D4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGJruS78ucQ7kNvwEb4WEA&_nc_oc=AdrR9M23ovro48r9129t0fPDTfQWAiA_w0L1GKs93CfKMVm-rKYoC2x3fpQ-9N7EPlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0EEbbwaIZFtptSsl0oi4x7k3-4zh4Cm6cr1Q055rQ1g&oe=69C536E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuoqCZSFjuUQ7kNvwH7yOPb&_nc_oc=AdrlYVvzxKpJz9l3ns_b0I3bBsUBOKPiRx3CfkJANRPQ_AAkWYdwQYK_5OPDu6nk0R0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL9goljAZQC47H0yganH3UGVqpJi_hIfR2ebod63IWMg&oe=69C52C8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-PBP7WDuW0Q7kNvwFWNa4V&_nc_oc=Adr7fNF4RYgnB1Jm-JrtlB9ME-OCZrb8yCxZyzPRMg6jXlrFwl3us7LIO1IH9U1DoIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYP0ymeBf1kGngWWhzdvBof3LtZNzOvLGekrMnP9r6Mw&oe=69C54340"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
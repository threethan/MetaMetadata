=7f20f&oh=00_Af8NK09UyEceior1mNvPjcMdcjwfIAcWFY4Eb-SMR6m7uA&oe=6A297A45"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WF-KgKJ91sQ7kNvwEHzDwA&_nc_oc=AdqOK7-xDTIMyl7-fz13tJylDlJwp4nJTEtlICfSTs1KUL_ULmfohcNKxl3bGsuIUZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wbn18Lpaa780u1LjzNgnK9G8-wcsV7Q2SfPFZMk1T5A&oe=6A2954D4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8DpcWwT06cQ7kNvwHKrT4f&_nc_oc=AdowhXQC0oSKliaYNpN-W2XdUwXGgOL9Nk2wcITeXxRm0mt77SG7aqatlHOOIIvofOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cBJ-4iScsTkAIM_sdtXM75Lnr1Q1nj3hS4hYQ1kSSWg&oe=6A2968E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ36THIhxdEQ7kNvwFO3TWg&_nc_oc=AdrDTgAXSdm-W1vFZ-dVbDsJZH-oaaJJqCZWiIf0WkgVIaRZO4wRavkjTlN5FhVE8Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C_z62gaWgUnXEHFKICXqYwhb0ayyqDSIZz6YAPcRBUQ&oe=6A295E8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofJOz6yxsP0Q7kNvwF4OZVD&_nc_oc=Adr8Ym8XaGyuqlpiKE6skx0wcCALqq9o8bt0BwZPOjxVn9rc5a4iY62lBrzmQlePffo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1ReZLFeG9gabPgXHTE7KgXLaVKALkMcJ9IipveyMGAQ&oe=6A297540"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
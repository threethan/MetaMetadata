=7f20f&oh=00_AQBDbtuSIAZLXYZu3g_0Vz4AwlZ4Y3OFnS9-pBI-wdXNiA&oe=6A564D45"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpUc_pdXmIsQ7kNvwGh4LHO&_nc_oc=AdooAxIe_Xq7nEcAtV1MhrmzO5W9HAFVnySsmT2py_6gM8Ym81wU_7KwiOVQRgFH-zs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPdU9ZK2SpwxTxitiTLatEskKhtH-n9_iYssv7tT9sTA&oe=6A5627D4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl4V0TzCqs0Q7kNvwH9xVfi&_nc_oc=Adr_eOAId786i0X0Pu-4oSsnDP4W9ekzhel147_29Xvb41fSUfD6iFwC2KX-sv84r1E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtPx4VDDwAYUGlp6G4cc2aFiNhZZ2DIyhV_UfPaIHXhg&oe=6A563BE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUPje7nVEskQ7kNvwHuh1-n&_nc_oc=AdpXC-vx_nDLEWsL50Fmi8yLGviSyVFFUHpzX7xsCkxulftUqLNHIv8ztGaK9V8jUBM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL-C83qUrKmGKeCd58o8M9_VMbjBc4GrOPIIa5f-KszA&oe=6A56318A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OEqdSd3BcUQ7kNvwHn6Kvz&_nc_oc=Adri1kyF9dsi5VwtSyXKTxyi-8YNtbjnHfjUBM3OEJ-9N-QF6a6jrE3KgZ-xZdLZDxY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaPfBUTNz3KKLff4PxhmGaUIwHDH_T3AI0EaviLYGIWQ&oe=6A564840"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
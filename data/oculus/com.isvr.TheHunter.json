=7f20f&oh=00_Af9PrGOHTCdTZqrW5Swx3yoM6kof3M_9CXA_dO7avyXvXA&oe=6A3E9245"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3dYv8zRWjIQ7kNvwH6Vg-u&_nc_oc=AdpgBrIShF6PKiOL3gXDA_I5ZPgI_Y2Kd9vGazjkiGTiSbTZg9bdAdkaS1PaHmNyrIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80vGISLtsJ11JTmHa3VbT6oJgQ2kyMVlmpbn-pypY9xQ&oe=6A3EA514"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3BNvYy3VBEQ7kNvwGgOarv&_nc_oc=AdpPAMrdPNbq54fRchiHXtiiyHqwv_X6TwMRZwLUeDCUoUOZ2SfAA-n9W7OZ1D-wVsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95s1RhchIdcWKJpKGwe5nD9H_NzYlZsp_3DYUDZV_gfw&oe=6A3E80E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmFaKICTe2wQ7kNvwF0iSud&_nc_oc=AdoiS0XeBgPctRKCRbs73YgXHhIxMQ36H14ann7mkP_H1ytt32NsH_B-surZ5Ulo_vc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fl9_D_dBQjtKe-TP-Atp22XPAMyQFVQzQSTT_LeCQIA&oe=6A3EAECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTINsBEn-o8Q7kNvwEkD84o&_nc_oc=AdrKUJWKoiapW0ncgzKsK4IYA09NoZb0WL_8pic_kDUyVyRjM_wTqUvH461ik4QBkOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88wmyXBrXmz5kjVQ6e-ucBiIx6JS3_8UJTDU1Ox5NaRw&oe=6A3E8D40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
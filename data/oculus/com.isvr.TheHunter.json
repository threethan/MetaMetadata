=7f20f&oh=00_Af1WsEIO3p2RWB2oi4LyW7BDWrm2QkFUdZ-x_wWetP6juQ&oe=69F60FC5"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fImw0idn2hgQ7kNvwEG_P9r&_nc_oc=AdqzIk9JXMPtahbxcHD2d0drloKVjM8B7rVeAcH4vt8ozWtg62qhzh4R_Ye9yCZPi4I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tDrtjikvBx1O1Hv_DruFFZeXDiVv8icWROzaTqxG2sg&oe=69F5EA54"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4-Pa8omrc4Q7kNvwGJqAlN&_nc_oc=Ado8P4IGWZTGBOUYR1oP4hgNB27YFEXTLCXQUdII11r4x4LbWaBxcUZLpkKl598vqlk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bbjeFrwLT3WLoj3pukI1fT_S7l1QGUOuPoc9atj86Jg&oe=69F5FE64"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jijXpoEaVzYQ7kNvwEDBpVj&_nc_oc=AdolionocKvWYfvsv30o_G6tM5rS7tl7wopX96FyEVWoo2vZbKek0D9Pec-QsPB9fnQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pG_60rePMJhxXC2PJyt-3LUDXQfNg_8fyvByYAXL17g&oe=69F5F40A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b54N-1sXEa0Q7kNvwGF7F5O&_nc_oc=AdoENBADYDAYTkoowSHsO4pIgA9Nm31xK_0HhkOF5ZBLtkKv7FJvh68I6twR3mqUp6I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zb3ey_jssL6wX6DHzxhZy5k7IH7bxlsMQfDX7eiBZzw&oe=69F60AC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
=7f20f&oh=00_AQBfpsU-AF1O969Vj5XJEJOyL_NmeXAt27xx5iDiui04LA&oe=6A510745"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbBoIH1d0cEQ7kNvwG5St-g&_nc_oc=AdqajrVN6zArIyPEsNzCcddCa1wCvPRbTgqEHo8a7Ww3nBUINnfBLl_nufYPP_BUvv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBDxKyuelmiFfutILU-QOmeNBj_xu2iSR3m7llvEDiJQ&oe=6A511A14"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpMv6Xg8eK4Q7kNvwH63q7s&_nc_oc=AdpKvvYVhtNRxC5gI8OAs3ha4AjRREF6uDT9jhnANaD5TCMu9dkSugP4l8Yn8mQHopo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8cVj7tcBHzydkm0SAY__VE6JCFPteTVWBp-3vHyECIQ&oe=6A50F5E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANXbAz0JctQQ7kNvwH2Gx_V&_nc_oc=Adpsxag09o6huh3NrdAWyh26hZfVWIpCJvuGuUtfmTrdd3qp2tizmM-pd-4Q2mt2bbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2As5K6GIOjFtk6ooih-nOSlAtfJ4zD-eb0kjKtYxP_Q&oe=6A50EB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fit2-IhZfH0Q7kNvwEJIPvW&_nc_oc=AdpvJOTmSf5ZEtn287zI1YDlb0WkWIyyxh3GukClQiB2MkymvrtzaF7XQincVgMr1N8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSq15r_4TjWDapx-vnV325EtySnKN7QBq9jMjt4WM-Yg&oe=6A510240"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
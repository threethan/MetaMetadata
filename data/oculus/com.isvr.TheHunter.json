=7f20f&oh=00_AQII9NzudyIN612bGD8AtQvfQ43c5w8QIWIm_xeYuTWr2w&oe=6AA02145"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVLJC5tC7J0Q7kNvwEKmpZN&_nc_oc=AdoLYyrB0NrJkkrW8f_ME16MFIyaw2-JZ8VB6rhKgoyHOUp-RqCxCEnCfRS5VMa-Fjk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV3LRwSszKgLbAO-ePTIXxht0--2nzaSqFRpDsARFO-A&oe=6A9FFBD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0iUSHCS6BgQ7kNvwFDQ7Jd&_nc_oc=AdoAtTD2v67bhkdUOInVrwPPPj5OtiwHLYyu4hT8xOlqYpYBgAnIsOQvOHs7YhWLWKg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2O6sq8CfdX6MIdKG4nPJI2zmZoalsxQNP71wjEZBjDw&oe=6AA00FE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QRiQUMD6lkQ7kNvwHMZD8a&_nc_oc=AdrQFykubnXF0_EC06fO2fcek_okSnxstacLE9TVyuHP0NJBDHAVFe-vrhGxstEOa-A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz9wM4INyR1-aBzAtBSVcx2nnDWhWCROB3RHMZVZXpFQ&oe=6AA0058A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ezGduepWw0Q7kNvwG6TnkK&_nc_oc=Adp8gKhelH0ndmXy1jWMsn00kzJ5KKJOVhqhob1gghi42pBaN98OPGrOb84iiGjdXl8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-3LLhK-5-UYLDLpZNAoMzcg7bKzggDOnPf8lYjzSQ0g&oe=6AA01C40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
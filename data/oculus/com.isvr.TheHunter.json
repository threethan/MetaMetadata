=7f20f&oh=00_AQBTvCHeJ3fFMfPiAD8RkoujtwD2g0GysU0S1q5Xi4YTRA&oe=6A68C245"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvPprItUkmoQ7kNvwESDlGW&_nc_oc=AdrBVcNHYBizk5-55J1VVPcJtjrpG2ztCPkbuzFLtYjBaVpuAv9iiT1k8FlRFTkuxvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ZgJSOjrmm-ekfkPOB9w28974arNv2N-OzWHj45hzlA&oe=6A689CD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DysaxBdHuQQ7kNvwGSa0uj&_nc_oc=AdpR7soeogdfC1HkgGWhDZkuzxnOFb8pBYADRGWJngDDbpK-RmchWgBbwGYWVmvxNSw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx9qrL0OFBAXo11Jw3USJMDbHrrivIATc-jXO0alF5sw&oe=6A68B0E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H_JbvFceKcQ7kNvwEXfYxS&_nc_oc=AdrgStrb7u52MO6BXX2QkOeH8NphrbMx7SLPoIEmCfQ2FRmAG7pNQOQjYuGcTE7ZXJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGYTKskSU7ka-9NuJQwHEH199WqSUHCsOrE43TgO-K6A&oe=6A68A68A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxSj3ygfc1MQ7kNvwE8VpGN&_nc_oc=AdqupFL4DnXvuAXq3Va4aYCmA2CKDi13Ss6N0t_PVrLg5Kb3ajKkhvUwQCvcdLqq77Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-_ktUfTi38ypV1aWORGar08He7fTmEs7BGny-tlhDaQ&oe=6A68BD40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
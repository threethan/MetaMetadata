=7f20f&oh=00_AQTR2t6KBMa9HHvTNu_FK_QO1hwK8VIRSQLWhh4D0-OCOw&oe=6AE75245"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fdGyrNX6-sQ7kNvwGaPcae&_nc_oc=Ado8-sf9ZC39ESmiyNDnizN7ytnKH5nrMYLwj9t8ZXxS3ZmgPEZT3KyzKGKfZKYFhmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1PFIUdnNfV828gNSpLu8cSJ30nOrgjJX9EjR8Up7uWQ&oe=6AE76514"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KFVpdeBwlMQ7kNvwEb5jeE&_nc_oc=Adqn320FGEAq0nyGS0Ijx2DvHdnwlg3990TZDvy2PhcK5wwbFH7LutNA2qS8xOCYhGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYyRS2Qp_fNItGNWaFXlAls59ZghQkno_KvLVeBtsbPg&oe=6AE740E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByJunaTjX74Q7kNvwGTfyvu&_nc_oc=AdpOl1Q3mDiaYKHRut98Mjwx65FnlH8vIDRDFJ2wnP75A3v9yCA5AihenyODq_HJk8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGso-9C8VRIlPGXdRdZDAj6cM6G88XGLV_tgYBl9U4sg&oe=6AE76ECA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFU_lteN1wwQ7kNvwHPUAPv&_nc_oc=Adqi90eocsTAWk4UGrADjW3p_SQLbFIVNidQhn6cV9zlru9H_9BBANDPWXj8471U288&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe7wi64_6-BIsDlb7WyaJ0w_0RiIkPm6bQFuy0OB2-qA&oe=6AE74D40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
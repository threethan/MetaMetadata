=7f20f&oh=00_AQAFFJBKq1mkpmOnLnzBWOnlfvTFsvooJUgGrYwbIdctOg&oe=6A661F45"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvPprItUkmoQ7kNvwHZNSRE&_nc_oc=AdofgvCnp_jXJj-7Q8A7PphGuz_jYOqiEldw7dPv11OJTGwJbpVb5TxzV1pP-lblYVI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIZWTVPO5mDdsG_TGaINkBwI-ac_GeuzhCrOKfa1D8EA&oe=6A65F9D4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOfi4RV7LHkQ7kNvwFedvLl&_nc_oc=AdrJwrRQWm2XejyZ5F71YYMeyookKNQUuL-kxNONjz6fNCuo1cBVuHeLTI4BtR75lnI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0EIClABouidOWqSGhCF4X4cd_Mm0SnsmRCtKZ9Rk4GA&oe=6A660DE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0BwhjUSo-UQ7kNvwEOvtyG&_nc_oc=Adpfy6d_p0ufQnrxrxp7pM8ivtN91q52berW4lPPIEMwYWiaB9kY3CipNvTA4nqTK2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArv7sw4vH1PyPCPQynrus_aqVG70pdJVXi24reBPQ6LQ&oe=6A66038A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yev1h5m5FUQ7kNvwH1JOu4&_nc_oc=AdqCKWtl9l8ZD6KxtRIa_oMGUXjDk_NI-PWu4XgymPxeOgQmVLZ-PVyaZc8B_fieOZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArgQ4RmU4CWstnzPFDmi3aNrJwBK0GXmVfnq6-Hrhs1w&oe=6A661A40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
=7a30f&oh=00_Afzt_T1XlaA1Z1Ls6c8hQBV7-z5DXWATb2vU8xPnIVKmMg&oe=69C26D05"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of6b6ldle8AQ7kNvwHqFEiC&_nc_oc=AdqYXrdFtnoP_W34clso-CnOCl7Jf0sQYIxoeSYoDSBzwaFCBrUeD9llxI3t7GhpYYc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxygPA8VP2fX0z5RZfTV72lJINvuJ13KUAYjqatE3Y_mQ&oe=69C27FD4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDGJruS78ucQ7kNvwHeCtWT&_nc_oc=Adpa9eDbKqmfKI6yE963XUao75H0Zf1P-dNycGhAmGb-23Yzfj_wfXXLxiWJEIsxhaU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6oUr_50ir4ZMmF21TxrAfhF1A3isc3d1KCSqUl8rhVw&oe=69C293E4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdI6TGDYPpwQ7kNvwGrOQxo&_nc_oc=AdoISgU5h-KwSahxDtu4SvpZssV1JBdtscUi8ed4vsYNmDGbmRHrQpfCYmwXGI12gvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-_4Ta_gbMYFUQQYCWxApGkOVWVbKmuWRb4-fJKRc_fA&oe=69C2898A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-PBP7WDuW0Q7kNvwGi8Yu0&_nc_oc=AdqUIGB08jS1oxMeiEqBGo0Qxnan23a6-4Z4Mcr9vZuxvlLs1pD4KmrF7_ARxVgUACE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMgbE2tsR6bOCnqMzAgunuuYMEoZxzlGqU1OM-MpmKAQ&oe=69C2A040"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
=7f20f&oh=00_Af5l-AGKJmHaZM_Cxqn7ZkuyT_MB0_B4BmwJEl5eRtf01Q&oe=6A1EEE45"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFuF6SKja3cQ7kNvwHXgJ_q&_nc_oc=Adqs_xVNbb6ljg07sDz7_8Vnz7FjQc6XxsDrFJ4EdMXAsxHYgiQxPV4VmiEoT1_80qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RAJhlfVz2y6gV8omuCKG2UOIbVcVIS6kJbUiqmXyGMQ&oe=6A1EC8D4"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAYV8BIAcLcQ7kNvwEitNC-&_nc_oc=Adqu8MzbNDahZzpVJinLxiHGnp7KdoWIQIeiBS5wM36ezufMB6qmVMR9UgcpsxtHv5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vy6wty4oOizNlN_pIqyJISpgypBKBbACPY-SEFvArow&oe=6A1EDCE4"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI9n-Z6TIlAQ7kNvwHzzdOf&_nc_oc=Ado_1RCyOtpoKY47vuoT6jhuWbzp7Tz2h2cycMNit1z0vcnuQOnM670ko1-ATnU09HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z6HIkGztfHB_ppUS2uM4-DYhswG24nv_DEYp-kzvm2Q&oe=6A1ED28A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md6zsj2nuVcQ7kNvwFtASnl&_nc_oc=AdobA0Y9ucvOToIB72W338Fs3QtbcZ-ajvndfEVjTzFbRoVbevIjbZwwHqa4G8Hi9VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mj9MgWsZ4D2Dk3-ts33IjUyAqp4nH2Anpc9Xa4fPISg&oe=6A1EE940"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
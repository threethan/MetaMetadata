om/v/t64.5771-25/12139351_569097779944217_8318980975199518720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S-DceTbY-QQ7kNvwE7XNQF&_nc_oc=Adlb7rkY4xfWB7jvnppxadPcZh7hn9j09Q1yvFHfAqiRimVIJs6XQMqf3udfpQp9qVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMYnrEEGw2uUe-lZ0lG0Ydm0EqA5Rhfmyw9x0WzTc58A&oe=69BFFECF"}, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
=7a30f&oh=00_Af2fk-yUvArdKrqsnn7g4Sdnq3dRxgse0aw4iGtTliShCA&oe=69DE54C5"}, {"file_name": "migrated_image.png", "id": "3024764064211964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602260_1667225633593194_4706498057141747712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4ePZdY-gAoQ7kNvwHpcqEK&_nc_oc=AdrXhrUXdgax9hWc2HhGdcTPXbHTb2C62xi9sxv1H_uenM75HQ4hxFdG4SAYgNpTUkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pSg41XbxRlRCOisdIvVwU4Zg6ND7TffsBTFWNhwvgbQ&oe=69DE2F54"}, {"file_name": "migrated_image.png", "id": "212055759907298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602253_197336150695432_8037739842278260736_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSRZliR94b8Q7kNvwEGKKFC&_nc_oc=AdojnwaDBVwxGZC1zixChRK254_dw9uU0SZPVeUwYhWcJDoUMgBLYKRopD5J4sQjTGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CJ7oHIl9TkC5-iDrqTXt4cuEpG_oyJaGSZu3LTRsH5A&oe=69DE4364"}, {"file_name": "migrated_image.png", "id": "855560544960740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386389_577089055818614_4946059057896095744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-PeJOk_rP4Q7kNvwGc7GD3&_nc_oc=AdrMWOWWbsgjGErLbFlQ9Mzc08_rUQkc5UTAManTz6BOc07CdnC6yj-ZKdsRRmON1fc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00W-WFn3SEKhsMOegfoslpgpmTYL3H-60ChqAkOMPUsQ&oe=69DE390A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hunter", "keywords": ["hunter", "Wizard", "Magic", "Dungeon", "adventrue"], "long_description": "As a Mage which has infinite potential,you need to experience a series of adventure to find out the mystery of your life experience. The dilapidated villa,gloomy Museum,ancient village,mysterious catacombs,are your battlefield, you need to use spells and powers of observation properly, gather clues and defeat the enemies. You enemies are strong, you need a reasonable grasp of the switch and the release of different skills, the slightest mistake can lead to death. \nThis is a first part of series, which invovles only the section of catacombs.\nTry to find out the mystery in this catacomb and survive.", "short_description": "This is a FPS game which use magic to defeat enemies but not a gun. It is little bit horror but absolutely acceptable for most players. Try it and feel the mysterious of Oriental magic world!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.2016vr.com/", "developer_terms_of_service_url": "http://www.2016vr.com/", "publisher_name": "Beijing Hulianxingmeng(ISVR)", "support_website_url": null, "website_url": "http://www.2016vr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "RPG", "SHOOTER", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1082528112317065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386394_667939700051556_4027902235215134720_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EnkwZb-udEQ7kNvwFEiD6r&_nc_oc=AdqrOyGBwdzsIy1segeL5KS-Nt1FQewGbiVe9UDA7K_i9s7ZPKshaU-mtTaFqzMowrE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23wTxGb2DqhYzaRe3T4-halg4dEEr9AfEIPZ_TejTcqQ&oe=69DE4FC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478729266, "lastRevision": {"nodes": [{"id": "1175424285837667", "release_type": "SCHEDULED",
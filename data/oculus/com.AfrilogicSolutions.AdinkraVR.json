a4hmgEmtGrfvkJzsBaDA&oe=6AFC9009"}, {"file_name": "1.png", "id": "771115219119800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303391_771115222453133_9179126566889182297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNWbk1i7oxwQ7kNvwGM-0YY&_nc_oc=AdpTeOAJw-hPhqqq2Td6a13vFZFHawSOFKdvYQSNXvg3vIuP_QImA7scxxAZPpInHJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7ckhjGW5D1im9mVYVOa6W7dU4eLaytt3X0qAa-0zPWg&oe=6AFC8953"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uehGUEqZdjwQ7kNvwGmOvyG&_nc_oc=AdpkdOQ3Qi2pFbbBr32rMP8SJLUww2wDYA0Pi6HHjiNQhFUpQCRRPJyNtl6uvRJ6sN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST2DSBs-a_OLJoeRPCew9Vvn4SeSSjs-0uVGsYJAmgVg&oe=6AFC7DA4"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRglE3_lKRIQ7kNvwGwXeQJ&_nc_oc=AdqHYfO5uNni-dg9JRzgUPKphUIe787gbjkfEzUQPHINmd8wt8EqagQVrLeXFnnlr2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_OMsCrTPJHCODg47fZTLYT5gWKcDqbQ_JjhoGyNuVSA&oe=6AFC959B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xJ6J8yx0zEQ7kNvwGQf9ah&_nc_oc=AdoienwdbGVnMcKfHvZD4wDgQkmKkBsM1qzClk0
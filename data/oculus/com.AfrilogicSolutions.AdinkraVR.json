06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDzkG0iN7PgQ7kNvwFeVGWz&_nc_oc=Ado3EtD8-3x7YChWMmFuq-Dm9W5y52MFnNy4WTrXBvaT9PGEt1kyXpdedkeb6mt8-6w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFviyaEWtwjIGUkTxMmxPkdGVfqwPLZZIR1xbbru2gcQw&oe=6A8EE493"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPK5mNYSBYsQ7kNvwG7uYmK&_nc_oc=Ado39QM0etMelW21pK-41kwjdOIxtCdFyISHtPhby6sJdLZDrxfHqm8RRK6dxFXMivM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3WQwjjCAv0xCe-Ndk0emMmUg-e82xWQQ2semN7mjsOA&oe=6A8ED8E4"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhoZRmg0qlYQ7kNvwFMwAjL&_nc_oc=AdptuxpLnNcTEFYAS2vnfKOg6_igN9YSM0AejpPfa0xA3lXcoWLeqRYJLmYbT1dAfQk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBkLJ5jjQBWucfRryx7wd4R9Io1-60HUPrNEF8q2k0Fg&oe=6A8EF0DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7w8vuzyORAQ7kNvwGPvJ1n&_nc_oc=AdqlbZnQs9K-y3YvB8Ger-O4mdODiDOpWyWPLa1QbkeK5aIjLfnTvtuafZ2g0h5mTss&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW89hTcj6ov2-vmTI_I26avBFf8S8iKGUaUMCGWRmO_w&oe=6A8EC69F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Adinkra VR", "platform": "ANDROID_6DOF", "context_category": {"
HhIqtayhw4Q7kNvwHucKmY&_nc_oc=AdldU4S3rVxssGB68wk4KgvD9c_uNVcWm40fbGKMGnF6SRfTcMQKNjmip9uxkRk2jKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoTkG19blZwRUyAqqOvj2otDlH2Vh0Ovhc0WKDPhcYug&oe=69AD7413"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR8RqekYRZsQ7kNvwHFe56x&_nc_oc=Adl1mvse_4PCQYcmHZgedTsgoQxhQ98wUSzmph3u6iCaT_Pwe5DokLbHHO1QB-WaVxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVe99E2oIoH9Hc0bvDw24bRez-NhUehuGbbOEPi6QQag&oe=69AD6864"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtK_ILhmtKMQ7kNvwExs-mo&_nc_oc=Adn2byLC_n52XVkH64tyO8m-E5fC2JhN28ZnYe72MvJfehOuWqE41Qv2KfhmhlvpgDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbNdg4O_cdYRNHVILoRrAH4UQ-bJNxtYK-pQ2esfUcEQ&oe=69AD805B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_KFsLq7uAkQ7kNvwHm6BsU&_nc_oc=Adlbq-UsH3NSCZrZUq2CX0MKhS4z5l0tYC4Ibkb_YDYO7rZrOqwS61Or7kjI6UUTrd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBjw15VpGNmPfclpGXM3Z2PjxlJc8Xqh6VDsBhAY52_A&oe=69AD561F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Adinkra VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
t=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSKg0VjhPRkQ7kNvwE1tLEb&_nc_oc=AdpS8MEyOUPMKDl1WH0KWA_1E5bzs4YuaJTtNTkv1V3G_pvTPcuGVLxuvGqoZoB4S-U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q9CQuFTN4Zdq_sL_fKLnBRlQP30UHpLFqKKbE58TH2Q&oe=6A11A613"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvb1Zm3ju_YQ7kNvwEM2oz7&_nc_oc=AdpnoqQEoHM02V_whAMnjD7_80_08IbRSsd8bVO0Aw7U_GWIdLM5M0C3kN2cUHtJxVg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46BjO7jK8FLE4E4CY6kWux_PToKv6p3H-r0ED64qD9gg&oe=6A119A64"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COe8KkYzsuQQ7kNvwEJ2_9s&_nc_oc=Adq8zDGz81pUnLK6aECg0icJenkVAGeHLZPR8x6_mFiT5oWZtECIsCS0nBl_KljtfIo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52ILcUNGIk4FLwm89OLGCiPQHhcH1xyg_7EzHkY7HRmA&oe=6A11B25B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6aUugmwQjIQ7kNvwHKyygA&_nc_oc=AdqdXzt126LSpNoVXmhspCENwmU-cuB88kSL2HDiMJ6Q0yrdgw4PxavWqD-EU7wi9tg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RpbKXnsLjFdgossOxfI1VdvbZrJvpKEeIZHBLSoFX6Q&oe=6A11C05F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Adinkra VR", "platform": "ANDROID_6DOF", "context_category"
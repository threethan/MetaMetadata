5U-y0Lle90Q7kNvwEuCbHw&_nc_oc=AdlcfFYUxVu7JcmWJpiaCKj68u6BL9nFRl2dILBPFBPdXszL6N8onIFRYedEvHIayHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfytyN5rDovgo5WOodoJvIktX3GPcO0HFlx1tW7VsnXZhw&oe=69B2BA13"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZIDjjcupzUQ7kNvwGR2l4I&_nc_oc=AdmcRUQ8xtiAL037jG3F7YtZo57qhPJB3r1py8_1aXzbfmhJ86PkjfZ-55a7Zwv0xZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxjBoRLt1U-QpTO7cFCDnTVf-EwJX0ymFYo_aAzv5-mkQ&oe=69B2AE64"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERAzrATM0bsQ7kNvwGXS6bG&_nc_oc=AdnQUAKrxgrAJT1cWFfMQdRmBssL8yeFJ-7WMzLNUaUcxaGiIYcJqn4JsjfDUATxc3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1HpGuQJhrhQShwCPNAbRZyehM3wq5on1z_l2LhWoAng&oe=69B2C65B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPmja-T_PJcQ7kNvwEYuWil&_nc_oc=AdksdLhC-sBgWEj8zQ6kFs4U_neVYCkKfRqtKKR6X0j-MRcdvTPR8wvQOJTQr1em5CM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzURzo1Sy5Ne_wDklc-RyVMXRas6usFn0Gtgr5ClFQbSQ&oe=69B29C1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Adinkra VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
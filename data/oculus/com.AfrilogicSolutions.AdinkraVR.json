in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9714168065274115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296890_1464516931364290_6497862316294382776_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xJ6J8yx0zEQ7kNvwHb8kbk&_nc_oc=AdrgBkbn4jGqX0LXpZoT0bFLdBQBGxYmp8SeKMs
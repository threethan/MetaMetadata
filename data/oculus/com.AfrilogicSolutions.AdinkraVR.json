Z3ocXhxDCox80&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyA02II7oKfxU1_bLcSXmTqnI_5B2yUYgPe5exCKhNIYw&oe=69AAD5FA"}, {"file_name": "5.png", "id": "1417101102686339", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820980_1417101106019672_9145086672293233764_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRINMbesBtUQ7kNvwEvJ3re&_nc_oc=AdmYCv-U3rzHKueXBmyZ0P_3jQsy4eZYjOJWXdDtDZMimxD_7FVOJ6bx93_Iq7VuPpI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzgcZq8uJJgURROVBcVoKA4wqOZhsgB3frPFWsMSTSnA&oe=69AAD7C9"}, {"file_name": "1.png", "id": "771115219119800", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303391_771115222453133_9179126566889182297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbTDjaPwQAQQ7kNvwEk6mjM&_nc_oc=AdkS3aWuVXe3_Nv8tuiASldMCNSoUCtMqVw-Z8JjErTRMZi0p-wJWKWFJjeYJ97gfBM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5p18duoEMo6ukA4gPRbAyT4ge74oN8RBlImPoMArHgA&oe=69AAD113"}, {"file_name": "2.png", "id": "1303813311292644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499295661_1303813314625977_3704079237026701088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3aYvN_M9ikQ7kNvwG8Clx0&_nc_oc=AdmoIJ4LPwU2tqnIZ1fYhJIHKaBv7FubBoxpSxwtrECVO8CRUuHAz4mausJvz0Rzglc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9RuriK6AcFdxmLsUtse_wHXj_hMCZ6jt_GiWCbbYSRw&oe=69AAC564"}, {"file_name": "3.png", "id": "794049446630245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499296890_794049449963578_2571227806717907479_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpLFAYy_Vy8Q7kNvwGd_CJh&_nc_oc=AdlfleaXeV5Jn2Qnxgq8wEkVdXC8tHJzQhGM8WlAkHJF_KJ0INN5SCoeg4N3N1ZuDIc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJhkHYvJJdhAWiXta6Gnb5ofRYgmLfYulbMirjBHccyA&oe=69AADD5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adinkra VR", "keywords": ["Adinkra", "Ghana", "Rythm", "Drums", "Culture"], "long_description": "Adinkra VR is a vibrant engaging game that brings Ghanaian culture to life through history, music, movement, and symbolism. Inspired by the spirit of traditional games and culture, you'll slash, drum, learn, and move to the beat of authentic African sounds \u2014 all while surrounded by powerful Adinkra symbols and rich cultural visuals. \n\nWhether you're slashing through patterns in rhythm mode or pounding virtual drums in drum mode, or touring heritage sites, Adinkra VR is designed to be both entertaining and educational. Learn the meanings behind Ghana's iconic Adinkra symbols, experience the power of traditional instruments, and lose yourself in music that blends history with a modern groove. Fun, energetic, and inspiring \u2014 this is cultural celebration through immersive play. ", "short_description": "Discover Ghanaian culture through history, rhythm, drumming and dancing in this fun, engaging and energetic VR experience! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://afrilogicsolutions.com/avr-privacy-policy/#elementor-toc__heading-anchor-10", "developer_terms_of_service_url": "https://afrilogicsolutions.com/avr-terms-of-service/#elementor-toc__heading-anchor-11", "publisher_name": "Afrilogic Solutions", "support_website_url": null, "website_url": "https://afrilogicsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
ages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "ko", "es_MX", "es", "pt_BR", "pt", "ru", "en_US", "en_AU", "en_CA", "en_GB", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376678882187679"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1859906585167931"}, {"status": "PUBLISHED", "id": "1118385757816212"}]}, "baseline_offer": {"id": "1859906585167931"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792725360, "status": "PUBLISHED", "id": "1859906585167931"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1475260435662856", "version": "1.11.20261109"}, "id": "1731564267923779", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1475260435662856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "- Select the version number under Settings \u2192 About to check for updates. On supported headsets, you can download and install them in Youmu.\n- Choose between Classic cinema and Quiet void. If you used Moonlit terrace, Youmu switches to Classic cinema after the update.\n- Improved decoding efficiency for original iPhone spatial videos.\n\nYoumu uses FFmpeg under LGPL 2.1 or later. To request the corresponding source for this version, email youmu.support@gmail.com.", "created_date": 1794270869, "id": "1475260435662856", "version": "1.11.20261109", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1475260435662856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "- YM_Link: pair with the YM_Link app on a Windows or Mac computer on the same Wi-Fi, then play videos from its shared folders or view its screen.\n- The YM_Link desktop app can be downloaded from within Youmu.\n- The menu pages have an all-new layout.\n- Added the Champagne Gold skin for trial and Premium users.\n- Optional hand controls (Beta) in Preferences.\n- General performance and stability improvements.", "created_date": 1793636527, "id": "1458768310645402", "version": "20261102.2343", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1475260435662856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Simplified statistics settings to one Allow statistics switch, enabled by default where no existing choice exists. Turn reporting off or back on directly, while existing opt-outs are preserved. Added system and app language reporting to improve localization and account support, with updated privacy disclosures. Also includes playback, playlist-cover, subtitle, settings and cinema-positioning improvements from the previous update.", "created_date": 1792918670, "id": "1436778009511099", "version": "20261025.1615", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1475260435662856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Improved playback stability and library browsing. Updated settings navigation and localized dialogs, improved subtitle encoding and same-name subtitle matching, increased cover-cache capacity, and fixed playlist cover refreshes during controller scrolling. Includes corrections to library positioning and cinema visibility.", "created_date": 1792856355, "id": "1435616379627262", "version": "20261024.2329", "version_code": 20, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1475260435662856"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Improved first-run local file setup. Youmu opens its Android all-files permission settings, returns to the app after access is enabled, and prepares the fixed YoumuVR movie and book folders automatically. The library opens only after the system permission and folder setup are ready. Canceling leaves a retry entry without repeatedly reopening settings. Returning from settings preserves the ordinary reading context and keeps playback paused. Existing storage associations and content remain compatible; private spaces lock before opening settings. Reauthorizing clears recovered file-access errors without hiding saved-data failures.", "created_date": 1792257965, "id": "1423033997552167", "version": "20261018.0009", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
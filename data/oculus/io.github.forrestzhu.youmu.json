_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR_Yp9P1kUgQ7kNvwHXb4nm&_nc_oc=AdpohUM0R0Oq_7mjGiTYlPprHpFsllF83ITx6mmmeO5MhfzzYYfnZ-hTAYnEsQUTz20&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTDpc0um0_3B1F8KrROsTJMepFiMHjwtk7lDKkVFF9uQ&oe=6AFB44BC"}, {"file_name": "03-bookshelf.png", "id": "2619461051830681", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499624577_2619461055164014_2084644494123516015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp_hGCWD530Q7kNvwHNSjnW&_nc_oc=Adp-WZZURYMOWcAXuIND2FzwUquq1hjiUPK8ujH1NvaguCbEOwFevKSGA8MxB4qYV58&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdlZaqTNzz4PB4n1QevnA8ISv6Hx7q8LXzrz8pbrUxuw&oe=6AFB298F"}, {"file_name": "04-image-folder.png", "id": "1437225695262371", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623558_1437225701929037_8448469870823518672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh1CG3YTC9wQ7kNvwHQ1Dx8&_nc_oc=AdowQJT5L6T8mGvNLY8pcho7vh54VqjgJqug2PcOg5JVa4bur7M6YzaWSxGgcz5vFyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLX4sdaoPm7mIMykya7GGIyMepB3sE-VWgusQLIIVV3g&oe=6AFB4965"}, {"file_name": "05-image-video-folder.png", "id": "1656721839412234", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/594002350_1656721846078900_721584526957719796_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm8WV3K8TVwQ7kNvwHgeLG9&_nc_oc=AdoLHlV4s8N35nDC6WrJh1MUpeR0sOFUlbuUWriFQsrxAz4C1b0riZ5wZAPjawAYn5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-5PfKweyZNzvH52RuWZK9-jzDq9zH3LbqB2fhUqwjaQ&oe=6AFB47A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Youmu VR Player", "keywords": ["video", "3D", "cinema", "ebook", "privacy"], "long_description": "Let your eyes wander.\n\nYoumu brings your own videos, books and image collections into a personal cinema and reading space.\n\n**Watch your way**\n- Play local 2D, stereoscopic, 180\u00b0 and 360\u00b0 videos.\n- Adjust screen size and distance, choose a viewing environment, and control subtitles, audio tracks and playback speed.\n- Organize videos with folders and albums, and resume from saved progress.\n\n**Read in your own space**\n- Open TXT, EPUB, PDF, Markdown, CHM and HTML documents.\n- Adjust text size, spacing, themes and reading layouts.\n- Browse image and video collections in single-page, double-page or scrolling views.\n- Choose repeat-one or sequential video playback, timed image switching and remembered playback speed.\n\n**Keep selected content private**\n\n\nCreate an encrypted, password-protected space for selected videos and books, with progress separate from your ordinary library.\n\nDesigned for Meta Quest 3 and 3S. Bring your own content and enjoy local playback offline. Format and resolution compatibility depend on your files and headset. DRM-protected media is not supported. Keep your private-space password safe: it cannot be reset to recover encrypted content.", "short_description": "Your own cinema and reading space on Meta Quest. Play local 2D, 3D, 180\u00b0 and 360\u00b0 videos, read books and documents, browse image and video collections, and keep selected content in an encrypted private space. Customize viewing and reading, then continue from where you left off."}, {"images": {"nodes": [{"file_name": "youmu-zh-CN-store-icon-512.png", "id": "2299844680858239", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624656_2299844684191572_3196188923285374034_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjgrOsYZkU8Q7kNvwEuPhm5&_nc_oc=AdprTdtFazhwnSOnW7EGePcgg9gHzusDfXmWvsC4Bc6tIWS6CLTy5GK6xhG70gffwOw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdg3vpeOiUr-Wtl74OWZX0HC3ZBu26PGsdRyfHMvnIIw&oe=6AFB27A9"}, {"file_name": "youmu-zh-CN-cover-square-1440.png", "id":
nc_sid=6e7a0a&_nc_ohc=iEdWlPmt-dIQ7kNvwHRoIaU&_nc_oc=AdrkiDGZjjbgwaxrCyCm7pN1a1iPTFTwsfBJ0k3m4-UD5eSLu9YGoH-xtrH8l0Kaagk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQYRwmN53XcHFLaXo1J4cuB7qdcgom5K7130OLEhL7-g&oe=6AE6118F"}, {"file_name": "04-image-folder.png", "id": "1437225695262371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623558_1437225701929037_8448469870823518672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F0Exl9jcI4Q7kNvwENJsUh&_nc_oc=AdpIcE1ZnMthEUM9X8imhvKg3erS2wtzpiGG5_LVSlkDTmnu0J5JhGJjKyFnyiuRCM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_agNnK1fybj9kH56u-uz47cG7XPSJZfjYBkq1lJV6LA&oe=6AE5F925"}, {"file_name": "05-image-video-folder.png", "id": "1656721839412234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/594002350_1656721846078900_721584526957719796_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwuwgrPgtpQQ7kNvwHZDd39&_nc_oc=AdouMPszMu6D_INYznriKdf7i9PnVghql4yRU53yiJk9mrgV_D45a2Zx_Y8wJsRHslE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC1HnhupAx9BsgVOaPSixo1g55k24J_eHvxMCGGV-gxQ&oe=6AE5F761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Youmu VR Player", "keywords": ["video", "3D", "cinema", "ebook", "privacy"], "long_description": "Let your eyes wander.\n\nYoumu brings your own videos, books and image collections into a personal cinema and reading space.\n\n**Watch your way**\n- Play local 2D, stereoscopic, 180\u00b0 and 360\u00b0 videos.\n- Adjust screen size and distance, choose a viewing environment, and control subtitles, audio tracks and playback speed.\n- Organize videos with folders and albums, and resume from saved progress.\n\n**Read in your own space**\n- Open TXT, EPUB, PDF, Markdown, CHM and HTML documents.\n- Adjust text size, spacing, themes and reading layouts.\n- Browse image and video collections in single-page, double-page or scrolling views.\n- Choose repeat-one or sequential video playback, timed image switching and remembered playback speed.\n\n**Keep selected content private**\n\n\nCreate an encrypted, password-protected space for selected videos and books, with progress separate from your ordinary library.\n\nDesigned for Meta Quest 3 and 3S. Bring your own content and enjoy local playback offline. Format and resolution compatibility depend on your files and headset. DRM-protected media is not supported. Keep your private-space password safe: it cannot be reset to recover encrypted content.", "short_description": "Your own cinema and reading space on Meta Quest. Play local 2D, 3D, 180\u00b0 and 360\u00b0 videos, read books and documents, browse image and video collections, and keep selected content in an encrypted private space. Customize viewing and reading, then continue from where you left off."}, {"images": {"nodes": [{"file_name": "youmu-zh-CN-store-icon-512.png", "id": "2299844680858239", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624656_2299844684191572_3196188923285374034_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGQ9tkqjJr0Q7kNvwFScxUd&_nc_oc=AdqpInjsTJ0QbhflHaoyhyCHAfhnMl7FqypB9tXz5Od5W8Vht5DSU9InTRfUBxcXFsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrLjMcZAO8MecwYYCsNO35a6i6Oyyx2p3yq0KdT0XKzQ&oe=6AE60FA9"}, {"file_name": "youmu-zh-CN-cover-square-1440.png", "id": "2097179584233826", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_2097179587567159_2389540801718323582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNP8WOanZY4Q7kNvwGe3V9Y&_nc_oc=AdrqHpYGM0sEf0sOkTtnQkcafvZ9Tgz8-VXBHeSFBfHNody_3mBD31evXddEZaZICZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlweE2cnGKb-gTO4ro98yD_N2LfJYEdRNFQbu6V86TYg&oe=6AE61594"}, {"file_name": "youmu-zh-CN-hero-3000x900.png", "id": "1602660827966014", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771
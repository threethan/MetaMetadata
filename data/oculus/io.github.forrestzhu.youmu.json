6\u5165\u4e13\u5c5e\u5f71\u9662\u4e0e\u9605\u8bfb\u7a7a\u95f4\u3002\n\n**\u6309\u81ea\u5df1\u7684\u65b9\u5f0f\u89c2\u5f71**\n- \u64ad\u653e\u672c\u5730 2D\u30013D \u7acb\u4f53\u3001180\u00b0 \u548c 360\u00b0 \u89c6\u9891\u3002\n- \u8c03\u6574\u5c4f\u5e55\u5c3a\u5bf8\u4e0e\u8ddd\u79bb\uff0c\u9009\u62e9\u89c2\u5f71\u73af\u5883\uff0c\u63a7\u5236\u5b57\u5e55\u3001\u97f3\u8f68\u548c\u64ad\u653e\u500d\u901f\u3002\n- \u901a\u8fc7\u6587\u4ef6\u5939\u548c\u4e13\u8f91\u6574\u7406\u89c6\u9891\uff0c\u4ece\u4fdd\u5b58\u7684\u8fdb\u5ea6\u7ee7\u7eed\u64ad\u653e\u3002\n\n**\u5728\u4e13\u5c5e\u7a7a\u95f4\u9605\u8bfb**\n- \u6253\u5f00 TXT\u3001EPUB\u3001PDF\u3001Markdown\u3001CHM \u548c HTML \u6587\u6863\u3002\n- \u8c03\u6574\u5b57\u53f7\u3001\u95f4\u8ddd\u3001\u4e3b\u9898\u548c\u9605\u8bfb\u5e03\u5c40\u3002\n- \u4ee5\u5355\u9875\u3001\u53cc\u9875\u6216\u6eda\u52a8\u89c6\u56fe\u6d4f\u89c8\u56fe\u7247\u548c\u89c6\u9891\u5408\u96c6\u3002\n- \u9009\u62e9\u89c6\u9891\u5355\u7247\u5faa\u73af\u6216\u987a\u5e8f\u64ad\u653e\uff0c\u8bbe\u7f6e\u56fe\u7247\u5b9a\u65f6\u5207\u6362\uff0c\u5e76\u8bb0\u4f4f\u64ad\u653e\u500d\u901f\u3002\n\n**\u5b88\u62a4\u79c1\u5bc6\u5185\u5bb9**\n\u4e3a\u9009\u5b9a\u7684\u89c6\u9891\u548c\u4e66\u7c4d\u521b\u5efa\u5bc6\u7801\u4fdd\u62a4\u7684\u52a0\u5bc6\u7a7a\u95f4\uff0c\u8fdb\u5ea6\u4e0e\u666e\u901a\u5a92\u4f53\u5e93\u72ec\u7acb\u4fdd\u5b58\u3002\n\n\u4e13\u4e3a Meta Quest 3 \u548c 3S \u8bbe\u8ba1\u3002\u81ea\u5907\u5185\u5bb9\uff0c\u672c\u5730\u64ad\u653e\u53ef\u79bb\u7ebf\u4f7f\u7528\u3002\u683c\u5f0f\u4e0e\u5206\u8fa8\u7387\u517c\u5bb9\u6027\u53d6\u51b3\u4e8e\u6587\u4ef6\u548c\u5934\u663e\uff0c\u4e0d\u652f\u6301 DRM \u4fdd\u62a4\u7684\u5a92\u4f53\u3002\u8bf7\u4fdd\u7ba1\u597d\u79c1\u5bc6\u7a7a\u95f4\u5bc6\u7801\uff1a\u5fd8\u8bb0\u5bc6\u7801\u540e\uff0c\u65e0\u6cd5\u901a\u8fc7\u91cd\u7f6e\u5bc6\u7801\u6062\u590d\u52a0\u5bc6\u5185\u5bb9\u3002", "short_description": "\u5728 Meta Quest \u4e2d\u62e5\u6709\u4e13\u5c5e\u5f71\u9662\u4e0e\u9605\u8bfb\u7a7a\u95f4\u3002\u64ad\u653e\u672c\u5730 2D\u30013D\u3001180\u00b0 \u548c 360\u00b0 \u89c6\u9891\uff0c\u9605\u8bfb\u4e66\u7c4d\u4e0e\u6587\u6863\uff0c\u6d4f\u89c8\u56fe\u7247\u548c\u89c6\u9891\u5408\u96c6\uff0c\u5e76\u5c06\u9009\u5b9a\u5185\u5bb9\u4fdd\u5b58\u5728\u52a0\u5bc6\u79c1\u5bc6\u7a7a\u95f4\u3002\u6309\u559c\u597d\u8c03\u6574\u89c2\u5f71\u548c\u9605\u8bfb\u8bbe\u7f6e\uff0c\u968f\u65f6\u4ece\u4e0a\u6b21\u8fdb\u5ea6\u7ee7\u7eed\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/youmu/index/privacy-en", "developer_terms_of_service_url": null, "publisher_name": "ForrestLab", "support_website_url": null, "website_url": "https://sites.google.com/view/youmu", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "ko", "es_MX", "es", "pt_BR", "pt", "ru", "en_US", "en_AU", "en_CA", "en_GB", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376678882187679"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1859906585167931"}, {"status": "PUBLISHED", "id": "1118385757816212"}]}, "baseline_offer": {"id": "1859906585167931"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792725360, "status": "PUBLISHED", "id": "1859906585167931"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1436778009511099", "version": "20261025.1615"}, "id": "1731564267923779", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436778009511099"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Simplified statistics settings to one Allow statistics switch, enabled by default where no existing choice exists. Turn reporting off or back on directly, while existing opt-outs are preserved. Added system and app language reporting to improve localization and account support, with updated privacy disclosures. Also includes playback, playlist-cover, subtitle, settings and cinema-positioning improvements from the previous update.", "created_date": 1792918670, "id": "1436778009511099", "version": "20261025.1615", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436778009511099"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Improved playback stability and library browsing. Updated settings navigation and localized dialogs, improved subtitle encoding and same-name subtitle matching, increased cover-cache capacity, and fixed playlist cover refreshes during controller scrolling. Includes corrections to library positioning and cinema visibility.", "created_date": 1792856355, "id": "1435616379627262", "version": "20261024.2329", "version_code": 20, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436778009511099"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Improved first-run local file setup. Youmu opens its Android all-files permission settings, returns to the app after access is enabled, and prepares the fixed YoumuVR movie and book folders automatically. The library opens only after the system permission and folder setup are ready. Canceling leaves a retry entry without repeatedly reopening settings. Returning from settings preserves the ordinary reading context and keeps playback paused. Existing storage associations and content remain compatible; private spaces lock before opening settings. Reauthorizing clears recovered file-access errors without hiding saved-data failures.", "created_date": 1792257965, "id": "1423033997552167", "version": "20261018.0009", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436778009511099"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1731564267923779"}]}, "change_log": "Youmu 20261017.1800: Premium preparation, folder access recovery, system picker task modes, and privacy disclosures. Private draft; real commerce and headset acceptance remain pending.", "created_date": 1792231744, "id": "1422386840950216", "version": "20261017.1800", "version_code": 18, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1376678865521014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436778009511099"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791866277, "id": "1414524708403096", "version": "20261013.1209", "version_code": 17, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
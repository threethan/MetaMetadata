&_nc_sid=6e7a0a&_nc_ohc=-DhLUDqYCQwQ7kNvwG3ZVPA&_nc_oc=Adozuws3UXl8ETrQzj5MH5jRHlL67W4jW-ZXysig65s53lUJxNYUH6g8V6t_W65KcUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvm0d6fjfEq0U7sU6cL-_mFxRKx0yY6qS1RbIIUTtPYw&oe=6AEA060F"}, {"file_name": "04-image-folder.png", "id": "1437225695262371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623558_1437225701929037_8448469870823518672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MzOIQ2Yd9YQ7kNvwGsB5Ay&_nc_oc=AdpOuaNO-fwY8r09Bm0iqtZar4vc4bnEqk22cDgNrZPTgWRLZqBNU2h2Kkj39dxNXLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHh6dC_sfSytK6vaW_KlHtBcXPO1K9n5D7yZqroPztYA&oe=6AE9EDA5"}, {"file_name": "05-image-video-folder.png", "id": "1656721839412234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/594002350_1656721846078900_721584526957719796_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBsURbD0oQsQ7kNvwEjr2jB&_nc_oc=Adpw-BrCwu24NjxiLUsVTqf8vFJWg-D2AM2JZzYIIyHZ04mbwzs4gPkPlkIS2C4wCiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF1T9hSN3aZSvBAHBcTW1OpktvFseAF4TnNzxcvMtTNg&oe=6AE9EBE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Youmu VR Player", "keywords": ["video", "3D", "cinema", "ebook", "privacy"], "long_description": "Let your eyes wander.\n\nYoumu brings your own videos, books and image collections into a personal cinema and reading space.\n\n**Watch your way**\n- Play local 2D, stereoscopic, 180\u00b0 and 360\u00b0 videos.\n- Adjust screen size and distance, choose a viewing environment, and control subtitles, audio tracks and playback speed.\n- Organize videos with folders and albums, and resume from saved progress.\n\n**Read in your own space**\n- Open TXT, EPUB, PDF, Markdown, CHM and HTML documents.\n- Adjust text size, spacing, themes and reading layouts.\n- Browse image and video collections in single-page, double-page or scrolling views.\n- Choose repeat-one or sequential video playback, timed image switching and remembered playback speed.\n\n**Keep selected content private**\n\n\nCreate an encrypted, password-protected space for selected videos and books, with progress separate from your ordinary library.\n\nDesigned for Meta Quest 3 and 3S. Bring your own content and enjoy local playback offline. Format and resolution compatibility depend on your files and headset. DRM-protected media is not supported. Keep your private-space password safe: it cannot be reset to recover encrypted content.", "short_description": "Your own cinema and reading space on Meta Quest. Play local 2D, 3D, 180\u00b0 and 360\u00b0 videos, read books and documents, browse image and video collections, and keep selected content in an encrypted private space. Customize viewing and reading, then continue from where you left off."}, {"images": {"nodes": [{"file_name": "youmu-zh-CN-store-icon-512.png", "id": "2299844680858239", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_2299844684191572_3196188923285374034_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzAugTcFBRsQ7kNvwHDf-DB&_nc_oc=AdrJIDwz5-tEEdgwy1Y-bImP3iXjBedHIGdfUP1sXJfM_IS7ffTaDEsAkzyvZihRtDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9EX-LfnBQ91H2AX88LFLb96ZJVjNcgEyVwspHxn8btg&oe=6AEA0429"}, {"file_name": "youmu-zh-CN-cover-square-1440.png", "id": "2097179584233826", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_2097179587567159_2389540801718323582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0dbIjVL4HsQ7kNvwEedj2T&_nc_oc=AdpI4mkVfnqPi5t5AWkZUyOhamNg75ANFyYsEEm19K0EpaxrgFuUPuH-hl3ne1hWagM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeRNeM3mpotF6jvkaSUI6udku0SLHyVUzRdeMzvGqauQ&oe=6AEA0A14"}, {"file_name": "youmu-zh-CN-hero-3000x900.png", "id": "1602660827966014", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.57
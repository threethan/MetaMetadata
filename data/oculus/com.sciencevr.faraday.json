c_ohc=ms6XJZ8uME0Q7kNvwGg788x&_nc_oc=Adp3o2kPqZGwbA75HmwdFXuisnV49ILyXMmHWH13LZ89tXl_lphyqgZF2_zt12s10GA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z9wXOqOewQDUblmy4WzOjijnRHW2OkU5maEPjwaoWGw&oe=69FB3247"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvnlSlSxjFcQ7kNvwFptLXD&_nc_oc=AdobHgrTzARGu3zbhsoLdXtglRBT1mb14m1pIX0B2YowdMC5wS6dEK2x8_VFnLzDt58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55bzlXK7xu7pBg1_nDMTht9rSkXU-1s3bBdieuZZPM5A&oe=69FB4DC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIauUea5dbcQ7kNvwFL4f5K&_nc_oc=AdqSb1Dy15M7vZplg7t0V-EtWAWlhsMKleKOeVDGNtTfOSZ-aQX0CMHhjB9ZOnfnztc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TPdEWquJe3SEx8ZKVvjafCufDIjP1HGFt2DEmMNbbsg&oe=69FB36BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwgnzEczT-4Q7kNvwGcCBJD&_nc_oc=AdpKsPicnXoYUB7QcYYEh5T5ssJxv-ISRGIwol_0COEJIe5OU-QZ3bpmHHsyahfbD-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20
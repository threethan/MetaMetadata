_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biF0Vx7yFAEQ7kNvwF53qu9&_nc_oc=AdkHFckEFkN3huQpG4pmdbBa43Xtu0_kvUIjz8sBhxwPLqTreETgPDOio8Kbb4Oj7rw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftGSjRZng1Fk_g81-YpF3bOZHz41t82tU4RfB0eAlfdSg&oe=69A97D59"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO6Hre9muf4Q7kNvwGIQsTx&_nc_oc=AdkimOomK85pTGBpbu6fCrUgImbLwA9QELfKUTbm7-cmjE_R7YPVgsufmEsDpS8A3Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulgYXCe46nFJU0Ba7vEBE7CZTf9Ru0iWtW3WreWOv3xw&oe=69A967E3"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYgp8a4vRUsQ7kNvwG1dE6l&_nc_oc=Adna6lPm3YFYOjaGJm7ocRdMQUpXhODuGgexQHYfLVjydh9DSE9_U68jeA2wi2EjJRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft3J6Rm1I4o4eC71A9zDoUA-0Pa63pp5gRWaRenRAWATA&oe=69A96B54"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bOV2qgMlfcQ7kNvwFsn5zY&_nc_oc=AdnS3CpT5yUTqkr5ZbxwKYffkQwlsgetdCWhNJ2kOVN3iKqrq7a3Fw5Vucexfuj3XnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvGYtHfYE6WtlhTQH5Cjx5Ch-VyhQsJvXGKsSbGh9dRiw&oe=69A984B1"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axUygXEE2HgQ7kNvwE1BXLD&_nc_oc=AdklURLNH56qSlr-LBZLAucLqScmIrVM5EIKiQ64HGkNuz-844PeZ35kJH9xUlkoqDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftYt39pA6zinGxurQIOGtJr7KL4Atd3ImSNHYr8qI3DkQ&oe=69A97547"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMANkmT95nkQ7kNvwHz0AQx&_nc_oc=AdnGo-vMuUEciLlDgp1XTcEFMqWlIfPONUvLnUJ2uJ2GgmDlZ8_-VdLAkgRHnnj1Gmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvxfxuiBT0s8tcSAr6tXkaFVgNFgcd5p9XluwsTaqkqpg&oe=69A990C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0fNcOZ9ax8Q7kNvwH2kwEW&_nc_oc=AdkYsu3C4ut6UUqpF_CxaXvQByiyE4KP_aqSEx9aPVj7Z-ze5hlFMB-ygeHQTrt-xe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLiWbfqish3ie01jM0GaMIMksHy6IVPhoshHWg71EGRg&oe=69A979BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biF0Vx7yFAEQ7kNvwF53qu9&_nc_oc=AdkHFckEFkN3huQpG4pmdbBa43Xtu0_kvUIjz8sBhxwPLqTreETgPDOio8Kbb4Oj7rw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-OPuoKdVOoN6_JcZk3NF3k2-am_pQXZt5HgiG-lC0PQ&o
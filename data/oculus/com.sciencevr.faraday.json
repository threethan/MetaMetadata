_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJVQP3lKx9EQ7kNvwHldeI7&_nc_oc=AdmdbkPGY-XIrKItf2d3GeMHg_ltD0WUh86iPkNZJkxdm0q0RbN3bBccpUu6-2-g8jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfMhE3fn2-Sk4u4GtBWdQ6QbNOdfph_I10Ixnp7NB7mA&oe=69B014D9"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWFy6nQ__6YQ7kNvwGK-wM6&_nc_oc=AdlOCWfbDWXb9dsJCyNTBxucU0mXj5ud-BEW3TlZ8rMLZiDDJzsoQYqsGVDFF_0oUu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUvpDnh7db57MMdDmpiD7FcFckaNxd3RjM_yY_pLiDrQ&oe=69AFFF63"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0sSo5NabCsQ7kNvwFpJl-d&_nc_oc=AdmCkQcpvi85zWOwnzhoJJ0wQTT1Z8TCRQMpmtTQolwVvroWAJIXPDNLCamlma-5h8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrqb5udA_xl6voB36tObZqnoTB0CvYKQvOF-oQhQsHSA&oe=69B002D4"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zcKpSxtj8Q7kNvwFSIfY-&_nc_oc=AdkIGTJDge4X0opQMHOV1f4nlGSfolupFqgGARG-wtK5gdropJt6oEgZt7otsPUh0rA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9QcYh3riojltG5DnNJEs2OI146e74B4eLcQYOIKoJIQ&oe=69B01C31"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izUiacVjK7wQ7kNvwHzxlOo&_nc_oc=AdkLX1a_tg787Tx_Z1iHxwy8nwyi0YKJ7JBdsNFC0tw6C-0JK4y-u7FXrzbi5MLKHJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjTYNmEB8WDfM86zLUTprfAvLV8dnCH0bNlYBaWmUOPQ&oe=69B00CC7"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiqvIgeNz0cQ7kNvwELhPpi&_nc_oc=AdmJ7b6eZhifQsmTe0-L82WmiSTbSrBlC8BeQcuNAl9yaZoX_rELH5_Ya273JsHljWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQV3loYNTOiRTW5nnMfgbsL8PXHS4txOK65qlcZ0G-Dg&oe=69B02845"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QVNioptVbQQ7kNvwHJTfNs&_nc_oc=Adl63XADNMDKLnHSbBZW-03hnc6Ugo2fgd6GT-qK4WfUWijKb9bLNu0lRS-cvTYVEEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdvF-mDJ2x0RhTwOF7DCqmtWDUzg1V0w6EO4qvftMJIg&oe=69B0113E"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJVQP3lKx9EQ7kNvwHldeI7&_nc_oc=AdmdbkPGY-XIrKItf2d3GeMHg_ltD0WUh86iPkNZJkxdm0q0RbN3bBccpUu6-2-g8jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWRkTKU65Ovxf5WDTp939GtqXO1qiEqn__yw8PxMB7qw&o
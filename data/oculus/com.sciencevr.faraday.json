_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwE4OB25&_nc_oc=AdleBYc0XHq9ZaWJXzLzJ-WWllS48E8OOnJz7GnGP-uhONPTmWJmj4cvTx7qNPb68Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKmjxD32QQrADYFVyB5UnVMha7vTOoBXtJ_pSeMyleFw&oe=69B16659"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWFy6nQ__6YQ7kNvwHIWVVc&_nc_oc=Adn8p3WJjwAy2iY2MTla7lGONIWjeqkEKLzMunlx7WMP2KavFctdbei4dQZhlwrVV7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfdIw7F7y8Z1XN0S-Fl3a2Eyxp8yowDDwvpFBzQr65DQ&oe=69B150E3"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoElaIRlidgQ7kNvwGm7ida&_nc_oc=Adl44jk07vqb1quNYT4PcSHixwWHyxwkNCO7OInnM9PO3MJ7rZIGZS6QBuxceknvTNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydUSkNBlp52QPTksHxO1Z_C6WK0EYPgGseIrlqSUXk0A&oe=69B15454"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zcKpSxtj8Q7kNvwF3T2Zc&_nc_oc=AdkPEAU2EOjzcIKb4otVT9KcseVANVoRn-6INzpiDOFiVxjVpHk8R8PYGfYZfGvzFsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1pI9rLjoUvyKdNuMXJiookj6XI2-p2rT2CIE1GfYMvw&oe=69B16DB1"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BAsH3or2AgQ7kNvwEx4rKZ&_nc_oc=AdnzdMIhv5h7ho66_49LCfv3g1m-n9TJoatgUhkvoRiOqgehnVa9K1bjyp0YtlvMPUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuLNKB_7IIWDPx8oWSHA3v3QPow96i6cWeYAhyFgrz1A&oe=69B15E47"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiqvIgeNz0cQ7kNvwFjJv_Y&_nc_oc=Adk4Siit7tfi9D59nUUgLy_1Jhg4YQtO95CriWdQjLnUOqUSExNt-6ieWqnaSJdS5cg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuT6ixvWsHzCZHmmw66Max7ZCyBUgPV7TWQiZmHkgPFA&oe=69B179C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT7T-R9JaIIQ7kNvwFdbeZp&_nc_oc=AdngtieWGnuM7xjW4eEMRk-nqm3O9zKuFqPQbAw3sTH65UecPsbAFAfGGCrTT5Mlsz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJNlG10OKfnl9hjyWDEwnM89Q_slFbjP19C84qK8YODA&oe=69B162BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwE4OB25&_nc_oc=AdleBYc0XHq9ZaWJXzLzJ-WWllS48E8OOnJz7GnGP-uhONPTmWJmj4cvTx7qNPb68Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwevgNIklpYGJRibqTCMISEtzlVZF_xYHv7JqTW7k2Cxw&o
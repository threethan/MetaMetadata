_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3BvBFYlYvgQ7kNvwG_KhGK&_nc_oc=Adk13k9U7hats2vsQtCaqPYTxpkMXvOQgMAydy0FnWHqEUlfTAhAOrUgkXpsU6cfRQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq9X5fkDsSrwjf4Jyfhcg29P0jIuOGeAQLd437rTwuoA&oe=69BFE6D9"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK3IWrGANk0Q7kNvwG8Azo5&_nc_oc=AdmjUZc4MtG5ACDW8pXBMqUmurIdc88FDLfljOUwQ17OBoXRebpA_90wspatIR3nhjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGu7vtwXoWZTcsxgw3ky6psnnwjoR_oZkw95ufdaOhhg&oe=69BFD163"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQwXjADtcx0Q7kNvwHpaWet&_nc_oc=AdlOTOS5CEV_3pnXmdL5OtWin_gGPNOvEtbYPNJwsxgPktnhWriv1NIojACkEsOmWhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcBz477QwOKbDM-9WgOWwnd_V8b7xIADUHHUxLpY_VBA&oe=69BFD4D4"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewFMIugBamEQ7kNvwGQMxZc&_nc_oc=Adl2yDTi9sY86y6cBz6F_AN0qLm3-XCS-SbS9_YneCtD3XJEqpJ64OAqtyzmqFBRt-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9Z-VfkTjjckX5mhoHhNX6ZdaB6_gLt_XbpaDcqEQmkA&oe=69BFEE31"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHfVorX0hysQ7kNvwGBOzZ7&_nc_oc=Adk80Z8JbP-qyvQrqOEwHVftJU8QqgByAuk-1HtqO38WTwcPhdeqMhdNgMVO-Y-c2Lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoAhwXr9Ds6TjmV9FKV0i4bQSyxI8pdUBzcBQgQrYYHw&oe=69BFDEC7"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjWeHwVYknUQ7kNvwG7yDP8&_nc_oc=AdkXWm2b6QjZ7n7irqGzJ61crDQQ0yg2nHgLG3XDIbVAmel3pOGpOsY1fwV4emR2Iy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFgJesDjySeBQAaAuikWJh_CE3UnOKyOAGTQMfEAwYtA&oe=69BFFA45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq3O_lv7LQkQ7kNvwEkImE6&_nc_oc=Adl13TrvbJ2ZWYFELq-JlrFDT_l54Caf4Zft1yfIpyVug4wjI8YwGg5ZlW3k4OSpCk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIhFpWL88-SZlqNTHwvU4UMNJwWv4y8Jnt5ociBHk1Qg&oe=69BFE33E"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3BvBFYlYvgQ7kNvwG_KhGK&_nc_oc=Adk13k9U7hats2vsQtCaqPYTxpkMXvOQgMAydy0FnWHqEUlfTAhAOrUgkXpsU6cfRQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyn1yDSp9LAWtEwP9jUpXMelbp1YAye3zHYpxmW2tNSrg&o
_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsghyKvq6p5aWCrZk1GfThZv7XCzRWiBZMdTxJzDUtsQ&oe=6A4F9247"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL3xjWmU4CQQ7kNvwF84PUG&_nc_oc=AdpsfzGqqh34dMEBnRK9djf5Wc1BgJCLmTQ4plEb0iqhQob2hAoOzf_wPynt_4c2-Xs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIDna6zKl2kOBZNHPWMoEvK8NZOKJLqus61WaCwaJrKA&oe=6A4FADC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk5ZHS1zOhgQ7kNvwFihBS8&_nc_oc=Adpq4_efarfGlbHXaSFsord5BGpGux0olfBPopIuBhygQAmV79tBFU5KUtSxzfj6llc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEdG2K7QDLNuoogv8mfnZe8jgsQaXHNlu5xu_aAt4iMQ&oe=6A4F96BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "582918916426577"}]}, "baseline_offer": {"id": "582918916426577"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626811740, "status": "PUBLISHED", "id": "582918916426577"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4336933279662538", "version": "0.54"}, "id": "118496280103265", "channel_name": "LIVE"}]},
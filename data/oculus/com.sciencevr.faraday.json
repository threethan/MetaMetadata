_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEsTBGCKhl8Q7kNvwHN41oh&_nc_oc=AdmHWJ6hSkNxt8a05KQodxg6oSVqFRdXcBrTvofPCxqJPkDsicPS9adB2SG_RSCX1P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUAnuZfz3p9utsl6wPSB4VY6n9bNYbTXRsrdSY_QHsPg&oe=69B6AC59"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8UYGGX77eYQ7kNvwFiZdwe&_nc_oc=Adli0hnzGZtsacWJBZ1OPK0NPob-eucAL0EfQjW-mZ54RF4qGNitk5SP_bTL54nNKa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPcyEb_WLqnyUt3PMjeazuoj4u-EPWHS6fTiiRlLsmsg&oe=69B696E3"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYA39qfX34cQ7kNvwF-MrGX&_nc_oc=AdlBalvwRIR53eoxxLFFsEGKoNkA2Xu65kUhF0nbHVtoA6phyTQ9XPn7Os-jqvKx37I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzdvE5XZd1KTFjMFXi4yZkcGCsss4FxzOgtkiOIWA-4g&oe=69B69A54"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLg2JfAoZxQQ7kNvwEeefkV&_nc_oc=AdlznulEKUk28J-i0yYKVjlN9p4tHhCOp03XuWxTtXo0EWK6T9ce1mirg3BHdAkMePc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRf7Hy_A8LNpYstAb_b8GvZJZm_ul-6D5EbsMDdL6Rxg&oe=69B6B3B1"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOMiGMjV4xsQ7kNvwEiRtNY&_nc_oc=AdluyLNQ7DngmwMvnRqYJYJPSGqPrU_lv8STxMyCyClOCaL3mrb-VOrf0rvLsevSFEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyot4p80PeSYlxLx9VGoXEA4eFfUNwgps88Pzm4d5eX7w&oe=69B6A447"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf52vG37UiAQ7kNvwHQrPk_&_nc_oc=AdmRZyt0NSHNlX7bzF7mLDT20rqCvcSduQn1Mv32lgVf08hfqkC72Gpe9ImQVGZLiF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKtH2bo8VrXX8oAzoBbSX_wU7CKAISYibBSkYv_VxEVg&oe=69B6BFC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98VYXi8TZiIQ7kNvwGnfVUS&_nc_oc=Adlxn8aAxYKYGr-CtErGEsINYz_3yxdPP5xMABHdE6bY-WfqBDk5QtQaO3q-jlcNp6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxORCDqANfhSxq7MYu3FF2YciYle2CVf0x8pYxsVvQ8A&oe=69B6A8BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEsTBGCKhl8Q7kNvwHN41oh&_nc_oc=AdmHWJ6hSkNxt8a05KQodxg6oSVqFRdXcBrTvofPCxqJPkDsicPS9adB2SG_RSCX1P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwejUtXO6JKBX0PhkbUE8k_3Ecz9OUvG0AiETVrUnkhig&o
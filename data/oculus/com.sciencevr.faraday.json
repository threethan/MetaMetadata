_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN5gPzdEyj8Q7kNvwFdhNaK&_nc_oc=AdkC6Qekq7MPQilyB1D9mO-Nj4vJogEnERQUEAljb_pXH6ahGpgzIzkOvCRRlMxED6U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkTetSkD7GYebipaenRGBTUHwZGSBOM5ag_Fdr4-J2Eg&oe=69BAA0D9"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXvg0-v1CsoQ7kNvwEtT87D&_nc_oc=AdnHPL-SjnodplEA2Nbf--qep-7y02cxQYzNL29PS37c3SIu30w0Hk3B4W79M719yOI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6-kkJ9IlLBqsbf_k4Ud10_cgbs1KfuSFlvQ_h3FqvGg&oe=69BA8B63"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_b7yYcJ1UQQ7kNvwEgIjZ-&_nc_oc=AdmOnYZmylCTZfcP23XxCNnmcp6P8C0bm1pa9XPh1zSMfir4jOvpMbMio7lRpg4aJRM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_rHK6DcTN5WPa9StSvdttAEhCrvUaMf6poL2Rko0nbA&oe=69BA8ED4"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoBvKL7QEHwQ7kNvwGmMrc8&_nc_oc=AdmH7VYDdd8iANCV4dophC2nU8yzlYrob3coM1r4pp6w96FCl2aNQu6tVwgGarC8QsI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-qJo8ZkAY_XD8gxdc5CRQgIUfvDpG3j84otmL76MYaQ&oe=69BAA831"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdHQVJblOd4Q7kNvwEJi6n6&_nc_oc=AdkXo03Nf84gOdH3WUoMQBHi8WHsLiTYurSPiQ-rq7sE5IY3DTcgBlcg5g0k65NRGmU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrsXu_u2xx1HPLIe7xSJ3ssVSIHvw8zAvytXGKv6X1cA&oe=69BA98C7"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjyZtt8zUkAQ7kNvwFBg7Mv&_nc_oc=AdnvPL5O0vS1ZDFVkX9XgsVKHotqZzpguJWCavqW60WGnUXoZYV_WVrQkhNYHV1zAqA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvPsiW_-CHHSUQzXcVrItgSD5Zr0Q14n2jyuHiHQWcdQ&oe=69BAB445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnkJCRrz_6oQ7kNvwHykU8y&_nc_oc=Adk1qQNts4S4glCTOUusJpZmJi1mtxGacZOO7uAhQiOVpTYME4sKoZwmyUTcY_puii8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwogZm7jNDfaKp2quG10-3wyBIoUfRtL3veC5_uyzJCmg&oe=69BA9D3E"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN5gPzdEyj8Q7kNvwFdhNaK&_nc_oc=AdkC6Qekq7MPQilyB1D9mO-Nj4vJogEnERQUEAljb_pXH6ahGpgzIzkOvCRRlMxED6U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxl8Ilvos3Wjt_dSr6RPUOZPqXsvEliWfFbVprxNlpHbg&o
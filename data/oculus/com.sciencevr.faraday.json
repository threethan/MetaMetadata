_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwHhI-Er&_nc_oc=AdmRD1qra2SbYmENXL4s9CdgQ-ZWD-t9h-l_JN1nwDJCEe5zAySQzLK9BfZ7mrQf-sM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykSrG1BmJzd9uQW4or8XjF0E6gx8HnTZiOaKRqSlMv1A&oe=69B40959"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8UYGGX77eYQ7kNvwE2LoGX&_nc_oc=Adm75XUP6uaWS6ks6y7Ba0ZozGp9DoiOvjARPLchc9xyrcqIl8goGmAPVCsmJhkNWCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afycvpc9DRKaanc27nEi16IQ9NrSOC7uc5HtXgIPfnAINQ&oe=69B3F3E3"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoElaIRlidgQ7kNvwFml957&_nc_oc=Adl-mSboaI8WLF8_tZ7AD29nqZopYPspaOccyK4-ooNQwggaJ6CUd_wsK2PzAlgZTJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXeWVpvye3fahFyOg5d-CmvF8F-5VFbsOmXw3LjyToLg&oe=69B3F754"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLg2JfAoZxQQ7kNvwGT3Si_&_nc_oc=Adl309YzFduVG_BltGUMRAUmwSHTH-YxLlCOLVncMpAWjYYSeRdAXph_wWj7krl_mnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOdI4CXUyDwru_f7HaXOLyjRfpeciKy8v8SIqBbQtXuA&oe=69B410B1"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BAsH3or2AgQ7kNvwFn7GZI&_nc_oc=Adn349VcTnNWt5SnALlnnMW-C0jQgEwIcTC3gwo1lLl7ztr5VL2i84tBm1Xf2BPP9K4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUojQEeZzIL5NWuNzKM4Yew6bs_8Ugtxc5Ajt6T6X6lg&oe=69B40147"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf52vG37UiAQ7kNvwF2h4P-&_nc_oc=AdlSSmft0fiwNgXmDOMcO8Fd8phTELc8-pZH4vUrXS-Sx6SZCoZ-0xG7lH2h_I0u97I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQGEs-cxK_0PaXwqDLw496RDEjs44st9YCkGOp9NBZow&oe=69B41CC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT7T-R9JaIIQ7kNvwFO13B5&_nc_oc=Adl9AIDZZPprqvAUcJ7IGDYZ6XyupBT5C_lorBluBvHkaTrNt5Y0K2vZCdJxL9DD7a0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUYQasPQt5w7CNQzuIQQ-3Y-jptS8AGTX_mxIk92ON9g&oe=69B405BE"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwHhI-Er&_nc_oc=AdmRD1qra2SbYmENXL4s9CdgQ-ZWD-t9h-l_JN1nwDJCEe5zAySQzLK9BfZ7mrQf-sM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwDpRRacoVsm-bZrNsiqR-_2Chf9b3FyeU7Yxw07jPgA&o
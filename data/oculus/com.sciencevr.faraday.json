_446960976387405_5110910147312353727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwFyJBG0&_nc_oc=Adlzgv8wLFzsSDunZqSJQpSWViSU5mOgI_JJuyHGMeKR9mdjiGJXH-IvkqzyTE5R5oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhRIOC_sslvmiZkl_1VaJ0K3eNU1gVxlZJlnAz3Wa2PQ&oe=69B2B7D9"}]}, "id": "747569175866724", "locale": "en_US", "screenshots": [{"file_name": "faradayapplab2560x1440snapshot3.png", "id": "272907427740282", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_272907441073614_7487632905304205359_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWFy6nQ__6YQ7kNvwHNk_-x&_nc_oc=AdkX6o1BdCvNWUNGH3IcDYcQ0SmwA5f084w81BX7xnBlzOm3zAzgXZmy4HYEmtFuz0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEerhmawjQb6g-OItNjSj9hAK-IlITPij3xFouZQZwOA&oe=69B2A263"}, {"file_name": "faradayapplab2560x1440snapshot4.png", "id": "189730679379196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_189730682712529_8181609348320045421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoElaIRlidgQ7kNvwGU6eno&_nc_oc=AdlQpydx9T5cgVHI-senL6zpeT50ruvJYGZ-5BaCQZkZ5CD23ILUfcWBXE2D02DtVvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6_I_YQjkHYvtkYfV6lIBhfJ4LyzCBGlVVlxfd972bXQ&oe=69B2A5D4"}, {"file_name": "faradayapplab2560x1440snapshot2.png", "id": "250942360094643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003239_250942363427976_3357060737561076766_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zcKpSxtj8Q7kNvwFJy4cq&_nc_oc=Adk6zEEcST8GMHWUSw7dFyEK4JSvh6AxJaxtTjsSSD1OFqjHqol6H3mjSOvrOx1U2EY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTkHBU_efZpFI4-g-iUB9skQ6EBBYCpIvH58BL2P7VrQ&oe=69B2BF31"}, {"file_name": "faradayapplab2560x1440snapshot1.png", "id": "4124930440852609", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974730_4124930444185942_2790320888215996273_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BAsH3or2AgQ7kNvwGT1BQ-&_nc_oc=AdmpmeGNI-mM5ot0YChZH7TDkssCh3WC6XIXq9CqBBoLvFw84HliCCsphU1rv_jLJKI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7YOnx3oAXIwwQoaX_FmdLN3bjqHu3zTt2sWT1wFKBfw&oe=69B2AFC7"}, {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "490993235592282", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_490993238925615_3708183660853387160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiqvIgeNz0cQ7kNvwEQ8edg&_nc_oc=AdkJe50_qSW_fyZIzSvJSi6nlRDku075oKkg0h5OAlcGqfWuf4-YZfLYPXwVI3_79UY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7o9X3jddlAuKoyO8WM11IBAQ5n7E19yCyUiUjN7JELA&oe=69B2CB45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "faradayapplab2560x1440snapshot5.png", "id": "1157246694735347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_1157246698068680_1665849032313953046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT7T-R9JaIIQ7kNvwG7qEVd&_nc_oc=AdmsIxi80WHXQdffuBVECE7WAbLQOQaEMPXSF1mUMQAF9Pqln0hjAy2YavVJkWzuNoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyxfWUdlWR5IkZiLkGvQQ04Ok4wRdVBb9xeK7C3nG53Q&oe=69B2B43E"}, "display_name": "Faraday's Magnets", "keywords": [], "long_description": "This is a paid preview version to fund our further development. Please support us to visualize human knowledge in Virtual Reality. Thank you so much!\n\n--\n\nTransport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before.\n\nPut on the \"Dyson Hat\" to see the invisible forces - the math structure superimposed onto the reality. We were inspired by Prof. Freeman Dyson's essays to design this hat for visualizing the two-layer structure of the world - the reality that satisfied math equations and the reality that we can touch.\n\nPick up two bar magnets and feel the magnetic field. Use a bar magnet to generate current from the helix coils. Do you know why the direction of current changes?", "short_description": "Transport yourself back in time to 1855 into the lecture hall of Michael Faraday, the experimental physicist who made vital discoveries around the understanding of electromagnetism. Joined by Scottish mathematical physicist James Clerk Maxwell, you will be able to visualize and interact with the magnetic forces in action like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": null, "website_url": "https://sciencevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450757836740717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974789_446960976387405_5110910147312353727_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEpH3R46lkwQ7kNvwFyJBG0&_nc_oc=Adlzgv8wLFzsSDunZqSJQpSWViSU5mOgI_JJuyHGMeKR9mdjiGJXH-IvkqzyTE5R5oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfuQoHsIzXA6jB_xh_jKbyiXzYJD7izz-UPrO7pWIU3Q&o
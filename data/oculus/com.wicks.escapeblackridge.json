3B62"}, {"file_name": "screenshot_5_maint_2560x1440.png", "id": "1128396713326443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771268_1128396716659776_3607806349631704680_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0XVGW2jCcUQ7kNvwF4EeMT&_nc_oc=AdrOHdotN8Er1ZQxhrdyd2Wrc8-bTz50zrnxyLFI7esoOQOZ-Sgw0H2uy6uFJu9cQfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGs6sD79P7jD89TWRJL-qmxOJU8oYsVlK3Oc2_9QUJbA&oe=6B105B32"}, {"file_name": "screenshot_4_hole_2560x1440.png", "id": "2287904331754240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771253_2287904338420906_8835241122171599626_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMhjgnRpeZwQ7kNvwHOXSaT&_nc_oc=AdoFhLSG1aHx9s6bxJab67qBQiOtB-7GxR7WYCRnWeW9L2wQFxVrhxLTSbwLNO_3lZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXddfEwMUZ_zEnJVB46Xwx9nEG2xYCtHCK5O45_AP9dOw&oe=6B105502"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape Blackridge", "keywords": [], "long_description": "You've just arrived at Blackridge Prison. The walls are thick, the guards are watching, and nobody is coming to get you out. So you'll do it yourself.\n\n**PUNCH YOUR WAY OUT**\nMake a fist and swing. Every block in your cell wall has its own strength, from crumbling plaster to steel-reinforced concrete. Real punches count, weak taps don't. Deeper in, you'll find coins, rare gems, contraband, old keys and secret notes.\n\n**GET STRONGER**\nSpend what you dig up at the commissary terminal on harder hits, faster punches and better hands. Across the corridor, Sal \"Pockets\" Pacheco runs the black market: chisels, hammers, a drill, a lockpick set, a torch, even a guard's uniform. Take what you want off his crate. Just make sure you can pay.\n\n**DON'T GET CAUGHT**\nThe prison runs on a clock: wake-up, breakfast, work, cell inspection, lights out. Guards see, hear and remember. Make too much noise and they'll come looking. Hide the hole behind your poster, stash your tools, crouch, and keep quiet. Push your luck and the whole block goes into lockdown.\n\n**CHOOSE YOUR ESCAPE**\nTunnel down into the old maintenance level and out to the forest. Crawl through the ventilation ducts past the break room. Or put on a uniform, swipe a keycard, crack the gate code and walk out the front door.\n\n**FEATURES**\n- Physical, punch-everything gameplay built for VR\n- A full prison day with guards that see, hear and remember\n- Upgrades, black-market tools and hidden loot\n- Several different ways to escape, each ", "short_description": "You're locked in a cell at Blackridge Prison with nothing but your fists. Punch the wall apart block by block, buy stronger fists and black-market tools, hide your tunnel from the guards, and find your way out."}]}, "developer_name": "Matty", "developer_privacy_policy_url": "https://escapeblackridge.site/privacy", "developer_terms_of_service_url": null, "publisher_name": "Matty", "support_website_url": null, "website_url": "https://escapeblackridge.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1443862998812354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908
32438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlzcBDRjJfAQ7kNvwGzflMx&_nc_oc=AdqfZPwrYa2ssiSaQjmd5jS8F8lK3HY03e-or4RCcnCfPccU2NZvnOIcyx3sZ_vgLb8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJecEyO94sl1BzIHNHIiYfZ-WxN-3pDAopjKZqCg01SPg&oe=6AAE8FF0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "https://cura.tours/support/", "website_url": "https://www.coopinnovations.co.uk/curatours", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9682200631849363"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57572941_4514988158519614_513828567661581694_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvIlB7D8KSwQ7kNvwHNUWLX&_nc_oc=Ado4jRoad8nFYRzmNaFR98sZEUQN-ptni4dADFvWot4C4AcLBKobF05oLg57IdF6YMA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2LWWTVBQYpiifWob-jc-tUs7nnEx3zCDoUbHcx8dcKA&oe=6AAE93F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Curatours", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1636362000, "lastRevision": {"nodes": [{"id": "47563
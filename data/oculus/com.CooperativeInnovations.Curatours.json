&_nc_ohc=5VdDdu_e3ycQ7kNvwFc1Hmv&_nc_oc=Adraf8ITkQ4sPEAzhqG7jFpGcm1IKdE4RqxqlSH39V8s_2IJ_WhVsF37WPZ4pHKJsr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTQA_UeTE2bSt8mUhmLmL17uClH2JyvsOf7preUbYv3Q&oe=6ABE85DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrXooVAGz_IQ7kNvwFQ_vmy&_nc_oc=Adoo7Mn9qjOUtVflo3yfQFXV9x5Qv1sa2ZKqUgKluLMvnJexZmNVnD2vTVQppyefQTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDAU7XyA8v8anNM3qbZYPrSrmmQ068T9ZuEPtNfKJFmg&oe=6ABE6651"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiEQulUf24gQ7kNvwGIMC9v&_nc_oc=Ado8NZThtew1jo4D3OvF_rjbE27RH52i-a4s3nHRE6gulZqmZvRmJ4PyC0AqeYhh31g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHdAG7Vha6KZros6lWKPXBd92J_Wt7zPa0OuJNpJLGjA&oe=6ABE7564"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meplbJ_9lvkQ7kNvwGB7_25&_nc_oc=Adpnswzc4ZTy2ijpdQThiEds2p0plhFM1aGUglLYuv09vA_LhrtWL5HIl_O9B_iXZcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfMGBzTnM58OUb8YnP3YLRnmaL9fRy6fkwU3ROyWzGvg&oe=6ABE65EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2EQbxkqMuMQ7kNvwHK1qGJ&_nc_oc=Adr9i7yKwQnNhb7YwvSWOllseS05YwGJvcUY6sub68ozBVUfRzB6hl48fEfvnoe8l5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6mTkNx4e2Aj8FrYhoLsoYU93845eaiUbQ6IJGirnK7Q&oe=6ABE64E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9czyhQl7nbUQ7kNvwG5OVmp&_nc_oc=Adn693FjECz1HPhJtxNrVa-FV7MS3ZnRY10QOzLx8jOw8TnRfwYhZfaChQsayUoDNbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuvNUW_gMut_l-UBB3gFDRRtn2sczj5qNR_0jT6p4IZw&oe=69A6ECEE"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPizwUBfPO8Q7kNvwFZytlx&_nc_oc=AdlN04DB5skHCjiABiH1IDoL5A1lwJfWH5U0HxKesJKM7E2eVKDvWlK2AXPFj4YU9iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXbBn7CIb8tNVhOSxX3JEjfMfTfnqHUDq8DYbmQO_u_A&oe=69A6D06E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPkfinr3noMQ7kNvwFVsl1h&_nc_oc=AdlQeGwQovqfsBKuSO7Px1Ii0x4sy9tbt-D4UF1bBLPuBk1g_D_h7aJEOX2J9GUM4j0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5Hd3q4ExSEyo8PfYIxcw6X_gZHA--ApVP9Q650-UHAQ&oe=69A6BBE2"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGvCEoL9QiAQ7kNvwHb6bXw&_nc_oc=AdknBGh62AXnok1x_lG-0r-BApF2jws05e5maq8Ui9o5Xd7Icka9idKjhJYgh0gk4wM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvicoA5RYPtUunbGSXEISr5M3mLXyDH15VuaM8ygTse2Q&oe=69A6D4E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUyVfyU5KjIQ7kNvwFUpxrS&_nc_oc=Adkgp_F5egChSz_CcMaaei1LK55iQQyO1qyvnQMxXgrh5t4Sa-lclwjmtvEJcZsBsOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQZdsYQWvMQhou7HgpD7wjDhyef9kL7HJdWb-S8TKkrQ&oe=69A6E3F0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
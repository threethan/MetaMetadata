c_ss=7f20f&oh=00_Af0vbOp6Ft5bF2YCpKV_oHbnho869fDR5_sU7LV66JOifA&oe=69F1F51B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07lQt_RZSjoQ7kNvwGoP6CA&_nc_oc=AdrPYGNIZMTKuFqaoRrYiW8RsQfX_-LLh9NnVy5GH66p6O-lTPaHqIXZ6fSdydy3z-U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2ft1r7yCxiWyFJJL5MQe1sFUanPvI6JXqFy-23L69zfg&oe=69F20DD1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kekP9BXYWg4Q7kNvwFEdU8Y&_nc_oc=AdqxUEhgpBURo_a9_PMmbmQIalUYam-T4tjrcWgkiENr_yWm4pICSEVOhJJ6lZnNQsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0ub-q7HuOyqoxvvKZQ875wWSLi9tFM1bCEg7PMwNGjSQ&oe=69F1E4A4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBD--ZwRK30Q7kNvwEQge5Q&_nc_oc=AdpWsPeC5hUvhXUCRkDXtuROb217CdSutgMNxznYrZFvfTlh2B30a2IFf-Q0eKOz_Kg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CYHh__shh2RqC2imzH_EYAy5Ofb5nN2zemawybAtffA&oe=69F20D6F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxtU3-6giaEQ7kNvwGJerz8&_nc_oc=AdroesV7qj55EAZ-VmpVfSfh7zrBuHSl20Lcz6DlKLab32nwM709DD9aHOh47BKJ150&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2i0MF2Bjmyp9KZYtGcmnCanKA2_FdOGhwQzKXegLborA&oe=69F20C62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDDcxq-BSJAQ7kNvwGdgKsH&_nc_oc=AdrmTsHGFg5M4swP4utG75FJ-6JdBqwg5TEZnojKRjiAqzIryynaC2rbWoiWBRvh9xM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2SQHtrpkwGnDwVLFPW4FsckP2Zxt-YBu_EtriPI9_Yhg&oe=69F1E826"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_gr
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UAHcRUv1pMQ7kNvwFYPE8t&_nc_oc=Adl4XkFu_YfW35r2X4-L0xj28EdbEfLELOuDqqDnyRZTRTba7NIIlx1SzQmCB1C7gtQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfslsoGpg6Bjxr3B1rJef9puPCSC8tvOZUusXCZZUfGOnQ&oe=69A1A6EE"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzqxed_VUA8Q7kNvwE8j5T8&_nc_oc=AdlVEdj02hebX2c9cNLR4fqkkY1vKTqkjPyts5kQdVFOhh6jVvFxa8sCrvCybx2PFQI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvxVWqxmCrDWYn3IkH0k6jsJ_-CnVV2WK7obN0RFDpHfA&oe=69A18A6E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGIMwwuyJHYQ7kNvwHS1W5J&_nc_oc=AdlI0hoZ7DYluy-yJFM6jW487qy6vo4T6XwBvowTCpAndo0XiDTMs2c8a5JolalTkDU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftVTRbjbcLDRyoXNXereWiTLUdh2DheB0oz1P-AOu7ycg&oe=69A175E2"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wzMoTQGaqMQ7kNvwHPz4XB&_nc_oc=AdlkGnX5eZfifs7HYU9xR1TdHEbzZISHVDDwd7-yZsVyCDntg79Y4bXIF6NCWhjgKl8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuMoEaE4ULJRwCqdtUeLEIpubQ_alPK1WStZ9ucpSRBsQ&oe=69A18EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQMCoS3xWR0Q7kNvwFhPepH&_nc_oc=AdkwkFteWCKY8PMJzPQx0Y0CDWYLlqqPP1tNuujTEF-YH-VUhXWt1I0v0KIEEzMA3i4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuBQaN3wKe-MiCFxl90rldrFlOamo4Nc4aC5WDic8ocHw&oe=69A19DF0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
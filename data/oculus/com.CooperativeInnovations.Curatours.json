-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4iMSi3afZ0Q7kNvwHk4eHc&_nc_oc=Adm7xw5G3ZfN_-A77Wm7F7uwYHEkZxWnci-VbHlQeHmTlJSatp0fo3N7Q4HRUnWxGRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftsMM2GAWKLZf_BvhON4fDHaBFGkhnB3CLP8Rtqp77vtw&oe=699C5C51"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5RNo3kX-kAQ7kNvwF5AbuW&_nc_oc=AdkNLYre4I6Mmq1jvvNzrRZcmIqjL9SNsUVLQfAObXOeOfB3jpKeuMu1tNlnFcjbmsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuyC6EHxlGB-fcF5x6hSO48XJipkiViuhl39oPX1FDdRg&oe=699C3324"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z422exotaKYQ7kNvwGEk92d&_nc_oc=AdmMvVKnIQF0tcw3fzfwbWpK2RUQXzcwUaT0iDK2l_x6YiO0bLzSqmOtUB5KZMj8ZnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu8XaTYM6Dga9QUjnwRc8Jz-w55lMLDVSr_L0G1yv3ZTg&oe=699C5BEF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl2cBKhalI0Q7kNvwHIhb-I&_nc_oc=AdlUCrSJsQIZ6-QzINj2_W7_7QK9YPeSzx_p0y5k6XW_jmR7427S9JxUfbepkYH6wR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_6KHTnTMvatpms3D1PcCGZPa6SeBMD9ZmZ2yFMjzliw&oe=699C5AE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oerMGhgOZcQ7kNvwGCUW4q&_nc_oc=AdlrPoGEPOkAQRosLorxfDbTxMQq2-KEe1KTAYUEvRItZ0VWAU-NSrFOUsnJygZSJqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv0E0ofqdikLNtL5d4QlhkfedA2Hnfw6OI_fuuUWUcSiw&oe=699C36A6"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
&_nc_ohc=4drz4-oGTTcQ7kNvwHnLii_&_nc_oc=AdqE0p1M-Segl79IXBbxOSKQD7-pWGiHUfCVTEBClmydwnu5_61Conxrf792uJ4d_aM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyplKrdox3NA2K2GVjJFzgZbs5X8PL9uMU9uzfmq8KPw&oe=6ACFA95B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoiNwrxmWvsQ7kNvwE11DZe&_nc_oc=AdrbQGei_H0v1DfBOfEl4TmwqMKb58xYvF-4db4ZSx04azkrB6P83I8IGUl0zOvlj3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfj_k5pzGaxJKcGJoTX6Q57MF0tlpb5z9jQ5tzTCJJiA&oe=6ACF89D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7pCVXLRyU0Q7kNvwFSl3qs&_nc_oc=AdrvP5-z76sFzzAs-mMTh8YTbjKT3WJsA6M2stGDrFKwbX2UqGRMptZVRVh6m1jQgHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpzYCYH_zoj6NQcruLLIOnUznbq4R7CEVAq2Tocc7DyQ&oe=6ACF98E4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fQSt-pZsPAQ7kNvwEQQnud&_nc_oc=AdpcXGTgG9mYV-05fEmCw_UYT0-0M6KVJqoLuumCqDmTvMpjSn4ZvOXMUCqv5M-lOss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWRQkrbm6YbcX7mfLEBD1ohszN3x5YEC2L2jFoIJn_-A&oe=6ACF896F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGciwNlKuNAQ7kNvwGAcWI3&_nc_oc=AdqvihNjhRrGg85xoaaC5IIMumAYk7zDnufliwOwg8JSmbih4E_DVJ-ryuG9ecgegQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7esJuoIirg5ZRsINMpqPFEFWO7DqklmWPJOcL11l7xA&oe=6ACF8862"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og_e8TxIxUEQ7kNvwFM_Xzd&_nc_oc=Adlzb-87O9xGG8RysfHvepbCDaFMaFiBYw_LByz-6evyhJgNdFwCPCANt3BGrgcjjYU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvexMxs9x5Vd0QpcHwg7QRxlWQOOovunxupS30lGuDK5w&oe=69A1A251"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzALR0DlUZoQ7kNvwG5RxOl&_nc_oc=AdnJkKOGUijPItvsRE1BcroEeeqp8LFhQh25sGPVhtCM_nOCZI5cw4_6k3vrf7NhKvY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvme51E2uBW2P3Frg6gECS19PpGe1kx0ygsnyrgLTAjxQ&oe=69A17924"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfzs-AbrHIAQ7kNvwGDE-ol&_nc_oc=AdlhCNJO6o6jLZDL1qaNGwTj4kTrCldUyxlURwgHtPXZAT2Hy8OvmElYZ-lgDnaRJWU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuVhU3Ywl5ApWfKXBD73D4X3AI_MPXWUq80lTaFFoHDKw&oe=69A1A1EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8aecKn_WwkQ7kNvwGLwowI&_nc_oc=Adm9dGo8jzGbjOr7iw8cY5STvjDig4RQGAcj2Ee2FnUVH6Ec8_Z2tnG2LgInYQgjIRY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuXEKay6GumbQJQ2jCfkxo5Prt9qM4pjmoz10Cz1Zm03A&oe=69A1A0E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwKeEyO9go0Q7kNvwFPluGC&_nc_oc=AdlAexZK7dLjOuR_WJE50ojWACaqCatOSXixUyjGVmWceSBNrfue5jMlAs9aEb1asgA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuWIfoWEUcSTnuatBWRcum6TnynpyRFtkRa_u1wWNrJwA&oe=69A17CA6"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
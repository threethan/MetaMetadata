&_nc_ohc=5hoRKVFry5kQ7kNvwE1_Y8l&_nc_oc=AdrjddkbzndOvGFByH8Krxr8TssCp3_L7WOrheZSjG9iYcV40taB0dCbydv7x907Kxc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_FXAvMUpgfm2aCd1be4xDSU0ARZVqjBhRjW__oFKUyw&oe=6AD39DDB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tn0S6cBQaYQ7kNvwEwgBzP&_nc_oc=AdoA0KbXwZa7CCSHDS6cEi0w2HKX8cx3VOwExXkgiFuC1RUBWS2xUL9zswTAVG3vBKg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQmX2w2yWNwo4QaTGKCQeAA02Ywf9uXJsBU_bDZvcf7Q&oe=6AD3B691"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA7h4tr8akoQ7kNvwG8QZDr&_nc_oc=AdquxSfdLcE8dVi5pFvQTwQYYmSeZpxo778rfVZ3aXXmRDDAezZ0aEhRJr9tYQv6a4I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDYu6a3AQpXDliKxEGQ4cyg4iAT9k_t1Nz-n7SKTqI0g&oe=6AD38D64"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViHNmmAjPHAQ7kNvwFQ57wZ&_nc_oc=AdoOX0bZWuQZp57EhaloaiZefaY-zRwhK8bO3ocWHVjRXk_JFNCYRcYQecmsLbGpcYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmdE9CKV2vFFFBxhDsZrBOrKyqaNJM7EkHtjo3JB9VQg&oe=6AD3B62F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcn1QgIKLVQQ7kNvwE7bY06&_nc_oc=Adrhi-n6_6iNukDsBRJ6zcNdMuQBLIPCwt084zdjclpgb2jCZAVCxyYRlSqGkSJQOzU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJjFZsGkA1_Vgbk864B3RKGmeepeNqeEEgxh7EcZkoig&oe=6AD3B522"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xefbwPR1ASEQ7kNvwEPGaou&_nc_oc=AdnuwpPa_R85lrQm9krCmicWpL9xdMk8t0BmPYf4RlrrS4L_ReBVO3aCMhbkGETARsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuJKedGYkH-4lY9_3Pa-ld_d2EzN7IEeRIIsViClCi6Iw&oe=69A596D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThF68vnFYZcQ7kNvwFDsR6u&_nc_oc=AdlHsUcXP9K4kkSAfW_dIVc6s2UILFyOIZqbErUb-tFN5FY85cUnymK3mqYGp1JVVeU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftWWTDklu_mJIqFy_JacEkxWMK8C-84N188UAfUq8W1Bg&oe=69A56DA4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux3bA6CgYsIQ7kNvwFNSAV6&_nc_oc=AdnAzO3vrSgcvdgI-wl4r9_lXv9fX4rizK6llfI8WsDalw9NAODiwEg5f2ly-pYViMg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs-4hCWSnNUwXKLjGd32uiRQ9QY_Mrwk7pifCRuz9YNAw&oe=69A5966F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlVdZ478WR0Q7kNvwEpBOfr&_nc_oc=AdmCTi3JLTwKCCvS2XgYsCCLLAiBNExbgd-chXYuRsfr07AQh4Mkm7fxPflKjpyALrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuX6Kw89dc8kFxnH52A7jFho_mUyJIPFfZj-ph42GOWPw&oe=69A59562"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jHX70KQpvgQ7kNvwGIvMbY&_nc_oc=AdlmHucUo_VvUqwl9J__RtGkCLP-vIQ3sDefq8Qp3mNgnBYi_20aLtQ7SGpJFdum-Ck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvhNzXgCk6qF83CUx_jI3dJEH60rn7DhI6hiPgoalWVbg&oe=69A57126"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
&_nc_ohc=Yftt1psllLUQ7kNvwHb8ll_&_nc_oc=AdofhCIUCdS4Pdut6mtp-Ogf61MFcs3pslVTx2lQK2dcGUMLsYJox16KL5CjI6Leu1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOsPHXe_PUNgAsnh5qAQ_m5g1vIV20al6qZzZNHNAsRw&oe=6AEB58DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iJchbXdUEEQ7kNvwGHpPQN&_nc_oc=AdpXMVdfVNUb5QurSnppcTQgLGjqccWlJr0vCGgy8aMMnqN0r6gcSuUM0hLghPVYAZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuVmg1f6eG8QZcUnUC--b5YjeeYwz07KLbZdfuMULGqw&oe=6AEB3951"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjt4BwOGy18Q7kNvwGON3PJ&_nc_oc=Adodlk7R3-D7zIc5LvSZ7FWHaImoXFmO6ptRnbkGBbFm4QyRkXUdMMogcBpgkqHhKuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQthdXAiLXjQYqPiUTQgxpHuhh7CWV1VE4ebu996SzibA&oe=6AEB4864"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ThwZBERvYAQ7kNvwGv4JfO&_nc_oc=Adq6z29ryNEhGp3XiBxE7RNRUU0DUPBVvVNWFlfmP-bUa9R0fQRGD88R35TI9sJv2RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQJ6E6XZrz-S-N-rkdz1q5dMN7bMn2sxSkKAEd3Xtzrg&oe=6AEB38EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKsjeEUn_J0Q7kNvwFQuCYy&_nc_oc=AdqSx20jCaaU7P6u3xF_VtfbS5TLC8bHh-s7lIKV8COSQMExidRBP9k8__VF64TMHeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7lk3hIurrhA4hRy37PtMyMFdVMPHnRNC75TtwLZVEOA&oe=6AEB37E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
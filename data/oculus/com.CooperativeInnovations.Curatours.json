74250720", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391773_651356877584053_1985014751912127584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWYEmV5C-BgQ7kNvwGnY4UK&_nc_oc=AdkZRSrwWrbcHUKKFohnNvrgegHA4_PTImPEmMeEi1kR7RohJ7VLjAAI4UscE3oLuGc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCuGlwsOLZ2vs_Of_wHTJg-djQ9ShmRM5s87lP5_k4EQ&oe=69AAE16E"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSRYPaMVWN8Q7kNvwFvVWMZ&_nc_oc=AdlhnwQoiUd1gdeMxFS-4YLznZQZnC8avokZeDNOf70tHON23nZ8mhzHj0sZqv1bDco&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-iy2aVyjaMLWrFMqwRUs3vOYDEhFDK-9JF-pbPMRWPA&oe=69AAC4EE"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4nS8F9uX1oQ7kNvwEk44Yh&_nc_oc=AdkdytpEk09QW_ivWt9mfYgME5NA7smkFSx3RhmkRAxLcH4Wdpf6bdZ8L9e5dg-eewQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmnyEXWmr-x-PsAS8yykXTUbZhS0TNC34_p4-Gh47Kxg&oe=69AAB062"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8-T3RQ-RWcQ7kNvwGM18yC&_nc_oc=AdkZtAXRyy7-1ob44pWkVww4VvAqF4KZzihBB3HFvimMnDyzsPtq6am-HkCLBc004OA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQNLnTtqKiUVPFBRU6A2JJpnkBHM1XJzXJUBZ4HIK4-A&oe=69AAC963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utgbGIAgbz8Q7kNvwHcfm56&_nc_oc=AdnLGjz7MUlSwxmeqYoQ1IdF6B_K1867zWyWs6zS2cE-YOyEF8zshIqhvByrFd_HucA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8FcQb0vyrexuPYpEJno49zCv_bYkkwI9FlylCY81iYg&oe=69AAD870"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have pr
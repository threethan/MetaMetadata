&_nc_ohc=g_3VVtEjwKYQ7kNvwGrCfZR&_nc_oc=Ado2VrE1-7qblnZAc6yhnFMI6p7dl3JsbOsQ-1tG8smr31cSWSnvRClu_D9Oz4ixCXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc2mJJncEKLUYoCFPE-mGhDLm2sgLVvWhMnHTe-K3fqw&oe=6ADF431B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb9hqjLm9hYQ7kNvwGu2gZk&_nc_oc=Adphdt_sB8n-Jv18icIl7Iunqkr47blXWCc1TZKCXGPVttF2J0pQePYDi6-7VRKMZ5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtcjOIT81mgiUVhBMD8VbxestBuNYMteaqhPqkzHaYlA&oe=6ADF5BD1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fso1kS-DX4AQ7kNvwGfxk3j&_nc_oc=AdogARJWHzfwUs0zBFfzb4EaGA1U0mEaA72gZ1H3Idw-cJ6k93jQEIm9_dW6AKmMnR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5GqS2hQbTWXP8OkaT9KCCPH9ACVXqyellzNoHglHh6g&oe=6ADF6AE4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOfOtpd86ycQ7kNvwFMDJnT&_nc_oc=AdpSE3l4hORmOYD4-LRnIfoDf6P_hv5S801eyu-ekxVMct1KdHTZ8ojZOOfc7wESdVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5p7Y4dXjRDShbEow8NOIH46qqOaA89gqgFyXcQSEQkg&oe=6ADF5B6F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnESLUUoFrIQ7kNvwG3xoIc&_nc_oc=AdpjSELsc8xVFxTuSYdNH-qcDFGPMcvTu9JY6521-66PyC-zet9Sho2FxFkd1L3lSQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx8j45WMcFLzO8BN6ALLepyWHT0U_qhf7ulbypdBPowg&oe=6ADF5A62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
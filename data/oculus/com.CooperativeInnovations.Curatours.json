&_nc_ohc=OeTC7obwbFMQ7kNvwEvayh2&_nc_oc=AdoRYmP9vplqbmujOenfV2Zp1egf7YT-6XChQ8Rz5FUfC4nXmPHhHgJ5TUjc77Po_ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHpUP7O0r74_uXbcPJO9QhgzQiy-ldL4yOTrG_Cgc3rQ&oe=6AEDFBDB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj5Q8Bx7PdMQ7kNvwHS9iCH&_nc_oc=AdqfOwyFgXEEWAX73FycmLZGtmH7pD-H7qYOstM8QmP7mVo4mnvVZfTk-vTc2wgj8DY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHPqJhTbBCFH1MzzMx1jO3a2effTskSs8aqqwL_bWHw&oe=6AEDDC51"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjt4BwOGy18Q7kNvwHN-ZCp&_nc_oc=Adr3Ww6FLURW78gO83pfLCUNMAGfczi7yykWEYnCWUrknleUeBEpBBRlxNEnCmdJ-iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzZvTlUyOX-yuanrBj6o3G3kqxq3ghuSoaLwlErbO3xw&oe=6AEDEB64"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os4hfsxuFUUQ7kNvwGrQg3n&_nc_oc=AdpeqoUg1c7JRqudyugNGPO6n2f1-PS1F1H3Yprwdj2dYjDGMX3eKmWafOOXbHcGEUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDl3UGtm2xbU8J6tgKRPVOC-U7hYj9qORBnem2iDN-SQ&oe=6AEDDBEF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKsjeEUn_J0Q7kNvwElgF-t&_nc_oc=AdqwCjqrTLNK6vmHfomE-1qC-yvSo2m7HmGLymVoXAEhLRjyRo6-OpFdAlXraUuJ9sU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSACeVAMaj-igGfFH8YbG-rKxSTN1OwUNUKa2KzW8Dihw&oe=6AEDDAE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
&_nc_ohc=4drz4-oGTTcQ7kNvwHiZTe2&_nc_oc=Adp5wxtzzbIka3L1z6G6rdIaeFMfS3cKfOq0JsNe6UCVACQS3DzR4ZS1__ud3NzWk-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODfDMuAh2K1dcmu1JCKcIgW6z9Bf1JLHzocrHevmhEHw&oe=6ACE57DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoiNwrxmWvsQ7kNvwEC6foF&_nc_oc=AdpsYTw6f7SPbCxQZY3DGZPTmpuPP6w-j_6JvB0EKeZR2dsH3P8_h6Rh_Ha3ignxzPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnt0m71glVBGd07wKeIDTz9akkgahRi5DV8_pbvkTOlg&oe=6ACE3851"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuGQdYfjpx4Q7kNvwFBdDvJ&_nc_oc=Adqt0xm0FkhCpHl43TVIOz8Y-j5dA2xEojJfxtkhPNKn9O1znUD3IaM8VHv4Dnq2yPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQbArMmF6cYlsCcSEN5O37Ykd72UE1yxovPV88BS_e6w&oe=6ACE4764"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fQSt-pZsPAQ7kNvwEulgo_&_nc_oc=Adr_uv9VCmTaFtaeVLCoMbvZEjkOPCQOMWlnbYZ1-eFr1PdDaf_2i53wgDXTSUe0j0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBbwIvJLjK8iu_uSsQ8d_FfSg8BEvYMj4SdoJ-VJDSdw&oe=6ACE37EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SBr64yiLMoQ7kNvwHtvO6n&_nc_oc=AdrACOSkHPXWFIg4VOP-25WL-iDADYdm6S_qQFHFELelL7GL0FSr7A3foky-ZWma-lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMszsGMDis6wVgh10OaHNBAaUXwGHHYjC-BtXu-aKRlJw&oe=6ACE36E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
&_nc_ohc=5VdDdu_e3ycQ7kNvwHKE1NY&_nc_oc=Adp6AEPKX9IUmDadbjpFRljX4lekzC1SmjR0AAoiOGit5Rwmlgq9UVBbsBVow7CZeIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4UO94zx88WUBr9X9vqgOPPyFKuCtGW-kXzBE0h4vQ9Q&oe=6ABD345B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrXooVAGz_IQ7kNvwHa8muI&_nc_oc=AdriVzuk_K3rFe6FqgnO26i4YtAMUcybRx551Wn5i_B3QNCzHw41OgH0fjiV4LdJ2r8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_Ol9S7AR-Nb6tngWOI5i9sYKdYvt3dJeGgIfHVB3uKw&oe=6ABD14D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiEQulUf24gQ7kNvwGPshxb&_nc_oc=AdoZ2kHdbOJ6nVDFJYdoO4jx0l_J75vaV0vRHVyCoVfsb8QeZOK_19nVN4W1s5dl__M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNk1a132frmQ-ZLVeU9GlokAP8ZlMGfYbq4vjz4dD_gw&oe=6ABD23E4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meplbJ_9lvkQ7kNvwEBhm22&_nc_oc=AdrFWKA4Q-EKNEluNDG85LVZjOerZ9BwGCmSdado6yFeQn7sUd5fEQXC92XnyenzdfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPX4GjTguC8svvtqEqT2FQSNV85-xoGtLp_XWCBjYD8A&oe=6ABD146F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2EQbxkqMuMQ7kNvwFm3J9D&_nc_oc=AdozQ5svroEft1B84cGuc2E93b-RNkl8a6zZJmtlRIESgeWSYVu0n54iE1wZQe3yloA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTylL3RcfDfPbMVO2nLEa-X1UXQUqLt0p9UOv-BPvZcQ&oe=6ABD1362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
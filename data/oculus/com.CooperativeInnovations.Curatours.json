&_nc_ohc=CaDKyWoMzekQ7kNvwGL4VBx&_nc_oc=Adrzfqg9dmAgFwvcwbDM1IOqoVWarMcYXyrX51_9NyW7-tQAp-dpsODHrVX7CrFfSE4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvMP8FUGn3NyXi_w-P4sWuUWRXxtLyA9Xq0KVwKMvJrA&oe=6AC911DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioih-XQZ3awQ7kNvwFHB8Jv&_nc_oc=AdrvXSd8uxR6M9h-dWLQ6hPKrPBiy_JcXsxpef9WS5pGm4xbUk3ypR20V-OjI-y_aLc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2IELV213Q_K5-kxXHxNVf3Anh5bBO5fBNn0H9Dssnog&oe=6AC8F251"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNQe5vFQl3QQ7kNvwFEAUwn&_nc_oc=AdpHbPSb2G-i9a6DedI0eVDpZ1AJbQkdhEHYVhRpqHBRQIXHf9lY3eZr9lhIwkiSRRc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTCI6znjqTaBhTGOp9Tj226ImjnaEfnA8Dq_7Z3HBqAA&oe=6AC90164"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEDuxOqjYLUQ7kNvwGdaCGz&_nc_oc=Adr3r8p5RCDF8uzQpY6malTJXxh6CMBkVvmVGyc2_8JHjfudWh5-p65NNrSmsb1HXtc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXIOwZVmARFHn1jD49M-6JmAQfrHrssA3RKQZ0Rz2o1w&oe=6AC8F1EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2qkHtH2LkQQ7kNvwEYJpKR&_nc_oc=AdqVSXcS5A0FlivIpt2zVZzvPw0QZwIKUeccwuD1pEBF6qMhesySts0Qfvu-5Gi0vmo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm81P9kZJYPkmmi5kO9Wr5D-MUsrwMPwRpY-OlvTr4vA&oe=6AC8F0E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axGpzhSMePkQ7kNvwEDrrpy&_nc_oc=AdnXE2kS5i_3giqF9QAJv6eMnTYdWLTiCet-ts7GAnjk7se58T1arv4ZOJg9cR1icDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7KsoF8edt_ZCoZr6IWvDMk_LJ41Jh8EHgCwxzRAfS_Q&oe=699B0F6E"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTuq8IUmAssQ7kNvwG4K11k&_nc_oc=AdmK2iMGFVs-bY32dkuzCBlIC7rvaaMSuJbm7T6liZtHRKbYltNAuHmoRwxdtSURENw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsCRS3jcEn-m6SOxwd_D9lg9DGNGdCYKnew5VI1FCSIcQ&oe=699AF2EE"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g34uBwrhjekQ7kNvwGCrmkh&_nc_oc=AdklIze9GwnCTSkOwaKqxBC5ms4KquyaXIApZSp_SAKED0NkCC6QmnDSMPiNx-XFqrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftrSc5JAAmdWEQOFrXHep-aFOHgfCtpFBXceE_oc7CdYg&oe=699ADE62"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5lrObhzuQkQ7kNvwFlGaq_&_nc_oc=Adn7kE1YTZeMJLIH2hNRp378uTl5SqkCMvXVKUAohm-LDiDsnjdv1KSur83CFIEVw6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgXaCCflqWcfWt8sw5_5HHgOt_m_RCjFZUK2grag61Ng&oe=699AF763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4GCOQAFLHMQ7kNvwEkEetm&_nc_oc=AdnxwpIIpFZiZdZseaOFTuhNxjbfWeSZikz_zVhFyGSIqS6UhkyYDEmnWmp4BWqg8tg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu9EMI3pWNdNFydCFBN2nacnzySbanZn64AYjxbI4A3MQ&oe=699B0670"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
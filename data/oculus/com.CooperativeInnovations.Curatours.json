 {"file_name": "MoP_Whale.png", "id": "651356874250720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391773_651356877584053_1985014751912127584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aToJj3LUuEQ7kNvwFABuoQ&_nc_oc=AdqlKmOcmEUe0R784N_LGGXzU7fpwI4RYV-k0baBwtyOyPxvUH3kf5JIQmUbykh1MYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSXZr1nfhcFTAO74KhJz91z-344iZQPfg_erJfYMWJCQ&oe=6AF1D56E"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDeSMwMWppkQ7kNvwFtmSgE&_nc_oc=Adqq2a_SIOMEA630wjhmqXfLjEhGRfbiTO-_sSyZH6oOTfZ533mm7l6HsxEnLtGG0gQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN-8XTxFTjavhWkYeectHrPE1ORB13srIv304mwO7Ccg&oe=6AF1F12E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ6dLaAjGNcQ7kNvwFLiDeu&_nc_oc=Adr828nXXqglgkC1ggU-KCJymqlLgO1yP6KrquDuUQ2Lk8F_UeHBA6B6Fvt4_16sZCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1HDy8br4hz6pzFzgyUSwyaub1NDktB7eHOz1tQszxQ&oe=6AF1DCA2"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcSq1z72YH4Q7kNvwHaCsoj&_nc_oc=AdqVcblRgkGuUCRxm15nz-ZGSU-kCIZTNyTot5Od_u3a8xNrHCyW_vEf415zyr0Elx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfNvzndI6EXd-1VFUcjtEGm2mpNmvMZwhxw2jDrwRqYg&oe=6AF1F5A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POQ6HXKcROwQ7kNvwGNs0L6&_nc_oc=AdqnvqSyegxenzz4pdllZ6eXNKoDNvRpkFUBGZh_x2vcDVOwIYqbVt5-yRSehlC3DIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS35OoBKS2cP1L0Weuh__FU3dEC441E57I-zTrMAdotaA&oe=6AF204B0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "https://cura.tours/support/", "website_url": "https://www.coopinnovations.co.uk/curatours", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9682200631849363"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572941_4514988158519614_513828567661581694_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE8lKLxq1lsQ7kNvwE6B_HI&_nc_oc=AdrCNvySB7sXHp_gdpJa2ul0psFELxBxympH2qOuLq7AQ4B3iLHF6SjkkzsXziBY-9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw3gRvlnOaOvIb0ZvJ3ZWTeX2WQN3cT-nLiAma4nZi1w&oe=6AF208B8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Curatours", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1636362000, "lastRevision": {"nodes": [{"id": "475636475438436
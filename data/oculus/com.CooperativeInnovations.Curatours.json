_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9czyhQl7nbUQ7kNvwH9Vccs&_nc_oc=AdlBobIhvhHNaR-vdpAl2BxkISVkXdoNyvamZ5LwQB05QgVyY2Y82FRDoCI8IMgeYyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuFWJhFEUBEToES34smECuqJxm6maYJaZ07BhAQkZP7dQ&oe=69A59B6E"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPizwUBfPO8Q7kNvwEW_s-5&_nc_oc=AdnFeMGEfxBZr6SZuUCvtHybNqHCnn4PnUfJMSIYtGkTg6o6cKzZT-gqu0YEOcFPDt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsmRqlE_guexkQhzsFD5DQgY25I6mxvPRwYwq3zpFdnHg&oe=69A57EEE"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPkfinr3noMQ7kNvwHZCfh4&_nc_oc=AdkNJa6We4QcBd2hXkRnHg8GL7nRaZNwWI3cJHZKUQ4LxCPDZISLjjh9Y5ZbJogvbJc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs_tAitpeIAE37C3paXucGfRBtEwZbgvuXiaN6xnLEyCA&oe=69A56A62"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGvCEoL9QiAQ7kNvwEDnU61&_nc_oc=Adl3AvAHtW9MioNR7jbLFhGiAYN0J0yj5ELAsVBdU_Ip3v-adY7uGPjaievD9Ap58R4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsQqn5KDFItrl7Y21p-OAvsehjUR81KPNrlPQ53iazRNQ&oe=69A58363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUyVfyU5KjIQ7kNvwHmCxWG&_nc_oc=Adml2OufeZDulNI3WKu08mpoIPdubxlW-wipj-NW6IScFAq8W0aSMFA7L5xHBMkXyO4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftGzP1d5-C4_1IoBjZMy05Ca8_pFSpXo8zZuraVu6aRHA&oe=69A59270"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2gfwz3mArYQ7kNvwFKHsD8&_nc_oc=AdrUUTc3DIrDw5kHFJkov3zlbl2AMM_6XjETj05pwzMGsmzAy6YLxt9aeqqMXmaFnEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af04NgxGx-IWOCJ_pvo4hJdjLEjFzNEYbocqCLWWWKVcCQ&oe=69F0C0EE"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCdThgJCirIQ7kNvwHUcU44&_nc_oc=Adr0wWdhEt9S_g7gWpTH74kb8Yz58AJmD0OxgOgbf8g9TOqR0zSJdFaqJWek94JRP8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2B9LSfqpLVEXwG8t7Bi8eZ6-EOA_39ozFN7kzBxJcMqg&oe=69F0A46E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8FZajG_KXAQ7kNvwEY9_V8&_nc_oc=Ado6EfYibBSERbkhe_lAQeHTOzSp3JhHp6R4HQQ18hjq54mWACyymYmg6sn_wWDJ69w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3g6ejazVSFcCGKeXOodhUG0gwcp7NcJxGKjUBGrLr8yQ&oe=69F0C822"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy8dNhQ0tE8Q7kNvwEVZQv1&_nc_oc=AdrE8nEWhGZVsUYvyvUmg_eDh9epVTfQctLkRKAL7NFXY4Art8j66Km1exgG3vxgB5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1hlTDep03qJcmRuAB-4JqRQPYKvoTaHbMfAuy_J5DOjA&oe=69F0A8E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIj4HcwkBbkQ7kNvwHuixiX&_nc_oc=Adr4Ri1EffN3MLM1qMoBdvg1su9-R692fKh_KecbUzWjxw8sBoYDEr3xmiyMEPmF3eQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0ttlt_DqWmZ6THE76kjkDU0VUN7mWz_435VLcOcf7ZYA&oe=69F0B7F0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
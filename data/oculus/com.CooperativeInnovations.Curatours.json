&_nc_ohc=Ok6wwjkD_y4Q7kNvwEAuH5b&_nc_oc=AdpnnsyhrPLiQn75Ec4Td1yB97LqOykBTzZfaAo6VVMdVfmCzV0Qp4KlGKnKH_1wIVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmGFaVLU3sf5hN-p5ErSVIHvfaFmzxV_CCMPB2EdkPRg&oe=6ABA915B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozUg7ILFEk8Q7kNvwHU0dqK&_nc_oc=AdobujXJKPfF0QW0c68XCbhjAr3WcXYuMv1iOAyDDWMWUGb3vTUC9XtfSfU6SHIVQSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMBJUMo9spSlBjApWNDxnvYBHiPpWV3zZCOLiFX5C2JQ&oe=6ABA71D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4CH0tVpYycQ7kNvwEz3vub&_nc_oc=AdqLcu9YRwdQmmutZxk0vyvn5PLSAnASELksNtcdno3jSoj7pITboiHl6atB9kdzFY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbD68EKlT0BhjDVRNOg5LpvIqs0DV6Nk8zn1krzamq_Q&oe=6ABA80E4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL2wgY3aQDsQ7kNvwHRKRB1&_nc_oc=Ado4azpkE8QZbtSYIE2rSaiZf0QR7wmgRZ9HFfmRFM0s9VcF_LZMKVf5IC5it0cBTPw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPgtwlUy30D6NhXdwb3Gr3Kdfvc8Agj6xmnvzATcCUXw&oe=6ABA716F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQf6DyIxMeEQ7kNvwHRE2FZ&_nc_oc=AdqaMZmh39kDr2qNmWR-D-QztjLacYh56OdCNccE8PkteAsrzzOFUNco2M5FCAg461c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6vPaOyYATjtKtqz2oDrqZCgGiIi_MflUBfaijN9o29A&oe=6ABA7062"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
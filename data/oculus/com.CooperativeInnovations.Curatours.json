-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ_aMw3aFzQQ7kNvwFpQuwZ&_nc_oc=AdnMYsHbCI5qLCqNY4xNSia-e6jWLpYlfMsh4ewn8hczUg8q6S2OV7ZrBHRPgUxPyJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftjwW2FMyF8LR0nnf9h3MXk-lAeKo9uCbJNrGbwtBFNNA&oe=699867D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLldgIWvYXEQ7kNvwEAuQMS&_nc_oc=AdllIWi-01wzFVnUc-FrIkLQXQ_-nQ73LaA3znS9IJ7wnlTkavNtLefT9_quBpfxjkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuF6O1EV_vlIptw3hMy92zc0XaLPJSdXfXmt3qbivOTMw&oe=69983EA4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d01RUwEw_sQ7kNvwEWwUp8&_nc_oc=AdnfXEP7FpOjyvla3CrgO5CX0yI7epSLEAzog81h8x0X7-wqU1UlII3kyTpM09TPdvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuL5rgf5BZ3JClDbjUVjcalM0c91r8IlOpTd4-fKByXww&oe=6998676F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxq9TXPRrVYQ7kNvwE1CMhV&_nc_oc=AdmERUUnHzHJw6CEfgKvEgL6LhOvTioR9n5d-kSY506_ctFeRzR5e4seq6Ud22wZq_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsFp8xoPJJu89lcq7Gg-ex70zscDXSVo7RKPlkRKduSyw&oe=69986662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-K90Oy76IoQ7kNvwH61L8u&_nc_oc=AdnjlwkiykAOVgUx-GftjlKxB9YHnr6nTDpbni5IWFdb6pOxfaPizaw0VxfHf3iYrqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsC4QQLmvS-YJGDDGD6r1RQhzT2yxE9nCT72UCkJXzDNA&oe=69984226"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
&_nc_ohc=E5YOew-XyEkQ7kNvwF_8qVl&_nc_oc=AdoX_3uIEHm1PC3LHLRa-3O6H3tB_AHefSgO3FfXC6GgH-h4fU5CwXAE67urbZlOzAM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzlrJ-zjG5ZK7Yc4gMDt3hD9XPVJHqzpB_Qp3AzkiF2w&oe=6AC7C05B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT1Oajt_cQYQ7kNvwEFeU9i&_nc_oc=AdrBgO__AqJ4EFedacVNqqvCPlEdKPCluCzHVjm5VDhVaWDar-nHDtonFtZQOakXr0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjoEWUPGmL0Mz6g86_ZW3wpTFLr5yoQAHKS9tbSC3vvA&oe=6AC7A0D1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNQe5vFQl3QQ7kNvwHOjaPd&_nc_oc=Adr99SGi1nybHW-eHmRsSKjWbEc6Tr2YezAx1Z-RZwJ10XLk4CWusiLwF1c4eAiUoGc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0iPHQHUZ7crQGeKNbU0OgTv0aLbzG6P2629hZlbTJaw&oe=6AC7AFE4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgAlKrk2mNQQ7kNvwGIXa8i&_nc_oc=Adql9RG_N5eX5sHLXdj6SGcDJmftdm-y6Zu5iItUxkzVoYxNX3Kp7H2IyDVZWOVsRJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUKREHhsSUt44i8uuVo-ViZhuWQy3kATgugz91cws0sg&oe=6AC7A06F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2qkHtH2LkQQ7kNvwHyFK9k&_nc_oc=AdrWAVXfexXKm56m5X8BNeFtoWAt62VkAvp8GsTrK5DfbueC4mOmlGXUMcMoXz7U-sM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2oB_U8iS0xbmvA0Xed9wlRpZ2DrF1wuDZwPinJ9to9w&oe=6AC79F62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
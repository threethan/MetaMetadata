&_nc_ohc=uaPgCeuhOCIQ7kNvwFiP-Zd&_nc_oc=Adr-xPpnzPiwzZbT00Cxaqq5jcJP-CoImlyLPOVKyLyNQPSK7Aio23CCDFJ8nKhRxf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyXUFwHG7LZGV8oz7arXIRgtpj_wcDgpJvioG42h5Pbw&oe=6AF09EDB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4BItmZIkYQ7kNvwFMQf7l&_nc_oc=AdrS_P-HOMDcRhqYHTqWB0n5vUREm4dSDK74W37CaxGP22irjLJpsC4mw2g4Z6qXwtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj2G807kDZ6oNxvSC-qF9B41dP7TjzrvBF6tpsGeVB4w&oe=6AF07F51"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plehx-VaQigQ7kNvwFsFTN7&_nc_oc=AdqVEeK53HMqKsRYv94_mdnHAqgaYE9hzZmpl-49ctSU8f1lk2v19-dfJfEEBMfOvo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQyQep_TUcKgyHPAjlKKl7AJLITlu0IVYCQyClk74EVA&oe=6AF08E64"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJGLW0mNDNwQ7kNvwG79I_d&_nc_oc=AdrG8hxhOU5VPI2Cboc1__xow8Yphuyu9J1b69jpvFfSXpwFJLv1pE3OVPKWftl-eFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPc5z5-RKFkYWSyrljUx0DEk3oB2HLFrQTiJZSYY9ESQ&oe=6AF07EEF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN4_xGXtpw4Q7kNvwEmwgEn&_nc_oc=AdqTd5M32gaM_N6lplydaHnncEwADZFjHVHv1esxsjOPeJAnq9_AAiVABBGTm_lzdr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREJnuc1su9aG5wkLU11wwVjIcY7dyWj7c9857mZI0T0g&oe=6AF07DE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
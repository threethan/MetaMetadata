-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xefbwPR1ASEQ7kNvwGPuQgf&_nc_oc=AdlBQhBAVTaw59w9c0bsiV7TlhmsbtNPKSe2Hu_TWXoax8bD1yx1FlRuxJujF3vbXZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft26HHht0XFM5pLhMtYAEEQcTLJTcn6gy2QKf7NFpgPxA&oe=69A6E851"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_474WPy9uMQ7kNvwFOVWO6&_nc_oc=AdliOdNSIO8dyanrY_KQUfiaMLn35buOpbPmSZ8JDdw7gxAb9hL7nRPtJ5udCgC54Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMdeNVBr_YLKzFxt4U_RAShipRKxyC49vNNDIhqsIKdw&oe=69A6BF24"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux3bA6CgYsIQ7kNvwHdDSLY&_nc_oc=AdmGv96e4HhvjyeR4gvIVAw4GyPumpSZki9XdZ5HgjSNrOVrOksuSFqJefhvskUJEqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqeefQg2klQF5OhTMgsD9sSE2mLg8x9GG4ecPP9MVjfg&oe=69A6E7EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlVdZ478WR0Q7kNvwFveCzE&_nc_oc=AdmfjTmfgd7rfKot-smyoDJASnBJ4mSM2WcwX9POoLZGxYMHmaRWh27K0xq5RQd9wdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvT2Kf65j2HthehAEm3VB0fmJGvpnMwDDR_22R1OBYRjQ&oe=69A6E6E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g0Gen3uH6IQ7kNvwEWfCiO&_nc_oc=Adl_Z1XWo-ZBKY7T4MlAKQxgHBbeitISUTbZAe_heeTueKoshpDVFcUynKNCuAkWMD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZxOTWuCruRBbnfz3Qb4gtMidVxG7xIavXgSqm6Y_AIA&oe=69A6C2A6"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
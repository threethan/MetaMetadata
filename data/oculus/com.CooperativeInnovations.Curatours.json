_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbe7VUZ7rdMQ7kNvwFP8uDw&_nc_oc=AdmiqKdeFtOxKuwiMTonSr8sOV2_ArL2d8akeQ-3x7OHVBoGNMdspFn170906haBLiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftDnTz9kdPXE80io7TmcP472M7cxt_6zi0iCnn4M8ZwvQ&oe=699C60EE"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTuq8IUmAssQ7kNvwHzDdLY&_nc_oc=Adm4Kw3LSx4t-lu30YKBz60Lga7w62Zo7oeTKBN4kEyE9l2_18DanOpdXlrpeD7oWtM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvvrUkvIFHcDS3dz1d2IPXpAjYIM64-ZoyP2kGn9wR7Vg&oe=699C446E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g34uBwrhjekQ7kNvwEj0u7p&_nc_oc=AdlpgwI9i8PEg9_3BmR7xy1Dc_0V4f5Ax70t9tizH53D2sqBEf-8xGh0kstLtvHQ5TQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuKtbDSjSYffMu8Hg_VTYbcPFOx0Y8j-aQi2fwtg0oUhQ&oe=699C6822"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKFVqiQ4ci4Q7kNvwHl0ezz&_nc_oc=Adk7s1PLy6PnnM3CRdYnQWMOyKGjOKoPI3u6zc2nKzpim-C71oqhw3MPjsvqGQ8yG5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv3n1GRDcXv0daiMURGi4KrWicnekOlauC4Qd81iPty5A&oe=699C48E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A4x7VTOnwUQ7kNvwEbLVEX&_nc_oc=AdlU4aLtyk-TdfXT-CkLXmccIqpWuoZPsRp6v-CZruQBP1oXnZQWQ2uP7aLrkNeSu-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsW1gM3JoR2PdAlTYz_kpRsaSjmwcS-ljz2H9n4Vo-h0w&oe=699C57F0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
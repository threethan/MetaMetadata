&_nc_ohc=RdL0WjmIObsQ7kNvwGpGu9J&_nc_oc=AdpBMeHj62izmey8FNSZ5oLZSc4-GkQb7PIF1xGEVxAXv1Aj6WIJxBZPwWGI88muk2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpe2EEvAr1qotBTl0yHjnCW5k_leZzOvyF6Vip0r8iDA&oe=6AE612DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgcMvrcGgAkQ7kNvwHYKeRm&_nc_oc=AdpezHdH6pLNomaRN9XLRbHjh3_pA5RdHNSeKECybYLOrFpDCS6VDo28Qk7_0uphqQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI6m_3an21PwI6WdOR1F2gnbCyJ4i59B3S01Yp4i9VtQ&oe=6AE5F351"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2SSmys9puEQ7kNvwEl0cBW&_nc_oc=Adq3dtNEf7GQf_GPaQWHhbjjJgB4CuioZGP1mR2Kgo0iuK7DYdh2MhzkSqFzFtDaLjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8emKUYPJL68hdt-CiwAmePAcYGhdMjG0o40yzfD1dzg&oe=6AE60264"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9SaW-IstdIQ7kNvwGk7_dL&_nc_oc=AdqCyQq7b7i1BDMI8muSGvjpSUETqekX7JMhbSwUvLPV2rOEvXMul9-XvGt7dA3CnfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpEmsTjbhZDcMRAt42xDFo-T4zllZW3C3kCIrTcXjQDA&oe=6AE5F2EF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTOJYp3i6EwQ7kNvwEseG4V&_nc_oc=Adqo7UckhWtD-tBv3fTKXs-7ZmiRme4gv88FHM-_hJjw4n0V1_c02gSja1htdeXt2GY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWEryjry1uOtiQOyzyTddKr_2QCvclz9zuWf4t-Cf2aw&oe=6AE5F1E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
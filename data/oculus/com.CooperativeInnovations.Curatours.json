&_nc_ohc=uaPgCeuhOCIQ7kNvwF1Pkbm&_nc_oc=AdphuURKXX5ZicZ9Mulnz_xGo6l5rL5FkxkOQoW37iwX-MjNYoXCpXnyEU_dTaL6_P8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3nLgBdJs_Na59hlMppdarC_Y3KOHGfaKawZOt5RuZ_g&oe=6AF341DB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4BItmZIkYQ7kNvwFqapO6&_nc_oc=Adp69P91lF-Dbif-ySqaTgkPFQdtt_mLyp5aLpnC0tBKM-cyEsF04xQq1BaZ-DSjYiA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvKfUF6xYBFcjTTWc9Rnh6m7WkEwUMemU6YS3LSsx3MA&oe=6AF35A91"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWaFI51llaIQ7kNvwGXzpBq&_nc_oc=AdpCAA1hsEd_X_aXmYZcO8QKohvt0JPLyNu3Q5fwqaIU_MeSecAO_AxS6gkUEOc1gyE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7t1rUrG39DcpKf_1UzsbtP70QlkeOH5KHT1hnO_XGUQ&oe=6AF33164"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJGLW0mNDNwQ7kNvwG97m98&_nc_oc=AdpNOrDm4-nTqId5IaQXYBFPcb6VIil0pYl_RdycOrWNfKhQHxvYpeA1DAgdTRYYX28&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDBfhRDtE3BFvuOgNdCwQdzCc_LX3uOck9B691KgIdiA&oe=6AF35A2F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g46ew4N4b0AQ7kNvwHDTGBA&_nc_oc=Adoxw5EE9eBzim9AsEk7SYgvIwCWmpWnsWY0fR3Gy99zgLMy7k7LFfskHL8I4nlwjxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlJRlcevWbacPnzQLy8MCr_2JnyAV4bco3DUCV5ditaw&oe=6AF35922"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
_1165920168499070_1972843046669381593_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umjEA_-KaHwQ7kNvwHNcnbC&_nc_oc=Adocd3TSBv5IAN9UvwrUQ_pdmUJ-H6W1kkLT-wuBZncKr84zkGhilq3ZY3SCTt6AJG4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQp91_iIdumQFU3URtcdwTVJplLW0IZmnvHpAJHgXrVAg&oe=6B0B2DCD"}, {"file_name": "MoP_Whale.png", "id": "651356874250720", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391773_651356877584053_1985014751912127584_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUIhB34aKncQ7kNvwGueWRE&_nc_oc=Adqvq8ToFJeLbUBZwEO3wc_6EAs3pGMxNaaUhQ2SPjg-wV6r9e7_8fgtrtZ-5ATqPJ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7dd4NWI655ODpyya-bYS3ppaBQCQUbn_bqmG7j2jK9w&oe=6B0B1A2E"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gks3lNwdo2AQ7kNvwEBd9nl&_nc_oc=AdrtJorrlYujcPjS5ut9PLFrZKAGJpvDuVS5II0ceFZ87_-FMUXVgs4AkvPuea9WIsw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtv6fmTyi3FO57VNfc-GCCnVu43gurKWtPR1EmsnpJgA&oe=6B0B35EE"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCesyshaplYQ7kNvwFKw3bq&_nc_oc=AdqsxmJ1dZzZocvcX9VkABlqPjQEXlMIbwT3fOmM3FsEGpjOP_HqO9tCIEZx-OA1RsI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ92Q6MW5XeFYq9ZZ8J7MEoeskD3ZNXIFiQ0CjwuITWCg&oe=6B0B2162"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-Byk6iqF5sQ7kNvwF2N0r5&_nc_oc=Adr0dmLYukhwIfahz3rSNP0Vt5LKAUev1LIqRatCGKALvzS2c6F5j32ZNQAmCq_mhXQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyi1DdntWYAmK1z-H0eCsncoROEb4BjLcuAAmeeTT2tQ&oe=6B0B3A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5jrkfA2gIQ7kNvwGHjN2E&_nc_oc=AdqtofKTWQFiCNwVhA0QJGAzVL3WFdhEk8pqa6W8fa5lXkuIltyEIWG5ghcwOfRQcNA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhLDrB7bPDNpj32JR-nzvTemx5vg_u35vv9OxZM7aNLQ&oe=6B0B1130"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": "https://cura.tours/support/", "website_url": "https://www.coopinnovations.co.uk/curatours", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9682200631849363"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572941_4514988158519614_513828567661581694_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGYntSckFfsQ7kNvwFWEofh&_nc_oc=Adp4BjkuKrmY6MC_ZiTg06gxSMNQnvfxcahGbm6_rVvalIjvGIPSt9XWuY4gsrQa15
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axGpzhSMePkQ7kNvwGdsK-C&_nc_oc=AdkGxXhj1g9Eek_JqRSyDtZZfL3xdkhi1ulS6cMTlnu7YXJAuXCKPV9mB4BBJK_pW64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSu-n3kmVwg4s3-PNg-JyYi_QLzGS4tuBPtEe5xRiQzw&oe=6999BDEE"}, {"file_name": "HighresScreenshot00013.png", "id": "9485579628188977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391773_9485579634855643_3583907083362611860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTuq8IUmAssQ7kNvwHQ6xJ7&_nc_oc=Adntmrv49wF9oidIJPaYpOpqAZibaddKhvErEE-mLMC6U55a3H3iJZxPOCkOiGSdxOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSI9qrNXknY7BFyjp0UBGFcPk9_-FZ0MIwrE0ivFZLNg&oe=6999A16E"}, {"file_name": "HighresScreenshot00008 (1).png", "id": "986561060108148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_986561063441481_8973886475549907994_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g34uBwrhjekQ7kNvwEL3srx&_nc_oc=AdkIkyOglkbNKcnt0jMqMZTzuZirCqo2Vrioco1rPPtsf-teGKJEZg0T3v7CfcrM4bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjYDwqyufVPdfZKTCX2L9QDpbOpkIrSPF3GDzBtriv2w&oe=69998CE2"}, {"file_name": "HighresScreenshot00035.png", "id": "1698431131103364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393608_1698431134436697_5936960088646747795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5lrObhzuQkQ7kNvwEojSqd&_nc_oc=AdmBHuuEc5MnwmilgtBO20NUTK_yW2Q94Z6yKQ_6zpcvQroLgFxlmxFogHL8OkWABBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBR2uBIW1HN8SJFgl6P2r061uCUUGTfQNuz27D8O5ITA&oe=6999A5E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00001 (1).png", "id": "632438742890058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_632438746223391_1395431173331766531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4GCOQAFLHMQ7kNvwHBwbso&_nc_oc=AdkEIYsEFlWDJdHIawjfGkDD55berSM5N3dcslPjnOfumX9S_yEKdMrcdOk51bGfxNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu74Ij7s5jLuBqHetu0xtzZSURrimvyh2H9ZUqvVbkGQw&oe=6999B4F0"}, "display_name": "Curatours", "keywords": [], "long_description": "Welcome to Curatours!\n\nCuratours is a social tour platform for culture and heritage. Visit incredible places filled with art, artefacts, stories and friends. Visitors can access tours of museums around the world from desktop, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it feels like a cross between a video call and playing a multiplayer game.\n\nCuratours is free to download and offers three types of cultural tour: \n\nSelf-Guided: \nStart a solo tour and explore the experiences at your own pace with this self-guided option.\n\nPrivate Tour:\nStart or join a private online tour, using a private room code to keep you in control of who can join your tour group.\n\nPublic Tour: \nJump in to an online public tour to share and explore together with other members of the public.\n\n\nVirtual Spaces for Culture, Museums and Galleries\n\nCuratours offers visitors a wide range of interactive experiences, from local museums to cultural and historic exhibitions. The virtual spaces allow visitors to get up close and personal with animals, artworks, and artefacts in ways not possible in the real world, all from the comfort of their own homes!\n\nDownload Curatours for free today and experience:\n\n\n{1678456049434285}\nBradford District Museum and Galleries\n\n{1699167101006411}\nMuseum of Colour\n\n{2067291553697127}\nMuseum of Plastic 2121\n\n\nand more! ", "short_description": "Curatours provides up close, personal access to cultural exhibitions within the safety and convenience of your own virtual space. Designed from the ground up to be as accessible to as many audiences as possible, unlocking real-world content that may have previously been out of reach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": nul
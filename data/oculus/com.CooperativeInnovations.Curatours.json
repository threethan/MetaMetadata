&_nc_ohc=ShncVjPcYwMQ7kNvwFzzGtm&_nc_oc=Adqz_SgZrg8sQQ-sYLQVNipiC6r9K0pUKIFBAI3udW7TJl0LGzK7BIzNdZDvDGQZk7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_R7GQf70i-I-tzxxCyZz1ks-wktjjGyktbGverhQIpA&oe=6AE1E61B"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmyLkc_tDe0Q7kNvwEPXlqA&_nc_oc=AdrWtH6siqR51tR78z6LAgmXX71hY88PU60MAoRpETD55G0-IZ3lv-RAF1yC4-HYGr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO36em-7019BDKRTqaXKe884_sor-lJkXhmpaZ3FVytQw&oe=6AE1FED1"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fso1kS-DX4AQ7kNvwG_QKrM&_nc_oc=AdpeiKT19n1UFRMXGnBidG3pux-kxX4VKZOESJXhWm9Q3lTtmQkr__SCLxW_JAlZJYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7EaJD70XtT7MSugiytYlIphYVcYiaoTETyOYE-Zx1Qg&oe=6AE20DE4"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0K1Y8OGdmIQ7kNvwFiuGsu&_nc_oc=AdqRHiaYopTks8pL8szSLHz0UdLElWrPoT654PCnBcbUIXc5XuoqJBcSod1AS4CsHwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaDTIwgXuqRj7rBidN5_8pL7No0qaXzC7c9XG5ZBA8mQ&oe=6AE1FE6F"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnESLUUoFrIQ7kNvwHd_PAe&_nc_oc=Adqzwpu1c_qyHs0a43_owK8VZo1JDKy2eYwcP4DyB_ohH8nMtlYHL7txAo2E0O3o9Vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMVqLGvwj8JJss5-906j2_QlPDP24xPMHtF1NL7wA5tQ&oe=6AE1FD62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
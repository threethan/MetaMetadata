-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07lQt_RZSjoQ7kNvwHC7pg4&_nc_oc=AdqL3PpCSFaLaiTV7rDxiZYCQWsFn4WWyp26BTTPxrIFiqEVkXSKtx9jAEM5yXcmqZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3cZR6pUZqTKEOEN_Hqt19sJRjqif9OVOJJPuASHnvcNA&oe=69F0BC51"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QexSGuuOFZ0Q7kNvwGWc1Lm&_nc_oc=AdokNqEdBoo6YLjhpGQZlScYBWFycdob3mAr_PmqCtTh4xq6PEuv-07z8AK4g9dk_Mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2h1WouniOKxtEZ7accLiAVkQSFjTGx_NLTmdii6T2wBA&oe=69F0CB64"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBD--ZwRK30Q7kNvwEqD0ZR&_nc_oc=AdoPTnLhAcT0hNl7QOnxjIy-9lkcF8FR-1yABxf8nedD2nBFJCrXNFOPA8AWSq0146c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af36KgKpSnba8Eh7Lk-0VimxJL9l9_JUV0B2BXKzV7k2ZQ&oe=69F0BBEF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxtU3-6giaEQ7kNvwHA3zui&_nc_oc=AdroWXvVK9aCHWDZ9998Fu3bNM3InzZY1ch6RLtj7C_zjm0uY2BmZd78E7Z_caHd204&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1t38Ypp-TA8VJ1msWMw0Gqk2QQuiovJG6A3fgKHAHj6Q&oe=69F0BAE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "occulus_coverart_placeholder.png", "id": "547061729749417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375087_547061736416083_6937420105488662687_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDWgrSrgGpUQ7kNvwFaeGZ6&_nc_oc=AdqDI1O3tftRQGkry_IzKdOIn28RJHeHw3e2p_B7wL4awmATdlpXRkqhkNUk75byxyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2b1kAY5RbSAWWRsQ1rn8G_MjfTf6jWHXtcs4f7aJsphQ&oe=69F0CEE6"}, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
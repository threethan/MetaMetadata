&_nc_ohc=E5YOew-XyEkQ7kNvwGvzPa3&_nc_oc=Adp1dmfnj-7vhYBIoyxYfwhp97YqFSDbG1lWuvrf3zDG-Xa0cASAZHX57MtCSQd8H48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Km32R_icvbC5lY3CTbN4e-oG01rQM7og-kwgUaDfBw&oe=6AC66EDB"}, {"file_name": "screengrab_1.png", "id": "3058377071155158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348045_3058377077821824_606644335952339901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fT1Oajt_cQYQ7kNvwGwd0SM&_nc_oc=Ado-UAcyH6arXfSdx39Aj_0RddtEkxn92_KZ4AuXu4ThoFOuGBey1nIlqgOJV80uSfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfkc-0KuOFhRsmkq1gZzzo9_CTrk4xIW8g6rvXE1Z5sw&oe=6AC64F51"}, {"file_name": "Screengrabs_2.png", "id": "861756404772390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572923_861756408105723_8470923836315507856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcrlGXgsBKkQ7kNvwG7cpDi&_nc_oc=AdomCyuk39GWR5Q70_-q7uCPXSaQH1Xngi1dY7ROOQm4rbo3vS3A8YMn0MsZbgHgDRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM40QfXb9Y8AZavkHUsTyEaYAIqCfUjOVk39t4OQx7Jcw&oe=6AC65E64"}, {"file_name": "Screengrabs_3.png", "id": "341601274328513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_341601277661846_5428982906936699612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgAlKrk2mNQQ7kNvwEmvIxC&_nc_oc=Adrpp1KpTQLJZFy4Q77IL6FXUmNzWKusj4jgs7rGqZeMRdbGMViQn6B1wlQJp5F6JKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOonPxydlWgNgAaw_MLPJe2Jja0cw0O51pYVS6nEJhthw&oe=6AC64EEF"}, {"file_name": "Screengrabs_4.png", "id": "507102677251409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_507102680584742_7420227356861752672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0go-qqfu4EsQ7kNvwFNVyZw&_nc_oc=AdqvS3R9Qc7OIphk3iDzfPtq05LjaQafuVEPAEbukOi_DQd5RDg50nbA34XPrQo-0yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuULs3qPea7kCHmPmEUUzGbEZ8KgrTIryB51lgCPS2fQ&oe=6AC64DE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Curatours", "keywords": [], "long_description": "Visitors can access tours of museums around the world from their desktops, phones or VR headsets. In VR it's an incredibly immersive experience and on other devices it's a bit like a cross between a Zoom Call and playing a game. \n\nYou can choose from three types of tour:\n \nSelf-guided tours can happen at anytime, just login and go exploring!\n \nPre-recorded tours are similar to a self-guided tour only at points a guide will appear to tell you something about that place or the artefact you\u2019re near. It\u2019s a bit like a 3D audio guide.\n \nLive-guided tours put you in a museum or gallery with an expert so you can talk to them and ask questions. To get a live-guided tour you will need to book on to one of the timeslots available. ", "short_description": "Visit art exhibitions and museums with friends and family. Everyone can explore and experience the tours using a either a PC, tablet, smartphone or virtual reality headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coopinnovations.co.uk/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Cooperative Innovations", "support_website_url": null, "website_url": "https://cura.tours/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
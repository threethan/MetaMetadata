reenshot-3-3d-view.png", "id": "2666008473846410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303100_2666008477179743_8663031205161685874_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZvVy_rWsuUQ7kNvwGIy2wi&_nc_oc=AdpJ1FGU4nfZ6FcYXaAoFaFHvyIGlLXsY7W8jA4A-wjlCle0Ypk9LE0FSMbY1tuUMWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREurawuB_eiM_AtB6CLXUVQ-SugbmcRKQNhv3tgNbucg&oe=6AEDF9A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada_mindnexus.png", "id": "1609939273842394", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300603_1609939277175727_4559854077515148341_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BMoHR951CUQ7kNvwHulJgC&_nc_oc=AdqIwlzVxpZ5jL43frORlg5lXwuEsRVZfyLaWHn8KKW6iQwHgQwd48nPMwiGPCDTfe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc93dGbkVvDzf2FJ9SA5O041AbVqO_z6LhqXb_ph4x6Q&oe=6AEDDB49"}, "display_name": "Mind Nexus", "keywords": [], "long_description": "Mind Nexus is a spatial idea board for Meta Quest. Brainstorm, research, plan and study on large boards that float in your room or in a calm cloud world.\n\nBUILD YOUR BOARD\n\u2022 Notes with rich formatting, links, images, tables, lists and charts that update from your tables\n\u2022 Connect ideas with labeled arrows, focus on one branch, and star the nodes that matter\n\u2022 Switch to 3D view: your nodes become bubbles, charts and cards placed around you\n\nTHINK WITH AI\n\u2022 Ask AI: write a question and the notes connected to it become its context\n\u2022 Summarize notes and web pages, break text into connected ideas, and search the web (with Claude)\n\u2022 Use the AI provider you prefer: Claude, Gemini, Groq, OpenRouter, OpenAI or a local Ollama server on your PC\n\nVOICE AND FILES\n\u2022 Voice notes and live dictation into any text field\n\u2022 Built-in file explorer and viewer for PDF, Word, CSV, text, images, audio and video\n\u2022 Import from Google Drive and Dropbox, export boards as .zip or Markdown\n\nMADE FOR YOUR SPACE\n\u2022 Mixed reality with passthrough, or a cloud environment with day, sunset and night skies\n\u2022 Snap boards to your walls like sticky notes\n\u2022 Controllers or hands, plus Bluetooth keyboard and mouse support\n\u2022 Organize topics in separate scenarios, each with its own boards\n\nAvailable in English, Spanish, French and Chinese. Your boards stay on your headset: no account required.", "short_description": "Think in space. Mind Nexus turns your room into an idea board: capture notes, links, images, tables, lists and charts, connect them into maps, and explore them in 3D around you. Ask AI with your notes as context, dictate by voice, and open your files \u2014 all in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://robb-roman.github.io/mind-nexus/privacy/", "developer_terms_of_service_url": null, "publisher_name": "RoDEVS", "support_website_url": "https://robb-roman.github.io/mind-nexus/", "website_url": "https://robb-roman.github.io/mind-nexus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "fr", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1378444378688363"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_1544403404110738_8732396393036944038_n
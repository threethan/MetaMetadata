0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6dyP6QY1cUQ7kNvwH73b_s&_nc_oc=AdrrLs_hNMG19Y401h-JoewAhoEKwp8gogIbWOhiYIPG3rJGb6VHjtissNmDGX98J2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2M6D0qmvx5-uXkjLDUHIAhdMK6P-zuHAoNZO_NPI31Q&oe=6B0F10E4"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnKmwFyvW-MQ7kNvwFyb4-1&_nc_oc=AdpbP619XQh-CCzIClzUeG4aTIl2cCLvBYravOpymdt9kJswegaqzZ77qlKDMBgR5FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTkVMe_4SMcWTgnYG_Oksv0tXAcK2-hOi1Iws04eAEZQ&oe=6B0F231E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFD9-oeOzNkQ7kNvwFjmvyg&_nc_oc=AdrvLro-3vp00HJMeWEXjsLfoXRiBd76cb2Jdp0OgLxnkOM3XfCFp2BQQGFLr-717sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVuP46lSqZFlNQxU6IGXKVX2GA-iV2426uggoV0a_u0Hg&oe=6B0EF378"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itUops1hiQAQ7kNvwGpp9IG&_nc_oc=Adp9KFSjqRphRU34jNjAjMSOWL3Tq6TjWM1Osqp-TGsQ5dXw1y2RUQ2gps0yHCi50aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVS3QJtnnsNYGL1VfxYwP5cWGLr6gBzdFakQu4IDaNmPg&oe=6B0F03CD"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4GvzpVuk_EQ7kNvwH1KCHi&_nc_oc=AdqLBXpyk7FE2djklwKQftkOz39AmHE6v33C_k1uQrpR1QgxlKXgt4SULXh21CibEiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_OYLC0h2EYQ0XsiavSZF7eMqrsy4SbGVl54tbnFRUxw&oe=6B0EFC09"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU7ZSUMTaaUQ7kNvwH6eKSq&_nc_oc=AdpNRUv-qoF2gM-J37o4asNd_biwCddgD3MwUfY60j9EnhS4UYAQLHLSyy4Sf-IUjkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9UDe1rG9QxTcOYWdR4yAaZZh4FCkne0Va_fyFaAaSkA&oe=6B0EF613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hid6RiqYFvYQ7kNvwEwidPo&_nc_oc=AdoXrobVdmCN8dXI3oWiVqh4dh1krFhW_G1TWKGzjhAAcyt-OT9COZBxGQbbTIIjBDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUe0Z70vw9xllde8i_5pIJfSn3CtHUj5YADRMMbEgvykQ&oe=6B0F18C6"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
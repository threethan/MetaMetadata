0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLj_PSwDUfsQ7kNvwFg_DAV&_nc_oc=AdoAJMghXWgojF_IlGilPlbHbX8F7qEcam5u0yFr2tfrSWygjz-RAoMoJ-Fm0bR9j0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTsFlVxb6YfpBNga0OXX5QkJdDef3jBVULDWF2596S6A&oe=6B0B1C64"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqTnfVt-Yx4Q7kNvwGO8z7R&_nc_oc=Adr2wYyLnGHTbvEbHG_dUGiN9gIOw7kBkhntTm5iL8FXtXqKoXwHViFvAA7SHWAxFwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqfwtdOkghh1p8i4RlZOzar9kqEVWA8O-I0dzuLnSpYQ&oe=6B0B2E9E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3oYhngckTkQ7kNvwET9c7R&_nc_oc=Adr6J2eRMOO_b8zflxPYCIkfq851Q1hkWwaa5ZQDqXXwfUIdkIYsVFZ-xwOn_weuDHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIECkbl7kDyIXyimZOYhIzv5oLMp0kftRqB4F1TS0kug&oe=6B0B3738"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N7MKPcbVIkQ7kNvwH7ym41&_nc_oc=AdptgAPFtTUB3GZ_EU6bg7q-xWigJT9KVWXWuyJZWEU7bVC4zGNWnc1Yk-Vv0US7ndQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdycdf1JX57cJWC3b_Dp7SRvt-Waucu2ZMnqDiJZoY4Q&oe=6B0B0F4D"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7joGg4p6BUQ7kNvwEiPtC-&_nc_oc=AdqHbV4avUsj0Wb2dszVBEDf2AyHvITf7yhv2sxleh863LKHlg0DXJR4qISEF8n5r8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ33pu4qw12qmaVSNqmusWvCuM5AkFNFWsW3m2HHKFBIA&oe=6B0B3FC9"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3SHDZCSY6YQ7kNvwHwETxO&_nc_oc=AdqG5uZKwuZqjaYiDAcOXXpiH34AJj-8lxgD2hhJH8YMrATO6A7hhahPH7jks5FwJx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa4sxTfZk9SliRolr1AaiVTWGj1VzAyzLw_9QO4Aotrw&oe=6B0B39D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cS_OcakobwQ7kNvwHjGOep&_nc_oc=Adql0TK-XL6LdR4BYVWVsrFdhyQA1bPQPU4W_Y5YKbNixKW3jMSSyQdCkaQzK89yctg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWoIsZxRnZPDCrS2X4QdDVCh4-ljUN-NxlJyaZrscaWQ&oe=6B0B2446"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05gaf0egju0Q7kNvwGwBEpX&_nc_oc=AdpjTmIEhBSdOrj6JDvlpE6Gg4oNqxNGnyEXH_p1QdHz6uDRlDIVhmBVI7n_zuqFztA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdJApHPGhwzpP-MCNyrFyEpyEMwRYcLQ3SAJPuOlSJtQ&oe=6B05D664"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALXcijrXhvwQ7kNvwHi8g_q&_nc_oc=AdpzJFEfBXTI9mWZRFDgR_1DdYPwI_4FGy_vTbCQgQ0zgZSRt_Pg2ZemTIQ67hQcRB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv-ou1vX9VX3NNVZTWpaX9XMAHwO2JWOhil0E6RvR9BQ&oe=6B05B05E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTNp3xw9q7kQ7kNvwGbgk06&_nc_oc=AdqQdPB-iAOoqp0XtIRrIKs_NeFAUtViohSNefTSCAAVnwvMnQDMAVSCU8WQsVNENTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHvvCKurn3UPRn081-hZ0b8lx9bJjqiCGY_oyPFU6apg&oe=6B05B8F8"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT7tfma6cFEQ7kNvwF7_U1R&_nc_oc=AdpjmNs5cgXdq9Kaq0X6zXxiDjFFens1kSVU-mCu6Cuk9I_TMam84Wukgw3S3idJXaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDlsAlasCFyB9pvS16tIK9JRn6-N_c01tyiET0Nu2s4w&oe=6B05C94D"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkjz3-_xSEIQ7kNvwE3ON53&_nc_oc=AdqRKTCukQAs8dLusjgv_HHwXZsJ2oU7gwaJ782Cgoh6zDwqysAb6FNRhn0DCjdEqNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz0omYMkiH8lGPCszodTgC1aAuQy2uq5NfQw7Y0xxuTA&oe=6B05C189"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r0W2vl1rbkQ7kNvwEhowu0&_nc_oc=Adoz_w9fW5cjK8RltbvHwiNo6-c5Zs0hyE1UnJnCWyjisHPMDuOcUHQuv7DKhupWhYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzRKRdRIJCAA5xaRFmf-Hjzx8LozsC3gA8a6o8XbmNcw&oe=6B05BB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EENlRvcFVpwQ7kNvwGyi84r&_nc_oc=AdrYhFiKFH0JQkSBWnCwm-K35XS-elM_fJ4vpiLttLgaTPA2d8XiPhiyihtyu030nJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcnwWtnAjNrQ6zHeS-pnwg3TenK4S0eXrp_BuHJBM5JQ&oe=6B05A606"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
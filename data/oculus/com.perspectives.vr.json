3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuEHWniNSjhX9jA1A-Vbk47h0PCqN5t8CaPLtKr6R1Tg&oe=6B086C4D"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkjz3-_xSEIQ7kNvwE2wiOl&_nc_oc=Adrs55CFYsT8Nb4cLZfOYvt1JY4ohXkNOkr0n1Fee6oQenqxgwLE-D5BFLNlRHMHJXw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwArV2bY8Rjve_3rRrmDnA8XihSmMPbLRokC-rQVceBA&oe=6B086489"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r0W2vl1rbkQ7kNvwHuXZlT&_nc_oc=AdqmyClw7GdSavdTFW0UFbL4tRnFArFN5YaSVGPiRKr9oHJC7aclBLoIrpOX_vdWQHo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkNV_XClpSOaj5xdbWuZKPDoZRQGOK1UYj_7CZubCRPw&oe=6B085E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EENlRvcFVpwQ7kNvwHc4R0J&_nc_oc=AdoZx0IOYcCL2uxakRXH3LFf4uNAM1R5kzDMUeqsIE1W55RI4V7bm03OPModDrf5ca8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZTN4bc6xJVV4c6b3pErEB1bal6bnVKsOF2kkQxyezaw&oe=6B084906"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426569163879153"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491831299_2083476228998702_5728134474344592820_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCchzVSyhfcQ7kNvwG1KgQq&_nc_oc=AdpdrEE7CxwPYfoBQemtdt0Bo_Q54PasoxmZPh-ve-XxRZyKi5EwtBvU7G7I5V7TH44&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRviQrCybXu5CpKCfvFxjbPBF4y-fv7fJXHOHeqm4CRoQ&oe=6B084E2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Perspectives VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1794993420, "lastRevision": {"nodes": [{"id": "1419916374544432", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1419916364544433", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1501690051840250"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "icon_512x512.png", "id": "3544205512406637", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307303_3544205515739970_3714281814421377892_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWkCnAEY2_gQ7kNvwHdf3cB&_nc_oc=AdpIZ_w9rkEbXU2hzn98GmSd81uBVVc3Iy4hK0yWHQr79o0B67kSp-z27lRv3zc8EjI&_nc_zt
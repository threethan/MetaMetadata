0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLj_PSwDUfsQ7kNvwEcf-Ks&_nc_oc=Adowp__tw6DFtS-Vv8KIfiuxJOu8RqWYWkGZiiRyHf7dgp9UDBSwZVwUukEt3goOL0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLzPHKfVlQGdmQjI5V9g9jX-nvm4DfZtUeMtLRFuVNWg&oe=6B0DBF64"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqTnfVt-Yx4Q7kNvwH7QnKS&_nc_oc=Ado_5gdHPjzN0OEUGK_JDrstX43owvD8ymY2jr02-D6oZnYbjLji1Mz2c6t2KN6UnDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkf5jqN-MX-S8t3JUtAakIPIjiKeGMGMP22qSZ0Ecj_w&oe=6B0DD19E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFD9-oeOzNkQ7kNvwGnz2UA&_nc_oc=Adq8Jr36RWeyep0t9xriP4DocDiLSdAJzxchIqC7R_Q-bocwD8rlACwUXZJzCHA27QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD-CsI5dgc9R677JjN8jmogoT2amoJ4lHBr6PkgRjlMw&oe=6B0DA1F8"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N7MKPcbVIkQ7kNvwETW7OC&_nc_oc=AdpEecPL3Yj-AcwD3qVmrwri8WQxmweiD1QBdGRoy_1xvpAe4vT47rjCmZeGRMVo61o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUXdC23vuZWOZO1kwQgEbQ3BpH7x4IH3amoZvtnCZA1w&oe=6B0DB24D"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4GvzpVuk_EQ7kNvwGwMhKI&_nc_oc=AdrLPXPVd_f8KMKPpsq2OcYTaeAYhr1VUMbnquK8EwPtyEMeVMUGHzv3xmNy-JLQFm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHOQaFjZ6sBg229929KuFDjIK3iPATromi38nXLVfb8w&oe=6B0DAA89"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU7ZSUMTaaUQ7kNvwE4x0y9&_nc_oc=AdqXPCwJKRc-Z_3MGUxG9-PVVhhmnl0m7yDifLUQQn4tu2QGU9MRAEPvX77cDOkiD50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvHTKRXt91Bm8rx349c6ywQglkNbTIhuJmevHaP9ngKg&oe=6B0DA493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hid6RiqYFvYQ7kNvwG48l03&_nc_oc=AdqHdRPSNltqQYLLCQeHv3PFJ_u9sW6DYTEYgEvAxepqRJwPjN7Ibdb2Z2B-0RjFfac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSF-CTsWteBCSPnp4wHV-iC_sfbuqlY68hNMcNOpRTl0w&oe=6B0DC746"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
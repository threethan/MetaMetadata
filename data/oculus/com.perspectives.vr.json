0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLj_PSwDUfsQ7kNvwFs4YVI&_nc_oc=AdqEPPC2UjBpZLVgN0rL-Tj7yCOIFdM5LJnh3XPwxAuhxraBk94bGUmled3qIpNVMiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRac26fDZDBohfdDZVzc2QCAaQng52MjewjjP3c1045ag&oe=6B0C6DE4"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqTnfVt-Yx4Q7kNvwHd4kN9&_nc_oc=AdrYzcK-2OQ0dvt1bs3Jyj_y1JjYFC-bGn_rudFHroAb1JHe_3IzAuYDiqHKMLLMX94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLCvFuhOv-21rKqGW1zzIqL_Rj6S04UrXpBnyX37UUow&oe=6B0C801E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFD9-oeOzNkQ7kNvwHnIj7R&_nc_oc=AdqS5ELnYhP8_f_yjsTIUMSJ5YvpJKKzQdJUYi9cOb7yEYDfnlbcZ2TWl9izbc24Dmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2I86o8wKiLfHT5Yfzx14iJtIKDIh7wN5ZMvgZsxF3KQ&oe=6B0C5078"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N7MKPcbVIkQ7kNvwGXdUMw&_nc_oc=AdoiD5GV0876_TA8sCG8Xznh90Cf7FaY2GzMsc5cWzHVIdxHqlG6-SECfMiC59ollDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk1s0Yer0Lp573eIfQhPGdeLs6dYQ7P7diLB8d201n3Q&oe=6B0C60CD"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7joGg4p6BUQ7kNvwERJ9CE&_nc_oc=AdqFsWVCqM0GpOYGK-m46rzH5WQZ0hz1B4uEva5LwF-aMswUUW2kGb-eUpqJ34_uv5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJ6ELtZWgNrGYmr53yN8Ag9qKq7MzfBhzPcgAMKc0Eaw&oe=6B0C5909"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3SHDZCSY6YQ7kNvwHtoBUH&_nc_oc=AdpMmDDkd9dXnzbn3uaRXiawBe8a6Wh9_jXFvYVxKL7XdwsSYpayy4zL0mwu5xsdCVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3-im8ih5XTs-bcBio8MjmJqj9emEOT6gD11DyZJOtMQ&oe=6B0C5313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cS_OcakobwQ7kNvwFXlB_Y&_nc_oc=AdpvDHzGPfHGZ5tv3sb_34eVZsOnrnM0zqVbpQDIdCSYMAevkjtIzy0xjrs3m5NNqbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4iRtAtr1bF0LFLZdQ6hOvFDmaq3CYZAU4Ot5kmAf-5Q&oe=6B0C75C6"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
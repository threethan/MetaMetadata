0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6dyP6QY1cUQ7kNvwG5DyqD&_nc_oc=AdqW-29YPFxpsEc_VRWEOSboGDRLRDEtKkFiC99BusTTEDw8QHoMG3rdo8l-6xviZ30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6VY4745kbLuS9vWrKwJO0S_mMhjd1ndUI95Eq57gXpQ&oe=6B106264"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnKmwFyvW-MQ7kNvwHDXn1p&_nc_oc=AdpHhLamgjBU7RWTMcJJIvdtx_9VLUWAEoN8mBrreHmDTokJwTWGDnW7nTL4l3hyfFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUt36Ojei0KkXSNpX5iXve7ZFphB-ZGxnG2p-3extO74Q&oe=6B103C5E"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi8OijD6CIwQ7kNvwHFCIiC&_nc_oc=AdohMKIDawPZQdsAeLHq0q997Me48aISUnhFAJLEvpVCHa-f0jJeJ9PIePpLycCfkds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9de5i4uaBWOpsFjptgY2Z8UC_eLWfHsbvy5u9pxZjNg&oe=6B1044F8"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itUops1hiQAQ7kNvwERrca8&_nc_oc=AdroTlKvAAOYtjLRnG9LWp8-ynoMcm4KkGTd-3_7Oj7cdo8Uj3YlOdwA41cnXMC7LkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9LVCZ1P5spW5Tp2EhvwkKw2OywXseEG-D-v-p6E2gTw&oe=6B10554D"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4GvzpVuk_EQ7kNvwGzE2qg&_nc_oc=AdqIeYyEFoystyOmJ7RYTmCL8naKrI7Fl9IFVr12WMc-BXufqzh38aYU31zITg2vGz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzhyjC32iN6XWrRgEvxEqaPmwphHsYrTcgQzZipWhTDA&oe=6B104D89"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU7ZSUMTaaUQ7kNvwHfz0c7&_nc_oc=AdoEJln5kA9N9iw8ShxOOVWBrcTQkDLDyMVUf6oKgHDXL5Yy-VWbO0G8xPapGyKCCg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCFvvOzd5_yA3xWnUCOOF4Bh3jeDCvMIDAfGjCuN9jgA&oe=6B104793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hid6RiqYFvYQ7kNvwHu1fTa&_nc_oc=AdrfClNEEIal9N4-_UQXn4kHcqPfJHWQJwe2tRK945G3PuG_PWFo04vCJt6AP2DU0kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWEm5L14AXfUCPcLk6dU41A55UGlSCIQnbLTqGQsOUahg&oe=6B106A46"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
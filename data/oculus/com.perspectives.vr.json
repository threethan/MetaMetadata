0_1105068985623820_577801391239275230_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgvcdSE0YKUQ7kNvwFg0WED&_nc_oc=AdqKeg0-uL6y9r4m546DQJ16Q44oARLx5_xNOzcgG1W9XeIxR1gLR5qFS-PtFOWy7Fk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS516cNqHTVOT2hlbfRrhmpEinKn3kMaPnQ-V0fc66nQg&oe=6B09CAE4"}]}, "id": "1074457695639553", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "3145199212349352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312257_3145199215682685_372426454756344194_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaQfl_YT7_kQ7kNvwFLQ5Tk&_nc_oc=Adqd6imOJDjv4QYec3S-d_tgWcgJ4gy8_B-2_-vmiiPyTZQL8QOwUsUaHkni58NuftA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1VTqxdUdabwY4F7QcpgZW2brEcfaNMEoeIKpq2MEiGg&oe=6B09A4DE"}, {"file_name": "screenshot_5.png", "id": "1159701383375310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303790_1159701386708643_8151610842519622403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3oYhngckTkQ7kNvwFalX0x&_nc_oc=AdpjAkhX1zZhrXH0Ab8m82teQZbIDL8wtVXymkJ6FwVE9UXweNcMxAj7DB919m5yBLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK4UzywVH-ITHoo1yR5kklyPfwnYDwQnZ8aKpJhdIadA&oe=6B09AD78"}, {"file_name": "screenshot_6.png", "id": "1444650007800897", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1444650011134230_6282327621154189206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTg9FkApK6YQ7kNvwEdOYn6&_nc_oc=AdpivoUopfR2hk1kYb3zntF9VAkqc_GoAjBXIK6d9E7AtBKTmJj2D0BPJ3BEDoGVzJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRLcVuqFUwierkp32qKvBSKpmualt6hZCfyJf4mC6oSg&oe=6B09BDCD"}, {"file_name": "screenshot_7.png", "id": "1816208959607923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673745728_1816208962941256_6020630242294776829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7joGg4p6BUQ7kNvwFRQg-w&_nc_oc=AdrQG2q2qD2SRdvWZlwJLG9i6hfYMQD6l_Bee0S5pSexuIDaLkiVSNTTGuRElfaXJKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo1Fy-sZBs5U_2FVu9zvjOcw-ERdUrAsvpJLnTzzQh3g&oe=6B09B609"}, {"file_name": "screenshot_8.png", "id": "4117023281934933", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499314659_4117023288601599_4537583110378712244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3SHDZCSY6YQ7kNvwHeD1HX&_nc_oc=AdqI6Y1qbnWMJ7sEjZ6IE0kXz5bAOx2R_JBdIzody8aRAtN1wrlcALlq-HulCAQQiOA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQru-3HuzbTguHL4LZYmLoQqAmNtVpEcIW5cULsyXqGlA&oe=6B09B013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2557309508102368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646423555_2557309511435701_7195974263347231515_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cS_OcakobwQ7kNvwFE9ZQ0&_nc_oc=AdpiMoSya6ZDchtog6zPD_RoWeHxuPjP-3PhHIz_nPFK4ltHeHPEHj74IIByOwRCBc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ62YlwmHPPktD-ITB-CTwbifk2Dxqi5Ye8EyQpNw_e_w&oe=6B099A86"}, "display_name": "Perspectives VR", "keywords": ["education", "empathy", "perception", "health", "mental"], "long_description": "Perspectives is an empathy and education app. Stand in an ordinary apartment, walk around, open doors and drawers, read a book or talk to Sam, then choose what to feel: the same room, seen and heard through someone else's senses.\n\nEXPERIENCES\nMind: schizophrenia, depression, anxiety, dissociation, ADHD, dementia and more.\nVision: migraine aura, tunnel vision, cataracts, colour blindness, visual snow and more.\nHearing: tinnitus, hearing loss.\nSubstances: alcohol, cannabis, LSD, stimulants, opioids, mushrooms, DMT, MDMA, ketamine.\nReality: a cartoon world, Alice-in-Wonderland size shifts.\nFun: a meme party.\n\nMADE TO BE UNDERSTOOD, NOT TO SCARE\nPick exactly which parts you want. Three strengths, a timer, switches for motion and flashing effects. Stop any time: one button, an open palm, or look down. Each experience ends with a short explanation and tips on supporting someone who lives with it.\n\nPRIVATE BY DESIGN\nFully offline. No account, no ads, no purchases. No data leaves your headset.\n\nPLEASE NOTE\nA simplified impression, not a diagnosis. Not a medical device; it cannot diagnose, treat or cure anything. Includes flashing patterns, unsettling sounds and shadowy figures. Not for children. Do not use with epilepsy, if prone to panic attacks, or if you feel unwell.\n\nCREDITS\nMade with Godot (MIT). Furniture: Poly Haven (CC0). Public-domain books, NASA photos. Voices, sounds and music are generated in the app. Full credits: see the Website link.", "short_description": "Feel, in a simplified way, how others can perceive the world: mental health, sensory conditions and drug effects, in one ordinary apartment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://exus541.github.io/portfolio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "exUs541", "support_website_url": null, "website_url": "https://exus541.github.io/portfolio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
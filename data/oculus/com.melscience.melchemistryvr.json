.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8tdPX08E0MQ7kNvwEE8DAI&_nc_oc=AdpwAJI_XcqxWzmko6eDraqBbaXBpdCdx9pFniPb5yc_hIXgOkp25QHUEjxWi37xpRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV9DU91q3rGMxwbt_OS9WK_Ma8MtJ_YIxglFRqeN7Hgw&oe=6A789948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_video_pic.png", "id": "200822753983739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162791_200822757317072_2998667009819934720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYmdehFOArIQ7kNvwEZyV9j&_nc_oc=AdoN-2qfsAjKnaDS8xd1z4ZwRPUZhVxsa39hXo8Iwf84noQlCXdpKS8GHxu-Qs_6DAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF8ygh9wMvvQ5Q-6qZVE_53ZSuL1dMAru3SwlO-g_qUQ&oe=6A788505"}, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science",
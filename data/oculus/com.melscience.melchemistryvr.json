k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuABPRtMOXMbEJMYAlxpT65ycCDmNsrJzWFthvsw_CN7g&oe=69A2D54E"}, {"file_name": "migrated_image.png", "id": "752308845295649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_333801563793590_6564751559387774976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhTwp8vFPHwQ7kNvwFjyxwS&_nc_oc=AdmoOUD8nURTBcbOnxOLyylNAMnX-AM0scf6fNCVWIWZV6xFwZtnRvTYV2DbiWT2OEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsW853ZjcrwpytaYRvW6uuSzuPKLA-FH21M9O1XzM9lEQ&oe=69A2E0FE"}, {"file_name": "migrated_image.png", "id": "437631697029756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgdJiyUncIIQ7kNvwESgzbP&_nc_oc=AdmlypseSQ6_GhsDJAMeABf9sMBGEu99vu8G9u72yzZL_pmStB40Rnrzsib51X_Auqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAPSMP22riJrHuBij7U2zUDkKnwPGj--nOjfXsplKGbw&oe=69A2CE08"}, {"file_name": "migrated_image.png", "id": "200004504594779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482156_197411594360500_7135162674161123328_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPUficiwGroQ7kNvwFu0AsW&_nc_oc=AdmFYNfgaQrDII4RdNoGpYpTpQKk86quvE1VGtLAfCtCs_873hwsxx-q0uK2ylEXI6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1IINB3dgZTI8-NbsIurUmCUkebQj_n9wDtWWu2p8tkw&oe=69A2EDA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506746864200007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504728_228548637725438_954679145801973760_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRHsTyw2nCkQ7kNvwEym3et&_nc_oc=Adm16maXgMjVJS7EGtkmor-QLikF7OfV9024aVbfIUWrtTErNzCEGj28fNZ_oynHD5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-FDiGK6THeQmC9VUAeRbhUqiKdbRu8X43cHxzCq5MUw&oe=69A2F0B2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
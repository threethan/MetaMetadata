&_nc_ohc=dx2A2YpQ20sQ7kNvwH5kBi3&_nc_oc=Adr04fea2bo6g5g5H5_8BHeRp6M0MxEiRGWXX01zNmpDexudHyyLvvRNWBmiPMEpet8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxq1RZKEUMZw_VYJAZ4mip7zSixYfu98v9O1NvdCBLjQ&oe=6AA4220E"}, {"file_name": "migrated_image.png", "id": "752308845295649", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12504730_333801563793590_6564751559387774976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IhxNJkXCSkQ7kNvwFhMBQL&_nc_oc=Ado0kjxbeKXHZRlxvrPm_UpcmEo8EV4iYGWQJWh9_YjAVvVrQSOV5IcWccFvIdWo9oQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyOPQ3pWZ2z0_F19EIqM8QR6UzQ05eJhjnOtDdMAN3rA&oe=6AA3F57E"}, {"file_name": "migrated_image.png", "id": "437631697029756", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSBTqPlAffcQ7kNvwHOAuVK&_nc_oc=AdphmXbRq1Gaug-G4_dDViJn62qrWYSPo9m9fgmkIZeCgTIYpiwqF_lWoAfCl6-E3so&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLC9z9x0_NqgMI1d0IjWnbKRFHXtZI1JYcsd0nJHo8aA&oe=6AA41AC8"}, {"file_name": "migrated_image.png", "id": "200004504594779", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12482156_197411594360500_7135162674161123328_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt00UkTtWc8Q7kNvwFQjhog&_nc_oc=Adq3M1hwWeFncYYqaN9W4fGUBP_BkIekSkjruqhISZpHLsOE0xO2mb177QxzlxHXhgg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGBzGGY7BroQz_sVnSaTsuyEuR7_9pXrcNegYTiXUIpQ&oe=6AA40225"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506746864200007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12504728_228548637725438_954679145801973760_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glJVTobVudUQ7kNvwErzrj5&_nc_oc=AdqEIbuuuIsdAq89r5jobdfIViP6deKO53ckqcLatmfL1hqeLVkQUQSmkIxAD6AP_fM&_nc_zt=3&_nc_ht=scontent-sin6-3.o
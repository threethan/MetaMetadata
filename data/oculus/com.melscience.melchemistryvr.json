g&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsG9hRmCpOmKbdc14E1l-mGaH7Sq82zUcN5zv3Kj-hU4g&oe=69A183CE"}, {"file_name": "migrated_image.png", "id": "752308845295649", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12504730_333801563793590_6564751559387774976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhTwp8vFPHwQ7kNvwGx22oh&_nc_oc=Adkxt9zkS-gQA1q5dC4UtzvUc74waP0zmkg591ypNN8FCk8y89P4kJSpjIsIFtyGnfA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfulhG_-vQg272_xMr1iftUT3CgewbEun5_i6-cyfPSdaA&oe=69A18F7E"}, {"file_name": "migrated_image.png", "id": "437631697029756", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgdJiyUncIIQ7kNvwEU2kHz&_nc_oc=Adnl8dVjoCbRB1FkXmCpYJW8YWjFyhGoc4J8ZFw86l2gltriS9R4w4zecGR0xDQvmtw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft3n2lAS8AZ9IioOTpxlM-rN-tyLJcLNlPqe_HCNxbLtg&oe=69A17C88"}, {"file_name": "migrated_image.png", "id": "200004504594779", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12482156_197411594360500_7135162674161123328_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPUficiwGroQ7kNvwESYFGv&_nc_oc=AdkkME6g2O48kTYLIVrxXH0HJVmKTrcZl3XFQ_Zo5t7Cd4bHbv-NOfZI4AETvgqNQLE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs1lMYR1iPddQbYtyMmwhexhq1p8RyzRgQ800bRuMGGGA&oe=69A19C25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506746864200007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12504728_228548637725438_954679145801973760_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1329CtjqqkQ7kNvwGN5aNY&_nc_oc=AdnPtmN3PFe9lLivdKzguwVX_ZZfMKH-ICHZrdcUFZV-hItfWm2Yv_pyb1am064YQDc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvjK_7d-WGM32qL3Yh9Xy0hj7Q7vJpDmaT8MiO2Khu6dg&oe=69A19F32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
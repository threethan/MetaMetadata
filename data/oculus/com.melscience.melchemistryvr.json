00_AQSs28897cbt65Aabm8vLrNt6UA7cg2y1puvuAmNUvFhOg&oe=6AFB30BE"}, {"file_name": "migrated_image.png", "id": "525336201722459", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12482378_228949034343748_3338776064011796480_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASrXhmqR21sQ7kNvwHt9udi&_nc_oc=AdqJG1t4O-T_jBoe0Z9EK0OgJ4qqIym1bpVVbSKMgIIu88kuEBfY0rSP-2w_CHCsCyk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdwUwB4aE5ujRilrG3K69_2Y2Zmc3HuqQ6U4xsR7rtHA&oe=6AFB250E"}, {"file_name": "migrated_image.png", "id": "222278785822047", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3EAoBduTLMQ7kNvwFffiCU&_nc_oc=AdpKSdShgM4YlQ6_TmIoen1YGluUrIfMocK0AWOx4eIJYCs3eGJRMfUqEEzr1r0NoKU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfCH7g7o3g3x4bkxjrqEOd_KE9UBLG1xylt89n2hdiRg&oe=6AFB1DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_video_pic.png", "id": "200822753983739", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162791_200822757317072_2998667009819934720_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfaQyIrBnrMQ7kNvwG3Lv8_&_nc_oc=Adohl6FN6CgqvBqLiaAGulfwL-vt1Dt1-0ZBKIVrgHaTZpfOe0gC-iwSDj2-AsLkal4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3UFLBXe5eqBI3uib8uSLR3gD1Ug42ItbweznfX-VVaA&oe=6AFB41C5"}, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/en/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "339746104687137"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3276642282459092", "version": "2.1.0"}, "id": "195152267742085", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
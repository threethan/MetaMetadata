0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsq1uE1HxOGZwi6BoEQGX5QGgc29ye7W_II95DVccTRug&oe=699AEC4E"}, {"file_name": "migrated_image.png", "id": "752308845295649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504730_333801563793590_6564751559387774976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL2i9jwlynIQ7kNvwFNEDVG&_nc_oc=Adnx7WslkO3JyrbQJFD-t7IqTWFC9iBhN-0FFO7dOJBb3MAX3IqWw9qquVX9piZx_8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftdqbmtxIttIFAiRPNqpkWNC1lzudKP38XffXkxCOiYcw&oe=699AF7FE"}, {"file_name": "migrated_image.png", "id": "437631697029756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8LCWFr6m3sQ7kNvwGnepzM&_nc_oc=AdlOuGAWX-T6Yzk6bkeanhEswbhmHnHoD6-N0qaxdc6zlwVAXNDXMJ1kHiiP4i-XSwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsmpd84rZOkLkiE8ZPm7QQhd_C57at63JPA-ydSu1fmHg&oe=699AE508"}, {"file_name": "migrated_image.png", "id": "200004504594779", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482156_197411594360500_7135162674161123328_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGMUABxNsxwQ7kNvwEEDH9E&_nc_oc=AdnCAd-C5f9MJlSuft9kP5cttMH7hSa2Mp7FZwDeWMbbdsxcXIJpPyN7-6lYihsQuWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvXQ4Q_l9viDp1Cfc-izOQchdD1R05qm4VQtdKWx4Opsg&oe=699B04A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506746864200007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504728_228548637725438_954679145801973760_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uONeSDYfOJcQ7kNvwGxxxft&_nc_oc=AdkHCdDCTs76xynucSIdixN0QzM6m9dYR1qkO3aCOxLKJKUVO1LXHcVnnoZAokl7Vf8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvzDfayqWILZERIakfaDk-SYTDB4KxxrBK4EjjJ-ClwgQ&oe=699B07B2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
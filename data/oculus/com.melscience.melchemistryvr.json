=1-7&_nc_sid=6e7a0a&_nc_ohc=RamI9-ejsZkQ7kNvwHfUS6s&_nc_oc=AdnP65LxnHBVN3PW2pM-jt592agpPo3RfoHpNb8Ia1E1lXoTgkBMY9FOysFDtmGsD9M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi3wZKsLlxATjgACj828apjClUTyDO4BL0mOkqnHcp1Q&oe=69B14E88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_video_pic.png", "id": "200822753983739", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162791_200822757317072_2998667009819934720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z48yeYgJY7wQ7kNvwFwWXJ3&_nc_oc=AdlV70x_OGs5bgxzbT0JotAGxB7fLFxnHUiG_Zz_Xf2gpx1nZW2erB_i18WuhDHGwr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaFDrgooZkYpebPpYSo_7Ip49oMiU1LqBB11ke5APIkQ&oe=69B17285"}, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/en/privacy/", "developer_terms_of_service_url":
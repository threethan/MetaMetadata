=1-7&_nc_sid=6e7a0a&_nc_ohc=wKV5pJLU-WEQ7kNvwEQV4z1&_nc_oc=AdnRQnXFZorddcss9UkAoPPMF6by-3zOoTpB3ofmPK-SRsGQCw-PSoo4s-dwQY6rGk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybFi7VbfKQXMJRZbIkncYZ_PAQ75LHuGxrQ94DO-71gw&oe=69B7E608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_video_pic.png", "id": "200822753983739", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162791_200822757317072_2998667009819934720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2Tvjv9oTWcQ7kNvwFpPK5X&_nc_oc=Adktm8ZEtzAdciUcVuWGqFKoelz3wU51H7E_f3rGUo9H-mWCveGDM6Otg8WRendxWaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzo8-mCX-fz-VuRPCQDpakEOZ8u0c3WTt4zd8TfM4vOGg&oe=69B80A05"}, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/en/privacy/", "developer_terms_of_service_url":
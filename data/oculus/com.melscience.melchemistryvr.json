dr-5Il_KMVwCf5ieWRbXpZaiH_5zCjmbCkUJbomWY3eRzEaCs9A4Mh4VysnvU64MPg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KWkX8KxKc46yYvVNShtVcq2gYoFOSoOqKtVhwdoNy-A&oe=69F1EF4E"}, {"file_name": "migrated_image.png", "id": "752308845295649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504730_333801563793590_6564751559387774976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1US60orkU18Q7kNvwFL_3uu&_nc_oc=AdrvACBp_nFPnziUPXD1R_xAXiRcvjIDr-3yepMr9esbzEsEo_dKGHlHf86usCm3ZMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3RbACv1glE5nNLr7ISZvllBrsEcKTkwO3NGctWS0HDNg&oe=69F1FAFE"}, {"file_name": "migrated_image.png", "id": "437631697029756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410280_1218576238278227_3961034177146519552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA-EVeJLS44Q7kNvwE9Z89q&_nc_oc=AdoXRj2A4kjzOF5SRdkTTU1i4dUi41S32fF3gnDEjCBWfTqD-dYuy3vLBPS9p8ltmbI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GBPajXT9jAucUHJfo9GEo_hnUWMX79WG3bAZ4IEIrtg&oe=69F1E808"}, {"file_name": "migrated_image.png", "id": "200004504594779", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12482156_197411594360500_7135162674161123328_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM4rjf4BRNYQ7kNvwFwQKks&_nc_oc=Adp8zm3M9_bWtbHVL98jKKhImpo6BE3f03GZt6ZL23BPycwRhHWsbkIBgAaJIFnWxaA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1z-PqSPnQoiiEOVkvHkXJP9QwNusrPtVVoSXnJ2FSeLQ&oe=69F207A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEL Chemistry VR Lessons", "keywords": ["Science", "Chemistry", "School", "Course", "Education"], "long_description": "MEL Chemistry is a course of chemistry lessons in virtual reality, made to fit the school curriculum, where virtual reality turns studying into an entertaining process for learning about the rudiments of chemistry, using scientific games and the immersion method.\n\nBecome a researcher in a scientific laboratory.\nDive into solids and gases to learn about their structure on the atomic and molecular level. Construct any atom on your own with a special constructor and learn about electron configuration.\n\nDon\u2019t memorize, understand!\nImmersing yourself in the subject of study makes it a lot easier to comprehend chemistry. Complex concepts become visual, and the ability to interact makes studying fun and entertaining.\n\nInside you will find multiple lessons that follow the basic school curriculum. There are also simple tasks and tests that will help you absorb more knowledge.", "short_description": "Explore chemistry like never before with short visual VR lessons."}]}, "developer_name": "MEL Science", "developer_privacy_policy_url": "https://melscience.com/privacy/", "developer_terms_of_service_url": "https://melscience.com/en/terms/", "publisher_name": "MEL Science", "support_website_url": null, "website_url": "https://melscience.com/vr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506746864200007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504728_228548637725438_954679145801973760_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FmvEcTR3OEQ7kNvwEMerdo&_nc_oc=AdpZw3DkjKIVi7OewR1jS-z-P9HeCsKZ2b1BJgYg9eLDTsZMBoldSEV7UgUxF8ojF9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qKWZl8XmPPhJirWdLx8A2M1CD3y5FlZsr3E-
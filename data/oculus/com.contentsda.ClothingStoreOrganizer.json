: ["vocation", "job", "clothingstore", "training"], "long_description": "1. Verify that the product and price tag information match.\n2. Check the color of the garment against the color and name on the price tag, then attach the price tag to the garment.\n3. Insert the pin to secure the anti-theft tag under the garment.\n4. Slide the anti-theft tag onto the pin.\n5. Remove the anti-theft tag.\n6. Hang pants on hangers and display them on the rack.\n7. Handle unexpected situations: If pants of a different type are hung in the wrong location, move them to the correct spot.\n8. Display newly arrived clothing in the correct location.\n9. Clean the mirror using a spray bottle and sponge.\n10. Dispose of any trash on the display rack into the trash bin. 10. Dispose of trash on display racks into the trash can.", "short_description": "Clothing Store Organizer Content designed to enhance the clothing store organization skills of individuals with developmental disabilities through activities such as attaching price tags, displaying items, sorting, cleaning, and more in a virtual reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDA Inc.", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"],
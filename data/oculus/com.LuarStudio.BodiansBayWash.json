scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpfDrTUgwcnzSLcffPQHzqCt-r88szItr9z00unbld-Q&oe=6AFC5E31"}, {"file_name": "SS-01.png", "id": "1593405728955421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1593405732288754_6219565833375539804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YT0yXC7G_gQ7kNvwHMc5pE&_nc_oc=AdoAeIgFBz2jmp1theZWa7xMFuuNv1j-w1ZLQygBAJMElL_QfPmRZjlq3quYmEnpGRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8pkki4j7UcfvzsvNvNCoJwTrn-HtA_Agd5USwgIoeeQ&oe=6AFC7EF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1010530955105658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310734_1010530958438991_4253340002244297284_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyi6PAlznzMQ7kNvwGkbYWM&_nc_oc=AdqovB-p8tmZkNX5nQT_jGKLtW3CSMI4Dg93kXtWvsXyYLuS_vrZ2Ul3DJxIj5hidhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXLx1nUV_069NZwCz9xWMGinMvquXsuDqscC905MxBFA&oe=6AFC61AD"}, "display_name": "Bodians Bay Wash", "keywords": ["Cleaning", "Relaxing", "Ocean", "Simulator", "Kraken"], "long_description": "Welcome to Bodian's Bay Wash - a relaxing cleaning simulator with tycoon \nelements. Find peace at the bottom of the sea while doing the dirty work \nand building a wash station of your own.\n\n\ud83e\uddfc Satisfying Manual Labor\nFeel the reward of a job well done with your own hands.\n{28388452934124616}\n{2300856770741658}\n Blast fine grime with the water gun, then pry off stubborn barnacles with your scraper. Master your tools and leave everything spotless.\n\n\ud83d\udcb0 Invest in Your Business\nEvery job pays. Spend your earnings on furniture, upgrades and better \ngear. A well-equipped station attracts higher-paying clients and unlocks \ntechnology that makes the work easier.\n\n\ud83d\udc0b Clients of Every Size\nNo two days are alike down here. Start with small motorboats and harmless \nrafts. Expand your station, buy new licenses, and the ocean starts sending \nstranger work.\n\nSome clients need a very long scrub. Others you'd rather not keep waiting.\n\n\ud83d\udcdd A note on scope\nBodian's Bay Wash is a 100% Brazilian indie game, built from scratch in \nfour months. The whole team is one developer writing all the code and one \nconcept artist bringing it to life. It's a short, focused game - and we're \njust getting started.", "short_description": "A relaxing underwater cleaning simulator! Use pressure washers and \nscrapers to strip barnacles off boat hulls and expand your very own \nunderwater wash. Buy furniture, upgrade your equipment, and get ready \nfor clients of colossal proportions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neat-hibiscus-588.notion.site/Pol-tica-de-Privacidade-Bodian-s-Bay-Wash-322033dfbd10805e96d1e1a0d5d28730?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Luar Studio", "support_website_url": null, "website_url": "https://luargamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "zh_CN", "de", "ja", "ru", "es", "fr", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28954777794127514"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_1923693888587477_7583856074392783781_n
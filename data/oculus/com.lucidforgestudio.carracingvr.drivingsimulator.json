tclVnIOQ&oe=6A95AEA3"}, {"file_name": "5.png", "id": "2048449576077920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_2048449579411253_8666925175904904242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bWBE-sHcwQQ7kNvwH3BSrt&_nc_oc=AdpV5QXfVnbzGT9JEFWieKr1xnTyOA0AkkFi2boByzeB_M_eOKQZrYZOkfJ4_ugtlHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnORSSmRFT6CkoAdB033_WAerQ1cRxwlP49rxIKbbF9w&oe=6A95BD70"}, {"file_name": "4.png", "id": "1006903105062494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1006903111729160_3575022765786851798_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svtsUzgFUqgQ7kNvwHAO21K&_nc_oc=AdqFnQC6Gnpq-pf8DJqS4tkVOjGByI3w6RnTz4f6hgZMMSzYRL7XU3Qix0SwZggGtq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnzk_5AYj_dREbceXmXayDYyyFxwzMWkFifqjQSFU_Wg&oe=6A95CBF7"}, {"file_name": "3.png", "id": "1349449147068169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1349449150401502_6308199092016863231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkXwfPxKUp4Q7kNvwEtHyq3&_nc_oc=AdrVBzWg5lpWXwg9ZwwCoFUsXBuvzZYbVGyayBQLBqkbRsd9EaVSHVpYcwG9_NOjaTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnKWEXKmxY7hcmPH9DbkE7BKPcfiBW0rsQaCBmwBsF_Q&oe=6A95E37D"}, {"file_name": "2.png", "id": "983145921202991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_983145924536324_7392205013537211601_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mddhhNCyZ0MQ7kNvwFV91bV&_nc_oc=AdojjrZW6r0yvcdRUNR_2mw9D1o6lWZsYGafgGE26_0qeByfgVeltDYUspQMhze7XfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI49AhVAb-cBWs8B15Se5mbsaKybZkg8Wtxvzps2ZoYA&oe=6A95C610"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing VR: Driving Simulator", "keywords": ["carracingvr", "drivingsimulator", "carracinggame", "vrcarracing", "driftcarracing"], "long_description": "Car Racing VR: Driving Simulator delivers an intense and immersive racing experience designed for players who love speed, precision, and realistic driving physics. Step into the world of carracingvr where every turn, drift, and acceleration feels lifelike. This game combines advanced drivingsimulator mechanics with high-quality VR-inspired visuals to create a truly engaging carracinggame experience.\n\nTake control of powerful sports cars, tune your driving skills, and explore dynamic environments built for both beginners and expert racers. Whether you enjoy smooth highway cruising or extreme drift challenges, driftcarracing modes offer nonstop excitement. Feel the adrenaline as you race through detailed tracks, avoid sharp corners, and compete against time in multiple game modes.\n\nThe vrcarracing experience is designed to give players full control with responsive handling, realistic braking systems, and immersive camera angles. Every car behaves differently, making each race unique and challenging. Master the art of drifting, improve your reflexes, and become the top racer in this high-speed world.\n\nWith optimized controls and smooth gameplay, this drivingsimulator allows you to enjoy both casual driving and competitive racing. Unlock new challenges, explore stunning environments, and push your limits in every race. Car Racing VR: Driving Simulator is the ultimate destination for racing fans who want action, realism, and endless fun in one powerful package.", "short_description": "Experience high-speed action in Car Racing VR: Driving Simulator, the ultimate carracingvr experience for thrill lovers. Jump into powerful cars, master sharp turns, and enjoy real drift physics in immersive vrcarracing worlds. Use smooth drivingsimulator controls for realistic handling and intense racing. Enjoy carracinggame modes, driftcarracing challenges, and fast tracks built for speed and precision. Compete in multiple racing environments designed for nonstop action and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1211033852089059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1265591235485695_3033644535407144367_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBtRbhm9wN0Q7kNvwFKpYwi&_nc_oc=Adq-fD_NnF2dD7BAi_EiKWuN9T3g894YgevGhPk-EyYUTIyKH0VTgTqgHW6sHj9kVho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUnC-TqID2f89wyVcq-Dn1IyYdiH_OVpCX08d7N9Hzxw&oe=6A95C2B9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Car Racing VR: Driving Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1782397320, "lastRevision": {"nodes": [{"id": "1211033862089058", "release_type": "SCHEDULED", 
nc_sid=6e7a0a&_nc_ohc=eu7hlQurLuYQ7kNvwGRA34H&_nc_oc=Adr-5W1PspzR8aD7CFmEars1ERPHGi8IoLaIDxBDTO3J8V3hzS4v1ejkeP_UQUdmkB0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AfTvlLLVx4KKATUnAqCxbxhr63IUQeTra9np-3Ec1og&oe=69EF4D75"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8ZpYQJAVs4Q7kNvwEPZCta&_nc_oc=AdqPH8jSEK4SbGZqUESQW-1dJjfR5q_vkQPTi26RIayVTe33aBz9xA96UJmPTl5qg50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y68Qw0fsGsP1WErWvvWAMiEqf6Y8pJQFXkB65m1pYMA&oe=69EF4DF1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKjaeKDq2LwQ7kNvwHS7E6r&_nc_oc=AdrpNjpg7zL3g4zfnwQRYnKW7svFNFnZYjT4bmBB_J-Qf7fxaNGnyROMgYYZe3GOe2g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Xwfw1foDzAgjmA_rEMCUPjtFmL1cw7-vAJz_2ecYtIg&oe=69EF6864"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP121QyomssQ7kNvwEi_fv8&_nc_oc=AdoWhuH8zEZXh056wEpUEK7tRih8huDpW9-LG3cQoV892YkTouer9Fcb6hU-rvjicB0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dg0VToqIraRc6_O3O_Lttv1INkz6Cv41-xAIxPZQwrA&oe=69EF7F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPS8fNmyXKAQ7kNvwEgFB4F&_nc_oc=AdqGqp79mKmRFRmc_rI-yowai49XjpIXZTsdMDmpvKnqd4fI4fiwGoHB9vA3rEWHfmg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01d-81rI4Kt1-Ru9GcIgU-FDy8oiH85HDlEpwG1uAY3A&oe=69EF5E6A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
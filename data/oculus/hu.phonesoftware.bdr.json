nc_sid=6e7a0a&_nc_ohc=8LAXZQRWys8Q7kNvwHMoh6Y&_nc_oc=AdomClvSeB_xM5DLXfXDhP3WnKtLvMHGYl_CbjxgNYLuYR79L400J_S488A_hD0QzNw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LmZW-1RuhuZFoFDb8-gyaddq_BVK_bwzqv-FzqN0AOg&oe=6A26E4B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=friBbEhqzeoQ7kNvwFCW6V4&_nc_oc=AdpcFPmukW1gLWxur63MsFey4oqDQ9Ee8s5krhONHjAdm0BnGPSNAQJwHiI2MOEHiaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93YeIdnLKZiULp0fx6-AK46q9dSuNpkF5c13jCmj41dA&oe=6A26E531"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCmp-krnDIkQ7kNvwFYFjEX&_nc_oc=AdqLTl8qfkdPSp1sEFWAi_XEiB4Arqx_LsyG0hWN_EfuOZhnqASh-pUWP8WWTXhDgpI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82ogdZ2ZzzXKEYrqjbKj4TfcGBPDp9yVXl5gw2Xpp5VA&oe=6A26C764"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-NhVTizx44Q7kNvwHNuUmj&_nc_oc=AdoWYn1pwuAgpHPToM86cfnJpfW_uoC1p4_pnSUVtemrzJNuCN4xeCHuCOIh6ahKtmY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UhnK5elPLPmlzwG0wMaaIO2FTg7E1FF-T9a-XDBdMsQ&oe=6A26DE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE2bSVD--CoQ7kNvwHLf24k&_nc_oc=Adp5Z7HY6K95EZMUkJvdGV25K7HVZwwCM5Bj_Jqr5gfi7rrLPVkKhpQ12-bQEs4cGuw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l8Ps4RXjdxjZM8jaeEzXIi33VhzXyCAaUNLOniHM2fQ&oe=6A26BD6A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
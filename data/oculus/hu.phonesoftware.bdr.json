nc_sid=6e7a0a&_nc_ohc=38xOJZtmzkAQ7kNvwFO2mn2&_nc_oc=Adp6y7Oc8psAEN7sxKbspHJhzlwXbbeGm9groi3kKVT9XQkVHjnp3MkREy_nNLHe-U0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCo1lhSHRshWXHT1Nkva45dsAi-xcOLUnk4qUSDWiBeg&oe=6A79BAF5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jvljoh6-AMQ7kNvwE361P4&_nc_oc=Adp7HKMlqMACjDud-T2jAqc2uATswl26cSwQuyZNc5viNMhDU0CUt2olBTRthXs6yaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz2fCNKy7B8zuKwuA2Cn8VePoJrg1kZo3IL6A6vnwwsw&oe=6A79BB71"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWivIxpXTjAQ7kNvwH3OZE8&_nc_oc=Adp_BHD3WdXhg2NgX9id75HAj-QyHev85UJkUn7UBp_YN_hW8-h39O2IIYIUsTKWnrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAeGQ-0e3pHLZFjQ0k8nDFW0I3F5uDHMkpcHvQuf_i4w&oe=6A79D5E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojneCWd-JYUQ7kNvwFVDORz&_nc_oc=AdrC015KLbBz_TUqnusKHnLhwBDFVSnvOb9JXAHm3tluEsyMlg066ArI5fgzzfjrD1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_i42EKLMGc2gPhhXXllFv8AE8VZNi_xoumYCodQhBlA&oe=6A79B45B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYXvwZ7QfWQQ7kNvwFifHe4&_nc_oc=AdpO3BchTtRl2zjIqJ88JPnJWowpP1pCArLFyX4sCGNqSwcJQa4PsOUvELG3FRJHFSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO4aLT75HTgEP0x8O5tFEZV2gUt0m10UgVhl-po4NA7A&oe=6A79CBEA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
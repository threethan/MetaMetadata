nc_sid=6e7a0a&_nc_ohc=a22GnhCHelQQ7kNvwFvm2jI&_nc_oc=AdouLeiyWqdGbQrwVV4z7pWs0nBOSlHa6E6EfmxaDoidoUknUsMhCTNCFVPApT3w4_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gEEuEpkW77en7JL3Fh0icelLqxNblrHkExeUYPO_raQ&oe=69EA0775"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf-tAVQW8AgQ7kNvwGCFqN-&_nc_oc=AdorOnb1P_MZVl5Sr_s-VwkKlXS2bO62MNXDjqd4miSCf3LZrXnjJzJvA2KOSqo5Dbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EZPKrYT8BgTGtGNETIp7BKBIkC8XjOyILp8kUajj1RA&oe=69EA07F1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6iu7M22MPoQ7kNvwFD-noQ&_nc_oc=Adq6LcYnV3f2V0aHkHdB8uVBy7uP2gPotnStDsCb50bWCfRLoN4jHp-llAj0A-DRf3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rmdCiiZMqJgwBPxpNS_VjNQ9ur5Tyr8pwKHPFrjtNaw&oe=69EA2264"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRKzoKgl-CEQ7kNvwEs9HnG&_nc_oc=AdpmCCtU7Co70D0oP-lPlKypRqrrGqcBkj8Prv3WJO5kTdz6Q9NcSZjh6jbsKyv0vBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HMElOQ9xvHZzN4z2a-Lfkc5nYVjO-WIb2ZcXPZI7jug&oe=69EA391B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loSbbNhcgeIQ7kNvwElOlFi&_nc_oc=AdrlW9yle9eD3zy1i_XAckDGPuRyTJs9t2SDMzdoD68fQnhnxuSkwgpPT9K5gbVQz5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10xkuBLKdyQPDABCNaMfCS8La5nE4AJz9UIxr9Z0uElQ&oe=69EA186A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
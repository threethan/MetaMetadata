nc_sid=6e7a0a&_nc_ohc=8LAXZQRWys8Q7kNvwFqgfSz&_nc_oc=Adpgjd-_3nandbwrUAUILhSPpDiu58MJR-Ai4I_VXmsxljSXj02u4GfgaIdXbQmqCiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VJ_SO3umsLzkipHVrSYaAe289yGMgm1NGES5BDurL8Q&oe=6A283635"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=friBbEhqzeoQ7kNvwEMCafD&_nc_oc=Adp5cXLMFFnzrd-0aY3wEvnrAx2Bk-Ti2kriNe0qeKLQLdRUNH0aDXtKk3v0qLE_MxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ppp-MaQISY026FeQTSo5ad0T_0ji-hruWMGW6Vk3Qvw&oe=6A2836B1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCmp-krnDIkQ7kNvwG5yI45&_nc_oc=Adr2M6_GRUmcneVRa4iTeZyliu6lZE9UPR2N7_gci4WMAsVHwdux07mbDOexCsGLlJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fdMG0rgsw1bZkmLfesHxEiKEUzCbWY0Q3Tw2M9jaAow&oe=6A2818E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-NhVTizx44Q7kNvwE8naSR&_nc_oc=Adrf9Q9lxE9fWNzM5gJvK7DnPxTwHOIH3Y7FKYTy2dwd4nWLTRbRRlwKwf5eoUo5eas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WndPXAe8g8xkBgUUhOyopa2EBEN4Dr-3Sg72cSughkg&oe=6A282F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXKAr2pECmUQ7kNvwHB_wA6&_nc_oc=AdrpBDUtmj8nHWqZwdYIb4adfnBkQGo0nq6Pj2nq6VpLTkVJ1qeX6QbiutvoNAH6NSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g08U5reQnsxuU0kl9TivNmbwV4q9hqDmdgFR5rZKvZw&oe=6A280EEA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
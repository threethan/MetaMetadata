nc_sid=6e7a0a&_nc_ohc=_DCi833dviAQ7kNvwH70aSY&_nc_oc=AdpRpQIPWrgAW1akZq4q659UAOLwvDPtIv8PbxdckNltUjKzj8mHRX2aT5qHCG4qUNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFTtr8W4Kwjo9Q53lIZRge8eqC9tl7-mpBvvbFAxebBA&oe=6ABD2FB5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-itFLHtkyK8Q7kNvwGZfx27&_nc_oc=AdrQhygW262vhxTSO4o99hsRTeemDnTecN5psF7_TK-X6_K2i1lv2gAIt0E4eIgTL4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1YoLwRQpSsSplu_ajztnaCulH5Kc7za97p3KtXISKfw&oe=6ABD3031"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jrY5tfoTusQ7kNvwFugtyK&_nc_oc=Adr0FsQ909M-QadlwDyIbBvI_CD-Wk6aYRMUWb5Tn9AJi0zWT-KW3m2o9cnyKW3nBpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsMYUJHk8gD-DeUbN-2F4ijTkZSKMXsTIdGtBv_fmfQw&oe=6ABD1264"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmEj4tk_rL0Q7kNvwG07qnp&_nc_oc=Adqd1nckElDrTK1VI0wf3gk4pwGlA19HN515L9s-tDdTieubqXerYV1YBo5uJMwU4PI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxatr5k_ZmbbpRBGwHc0wZqCndkU-ph6nQP8I_OKSxNg&oe=6ABD291B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzuII84VA1UQ7kNvwHr5XfD&_nc_oc=AdqExTN-38YUsb7hXPZG0e2BV2moxvRrBBA8jE1ZN3VOSDzT_1BwJGu2O1xq63L4Eho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-xRr7YjyzbUQUOkHeWG7sAoaN7p_1xaieg0TgyNtzCw&oe=6ABD086A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
nc_sid=6e7a0a&_nc_ohc=ZGmtCNAiG_IQ7kNvwES363E&_nc_oc=Adoj8LoHo66lkYvBN9H08WuaGG-6SxItfKu588zm3gjN8T_cxxI4mZBp4VQqc53l2cI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3x-y0J5IuwqmCV1pii03gEmQbYpjSnDuVPpDaD_m81g&oe=6AB93B35"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqjr1yrfRCIQ7kNvwHSU4L8&_nc_oc=Adq7c0jQ9v2VlpfG-j1w7ybBlnDCKQ--U05jevN0CEy0fOAujkMvy6BSkAWRtiS54sg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXc4tdYbAzlYLj4GAtkhIRCiaRm6fk2p8Ebjx8zcReSA&oe=6AB93BB1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZziM_MubiusQ7kNvwFVA1GL&_nc_oc=AdoXn6NtmKXXLtzrab0LjBhel6p9EOU5FxhRseVc5ZOxxrrL0xSFVCQ_r-xLU7LrtCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdTtL15hU4LDxYw_JP8A2xFqpv_thI9cHj3aFLiY1whQ&oe=6AB91DE4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT3OWg-a-jsQ7kNvwHe-Q59&_nc_oc=Ado2cNVWD2GItQiEAmk87IrQCr60DnAWVryqzt5-XxgtsBWIygk20WjXUWcXYXVZdCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfV8m03nhE3nADV6bR4JiGhpo9XzuVgBDXH56ha4AXtQ&oe=6AB9349B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE0JDr6bBbsQ7kNvwE7TZ3F&_nc_oc=Adq6feMMuWYzfO39P4kkV6CqV-vbbQ5bIW0SlFAPnDssg1orEOE4qVHU2Q1rurNFoVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSSE9qaoM8YEO93HHAvq3c-bBhzkcumd0T1PgLebfCfA&oe=6AB913EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
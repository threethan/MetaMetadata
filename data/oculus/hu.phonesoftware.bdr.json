nc_sid=6e7a0a&_nc_ohc=9F8Eito5jooQ7kNvwGkUdoI&_nc_oc=Adp8Pmvi_mCNxQscp6sfg1hizkL_SrhLk4ynP0jT1TDIGSus6qkE98HsPFrNYGz1BgE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKakF5u7pvTpdpu0uwpn-PVOVQSs2DJMcutyUAyEfWnDg&oe=6AA18035"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJJpFcbWmDkQ7kNvwEHEjna&_nc_oc=Adr5yr8rCruRVVHAfCLjzR1HlqcwO3IIGhs1wHbPQ7-YLxYH6D_PJSG3TBVyqsA1mJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ2111Iy5QUOvHjpS3vcglOAEave4ooTSTf6BatJ37Kw&oe=6AA180B1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CInJOMaulnoQ7kNvwHBXOgO&_nc_oc=AdoGj67nbjsCdK5Qz4G15XlqVznFyaZC817KifxiJ1T_DOm45-QpB-qCkhoWglp5QF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3iBG6fta1Rra-TQx9ERRDbsSW65UpuOv965-E5f6dDw&oe=6AA162E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR7BbY7qb3AQ7kNvwEBzIEw&_nc_oc=Adrh-uoLwYGhy7DyUEPbR3J29c_h8m9rhtcXf08uStVvZCOxNnYKpspUz1_MP4wWHjs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWKHp-BvzYBh0J5eV5nxt1-Nd6UyPef5hn3jZeHvg1uw&oe=6AA1799B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR6yZPFmMg4Q7kNvwHLg1Cn&_nc_oc=AdrLWqy7dsSfIolrldEvtsoWFyCUPGExBjU8IbeXUla9kxc094WLJ7ldXUIC7f1Iw40&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqvb4bRl4h7PzztbPB9FydgZ9kWgvBvn5GrODF0A1q-g&oe=6AA158EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
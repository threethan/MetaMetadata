nc_sid=6e7a0a&_nc_ohc=a22GnhCHelQQ7kNvwGc0LDW&_nc_oc=Adp3yfSGxWLD_92HcvuJYCBCO8XF6yETHKBRKjXviX5D8MD2LUVsJx0vdbd8SPm8LUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12Ux9y8Cwi1OMK0DJyipFFaHz7cWqbIz-zy_mLg5mEkA&oe=69E8B5F5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5X5ymdK2LoQ7kNvwF0uTU5&_nc_oc=Ado8Ly7d7VXdyJqVjsEXKSQWhrr4J6Sfeq-d2vouQLhKc393DcXCjRc_H3PJzOKduIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bXF_ozEvu16oJ4MY59-d5Wlpw90yrbwAdDGQsQwgOKQ&oe=69E8B671"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCJVvCQ7lp4Q7kNvwHEv-Aw&_nc_oc=AdpR-oQDpWfmZgXV6KOnLfgdHNN7Anv7Q8eTXRgOqO7-Yt6CZVHzkyRgMmcxg9Z3qCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cSLZ1csylc_UKXWexxbqv57l5o4U6QKh81hed_CPyJA&oe=69E8D0E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRKzoKgl-CEQ7kNvwGTXqzp&_nc_oc=AdpkuK_svMQwlf23LENPW_fErrd_WW2baSMF1jFrXmiP8HVHJAP3EIaaQ8fxn7_XWc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LZCqvTWfaNaEzdqSpIUe5R9QrPRaGSW0gxJRDMnIxag&oe=69E8AF5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loSbbNhcgeIQ7kNvwHmCcjt&_nc_oc=AdoIcjYSS11FcKrr1NJ-m_PyppWqKKVHk1pkWSGk92P6PttrFHBjq3rjddp11wblM_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kipPaP7IjRWMNJ5RVuvGU3SbCrql2jqTIeU34hRZ0Xg&oe=69E8C6EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
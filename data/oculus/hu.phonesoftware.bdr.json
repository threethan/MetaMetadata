nc_sid=6e7a0a&_nc_ohc=2fwShO7zRBcQ7kNvwEDenQJ&_nc_oc=AdpORm1xaQCFWBIqVzqRwu6THKtgfkLI-5OT8RR_nROiT2Q_fV8KlV5RE2KH5aaezcc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVNL5eFBtSvLPRq3g_p4T3S3M3PgPa2S7EoFyNvBVMiw&oe=6A5A16F5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O0FRuqvo_4Q7kNvwGhaHAi&_nc_oc=AdrVOUdz8aTnKcqLUE8kjV8SPHocmIM8JMv1T2imKssY9CKJHaTMRo2Hlp6QfDc3hfA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqq2p-5-0jQxUbTk-MtzYECH_e0aftfxG7aSrbefeXRw&oe=6A5A1771"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYoqZAARTRgQ7kNvwE2cf_1&_nc_oc=AdpsAiqa_JCxxju_1uXseOf0FFg5i_kOTb18BTLHPvaS14kc5V0_CVE4uldwNS8Mizk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADd55gzAIIYmwcjC_2iYAoiUXn2sIwcS-IvBcQlIlNhg&oe=6A5A31E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EArAVFFEn4IQ7kNvwEvKzZq&_nc_oc=Adpy01N3XIPR8Plm_NU9iBeaRxRDZYJcXXTVMJfQcQiPNL7d3i8chua9-f3qnbe4zzc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMKm3cvN-o_oY_sCJqo_wSSgcTKqsqTJF44lfvn1HPuA&oe=6A5A489B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75n892PM5-gQ7kNvwHkxzm9&_nc_oc=Ado2JMY2rfJGhZ0buRFCsuMH_p9hQP5S6-CIzSszGejGafF3Mk9hT1VfChQCHuZZDns&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH2WrY4JjhpGzz4MiJjX9LSNl-erZvkDpaihZp9Q-B2g&oe=6A5A27EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
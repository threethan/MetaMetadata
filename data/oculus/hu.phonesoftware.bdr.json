nc_sid=6e7a0a&_nc_ohc=n-KPQNjre-QQ7kNvwFBLrew&_nc_oc=AdpJmI-qhBvq3YD_gxSX7GOtgLD7aTwokUB8zZ3UbT3lDtjPOh2Z2XA7wKi8RxXnanI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ihCdeSIOfqR9irxNvFn7TfzbAFh9IL-QC73Q2JkgZaw&oe=6A0F29B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztbw2828uukQ7kNvwE70v4E&_nc_oc=AdpKxo2ojn9mfCoxl68nxBzGSJLlMBRCzv8bhGTMhodqfiE7mUYJ5OxBj_MmTr8PelQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zYlZ_ZWxo4ZGByZiskeYZriQKronKTpxX4XeO-JJ3Hw&oe=6A0F2A31"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhAFQR1A6_cQ7kNvwE8Pg_p&_nc_oc=Ado9s3FfVgDd2FdrMPiB2G-b4PCmfQnOJ9FECbDmf0F7fV7gWrlmJHmRUo9vN9QNyEQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nlqdJAviD1cn-oLK1CibWm6ZqcGPO3AF6AlMxPGgB_A&oe=6A0F0C64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_6BWMnVLVkQ7kNvwHZw3Bl&_nc_oc=AdqkppHxxpvQgbmiFoxAlvKKnEi9uANSLUxqehc3uHM_jMOU_VaI2iYHirbU3R8kaTU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DKcP7UR9KctjsrkXT5cxJ4zDwRc14RoVzkRsGKriZOw&oe=6A0F231B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96JWkYVNfvUQ7kNvwEtB2rY&_nc_oc=AdqG0TKVuF0FHN2xKUxLnaSUJ-OBxnzCKL6H8zLMU3Ytb7ginkMs-ELmsX_d_Ja3fuA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VuIpn3eQpwE4AvTyDzcBoVqlqlgQjEi6SNXoKD7O_1A&oe=6A0F026A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
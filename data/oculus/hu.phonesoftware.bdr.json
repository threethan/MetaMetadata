nc_sid=6e7a0a&_nc_ohc=VxmJFeEpRaoQ7kNvwFKv-Is&_nc_oc=AdqOaz4tCruomdiloitTOMJ6JZKTmgj8ofywGCmp9QkjZVsCbWdsCveIc9Ti8Ci1dvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBigVAqXq_Jf5bhaN5lcSoqop7Rw0ryVBDC6iJiExCBjg&oe=6A6C8BF5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os7nyWVlJvYQ7kNvwG_yOQR&_nc_oc=AdosidbFH33xHMKcZbzXGVfqDfKGum44yMURyMK7x6kWLgVwgc7EUSrKn_FsHXXQruw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEeW8_mE8Fp0S3nauwhVdD3WDtv3QrLY5JWkjIFQLX_w&oe=6A6C8C71"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHG9LLBDUZAQ7kNvwF3xM12&_nc_oc=Adr7FqsKz6eFmZhWWqKC9A9gK3DdN1JqCA2S3peGb1kmGR9MW-FMSewo5avRGRwp_7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBFf-KJLCRYGtmJHpslLRBz6w-_UrR6b6e8WN1gHMonQ&oe=6A6CA6E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OGT_ND4fTUQ7kNvwFnrSgy&_nc_oc=Adrrrd5pxzLu3jew61CCQYZ9VJbZCOivBGDfoYhI7jdN_CuQgt6AqMGsIeCBeQC-V2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlKx1VhFTLJlGV3bMUumSRFCFZ9Rh0nS3IpbFD2DWlBg&oe=6A6CBD9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy7k6uPubGcQ7kNvwHXMhBo&_nc_oc=AdoYf03SqHweJMeMFYAH74ixRsrEGIByq5Cr6M4YB1BgHSHeJOOphkspkWf0E50mXRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRfIbGpbRQ4-990aECTyqp1m6eLA-iVEONhw6p24nFKQ&oe=6A6C9CEA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
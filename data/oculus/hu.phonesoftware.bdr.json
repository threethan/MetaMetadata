nc_sid=6e7a0a&_nc_ohc=ZGmtCNAiG_IQ7kNvwHyUXLB&_nc_oc=AdpPK1n85Lf0LlvRd7Er1zdWBzrpLirilvdaofEixt4acXHfKcD41SRE6ZOCtGVZCUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvMk8H9ZN4phT-XT7F6ckRPl2ls0YKVfdZbYwg2PaTAQ&oe=6AB7E9B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqjr1yrfRCIQ7kNvwGgtVRs&_nc_oc=Adr6GOXyDcEX0ZGaP4VwXQBvu84CFziA9yeOBRjcRVN5aLHSFTt2rBQz_QJtCHRTp-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmRtoyogOxM43Ef91LklY_DmLt_xeun-CswOVsibZF9A&oe=6AB7EA31"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZziM_MubiusQ7kNvwGFapXT&_nc_oc=AdqqusaEf92v2R6VvmrJJm_dhZqLZcQm9wji9PGTvKvt75SXW1EmFNV3aR8sG7I4ygE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY6SHiL3Qxthd8_Mc8kSeXaEvzWHb1rmtW66Iu-jNaUg&oe=6AB7CC64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz_jBdAwABEQ7kNvwH-39sZ&_nc_oc=AdpJ_041bFnXBCdkKzzD_ews3qRb08c0_VlH6INmnIc1hiiV3Ut-mkDIev-IBsA-4Ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcaOaXGMpap-jt1znc4-rPKuboL9ymFapFFMaDfFk0yA&oe=6AB7E31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE0JDr6bBbsQ7kNvwHsvHlw&_nc_oc=AdrldoyDxA-alFypnDq0tK9C5RqbtfNWSC16ETytd-bptaVuUp-BV5akUxpGR-XPPrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSiRo27dGJfA2zp5vUYPY56OYvm6iAmbPMMwJ5vst3jg&oe=6AB7C26A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
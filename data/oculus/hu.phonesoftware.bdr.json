nc_sid=6e7a0a&_nc_ohc=9F8Eito5jooQ7kNvwFNihWm&_nc_oc=Adq_O1LTfdstXv3L025c3RItCIR_z3sC3yJN24lLuZ9qsbN8hXQcbdlmFqx8cS98hQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEQsgwYZu4R_tAV73hllHC7qpfxvJunNTZf3_a2266Ng&oe=6A9EDD35"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYexJ6ZUchUQ7kNvwG3ZPsA&_nc_oc=AdrzM7HyXZVOXsCiiwcANMw1YahiaPRp7fbx425or6CBj6T7gd1r9o4tp8wV1Bo-G1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLUd-4_8JYePY34o-7bVccDBmgqQJQu21W43891RxPBQ&oe=6A9EDDB1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR1ST7UBc40Q7kNvwGFaVe5&_nc_oc=AdrMae-FlSX5CtW-BXmFoNrRVInsd8ts7xYCVbf4nYKsnp5h9pO5MstxkRLGZupCBuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw-Si0Ngz4Zw2BKF-QUFGJuHFM3v_2jl29Y7SHZpEziA&oe=6A9EBFE4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se3Hbco83g4Q7kNvwGbLtrQ&_nc_oc=AdpQMQ8xsn7b9sZyYik5RY2OwAb2HvblM1B73kqZPQtudXwJ1M_5TZG4YqpAC8UZNOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeNe-H5nrxGCJFq-vxLqwMVyHfQOS3pZ32leBH0TcSlg&oe=6A9ED69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR6yZPFmMg4Q7kNvwEETBLR&_nc_oc=AdrYm-27DIlkH5tONoU8dzpMDlJIfxnATpcQ3Rcp7uKloh8n-DrEwMJp16Yutjfn0h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_Es2qUsxRc_ODcHdxx3z2az-SBvteb7IGvytZDgRQlw&oe=6A9EB5EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
QQ7kNvwH-pSXt&_nc_oc=AdnGrvqEwSMJPGyx9cawwdtOWi48LgpdPkFHPLY6fGDSq-_SEcbchMBWtl81ELocc9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaIC8_r89Ksf-XPoLXNG6hi35NhiRcidXJAOeilDRDVg&oe=69B156F5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUB00pXiAdkQ7kNvwEJsn62&_nc_oc=AdkZSj255PTBYqG20lT5MlyeMYH49QDfZmd7z4TLeJ6x_5b28TP4kAgEElgApmjGGCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBS9l-sqHfE-TxL06GEo4c6VcCuGGDZAPIxRWAFd25vA&oe=69B15771"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I3QDBY0Fl8Q7kNvwHSIfwk&_nc_oc=Adk_gh90CFGGLxHouT5m8T4tY6WMu9OeU1dglFR-moeivC3RPPkysafiWhIVyixZsac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzp8Z8IwGeGIAPnrrpgi3cxdus3FCnnvR160FARCoIdg&oe=69B171E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnQSb-JtNwkQ7kNvwE4Ctyz&_nc_oc=AdlyHHXtwvJ8Uu9nbIMzgKWgb7tzqCEJ5RhI0KwkeRDMYat0L03esKOhb66Z7yf_Ius&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlxlIvUqpTcAZK_Q0qNe28eD6tEps0i1BmS38lTzOO-w&oe=69B1505B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRniRHfjfVEQ7kNvwGJaCTK&_nc_oc=AdkrkS2Ytfzc-yqUmEWlOs_W90gRJAyZTGmqjSCQJ5gbKsZO_v226QbXKcJQmDhXZiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh1LHLWEW8dt92EAFhhOqyLDd2Epj-J6voBIo4jTbkBw&oe=69B167EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
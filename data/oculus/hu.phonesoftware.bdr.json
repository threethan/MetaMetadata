nc_sid=6e7a0a&_nc_ohc=sC0OpFJx6BcQ7kNvwHMquts&_nc_oc=AdoqLO7RbhLpKpyBxKZGu42U83bTnT1JMR-95z4qK4NoWwMPO6PYMyc2PNcHMAbiOS4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgvYGExPRenVmf51I0eCmIU7YyN0-45qJ4_2aqtDOwMQ&oe=6AECA5B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scQrL6NSr4kQ7kNvwGW7g51&_nc_oc=AdqXslSrq1Bq-qbf_ddS53nSpG4Kg333d9CrPTtFBJBo0vZBczhowTx-rAd4sKe54oU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq7L4SmCspyTTX9ostjvv9SNMepQzdCml6_UaIU79Gnw&oe=6AECA631"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKFhsk-x9I0Q7kNvwHDY5rL&_nc_oc=AdrlgHx8OCA1dUu1d41Z7qbFRYSDDca6hWg1ZtAahIUeS0QenTwfZpbZI2CBoamCiaQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF7kcbKasQlqWbYIGWdi_q4SYBI43m0lWjUHlD4OcVxA&oe=6AEC8864"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sjKxgQTs54Q7kNvwGgc6Ki&_nc_oc=AdpryRfrvaiInXSVAbYmHyj6QA3P3edXLW08nS1hOs-YYXcj8LjNPt8XuyNc5jyxGIQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8LO_yiq4-vS-73rDQOuOP9gn4ioxrEFQHeKtLtDOQfw&oe=6AEC9F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDN_wXcVYMoQ7kNvwG8pDVV&_nc_oc=AdocmzH-73KCCPPl-xv-xg9_-hEDgPJyXMtmobNBJviBRNHkcSfDlIeLgSfqrLkLXkU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4B24anFpkcl0hRnM8EdnN6Ne52FqFjueiOOZRNFQWsw&oe=6AECB6AA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
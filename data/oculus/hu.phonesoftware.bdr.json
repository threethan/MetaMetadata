gQ7kNvwGQYKjo&_nc_oc=Adm8O0B24YAjJh-MKikQsTxoJlaNzlo3YIC636UWUa4DhtTwDediOLhaBc28Z4AZNhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHqfQXYvjR82Gque7K-ZHdb2opBbbUfl_ZxSD_cNHCJQ&oe=69BE85F5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWwpkaR_CyEQ7kNvwFvjf4P&_nc_oc=Adm_KcyLfJ0645ZPh1KNOOxPmMvU8rJaJK8ZoMt4K3eev8xJ9WtqP1djqzS00qFG_n8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-wLqeVqVLIVckgl1aDTOgHLCSlMDvlVkBUdbyQobNeg&oe=69BE8671"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGP-GMJtBzoQ7kNvwF7OId8&_nc_oc=AdnfTaPpfmhWu4JzkGFysLkMfw01RhYZ8UG5wPV12AImuwTnZZRDOp_tSTv9LzDZb_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7JZCmAxzJkGLeDWElevItb9-nHwNB0W6NevPqJbd8yQ&oe=69BEA0E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIXdM66mhOAQ7kNvwGSzISr&_nc_oc=AdkKc5r_IBfCX1NFN4iQvoL-NmdUxbcDCZrG7M0tdWnSHQwsx9lmjFWcHAfeH_caYrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbI4QNAWoVQcVm4VhP_q1MEPe46BTwLudyKYUDCUROKQ&oe=69BE7F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ncLYsv31SgQ7kNvwGpekrA&_nc_oc=AdmbdzKbAr2VdP35G26fkhcymO-NyH6YdTFLnNxiaGBOmVK-VB0oTtT64NtvOKFjBPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ-vt_BOQ4PBAbXed5l4sDR-5gikYu_HMyfiBTGq1dOA&oe=69BE96EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
nc_sid=6e7a0a&_nc_ohc=3K8bKPGiTdkQ7kNvwEP1jkr&_nc_oc=Adq14o5DobbYt3eJ3eiQL36o7i1uV8x_Tx-mQFywRBTjUYOxZ4tFoLboseei_k7MgP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cTVTuKKPTDyTzz-i_bBP8vNYnFhQ8qKbTedd7xd8lAw&oe=69E4C175"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RSZLjp_i-QQ7kNvwFgRywq&_nc_oc=Adp5VyWGXdAZOsHPiA9JlJwYdWb0frJlN9bqOHkfcIW3ss2g7xVOh7GrKmO5-nkUt7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af175CTwnfB4J9XCXJTdKtGK1SlvNyHvn_PM2BYPxcEHYw&oe=69E4C1F1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62KssMSEB2IQ7kNvwGcM0gO&_nc_oc=AdoIGCGtAMxC0P7puZFcZDVXxeSZiQXL9zLXzpltYGX1zrisvqMAEwjqFcmx9DIWuck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C__8JAbqs5Ol1EQ70T6m8iRswBMcDfhzKVEXWFN4KtQ&oe=69E4DC64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_k2KJCoeNEQ7kNvwGpcM5u&_nc_oc=AdqMuSW2IpyDJYt3_BCFNK9vduTTYfcrApWyRZsuKzpdQdteoqBlZZY6Mu8s1Al02Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I8bwpoGIuD7TL-Vu1ODrC1V6XaeNd3wcTB3mnBnVblw&oe=69E4BADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJgG_C98R00Q7kNvwEdxmsN&_nc_oc=Ado2ijkrl5A1a1lDdbDWhhU5bAF7227-U-OqcDDU2o197LQidX_noTB-5i-kXQm6TIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QQEVmIYl0NCQq_W5QlWFCNsPL8Mn7YLyG3wM3X8ytGQ&oe=69E4D26A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
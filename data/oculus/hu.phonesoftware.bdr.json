nc_sid=6e7a0a&_nc_ohc=1S5XGMqvCxcQ7kNvwEgn2bq&_nc_oc=AdqlPCX66kBKr9D4Nkhwjr4RxGWdyVj9TY_GflA4bVmJ0AwGWf_yI3DsmO8ltgFPW1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbqX1YGOM6MbxMOC_WF0_aPjOgJFIFmNHUhYEdXgsDMg&oe=6A708075"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq7HxWFos1MQ7kNvwGHHdoD&_nc_oc=Adp4xfyvhycHcb9pUKxsIqAD1zXvFNeNnOVrvSZWts6fpg4TcdIhWlk7se_SdLWjLYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG_sl9OOsd2wjurruBxKP8wL1ZJHhpeU3Vyr8fXrHm3g&oe=6A7080F1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXytCNH3QOsQ7kNvwFq0_ng&_nc_oc=AdrUfE0pu8bQ9l7-FqR37C5AKWrNm7PVObAv0v65Tl2BP1uJFRGihp5Xb6xphrYrkW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOF-2GFUkd703rDmfOvcgP3P_2x6bkWA9KTptc0S4rwQ&oe=6A709B64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XtlslZx4RQQ7kNvwFf-fIz&_nc_oc=AdoWi049VVj_VA64tUZyUL5Xjy8yctduRuJKtuDI7Ff-SL2JYrrLZIL6NaFYnP7EDZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRPcWzlq-BSNsxIU6FY5kz35s7AIdC7f7jk57nGlIfBA&oe=6A7079DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zSl-f-a_zEQ7kNvwHXJXBN&_nc_oc=AdrEdRPH5WQiIcL8qSZoMLLzSgO0mfWgZdnPNNhckbM1QqBIC2R2CWf-po-vPWPR6bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo1459sCm5N5lLZ_G1On2ftnidazAJ5iJERmqwPO6vvA&oe=6A70916A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
nc_sid=6e7a0a&_nc_ohc=PtFBA9CWmQcQ7kNvwFbTo10&_nc_oc=AdquHXjKBniav9K4yRwvXpYGBp_i1o9uMYMnGDOtKidVvSsYXFciQGec0PonWevQiOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TSRRHTq2E0v8BmVD04nPqUsXhj64ML9PIfml7VD43xA&oe=6A2D7C35"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpJs3onYkXsQ7kNvwFJS-ic&_nc_oc=Ado2utMRCenEA2LRZPvbzAckg3BXIZbbRDxycEKxTGt7mbnOdP-uQ6Ios2tPupOoMP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gcU3i57XJypQNEcmNoFOmME8zPkB68dOvSIN-raw03Q&oe=6A2D7CB1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOiNBy4sYjsQ7kNvwFH2GXt&_nc_oc=AdpILA5nBKZK-sUXVQD7t0EKKmsztZSCHsYnTFYxm5Q-Fm_mCA2bVa0qbX-xG1iAmxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jFrhouc6sJ9Tsr0SJdnQQ722feT82TUo-US_041jdvQ&oe=6A2D5EE4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73EmN4nTxkQQ7kNvwGpftvL&_nc_oc=AdqaKbVfHd_yLOW1gv6srr8mFsn1DNX36VfOg_ta-8Ksjz6yzuX2tClWBakGT5z8EgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BGgvWZOXBenfrj1wBlqLtexYmDoh4CTjjQ6kFPn1MyA&oe=6A2D759B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCQNIeQ_eVgQ7kNvwHUpWB4&_nc_oc=Ado7iExAx2rPco1J9Njo4iU0Lac8TZqkFnqoN8-BFL8vOOVJzwGyRiF2ae1VefnBK68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CrTg6UCmoYa2HyJ608nsFQ9w0SPu2AsKdIp61zeulug&oe=6A2D54EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
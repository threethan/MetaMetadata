WD6XD5stmR_TM-uM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbF-d4Dg-xsf_Uj6wJNH36qDHsl8L7I_1qRSqnQiaQnQ&oe=69A6CAF5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tg25Q9ixJcQ7kNvwGTWgDI&_nc_oc=Adk1RD_sCGo8flX3S0h6-1S2gSgbJ576EJwqNGKK0UpHoGiMyaLkqg_fOsc3XGK0n98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNs_GGaI5s0YH0kRiy---uv1WDnPlsp2BloEoB0x2lZQ&oe=69A6CB71"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbOuGgNZvqwQ7kNvwEON0kI&_nc_oc=AdmV6j8P4zTRkeyi-llK01EzdJfWGOajcdU5XPUAqdJwYalIs6jk2PcRY4Y8Px47UaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1hkk3Mb-f_bXVzP0AKiJRhNQehgzm3eugY-eyfCtNWQ&oe=69A6E5E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWCaSUqQxIEQ7kNvwGxSiJI&_nc_oc=AdncSHuDIDKqf1WyZuFZav0oZ--s7M5hc6sQFoH1fe1rncjIpg2vritAupXY5edYBLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMb2HFbV1-JuXrns3kdxOzSCN_LLLK95xVP7DqSYKPww&oe=69A6C45B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2odRk4qOmv4Q7kNvwHJWZzh&_nc_oc=AdmnDHMgduT9bBORgkTLdtJBZAhAKuacywUerDyuNTv3r7hjs9bgPbVTrGJUFziqOa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsWz-Ky4xkK4XWcQuVA216wStKep13-L1q7XfLKFC1Pw&oe=69A6DBEA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_su
nc_sid=6e7a0a&_nc_ohc=6_lkPJtvfxYQ7kNvwFscdeY&_nc_oc=Adp6wYfKTG4f7FOUiSx_Jfl1VwFr86jh9-moAh2dY_aF26d9VZFDOgDyg8LXZ5kVOJY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rLIL2GBDSk8Bx4_DjGs8IxaouAswFSKORuBPQVNxi4w&oe=6A131E35"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpZilaOvNmkQ7kNvwEnGpn1&_nc_oc=AdoNcJfH_ID6-4gQFQpyYlPw9r9mKKBw-tNYj1KZfT6VL0jV_kBa5aUYlfp8hg-OJns&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FxxTn6VsFqu3Zy3-TAMjw4FMFH2jPvoTdDblxxqfUlw&oe=6A131EB1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQSYoWL_pF0Q7kNvwFaqp8R&_nc_oc=Adq9pOLmyUQ5DrkykNpfVIIlVMqENnGB8Tf1jrRsXaxLOBJwYwNVc1raltx1nh-QYt8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af568kbcnRXB8vuzj88eSwAht-y6598Mc0gMeheRQEdGrQ&oe=6A1300E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbOzPpEKCtoQ7kNvwFhsxeB&_nc_oc=AdogDuAhGgGmR9HOE_ldEO0l82XKMfmPRInlmr-7wtc-Sy2Nv6bYXzJ8tv87SEerQrY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l1V8H8zgKvARIz_4AT0EkjDXU_Rjp0HDkh-Ub9A0JGg&oe=6A13179B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npVoHrkhFA0Q7kNvwE5w25q&_nc_oc=AdpynBwdbHTS-sDwjVeWlrn7eSQno5f3QgSjs71PVpcNKLlds4E1_t7KIblO-AYCk2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LTxQXH_G5JR0Rd011fdxha9zcuqZl68A3gNNYwo_jpA&oe=6A12F6EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
8c8sO2Oq5kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1SuqiIx9EBfdScC9wqo3tnUQzK7ZM0s0EcaE2eKmOvw&oe=6B070F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "955560035432771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462205_955560038766104_6847209455434227211_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s8I70g7s5sQ7kNvwF9sXES&_nc_oc=AdrUywZ7HT_G4u0V8p9FvtHx9Xd7JL61e-PhajxClFuPuXwvKG1MaOxQt_FqgcVto0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgzWZoCOnO9RuqbnbaD9FnBPEVcQTdCBuGCtbXcQyFdQ&oe=6B07237D"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile.\n\nWith stylised graphics and arcade-like physics, every turn, straightway and ramp will put your skills to the test. Feel the thrill of the race like never before in VR, as you immerse yourself counting the seconds on the home stretch.\n\nSo what are you waiting for? Get behind the wheel and start building your car today. The race is on!\n\nComing soon:\n\n- More cars\n- More tracks\n- A decent garage :)\n- More visual tweaking\n", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
gQ7kNvwH0K4Lo&_nc_oc=AdnAv0_PFxj6_ZGam0YReT-A_qM1W7uRQ77KGmywVMoWdKZEdVkKRPQGbZCibbUEOkM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAOemoR_v_yV6CauAled4lNkbLOXZg17CWqcrFsx8kyw&oe=69BD3475"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA14Mb_LLVwQ7kNvwGYRdvu&_nc_oc=AdmIFkcYm5ekxIRdAgjfxZnHkbxpL83HvAaGnbdoMkHm3zh_KwtPLUqtiS_Rj7GAfqI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo2M9iAUfV_qsrlb_Iq9Y0k_YrRDbR27rFztwprG7nfg&oe=69BD34F1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaqdI7T8EbEQ7kNvwHN1HRV&_nc_oc=Adl_J-efv3lZpvRh7Nt2ojNEPYdWHhtBB69bY1h-rlfK6nd6kHFBp8YEXlHxE-Ftix0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2cRXVdimpLl7Ld3MJVobh0OxF2Noy2Qh7UEsNL9DLfQ&oe=69BD4F64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIXdM66mhOAQ7kNvwERSavm&_nc_oc=AdloNe1TW9cgb-46YPt4i4_Lshld9UVA52WcIcbm6vn_w5xThoo2XnHlVNQg9N-zWqs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfSiHeJ_6JVO58YeUHEQW5fAPm87tSAWfBedMWyIltdw&oe=69BD2DDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ncLYsv31SgQ7kNvwEWmWfU&_nc_oc=Admw7CcQks5-PsVZdAFZZQmJr50aKV2TB_JwHXBv4sKMrJWYvrbNK6SE56oeKHNe7-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQo3Bw00Mdf426Tbm90RTsvTGx8_H-ln92L9YzhYM6XQ&oe=69BD456A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
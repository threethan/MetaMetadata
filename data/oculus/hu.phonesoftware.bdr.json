nc_sid=6e7a0a&_nc_ohc=Tvu3JBK84R8Q7kNvwHouCp6&_nc_oc=AdotvxlNysli9WaQ7QkIu2Re3oJsjbnZTSF392aFqKuGxvtD0TCdC2tMaahm6CYR1UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp0f6ooKE0G80VmG2nNg7Y2zkp4hfWFKhicY4kvTl90g&oe=6A9845B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fXfGO5A2DEQ7kNvwEDm8L3&_nc_oc=Adp0-IUDoNfISQvpUWafZd5wUZQxiZW0NRCuuKB2cXHEXCiQK1nQF1VkqL9vIH7ZHbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBem6mTHykdyyaLMzzBaCRIZkqj4vAYl4ezTIo2hLBzw&oe=6A984631"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAw533zjHOcQ7kNvwGEdWLo&_nc_oc=AdpuWv3X_uWhlCUT15iedfb8EIq7Uvq7azYwmUBAzhBQyOVQxvrX7GkEJPEMpJpme2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWEv5HnnqKeQ2sfvQUrAUm77n2N8mS2bNQkukU7k4wEA&oe=6A9860A4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPPUSTjrXw4Q7kNvwHUUf2m&_nc_oc=AdryOpBA8ltI-3FUY9Yus6tLJBVGynwN750G5oZl3fBImH4yEWfFPLgv0N-efzUhnlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKG6PG73kXDI5QqaaHqD_Un73jYPYwFFatLl_cYmRLwQ&oe=6A983F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyYtv7VJBAcQ7kNvwHUewUk&_nc_oc=Adp2LXpNtdMwPMsfOetxKNswAPSijbRNPrBIyxst0Vrl0eVdX7PdnokA64kGgx6DgXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6XwmVhFr_C_aLaa9dD-ptxtcisnhtFF1wOu78DqKMZw&oe=6A9856AA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
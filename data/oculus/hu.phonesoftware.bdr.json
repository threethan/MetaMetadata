nc_sid=6e7a0a&_nc_ohc=8EMHqhdpNDYQ7kNvwHg5tCr&_nc_oc=Ado50UfWwsnSq0vSH0wmyV6_WuiDDCrHLcrJoYtBBWHGjwpkFN8SEKfF9nDPupqI5Nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh3Abm5cU-s9rEycQ1gO2e8Pr39rMTW4adaQ7JxA1TXw&oe=6A5F5CF5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwXGM3xlTSMQ7kNvwEvu9J6&_nc_oc=AdrcmWp8p9WvZ3aamkf7-TKJ5TFiRwdTZqRUpsI7TG8yPEY2sBX2GWBFKSia2q7QoD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKnEDu_0P0yEAGgPtJhkpLiaByCp1Sk615lD5gonNLTA&oe=6A5F5D71"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LspLeH9fyXAQ7kNvwHa1L02&_nc_oc=AdqBG0epz53KyzW2COQyNJtXzN3oSFjFbByASB5hpw9w_mseUaeKKstMqNRga8WjzJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLhymt5Mb1rmrPvTGqEQHMOaIHgIwCn0EUgJwYq5g8_w&oe=6A5F77E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXjlLYKLznAQ7kNvwFULhVk&_nc_oc=AdpoaK5nrEXdM2Pdw4AXLG6ffLizcSMrdpxz_RAddcNh1PF7U7SXIJl9ewiJzLRNzQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfzeL13pvtSdF1otJd8VEK4qPxEeJBCOIM0CLqeWN3Gg&oe=6A5F565B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6iJON33kbwQ7kNvwHsk5CO&_nc_oc=Adp_t-OzKEh0BVAiaeVuPobHsqvSj1BHwfrh2RawO0NYxPQef04Mye4cQlkVeZPQPxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo7bkvalgqq7Vc71hC1W2ax9y7meMsi9QY6eKGxA7luw&oe=6A5F6DEA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
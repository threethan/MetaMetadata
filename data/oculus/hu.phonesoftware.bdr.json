nc_sid=6e7a0a&_nc_ohc=fUel2x9a1OIQ7kNvwGxToPp&_nc_oc=AdpW19O8vWSq5l-T7S6CXh2NGAEwM80lzq312iV7O_F35eMrgBD5hlOP9RiwX3NHwsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEvl2WrDw_n9yVBtNXnpYR8fuHUQcMQIr5w0oPHCJZJA&oe=6A6745F5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhzWwkAIyGsQ7kNvwFfjgL2&_nc_oc=AdqsktS4ZYCr-2Oe3ZeVYX5oyEIAUsZxGJ_sBQjbW7AOYGsDY77aF2TrdDF5JwaFZbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3DysoZelfsO_2FhS4nYXEQ01LhD0zd5MqrvL0WsXK2A&oe=6A674671"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWD8rF3ShSAQ7kNvwEGaypj&_nc_oc=AdqCTjaiI5HfQjLVP_AFQrUB45OfLgl9swKZ8QkUBz-ieUVK3_HQkPVkamelXFT8ZP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF_nJVZ1ilLEy7WfE6IRPEs4PhGADNYNrmqytnUwcACA&oe=6A6760E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QdvU6SMyHkQ7kNvwHwlbC8&_nc_oc=Adp0Ua2_jc4tSiq-JXi1uNQAV9nSjjlNlzPprTytFVsOfasjNo5BLZsm1VimqyN56yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqmHkmtiANcyyZfW3G_FkDNmJBTIS_jEjDJJ_O2g0DBQ&oe=6A67779B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWuwnPpeCU8Q7kNvwEi1s79&_nc_oc=AdrEQ4lUxWgOfB9SahlsaPYxRRD_S5Npr6KOZm4Qozw5aTqLLC7dFzitjfbeZf6LKR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALfLgahbuNvUHFf7AA3qpqzcdclKnvQs6Xu8aoCqQP5A&oe=6A6756EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
nc_sid=6e7a0a&_nc_ohc=n-KPQNjre-QQ7kNvwEqnTAY&_nc_oc=Ado3NdjqQPJ0faNdlOOr9BUHDDsnBSe_LsyP6kdsFOrrqACm0pdBGovSw0NW6c2T4Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7osZb_BtuVxpzi-FDlBSZDkWpFhK5mCCF3CXxjiNQoHQ&oe=6A0D9FF5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztbw2828uukQ7kNvwHl_t8K&_nc_oc=AdpQCT1xv6GAvjQrSLTMp5MvPzv8-Dglqjn_4GKZ0W-HH6X8Ptt27unI0u1glfqGCfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64pjputmS-bKX04dKrLoYJ_xE5ZDhL4j4fSKZJzH4MOw&oe=6A0DA071"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhAFQR1A6_cQ7kNvwGem_39&_nc_oc=AdoXK90q8fSKmosSEnssKYIyLEiPSBJCHFKOLl19ORHkyxjAhhE1LgFDOzty-pgoD3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aBENq1yFt17xUTQd5h8uXCAn8xQViwmzO6vLtzDoL6g&oe=6A0DBAE4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Su9tfBwkvAQ7kNvwEpGgYB&_nc_oc=AdqFicVLuv9RyNr9z45Ye1HlfGLVeve9tB343IcG5l8u9-p0KM98BVF7ZCl9QHCh2Ho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46VAn49yGsrvg5vUDv50KWebyGxGiZ5RXvXLSXGsViJw&oe=6A0DD19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96JWkYVNfvUQ7kNvwFAApkZ&_nc_oc=Adp3NpwZbsVP4NBj_8vL0bcb37vs8uFGQ8b03j6OVBlG74Yjl8YD-JPOl3Yk_uXefvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LpYIj1Q_At-Lnlc1GNzdBW20MgZHBML1r_H197L7oQA&oe=6A0DB0EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
nc_sid=6e7a0a&_nc_ohc=35wh0YN8YHsQ7kNvwEpziHs&_nc_oc=Adp9H7QGcvwpfDD3YOsTZORpj2AudQhvzigea9zuS_q9DSNxO3rRqN4loHCcDdq_aGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81qVq7pkR3NCisolWOijEx6XU7nQdcWcBsrsnuVK7oyA&oe=6A2441B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uxLOO0Rl9oQ7kNvwGYTCFE&_nc_oc=AdrouePAeV1nMO1abI60Z3awKRiPKfw4dGzo4Gzvx3u2VTYX-IiZowfNUx5PotNz-PQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B1UKFMZnBtU6gCIwjlG__G-DpB9loXTyZz3IHOSf5EA&oe=6A244231"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXdTVNnYIugQ7kNvwGRdTY5&_nc_oc=AdqN49GxBur91M2-DN0n13j7C9DohDcHZ39ht4xG-oHLwWoGqeGHCarLu7bFXnQvy0c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P6LJ9eLlATc3RZwjuQc_KId04jt79s4Gi9hxWXKSfWA&oe=6A242464"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF6IDgleHecQ7kNvwG7aTaK&_nc_oc=AdoqD3AXb9QBKPY1ptzmtGBX_Ah37kwRTfJ5W4bVfmv9qm6kor8-ZVAtKNtyROL4a8Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rSpRw5xQjmWXr5fur8KR-9NBVWdYRb2EbWvFN1J57qQ&oe=6A243B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE2bSVD--CoQ7kNvwFSedHG&_nc_oc=Adp5SCHSXijC9-kyCXlWp31QFpeaCD676ldnYvWrGWa5rUqUs-51vIHHZLtk57dikrI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NmuG4ABGW7Y1hRRpNuwbLeQtkLOD1kI_0inmgR80PxQ&oe=6A241A6A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
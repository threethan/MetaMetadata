nc_sid=6e7a0a&_nc_ohc=vm6udjKRsS0Q7kNvwGwwBJy&_nc_oc=AdqoMmx9LLn4SAGa27x-vDVn8nXssBf0fqnJDw_tyGvsssIQhZwSOJg6fBEyHmeho64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wqoficzachBj4sDuvjKr3ESnBcn3a0eshJN-jK3K4gQ&oe=69F49375"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x8jwtcMZ6UQ7kNvwEVTH_k&_nc_oc=AdrvNd6KVmcak9T55_PamhTS71CrEbJCHP7yTosqxcuk1iWTQUaRN1Z3wikUU72d_qc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Eq3-kea20XXBTdLg7jZEzztGYA0vy4RW-fuYN4KRytA&oe=69F493F1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu-gPkAYgHcQ7kNvwGXUWoL&_nc_oc=AdrRQIesB4m86IuYQNuzz0clcEDUgg6Fck0-isb-mx8VByk6wd_h6YaxVez3S2Je2E4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C5Cnx6aV0poMusAmEA80UgFTIX26jY9vW5dVrztaGmg&oe=69F4AE64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPq4u5LBMgMQ7kNvwFwTgbZ&_nc_oc=AdpP6ibxZx_bUmUT71M7L3FJqa_7pHtnEREy5v34-MsP8Yd6OZfuqgrxr_kxzEn1qhw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15G3Pf5SyDUHQEHj_S1k3VwB1EIdJG4xy7YI7E5rMjTA&oe=69F4C51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE41Ji3JMSoQ7kNvwHw1sfk&_nc_oc=Ado3h6ZEPQ7XDRaNC86k0JCTuoi2lvN6p3swOme3a18ch9arh3FmklbKNrOZ9LftLms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ibUF0PHCk_eFlJK3fbaIxuAY6O8LcqmYAN-ZIIHIltw&oe=69F4A46A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
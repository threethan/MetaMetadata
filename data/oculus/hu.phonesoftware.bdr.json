nc_sid=6e7a0a&_nc_ohc=qm8ePLkfENYQ7kNvwE4H6qI&_nc_oc=AdrqqjmrfS8meyw9iRCsMemVp1S6BzvjIBBG0AMN5krTtIcC6en79YoQ3jH6d0OyeXQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pO3oXzCnKdpYHepLFe16OjDTP0fR6dV19eEa-qhyOVg&oe=69E21E75"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RSZLjp_i-QQ7kNvwHpC4b5&_nc_oc=AdqAP2hzAic0ioyxSDEzut--U6FEik5HzYdwmQAaFcZtQacF1bAYBRuhd0mudkOPGiU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cVcpeht-r65CJQCHPXr185Q2AXNY854mmiqoBzAFGVw&oe=69E21EF1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62KssMSEB2IQ7kNvwH2-nBu&_nc_oc=AdpBKsY4HOAK5NghUHQwx-wQv2KIiEOJn-UwFhRR0KhUrNsvmrZtYeipT-DF2S6RSzE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P7Ws3e2vCF5Eu1yQSx_AUtMHfnosVGsomFTis5an5yg&oe=69E23964"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR_OMDEABkgQ7kNvwFakRqj&_nc_oc=AdozMpumCswFu36xXG9q1FGR2Q_RDHn954MNrFDAXaZNkWk-7clQM5K7S2S8EQhXy_s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nZYuDuZs1dmB0IrvUnlQD-tD0BTr7uqkUeXeS1NTkxw&oe=69E2501B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2pn9-SGfu4Q7kNvwEXGGik&_nc_oc=AdqZK5-Kg0zqGQ3vmr3Y5zWKmM_y7-qXT7xERdRbYGc3cB_jEA-n8T3MSW3mNmpr1NE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YicKYYHMg9NqMu1CJHL2Hjn2HU9gvTEjxZqY1Nb4GlA&oe=69E22F6A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
1-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUsY0a3VIAkQ7kNvwGbhoeE&_nc_oc=AdrEpufYJL2tQG058NW6nnpxIo2Sa7fWsIjkw2-6pK3aMUTFAEGu7T5iy0e_QPUvN6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5a9W1VkCkZpb64UH3tzFiGTPW9deJ5yNkkXsmGFoIAw&oe=6B03202A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "610832451145499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982617_981495652995345_2446359202040011340_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h2U-cgckM4Q7kNvwHEWCK7&_nc_oc=Adrlx2OxhqZb8APlcT9uOBVX1-Iz_3KAEW-OC40GC3rjQYLeuHBmes4eyXIUi_FfJPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTCHZABPL_5s44jRK8WtaoaCJ7S-7hVAQhGOCR7pj2bw&oe=6B032335"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Build and Drive Racing Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1679058600, "lastRevision": {"nodes": [{"id": "6349806861698877", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_lo
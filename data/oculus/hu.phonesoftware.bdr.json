&_nc_sid=6e7a0a&_nc_ohc=h8ptZb-9830Q7kNvwHJevZg&_nc_oc=AdoFSXJEm6TjUSA8qlc7HQuKpgkY9FZfbtRP4Y4gI3p2EuLIXXxhsugJ15OgDbQrS0Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWekIMW78n3PV66TVIvMwg1cul2HU98xlNCLMn1rgyKA&oe=6A7DAF75"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MorFxByUWuEQ7kNvwE7LHDU&_nc_oc=Adr3StalZeivKHHQ_a7u9WsPr2j1mA5brg8UoOmWZbcS4Qk4jqB4Y7quHTJitWzy2lY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmOlOGO2K_FSMnlbpR_rWCwtXJA6BQbnQQ2VbSEKlpBA&oe=6A7DAFF1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYtyZRPjfVMQ7kNvwFAVO1g&_nc_oc=Adrq3Z8mX_1sp_6hnlC7_Fmt-UueCW4LHK9P6vSkKeen8DeLXMPU04j1ZLL8SCCy5ow&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_mtHCUfMQMKUdUv4owQImv3igsRaHYCy6mECTlpq5_A&oe=6A7DCA64"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojneCWd-JYUQ7kNvwEC85nB&_nc_oc=Adr58YCdBJ6UTp31kfMkuxpUFuFxcfIZaYPDaftddqLYMjnAbayvLVkmlytLQCgrASU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw7uhbLFosT8rKsYhBBcvTGCh2bTso8RKTRg9vDdmEQw&oe=6A7DA8DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqX2bCMHmSQQ7kNvwEqgt-O&_nc_oc=AdrIs-ATqfV9BPgcFMIT6u0gNdSJpTPa9Q_-ZIrye92cD09mtlmfAuX6jkih2ebdhTA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZCrFgHH7ewhJeE_3GJPWj5mf5gaIXM0vuysbrE4wgqw&oe=6A7DC06A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_
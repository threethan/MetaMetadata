nc_sid=6e7a0a&_nc_ohc=frXRndboQOsQ7kNvwEwL3Qm&_nc_oc=Adr872FSSBYSw5BPfVMIEB4k7udg75cdLJe6NmJfWwvc6YvOfxZzQPhfUJTbDnZOnUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9QUYumBpg7h-fEy8vntJOuaLG_jg35f6AVNGNl5GO9w&oe=6AA574B5"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vczg_E9TiGMQ7kNvwEC3sbz&_nc_oc=AdoRPVX8CJjGVxIseopdDUIXvFbK6IPyrFXZFIMP0r10hWfZyOFlp_eYQTHCvcdTH_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeig7IOgfh4N9Myvi0YTes__P9IHHi4JDBAVIO5Pmh5g&oe=6AA57531"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE0051s--QIQ7kNvwGEEPYR&_nc_oc=AdrVZJHh9ZJHFU8Aqsh27rdmVH0vEzyovwLd6oSMK65HCkZ9yA7UzNDzEmi-RrY2eJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKalVzEyG97QDA5wS-CScmMoJjX6N620I3Nk1Gk06sCGA&oe=6AA55764"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYZ49xxp28QQ7kNvwH3i0dZ&_nc_oc=AdoYRkguw8BjxCryONditD8-Pz9YosSek02bxjXp4Pgpv4HQOcZnYrAaTcQmJPdzyh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtEJ_CPJGxghtJghapC-nXhTb2TDxJYThyWLKH7gToXA&oe=6AA56E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkmwzPUk9k8Q7kNvwGH-Uz8&_nc_oc=AdoO44e-T5RAF-IxVCQk8mmroFA4bS-WzSZe_3lbpxgflFHABqUwaoE2y58t1BnMbOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRRdlDsiMUhGrqyFp9e_ygaho6hlMTQAh08KwicGeBGQ&oe=6AA54D6A"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
nc_sid=6e7a0a&_nc_ohc=m_4XyKz-BRQQ7kNvwHBDW2R&_nc_oc=Ado-NHyDXV6mT0Bjruk3WU-7K19mtuXslUlRS5pmaFQo5WpBzx9FhFFLNxieU6jLeOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zrGIrCaRHmrmW0DYkEk7T2tyUaDSGIzYswtsD-3PmEA&oe=6A3FF135"}, {"file_name": "13.png", "id": "803674367836566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203614_803674371169899_913182374289728501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co_LCWkpD60Q7kNvwH--D2c&_nc_oc=AdrJTHk6HmICRXblqi24lne_3tjPqF5gXchSvuZZo4RLPt0btqCaMATX8bVnuXFxIPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88cJjW1-cuxFlfPM9EpD0AljZryiQtAo2yhMe35mzLug&oe=6A3FF1B1"}, {"file_name": "19.png", "id": "644044133997542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031571_644044137330875_2611354646149495117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au9RVM_MG60Q7kNvwEKc_u7&_nc_oc=AdoV75eD7v9O3iwMW4FT-ULZKSGPRvJG3dNFc6yC7rmSIfsUsCIsmoKUvwf_7-XI9Xg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CR1NUU62goUSVxhG0NYxVa6AmJU3xw0PHYUg_cV23gg&oe=6A3FD3E4"}, {"file_name": "4.png", "id": "195537233146444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_195537236479777_6125012435723616563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcONYxf_kW4Q7kNvwH25dO5&_nc_oc=AdrrLptZr7PJjLWJaxvC9gru7XtJPMdt_2g4Ay_Syas56i2rhXZKDOVgsPofWCwOIAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gy8z9whFFdDaWyeXZYUSu-B2QlEaBcJ9Oe7YP5bshRg&oe=6A3FEA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "19.png", "id": "230300276557751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_230300279891084_1462332637203509074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXcCOBTNscYQ7kNvwF0IgGl&_nc_oc=Adq_aRJIveZKbZrGgO7PTBBKtsLanePNjFBRsH63_3o0UEl2qhYlXT206xukgO9OpI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CDlIU41Wr48drFIbnseL9n2Ez2FhuUDYnuX8zVtXc2w&oe=6A3FC9EA"}, "display_name": "Build and Drive Racing Demo", "keywords": [], "long_description": "Welcome to the demo page of Build and Drive Racing, an exciting early access game.\n\nTake this opportunity to try out the DEMO game and get a taste of the thrilling racing experience. If you enjoy it, don't miss out on purchasing the early access game at its launch price:\nhttps://www.oculus.com/experiences/quest/9933061533378254/\n\nThe game is just getting started, and as the very first early access version, you can expect regular updates and improvements to enhance your gameplay.\n\nExperience the following features in the early access game:\n\n-Challenge unlock system: complete challenges to unlock cars, wheels, levels\n-Game modes: race against your ghost and beat your best lap or race against AI opponents\n-Garage: customize your car\n\nExciting updates are on the horizon, including:\n\n-UX improvements\n-New level and challenges\n-New cars and addons\n-New game modes\n\nGet ready for an immersive racing experience and stay tuned for more thrilling updates!\n\nWe need your feedback to make this game absolute fire for you! Your thoughts and opinions matter, so don't hold back. Hit us up with those epic reviews, whether it's here, on Reddit, or on Discord. \nWe wanna know what you think, 'cause you're the boss ;-) \nHelp us level up this game and let's create something legendary together.", "short_description": "Get ready for a new experience on Windows desktop and VR, where you get to build your ultimate racing machine, tailored to your driving style and optimized for performance, or race to the finish line with a monster what makes you smile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrdevelopment.eu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRdevelopment", "support_website_url": null, "website_url": "https://buildanddriveracing.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags":
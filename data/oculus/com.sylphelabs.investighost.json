Z0ZohRV9ZvxBUx6kmMlfqUaTUWn6mOdkmiuzEvJUkpGxKe_Ygm2EsHlHexfR6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WRN8yQ046JEtxXfRma9T-6yDSRn9edbKQ0uYwnfBD-Q&oe=69FB2C0A"}, {"file_name": "shot_04.png", "id": "1997082354522290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827703_1997082361188956_318146475301101198_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvBTTdmOBioQ7kNvwH5SSsS&_nc_oc=AdoHNKsAzC8Ofzd_nk5I7WslsSC_GfoXRbR8EahSOfHKBUBmK3jdAS2zBsFi1z435Ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yyOb6AFyJhcSCGMUJuRqYR051dl2WlAdRfRQdGmxxRg&oe=69FB4256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape2560x1440px.png", "id": "1316761356953064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822823_1316761360286397_2272191156800823025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5zET1z__1sQ7kNvwFM5GLo&_nc_oc=AdrTGY8cJKfMXO1FsGSzbTM8FvwhERoUh89JkMwzoQfitKWLxZPF3XJtP0lK8qo9GEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OHgsweCkA0gq_9GgkLrWw5XupQX466tlzLAlYPuIC0w&oe=69FB4760"}, "display_name": "InvestiGhost", "keywords": ["ghost", "exploration", "photo", "collectibles", "investigation"], "long_description": "# InvestiGhost: a VR ghost-hunting adventure where cartoon humor meets haunted-house thrills.\nCreep through a haunted jazz club. Sneak into an old mansion. Something moves in the dark is it hostile, shy, or just watching you? \n\n{935692488974655}\n\nGrab your camera and catch the shot, or switch to your plasma gun and fight back. \nYour only tool is the **W.A.L.R.U.S.** (Wide Absorbent, Locator and Reaping Unit for Spectrals) a shape-shifting gadget that becomes radar, camera, gun, or energy drainer on demand. \n\nTrack invisible ghosts, photograph them for profit, blast the hostile ones, and harvest ecto-energy from glowing wisps. \nEvery photo is scored on framing, distance, and subject mood, sell the best ones and build your paranormal gallery. \n\nEvery drop of energy counts: it's your ammo, your repair kit, your lifeline! \n\nEach Boss haunts their domain for a reason. \nFind the bonds tied to their past life, force their hidden heart into the open, and survive escalating attack phases to drain their core for good.\n\nBut damage hits your gadget, not you - push too far and your gear breaks: mission over. \n\n**Between hunts: sell photos, repair your gear, and take on the next case.**\n\n\u26a0\ufe0f EARLY ACCESS INFO \u26a0\ufe0f\n\n# Fully playable now with 4 levels, Boss fight, and Office Hub. Photo gallery and upgrade shop coming soon. \n\nJump in at launch price.\n{2313429015828204}\n", "short_description": "InvestiGhost a VR ghost-hunting adventure where cartoon humor meets haunted-house thrills.Creep through a haunted jazz club. \n\nSneak into an old mansion. Something moves in the dark, is it hostile, shy, or just watching you?\nYour only tool is the **W.A.L.R.U.S.** a shape-shifting gadget that becomes radar, camera, gun, or energy drainer on demand.\n\n\u26a0\ufe0f EARLY ACCESS \u26a0\ufe0f \n# Fully playable now with 4 levels, Boss fight, and Office Hub.\nPhoto gallery and upgrade shop coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sylphelabs.com/public/ig4/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sylphe labs s.r.l.", "support_website_url": null, "website_url": "https://discord.gg/snr3wtaeGk", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po-l8UDhFNsQ7kNvwEtYjyf&_nc_oc=AdowKWvJOktw8y5CN0diJy7f0Vcl7bme2fBSMFZLfDk9ytkFYMEax8DC5FVzkMUMO14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZgH2hti9qRBgqU5kAUDE9IG4oJBn_1tuSONqrThUYsw&oe=69D4ED65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNY8m80tOTkQ7kNvwG_Px9k&_nc_oc=AdrlAPbngdIXtdRtLPuuouiNfDV3W2XRlvpV75M4eijmD_6Mfch4kdPRM-62Slxqkgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af245Aaeh0MN6Uv7Q4urY-QyD4GiKWWxYMMCDQ-eWW7QWg&oe=69D4EA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlsQf4551noQ7kNvwHDkqRL&_nc_oc=AdryyOOHUlljDYaMdM34hHusbNcZv5hoJo1Uuu2QGcStR2XHZr7Kabw571HV2IpksHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QlK0Npur3Lacn9SfixfIjTqvB6nEG5olmtq0yFhDN3Q&oe=69D50192"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
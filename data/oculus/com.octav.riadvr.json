.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZN22PIY_kkQ7kNvwEcuzPo&_nc_oc=AdrB4P-6i59W69YSaytDRrMPcY8o5N2WqLvA-q1Uw_rfcjVS6WZob529-aIK21cHm7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuRJ9ywmQTIfJPrII1_F_yuklWmSsPNluN3xehlb9xdw&oe=6AE8AF25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdGBh7-8xdYQ7kNvwHODrjC&_nc_oc=AdokgsmErj5I58V7kWl4s2-4BhPRq9Dgx27_FyL1YUV1Eg54nRrM7umVcWVbjsR_1IY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0i8PyB7xSdG_xXKsEC6ErNIt-g4ypqNTfA6TruaAQuA&oe=6AE8AC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4WgydhikvsQ7kNvwHwxTy_&_nc_oc=AdqC2ds823BoT88e3nS3hUZ_JyrAAHYA0M86x9cMnwgmRISUozUHqMdvoE-qruxFpUo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYCbg3kNmwUvu4g2zL5oaQ5T5HqUlsV9xKxg9Z2zTMlw&oe=6AE8C352"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
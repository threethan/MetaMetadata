dP1MtBnGw42RZQ4hkzI_8i9i5iUWHP4557DYWTLa8YfR-Bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILPOkDMrGoXqt9DMJZhDfmyEgvpgUwOfi4Rx77HWHD_w&oe=6AB1382E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXkVVUH_uOgQ7kNvwFHGT0s&_nc_oc=AdqIIG8un8RV4h2IHMFRChySjJclaOd5HWTGU2wE2Hz7OX8jpt1u-HY4-bT4zYwTJms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUFnI5Dvfhc-jhEV1UqqccS9Y5soo7i7EUVO64mZklDA&oe=6AB126D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjA-ItXXbDYQ7kNvwGFISVc&_nc_oc=AdrEBE4rdKN5Ld7nLrZPdSc3UUxy77ULfJ4i3vshPsiE5uUlTk3cNwdvUi8mumWvZtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItQvaOmavFPjsUL1rPAXg7Rh7Dx0MxSZDIKxt6pk8Y1g&oe=6AB15025"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMp1lejI_V0Q7kNvwGmLyDp&_nc_oc=AdrKUm40qEn6myXhiUENaME_tEiG78Lobmw8ckLP4KqXfWujXzmu2aWpTGFry4blIPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeF1VCvSc4mchvhprNN_dBYcaPSaQOKjoAAuGrwt2nnQ&oe=6AB14D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YyDFPzBeKMQ7kNvwHp9-aj&_nc_oc=AdrJwEvJgo1yY5KZP_Zw8Pe6QeRpqKvgjtU4K-TBiRV3T_ZUwzAGlp4Vo99Dx4ZBYs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV1subVdsBJqftkdU3d3AFnxVNd2T2SK9ht-9J5Lo0oQ&oe=6AB151B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
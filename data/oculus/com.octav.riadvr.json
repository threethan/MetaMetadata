.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONoH4m1rcrIQ7kNvwFY6hYz&_nc_oc=Adp91XnV0konrzB6canRuUf3Ry0mftGaX6dxrezfutrSgAeUyEpJvl0SRzb_7LKAXKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tuss9JIiPJGKq7HFeVtUiIPRyK0IV7gQqBRHSz0HzAQ&oe=6A301D25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5QL5X4cEWkQ7kNvwG5LVh7&_nc_oc=AdrL7uNeVTSChzTlpIRXxb5-VHM3GeiI-D8xvRXC5w2gqoOf7G949RogaVIwLn_yot8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k3QG4Hy0o-80BiCWwJTkzBJm4cvrc2XXPENMOUIE5lA&oe=6A301A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Bkvr5LH4IQ7kNvwHqLWUv&_nc_oc=AdpQ7q0tQ-7RV2uXwpg8SblEwiq_CpOITT5g4RUuoZ7PdKuY9zEHVIQsqBq0iwTCDLk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HjpP2u6HYKgrIV6aykp-kI90mYbhJ_BsSNtwysEJ8_Q&oe=6A2FF912"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
8hIvlE_sX0UvwCcKm0RU4FlfP-YU3W3RoVtGLBrUYQUNuu4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mMMI0tIbgODsgoMbsBpI4tdbZJ6sdTKplLXdVZL9F-A&oe=69D9022E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti3eY0LGUjIQ7kNvwH1r_p4&_nc_oc=Adph4E4K0pBad-dh1BeG85jHoMfkplOmbjQN_1mX67o9R3f3vXnoJ-ywk1coypfw-0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nb8qMEW1eR-p4__ts3xmROgBDcDyyfLkCNUGxmuUkOQ&oe=69D8F0D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgXwuGKbuJMQ7kNvwGucgby&_nc_oc=AdoPmKYKC-EifG7ad4ZKk1pNCEl-Z8-uhNLYxO85ebuxUsltQf-Yo-zCCrUBKpEZM0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FY9HLzmDl6YMeI8BKoJrie2_bqYQ07NxgIQjC9iFszA&oe=69D8E1E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnwqXUl8c-gQ7kNvwGMl_jJ&_nc_oc=Adr2uqqMUWXrzMXVXcgkBYgL09l1sKJ8nn34G99yf6zd_T0zj9eMDxCznwGmJgkSZUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wNDs2wUt5yJysLnpOIaEoLj5pLmO1vh84DeaBbmKkIw&oe=69D8DEF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddnZXBYbQukQ7kNvwFYJ7sl&_nc_oc=AdrCyk2_c_RKzSC8Pfm9lnF8ISLzOBQUhtX_zvRIePcV26PclcbulyUg0QVmP_KYhDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tjIUSPctL7CJijb9T0dsK2TQ5mDOWQ5nN-xLrtrhfvQ&oe=69D8E371"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
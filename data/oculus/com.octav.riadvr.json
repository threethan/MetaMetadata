QQ_DZ97W7C5CrBD3dCmJf-lj0x9CX0B8_W6wL4RCh26wCog&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LEA8KkBN4tMgmR1A50z4ddT4bTph6re2fblteKOYAig&oe=6A0C6CAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1l4QJ5yDc4Q7kNvwH3coT9&_nc_oc=AdoaQvYpyXbcCASnlV3zpKj7op3QOXOcCr1GLtjfLeU7se_Vd9irP-zC8GF_918J8F0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VNrgv9JtUAhYmQokk1BT7_NlloQv3Ekj36rmETPluVw&oe=6A0C5B51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbHLG3VSYQQ7kNvwHRy60F&_nc_oc=AdrfV9RiYNee3RatNeuoMI3ztVttaD91fwDV8bQJUNH6E1j91K43Y6hPg5hN74m1uRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fEvt8bp-HuIsFZ4GT1fGQw55qbEGTnCSsjZA8FBETyA&oe=6A0C84A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2zbNUj0XG4Q7kNvwEi8J3O&_nc_oc=Adq-si__GpjeRYfOJY0hIoiQwWqaPfL8dACBYFM0iqhtFWK7u3ipKfbv4SSrDV_K8sg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57XDLprMCxTzqy4lnWIZhksHe4JOOVdD_DDlGyWC-4PA&oe=6A0C81B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yySBF--QZgAQ7kNvwHPV2PC&_nc_oc=AdqjmfwcKPcruh0PF8gTMeru8kQheRD4DY0elrId7p74R6HNYNEPPryQ-uWiGHTwbyY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45ngBQCheM09ajoFIraDzCPHSSzhxhnvnwW9l4B1cKKQ&oe=6A0C8631"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_A3nSUc7EQ7kNvwE8hZcb&_nc_oc=AdraaG9UkIJxXZEaLZNJ9eroa75OTN4b1HmoCGc9VxXMSbK66hlLY71mT20Nbrk15ZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAlAebtbjFGMQzg-m7yGeUbXxjesrLNvXhNjOxYso_qA&oe=6A526425"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NWf7Kpnu4gQ7kNvwHkIbuF&_nc_oc=AdrjxBkmwk95t7n8zH7Vl3GX5dsMEsvUG5gVJWLq1QVOA7WOqqaFya9BOQe_9W10kVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ6wc47cpSzX-y9PxJ-1FKf3x-XOK76wX8slFthNRGAw&oe=6A526130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7D6hpWKKUEQ7kNvwF24Z3f&_nc_oc=AdrqL7-XT0M683KGc3tlXdOAm2Yh_kxUYHTtUTYCFerh0EE22pE31bJMe2GKmfnzmK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX3iq5ylN_oycaSxDV4xDkVF7SK6hrE_jxYQtbTqPZIg&oe=6A524012"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
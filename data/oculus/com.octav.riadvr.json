_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4ogXDMJi9MQ7kNvwEecs9c&_nc_oc=AdlmkuyGAKY4spJIw4EKJ1b99vmWo7nrUyfJS7ej5yMApGj5wQ-UyCTI0Rk8WD7Dz2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5JmQCRpgWb100ssebdvx3ACavv5FooWsCKXTghBgimA&oe=69AC0EE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3VWgPDHbE0Q7kNvwHNe4bX&_nc_oc=AdnMT5TaWMtI75nMne5wiKb2VPq1-Fqnnkh0_qTeUzgbR-fpH8VnE5dJSdPH59b1bdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6jOT6gOdrWXwEcGfNjtScXQ4HDb8uwm2LaJoDJov3Og&oe=69AC0BF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNILrh_pG0wQ7kNvwEqvbCr&_nc_oc=Adl_-Sz7f2LE8VL1_n0ECwD-g6htVBsJJyg98MihSHVqfmf5_6FrejS0sqblfbwGAx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzl4aL14mO3wN1wCrclbSMdBjuNidAp8iSEqmOufy6Qnw&oe=69AC2312"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
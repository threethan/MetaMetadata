.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9Kj1E73FuMQ7kNvwFzhxsd&_nc_oc=Adqy-YdQ1sY-r-JHx7RvYTEAwspr5LkreeecZW5gOQth_T36QXBsQRGDArhuUJFwsKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i80ZjC3U-1mWiFlFtyAWa1W0whefeG-gIA2jBwMAt9A&oe=69DB84E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnKUA5GQGl0Q7kNvwEBnGh0&_nc_oc=AdouFM8X4ai61JP8eLra8LMn_B4Xo6CL3r3yHotIIGgLlI101bAsWCMTX_DXTmhE0V0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iEab7dbfHpcj04u4qFFnRYbt4yUMZhbBe2mUuKyzVPw&oe=69DB81F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVQNDEBA2XQQ7kNvwHbWQJX&_nc_oc=Adr4CA4a60WsX1Dyzx5VqXTQduWvq02yqwS0oL_dr0YRtWJjV3nwGGOTLz5mctIQv9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HfBZrtFmTNjloHr--Y5Rb9RHQaxmrtCWbUeZQ9EJT1w&oe=69DB9912"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
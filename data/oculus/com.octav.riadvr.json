.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONoH4m1rcrIQ7kNvwF2x7Um&_nc_oc=AdrSgJDlrAO-k8RrDib_ghXucR6Q8VgRaQtpwnk23tdW1dwoQdJsaWxzsuHCPQnF4Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M4PQSysDkiY3loyGtispP9_EGTxg-8DRFjF2eQYzK6A&oe=6A2D7A25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBJzfR_A9zYQ7kNvwG-kDTT&_nc_oc=Adq_nrd5wl-F69IUMSeWGLLIG_Ed_XUTacCWwel5dFQVNjXAnWpEXXtUBRFuc8P2qRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZH9FuasewZ3-bSB4lkrgCC-TDFOvgZ3sHIo4PozzYtA&oe=6A2D7730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ctW1MmOhcsQ7kNvwEWBw8z&_nc_oc=Adq1ztIJVk8uk1TYjs2d9iGtNtdDyZcYFXRkuH_itfbQ3_whgAtUBQ2x0jJC77fFr34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I71xaxweHSRRvQIqKu0owCWmuaFLJQ9C0RjEYa3ArkQ&oe=6A2D5612"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN_-nbkJA40Q7kNvwGiz7Rm&_nc_oc=AdpQcUwIRjP-VJ9C2MOH8X3E1skFdqlCDAskbhKs65M3En1I3pYggrrQU6XjidZPNrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLLgF5frmOI5eCHVoxEFVi-ge9lFwcnqZPQV6CjQMXew&oe=6ABBDC25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx_xJYbdgM4Q7kNvwHBJssS&_nc_oc=AdoZ7AD2JdH68HfRO_HWhF9StREf4Ixms4CoS2QWNsWVpviEWsqvu_6qWar5gFG4zKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4ovJk7pLueN6-xaB1MlSPVd80U96syFlX8xobcfvfQ&oe=6ABBD930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN6uTBHKFpsQ7kNvwHoolgz&_nc_oc=AdonyUJ7cdlYKF578pnUTuXebX31eDK2qLTNszPM4B_jCjZMq2S-iG91R6ZvpdQRW6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz9WffBE9Sz46DsI2N55BxoqqHQ6Z8TOccBS1_cEdc7g&oe=6ABBB812"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
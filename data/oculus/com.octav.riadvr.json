.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iI_g-0GdLHkQ7kNvwFbqao-&_nc_oc=AdotOUcmaG0d2LVY3EdUrkioWgMK0wl45K5jm4rJzHCpRGcveoW1R1tXJL8xs05JTLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJa8rTYMh35rF9WqL8rzUv4_JTDvj5dCIqs2k3URpE1Q&oe=6AF5DE25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYbz13NsgesQ7kNvwGYSxB-&_nc_oc=AdrGWSfY6L8x-bGG6QJEAOOkKlATm8NEyfUiriTeKuL6Sihs-GcSqWK5jHFdjSG0goE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTgX2PyjtDNMjt_ptDGaRBQGvcO8vSlX1GmYlSboTexQ&oe=6AF5DB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2puPySzCOIQ7kNvwGYQzIX&_nc_oc=AdrkcdfzsDSBnCwDbFa1w8mxgaFr51uzPhes4slZiiUD01f-mQhnzUDPpw9UUzmMi3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0qhjIMqNBUPjTDlYhZjhd43ljS2S2cfpJAw20eMiupg&oe=6AF5F252"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
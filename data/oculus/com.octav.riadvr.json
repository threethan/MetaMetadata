wSacNhTlfZky47fT9f1rxVlLzjHGT94NtxVJIOIIcXQTD0c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0cIIYngbQRN96JmGRZs20iPGieqCQEgoC69gI9rjzVA&oe=6A6612AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLYwX3gHVTIQ7kNvwGcdN1v&_nc_oc=AdqEE74SEU8vMQ2ozvfX9gSNS1LwzGSw-nvhWbUMGO_jkUlXL803sgc3S1O2CJXmUms&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsozxvpX9ZKOSWhKRkL9c7XBS87q-LLWvsvUt9eBJ_cQ&oe=6A660151"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQlJMzayVUQ7kNvwHUw3jU&_nc_oc=AdpVA6p9_bmrA3DqIt-5c5omR3PH47FNyOvAGef29RYR6gXgI_6yAsgV2JsCohvoqPw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV4YGZ60__i-OUJxTM2n4VyWiuZ48kO52Ua_tdApVtMQ&oe=6A65F265"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDHGvdiBXsAQ7kNvwGVjryu&_nc_oc=AdpoNLs14AW-VRCJkYV7JlFUyrynqFf1Aqrw2vKLgq6WS4l46H88zAT9aboGIWYB110&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuYfgmOkoMj6bPGzLdlNR_8KnSxWhlmr_JuNyD5m1aoA&oe=6A65EF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1vilpe4RZsQ7kNvwF7QllQ&_nc_oc=AdpBo_kupz6LZIO1yiUBWQjn3xKWiDJMyKXTbKmtIvj2h_YWTp04cWXk9zxjhDr96YA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPlxvSklT83hf7qm_Jctxqur2B79y3UDRH1YRuWUGgfg&oe=6A65F3F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnEQmkZrrJQQ7kNvwFIG224&_nc_oc=Adq5n4u608t5xZ5a_pziD_xrTgMOiea7_ZNhy0iZnpVgYvUnqs9LVDei8A9vcg0sXGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCvav8oI77WMlzpkdtnPyRWhx8dT61z8zrz1AHNiNWxg&oe=6A805065"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXVSH7ScFjoQ7kNvwHa7Uxc&_nc_oc=AdocYCHGjDLifpF3tkxtDTe-z1UIZNbZHiHqIqET3fUBrmlQNjCNUAeGCIELZCtUl3I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzmGTyrLAKpwwrALZdKnhcEPEjYIRad7hZmv8_x1sx-Q&oe=6A804D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BsBec7PSoIQ7kNvwEOpsPs&_nc_oc=AdooxYoCbvBm_lx0YhpvTYD-1d3vc87WBAy3INlakOOupM55sCoqr67mH3FTrsBGL98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ0QPZQhmgWCKIevkyrnsMjs0xq7dtovHc8MPpQzE3_w&oe=6A806492"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
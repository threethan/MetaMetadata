YXKO4kDcLZSlZPK4ESflQ73ZyAJjlzpdRMj-IW5btWYFAXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcO46Pv-N5p2e-Az_O-oelbzXGFEad2rG-7K3DE5Ovpw&oe=6A8972EE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D9BHsc8SyMQ7kNvwF5JXv6&_nc_oc=AdoBI3OzVS4CuB4tYFZC4ZhzPDJQOhYNhInE_mQBkgn-uvEtMUGABogkRuafE0jvARQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4hcuA75dEP-DTYb7WkK1j3YXgB3GTyIPYRTT1X5F0Kw&oe=6A8999D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw-gF19NswkQ7kNvwHKwuAm&_nc_oc=AdoYPcluxBnYolJju1G5Jsn2Uy0nWP8iqbsr5lHnCyG1GvKi1FlcmTnt0B5TA55hClE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1EW0pgHX6ZjYkRnoAazinnV95ss1E4gU9SVMooPqDvQ&oe=6A898AE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j23sCt4RHqAQ7kNvwFgdJnz&_nc_oc=AdqmzoS9dkbuepc6BPQh2GmcB8tMqXmHR68F341ooZ9Hq6_uwVcmWgBlH2X2cC3USIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfdqb4mo5R27s6IMUN4phzockFXIp_6_gg7rErxad5rg&oe=6A8987F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jyJ7Hrhh2YQ7kNvwGoQrXU&_nc_oc=Adp0UZruUtpecMutxnTVv-sxMApW_jYgMAvcIK_j4KTFQ9BZ4T4eL04qcDHlpmKwfcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuhe0HDgqkFaPODANJzXK3dIIG2kYMrneIj42jYCI0Yw&oe=6A898C71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
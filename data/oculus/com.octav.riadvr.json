.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1byJI0LlI4Q7kNvwHb9dBc&_nc_oc=AdqAHqk2yYpGT7nGxw__kwU6WQPGC4aZ6QujapPoUBCL7iJlh3LsIqYnVh533MXU5b8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90zuYCG-o1WteU8q-539NPq8z10pj3-FZsB4LkRwJ48A&oe=6A356325"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyhVfXHt5oMQ7kNvwGFmbq7&_nc_oc=AdrQgQJWaEVAx5GWbUjYUS8CAW_S4ZVEnMDdXlUhbJ6YKQ4luiM5EH5qyNPpdOoGS14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8IXHv1gZjkQEKAanMl14vYiQwzUQsiyaZm1QYZlwZFg&oe=6A356030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLMNV00ecVkQ7kNvwFzzbx-&_nc_oc=AdoSBpHsvvzEh6hGL5h-A8GXbDAl1edhjUM0Pab5xjk1mccvCOYySCSoQH2jmInHtto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-De1DqHpXbUpbG2LHpMHh2G_rTjEPP2XkWQwGPxFRC-w&oe=6A353F12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
WH9tGr4OFqt8AqIMdiYgSBMsEq6K8INDsudsFMgqqnnlnSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yvDiLPm7kRdfLjrKS4y6HFmWcuI68don3ACIxKSu-jQ&oe=69E38E2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11eI1aIYCkcQ7kNvwEJc09z&_nc_oc=Adob-KzF8V2wPts3sbsOC56toJGuUPoV0RHrPc_NzKISEArMq5ep5Tpsyvh5apw2-AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eRvX-kAIcV4BwrnSMPRvqGo5A-H-9lA76uFzO8YjMVw&oe=69E37CD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiKv75Smu9EQ7kNvwF8_w5H&_nc_oc=AdqnEQOWcnTbigIZFkNu7LCzzH8BPfAqtRsWl0nG1FY3FaDPPilaRpeT2cK-25cOZqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mv_dj7swVbxHRnFVhX_TORON215sAMJSbQrnpDHEuWQ&oe=69E36DE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR3ovM-mgMkQ7kNvwEdIhxS&_nc_oc=Adp-Q6LLJFIXsPtLdDDfUSG6K7ueHaFzWfuwNiW0nYOupFvDAjbehVaQEynb6-VV0hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VDub1vwkjkhcJ-Oja5ba6cF5FlV8iRItBCabZPEyFjQ&oe=69E36AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WwThWgcRNAQ7kNvwGbaqlG&_nc_oc=AdqLzrFDu86l95fRtMOMokRdumMlC5Qhy_eneQTeiwq0fIpzFeWyyTG5pKzRk0an8pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05kjSxgRjyyRSKeQg6Juy-QcaypimBe3OlodMWX8_6VQ&oe=69E36F71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
ylwZP2Jb163GfRBSLbguCh3cYxhFl3T2bTH_PAtYZu5YqERnjDY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHo_Xylxt56flrRcFJBHyzUuZiham0sduF8vSvehAjbA&oe=6AA94F2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN_xWg99GcoQ7kNvwHjlljw&_nc_oc=Adop4AB4HL7MhsUhv82Ou-wsHe3-gZIT0N0kOESs1bVe3KflNFhqFmQoNrMKSn6QAG8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI67KaBwnEpPk76A_Eu1RI0oJLRtBvelZFPautErkeZMA&oe=6AA93DD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6KwZEm6FoQ7kNvwGhFtTX&_nc_oc=AdrkbStOFvDKnqeQ6TgRiVxo_aaKEFdmg5pWJUl9cIa46csnbP3R_xwXf7yOEwqx3K0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG7nTK0rFCEidnEYFDwqxw0SXPd8rOsU4udSEGVN7Gog&oe=6AA96725"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frWA-weZLxoQ7kNvwE98aTp&_nc_oc=Adpotwj3BwVhlcTZcQ3tGDehfBeOdbKyOZjkO-rMBq9Wg8kjzjv26WLCJ5TPZXxKuqg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC9oSeGDwlLdOURaA-9IJCuXipjY9U9AOP16U0HnX-VA&oe=6AA96430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy5qatacOokQ7kNvwEm-702&_nc_oc=AdqGFh1IcWB4Dhz3JC2A6yXlFGNLzmWwywvWriFN2yMrusXIUnvburElZlaQFIR-YFM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk698PQH2-v643613L61ZrR2e4cUCwUEqVk8bJT7zv9Q&oe=6AA968B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
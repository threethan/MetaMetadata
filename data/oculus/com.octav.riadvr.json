.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfW8RxZBafgQ7kNvwFpxuUU&_nc_oc=AdoMSm8wvjG4vmHYRCwENwWduSRsawR9ZHDLV3P9d3EKzIfhycGWYiSJykfzhTs5mAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIq6PcNATufKVT5Dkuw8w9M4XXNlqGhiqbwfv01b6diQ&oe=6A634F65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdpA10ZUqYAQ7kNvwHCLOsN&_nc_oc=AdptS2ytRDB1opqZ-y-kcniwj5YnUOto7QfR8EEX5pxEcfMWq1XNuXGwyyvynyVrVk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7anioEdKu8-z-0SOkmvzlOPOlTaVIHCBKNvBMYs8shg&oe=6A6384B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WURw9daNne0Q7kNvwEoBICw&_nc_oc=Adqf5M_QNF55ux3EHaGgOoxpsAyTbicaqnKb4FqXTir5ab3AXS6kz_7JTyYA2XKhg5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt14fON9B3qWVsLzQL99XC-TSexB0hyu0CiA6E43IVVw&oe=6A636392"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
k4TMb1aXnr9T5hqb_YJSsEshXTWJfZbdTql9u13yec9V_JM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12A0NuXYhq40a_J5H9mhPmvVzOVCrufTwKEeCbuQVpWg&oe=69F6032E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhBqo8_U_AsQ7kNvwF5rZKF&_nc_oc=Adqc-yRLwkAGD1cHmhcp57QGGxECBQRjEBmvJ6K16ZHLIaOwI5JMwwA-EgQwRr7ZAyo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kQk5UeOtG7cMRzo_bL21LZrE8vroKGvrZvFn57_2eSw&oe=69F5F1D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSBtRDKwxBoQ7kNvwElBufA&_nc_oc=Adr-ySshu69Lqw_1k955tzYSVt-CfPFLrlGeIGETg0MSuvhRo9k_ycnjhiv_tk6OkA0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZjHujZuIzw2i0DENSPut1iezjYtDL4PWmyC322ZiBrA&oe=69F61B25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCWCGHwRQ9YQ7kNvwH8qCFG&_nc_oc=Ado6M8kJj1UIzCv0ig0cbmzYFxd9b69wLvr56wDg2a7N5Gr2lAYEK9FpHPfNKrFjtzg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iN2uqPQSp1KQEjznutA5X293ylYGyedxYlIqJ_P0-lg&oe=69F61830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucUm9rnhS6AQ7kNvwFWhUgZ&_nc_oc=Adpc1VWn2qqFtQCO1NaiHP6sZbMrQTveG2Ix8n3A4i9Qrg5K41OROiolyLIqUpUbxog&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-d4BFGiX3HCosuffmNbbhyOLqmpvdyMiTzY2_JsNdGA&oe=69F61CB1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
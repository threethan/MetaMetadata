.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRHbI1n3TBoQ7kNvwHJz3k1&_nc_oc=Adoavtog4KaSmOPv0Pz_tehNQokrV-_8VJTpNSdh-5uNUS6gGtW-5lkdZRzXHVKaMOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvlBpge7JBnvv0GF9q4Xjf_voTg6k73hSuFNHI-YmZIA&oe=6AC273A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax_YTUkdBH0Q7kNvwFrQvqk&_nc_oc=Adrj5KhIUtGJWBsor1k0cpus6C1LynnPtC6X-Rga2yhKoES9bCy2caL0udXYgPBLJkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7uh2TmsfzRE-eYed2GMuBMwkAiWpwW5gc1ro1N-_eWQ&oe=6AC270B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vGEA5QARUkQ7kNvwGCDRRp&_nc_oc=AdoofjxRgpqFt0hUgIZk3a2o-5DzBdZfcduL7CAfqzMMw5BkXgUEtUAHzOmrw52O-Zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW2s26ZqBAQN2oaJoiJ_l5aKZlSEkin5Da550ORd8xVg&oe=6AC24F92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
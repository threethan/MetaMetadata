.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFPh1Q_XJ9wQ7kNvwGOchrM&_nc_oc=AdqSAf0jPyUC6DOrxUkkxkZP3IhfCr8Vineop7A4Pq-uF4JtT77C5lNL_uHaTqtjzV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF47HLxTvASAG_OOdys-_YdsOq8zeoRmnqmTJ_Kf73HQ&oe=6A4FC125"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdY_B1K4sZYQ7kNvwGAYquc&_nc_oc=AdrYQkzquQHgv_HhdTWGaDgUJRL3JTq84N9YgUs06vj3maOw30dTVslgMQcGstF-ceg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxPg_wgBPEVPgeYxk7UoRIaSLVs_tmQgdgl8TQ1cKFkA&oe=6A4FBE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7D6hpWKKUEQ7kNvwEdou6t&_nc_oc=AdpBAjTk4ZPbKcgqAO8YifdQfqDhVd8L4xlkBhxtTQHSjBBeiqB2k7PTkz46TS6F_hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRKRrdk4LktP5CyBAW2M78iqF-o-en_vRx7DZxL_sWwA&oe=6A4F9D12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
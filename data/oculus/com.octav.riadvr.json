.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfFj0AS8oAEQ7kNvwFX-gqQ&_nc_oc=Adpl5GsV21RkXi_r6-9O_O5VMIy1_34pOZVsiIc2A_t2apdG0iGTJP-ZLKXuSrVMMjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZmfviWJk313L4ilh7yMu0s698cBzCkwXeCe5xB1R3_Q&oe=6A283425"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEm-h0hsPYoQ7kNvwGEel36&_nc_oc=AdqgSPG2cke1UPPCjisXz5mAY79gKAsCvFNvdHAxQ9ZApuakLPWuVA15G0Yy7mvow3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hw6ElIKrdb_mO3GHWXpXDOXBstawYmm_GUpkphHqZ-A&oe=6A283130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jJdgF1aMq4Q7kNvwEU_NrW&_nc_oc=AdqJ3RX8nE6eCtpoH-jPD4cdKuQVm2jP_FqMG-yaqxFzFJgexWUn3gmX0pN_DCUxQx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M11cevIylpKmTI1ef0r7Y8ovTIwc-OFNnawgvJXT-EQ&oe=6A281012"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
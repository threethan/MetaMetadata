QD2FMPWE3trpZMvMWZdIOe5iRbiFW6RWMxhirgLSJOJcoSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVZRdZkZA4VBDgEqTv9wdsl83GWnHdZR2_aAteO5Ye6g&oe=6A9C202E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1SKtOAwPYUQ7kNvwFS6ttN&_nc_oc=AdorE4WuQFQbBMqgBXxZurY22h9-OO5qf2GW1UrEOQ2babQsLRl0bMHGEV1KVOvif1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs6xDLe74fopR-AA03JtlU-QsLgP5fMcTBRy8PVziUrQ&oe=6A9C0ED1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uNCg2bc5nsQ7kNvwHaUkL-&_nc_oc=AdopW6xa5v2x7jDTbuGrC323Z77vPiPozqG39Ul9TZdzyA5mgLEpqOdaCsAcdkn7c4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl7ehYZJHj5kV6GcBXMOFjM4z9NtgGhc2maJUXXoy4IA&oe=6A9C3825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCA30le2cMcQ7kNvwEzadtM&_nc_oc=Adpw042QLE8jhquOIP_NuhdwaNPCSKElPKjJ_PRbSTm0DGWHFMml6IOt0yiJokRiTyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfvQZdazZkSNeEEnnkS_-r2Pz9BGxY2ui_yRGjSAWU6w&oe=6A9C3530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSJb0WkRWxIQ7kNvwE95qiH&_nc_oc=AdqCDYdo57PfBqYiNtkOTxWHnmQfmqK_yNerFp_4-WZytneBwPi2TQenn4r6x4Q3UzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO0WToLG46gvVTWgL4K1o9f0OQ3Yqf6kXQmbKKhcwA6w&oe=6A9C39B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
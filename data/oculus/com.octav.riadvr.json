.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy32zVgSL10Q7kNvwE6V_Pc&_nc_oc=AdppLxhqdLCAPwFB2kylHkV-Xhk-f9OVngoWdtRUH1ZKnkL-qImlfF-9cKApaftBA5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dJWC5LGijoL1SJZihG_6YLeGes_r8ydXidXo30dyvGw&oe=6A316EA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5QL5X4cEWkQ7kNvwHlXxy8&_nc_oc=AdqNBXCfF_7DAva2Q2Qary4efFJDdOh4HC58xLFzCt_yjqbh_W50-KXpFeSrlKy_ay4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af980LV5a4w8qIeW30rW-zwhIIWj0XfZs4IcemU6N-pbdw&oe=6A316BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Bkvr5LH4IQ7kNvwE5NRKt&_nc_oc=AdoBcwU9NuzXkdjDQU3VWZW96SFHIRabS90qdXBekugOKiaSEYcZDgBdS-YOEEK2_oQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W-ROpdfz5bAo2JyfF7j9hQEO9kGyvODY5i0nDU6xhAA&oe=6A314A92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
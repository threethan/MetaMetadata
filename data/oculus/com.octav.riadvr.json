elOORFUZH5MG_RC5G_7LrhA5q-qP3cmp8vcqzsxhmBAYgzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5h_yr7UIPePCw7GAb7CPrlX4X-brLK_TyaO5oTpzBA&oe=69FB492E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mILmLCtWvqoQ7kNvwH5p2de&_nc_oc=AdopW0dzelrlzFoPIWfn2-pG4_l-cvI5D8PJzDcE7YwzVb4nZ7ka5wQuzlKAhU9C2CM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rpw8Ml0cKfN3Em0zUbXZpgQ2xOy54cPbn5NtU4VEQcg&oe=69FB37D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZKQwzbK924Q7kNvwFjGLbr&_nc_oc=AdqZf-UvIqcqCy8H8f_Cn10ubiHnO8RpK6R1ck4DIVCiQOAcQgG4Avpm5KsGn467sO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G87XhnkIXgIt-9S2FPVgc6LRLJZ_2EnGAiRRjAxn2CA&oe=69FB28E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4x92nfb8AQ7kNvwEKwEVj&_nc_oc=AdrG7NIAN7uajz9Ua4b3Zp4NfcAZDB1HK_wSiRvgPenTOqr0BuMmWtxNXqFPq5jprns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xdml6UcNGKI7m06vmzcvsoAxm5J7py2LBMxXn5e1Phw&oe=69FB5E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d9NEn2dS5AQ7kNvwGDsO4c&_nc_oc=AdrkkMftSmIJmfJ8ZOAYi9mWcV8PVnMJlAGM9Q3j_bzHuZ4jaZKISXPoWLJ5hEuy5lo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bicTrqjiScNi1YB0QNeLC62oli-2aqBc9k-Bx7bEgwA&oe=69FB2A71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrkSmVRYcUgQ7kNvwGen89j&_nc_oc=AdocMY0Iqch-mPildILgeJomr1WhlCIVBsYi1CBT7qs_DCOSzRRRONCdYN-bRrGNn5s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5EnBL80wforJP6bQMtITAskQft2JOdPiQQW4uiF-gHg&oe=6A2C28A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBJzfR_A9zYQ7kNvwFrDFAv&_nc_oc=Adq-t47jSYVYF-lFuxXP0T39lyksYRIJiu3Kyqu9zoJaRZ2FJVtR663PzZXiBp3dtD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lDepa3TslMKIqgKyArxB1k53Liqx0hBO1cDv6ouof7g&oe=6A2C25B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ctW1MmOhcsQ7kNvwFc1hKo&_nc_oc=Ado3bdp4bzvZpb81LVMZVjr63cVDWEoQTM8O-d_-eAAsX5ettkoXjVkbAldme2lv7wg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5kcBJb9Iad6mAL9bKw-Ylo295QNgDnMELaiuy0VVRoQ&oe=6A2C0492"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcyCodbO748Q7kNvwGM7y0r&_nc_oc=AdpPbgo90-flGyo1X1MguiFfOua4XekxtwWfOTq-jL9vq0NtJ0v9oj96qhVQByjvxDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-stA1Q-2SavNxH_aRujVqtCu5Ge7EbyZ-gY9G7-V7aQ&oe=6A089025"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThW36yar6QYQ7kNvwFwa1bp&_nc_oc=AdpZ5NU1IVwqRhE9a1YB74kHCIUni8pOBymudvzCXnW_L9hmusEVBVqZduzFiFLKGyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ybyPC6qVLQg1KG123LeBPUbeqWvu-OCZwjetuh05EIA&oe=6A088D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q03jfkHplL4Q7kNvwEVo_ih&_nc_oc=AdokAOF57bfYwkaLGBq2EJhmxIaeg0uMPavQLiJ7JOXxX6HsAsiQAaSUNYqGEfmOQP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lm7-9xcdYxSyQXhaJkdscBezzVdVmwKChIF_dLCafCA&oe=6A086C12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
o6Lf9Fp0HxLqqXfY6P460AlBm-lLQ&oe=69A2F4AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gO1UmcA4FkQ7kNvwH7yXft&_nc_oc=Adl8mDEhIqtZuNBs6egCJDj_-mlrrzA1x7_7dvgB_gSp7GgW1xW_IV9UfWZiscSarA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDazGNIi_sldtpjdKcyIEIh7UYXDaaHeL4QWIWbp2cHg&oe=69A2E351"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWrVCxiGDvQQ7kNvwGSH5xA&_nc_oc=AdldGjs3NGT0SOmXxXcLnCG4wulF92uK2Fu1UuFfLXNSfqHLAGsLOKhNNvi03IWyWUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuH2zRAGhi-x6Bsz0CmJcpHAgxgsMXoEXeCTATnAkY0dQ&oe=69A2D465"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxhLRspiPs8Q7kNvwHMJf2Q&_nc_oc=Adm3Fs6mfuMuOyE0RgZDzurHbXSBxM8O3Yk8Z6eykvq6g_6J7Kl0ArRKS5eiA9GVoSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDS7-WPS9DFaYkCwmO44EsnuA_MdqD0kJfYbDMIOtmWA&oe=69A2D170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9uHaHRGJ-4Q7kNvwGW5vNr&_nc_oc=Adl03pi8OXY__Yv3scISa69H3fGlBqjmFIdweQcZcvuSwY7XSqaIPkwoaMHnBvGjAUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurVIxkUwWsjilZHECpCZGmJ2ZMyQsW_9Ae6PntHSrF0g&oe=69A2D5F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750843311639674"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982508_2345965692405818_1409234898877630
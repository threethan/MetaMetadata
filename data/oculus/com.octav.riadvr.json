.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8NV0r5TrFoQ7kNvwEBBeEp&_nc_oc=AdqPtCnxCmhCU7nBeDB4B515j6DLGazXQHefkQcEXyDzYNr75mHN_DwYUH1IgnxXYoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TEUWzfzOEPHD20CyIE92_TBq9OS5h3eKsbHl87NTXLw&oe=6A186225"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWWRyZKrsN0Q7kNvwFq8HSB&_nc_oc=AdrYjZ-AsY7LuefyJvvwTgBIQjd_66aosXR8k9vh_Pzp-dIof3e06U42DrsB5wZe17Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BjQGPeNe7Nvj8vGx6-3P212aoN9jx6m1G29vdGgyb9w&oe=6A185F30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J68w3IYK2OIQ7kNvwH_NfTU&_nc_oc=AdrcL8oumaw-zgU_5l2evjdVLF0ZHW3NkrNK1SSZ7nsIXcoc79s64LSlhHAy4XdlSoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N9zop1axtNEDcSdCDSDHx-79eedt5REcwYNe75G0SMQ&oe=6A183E12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
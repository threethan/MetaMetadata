.png", "id": "454532440811338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vryfERMXG2QQ7kNvwFc1FNh&_nc_oc=AdrTlv_nwWf5s1cl3oNb0RI7trYr9Rn8Fx43kTqrzXX7muJiN5FKugBPVp09v6q_dQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnYTjcOnsm2MxhRmb7JPNwAc9CcRV77lasR97AekKF0A&oe=6ACE5125"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM0E8aimX2wQ7kNvwF2y4z9&_nc_oc=AdpGBvWOHEhMq10GgjVtDP1nJeHoWDYdDqmpiyKvhfsJ3f6phVtvUxlmqH40pGDesFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEEBmf4SYFZxWQ3N6eLZx3nVqLsUXNVx-L-1O0_c5aWg&oe=6ACE4E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArtFSJN36zEQ7kNvwG9QFXl&_nc_oc=AdrFwxAGQNZX5XQx-Uo_XzNCeZY_vP_0eJ0-KPpRdTBho5vtZXIyzhzasvpBrHAqC58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3sICzOXy9RqVWN3LEqt4YAt5JyqlEbWviAZh65WTFww&oe=6ACE6552"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
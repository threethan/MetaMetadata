.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDVDeswGhe4Q7kNvwGoBmrF&_nc_oc=AdqJrJDPUnrmVr-4NnV5LD_nI7KbnTQgbjj1j4uS-5TGKZ1BXgJtIq8_fkjLINhrWzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mlbTb1m_82Ddyl-tiXZUlmjYw5qYvKCDjCK96OusR6w&oe=69E8B3E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLT-WAi1iYQQ7kNvwGmkCPX&_nc_oc=AdpvCEt0G1qe6cH2_aFtatX14OERpWbhyNxsBamSgltP5UgwowA96nZXcc_HrpcWuqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UNGrF58rkGhbile6eaaC6AHTtMkZv0NkWydqF_M_L8w&oe=69E8B0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATTQ9uGUNeoQ7kNvwE7BFP_&_nc_oc=AdoQkTPX9yDE1o5j8FQVTMHkBndfYY4X4-_HEJyStE_LRaBSs-JJgGouSWN8R7v7OgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JWrzAGvb1-mdDxubOdU0TBCftdARgX6t7K5TER2NtGA&oe=69E8C812"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
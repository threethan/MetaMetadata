.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8NV0r5TrFoQ7kNvwHYgvCa&_nc_oc=AdqRkRjt7wVH9bSgcQYEt1N9CXXIki7XF0-HKhYs_g68XAuCK_NGlCGkf5Shap720so&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cgAtkvSrOsP62Rg4pxMztxxfDnqx0BAktsuXey0w39Q&oe=6A1710A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWWRyZKrsN0Q7kNvwE8aBnZ&_nc_oc=AdryC8EgKXUDuOlCJ91j0bCeDWZyuKfGQT1-b9JYBbfZKY0xSB-NK57pDItNcHwSq74&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HY1FncZI_zsFCDPYYIi-tv9oykJhpJuuSEKIBMjuBqg&oe=6A170DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLly3X1dBsUQ7kNvwEdGppE&_nc_oc=AdpQiI7Y6Spi3g1uZiMhPHDwtVfco9YfGr5ac9PVnUd09TINOiCQdup_7Q1xvyVImsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68sSliJyOC_pWQb72QJ0VVP26J8mJShk1H6aJs4gTNew&oe=6A16EC92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
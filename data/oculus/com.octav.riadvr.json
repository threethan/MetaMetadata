uEYZw9EZ6Xw-szj8ht-PSDAFUR_XOCW04TJYkghJUJEQsog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqksPE6J0PmpyuFnmRj2zJyDz45SMFFMG2FeedX9ut3Q&oe=69CD24AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBR3TEvwNxsQ7kNvwHO2pSR&_nc_oc=Adptg_P7gMZhk4ngfl0UHqiB3lLa15_1mIueJlXFdv-nfgLIvIeHLfwdKnzILvMYrDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyocUOnq6yThwVHv_ieSH9PsaB955r_6As4kornyea12g&oe=69CD1351"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BMJu_6YKLEQ7kNvwHL-e1d&_nc_oc=AdqBhun0tHNe41NCTaL-J0KtuJZg2O6BNp5ten4hS9mgmS_7xOYdMXpfVtF7nSWccQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8OLGyAzikxHYS8iDlm-9EKpvhtmozCyrWyDKFzScrcA&oe=69CD0465"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r--tcqZD9sQ7kNvwHq1gxo&_nc_oc=Adqwcioej6ok9yvz4xwDzgveuIK6XEuZnGVKxvKUcCE9Aj7NwKO1QYSw9ubxkNTvm2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA2q3S704cKVNmZbq1YzC3vetzMzuo2zgxeXGNcRXv1g&oe=69CD0170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjvXzvkPCmoQ7kNvwF3gxwi&_nc_oc=AdpySvfW-6pKX6A4Ic_1hS6ytobTieC6FpKau6iT3n3uuxaJGuRU-t16NErJEOTXjRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_rLGmpcZTZxnGudeH6Q9pQ5CT-dL4sR2c5xnm3gpUFQ&oe=69CD05F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
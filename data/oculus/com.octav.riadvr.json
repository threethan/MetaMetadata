VG0y3v7BGDtcqNtYFl-Qluoe_DGAuNEjfntB5b7dlzAq4zs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2D1Xd7EM4HlxSlOjog2wGMHiNyIr-tfirv1M6lslpHg&oe=69C53BAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjfFhA8z3kQ7kNvwFEZhhh&_nc_oc=Adp8vR4WkvHEXKmYwLaFhyzmJKWsPpAuhYWWDMBGxMt14Jb0FTemRaZVNeN8TcR0Evk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeGRPG7aPmvThpVJL4-qIZpejRrBXkvWUD6upxTLy3OQ&oe=69C52A51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ju7E3KiULMQ7kNvwFrok9A&_nc_oc=Adpm-wjEWdIjK39yaWXQKiS5LZs_c3YIdDSGr3QWRZDPf_SWKEKGYtSA-eImgGIk43o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywRw42M2sIY-BBnNtKHdY67froWSYg65LMi-I29-1-Lg&oe=69C51B65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vNbxAVU_C0Q7kNvwERVKVn&_nc_oc=Adpdj4RvCI5jAtz8M1LcMK2lGWBhsDyiNWeP44XwFbjHNNXef0JYX38r43t4QuXmSwM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXZyUqWUrtk2_LQJrIVxofIflE_mGskQwUssEQ8Z2Nrw&oe=69C51870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8KarLhphloQ7kNvwHIubF7&_nc_oc=AdqphSqso6yB20Cy1V5Mi5wLnN2H5Ij0t0yE00qysNrbDPftZzCIXz7hRQu4QQP1v7g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrHnfVVf1OLgqD8XQZUJRAKZ5_v_sxLc21dDeoScaEQQ&oe=69C51CF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-A4c-Im0UdoQ7kNvwGK83o-&_nc_oc=AdnfQb_Nd5K8K78nKNhQaVi_I2gyVzWKWVsPYFwlm3V8itUkR9QdqfAp7DQuqcpmBrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyWhsCe4xD9AXKjxCgzSArMRMdl3zt8_eQ9Nco-vS3TQ&oe=69BFD565"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZixXIJ8OTUQ7kNvwHIE5Rh&_nc_oc=AdmrB36fjk2HG8f5sZVnKuYvRV7XUICC6HY39S2dF6dUImEHyFwbJ44744IBxUk0jNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7fWuohVrv2xvyOu69XCV0LZrwRKDzspOtzMP5suXO1w&oe=69BFD270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW8Qwzh9kbIQ7kNvwFAY_rX&_nc_oc=AdnuNgTBFaXrlzPRgfYPrRWMzMBRqun6KZH11KTx1rhhYN0WM9GEO_EpKee4vK18VtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbSWH9znxwSS2q_wUxxJk3cGZTp9w3KSZ-NRDWZRTcIw&oe=69BFE992"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
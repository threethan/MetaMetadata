.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN_-nbkJA40Q7kNvwGHgBB7&_nc_oc=Adoek525gjIlnh3wDcl1EhVKZQHmITPEtn9DzITNhLikI9qW-V4cFEIIuk40m5R2Q9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY8XSSF6DU4q7G3_yrb7zKAEMRgW17NEESb4GH4vo9rg&oe=6ABD2DA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdhIPKIB_AsQ7kNvwGkUK8n&_nc_oc=AdpqrR2jGhyI7Z6XeaOvKwFCFwXjD2YTNzjerXOm6lUtn2_rB8ll4zgjMZsSfq4v_GU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9mdLkW4WsIkTwpinNM0eXSTNIANqNwHlJntu3zABh9Q&oe=6ABD2AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN6uTBHKFpsQ7kNvwHVs-Ta&_nc_oc=AdrLs-JUUnMrhOz23twYKWzGjY1NYcWDEFipgxOJcfoPH194wN8Bk4ir5w6yarYIPd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMcKt0DfI-17N5oSRXjnJRoXiM1hIgBTJDEjmbPsxu9g&oe=6ABD0992"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
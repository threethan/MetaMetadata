_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov6JOkFuFBoQ7kNvwEhFxGr&_nc_oc=Adnm-CX5OtSkfK4a1oYYCb-FEgAixMC7yq7aipaSVscX5bI8uvNs4RhGizBM8c9bMm8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfysdedP5SohZL9mMyS8PlK7xqL5Qv5usQvI5L6Ze3hzfg&oe=69B2A665"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9-Rr4--Pq4Q7kNvwECMPxA&_nc_oc=Admr1KRDfTLtLmQ9hVBc6HV8QoYe8lAiWPIRoFqgW9HopEEcGY_y3lrRCDztwNHOEFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxA7-8sSEhQy_xnTMwaWgx88UiUItuv-pLvHzNmTXW38w&oe=69B2A370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db_wahMiP08Q7kNvwE3JodN&_nc_oc=Adm-0ZczqmzkQ33pmFzyQQU5oVCLNVBmD47q5jZ-Cyqmqiofd3OKINTT_4Z3cUbxzFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSrHUH_hJsqDQjuP2TVPV62R_UerIyvkFb-TfrbmkBHA&oe=69B2BA92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
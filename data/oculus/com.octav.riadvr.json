.png", "id": "454532440811338", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiKv75Smu9EQ7kNvwHT2fH3&_nc_oc=AdrDuqy1ktS0fBQIMp8aPm0IOWB-RB-nqg3ORJLXEhNuf0lg38wsqOjN0C2AmFjVwIE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QKpq4V__bmZKrJw3wTXTPdQQrZPNjvt2V0ECt6ykSNw&oe=69E21C65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfBB9lAaY84Q7kNvwHq_TBK&_nc_oc=AdrIa2WvGsvBpKbPxW_dVNLB41OIazDW0lVL_5xiOApo1pZb9pMv1pArzynW6GVL2Z4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iZGKPhOXR5phKHtETJZ_xrlw3MaTKVxv4weUbUDx0Gg&oe=69E251B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uROOSChzXRoQ7kNvwFfy0aJ&_nc_oc=Ado3IFmGlDPsrQL1LZdNgpRq5a2BqTab6gldK6N7j8kLGVmOSKQClv7OGuYMJdfn-e4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tWjcP8m8ydhkfLxb-9UVlkVRvTJG30tN-io7dgg6oKg&oe=69E23092"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
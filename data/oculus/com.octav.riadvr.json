it8kX8r976W1_qg0q71186NIaoo0gpOJnpZn0sorVA3MQRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MbyZltvsLOSgYhMf5iVTOp2QXIif6ytKHmXFPCR15tQ&oe=6A281C2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wuc1G3OYMrYQ7kNvwG4PolV&_nc_oc=AdoQ4k6RgsPpjM1ZIdWBDaC6-wbC_2xEI0klnA1RXxeGa3V5C0UtILn94wHYx0wnq1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NpzgGXJU1OErLAzZntWAePZFRp0sBYsU6DuI7zAIsRw&oe=6A280AD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfFj0AS8oAEQ7kNvwFX-gqQ&_nc_oc=Adpl5GsV21RkXi_r6-9O_O5VMIy1_34pOZVsiIc2A_t2apdG0iGTJP-ZLKXuSrVMMjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZmfviWJk313L4ilh7yMu0s698cBzCkwXeCe5xB1R3_Q&oe=6A283425"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEm-h0hsPYoQ7kNvwGEel36&_nc_oc=AdqgSPG2cke1UPPCjisXz5mAY79gKAsCvFNvdHAxQ9ZApuakLPWuVA15G0Yy7mvow3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hw6ElIKrdb_mO3GHWXpXDOXBstawYmm_GUpkphHqZ-A&oe=6A283130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCl-4HqW1QkQ7kNvwGh6ZLb&_nc_oc=AdoAb98QG4ZTTZLjL7fsQ-I4y4FqoRvbPk9Qt7MrsffMPrPyUYAxJfaAhhbVwYYgIIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nYxMfVoHQ5PBC9v2ZyN-SurUkNSMhDrLqcUShQoFI9A&oe=6A2835B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qawMmHwDkQQ7kNvwFKYh2k&_nc_oc=Adqo5kMhpyhY7-lnFqlPAsRgUOgD_ULbEyuO8JthSpopqk4zCLbrYyt3VN-qDKbk3fU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpxLBLLIQsR9ivQsu0YyNaOP0Xw1cSxGIjFxrilu1VKQ&oe=6AF09825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_CoLZ0gRAwQ7kNvwEBk9y1&_nc_oc=AdqiA9az_szIhivhROaU0ye3Ssv9ltAxUA7CIgZiE9K3_dY9zQmTYKBIqU-m9moziwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmJfibNT021mhOZPIMD5k-8yOS-hpjo-lf_ebbSvE7xQ&oe=6AF09530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOX0L9XMBLoQ7kNvwFaEpGl&_nc_oc=AdpPBGrbappK3d1tPVw8sRKXMa1ap1L7gUQE9Iqp7YyWvFu3Vhslz3TmP_rI_naYjeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5njHRm5JXOQU-ynDjoNOLcJDWW4_bzTXQUGQ5oeUbbw&oe=6AF0AC52"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
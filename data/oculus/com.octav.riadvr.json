_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFFZAbHy82MQ7kNvwEOTR0j&_nc_oc=AdlnMttgDIQK3XljbtX5Z3T1yHOJxKCGEzQI9Q9htVaqKuFnnLILYq8_IheuWGTX6kI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_OjyajAdxrdWa3KpC39FEgyyZNWOoykvJkuJv9NvXiw&oe=69BA8F65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D86pHTovzUIQ7kNvwF1hb_Y&_nc_oc=AdkryVjDB83O_0AHhR3nQkBby8y14bmShwjhY6zXArybL4XwrphdCDiSL1vs2-tQJ5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXeehRaUi7MMrBL8fvh4lCaitvDIoKffqN8PIZoO2XkQ&oe=69BA8C70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXq8-rOSMAsQ7kNvwEvt1qR&_nc_oc=AdnZ7GyeaOtxf3nVIjLi9lRXMJCcmaptWbIo_tNV-yTbSyOahyUIlEP8fMF_EwnJ9uk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXf7zWpp10o_65JdliDUHhaSLFDEtjEitf83-K9SInCQ&oe=69BAA392"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
GZJvTHkVTRYqxP1mJnBvdD0bOFRT8Ik8uECk8fQq1jHR-h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn6iKTgqtCRhElX0qIzWIzmUi47lxe4JL3j7ijr6e1kQ&oe=69D1192E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-MfGWkhy0wQ7kNvwEiGwlG&_nc_oc=AdrLdFkXn5KBsJtbLVOGEda19bfRXqNKJGMptarvz9DlDG_3v2YlYjwoiMzcAs78Cyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-QBM22nkaBmcwSHtpnVtadxb5Gwp6RX3DY4zSwy-1qw&oe=69D107D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtNcOXXH50kQ7kNvwGLOsQu&_nc_oc=AdoKD_sPfsvsQy3zD-sC4SApCO4bprPBWdDg1NLvxO1lM-0J317fSamsGsjg8DlTEqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxo0tCuRgGEi0if_G2d6JvTg4jeEU6TMPl8yrSXjDTR7w&oe=69D0F8E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWqoTMvcCDYQ7kNvwGF0ATc&_nc_oc=Adq7MCGtjNzT_rCi2DyoCcepFS13PmJiqrxzvpY2fFN-v4uKh1V6T3Hc6FnT8tEjWnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv3AMZP-moZkjajZqXSV1L5LdJTpj547rXcdNl-ZR1Sg&oe=69D0F5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSMkIq_MBd8Q7kNvwGNzX4v&_nc_oc=AdogMh1kmSHbhe0bTSLZPGr-aZdxXLiWfQXIEDhoNha9Noc0qHsn9RmKnZJO3SD5flc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU9XybEfycHLVar01OFoUVXg37UKcxrmPhaIJH-CpJKQ&oe=69D0FA71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po-l8UDhFNsQ7kNvwHowwVG&_nc_oc=AdoRBcLfc5iigQSdY2NrbyIeaCQXmq0fJEEv8AREXui81EzGVHY6Tx8BMYh7qJcRMbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b0KwXoENJMB2LJlqY8Wu3gH_6Dc-AOxyCkpqTB0g6hg&oe=69D39BE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNY8m80tOTkQ7kNvwE-B0Y1&_nc_oc=AdpTWaErPPOvvXU3qnL-y6Pqg8UP-qc5DZHoAyEiN1h5CIow8_C6LK6qlmTSEv0KsUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e15Uzkg0gSQxmWePgWeDsQ4JHlm8JCJeCiba6uEuKww&oe=69D398F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQN6AhKgzoIQ7kNvwFPqHh5&_nc_oc=AdrIAOK6xf-5Oj8ZCP9hv6BRgjKt_t1xhgj01XlBzF5U4rOH1BeNOzDfuyQ23br5nrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0seS2wFZ2ZTWERzBM5WlTc3zGOWD1rSCA0Z9MmdEGFJw&oe=69D3B012"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
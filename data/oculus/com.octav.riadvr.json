.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXNei4HH5j0Q7kNvwE7Sc0U&_nc_oc=Adp0QUpXFNvtOcXgv2jeCcXwTyherzdpcohUhVn2C31H9BFnI06VCa3tRSwe_SdzDuU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOQ_kAXr2QIzQq-umCYBx25U-nHwezmz7_D5A6JFZiYA&oe=6A8444E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQTvesy2c-EQ7kNvwEXn13o&_nc_oc=AdqC_U2HQjGYS8BbEfHaPYlcmoKpi_Q_uZc4fy9qKk-Lv4CygRbhZL5x-NKoaORaTvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNPfh59baVyWa9LjuH3LWt9TZ5u1lcxps73ySMMfIXAQ&oe=6A8441F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoZ5WbtTXJkQ7kNvwG_CLoP&_nc_oc=Ado2ZhIu3Iqt3caRNGbQNeUPL_f9Eefk1hJjnBBTeymCTc5UNIDK0UX-AAtNsFxG0rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt2WG1CQ7y8aQ3BZSjMKbxUJ4kmcuiKO3biQSaKjKX2w&oe=6A845912"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
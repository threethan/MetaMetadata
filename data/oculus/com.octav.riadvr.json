.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZN22PIY_kkQ7kNvwFqX5_n&_nc_oc=AdoFVJfZA3Jqh1XiJdas8grGf0IwoGYrb4oHmoAwcB1vd8OTvAzv7IPFFgCr-A4s-QA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmrGmrmhr5ZRkCh1Phmf43qWVpI_8xyYVacbWmCpJCwQ&oe=6AEA00A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdGBh7-8xdYQ7kNvwF7Fo9o&_nc_oc=AdpU5E98euQHtmhubl0HBLMydn6OwWpAACtFY2Xg4jhZLm1jNdeMAdmL4eUDKVByUC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgbdAzrIyIQntm8y_2uo1bBqEzAyNe4oOSEHSE0h53ug&oe=6AE9FDB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7foOoI_n2wQ7kNvwGdcZM2&_nc_oc=Adp5jo5kmTtt_rZ20q8uWffLSitCU6j9ScTlxlWfTtrb_UqR-Xebp0aw9u9hcGL3YPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8YBbAgCANEoctoa8B_eINqSMIIn5B0R9vZqg4h1i5Kg&oe=6AEA14D2"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AUkkDLkwqcQ7kNvwGawyij&_nc_oc=AdpVKjXGvRJmqd3baJmNCvSWBsF83MGUiIKODpAAfsM_9ZxO50WAEZAH2RU053HeeKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I15gbxllbhaaQnYz2CF7bq3e88PFuHllEJfAse5UEPA&oe=6A0311E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI6uAE8qSp4Q7kNvwEd1RgL&_nc_oc=AdrxI_HCDz1uEdvHkebnbg94kbbK5V-YoRJZuvz65Zdgz3e3a2lSbkyHHmx2vgW8mRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_E3Lf_QHhoeq4ZONz4I1sv301bGaNc6QuGF6GvSsSZQ&oe=6A034730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VPydVdtV6sQ7kNvwG7ttIl&_nc_oc=Adodjbu5wP6fkVrcgtYO-FP1K2B5gvepj9JaHOgpRC1QjdWGfWObLYYjyFBdvf_0cyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78FR8iSXuyKSjSeaRn_hJ17SnnYwQ-aZqhNXmC3Nf3aw&oe=6A032612"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
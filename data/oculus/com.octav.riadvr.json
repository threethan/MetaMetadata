jfL7LApc68ZDbCtA0N2nTk8SBFeq8KATgkZEMhoX43Yeq6g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6XRrloaR6vELvi6UzyEB3sWL2r5yRB6_upc5p7KUa_A&oe=6A4E57AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-oqyVKu5Y8Q7kNvwHRV1Do&_nc_oc=AdrVsLCXizHS77n0RbWFZrMVmwKw4FBm17Ea7XbIgs73amamo0ZyG3_1ATusH0sIZaQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwzLGZWDBY-X5FMC_XpTqP1LCStZYPd4beMwKL-DaYCA&oe=6A4E4651"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFPh1Q_XJ9wQ7kNvwH-i5uv&_nc_oc=Adoh03IbyX-0E5eKtlY13CKx9XCClgDRPezwEzt4m7n3Gqg_XEolCV5HIvsboKZIblk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVl2C_1XFxtsn1BWnTtoyz_HjE4ystFUHeqWGuWN52cg&oe=6A4E6FA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdY_B1K4sZYQ7kNvwGNEaDB&_nc_oc=AdpkbRWR_GGhi96RnjLLx85TcwjUUSsA-04Z7X3WP81cEFINr80IWOqRKLom6aQM3Ss&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALdGy7Xf8RisN2PooXiKbXZJT0fU0Z5N-aVOTcSiIALw&oe=6A4E6CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBBNOsQYeCMQ7kNvwE0ICS1&_nc_oc=AdrOeUB3greKmZuo4-Xv1JYCbz9Ibbpr7G7NLTyeby3TT0YEMv6RK1dH_mStU3yWYKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2UUNGXI5zau4tZyYg9STVhd5UwwJ7YnmY1sPT1ou4OQ&oe=6A4E38F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
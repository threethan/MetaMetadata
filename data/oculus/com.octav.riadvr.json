EeL9tfi4CXXsBz5JRO-X6wVqtYq-Eyz6-Ec3yG_IQc5QQGE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bKe4S4F49rduJrQjCfzjAj30wUCtX46g0K_GDizc6uw&oe=6A1AED2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbHiogdm2cwQ7kNvwHT43m9&_nc_oc=AdrtEC11nk8YFKEGptJ_GXWIaAiDmPtYVoiZ4NB6mzu9cdoWDMT5Q7YmoPsbHxT3qnE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h0O5PRwhioB5Gq7xlFcLkpSYktXEa2XU1PFcn-L6hJQ&oe=6A1ADBD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK_SYPdf9vEQ7kNvwEYue-Z&_nc_oc=AdrA98M7MZwGm2IHK4Se0q98RkMZBTpuTZkFPYpQc2cRtKxzhytY_JmsligUEWx8f9k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af558McR3pU73CSr2STgOEN7kQu9VljFJ1wdrbHvkTZV3A&oe=6A1B0525"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B53ayIMO4soQ7kNvwG-9m28&_nc_oc=AdpRgtBwpQRc4cQ3uY33cU1FB14GedwmFpkmG_psvYqi3S_xSB8AvaHricsm4kcuyis&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FijyFUSVXuZYrC3BFJlrcjfVvcMBYkFgWu9_-1dVnpQ&oe=6A1B0230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0v85V81wRsQ7kNvwHJLQCu&_nc_oc=AdrdJl8IKlCsALwMwG6RZcLoCOFGHNP-2OdqNErD7wP9fC_DUazzAQNPQl8JHlOpJik&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7veLVsRtixw1axTBOCDFnH4uSKD8Rsd63vz-VD3_x1dQ&oe=6A1B06B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
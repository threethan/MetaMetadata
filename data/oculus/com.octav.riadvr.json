.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AUkkDLkwqcQ7kNvwFc_L4H&_nc_oc=AdpJaKn0hJXeDNs4nIAHcM0eimtuN7aRtItPODQMJKJwG6E1j6zxDSCB8IxQWV_f244&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t9DCu1Fr_0gdwDCzH68zVWNFGYmAE1Z6hyARXyFvZAQ&oe=6A01C065"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c67oMEYFfIkQ7kNvwHJavG9&_nc_oc=AdoDdYHpR4QKMHKbtSnNzEYZ0GPl-cBAMdpokVHde27gLEQRdUND4w_fnQ_5HhIfZAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U_OPn00x3bKkpsOUxtKvHf2QHGTufeo6VBlwbR8MORg&oe=6A01F5B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VPydVdtV6sQ7kNvwHnmco8&_nc_oc=AdrzMqFKWX9vERy6x5TfkBzKctzWP3Be0HsUd4zMzRYyr9g4dIbdjzgYxq0ZtXsdEA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FZmOxsRR3Pw8fkyDSQXq1fYG-doqahHH2IQVBqypiWA&oe=6A01D492"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
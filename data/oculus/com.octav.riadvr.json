UVLOtD4ry8J_74U2FLVqXlGemN3wAkldvs_4oDV4-uugo-s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3O5MIZino51F0fWAW2vgnmgyQ7nIKje-PABnpRJpSvQ&oe=6A58E3AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_TdG8l1_TYQ7kNvwFSXHFP&_nc_oc=AdrI9PTtPoYSUFuVz54XXwX9OiR5lEu4VAPiFNze0ElIncJmYdLSIvX4QKFPorPm9zs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxPtfBs4Os62imjSfolug59hEY_cqaSBoKCtugOhAH1w&oe=6A58D251"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4WDQWgyVxwQ7kNvwEKVjGx&_nc_oc=AdrsJXpA-s6QqUU4lvvoOWxwtwSvMPRljH479GHRtRDsRGMi7YPlF4KOryITcrY3KvE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmKhzJCpXADiZwHiAnmSQk9nICaT90HSfOSNzzbNq2cg&oe=6A58C365"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_hd09CY1xsQ7kNvwEF227T&_nc_oc=AdoMdDeO675ihjK67iELfsLosRgQuCGWO8M5J_rCyXZQjyVeEXPJdvu5VsvoMFvL-NQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8FbjMuux8bcfHHKF_KDr7UNvxsFzFSnCv_uHdr4u9RA&oe=6A58F8B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ49sijhB8QQ7kNvwHaaEPy&_nc_oc=Adr3pnQbiB5V72C8dDlKwTklqnJqOAxA2UGvI0g0kHlPvf_wRmRTfKdBBFwhcw7lhQA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg3vQ-FvenBuSyETXM8kgo9Fo556tthnfeETudI33EVw&oe=6A58C4F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
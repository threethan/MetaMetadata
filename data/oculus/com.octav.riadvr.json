_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEHzTW7pvDEQ7kNvwEgFxc8&_nc_oc=Adlvr8s-GDDf2v36-fjE3yn7RO2_JgaEYpdYxmBX6Gk_79rBcXLLGOJ3MC46ZpGbIIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3KoSMat6ruMWgZeK5P7flEmll_P7eIWbey5QuhIesPw&oe=69B154E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9-Rr4--Pq4Q7kNvwGZmCyJ&_nc_oc=AdnHvKIHyT38qs3pwfKRIxqcGAMyjbTeH6DXCSIztWTaWjrMXp80PKBHAIEqUh3qrB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnjVPn4FXfvd7nhF0HLzkWj-roV5yTR8uwHIp98rYo0w&oe=69B151F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db_wahMiP08Q7kNvwE9-LFR&_nc_oc=AdmZVK8sKAYpQVsTJxCNj44tOThRhJ1BnmtoDysCtTrEzB3IqqcEsDWKWiGrXjiBPTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXOnmIQEzmBm7KOw-EwiRXYD6aMxHZAjRFdR1TeKCy7w&oe=69B16912"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
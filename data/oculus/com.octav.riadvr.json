.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESdiV-Oq_cQ7kNvwETx2wA&_nc_oc=AdpfZFy86uqEaP6kHyeGRU9D5575cnMrYASFM-5KTuS3avbRaNQ_u6uufn3WsR8LP0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YT8mr338VdVCIwkmwvN0TdkDjhrj8ZJCxzPCj7ItXCw&oe=6A47D825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqqhw-TmiQIQ7kNvwENR_J3&_nc_oc=AdraBYleE5w_dI9hP7oMOSr35xEASzy5jZGwh2JzM0LdqPKJWxaraH7Guw-NGPDxAHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1xJc0fljYDfdoL7It_EnYv7Qs0GTW6uAsVrbAVD_qgw&oe=6A47D530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhS1t_8hiHkQ7kNvwFZyg09&_nc_oc=AdrrRsYRoLNBDMO1exC1FOtZrc8GzlgI_9uIVdzSgqGRljtofhydPQfonPTDJ8fU6bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cwgtGFA20H43eUrxSNTXPCRCDOvOp2nLk5N2QpY3U0Q&oe=6A47B412"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
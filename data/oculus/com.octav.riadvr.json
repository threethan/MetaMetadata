.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8goq20tGd4Q7kNvwFHWXf7&_nc_oc=AdrdIsHkQITfHya2XpsEDizM1bRKaeXUWTW_UAnkrOi8i7e8FmE9RX51wsZ3cSHdd9w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUD0tD7vSn-MaM3GgKNKT1EJ4q02PDh12ZLlUiyd2DMw&oe=6A550725"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NWf7Kpnu4gQ7kNvwGGyepr&_nc_oc=AdrqgDeTzwhF4VgTHP5urL6DJc68JFS5iMzk3whaOUqgRI_dmHfRfNkGZwI6qAoT7wM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTm_VdCp75cMJR5NyBhkxgngBru82QvhbX6j2RGkIokA&oe=6A550430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1hgLre4064Q7kNvwHKK6fj&_nc_oc=Adqgsv6oQRBOxrq2PsJyROGfjQN-VoqcHImxbd_yR9fw4qz3whwRglj2dN3gDa3_gMs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvC1RgqR3rB7jCoyuWo5kF6pE7ds6okCRWGcfTVD5PrA&oe=6A54E312"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
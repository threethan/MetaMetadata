.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev80Fow5q3EQ7kNvwH8RjJ4&_nc_oc=Adq2J2BaGUtp8qcidWwGdaHM8PwxC80lezn85ImlfjSa9IB4noTjxsIPcm4afqgwJWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwFZEgFBtb7_GLjeDjHdiE_emCbW69u2_iX40FjfslRA&oe=6AD0F425"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A82xSkqjwhgQ7kNvwGURbiQ&_nc_oc=AdreOb_bnBQVD_pqTSUQDkhsq5czspMeMIQztWsP18GkGwdoNPQp9Fg_7PEpO3DyD3s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrrPYd64Lw8kr7_67V_jXZP8Bw2GleiYDhWIXRlYA8wg&oe=6AD0F130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArtFSJN36zEQ7kNvwEDrEkC&_nc_oc=Adqoe2PcZR2sG7VK4mGrwaI6fiLA7kWKYOgMGJnaO8tr37I1gApbsi4wPiTGb8Rk2L4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA5QYBsZSjfXcQeFABS-iEDQG2N9mOwom5banpIdgahg&oe=6AD0D012"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
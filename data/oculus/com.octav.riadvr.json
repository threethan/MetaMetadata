.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiKv75Smu9EQ7kNvwG3c0q0&_nc_oc=AdpOsUFKRCS55Ygey9FLEVnJyogdXTFEHtadRbROulwcHa8a6kPCQSwqWLddLz2vHfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TIC3duWzWO3s3JNAD9_-fYo5eixNtiv8bL7DCCJFXzA&oe=69E4BF65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR3ovM-mgMkQ7kNvwFOrOxi&_nc_oc=Adq_0ytAcNNdIzJ_UN-7ctVDFAngYc7ISuvBItWrQVn4sY8XFI7evmpPOpMAiPv01OY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tRxNx7dXQgErNZplBqhA0tM1wgbdVFTPOZvmBEWWdUg&oe=69E4BC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCPxSy6OHIEQ7kNvwHyRNwc&_nc_oc=Adp2Pz20zJXJTPZDJw5Klnsb_p1HQrUNC0u9O05n6sM8bZaKcaAwDBRZ22C-WFSy7XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Svif2Qt01Jnctaf3SHl3g6Nyh6GMMOhdvmwu6iy2y7A&oe=69E4D392"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
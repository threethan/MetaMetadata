YTCtqwec0gcEusMs7SNoKe64mPjRJreyAag4aueShSmQ-r0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7d-f3Gtf4iOSuphdzICfIIKUwF8HaksdT8oEMa3EbOQ&oe=6A88216E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D9BHsc8SyMQ7kNvwEIoj8g&_nc_oc=AdrAvu4E8S4ywZ7ufTqlzO2Hf0udw6FhNIfYfkkK7c-83u4vGI0CDKB4bNOcujkXLtE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHww3g46wWM5-RZEvTpFcKIH1d7xpTRT0JIgV9OtLP48Q&oe=6A884851"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw-gF19NswkQ7kNvwFEdzmY&_nc_oc=AdrmpHP0SvA6vtfyTB5yiWMwWKWe5DuOAiJuz18LvV8r5Gocze4prwdbzEHV-h9JOlk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeSDavqnyinyjwCMp1rZXMpsDELfFYtwpOAP_sK3AIDw&oe=6A883965"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClhUrwkKxEAQ7kNvwEmqmlY&_nc_oc=AdqdR2fdI4q3A56zx4w4smf5i86CMvG4gvzzMBHj8Q-4hIp1nxghX5g-Mpljth4lXHI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpsdoL3vatxJ_sFXAr40gv4i0hVrbP9WjlfBcL3UALKw&oe=6A883670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jyJ7Hrhh2YQ7kNvwECfwQI&_nc_oc=Adrz1cQoXCyfnPtYGEOy7NzZZJ_cc774iwCUD8JdlnNu7O-QoDXT-DsuUbXBDBJuiKc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5jkPe6Hdf0OjdUdfyAC0uHQiyf2p9eN3N6aP8k1f3gA&oe=6A883AF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQlJMzayVUQ7kNvwFfsmVx&_nc_oc=AdoPO-RUpRREqccx7bhe8SrH_puwGBsUM2XCoFm3HJ54fuWG9ZDsDCsuYQXkkpvuZ1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLRU-khMjVij5fl-Tcw4Uv1hjyaaFqCY8wUM3WKaR4oA&oe=6A64A0E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdpA10ZUqYAQ7kNvwHDdi-N&_nc_oc=AdrZCT5x5lS2x1owuplqH5y_EHLs9ieuMG3aly7G6joeISQhbt_6vNH9u1YI2V-nbQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ_jPR_Ntpljd4AGQy16he6mBKB1feXoyLTVhWyMpelQ&oe=6A649DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WURw9daNne0Q7kNvwE9gK2m&_nc_oc=Adpo6IEslH6VhqS3eLZNkWoyIkQp9boUPjsKsp9LLulegDuNUkVCvV3GuXuTIHZMrxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMa411Mt-TUbERCuAe3zETGnH2J1m81XmqOsb2IueYQQ&oe=6A64B512"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
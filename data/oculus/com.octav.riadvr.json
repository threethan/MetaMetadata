.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf1dA8iYsmIQ7kNvwHlSP1S&_nc_oc=AdrG2eec4zuAB_HIUUe6_c_Lus3ZmkuAeKe8UsTqFPFz1t0jRFAfd8LkHeoLesBLC0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fsTBnh0w00W5ypvMid2EKzWELfhySdHuz29XZ7a_bNA&oe=69EA0565"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLT-WAi1iYQQ7kNvwEdI4xm&_nc_oc=AdqaUexXSoNkfBipxWNcwcrS7DIn6PzDMFXna-lgoGhGb9p5WCkppJ5dBo4Qo9q-kcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30EGT_dR9gMXML05HtEgiDrL6cU8PuhmZvDa4ZVcyxvQ&oe=69EA0270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATTQ9uGUNeoQ7kNvwFge3lv&_nc_oc=AdpYwfXfQWPj6-FPJHRQgPlNhKwCqiJGhvVtSjICVMj-DYuCf1PPoVlLPzQYb7uiPls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mgP5H9HS2T4EyGunzuXReU7Z1EkM7vtJZ7yNdG484Pw&oe=69EA1992"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrkSmVRYcUgQ7kNvwGFdGU4&_nc_oc=AdrUrNK2S6Fbqb9pbtSLsvSPHE3Gh5dTEj_CNnsRToyBsyJAACfNrtrYnZXU0tcxyNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R4cCzCg-t5SU--imuGVuGOx0kXCSnr7DJl3Of_CqJTw&oe=6A2985A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEm-h0hsPYoQ7kNvwHHPvMC&_nc_oc=AdpdgpICN3HGo0MJfK2G7lrcnfvzdTgbdXNPG5HfIa37Pm_LVWplotIFBuXCrxvLZK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PzG5Sj2Z19T1gfd4dKPLj9pfrjHDT1AJ44pyUu4IyGQ&oe=6A2982B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jJdgF1aMq4Q7kNvwGjU_sd&_nc_oc=AdogGcvDyx6iO5C4KDx7Ds8pb73Q2aSTkxFw2N0ZKB-ebN-iijlnKWg8GAyERLqHAU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2bl5dr_TR0Uu10xaBtKlJowqg5GfMVPrXQ4WReGenSw&oe=6A296192"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiKv75Smu9EQ7kNvwF8_w5H&_nc_oc=AdqnEQOWcnTbigIZFkNu7LCzzH8BPfAqtRsWl0nG1FY3FaDPPilaRpeT2cK-25cOZqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mv_dj7swVbxHRnFVhX_TORON215sAMJSbQrnpDHEuWQ&oe=69E36DE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR3ovM-mgMkQ7kNvwEdIhxS&_nc_oc=Adp-Q6LLJFIXsPtLdDDfUSG6K7ueHaFzWfuwNiW0nYOupFvDAjbehVaQEynb6-VV0hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VDub1vwkjkhcJ-Oja5ba6cF5FlV8iRItBCabZPEyFjQ&oe=69E36AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uROOSChzXRoQ7kNvwGE9f-m&_nc_oc=AdoBvp3lFM0Kg1VSRHMx8e0ifNW_ziHqDR89E8shfJ3CZTJJECFG4OT0v-ep4O0eJ_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pFnrjh2ExLd1ccdPuZVK0Thwaal3jwcBtdz5-Xdol-w&oe=69E38212"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
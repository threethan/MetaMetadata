.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WwJqL5r0MgQ7kNvwEktMH7&_nc_oc=Adozd1diMHoPStS5JpSCvGhUbLIoify_WqypG4yPX7wFzHqsVFh_iXhEIaFOqoWOlWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD77McA3nJ02XkEA09MPhuppfwnYWRJKyj9QbDN49LMg&oe=6A9AE6A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCA30le2cMcQ7kNvwE_xOFZ&_nc_oc=AdojSH8n10nc7wUSQ4HUGt2xEORnULF0BX4uIWNLzzxZI0a8g1Ba2epb_cIumVTR_ks&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCPgV63rBWSkQorvUJMBKAWsb2l7IbWcljf7g4VJbkrw&oe=6A9AE3B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ6kwtCJBTgQ7kNvwGb9M2y&_nc_oc=Adp0uPlyWC77FuLQMrU9BlyL-tO6iY53UDRzD6rhIGo4DPCfyLYNAIB9CoqeDmbpxIw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOwAVnGuB8E95IziJW2MhTActNrjih3XwizLBGDaugIg&oe=6A9AC292"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
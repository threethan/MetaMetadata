.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyaxZcg_mZcQ7kNvwFHB27d&_nc_oc=Adqz5X-ICrN6sJgsUOobnATH4TjG-Ich4LgmG8_Vfl3QpxVe5p-BoLXwtXEZtjAfSYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NchipYk8nfNryeVc7XNcth3Q2hmDoSY38AoW2jCW4OA&oe=6A3E9DA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFt0Xo4nMhIQ7kNvwGgf7-y&_nc_oc=AdrX0MwttD60tTL4GL4ocCnoDKkj6_LAL-2J_AKSEdr8fXToqmKYonkL0tqRRm5gNv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GK1Hyqt8QT0ONmk7aEbzAqY33CBIrpG8cPZlA-F3cug&oe=6A3E9AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xi7N8TXPIkQ7kNvwEz2jaj&_nc_oc=Adrwa-W-j5tfpyVc-sIfVP2I_Dl1VtVwn8uzBJCACA8vZd9NCDIORXvzj6KLEphqEDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7SyAlBRMzkl5cy3rduaS9_g1LAj7xOTLRN_hy-oeTrw&oe=6A3EB1D2"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
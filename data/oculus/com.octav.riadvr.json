opN1ENiPGeF2tGLRunIoKmrd0dVfNRa_HnA9rK5oU6sx7_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiFZ7z4LGvTnocuJZgJWUWhrRCXWGCHisHtQepxGWd9Q&oe=6ADF5CAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA-j1ZvmzIMQ7kNvwHx3-Yy&_nc_oc=AdoiG8n5h4S0U3ZQXuhJUnQgLm_uJRdiLmqv62zjljb1u450lPzG7V_g7An-cwejQ4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUDkveMk6wvlZIum6X7EHncHEf8GKDWjiSL9VNW1bnVw&oe=6ADF4B51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSF6Eo7tPF4Q7kNvwHcNDI1&_nc_oc=Adre0fio8RAmOHuBd-hMPt7RNMcK2ryrbG06j3Lm3PFcCUoR8VOZBNc3Xtgri0duLIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgQaQ9FtIZZgfQrHOs5YsmK5T70sCT-dCBZyST8YQrDQ&oe=6ADF74A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOKwykfxSAkQ7kNvwHIPkiO&_nc_oc=Adql1Q1omq7evGpeZoJqR7NPUw4Y-hPgmYpcQ5i9yGTzNSY-gKlhR__m0tQri0tbkS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf-3dZF7UYMipbrbVOuiEaRy4x9VxLjwprbKFLrNjFFg&oe=6ADF71B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK_8WDV1dOUQ7kNvwGvKU9E&_nc_oc=AdpVrf3Sp4-1lqga-Lwt3d74bCUcAwFBZNb7mlojZ8rNvdXl0Av5otfaZ2uNjWOXZzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsBJq1aj3Z14JtLMyPkQem6GiT6ZOP9B46zjwcGxX2rg&oe=6ADF7631"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ju7E3KiULMQ7kNvwHKC-Gt&_nc_oc=AdqbLnqE7jQmi7AjPOEyIO5CD9Dep93EdAofVZr6Ox_M260-GZuHTap8AKu00o8BQxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6BA82YBtAnlCHxF82fx_aITjDM6yB4FFnRhqO_MyntQ&oe=69C27865"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZixXIJ8OTUQ7kNvwEkYC6v&_nc_oc=AdqRtAIU2xBG8_B3EFR4tq7Tsni-YDBXgKe8ZD8Q63gNDrrxfEM1wvPBhXT65MU3WPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2FKyC_v8p6r0I8pdMMgMPlt7VQV1DO-CMOAaEOzz_9g&oe=69C27570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMy2p_Ss630Q7kNvwHqDIxu&_nc_oc=AdrlHwQm0F0scyj3oriEPKu261J7jQsWmcqBdrAQFXb4RaO24VyMY566J-2HKydJyGA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8WfuH5l-GpxZeoAC-fdqJgb1836vCy2KUjPCGwqieCg&oe=69C28C92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
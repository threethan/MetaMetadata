.png", "id": "454532440811338", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK_SYPdf9vEQ7kNvwEYue-Z&_nc_oc=AdrA98M7MZwGm2IHK4Se0q98RkMZBTpuTZkFPYpQc2cRtKxzhytY_JmsligUEWx8f9k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af558McR3pU73CSr2STgOEN7kQu9VljFJ1wdrbHvkTZV3A&oe=6A1B0525"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B53ayIMO4soQ7kNvwG-9m28&_nc_oc=AdpRgtBwpQRc4cQ3uY33cU1FB14GedwmFpkmG_psvYqi3S_xSB8AvaHricsm4kcuyis&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FijyFUSVXuZYrC3BFJlrcjfVvcMBYkFgWu9_-1dVnpQ&oe=6A1B0230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J68w3IYK2OIQ7kNvwF63_Bx&_nc_oc=AdrTDiZd2nWuiiYwAyj95f8ZJl2HztYYLnAmG5vVIHLkGKHIe_HBbUAPiN69REoFyas&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78ePKhYL8LcvzFxg-WbxCQhqcTITEjwxH0zcjMgbd4eg&oe=6A1AE112"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
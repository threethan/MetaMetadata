.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfW8RxZBafgQ7kNvwEzPmI2&_nc_oc=Adrl6BdqkJZt7GxZLH6tlf7OknXZDRCD_VrfElXA-pbN9Jq2Y8sJJTlKmz4lvIOce7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpjqRFN5bO1QPUE6kICMpayw_IY4sur3xUrXHBd6Ywwg&oe=6A60AC65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3qFR1GrjV8Q7kNvwHVnXp6&_nc_oc=AdqD1XX0TR-ShJEgl9a9vrO0FUsfArLb4gT1ryrJ9B6iAWHzyajDzIBcerLTjZ-dqRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO5JpRFO8kuJJesQkVH6AiQiwekbswYr8ftLnbqcDYrQ&oe=6A60A970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REeiV7DaygAQ7kNvwHo2jOT&_nc_oc=AdrVskYamZixxFrQnPlXE-iwkCtPlFh0Zu4-qRgKL19svoxxBfxz16qwqB6LwDZsjQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCccPU6pTlSI8DS_EvEUIXbecFCq80R1jeyr1FpSw9C0A&oe=6A60C092"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
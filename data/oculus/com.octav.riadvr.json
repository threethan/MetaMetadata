vA8Wt1_6E9dp3qkzJW71nGwrxftUVCQdb3A3oGWnAa-4J-w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_pj5CX_5t1xnq5hrCpiOulG13HiSuTgKClFc9wo1QvQ&oe=69E23CAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11eI1aIYCkcQ7kNvwE1D-vl&_nc_oc=AdpUtJfzaMI11j9FF0vofh3JdZCYsj8yBKXUxq0nU26noLqTnkZPMyhux6g2Ux9dAMM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zAeRzcd9JOHqwcXrQqwbnp_Jbt1dpf94-3aDsyHtFlg&oe=69E22B51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiKv75Smu9EQ7kNvwHT2fH3&_nc_oc=AdrDuqy1ktS0fBQIMp8aPm0IOWB-RB-nqg3ORJLXEhNuf0lg38wsqOjN0C2AmFjVwIE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QKpq4V__bmZKrJw3wTXTPdQQrZPNjvt2V0ECt6ykSNw&oe=69E21C65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfBB9lAaY84Q7kNvwHq_TBK&_nc_oc=AdrIa2WvGsvBpKbPxW_dVNLB41OIazDW0lVL_5xiOApo1pZb9pMv1pArzynW6GVL2Z4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iZGKPhOXR5phKHtETJZ_xrlw3MaTKVxv4weUbUDx0Gg&oe=69E251B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WwThWgcRNAQ7kNvwFDUSrA&_nc_oc=AdqdSkd5Z5duhcnGGppIn_76weEejplrKYT49fabgoeDz_gRfgY1g6dLLdZruJoMgu0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2caMCqg2G5GVRxmBCqY5CsFBIGBGOubHxEyAwNdqv-bA&oe=69E21DF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-XnVUZUzt8Q7kNvwEHEr74&_nc_oc=Adp4NyS0GNmWL_pAVs5Pbs7oyTmC7PlLQUSKkicACMD97dSxw3pQ7rZ8hEa-HdMsQlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxm756Qe0W63mSfcJ5t3T2dol7yxk4Pz1rqWJaxL-PHQ&oe=6AB544A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT1WmHAMsiMQ7kNvwGbC70O&_nc_oc=AdpqkHIEztUXi2AOnCbMjAtO9FsBOvrh8PpnxaV6wC_HmC_IeU1k4_vCOYh3gB_W85g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJTMC-hcSH7GjPfs8DVLqvdS4h0TTUv0a4mqJWAYKkWg&oe=6AB541B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdso5Dw7-tUQ7kNvwEWovKI&_nc_oc=AdrRDUlYLawGrHbU5PN_mt-FftK_7VO1fQViDtt8AaUbUCClO4uKk38hFgWKmY-LY-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiZVhOBDOgq_C1OgM8svjiMwtWUS6PlbyQ_413LDbMbw&oe=6AB52092"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
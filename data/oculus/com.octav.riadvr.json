AQRGPrv_jUpKCebBilN64LyswOAv2j9XSw5GefKH6WO8_G8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LUBsAHW_pyhpBwa5yOXsRbFzfCHVLDf92EFC_UXLnNA&oe=6A451D2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtmAYD1IIfAQ7kNvwFiZZiH&_nc_oc=AdrtHfXGd5gJ4UYGwP-GPf9BYPcdD_8zbYvXCMdWS1NLHolbWVHkTgIozQu41Vbc3RE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GkZ8a6WzY_HaKuXoEtYKWtOTYzYxTyq53knHW7ftWAw&oe=6A450BD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESdiV-Oq_cQ7kNvwFHmWV6&_nc_oc=AdoLt5oZ6TvMPDRZQicmLqgF9kU4cFwqgI0Mli9ULFSaeff_5BNzb1dEI_sDLVM0IGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Ig6s9S8ChgVF5jd6VNjbRiTIbfVie-5uiJireKeX_Q&oe=6A453525"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNyxc6uBmvIQ7kNvwHXZaJs&_nc_oc=Adq7MEj5gvTPyWImPwo8cncCQiMYhSwd6BEuWvN0gBTyc9HvAALorXFoQtcZP3cDLns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rfn2YHewXq5G8V0hrAK4hVx-jarY_Oui6fzhklhAZdw&oe=6A453230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il1LQjI5xuoQ7kNvwHUOtV3&_nc_oc=Adoa5khru8T0b-mdFc74LOWuA0_2isuwJBiUXZ37jPSil4qYcRqmkMQupFM4PQCMm6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nqAorMLVmiSAfewUOhvpVKEEz6ZcYsSLqt0KaAQw5tw&oe=6A4536B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
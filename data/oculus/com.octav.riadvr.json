.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw-gF19NswkQ7kNvwHKwuAm&_nc_oc=AdoYPcluxBnYolJju1G5Jsn2Uy0nWP8iqbsr5lHnCyG1GvKi1FlcmTnt0B5TA55hClE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1EW0pgHX6ZjYkRnoAazinnV95ss1E4gU9SVMooPqDvQ&oe=6A898AE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j23sCt4RHqAQ7kNvwFgdJnz&_nc_oc=AdqmzoS9dkbuepc6BPQh2GmcB8tMqXmHR68F341ooZ9Hq6_uwVcmWgBlH2X2cC3USIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfdqb4mo5R27s6IMUN4phzockFXIp_6_gg7rErxad5rg&oe=6A8987F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYgVwWFBTcoQ7kNvwHoKDoK&_nc_oc=AdotdzmTW0MhDv2pELCU5UTKaLVua4KRR8qzUIX-lNOUN6ebLwAxxBz83ok4asEeNEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvW51Ht5zUMiyHjsp_-qNJf7jh9d80NM79_clhLekmrw&oe=6A899F12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
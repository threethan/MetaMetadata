hWsk-MP7TJXxyJJ2l7aRGYw1MgC-TbW-j59ZR9y1A23EPZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48QbN395Ys_7O-fYdWi1IcvU12UD6t9rcTJzpIBqB03Q&oe=6A0B1B2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgRlmx0CeDgQ7kNvwHkl2TV&_nc_oc=Adpjor6sAp4_9fs8ibsP37fILaiUBFETU_JE4IUev3eXnLOsoNNnYTBZQShJ7SowTF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N9VQiq_PYgXGiOIlm5kpO0CqKUDhJ6SJcjZ4edoXevg&oe=6A0B09D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbHLG3VSYQQ7kNvwGlcEYW&_nc_oc=Adpnli467_yaDRRjZSD5Gw2cdyFwueYjPJoSM7eVR0IKof79MdaLOEaLT3xylSL18u0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ihRC9KRFAO8blzfXOx8rZ20vmUkvAx6NWQ1QB6Gb71Q&oe=6A0B3325"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2zbNUj0XG4Q7kNvwHHGwTY&_nc_oc=AdouIFNMTrpMmLdmAZquQZau4fZN2pQfp8pAqlJ0bs05WSkOS975GhnfiHtsf-gX478&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S26KnSV_Rol7YQKK8tYPTgE7Xdc0GyyltsVb16J1WpQ&oe=6A0B3030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yySBF--QZgAQ7kNvwGJALR6&_nc_oc=AdqzBh3QG9EebNS_okWKUAphAG_rdsj74WxcEjGE9lwbkcrAyb5svHRRGPe_hUXNSqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lvVZOG4J6e-fykvwMnNdSGaGNPQUTgZnZcexygdxwYA&oe=6A0B34B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
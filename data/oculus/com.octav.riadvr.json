.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcyCodbO748Q7kNvwGUnrlf&_nc_oc=AdqoXAr-IhZVZhZ-iLTAeDxND52TA3xfrbqQnaTJqc7lHGQqDnb5GYw623aiWLSm8To&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uWjrGkAbLiY2Q-3DpoMc4W_3QLDISBcdO6DJQ7TK0hA&oe=6A073EA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThW36yar6QYQ7kNvwEtTgyP&_nc_oc=AdpaLlhwmMeybJaXyyddt6HuT96GqFQgUvDU57OIYf3P9FCEYuMb_eC1qIvDfNY3f4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fjHp9ueNSjGhWIWyX1J4tSmscAODfjXzsD05QjLKeSA&oe=6A073BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnB0kLfcF-YQ7kNvwG06NyZ&_nc_oc=Adqy3_vFba8LYSN4Qwd-U4YMzou3cnFbRqkz9IeUMMVqX3xIbisf0fS_010sQceyKTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VMjjVYBwuxSgkSrgQc6G5I3m0Ej4lKniOdzZhuo7ieg&oe=6A071A92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
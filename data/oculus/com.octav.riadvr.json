.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSBtRDKwxBoQ7kNvwGsEKqw&_nc_oc=Adqx09CUbakNtNbHkNAuC14GCjq-_G2zvJrMDhM0Yv923OzZiw84OTglfF0HFfjpNoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2K7KkCjrn-d8QwbnoRinzKW8zp5bC9Ew-zrHJ9SdiSzw&oe=69F76CA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxM-8yeIrgAQ7kNvwFQl1yD&_nc_oc=AdpVx2Fa9v7XjTZpSMtJxJYQ4bjWRd0iPIYfEIiIv4nDpDUUBy2I_qoEUTquYUSra9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Vi1Pwz9BbxbcnGZ4bHs8jq5Fcz-9etepHZ3qLEzjeQw&oe=69F769B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXpZzqqqhhgQ7kNvwHOd9qD&_nc_oc=AdqRCCs6zuRaPsjJ9t9rx_z4hZgTFXU6Fk_b_1fgmPu43_k7nn0bEGt2R_399u0PftA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32m03RAJsgpVaeGDUdF5qNInZpFWMJIZv7oaPAA7qIAA&oe=69F74892"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
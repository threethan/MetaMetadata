.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62lDRvN7O3IQ7kNvwGdCSAk&_nc_oc=Adra_ub2GInpKAj2FkjK7HPdzTUm19KNCZiYL0Up5wSJkGWASRcAvzhSqCJ3IUQBIxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlJDJ4qV97woNCnq3UD5nMOVtmYnPoBFtNHO96G6amjQ&oe=6ABA8AA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx_xJYbdgM4Q7kNvwEeADIU&_nc_oc=AdqR1XJcoAZ5mgz44REUae-0wgr5mGa5k-0hnly82-4L5JkT-W1ZjwaHunC8jKyGZ6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhd0QY5HDXAFlEQ4sWK4aLhQDaYhwX9151yORpt3MlEw&oe=6ABA87B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN6uTBHKFpsQ7kNvwFZyt45&_nc_oc=AdqZ-RGfNorvxNMXQIwW6NiYfb2Fo0R9-6QqQj2mdad0_ewjYo50ykvh7J2Ebq1SeDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2e5_t517v8nijDOWZH1J7Tn3vwgFFAOxj1mDors6D_A&oe=6ABA6692"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
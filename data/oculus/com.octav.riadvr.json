.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk5K41aGIloQ7kNvwEoKXdU&_nc_oc=AdqdAAz_U6JlzbxJZkgvrCotbhfyjTe-1M7-To60Ymjea34f_h8gveDb0mCJJtWkEjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwdZnf4lB85IJuZJnMs6JJ6ZOpThaSS41i2fxAuNlQuA&oe=6AEDF525"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK71sodxtFYQ7kNvwHB6yjN&_nc_oc=AdqlrQG3hxKagHfCSrwswA7_LmQFfGLgcXKvEgau6qWL5zC2ii4gwGcu3fQEQWHFdsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEnimxDVmYMhRK9d21_o114WdQ0285jpqFXfoDs7T3HA&oe=6AEDF230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOX0L9XMBLoQ7kNvwHl1SHE&_nc_oc=AdqOg3gLq39LyysYtZarxDPQ87iL9-pg5vAerNEuISfRnmZHmt5La9cmf8swJsf9NHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5ScFM2ieDZFJDKY5Togl4a3nsZYEjNmwh9C7C8hethg&oe=6AEE0952"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
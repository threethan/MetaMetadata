.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZKQwzbK924Q7kNvwE1MiGY&_nc_oc=AdoQKPq6U7oifo07bsznNQRQugQmTChbA-HODlAUfeOBvOdKtOoTgBT78lu-sq6Opdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55nl90HopsTRj2imMu6R1yiayZLaKxu8ot2y6WERW2eg&oe=69FCB2A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4x92nfb8AQ7kNvwE5MTu6&_nc_oc=AdookQaIxtmvlXz8j8ornS76UYV7lzS6a1rzqlX052cesu250AnFWCrX0HWDARQvO7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Al2VCAme02r4bBzI4vq70NGpe_PHcWiO8bW6qDSwrdA&oe=69FCAFB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KfCOUxnAEYQ7kNvwGQi-2b&_nc_oc=AdpoON24NkfSBsSx4uEJndVfk6sqQzum1JButHSpmzku2aBbUDtZ052thvYwG53IjzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KQQUn4tQ384R1xiqqZhPypp9H-YZiyoNB023lNDnnFQ&oe=69FC8E92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
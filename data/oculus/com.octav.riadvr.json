hD9GruVzG9_MA6G-Q0RaYn1rcAcr8Go_KecS2sodl0HNG68&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_4rYUr9-HzF9oPOAVzM9gmqkMJd3TdZLK1kzIjPoXCA&oe=6A10612E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANY60SjCMS0Q7kNvwGxP6Jf&_nc_oc=Adqf0WRSF6fcg_q0BM9hQvq4d3ip2Qnv9wp4UbXOHiYKiyqPGkTdIFjlSl7fVqrUrOg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RrYT0t4Jne6k042K7J28-oLJma7EpUg6e5T9x61ZUIg&oe=6A104FD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po1rfmpzQBMQ7kNvwEKwbbi&_nc_oc=AdrsBEgdWTXfCjEW3BthrjLSTuECtR4ZxJ3XFnD0UA1QXGSn5GKGIymCVptsA9ItX6A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HvITNQuTuITX86GOE-NiM8WMv3t1vhrk5QmNdc1wJ4A&oe=6A107925"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_aie5Uy1ZQQ7kNvwHKFGkO&_nc_oc=AdpK-W755k86jpYiT5FHGBGTDULv7-fbON-tDXTT1XEFU7BBxNwG_iA4rRgNuKC7FDU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L0YhRBL128kdHsi2fAmNcqHDAAZR2bblRMn_kLhJOEA&oe=6A107630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VJB-8kMJawQ7kNvwGPgLpl&_nc_oc=AdpJMgM4DxR-XW8l-EtEVhXnjHMsSedhuzsJ2e8TPh0jRRGc1k12N6Prchnjryxz65Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vV-mLt3qTOICkh3lMgENgzx1nl6fkjd5jqj9PlU08lQ&oe=6A107AB1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSF6Eo7tPF4Q7kNvwHcNDI1&_nc_oc=Adre0fio8RAmOHuBd-hMPt7RNMcK2ryrbG06j3Lm3PFcCUoR8VOZBNc3Xtgri0duLIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgQaQ9FtIZZgfQrHOs5YsmK5T70sCT-dCBZyST8YQrDQ&oe=6ADF74A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOKwykfxSAkQ7kNvwHIPkiO&_nc_oc=Adql1Q1omq7evGpeZoJqR7NPUw4Y-hPgmYpcQ5i9yGTzNSY-gKlhR__m0tQri0tbkS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf-3dZF7UYMipbrbVOuiEaRy4x9VxLjwprbKFLrNjFFg&oe=6ADF71B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F64j5c_LoZsQ7kNvwGlkt2Z&_nc_oc=Adq0_lIorHdUfxqbUlNhzgWVwhXjpN4GjbXPICEQ6Oe0PpbWyKzVo217Ycr0GMAVgNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME0F_oFMzIFsqi3Db9ytk9SQ2rnLpm9-1XqZTjPjzhyQ&oe=6ADF5092"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
dvKJBbu0EWO92UQs-RSKphdJT9MXHKhqADQE-UU7i9qxq-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATBMZSxz-wyjZSIovGnjIDMAGvCa8cjXzE3PefUa1E_Q&oe=6A60CCAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsTn1l_8ShsQ7kNvwEi9Be6&_nc_oc=AdpYvzok9OjeVUa7LM1PMePA7WEJxeAnPUgCEXR0ERh6R7Ha9mKtFTpBmGgNcHNYwFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdPTlij1Nt8TW624KIlEhP3q5eQCWNbmykAS5Gy-E2yw&oe=6A60BB51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfW8RxZBafgQ7kNvwEzPmI2&_nc_oc=Adrl6BdqkJZt7GxZLH6tlf7OknXZDRCD_VrfElXA-pbN9Jq2Y8sJJTlKmz4lvIOce7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpjqRFN5bO1QPUE6kICMpayw_IY4sur3xUrXHBd6Ywwg&oe=6A60AC65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3qFR1GrjV8Q7kNvwHVnXp6&_nc_oc=AdqD1XX0TR-ShJEgl9a9vrO0FUsfArLb4gT1ryrJ9B6iAWHzyajDzIBcerLTjZ-dqRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO5JpRFO8kuJJesQkVH6AiQiwekbswYr8ftLnbqcDYrQ&oe=6A60A970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAXdar4aPscQ7kNvwHV45id&_nc_oc=AdqIhMFG7vEDiX7nCmWkjdblV41Io9NQjZmuWV62J-R-Yal8ur24ZQTrklqE2_EvwZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5_74o1uqBSZqtB6pv5x2bgi6yxs0ox4O9O9PWWeV4fw&oe=6A60ADF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
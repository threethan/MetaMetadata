Hzh-iVs9gk5Mfhl4eh8xWzK7uXKUndjKVIShTilE-FDpXnM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TIIl_yFJDvHgmdAS5NBz0RykptvyK7TOHMHSAGsggGA&oe=6A13042E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANY60SjCMS0Q7kNvwH6_BXV&_nc_oc=AdqFwRjmJojpeA8UT2PXyegmYN4utiKVCUIDch-iLFjW2BeTiK9EW9aFQ6I3jGZxRNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sgmjy74OvHPpgXceYiphQz7cmMKYUC7smoCe7RXQ7Uw&oe=6A12F2D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3DFQHBPpOcQ7kNvwF73UPj&_nc_oc=AdpRWR3zOG9pR9gmosURDd6-Q1wqUrLV-ETPF9MyeDt3MVUd2mzedHQRPPuvOtcDTEw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lCMMDxHGrpgxCeAUXsdwak7p4lU9TGzRbBDtPu-gnhA&oe=6A131C25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTl_qqhvH30Q7kNvwE2Bj42&_nc_oc=AdpRyEQy6XgTL0Hb02rln9P5S6MQ_sLFkd2YAW07BlBW2ZzsH1NyLAAOM9ThxFRmh4Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nCxR03olxmawEA-heDnV4ldxdZtenonOEUSVd7cjAbQ&oe=6A131930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEjCFNE5dmMQ7kNvwGjt1eG&_nc_oc=AdoobNTlepY_S8t3gVzgsyzr4gwamYXGndh7VFeGKPGBl8SQ0Bthci44-Ow5y6ND7Zc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60lbw0CMjLPenQx6qtB_87UOQdx_1M60NYpOlhmWKlvw&oe=6A131DB1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
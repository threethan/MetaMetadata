.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK_SYPdf9vEQ7kNvwEGKXVK&_nc_oc=Adr8VxHvSGufZwad9GfflSQrKiwPx0RJcnmiXO5eEKEW98ZK-5qR89XKn1iRfxrdFpE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jpj8f7fqDKQcBuYd-DRtb5P_moIUdZ0eCmlF8PBIq3g&oe=6A19B3A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWWRyZKrsN0Q7kNvwEDFKld&_nc_oc=AdpHzaxLCpm8TKynhRA0KR4ZnLftIMSL9wNHPxoXNlSrczaKVl6ZmY8rPj4titFpXpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48htoemWn_oPYWOascVJY5yXnrr7gCDyv-8e_3SCaFYw&oe=6A19B0B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J68w3IYK2OIQ7kNvwHxHMrf&_nc_oc=Adr3kr5brzXv-5AEM3zd6rCFfDWQmqacWDo-29n9fSET0TlanSUnHZQvc0z9V8B87z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-gFxFlgzWGKjRLUEYDxpfIlJh0o2VeoG83bPWkdUvWA&oe=6A198F92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgXwuGKbuJMQ7kNvwGucgby&_nc_oc=AdoPmKYKC-EifG7ad4ZKk1pNCEl-Z8-uhNLYxO85ebuxUsltQf-Yo-zCCrUBKpEZM0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FY9HLzmDl6YMeI8BKoJrie2_bqYQ07NxgIQjC9iFszA&oe=69D8E1E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnwqXUl8c-gQ7kNvwGMl_jJ&_nc_oc=Adr2uqqMUWXrzMXVXcgkBYgL09l1sKJ8nn34G99yf6zd_T0zj9eMDxCznwGmJgkSZUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wNDs2wUt5yJysLnpOIaEoLj5pLmO1vh84DeaBbmKkIw&oe=69D8DEF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVQNDEBA2XQQ7kNvwFl2jZ9&_nc_oc=AdrwWOpQnt2vV8q5uDdDiRCUVbiw33M1xvDilj8gzi5fWQcO9muTMkjJO2F-kbujD48&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LxpqWY5HKWitb34crkswJ-1dn8RFD3p6d11hJKv7N_Q&oe=69D8F612"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
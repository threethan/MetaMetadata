.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5DsXWx6q30Q7kNvwFwKfJ1&_nc_oc=Ado1kE70ldx7trpSBMW7oeuymL9E-fF2Qiw0oxvqeLM1sLFRBoAJKga-D9wyMZRxsUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG8utkbO-fJaRJMB0j3WmBiA_NkkZweWORi85k4kCXAg&oe=6AA2CFA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7TteCaPWCEQ7kNvwHsa_O9&_nc_oc=AdqNLXZO_TGuBLC787ncLVF9iqTtLk2ltusEiUOlYkTrYtxqHltO_CqEutjGwUu0bzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcLj00ieqqOgoawiD1BVkJWoygQn9VATJo7f9bNOBF8w&oe=6AA2CCB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdZcgz2mE3oQ7kNvwHA1-yg&_nc_oc=Adp7UPc_aFLauFezW6FfmBrcvblF1oyBhK-4vcrO9AYkqOdal_PeYbOTXcEdDSsCc3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBVF45n7eJ8ws1X1ozpXdCl24eE2yAMX7sFh356C9miw&oe=6AA2AB92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
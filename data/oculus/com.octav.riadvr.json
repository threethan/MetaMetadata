.png", "id": "454532440811338", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSnwZ9nj9KsQ7kNvwEsn74D&_nc_oc=Adothj9Cjt3IlppITQejr4Y3n_1VbegM-mx02-t_0v_THFvqFtJ81zkmB2Affr4Cmv8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9FU6lsNt76InrHNsAFop1ThFn4pyLAGVN79v9KWdOCg&oe=6A9416E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmOd5zyXixEQ7kNvwE4HVku&_nc_oc=AdqdeV-4QmNOoJVUlVSlrfRLj1ee1q3VsSqeNus6E0gwSj027rvklo2LcdGk3-jrqdI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoNKKgSBVlYhYiryMlZbKC_shM8ljmziCm9ZpJrAfwig&oe=6A9413F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS2b3cIq4zcQ7kNvwFJY6Sa&_nc_oc=AdoMXz8xibrTwACHq6muRuxFix06pEi7M80zFX5Cv0yxfA26hPZ7BkcCYWjFg-UjwYQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ1JlQQJCGg8SWcxmvqEgyn_a_WkoSqY-QfKM48x8psA&oe=6A942B12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
yGOymHPMEwGGDx8yl0P3dQydjAWdT1NFzIVu2FAekcBpKLY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbG84k6HmgqXzk4iS2Ukupam0_3waugUMhluP2DwlBtg&oe=6A93FEEE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVjwSYoDsbMQ7kNvwHLfQzd&_nc_oc=AdrNCUfouEUGzLMowIwhME1ClRW1kH74-yUul9-Xnpo3Qx6XxmyETHflLyln7YbK4bU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDVZEa0mkfSiTnOCxHVyMN1iDS8yVnqr1aQs28qjhFPA&oe=6A9425D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSnwZ9nj9KsQ7kNvwEsn74D&_nc_oc=Adothj9Cjt3IlppITQejr4Y3n_1VbegM-mx02-t_0v_THFvqFtJ81zkmB2Affr4Cmv8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9FU6lsNt76InrHNsAFop1ThFn4pyLAGVN79v9KWdOCg&oe=6A9416E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmOd5zyXixEQ7kNvwE4HVku&_nc_oc=AdqdeV-4QmNOoJVUlVSlrfRLj1ee1q3VsSqeNus6E0gwSj027rvklo2LcdGk3-jrqdI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoNKKgSBVlYhYiryMlZbKC_shM8ljmziCm9ZpJrAfwig&oe=6A9413F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJKVZ2xf_AMQ7kNvwFUX1Qm&_nc_oc=Adp77jEhBcwN8q5ec00_7Yy3ftk5G120qHmkFRkXNcEYG0D0-QNZXml2n6y5HviqUt8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs8ypvOy6PCWHUXuUwapgbAzDZVYqub8m2k6mSS_uf6Q&oe=6A941871"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
O__IEKJYyDEc7iJPqbyYiyhknrCCJMP2HgeElvWM8jnoLF0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iNYcA0tBpqQvRQ2AOhSYqrV-a_UAC2FwZ94Sl9BDO-Q&oe=6A30052E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulrAP7Crc0YQ7kNvwHVO951&_nc_oc=AdpBh-SpjJB3bYSvwLxeiIHvdPFW6VTTwZlBME_KXMDjb0aiUnQ1OqiCpUzIbXt3GDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ApnubEaQhpR8VhDx8e0ZQWAJ2ijm21ptmfj83ljglbA&oe=6A2FF3D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONoH4m1rcrIQ7kNvwFY6hYz&_nc_oc=Adp91XnV0konrzB6canRuUf3Ry0mftGaX6dxrezfutrSgAeUyEpJvl0SRzb_7LKAXKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tuss9JIiPJGKq7HFeVtUiIPRyK0IV7gQqBRHSz0HzAQ&oe=6A301D25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5QL5X4cEWkQ7kNvwG5LVh7&_nc_oc=AdrL7uNeVTSChzTlpIRXxb5-VHM3GeiI-D8xvRXC5w2gqoOf7G949RogaVIwLn_yot8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k3QG4Hy0o-80BiCWwJTkzBJm4cvrc2XXPENMOUIE5lA&oe=6A301A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU9eCPaj0joQ7kNvwHkiwJK&_nc_oc=AdrNK3gzZNra49NJBAKPwxLNWskmr8rLJ7tSoJ5jUxQLfDhlVM96zXiJBtTsPQ4OUwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85JRlpOikqWHH5uzpQguwC80LShzDDdiWDkF_AQZj0jQ&oe=6A301EB1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
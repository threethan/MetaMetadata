XXUIvxM2NdLfY-LTmELdRVFXMxMMN1vn3jblgBoxq7Xg7yQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeWXq9JU5zG1OaM-Z49ZhNvciMbf0Qt34Jne-S6S3YBA&oe=6AC25BAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EXPGNmRK4QQ7kNvwEcSLS8&_nc_oc=Adp7zgKIK3ZXKXAEHiDiMwlza79X8g6Ra0nDJYqu7HrxryPw4DPFOokdOjqbehAscpc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhVtS5Tb4DHlOgN9I7XuDk5zPv1M1MLywbYJ6M95Q8QQ&oe=6AC28291"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRHbI1n3TBoQ7kNvwHJz3k1&_nc_oc=Adoavtog4KaSmOPv0Pz_tehNQokrV-_8VJTpNSdh-5uNUS6gGtW-5lkdZRzXHVKaMOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvlBpge7JBnvv0GF9q4Xjf_voTg6k73hSuFNHI-YmZIA&oe=6AC273A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax_YTUkdBH0Q7kNvwFrQvqk&_nc_oc=Adrj5KhIUtGJWBsor1k0cpus6C1LynnPtC6X-Rga2yhKoES9bCy2caL0udXYgPBLJkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7uh2TmsfzRE-eYed2GMuBMwkAiWpwW5gc1ro1N-_eWQ&oe=6AC270B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEjgETX2ad4Q7kNvwEH-JYp&_nc_oc=AdoUo25nB54X-N_ew-NhFo7-2S98pvzRk5oioU9g1PmLkOnR_rcp8Ywwdn0f3mcAlxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNbGQSym6GjmONWgGIIIVNFoUk8zI65KZvKoTccBakQA&oe=6AC27531"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iI_g-0GdLHkQ7kNvwFrX43G&_nc_oc=AdpmumU0ANedqjBk469PgafYzEyMhkFznHu2slGfhtmTHFak4ohT2n_8bhL7IV9eeD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9dQIZ-Qywh6cu-h8HZblQWEFKMsRXRCJ6MATsSo70cQ&oe=6AF48CA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYbz13NsgesQ7kNvwEG2gzH&_nc_oc=AdpYIAqzNVmjBzfk14yeO9C0NDcG9TOQsO6x5lpmU34Jz2InmZs9WraC6K502ljApcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPaU5lJ2jtzyJt4lubfvQNQNIPdb7Wu368GPEDwOaGBw&oe=6AF489B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix40DjReOzIQ7kNvwENrQH0&_nc_oc=AdrRKrqwAucOma0A1T-h342_kw5elJufDcdGEpnS39qpEXtc8wvy3s0vv9EZ6wR6skQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyXdo8ZQJWmpwXXnbfo6oAFRsuHJCFzOLkU6B9hiQr2Q&oe=6AF4A0D2"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
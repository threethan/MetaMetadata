g3Chs9Rcxt8-sx_tjomyAAe7lbU0ay7ZyS14Ykq-VOG6Mu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61JCCArj2szc7jLcRgITQwT1W1zBBdbbaybt4F2Oo1iA&oe=6A184A2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbHiogdm2cwQ7kNvwGsFIjm&_nc_oc=Adr67XZAUJgWZsvK2GX-zN5Amus4Rp77UwoY4RU5ND5kjQ700E886Ja3s42zvbZCbWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af436wwyyS15UItY6fUPtEwtYx9VY3C4wmeNYQ4VFuoE9w&oe=6A1838D1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8NV0r5TrFoQ7kNvwEBBeEp&_nc_oc=AdqPtCnxCmhCU7nBeDB4B515j6DLGazXQHefkQcEXyDzYNr75mHN_DwYUH1IgnxXYoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TEUWzfzOEPHD20CyIE92_TBq9OS5h3eKsbHl87NTXLw&oe=6A186225"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWWRyZKrsN0Q7kNvwFq8HSB&_nc_oc=AdrYjZ-AsY7LuefyJvvwTgBIQjd_66aosXR8k9vh_Pzp-dIof3e06U42DrsB5wZe17Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BjQGPeNe7Nvj8vGx6-3P212aoN9jx6m1G29vdGgyb9w&oe=6A185F30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptrZd64GuXIQ7kNvwGO8LRX&_nc_oc=Adpq60bVU5T117XOJ-0yXSHr8P9CsVRVYS1SivhS5ZfJg-G179RJEg8IVCepP3NZyhc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DJQ_6gT4WK3bPFkVnCr1ahOypVWgcKPHD69eHJVOsIA&oe=6A1863B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
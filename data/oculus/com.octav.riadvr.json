.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19DIRdb6yIwQ7kNvwGwsD2b&_nc_oc=Ado9BFYjoIZsEzFDjQoPC-DcQSQGwSmYUY9keQux1eQhcwaB7t8BQJlujUsWHBmBfw0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIq51hwMZJabZUJDOb_aThmYTYJweR5Q0tPcT-qZ-MYA&oe=6AC90B25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqQUkA9BLrAQ7kNvwGdqe1e&_nc_oc=AdrRSGh6GYO0YWNgogjrXHOXbxXfcArGIXufiN-6fAOSMQXT5JmYNu48HzODQQHBx6Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV_jVTh_9hyk0uxdUhyH7BB-QrSByzoD0mjYpzaETNEw&oe=6AC90830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAbF-Dm0t0EQ7kNvwEDGK69&_nc_oc=AdoSw3QoZenW2isETKuay3HoUHT0-1KS5kvlzwLFN_pAWQ0XEOA0M83X1DmTUiL7DCU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuyqz9LkCP3efEhtCBKprk-VoK2HG_Mbnt9-mDSH10PA&oe=6AC8E712"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
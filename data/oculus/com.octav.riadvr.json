.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN_-nbkJA40Q7kNvwHn5RpI&_nc_oc=AdoRSwf1lZHeNqcF7f9WJu3gWuGIW30s-yfA9d2UQ_bVfDXGc1-na5CSddgO14yTdvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwqIXm4ATEhO_u2tkDDXojmzkRM8JESlnpv_S2eeTpiA&oe=6ABE7F25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdhIPKIB_AsQ7kNvwHFXor1&_nc_oc=AdpvVIVTfdXrX3_s_VMTgFNjRhd_XPzwG3RfCfHU5prrxiwZLilPDw2kKZfB76cWnAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFMt4mrrlkzudask6yKJTFsqixxWEYQ3c-9NOoKK3BFw&oe=6ABE7C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UNAlMz0nCoQ7kNvwGRYU64&_nc_oc=AdoCDVJiYu5BJXDPpnhXb4zF4Dyh2n6TtE1SJwVjG07PujCZqFNynZAf8phA02DZXoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTypqM89AmdKIx1IwJslGE2EbP_i-Q3vzvkkT_kx8bgQ&oe=6ABE5B12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
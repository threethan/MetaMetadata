.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa-cY_F4CHMQ7kNvwFEylnE&_nc_oc=AdqtW4-wbu_cTl9Qug_rmDjeNDJ1kJhT9EajE06446mOozTUwcSc6p7GOu-w8iRZKhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTt_Zp321FXmYqw1b47Oil3UqLeu1CzizJPqdMt1OLKg&oe=6AF88125"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZLXUFpcFNYQ7kNvwGNV6Lb&_nc_oc=AdobMmCJ2o6TwvK-tdUsBZEdMfWhKNXpVrKvnNEWBB9T74l77_NTNSneVG2ChMLvBk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj4egDJSuEzG39DeZUqDHMfg5CjAeNvjSAX2JWzHsqIw&oe=6AF87E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2puPySzCOIQ7kNvwGH6Nxn&_nc_oc=Adrxbzk8kRLW-6JZDXLgPQ9f-_7jTJY2TH5bZvr2NfdZDZ4pz1bL6uYI9TZdE5H5CFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1tjr9M14T3edT3nUHveYqoPerXweHMfpqk8ZNUs6Ndg&oe=6AF89552"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
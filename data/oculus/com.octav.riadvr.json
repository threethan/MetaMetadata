.png", "id": "454532440811338", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha3NMRQoPgMQ7kNvwElUcN2&_nc_oc=AdoVAYZoS83Vkz9TiQpf-RHP0AmmkTAvGEG4bOO8MVVwoD4j62_3Dbj4l1O7YzvR4ho&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuLvNAC8YPO5KDQB--CynaHf8oFzTVxde3RsohSFcohQ&oe=6AE36925"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsznmCaHsYUQ7kNvwGFhwqw&_nc_oc=Adq-KYsiBFA5EsL1nPnDsrVuFgRhuKIEzEAnXNjk2X96NWpJMHoBrWOZI6YEDXX0VXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORPi5B_M463oLpgxE02FvzASdOxlcbHxD-p4LVKUIeFw&oe=6AE36630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5suP4Fv81vsQ7kNvwGYoFBo&_nc_oc=AdqMv8g6OeIsiNG2lZWYqgttTsj-aJIXtSUsR6I_amT7XDSEfAphL5fFL4jJWy0bfwI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmjn8YNc24tv-EYg7GJjkz2axsQAcGOxaMM0adVX-dYA&oe=6AE34512"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
x0bVnBuJtB-DHuvtt_O4cL1Cmg5f1Rp8zbC9NPv4-xX0vGA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JzO8wTGYXeoRR79r3pBprvqprCOx_ZHe3hxRqxAWNOg&oe=6A2C10AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QxAIgidYbUQ7kNvwE8H3t4&_nc_oc=AdowG_PRpQ9MZDJH6CiTVSgmhIv2lyMZTzGDsChmRsbPSwvriJL8NeM_T_PehJWVOnU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vFv4m_C5EySRC4jT_gTaDKZcami7HVZ1JDvEThsayyQ&oe=6A2BFF51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrkSmVRYcUgQ7kNvwGen89j&_nc_oc=AdocMY0Iqch-mPildILgeJomr1WhlCIVBsYi1CBT7qs_DCOSzRRRONCdYN-bRrGNn5s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5EnBL80wforJP6bQMtITAskQft2JOdPiQQW4uiF-gHg&oe=6A2C28A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBJzfR_A9zYQ7kNvwFrDFAv&_nc_oc=Adq-t47jSYVYF-lFuxXP0T39lyksYRIJiu3Kyqu9zoJaRZ2FJVtR663PzZXiBp3dtD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lDepa3TslMKIqgKyArxB1k53Liqx0hBO1cDv6ouof7g&oe=6A2C25B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6KKlAX7WDoQ7kNvwE6KcmF&_nc_oc=AdqjeVuidP-ogQy8ay50xp7LEYNC3i_l6pvjv_v5VTjmWuLrpF7NqZjnJoC-hdpzIus&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aFbNZjbRcQEb-KWQXurr_Rh2YEZi-Z0cnNf0OKOChQw&oe=6A2C2A31"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
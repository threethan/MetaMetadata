.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrlzJQfY4U4Q7kNvwF4dNS9&_nc_oc=AdqErzQB2dpAf-mLj2w3ozBsK2FwzrIcgP63uLDjzoDdT87oHm3OjYJrzliZFGhH93M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbuEV9mDMtIZzZxtzAl56K2g01Qd-IrxuF5KrlZ0Fbsw&oe=6A69E6E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aROwCkGJVP4Q7kNvwFgiMY4&_nc_oc=AdpUmsGy-DpPVyrIALhQIFT0-0XSnHnczBzLDkPZZWkq857VRogDh34EjL-Lg4KGdTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm0BlEiWMpZbnsscVYPvDvHanWgIc1uIxdmsGY7ZFhVA&oe=6A69E3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygf5RdIJmRIQ7kNvwH0V-oa&_nc_oc=Adq_prYTOKLtsDd5QxDPBIy-LdOX3PjGgKgHo1R-LEPDEVVDLIKvcX3t0LpX893EzIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHwLX2uT3vWxOM2LE2I6cJsqxNe8XBDLxn0tEGSGSANA&oe=6A69FB12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
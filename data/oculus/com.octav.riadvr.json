.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qawMmHwDkQQ7kNvwEIi6JD&_nc_oc=Adp6T5O2urekFVPjceFOhVuZD5yW6w1fsfff5hh5elNN9cp-qHjuhO9vEOehaBeA2lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0-S4v13DXPOqD3GnpL659WNrufYjwaPzaW63OqtQYPA&oe=6AF1E9A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_CoLZ0gRAwQ7kNvwEZCRCG&_nc_oc=AdpNFp-jfOpELvqtkdEQOuJRr3rc_Oi6QCv6cC_wg4kb6mzsmJV8vzBFY0KoHWJf3FU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9KVv8PuuWnaL8_V4L8w8ufkOQM4yXM0OpmzCnlF9b_A&oe=6AF1E6B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix40DjReOzIQ7kNvwGcfyLt&_nc_oc=AdoUCik8AHKSqvcYgA-ClMenSZny4EpzEqn5HCEtmps5wJF-jfoTuTsJxe6wPBV6kf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa2VBjB26bZSjxyBLRl3x93M9pFhLUO1plZjQOigL3Mg&oe=6AF1FDD2"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
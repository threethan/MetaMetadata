.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSF6Eo7tPF4Q7kNvwH3O2-K&_nc_oc=AdrVeA4B2lN6dl7tRwuNW9uaw8trcMpn7S84eGMhsHMCBU88KnZxMa1oo6FQunR0T5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP3nXs6izF-QFTn-q33UZiuq8bYIK_PkorDkIJEoQSgg&oe=6AE217A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsznmCaHsYUQ7kNvwE9v-lK&_nc_oc=Adq9WFv7RXt_gErj23x4-v6yx0ZPCntrP0DIZykyK9l2GQiOfrtWSWM1WQaWpqkwUsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrjXl0KOei0BkIaHPhT0WBXdcuE452UR7Ki8TxKvbtyg&oe=6AE214B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5suP4Fv81vsQ7kNvwF5zCMM&_nc_oc=AdriJd5tv7CPspmabvURujjMGGN99aEYeO1qYGyn0EqseohWwZ0M7OQ0r90-CyxBm2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6iJtYQxTA09Ssh4b51dVZslVIUZRC0G6vwIWropOCIQ&oe=6AE1F392"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEyTqC32egoQ7kNvwFCgqvd&_nc_oc=Adrwi1fOT6NKMRcb9M_MBe8ICTQxAZFVEckxBJe96RSucvN5FIr9MXszDV3CYX-FZ7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFuFuefTQc6JvCuEhj8bkaGDTDORmrQlAZdt2h2dqsPg&oe=6A7EFEE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXVSH7ScFjoQ7kNvwHvlgun&_nc_oc=AdqzTKCD_raDCE8i5Sq8kueOsyatGr104VI3n9YtILNcNzI152gvnnxEuFBlGvixcN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF2_m8Gi9uM2EQpACm7qmS6P7qZuod0ziM9J3BejYGAw&oe=6A7EFBF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BsBec7PSoIQ7kNvwFMqlAS&_nc_oc=AdppgUYvQmJW9ods9Q4AskXN_4JZh8TaXuAZYz8jA9ei7tNcYWnmQvVpn9hAJ6XZUUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu7RZ24WoeHq9hRsp1nYRhl9lxXup6n_Seo7AGuHF0pQ&oe=6A7F1312"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
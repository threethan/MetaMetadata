.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbHLG3VSYQQ7kNvwGlcEYW&_nc_oc=Adpnli467_yaDRRjZSD5Gw2cdyFwueYjPJoSM7eVR0IKof79MdaLOEaLT3xylSL18u0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ihRC9KRFAO8blzfXOx8rZ20vmUkvAx6NWQ1QB6Gb71Q&oe=6A0B3325"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2zbNUj0XG4Q7kNvwHHGwTY&_nc_oc=AdouIFNMTrpMmLdmAZquQZau4fZN2pQfp8pAqlJ0bs05WSkOS975GhnfiHtsf-gX478&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S26KnSV_Rol7YQKK8tYPTgE7Xdc0GyyltsVb16J1WpQ&oe=6A0B3030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q03jfkHplL4Q7kNvwEgrzq5&_nc_oc=AdpVDzL4uZioHNVgNBHVcaPJk9MpG-wsxK6VRgLXTD8MqUcqhTsjB6Veyzle9W0wWsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TrzyJ-O9_vzqZ1k5Rs2vWWb52CxiutgSYXYmxzV4MNQ&oe=6A0B0F12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
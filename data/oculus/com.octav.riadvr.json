.png", "id": "454532440811338", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6CtPsSSISsQ7kNvwGq1Rd4&_nc_oc=AdqndxO-b_y-Sm4YO_GASGE2zYVPjm4zt2j0MVINLJ67b7EOFNPAVty-5d_RfQvQKkU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRNIrnGQT88gNJ2me7CRt9rtqs2xLBhaX3WHCU-Es92Q&oe=6AD39725"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A82xSkqjwhgQ7kNvwEDYZZS&_nc_oc=AdoR1aMtOLN1PPAfTIn4alS9W4Lr4fZqVsR46GM1RWvpO1WBm6SrAM7Pn_VSHSbacb0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjupbGFjNN31ZuriqYlLYVH_8TAKXeJwgv1P7PbwTTGg&oe=6AD39430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKJykCm8i6wQ7kNvwE2fBul&_nc_oc=AdoKMxL86GL-vd-5N8aseupxsVjCHC2RtfKSN16kOK45mD-fhluFbw_XM8-ZW67Ohrs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKeXc8-sNhjmz-0XyiepvAPlNgTrNZgcEaPHe1Vi6sRw&oe=6AD3AB52"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
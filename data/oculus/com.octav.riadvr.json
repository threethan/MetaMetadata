.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VbHLG3VSYQQ7kNvwHRy60F&_nc_oc=AdrfV9RiYNee3RatNeuoMI3ztVttaD91fwDV8bQJUNH6E1j91K43Y6hPg5hN74m1uRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fEvt8bp-HuIsFZ4GT1fGQw55qbEGTnCSsjZA8FBETyA&oe=6A0C84A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2zbNUj0XG4Q7kNvwEi8J3O&_nc_oc=Adq-si__GpjeRYfOJY0hIoiQwWqaPfL8dACBYFM0iqhtFWK7u3ipKfbv4SSrDV_K8sg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57XDLprMCxTzqy4lnWIZhksHe4JOOVdD_DDlGyWC-4PA&oe=6A0C81B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5bXfsA8cTMQ7kNvwF1qbBd&_nc_oc=Ado7bXHc820riW1epLeFVzU9J7jrUhaII_-xuZsFRwaqAkPunwfVI78TWueIIDW9Js0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63bp38J1z3swvciXcMZuJa_6NN1o-me9svrK2ayTyWIQ&oe=6A0C6092"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
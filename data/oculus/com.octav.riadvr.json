.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8goq20tGd4Q7kNvwHCJMDa&_nc_oc=Adp_kSzwEXyB_Ip6uDtHE6MmcXpnw-zNu1J02RUnPh9LXzi0HX7BYzm3DfxMBXzJslo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx7N6UQT_zA6aGVq4PE75jiuKbY2Ekjoxt8Umt8sMtDQ&oe=6A5771E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_hd09CY1xsQ7kNvwHOzCmn&_nc_oc=AdqCtMqEhm8Aqbx8OhIDhUNH6-rxlArpGjK8loLk_C56J0dR9cTaguKyJZUKHGB6JAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_Snuv1Ee26hUfrbB8Ug4RStk52u9647AiRbHQFjZrg&oe=6A576EF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqKi7oO8MoMQ7kNvwFY9ogm&_nc_oc=AdqqpAPWE7V5wRFLGEXWMiXfoywgcD3IaItZTytJBU_d14z7DdFXeVGBFGzsW2lIzUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyJIC1V5FYW9Ri8Cvv4k4N6X9T5c4_AnG_c7FzeUeBeQ&oe=6A578612"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov6JOkFuFBoQ7kNvwEmpOX_&_nc_oc=AdnBOfPaCCPVOFWz5fZjggbX0rGboHzUDLkoUlTOiBIAFCju3Piq1CvMt2UeKepjp0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv--VKDwraEkFrWrc1dokddCUvfblE02kEkXd4EwTNNg&oe=69B54965"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKhohFPCdZ8Q7kNvwF_qxqv&_nc_oc=Admtb8O7DOjf_J_scWb_U9Ucv6uUh9_QMyKVmnGsJu4NPNmrVbsXRh_X50Vfi_6thYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpMJpIQ8LjCDHbI1ChDMq8SIiNsmuR3GLtIi0jriXM0w&oe=69B54670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeI3qOSMK74Q7kNvwExUtzX&_nc_oc=AdmpX_kudZeYnHP8ywgLhAWhDyiSkZNQ0vCq2Gk2CaV8NB3qFUuAfIwd0eouAl-0qwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxhv6DU712UTSXk4HHyNQj3IEjSUUqCajBiUCxpZ01BNQ&oe=69B55D92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulou
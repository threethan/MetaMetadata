RZAES7ogbZsHiIYhrPj9gFRusa39mQFM1od7ZoPjyF67w5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGQpihAV6-23gNm79I-UT3bYCNPoJuF2y25gKPYfam6w&oe=69C68D2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjfFhA8z3kQ7kNvwG-CuJZ&_nc_oc=AdrlQ_9jL156ZPUkCXTphvTWC9tGKrRz9sZp9r7YrdfloQkV3_A50cuBviUpf5Rna08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afza1w7JIGUxYdVPyng6APA8xjfOR1lZGTe_chY6rCyCCQ&oe=69C67BD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbfEP3fGaXYQ7kNvwGaSYAh&_nc_oc=AdpeK0XUr9WR-65AxYpuNo8O-frMuJaV0nolF_lqiu-nnv3sEsjXR0-MF6-mdfiwhKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYQKFgMHV-UOH8tJF81YV7gFTDxjPf-lwiwoUq7WUINw&oe=69C66CE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vNbxAVU_C0Q7kNvwEkeRmV&_nc_oc=Adq-wQxxepo870Eo7lhAnYT7p6knTQtl0qh9KTFYpgUnUbStYFAfuzSTQtLbdOFZRNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjHXesjk08RW9qr2cxFgbcYgHsFsukM9aUU3oyvAJHDw&oe=69C669F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMSQm7e-gVsQ7kNvwExtBHU&_nc_oc=AdqndHLUOzp91WgydM-oqE0ryphhmec7ty4855hSabpIR_eH2cKjAzq7H8CyooMAIdQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5k-D4ug4uUY_-cx5u5cU4644o9iirTmQ0yC7Ij203mA&oe=69C66E71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
YjUcw5jn1iQOaupm5clk7gw-4BhybaDu_o_pnWYYtH9HqEk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqh03GNBS56CoRnMD6MTfnEQhQksgkZn8oaDww4YwCdg&oe=6A974AAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF_xkCKMex0Q7kNvwH2RCNe&_nc_oc=AdpD0iAv4cvzBU-jgDq1ewYW1OkrhqF8xDLZ8b9uuzerdduvUSleaCUsxto3bhhhS9I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCJJoYS8OFKZlZhfSXom9TMaNV1DsMyfNzae0igaC9wA&oe=6A973951"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSnwZ9nj9KsQ7kNvwEfva_E&_nc_oc=AdrRQnG587m1mapp9_NKhooNccZW0aSg-mVHuAfUaN-fvsnzwEql2dB0XqbQSXcljTo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR7CwhN-ovTOCWTc7oAmKtw8J1mZZfD4avi8hDXglUpA&oe=6A972A65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDiaHmGlva4Q7kNvwHm7kF-&_nc_oc=AdpXqvP4msq9pV4XEVoW0HYWedytZaO9T9JNASkyEnH58tMJVYmsILH-WK6Y4SNVYFs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm3TN-IOba3GGwKiuMCdYC9j4dA9ivibZYj3zjgt25LA&oe=6A972770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJKVZ2xf_AMQ7kNvwGdd_CE&_nc_oc=AdplKhg77m7AKKVK36r2Ny-XCYG8YfwVJPrUIi--DPuFkrjghm32gKW_E0NMNIw3674&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeOLon184iZ9HS4hU2H_yIyptI2j4-dz2JKuKw1v737g&oe=6A972BF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
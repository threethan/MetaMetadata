.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62lDRvN7O3IQ7kNvwHqTVrH&_nc_oc=AdqY5wORJPLgrccBtOl-4Gu6wyDqsJEmzMLtCZFKjYskk8WM-ZwNd3dtJpYYcbjyMns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3ukP3p0Gh1GcqDdwCG0vnssZsxaKctuMpRQVdmp_C-g&oe=6AB93925"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx_xJYbdgM4Q7kNvwFR9kA-&_nc_oc=Adqstk6lZgfpsbersHZXJ89WApT_n0ZN1Io2qTcHWfiigWI9I7ztPSCcimCziDpe18g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZiHcnJaXF4Pk6VBpjvBRvKS3LfqGTY1_auTHSousrUw&oe=6AB93630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EsplLQeM4MQ7kNvwG53vCQ&_nc_oc=Adq8V8y4P9GAdoU7tY2RayUb_H_r0LU_mC9jJ0m4gftzoHy626-t5bQVa75_zk0whOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt6xGEjGlIo8jgAFRypKGwqCmo-Hj6rbIq1EuqTnMElQ&oe=6AB91512"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
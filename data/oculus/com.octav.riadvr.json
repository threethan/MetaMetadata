.png", "id": "454532440811338", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQlJMzayVUQ7kNvwHUw3jU&_nc_oc=AdpVA6p9_bmrA3DqIt-5c5omR3PH47FNyOvAGef29RYR6gXgI_6yAsgV2JsCohvoqPw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV4YGZ60__i-OUJxTM2n4VyWiuZ48kO52Ua_tdApVtMQ&oe=6A65F265"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDHGvdiBXsAQ7kNvwGVjryu&_nc_oc=AdpoNLs14AW-VRCJkYV7JlFUyrynqFf1Aqrw2vKLgq6WS4l46H88zAT9aboGIWYB110&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuYfgmOkoMj6bPGzLdlNR_8KnSxWhlmr_JuNyD5m1aoA&oe=6A65EF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WURw9daNne0Q7kNvwEpHk0I&_nc_oc=AdrNBOut9pa3avzaEdo0XFgTf1tki7bMWI46QiwYV0cDvNJm1TzyU1GVybk3C04oQBc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKUT7_MC1wRkU46wY0ewlqZtB79tgU56hQ2JI1dAC9sg&oe=6A660692"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9Kj1E73FuMQ7kNvwFGyUQt&_nc_oc=AdqSPniRzXKsKyEWZc-r5GQ87Z_ktk6K35k5YYHAOM6-f361loV_vNCHXwi04ofiYts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gzMqmXzox48e409Iax80Qpym9_Dws4SnmFADX6TvC2w&oe=69DCD665"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnKUA5GQGl0Q7kNvwE4R673&_nc_oc=AdpvICbE8Ws9V-cCCKVzCJ1QzLjH-Yci2DdfnI6M3gWbN5kCA4CM1IHbf-_LuPau1f0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f1T3J8kAk_shRYFztiXw_U9ghuc_VZ0KFQLyA06lgvA&oe=69DCD370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruD3jUOTpOgQ7kNvwGbRzGV&_nc_oc=AdoGqjpL9mmP7vIbp_17uL4AXMK8TKDR8Bvu4Ruv6mmULxwT6tdATzm_vSnqeOokpK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fqTjKG_cYItCg6Ocgp3Dnz94Qcy_2e2-72g6tV1D-9A&oe=69DCEA92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
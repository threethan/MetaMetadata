.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krIhTRwACM8Q7kNvwEt0_pb&_nc_oc=Adop4qf_J2WtCC7w_aqyrP_u7yTuXfllWflVukl6hP-bSvMFEo6SS71q6lzNngLOLDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h7cTNmRfcLV4JMGpnimKa9dYXzdYTZoWu-O_QMHgBBQ&oe=6A3AA925"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_7gkm3p83wQ7kNvwFuBQ4i&_nc_oc=AdqBgZXTnXHU1rgClFuHGWiOQrbzfKYNO2EsK2h-c0GOGYm2ez5uflwbyl4tim6dZtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gqGKVYp09QXrKi2JCxYoRsfeskt79uvfRn6PoHp5OJA&oe=6A3AA630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdO4t152kEQQ7kNvwFeC0hU&_nc_oc=AdrudBy1TPXkHfzx-dJO4gS1YblNDENDKgEi3V2nJ5LUH_eedkPgr0ejo3ufiN1JGII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NfK8t2jEPhT3uwiaCtls2mmJKDA_4HJuYA6Geh-ugDg&oe=6A3A8512"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
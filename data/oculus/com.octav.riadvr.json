.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq-VIln7vmAQ7kNvwGtMICD&_nc_oc=Ado4biTrq11m9Z5L7fxiwvLxQrn-q2MCPYCnlBVcgSdP5MjpCtzbWJkXWtluBHPbG5U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86xrT-qoJOI-NcOEqPJEClP2-BH4tMtEkd5PHg_S8xsw&oe=6A4140A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFt0Xo4nMhIQ7kNvwEpiz9U&_nc_oc=AdoZNGtqG6cre8a2qn7LFLViLGaozZsXZ96wluz8pSV7ue1nrUhPIdG31DKoNW1bNtY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ehyUtpfoEis_huyiPGo694CI7EU7nDPqKX6Yc3BKrg&oe=6A413DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xsr9R2mkyugQ7kNvwEpckii&_nc_oc=Ado2V9GjqgC6ZO3M1VdlDNQdfWYX44_cfhPn8QPNidWR79Ukh8MflKAHWy3m6YjXPWc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uVuKBtK_3KIk0FB4O2bHxfQdHPcCFk3ZYlPoFrqPlLg&oe=6A411C92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
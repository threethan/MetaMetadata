.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeLm-Y7aJEoQ7kNvwHYpZQk&_nc_oc=Adp2VYWrMOQQBlbvhQ_W0LNhTmE4K4rbfvRqDlBGPdJVnHn_F55iHpCK5RBIJQPOKMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ORJXEMaxSYw0XtdQNGCMJsJLCFC3RfwHclPJP0hHDng&oe=6A00A725"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c67oMEYFfIkQ7kNvwEkC8CV&_nc_oc=AdpbWHUEfo_Rmh6LTJWdlFYe1APLCEAZGgi9E1Ent1mtADCPRYa9TbTENPkup8vyfTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tcRaFiP7wnooxrMPDpl84hi0tg-Pb4eVC85X7VrH3XA&oe=6A00A430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VPydVdtV6sQ7kNvwELOy8y&_nc_oc=AdrO7qiN1q376HNmgfztglMgPCtTZ5U-t-ZK7uhFI6Bi0ouoAEXiaTM3Tk4EVndvfZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ktn7GMvOrw3gnJ-O5AtOW4MYOYExq4F8FRDHHz-qRPg&oe=6A008312"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
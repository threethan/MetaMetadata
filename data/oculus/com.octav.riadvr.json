.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krIhTRwACM8Q7kNvwEIMtTT&_nc_oc=Ado85yKYrJXhWve-GPTacQ4ZJGu0y4Sc9U7pnGxhVt9jswCObCgsCku1az61jhpN1dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J8w-46Gpxx_Cg3NtnePgUeHd281Zfj4PBeL80bM3oAw&oe=6A3BFAA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_7gkm3p83wQ7kNvwFn4WXn&_nc_oc=AdpcUB7OKMbYjysWARWp-EVzFlbQRYHpkum64hvdNUjSqhw0O2RjvrBKu6zLMV3Ceac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7WPMvlA7YI3KHHshumc4xZbDtCIwN9WMADCQJkM4d6Q&oe=6A3BF7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xi7N8TXPIkQ7kNvwHvocK_&_nc_oc=AdpsUHl61DLXZp5TH9DSUVY9yH6_l2Wo1N9AiufaiNWFqXzSF3_BrgywyrbvJSy_DZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v1xvVOb1RiQtK1sQLxDuK4VcNx6dp7SAWIdD7kj7LQQ&oe=6A3BD692"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_A3nSUc7EQ7kNvwFjNX9Q&_nc_oc=AdpiF6KMCrbXVhM6CL_HtXKF-uVDk72tBcwwTk-z-hoQ5acgy97McfwwM6Q71_W3FOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMOefNyhdV0AFgt8X0XKOK9qcGa4b0ubFVy3Au1ByjVA&oe=6A537D65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NWf7Kpnu4gQ7kNvwF6GQ4D&_nc_oc=AdoIj5AYMbKd-zHRnACPlT2GuioyarO1h-uHPV8gukX2Wg_rv-kFCIxQUeHXSGwm_rI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAK7eYCGjyNuAK97VmvcTGaJM9w2__FHo7z12RXZtgbA&oe=6A537A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1hgLre4064Q7kNvwGNGTtz&_nc_oc=AdoL1XNHoksTb6BMFZuHc8GjRRWBUxqVixqqje8lKlVPIeWB4dSA1DT_2GryI3foE9M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUeODza6p5vrIwNMuWWTEB-rJifqs72wciyztamSLKDg&oe=6A539192"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
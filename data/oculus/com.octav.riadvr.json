.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjA-ItXXbDYQ7kNvwGFISVc&_nc_oc=AdrEBE4rdKN5Ld7nLrZPdSc3UUxy77ULfJ4i3vshPsiE5uUlTk3cNwdvUi8mumWvZtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItQvaOmavFPjsUL1rPAXg7Rh7Dx0MxSZDIKxt6pk8Y1g&oe=6AB15025"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMp1lejI_V0Q7kNvwGmLyDp&_nc_oc=AdrKUm40qEn6myXhiUENaME_tEiG78Lobmw8ckLP4KqXfWujXzmu2aWpTGFry4blIPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeF1VCvSc4mchvhprNN_dBYcaPSaQOKjoAAuGrwt2nnQ&oe=6AB14D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9IeXp4CxgAQ7kNvwE7zdfT&_nc_oc=AdpnY4ZvNa6rB389qc2CFALVhFaU0n-SIQDq57bjPj0fMGmlLPZ8oB-0whSNg6MX1Dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsRuHoQEHymqSKQ6IIvhdgps9OM-yA3CrG28xW07-y9A&oe=6AB12C12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs57nTNkk50Q7kNvwELPg-n&_nc_oc=AdpGiX_e26N2nPwg8owk_RFhiVCPDPeug7ByQ1Vxr6Sw3Qy6wx_vw74EWKWI-RoXORk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFGlee6bGUoB3k1DvQdmBUZ8PaYqNQyqHDORvtigV0Ww&oe=6A4A7B25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlELie564LEQ7kNvwHKvoTc&_nc_oc=AdooWp8tC0gMc4Ox1PKcZ5b80Vw4RZjJhqube7XWzjuK46qhnHqTJJYvmLDg9UZHU9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf8dnfUZenGJEc-PWXgRHuvKjlhP_B5uUvY1pOf1FcfA&oe=6A4A7830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhS1t_8hiHkQ7kNvwHaBD9s&_nc_oc=AdrKfKVt_hG6Eawk2sJYAOxBsxuSIH4Sx_zozjIywRIVcVQfw_8QG_85Y7KvLnztlw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHRV219upg0-W8WjYWKi_nWULonl5WVo2agZsickqB3w&oe=6A4A5712"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
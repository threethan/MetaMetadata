.png", "id": "454532440811338", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1jwdGiqC-sQ7kNvwHGBPQM&_nc_oc=AdqpPw47rcBLRJJQ9AMB5zVRY8qBg2qPFfhK0Zphg_Qh_DzhYUpYIuCsnKw2qDYlY9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP1GlbY9JiNyAEwhCbJVJGdQLGDvXdmRrndQvG9O5N1A&oe=6A6F2CE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk1f87D7dIAQ7kNvwFhK-h8&_nc_oc=AdrXZLn70J7E1-h3NY4hhYHVvfa9JZy7z3H6wjSabrcRPep3p1AE1fzaFTfPT0OZmQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXrpp7hqYByX21wWZimILHJtmvoa990S2Fykr_lp4jpw&oe=6A6F29F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7xWvLThP38Q7kNvwFi3n3A&_nc_oc=Adrr8S63sTf9UXEPLASrYHFwnQhai3mV2B7l4zyFqkYOgQb0s-MV0uLzChyMg0Z3yUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA91ULwgmofjMoRWr3PUiiP6R2-0qUlEAN4qpA5Onk_NA&oe=6A6F4112"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
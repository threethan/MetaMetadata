.png", "id": "454532440811338", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgXwuGKbuJMQ7kNvwF_3VK6&_nc_oc=Adp_S72hKD0wFIhFqGsrGDhQgEbUjHeif4PjUZqdhe6gTAMHeCIMP66qUmsLSYSYAUE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nJ7cbcUGcDpAqpKFpr3AOKQhL6Hwsu84r_f1zqGSM9g&oe=69D79065"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnwqXUl8c-gQ7kNvwFYp3fG&_nc_oc=AdrTX4Mb6yYP9sa_P3wXGnyeCSqzphO8An_xTByJLZqtneVGObY-pb7XJRIyos2jXDs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Twk9u1o5MnodoZbRYv4FvlzOknmTLm_EKMhjv30nHA&oe=69D78D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlsQf4551noQ7kNvwEamB7U&_nc_oc=Adqegsuyu0GISMoJ8nQevHQ2yrOp8uMmuTFZCVDxBiMn5TWzEbSCTaX1p04w1Ej5uxk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O9PZbkdKY681P4C_H7doybxsdNfuoyPgXespc-Vgu-A&oe=69D7A492"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uNCg2bc5nsQ7kNvwHaUkL-&_nc_oc=AdopW6xa5v2x7jDTbuGrC323Z77vPiPozqG39Ul9TZdzyA5mgLEpqOdaCsAcdkn7c4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl7ehYZJHj5kV6GcBXMOFjM4z9NtgGhc2maJUXXoy4IA&oe=6A9C3825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCA30le2cMcQ7kNvwEzadtM&_nc_oc=Adpw042QLE8jhquOIP_NuhdwaNPCSKElPKjJ_PRbSTm0DGWHFMml6IOt0yiJokRiTyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfvQZdazZkSNeEEnnkS_-r2Pz9BGxY2ui_yRGjSAWU6w&oe=6A9C3530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ6kwtCJBTgQ7kNvwHZA5rr&_nc_oc=AdruPyXjxHrUdZy7IsSBp1BmYZRedL8pFymoVHGYSd5cfz5keQKtkX3oUu-XoPvTigY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfH_khb2GlBVMy68RU-Ecoh7beuKq-lHDN0plo5pDb_A&oe=6A9C1412"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
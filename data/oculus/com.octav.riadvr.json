.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZKQwzbK924Q7kNvwFSDunJ&_nc_oc=Adp_OsdjZ0V_heKUWe9f0yTOoCbw1Tm6pWuYrJLJDBmQhZ_UyQHAF3ujtQNcXiiY5aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SwbdUtZr0NG1LjYs61FYpKO-UvkarX3y3mck9momOMA&oe=69FA0FA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxM-8yeIrgAQ7kNvwEwByjA&_nc_oc=AdqoMbx8SIaRjHvG0AYSKPFUpDdDvtbMLc3dZtHvE3XuNLCMV2jMT7aDOX9gIaXvKKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ruM9XFs3_H0H9_GG7SPkWutuHc8wg-7BSfl-uHlBj7A&oe=69FA0CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nknROqFiAc0Q7kNvwGvkztU&_nc_oc=AdpkkwHt0ZxoJo2UQw0gTmvF7vuwbJHNEEQxIDma2VcE760_xn4J2btt8HI56P9Y3Hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DlsFT7Ym1mNeac6IHpRR7ezE8uR9dD-kvpvWobE3qFQ&oe=69F9EB92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1pu8znzseEQ7kNvwE8cm5V&_nc_oc=AdoI7uuF5u8h6OuU0W-YH_nrIRFC3IHB4-EBWKxEoAyj-D0LhO6YKTatBZAvdByTBDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGopJYfhdX-4dJWoICGAonvSu6Vx8x-sIZT1y7uqAu9BQ&oe=6A7472E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ully50TQBWkQ7kNvwH9NZq0&_nc_oc=Ado2YV19QmjSv4UxsaG_aTt1V_0Tjbbk9vDYtH9aVJpY8n4iwhJKR0cUQzsxyz-bnKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_5Fj0MppSW1hC-J7kfaI5NyZskKmP3aeTtRw1CGwzaQ&oe=6A74A830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYJ2-9XjDnQQ7kNvwGLJoPY&_nc_oc=AdpYU_3aus6gHtNmMn14NocylBQG73IP-sw3nTZT_pvVG8PbkD9SgevvRM4n3KY-9Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTVaqCTf6qIab2LgrHK73xI2k6mmhwb4yWDsle3MVdJw&oe=6A748712"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
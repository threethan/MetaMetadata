.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtNcOXXH50kQ7kNvwEIdpQ8&_nc_oc=AdqzX9eFnc4Em6a6-BmQqrunDbaOyhOEu83dXtoKL-p2XThcVUH6W60fuv1Tca8iqd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzPSeukl6Xpu9AcQvyskEGisdQqOxesl5vr17jAqDvJA&oe=69CE55E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r--tcqZD9sQ7kNvwES0JPB&_nc_oc=AdqPcifsNvsccvuT_A-hmcJY_EWx1aQqZq1QeDj0rqC0J984aVzv1oyg5enBvvpuzUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0VXgwZkuECNsVQNwxnxRwWtfRougcEUyC_ujkAYDSng&oe=69CE52F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_O0WPPU5JsQ7kNvwGGV6rA&_nc_oc=AdpOIX1yFOWwrzCEVCjUgDBRlNXw4l11zBfxF5HUwCXtwtUpFeL4DgmD-xTP0DXUWa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZiI5xhLaEEroFUcOg3YRtIS3mJfakVY8IY7_PtxRM2g&oe=69CE6A12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
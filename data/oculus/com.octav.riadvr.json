.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtNcOXXH50kQ7kNvwGLOsQu&_nc_oc=AdoKD_sPfsvsQy3zD-sC4SApCO4bprPBWdDg1NLvxO1lM-0J317fSamsGsjg8DlTEqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxo0tCuRgGEi0if_G2d6JvTg4jeEU6TMPl8yrSXjDTR7w&oe=69D0F8E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWqoTMvcCDYQ7kNvwGF0ATc&_nc_oc=Adq7MCGtjNzT_rCi2DyoCcepFS13PmJiqrxzvpY2fFN-v4uKh1V6T3Hc6FnT8tEjWnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv3AMZP-moZkjajZqXSV1L5LdJTpj547rXcdNl-ZR1Sg&oe=69D0F5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQN6AhKgzoIQ7kNvwGZ0ATs&_nc_oc=AdpOsD6I2zYzrdBGWCh8t1SnJuIymGpS34Eu1UWsr0H5q8HW-EE_DO1tmqa1cmE5LUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgkGJfohzrUQUKIA5QdpaO9VQXw6FTyOL6Lcth3oij9Q&oe=69D10D12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
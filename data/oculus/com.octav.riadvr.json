.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSBtRDKwxBoQ7kNvwEO38U7&_nc_oc=AdpmRcI9VMGVqzLvXRo0VgIeL-U_cJd6-31EORgXUcXNVHqKXEvBK-9W4Ix_d2AGDSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YXWjfx0JDCg-A9mlTdbCKnBnzgPPyK7TmCyyWraxEog&oe=69F8BE25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxM-8yeIrgAQ7kNvwGlBBz6&_nc_oc=AdqHJD8hXcg09nRZxC-jyK6WCF-8MZ41DNKHdm0_omTlCPE9bZExb4ooAad0bRur7r4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vIPu8pxgXB-wZGkuXayX6DvY4JPaDU2SWuFmbgeWlFw&oe=69F8BB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nknROqFiAc0Q7kNvwHPaIyM&_nc_oc=AdqP7K5x9NQhCPR56NbagLjieLtucYkGPz2R5EyEJXZKqoUYfvZ6KI_8puZUeFsmch8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u07mC2Vwl5qSLTRYS81e6MKeL23behMD8e48ddE9_QA&oe=69F89A12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
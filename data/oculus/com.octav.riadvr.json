.png", "id": "454532440811338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYr0y0xXRZEQ7kNvwGL76qJ&_nc_oc=AdrivsjZORaVF8Jfhq7jpgC0MQcruhw5m2hBr9nYW8tJWbVKnggBsGN8KiDmu3SqqtU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iQWxZsl9bxC8NUkIjNBy6DckOD8_nq23RDeUVPuuGbA&oe=69EF83A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xgInnKS_WQQ7kNvwGJwT5n&_nc_oc=Adqkfm9bPiStY8VyTA6-6jxfO6jtJBY1HVunhnfgqOdEQ39oFbRF8N0pDIqeT7t6UOI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qG-7W4Z21oR8jhtOutVsqeJFdLmzDt2t45Ghsnq3jDA&oe=69EF80B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce7Y_jqH4hgQ7kNvwFRymzl&_nc_oc=Ado95nUC9vGqet6u-d6k0-pD29rI7VywuSo5uI7rYGEK99_HDuv4kb4raiHxjGu9u-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JVsLCAi2XQVnpHIwLXYy4qX16BxwYwyOwGMjEQJR0Og&oe=69EF5F92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhN_Uwmr8loQ7kNvwH9-8tL&_nc_oc=AdrSYemudUCB_9V87PPSkeyw2VIb7Zdwhbyq9N5n9gkOcj38MGcO1nhxM4_SMZPEc60&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2okat2Pi8ZUea1rM2Nev4nC33uKGmN7dmsL9Bt4aRI6w&oe=69F37825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCWCGHwRQ9YQ7kNvwGgAyz1&_nc_oc=AdpfMjlmdmGgmhklwu5Dz0-UrC3aQisXA5NYgkd2ZtmduDa8f0G25dn7d0QIBHYsiPo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jhLRroAL4K-9JN_DS84MxJ6zgaz2jBRpbrohJsymNAg&oe=69F37530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LerrzIkhI-wQ7kNvwFzFOZC&_nc_oc=Adr3kUXSqBErI8pDXk3OiD_HTeUv1azHlOTuAXNibJzzJtdyE-rp7oH6pjxdOJR0aR0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KCi1RAGahraQQhEYnsaB4Z90NyvvM4BL_aaB-JrHuGw&oe=69F35412"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
w-ZCwdvPCIyPcXBmqE8MKa-VLccz_UEa6AC2Q0_8y7M_cDCmejA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtjs_xpUiOiXeXj62CJ99c7n1OdIYpApOfxmthdh7z9g&oe=6A7DCDAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vxgMseEDc4Q7kNvwGXy4Gg&_nc_oc=AdoBLJQC1XbN0VZS2B_j2Piq1irzyMGZb87ZGbMXBnZwKmVHonFI30034Jbj-57lua8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKE_hfXmJZzAH8KV9htjzBOIVFkCirrkRJoLSUMdUflA&oe=6A7DBC51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEyTqC32egoQ7kNvwFfFddg&_nc_oc=AdobTVPhVZcRZc2mYCXpJiqMlrG-0Y-1BtLXmT_S2uHvDzG6kOAa2jEeSTPpMBgKukk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGLgffgdD6ykZTxU-euJ4JkwDQvDv9ZDXtQtMTgsI5mw&oe=6A7DAD65"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXVSH7ScFjoQ7kNvwG7MW5y&_nc_oc=AdpkWJVOmRclAht7GSNigfwh7h_DmarcGjVSTx5WFB-2OaZzQHiIMoIvZQLlOcWqm3c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRKdJIXnLnzQAyGaO0XvCMDmBYwY62n1ibI33dzoTm4A&oe=6A7DAA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saykVvZB3S8Q7kNvwGN_Xk2&_nc_oc=AdpUPppwQTS4LHD8owY0rQw5alA4_MuVwX6tDFQCUE0dI41Q5U1OzvCIOqYQWHlbXFk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHggDI0tRm5zhlyY_pvv3xeTW6j1naW4PZJasPpeFx2sw&oe=6A7DAEF1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
.png", "id": "454532440811338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V_QtwZgZYQQ7kNvwFhLCd1&_nc_oc=Adp8HmzC8m1owg3X6RTyGyI3IVM9Yy__WjIqZG8UfhIFgCJksU3B4f74UgMvo9MgY8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-JKEnmKL6ER031URkrmq0FbWBaFphCmWwjOJwjNom-g&oe=6A5CB7E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_t_nxkrQYkQ7kNvwGSyWQu&_nc_oc=AdrjDz5gLwet5SoEw-xXYByoJoA_nRS7chNBnCzkz3Dc2qrniGVm1iHWgf7gTAzTJwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzuY_1RbV6L0zxVTHaNe48to42B2JBrnzYO_7VU9Q8Ww&oe=6A5CB4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0ahjN41wz0Q7kNvwEaeqOL&_nc_oc=AdqCmKuwZgZrIYIfRLdAZeM1lfaomoxSHnq7Nrkt6qE2wqs2o7VsEPx0xI0UpKgx_D4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBri9KViqofDSKmwBXyxTLBetnyC4HtOiZ1c8aFc1hAdA&oe=6A5CCC12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
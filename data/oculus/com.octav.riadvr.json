V74TukLWFnUR_FZsppOT1Wm-Uha94rudxlF8XR1lNaPxr4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3s4S1ddv02Hb_XY-L1kCATxAeZy1jHMZ-aEH7qlvUp0Q&oe=69EF6BAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp1lklfOuBkQ7kNvwEciCPT&_nc_oc=AdrHAz8_6BSbkebth_zw8RHEkUaR5gRtD9JB9G9ARTCTZ4V_bJ8GrXLil7WD_xVK2T4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cuFvov89L1ydqqMMGb9fcwRHK0wcDOFmKViSPCED_5w&oe=69EF5A51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYr0y0xXRZEQ7kNvwGL76qJ&_nc_oc=AdrivsjZORaVF8Jfhq7jpgC0MQcruhw5m2hBr9nYW8tJWbVKnggBsGN8KiDmu3SqqtU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iQWxZsl9bxC8NUkIjNBy6DckOD8_nq23RDeUVPuuGbA&oe=69EF83A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xgInnKS_WQQ7kNvwGJwT5n&_nc_oc=Adqkfm9bPiStY8VyTA6-6jxfO6jtJBY1HVunhnfgqOdEQ39oFbRF8N0pDIqeT7t6UOI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qG-7W4Z21oR8jhtOutVsqeJFdLmzDt2t45Ghsnq3jDA&oe=69EF80B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcW_hBOLaPoQ7kNvwHQiBdC&_nc_oc=Adps3XLeD5-IcTG06zSbZI5Jc6oLjDvjSuSGEfdlsS3ynL48Prq0WkF8ykUsa4p87Wg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AAl7yUFi4qi1gwuVXj-zWiwkORDoNmh4PL69pKP42JA&oe=69EF8531"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qawMmHwDkQQ7kNvwF2dtFX&_nc_oc=AdrNhvkIczsiQQMC4TblYVazvVsvpoE2gVmFwU-HJE8Ut5ei7_TDeM7PZx19cEHA2rI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-yPumVlG_DoCq-T2UUuQjIsZbsSSCVf3-tQTJcP8B_g&oe=6AEF46A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK71sodxtFYQ7kNvwG1SL6A&_nc_oc=Adou81OJyWFydJE4495QOPG11hyvndPvoR6Xgdy4I7SRaOQ-YTfaVt7YSunmPV8NiSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuwJWZKZa6MdLzxMujSsylNBqve5S8gv1F1Nq-e3sYng&oe=6AEF43B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOX0L9XMBLoQ7kNvwEyVAVd&_nc_oc=AdoT9-EuKmN4a2wAYhHwAtGcZVtjHizOXt3Nd0R24vvD3PXvKGAjqyVZo7W97wejIfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV0gM7T8k-avPmMTyImKqWzBaShRSXyxx1BUKSObGnMQ&oe=6AEF5AD2"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
.png", "id": "454532440811338", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyaxZcg_mZcQ7kNvwGVpCWT&_nc_oc=AdrAdHbhqyc1_P8wSkjpJtu6oAIRVy1j40THV2bcHftbkV8xuhYQhCZdF4MsAYDc0Bs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9meArPdOj-SU2BOi_3_Fp5PqXOV8TelaRwWVYWNWDzuA&oe=6A3FEF25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFt0Xo4nMhIQ7kNvwG0A_A4&_nc_oc=Adr6SiDp0mC8y-TFMzuJM2TW0yp-9_3_-LbHRNxwLQsbpzldl8CbweCfuT3jPfhbRHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SKjpVrmtjjz65sc_tL8721dGn0TlJhMzwoAy_PdPwNg&oe=6A3FEC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xsr9R2mkyugQ7kNvwFU4gTU&_nc_oc=AdoikLPDf191XLka9QQjYSRgBaviesxqyn1qApx5R54Q2QkXQfyK_NXKH_Gj_AM2VKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dx4tjcHUflMDe-iObN92vS1L31X8Q2TP_PFuBKncySg&oe=6A3FCB12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
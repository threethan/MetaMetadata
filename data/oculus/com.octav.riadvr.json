.png", "id": "454532440811338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhN_Uwmr8loQ7kNvwHg5zuO&_nc_oc=AdqGQaR8YTSoS3PFLPLnwjuSnaRuw2z--zjcvWvMjShT5urrXIqMjrrlq6KLEcNk1rA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2B2hy8Puc3D5wuvO_-t8JClDbHqp6Y4hft9HScaYb64w&oe=69F49165"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCWCGHwRQ9YQ7kNvwH17mwT&_nc_oc=AdpKbpgkJfY5qk941UaZFI-42OtMrJCVgiQeLXsjo6nJg7mYzx6nl5ewnHTBq9D0LC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NmYz-JwmD5WWSMbLrv-OTdUqAEWKQCwgRvumO8JtBSQ&oe=69F4C6B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXpZzqqqhhgQ7kNvwFfGo40&_nc_oc=AdrNcF46Vr-tpzNHsGlFIE46lwny7Lhm--hD9TS9t2IRonUPtWYL3CaupUaGXI7k7f0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XYUzfWGjI41g0W3pGFUjm-_hZam7s4w-yOVSYJ14jeA&oe=69F4A592"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
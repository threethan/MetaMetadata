.png", "id": "454532440811338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vryfERMXG2QQ7kNvwFN1iAz&_nc_oc=AdrH_3hl0TJQKCCdvoARKdwokm--RWzl70SrHRc-c7QANW3peMHWah_wX3mlMAn-hpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHsdUv0N552r-GYGVJyvJqJ5aR8W_VQS5uA3vs_KiTDQ&oe=6ACBAE25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqQUkA9BLrAQ7kNvwGR3Vxg&_nc_oc=AdodQ8YvkVw-7oFozD8EQQQ0w5tNb0v3RvXEVYDnQwRUEX_f6tck_mnIhi7TbNjxhwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE7GYueFdSdz4TuukgIe_xnxhvZo8X3u9_esN6OSIovw&oe=6ACBAB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USrSB-5xzd8Q7kNvwEA24Q4&_nc_oc=AdpBSuWrtaTQO8MiLykKyRMwZxqT5ED10LlPeGT5kZR2iJU4qwpFb-kiSfSINRVDx6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFlxnsn8_ho7Y9oDLSNtohAip5GGiNtS9OKlgrakj8Bw&oe=6ACBC252"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
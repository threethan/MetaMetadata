.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6KwZEm6FoQ7kNvwHy5L5M&_nc_oc=Ado_QTfxbKz021wb0ueSxmGZDmuytgYo0NMNEXjBlb_--pJBiRM2VQUxJOEOPxdoClY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyT4_DZ9hjsg_EngeUUfdOBQJlxmI5hn7vJTw6HX9wyg&oe=6AA815A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDys36WA68IQ7kNvwHgoS8q&_nc_oc=AdrwqbiYIxHUoFnYbZk0ENJx0rXnzfdsmwtN3rcHf5f6bvnv0U3OMvK7BaCZCaTmTOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRbakNGTlUAikgCuyuUaFNL2CJIxDEY3Bfk8VTZumC4w&oe=6AA812B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFYAYIfKc9sQ7kNvwGdwyLB&_nc_oc=AdqHNXhbI8tXm7I3NtfilviJldvhpDwqQ8fbW_m5lAd11nFZY-VZEsihWPRGgwe5A3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwUSdtXWYakmet2a1-zMnwQwCcNbbnc7t9QGZB2ymP3A&oe=6AA7F192"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
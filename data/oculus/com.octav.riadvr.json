.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BMJu_6YKLEQ7kNvwHL-e1d&_nc_oc=AdqBhun0tHNe41NCTaL-J0KtuJZg2O6BNp5ten4hS9mgmS_7xOYdMXpfVtF7nSWccQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8OLGyAzikxHYS8iDlm-9EKpvhtmozCyrWyDKFzScrcA&oe=69CD0465"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r--tcqZD9sQ7kNvwHq1gxo&_nc_oc=Adqwcioej6ok9yvz4xwDzgveuIK6XEuZnGVKxvKUcCE9Aj7NwKO1QYSw9ubxkNTvm2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA2q3S704cKVNmZbq1YzC3vetzMzuo2zgxeXGNcRXv1g&oe=69CD0170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_O0WPPU5JsQ7kNvwHwTwVB&_nc_oc=AdoB8gUmQCUOsprBnfabHepu_6vQEtFuranIuk2RVoBPISqBQRKTbHC64BqCFwBy82g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz93XPjzdyE6fv9oATSQFJ1jzk24KUf2SPNd37dA5gx_Q&oe=69CD1892"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
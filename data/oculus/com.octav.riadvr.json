.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsdA1flPwtwQ7kNvwEClUDD&_nc_oc=AdoR8YidH-feIQ3hXcoHjKrXSaDOtV9UWiEIzQckrkWlAMBomoIOykXtu5NQUp4KCN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxUEo-BPVV1SaOlubYX2pKTVsvT_7o6iPGt-OQJoN3HQ&oe=6AC66825"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-pnCzxJQL4Q7kNvwGqm6Ed&_nc_oc=AdrktpjWfWAMoWNELwmUzImaAAOp2Q0fr_jJ6VYUHEzZ7xyPzc3xE7fqtE3l7hT42F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRLRGrjnDf6dMrSjjb97VRvIwVLzU-u4AaHjiEBBK52Q&oe=6AC66530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAbF-Dm0t0EQ7kNvwEh95M2&_nc_oc=Adr6mM4yCbQdLOnGFUthCxVb1nCNEG6ocvcjSPxQlRZrSCZwfkd9BYFqtGRap7baYfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNFHjmduZV-RVNBD960AOsLHhOQWWWwVwl6H1WPP7Odw&oe=6AC64412"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
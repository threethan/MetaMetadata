DfYGL2y6ziNu-2sbTalyJkT7BEMxjnKeb2jWt6V-FgUifXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h8-tn3C08hB2Ujk1SytAEThYl8YKamOHqwoYjpB3G3Q&oe=69FDEC2E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P38-mwvmGnsQ7kNvwE1mwz9&_nc_oc=AdpNh7trSHnoOY8N3Nxcw97yJxQdJo2L9_kjDC24J6LYtSeVQIZobNNoUCIIjqHY0vA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cqwaLkpTsrw4rpGXk0qQOdTP4Cc8POg-80Zkj8uESiQ&oe=69FDDAD1"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeLm-Y7aJEoQ7kNvwGzZqjv&_nc_oc=Adpe4UsmTCkan7fuwNtbjSQtCqykh8ENJUnyyeVF0aC4cLULc7epCfoWFUEMVocfuZI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EDol4Nq018LS6EKg-Fqte0D6CeH3DtZpxG4YTmqb78g&oe=69FDCBE5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4x92nfb8AQ7kNvwHOpJgN&_nc_oc=AdqdZspSeprJ5mq3-Jl2gAyGB_SLCDGoUPtyHZ_c7dmv0hAz_kerkC4BZMx3gjViFXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zmZuCZLkj3muSWxJWpc-qcBzA8ZR2imeZvEZw86RGHg&oe=69FE0130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnoNXW11Oj0Q7kNvwEkx7KL&_nc_oc=Adp8Jdl54QdWJ2_0bC99u7F7GTIECSFOiKA4XJVTn5YZEA5KbO9_ud7nTP5vR2TnlWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AVsLz-8vo4nak5fwhtyWAC5B15yJifWDQB6gDVBlTTw&oe=69FDCD71"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
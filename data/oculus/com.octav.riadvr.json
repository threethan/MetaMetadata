.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDVDeswGhe4Q7kNvwGymMmH&_nc_oc=Adr8U6dOe0mP5J0jXsbWpmUGZyN7i8M-NwOs_9o46i-tj8R3ayf4t5tZ_NH5mE3rA1k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I4LSg3rUL3rywbdGRC-J92s7RagxRyuwEsrg9kW_52g&oe=69E76265"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLT-WAi1iYQQ7kNvwEmuo_w&_nc_oc=AdqI988-0n-y2epDWjfwsKSUwVDFJevOcuRbRXnsFSv3fbBC4FpaxQRNjG2a1_tbadI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b8o0eiMmnCyvqSUeeFgispJc3cM3mUFqCKp0568qZFg&oe=69E75F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCPxSy6OHIEQ7kNvwHb8Sjy&_nc_oc=Adq591J5EBmm0HyoIPumjen_01VBUe3idaKmoFOIM_pJa32KV9fyuAJKQPVae4Ou6hM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16pAHfGhKoXwozC5Tht2Jq3uxLZfmJjA_-obq7wD0c-g&oe=69E77692"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
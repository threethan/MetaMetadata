e1_L9yLOkICs0_k2MqVTxGJpYvAJrMXwBNnrDskbZurCKO4_cXg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RIXgtEXgQmrNeIrlSIxg-MRKYILu2F7OfVcbJbsDyUA&oe=6A466EAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtmAYD1IIfAQ7kNvwHbbQhl&_nc_oc=AdpofkfCrXLGoORmlQupxAdckKc-mJjysfLWkO6dKO45VkKFQA0X-VffpJM9C-yApLA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_UgjzNJSE_cgssVXuwyOYbJ8vhEZBkdwaae7GZ9-Rzg&oe=6A465D51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eESdiV-Oq_cQ7kNvwGstvZC&_nc_oc=Adrrr3zwCnWZAsIFY2MmFOjjI5gDJWofxVksfyTBfzZxPhrscHwE_b-I_G45mpO_ync&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UxbzNk-zcDItlop-ZPpJPHYiKaXs0wTVV19A1cXhCgA&oe=6A4686A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqqhw-TmiQIQ7kNvwG61wkV&_nc_oc=AdoKUv5RMYrs8iIUFJwTOwF748x2QR8OBLV_AR9PykpB639GKRchje9_KbVADYK265g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nPO7X6GWpoTV0coRJ6ZqpC6sVq7xLv7EUiGXZcszW1Q&oe=6A4683B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il1LQjI5xuoQ7kNvwEccqZ9&_nc_oc=AdrzKrSAR79G0nGoyFRgI7Vav07pRyKsrZV8d5-f_2PA_3xBGwwRTsLA_TEHEqbN5Ys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B3AvKFPr9F7GuDZ7hZPlCO56eiN7mb5cSC-Un6cRxig&oe=6A468831"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
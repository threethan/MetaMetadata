4GvkoALAyKiZ089in7AROQDtMSf_iEbap2qzrKncUGsYv8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAXIhRV8FxzNEKOEd_qW7aTUqJ3O8bQQ0OaEiEKNB0VQ&oe=6AE8972E"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_1iZvwh_SUQ7kNvwFRna_R&_nc_oc=AdqS5BPl7og8w8mQp6fyZuvAQ9nPeXfo_AssZAvmc9XQCUpMk5USx7l6ukTo_hFL-9A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpr0SEXdn9uNlKpBrV0OPDJ2nX1jEHqJnt_bvw5txNHg&oe=6AE8BE11"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZN22PIY_kkQ7kNvwEcuzPo&_nc_oc=AdrB4P-6i59W69YSaytDRrMPcY8o5N2WqLvA-q1Uw_rfcjVS6WZob529-aIK21cHm7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuRJ9ywmQTIfJPrII1_F_yuklWmSsPNluN3xehlb9xdw&oe=6AE8AF25"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdGBh7-8xdYQ7kNvwHODrjC&_nc_oc=AdokgsmErj5I58V7kWl4s2-4BhPRq9Dgx27_FyL1YUV1Eg54nRrM7umVcWVbjsR_1IY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0i8PyB7xSdG_xXKsEC6ErNIt-g4ypqNTfA6TruaAQuA&oe=6AE8AC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZWljwwtunMQ7kNvwH7ovOM&_nc_oc=AdrBCp8rmpCajLWXWEvRvA7KWdwcHEgkewx2lcTzGbJhGIQBQ6epVde8U4kVg-bCMJE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBsrtPFch_j7YjGM-40SM61PrJs1SzV7pwaEXucswrSw&oe=6AE8B0B1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
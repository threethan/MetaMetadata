.png", "id": "454532440811338", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5DsXWx6q30Q7kNvwH6X-z5&_nc_oc=Ado5xzta-eblg9GeC0VFwMXQq8trWEL92Kd0rLScPnwz60_JB44a7WZXei1IG_QmW9o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeCWR8t61WyQAJWxOEmxl7VzdDeSMpsCgBZP2iR_HVXg&oe=6AA02CA5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mECKFMB7wuYQ7kNvwEvqrcN&_nc_oc=Adqsl_sRYkf4nuOmAtoOqPvUmRQoqH46Jn_v5GyM7j8DMFkndG7Lz1TBJbGmmB5tOZg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfXkESiiRiIGhFH0RRcAXaEhPTsX8FC28WARPIuHRQDQ&oe=6AA029B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH3HdyijQP0Q7kNvwEisV4B&_nc_oc=Adq6S4wyC5CjkDzt_jKO80njRHGXl_ov9y-OU4bmI1Cxi4LCeHATI4fRuvI8moMuw7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJInMKu_QObbCfPC_McWRWUpn7FtW5wKdN-stp7S6gmVA&oe=6AA00892"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
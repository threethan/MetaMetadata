y7K1bB8Nd5uV7osu5o5xSE9KdQaVibg-YoPn7zRo2ebTtSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyBvUBVN2np26WC_ncHBa1fNdUDmb1-U1Sn0igm05HTQ&oe=6AA7FDAE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN_xWg99GcoQ7kNvwHMQ8u8&_nc_oc=AdpwWTGee8PcrBeYhikI9Sy9iGgCpKo3fgdGnqjML-l_1Ijjm6_PBNRKtAk0YWzoiOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp2nXbADBVHZko9zeXoLWs4dP4lXHmuFQKv4ySGv-YuQ&oe=6AA7EC51"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6KwZEm6FoQ7kNvwHy5L5M&_nc_oc=Ado_QTfxbKz021wb0ueSxmGZDmuytgYo0NMNEXjBlb_--pJBiRM2VQUxJOEOPxdoClY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyT4_DZ9hjsg_EngeUUfdOBQJlxmI5hn7vJTw6HX9wyg&oe=6AA815A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDys36WA68IQ7kNvwHgoS8q&_nc_oc=AdrwqbiYIxHUoFnYbZk0ENJx0rXnzfdsmwtN3rcHf5f6bvnv0U3OMvK7BaCZCaTmTOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRbakNGTlUAikgCuyuUaFNL2CJIxDEY3Bfk8VTZumC4w&oe=6AA812B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy5qatacOokQ7kNvwE4Bi81&_nc_oc=AdosPzzDLxSo7lNPkxEqkdKHax_ntTGBVDlJhiCvCRdUwA7WDol8a2lCgeMXtWLLYhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8cDJpaXh0Qxdr_HpVxue6CVs9M6AHcKdwqI3qCiqiA&oe=6AA81731"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
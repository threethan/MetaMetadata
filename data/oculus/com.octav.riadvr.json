.png", "id": "454532440811338", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_A3nSUc7EQ7kNvwHcqhbK&_nc_oc=AdorY7fxDZYb0-RtEk1SLoIyM7Gif9rMkPRHbPDtOHoUOwSXdo7dnmnwaA82TZMZ56E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCp1ArdC1oSeaLltfiZYd59R2hwTj-NCaqmlBulmbSyg&oe=6A5112A5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdY_B1K4sZYQ7kNvwGMhVxN&_nc_oc=AdryyY8iXcmMvDNYK0CUEkq6u919V8CnquQ_GcCWPWYxEBgIFEJJagv1Y1iGiYCApz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1bG30CLpz8EWqZt5gjDaQT_OPKbgBMlh6H65i1YCHDA&oe=6A510FB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7D6hpWKKUEQ7kNvwEZPb6t&_nc_oc=AdrzwaYEP_Q2l3hLbh7BLpdxp61cFiW5c3a2fvuWsa1W3B4cG0zwIzY2EYRzj6mSjFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCndk49KYS0ErTSdX7lls6Tiz3exnwPzYqNH61uqn3I4Q&oe=6A50EE92"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
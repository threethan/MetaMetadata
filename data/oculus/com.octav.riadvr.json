.png", "id": "454532440811338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYr0y0xXRZEQ7kNvwGfklYd&_nc_oc=AdrDNqkokNJbP5kEys5TnOjTQ3iK99JwHXxHW8bZiwa-BDBakBq5SIeHXhW2rSHZBoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bMRZp8mG5ZMVHvoAvC5Rw_FfknyEi7n0Ldp0rLJPfNQ&oe=69EDF9E5"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF-9IAh2lsUQ7kNvwFDlt_6&_nc_oc=Adpw-ZDIdJarWkPJzEYKagIzEgzXUFr_73TccdQ7txnGxG-FxYl29Uszrc2As_L4LKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nHghLU7p8xa_ub5K1Q3hrVQxlK8pb4tkt9hJxzDi3dA&oe=69EDF6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce7Y_jqH4hgQ7kNvwFvBBqt&_nc_oc=AdrxZS_R-zTPmKf9rmR4BDjMUco8cvS-qszIsR539VR3atP_UPGbNPsyTdyivKjXxVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gKk-U1LIoderhGDrz8JeHkUR0Bi--BQzACHqEs6KdFw&oe=69EE0E12"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
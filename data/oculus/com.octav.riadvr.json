.png", "id": "454532440811338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WwJqL5r0MgQ7kNvwH6jA-u&_nc_oc=AdonJnoPCh-lbSQKYXhJwsE-7S2ua8472LiRdMhcToemk4wlbH_Oe39VCKEAgVQgMHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk463nb2kys4F55kPXYsj_U1GRCsTdPMT-7ijZuDeHiw&oe=6A999525"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCA30le2cMcQ7kNvwFp94hN&_nc_oc=Adp9_C46mPyYhDbvmysfkxdU-Uf1DVI0NniYt8j4KX5hqa1AvJ4N6EOUzIR_BQvOagQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBIqAK51AAafu82NSIxJxI8jUAaDsnjkKqVB_Z9HmYkA&oe=6A999230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "435808435771867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982637_435808439105200_5495729857779919215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v3ju_-83qwQ7kNvwGLPnMX&_nc_oc=AdqKYtZ3Aiaf6-J1RTthFxizz557emJz61JcKpSMP9W492Hr1p5gZTnDJ-j-hhslOQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK5TVPy7gHvcxkaDUz4yLxULjctu730No3V6kU9jAPRA&oe=6A997112"}, "display_name": "Riad VR", "keywords": [], "long_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtual reality. Every element, from the intricate Zellij tilework to the detailed Nekch carvings, has been meticulously recreated to immerse you in Morocco's rich cultural heritage.\n \nExplore the winding corridors and uncover the secrets of traditional Moroccan design, where Islamic geometry beautifully intersects with Moorish elegance. Our immersive experience makes you feel as if you are truly standing in a Moroccan Riad.", "short_description": "Experience the grandeur of a traditional Moroccan Riad in breathtaking virtu
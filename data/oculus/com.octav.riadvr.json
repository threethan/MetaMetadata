jyjA1EC5Lt0KKKohLeWiuQgtEExJtAgdi2yS_e7P3c6nfc0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkKncogAmKWr6Hz-QeluWhy_By-iShXj-cY5hB3VqLoA&oe=69C298AE"}, {"file_name": "RVR_SS_3.png", "id": "445822758423956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75439601_445822761757289_1114144105633065772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBvu7bzvLuMQ7kNvwFbMMtF&_nc_oc=AdoxtcUKvyK9cExnK_wy4vEff1kfXmJ7Y1yjhyy4paCRK1nN78AYayMt3gjGoLFxmPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeDOmwouppcCHj2Vj4JS7iJxx4cNJ97x7XrgvSZVS7MA&oe=69C28751"}, {"file_name": "RVR_SS_5.png", "id": "454532440811338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036696_454532444144671_3989988567041925108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ju7E3KiULMQ7kNvwHKC-Gt&_nc_oc=AdqbLnqE7jQmi7AjPOEyIO5CD9Dep93EdAofVZr6Ox_M260-GZuHTap8AKu00o8BQxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6BA82YBtAnlCHxF82fx_aITjDM6yB4FFnRhqO_MyntQ&oe=69C27865"}, {"file_name": "RVR_SS_4.png", "id": "404346685967036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622012_404346689300369_1924994508341083515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZixXIJ8OTUQ7kNvwEkYC6v&_nc_oc=AdqRtAIU2xBG8_B3EFR4tq7Tsni-YDBXgKe8ZD8Q63gNDrrxfEM1wvPBhXT65MU3WPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2FKyC_v8p6r0I8pdMMgMPlt7VQV1DO-CMOAaEOzz_9g&oe=69C27570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (1).png", "id": "1450814318971629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974448_1450814325638295_2703974088119855249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8KarLhphloQ7kNvwElTra1&_nc_oc=AdqRaERjPI9ON8V7XhCrd6Np41-CFLGSZSD_wyIqpeHltjTT4SDWDhFVI2urDbrAxbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9p75wnouz9r08S26rx6V4PfWXmY3i-nU8dUjSU2vHhw&oe=69C279F1"}, "display_name": "Riad VR", "keywords": ["immersive", "experience", "traditional", "visit", "Travel"], "long_description": "Travel to the enchanting world of a traditional Moroccan Riad with Riad VR! Step through the virtual doors and immerse yourself in the beauty and tranquility of this architectural masterpiece.\nDiscover the hidden details:\nExplore every corner: Wander through the riad's courtyards, admire the tilework and carvings, and soak in the peaceful atmosphere.\nUncover the secrets of design: Learn about the fascinating history and cultural significance of Moroccan architecture and design.\nExperience the ambiance: Feel the serenity of the riad's central fountain and the gentle sounds of traditional music.\n\nDownload Riad VR today and join on a virtual journey to the heart of Morocco!\n", "short_description": "Travel to the tranquility of a traditional Moroccan Riad in VR. Explore its intricate architecture, admire the beautiful tilework, and uncover the secrets of its design. A peaceful virtual journey to the heart of Morocco. \n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20RiadVR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
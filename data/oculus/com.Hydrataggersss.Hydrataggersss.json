dn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfCuxIAyiWMQ7kNvwHpm08a&_nc_oc=Adlviw6RcX6zuY7zCyq8nMnrNp9enAJEozQo7s1YWpYBbOHtQYcS9hzVh7MKhAJ7A80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3bDEvAtMN7wIcoNRIDmChGsfXLAH2YDsknkNQNo5WVw&oe=69B9334E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvS7zRNS0gUQ7kNvwEhJNuQ&_nc_oc=AdmDClDDKmv39w5-rTqCXgI9YtrIhvoG9zKod3hXA578qDi82eCw-sz8XronfMczyiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeclEj0nTtUV7c9O4Gi0m-f1MT8n3RBY59fzZnIo_Mkg&oe=69B933E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer
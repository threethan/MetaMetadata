g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N_6yf61IQMQ7kNvwHvyZGA&_nc_oc=AdmHWlg-S9QG7NN8WwoMFq2m2Yy1ne5kQmx3a_1SDXxWz0bN0Yv2FN0FElkQlqabioY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_1tLO0RQR5ZzB-83E-kd0kZ30c-hnh-nXhLxy3pgX8w&oe=69A2FAAA"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r215HhRJ3x4Q7kNvwHCYccq&_nc_oc=AdkNuNQfuyKpAptgr6sDA_v48f701P-PJvEILqIULcaUFOZlCVh63AGCVBqQAM0VV5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupINmta53uKWZP2mdoPXSglbZbYt8UJX2ZfHrrPtyEeQ&oe=69A2D134"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRsaZqi9_ZQQ7kNvwGSQu_d&_nc_oc=AdkLMhQaVRJKYJDdfNPuv8eAaI47FbVPa0NPzOol2NsNjD5a0_QANIGV67c8HmZa5Fg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdLb4oIIqYdfzawNbX0GIwVPpymBPlscn9kUlHVFfYvA&oe=69A2C9CE"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_0X94NRyqcQ7kNvwHbi8PI&_nc_oc=Adm9GTRBqjhb8CRbc1RldA-EpuW6oDVbQKc1wm0Q7vOwwvLxZZ_VLFQsrpOxDOsuTnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZm7smc1WUJnmrJ4Cac1TjIVH6YNSt81UM8D_TpfOzkg&oe=69A2CA62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_1111200870476433_9167397443673836745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlaIdGWEXdsQ7
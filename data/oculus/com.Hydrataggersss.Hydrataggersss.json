g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N_6yf61IQMQ7kNvwEPrucg&_nc_oc=AdnqAof-rlXbM-a05TPb1OhRpbUK_F3_06AlYDmAsSmP_SliFwT9CAps4KtdwKFeHC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSsuExByX0NyxvtIKrBfJZ8DX4Rsv4T_ThHkwGDVRChg&oe=69A44C2A"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY9VLci732gQ7kNvwGLN8FE&_nc_oc=AdlSQumGVrspDC4X5V1YYQMFPpNmsyh7m_U5Mas4-9mzyOQqJ5Nfpxd9tbNx0RuzXhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvVRpov3ZCcLonh1yXhIGv4gIpiJD_eBYdGF3974EKFQ&oe=69A422B4"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcNTGLhVr7oQ7kNvwFErqyR&_nc_oc=AdkrmgXNjxJ9jJNUOew6cqvUrawL-tQwL5Xso4MYxIIyFfonjE-QblwybkEY9QZMUSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskIVGe2iiNTDSJDxNgsoa6FkF9cYwTaW2Hdg7tL1rxuQ&oe=69A41B4E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_0X94NRyqcQ7kNvwHDLgzH&_nc_oc=AdnQbe_RzWZxsiu_Bs9aNguJzfMUu1jrVyO9h1f_fFv47Sg9R4-C1OqMCHJ4GT8OkRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftugz3uMKAFUrVy28LDrDpi6g4oHLrMv4PEyZ6-e0Gc-A&oe=69A41BE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_1111200870476433_9167397443673836745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlaIdGWEXdsQ7
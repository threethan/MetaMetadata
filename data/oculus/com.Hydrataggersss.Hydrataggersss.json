dn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAs0ygOFznYQ7kNvwHNZd4L&_nc_oc=AdnXP0W41LcI313hf61lbTGdvqTZ533lz0s21X4gE6EyP6WMx7dHWrwpNeIFITRjWHw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHsIDC_OCbSbRFfzECiaWsS3zFHtikCN6kTl92XhHveQ&oe=69BD600E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk79LnagYh8Q7kNvwFKSyjE&_nc_oc=AdlQhS8pdECqJXitKpuCG5E3fytdT_NfnUX-VhYu-pcQJKtPH6ZwjHHv6G10ngSXFyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwkrfj_yLy1Hx8iHiievT3CPvrAosRuV8wF9xSzngcNRQ&oe=69BD60A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer
cdn.com/v/t64.5771-25/75348041_1052673823283350_5995596916799641357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu8ylc2-_lEQ7kNvwE6yhdP&_nc_oc=AdlTMfdAX45k5eGpwwNa1_BiWARyS7QzLVymgF9jlMPgJA9WNhQxYXHJ-TKsEj5HMA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDgcZWvBPhWhlBCdgReAFGAXSxzNb59HvuqiRakrLRbw&oe=69B9642A"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSm-gklfU5EQ7kNvwFPmM4m&_nc_oc=AdmY50b0M0dLAX9jYpIDPWvAc1_imTkexu02UFTN9MaANsgR2ngzhxHhGSO2bKfu6J8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJmQlQoOww-5l5v0LuEitlvNKIAz9sczDm3qMzZqEaGA&oe=69B93AB4"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfCuxIAyiWMQ7kNvwHpm08a&_nc_oc=Adlviw6RcX6zuY7zCyq8nMnrNp9enAJEozQo7s1YWpYBbOHtQYcS9hzVh7MKhAJ7A80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3bDEvAtMN7wIcoNRIDmChGsfXLAH2YDsknkNQNo5WVw&oe=69B9334E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvS7zRNS0gUQ7kNvwEhJNuQ&_nc_oc=AdmDClDDKmv39w5-rTqCXgI9YtrIhvoG9zKod3hXA578qDi82eCw-sz8XronfMczyiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeclEj0nTtUV7c9O4Gi0m-f1MT8n3RBY59fzZnIo_Mkg&oe=69B933E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_111120087047
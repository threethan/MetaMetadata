cdn.com/v/t64.5771-25/75348041_1052673823283350_5995596916799641357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD8wv96Ak2EQ7kNvwEkIEwy&_nc_oc=AdmL5fWEHpu4oezmK75yy-wwo05jrNieFk9UfuJuXfigXriKEiuDwdlFceqOhZR83Hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7xd_PnEqn1xAzlWR5D9k31TFimXn5chwRML6kuMM42g&oe=69BFFBAA"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikzEHPm7OcEQ7kNvwF-PGwE&_nc_oc=AdmzxHzJkHHpMsCbQZQLRBqmGu_PJVZFR0yWpu_BUeOw664pZjA8dNMZanBeMuJFXtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2JUH9bUTSYsPt9E_dXnjL2NhFolkkQQ_VKpdufGUKUg&oe=69BFD234"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDAkAr0FAb4Q7kNvwHydZMj&_nc_oc=AdmVzGDZkpRT9rhCw1I4DhAbDdkTHyW_gJYxpfyAgv2OWHnzMkNP9iTPErx0TAknWwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDCPqbIovkQ9RVLtZ7sGOMv38gEsioScUjMmMEyWEelQ&oe=69BFCACE"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk79LnagYh8Q7kNvwG6MVeQ&_nc_oc=Adm4apO6DbNrd1BmTR9QAlBQB2sKVPP2E_ZkJqhHjL5Yf7KdUcAdE4T_Xp2FXjOziUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTDTLQ-WWeF6djY_NtURrSoBqdLDiS5UxW8yuhrqA7OQ&oe=69BFCB62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_111120087047
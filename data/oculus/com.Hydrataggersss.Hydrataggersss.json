cdn.com/v/t64.5771-25/75348041_1052673823283350_5995596916799641357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD8wv96Ak2EQ7kNvwG2hBhQ&_nc_oc=AdkdwSwn5Qw57tuBUaibdoUVDmCVeMebFpr0CNsR0zk61_u45zywm-OBNZC-bRZDbI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_ksdvaXB5KrU1Y_xuQl4F-G0XTAHSuVliOscejtOpow&oe=69BD58AA"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjqeLaOaBSEQ7kNvwG09kXz&_nc_oc=AdlYZpaS_PYdZzo3W41_VmFyqs_bJKec2jZprZGoFywtS_41YmJbwOJiX7AOPZUxXcM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7Med852V7BtuSh4cgZvFKHRF-lA2qQKNuGif9d3tG2g&oe=69BD2F34"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAs0ygOFznYQ7kNvwHNZd4L&_nc_oc=AdnXP0W41LcI313hf61lbTGdvqTZ533lz0s21X4gE6EyP6WMx7dHWrwpNeIFITRjWHw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHsIDC_OCbSbRFfzECiaWsS3zFHtikCN6kTl92XhHveQ&oe=69BD600E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk79LnagYh8Q7kNvwFKSyjE&_nc_oc=AdlQhS8pdECqJXitKpuCG5E3fytdT_NfnUX-VhYu-pcQJKtPH6ZwjHHv6G10ngSXFyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwkrfj_yLy1Hx8iHiievT3CPvrAosRuV8wF9xSzngcNRQ&oe=69BD60A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_111120087047
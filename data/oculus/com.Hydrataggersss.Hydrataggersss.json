g?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0W6K9dBGEYQ7kNvwHzsDxQ&_nc_oc=Ado-WnJnLDTVKEbeZYPnHYaReKkKO6cXvZUEJyb67d2_ozvm8qxBnwracJGh5O4jSko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0zA5uGffn7MjANdwVMu_lj3C2OpGUTP7t3x9HBQBMK6g&oe=69F0C32A"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5cBD_cCDS4Q7kNvwFvA1oU&_nc_oc=Adr5pUuGlFZjUfsPRDz2_jQv1jafTZ_qOX6TsJ8EJd0fG8NJF5fWfWV9DfYAoHX8-m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Qvzr_eaco6RZClqqFWdBksWCaXoaM7qjKzPOT0bvAcQ&oe=69F0D1F4"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u47DKhS9IJcQ7kNvwGtofyE&_nc_oc=AdprvuFYBAIhbGOFRQZ5JxsyYRa0LJSkh_r_clDH8pluuSNP1C4HhWXp_6I-X-A2dTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3E6MJSDmIsLMGQSTVmf_Gnna260DiIm_E_DhvFhvomLg&oe=69F0CA8E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCsKUW0wAfkQ7kNvwEyYDA5&_nc_oc=AdrJroPIPpBVd3tbaJRcLCVNzJ3XjCi6IUK4qH0AkI0VJJdkGrLZvDDR_73gANPT4WQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0B_42DY1x5d6XJNkDg2JFu_ujjGSPeWDeTNCDQCUC5ZQ&oe=69F0CB22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_1111200870476433_9167397443673836745_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT4_6yTRAtAQ7
7", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75348041_1052673823283350_5995596916799641357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93tRGhGa-xMQ7kNvwG699rd&_nc_oc=Adp9f9PI5gDZ-6p26rP6ZAh3pQu8mNXy04FIjD7hAFLNbRBOmEMkqL4GOUSNF6alS90&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeuUuBO9KdQ_urvch1SwQIk0WW4RpisgPLOZgH5WSSJQ&oe=6AA40F2A"}, {"file_name": "mage-2560x1440.png", "id": "969151595057545", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031456_969151598390878_9168832796128073572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfi1-iiCbcUQ7kNvwE8EjKM&_nc_oc=Adp1VxKG84helq3Bg6VgK45COywuwissomGFlL6VlGLF7n3KHHk8BaqCRbDLjiRptsg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKslHx8uNMNqFj9aezZmrAIDNITxt8pfnvmxIxyB1Lxew&oe=6AA41DF4"}, {"file_name": "GAME-2560x1440.png", "id": "942403334223116", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391899_942403337556449_690308191559525843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqrfu5Zj-KEQ7kNvwGua4dr&_nc_oc=AdrL4g8Ydk3goRSYG-8q0WI_YP2aheZGKXNIJ4Pb7KSchLB4krUv8bwiobL5ECCWcbQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-d5GqU1Xb19HOR6tAVSPcJjLbdUOPBDtGg0BqRskk1w&oe=6AA4168E"}, {"file_name": "image-2560x1440.png", "id": "903386658282953", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_903386661616286_6268115176619886869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkLUH-kxwNsQ7kNvwE_Luho&_nc_oc=AdpE9n9pLFM2Av_U5haIMJkccnjrkeuMb9mVpMw8kC_EX9Z-2S-8Y33wmkIYsuJZoEs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU9bFLg_R8UzWhAiC0BZv8i2jynrU5Fy7bupDjIqMDgQ&oe=6AA41722"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hydrataggersss", "keywords": [], "long_description": "In Hydrataggersss, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, Hydrataggersss offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets Hydrataggersss apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to Hydrataggersss, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become Hydrataggersss, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/hydrataggings/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8801340316586053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
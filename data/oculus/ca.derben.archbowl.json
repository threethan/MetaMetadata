OyCCD2YXLY1eYLlFVISa3z_TYQA3Sgmdzt7no&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qVw2-TjNlpwnZHfSIXgGLKvTfDUrtra3zQDiyCa76UA&oe=69E75CBB"}, {"file_name": "meta01.png", "id": "935352039046546", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299051_935352042379879_6230162766358039077_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq3Qi58zeo8Q7kNvwGzFhj6&_nc_oc=AdrI1397xL4Eu2KJZ3nWzlLYxVXPv0vz-xO4958c8l8K4qvLMfA500CbufWuMRDsmKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09_AkWM5D2aCaPwpjCMLsurxgf7TtOTuiiKl4Nw80ZiQ&oe=69E7707D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArchBowlAR", "keywords": ["archery", "bowling", "ar", "derben"], "long_description": "# Turn your space into your personal sports arena.\n\nWhether you're in your living room, backyard or at the park, ArchBowlAR brings authentic bowling and archery mechanics into your real-world space. Fully offline, no setup required, just open the game and play. This is an AR (Augmented Reality) game, it's like having an archery range or bowling lane anywhere you like!\n\n\n**Bowling**\n\n Designed for natural, standing play. There are different pin configurations; 5V pin, 9 diamond, 10, 15 and 21 triangle. Currently everything is scored the same, all pins down is a strike or spare.\n\n**Controls:** Simply grab the ball with the trigger and bowl just like you would on a real lane.\n\n\n**Archery**\n\n A flexible experience for any environment. Options include; target distance, target movement, a bow hud and visible arrow paths.\n\n**Sitting or Standing:** Most target modes work perfectly while seated. Use 180\u00b0 or 360\u00b0 modes for a more active, standing challenge.\n\n**Controls:** Grip spawns your bow; the trigger spawns your arrows. To fire an arrow, move your hands apart to reach for one, pull trigger, then bring your hands together to nock. Pull back and release the trigger to take your shot.\n\n# Pro Tips for the Best Experience\n\n**Safety First:** For the health of your headset lenses and camera sensors, please avoid playing in direct sunlight.\n\n**Privacy:** This app requires camera access to function, but it does not record or store your video feed.\n", "short_description": "A simple AR Archery and Bowling game. Fully offline, so go play outside or stay inside. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://derben.ca/ArchBowlAR/pp.htm", "developer_terms_of_service_url": null, "publisher_name": "DBScorpion", "support_website_url": null, "website_url": "https://derben.ca/ArchBowlAR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25759088053723597"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1401416604714278"}]}, "baseline_offer": {"id": "1401416604714278"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773941160, "status": "PUBLISHED", "id": "1401416604714278"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26416893451276384", "version": "0.9.14"}, "id": "758280046753578", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25759
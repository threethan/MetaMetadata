-ord5-1.oculuscdn.com&oh=00_AftRdskLmamiPhmZqgNOmdhofHzzn248omXGr7NzbVkC3A&oe=69A4247D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH5Cli0xqnIQ7kNvwHfaumO&_nc_oc=Adlr7wlK7UKD-1FFK729cjILVGX8TtJAO4A3OkpFSPsY74LyLYAy8jAQRwJHXQnOhUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu9t8uvLw2o5-vPoh48-BBXvpPwVRbXt3PNPHSNhybUjA&oe=69A4440A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgvcWqFoUugQ7kNvwG3mh3k&_nc_oc=Adl_OQrXoa85mH4gVsMNRmc_cASs_H5MBwPDcLsv4gv42DvJi384Sia8D8Za8kh_49Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuJKvYSiFfya-L2H_ccEc_4CX0mCjqlDdRSq_LSfrjlvQ&oe=69A42767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxq7P9oZ2T8Q7kNvwEhjQqc&_nc_oc=AdlzRDlC9-3I7alYqSes3nwb0KnsHKrdEcV27_cwVHYw9jGsxHuDwRdOd_clOG7SOV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfusZdpjeLufQgp5ZKImu_onAkyh13_heOtn4BsGsQp4Gw&oe=69A446FE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_quqvmH--kQ7kNvwGRN7WL&_nc_oc=AdlnMZQVolHGgYE0b34KxRrcqc6kSV4zbvPAe3No0V787cU370wu-8UiZxl2mY4Fwgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft4VhqHeAMNFwJ59LSwak2jogN_QoYvc5CCowIeMy3k0A&oe=69A44B0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "P
nlvZoQ7kNvwHWoUIO&_nc_oc=AdoSfHB9GsW-pton75sRjJDT5JpR2bApVviDdShqyMjLu7mC1JIKfUM8waVb4pPiR5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbfLNmf5DbzPyEUfU8oU45hxbHvMX9mwRywk_8Iq330Q&oe=6A4BCB3D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ErfcgOSn8EQ7kNvwHjz7eC&_nc_oc=Adpv1Erh1Vd9rc0wfUc5WEvA6gHmvPI8UfxoI1tb3RzRm0fyiJaaZ3hqaTaZSCtw6RA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMOpszJ9ZVMe6pO3pd-9zQPFdL-PbV5zTzFWxUqOn9CQ&oe=6A4BB28A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfm-xc1eXhcQ7kNvwFwBg-U&_nc_oc=AdrXC9BdEIqTjeP3cbGztBoWS4wSTgozx0m7uOMY7qcpOpNsMhGIoVSMkFb1BAqK4SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYhASbI2ytU4sNUXN-5LhXdYyLxT_TW2TcfCmlFTXIUQ&oe=6A4BCE27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7ELpp9KOWUQ7kNvwGsaik3&_nc_oc=AdrUynC3zv4LNPEX_U8fzZpQL0vpnc6ZJvjJKiXHbCmUYi7kLys90an7irRTGIBjW1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABLpI7SDMbl7Pfhdw6Vp1YtxMxL4GDSJPbcvNa9g0cgQ&oe=6A4BB57E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma4hF6qdQwkQ7kNvwEeUDjQ&_nc_oc=Adoc27rwr2lJrtG6mkF9LEr8pPw3XP3ecjKH7W3ebTchOzBNbCbryCNMtC8fDG3xzpo&_nc_zt=3&_nc_ht=scontent-iad3-2.o
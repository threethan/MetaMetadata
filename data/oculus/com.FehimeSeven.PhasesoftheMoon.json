-iad3-1.oculuscdn.com&oh=00_Af0P0dbohJ9mDT6bfM3CPYKTc0qNKjXiZIFaxWNd-vS7UA&oe=69F09B7D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCPgi5btf4MQ7kNvwGwkyQG&_nc_oc=AdrBP0H_L4tN8CRN3rlgODFZVPKIK2d_RACPtNsDX7GYMm17u9GQ89qzQBoD4rd9m-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0fC6wJNzYrccPFbrwSQWqOduQIpjiImJOV6tfEjp4YFA&oe=69F0BB0A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiNB0JOkF5YQ7kNvwEpjZ7Y&_nc_oc=AdoAjYFu0GAMCWQIIxoLR8gbVMoCfcNtAF2ogyEG_ObvGFgK2W5MUgPGGGjZbxrzcb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3BLLLjjHri6ciptqFWkkDBOeqzgC2M9xUCzaJbEyz6rQ&oe=69F09E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79p7sZv-aqcQ7kNvwF-vXFs&_nc_oc=AdoINhKdgBRRuJ1d5W_GToZ6-2E-RCPZxQkwQ0eS_-MMUK56-JQrY__i1TP44i3xj7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2VF1-s8UnBj5taqMQg27LAtNiZhdA9Re2pfXMgbs8_Sg&oe=69F0BDFE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiokitfGgGwQ7kNvwEDokZc&_nc_oc=Adq5oEgbE4MBxPl50csCY81WeRrOf3FuSM1xw6FsmOwpJKtJ3hH629G2Vadg11HuYjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1DsblMVus4yvEy8CiUvXPJd8lOGcfYoclfhhVOD1wBaQ&oe=69F0C20B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "P
-iad3-1.oculuscdn.com&oh=00_AfuFHreX_wK_1iQGlhqva0g99lh3VwQl-YKnkaSBkxuaow&oe=6999987D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mDR7OzuaYcQ7kNvwG8QtgN&_nc_oc=AdnIMYgG9dOwc8fLcxZLu6tj5FPwg8W-aQHLowd03Ffe4CAjkOMfJAaHShtmQH2wmVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumOcfBrMu9zac-9PSUH29a7vgjwToa-VqdliEAaoXcrQ&oe=6999B80A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5dL5XL8JV0Q7kNvwFHmdDA&_nc_oc=AdkXx5NrlG-AxKChf5DXhbLXbmF7ciONVoRrKR2wvJ3LLrYbip0UCEUI9ntK2UuVrNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv21J6n5D3uowPa8UYf4hOUyFS3791odp7Vf8dIsLucew&oe=69999B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dREW3qz1-mwQ7kNvwHRsw5L&_nc_oc=Adkp44xs5reD3hb1ZnJPHGlSB7qbVMxI6TI4cpFZoJFPvCusv4SuqAJafp3w5Rzc_ZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6c2LtMb6UGb9ddHBQzzaWX4ryunpcUrfQOFBs3Jkr-A&oe=6999BAFE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMHkWXlGk8kQ7kNvwGbUDrg&_nc_oc=AdlHXRbwSQEIuSV3T529JRBb16JeD6SufXu2S4mdjWg01ifMgVPfsPNvCTb6HTPWCrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6kXzIHEN_qRqgOmyZAUXVC6FLlJ2cao0500qj5GY0sg&oe=6999BF0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "P
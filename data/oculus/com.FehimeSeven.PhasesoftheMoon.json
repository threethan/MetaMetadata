-mWb4Q7kNvwHWstit&_nc_oc=AdrqFDV13ior95a5ucj-r0XbQHAhp3sV9GBC3C8QHt20rRCX2oB1JNEWOtPwJRgVWU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3idAFZ5y2X8jJC8HJTpnyH7xA2X9OOk48wDTU36s8RBw&oe=69DA31FD"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdI_3BgiF7MQ7kNvwGO0Zh1&_nc_oc=AdrK5nb_BdkqubfSW2GB0W0cYf3d04qtX9x28xJ-fLq0jNUEW8f9ygTv9Ysa_a-iZFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35_Z9AeWD8Uz-q8ksnf85P4pGP80eJu4cfmZIm4Zkdog&oe=69DA518A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNrLA_bgx8EQ7kNvwFsVFtO&_nc_oc=AdoXu3F2Q1hN3eObaIVgjVbcje4tsDt7c1UDApdFNBV0TVqkD4-yeIyr3Cz-TswIpYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i_AH_-E737cE8JN89CKaew4CBuJI0YJMoAk9leWqWOQ&oe=69DA34E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdC_a0u9oJMQ7kNvwHHodX5&_nc_oc=AdotpH8UJB4mS9-WfucUUApGYtxzZ4t8-9d-c1lvqxYG_sLwRoJnuscZp8b5Q6bYuX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14vxRCMMAD2LrnHcs1NFG-J4Pcm98Y9cTW4tKcUwGDnw&oe=69DA547E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyLblCos6YEQ7kNvwESnlQI&_nc_oc=AdqrRFI0yX7fIgO9OEE0u-aXVoc4xAR00MQ81ibqSCQqUkRZ2CWI8DZvhl4hi7Th4zc&_nc_zt=3&_nc_ht=scontent-ams2-1.o
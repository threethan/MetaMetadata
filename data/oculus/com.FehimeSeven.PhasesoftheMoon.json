, "id": "2531002780378848", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2YcEz5ffdYQ7kNvwFYR2zW&_nc_oc=AdptbOA8qvsXkLO03pczss7IP396JEwgiWDG0HM9BsiROewgIkZEt3gxlyqI_DV4vp4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED9EoSOYRmtqTnP1vXdOptPOxM9AomjArHIXnJMomKVg&oe=6A8597E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRL5JxKJSiQQ7kNvwHwOevv&_nc_oc=AdrB3_7hBNC-Ggpkgga_9Isl194jmQ6rcy1SWwUWQ7SpZklvhsELMwk3Xiy6Q2wiW5c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM81CCvtcmp7WV280QnhJOkXY3kMyRsaieMBViUprA6A&oe=6A857F3E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "http://phasesofthemoon.net/", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "http://phasesofthemoon.net/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "363137355242770"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "286423116478571"}]}, "baseline_offer": {"id": "286423116478571"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1620769860, "status": "PUBLISHED", "id": "286423116478571"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3872262362891894", "version": "1.0"}, "id": "954091175351124", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3655578624560270", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3872262362891894"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "954091175351124"}]}, "change_log": null, "created_date": 1620394017, "id": "3872262362891894", "version": "1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", 
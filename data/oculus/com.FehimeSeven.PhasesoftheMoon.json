BJUigQ7kNvwFDhw0H&_nc_oc=Adpj9K8eKMoJgdMjGtLjQ3dcub1dwavuJcooO0tF7ukhw8TSMAQBukVQd_tr80GaAj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41ewQG0P3Zb8o_BSx32GFZYx81o5fTn6NbFetAJ4QqaA&oe=6A1DA6BD"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDKuSkC559wQ7kNvwFEXsoj&_nc_oc=AdqV_Hk0Ixu7Z_GXes_A3kIAzw8kqJ7iNdozlyiQahoYg0IwMVivSXLvfmaRrTExGKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HCQ_-57gkKWda5iDL5NaMvb5R8qpnxBMjDHrcsWU1Gg&oe=6A1D8E0A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X7d2qNa1iIQ7kNvwH4o4oB&_nc_oc=AdotmLqi_T8aRgDhzJBv6QKBcx45nC7CVSHZ03IgN8SWCF-5tQ5SCjtF27o9x9fXJvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x4IJqDgxPSUfLfuffkcyAeoqAZIhzX6EcAVG44a2pkw&oe=6A1DA9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=856B0cinyWoQ7kNvwGnO-Yj&_nc_oc=Adr2Ip68a3A_t-r1sT0GGOuYSBAOjm5_YW0O_jahu2YjMY_wm3gPDbaRsiQItDCg_q0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r2iFIqQ7ihZFWPeiMW3DxYfjnUSTOLIMxcLoRx9nnMA&oe=6A1D90FE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pydO2nhstmIQ7kNvwGZlbFy&_nc_oc=AdqJfksTZ45AMFOE5CDEsNvbOHngZsoxNfjBr_aAtTFxF56P2tx9kpnUcRvqVVak9RY&_nc_zt=3&_nc_ht=scontent-ord5-2.o
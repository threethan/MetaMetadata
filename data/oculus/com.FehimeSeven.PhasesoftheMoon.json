-hkg1-1.oculuscdn.com&oh=00_Afs5tHX9pwLFkI8CwXHO_CucMYvAmGdlYZ_h5kigXuGAig&oe=69A1817D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIbdmp0byCwQ7kNvwEv_tef&_nc_oc=AdnJUhCsZzzzP1SQbVexUra6frpt-PP9DL2jlGpCMTKI8xXei080L0N2wTqxvXTBfUA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft2_XRbeFOI3obX5r0-8V4gQ1EvzkQlz6Nax9VU0AWKoA&oe=69A1A10A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKAMKVwH0h0Q7kNvwGLD7Tr&_nc_oc=AdmhJgmicz3j2NVRIevPwLTmFnea-BaVkFc8ghiZrqNPBJcFjflHM8dSWwOH-VLtRjU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftB38vgNT5a99_pxP_He8xDoUmhwVJL8gbWDJphgtCi7A&oe=69A18467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxq7P9oZ2T8Q7kNvwHg-WgK&_nc_oc=AdmKQqmvbNk-pZ9zKjzX7mrkUNEBcj4CCe95I9TCUZ1u8i134ZvpazKWjVKSH4HrFH8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu32XsdIWuEXSWGddBMsqrxKFf_36Bs6GSaGPEO-awopA&oe=69A1A3FE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEeatiJGGEsQ7kNvwF85o2T&_nc_oc=AdllFiMGlU9vCO0QjYtLM57k6RYgInocMDJzLTWi_T28fos4LVjkeogpPDuGgh-vZVk&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvYeozIrXSzODk_tGtno-x2xcMfzIg5Z5bRrIou2oBdzA&oe=69A1A80B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "P
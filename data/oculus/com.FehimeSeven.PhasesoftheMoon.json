QnE80Q7kNvwHWK7Tn&_nc_oc=AdpmI135J5RqGustPM_GdyQ1K-i3UAdmhkBLUpQb1TPyRb3cJ9ofAhmZWlRW29lv_oM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0AX4hxRFL0NE8yOqoBqhnA-aL8eIY91LdPJyjcKsvLA&oe=6A6F2B7D"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9M98s1WReAQ7kNvwER94-j&_nc_oc=AdpTcQI3-yzhyjjvyeEPgBXRvVTuwmkR9TjM86p74UefYjaXu7675ksBZrRiBMo0XzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPBTxSq_DNvnbMHkqTdrcmZjCVFHPzXskFcTEjVp4AxQ&oe=6A6F4B0A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-zCt1krKRYQ7kNvwHB6PDd&_nc_oc=AdqUZBfJA6J6Y96SGJ_KXFgLwvwwXvQsyfDvCAsw0DQ5JS4k5t3T_ENQVPH5Pi_Qkw0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu7WEBxZ1J6LFRSgKqYxx0nvbvtUwnEGnc7-gsZ0Q_6A&oe=6A6F2E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF1_FePVobkQ7kNvwHlmeg-&_nc_oc=AdpiSlsnMDI036b7slfZcAW-hjQwTP7UB7uPno74RiV64qHJyaOmBdXn9W_GlUBnQk0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsLtMy4XuqWnRv4TPFtKMpwoDSy2o6vFi0O1hFaOz9Vg&oe=6A6F4DFE"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbHBmIJiRGAQ7kNvwFvnkW3&_nc_oc=AdrM8yzamibAAklRYeD8MveI_IZuyxWppv80xI-jfMLi2MZUwZLeQyapRu-1zuI18G8&_nc_zt=3&_nc_ht=scontent-atl3-3.o
-iad3-1.oculuscdn.com&oh=00_AfsCoMx6_6xq0LbvldQzPGs3WTiUiOLZhoi_H5P2cQiLlg&oe=699D8CFD"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aw5jSw_UUEQ7kNvwGudntF&_nc_oc=AdmSUABBEr3O4wfSDZFET9SUhTy4n8JIWXORK8-qZJO9iB_tsc5yopparTYVL6Cdk94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJTkfJ8AzgH8Y2yf2eMiHYmEmfiblKpPxmiQNTjQkpZg&oe=699DAC8A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5D9QKML4EQQ7kNvwEjji2C&_nc_oc=AdlkKKeJJI81p-so1JMwb34U6cU7EhV1ZwxJyETDBa9j7POEszmP1N308upcAZ1r39w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPtWVNBdynEpKVRfc_EE4d5AQpunZ_e9oS1kacsfF8cg&oe=699D8FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V0Cjgu6HxIQ7kNvwGQwey0&_nc_oc=Adn5cjZgkYbh9LP1y8DjNgk2-EAPnok2eX6HD-EyinXsQ3S0tgeBrHEbxdVrFgeWExg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4tzhbAQu9QlfdUUgnjX-xJXv-vZm-bY46JFW4y4vhlQ&oe=699DAF7E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6DYIqfGMeEQ7kNvwFTEoNm&_nc_oc=AdkeX_HUpvP33gxB8nMCfZxNhv8YwpxAoE6H9lWC4m4Q1Qqgbfv5uqGqj076L-chFWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_LV3lL01rjO9KjtyFbY4or-EsIQc_x4v57JkugALtGg&oe=699DB38B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "P
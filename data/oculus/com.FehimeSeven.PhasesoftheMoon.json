GtXrAQ7kNvwGegzIv&_nc_oc=Adoviv68PIZSccjVZqJOsa9lt5bVqFWpNQ3S-BOY678C6J0G_78cnwenELy6mAzq4RQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREskuWsIq5JoqSYfwmn1EffopbA4GdiWHeSgC033njRw&oe=6AF339BD"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_0yh_DSeT8Q7kNvwHT0Dzn&_nc_oc=AdqB3l2jW01ZX9Axq6BCGTd4_J0ZgHDAi6nFIdnDWoh7IL8FgFGGcCN7qlVtF_TOk5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT88IGCE5MzS8kXgvDu1r4NUbyldSs1MEpak-7E7aoGGw&oe=6AF3594A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPlsfSo-dNQQ7kNvwFBrhOX&_nc_oc=AdrNwx5LCb6YvJ8zTHBUadfUuVgtHrJFs646sl6V7Sz9-hfwq91w_rzK0bVyFoLkFhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtl4ZNvGhzaIz3H3vn_p0mur4MAKDjdvaXQJzZKpf8DQ&oe=6AF33CA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2788T_EfYgQ7kNvwETsUw5&_nc_oc=AdoAaX30knrxtgFFMhUA7YqvMQ3OlJzSIK0hbB9X2RrCrDpNyxGB6-H_rh1vCKUM87E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTbKHpCGNeDxa1HgQOmLCww_42VYVaagfufhdnTp9SjQ&oe=6AF35C3E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmXCknGlW5YQ7kNvwEF6IH8&_nc_oc=AdrqDQw-gYNNnDLNYYYLrqXE_wmEKlw_rZgzGm5jrHhpxXZxF_V2ABoLJ5KCIVMSTFM&_nc_zt=3&_nc_ht=scontent-sea5-1.o
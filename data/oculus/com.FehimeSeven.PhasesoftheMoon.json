5SwoaxKcWVIDXKrzxnFZ0L0csyP5l3F_YPz3A0q6usX3d3rF85ZYnL7Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZZUyL18ebaYBkMCUVee1yUKtTxDcOIYZqEEEUrs8BUg&oe=69BD30FD"}, {"file_name": "4.png", "id": "249017406900660", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_249017410233993_2774128290114664944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MizVHF5wtYQ7kNvwGNkCrx&_nc_oc=AdmMOqtnXK-1Q5_8XRsv_q2xMZ2hew-I33XI5sQIfJDypOS74XIs_50bgyyQMW2aRIw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkFh6d3kFEL4BZjB7Xp6hMSTrxtY9NIfeIs3agUeexqQ&oe=69BD508A"}, {"file_name": "5.png", "id": "2531002780378848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_2531002783712181_7475396004841822323_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDiQYgep45UQ7kNvwHC4kbC&_nc_oc=Adn-t-LFwepuUJo7PqENxNmuQ8gfA_S64gIvent-SiZwIm6xNf2jhkdu3fPJvzmxEcU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuSooq8Kn8JBtlrm1EmNAAGisj-Yh4skAhYr5o3IeX_g&oe=69BD33E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "4146366052093130", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982526_4146366055426463_1932917196235881614_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A81Ei2OFQIsQ7kNvwHQXU0q&_nc_oc=Adk8IVAbKIQ_ny4AZPJxKG9R9F5KDAwjnbcyn-N82-4iNcCjJcy7QWoYzogcsWioSDc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVfKdg97wIMhCSfdtt_X3jwx5I3mytMBIKVK1_J3KrxA&oe=69BD537E"}, "display_name": "Phases of the Moon", "keywords": [], "long_description": "Phases of the Moon is a three-dimensional poem that you fly through in order to read. It is not an ordinary text, but a place that you visit and quickly get lost in. \n\nThe narrative revolves around a toxic love story told through 60 chapters or 'phases', which intertwine in a cloud of text strings. As the reader and protagonist move closer to the center and ending of the text, its poetic statements crisscross and fuse into a chaotic conclusion.\n\nThe full journey is 20 minutes.\n\nINSTRUCTIONS:\n\u2022 Hold the trigger buttons to fly\n\u2022 Control the speed by bending and stretching your arms\n\u2022 You can fly with just a single controller - or both for maximum speed\n\u2022 In the menu you can access the chapter index, switch the color and more\n", "short_description": "Experience a unique form of literature: a three-dimensional poem that you fly through in order to read. Get lost in the landscape of a toxic love story."}]}, "developer_name": "Simon Theis Hansen", "developer_privacy_policy_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Simon Theis Hansen", "support_website_url": null, "website_url": "https://sites.google.com/view/phasesofthemoon-privacypolicy", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235763147070315"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230051_2951226471867775_601225621071352975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDsj4UrS2r8Q7kNvwHgnQfy&_nc_oc=AdlgEbJiyDR8EM3UXAAIoHh2S9ujCCPHTz-WkTsAjrgCDxkG419pLYQznRtfEO1k8gw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMUWo6UJgXvHWfTtbllXTx
40_2026-06-11_10-28-07.png", "id": "1374923021148990", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827987_1374923024482323_3196498699362125637_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2bh2S-yEH8Q7kNvwHIvd8d&_nc_oc=AdpVVosTEE9JK8aR-ZYcLyfKS4Onl_3oBXY4qMMsNG83iwMcYiywB0VyVn34-R4PsUo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6wHsaHpkhi3YLjgB7Ai2yHTzzOcvGGT5eMpOcsOQvJA&oe=6A93FBBA"}, {"file_name": "screenshot_2560x1440_2026-06-11_10-27-46.png", "id": "1273360347925046", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823351_1273360351258379_5685818974515252570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssiZTv3ycTUQ7kNvwHFHPoY&_nc_oc=AdojoUlOrZ8jxvhtTKgZ2UW9yRa_orDyXanA2EnY48P3-mPXakzErjNU_lwpJieIMVk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkjhc3cN9vt3NLqQsDUyuuKLlcGNOU1tkPUNZsA1qOuQ&oe=6A940A94"}, {"file_name": "screenshot_2560x1440_2026-06-11_10-27-27.png", "id": "1810534509920539", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823341_1810534516587205_2780471838654548872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnqhlvIIoP0Q7kNvwFjkEaz&_nc_oc=Adq-ejuhQmefmuhctL4CY2YdOu0FIa5K1XztjAo9VmsbSFNFRFa7CpMwPA74WirBW1E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Iaqyw5Yco3vtE7XakXZSJbqWy-47Y2S7tpt8wqKF9w&oe=6A94178B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Detention Monkeys VR", "keywords": ["school", "bully", "monkey", "detention"], "long_description": "Detention Monkeys is a chaotic Social VR school playground where you pull pranks, cause trouble, get chased by seniors, and try not to get sent to detention.\n\nJoin the Community => [Discord Link]\n\n# PULL PRANKS IN VR\n\nUse prank tools, mess with friends, and create funny schoolyard moments across the playground.\n\n{27181827524803180}\n\n# GET CHASED BY Mr. DETENTION\n\nCausing too much trouble, and Mr. Detention will notice you. Run, climb, hide, or escape before he catches you.\n\n# SURVIVE DETENTION\n\nGet busted, serve your time, and jump back into the schoolyard to cause chaos again.\n\n# BECOME THE BIGGEST TROUBLEMAKER\n\nRaise your status, create funny moments, hang out with friends, and become the player everyone remembers.\n\nCause trouble. Get noticed. Escape seniors. Avoid detention.\n", "short_description": "\ud83d\udc12 Monkey school chaos in VR\n\ud83c\udf4c Prank. Run. Escape DETENTION!\n\nMOST IMPORTANTLY, build your reputation as the biggest troublemaker in school..."}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://sites.google.com/view/detention-monkeys/home", "developer_terms_of_service_url": null, "publisher_name": "AshRift Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/detention-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27067625749573606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824328_775194778952197_6454498307336014996_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sn5qSzwZhykQ7kNvwE1z6IP&_nc_oc=Adqr7evdFPdxRkpII1rJO0T0GQ_JUyJFknfZM8rDp7-jFl_Tl_0skVDrLHZgICCC-DE&_nc_zt=3&_nc_ht=scontent-qro1-1.ocu
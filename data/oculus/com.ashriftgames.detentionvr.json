40_2026-06-11_10-28-07.png", "id": "1374923021148990", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827987_1374923024482323_3196498699362125637_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIbF5w4awtEQ7kNvwFBWHMM&_nc_oc=AdrhXn7rD3wOcb7uAtG8oWGP1551DNXhrMfaArKFjYjmj6fpWw8y-FddwvuKPE1opQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfcqBIE1xDN-m8UqhndG81KK5XWjgjtTDZEMty7HBMqA&oe=6AA162FA"}, {"file_name": "screenshot_2560x1440_2026-06-11_10-27-46.png", "id": "1273360347925046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_1273360351258379_5685818974515252570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPkJ_4agAe8Q7kNvwFSnmtq&_nc_oc=Adq9R5c1vsmJxIAS7W9DtSjpqyuHDoHZPZsMrb3itWqEYLKByJFpgwMnzvrYRPFcAhI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGmZLjWwfNos8q7nGIhfaF_HQW_QYsm7igpw7O35dERQ&oe=6AA171D4"}, {"file_name": "screenshot_2560x1440_2026-06-11_10-27-27.png", "id": "1810534509920539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_1810534516587205_2780471838654548872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2GO855Al38Q7kNvwFG4VPD&_nc_oc=AdoCUdTfZgqRXujGiLGK5_x7NnCcNfbpVoYSbTQZz3TFyFfFDox8xSx1RsY1_E8F_KM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxAYtgcrP3_MmJD79-cGVvpOpeYEavY_kIaeUeQBANFw&oe=6AA17ECB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Detention Monkeys VR", "keywords": ["school", "bully", "monkey", "detention"], "long_description": "Detention Monkeys is a chaotic Social VR school playground where you pull pranks, cause trouble, get chased by seniors, and try not to get sent to detention.\n\nJoin the Community => [Discord Link]\n\n# PULL PRANKS IN VR\n\nUse prank tools, mess with friends, and create funny schoolyard moments across the playground.\n\n{27181827524803180}\n\n# GET CHASED BY Mr. DETENTION\n\nCausing too much trouble, and Mr. Detention will notice you. Run, climb, hide, or escape before he catches you.\n\n# SURVIVE DETENTION\n\nGet busted, serve your time, and jump back into the schoolyard to cause chaos again.\n\n# BECOME THE BIGGEST TROUBLEMAKER\n\nRaise your status, create funny moments, hang out with friends, and become the player everyone remembers.\n\nCause trouble. Get noticed. Escape seniors. Avoid detention.\n", "short_description": "\ud83d\udc12 Monkey school chaos in VR\n\ud83c\udf4c Prank. Run. Escape DETENTION!\n\nMOST IMPORTANTLY, build your reputation as the biggest troublemaker in school..."}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://sites.google.com/view/detention-monkeys/home", "developer_terms_of_service_url": null, "publisher_name": "AshRift Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/detention-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27067625749573606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824328_775194778952197_6454498307336014996_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdBnCXDTRlwQ7kNvwFUNNge&_nc_oc=AdqTLQMvjmOmK5QJJXb6PQU2jg85OZhoSRCPBnVEtNBr1D0ZVYLXy_AckDwaTjh9PoY&_nc_zt=3&_nc_ht=scontent-lga3-1.ocu
16587205_2780471838654548872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnqhlvIIoP0Q7kNvwFjkEaz&_nc_oc=Adq-ejuhQmefmuhctL4CY2YdOu0FIa5K1XztjAo9VmsbSFNFRFa7CpMwPA74WirBW1E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Iaqyw5Yco3vtE7XakXZSJbqWy-47Y2S7tpt8wqKF9w&oe=6A94178B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Detention Monkeys VR", "keywords": ["school", "bully", "monkey", "detention"], "long_description": "Detention Monkeys is a chaotic Social VR school playground where you pull pranks, cause trouble, get chased by seniors, and try not to get sent to detention.\n\nJoin the Community => [Discord Link]\n\n# PULL PRANKS IN VR\n\nUse prank tools, mess with friends, and create funny schoolyard moments across the playground.\n\n{27181827524803180}\n\n# GET CHASED BY Mr. DETENTION\n\nCausing too much trouble, and Mr. Detention will notice you. Run, climb, hide, or escape before he catches you.\n\n# SURVIVE DETENTION\n\nGet busted, serve your time, and jump back into the schoolyard to cause chaos again.\n\n# BECOME THE BIGGEST TROUBLEMAKER\n\nRaise your status, create funny moments, hang out with friends, and become the player everyone remembers.\n\nCause trouble. Get noticed. Escape seniors. Avoid detention.\n", "short_description": "\ud83d\udc12 Monkey school chaos in VR\n\ud83c\udf4c Prank. Run. Escape DETENTION!\n\nMOST IMPORTANTLY, build your reputation as the biggest troublemaker in school..."}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://sites.google.com/view/detention-monkeys/home", "developer_terms_of_service_url": null, "publisher_name": "AshRift Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/detention-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
a5-1.oculuscdn.com/v/t64.5771-25/878748596_28899433476372670_8918504042190431498_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tap4alSr4fkQ7kNvwH3j9Xs&_nc_oc=Adp3WdqshY6ya-qnFifIJy-dBIUNG4Z_3j0uW2w5XJ9KHb866iASorHJzWihCUNSC7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXzSrdaN26kWRij-mU7UOPvc7pc1I-RWjBnlayPCXmag&oe=6AFC7B47"}, {"file_name": "DM_Screenshot_4_School_Gate_2560x1440.png", "id": "1462013789227524", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596168449_1462013795894190_846166484100685217_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpvtQdG-xIIQ7kNvwG16enE&_nc_oc=AdoygJ6XZ6NvPqLIMCwiUW4ysSjC97hrbw0fAWLoXdSInoDdtMuALFh0rv517qb9Vzo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkwZTBiA7CeUEEginCaHwPw8vOYd-IGNuEWTpKAe60Jg&oe=6AFC8DCE"}, {"file_name": "DM_Screenshot_7_Music_Classroom_2560x1440.png", "id": "914833218264233", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_914833224930899_4163764064277050460_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T_RHVKfJQ0Q7kNvwGsref7&_nc_oc=Adp2dB8rw6F50U-W72CpOwLvQhvGUrsY7tBETlq7Q1iS6MFHApT1cvjby73sBxWzFiA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuE4FuLq-zoL9BxczwuXnE4qz491PQzKpbQ-MITFMVxA&oe=6AFC6022"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Detention Monkeys: Fright School", "keywords": ["school", "monkey", "prank", "hangout", "multiplayer"], "long_description": "# \ud83d\udc12 NEW: Mrs. Grumble's Class \ud83d\udc12\n\nThere's a new teacher in the Science room, and she does **NOT** like noise. Sneak a whoopee cushion into her class and let one rip... then hope she doesn't figure out who did it.\n\n- She blames the **last prankster**\n- She grabs her ruler and **chases you** until you escape her classroom\n- Too slow? **Straight to detention!**\n\n# What's New\n\n- **Dye Your Monkey:** pick any fur colour at the \"Dye your monkey\" board and stand out on the playground\n- **New Cosmetic Stands:** caps, hall monitor gear, bully jackets, football kits and more in the main hall\n- **Shorter Detention:** you're back to causing chaos sooner\n\n# Cause Trouble at School\n\n**Pull Pranks in VR**\n\nGrab prank tools, mess with your friends and create funny moments all over the school.\n\n**Get Chased by Mr. Detention**\n\nCause too much trouble and Mr. Detention will notice. Run, climb, hide or escape before he catches you.\n\n**Climb, Swing and Fly**\n\nMove with your hands, climb the school walls, and hop on a broom to fly over the schoolyard.\n\n**Hang Out with Friends**\n\nExplore the classrooms, halls, playground and sports field together, and become the troublemaker everyone remembers.\n\n**Cause trouble. Get noticed. Escape the teachers. Avoid detention.**\n\nJoin the Community => https://discord.gg/gdGM7abHsE", "short_description": "Monkey around a real school in VR! \nPull pranks, swing and climb with your hands, dye your fur any colour, and collect cosmetics with friends. \nBut watch out: Mrs. Grumble hates noise in her science class, and Mr. Detention is always on patrol. Get caught, and you\u2019re off to detention!"}]}, "developer_name": "IRONHEAD", "developer_privacy_policy_url": "https://sites.google.com/view/detention-monkeys/home", "developer_terms_of_service_url": null, "publisher_name": "IRONHEAD", "support_website_url": null, "website_url": "https://sites.google.com/view/detention-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_grap
vwFUJL6q&_nc_oc=AdobfWYd7jZSxw6Y6vr-s_MAR7c4-CuVHNfQoo4Z0N6EpBn23fXeZYNTncdOgIjVXZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXaT-KpyL38kq_bbYbSqwgop66ZJrb4SEndxPEOswSww&oe=6AEB3927"}, {"file_name": "DM_Halloween2026_Screenshot_5_TinyHead_2560x1440.png", "id": "1349141707176165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1349141710509498_5722547444422121795_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inM-ZYJbnNoQ7kNvwGiiC_T&_nc_oc=Adq9iGQA3_RV-bXJatt_m_Z_zZAhCC62yHpgkmJbo_N2-O2HFT6ZIRFN2QkQ2f9Laao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKHlrQVOhi4_SZMxNcwGU75U8xal2-8MC-JvhI7EFBtw&oe=6AEB4947"}, {"file_name": "DM_Halloween2026_Screenshot_1_SchoolGate_2560x1440.png", "id": "1694330008788385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1694330012121718_50424013024265829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YinHZ27N6wwQ7kNvwFGRYF4&_nc_oc=AdoLD7qeBAkTtibf4wiCHIUzOhL0OrzrF5vNkOb--RaH3gFFE4cLVbyr_t1aikCEB-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLWlM2b8t1inO8KZTu7laNqL1GVSJpzwoCJTycBvJA7Q&oe=6AEB5546"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Detention Monkeys: Fright School", "keywords": ["school", "monkey", "prank", "hangout", "multiplayer"], "long_description": "# \ud83c\udf83 Halloween Update: Fright School \ud83c\udf83\nThe school stayed open after dark, and **something has moved in.**\n\n\n# Haunted School at Night\nThe whole schoolyard is decked out for Halloween: glowing pumpkins, ghosts, a graveyard and a spooky science lab.\n\n\n# Brew Potions, Cast Spells\nGrab a magic wand, dip it in a bubbling cauldron and zap your friends:\n- **Giant Hands**\n- **Tiny Head**\n\n\n# Fly Brooms in Broom Blitz\nHop on a broom and race through glowing goals high above the football field.\n{1740809880551453}\n\n\n\n\n# Watch Out for the Clown\nSomething creepy lurks around campus. Stare at it too long, or get too close, and it will find you.\n\n\n# Halloween Cosmetics\nPumpkin hats, witch hats, a mummy outfit, skull masks and more.\n\n**Join the Community => [PASTE DISCORD INVITE LINK]**\n\n# Pull Pranks in VR\nUse prank tools, mess with friends, and create funny schoolyard moments across the playground.\n\n# Get Chased by Mr. Detention\nCause too much trouble and Mr. Detention will notice you. Run, climb, hide, or escape before he catches you.\n\n# Survive Detention\nGet busted, serve your time, and jump back into the schoolyard to cause chaos again.\n\n# Become the Biggest Troublemaker\nRaise your status, create funny moments, hang out with friends, and become the player everyone remembers.\n\n**Cause trouble. Get noticed. Escape Mr. Detention. Avoid detention.**\n", "short_description": "Detention Monkeys is a chaotic social VR school playground, and for Halloween, the school is haunted. Pull pranks, brew potions, fly brooms, and dodge a creepy clown with your friends at Fright School, then try not to get sent to detention."}]}, "developer_name": "IRONHEAD", "developer_privacy_policy_url": "https://sites.google.com/view/detention-monkeys/home", "developer_terms_of_service_url": null, "publisher_name": "IRONHEAD", "support_website_url": null, "website_url": "https://sites.google.com/view/detention-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_
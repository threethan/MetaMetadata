-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIZelGyy4MAQ7kNvwEBEwiY&_nc_oc=AdkKaP8ujP728LemxRewVRtwrB5Absu2mHRQK9Qx_5N54vqRj4HVr7yGLOv8OPagVhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXYFLWXhy6XzCPskhAQbQJBMPDTRpEezdBbYLQsNuVqg&oe=69BE85D4"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJQ4WMiktN4Q7kNvwGIGuek&_nc_oc=Adnk-tKQOflpDvQKTIuvOfpmpCRNqykQTBWNdmK9eqXp75qsqNVyXSfbx_cRM1iUbMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoQbJhmAOeHPlbZGk4d6FPaOZUzmvU8diDvH6Az77ZlA&oe=69BE9028"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "Clamb is a punishing VR climbing game. You climb a surreal mountain with nothing but a hammer. The hammer follows the movement of your controllers. Hit, push and drag your hammer past obstacles to get over them. It will be difficult at first, but practice makes perfect.\n\n- Climb a surreal mountain that reaches into the stratosphere.\n- No checkpoints will save you from falling.\n- Your skills will be tested, your limits broken.\n- Tunnelling available to alleviate motion sickness. (Vignette)\n- Option to swap hands on the hammer.\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt's not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_websi
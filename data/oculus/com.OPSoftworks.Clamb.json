, {"file_name": "Clamb_Meta_Screenshots_4_2560x1440.png", "id": "2101553566991933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aypajiHssT0Q7kNvwFDisqS&_nc_oc=AdoxDQP4rNhwB5lpASdTnL2up9isu4UILpyXdQD54WAXQNAJZBHRoGmPV_ftIdt3i68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_E3GRBECoRBhQbWFDnUajQkzsBbCJn6pvI1OJDA2Qg&oe=6AAABA94"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEpm2UsfWKQQ7kNvwF1iSds&_nc_oc=AdrpmZs3m182zpIJ9qcDmXnsE3UAHYvitOdgFYfDAxdfRjPtYK8BX6O312BOBa6_BBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoV_qBNnHOc8haxcZw2Lo7-uTbHMx-7dqHwoPFUNWbNQ&oe=6AAA8CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clamb_Meta_CoverArt_Landscape_2560x1440.png", "id": "706987881884563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_706987885217896_5842628266568314191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiDbc5qdbv8Q7kNvwE0LL2E&_nc_oc=AdqDSfdYmPHRRqWzOFfs_Zt8WthRzT5QFV4Y7jxSZ4FXQT8Rpfa2z1UWHYvum1d_lQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQyOeCLTTDoipu-JzusFHq3Kl9CI1VZo_aDTyJTwc9eQ&oe=6AAAA640"}, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "**Clamb** is a punishing VR climbing game - now with optional checkpoints and multiple hammer styles.\n\nClimb a surreal mountain with nothing but your hammer. The hammer follows the movement of your controllers. Hit, push, and drag your hammer past obstacles to overcome them. It will be difficult at first, but practice makes perfect.\n\n- **Choose your climb style** - The original Heavy Hammer for maximum challenge, or the new Twin Hammers for easier control.\n\n- **Optional checkpoints** - Checkpoints won\u2019t save you... unless you turn them on.\n\n- **Physics-based climbing** with no hand-holding.\n\n- **Climb a surreal mountain** that reaches into the stratosphere.\n\n- **Your skills will be tested, your limits broken.**\n\n- Tunnelling option for comfort. (Vignette)\n\n- Option to swap hammer hands.\n\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt\u2019s not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.opsoftworks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346350078341121"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393475_1227432832243654_5170482081767902946_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZm9HC9-808Q7kNvwHonXt0&_nc_oc=Adp1fDxRJd73RInv6pWxIYebrjxBls6v7XXhGVW9j37fV4
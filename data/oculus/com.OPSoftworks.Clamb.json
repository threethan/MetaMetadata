-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkt1Oa5SVOkQ7kNvwHxBbd8&_nc_oc=Adl2zeP7nUwk0N1HaFH7ZgZ9Jl2QUWUmcZSY18Njdz1_yt3s-UaUwVpZNybieTewuP4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTDZjMhZY8leROT4IXy2qdX7MoT32PbbsJrKkcxIe7jQ&oe=69B7EE54"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJBSOzclq68Q7kNvwHbcdE9&_nc_oc=Adkqt2IKQ9CFnTu1VXgRTFD2HFIY-8rpszOZL_DdeT2VkDE7HTzQOB-WS9EgOtChyo0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwW8iUk66ON5X5qkkWNZB9lgJSfXEAnRox8q0OmuLyJ0Q&oe=69B7F8A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "Clamb is a punishing VR climbing game. You climb a surreal mountain with nothing but a hammer. The hammer follows the movement of your controllers. Hit, push and drag your hammer past obstacles to get over them. It will be difficult at first, but practice makes perfect.\n\n- Climb a surreal mountain that reaches into the stratosphere.\n- No checkpoints will save you from falling.\n- Your skills will be tested, your limits broken.\n- Tunnelling available to alleviate motion sickness. (Vignette)\n- Option to swap hands on the hammer.\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt's not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_websi
 {"file_name": "Clamb_Meta_Screenshots_4_2560x1440.png", "id": "2101553566991933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqYMPU6_v38Q7kNvwHJF1Oj&_nc_oc=Ado0riFSvj4ETgJh5JVK7LHO9yyRg1nVvJMRtWZ2iorasbqXY8YcHMrAYOMqJmn6G8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZcqOAcCLh5o4xKF_p3LNKUg2qT7XXFAWP_a8Gw8OUTg&oe=6A0D9FD4"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwDNuJ_N7pwQ7kNvwGJEVs1&_nc_oc=AdpLglFNIzxMxju30cET7KnD6V5jHdMdMurJ2UbZRR19FGa6I3-Aw5OQHPVVBry74To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VL6rykW6vOWlzdXRrbb-f0DYttOJwP94Bq4ObV7S_QA&oe=6A0DAA28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clamb_Meta_CoverArt_Landscape_2560x1440.png", "id": "706987881884563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822581_706987885217896_5842628266568314191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYxQZqf5bgwQ7kNvwHnPGRx&_nc_oc=AdqChoIjcEClcf8-klK_I1Q_f6Vsa0_-G2gYyI6FRV9MIaCQoZrqQhvRpu2m9hk-kJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BJV4ONI9C-_S7EeCXensYY6vDjAd1ZGaTbF_zbagUxQ&oe=6A0DC3C0"}, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "**Clamb** is a punishing VR climbing game - now with optional checkpoints and multiple hammer styles.\n\nClimb a surreal mountain with nothing but your hammer. The hammer follows the movement of your controllers. Hit, push, and drag your hammer past obstacles to overcome them. It will be difficult at first, but practice makes perfect.\n\n- **Choose your climb style** - The original Heavy Hammer for maximum challenge, or the new Twin Hammers for easier control.\n\n- **Optional checkpoints** - Checkpoints won\u2019t save you... unless you turn them on.\n\n- **Physics-based climbing** with no hand-holding.\n\n- **Climb a surreal mountain** that reaches into the stratosphere.\n\n- **Your skills will be tested, your limits broken.**\n\n- Tunnelling option for comfort. (Vignette)\n\n- Option to swap hammer hands.\n\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt\u2019s not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.opsoftworks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346350078341121"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393475_1227432832243654_5170482081767902946_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gehMDuurousQ7kNvwHdDifC&_nc_oc=AdqHyODxy000IprA4fMAhxaWhMCPkYq2QarvF80ub5q5YbM
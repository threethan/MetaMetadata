 {"file_name": "Clamb_Meta_Screenshots_4_2560x1440.png", "id": "2101553566991933", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhDyTDIM4EQ7kNvwF8xxJi&_nc_oc=Ado-ZTm8yKcuCd2mUzd6gtBmb3OS2YtD8kqQ4Ll9IOAyYqrQlUNkX68Xncd-BPNybrQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OaIPR6enjCX2rei37TYS-NTbR2jECZqk0JGKJbz-CnA&oe=6A26E494"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_BKZkr8XPwQ7kNvwE18UcT&_nc_oc=Adoz0luhgYW3MuepadBbrsuWfy_03l--IwLyJOY0pm2zXK2Dgvhac50SplqoKZX1SRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TAaRABD9PwTa21qovS3QKAQtAOun-WHn6QNb1cHhrtg&oe=6A26EEE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clamb_Meta_CoverArt_Landscape_2560x1440.png", "id": "706987881884563", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822581_706987885217896_5842628266568314191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MgEBt0dGWEQ7kNvwGv-S91&_nc_oc=Adrx5-uSU-3HR-INOrqbXS9eTZFwu1Ga2Xt5Pl2pBpX0xaPrJPyujf7fIg7rXhTRars&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g2GAxuuQEnbQG_OiJtvwfPWaI4Iq_aG8HMvFGPe0nmQ&oe=6A26D040"}, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "**Clamb** is a punishing VR climbing game - now with optional checkpoints and multiple hammer styles.\n\nClimb a surreal mountain with nothing but your hammer. The hammer follows the movement of your controllers. Hit, push, and drag your hammer past obstacles to overcome them. It will be difficult at first, but practice makes perfect.\n\n- **Choose your climb style** - The original Heavy Hammer for maximum challenge, or the new Twin Hammers for easier control.\n\n- **Optional checkpoints** - Checkpoints won\u2019t save you... unless you turn them on.\n\n- **Physics-based climbing** with no hand-holding.\n\n- **Climb a surreal mountain** that reaches into the stratosphere.\n\n- **Your skills will be tested, your limits broken.**\n\n- Tunnelling option for comfort. (Vignette)\n\n- Option to swap hammer hands.\n\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt\u2019s not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.opsoftworks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346350078341121"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393475_1227432832243654_5170482081767902946_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PNS-aJY8mAQ7kNvwGWF5DR&_nc_oc=AdrAVCElTHQMsK9MPOL0qEMINAXNrhcMIcYdo-HWGvf8HjC
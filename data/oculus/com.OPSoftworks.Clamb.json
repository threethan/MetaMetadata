756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEErPclFt7sQ7kNvwF5ey5L&_nc_oc=Adqm7i4o8L91lZ7wuYBAgHxJl36Mv3PyDAlCJnndBOLTk9gD-rAL2ythF5fgIYp4Rzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PAvSGiwC9yebxJ2dmnyJ_pO7eEOIML9SG-aLtozat6Q&oe=69F1F054"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayuNGHA0DgwQ7kNvwGFpbBR&_nc_oc=AdoQf9Qpy_HHhypt5eXv6mhI4b9rRdEUXDXS3UVfJJty40LnoleGPw6zBY8sOPPjfYw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3T10R5qLFBmOT8EL9QXFBy_8C3ZWd7RV79kKr9xeK6yQ&oe=69F1FAA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "Clamb is a punishing VR climbing game. You climb a surreal mountain with nothing but a hammer. The hammer follows the movement of your controllers. Hit, push and drag your hammer past obstacles to get over them. It will be difficult at first, but practice makes perfect.\n\n- Climb a surreal mountain that reaches into the stratosphere.\n- No checkpoints will save you from falling.\n- Your skills will be tested, your limits broken.\n- Tunnelling available to alleviate motion sickness. (Vignette)\n- Option to swap hands on the hammer.\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt's not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.
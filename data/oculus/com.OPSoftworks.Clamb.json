 {"file_name": "Clamb_Meta_Screenshots_4_2560x1440.png", "id": "2101553566991933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393738_2101553570325266_8856964756107607754_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP_eBqGGMzwQ7kNvwEiIczE&_nc_oc=AdpYzkgErb92Wybbc26kWtojHbjl2fse3YfGgnmYvTp1evOsClaBoiiUpnS9KhS5TSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MugvdNcJr0HuBqcO_3QI1g5YsQJS9C3qgAzu2CiNmFA&oe=6A05EF14"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yx4EoLTkiYQ7kNvwGlCkO0&_nc_oc=AdpDCIJFKJFkWRAnG2viQ0QtbPJUjAKKmI64jxKntMdf9l0l0u41DaLvdZgTnPdb4NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ace3kUe3Ba_dBaYLzMSDGyzaRSSFOaYb97qg0mzgwCA&oe=6A05C128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clamb_Meta_CoverArt_Landscape_2560x1440.png", "id": "706987881884563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822581_706987885217896_5842628266568314191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfEe3QS9kIEQ7kNvwFOe0j-&_nc_oc=AdppnD8vkow5rwwuyJ78jclzR-3vaA7Pkmfr91U7gQRQl2-FNmWsPMBzzNKiFmqisFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VKUbFQl4RkgILm1SyU6tcE8HQ0fOmSd5-WNZF-Js8JQ&oe=6A05DAC0"}, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "**Clamb** is a punishing VR climbing game - now with optional checkpoints and multiple hammer styles.\n\nClimb a surreal mountain with nothing but your hammer. The hammer follows the movement of your controllers. Hit, push, and drag your hammer past obstacles to overcome them. It will be difficult at first, but practice makes perfect.\n\n- **Choose your climb style** - The original Heavy Hammer for maximum challenge, or the new Twin Hammers for easier control.\n\n- **Optional checkpoints** - Checkpoints won\u2019t save you... unless you turn them on.\n\n- **Physics-based climbing** with no hand-holding.\n\n- **Climb a surreal mountain** that reaches into the stratosphere.\n\n- **Your skills will be tested, your limits broken.**\n\n- Tunnelling option for comfort. (Vignette)\n\n- Option to swap hammer hands.\n\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt\u2019s not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.opsoftworks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346350078341121"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393475_1227432832243654_5170482081767902946_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZDhfIUdhoAQ7kNvwFPUAcv&_nc_oc=AdqXi-dOgIX7CmnNPcoyFWF0tVvIRPIurjmfsKOlxJL3ulA
itYL9Ygdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5z-pCDOX8_Ymal_cr9byeSZBGA449OoDsuFFKHaM1yQ&oe=69A6CAD4"}, {"file_name": "Clamb_Meta_Screenshots_5_2560x1440.png", "id": "1338043543975497", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819775_1338043547308830_8039435356990940156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCDxfWGSuKcQ7kNvwHZTL5z&_nc_oc=AdlMapy_oUwXt8b1TKDDf_4Jo8jC4sgZhjA-FtE7COqq-9qs0_g3ojwn_U5W_NlVSgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXMMaVlrPsr7iufxTd5lFmYmH8FLixPRQEhcAssILN4w&oe=69A6D528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clamb", "keywords": ["hammer", "climb", "climbing", "climber", "difficult"], "long_description": "Clamb is a punishing VR climbing game. You climb a surreal mountain with nothing but a hammer. The hammer follows the movement of your controllers. Hit, push and drag your hammer past obstacles to get over them. It will be difficult at first, but practice makes perfect.\n\n- Climb a surreal mountain that reaches into the stratosphere.\n- No checkpoints will save you from falling.\n- Your skills will be tested, your limits broken.\n- Tunnelling available to alleviate motion sickness. (Vignette)\n- Option to swap hands on the hammer.\n- There is a reward for those who reach the top.\n\nI know it's quite a clamber up those rocks, but once you get to the top, the view is worth it.\n\nIt's not the mountain we conquer, but ourselves.", "short_description": "A punishing VR climbing game. Climb a surreal mountain with nothing but a hammer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.opsoftworks.com/clamb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OP Softworks", "support_website_url": null, "website_url": "https://www.opsoftworks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
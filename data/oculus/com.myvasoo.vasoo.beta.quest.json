c_sid=6e7a0a&_nc_ohc=WhEYrDASeQ4Q7kNvwET_7TG&_nc_oc=AdpdutVOwWSUZFBp3RVjBoGUxuo0BG9O8cCsXxjXS0HxuP33-e3fPogiTqVhCK79ruc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oE03dHgcQ2ShUUKfaTEwccK2imBKfAbCo0b04baNBkg&oe=6A369068"}, "display_name": "Vasoo Be Together", "keywords": [], "long_description": "Vasoo is an entertainment focused, social virtual space that is completely immersive and interactive. We have different realistic and charming worlds inside our application where small groups of friends and family can hang out together and engage in a wide range of fun activities.\n\nChoose from a list of 3D avatars to represent yourself in the different worlds and use them to move around, interact with in-game objects, and mirror other in-person actions. Enjoy our beautiful immersive 3D environments and talk to your friends seamlessly in real time as if they are right next to you. \n", "short_description": "The perfect place to hang out with your friends, enjoy minigames, watch videos together, and so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iconicengine.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Iconic Engine", "support_website_url": "https://www.iconicengine.com/contact", "website_url": "https://www.iconicengine.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_intera
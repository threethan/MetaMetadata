le_name": "House - Shot 1 - Watching TV (1) (1).png", "id": "710401743563886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982549_710401746897219_8168682228147444404_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrE-OltriV4Q7kNvwH-urFu&_nc_oc=Adm5THeINZ95TopHS3nKyYQsKToIg9l0_OZSOrI7CS2Bv9bM4bxq35Ce1cgid_hfZ6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLvskeHKKx0sYD2XZ5e2QctEqtoD_ZKSJXpNnIrhUQyA&oe=69B6A0F3"}, {"file_name": "Shot 2 (1).png", "id": "393019372803279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_393019376136612_4564224429327649004_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqIJgjr0iYQQ7kNvwHM66Qe&_nc_oc=Adnlurf_oODIA_IgH3cfMHCnwLsybwyjtxmOCM7e2L72z93vXWkOrrUOdZ95wWB6SoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxd2TXzEvooSYlCCEayONEkUjkCZWShARPIbBMOyIFZfQ&oe=69B6ABEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_2.png", "id": "737490654159864", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75588058_737490657493197_2757378214970561705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyWqV9waX2QQ7kNvwGBVnNr&_nc_oc=AdlMUHbR9NmQ94XhI7Put-xUSqyNbeX1ymCL698B5n9A7U9dl1-FP3cjF1P9Sj4jut0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxdr6FvdQWQhLpvPL3_p4e5qvqQvBw4KPBJWJaja0nqXg&oe=69B6AEE8"}, "display_name": "Vasoo Be Together", "keywords": [], "long_description": "Vasoo is an entertainment focused, social virtual space that is completely immersive and interactive. We have different realistic and charming worlds inside our application where small groups of friends and family can hang out together and engage in a wide range of fun activities.\n\nChoose from a list of 3D avatars to represent yourself in the different worlds and use them to move around, interact with in-game objects, and mirror other in-person actions. Enjoy our beautiful immersive 3D environments and talk to your friends seamlessly in real time as if they are right next to you. \n", "short_description": "The perfect place to hang out with your friends, enjoy minigames, watch videos together, and so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iconicengine.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Iconic Engine", "support_website_url": "https://www.iconicengine.com/contact", "website_url": "https://www.iconicengine.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "787560838946797"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "817592942943461"}]}, "baseline_offer": {"id": "817592942943461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1660847400, "status": "PUBLISHED", "id": "817592942943461"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6348510418605256", "version": "0.28.0.0.gcd651cce3a"}, "id": "618486055809586", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4955910784531900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "634
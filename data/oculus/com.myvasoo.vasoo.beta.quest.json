AQTuV2S1yU6dc9Q2PrRI7W5C97Ss1wU_B22IoIXDQ4NvwQ&oe=6B0712AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_2.png", "id": "737490654159864", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75588058_737490657493197_2757378214970561705_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T79plqw1UdwQ7kNvwGoG7N5&_nc_oc=AdrMsAIpyEBsoVz6W-2fX4zbeMj_ejye41GxYm_9YFe9AipJ8patnO_f2nvY0Xdp864&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7ErpDwDDKw4mfZN7dneFnQVQikFEcPw_-4GGavRK5VA&oe=6B0715A8"}, "display_name": "Vasoo Be Together", "keywords": [], "long_description": "Vasoo is an entertainment focused, social virtual space that is completely immersive and interactive. We have different realistic and charming worlds inside our application where small groups of friends and family can hang out together and engage in a wide range of fun activities.\n\nChoose from a list of 3D avatars to represent yourself in the different worlds and use them to move around, interact with in-game objects, and mirror other in-person actions. Enjoy our beautiful immersive 3D environments and talk to your friends seamlessly in real time as if they are right next to you. \n", "short_description": "The perfect place to hang out with your friends, enjoy minigames, watch videos together, and so much more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iconicengine.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Iconic Engine", "support_website_url": "https://www.iconicengine.com/contact", "website_url": "https://www.iconicengine.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_conn
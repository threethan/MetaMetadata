n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO7jti8rVAkQ7kNvwG32VFP&_nc_oc=AdoooeDXAhsZAPV-ZyD4q9MtfoSwJlZ3BH3uWV_KPHdhXE6UwjOISFYwWi8OD3DO8QI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhMDk08zU3lOLJXUB9RmPHlFkeqtfLNOS_Ku2BmxlNwg&oe=6B105FD8"}, {"file_name": "Solwata_Screenshot_04.png", "id": "1843392957077896", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_1843392960411229_7900229957058856948_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7Doz_to1uoQ7kNvwGh33Ev&_nc_oc=Adpl6J8jmAMUOS-QikDkA2trz7LAVpwzkPZ_Q5eTE31stOg5HVYUUSyBpRfkvp35RL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVznHECyoMJ43aj32bA9s4k7l3sNWfqEtN0JMDzrSGN0g&oe=6B106122"}, {"file_name": "Solwata_Screenshot_05.png", "id": "4204435136524060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_4204435139857393_1306166888834431198_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JWlgu9WB2MQ7kNvwFR_Xj_&_nc_oc=AdpTGEn7cfgnT_QaJtx1E092BpcZXUo-9V2AS9Ztzy0yTnp2kdTJaIPhXD1jcNwa5no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmpWN8MrM1jdn0W2o4ayc9WqG0I805UWUGpsebvifsvg&oe=6B106550"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Solwata", "keywords": [], "long_description": "Solwata (pidgin for saltwater) is an immersive mixed reality experience that transports audiences to Solomon Islands to confront the human rights consequences of climate change. Co-produced by Human Rights Watch, NowHere Media, and Agog: The Immersive Media Institute, the project is based on Human Rights Watch research and created with the Walande, Ngongosila, and Kwai communities. \nNarrated by Mark Ruffalo, Solwata invites viewers into the world of the Solwata people, transforming climate loss into a personal encounter with resilience.\nWalande was once a vibrant Pacific island community, but storms grew stronger, tides higher, and king tides repeatedly flooded homes, erasing land and forcing relocation to the mainland. In Solwata, participants join Martha, Francis, and Lawrence as they protect their homes and heritage amidst displacement.\nUsing 360 video, Gaussian splats, spatial audio, and 3D animations, users enter a slow-motion catastrophe alongside frontline islanders.\nWhile focused on Solomon Islands, millions worldwide face similar risks. Solwata shows how immersive storytelling complements research to push governments for rights-respecting relocation policies, ensuring communities decide their futures with dignity.\n\n", "short_description": "Narrated by Mark Ruffalo, Solwata is a mixed reality experience  exploring rising seas in Solomon Islands due to climate change. The audience will enter the vibrant world of the Solwata, or saltwater, people. Using 360 video, Gaussian splats, and 3D animations, participants join Martha, Francis, and Lawrence as they protect their homes and heritage amidst displacement and planned relocation to the mainland. Solwata transforms an abstract threat into a visceral experience of cultural resilience a"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nowheremedia.net/solwata-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NowHere Media", "support_website_url": null, "website_url": "http://www.solwata.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes"
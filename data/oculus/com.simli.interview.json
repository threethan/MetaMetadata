.png", "id": "708869224255352", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974779_708869227588685_2869106126093839933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnpMLqXBeNYQ7kNvwGf95nI&_nc_oc=Adqj3Z_v5F01L-GrNugtOqtsiTnLkh1r4vFXBeXmFhMGZv7hKCe2kCEehJzrjETIR1w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWTxdb7jwdIwRtmTMAQbrWew6JWe4tb-4ym8KhEqrg3A&oe=6A7DC3AD"}, {"file_name": "TrailerCover.png", "id": "534773861901717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031350_534773868568383_1567764472152410917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXSkLKFHPQAQ7kNvwFVxonc&_nc_oc=Adp3KPk60yfhMNwwv-WltRXTwFG_lYgXtZK5le4CLR-atzr3GBbiB6yFeG3mY5KfMlQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyOq1c2ZbP8zDHJwG9uTkFfcSrTkL_hjDrr-IDNYnOdA&oe=6A7DCBB5"}, {"file_name": "Screenshot1.png", "id": "3057879474512333", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974593_3057879477845666_3909506663525550675_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX3ckw1sjT0Q7kNvwHfa-QA&_nc_oc=AdoilsLS2yE9kyFLr3Iy87K2SfBrbJlSc09DCfE2nEa1s0WC6AT-hSfrmvHaHzPuW00&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVIm7G5jothc5CcyjnJa6wJ9Sg3DDlSX2D1GGGYBlffg&oe=6A7DC95A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Yatek", "keywords": [], "long_description": "Here you\u2019ll get a taste of what the full Yatek experience has to offer. Explore one of our simulated social situations and customize your experience using our speech-to-text prompts. In the full Simli app, we have more than 10 social situations you can experience.\n\nWithYatek, you\u2019ll get to experience a simulated job interview. Before you start, you\u2019ll get to choose what job you\u2019ve applied for and then get relevant questions from the interviewer. The interview will take place in an office with you and one character. Who knows, maybe you\u2019ll get hired?\n\nThere\u2019s no limit to how much you can test, so go ahead and test as much as you want. That way, we also get valuable feedback on what works and what doesn\u2019t. And hey, if you know someone who needs to practice their job interviewing skills, then share it with them too!\n\nTeam Yatek\n", "short_description": "Here you can try one of our simulated social situations and experiment with speech-to-text to customize your training session. So what are you waiting for? See for yourself how real-seeming the conversations with our characters are.\n"}]}, "developer_name": "Yatek", "developer_privacy_policy_url": "https://sites.google.com/simli.com/yatek-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Yatek", "support_website_url": null, "website_url": "https://www.simli.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27972958475628432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75297582_1251948499377411_2473878896998784110_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn3EYIPRJ00Q7kNvwEv_-Sx&_nc_oc=AdqPdqhwD-fbJZwtztrXlZwrrAt8cI3dw32h0S6_Ttb2yWEP-lmXgQtiWr4YWNOCxW0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUyvgB7Md1XYVvYISVUGCcPb-JwA1TuF0NNSvFVocReA&oe=6A7D9AB7"}, "is_concept": false, "is_test": false, "is_tr
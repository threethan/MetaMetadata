ler input lets you move between scenes and return to the main menu at any time.\n\nAvailable in English, Portuguese and Spanish.\n\nAccess requires a Walevska Quantum account (quantumvr.com.br) and an internet connection. Sign in with your email and password using the in-VR keyboard.", "short_description": "Explore eight immersive virtual reality environments inspired by everyday situations: heights, an enclosed elevator, spiders, rats, cockroaches, a messy room, crooked picture frames and a room with an MRI machine. Available in English, Portuguese and Spanish."}]}, "developer_name": "Grupo Vex", "developer_privacy_policy_url": "https://quantumvr.nyc3.cdn.digitaloceanspaces.com/privacy/privacy_terms.html", "developer_terms_of_service_url": null, "publisher_name": "Grupo Vex", "support_website_url": null, "website_url": "https://grupovex.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR", "en_US", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29672242125698140"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2511622115865416"}]}, "baseline_offer": {"id": "2511622115865416"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790966040, "status": "PUBLISHED", "id": "2511622115865416"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29672534375668915", "version": "1.3"}, "id": "7
9A2CE9D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX68_S6HBHkQ7kNvwEs9GDY&_nc_oc=AdlXVDiL64bCBrh_-A7tz_kW-VIF7BLDXjcf0lt9FWEU8lGp4NBmwwXh9qc_TF8RCTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftF1S3vVxRA_KDfMrSwDg1QPezspot0uLxl1B5ZcJ6ZwQ&oe=69A2E50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvlG4eIIw3cQ7kNvwE-iGLX&_nc_oc=Adlt6BxQsLsiVgE7HRvElgVWCiPnhzSs1uES74OZPTC2XQYzkjsL3kZM_Jgpg2k6EUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvmp173_FrcAfqzBuLq3vRV4mo1zaNYQszg5dN0zVRzgQ&oe=69A2DCF0"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "suppo
jft81tf35Qunqs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3fQoKmr-Xz92NcDVLA3WHaQpZ-6eQM14hEku3dgSrPw&oe=6AA9615D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vddUjpo7v7oQ7kNvwFoJGTm&_nc_oc=Adqrc6exiHux-hb8eLQ1jDSpbCny8NF-aaqJrzauxcgJAdobjQsnzmGW9gaHKNun0ik&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo1BAUVHsOmCY7nIYJWLoY_RRs_HTktJH7RNeUCkgW_A&oe=6AA93F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mvnznlx4-cQ7kNvwH9thT6&_nc_oc=Adq7mnOclakt-9ILD0pKUlX6zmlGrp-BFLYH5A9Rad8m5msfypNf_bsl3cs854uy5c8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfXlCweHRYUmYzvJ_GY6ZD4fpixS_OCCMpkXLM3vxUIA&oe=6AA93770"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url
ent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGITdUatJG4XVyPKyV-GtQ9oIpXBoLvOwmgsGslr2gvg&oe=69AAB79D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YqlEdR4KD4Q7kNvwFJJ7Hu&_nc_oc=Adl2OrO_IdRV625XbEcrx5mSSZfDFwm_7Ztj0MSEoWqcr0XeJrEprsIZkwzLOZJh1ig&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afzr9IAeatULY1Os8xyexjA6omhqEYKfJaC3lHUd4zrSJA&oe=69AACE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1KRjeb9UowQ7kNvwEUc1UP&_nc_oc=AdnPBIRXz187op7oK4qAnmvg5UYCsFhjLJFbd5MqXkoVH86rta709u1Vjdpp0HkheRU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afwil6H7gEY4kTX-U-zCBr1G7pRAQTAMJA_15oWhdUZXXw&oe=69AAC5F0"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBox
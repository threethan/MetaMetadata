seum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "support_website_url": null, "website_url": "https://gamebox.museum/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26279928758278658"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035330_2617183768473287_3724352711142821912_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dryYHT4guyQQ7kNvwEC6nBd&_nc_oc=Adpemw0GZ7C4UeENnhvJroQF-mVPWoU2q1buuru_kQfNJzDAroO1TCV9ILeKkgScDg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6jgdZhwqG1nvY6hAqQMW0VZkZvDOaJ_7xgQNYPeFKdA&oe=6AFDC331"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gamebox Museum", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "r
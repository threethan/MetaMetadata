99AE59D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab4m-94sGCAQ7kNvwFNv_NC&_nc_oc=AdmP-xIfLPBZazng23xChEci5MM3ZCNnfCGosa8DIEkKEQBovqela4dzURGb4veJD8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs9OHa2kr8_6a-raQw3icvX8BVyCg9NeF8niIa9xLjC-A&oe=699AFC0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6ThR-89bsEQ7kNvwGcS9M4&_nc_oc=Adl8MO4LAXtuNyr8Cc7Pnq0O7Hs-HPNXQ4WHdnHSiHRP1koYyCnkzg5yKi9G6CFMkso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv15VQmGEDGTvE4VaOABd5jsS9a--zI7sREf7LgqvQdbw&oe=699AF3F0"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "suppo
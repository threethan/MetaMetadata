99EDA1D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13BiheJ3f6wQ7kNvwEKTXxV&_nc_oc=AdmSih4nJWwYeDp1CvDSMSYp233L3Mm6MUImLy9qhnDWw20rcQkuagv3DOYUnizOrFU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuePRudgm8zqP0fYHBQpkrLNnRlwqRU8_INGJBGVPSqEw&oe=699EF08D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYdPMQpCXDoQ7kNvwEA64L8&_nc_oc=Adk0DOoSJut6VA66L0uaIykMMQtIjbWfHTNJe_ZEumXSswhbC4yL4uXmC3lBHN1Ja3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftsObBG6f4Msw0-sspLZr8a6DOYgH8_RTf8RrFEgV5xPA&oe=699EE870"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "suppo
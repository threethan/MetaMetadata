9A02B9D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13BiheJ3f6wQ7kNvwFtTQj4&_nc_oc=Adk8FPTpxD7xAm3OHsQez5SPXaP4LVTWtLlrCJdCATbrQhQCXpMMydtYBAaa82wDANI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshAXBu1Nf0yUZwgDbKadWH1g2UG4xn3FfvixBByCXIuQ&oe=69A0420D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYdPMQpCXDoQ7kNvwGluLBk&_nc_oc=Adn5MCDoiqc3QCD2g8D8womxUlV32tpjpiqpw6ph6SSjdFC2fBPKZYz_spx8TAMgZ-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuoq281BXyiyvzqeMBqLHaOpNUay4wLhKd_xCQ6FwSB0Q&oe=69A039F0"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "suppo
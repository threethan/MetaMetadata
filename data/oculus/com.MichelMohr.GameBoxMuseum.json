nt-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2zDs2RhPRhshsm5TzDBitVJ8yZ9_AbCuTUFFOWq98Kw&oe=69B9381D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUTHnRKcKRsQ7kNvwFoL7bZ&_nc_oc=Adk7YMDrI8Duw7ntQHHeVfJKtnpKrYzG1yj9_Fzhv88fwLDnkAeZXl4OSE2EWzYUdEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJpgma3rFDAWcWr3a2NZKeaNCXYZW7b87ob-zGpeh3Sg&oe=69B94E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSj0eSOg5CMQ7kNvwHF5eaU&_nc_oc=Adkw5zwqtlBLbvqdb6f_NCuKFQqtnlBUg5Kw9fr-Pc6GREAC_TPri08ERFi9aUO7YMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh7VdqG_ncS5ub_5bwap-mtCOAbD1MCsDxQf-fyJW6PQ&oe=69B94670"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuse
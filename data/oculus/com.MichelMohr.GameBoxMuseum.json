nt-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUCBj-_fca8JhJyH-p8QxtOJlMOcvfmaVJ7HeuJydLqA&oe=69B6951D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUTHnRKcKRsQ7kNvwEiaDJC&_nc_oc=AdkoIPM5qbnVTx8WLsfb0au07brWt8QS0cyScuss-BvlFRpbCcdYsnha87JvNzdQh8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLoZAooa8ZL4q-qnh2sV2aY1-ZBh4bCfrE1IMxH3LHvg&oe=69B6AB8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFY00EdAc5UQ7kNvwFfIy9Y&_nc_oc=AdmYhhZ_m-iN_-nald0gIKUGAU6JqkJWJJ0Sku0cTGsAWUGxp5BGp2pWBIBhHT8NP4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afynp-aQ1RgYOhoSV4n_5XpjsOGe_MZBPhNkjQB8OftIBQ&oe=69B6A370"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuse
nt-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz37oBtVQ5RiCHZVH_7JCZgl2w0F86G3rdYPcz5EKWxRQ&oe=69AC091D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YqlEdR4KD4Q7kNvwGW511b&_nc_oc=Adk0NgzWo6utafBCsNKIyhhSvP3PL6RaqW6121NPOqbZ0af8jGzCWBe6RWYQduLyH9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0ZtxUP_ax7jvaGV4_-7cKtvXzt2YV0ycBAm9PtUsfKw&oe=69AC1F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1KRjeb9UowQ7kNvwF3Jnwr&_nc_oc=AdnI2xewaSp6qUAfZKfstvEO0SwMB2SnVrK2YdMa6rKCJMu72x91CO1XKm9foknDvKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhEizzm-DyGLJNqxttq_3J-HNYyvmKMCo64P26OgSc0Q&oe=69AC1770"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuse
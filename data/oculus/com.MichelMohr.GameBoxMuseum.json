9A4201D"}, {"file_name": "1.png", "id": "1434240023844706", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003251_1434240027178039_8219734617711632179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX68_S6HBHkQ7kNvwEkJIuG&_nc_oc=AdksUiHspOJJMoGuXo4BASU5iPdaumwVxM1JxloSPpks5XBO7YQUec91ooMq4E6ThVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuO3R81FbjHcnplBmCpAev4WQAn9nbCFtH_Cs8h4EReGQ&oe=69A4368D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videosplash.png", "id": "859586229337555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_859586232670888_1309886561172094678_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvlG4eIIw3cQ7kNvwHrfgJN&_nc_oc=AdnAb-KQI8qx0iH9W5jG89pH3IMfBVnwjYaKhrYP4Xma1jhr27tJAO5vhQfzBX6DBdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv7GiURrrRzvXEunnsj-DSvtSHNsBz0PXGxy9lyAva_zA&oe=69A42E70"}, "display_name": "Gamebox Museum", "keywords": ["retro", "game", "oldschool", "vintage", "box"], "long_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites.\n\nBack when games consisted of boxy hallways and flat sprites, a game's box helped kickstart a gamer's imagination with the right context for full immersion. \n\n* Browse and view high resolution 3D scanned game boxes from an ever-expanding database.\nComing soon:\n* Turn your home space in a mixed reality game box collector museum.\n* Share your home museum with other visitors.\n* Browse the archives rooms.", "short_description": "Visit the Gamebox Museum to learn about cool game boxes from the 90's, discover new games from the past or learn things you didn't know about favourites."}]}, "developer_name": "Flittermouse Games", "developer_privacy_policy_url": "https://michelmohr.me/3dBoxCollector/GameBoxMuseumPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Flittermouse Games", "suppo
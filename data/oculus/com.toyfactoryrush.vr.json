wQ7kNvwGKn8Jq&_nc_oc=AdpWvRgJTeWx53KSGsSCeTfGsukyxYEG6hk4EMyWxHtRaT4pbBBfIY_qMm6NSNsoY00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIkXKt76yn8hktiEGgJuGmvZrlVIqB3dK3PWCKi6x5Yw&oe=6A9C2E74"}, {"file_name": "4.png", "id": "1281138177038706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820382_1281138180372039_2529110020727967521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmMCzwiFsewQ7kNvwG9yqJj&_nc_oc=Ado-kW5jVm9_MuRfBEooMm9AeV9RmrJOS0T0-OVCYxdVJakjpKXCdXz8snmxAX6FqRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhrsim-Dft3unzZMOGAyrbdg0ZMr36zAq1hm3NmCeDXA&oe=6A9C0B12"}, {"file_name": "3.png", "id": "3650517895081420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300574_3650517898414753_1677688664230829638_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZd3AUAGNqAQ7kNvwGRrF84&_nc_oc=AdrHcosU9Z4uYwtpV0oAFri2uyrzMTUScUNel4mIYQvFKnXKRQNR3-03HSIIpXQxNoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2RhU96zl9EoLsPen2a-RdCa9yMTjwJ1ykZmVe3Wj7eA&oe=6A9C3F3D"}, {"file_name": "1+ ss.png", "id": "1114758320230218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_1114758323563551_4416159141420860559_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Alhcn7hRwLIQ7kNvwHZwixG&_nc_oc=AdrpXpG84uhY2qlDuLzaXVbkIw7T4GfLGKm7gCdJLT4HjpGjcXfPtikR3TYOKxTiqTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAzVRxgoPMtpSAWJ66TcpOtWgSWx1gNL6AFSpCpW4fVg&oe=6A9C249E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toy Factory Rush VR", "keywords": ["Toy", "Factory", "Match", "FindIt", "Puzzle"], "long_description": "Welcome to Toy Factory Rush VR \u2013 the ultimate toy collecting and packing challenge!\nPut on your VR headset and step inside a colorful toy factory, where you\u2019ll work as a factory worker racing to collect and pack toys into boxes before time runs out.\n\nThis fun and fast-paced VR factory game combines action, puzzles, and time management. Your mission? Spot the highlighted toys, grab them quickly, and place them in the correct box while the factory conveyor belts keep moving.\n\n\ud83c\udfae Features:\n\nImmersive VR gameplay \u2013 feel like a real toy factory worker\n\nCollect toys like teddy bears, robots, planes, and more\n\nFast-paced factory action \u2013 pack toys before the clock runs out\n\nChallenging levels with increasing speed and difficulty\n\nColorful 3D toy factory environment designed for VR fun", "short_description": "Step into a toy factory in VR! Collect, pack, and rush to box toys before time runs out."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253917684230178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307451_1282793222712188_5863144523505531560_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvNBYlwi5kAQ7kNvwHLlJdm&_nc_oc=AdqTH3GNvogiErT8T8CNkI9NEzg2QASNZ9_RX75NSzI-mTe3POPO6DsFID5IU_AP4Cw&_nc_zt=3&_nc_ht=scon
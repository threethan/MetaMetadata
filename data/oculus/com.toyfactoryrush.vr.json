wQ7kNvwFXxuaK&_nc_oc=AdotB9LOQOfFUxEgHWbyY7kwIDZuFBeptU9kS--eLBqVmDmsBppAgL_YqB_Sv--qwpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJecnuTmWF1TOCE2GpBmAqbcuxrnNPC44UuaQ2RzI-7Mg&oe=6A9D7FF4"}, {"file_name": "4.png", "id": "1281138177038706", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1281138180372039_2529110020727967521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmMCzwiFsewQ7kNvwEFnmQ1&_nc_oc=AdrCk2GAhDC-j2iWGTjkOKHdUt84uDD7MggcC1RUz1DzH4BLnj7YI037xoUDDXqlaUY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ibIZFHUxCyDMGkqmWL2HaRkiC8HhasqQfFD5vt7QGA&oe=6A9D5C92"}, {"file_name": "3.png", "id": "3650517895081420", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300574_3650517898414753_1677688664230829638_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb2sQkInP6sQ7kNvwFwkiow&_nc_oc=AdpLYaTPTlSWqy3hAMnOF2NaD6nSs7TSoMXI7ouCsob1i0aV38G1xyfK_gPLo9BIDMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfp_JPb5bP5Et2e97apT7_GpJEzysPgJzddjwNFAVXPw&oe=6A9D587D"}, {"file_name": "1+ ss.png", "id": "1114758320230218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_1114758323563551_4416159141420860559_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkLAh46JhCMQ7kNvwGJH03O&_nc_oc=AdqS-_1ThqzBuuAyHYTURk_9Vl1s6StgVNXSO3Q-vHHjqMxWmdhE6KKarXx9F-cWT4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxsfMOvt9m6C42yiVd3jfoFnDT5RTGJEKs569TWbt6bw&oe=6A9D761E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toy Factory Rush VR", "keywords": ["Toy", "Factory", "Match", "FindIt", "Puzzle"], "long_description": "Welcome to Toy Factory Rush VR \u2013 the ultimate toy collecting and packing challenge!\nPut on your VR headset and step inside a colorful toy factory, where you\u2019ll work as a factory worker racing to collect and pack toys into boxes before time runs out.\n\nThis fun and fast-paced VR factory game combines action, puzzles, and time management. Your mission? Spot the highlighted toys, grab them quickly, and place them in the correct box while the factory conveyor belts keep moving.\n\n\ud83c\udfae Features:\n\nImmersive VR gameplay \u2013 feel like a real toy factory worker\n\nCollect toys like teddy bears, robots, planes, and more\n\nFast-paced factory action \u2013 pack toys before the clock runs out\n\nChallenging levels with increasing speed and difficulty\n\nColorful 3D toy factory environment designed for VR fun", "short_description": "Step into a toy factory in VR! Collect, pack, and rush to box toys before time runs out."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253917684230178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_1282793222712188_5863144523505531560_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvNBYlwi5kAQ7kNvwFNQxM9&_nc_oc=Ado26lu-sNoDglWkD8wsZrSc2ycI_3nqoq59fdM9fuLKyvxpisFsEmgUYrIL6UZ9doE&_nc_zt=3&_nc_ht=scon
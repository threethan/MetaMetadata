uscdn.com&_nc_ss=7f20f&oh=00_AQCZUNpPOqNlKKg_BoGmU3LQxlQELAUbyR1lOSYqHv0xhA&oe=6A53ABF4"}, {"file_name": "4.png", "id": "1281138177038706", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820382_1281138180372039_2529110020727967521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0leZoPbr1sQ7kNvwHRtujo&_nc_oc=AdrSdYyvpq06B-f3QKCOoD0OxcZ564mq5FLbTNjOB3IHeppvTuajFNbitJrpy48UpXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW4GmF9wZifsRXtlXF-Vz0NU2TQFImWOK66Mp07BKrrg&oe=6A538892"}, {"file_name": "3.png", "id": "3650517895081420", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300574_3650517898414753_1677688664230829638_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3kXmyru40gQ7kNvwFVJfKd&_nc_oc=AdrQuNctBgYdblfHFgDc1XIWBW5I6xmhuuDWYBgo0yvi5HbDDhx6LyDesj9WI8Xu1oU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMUCmi4sXdsOuve_wmUmlTGoc_JFJHctY6Y1Rc_2LlPQ&oe=6A53847D"}, {"file_name": "1+ ss.png", "id": "1114758320230218", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819980_1114758323563551_4416159141420860559_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukaoL0S3TjMQ7kNvwHseoCP&_nc_oc=AdpVnL14nq_bx_8xd8U5-uQkQeyQRD57mc7SHt3xNENourW2d-4LBjpVnE-7KZlKIFY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNM3zz-gc4fmhknlZpiJk44tKQc-sATQioj8bapcJ1EQ&oe=6A53A21E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Toy Factory Rush VR", "keywords": ["Toy", "Factory", "Match", "FindIt", "Puzzle"], "long_description": "Welcome to Toy Factory Rush VR \u2013 the ultimate toy collecting and packing challenge!\nPut on your VR headset and step inside a colorful toy factory, where you\u2019ll work as a factory worker racing to collect and pack toys into boxes before time runs out.\n\nThis fun and fast-paced VR factory game combines action, puzzles, and time management. Your mission? Spot the highlighted toys, grab them quickly, and place them in the correct box while the factory conveyor belts keep moving.\n\n\ud83c\udfae Features:\n\nImmersive VR gameplay \u2013 feel like a real toy factory worker\n\nCollect toys like teddy bears, robots, planes, and more\n\nFast-paced factory action \u2013 pack toys before the clock runs out\n\nChallenging levels with increasing speed and difficulty\n\nColorful 3D toy factory environment designed for VR fun", "short_description": "Step into a toy factory in VR! Collect, pack, and rush to box toys before time runs out."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253917684230178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_1282793222712188_5863144523505531560_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHj-MzhRPCoQ7kNvwF85eea&_nc_oc=AdpCUACTv8D-k2y9RyJFaPxMBQQBewALCMxjvMjshbS8LgYsHAvL9Ify-K6pipiqWEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5vvUekbjdpS7dWHnGlDcLiQnipR6_Zd9kxkQp1sDnqQ&oe=6A537BFA"}, "is_concept": fals
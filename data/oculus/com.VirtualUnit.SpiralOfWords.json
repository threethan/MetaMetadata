42-u9iXkPx15AR6bkAAMUNi4ImM_KU05ehw4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNWdMBeO_oX481Vu62JJ0voO8m0fFBBSAn9DhcmlDvTg&oe=6AFDB6B9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6UaQzaKwNIQ7kNvwGQkf3l&_nc_oc=AdrDABaMbtMZC3cCmTRKdYTtqAcWSNf2nKeNDtSaE7BZrRPxdRsB0CnjcuuW0SAJyro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS79bHZVgXU9-QMHadPJLDaTzXXE-Sx4-s3vL2-t3H-3Q&oe=6AFDBEEE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QApFhNT9pooQ7kNvwF247uG&_nc_oc=Adr74pHhk8jJlwIhzB-j4G9qCSgRToNfdCwQca9f2PbNZq-gw5zHo5t3vBdaRgQFy90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs3r_WAMkFgsNYjSFRaauIWDt4-I-xbBgLEvs-stXpIw&oe=6AFDD0B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7F1tq0l_0oQ7kNvwFITlHX&_nc_oc=AdqKVEbZN3jWhzmdnxH-F5qwKPfxyQpqCd2m1k7fNqR4mrXiI4_fBCNrnH7p68h4myg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCpmVtgdNOBDJVPiYobu0lHT145wuAF_e16ikVKe4KeQ&oe=6AFDC65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KJXj1xT0RUQ7kNvwFYyIM6&_nc_oc=AdrAJACpn6VCpoQPLGoDonoa82UtsDB_coVKyp9CEtT6IZ76aoWx0QaLxN208SZjHCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4t0AzGqpaQpdeG4J9VSWAwHkgMzaQMYvf1wGwU78Aaw&oe=6AFDB6EF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
dhk4jNoPluDnV8b0n4K50eb04eWgaxpS7vPoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpF3u6XvJ36PwUkO5DidKnbtnZ98dFaS_f5-mOHgMs9g&oe=6B0DC0F9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YStnPcWcgYkQ7kNvwEW_VfG&_nc_oc=AdpCQiyzC7bs-OARv0TddC_Bh5EUy0IYqlE_TsYb9UgAkK4q1lFAq7XD5EcGN7fSA1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-bC5umXZW0frL3egT3RtyTFlAObVNdJqFJ7XGTCZrTw&oe=6B0DC92E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syU0IocCqAsQ7kNvwHUel_-&_nc_oc=AdrHF204H2Z8C6F70Ddkjn3NUcglnQwmNthRyMwG9vViRHK7vN3WEjodbO-DuuWbp5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLe3VWSr1fTIvmnt0Is4e-bucP4WwPFM81wecBXQydRQ&oe=6B0DA2B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE85x_nMgOgQ7kNvwHQ-_9B&_nc_oc=AdrDSkVVlOYjNiICms2pgJSRpX4BH8oJj-3AKAjl98a0Ref4M9ynnP-mXQjxlzDXP8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_smshDKd2FEPI96GzvAU6H4pWkyWUXuyOmbzDbIniFA&oe=6B0DD09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mblXtuZd0F4Q7kNvwErV0-R&_nc_oc=AdoKJj6GVg2TGzI1-3DLORSoWntLOOTxYBDX5pGrisRczWkATzB9MfPSpdWRRvQoN1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4ELtk5XXJDrNNx9Hz7g3q9naMzKix5q4rifmoRU0PfQ&oe=6B0DC12F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
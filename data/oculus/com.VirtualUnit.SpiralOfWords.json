FzfCsEkL8VV7gemvlfCnq-iZ-QhuyH2D6W_qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkHBT4wlpalWEavJBtRcwiQ_LnpRQRyXpbjaO_tvo-rA&oe=6AFF0839"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kmmXaiXt0QQ7kNvwHmBNiq&_nc_oc=AdoqqH-yG_w40Unw1NQ8dSlXH0oQVq83Ede-O5ZxMpODaHEbCXPAWlCMiyErD05b_Ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvBmySNaXGZJZDTtvysWm6egK9CeHTG3qnGmURxZj4Pg&oe=6AFF106E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QApFhNT9pooQ7kNvwHkcfni&_nc_oc=AdqEniHgw1MZS9LvnwVk92X8etZgYjcCNAHe6CHQ2C-etg9xuX-PM2dKog-N0fZK4kA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA3lqXewqN-lYg0JG3KT_7xDh7dj-fvTl3HLyBjT3Rzw&oe=6AFF2234"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7F1tq0l_0oQ7kNvwHvAiBC&_nc_oc=AdoAHVQOEmv-i_PKbbTiYOpkmO0NKB_AwP9QM6e712P2-CUCFr3wgQmgrJcXZX2y0ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG20dsvHyCTHVHMmkrV6f4M1j22f6aW4HmyBqvYd7VNA&oe=6AFF17DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZmh_O1oxbEQ7kNvwGU6t2c&_nc_oc=AdoJlqTDqTEbykmz3AIeyslvDZicTnT3UXsGHLH76EoGMLcBZF7JupEVnmpfiO1hTqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBVCETLM3KA4UajuzoR0c3JbkY-KMsjF_IJFPbNcncQg&oe=6AFF086F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
R11FlHhOyFt_7navD6mfnxD7ZIHT6lXOxZsxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlYlxcLIM1wfnq1BKn_7tJGmeE5TNa9YQ0S_ma49Z4qg&oe=6B072979"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb8DPpnuwyoQ7kNvwHnx415&_nc_oc=Adr7dKAwf9OGEEFh2I5FRsoQ5y08QuFbHcR0Ucy1twYPxb9YS3AyYL2-Rs0kTGt_45E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdYL-_Ery4AfqWiyqj6SFwAqLLkhKdIv0CXQRsMsrV5g&oe=6B06F96E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H97Bv36Bx9YQ7kNvwFpA6eJ&_nc_oc=Adr60NHbYcuxaraUUKh0grKwBPlD4a-HlzxKza0NxiUzAjGjgVvCgDCyJa3hcpeiknw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZDKjX5vB_0DBme_1tEJe28VtR-QvnMWuvFbOq5KudCA&oe=6B070B34"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFOVGFEoiU8Q7kNvwHWNqqO&_nc_oc=Adq5Vgou3l8T9URRvYDc-uoPF9rXQrcdMXIvURShZnFTQ3oZ5nL3IFfAFdLEitKU5QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLf39q88DhczRnTz-A-IXZ_9QYoAjAcPZvevghzU4trQ&oe=6B0700DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPDl22HZYHAQ7kNvwHMRwk4&_nc_oc=AdqHd6h4G5kCLqEynmS4pneh1wil-VWuyZAU_qwBekDTSBgZahetH3ynxV9zbZlwwik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv1XwVNYqCvT_M6scsjpRY_FsKZovoUwt-5v7YSbW1SA&oe=6B0729AF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
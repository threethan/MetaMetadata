FgV6wVE_PLdRq48XiNXaKdRTLKB_pkOUtSD-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS02wJV5p1TgwgHC-UjxG6w3uS2234BbEoHvfiZORqBSw&oe=6B0842B9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb8DPpnuwyoQ7kNvwHL6t5-&_nc_oc=Ado96E4wXEKZfD83-Dxt5RT-DavOu9uXUO3kzXI_zdAqBkV29UoJjF7emnbppNqqbKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVwtHgL81wc1plnmq53Yjl0MET_H_ATgjYq_ZNC54Tog&oe=6B084AEE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvOedEtxg9YQ7kNvwFEhofs&_nc_oc=Adr0JkHc_kVNaaW4jY_525s2rZ6kZrvIcTSSGGkZMdFerrtjQwlVSyhJwE1T1-kvZ5w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa2XULesOdL5GQytv8JsoKI6OCHwTo2nYovK4z5QGW3g&oe=6B085CB4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqlh5U0vyrYQ7kNvwHpYmYh&_nc_oc=AdqJyQ5-sJ-Dst5VHfW1EV6a7_It3SQQLvMaI1wvCKlhqBYeaYAJlW-56CI79gwuwfQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo087zJhZj83lNByMTDMiRTF8KhfsrZcukLxpsFvhnPw&oe=6B08525F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPDl22HZYHAQ7kNvwHl8gnS&_nc_oc=Adpx6dz3g3BssSP-BuP2lqtHXN5HaOa-taK3OknB7i_D_eevJ1EDt_0DEyRqezk0OLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUp_19g1ei1g3jWDNkqJmUjvEKoqEIsNd9-dTl6F3_og&oe=6B0842EF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
nPRxhtiw38wVC4r6VMTg_z0FDhZN1oODRMGuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDlG-XBICjm6zN_toH1qy5dsXkUZBkWDH8j1Wb4oKrdw&oe=6B0C6F79"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YStnPcWcgYkQ7kNvwE0i9vV&_nc_oc=Ado6LCRaej6vdNtrkDq2o6JBzD413rEMy0bUJSfU14beNlEQCwT8bvFk8Up10YoQ_gM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSscuceYg3CgPAuXoFvNCf5DGWpVkXLHvNBQYrFatEqUQ&oe=6B0C77AE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syU0IocCqAsQ7kNvwGAOCLk&_nc_oc=Adr5gFttSM2Kql17O20zsDBu_3x96PMjIs5uFw-Nd7lzxJO3w5DKwGnHV3VlO2zf59A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbAO7OKueWCJk2gmM8lJY7mSK3eCRylUkKF8z_tPmTBQ&oe=6B0C5134"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE85x_nMgOgQ7kNvwEy7mww&_nc_oc=AdrzVb47r4jEpp0HtgutJ46Ite6zncWGXVxFcnjx78PMEu6UdjmDqeWAjI6xjMY_mx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8DvYM_bIknHK97JjwrK7E7aQ1I-WCToKZb3_l8OY5tw&oe=6B0C7F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mblXtuZd0F4Q7kNvwGJYsNb&_nc_oc=AdrzoDqYD-nNrBjLVXD4ncfXA9ygW7x2KLCzP0XpOt5beLR7XfubBMpyHGd42dY2qe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFIB2U6FkYQ8XBh2pokzZEKrYfIS3kZ8xlSaDtl0nBnw&oe=6B0C6FAF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
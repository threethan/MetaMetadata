ZhL7hIxCECmIW06Zc-PYgWH2Ui1PdYhsJA4b0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDo0LElC9o_u7WQpydYI0zXSZOjBTjWmn4ral46CWvew&oe=6AFC6539"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6UaQzaKwNIQ7kNvwEJd8Nj&_nc_oc=AdrML-DtcOBVMsOaUsY8WkY83ynLu6T3aeRuCIj9F3Dyp6atpTmGHWbOLGb3gyQH8-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUbJsbGIaBTCFv-2et88j8-X01nXlwCdmMwwH0He2sGg&oe=6AFC6D6E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QApFhNT9pooQ7kNvwHxCsi4&_nc_oc=AdruXPcUr8wzBHtn_tbRBqCOJOmm-421lYdfJXFCyRZpRNva8M3ymnZjgjQqTb7iVP0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJB6sM9wRr4jo4JsKpO9-RRPhFVr7qI0bHevbifu38PQ&oe=6AFC7F34"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7F1tq0l_0oQ7kNvwHXEWDZ&_nc_oc=AdpBophjUPRqLqe98FA0AVDetJoOO0qG6z1OV6TqAyfKFJRO73ebh8031GTvwIw84Zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzRGbnhl20mAKA8NmFQN2JsE9DFUM3MTMRLHUba8LI2w&oe=6AFC74DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KJXj1xT0RUQ7kNvwGd45XC&_nc_oc=Adpo0ToM84OSB1eMKKVDSQBIIW7SKwA2U-0fAsdB_SRBHzFD2BXlqlIFrm_4rJkl1R4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz7ar0JcVLMi6vnCRqY7Iq2CAos9CJ0Vybyp4f5OeLmA&oe=6AFC656F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
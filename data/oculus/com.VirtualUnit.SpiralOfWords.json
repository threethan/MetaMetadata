WbZJw6Vp5YQYHo-TdNovLFBMuHGyLh_9CCHjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_Refmc2Ai_ltSGdclzvXhDToh219pO__5owdimd8ilg&oe=6B1063F9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cNW0_O01bgQ7kNvwH2oxsO&_nc_oc=AdoVNWdqiV8K4wi6DDI8Mso-8Qu06nMXlL-XlwLl5_H61sSUOWmP3WmE_a9ASPuqMe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxQc18DwzWLT09m2o4vrjXxGMwVB3wkqSHPQfw7LjUzA&oe=6B106C2E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXy9JSvVJb0Q7kNvwGrgJBY&_nc_oc=AdrabRdUyAIb3siA_3eGEm1qo0q89wlw7zGJZCc9JI_f8anz-zAnhPdPt3LuNxs8W0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVPbGrPZSBAmuPf6SONg9apJYT3rP1T674OlFJc-caVg&oe=6B1045B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xli28jTCBQQ7kNvwEN96bW&_nc_oc=AdqCJG6qQLNduDCOpY-chlJdGMKEXtZ-M9SBHt8K-Qw3vcekWSHF_kdxX0BO36MLsW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaB5aVVRAiOilIcH9RBicGAgpyVaAwgDQHcsAFQqypyA&oe=6B103B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BrEF79ACXAQ7kNvwFjmi_-&_nc_oc=AdouTp1qvi3A4wAKKCfAoMNjZiaoFB-cfkry7HgV3NPCef7Up2um55CJQGpqaUHqmhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVn4nkXVIHUJ4qPkk4TBVe1HnYv0dMLgDEP_snSCMpxgA&oe=6B10642F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
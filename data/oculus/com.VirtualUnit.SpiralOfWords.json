krBTf-yG35Ro5fDQ4_YO073EmhSNkj1WIK3cA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiT8sTtjr9E2AmFNGKB9US8XbuswiK82a4LN-m6YJCLw&oe=6B05D7F9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLKPw-AOPOMQ7kNvwFiECkf&_nc_oc=AdqmoEEWmP0llbvKmoa66eTeU3OySt_2iIS1hYxmK9BBPJQffPLXjym50Dz-jfqCG5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPCtonlFML0rurpwM17EipdPyxpaCZcZuFmHXHKf4WMw&oe=6B05A7EE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H97Bv36Bx9YQ7kNvwF9MTpW&_nc_oc=AdonCNhRZmrDnwNfDC4mfDAUxHM9etV0ah6wvh-iy8DBaEHhI-zelHDIrcI50fzUZok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNASRf6AJrYX_zY80eigyUSZ1qWnlm7_Y0XJFL4WFg5g&oe=6B05B9B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFOVGFEoiU8Q7kNvwGdijRd&_nc_oc=AdrrwRZMI4rskDZ_FCc6GdY9jubNI8cboc3mhwdtbncwz35GDdY54O2AeIIECg2q4nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0TbpYWqRglc8sTu7wj2XnvxirbP-7nL30TH1Z3YcsGw&oe=6B05AF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz8ZIdwJmQEQ7kNvwE6-ZhW&_nc_oc=AdoofMm2bR10fC5MNIRlOHXHgPSTmaO6f_UeE1oWvFMVDscyQjPkx3cgjF8vG7b1BqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM2bLInytR0OFQY9ai_tu2DJ9-D2SCCYhRyStIyiSbKg&oe=6B05D82F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
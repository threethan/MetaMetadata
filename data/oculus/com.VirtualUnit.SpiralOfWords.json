O-cLRoZb_kQdqtVI5cSv7vMQG8DXjqyU8kEEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5ci6jqXIwR2GXO09YwcKsfyiLx61P-e4LECVap0-gA&oe=6B0334F9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLKPw-AOPOMQ7kNvwGwrHIZ&_nc_oc=AdoCellxq2ilvX5k9CjpWJZOuqJ8gls4jO6_vjyFSy0lZxjArpTdLzlrKLKPJKZGTM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSmW-709-84dTTD7a4A-jSdw6qKxpxm9cH5TyUZxntgg&oe=6B0304EE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoOpvJsbVpQQ7kNvwEBpIgK&_nc_oc=Adro4HhVVWhX7s5VESp4uDuMi5BIz97rqfxhIYrgOXDk5MQFw0U_yBJiihnf8CUMmT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw_fXQR6v9IxxxZpIfpBoOSANahXcbKvC7NPZFt2gB_g&oe=6B0316B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VinNy7jQ5jYQ7kNvwFn0l_h&_nc_oc=AdrNfAtCc4L2GWOqHtPrLmaqcRW7vb_HthkCpGvdyzaAzPu4kQ8XPnIdcC76j3lv_SM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMZzTxksWiRVH9VpfSFxuDMcb_bUFJcBKm3frluQAM-Q&oe=6B030C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz8ZIdwJmQEQ7kNvwFC0yJL&_nc_oc=AdqAg38dyMA-J27bO44_7PHwrRASQZWF7iFDxYb-MpdisXE0Uqo18vEpPIxqi59_hJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXUD6lgrnvwSr3Z0ZSZwsjn1mqjwaF2uY7plrJwBztMg&oe=6B03352F"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
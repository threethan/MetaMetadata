66DAk293x2-2g-82ouqXUnfEoBvPMvkSCff_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGHKlQaSRDlw8kV3_m5-YPdsMJ-Usc4ZI4SgXpgdzoaw&oe=6B0059B9"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kmmXaiXt0QQ7kNvwHhAyLS&_nc_oc=AdpREJ0Th9g9lF7ovMAVr9TR45Aa75SSbEM9bpUTlR7dKMnpAb44Ka1hdg3AqO4v7Po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxIz8MmeA9L92vGeyYNtszJ46uJtaeUn6T2IRrgVWSnQ&oe=6B0061EE"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoOpvJsbVpQQ7kNvwG82PUi&_nc_oc=AdqAdtkCVdsMzfTRPbbwdD-mZFCHUX1T1zRw8QMDNpPZRymhhi3Bf_cPNFN7Iomlv4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOX50X8u6tvlebFfMlDY1PMr0n3-FcL6q_1fcNb-8TqA&oe=6B0073B4"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VinNy7jQ5jYQ7kNvwGmhMnc&_nc_oc=Adpg7hu--dVLo_2OF-SIoqz1JajNAx4xTB3_FuobFxJVHA1FjyNBz0wYDnmwd4mmjjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8u7EgfXeWW-5PcTO3aLQW5lMHU5Oikc-F8W-Tb3Zv2Q&oe=6B00695F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZmh_O1oxbEQ7kNvwFuFnVg&_nc_oc=Adr_B075buPVU1FNiw7f407XXQrFOZnSCeCSmlpqPuIgXgVpGZxy5xgEJlTyWMg4EzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfRchO6mMAXb91xCloJcbW2B7QWUpzUzvRxp7jBtZIMQ&oe=6B0059EF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
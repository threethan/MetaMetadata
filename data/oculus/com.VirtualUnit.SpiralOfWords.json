nDdfHgIhimbvB7yC61E6swKSU9rHyE44sS2QQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoC-06HgujmWgvKX0QFvaa-t1NrWjQ4qmDaRCtNxp5BQ&oe=6B09CC79"}, {"file_name": "Spiral02.png", "id": "1184671185675260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641341_1184671189008593_1755164618307935049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb8DPpnuwyoQ7kNvwHRHgYB&_nc_oc=Adri1Z-GFapISwzhLkWVCicU41oLM-VRN8aaNWfz-XWZJW2J-EvyMnEtkLSC0Nsuv7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4w2XuRo0GYQg9N25TD0t6A-nY9ivi22YKPpuvpMxJOQ&oe=6B099C6E"}, {"file_name": "Spiral03.png", "id": "379166224011112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234368_379166234011111_806351015372780360_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvOedEtxg9YQ7kNvwFfJO_I&_nc_oc=AdpPQOvA3lqxjLCNWK8TNr0zuhzHb2Zu6POaS2hLxmEI76PyxI1N_Lu7irpHI01jpsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpnu8yKKv3kyd85dCdFYrmwXXJWilaz7QQLHK1iRVVnQ&oe=6B09AE34"}, {"file_name": "Spiral04.png", "id": "764926327803641", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572936_764926331136974_704416787747095167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqlh5U0vyrYQ7kNvwFp5tVM&_nc_oc=Adr0klmWF88rYLD35O9IKwp_NLRwYQGUVQl7jC1O-wLTMYWkBXdaeCnUb7VRV4s-kUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXWMdNjUlebEvtCybZLpPCAbdQWuSJnl9XilAD5G289g&oe=6B09A3DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen-video.png", "id": "1002271754050629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262741_1002271757383962_7221491894489878929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPDl22HZYHAQ7kNvwF-kKx-&_nc_oc=AdrTYhO0eY45j9OqWef25dmSvlF-jh5V-S_TfJN1pplw3aDt06-8geMyCaVOgAYhZmU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_vJCF8OlhpSOTliB-Od1Ssovaoc68RFXhnZHcHUcYAA&oe=6B09CCAF"}, "display_name": "Spiral of Words", "keywords": [], "long_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space.\n\nThe VR project SPIRAL OF WORDS is a kind of \u2018artistic recycling\u2019 as well as an archive of the idea of \u200b\u200ba realized textual narrative performance. The narratives in SPIRAL OF WORDS have been partially modified, they symbolize the original idea in different colors. The project is refreshed, enriched, and different in relation to the original performance, it is actually a reinterpretation of a creative collaborative idea, in a way that VR media allows. And that is the direct interaction of the users, where they freely communicate with the given words", "short_description": "SPIRAL OF WORDS is a platform for creative writing in VR, based on an idea realized in 1998. Three authors from three locations (London, UK; The Hague, the Netherlands and Novi Sad, Serbia) sent texts at defined time intervals, starting from words to sentences over paragraphs to short stories, all this took place via e-mail/the internet, creating a common narrative in a defined location that built a spiral of words in a fictional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy-spiral-of-words", "developer_terms_of_service_url": null, "publisher_name": "VirtualUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922
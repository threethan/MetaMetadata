 arrangements established by the organization providing the content.\n\nDesigned for supported Meta Quest headsets.", "short_description": "An immersive VR player for medical education, delivering organization-provided 360\u00b0 procedure recordings and related learning experiences on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://number9vr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WRHVR LLC", "support_website_url": null, "website_url": "https://number9vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1434007103129588"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1119344464133013"}]}, "baseline_offer": {"id": "1119344464133013"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794247200, "status": "PUBLISHED", "id": "1119344464133013"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1436510579545907", "version": "0.1.3"}, "id": "1070045236067150", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1434007093129589", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary",
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1129336016249307_2613862013919464289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exU3tpzWD-8Q7kNvwF2Rs_T&_nc_oc=AdoJdXjcyaXRw9DsvCL4N7kI4jF9T15Lho4rEP-HgPy2FdRL7gwe-NNFYkEHOsxwCEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNWCaOu1SOPSVl7BIy4HvXNmCSUUJi88t_wUXodGZrQQ&oe=6AF89D21"}, {"file_name": "Number9VR_XR_Player_Screenshot_1_2560x1440.png", "id": "1151458407648703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_1151458410982036_2184781968705260387_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHIYcUTlcMYQ7kNvwFUjhF5&_nc_oc=AdrRAVMx5BNU3oQSPyAn6Yenn3yHCXODxp6xeMDwk48MdSnYNXJmqtjajHrrZdOJydQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQResu3RSn-zj6Gi3LwvD8Ko1btdHBBisej-EzsPJH6yNA&oe=6AF8816B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Number9VR XR Player", "keywords": [], "long_description": "Number9VR XR Player is a virtual reality playback application for medical education and professional training.\n\nIt gives authorized users access to 360\u00b0 recordings of medical procedures and related educational experiences supplied by healthcare organizations and other content owners. Depending on the experience, playback may include chapter navigation and picture-in-picture views to review additional procedural detail.\n\nNumber9VR provides the playback technology and technical infrastructure. Medical procedures and recordings are supplied and owned by the respective organizations or content providers. Number9VR does not create the procedures or claim ownership of the medical content.\n\nAccess to experiences is managed according to the distribution and authorization arrangements established by the organization providing the content.\n\nDesigned for supported Meta Quest headsets.", "short_description": "An immersive VR player for medical education, delivering organization-provided 360\u00b0 procedure recordings and related learning experiences on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://number9vr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "WRHVR LLC", "support_website_url": null, "website_url": "https://number9vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1434007103129588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1708383704631195_959936521975290514_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flSZGlISSdQQ7kNvwHuVv1f&_nc_oc=AdoYyq5nb3-R5O0IoDF3HvaVcf5zNIOjcF7rkmqL7telOf7m0stwv3GImpdMlQtjwhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc46O5QqqXiYr2xtvNMfS7r0Xe75MvhfXqPkekgaoRCQ&oe=6AF877C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Number9VR XR Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1794247200, "lastRevision": {"nodes": [{"id": "1434007109796254", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1434007093129589", "is_first_party": false, "enables_in_app_ads": fal
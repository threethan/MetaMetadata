86994926993193088_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdMCUdT5GLAQ7kNvwGCUNZt&_nc_oc=Adqe8ZcOQywVAs0oOyPS8SKNCbkx0TORnDsu5sOkhK4ZXzFiGJrTPvCIXhuk6O-8n-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyrdo7Uv4Y9uGTmrpojWBbor2gH-0UH4FKOSeTmoqAGQ&oe=6B030328"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-54-08.png", "id": "1100326078785018", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_1100326082118351_6140300199398715419_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVJ3a1hThC8Q7kNvwGnyKM4&_nc_oc=AdoaCjQjGaxVZNSUxllVbxVmzYw9YD8bPAqnz3glx9gNs78dfc49mKojLRkgV_saB1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPt4f9Q0jFuKlCALbd7wZK0HrUmC2Pm9ruSwwZcPqqBA&oe=6B0329DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ghost Game V2", "keywords": [], "long_description": "Become a playful ghost in Ghost Game V2, a fun and energetic social VR experience designed for Meta Quest. Move just like in Gorilla Tag\u2014using your hands to walk, run, and climb through unique maps.\n\nHang out with other players, make new friends, and customize your ghost with a growing collection of cosmetics. New maps and items are added regularly, so there\u2019s always something fresh to explore.\n\nIt\u2019s all about fun and friendly vibes\u2014but don\u2019t forget the rules. Break them, and the vent ghosts might come out to give you a little... reminder. \ud83d\udc7b", "short_description": "Become a friendly ghost and explore fun maps using hand-based movement! Chat with others, collect cosmetics, and enjoy regular updates\u2014just don\u2019t break the rules, or the vent ghosts might appear!"}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4675c9bf-9126-43fc-9526-ac055c2b3433", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": nul
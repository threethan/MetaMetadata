9K5ITQYxZiX_lNWqTO7SKrhMQ3IHNIXWNg&oe=699996A1"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-53-56.png", "id": "1240330707648071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302735_1240330710981404_1960853374604569846_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHfMUYeopnYQ7kNvwETr5Sb&_nc_oc=Adnyn3zqmk_Z2IavCwLdpWEnoi-xcpV98DGXmMncKsrCTMJMzc6T3adpbOVmLvkxcTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSQn3T_kY_qttRKvQE0lJfpYtbtonsyTDbEWj0zxvCkw&oe=6999A0AA"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-54-03.png", "id": "3559080100900736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310885_3559080104234069_7286994926993193088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li02gbKPtT4Q7kNvwHElUMT&_nc_oc=AdkpbHAElZUDnvobniRcq5xLbhrdg-VbINlIpbKZs5kcjs85s9vBfLgf202df24d908&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuWHSmM5Vlui4XEgC1NZZsQxq5m-Ks42oQDAs_5wdttw&oe=69998FE8"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-54-08.png", "id": "1100326078785018", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619672_1100326082118351_6140300199398715419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A2RVM00CksQ7kNvwEUw0aY&_nc_oc=AdmTAk7A_QFK5vUoMtbFHWvYEWBl1HY4XpWfnnMbCmZ9D6diS4UGp0faQ6S1gMoxuxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkSn_nEbNelc1upMVOZtaAQ6WlvanbQxgwhKLqEDJ3Fg&oe=6999B69A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ghost Game V2", "keywords": [], "long_description": "Become a playful ghost in Ghost Game V2, a fun and energetic social VR experience designed for Meta Quest. Move just like in Gorilla Tag\u2014using your hands to walk, run, and climb through unique maps.\n\nHang out with other players, make new friends, and customize your ghost with a growing collection of cosmetics. New maps and items are added regularly, so there\u2019s always something fresh to explore.\n\nIt\u2019s all about fun and friendly vibes\u2014but don\u2019t forget the rules. Break them, and the vent ghosts might come out to give you a little... reminder. \ud83d\udc7b", "short_description": "Become a friendly ghost and explore fun maps using hand-based movement! Chat with others, collect cosmetics, and enjoy regular updates\u2014just don\u2019t break the rules, or the vent ghosts might appear!"}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4675c9bf-9126-43fc-9526-ac055c2b3433", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1e4yA6IxbwAxySxGAGqt18O9y1NWA_OEVsYnkkS0Ml2c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24168097596149224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_599441682760084_8853510790833014537_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X_g9-W6PyQQ7kNvwGL_YKp&_nc_oc=AdmKAIzGJ5KzLI8qY1aW8fjm6NUcibHrKQn5fcTTrzft1sEQu4WaEwGzz0-0yOiSVtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpGq_bT_JW36MKgBiBklH6L7p8oIg6O-Iu1GYXBL_2GQ&oe=6999C041"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ghost Game V2", "pla
f cosmetics. New maps and items are added regularly, so there\u2019s always something fresh to explore.\n\nIt\u2019s all about fun and friendly vibes\u2014but don\u2019t forget the rules. Break them, and the vent ghosts might come out to give you a little... reminder. \ud83d\udc7b", "short_description": "Become a friendly ghost and explore fun maps using hand-based movement! Chat with others, collect cosmetics, and enjoy regular updates\u2014just don\u2019t break the rules, or the vent ghosts might appear!"}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4675c9bf-9126-43fc-9526-ac055c2b3433", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1e4yA6IxbwAxySxGAGqt18O9y1NWA_OEVsYnkkS0Ml2c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24168097596149224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822883_599441682760084_8853510790833014537_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em5q30ykvWwQ7kNvwFVr2Pb&_nc_oc=Adr_jcT2TYpGY8vu4a7IwKty2ftv3PHwPX1G7-WLYuPX1ugBrXuJkJ54DKZWSM7xf5s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WrMT5lsDwV
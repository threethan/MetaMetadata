lSsb3mK3K1MWCVQxvkq8nPUsjGfD32uv3w&oe=69F0D1E1"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-53-56.png", "id": "1240330707648071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302735_1240330710981404_1960853374604569846_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30SPEptpaYkQ7kNvwFb3Oxn&_nc_oc=Adp5ksF_D2vShOUab00RoVJvAP9m7k4PG-iI415_12CLF6asWhBjFgXv3Qz72boNmVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0wihnf-X2wbeWy8RFjoUHouhIjFvF-maeQf690O0hx1g&oe=69F0A3AA"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-54-03.png", "id": "3559080100900736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310885_3559080104234069_7286994926993193088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym302bfAHRkQ7kNvwElcOiz&_nc_oc=AdrZC1jEtDOwGV0wtC5a8F_QFOH_JoG0qThuhHOD8HaXq9pzpxWD_o-3xwL3oG-yi7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2yAI02Pb6v89qs7Y-9PF0aTgBOKqYb8zJ08Yi7IYCjeg&oe=69F0CB28"}, {"file_name": "SampleScene_Custom..._18.06.2025_12-54-08.png", "id": "1100326078785018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1100326082118351_6140300199398715419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNlBAMyWjxEQ7kNvwEyjkFu&_nc_oc=AdoCJuKeznpnD59gGAc0QVC9S1ZQ73zD6TxdNSfH5TkgHBeArjjD8D7M4mLS-4Vx0QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2_3VjnZLLJR0PeabyM3Q4a7Wr3w6CcOg-CWII7b_FQTg&oe=69F0B99A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ghost Game V2", "keywords": [], "long_description": "Become a playful ghost in Ghost Game V2, a fun and energetic social VR experience designed for Meta Quest. Move just like in Gorilla Tag\u2014using your hands to walk, run, and climb through unique maps.\n\nHang out with other players, make new friends, and customize your ghost with a growing collection of cosmetics. New maps and items are added regularly, so there\u2019s always something fresh to explore.\n\nIt\u2019s all about fun and friendly vibes\u2014but don\u2019t forget the rules. Break them, and the vent ghosts might come out to give you a little... reminder. \ud83d\udc7b", "short_description": "Become a friendly ghost and explore fun maps using hand-based movement! Chat with others, collect cosmetics, and enjoy regular updates\u2014just don\u2019t break the rules, or the vent ghosts might appear!"}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4675c9bf-9126-43fc-9526-ac055c2b3433", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1e4yA6IxbwAxySxGAGqt18O9y1NWA_OEVsYnkkS0Ml2c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24168097596149224"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822883_599441682760084_8853510790833014537_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZawh5rgd0wQ7kNvwHJWwJY&_nc_oc=Adpai4soPZNw2towOOQWZ-5O7egmw2gELEWp76-_CAiGl5ihg8YEBnr0RqO3Dv3fvI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1290W5oXNJ6Je67h77asn1hKDzBfY40l9HKpIF-2BY9Q&oe=69F0C341"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ghost Game V2", "pla
57_1241680448098736514_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEn2Tk36uQUQ7kNvwFDTYBP&_nc_oc=Adlcj5Nio9oWFKmqXZLOeA8yWMS8U-2GNuM2fAxaWlFK3CmtHR_IPMazceFQC4sf9O0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbzTdAKomvcEisbDXky0uv5Ead_swnuKH8JuoXEYiTcA&oe=69A41BA3"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "512418207134025", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035315_512418213800691_6351743728904448576_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQkoLHuE1eMQ7kNvwEhadLj&_nc_oc=AdnB0xbvWeiE0sc_Jq34g-EV7TFhCTvdHBvzGS1GtyA4dlslnIPoJIVs_2ycz4GEt1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8FPAYExjF7toEiIm2STaqilRxDONj3BFh6Z9N_GeNRw&oe=69A4300E"}, {"file_name": "512.png", "id": "275470684535859", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982580_275470687869192_3200725871982560911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZNS_l3CzskQ7kNvwED0pP-&_nc_oc=Adkqj2vxh7htOw-pgofFcxcTdvO8VCwXfN97GsxkF0ZiJoryIio4WZJBvfP0dJWtH0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftP7vYbsM0O3_q9fI82cgjpldZWbb6sbDrhybpZnMooTA&oe=69A44BE9"}]}, "id": "3201778793429512", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "izneo", "keywords": [], "long_description": "izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nL'utilisation de l'application requi\u00e8re la connexion \u00e0 un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nAcc\u00e9dez \u00e0 votre biblioth\u00e8que izneo en vous connectant depuis l'application.\n\nLisez depuis votre biblioth\u00e8que :\n- Mangas\n- Webtoons\n- Bandes dessin\u00e9es\n- Comics\n\nModifiez l'environnement pour changer l'ambiance de vos lectures.\nUtilisez les contr\u00f4les Oculus Quest pour zoomer et \u00eatre au plus pr\u00e8s des planches dessin\u00e9es.", "short_description": "Izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nPour utiliser l'application vous devez poss\u00e9der un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nConnectez-vous \u00e0 votre compte et retrouvez vos albums \u00e0 lire en r\u00e9alit\u00e9 virtuelle dans des environnements configurables."}, {"images": {"nodes": [{"file_name": "1080x360_bg.png", "id": "1205263993211836", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_1205263996545169_9148883512724487229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXG9bEQxEH0Q7kNvwGXYl0L&_nc_oc=Adm9JpjHotDMKYcC_iZffWilJkgSNXvXByCYqo-899RX30r8zerb-fEfmlNAv5dNqWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftlFv-cMyvNNojMrp5B6tBb88NZ12ayVQWMsmDEufAEPA&oe=69A42174"}, {"file_name": "512.png", "id": "1050334919080944", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984471_1050334922414277_3741888985697961122_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VPHBmW9CbAQ7kNvwEBwyM8&_nc_oc=AdlifiFukkhvhC_7Gldvmz6qBSgxXGDqKcQMJ9TKj2r5WqVhB5jEbCYyD_6AeGKeraU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftLwAJxhlPzdD2z9Oa5bfXjLxP7nwXSaNtwomznYI1i7Q&oe=69A422D6"}, {"file_name": "2560x1440_bg.png", "id": "715429989842664", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982580_715429993175997_4462372464006952430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3nzCy74RaUQ7kNvwESjHqk&_nc_oc=AdmirJxaCMFH8gEGx6Wr-59iIc-CxBg1WeZBl5qrWFCCFl9Ovbs5PvLBcWJz00KxXFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afugo0b6pe2AElsW0LtU7Eh3oXU9DhUxPHc8zasSorQvHA&oe=69A437F7"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "629709414781356", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_629709421448022_713197402145434487_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_
57_1241680448098736514_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKFaoUHi5ywQ7kNvwGH-xC6&_nc_oc=AdmDRds-wVtf3N-VX64P-KD_Y1lgfhD0LUd30RvvpTODAwwUVI6EqR9joDxwTvqXbJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOe90HAcj8girqLOUxFjVTo5XN6A0v_-GWvWsEmhbuhQ&oe=69998FA3"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "512418207134025", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035315_512418213800691_6351743728904448576_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY0nGrJsu5EQ7kNvwFOgz30&_nc_oc=Adn41mPqfIG08V_-EFgaJg1UTNipqVR7yuvKerQH1X-MiFJWGloiEXJpuqo79siOFcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthOFwTlrELZAWoqi-ByqPNFDVImQaLOPC7iHST0R37Ig&oe=6999A40E"}, {"file_name": "512.png", "id": "275470684535859", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982580_275470687869192_3200725871982560911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfd-S8UhurUQ7kNvwHfew_m&_nc_oc=Adm2Eqj4Sve483A_EZoGzOJMNN9IyZ74wjVvu6r28vv7375RGpTT9nI6oZlnarFeij0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7L_yD1tvEmFRacNtYJVys6SAvess3cEqOPswEreAeiA&oe=6999BFE9"}]}, "id": "3201778793429512", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "izneo", "keywords": [], "long_description": "izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nL'utilisation de l'application requi\u00e8re la connexion \u00e0 un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nAcc\u00e9dez \u00e0 votre biblioth\u00e8que izneo en vous connectant depuis l'application.\n\nLisez depuis votre biblioth\u00e8que :\n- Mangas\n- Webtoons\n- Bandes dessin\u00e9es\n- Comics\n\nModifiez l'environnement pour changer l'ambiance de vos lectures.\nUtilisez les contr\u00f4les Oculus Quest pour zoomer et \u00eatre au plus pr\u00e8s des planches dessin\u00e9es.", "short_description": "Izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nPour utiliser l'application vous devez poss\u00e9der un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nConnectez-vous \u00e0 votre compte et retrouvez vos albums \u00e0 lire en r\u00e9alit\u00e9 virtuelle dans des environnements configurables."}, {"images": {"nodes": [{"file_name": "1080x360_bg.png", "id": "1205263993211836", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_1205263996545169_9148883512724487229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8-P0qnr3QgQ7kNvwFakEnh&_nc_oc=AdnXp968Xw-twOS1Gdh2HmfUijS39Tgy2jwdWddIk7SprFPjmmBX2CMvq8Q1lXGen8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afva7VE4iE20pgSj_P8qHSOHRgzu2AJ4L2aDDzBKHQgayQ&oe=69999574"}, {"file_name": "512.png", "id": "1050334919080944", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984471_1050334922414277_3741888985697961122_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbME1T72QrYQ7kNvwFPSqdG&_nc_oc=Adl86V2Pluo1eOSbWl7KSxlY4R6wq3eaEgzIERo2sP6hrF9kM8P3Q4zAYHJ3qflVslE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLAHHjHHtRgM-i2y3CWzJ82L40zmnvbJ2mbqOnYg9nUA&oe=699996D6"}, {"file_name": "2560x1440_bg.png", "id": "715429989842664", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_715429993175997_4462372464006952430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhiZw64gnR0Q7kNvwHE60EU&_nc_oc=AdnCuTVD6c3galLL6HLftXIqVb650dU02a6gXaqmFUxsd0DK1Fy2rAzK0uZSNeU3gqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSX7aqe6RFTzh6TUKMlDD0MgV0LMz4lkZ0IdZQZjZEiA&oe=6999ABF7"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "629709414781356", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_629709421448022_713197402145434487_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_
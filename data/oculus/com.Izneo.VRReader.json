mNc2uhz_U05RNL1qbzhE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vfYYA-8QDOM_tazqnLtpKr9yBPo3iVmlsEs7eApOAhw&oe=6A394569"}]}, "id": "3201778793429512", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "izneo", "keywords": [], "long_description": "izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nL'utilisation de l'application requi\u00e8re la connexion \u00e0 un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nAcc\u00e9dez \u00e0 votre biblioth\u00e8que izneo en vous connectant depuis l'application.\n\nLisez depuis votre biblioth\u00e8que :\n- Mangas\n- Webtoons\n- Bandes dessin\u00e9es\n- Comics\n\nModifiez l'environnement pour changer l'ambiance de vos lectures.\nUtilisez les contr\u00f4les Oculus Quest pour zoomer et \u00eatre au plus pr\u00e8s des planches dessin\u00e9es.", "short_description": "Izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nPour utiliser l'application vous devez poss\u00e9der un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nConnectez-vous \u00e0 votre compte et retrouvez vos albums \u00e0 lire en r\u00e9alit\u00e9 virtuelle dans des environnements configurables."}, {"images": {"nodes": [{"file_name": "1080x360_bg.png", "id": "1205263993211836", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982727_1205263996545169_9148883512724487229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UfeikxIQ3cQ7kNvwHoD4yc&_nc_oc=AdqiBQrv2YjlXd9eNPXx3LmWhK1tfgzHUr_sd81G4cczOfs2itT_q1ZWZRdzIXteo98&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hEGbD1FGYOJ4Qblb_w9hjQyhrmvwuWkn6Kh8PRyqbKw&oe=6A395334"}, {"file_name": "512.png", "id": "1050334919080944", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984471_1050334922414277_3741888985697961122_n.png?_nc_cat=107
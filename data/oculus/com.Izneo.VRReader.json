57_1241680448098736514_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM8Id5RdW9YQ7kNvwGrGVg6&_nc_oc=Adn5FmaNiLUF1rprPcSJ1UhhwMxXXHDzkMGRUekNtb-pvrJtowIPqOhcqsB4v4INmNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsUFsYRRzesWYfzJfPuQEhntjrF1taYLjkvWr0fZG-vuA&oe=699ED5A3"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "512418207134025", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035315_512418213800691_6351743728904448576_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2RkFxfMJQ8Q7kNvwHkR7q8&_nc_oc=Adm3jkNDxSZqIH980QP-ifTr1BZKkbkhG-p9NlBdtKNWQ4tz-ZymkfksYWqgLZBK3UA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_xpijDx4lS0uAXy-2E5VP6ahVyzS2EvJcifNb_GZa5w&oe=699EEA0E"}, {"file_name": "512.png", "id": "275470684535859", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_275470687869192_3200725871982560911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogqIZbjky34Q7kNvwHYV69M&_nc_oc=AdkoY7l37S6A17giPYPhWYGWESIO6R8PX5veDy-g6TwD4hIWoNSCqR2cphFHOdLZ1ZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftn6xuODSBnu2bjiCL9vvlmk3IrXt-nIZ1HFn6jymRTgQ&oe=699F05E9"}]}, "id": "3201778793429512", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "izneo", "keywords": [], "long_description": "izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nL'utilisation de l'application requi\u00e8re la connexion \u00e0 un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nAcc\u00e9dez \u00e0 votre biblioth\u00e8que izneo en vous connectant depuis l'application.\n\nLisez depuis votre biblioth\u00e8que :\n- Mangas\n- Webtoons\n- Bandes dessin\u00e9es\n- Comics\n\nModifiez l'environnement pour changer l'ambiance de vos lectures.\nUtilisez les contr\u00f4les Oculus Quest pour zoomer et \u00eatre au plus pr\u00e8s des planches dessin\u00e9es.", "short_description": "Izneo est un service cross-plateformes permettant de lire des Mangas, BD, Webtoons et Comics.\nPour utiliser l'application vous devez poss\u00e9der un compte izneo (\u00e0 cr\u00e9er sur www.izneo.com).\nConnectez-vous \u00e0 votre compte et retrouvez vos albums \u00e0 lire en r\u00e9alit\u00e9 virtuelle dans des environnements configurables."}, {"images": {"nodes": [{"file_name": "1080x360_bg.png", "id": "1205263993211836", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_1205263996545169_9148883512724487229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNaQtkWKdA4Q7kNvwHvJCYU&_nc_oc=Adkw18BIL1wwoTnOPC6Wa2yKnV9e-eE7ddrBTkym3cw0Js0q0QKcRjznWExRiunFEFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsE2hNHghwcjj3zA8R_nt4PKadAOda_8me-jYNjUvc4KA&oe=699EDB74"}, {"file_name": "512.png", "id": "1050334919080944", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984471_1050334922414277_3741888985697961122_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOIpGF3wOvgQ7kNvwF77fud&_nc_oc=Adm13U54-xgU8VYYhAKCBffjTNffFqphAgaeJE2EGhqGT8eIqj1iINWIwnP0MjjdIOo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsyT0b3wV9H_z9ZGoTbz7u3RilQsEbF79zfnxC8H_GhgA&oe=699EDCD6"}, {"file_name": "2560x1440_bg.png", "id": "715429989842664", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_715429993175997_4462372464006952430_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mawh5w-6lAQ7kNvwHlSNZI&_nc_oc=AdltsBwQGgzl4g7O1Au6zyvEDd2MZrz1RaApLxIs2GoaJa11-7vCpQZKIAkT3vPkjGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft39sA4s1G0cGSduPFi8fVufzPPpdVTFV-5NTOAqenFAw&oe=699EF1F7"}, {"file_name": "3000x900_pdp-art-safezone.png", "id": "629709414781356", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_629709421448022_713197402145434487_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_
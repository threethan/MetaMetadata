1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGY0VI-aJDkQ7kNvwHIbNw0&_nc_oc=AdqM2qiYMy3ndG1saq8pir5Rb0DcmmJLf4imkShKNFJ8BsstOADE7UUHdiroQdbZaZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqdcEp-qdjL72mUeCiGc9DEMFCvV45xEhvqrMT4_1Ng&oe=6A2EAC0D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UwNwzucoRgQ7kNvwFhaN6M&_nc_oc=Ado3hy04E1mtsFoWli4HfchC4vkLdVxWDDXOTN0VjrllOGTbBxLy_u8liHSBLpxcNLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p6mawcOgl239JBoohnggi5f3oAFwbG0xHDsdWW2xozQ&oe=6A2EB1BC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIGFeVRLXyYQ7kNvwHX2a9b&_nc_oc=AdpQPf38wI2seSM19_IPj2B-r8AbMnDr2EAJ8GavWEwdbIysOXTAJJvN6d0ebzP4hww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vP-Cbdp0UddhcT4piShBt031cpBX4YTmBRpNnZbImjg&oe=6A2EA24F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io4lAP-PbVIQ7kNvwGB10Py&_nc_oc=AdrbB-Ve5F8FMlynjDZMx8bfJaujHjvP4yBtWFz41mO77O6yktUFr6j4qmHsDZx2EIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FDPY1IX4N1r5nXmnYE9AEdLbgbh2xb8xHwLu7pRZJEg&oe=6A2EA223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEyYc5naeYwQ7kNvwHtBiAn&_nc_oc=Adp6uYS8S5xdV4ws_R3gcY_rGuqfYY1TM7gtTY0OXTzudp1pwYZAGu4DjSI6coL8q1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uimJz14lDqIyK2moRopBTsAVmaVcjQJnWgmYc7q82Qw&oe=6A2EB95E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
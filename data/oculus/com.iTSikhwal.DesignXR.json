1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CiA82U1oQAQ7kNvwE3M1uj&_nc_oc=AdqyEZuPob5EBIhYkQmzqvJvYQ78isiZNZbCjCF0bnFctsvGd0dCP1jkkLoCB1vo-70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWJUSPIUw3hcGr0vU64eTqENBxZylJrT8hj8AY6fMC_Q&oe=69C6858D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eub8apveRA8Q7kNvwFBhH8x&_nc_oc=AdoWHQE0KOJ1F2eFdBknkSzFnINsc0007Xa6tVQ4CJgCTTE5cPyRFB8eoC_UOKgN7GA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuYV5YeLenlLgcnS3pn-m8nMB2KPbbUmPfKNYGzLPtUQ&oe=69C68B3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTI7XznBycQ7kNvwFNjV3U&_nc_oc=AdoEuMSYqdrKISHTf7zKHHHKQVshtBLegfge_3paGBDWHT6SJOggS86IxNTfBPPrdaw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_kO5DZkpHnAKflR435RrSTvMNxr-XT77Gc8il_UivdA&oe=69C67BCF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wrxKjp7UskQ7kNvwE9Nv1U&_nc_oc=AdpGQGEBLb2CNc2phYTw7NGlUspIPbfZT_Ozfumb6fMZWAJL8IttWE-Li913jwfDAJo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxF9vkwpb1vAxr4P3NJfJexsIoIxkaeebibJIYtz89Xjg&oe=69C67BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65NdGguCuqwQ7kNvwEtjNtQ&_nc_oc=AdrMgBXuyxFV7s9rGjP11RfleeKP2bc_oju2-bo90lRRxIJ-6PQe2PE7hXoTZVgDQ34&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZ_aIGGkPlemh9scgRCtcR160mxpbNIZ949vq27VJUwA&oe=69C692DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
_sid=6e7a0a&_nc_ohc=FB1OY0PbuaAQ7kNvwFVW9Y_&_nc_oc=Adl62mPmxDkubMszvHRvEVMt8Vck1L5_OLgG1Kwpin_SSjpznq3asU6gwgzfsfYdvSg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl_r21NAuHL-EyGc3bHBMlJ2hNXVG5UtuHZADi18Ov9A&oe=69AAD60D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIbX16vEfasQ7kNvwHNYF9l&_nc_oc=AdnpvZ1HEWR5Y5m3ZFckNUG4_GbQIaGfAZE-N3370gSwRg8DUFaPGGZG70fe7hxyvYQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSA-cHPLsXEjGEA74PKHTjjnMNQ-LoWZLMG8kiKExUpQ&oe=69AADBBC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfiHFqnjP4Q7kNvwEDCVzU&_nc_oc=Admcx5i84Wx_BLQ3vZi83koTCZALUXiP_1h0ybK_IdPA4OLzLpf9ZGkdcbtq5_yM0gw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCxWpaT8oL5J91edI1-uN7ODPYzhqwQVetPV3ocw43mQ&oe=69AACC4F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GWBLhCj1EYQ7kNvwHr2iox&_nc_oc=Adkfl38j2eAcNyUa-m-H9t4m3EhE6TSe_Smw4cgdJSUZNYqzcJjDFt2f1J-C4zznaYM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrZkChzIR0etbW4fkglydG_qxiMa_kGbgeRzzmWfPoUw&oe=69AACC23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPHNWPBZXD0Q7kNvwGTY57v&_nc_oc=Adnxw9gi2dae2osUvJzu-rgMQMSoC34Rwc08S2YCjZufzDDBo-LiURJ71JnAbwTZAsA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwm7hFqredPn5piA-XC5zhVR0VhVZGRWrrXgN9mtxmXaw&oe=69AAE35E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tag
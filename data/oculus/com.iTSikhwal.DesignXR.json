21_5587971032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI-9ds-PJmcQ7kNvwFt41gn&_nc_oc=AdpOn_Z4JDGZ_m_eBpqfm75w9WcgINdSh82qfTP_9wBAJgQLZesNOvyej01xyh-4yNo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D27EIOsvHTOCuo0wDmxYi3Jjv2qw8RdWkizvJLawcLQ&oe=6A36950D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C25prE8m_f0Q7kNvwFYfKiH&_nc_oc=AdqVObNOHiG5hRSt3a7WMgpPl4iaV50U-8lvwI7TNakK2L9pfzWFWoaoLJsHp9mS6q8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkGhHcr-yQGNzckiuBhnoTrtIoVQwjgmy5CNump5wCg&oe=6A369ABC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGtWBZy8unMQ7kNvwGL3OVA&_nc_oc=AdrkbhcxWFp0fA6D99EkD7Uwe2uYeTL1COl2Zxwtqe-RbKMT1AT6wcsPbzULssD2If8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EsMZIUrbzPXhAc_V4Wgf7R-abS3BtyIv02QVN24eFlw&oe=6A36C38F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBXdBfrxGOUQ7kNvwFEGWZj&_nc_oc=Ado7s-aYgp0yEv3cNbdtXn5L3ZDSXfWRd63nOW-60IJqmqZIN2msiEIWkWw4jnZGmUw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qgac1EF70ttbS4d4Pp9JT5WKHt43Y1hen9s97JzG-0w&oe=6A36C363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzl2ACCiA5cQ7kNvwHu-Ltm&_nc_oc=AdoMnx7pZC49ze_4cz7KO0ApFS1naMA_7Spl8OyY0mtGAf_Ae0PJiNddtzScoano7-A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h_xqaVS3Fh1vGbTg-mq24RQFV3FKN-RsIlNi-VwcEaw&oe=6A36A25E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", 
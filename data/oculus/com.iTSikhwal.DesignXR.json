3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGZCxsDLhL5dIRTSF1eyj_p6fUnSzjiNp8P_guj6u2EQ&oe=699DA70D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITr1UkSGyVEQ7kNvwEjWjkn&_nc_oc=AdlDaDKj0O5qwwLnayHJsRpnk5lQJwoO4xe5KUkMPLAjvv5RJsSZCbEfXsCmbUkb83E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFd6ZLgiNemgdTinI4dfTmKBMybrPEVBUQUuz691z2Ig&oe=699DACBC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YinYdmqDAIUQ7kNvwHi-yNC&_nc_oc=AdmRxzLegB8-iUjDL_yVH42lQAHC10LVGLWE8LhSGzfU1NGBAlHfpaAepOnRavhN6tM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVRYtFabM3m55NvQkAG3hi6GZHrzL0ptOBNEQiVLS7yQ&oe=699D9D4F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtJMKSSET7kQ7kNvwEZNbTs&_nc_oc=AdmD4IC4GMM2-Aojd9c4ltSCVzAdcNrG5dY8z1V_tt1Ac0UAAnDc_-B0nv0LOFk2Z5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5FCDOqJAcYysdUxQEKlRzcSlKN6K4DBdr9Y_2AQlWng&oe=699D9D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWT_0YDpMzEQ7kNvwGD8Vkp&_nc_oc=Admpd848YzouGjSV4ibgrlyuR9t5_rJXg84hRDkN5tQ2EzCwLRqXa_ibSeoDnQWtpk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqV5I4zNgIytmLK5BkSLeqfeF1h91G1CGzUFg3XQsgtg&oe=699DB45E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_sub
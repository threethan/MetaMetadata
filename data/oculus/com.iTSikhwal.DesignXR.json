1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkzHuWR9VCsQ7kNvwFLoSm2&_nc_oc=AdoVEkD83ERAAIpRLbIw9Ljk2hn1oyRisO2-bzUqwWSXUqTWeOHX2fkQfzCrixkxiNM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyKD7nx6zxsLeV2zxKn8BUzqRBkshMkSE4ddNh9NM-6A&oe=6A4CFE8D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jOE6YWNG2AQ7kNvwHVcVKI&_nc_oc=AdqDYqZ9Hj8m2u9Xpo-4SXd3LBDA37rwLSZWnenpWzFMBbFtCcp_DJIzGpG89akviqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnwjxsCu8sxEQqWX69y3qd1v7WxzvjQgyFbJMLaFHgdA&oe=6A4D043C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sMYudGUoD4Q7kNvwEn5lV1&_nc_oc=AdoP5Byxc_g0zjp84bqjcTKGlS9jSJoaSWaNSq1nsHG2Qkk9Fz9OmeIBn4eOQcDXw00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7ia0-w1ryQeJp0ev8xreyIh5xcAzRXafoJNskBs1-rg&oe=6A4CF4CF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmTS4BTrDcEQ7kNvwFFvIXc&_nc_oc=Adr48gDh36zsDcuEQ7nKRpDpgitmDbDBLWgWnsT44B0oxZrVGWY7BLAw0nLkQPh33Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI6aeRI9xXoHbN6ikw85L-FlF2zynLD8MJMoa7Coa5gA&oe=6A4CF4A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw9h0za51uIQ7kNvwF-jsrS&_nc_oc=AdpTNnQ1Pv_ufNMwD0VPZw69yEL7548HZhxbAXqThNOqPIXU-iSOsjvDQ6gKf0bdmgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdZEJz6Tb0OiLHOKin7MTI0yVlw8IkiV9tthmc0nDoig&oe=6A4D0BDE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
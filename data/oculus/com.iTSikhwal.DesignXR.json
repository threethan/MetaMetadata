3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvvf_G6cO1D9Q_eToQ26uaVUCSoXkJqn4QyZ4A8HNf_IA&oe=699C558D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITr1UkSGyVEQ7kNvwFbcGdL&_nc_oc=Adl6Gvo8bhCLK7Nij7UU4Rx1xacTTEWlx9qfJCcR10RjQP4pPJ1lpIBdd49XEnIUeYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftUI5Mu0ATBLNm_oBBKxT1V8Oq7bm051LsmEtCVTWHtHw&oe=699C5B3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YinYdmqDAIUQ7kNvwFwE7dL&_nc_oc=Adl1wef2JLTPYdToKktHILt6czAXCewcg4Gs2FDJ7nYtK7D4HNMw2H7LRw3bUzSNcK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsC5m0js2uLczzN5KU4x6KvA2H4ErRWGht_VF72b1ct5A&oe=699C4BCF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtJMKSSET7kQ7kNvwFcpKol&_nc_oc=AdkT_p_CN_JLbxQ1cc0JGblnuiCXRd84aKD3o6w0ZqUWwRGioo2SqRoyWTeHpjAncgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-p8tB8hsB9JPCB_BrOMY8p1qD6fjt_Lhw_Dh5T5QcuA&oe=699C4BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWT_0YDpMzEQ7kNvwEu4vnk&_nc_oc=Adk1putaRWxE9qM5RL_r-kk4XSbDPttDSCBrYeupAHpxQKxNjlfTZ_-dQ8S57JX9fyM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuOXTI5JC2a9gnEhfSEeXh2TtjlatZfZHZQAXhkbEAGZg&oe=699C62DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_sub
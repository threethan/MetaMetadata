0a&_nc_ohc=FB1OY0PbuaAQ7kNvwHXt1Im&_nc_oc=AdnvxliSWCzV1zS27H8ayY_CNiVOekVVXgqIXfF2DxO8D2m1vdcvKPkk5vdCEM57Zr4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt0G6w1FTDZ8lpfWcnS6U_NEKi8lusp9lYNdSNN9gONw&oe=69AD790D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIbX16vEfasQ7kNvwFNRvBE&_nc_oc=AdmAfGGZpJc3dUgS_koaeFAIJvWX41OpdIFbTUUHpXW_QEPMkamTmDoHZ7xqFj21KMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-nfI0gqc5S82S34vvhnR3yGdmDKGwnt5UiYijyWHe4w&oe=69AD7EBC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfiHFqnjP4Q7kNvwG6V2fY&_nc_oc=AdlJ_hTQXQoTm-RvwZBvT_ukx55VQRAicD-_WWf4vcqcn2eRnlMQlBv8GB_UXiIfLH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4afLp23-rH18ZIv9KXshEgBCMRKKUX3w2OwodP1J17w&oe=69AD6F4F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GWBLhCj1EYQ7kNvwEZ7Pha&_nc_oc=AdnA1zLJHGZ2K13Ufs7dpGeyAXIL1fxft8od-2uru-pXywZTvClAInEPwLCEMP61eL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzsue5rl9ETJCPY1JDIHlgFaQWrUrhlu-1a7bfXVoi4VA&oe=69AD6F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPHNWPBZXD0Q7kNvwGkq8Nw&_nc_oc=AdkYeVcqHzly8BrUBNqrCUdwR4JqcKsU8M6_2ZzBsOoWUlSMnJ5MtGZ2k0hC5gvVKFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc5_Ri27KsfkDOJBIcnVECfYgqw50-M-6teGGiDrj35g&oe=69AD865E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "c
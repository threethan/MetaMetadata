oc=AdrH1tz6bc3YO_Kp1aSTRfvTFYS1j3CRCrwjpeewA9kqpE7aJvMWQnjXTB5Dj5rMo0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0L29id3egjKRZGA60jzBPjSVx2_eLIQWhuyPe5ynDLsA&oe=69F2070D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goA8ROcaxRYQ7kNvwEfYg4Q&_nc_oc=Adpqn1OpjYl6y003sJ0svKDEf_9e3RHeW24r2H4sjpGXf3mygf-1JoKzsr2IFzDlf7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UKXDewAj_o59HiEtTARGG0Gn3NJd53orPa9Gh3M1wOw&oe=69F20CBC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcHmbn5kYXgQ7kNvwG4_n_-&_nc_oc=Adq4Ryg_QmEwVpMo6AJJz5ypZT-7Nlz4ddvPp6XsbC8tK348aPlnunRNsSVgur1Bj10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Z56kuowgfYiwTtaPhRUDzjCEDdBk-X91imlVNSTT6Gw&oe=69F1FD4F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDwYJ_DmPJwQ7kNvwHyED0h&_nc_oc=AdoApCeCINusbCq7ihOPFSoQI7TJFTsat9h6F5bM4BEgAbuESYYv2KXg05iMCVUVvdY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1sFhMEdaZQuT2qdYp66zkEuDRW7ZwDK-qZtqK-FO_ynQ&oe=69F1FD23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8rJFs7_XpoQ7kNvwE5iitr&_nc_oc=Adqpj9CVqvY4ZOlnUSnHclTTB17VNCw5jmEGpBhtSsatx-8CUMhIptxVs9p6aVzLAPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2AE3WQ-Kl3_12Z7OmQcWyqbWHPC5KONBFz7UwNGk5grQ&oe=69F2145E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}
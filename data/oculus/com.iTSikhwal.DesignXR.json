1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR5WCjtFYeoQ7kNvwFNV3Xz&_nc_oc=AdoUW22J_71zzCQkUyuRukrzkVTmZ4sMbWJF1a2glZ2sLsQI2JzJz3WZNSgugkc84g8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mblqtzeBxnzUdFP39zbnLg5cv0_0WO0OnJPFtY7nsEA&oe=69DE408D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmj74nXyUF8Q7kNvwHhJJmX&_nc_oc=AdqWtVAnt6uQW9jay_z7obeSFBUZOEv5aKh4nWBBH_4SpfiGpC0YdshQgYBkVcNNNgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DNoFps3nbefvYuvrn2RABahj7qj0TYOPmXcpd-kofFg&oe=69DE463C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDVWg9YFEBsQ7kNvwGo9C5d&_nc_oc=Adosv8U4jCAuTaZLXD6bjrWenXICroP0Es9gRGPTHW9nsjGkI0yLeXGy80GyOsAo7PU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hgSKdtjAjXp5D6Y0n69v916jwTfhQESjp5nRQ9HvsOg&oe=69DE36CF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHnRH96ShxMQ7kNvwF_8BVo&_nc_oc=AdpCd_0v7kUv4rBdTVFci0ttaVAUNqCQCIApQ-UgeGkOfqJfDussFRjk21WCr20KYik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k9o5cHr2QBd3gB3ADk6V2qCEyPLHQ5EhtcRPELgQdMg&oe=69DE36A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZIpPZ0rV5EQ7kNvwFMUeGN&_nc_oc=AdoTW-_AAOoCaB-xKlrZj7GlhExVm_40qP4zrU96a-8aHF_X9VFn0GLP9nU3smCtatY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X3IM_FHNljhGq_NZ8ltbnQNgjzW-IZmgMqao2eNORiw&oe=69DE4DDE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
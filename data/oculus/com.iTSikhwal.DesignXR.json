21_5587971032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NDY8ix9P9wQ7kNvwGTRH2b&_nc_oc=Ado1YKcF6_o-WAn0c51cFvLOOloIXx4o2EUO1OliJ5klRiMETvK72IpxuIDIqwuTXMM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kmoAM0zzNPhR963eKZLSVsZOvhId62LE3N2JMqW35Jg&oe=6A11AB0D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt0nmD-1M3EQ7kNvwEbkwQP&_nc_oc=AdoYklwjLd8C4QFmdK4QQQowTqz7TE_w-cEHo_urGtt2a5PABrCgLXwUoPuZGtkqEIc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55FqphsI_tmVrDm0Oi_XSustuf7ANNG1NHxdO1BWL8Gg&oe=6A11B0BC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELyfVgwP94QQ7kNvwHMJOK2&_nc_oc=AdoBWtR45T1XWZP1Ys0_DmWvjF2TirtoGwM7DbtCU5cm3N9CwFzr3ahqsNPGUYVNFDo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AYkfwbbGOg6FWuJdN33LRgzn8BkU1cNbUHlygZCtYvw&oe=6A11A14F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROK9bYFC8MYQ7kNvwGDRj_u&_nc_oc=Adptx5_sVR-BjyDtfrMs2MPSsoTUAKAFhACi1lRy5BGQUgNs55e8cohmaapH_SMITSw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WdvL7COzHJIuMrOjtlid72oBFOOAANv0pGmBLNruolA&oe=6A11A123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8MaNS-kgVAQ7kNvwGQ82xa&_nc_oc=Ado4GbuVdKxzIshPYduCfU2fGklEK_DjaK9ShGSFF3GzGKiq-C7y6Ib_DK7GTau6uNo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-oDWSV35E-f9RxP3GVwmwn7bvCjOYVIq3gy7XWc908A&oe=6A11B85E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", 
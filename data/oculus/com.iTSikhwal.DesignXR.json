1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDxHIU0r37AQ7kNvwEb-8nc&_nc_oc=Adri7g9MBSN6962G9Xy5cZxkdjyzC2hTZ5uRiAIwn2gxdp7p08hevcKEWK0IJh5qyt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOaTguyCP4ax7bKjZyPZHPfXuARDh_b8moW31-rWc4Cg&oe=6A50F30D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgXGsOA7Sa0Q7kNvwGmCtt0&_nc_oc=AdpWGTjpVEqBKROH-ProdO-PV2XCWx2be5BOmbTMeCNdqjfig5wZR2FZu-au32hoWNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD716jBbkeHRUqGgDjD7FQzq8EU8rpUfb227waSpO4f4Q&oe=6A50F8BC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1NJfdhr_T0Q7kNvwG22zSI&_nc_oc=AdrmDjyqhIPmRTg_80lMfufSJOjL9bARMUJHI-3EBHJttDXrhIEQ7VuLXiqRT5pvQlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe24zBP9Da_nbxujUwt0MlNVpoK9kS_JbdP0-snBlokA&oe=6A50E94F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETYlfCP3qVgQ7kNvwFfRwIJ&_nc_oc=AdrdH63LdqzLEFB1NdKnphnMH7fMhb1NhJ5_Krt85DwEl1_W0gI4NBJvMUpLrnno-yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk80RtFKaQIz-BETD9JM0Mv09_zqNk7cwSt4yPiAYOag&oe=6A50E923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_PeZDGHWzQQ7kNvwFdbnqW&_nc_oc=Adp8E7sEfLWvXcAalSBeZengBvVTCw_Q0AAwxfWchtccC43muYZYmm92BZ784rs5VFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBib1ELcORDFcs181OCeyFKqIy6feMXrF2YpbgfHKEv3Q&oe=6A51005E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
PUlY0ZvHR-wYyjA8ng7DgGFBqpVig2DYMqD16owxgnlUO_1s7ReY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwZE1_A4XWrX_VWgZVIVaMmkW8smkXj8u11SRRAwtuig&oe=6B0078E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1UjeSthyDYQ7kNvwH7NUcm&_nc_oc=AdpuKhXtg8jKIddPb2EfqFxX81OkSIGq7zRj0903NtYb8uFRD_p78LAD7adiNq9cJRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJSkAqoTAXibZHGCE2KAFt08c8bk9_PnHPi_1oxPToOw&oe=6B0057DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24766711843006152"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1870398027197345_6195809521178023204_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFK5riy0crQQ7kNvwElKBUW&_nc_oc=Adp4MjOEqJMUCc0OoRW2J4aa_n_9Q56y0z93yuBG14mzJhkWCKXjNJWgblr-unMgLc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkp2_NdImUrhVc32cUvnuXH_ktGWfyn0PTNFtmhpIwtw&oe=6B006E50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DesignXR Arena Metaverse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "
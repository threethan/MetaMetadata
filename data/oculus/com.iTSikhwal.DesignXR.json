.png", "id": "1139974845002355", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_1139974848335688_7265290338280181330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WlYIJ02qQoQ7kNvwEzK0hk&_nc_oc=AdrA2qbjbIlrgiObNNgtaV5rNwiR643PoPYrhoOHmWmKRmOGYAhSL9oHhyvzcOh5VaA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7yTdoVksvm01uZaCGHTMh8OZqIoBNdn2Oelh9hfb3Bg&oe=6A81B4D5"}, {"file_name": "DesignXR (21).png", "id": "1188161269975141", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310651_1188161273308474_2450660723065015652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVpfX0WE5NgQ7kNvwEHXD_J&_nc_oc=Adq5horLpElQQePRkOWIztqBgYtLuFtI8laYYJrUkXp4w3aUSlg3eAzIh5ECS32IIZw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVtDxauNQr82QmyqGUfIO8nnAEp_VRpw4tmRabqy4BrQ&oe=6A81B2A9"}, {"file_name": "DesignXR (22).png", "id": "817149201209054", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308103_817149204542387_7181880101509611568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT_gKQbNoBAQ7kNvwEucXrT&_nc_oc=AdpGBI6b71uIlfgA-zWsivEd8T6xzHPnl7GEXFhfLaJhO_8UiXHDNB5cDQU5bH6BIRE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUuE12iQ57xHzpm7QN--Q2J6-lOhKGHoWFVCGX7CF3Qg&oe=6A81C619"}, {"file_name": "DesignXR (23).png", "id": "1763059911073811", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304162_1763059914407144_260572872702006809_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0juEN_ksxRQQ7kNvwGuc1gG&_nc_oc=AdrBG8JPbtnnIsHCJEr2w_DoZabyKE2w2Cd4Lelr3IWeeqX_cnnZ9z39c0LxCCzjgNU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEygaHO8bvuaDlPGLotzxWMnvvwCCPV0LHC0D5flUBSvA&oe=6A81B73F"}, {"file_name": "DesignXR (34).png", "id": "1349630696567240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821702_1349630709900572_6070462723318437426_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVQl32stkScQ7kNvwF8Joyj&_nc_oc=Ado254AnbFgsWXGmLgptaMb3kuNZ_zZQq16xmbhZcRnIFbwgTXljf9H6ZLIi4PWqsGA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCYsO6Hvk8mfe-OWg-i7CsNQVtcRXLtlPBBIIxsPKidg&oe=6A81A8AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (41).png", "id": "665177116420671", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823366_665177123087337_3118693476427529470_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URXfK_ILDIYQ7kNvwEo_8Ca&_nc_oc=AdoDU7UU0_DNyluxsBS1N0R_7tWKVsSMENVXw5cq4j30n_TDLXYN32OiyRvoiAO_q90&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzBOp1SYnrenVsEL5L_-9m0rPkCLLubQKdt8aIM0oJWw&oe=6A81B31A"}, "display_name": "DesignXR", "keywords": ["Art", "Design", "Interior", "Home", "MixedReality"], "long_description": "# \ud83d\ude80 DesignXR \u2013 The Future of Luxury Interior Design\n\nStep into Your Designs Before They Exist\n\nDesignXR is the ultimate platform for interior design professionals who demand precision, realism, and elegance. Built for Meta Quest and cross-platform, DesignXR lets you visualize, validate, and present your most ambitious ideas in immersive XR\u2014including Virtual Reality (VR) and Mixed Reality (MR).\n\nNo more flat renderings. No more \u201ctrust me, it will look amazing.\u201d DesignXR lets your clients experience their future space before the first piece of furniture is ordered.\n\n\n# \u2728 Key Features:\n\n* Immersive Client Experiences: Walk through photorealistic virtual environments of future spaces.\n\n* Precision & Customization: Validate every design choice\u2014from scale to placement\u2014with unparalleled accuracy.\n\n* Professional Results: Present your designs with a level of realism that sets you apart.\n\n * Competitive Advantage: Bridge the gap between imagination and reality for discerning clients.\n{1352160019876797}\nFor the designer who demands the finest tools, DesignXR delivers a flawless, immersive experience that elevates your presentations and client satisfaction.\n\n\ud83d\udca1 Ready to revolutionize your design process?\nSee your vision come to life with DesignXR today.\n\n\n\n", "short_description": "Building the Future of Luxury Interior Design"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24347155961628411"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1079845424329242"}]}, "baseline_offer": {"id": "1079845424329242"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763058600, "status": "PUBLISHED", "id": "1079845424329242"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24600934726250532", "version": "1.3.6"}, "id": "1828697518003130", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9863105597126688", "is_concept": false, "latest_released_binary": {"
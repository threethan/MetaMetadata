1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDxHIU0r37AQ7kNvwGeRCw3&_nc_oc=AdrHsBtDQnl9IDaWKgb7SuRwxK8pxHIWmkW-SVdML_AaDwoJm-ZeZ8eL83nJwuW4SYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfnW4MzddJY6BHYR_UfEv24jmyucJBeVeWjr5r8cra4g&oe=6A52448D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgXGsOA7Sa0Q7kNvwHec8r5&_nc_oc=AdoCu1oJras20T-a3ZRpa00d4c8yCwMgvgEGZuJq0YNkjP5v25ogvLD9JJ3r5xbQx50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNfoZGCSkvNMhwMcdaiXgD8l5r4gQH28VuNStuCCtntQ&oe=6A524A3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1NJfdhr_T0Q7kNvwEn9mlZ&_nc_oc=AdoeN_K1caM5DJa3VWscnEecnd-rVS2Gb3nPFakSlmoacw6PpGJeBhmr9dPJClGcJCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK8EgEOrRhExHMlUo5YtaKQNLdz-13GB8RVVHhZgrFZA&oe=6A523ACF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETYlfCP3qVgQ7kNvwGt_55i&_nc_oc=Adq6dlpkQKuHjV1_JxMf9J927VyCgr_rT0PGSt2DTzMK4lmkd98Tq7kEWDEUopz7fE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaiD2hEYbrnYhTUtDoNhI9ACA1cUzzEL6MpOnPDxpKcQ&oe=6A523AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_PeZDGHWzQQ7kNvwGOALpB&_nc_oc=AdrGWBhS1lvajTgZYWOvlWtccDJldVc0at_YJdNAspIoLJ-C-rP2VPYwMrormnUam1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKTJepnn7Ddm0klg-uwv6K7ywlgUABYMIwYxQRLwZ4Rg&oe=6A5251DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
0a&_nc_ohc=FB1OY0PbuaAQ7kNvwFR3hks&_nc_oc=AdnJeG8fJ2GkD4LJViqCW3Yi-MUQ-f48ng28Hloe55EEYGCC2JiutixpYr3SZc34I0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKj9reTWYgwk5wl_FQgyxk_wrTT5OcA_taNuXx6-MgXA&oe=69AC278D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIbX16vEfasQ7kNvwHpA7ml&_nc_oc=AdkCsE4yiICDi0hLzj6VZIUVvSuGMLS7eFHrcOET7DToeHyvINapsnbFPKzyUFqVeZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKQI1TYU-lu62tx-jdLRWXl56G_oJMtj977Mj53Vaygg&oe=69AC2D3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfiHFqnjP4Q7kNvwGwkMqE&_nc_oc=Adm82vVmlH4GnekAMycU8HESikI_QqPukXaQZ9juLPDAei-KtNqZmS5oms64lRzO5V8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZXvWv-UsuXwrD1Q3ENJzO4JPyzaEZORb6eQ_MW8VHVQ&oe=69AC1DCF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GWBLhCj1EYQ7kNvwGhsNuz&_nc_oc=AdmUy7fzqwfgICdIXU0LVLkEiOcTX1-hKoqz5dHwrJT9h0dYcx370nCNRvePJvUvWNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweOlhJOCGwghvZ6OvQg3ra5547c42cWym-g7r1Jy4qxQ&oe=69AC1DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPHNWPBZXD0Q7kNvwERnROO&_nc_oc=Adnryb9grjnHqBPf7cGirfG6s7Sggbpbm1YA0SS95hz5dpqAEZ9Adx70p1OKwLfSRXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqkiBGlvmbPsom8_21HY1rlYBhFKE6amLvfIeT32SkFw&oe=69AC34DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "c
21_5587971032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5s2uuMzLLIQ7kNvwFiBaUq&_nc_oc=AdrACZh_Yser6fGNEjWRtc2UDewseliS_oRB-ugCAK53taoY9Mft42jKDKj9RoHUKvU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rgku7XvKBisgRRMmtMDhT7JlFxYw6ZwIzRkbkK9mTvg&oe=6A22CE8D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ar6I3__LS4Q7kNvwE8fhCg&_nc_oc=AdpIwyRwLEkXEgKn2fr86apVo-mF898W0JvtmktULizXpWB-_-jQRvl0acqifGwvfm4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af974dxOZFcxZQH_t0UeSAtY_NrLzlaqhiYLxwZBulfaBQ&oe=6A22D43C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIFfkaJJgAwQ7kNvwHpxXWd&_nc_oc=AdqHUmw0qAQwG2idxck4b7CDxx4MPnf5XleC8_hdQ4e_d96ueBQU0dNvuPX9fvRuRq0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90jsbrnMyavPEnXh-qQJU47LMD-yDoEH4r_6MaB9oz2g&oe=6A22FD0F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldesMnjon6sQ7kNvwF97yci&_nc_oc=AdowXHa0hYylkLEhwuAg0ig_qhxIOl51GzOYDnvACMzmXqTsukXu7ltXvx8O0ETAZ_Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JMXXGjINwHk-Gl-_xFfDiQIwF0C1P9VvVi2j41oEB3g&oe=6A22FCE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgfF1eGCjDsQ7kNvwGOB5DC&_nc_oc=AdrvwIj_hC3Bw4ahC7dQ-HE6FUVpvJ8MypybhkKb669bAWR7r-l27UCEUsPsd2qSqcs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4wGVak9AA9wHfuST9ST-6eNLg-WJqL_yhoFirNB3NOQ&oe=6A22DBDE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", 
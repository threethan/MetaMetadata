1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkzHuWR9VCsQ7kNvwGZQcTG&_nc_oc=AdpT-sK634UG88yrIlbZw10_QmyTbuAJDHLZ3hXyJqbDH1ULd7mcR_eVCSIrWKaLJCY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqeGiCZQGO6Bovc-3OWXhVe5B1OlAYcVItIcbAP9IDdg&oe=6A4E500D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jOE6YWNG2AQ7kNvwFsZROp&_nc_oc=AdqzkF2D2mDydRr8hOPU9AzENdxJqMCuNhl76jOKjQIo8AMTkitqkASNsNjIeYyF4nY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNGJMO4epo1hMYVdBVUBh5QMARCcDufEtFn-I8yjq7gA&oe=6A4E55BC"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sMYudGUoD4Q7kNvwEEQ1oh&_nc_oc=Adqf5fj7IecZDanvdKMWLMOL2llJG-9x64KsrtAu6gX1SC46MzKdQxK7BywXYgr6LqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACOpnXbzIZ1llZUS5PiS_eT5VktvW2MegZi7C-A5ojIg&oe=6A4E464F"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmTS4BTrDcEQ7kNvwGnbYr9&_nc_oc=Adr67VRv3wdIkp3TX9Gnj8xg7zq0itvb4camNqQNXuNyeg057uImy3OJQ_DcIoecSak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Ty8yykpzvDSMqgf5d0CxQeG7Q5IIn61FQH8WprGxLA&oe=6A4E4623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw9h0za51uIQ7kNvwG1GtpS&_nc_oc=Adrxxy1_jvCf7IzQqPKkTY6Hc3s_fPiGgoLXYjZ46O1M1QyySNVTVqVMpZtBExh1M6M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1mNlzYU784uUvK_5j6gYrAPTBjD8hHS2DXjm-xUq0uw&oe=6A4E5D5E"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
txcVJA4aDAsTPHGEnEM_R5357KKDtuzXeujTJORiDhIa2zzsli31x9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXrYMH8HUWri0kSzqDRlzDBfR1GKcwsH7wbWkGnxx7PQ&oe=6AFDB319"}, {"file_name": "DesignXR (23).png", "id": "1763059911073811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_1763059914407144_260572872702006809_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_0OGfKOkMQ7kNvwHfMglT&_nc_oc=Adql9Ly2UeWovFVYMDhDbVRS1qrhk-DIsfTgzMazDt87Pdnxr5VZUD_XTPKeVry-C6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFQIqXB_4OSVL4Zc73HHvuKcaBpwC3xy63-4QAne1lWA&oe=6AFDDC7F"}, {"file_name": "DesignXR (34).png", "id": "1349630696567240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1349630709900572_6070462723318437426_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nExPtoKLmgQ7kNvwGPx3oc&_nc_oc=AdoBWBH3u-_Ob4CyelkcO2lOoU537DZAHE_cAHSkfIQo9XYuJO2yBBJ-5nn7ZKEQmC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmwZ7NOni6mv6Y6Qa6wy_MFEkBddhncroZYsFvVnY15g&oe=6AFDCDEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (41).png", "id": "665177116420671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_665177123087337_3118693476427529470_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pxl_m2c5qX0Q7kNvwEDJ9ZL&_nc_oc=Adp_k_fvDquiZ12kGVRLnaTf81I-Qf-oTEiPG06IhCLzAEChcgINSsKOMGCFG8YUw8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI1Werc6AWDf9p7SMfYxVSXTl01-0NtMv1cRcyi35zrA&oe=6AFDD85A"}, "display_name": "DesignXR", "keywords": ["Art", "Design", "Interior", "Home", "MixedReality"], "long_description": "# \ud83d\ude80 DesignXR \u2013 The Future of Luxury Interior Design\n\nStep into Your Designs Before They Exist\n\nDesignXR is the ultimate platform for interior design professionals who demand precision, realism, and elegance. Built for Meta Quest and cross-platform, DesignXR lets you visualize, validate, and present your most ambitious ideas in immersive XR\u2014including Virtual Reality (VR) and Mixed Reality (MR).\n\nNo more flat renderings. No more \u201ctrust me, it will look amazing.\u201d DesignXR lets your clients experience their future space before the first piece of furniture is ordered.\n\n\n# \u2728 Key Features:\n\n* Immersive Client Experiences: Walk through photorealistic virtual environments of future spaces.\n\n* Precision & Customization: Validate every design choice\u2014from scale to placement\u2014with unparalleled accuracy.\n\n* Professional Results: Present your designs with a level of realism that sets you apart.\n\n * Competitive Advantage: Bridge the gap between imagination and reality for discerning clients.\n{1352160019876797}\nFor the designer who demands the finest tools, DesignXR delivers a flawless, immersive experience that elevates your presentations and client satisfaction.\n\n\ud83d\udca1 Ready to revolutionize your design process?\nSee your vision come to life with DesignXR today.\n\n\n\n", "short_description": "Building the Future of Luxury Interior Design"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
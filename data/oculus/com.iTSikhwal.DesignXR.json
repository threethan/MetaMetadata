1032305346503_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CiA82U1oQAQ7kNvwHi10r5&_nc_oc=AdqL53rtIE66LJc_0WjceHPKjsMS5M3_2j4YyxeP59EkO-VLX9smqooQqqWFvGiOIqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0Hn8Oj5Bme789H-NDd8FZG4EKldo2JLCzmFkt05cvKw&oe=69C9288D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eub8apveRA8Q7kNvwEvz50X&_nc_oc=Adquaall19Py8f2_aSu7uSH1uhNSsjeWKpnG55Nh3qvxcdRk-AGbWGpCnfgLzH-wKmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxS77Y3ISm49vWCzcasmdhYSSZ1FXnrcEvDYECzN2Rrpw&oe=69C92E3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTI7XznBycQ7kNvwFbHpP-&_nc_oc=AdoixEOQtkZk1ucNXlMG5sDJUKLayWv7X6sl59CC-iBT4zUttcn7DG6LRI-Hn9W9k98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyljnn5XQPZ-S6SlfSen16ubk01Spn6Gm-uNJTydoqFWQ&oe=69C91ECF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wrxKjp7UskQ7kNvwGEE8sp&_nc_oc=AdrBWQZFnMHxsPtAcZub_6iNS6RoHdIASWBPdi7Ym_Hjs9GXJa7R1UBTisUYb3PVhxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMWdgwDJjreqnt_Iwzy0W714vm3Qd2Uhxc3CxJXVl4XA&oe=69C91EA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65NdGguCuqwQ7kNvwFJaV6P&_nc_oc=AdqcaigYL-v8wxkFoQ-A1SWHvtyRFy22Y-GrHEhmGrfFnQvKJ87l_yVjNzqfpydS7p4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIQXKI_WSuikw9B8-R3qkyinj0DOJI9iVtQr1BC5lB7A&oe=69C935DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category"
aeWqW0pR9vhtIbFnOpxuUWSRp-UZnjFAoeC-89zFVqetNMd7TrtdNCU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVJCUfdzSpjKjEKniLuOuOaGUMeQb13MzyvZix3l_3yA&oe=6AFB4859"}, {"file_name": "DesignXR (23).png", "id": "1763059911073811", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304162_1763059914407144_260572872702006809_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_0OGfKOkMQ7kNvwEvoLoA&_nc_oc=AdouoH5tkuXpQNXSby-khXwr8SUqHC9zPwWksTSvrfsCEP8HWoW7FHIkgq4ghhk7Ays&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8yPIvKwdWE8RUQdZ8wZ2jO3fMLx5z6taawsgfT3H3hA&oe=6AFB397F"}, {"file_name": "DesignXR (34).png", "id": "1349630696567240", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821702_1349630709900572_6070462723318437426_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z24t5awjXUMQ7kNvwFsK5cP&_nc_oc=Adqa5vpHHEDtXmqJAxNnRXXojdiAHC4P3xj1Na1O6sCYkDkVIdeRqdJe2M6NLwB1QsM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7j0VF1Bun-ZiMqIsr6lP62BPmoYw9lD_MkZLncs4_AA&oe=6AFB2AEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (41).png", "id": "665177116420671", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_665177123087337_3118693476427529470_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI1fGht2OZIQ7kNvwE7EIYN&_nc_oc=AdpDEtKBQhu_hkmczfM2UGYYY_UnpsHAkHAk_atEbd9dQUjjnOOO7ReFNYhzGhkP_7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7FYEQdjayXPmdOgwjT-DBERayK7VKZcNauy715IsURA&oe=6AFB355A"}, "display_name": "DesignXR", "keywords": ["Art", "Design", "Interior", "Home", "MixedReality"], "long_description": "# \ud83d\ude80 DesignXR \u2013 The Future of Luxury Interior Design\n\nStep into Your Designs Before They Exist\n\nDesignXR is the ultimate platform for interior design professionals who demand precision, realism, and elegance. Built for Meta Quest and cross-platform, DesignXR lets you visualize, validate, and present your most ambitious ideas in immersive XR\u2014including Virtual Reality (VR) and Mixed Reality (MR).\n\nNo more flat renderings. No more \u201ctrust me, it will look amazing.\u201d DesignXR lets your clients experience their future space before the first piece of furniture is ordered.\n\n\n# \u2728 Key Features:\n\n* Immersive Client Experiences: Walk through photorealistic virtual environments of future spaces.\n\n* Precision & Customization: Validate every design choice\u2014from scale to placement\u2014with unparalleled accuracy.\n\n* Professional Results: Present your designs with a level of realism that sets you apart.\n\n * Competitive Advantage: Bridge the gap between imagination and reality for discerning clients.\n{1352160019876797}\nFor the designer who demands the finest tools, DesignXR delivers a flawless, immersive experience that elevates your presentations and client satisfaction.\n\n\ud83d\udca1 Ready to revolutionize your design process?\nSee your vision come to life with DesignXR today.\n\n\n\n", "short_description": "Building the Future of Luxury Interior Design"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
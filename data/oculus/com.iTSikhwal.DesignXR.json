3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs0HxWs-LEcdsnYWapvM9I4bk8RboVbbtQqSjgOlEnhIw&oe=699EF88D"}, {"file_name": "DesignXR (77).png", "id": "1198069898929887", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1198069902263220_720857584756128599_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_tohLoy8gMQ7kNvwGm79F2&_nc_oc=AdkGDBCU_skBe1d5NC_Sa1PYS11uF5toR5-U052ZVn49w_6AuZb4Gtq-vtQ_Z2zdh9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft43FeQWFRAgbdAZ1C4Bs6uZ4wYQPKmUxf9BREKxe_PQQ&oe=699EFE3C"}, {"file_name": "DesignXR (73).png", "id": "1396714968527005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1396714971860338_978164289536762199_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5kTnpS34UkQ7kNvwGA7AWo&_nc_oc=AdmjDCB13LGD6hR2R2wDV6YACD-POzPZJetctIRsxMKfqwzo8rSa0ihCpNrHzNLPUOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQq7XoiUOkwjbx7HdGG_N_Ov8hj1PX_vzsTPkc9RPwaQ&oe=699EEECF"}, {"file_name": "DesignXR (75).png", "id": "904437415489136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_904437418822469_4090400682754464560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DkSkyQWTHMQ7kNvwFrTRid&_nc_oc=Adn7Ot-RGHsBsizwyDVbHPoYlGJjSbcLQAHpTkub4EernpYh1KsJn03-xVXQ6UbgVQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfspLRhd-TGJIPLT0OjQsHQJ6_sADSZkyhTfsJ6mT4xysg&oe=699EEEA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (69).png", "id": "1222447113072589", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1222447119739255_4884568445868733966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lOno-cOG_cQ7kNvwGnR5jy&_nc_oc=AdnQQWLnP3I8aiIXrIo6Mm9faH7fq2Reu_yKMVh3OO5Q-AYShjpogu-MX6aYSbL_yv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBYqbSQIKsls9TiN9Z6LRVtmX-BZWGfCumDJyE4UAQHA&oe=699F05DE"}, "display_name": "DesignXR Arena Metaverse", "keywords": ["Art", "Design", "Metaverse"], "long_description": "# \ud83c\udf10 Arena \u2013 Your Social Creative Metaverse\n\nWelcome to Arena, the social side of DesignXR \u2014 a place where creativity, collaboration, and play come together.\n\n\ud83c\udfad Meet, Play & Hang Out\n\nJoin friends, clients, or a global community inside beautiful immersive worlds.\n\n\u270f\ufe0f 3D Art & Spatial Drawing\n\nDraw, sculpt, paint, and sketch in 3D space. Create art you can walk around, interact with, and collaborate on.\n\n\ud83c\udf10 DesignXR Arena Metaverse\n{1320626179816926}\nA Social World for Creativity, Connection, and Exploration\nStep beyond screens and enter a living, shared universe.\n\nDesignXR Arena Metaverse is a next-generation social metaverse where people meet, create, explore, and express themselves together inside immersive 3D worlds. Built for VR and cross-platform experiences, Arena is a space designed for community, creativity, and real-time interaction.\n\nWhether you want to hang out with friends, collaborate on creative ideas, or explore virtual environments, DesignXR Arena offers a dynamic world that evolves with its users.\n\n\ud83d\ude80 A Living Social Metaverse\n\nDesignXR Arena Metaverse is built for the future of social presence \u2014 where creativity, play, and collaboration happen naturally in immersive 3D space.\n\nEnter worlds.\nMeet people.\nCreate together.\n\nWelcome to DesignXR Arena Metaverse.", "short_description": "DesignXR Arena Metaverse \u2014 a shared world to meet, create, and explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_sub
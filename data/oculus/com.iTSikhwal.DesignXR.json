FTc8802u68abSnLyKI9cVBKU18Phn1LL65ZVtLpk_YomzSGmvIJkXB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgyJH6ewh2lKpeyFxayEtb3_yygek5upPdadSPEPWAww&oe=6B01DFD9"}, {"file_name": "DesignXR (23).png", "id": "1763059911073811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_1763059914407144_260572872702006809_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7w8G5PCKuwQ7kNvwGP0S3-&_nc_oc=AdqJwwDuTClVHzscCeVGbNRgkL5yKBOpaYWQIiSNmoFOIRaf4bwDYd7ZUugzaFXQToI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIOaaMuMtVYHX6Fpa_qZYzsvQqWUlQXGFLGbaXu_nGrg&oe=6B01D0FF"}, {"file_name": "DesignXR (34).png", "id": "1349630696567240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_1349630709900572_6070462723318437426_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DoErNMovk0Q7kNvwHZKooF&_nc_oc=AdpOa3V3rTYm5N5dyA7smhiBYRIccfe_RcHSEVKaHAa2lINk56HLKYbS6GekhmH7n9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl4Xzu7F2DYOv9lJ2zzsnXq_WTyABYE6tpV-OQKwQPow&oe=6B01C26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DesignXR (41).png", "id": "665177116420671", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_665177123087337_3118693476427529470_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTiiAMmvgcUQ7kNvwFLKJwK&_nc_oc=AdrQE2dT5xKYzuStpFKVikEF6Ji-GiV74I541UF6yHTgZD1tTpH9uyIpwFTDdiaamWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcI9Dt2cfCnGKSpofFb6a3KtVg_0HN9jnUtVnlSz_KrQ&oe=6B01CCDA"}, "display_name": "DesignXR", "keywords": ["Art", "Design", "Interior", "Home", "MixedReality"], "long_description": "# \ud83d\ude80 DesignXR \u2013 The Future of Luxury Interior Design\n\nStep into Your Designs Before They Exist\n\nDesignXR is the ultimate platform for interior design professionals who demand precision, realism, and elegance. Built for Meta Quest and cross-platform, DesignXR lets you visualize, validate, and present your most ambitious ideas in immersive XR\u2014including Virtual Reality (VR) and Mixed Reality (MR).\n\nNo more flat renderings. No more \u201ctrust me, it will look amazing.\u201d DesignXR lets your clients experience their future space before the first piece of furniture is ordered.\n\n\n# \u2728 Key Features:\n\n* Immersive Client Experiences: Walk through photorealistic virtual environments of future spaces.\n\n* Precision & Customization: Validate every design choice\u2014from scale to placement\u2014with unparalleled accuracy.\n\n* Professional Results: Present your designs with a level of realism that sets you apart.\n\n * Competitive Advantage: Bridge the gap between imagination and reality for discerning clients.\n{1352160019876797}\nFor the designer who demands the finest tools, DesignXR delivers a flawless, immersive experience that elevates your presentations and client satisfaction.\n\n\ud83d\udca1 Ready to revolutionize your design process?\nSee your vision come to life with DesignXR today.\n\n\n\n", "short_description": "Building the Future of Luxury Interior Design"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6957a2f2-d4ae-4b94-bb63-92b86dddfa64", "developer_terms_of_service_url": null, "publisher_name": "iTSikhwal", "support_website_url": null, "website_url": "https://itsikhwal.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
a30f&oh=00_Af3muS3KLuL1tzcqMkNJ5WoS1RHBlGI696q5wtIKQwBkzA&oe=69D7B15F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oipZ0yhCFBMQ7kNvwFC8MUJ&_nc_oc=Adoz7xftC_HobsYcAEafwV4vaSog_r8262ZB8ynQ2G1bvTrKb58v7tr14aMBG5bMc84&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CtzK_0Bq9Nj2mgCmG6k3v9rvAX8gSRX98YJgKq1jGjw&oe=69D79216"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKebDt6ym4oQ7kNvwHKP_S7&_nc_oc=AdriXRiBT2upLI1dOjkpWPNtn8_Pfh8JQU4h12nvET8R4HN_AtVjcJsRxb8xyqmh5OE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WoMs6wTJE-15_DnsaM89aKJqMP7DN1VUWlzWsn9AraA&oe=69D78687"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_OHW9aygUYQ7kNvwF9o-sM&_nc_oc=Ado8HdXqS2ylY2I7jvsRE157joPUpO8qFdgucPpuJxx8Sa76AhZwclhnVKAznnAqj7s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cKD9eIgsy6K3oyI71X6-LJTOvE7CcHRgouB1V5NVc4g&oe=69D7BAEA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-Dp0GbTuCsQ7kNvwEnQiet&_nc_oc=Adqqm9Um8PG4Qg0SfhI1fq51CAv-W2wrZbnQDwWTD2v3xuLL8MI8wldQOxuVOUAKjxY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rgNr9946OtnV9tBAjnvMzjhDUj-N5V7U8vq8S_wJnSw&oe=69D7A827"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
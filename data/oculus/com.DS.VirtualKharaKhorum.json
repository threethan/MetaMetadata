f20f&oh=00_AQCChWOMn773wyYgj8gkQ_BZ7ur_ULZII_g8mWsjaqiKXQ&oe=6A54EFDF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy3R5-fYAtgQ7kNvwG8EWfy&_nc_oc=AdpXf3qB9QPry50bki1ITSx0NEwhZ-ZDf-iaOqZMXKGjDTwNEMyMly3N1YDahlLE0DM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7OcHaOKJnv3lCDI7hz4IoXG0wD_9qW3ztQZM2kFb04Q&oe=6A5508D6"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wD1keYsiQoQ7kNvwHVzja8&_nc_oc=Adq0cTksWRkA9UUMYYwbAGduH6ltgyRx8PePRD-TtT8Gc5QUniaVQyeQWug745Mofx4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbjkpk1keb5ejYW6gWT5TbuipOi5vaQ889n_MfgJnTvA&oe=6A54FD47"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfV1TsA528sQ7kNvwHbZmL3&_nc_oc=Adp-2ouYLcktePrj6_LE-4bfzqHB__j3qu_TW0b5qPXzLm9uRgj2eqLzGtLQt99_qvQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtCOcpO1xf_sMr7OFpLVNVbaXhwy2hD4MhoQtXTyRKkg&oe=6A54F96A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiY99dBV_DQQ7kNvwFllj8A&_nc_oc=Adrq1h5cfWz0ZHLu9huJYXJP7cLqS0IAgtLykSv_6xTAl2wRFxAYhZyRP_QBLhbUyA4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtbKVZYycuQJ3yKLoXiKLVtu918IUGkUjyOzy4ML27Zw&oe=6A54E6A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
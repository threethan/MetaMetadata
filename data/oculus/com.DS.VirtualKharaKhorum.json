f20f&oh=00_Af1Dz9MQQPjaiaoC1bxZy2a0CYfx1GWJh5jzTjUCYYXBDw&oe=69F360DF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjRE8KR1pAkQ7kNvwHWf0HK&_nc_oc=AdrTKEGD5QNr83IyCA1IpUtiZPjC-1-qw7YJHS2n0WRSYlsTW6QOL4gq7obt_9zcugM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c8D96t0v_s7Tvv56IhA-LBRcXMvLDpgSod6KifPeQ2A&oe=69F34196"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6vMLytJ3ssQ7kNvwEVotiE&_nc_oc=AdpMivEJjRzNjE1sU5pLcqdY13WUU6RF5wWHt4covv5muM_eng_4cm6B_kd04mAXR58&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af331Wl1pi49w1mxs6cuJe--5VPyxrh_H8JCsX3UAzymqQ&oe=69F36E47"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwMA5Kuk0BYQ7kNvwFNSkdz&_nc_oc=AdpCFh9NIGIzdusgm3Moc7t0qVt-Ohlzr2nLCDGKdL3yl6XrP5m1-_EgbVdCw2y1PhE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cd59z1NLE9K3Z5OGXE6ruLuBxuoTpDanSzlP7vBIU0w&oe=69F36A6A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxDXTTP9EfUQ7kNvwFF3bzQ&_nc_oc=AdpiSOLRTEr1apGI0aF6wdhx40ilFMcmQLAU3Hsaom-7xE2WQs2KV79PRI1NOHL-NlA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DSS61Vm0MEbJGOVBuP1tQShI2yxefYrqx0Q--WjLcYg&oe=69F357A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
Nb&_nc_oc=AdqFNVUt_FeOKCGnsims0FXzn86NOpnBR2ov4cN-DyzxQ3IUKOLS2Zdfnk_lR4YMuqo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdzO-TgxTn0K7d4s-LroTrS1HkxF0LYdYGPtuT_gfHYw&oe=6A8EF1DF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbq3V_3totQQ7kNvwFXlKTW&_nc_oc=AdpAHf0ztu6QX7NGy8ZRItzj0r2M-yTK6Um7jcc69SqZ4sIqlMZMDYGSvyNZ1y9i27Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMgTutvD-s0WQlo3wxtsXifSsrXX87wv04ROfBmNhtCQ&oe=6A8ED296"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY-xlczmjbsQ7kNvwEbN6-F&_nc_oc=AdpdmqZRaoy-xrRO9mimdco9BNEyUx0IyRPH0b2Qicn-q-jC7hi6Z-Kn3sfvtrPxCDo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8xNtIR12vcaoSun93NRqZWWZAI6-SwC6eXpRK6rup0A&oe=6A8EC707"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RxRsEUGkEcQ7kNvwFbWz2T&_nc_oc=AdqLMjQrSnqlfkgvDQ1_HankzekmxmEWOTEYFpFBX-LdUa_Oqws3A6pxlPKIujq9rSA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExZIYAZJPGQafjMP3BQ2ZPZJCF2pkZcRcYoJsU4sLG6Q&oe=6A8EC32A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN4u1Pb8oI8Q7kNvwEQtq0J&_nc_oc=AdpXjIWw4aRsGrA39oXzqZENKR6SjqOgbWziNTyRrQP78H9c1U9o_BaGPp4qznb9kcY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4z-8sWLjmS0Wx6mcQUrFsPcQcVSRAx_ItPUelc5MDEw&oe=6A8EE8A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
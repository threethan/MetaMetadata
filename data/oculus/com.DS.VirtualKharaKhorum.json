f20f&oh=00_Af7xC8_K74Svcr1nnWGxLV05DH1qCKtOEshC_3qaL-eHJw&oe=69FF3E5F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZx9ckKN4vUQ7kNvwGAMukC&_nc_oc=Adr5IpqLNb_e8yzvr2w4aOUIPc6tt0aCgXIJrf7CK_AYf5OAcyft2rVT8QP-sKoJcLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cx_BgqY1Zni6uXofiirqpw1aJ30QHkPWnNNrnQumoAA&oe=69FF1F16"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpvbkNA-L5cQ7kNvwH1nicp&_nc_oc=AdpjGoByRTqW76GDyidtv4_HWeWPve8ygIhHa5AH50P6n8sXstnn8jlqfZ5izniCcZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68pjz-sTebIOXmeA0ZGRS3GH25VDIDgmBdqj4NC0MuCA&oe=69FF4BC7"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxC4qK-3UGIQ7kNvwFkAm8B&_nc_oc=AdpOaEMUgMrk3FYsKOavNmOPvPhXne4udbhBXzHAptu9y57b50eCj_6sP3khHwI-Lqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rik2V4SENCwChpAAsMpZDyyeHt9HjC6m8iHaTRme16w&oe=69FF47EA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka8QHO8sQCcQ7kNvwEQBwZ9&_nc_oc=AdrgxXzh0E74nPQOyfj6D4ZVWigFLKN7laFKFNFThH3bSqMME0wxLmFjgbjTXV9QIBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Sgnyv0jb5NEfE1D2lTLAf82XV5IUP-nF8EOd6z4GCYQ&oe=69FF3527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
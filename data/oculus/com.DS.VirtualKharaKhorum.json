a30f&oh=00_AfxAmv88Z_sDuFaHgHYu_gx5Bmqgim5_vNuORaCrIvkn_g&oe=69C53C5F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUSPj8V435kQ7kNvwFBCGWN&_nc_oc=Adr4h-tfVginuvPkw5aFLbH3mh_L2zDm3QGKzQlWpthCo-xfjtLhykXz3EJuewhUk2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAJ3PDpN8KjXPUdaYVpGeIzkDoTmJAK2bT_daUC_knxA&oe=69C51D16"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ERNFUPBo80Q7kNvwHsKrpM&_nc_oc=AdpC0pkR6ncMftWI4q1QcBr2zHILeTh2yFI6180bxOiAZVE8qkQBz4RruS_nyQ5bOzI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFDFVahmWuTx4FnziEsGdHVqn5GEzEor_B_02PNlHszQ&oe=69C51187"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUagYUs3A9YQ7kNvwEzF2nz&_nc_oc=Adpinm0LZIeXBSmDSnqO8VMXicpi7ryE5f8AprjhFWap1rzh867JWQgZ4aBonxXOfu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIXr13WimEqlT745Db35EF6FZv0R1beqeJj7V7onz3oQ&oe=69C545EA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUkovyCnXPgQ7kNvwHX8zu7&_nc_oc=AdpUZi8iSGykJEm103kXS-u4TG9zM_g307n0qzEmLycoZS2PnZtwWXKRfmDMJaN7ayk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzB02G-5n75yWozwjWmbEpjZJPB9_8I3rXG88dQzyd-Hw&oe=69C53327"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
f20f&oh=00_Af5ZaCT-WspScni7Y749XHZci4bJ5RHdzUM4HwVqcky4HQ&oe=6A1D90DF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8xyRT7mRHcQ7kNvwFV9FrG&_nc_oc=AdpydQ0pgYUcY1HNnwGx5r7gu1HeuY3vL3fIGfnAszmEAOZ16MeHy-Fja1FaUu-zEbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xalbYIXFStpC_d7XdlTVlqWZtpOFpe89UkZZVS1Vf5A&oe=6A1DA9D6"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrYVj1utjI0Q7kNvwGq38TB&_nc_oc=AdpSqOXTBA_6HZzvd8qAdOulneJU25b-5YhenDLzQ_WFKL2hpQy5NtlaB694QLlX4cA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aamTC5-3VogMGoF6W7ak_uQSaecTDFiYjzeFVZATU1Q&oe=6A1D9E47"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89b8Ah5qYqYQ7kNvwHwt68C&_nc_oc=AdraGWGOfMxFeUW31pYKdtaE_qQrzoTmcNNKENBqUoErR7WcqqTv4I64XT5gR1t3YqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pqvVaA-tXMiyNoP66GPpCoOtKrB3FfZxQV7A8-7fGuA&oe=6A1D9A6A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvcMI-LgN90Q7kNvwF2yOcl&_nc_oc=Adr_oEBWoNW95yZtSYEAC4lGMluNU5dNsUAgJQo8-M_UVfEu3e6WiFx2V3u1dNDsWwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7StMcEYrH3AXr6d3oalyFK_FEh3K-B1ROj4Mq5ISHUmw&oe=6A1D87A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
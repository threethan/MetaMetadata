a30f&oh=00_Af03aKdb_7ZN75XY65GA5Yb5285DJrr8ajrmna1EwUd5mQ&oe=69EA265F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I6Hlq8iDWcQ7kNvwFq9T5a&_nc_oc=Adrg3LUMJDM3A8Wkww5_Xq4_GtMV8YY4bwaBV7_ireXZ9oMfAhIP1A1P-AmyPfcAvVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hGz0boNqHTPsEuxCv2UCpR7rRKPoK7q8HWJzlKCjffQ&oe=69EA0716"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeXdJhUBgZkQ7kNvwFIv0ox&_nc_oc=AdrRYEvLrPPDQihgGzzOjufjQj396eRqZKYLIk0WjSOOwH1V14wGhJW_P3WfHuvUW6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03PT4I-DGeJ8JbwqqrraN-jr8SoFB8l9PDU5UhmpxMIA&oe=69EA33C7"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxIDptynaYUQ7kNvwEHkspK&_nc_oc=Adqq9YV0jSBgXGQfTh_P75gjzKDlpieLHKNaVHGJmSmL8XuX_-0hcKPpOhvwkZ_AX1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PhLEy0njg7MbFn_uZoMAxCtM4kHzK7OMvwEYpDqJkaA&oe=69EA2FEA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8upoPCP1A4gQ7kNvwH54ZKG&_nc_oc=AdrnO5SMa4ErhIKjHVwxKt3K2GYBieu6DMxA_lntvOAzzFma-Kr4SUj5_rNyc2CG1C4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kOdNDjk0tFmusCi_Zp6Dos3c4BUnNAHkQ9kqRgpPBxA&oe=69EA1D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
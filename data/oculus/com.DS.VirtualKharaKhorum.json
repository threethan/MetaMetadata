f20f&oh=00_AQDhbUnSHJWGczGYJ_OaU9imvdqq3p5wR5zOrxvncP05Ng&oe=6A68B65F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cusmkz6GR6kQ7kNvwFU_Nnu&_nc_oc=Adq_-b46XezXNE0aJmJy4k2oP3COI4u2NoRMFmktPs_ailyyGL9AoC2_i2HWPBlJ7fk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoW3LBcJkmeAEgnve0_1sIWq_gBw_yEp1gtCH8mmANBA&oe=6A689716"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iFUXb2u8JMQ7kNvwE4vqhz&_nc_oc=AdrC3rWEpffwXFCJaPy2A8Ng_X69Gzi8e6hwwPs6zd3A6akL_dzUuBlsNr5iU8_gyuk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxRJ36bDamg7VXVGkrRmwXHW2VZvr4nS9Ius_uqSWpyA&oe=6A68C3C7"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-e3Aaaw9q4Q7kNvwGUDjpK&_nc_oc=AdpxVuX1W4VS__q-D8dc77per0sRtHnipMBaTCLIDtT3y-eqaDleiwKrnRuXnKz3tmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVpXRFwnDZKqdG5MZdMDn1IwIyS4Ll4aTQlHWz7b7Mlw&oe=6A68BFEA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbN-Y38Ny2AQ7kNvwHBvPG7&_nc_oc=AdpAe65oYbOryG_NEn8rWxjTBujqkhzL0EVQCa8hFpinM2dWLjLoFa9mQW7Tq5kpCAo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCts_Hrr_Ej-0dkXMnWIvBc-CaRjOjjZzMLZxzlg5A7VQ&oe=6A68AD27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
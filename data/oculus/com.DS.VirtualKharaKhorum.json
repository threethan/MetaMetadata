f20f&oh=00_AQCkN5whk0_I_IfokeHQXssw7sMLbbN4SR7w5Pr61NhoPA&oe=6A4A63DF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxvlwL9-b4MQ7kNvwG-05qm&_nc_oc=Adp7eeF3yBO2TH_QAeGBsoOcDrOei9TeZSlC5LUXoFWUt1-hPyzvGd2zPCeQj9YOdOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGVhMp_QPM-FEjpH85iYruPvU5aVbJCB_T43S66wv8hA&oe=6A4A7CD6"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ux9Evijg8AQ7kNvwHpTnxI&_nc_oc=Ado1e2hzOZYeAJc0iChK4HB8ODdWWS6x60ZAlb8rd6i5r9_Yth2YRd7KY84LwGMgvno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCacv-c6hPwf7ULHdsQcv5Q4FfmgUPCbo0_xeZ0Y8f5ew&oe=6A4A7147"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ItFF_Vq2wgQ7kNvwFCmFCb&_nc_oc=AdrqCPCExDKTnfv7gXHHpSIhfsTNJRm0aqAnsa5HIv5RokwRrI0Qzj8gush5bmYf0Bw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIrqK20H7xAzveyx0A4DlfqFLWr5Lvobz8zAn6iOTbew&oe=6A4A6D6A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3fHreatAk4Q7kNvwEycjJc&_nc_oc=AdqX9sdo-Oxn4q6dTqh5A1TYJqMwaGf4de1QnkzCq6jfOy7EQk1c4w6UNlEv34diqq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJCHckZEuNygUlFUWYravpiA1mm_niZHObymD8kIALiA&oe=6A4A5AA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
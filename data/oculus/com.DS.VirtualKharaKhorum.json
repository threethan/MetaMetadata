d": "647016961301385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScFmUfmkghcQ7kNvwFX9a9d&_nc_oc=AdkW6X85H1rRhNFk_divrO4GLPNH23nBL7DXeTvVKmGUvIc4sXQZUGXRz3flqzmWAYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu05A6rdU3ZMK2rpS00AoxGAfS4iuMO1Q9PkkWyAJPcSw&oe=69A2D616"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EniNXP9LqLwQ7kNvwFgCgCO&_nc_oc=AdmKG8HKb2W-Y27B8gPjbYB8ETXLKhO9mY1ejnlSP-muPiIKLqiDWOizXbqgdJ1DM78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_o-3otTeBI2fqGaBqvltKCrOJD8FRh722zAo_MeX9Bg&oe=69A2CA87"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ8xfq0cK4UQ7kNvwGo2vjk&_nc_oc=AdnsWmCsVtxzVhRpfnIkqru0DiTNZzYDUMaI2N2l95mWrmyjt6X3Yg4hEW2b4pMnTjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6JYVELeufEDUbNhy5h5SSqQJsjr-jhjPPA9RbCTDOnQ&oe=69A2C6AA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxAYUiMji1cQ7kNvwFjKskF&_nc_oc=AdnQaqtwb7kbxTtZ0uHoRQNYJRegdtxoJL4FZT5C1yBDEv0OINcinqaITS4tzAODZ78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2Kv96BqPprlR6bpyzbnD1U7F6vMMzFu1RPEgI3Fdp1Q&oe=69A2EC27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9418635424871269"}, "review_messages": []}]}, "cover_square_imag
a30f&oh=00_AfziCRxGURZrgILgwAJ1ambhIopquVdrapyuZ73WTiDrRw&oe=69D119DF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG72i9-yaQ8Q7kNvwFQOVc8&_nc_oc=AdreWeTu20QWIgpWC0fDtelWjtnedLzeFmFq6qxgxWUmSzU1DL96gSdmiYWnjnc7hTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz5yxZH7YKzr0bEl5aJV7lHVsnTCshAJ7frJpDMs6tEg&oe=69D0FA96"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOjhwjgqbIwQ7kNvwGojf33&_nc_oc=AdrkrmlzvN4avm3lQhKdU3_cFsKTxTiujDH4hdUY1HWCju9rII8YiRJYxwg1wWN_5qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziFYcgTqnoj13t4pAFeIK-nzAKQ6kbL1SPIKm0NT6T7w&oe=69D0EF07"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YmeI94B8dcQ7kNvwEPNA4E&_nc_oc=Adr9TvD-eB2LXiaL44n-PFbvcV9G4_J2jhaXflhQFvYbHvM0UpIrT_QMuwDENgW4uTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfW4fWRDF9YPsaKPnclF9nMkMmPbCttJot0h2_tKPlFw&oe=69D1236A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lSGfPGK7PgQ7kNvwEmPNBj&_nc_oc=AdrQDqp5coMrp8i0zGOYWypfOfANpqf-Sm5-wObp9voGpZayRFLHjT37CMFCYzLnubk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhmOTpbM5lT4M_msUaOs73prhieSvCg5EqN240dRPBlg&oe=69D110A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
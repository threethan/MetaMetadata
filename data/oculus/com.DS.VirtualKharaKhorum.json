fn&_nc_oc=AdqphZMTFEHLA71r1UBqIbgG8Y6a3N2-EEfDh7pRztf7QWYxcIuFRTkgICjCBvanjLI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuGg3DsW66hzP7hQp4Qi8aXZtM2HkajUphwrQFmN1b5Q&oe=6A8D681F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbq3V_3totQQ7kNvwEQKBBq&_nc_oc=AdrQuxa4XclBrjhmHmKUv63zkyusAwxNkN3qCAnmIcBLQBpw3xLc77rorHMcsE1QC7M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9HZJDFnsqowKwh9X0fjeB4eaM4QPmCjHn0Jwj0vKmXA&oe=6A8D8116"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOJUUH0doXwQ7kNvwGPNuYS&_nc_oc=Adqwzc_-Mc6JOmwKNEyaj8r8bQLxg0DhK3AVHTi3ZNDjQC6lcaK-0L6-5do0PKA16DA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr_Qxi9JBOTAzofb31rUEuhOL8uJiTSyRS8xd_vdJ8ug&oe=6A8D7587"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7brY6MgJR4Q7kNvwE77AFj&_nc_oc=Adpzp2aGKiyeUShNlsz9HxXhzLPyKePJ5zWELCtB0PopfuAlF7VejVj6kL2zeAOx3do&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7yCW-i8mrk_CCoeEx4Tk9bS4-5ie_zuNVlSdhORkZzw&oe=6A8D71AA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN4u1Pb8oI8Q7kNvwEaHDP6&_nc_oc=AdqujukA0itsNS72td30B29U7QeT1Y_yYz4hj4OkSQjCf31ewTbla1vC8C4l0FEyjf8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMKWnOkiq2rnka9kXNTKwVR8stSEChnDnaoDkZLpCu_A&oe=6A8D9727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
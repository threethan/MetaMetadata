f20f&oh=00_Af-S-sqoO7UwJUeyjfKqiYP-g8rSHUJt-Gl_L6f_7sFqlg&oe=6A24285F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0D5KlWYMwcQ7kNvwEnUHB3&_nc_oc=AdoNct_N_Xqfr10Lb6BcGh-p0EgmEwd7KWQAQ9gCl49L9yBLWL6OqtzZH8POoQ_sojM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FskQYy95gRClaDMz_XfFs0KmFzzoY0W7OLg4EEOw4YQ&oe=6A244156"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3-sRNzwmRwQ7kNvwFihFlU&_nc_oc=Adq_fCkCqfgo-wH3D74p2WVZ3aSSouIj-C-BLa6GjZPAC6S4oGuqYw5l7gEUkziXa9I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MsmPXqSTbP4u7Oec7IdzM1W5gQbm--7tLIM66Z-bPng&oe=6A2435C7"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=allRjFCDsJUQ7kNvwFeDipi&_nc_oc=AdqATzlUQ-i-0f95CJu-giBPREJ_2tNwuJvbODflpMniXvOdwwYzqoNX8P7Y94bjZLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wNyPAb1ZAzuYYRdJIXUIK3kDCSe5SEQ2VMP1KvWhFYg&oe=6A2431EA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIGfktE9aTIQ7kNvwG2S6E1&_nc_oc=AdrKidlbAAe73cpaLHZbji701tIaZqzUXvK52Z2bACxvFoGJTI6rCiPQQ2-cezawC44&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DZqeghT9d2uakbHYwNTpqgJTLX7H_tu57APk8vXHKng&oe=6A241F27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
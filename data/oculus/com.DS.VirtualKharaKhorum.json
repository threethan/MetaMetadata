kKTCtEwoDhulwKuFgOmVvJfeg&oe=69B56A5F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPpQr-QRYW4Q7kNvwH8n9KV&_nc_oc=AdkL_x_3YBW8LPC6x8EPd9GicCCXT07ovn6jFb9mgG6iNJxsSwV9tF_LcPQ6lDZhXIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnoQ4a29W98irvAvBQP0pkoJw6Ce6NyV4uwbgCTrFT4w&oe=69B54B16"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efws_Hg5Gt4Q7kNvwHEeXPR&_nc_oc=AdlnNYhxqqFLhdbVlaW7qP4erXlypO_IcoAQoziYE8klOGzIJI25lk1mNPgKq2SMA8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWEoZtm8AHdRWTDXAfNOLmR7IIj0gLFCCaJccTJFXe5Q&oe=69B53F87"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUr6mrPRiFAQ7kNvwHWn_y8&_nc_oc=AdmlVzLG8dG0BbeYKtEwcs1YDy4L3ivRCOUd0wsG8pfK8j-QMZUNWDVhQ-uY5UHpjWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtzE57gpYDyRE-pd83FVffd4F2hWBsjJ6YhZ5WsCzIJg&oe=69B53BAA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtCiMR7RT5YQ7kNvwGeCKi8&_nc_oc=AdmUzAXRej3WkAS17z2zEK_BmOofW1jvnrdeaRrvLLk6htR3utl0F7YeN92jrQnTskU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYBGFtsCqqu4mntexixV67f9flHm-jFOai0z11XdRVbg&oe=69B56127"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_
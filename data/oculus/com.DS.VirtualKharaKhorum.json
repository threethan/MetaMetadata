f20f&oh=00_AQGfyUC1t0kC5yoZGK1fxQrpqYk-0JqLmGH52Dxbf7Cu-Q&oe=6A8C169F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YirMOnrklqIQ7kNvwHimyRl&_nc_oc=Ado4o0v_4eWsQCB-AL-Zhbs9YgYUA-dKxqUZGJc7dBJkH-V4Yn7S9gwXo-fkBHzyOmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeK1s11zbHkFxOsTiWFKB-5KQGKY4RYjn4HAMR_T1yNg&oe=6A8C2F96"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOJUUH0doXwQ7kNvwGTuDQ5&_nc_oc=AdrY_bctlzAOJ4rETxhvHQmlFe6dwXfnW6MTV7uAoeAhQ7s9hx1wCXHW3l9-kXN6lCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnSJCRTOcj7GFIqMCi3LdnDc1JmGhk53T4euTsDrB0-w&oe=6A8C2407"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7brY6MgJR4Q7kNvwEynvDO&_nc_oc=AdqbVeGgp8mOjbxn6OFLhGQHoYCfkEqK0TvqhmvbabXe4swPRQJQe3Ho0BSQMFsjbvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBPHKBPMSqjpb__DmRrJuBZW7LZG3KEt4PtND2uDh0lQ&oe=6A8C202A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN4u1Pb8oI8Q7kNvwEui-5x&_nc_oc=Adq6TYp_GOd6-VwmBgsmviwPytwIk3OI-eO7wKN4pRR_ksd-hFvg7YxnPkz662G4Od0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFHz_X0B16KRmSz5hQ-iVCAx0ikZGSv1QfP5JrWmnwVA&oe=6A8C45A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
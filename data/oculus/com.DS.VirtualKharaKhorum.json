guo&_nc_oc=Adqx_t1HyWdJ9Gpb_H5I-D5ktJl6CyEreJhmotwjhKRiSp3oU9LdjTMURfdls6eBJ1c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOI_q_nUqT_oBOz-Ktk2QW5AeKHXdKLxTclQnLANnglw&oe=6AA94FDF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FTm2PAlUycQ7kNvwFiHv95&_nc_oc=Adpmf08Jto9iZRF--d0ZgRMqqPVtChFFnAZxDFRyoXTLAmpBEc-oGCYNn5dmrjG7tY0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNxeCiF9rK1Uw1lE4snBbgakqTIg4QbeLUpIKQAPxpOg&oe=6AA968D6"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E6J41JvixgQ7kNvwGmE-Go&_nc_oc=Adq3bbyuxYrWB_piwVk4SpIYLBoUVwmPriiyKw-HD7J1RbfYGRrTnwECK9nOaHM29H4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgO_FlDvOkAHFOvZ6rjuFNVG3_8M6-lNQ6WeduBkPOIg&oe=6AA95D47"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-Vli4KrwHsQ7kNvwEwiMup&_nc_oc=Adqqnjh9W3JfwADXLNtXtWGDEUUFQe7k3Hb9EymlDKEH_y29qZbcHrnIKmkiw6ZWp2c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQNyotOIqXKvi5_qsq0yz4fYtu7Ls6UEGXQd5YC8fTsQ&oe=6AA9596A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjEoqptjZ9kQ7kNvwGGfmdm&_nc_oc=AdqQLlIG_hNLMUGuNZW4BHaf9r5FaVtMcapEJM6gX5LXcJdPL2EVoWhWI6xnCawZyk8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgq3ZGWRLrAz6HLNuCWjtlcFzDlHqYfZAI-xsg1bQ-eA&oe=6AA946A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
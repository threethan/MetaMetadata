f20f&oh=00_AQCZqxshSnV-apgxj8PCY3y-8NpjTto-MC9KvKVPBy80dQ&oe=6A6CAADF"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_GvWZnl5soQ7kNvwEfu0xF&_nc_oc=Adom1vFZUmELqZ-z2tZy4BkeYOeB15c4KAh8xXK8fKKckdVtd9gkSCkVM0BBs2x9j6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB-5NTzvXRbE2bzrIh8UKDKsw3C0mhKFDBreWLBVCjgg&oe=6A6C8B96"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zS99p-ZF2oQ7kNvwFziAnT&_nc_oc=AdqyQkCfamvX47DeycCDX2BE7eN6sBSkwzRGJX6fyN_Z-bNfisLqbfSfD4HtIMhlumk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmiA-E-6cpOK4TzN-dISFJSghcu-5L8w1TzjrvlqdPhA&oe=6A6CB847"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MRtEuVPBYcQ7kNvwH9roFm&_nc_oc=Ado7-mwpxpVmeN_yz0XJYBC6VxUyLsCFswSE7mT9qBHZC6TJcquCQHWwi5bIx8YFAuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlIj6o39A8itC8lRepL1fJQCDItie0JkibujfF-F6w3g&oe=6A6CB46A"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doPOFvYb6BEQ7kNvwFJ0q0D&_nc_oc=AdqVyWvqJlbOnOi4slzMTq3PpGtCCO3S_uDeLh8uap8VpfCQfgGS46pdEWnmfHwHzc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClZDPd-qAHLx8neEOPLVLgwPVNRbO3SueBk7qqZsgnQg&oe=6A6CA1A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
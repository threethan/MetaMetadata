b=1-7&_nc_sid=6e7a0a&_nc_ohc=S0yoJuy4fdwQ7kNvwEmcOxI&_nc_oc=AdpDO4UWZd9xp6oYajOGYR3q-ySZ1wo_8Nwazm_Z6lylUlIerStmxyNVvlKlRhoa51c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7uWGgDJEAkPSMDEstkgCA-7hIbbUSIy-XZdKUyVZedQ&oe=6B0C5F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
f20f&oh=00_Af4AnLXOppfSKOUFwpTC6jDSVKkkvrO3p6hbXdf5cfNCPQ&oe=6A14565F"}, {"file_name": "image_1.png", "id": "647016961301385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_647016964634718_6235326209087386999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZYVxdYxV9cQ7kNvwG7crWq&_nc_oc=Adr6sSMOgdjw8o2x1iN0HpolxoKUorPU-IXjy4zxEg4r1x9KoZ4i2jZg0XsgdjQjYNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YuqmJDgFn184T6ATWbAZdMbcjky-slA9IdOs8GqUODQ&oe=6A146F56"}, {"file_name": "image_5.png", "id": "2416878585333691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393780_2416878588667024_100334430558608085_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33nxaXwfDj8Q7kNvwGMH4uZ&_nc_oc=AdoedIRR1Z5C2kQLpZHbCxALnZ_vg16ANGpgsHciPIuKG02Zl4UfINcurCzfrS1G2A4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lztrSdvY72xGtPJErd9RraocIimEB5v_Z9pjiiyk2gA&oe=6A1463C7"}, {"file_name": "image_3.png", "id": "1170553634718873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392104_1170553641385539_8714562123656965505_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7a-lyinmsQQ7kNvwGAzSWE&_nc_oc=AdoDkqwgqS6U6hNp2hLgEAPXA7XFKpJLPLh0gopjY6nxROWV_zWjUw4XRsSEaN85feI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kCGafxG1fPtGaBzhErMjPIU3H7-nCz410Joqq1nN4Tg&oe=6A145FEA"}, {"file_name": "image_4.png", "id": "9625316710866167", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391935_9625316724199499_8778548239476406263_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oGn90S1_2UQ7kNvwEAyhml&_nc_oc=Adpp1UJ3i7VNjY4o_BXGLxuV6dqSGswCMLv7BycWc1wsuvO6o_KAWFUeVRkO4T0BgVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43QUNnFtPIR80U2bZC6lRBBWDqMnnobcg2WP1w-bxVbQ&oe=6A144D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Kharakhorum World Expo", "keywords": [], "long_description": "Virtual Kharakhorum is a stunning VR experience that transports you to the heart of the Mongol Empire\u2019s legendary capital. Once a thriving center of culture, trade, and diplomacy, Kharakhorum stood at the crossroads of East and West, where caravans, craftsmen, scholars, and envoys from around the world gathered under the watchful eye of the Great Khans.\n\nStep into a faithfully reimagined city where the sounds of horse hooves echo through open courtyards, prayer flags flutter in the wind, and the spirit of nomadic life pulses through every corner. Wander through sacred temples, bustling markets, artisan workshops, and royal halls, each telling a story of Mongolia\u2019s deep spiritual heritage, skilled craftsmanship, and vast influence.\n\nWhether you're here to learn, explore, or simply lose yourself in the beauty of a vanished world, Virtual Kharakhorum offers an unforgettable journey into one of history\u2019s most fascinating civilizations, fully brought to life in immersive virtual reality.", "short_description": "Step into Virtual Kharakhorum, the heart of ancient Mongolian civilization. Discover a culture shaped by nomadic life, spiritual depth, and the legacy of the Great Khans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
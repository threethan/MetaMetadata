ad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTr-SzF85tuheNpsyCHV0GUz5H6BY235G0iJ4pntm1lQ&oe=6A64A3E6"}, {"file_name": "Photo_20260614_015633.png", "id": "2521282554982545", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294616_2521282558315878_8064303755678672902_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY2HcB-238oQ7kNvwF6-w2v&_nc_oc=AdqJzg8rq0hQqWCrzoRL336bj4_MojoTcWWOThwkYfaz4bEF73Vbv55J_kQJF9ZtqL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKTXUV4jN_drHG4lUkr42LGlPx-t0irrC1r8LWZvJ2mA&oe=6A64D527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VECTOR", "keywords": [], "long_description": "Welcome to the world of **Vector**!\n\n- Run, jump, flip, and climb in this Multiplayer Parkour Infection Game.\n\n# Get your game face on!\n\n- Join The Hub, find a lobby, and lock in. When the voting sequence begins, every player in The Hub gets a say, choose from three maps and a game mode. First to majority wins the vote. Then the match begins.\n\n{1555429052654008}\n\n- Once voting is over, the match begins, a countdown starts, locking the infected in place as the survivors get time to escape and run for a headstart, once the clock ticks three, the game is on as it is you The Survivors versus The Infected, survive the match to obtain points to then earn cosmetics and other In-Game goodies!\n\n# Post Game and Customization!\n\n{4032660900202340}\n\n- Welcome back to the hub, cool yourself off and take a break! Walk over to the computer to customize your look, with a cosmetic browser and store, igniting your look within Vector. Go to the settings to apply yourself by changing your fur color and mixing your player settings for a perfect experience.\n\n- Once you are out of the computer room, you will see the voting area, to your left and right are two shops, one being for the survivors, and one for the infected! Make sure to stop by to excel your look even more!\n\n- Now walking outside of the lobby gives you the outdoor view of The Hub, green grass and flowing trees will sooth your mind after an intense match of Tag!\n\n# Have a wonderful time when playing **Vector**! \n", "short_description": "Welcome to the world of Vector!\n\nRun, jump, flip, and climb  Multiplayer Parkour Tag and Infection.\n\nJoin a lobby and get ready, once the voting sequence starts you are locked in for an intense match of either Infection or tons of other game-modes you can also vote for! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refresh-games.com/privacypolicy", "developer_terms_of_service_url": "https://www.refresh-games.com/privacypolicy-1", "publisher_name": "Refresh Games", "support_website_url": "https://www.refresh-games.com/#contact-us", "website_url": "https://www.refresh-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "27422391210759926"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303377_3009304085930780_7635301980692309390_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhdzyWQPmDIQ7kNvwF6F54P&_nc_oc=AdpurWXJH2epnFlTs5VlJOSU0J-5uMk-0oi2AycResH-7DNct-a-Ixdp-8t5CJC45ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJPo2ystjg3ZvdYuMb8ydRnl3Ip7CCPXJ4QcujtJPVoQ&oe=6A64C016"}, "
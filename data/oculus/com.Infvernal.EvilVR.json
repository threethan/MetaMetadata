lete puzzles to find your brother.", "short_description": "Will keep you in shock while trying to escape the evils that stalking you, you will end up horrified when you see the creatures that await you, monsters, malformed fetuses, zombies, creatures that never had to see the light."}]}, "developer_name": "Adrian Iba\u00f1ez", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/controlpanel.htm?first", "developer_terms_of_service_url": "https://www.samplestore.com/legal/terms_of_use_mobile/", "publisher_name": "Infvernal Studio", "support_website_url": null, "website_url": "https://www.facebook.com/InfvernalGamesStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2972205856378471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162769_576154322732154_9223303008140394496_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP0uLBDZaswQ7kNvwEK41wu&_nc_oc=AdlejWsr-NVHDAmu1TW1v3-1wJstzcDiE3jzGdcdzpIoEgHUVvnmRRunZ8GNm4xLmqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0NvYmGagUm04jmBrRFfk4mi9kdAAD5XTMAoupyrLYvw&oe=69B7F59A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Evil Silent", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1520354369, "lastRevision": {"nodes": [{"id": "1122494807856506", "release_type": "SCHEDULED", "administration_status": "AP
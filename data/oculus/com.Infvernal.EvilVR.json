", "Action"], "long_description": "Your brother has disappeared while investigating some events in a mansion that should be abandoned, so you will find him, soon you will realize that it has not been a good idea to enter this place full of strange creatures, dungeons and failed experiments that stalk you from the shadows, you must get away from them and complete puzzles to find your brother.", "short_description": "Will keep you in shock while trying to escape the evils that stalking you, you will end up horrified when you see the creatures that await you, monsters, malformed fetuses, zombies, creatures that never had to see the light."}]}, "developer_name": "Adrian Iba\u00f1ez", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/controlpanel.htm?first", "developer_terms_of_service_url": "https://www.samplestore.com/legal/terms_of_use_mobile/", "publisher_name": "Infvernal Studio", "support_website_url": null, "website_url": "https://www.facebook.com/InfvernalGamesStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2972205856378471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162769_576154322732154_9223303008140394496_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGbpFT8Lk0IQ7kNvwHCl0-0&_nc_oc=AdovK33p7-o-gineViTQDxJDl2RPKs19cG2yr3L1KY2Uo8VmQoZa2aA92lkf21VQbg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
c_sid=6e7a0a&_nc_ohc=kb7cdEF3n_8Q7kNvwHiSn2o&_nc_oc=AdpcOURGXyLOQBn6sMLY1QI_XvAZnPJAEVmgHU3ub9FKjoTxeDy2iccLElC9DocnA88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMYS0dJ9y6BtHkQS9BD0jnUSGoRb1ZrG2FtvIC0sFkXA&oe=6B0DC1DD"}, {"file_name": "Screenshot_5.png", "id": "3979820818906030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618892_3979820838906028_4597339069073015183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RSt5mAMJusQ7kNvwF4qoRS&_nc_oc=Adrla75Pua1Gz59H3729nm0ncR4RaXAE1Y7QeVHN-IGUuqAhRKj7p5-S8fYM0yYPD4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQi6qYJMM0Oy2y8n_-zpe-2zt9W8xm85B7sG6_GhINRpg&oe=6B0DA748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GIO TAGGERS REBORN", "keywords": [], "long_description": "GIO TAGGERS REBORN is a high-energy VR multiplayer game that redefines movement-based gameplay using Gorilla Tag-style locomotion. Step into a world where your arms are your only tools\u2014no sticks, no buttons\u2014just pure physical skill and agility. Run, leap, vault, and climb using real-life motions as you chase down opponents or make a daring escape in fast-paced tag battles.\n\nWhether you're swinging through urban rooftops, scaling massive jungle trees, or navigating futuristic arenas, every map is designed to push your movement and creativity to the limit. With fluid, physics-based locomotion, you\u2019ll need lightning reflexes, sharp instincts, and flawless timing to stay ahead of the tagger\u2014or become one.", "short_description": "GIO TAGGERS REBORN is a fast-paced VR multiplayer experience that uses Gorilla Tag-style locomotion. Swing, climb, and launch yourself through dynamic arenas as you outmaneuver rivals in intense tag battles. No buttons\u2014just pure movement, skill, and chaos.\n\n"}]}, "developer_name": "justiceformatin", "developer_privacy_policy_url": "https://sites.google.com/view/giotaggers/home", "develo
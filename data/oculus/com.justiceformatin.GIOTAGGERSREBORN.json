c_sid=6e7a0a&_nc_ohc=mKG67SDC_78Q7kNvwGKC92L&_nc_oc=AdpwmlBOl_qc5IxRgXWPsaSlcbgNXBrYrujTwIYrTwll4gzVLCcINGg5giwv_npN_Rk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxjSobAMyqg6NZvBGoMC77KypqwVpwn4QEL7xnM05gYA&oe=6B0B1EDD"}, {"file_name": "Screenshot_5.png", "id": "3979820818906030", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618892_3979820838906028_4597339069073015183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzouW2TL8skQ7kNvwGRzxuw&_nc_oc=Adp6fRG435DyRg7vPuNVDBcZFH5kkD3KPIl6Giwd-Hljxr4upmD849DHZr_dTuuCNVE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQG7Gjq9fEhe3lG7iyw2D8xcq_CRCaAogrsJ_1PLerq1Q&oe=6B0B3C88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GIO TAGGERS REBORN", "keywords": [], "long_description": "GIO TAGGERS REBORN is a high-energy VR multiplayer game that redefines movement-based gameplay using Gorilla Tag-style locomotion. Step into a world where your arms are your only tools\u2014no sticks, no buttons\u2014just pure physical skill and agility. Run, leap, vault, and climb using real-life motions as you chase down opponents or make a daring escape in fast-paced tag battles.\n\nWhether you're swinging through urban rooftops, scaling massive jungle trees, or navigating futuristic arenas, every map is designed to push your movement and creativity to the limit. With fluid, physics-based locomotion, you\u2019ll need lightning reflexes, sharp instincts, and flawless timing to stay ahead of the tagger\u2014or become one.", "short_description": "GIO TAGGERS REBORN is a fast-paced VR multiplayer experience that uses Gorilla Tag-style locomotion. Swing, climb, and launch yourself through dynamic arenas as you outmaneuver rivals in intense tag battles. No buttons\u2014just pure movement, skill, and chaos.\n\n"}]}, "developer_name": "justiceformatin", "developer_privacy_policy_url": "https://sites.google.com/view/giotaggers/home", "develo
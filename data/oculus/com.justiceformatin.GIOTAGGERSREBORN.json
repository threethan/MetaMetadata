FTUnrMQ7kNvwFmE5Cy&_nc_oc=Adlg9PESoRyDaw73DoMw4EaDAYE4OkkMJs9EeJRW5l4QFvWkPdHakpgK7q-XBDYpDnE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuM26j_YwBId459t4mfShsm6KQ5KaVvy_VXg6QMoKt6wA&oe=69A19108"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GIO TAGGERS REBORN", "keywords": [], "long_description": "GIO TAGGERS REBORN is a high-energy VR multiplayer game that redefines movement-based gameplay using Gorilla Tag-style locomotion. Step into a world where your arms are your only tools\u2014no sticks, no buttons\u2014just pure physical skill and agility. Run, leap, vault, and climb using real-life motions as you chase down opponents or make a daring escape in fast-paced tag battles.\n\nWhether you're swinging through urban rooftops, scaling massive jungle trees, or navigating futuristic arenas, every map is designed to push your movement and creativity to the limit. With fluid, physics-based locomotion, you\u2019ll need lightning reflexes, sharp instincts, and flawless timing to stay ahead of the tagger\u2014or become one.", "short_description": "GIO TAGGERS REBORN is a fast-paced VR multiplayer experience that uses Gorilla Tag-style locomotion. Swing, climb, and launch yourself through dynamic arenas as you outmaneuver rivals in intense tag battles. No buttons\u2014just pure movement, skill, and chaos.\n\n"}]}, "developer_name": "justiceformatin", "developer_privacy_policy_url": "https://sites.google.com/view/giotaggers/home", "developer_terms_of_service_url": null, "publisher_name": "BIGBOITHEBIGGEST", "support_website_url": null, "website_url": "https://sites.google.com/view/giotaggerwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
]}, "id": "1204325278053515", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1007970757770598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299786_1007970764437264_3831179960473286182_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkIlMU4AcwAQ7kNvwHT775c&_nc_oc=AdkmAVY09WixlbHHQ4u6HfqwGWLUNO2-UxcKPUJ4ddrE38O9BiDN6lnVx612iAn1-Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3Wwjz4icaQwD8MjiNF1jUB1LTCY3xYuMbVVoSDBZ0Rw&oe=69A2C5D3"}, {"file_name": "Screenshot_3.png", "id": "1474910303498710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1474910306832043_2051620458961005464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw_rU51AGpgQ7kNvwHbXasj&_nc_oc=AdnN6mlG_PvbZRbkCT96NoF5nMiFJZI6jUlflDEXI7iuT6Z6ggSUst5HjRSwtLKjUxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsjp5eorlnNhHGwPO2lQ29V8yap5NvLT_qc1jorvtnaHg&oe=69A2C62C"}, {"file_name": "Screenshot_2.png", "id": "966202815439560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620559_966202818772893_5546296736870068676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPCHRCwKR1oQ7kNvwGl2oTE&_nc_oc=AdkJ9hVrnqFBWmKCMoqrB2IX1uwnx1pXxsIUk-bNNkYCdtMkneIA_Via7io1fk4-_Jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvK0CHtPX0HniHUTQLGeoxdADdlB62Y61b8AoweAB_mgQ&oe=69A2E697"}, {"file_name": "Screenshot_4.png", "id": "1691317088927744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617767_1691317095594410_7275408674601274732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETwLsOed6n8Q7kNvwExT6Re&_nc_oc=AdkGvlFtoHeBbINmP3Iac36oM_BRpYF6LFxFZ0-fRqojFbpE22UTm5usG-auLuK99KU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_0ZcrXX5fNU3G6vkeZqf47ql8TvkV-E8g_sJKVEVlnA&oe=69A2FD1D"}, {"file_name": "Screenshot_5.png", "id": "3979820818906030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618892_3979820838906028_4597339069073015183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4THqZFTUnrMQ7kNvwFAX1Jj&_nc_oc=AdlX_CfQfRP6fN8mM2y8_x-JIVz4P6E9JD5gJl7wPnwJRTL3g9jam-ApgRvhRYJaZaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3FINedGokrdDfOq2t8RxsDZP0t0OqOuIFEOXxjDBS2w&oe=69A2E288"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GIO TAGGERS REBORN", "keywords": [], "long_description": "GIO TAGGERS REBORN is a high-energy VR multiplayer game that redefines movement-based gameplay using Gorilla Tag-style locomotion. Step into a world where your arms are your only tools\u2014no sticks, no buttons\u2014just pure physical skill and agility. Run, leap, vault, and climb using real-life motions as you chase down opponents or make a daring escape in fast-paced tag battles.\n\nWhether you're swinging through urban rooftops, scaling massive jungle trees, or navigating futuristic arenas, every map is designed to push your movement and creativity to the limit. With fluid, physics-based locomotion, you\u2019ll need lightning reflexes, sharp instincts, and flawless timing to stay ahead of the tagger\u2014or become one.", "short_description": "GIO TAGGERS REBORN is a fast-paced VR multiplayer experience that uses Gorilla Tag-style locomotion. Swing, climb, and launch yourself through dynamic arenas as you outmaneuver rivals in intense tag battles. No buttons\u2014just pure movement, skill, and chaos.\n\n"}]}, "developer_name": "justiceformatin", "developer_privacy_policy_url": "https://sites.google.com/view/giotaggers/home", "developer_terms_of_service_url": null, "publisher_name": "BIGBOITHEBIGGEST", "support_website_url": null, "website_url": "https://sites.google.com/view/giotaggerwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
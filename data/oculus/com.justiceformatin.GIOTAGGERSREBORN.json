c_sid=6e7a0a&_nc_ohc=BUJblVLxVzkQ7kNvwF7Laat&_nc_oc=AdoatQPrLhJ87CjbjTRU7AICmZEfjoFD4_c8bWgE1X_97u1hDQdeCWbde031Du4j1qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgPtOs68Xipy29xknl9Knx8_fhbe1f4gPnl_PrCFnD0w&oe=6B05D8DD"}, {"file_name": "Screenshot_5.png", "id": "3979820818906030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618892_3979820838906028_4597339069073015183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1yObANWbwEQ7kNvwE7Stdr&_nc_oc=AdrdyC8dxq0_5FuYgg6cS0Mk5b07KNKNas_3xIVoLuyrGBOizuOKlTZO6mv6n4r6Rqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUh1ENhLVQQZHBWLFwx0CapEubuGtaKGMI_aEzVGAaXA&oe=6B05BE48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GIO TAGGERS REBORN", "keywords": [], "long_description": "GIO TAGGERS REBORN is a high-energy VR multiplayer game that redefines movement-based gameplay using Gorilla Tag-style locomotion. Step into a world where your arms are your only tools\u2014no sticks, no buttons\u2014just pure physical skill and agility. Run, leap, vault, and climb using real-life motions as you chase down opponents or make a daring escape in fast-paced tag battles.\n\nWhether you're swinging through urban rooftops, scaling massive jungle trees, or navigating futuristic arenas, every map is designed to push your movement and creativity to the limit. With fluid, physics-based locomotion, you\u2019ll need lightning reflexes, sharp instincts, and flawless timing to stay ahead of the tagger\u2014or become one.", "short_description": "GIO TAGGERS REBORN is a fast-paced VR multiplayer experience that uses Gorilla Tag-style locomotion. Swing, climb, and launch yourself through dynamic arenas as you outmaneuver rivals in intense tag battles. No buttons\u2014just pure movement, skill, and chaos.\n\n"}]}, "developer_name": "justiceformatin", "developer_privacy_policy_url": "https://sites.google.com/view/giotaggers/home", "develo
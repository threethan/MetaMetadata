_ohc=wcXHKtoh0q4Q7kNvwF8JfKR&_nc_oc=Adp1LDGy74ZlxC4vqWF_a1HgAzMQSdX4mfeJXBXGP7DYx-ghzA-VMoSxi2dn_GwvWvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LfVWxT-B8x0O12d7WDinX0PXx49doMWivHvXeO8iwig&oe=6A218107"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kp6hg5C-ToQ7kNvwFwr9P-&_nc_oc=AdpTE0L5hXLvtY6cwnJawAljfvAeuHk6QCWaUaOXO1rXPSUT1Er3odC1umuqpY9RGw4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LIvCUG-LBbPZtS6Q3jMAcbSo2JXIhrXEi1wpLXYRIHQ&oe=6A217318"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrTjTwwShZcQ7kNvwEFNzWu&_nc_oc=AdoiLdv8pfZb8sNCE0TIRgbv9ZZ3nAK0jkDY1301bntrkUY5oKKGUAHx2x5kWnmXyaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YeFGf_r2rER3Rmkru0zp84GinJQ1w-8dmBb-VCdhYSQ&oe=6A2184D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02QEIK1nLZ4Q7kNvwGi2xMK&_nc_oc=Adq5CAuoCEq70ZYNsMUmX5YHmu6tH47pUXA3WJEgJgJnS7qg_fw3tEYM4aSA1cAH36o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Cvn4lUw1ODr7O45uVoVTNOoxbr_YoZGyz1zYx7oZhw&oe=6A219867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRqkuqzeKQIQ7kNvwE6XNnB&_nc_oc=AdrxnpqOoqe1zkwBvpR58OMVuAEo0JP6CmdfRKeMu1a784Q7dxvfMJWovXI2cM8LmNM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9hJwTECe-4XYm1WjL_DR3P6XozV7Be9AgnEf7kjLy2g&oe=6A21A29E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
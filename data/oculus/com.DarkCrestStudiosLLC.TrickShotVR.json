_ohc=iXXEsWWEyxUQ7kNvwHFEUjE&_nc_oc=AdrocVdmBFgmLKC4isdyFwCAl-PUPo1ezWAYmJ99ZaGc_CssA37s--iWCd-1giWrYpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfBsB-eBOQrM-CZafCA8STpNuCW1_JhtdgfpTI_A97-Q&oe=6AC8EF87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cichhMBwxr0Q7kNvwFKTSwf&_nc_oc=AdpdjxQDlBt9KfK5IKREE2c7MK6NNqEgXCZvofd9hPTmouzvsHkLqFVuYHgOctlrD0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPohzdqpQ1C7lumNU4nnbYshGV5xw-i8Yt5Lr4ucNbIPw&oe=6AC919D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXkeqBusdoYQ7kNvwGd1Tk-&_nc_oc=Ado8aThLKPl54_kQuvB_eJtpcaF7YpFxuGqF6kjGMpgQnwfvzSjfJkefTU6jeoZscpg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtydUB07z_cpCLmE4KkOEbPcd0-9iiMbxWy1Mo49660w&oe=6AC8F353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBIpkEICcPkQ7kNvwEGPIYz&_nc_oc=AdoztmnyQT28ZhjZSnqecPep5ckBaOYI3TKvDPMTm2EJsm2mLqzVSuQ0726-1iCxFvI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Hi0ZRCtt__0NFxI6_h-4xYn6Hbz7fk646xRPSnoanw&oe=6AC906E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA1neZltpoQQ7kNvwEOEema&_nc_oc=AdoSznkb5DH7DjY-e6nasv0KS07s0ZupeSi_a2ArtF70d6hs2Y7SycRB-wlDFLBroVk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZxqI7Nbf8Cp2lw90bIijcmFfTkd-c0GDNE2hWKU-tJw&oe=6AC9111E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
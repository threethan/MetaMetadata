_ohc=Epw4s7dahXwQ7kNvwGbP3cX&_nc_oc=AdprhlHt-DdbEoIu2sJUqnmHaMEgr4IL84VLh6HfCCz_CnIjx8Ne9Wre52677iEKEe8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo-BUMf7MWvlYYptJzykMJbCPohlndvzUHkX-17lbEmA&oe=6A5F7787"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLP5-ygXun4Q7kNvwEaLR7v&_nc_oc=Adol53ubQqywUAsAdqG9vIW3Dm9cfjniY5lMZVdBl7DzazsjJi5bxbXpwtrwHUN9fQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7H01VaQE3GfLpyWHKoUEi38mxM_MKV878azOkgAOJVA&oe=6A5F6998"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q55LuVLuIuMQ7kNvwEz-l2Q&_nc_oc=AdqtRBeY3s8oGhS9ZpCW3HSq8A9mGi-pQfnOxzVYo3YPG2Pqtr9OPse9e0E6y7NUYDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA20GCG0z3kaBb89s_3Crfb7vZt-hskpCFcSPBvwPKk9Q&oe=6A5F7B53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXkl9IgL51IQ7kNvwHSOa14&_nc_oc=Adqx7npihfIw7Khvo8b9q4kwTQHQ2Zj8YSo-JJh0W6aOw9emPTGykiNpYeLDjJE056A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeW1E-IxK5BbkNnd0Fh0obMIPDxVXzVc7TiADevRz0sw&oe=6A5F56A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p5b_gOJMIgQ7kNvwE7H_a2&_nc_oc=AdoyCwCOAIWPYRmwzxqCzGiHo3WpVHdbA6GHoJgE3ZtlkAeTobWhC0dQdQtm3cymbxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcrSy2M7GbH5ddhdvuB_qBtJnXaX7D9za785aPb7dhAw&oe=6A5F60DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=TBHkGbXNG44Q7kNvwGUkzWG&_nc_oc=Adr3c371wtONgLTCzyhqoBfRxTlJOq6Tc-PWnsL9IWlUSShL6zyyg4xN8fJMkD9Xw4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGueSnAiGALaeXRkUx05uaQhJajJl2cBZR-_zbTbcWd9g&oe=6A903F07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t36QWg_gvM0Q7kNvwG8eKH5&_nc_oc=AdpHIYCCwC7nJqqaUbVvKQVgJrmLAtsZS-InynEWk9KHvYkLkLZZDmjpI8wbuGkne3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5rdT4B2UyG7vY8KHF4WnrLdeEou-2LpkWgNYikqlw7g&oe=6A903118"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owuUQaZLEjEQ7kNvwHE35kH&_nc_oc=Adrhs7OhqmfShLDJXCncG43flbKvOFBJbkA5a7ScLKhV6PZjn9-lRcwtd9tYHWUIIH8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQecG2goQoMeB7ojf4Zr_c_yubfsGgCJT6DUIqpgSgRg&oe=6A900A93"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIXzubgsEf4Q7kNvwG42ljV&_nc_oc=Adr9iBhNLRIQnaeXQZgg1XsXurEQaJPscTcCRtJRyhtxPbpaEzu_XG2ZF9kE3IZOqCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCQJZEfoY48-bdVkFigy_G9rHfLdCKYOw4gGo2o-CUug&oe=6A901E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TswOf9xG6TAQ7kNvwE2Opt3&_nc_oc=Adofh6WIIKxdF037dNU8eExdxjGPNR6zvT9Oxne-irO8s9wn0kI4XZz_c-aGvJUkMYI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHed_T3Hrv9JyigJYLTrvB36hH98jbIecWWO7H4v8-4LQ&oe=6A90285E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
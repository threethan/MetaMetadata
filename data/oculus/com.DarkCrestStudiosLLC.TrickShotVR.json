_oc=Adl-sIqlHg3NsLqKZL9rMfwD7uRnyFsEKZcmZP-66i6oMmSZCBsc73I31RprGOLH5RY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgjxh180OnOfpOAL0FUYrQ9WFEWQrxMy-L7Ssbq3wRZQ&oe=69B2C307"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRRYSut3NFUQ7kNvwFv7vue&_nc_oc=Adn7lBwcP8VJHGhLZuHWJNvuCVfR_h9Ck32UVWFCOd1K5Yf9XOomg3pCvyMKAqEPt6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzjhn7yvmLz3SCyERIW2TfBzL1PJbykrp8NRnhn-GjLmA&oe=69B2B518"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTAIU3L0SRUQ7kNvwH6CVDO&_nc_oc=AdlHWo1ofPsb8BxttCDQX9WkTFhzrGH6Qr3MHdnq7j2HKsC7WvyPw_I926sqf40oyVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiSwQZF8fv7DC1dOfvqa2_dp6azm1URfzT1O95kILx_A&oe=69B2C6D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAituW8Twa4Q7kNvwEJL-cx&_nc_oc=AdkSmoe2Uav-EoyHHPrzLfLsUHrft2mfO0f3lAUWcj4jZbF7Z4gA-ZVoqV7lZm0Womc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydzbH0xe_AoulO3rqngz-i1DQMN-2Cv11E3iCB2XPEBQ&oe=69B2A227"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHDkRsVF7-MQ7kNvwGqi7x3&_nc_oc=Adm67Pb0tihJTkn0enjh66UAo8KST57fwpFajp_E4Q_uIECAiKdJu4CbNk8lppn58Gw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyO8A2pLrpzM3IuWMLmYzqml7K8WurGJPE-lXREC9yw8Q&oe=69B2AC5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", 
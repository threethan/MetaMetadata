_ohc=cdAAkTH0poEQ7kNvwF1PFk5&_nc_oc=AdqX08xRY0d0pByg95kfrdtR18y_UmySlD0z9CgkRqLZLAXbLos3KZ6_5u-J_CLSXuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjYeUpvBZ8pLh6-sBZ9EcfQy5otSHBsGDZxMHnUpxm9Q&oe=6A621A87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r84z-pCecswQ7kNvwFigEJx&_nc_oc=Adr4916RAiMQEn0ebt9HcX4ecypzO-i1CxO06xsgWUSvHt1KWlu8pipjTdGBF9fm3EI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC40vcUXCtP_-550EBtCgVFYRoXAlzAETwZWKWoilSqkg&oe=6A620C98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L23H49DnwH8Q7kNvwFRKcA8&_nc_oc=Adr1FtNIV7Nmnnm8vs8Umrz3XSy3I4ktFBLMw_GiAPZQx52u-ZCZIQB7BvcrAQOF5Io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsum0Jok8BvPil39M7LNWHQg9MW2KquLAr6JK4nKj-pQ&oe=6A621E53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXkl9IgL51IQ7kNvwFDxG-3&_nc_oc=AdoKbauxN4UsECsTzs8Q_hTKoRu75mP6G3FxV00xfJLBBZyYo_Jhdn3S2QV0iMcrDZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ7ki241jr20ULB98o39KOSn7dWMI855lsVkBLYbKAjQ&oe=6A6231E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYAQyTsvlSgQ7kNvwHCgUfX&_nc_oc=Adqp0kg6mvqaP_CCId_rryGfJ8_gDaCKUx0pVJo-5oJPWum-277RAa6RxhmvBqKJAGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdQx70zdyZfF_kICYvrVD71VY9kvuo9UF36Gp4n9LO_w&oe=6A6203DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
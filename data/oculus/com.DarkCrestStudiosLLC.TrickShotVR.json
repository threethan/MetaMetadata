_oc=AdnI5APyHuhqv35BUFHMhZ2IeyiUsjD0RsFfmNSSd1uWNeMbKe0KHOei-7k4TGKv3Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS35tEfzc80OnPtnnGUkGRredT5GSJbInYjvkWjJI3Ug&oe=69B56607"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp4IA-flSXIQ7kNvwG-xVeM&_nc_oc=Adn7QlkHYB_DrG5zLh6UgNNJWqazpJL9Ir8I8dBrkQHhZjpqxzv4Nz1ONWWHBp1mgB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7G4kFecefWgLHABJ4n8Wc7J4nIpBwS2PduIpcVC6-2A&oe=69B55818"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoItTS9Njs0Q7kNvwHtZvbR&_nc_oc=AdmYXECtBHlGhaKq68wwnHevBlWEIVmmzDFeDiPk95Do-34XT8iY6Tq6oBustKHieKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfziR3mHfr664wv6e6SXy6KNo2wQr6EixPw1T4scuGyfeA&oe=69B569D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHLAY7iq0_cQ7kNvwH6_dl4&_nc_oc=AdmPeu1UBwP8Hvrl3G22SdGFGeaxjQdGpm8dNtA9x4DqxJSFImeaBjoQnMBSfFXlkic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz39ohtr3E4pXLp2tJLplAneQcjlc7d2KU8-yI9Bwf4Qg&oe=69B54527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHDkRsVF7-MQ7kNvwGTWXJX&_nc_oc=AdkK3_8_xLcOWrgRPaGYx2rI1-g2aviECrJVCbVacFgqjfm_VOAmrbLnHxsW0H5FKyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9n74tfjCEAfIsw1m1VHBmnL75i7Q-V3fIKpaDroZJtg&oe=69B54F5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", 
_ohc=gCJDsk66yyYQ7kNvwF8hXnj&_nc_oc=AdpXN1CRYGNE73SDnFwoKQOgSIJIVGUxk_6nKCevfEl9nqjh0P8hLVh-hcfYRVrg1cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiWv1CwHucIsqI3YuLBd3LmwJPF6N6DIifMJoo5GVDQg&oe=6AB3D787"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmADvYYL85EQ7kNvwE-puCO&_nc_oc=AdpQnxK7l2S-Jz_dLmI8h1DDRFwjRbGVGEB1Dn-spQt-iPFq43ZeO5fjNCNFb1e3pOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp--hviNbAUYSPLnVfOVyFFcbwMJDfKxgvtk1WY4DFcw&oe=6AB3C998"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR0ti1yYdJAQ7kNvwFu6Um5&_nc_oc=AdpqeoOiOTntUqBZs6X7UtQUbtsqFCxKBwDYqpm8-znhoLXV5_mMuJeVDzks25zaDtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyZEyoSUAWv8bhL_EzPWe7FW6LpJpM-leS2HMUYpYDIw&oe=6AB3DB53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdjDMLduffEQ7kNvwFuPCyM&_nc_oc=AdrJLDFBsalEWWAz3kkwNPpyeJWPioG_G3S4mhjKGXCT0YcZFzropWPS5ZCJq3eYYoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLgqxMJKMgNzuOlMbaS1jVBRmjLAqnYAQ1z1MOzlO8YQ&oe=6AB3EEE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVw0Qtj_5-oQ7kNvwHLRXnq&_nc_oc=Adp1qKNLq-MOdYbzWXiBqIIGqF2-fP5QODtWvlv3BO9XFIhY7cw3Gaql_afznnzxczI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1R4cWEVm4KJg15y7TWwX0Ztx1Tq74SfL-fyItl7pB4Q&oe=6AB3C0DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
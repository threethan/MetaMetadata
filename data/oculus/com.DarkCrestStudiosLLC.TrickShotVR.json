_ohc=74zSauUqPY0Q7kNvwHNuA4_&_nc_oc=Ado19FBAzLG2FR5VH2MLT38bgHfMCulc33P0sX64FGEvabzq3KNFScFX59_bo6bii3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mrLbeSADa3uun4Sg6n5V1VFM6gQrJgfNmntH0FAvTyA&oe=69E38A87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYADONpF208Q7kNvwGMWTGA&_nc_oc=AdogiBHAz5RNgYMGtpbM1CGlpeP3SeWeH6qy2MGsRYWEdWJDkHEV0R4XWSx2nl_445c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1phLdGxp_rL5Fb6oaZRQvfcUmAqcHC-60he0Q6HFYCBg&oe=69E37C98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhm3h7c4440Q7kNvwGhEWjM&_nc_oc=AdrgSmkQcAmPEsNha1BYFrP5gZEk1vUVJtLi9I24m7BwdRCOArpwJOdDp9_nINptX8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05Rfq9A6u0t2_p7D-pi2bQPIryK7Dc6jWTWcE08sHnKw&oe=69E38E53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnWptyrR9wMQ7kNvwEhdNzB&_nc_oc=AdpUUsH29RUjfIeADZeK0wL4xHpW6XYnpwpBqhEyNOtSHYmfZFVW_o0GX_WNpmXnV90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NIfhUf2tcFKLq-0BIKLVLIsWnY-AewEsXrliCki9bsg&oe=69E369A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHZ5WW3Ov9EQ7kNvwEatZnA&_nc_oc=AdpS2C1qOtASYX3LtPrLwZjB-xa5RbdF995x9zCKzSQ7yEZvh6ysElH_pub5ORlHsHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Zn-BbfPccWy8ApBwWQHD8108hp3KvzPwE6xwHRt7aEA&oe=69E373DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=VBSAjqBtU_wQ7kNvwG8_2eJ&_nc_oc=Adovohov1QckBObOeyuu75rIM0Hs733rl3kKT3xbdjOs3rfOBTZrDHrj4Y1s9J4rsMY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dsleCrHVuDHVrZ0juApUH3hBNrSYpc3UuS0Wad3uwIg&oe=6A2C0D07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT_0Zt8z8hUQ7kNvwH30tCh&_nc_oc=AdrROm3eDT9KDiI6zR62zAOoL-t-Xa2DC-AlvAOg7z5sllKg5odFXN6ri6U3jicA5x8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_63_nCq4gDFq5wYidJcFzs9RkMMArz2pXUpGmOc36-_Q&oe=6A2BFF18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rPq57f1wYoQ7kNvwEC6ccb&_nc_oc=AdqZoFex2gY_dS5agMto2tmUeBVzMexKyZiHVm3X3U3FBBNN3-oVijtn8JnutNHJfU8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KXkWt9O2ze6wd8YWT9NknazdeFzIyL60ILDKDiKN2oQ&oe=6A2C10D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISbc93GWHlUQ7kNvwH4GK61&_nc_oc=AdoDSmBD9UUnz6PS5UEEkcmZm9RakfAD96YWKiSBJy69WR_do97-_IadyILclYwL6Fo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4JSGsaQtn0Q1jHOhAhx8h0kQ81u_H5uwX8-s-nIijyA&oe=6A2C2467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKyxWFexVrwQ7kNvwFfpule&_nc_oc=AdrjJdUYr9nRnW6iiF7CXZhoqUepPARsCNBAdS2TvFUcxBwU6b71rHKhF9QcEGIVwog&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6ECBUwOwCduRJGEqmalA-qfCGIzkix6pF7qCOTr-o6w&oe=6A2C2E9E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
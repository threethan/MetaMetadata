, {"file_name": "Screenshot4.png", "id": "861602418899862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031627_861602422233195_500317605450579596_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXhxspsWoRMQ7kNvwFNcZXK&_nc_oc=Adq-yVVLFunOuw2_XfcnEvPqFzUC5THtUkzpcaR4Bx3BfDhFyI7j-ABFQsROeOYf0yM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsGd42kTokflqYpjCW4W6GZgVTUhJYOY8-SOwj-Rw8sA&oe=6B0DB5C7"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQdVIKY2i9AQ7kNvwFK__K6&_nc_oc=AdplSEvzjgpKrDyTSJM8QGr95qCaVP96j--xHq2diJmP7jeSKxT3mlP1kSIAIrxeDQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9j6Y-K46xAYj2ihmF1IOGxfQTrHMrT529TjiLV1mzwg&oe=6B0DA7D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe0Qf_N8_6AQ7kNvwElvx7S&_nc_oc=AdrhjEWNB0tFJor6q_ZcnVxWaXAJSE4vUH0CfypzmjnAaT95un2Dx5Z4RZldNB2ioP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8DLll3F49dNZqFXlwRWgYK7pHSK2aI5r0Htnbtq6MLQ&oe=6B0DB993"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5B_FAAQ1xoQ7kNvwGeHQfM&_nc_oc=Adqj7Zih0Ngnu_EHn_8sn3tI8tWXmb6NwwJKkb55TkTlAdnCiglS_JJGtcXqEVcm9es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3gJkRbZygX6sv8DxYmweAKHuOWFagozVEb0maDP-zxg&oe=6B0DCD27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwiio01o1YYQ7kNvwHI1tQ7&_nc_oc=Adr_P-ALxQR3uNwMpOaawUtMGWX3MTbh6jEgX_mZT602r1RSlRxF2oMlqJFfnRkmV4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTX4sPgxRIgfwOQhaeKlyDQaN3SZmFjX4AO68rap-xUpw&oe=6B0D9F1E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.dar
_ohc=hIXD5-xKiZMQ7kNvwFaH-rl&_nc_oc=AdoP3BzQZ_lQjFte25r-IHxHzm__tS_ynyjI25rs4RWvmC3CLG0j3a1aX46XEI5KJUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2_bpqK888sgNtgttnfIkVbQLTDrhREsXMdvpJpNYoRA&oe=6A54EB87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca7NIE8twd0Q7kNvwHAcaib&_nc_oc=Adp6IYVz-h99CRJVwJj5s5BDjyJ8zmeW8M7VLuybjRKVwBWxf2l-VZSXq_iVOKgasb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5l7Edk5MGs_ontAkskSC6K8pOyLOfc0EB2IOVA9l_4A&oe=6A54DD98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVpl8CFPB_AQ7kNvwE2sc_s&_nc_oc=AdriP5xyiM4vEB-bbmzEkZUNz_UgS49qlWNIVwxQUGgw7J1xEi5e1wrU_npH0lYX2mU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-VooVpoTNDEjglfgAd71TopLLiuiNCbvO1ZuPLDSeSg&oe=6A54EF53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgZIUP4cl4cQ7kNvwHP5fT1&_nc_oc=Adpkm8eTCdsO6oSihqU_G_bCzLqG6QuM0XvDi1PbuIkuMHlrsVdlgZgItovdDNQCYQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWyFegBb7HvJuwehgiVitSqEcV5nOjd8cD3yH-fI_-A&oe=6A5502E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuE9w_HWTKEQ7kNvwGlcEWu&_nc_oc=AdrjbE0Hf88dn90_oMqZW9Sf0xb3JORSXXxkMhyMmed6Im_f0gaMV7LydqrlWwVMyhM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5h1ArelG0axhzWI_9yEYgESiUniWL2Dwf6jhgVikopQ&oe=6A54D4DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
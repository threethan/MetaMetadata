_ohc=_2sKWPeS6J4Q7kNvwHRWBpi&_nc_oc=Adqew1ySB1d4wXGWKt0ilfl4oiFlWqDUrbzy461ntLlKvDGB2a6kt4vmD4teODWmvMg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y0xCpV_w-U6mutfWhdsXQvq5WKjtDI0_EOsFGqWEC4A&oe=69FDE887"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xSc6gvKG-QQ7kNvwEFfw6j&_nc_oc=AdrG1BN1HunaJFq3dOCuNkz4txlI166KQrs971bCJGss7Fzj4grFQMr-Kg9bPgp-134&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tC1961hxIIMoT2utOJNi8jwzXvb8RGu0SLRqvHvAhZA&oe=69FDDA98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox6OWZY3QbAQ7kNvwGt7os3&_nc_oc=AdrkUB0P33hxtyCWsuZZ7IBGT5E70Y7wJ-Yk4vMDeZgpqx-Ihzk-5DE288ggDnbtzkg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j4TxD5ptXoCdJSq_jDuzgXeGoy8WgMpfUF51J7FzwmQ&oe=69FDEC53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nxAK2CjlJEQ7kNvwHOkJ4k&_nc_oc=AdoDeZOda3RWCMzes8TChcpXm1ibHkozfFB_N4mkXNLeV0KPDWotayyTGTAemZi_gM4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YUIkuKmOJqjf-cTBZA_KUMcp3uPnEs2oQffJC5lPu4g&oe=69FDFFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aH52ViB7JwQ7kNvwH2al20&_nc_oc=Ado7OG_GWMjpWbOVZvSiO2Niv_IDEzIi1O602tjevAkqqvJWWAmQtgriK7vw7oJKlvc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XxkgHPKBzsq46_qCrxxy9r3JjxjFqSi_4sLZxYVmDhA&oe=69FDD1DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
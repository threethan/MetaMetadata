_ohc=ODDO7lzkR88Q7kNvwHLwYc9&_nc_oc=Ado1YTY8FfamGTZodh0nfGdUB7ssiwYQrtVvSrnbMf0t4admEysXhbyFPPZhWK5yn1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKUAmU_s8nNpUuUxtvajzdyeWwqENQMgGywlJqyY-TTw&oe=6AC10687"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1lEzQXJfRIQ7kNvwH6gfzw&_nc_oc=AdrA7JE8h4QR_8HDiiqJ5i72U0hzgPboBWzH1ftuIX0U1OptsWr_9kjxkYm9JOxaEew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0H3L2c7sdkMzi9S4kOXYsNuEdvt9iH1M76RwPnn8_aQ&oe=6AC130D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJqlDt9mTTAQ7kNvwFpfoTW&_nc_oc=Ado-oxPrx10i8HRRZKd6KV3fSDOmDg73lNHrFuZvKvVwWb1WDZif4XISqNKNL8_PmVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP__Yc1AUMmmJTYidT0wPbZg_1YRImU-a4J5rh2f6UJyQ&oe=6AC10A53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEEhlxsa5u0Q7kNvwHFTfw5&_nc_oc=AdpUwP2WQ09lL3_pXXsUiUdnbkhoOOnkebF9sw7Xlyr3TSshhLty6G_Ekpayb4yTswE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwfO7WWTH-flm3fKvDMhhbeilTPR1ZEiB5XKW_QyiF_Q&oe=6AC11DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueRlH1ndMJUQ7kNvwHDRGug&_nc_oc=AdoOW8tUV_gWTwW1sav5zUa1NcOu7YT6Txbwx6bwmn1D5FEgHqqM0DSD4CfiHk7xRgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP48cy-UZYxrd3iH1bEIOrogsE-bq0kU3D4zIEwC420Q&oe=6AC1281E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
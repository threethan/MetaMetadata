_ohc=ox8L4-roxGMQ7kNvwGOfJlj&_nc_oc=AdqxN6dEmv0yJDgq6RchJy0UQDJHtozD8HTr-EhleCvp_V09aVIZG6F1zffJlb8LYBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_JalbeAwMbOZx00X4_zTP5pEKYdmoeGyfgrhlpnTgtw&oe=6A9EBF87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LiLRT53GSIQ7kNvwG97IQh&_nc_oc=AdpVPIxnyGV4H9H4eePhUrWaY3CRUMv4ZJXgfxD2NjU2m28jnlAjtNoSmpSPt2tNH_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvw0ZanBwslJEsWzMMknn63i0dO7MxpkwSDoNEHxYflg&oe=6A9EB198"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laeKlzDDw18Q7kNvwHscNw5&_nc_oc=Adqs6_35IQ-_HKlcHkcN0UxdzKza58VPmJlJ4ypmF9cwDAxYkN2XGJditzxKRrpCnWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6yYGlrsyeMuLGiYwmqjhB5INv_7BmXsHa5bOFIZUlJA&oe=6A9EC353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1XvVLG6p-4Q7kNvwEgftBV&_nc_oc=Adqymv7qJa-5q12fD-j3g5wYVgKhj-n9Pg9FlUpseOJWV61WuD5r4hgW015vvyZANY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWqoK9iX7qgxbgkr1gMlBzyCdDhcJmaXQ0abnZ45J7YA&oe=6A9ED6E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEneXIRxwrwQ7kNvwF8GMmK&_nc_oc=AdrfJlgElx_Tabbl1o09kSl-i4jU31GrHgJtm30Og74E_qPEP0RdASxBmUkdZxlmuYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEXvk9XdHA2mBG6MymdaoM7u2RIYCR5n0m3AO4PW2OVA&oe=6A9EA8DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=ba1gfGBjaroQ7kNvwGO-Znc&_nc_oc=AdrZ32VONZDSK6lUl0QpKx9DY9tQbjLUun2QTT1v_WMvLPFlI3ZkumS7GXiE8QuuT0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwDkVGU9PCt-jMR2hN3my2H7QMxSXoyG6kyBV_cNNWpg&oe=6A7C7887"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0eng4KxLPEQ7kNvwGhXcxR&_nc_oc=AdoLdnnK3ucafLBOdZZKWx0m3eklbh6XxnP1nFjkR6yc-QD9xR7cUBj0Gi28wRJCKGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXx4CZz4qSB2t_lsoYOrR4vBGh01VDEK-zYuA2e8M6GQ&oe=6A7C6A98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjmiuJT1ZTAQ7kNvwGT1QIH&_nc_oc=AdoHEfR-jTkt453RjKkhx3MlqitBL91f-0g52qVFK69SpgaCSHOUy-4Y9v1fzefeE6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdPT_r8FEcWAZGGaE1RKnN4viJcTY6bTwNt9R4SS8zdw&oe=6A7C4413"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToD5VT6SA74Q7kNvwFuBtaS&_nc_oc=AdqiZ3l11Uc1czPJc8Hp6vchQ9caGOib_4xYeoWNDSod1zEAjQHKbTU5sGoVoAZ6CLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4CNBldhmvd2CCg1OWSpw5-_JDoWVzZlFQJAGtn0z5bQ&oe=6A7C57A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmHce_Kn0eUQ7kNvwEOva2v&_nc_oc=AdqlCNKLzIppGCavgXxxn-UBr5XeuoweH8h6E62HGAD2XHpb63FzrAlNxqJZHlWcsEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFndWz9C6iuaPVhrDdT7DmEfh09cgJA6Tht-ldLhVdYew&oe=6A7C61DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
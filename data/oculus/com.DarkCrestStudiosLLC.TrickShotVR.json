, {"file_name": "Screenshot4.png", "id": "861602418899862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031627_861602422233195_500317605450579596_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7QaqCWlQ4wQ7kNvwHJZirV&_nc_oc=Adoxh0pcPM5c-S-TmFIy631fMgi2QLfbUzYpWdwB6qfA9bVUVkLBsULIzm_O5cCNZMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV3ZZKeQoxVerZyno4ilEaF3C6JSEDQfPi4OEykdB98w&oe=6B01D847"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cn155XQTBwQ7kNvwFV2hIg&_nc_oc=Ado1sGtjcs7vHGwCSHj6iPFcODU0DKSjH9isgm8OO8r2o_nMn21MWi5Ot3GpHYWx3ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs4ReDow0jduuUXKZJOZZ4JcxKU-NS8udWDdgBZbUWjw&oe=6B01CA58"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNyL_rkh21EQ7kNvwHufEm8&_nc_oc=Adq7y1XVyj8Cxybe6CXkfpVZHUgdyly3kFzvLpcuWam8JGnTCqOmVRs1o-zSv0CKbqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgAcpc_TfQkKt_tl_ggBWG8phb1gJmQKEW86poq5yR2A&oe=6B01DC13"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHlkmWd5kXwQ7kNvwFOeloX&_nc_oc=AdrhzGKIW5J3G9iikE8h1c671aHpJolq1AFwb3JBKZYcao7p4e1SRete4gNPRnBZ0X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtiRWiRK2VUPcyE-EzARZeawLHloWj1gebVb6ypBDL1g&oe=6B01B767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_dp_aXL22IQ7kNvwGFx7m8&_nc_oc=AdqWdbkgYeKLOwEJ0AQ9z5qbqkrCG2O8TLo0wUzG7vGCi0-aKeV9CYtopiLnLMc1ORw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYiQ2sTUJz0Zzy79BxGyh-cn8YZEIdu0Wl9p_T3n-XFA&oe=6B01C19E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.dar
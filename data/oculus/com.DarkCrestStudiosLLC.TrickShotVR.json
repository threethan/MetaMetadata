_ohc=c1HGGdjEzPcQ7kNvwHlfGbi&_nc_oc=AdrQkmZHUE1BS1OP-AQKSZcM_nTnYePaHJd_EH5XKlAXdqNNhJHDwWpq31r1rrLSsZg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDn6dRmuA47MhIG9YqJjH_qmQ2wkctmjR2yoFDVz78Q&oe=6AEC8807"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tiiAv9J80gQ7kNvwF58AJj&_nc_oc=AdpF41dAd68sig3MiDOqjti6PLufJEtyjf1F4MwM1ohUhklPJT6re6TZ5pHFDiRduJA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJDLIf9PXgTGbFNX-j1VwvDJYN3ENtU3JpluUgD1btmA&oe=6AECB258"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2_AH5vPaqEQ7kNvwFNfF9C&_nc_oc=AdrLSNZsZPfIPqkhSYl07Kty8DjaGV5iPZD_RmbCL587rz4MldqHVnI-GgBfT_EwO-Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtBTZv5RostkFBOmc4eURcRi56dtDm2oGDjpYfgqcuWQ&oe=6AEC8BD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5Xi7FwNLyAQ7kNvwFX3S8f&_nc_oc=AdpGxNiwrVfBcSIxQrBAjIPP1CugHxd0gaEa8CJD7muk3YbOEj1IkOVJftn52MdoQIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmfo1ZV3KRuRE2rgPGkqa4GVcUBwh7cD_zmlqPajly0Q&oe=6AEC9F67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RiUv9Rw8vAQ7kNvwHCHwiJ&_nc_oc=AdreidWXQWjwIpDt_IEwlD9IHvP27lHfy0_iZiP6q4RWi9DHzsVHxR64jD-M2nfGkrI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThk8TENmwCbAepKTEY0hiJBxEn6kL5vbDmDGoZH66IWQ&oe=6AECA99E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
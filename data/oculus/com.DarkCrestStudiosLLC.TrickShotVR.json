_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afty7sbo7btWw2ObOxfP56sLXgRcJ5SjEG9mRo092cfMVQ&oe=699DAB07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tstbMYb3q_8Q7kNvwG2GZZ-&_nc_oc=Adk7q6xTzL_6TslZP8-67JAqJHwk7ZaGGlUsQCwicTHcRKL7Eic5S_mL2rI5UUfHQNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs03e7sgoIp7jcWkYR0_WVhkyKDGh5q797coSqXS6U2Tg&oe=699D9D18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xpAX5oGe98Q7kNvwHZ8uch&_nc_oc=AdlEiiUGcalZSPeo_ZLCLxceGj4QaZvUPYNJcxGmOLG5G9QM8Kvd2LJEbbCcnUNI2nY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjVYIwnYX-lqZioF6P4U7pBMNKUolHUFr3zAlyXWqg2Q&oe=699DAED3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHV--kieMXkQ7kNvwEUZ7yr&_nc_oc=Adm5w-6iT2sHa2I4kB1J4LM91NDxd9bSZ_G-J7RHLf3IIQRjpcP5bx1H2OuzJbTwMeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUuQNJuj9_yDLnCC5rDuhY0uFqa2VMWNYfnt8aeDbStA&oe=699D8A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YBUzEYSQ54Q7kNvwHd1yZc&_nc_oc=Admr-mYtohAxOixXORpACxdWZEaYqYHHdJZ7Z_FaShodi8j4dOwxzO2yaSxSrZwuiJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftO7iAwmYQZ-3R3Cai3ZjyAB6gHb4aVZo--CM9Ceaum7A&oe=699D945E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
_ohc=Yz_q2EKQKZYQ7kNvwEOJQwc&_nc_oc=Adq7PBLGslD2NUksBIEQn2F8VBjMtcz7RizHCeEi8TIMMsl3PFuAlwFTWr8uffwIdDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtHcxzzLFqBis1GucRHwaQEJQfbu1nF_sKf9Hk_fcKPQ&oe=6AE74207"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldZGEbNR0toQ7kNvwGxmMMm&_nc_oc=AdoVt_HYvTY9_8U0hc_OBbG-un3DewcRiMePo_KkQyUA8WvB5Wzgkpp_UnttKkl2qKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMLFWs3y-5CnYoJJ6aR1K681m0n4WpkaCFSwlpFGbHAA&oe=6AE76C58"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16GVPjn6XpYQ7kNvwGbum2R&_nc_oc=AdoYdpnLH1p-9v8L8zLCivMydV8R6Dcu5F6EwQDuZ5Hvj67Jc_ZDXcgCaawwqjeLnB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtwjC2Bb6XmubBfED_tht65fIPniFEs4pViWs54ev1vg&oe=6AE745D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se6afvQVVvAQ7kNvwGRZwnZ&_nc_oc=AdoMILkMa6RQlDfz-wcS2UEJ-qTVveNO1k4z2Eo3WF3cbQMpuT1o-HvyEkh3EyqIjaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXXMLEAHTKgyM6wWk-821Kwsavlr_iX9E1PrPqq-X-PA&oe=6AE75967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpDPvCh8YoAQ7kNvwFzvBtC&_nc_oc=AdofCXp5Bo9jsdiNht7NPGOzryNRb0_jAH-KdF7Z_b1dvAKNEh053wriSZYQoMLiSto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR-wg5I4eU7pWcNs70A_TdGtX79cNaFO9Dd1fmtgVDUQ&oe=6AE7639E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
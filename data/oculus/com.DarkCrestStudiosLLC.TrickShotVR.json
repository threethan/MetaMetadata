_oc=Adn-mVNg8epEqyBbMzYsTQ5p4cKVLdCvCHsjlOd0xPX-KTQQADXz5U3_u_RkWmc60to&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYLwzxvZlOqM-yZh3S2zr1rQYUC4NAVxwYwLLpevMZEg&oe=69AD7D07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wR5NY1MFkQ7kNvwH9g17P&_nc_oc=AdkT88gbXnrfBOlhoVyVb5ju8O0JSewtgftVdnPobt34qy-c46U_zLspb3psFBsS_n4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjmztpPKxWMPAqnzFpODwccBJeY7Lrmmj83b3_TA86CQ&oe=69AD6F18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUNcreL93l4Q7kNvwFJmv_R&_nc_oc=Adn9AhXdOr1QkJvjYMSsaVzfkWw_-Xxdms9YPo9wln7sty1XwDgWevifL3IazMOUdEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqhsHjtFZAYqbR2oh_Z5ICwWaCARfDyw0l_rZBSzNJIQ&oe=69AD80D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUgt2GiYCR8Q7kNvwElo-Rr&_nc_oc=AdlYcxDU-2mIBlzBayvJFM_jRaoea8fMX3CizRS8-_-vjashWHvEDdC-iRcngRtA1Go&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzrx7oQHw291fhdqCVVDqG-Wy5gtfQWJ10B0OXRWRm1nw&oe=69AD5C27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb6I4L7crYQQ7kNvwGx363t&_nc_oc=Adk5j4TTsHc4rID7QmC4ah4fa3Znnq2uLvvQ5z9tD4hKZw9D56AfPf40G5eOqU7IEzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIJj-tkfNY4nQiy1XKhnoKqjO5hy-ZhtpKgtfTpR5Kvg&oe=69AD665E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", 
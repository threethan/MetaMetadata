_ohc=joriHEyNGzoQ7kNvwHVWlN7&_nc_oc=Adrm70j9u5rCfIk3nd1hsgKL4Iu4vIELdeu2XrPppz9ZckxYxsJljgxkEdAUwXjpB4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6XrxSMYYNvpM07wI4d-Lbfmw0mChXvfEGStAXcYlu4g&oe=6A427687"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZYZTil3y7YQ7kNvwGs8uKe&_nc_oc=Adqj_ZT-wuH1VnCyBMeNfHL8l5dtuDCTh_oAFEOCoaRJrojRbCXnuqe93FZzttzKMqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O8f3vg6bKFw_aHWsvYvRASepB8AwQ0Itm4EDzBGljwQ&oe=6A426898"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYik0SSW4gkQ7kNvwE_2buy&_nc_oc=AdqHTyxOUu3rLa0eJy4DjFsyXA6RNlbdVJT4mtUKhijrntsZ7wiql1WC1-iPYLT2xTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bKfGKCQaEd3WTzLwqzEhzLnnI485vmJmo5owx8dioxA&oe=6A427A53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPHZ9HeCg04Q7kNvwFGaTG0&_nc_oc=AdrJmOQYLT3i8vpnRY4sHr9GZr7YNU2S7_p7P637aQs49648VZL1PgIel9u6CTEDM7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cagd-qXsjO-WC8ylwOO9EI8UcIv5dU9rmCffpY26zvA&oe=6A428DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx78g5WRdhQQ7kNvwEL5oJn&_nc_oc=AdpMJ1hy8Q8sZhnavNu0kYomMNOofRPstUyWwAaZNpDM_DOQp4ZsvpMvn44v1wzdr00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WjyYLWkhO3Z-FG9nEoTBPUkALRUoU5pjZwuILqd9l0w&oe=6A42981E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
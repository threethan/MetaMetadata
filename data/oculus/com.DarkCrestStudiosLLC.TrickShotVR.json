, {"file_name": "Screenshot4.png", "id": "861602418899862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031627_861602422233195_500317605450579596_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXhxspsWoRMQ7kNvwHA_vJS&_nc_oc=AdrCPGgYLhtdxAYMBjg8qpnw4JYSLKoEVugO7ovmvQzYK5qibxlhnu0DUwrbGcnwl4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQanaG9oF7k9--xjpwQW9ZuKsuZTJt1Jlb9q08lbrlE8g&oe=6B0C6447"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQdVIKY2i9AQ7kNvwHj6Blg&_nc_oc=Adqxbtf4O-vMerx9PlBGs68PbkzJlm7cvYzPA0kcck_CnwjOABq998KravLmbvIDc9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQO9zbUu2Lt-NGH0SZ7vkwh_sSwdD9p0FnOjUF8fBqNOA&oe=6B0C5658"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe0Qf_N8_6AQ7kNvwG2Eykx&_nc_oc=AdqBAQypkSbw6J9BplT-Uqv5crnVq1l4ibZusR7yejyNamjlYOGG_dxHiUH4e4D3DNI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHTNKtThD4lXYdwiUyGVQuB4oX17Bxzqm5f-ce1ISzAA&oe=6B0C6813"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7zNFl90lbAQ7kNvwFNXiIe&_nc_oc=Adodnjz2KsE87sN8In2-tZqqroG3YHm6ox2Ptcue7k6LBdzrM05PxRwvF1bkWlmXLFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLNsT2pC460lHese7CcyekT_zFrffISwysRKH-fgdqfw&oe=6B0C7BA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwiio01o1YYQ7kNvwHBKyEt&_nc_oc=Adp_eHEwfM2NSOcDOoqKMP8Sx7IBYA57WTpunzby1HQ1-Zi5NQFnHb348_bZrPwK-_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAm2aoW0786ghbigMyu-Nr8DeCdVEbdThVKwRPjwbSsw&oe=6B0C4D9E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.dar
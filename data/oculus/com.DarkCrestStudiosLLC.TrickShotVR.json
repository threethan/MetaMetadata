_ohc=il6Y4VhYcTwQ7kNvwEQxw5x&_nc_oc=AdqPSctacf-duoS--p5Xi89ZksnRUDzhFx-wRsksV3cbl_IqDcPlFiaFimpKO28Fyzk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_ZwzuOf_ie2hRr7G-c0zVv9fyDs7xxbFE95XaioF1Dg&oe=69CBCF87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9Ifyha4blMQ7kNvwFYvWTz&_nc_oc=AdqiXy582gUqeLk1-bQSNXEaouFuTbUEOoDlYOJtCQ2s_WWSA7_eIMJ10DaNy3mctUQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxb9a_ET5YcEp5cQ0pz1-ASbo2U5RcaJ66QJ-f0tYXTLw&oe=69CBC198"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBc2338_708Q7kNvwFFHRIm&_nc_oc=AdokDQfmwiT3kCB49XCxSU9jDxA2Dte7XpZN-FjkE4whFBtyuwVfcbjg3CrCyvPg0ew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaKdIVhQP9W_ZBUbiFBgE3sAxfrpGdDIm_lpikVqtWgA&oe=69CBD353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QREcKE9U0eUQ7kNvwEaGxTR&_nc_oc=Adq4ZkOqKCarpQWTQCkbcReG5egxWAnZMX96XX42mbJXKjbNMyj58tkqWRGktvyN7q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykJr3lt20Nc6TEgs5M25m0zm_H7v4pZU8bWlelhLuAgg&oe=69CBAEA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc_JMhHH7ZoQ7kNvwFHQBsK&_nc_oc=AdqPfZtwlAzVlEKeufFNe6mXgXqWKFY50qc4C1JpdTlTF8jx9ZRnH_MYp3WPa3Y2-Wg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpNKb4FO-NnHlFCtjoi61x8D1Vnz4s_027OVjkGGv5Gg&oe=69CBB8DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
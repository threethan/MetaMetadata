_ohc=7Phg1tfae6EQ7kNvwHnF709&_nc_oc=AdqTAXJ8IwPGVqptogA5ZjdSgE2EjMpBGcU-kDHrTJmhXRVe5cZ4QQniR8dJZpspB5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1zi35YJciOCjSrsm071apj-PsF1DY09Kt8JKf9AKi4w&oe=69C92C87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WShIQVBoeCwQ7kNvwEnpsz3&_nc_oc=AdoJawX3cK8ZIxlBzlkJB6RyV2VeyegEK7_RBh0-NCE6lJ5NA4mRxpeU_18Ok7LJ2F4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnWbzn6VzNwsAxWklWCYMyWW43ff2PO_Lutw5QIkEvtA&oe=69C91E98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skN02evszFsQ7kNvwFVwSjr&_nc_oc=AdrZ-2Wky3sGncqXCTVEKM2A2xDRalHp8-Amh7ekSEK-c3AbwmUEkEKrFWgYXLs6Bv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMEvCKzxAFuhnEBHWwaP5MPnS8-qRbsgAoEnOnUbqmRg&oe=69C93053"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QREcKE9U0eUQ7kNvwH2n_UW&_nc_oc=AdqD5rLr9Gj8NrjEzlmzEeIDcWGKfeNlTOXJevTmcQ6jVdkBh1EuWc8tiJo6DA0Oofs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTr_9BUOSwFmxomtMEwgPMNd9dWra8hEk89V4y3Le3uw&oe=69C90BA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ7sz_hgwkcQ7kNvwEJoalq&_nc_oc=AdqlZJfycIMpk--5kZ2J3uLi0Q2u8eNrSh-ipO90kOgPOMRdYtGf-VQDKbeDgcdgdow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0ZFvtXiwEY8p1Ly1GmC7W_VWDcAuedtr-24qJMObnRg&oe=69C915DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
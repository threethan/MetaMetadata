_ohc=Nx47BtlzExgQ7kNvwG_70l7&_nc_oc=Adr6jkIfHrzLOnIeYuyZdn_ZipUmCsEVjqDwYXLq8CWYjqhwS36QS8Bhrkb_7LyPcOE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME9s5O0Vrr2895L13TkTb6M-JHAKYYHHK55Acx76IyVQ&oe=6AD0D887"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVzdR6HXU7sQ7kNvwFJcx90&_nc_oc=AdrXRZOwq0Fo8KsrzQktmcn91YejzBlNqQXRPDIxcVYnbo2wtSa9epDGf7F39xkrPIA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNim6b5cNPGDXAV5npnyp7Kh_9Y4fEg9jAp3FfT9Vjqzw&oe=6AD102D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbLFFmqb0-MQ7kNvwGsJN9l&_nc_oc=Adp6NDE3LIqogyFNpLHuDq2Vxtb3H-SH7IyCYGI7wUrvkoLl7ofET-EX_-77zRq_P00&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4lJ0jx50q8dNtcjPN2LAlLfExtjd67Xzi-swTrnTy-g&oe=6AD0DC53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6KK8iXFlIQ7kNvwFnTzRm&_nc_oc=AdqK4yrSjOG4bhCQvfZOTmVmjFFryA7bnh8_XkiAoWsVQXG8gxSMltJJsLyuKgwSzOY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtpMLJpESIwMbkOBNc32zGWRraXE3gRZD9yyoN1ICN5A&oe=6AD0EFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LmaJ4ABNo0Q7kNvwG6tKhy&_nc_oc=AdoohClBF-uQm4fJmLWyJWruPxTl7e1sZV5js19Hr_tH_FxLSSqGrnCysz4uXNnA3f8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh-i47jacbnomlsY6VbQ27YnQuvBa_hu6N52IosZGqYw&oe=6AD0FA1E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
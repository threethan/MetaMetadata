n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OQoXhofPaEQ7kNvwHj3wmB&_nc_oc=AdlWg4GEjDADQJR_5GIruXi7Uwo-Hs3Gc27hDw0Ekqeg0dTuFY1xy8KLJ1yikyDe4Us&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5MoIy5B09kmCe3NZPN5DGVADAarPo7TTCL5PUKL7kfA&oe=69BA9E18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0uIh8YUxs0Q7kNvwFsSFoZ&_nc_oc=Adlm-OwI3lzTx0D2NQbUrlz0NwxHh4oGCzkaosHYWMbXvXLd6ng56j__q2ZZFVk-5Zw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxD6pyPekee6Qb_M7Crk8YNT_CAXfm4S_jC43u6u8ipGA&oe=69BAAFD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSyb0g4NY7wQ7kNvwGBwSFo&_nc_oc=AdnL3dn61-NMi-G5pxzFfn2pr6KfVrMWNbzYTHkx8CcrDXc57lzF7D_iATRwCnmxEd0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzMaghkacbdJsehAeYtBdjnE8LALsw8JxOx9V9-GH_IQ&oe=69BA8B27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atVx4BCVEdYQ7kNvwEwFPjH&_nc_oc=AdnWNn1tAmz2kEQLL04knq5_Oy9PoEu29IpVM2KYsHLGTU2umWEG4wvs4DvyHRdM8v4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8ij-Nw-C0nXByFruns6F15_ZpkpjSRbJt581MkNuntA&oe=69BA955E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6673538636074650"}}]}, "scheduled_offers": {"coun
_ohc=8yNpN38p_yAQ7kNvwF47wOj&_nc_oc=Ado0OKa1A4apiwLn8dxluI6Hz6Snbo3ePUrCf81ys-3_VAv-SJwVDwBcJGMTGhoeBl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y-YEKxOAyubcgWnjg5yVRVXt2IelMrcVMVHN8SrO_fA&oe=69EE1687"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-OBNOJIi1EQ7kNvwGv50U2&_nc_oc=AdqzIb8msxanKf9MIxgV5xwePqq0jHMV60r6w02JLd-gw47AHE8k9zpQyj01XzxuKTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r46H1IN0Ioi23cNRNyKB8-yGUc-VwplwNDIQqbbsyQQ&oe=69EE0898"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnOhvay_AqsQ7kNvwE-AMDm&_nc_oc=AdpLO6hrdLY5VBlgDvCvs-GmshH9Fv-6zYQu1K1T7tImqf4kigIjPCY8n4Mdr3g9lNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n04w6iqCrjVKr1iP2OwNpA0gxwSFpfIh3wYaSgyO8Tw&oe=69EE1A53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWyu0xDYFwsQ7kNvwH3lZDh&_nc_oc=AdpcTV1JsWfxXNUI8kADgC9qOyN6wt_EpC_fJnjlxOzG_KMZ6H0rlXyL_q6cnOqH61w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MoJFP-mOQ9x7tS6wzPwZQCng6tLl17ML6iKGXDamFWw&oe=69EDF5A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__PH_BiwGJ8Q7kNvwHXJn2D&_nc_oc=AdqnyEFw19vU7hCZZNUb1Oq-x8vg5UGZKr-rcCrfPQsUv5acLGvI9HALyfCeDH8QjD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iSPms_CZBUKSP4finwP-Z-wYDFO-WhGUbVdtMFBKFrA&oe=69EDFFDE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
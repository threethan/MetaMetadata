_ohc=ox8L4-roxGMQ7kNvwEpUg9T&_nc_oc=AdpmgQAw4V2TKLikT3qx7sA3RcLSGmuWzY3-Pqwxd5G5xEljCc-BBvxv0jC4WZq0zgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZCK4I05f37iNkMTBHl0U7JmqfxPdKAljzXySVe5aR-Q&oe=6A9D6E07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LiLRT53GSIQ7kNvwECaJPO&_nc_oc=AdopC8bod8RBKDHdvTisRIr-b_uUe2F1-ZNz4cFa-6S1qRaWKOgvnp9WKo7B6lIeXIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGaF2OviuLWNm2uKFYxCJcNsvLnkhZv2yH0ICFZ8SEqA&oe=6A9D6018"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laeKlzDDw18Q7kNvwFXmiBL&_nc_oc=AdqHlfUfXL5sT2PjoNBtazE21ECg3Kn2datCtgNggdyq40o81_nB5HJz8ADXB3d5V84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHkvASb_segdojDyN6L73V_ZHZh1OY6l_9dmCRLV2b9g&oe=6A9D71D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Elq_wR17KZUQ7kNvwEkoeVr&_nc_oc=Adr5pb1GcJkB8MHNPEJRrvlBDEEw3x4UDANOLVnFXtL-1s_u4ooF1DUcDP3__o2OT1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEEJjBHpRUDfhs2DdOpWXeW3gNLTMMaHAHoj87w5i4LQ&oe=6A9D8567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEneXIRxwrwQ7kNvwEnQrpb&_nc_oc=Adr3R_aWIQgTcS4egDCfWea3xw3903sf37CT9Bi5u66bTWB_1GWOAIpBhpwN4SFwakA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIetvhBw-okAwzaLhZhGiFTdcrhgAcUgWSpJve3-NJA_w&oe=6A9D575E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
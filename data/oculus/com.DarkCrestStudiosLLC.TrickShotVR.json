, {"file_name": "Screenshot4.png", "id": "861602418899862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031627_861602422233195_500317605450579596_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rs3klUoyB8Q7kNvwF9ZE82&_nc_oc=AdqjZO_Yh4nLqPTngzTA-vRBH8kIfqgdl9idvgmaPLQZ9_tZknLhB-02f18vmcmPoe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOy3xlQLjN8_VCkzWnWWwzDSkfciuOFBjM6lSBUZyiPw&oe=6B1058C7"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khu8ExMHHdUQ7kNvwF0n7HL&_nc_oc=AdrAEN2fRVhz_gN_GNt3uDZfI4wjqTe1Nfaj4-VuV0lwMFwWr6ExUyxGcJa4xJP6IOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXibZlShRWtjf0cqBndDioam77D1VL59fpsdayGITzMLw&oe=6B104AD8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faMPr_qO6xAQ7kNvwFeOf-l&_nc_oc=Adoh04pCs0_RVaCz9YeXVofJFwr2tz5hsk3TZOaPXNWeNqr48mlTDg4ibL4hUscclQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQouee4iqjnh_hWWVhVnSnKOaY5fBprTmJ7nF-1aGGNQ&oe=6B105C93"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5B_FAAQ1xoQ7kNvwHwdd9n&_nc_oc=Adri-itFFynzORZze5izAW3USxc3mbVZWRqlNTQ6241ro5BQweMgqLQeRvX6Eid2Rvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwLynuWK9DM12teg3lHDyyFkRY_UZemEMCTFplP63-3g&oe=6B1037E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhTzVuFmqZQQ7kNvwE2f9gQ&_nc_oc=Ado7up5OwtqYZzUIQrSzOdGd3_faAWrqzkSjwNpPH3opLsjlkTTJJIaovoys5E6KFUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWohKaLPvj6gTjp5WeA2rIlwopMd9OznWpzZbULlv4FCQ&oe=6B10421E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.dar
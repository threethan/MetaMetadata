a0a&_nc_ohc=JVoiS2zg94wQ7kNvwGVMmH5&_nc_oc=AdpgxOAhIT2VVi9B-v6FyANc_Ik03U1XLRh7FNe5leRvJyw0mz8kI7VSUbbr1Y36HVY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mzxppzPJzv2EqNTjp6nirdXTnVF3KdQfigHD45KAAwA&oe=6A11AF07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txV_uglJwR4Q7kNvwG7qr-5&_nc_oc=AdrwXU2z3_umWffCcpdRPU6gMxAehxnTjdlwORM6iq1tbwKVmQy-BqnGg3OKF-FmYko&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hAX38auEXGzyQf3xkRaFaRaJ0KVpnhXLvx6icatHdFw&oe=6A11A118"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF9XwoRN1u4Q7kNvwEOmkdj&_nc_oc=AdpIctdc8BZm4pEO0TpOwKaULQxFfNq7Z2xHQaXCqvWmZvaXgcHlvGaEoDFMkrT3Wq8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72zOdb61PPJ3WEvv5XXxkwMjTJDCfbhMtg5Ymjxc9_JA&oe=6A11B2D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxhrWT1GEfQQ7kNvwGp8J3N&_nc_oc=Adr_FPWo-hON7lK8oEmnCKhXuMdojsShSDDtQMHlRcNwvJElPDKRQUYVTdWdGwzqps0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-slCsM-_7WZECRwmkkzMzS5988x_h0aDDOq3rXTLzMA&oe=6A11C667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcftXfUNqgoQ7kNvwGxa3-e&_nc_oc=Adq-JBApEC0fCzED-xg9JksoH2nq07WfQIoRgQ1oIIqZ-fQcDf6q8ynIvdfwsjeQ6vA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FKdllG1rrbvE-UqSRmlnV7x_Bk1KKDAwBi2RuPEBPnA&oe=6A11D09E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
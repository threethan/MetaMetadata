_ohc=74zSauUqPY0Q7kNvwGM7LnT&_nc_oc=AdpLd9CsdBuBIHhWj5BqI9_Ap9N35dIzeO9x3gMXF_khMqOtm0x7G7EvwzjhdeH5HdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uzG8mvL5uWQ0ZvkB6DpgW5dfAtmNf3zplx-MtcQlx-A&oe=69E4DC07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYADONpF208Q7kNvwFdqfn2&_nc_oc=Adrl_M8qBSxXih9CKoqoAGg_wDgepm-UHuOpwbBRIqjmuQLJltUMF6Sfir3tHUS37C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OmiFBkCU_1WiylJnutT1Xi9AbpbJolyZa0iWHsRbogA&oe=69E4CE18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhm3h7c4440Q7kNvwFR0yNd&_nc_oc=AdpHj80BvRvd8NO0etzmnd41Zi6g_urcyOA44D7WxRZs-1MJTZwOmS6ncs-k7SW2NcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MWUpLud14IW5g1Ipm9kX8od1jyRhh5wb0eRk_GjsTgg&oe=69E4DFD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-RXo1YsJFYQ7kNvwFoiN2N&_nc_oc=Adq8wD8ga4hIyHqCkLl9Yre_psc8X1EEtpzuw5W4JK7dMluaCZTnvLZKr_MA0F--osQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FV5XsLY_b7JKwQn43DtTpXfwF78d7XJGK-uXrZW0WhQ&oe=69E4BB27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHZ5WW3Ov9EQ7kNvwHjZl2w&_nc_oc=AdpUZkO0pVcxpkjqoA_AXfwdCU5UGMfbQEin95f9EgpnXzf6zQCUr3Y8SfZGaCTY9JI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cO55Lh3AIUV_2zQY0CQFZAhWg170Xojz9hUvTfG9_8A&oe=69E4C55E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=wcXHKtoh0q4Q7kNvwH1nbM1&_nc_oc=AdqX_amQ_9CQDbk3TLkmZ1-GFGVcLxQS0MSid1fZWwHfGL5PqIJjbIw81X4NEsnzAJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZTf3u--yOpfmdt-tdRpbrfodb7n3jp0IKlHIqwNo84g&oe=6A1EDE07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kp6hg5C-ToQ7kNvwFyp6QQ&_nc_oc=Adqkm_Giznal8aakNs5Mcg7ghSBS6QpzvnsMkLpVRU6S7U0ulsUBw2kre3ZYJQ1kdqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gMpPTQakpPnDI-x8ZHoQ5A5Kn5Qd6jYI0qB8DebZhFw&oe=6A1ED018"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrTjTwwShZcQ7kNvwH11UTn&_nc_oc=AdqC3VkTM73sGaf6Im8fXLNT4Zz76XvGdw6MJukakm9FYgeaUxPPaZgh_EDMy_NsKYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-xw9poCaZlWttbCc17Lys2pH_S0Rzh93kAdBkHpKuGw&oe=6A1EE1D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVIi2i_lp2EQ7kNvwHEsRIE&_nc_oc=AdoRiKB4Z9aPn01-jmsHpyYYEV_j4htU_UcmAIcbN_HPDFbr2Ee9qqdo55wwWZv3D70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iuopHmgcpJ0Dlw9jBbxsrOT8nLn79p67DAhM79_vCRg&oe=6A1EF567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1AbvF3pPV4Q7kNvwGIuk9I&_nc_oc=AdpBQdh1aeQv0KJyI0TgCuZB0BNNnaSHLMbdKr43oqvj6OQqE4EQ6hR-mihwdltRj3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eQnlTCvDLEdkv1_1XrBTheBPSoQCOWQPNAsocXAsTQw&oe=6A1EFF9E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
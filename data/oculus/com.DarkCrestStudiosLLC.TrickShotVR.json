//scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D7k_zUe9_EQ7kNvwFzI2Gg&_nc_oc=AdqL1iOwx_Ij3n7Q8BHHRk_5FHWr9ZM6Je_VuOpCfAyCveK2aR-L6LI4YipAS87Mwwg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k7-lk97Cr9GCDtM6lxf9Q-gSXQhZjgLJz-SkTGgnOcw&oe=6A0C5B18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qeM8jwhHf0Q7kNvwFQwVun&_nc_oc=Adou99dcc3O09PVWQmOa6vqWRR4HsXVhl-rl5YeAJ4RH30ll1X0RYhnSZI55Kv1IxSY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mQl7Z3m0LEqpTQvsV6EagovUBjCYd1kjWzWyU1K8RTw&oe=6A0C6CD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Shp9TZAdb0Q7kNvwFrzG3I&_nc_oc=AdrtM35p5RJTa8TjkC2Hit38TYK1GYG8myLzwZb8rGUIoKkFNE0hhHrYhHfkrNZ95TU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IjzbyMxTFDMz2U_TJodkMZB2HIFiItPs6AYr5l-7LAw&oe=6A0C8067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJhBCVxQJ2oQ7kNvwHIAG9p&_nc_oc=AdoYPPiE_gj67EmROxnKa04J3l41V-dc6dVW0aKLLGP7aH2YGsUgB-ttJR6oThNHIPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51M2pI6xTggUopKgsTQvky0iPBGCjT2hA4Ya3FBRZmuQ&oe=6A0C525E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mod
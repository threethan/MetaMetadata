_ohc=U5H-K-DMODsQ7kNvwHVkns-&_nc_oc=AdrHfazn8i83_8CRlu6sfYiIQgx7XuWwI8G0Lgd6PrxJdJgdw0mEyy-lU9oQfvoHEbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QVGYurj4cI7mq3X1Qz12FVIt0WtwTQA-89_gtDPC11Q&oe=6A3A8D87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o28gi6SsXoQ7kNvwGtQTs5&_nc_oc=AdqTgrPExwlfTNEVs3xzkD0mtt0ZtX_QGeU1pkAtuv3-00465eMSnXXlKFVjOauX8Ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84XWyCQhBW5l-cXP9_vjeuy_suwInFPElX6dwpGWbYDQ&oe=6A3AB7D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30BcicSSgPQQ7kNvwElXpnW&_nc_oc=Adorva8lZxiOTNL_G1yqeTWI4pJRg9_HOC5MdgCs_Fc5LGeYjRz7o4bgoT5jXn8s9gM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JssSmlWNYYag_BhOPe6dVfTFQ3EKwfOxvceSBXzN_tg&oe=6A3A9153"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7bmsFlfTOcQ7kNvwFmjPIm&_nc_oc=AdrbLinIwhRkboNEoYnv92yUUXyXPPNo2kG1rGIRbs1HJdiByRPcFNatZd-PdbW3GxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8esowVHCyxQE5XBCRXQid6Q6WYZ7Z00Tbml7dAb4d9Vw&oe=6A3AA4E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReFw_F_eKNcQ7kNvwEpwxAR&_nc_oc=AdqRMU7UouLRVLyghuhME_uCNLTxNEebcQKTmq2rTL9n8dBEGKreWna1LBSRblhV1SM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iLwotcKeVY-oJA6EgxVHnDVLx66BrPQ_43DB6VPZ1iA&oe=6A3AAF1E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
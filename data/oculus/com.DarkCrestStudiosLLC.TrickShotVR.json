_ohc=wcXHKtoh0q4Q7kNvwFepDnu&_nc_oc=AdoMQQTSBD3ZQ5T7U-nuSpRhIyqDpiRZbEHZHFF3jpi-IV2qM-5vOcKvS_SH2PjHNhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jlfp0AcCYuGeyBZIaF7V4mw17UU3AE9ZakmODc6q-Bw&oe=6A202F87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kp6hg5C-ToQ7kNvwEWlPCl&_nc_oc=Adp1iHeTMGfFgdDzlANXXRAOsuhkln__rlSW1seCPi2bibWTD-uRBawLsLaLwpDJPIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wScSzP_LUZYSyEpoQGT7lCZsD4xM2y-aQgYRk3Ecusw&oe=6A202198"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrTjTwwShZcQ7kNvwFfwWpk&_nc_oc=AdphPkKS09F5jFYeKFQwFf7IL_VPD0csadKk_-MofTI7jaA_pxwS0R7TwPP7DXIYO08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WyMnlKHUz3Xo6_mPnMA441w_iSbqR5-YITZK_p66Tcw&oe=6A203353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02QEIK1nLZ4Q7kNvwFnFuKN&_nc_oc=AdrESMkAQCPnqRvOBo9DkBxZXt1A5DAg3h2kyp9lS0B781VdTA133oEgH1DLXoceV3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m-r1zn7768eOLBrli79rB9-ZjBtZBZtlA1W_b_wAYKA&oe=6A2046E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1AbvF3pPV4Q7kNvwHl2GB0&_nc_oc=AdpVgstaDigVEKtQqzhEmMG66SGjtPjhioc_bvqm0MvCu3apN0sPvKS_tJ1qNvWls7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74x1rszItQrRD9AkrMU2x-TygMY2StB8h8levepg-dDw&oe=6A2018DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
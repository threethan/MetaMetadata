_ohc=QlaMRP6pd_MQ7kNvwGMQPzL&_nc_oc=Adr3EzBbrozxv9-wVLAW6PdyIvQz0f7VyPZelOoIKTWs-su8fyFhnrOwGhsJ5eYm4xo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SgQbZBlgYg92bEiLcwofhETRiN4eFTaL6f-7JBh6lYg&oe=69E77F07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfkBi7x7R-kQ7kNvwHV35Tr&_nc_oc=Adpgbi1GQiR_o_J6KZghlJ-JKJtofUiFO80GDmKIabde4fzxH7hO7jEGA91yRGljkpo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pEzrGgvru5kXKBBjZ6MxYNMMFQoK2kx-lyIVindowCA&oe=69E77118"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNMxw46K84Q7kNvwHcA_x_&_nc_oc=AdrVxWPCrXZCo2d7YTAAPWBtvdfKchcJaKqtJLAHZQpBj4qL0QThwYKEK3D8R4faKb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vvWqMBSkKXj9Nx0IgnpRcRO0zU98pabXLLA608MB4iQ&oe=69E782D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-RXo1YsJFYQ7kNvwEdqzYQ&_nc_oc=AdpLXuDROwOYZlBBAmMYpZUWsKIYfposZ7qD7l1VehHX1Uf9Qvl4jYdNqoAoeNudUtE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LoW1XBp-n2XPoUMwyVU5h4le11VXFIA0oArmhpXqBow&oe=69E75E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DjY-9RaIdsQ7kNvwGNhI2a&_nc_oc=AdpzJmYM8vcQp6P2oyxmvGAEmv51sRS6VUoSoGLWE40CS1qXLAUYM1fopJGcghVU2uo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1osHcax5Letz6RMvt1vV2mKiuzvFTQeU36zGQZCa1j0Q&oe=69E7685E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
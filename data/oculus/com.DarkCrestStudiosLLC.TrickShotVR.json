_ohc=xiyqC9DNV5sQ7kNvwGZxdTW&_nc_oc=AdrZOMjyWSGITsR64Vec0BEMd5mhahuft9eIl-2zBr-CvaFJXWnx-z5ge3y4bw1W-k0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG69mpgZJZb6FbA3hnuL-EsUZu7f1Gu5yMcg7qOC3GVXA&oe=6A881DC7"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smX1OrsFFigQ7kNvwHBqSXJ&_nc_oc=AdqwNA89TE8T3jD0-An1TXEyCQ4hE2wesnUKBgfZRZUq_pMZbzVtA2nBV2rPQfSgW60&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1C_0FkmtGVXVPd6TxY6F2_xrLrV17FMCaHDih4JBNSg&oe=6A884818"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmp9bW26HQUQ7kNvwHpjxlk&_nc_oc=AdqloMOHd91ji2eiZmIqcHDE1BQHMRuuAqwi4iM-E1X43zWqHSjTD9TyQYriW8Tco1o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEihV6mVb5ros_jEcrPwhbI0frB1Pa9ArbhDB9EhnI1WQ&oe=6A882193"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WDYF0mbm2QQ7kNvwGmcHkN&_nc_oc=AdppH73tdZHT3chzq8g2HAtTj7_0mAHSI_hJIeCXTBJ5AJgtwj_61zsZmhHrOYmblzo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd4GROA-G4R_7CWwaF1Z78RbQc2UTNfOmmVKYN7mUIsw&oe=6A883527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czISE6jOm0QQ7kNvwH8l72R&_nc_oc=AdphPWgUdO0K9rwBfKct4qifkTwlnZT_VaekExev02gh6syVyt_ATGfgcwWdu8qEBW0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMedJ9GbeGjXoblfCfuxmUvdqXhfCzEDPyTnRpPeUpPA&oe=6A883F5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
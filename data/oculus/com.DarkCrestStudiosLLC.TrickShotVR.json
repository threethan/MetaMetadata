_ohc=pVlE2-pteOAQ7kNvwFuBeBp&_nc_oc=AdqIroOMpt-Jzj7U82S10dWw5YVwRfzH-ErF-HeSaovhuBs3cqHBTi3JcOhaFcURR2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkzES0phQUJDz2DcFEN-8Kypg9fWCIRM0VWrmAUc0ISQ&oe=6AF89DC7"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDOnwbE22GQQ7kNvwHoO0KJ&_nc_oc=AdqPc1IRrivLgmlEqMgvX4Rnt85f1yfl8LeUkTGrz8g3E7Yj4CTIq2yOxKHTBH8eKow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp8RpcikurBYF4gLAl9CybeZKtjBVtZUCF1hXJM4QdLw&oe=6AF88FD8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wR2IAkCVAAQ7kNvwFJGmtG&_nc_oc=Adqx1a_oeR2Qds_Dwm9pZg1cXIZR6IlzQx9VDUXsMUHMjV779bOJEV3r172pNt1yHgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfVyf3cbSZzrA66u0cG65AeBFR8mwHQB8xGqi1OdP4vg&oe=6AF8A193"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62_4oY8sKrkQ7kNvwHX3oY7&_nc_oc=AdrnYv9cbunsve_0B_dZp3sNBLHSWHUptP5pfI50jPbSm1H7BOcYktKkFLtZQcGihTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXIRO9wsn4Gsx2vDdgchwjp-iG6MikR7rrCay28vbYkg&oe=6AF87CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMHaIO-g_IUQ7kNvwEowIk2&_nc_oc=Adqhtap58w_Fe6D7Xd-HvdEzAPGUxCGHLZd3JHBVasClaueD-gCLlOvDsa7D1ZS32AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb2aOFb29F4kZm2miPcVmbOPowq7YpxyCOz3Z4NC6QlQ&oe=6AF8871E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
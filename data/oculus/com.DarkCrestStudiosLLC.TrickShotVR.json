_ohc=ctJtG6MXU5gQ7kNvwGa8p4q&_nc_oc=AdoZVGrkjXWe8Ju0Z2O43hbcE5birJ1XoRQzngnwTW-oIQ2YDpb0icg2Q0tTB_bV6oM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGq4DP-WhRxpF-hzHLtKH2vQ7h1w99qZ9iggunXxOx3A&oe=6A915847"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t36QWg_gvM0Q7kNvwFa80uU&_nc_oc=AdqczLhKyCd5hh6gOd48X8aCLicgVvXSzdz7gZc-6pMDLv5ZZ8cxgs4N1S4sX59ssuM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnrm4WeSvzpAtq3MafPJAl-Tr8a1_nm4Y9uTMLuyPdBg&oe=6A918298"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmHZSDxZjLgQ7kNvwEduoaB&_nc_oc=AdqYRO1z7AQ8QIpkUK2nvGlfPmaYtIfrDswbzdQ8blbu3_mR3tlSsd3pu16pk5Jwhd4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYTOZpHL4MsHdBB0jqOCT6koSLiGQj4GYhrCwApE4ivQ&oe=6A915C13"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIXzubgsEf4Q7kNvwG1G775&_nc_oc=AdrF1i8T_cm-daaZcgr4aHdlvVHXoRoD1dp8zFDN914vYiyWbaMsQORsw6T82ytVmOM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmhbYjKnlmLjsN0o-YlnSaSYgrUW4Ttq6yNDMfjjOZ2g&oe=6A916FA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TswOf9xG6TAQ7kNvwF0i29f&_nc_oc=Adqtd4_es_2o0S_baisJpl5woRB5ba3uahVeaxCiGCXmvannAisZxBke-TyCDBsjFto&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvymWf8FOhonWFTFVDPfE7W6PFadsMX2GhuKyCBaHFvw&oe=6A9179DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
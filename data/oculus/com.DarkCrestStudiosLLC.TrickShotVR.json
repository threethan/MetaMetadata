_ohc=M7J3lI9lTh0Q7kNvwHi6LSW&_nc_oc=AdoYxnPz3A8XUKNplLYlsh5yXWUdr9JOI607IQpKzGvpb3JZbe8Zz-S0R8AK5fssHpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIPOlCChaxgT4lNl8kHmcmonSZHdy7MKK2Nj7ToU-TOQ&oe=6A788407"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDpMXZ7M1OkQ7kNvwFTN92T&_nc_oc=AdoxCgJuag0xFBCr7zU-GgFm7MnzrtxdXWXZADCO27fG0MfZrpTnZeFjG97hyE09qvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkITiyxnHUTOzZUVPv0pLLqSkRxtFy5YdrXpNE5GoTfQ&oe=6A787618"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhnm74mcOd4Q7kNvwH0MGTl&_nc_oc=AdqLSyDjNGjBjbeP0lGxwh8RvVUaxTkyh_Q34ln8VhAvmXlqzXzkndp-VCMul7MqF8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQtqCcg6Ct4u_PqjUDRUXRtt2YL9f1WqKaWCPYtF7dOQ&oe=6A7887D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDRZwcTiV54Q7kNvwGDN5Mg&_nc_oc=AdpCqYJfauoeNlwIMt-mG4QwXQAl9eCH5CDZwVlBHINrGuGaIijdJ77Hsq3hsqdewZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCIFevmiUtuKJNz9dEO2KYQgBGhWJUxhPT9IKd4IuY6g&oe=6A789B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n79yOTXojrkQ7kNvwGsilns&_nc_oc=AdpX70HRnVqH2zyHgS7rKxAEsrSdwnr3vuG-DLDVG8FKGSZvf7RehoXbGtuAezWFVLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2x0DemWtR2PlISPgsV2EwQSJGhF8QMwSyYdXKYLZFTw&oe=6A786D5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=cdAAkTH0poEQ7kNvwGKI70X&_nc_oc=Adoqar8Rprt2xVFi0Y6Gi8kum0tMdBAP8uz3Cks142Jl53vGVrohc0-xbeLKIW2KuLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY-G9GbYOC80q0DIZvPLhgROcelZZOL4I_KVSpqvhtlg&oe=6A64BD87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r84z-pCecswQ7kNvwEuMw2r&_nc_oc=Adr-s5LP8hnRKZDtRP973W1HYmejm2GsfDAzKM-56nO9PzPuARDDXhtCn6EG1m0f5QQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg_njptEALK-R0Qr3yWGZZv7D63uHYErpYSHMCEv2tgg&oe=6A64AF98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L23H49DnwH8Q7kNvwGXmKhy&_nc_oc=Ado3aJJSFz8po30gkP2Mm6VoiAiyB4VtGutq25FGzZZUQPVUIlcOeqr2qk1fHef2CH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsKuTuMCpAqfnUWGv0dIfPDKw8UC9s7C6TlB7X_l1r7Q&oe=6A64C153"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oort96zoikcQ7kNvwGazOHp&_nc_oc=AdrZQRCmyI6Rr_4q14ktzupMnbBUxbOsIfuhtpmx-BMdBHj_SB57xXR1Uitb2XgfNP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKS28-VsyOqEFg950o_3VGU0p2OnCMzc6nMNw1MSohfg&oe=6A649CA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0va5l7squd0Q7kNvwFS9kwF&_nc_oc=AdoQZ6WrYPDLvI7CQKkUNI0zMxDgwFnvdVqLm_t3kFnWZOb7BIub9LtCOYMduvpZCY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBlvWHQKV4RnxfrWrMCllhIT1-xJt5aJCf4WXRtmEvCA&oe=6A64A6DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
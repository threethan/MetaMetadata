_ohc=QlaMRP6pd_MQ7kNvwF7MEIs&_nc_oc=Adr8NSnG-zUyqp3yXqB58UJF2SSh7bJigdVlwItrTBSgeq0oH6iQOmpzlffH7ALJt-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Be6cHPEssmM9MWsQkdCkGQCL_OU6w_15xSoYWf1QiFA&oe=69EA2207"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfkBi7x7R-kQ7kNvwHJM24o&_nc_oc=AdrzBDY0zjtKR9EjMx01fEAoXfLW7I9DbP6dGPv4Jf2SlBu5q8xY3cA7Qg6iFMHwakA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OKONdECw8K2u1V3g0Z7VLo3I9pyJluS6i9a9_fz7XGg&oe=69EA1418"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RNMxw46K84Q7kNvwHdg04v&_nc_oc=AdplB7fa3lq19nJhDfXWKZ1tOPwEJIq4O0FoYBsCMKih284793yK_qubalmBdgZsUSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ROm-GYsbMFEqupaqCOyCTtOhoHaUFCec04Hq5QYNdLQ&oe=69EA25D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibMX63Hr74kQ7kNvwGA1UI_&_nc_oc=AdqcWk106pfARRwa_tljSGK_5U7z1gQqlS2G4fld9fKhdJZM3y4ClXTz_YkqFe9SuPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AMaRPnS3M4PhKGhqnuJAdArfZKXO90TTmjnGo23d3Cw&oe=69EA3967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfm_vEK42TIQ7kNvwFgphWS&_nc_oc=AdrG3SN7pUCx2ml3u7lV7mWg_cAHdZTtQ5motrtg2_6Uf2Tt11CFn0H3igihEKn5LxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XiAs1d6jsPAn8ye6SR3djNuHHJyKAn5GmuJUlsKIiXg&oe=69EA0B5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
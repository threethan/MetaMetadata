_ohc=tDfa6iFR0ygQ7kNvwGs78a1&_nc_oc=AdrDYnu2Prp1utiF3LU8GdCNEuF5xyGs75uTvRxpfikqCD1MwZQjCNwtmipz0jAyU2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f9yn79P25DDwFr-7mJFfaqGYfXLXScVv2o8mMRBzZsA&oe=6A16F507"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfz3vtFXpHAQ7kNvwHlta3C&_nc_oc=AdrT8VeQ02s9LvvgiQAS6ZgRmleJ_A_FIy5JjHE9_x6SuT9V2QBPBDV7wUJgreDlnTk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p8BF9LCdaYNpwEqEeEduN-i_PA6wQ5-arMjwsUY3bKA&oe=6A16E718"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNvrW_Ld7mEQ7kNvwF-k608&_nc_oc=AdpmzlNZ0rFb-1i2VhFF_xoFeaF6QLhAAnxXiRPlwWQcjFz8SMIEIwHmOkNfsNT7Tuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ABA_5rJt1Um5PA-2_AaT5ex_MI0fvcZs6L9IKkyucxw&oe=6A16F8D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJqlILVwDQwQ7kNvwGeVEdW&_nc_oc=Adq2e0UHSl_tb7u8UsY0HBps8XQeTHTHuU-WiH8vRIXnWpGl_AZ-msVoE5wZ2A4pq2k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rlXoJMlxKX45ihp_aTk0NR_L8hkymKl0USHcmUQsDzA&oe=6A170C67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R74pDcyzNcQQ7kNvwGOt_cB&_nc_oc=Ado3luAhcbE9SNg_CgzYjD0WmrbasnCw3ZVBbKGywoJRwY-kCxiCj3gPC6ObYiKfWNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55KwwFzIuqqBcLUz5g2lX6zONIA7M5Es4JnIKE2nP39g&oe=6A16DE5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
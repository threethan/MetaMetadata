_ohc=yIrwNKyfc-kQ7kNvwH7_cSf&_nc_oc=AdplZDnvlIjhkckrg--ghlOvfCqRdKzVzVjz05kEtIzbW6pHubRXUAr5DVT0EoV4O-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m1FiYf8uGrQf0SrtlR_yxbAg--ob9xMLxOFFoFqdqOA&oe=69F9F407"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y35IeQ0b_SEQ7kNvwHHFrDf&_nc_oc=AdozM_GsZ76LXIkH9iJ6sQELmDBc4_p-rdMLZIHrSbLzKdeicvPQF6NCM068YqdVAMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WCnSq9msqxcswSaVwGRlmrwYCXwjdid8xPdCFkIUxzQ&oe=69F9E618"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKXEo01Um1UQ7kNvwEoTbKu&_nc_oc=AdqKGZ7RyxBfbvZOFMposCttY8gO1oIfTOU1sxNK58goWq419pYBox7Wrg7YwvVo930&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Ej64SsRoFOp_L-AUe35biZ5IGDl7obxIkcAojjxblg&oe=69F9F7D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZerX50-1MGIQ7kNvwG45gcU&_nc_oc=AdrI4rgU2qnMcDhH2V8ckL7BZOjUx1UK_Sz916qTlawbyE3gS4rQZN8vGWdMDHLbCHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sWRf_CzOltldmprOCWHOcZcJJ5OvUwIsTWBpo9XMiSQ&oe=69FA0B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf96p64o7hEQ7kNvwGMnQUs&_nc_oc=Adq6cCl6CRT4HxD-bprBaYZOr9YIgaO47ZR5g9Ng7RJk3o_tCKfzAD2-b40_YC-LMz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eQCIA0lBwEFtMGC3CKqSKZsYdrq-gwnk43Wtua6D10g&oe=69F9DD5E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
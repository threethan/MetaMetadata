, {"file_name": "Screenshot4.png", "id": "861602418899862", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031627_861602422233195_500317605450579596_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lixo76fw42YQ7kNvwGCGLyZ&_nc_oc=AdqK_yBBdh2eRxSY2EVIpbMGnwO9OTfONuXV8LOP7OF4SdfwYZ-FvfnctVG3K3NdaAs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGWXxM-joHu-Pz5HHUDcY75lnEgM6WpIPUBqF-Oo-P5A&oe=6AFC9247"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBYyF2yXckkQ7kNvwG8k0l7&_nc_oc=AdoVbAdhVkZLsV5RCppX3eCI-XFSEbVvxKoQ-IsBWHdg8RmR1DjEPCmcli2vuWNXEbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp2alV6yYBf-1YFAywuDzffvlAcaWk2RV4les5zdfYaA&oe=6AFC8458"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj-5n5uLMRIQ7kNvwGAMcJc&_nc_oc=Adp9BNzfg2Kt3_h1UUJsH25kFxrT0JYwXeR12hNoRcK1EuC7G1REaX0Hw44VmZ7K0QA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_OEW6LkIpFeQOkIcvKTZPuAkN6gs80RZKK4qYUnEoNQ&oe=6AFC5DD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUU-daHX-r8Q7kNvwEb2x5h&_nc_oc=AdqCjz1-ckJndyFSCLbTfeTjiL4RDaaDuPCB4Zh5BVtU72CtYARbukD3mdPrJqVL_E8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNfcAkRVT4gk5a4TQwfsU53aJGDkr_V2AoHwhVWXykkw&oe=6AFC7167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1czAIP-M8AQ7kNvwFTQwzb&_nc_oc=AdoFNieOhtxmguisL-SSaV3aPScOQlGMZA3-kdxDKzW1psnWX6Jv1znl6NmMv74gG8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6UVGlf9zCALS5wfen7r7flHUJrHTnKwQl-jpaCRJYWQ&oe=6AFC7B9E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.dar
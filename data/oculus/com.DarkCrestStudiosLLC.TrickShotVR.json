_ohc=77TOjWm02L8Q7kNvwHjqvhs&_nc_oc=AdrAAvg7kYPykj0KpH5smgYU_RZMY6A11uIKv_sAjTYDwMEahmP6ciwjKMWyqfwLhjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiSLocK50lV47FF34Bh8yJmaN68u61z9JbYFU0eeM91Q&oe=6ADF5907"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp7bIaZFPsEQ7kNvwGidOXj&_nc_oc=AdpyRjM_R-S2Jwd0dfnWPsYSAdt-aohjr75hx4vCIDpwqvFs4PRRSqUJiD1uLbV39U0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4CtI9ZxLryrwStySYMi8ahDOR72IT2BpU5w64bIFvNw&oe=6ADF4B18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HXdvRYAajAQ7kNvwEsDLWJ&_nc_oc=Adr7UKxPcKu-FdoJf2XHxcTYJBopCgYAQVBJC7-PSxdZ4iPr0BPPuRtbatzDGnLile4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM436yZEe3jA2hYgiqa1H8l0v3o-qQtvIgSWjPyITvBpw&oe=6ADF5CD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcCEUlgfQ0MQ7kNvwFYEyF8&_nc_oc=AdqEO64S2VX7NJzh5iLRxDw9h3yesJWKin8mMyiudv52QgVXJmRbqsdLZPspxz-zigs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM02_0sMzrz4huBlkTezGSu5rb_PK4ttrTUVO8VA1ExVQ&oe=6ADF7067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu7MOlLhni8Q7kNvwF3Up_B&_nc_oc=AdpgW7rAE8-2XNyUCBd_0BFG5VYghQchBU1QVwyivQnvCkZo_ROQ4v08IV1MN_Vwg2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd0oNkwBxOHxGJX8fm2psEAr5RIp3A3dMiaKmRshsMPw&oe=6ADF7A9E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0s82rPegqA45y1Q1_Hxnu8S0BVks5VqjbQ-CJohXBUKQ&oe=69F0B987"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OvzrNAt--8Q7kNvwGvXldC&_nc_oc=AdpZg6GEjIq1fiyRNF1KhhMJL91pgS6E4CcOz9H1SMaqAxIgb8LUrzIbR1orBB2TKDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1qG190OuTpruBtYCwBaQuErvmUOUxW9XcQZSwIhkg-XQ&oe=69F0AB98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NmUHEedDocQ7kNvwGBY18V&_nc_oc=AdpvLxEgBC6S8cTxBJbB8jFmykIDikdec2Inam5ujzzCwcDH6LR1mKOoM3kDIrXiGBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2xvD2nKHhL5uFl_ZaTTAxOz4SciFKzvgNJ7u1AUp0Jmw&oe=69F0BD53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewsM1YGzh4oQ7kNvwE9nX-J&_nc_oc=AdqTCcgC_lb4Hq7D8yfDDBH0XYq45pO2pmDmG43tAduP56EbMbWzmTdMcYxhy6MYcio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3ljMfLPclsglEp5JprOd1_qKtjJJTT8Bwl23cI38Gbeg&oe=69F0D0E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__PH_BiwGJ8Q7kNvwFjIVEV&_nc_oc=AdoIdJ0yJpUoMoeUv9kFkOLD2ulwQIC3ThElkhtevfVNcDyd3o6lsW6_9mNrYljRLos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0NteRtWXszkKS3Ywf881n9z8ZzZGh4yTQQLIptVPzM9A&oe=69F0A2DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
_ohc=k3-Uu27RoaMQ7kNvwFVj8nl&_nc_oc=Ado1UMOGQIFyd24fEv-FUARCJ355NSmaKYsX3n_E66kc1spb-OQSThURJUKRpsFs9RY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd2x-2rtIv6kExN6GgvD8Tu11FJ6EJ-98aYYNSxwUsJg&oe=6A4A5F87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JrLFzOX4OcQ7kNvwF5Oety&_nc_oc=Adq9xZd1b0mEZ-MeNv-TNwO6up6fSo-3M3HBI--SH06DCZhWHoLoXKUZqmvX6BwzmAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRKe6D9ywCa4eLCKKJnzIsl3m9MZEUyn337S72DNCdmQ&oe=6A4A5198"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_S_zYpj2AEQ7kNvwEKKEB_&_nc_oc=AdrdAuUinl1DN6L1GzVo3Ms87lJIQLOnthOxN_Wp3pO-imLERVjo64zWMuRqIADbzFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-rp9uXqjKGtaiJtkj3CmE0_SJe0gYOG4255K1l9ZFNQ&oe=6A4A6353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5M2tlsWh_gQ7kNvwHl2ci6&_nc_oc=AdoAaDmIb_ei4U1pR5Hkx2UiTMLb3KhpNRyXJZPba5feKrZQm_X2oSgXJSqwxAV6CWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYtEFgDsoVMVwqvTmTvUh6n4Tayahn2-UNB3KaY4xHJg&oe=6A4A76E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIYmr8sleXEQ7kNvwFicxEX&_nc_oc=Adrf9zjr9t8CKfer_J20bIxnzSYi7ukxRfSz2_xZL-c6iXhDGZN4ydK1vxPggTTRX1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk-dWW8hJS2HssLfB1NDbA6EvBBRk-bIHy3qNS3UN88A&oe=6A4A811E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
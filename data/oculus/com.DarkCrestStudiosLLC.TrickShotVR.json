_ohc=hbEJvwdCO2AQ7kNvwGLUooH&_nc_oc=Adq98N5YwsmswOYWSXGkNtXy2E41ECB-Q6Yx9vuPdSHqLsQDJ185JzVynod5OjsT4iM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BH4XZuBt2T343wNXRD4rhyCJrIWd8Zl6VNnlUjPsbLA&oe=6A300187"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljYVARvT_KEQ7kNvwF8bETC&_nc_oc=AdqjkCvgheeEyYzMjBLz1xfd4kJFT5vXxT2f7CTzUR2xKyYYBeuYcxB-IZKdFD5pC6o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ap5Lm-Dz_BfQd8b8_SYR7c9cVU7KxAVLBaWEa8BlR0Q&oe=6A2FF398"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDDgcUgkkQIQ7kNvwFxT9hH&_nc_oc=AdpK0N7aN4zanqiVMZwxd3-1gjhLDDBMMAMe0GeE98aKRaHZv3LeeRW_LbkFcWEYcME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KXn1v_IDgYlxtVCufjCpofRwvB7Ufo4r5q3QM2xHcfg&oe=6A300553"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAR-BbJ4JxsQ7kNvwHkqdTq&_nc_oc=AdqnmUKU1kG0dACiqbf8Gfuu8ba3z1iM-v9Q73tMYeE5qafPaqeIIRTALgov_kCt_70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dZuFVCj56gLRJIfymonwmrDaMueh11rSEFpjUjVkr6A&oe=6A3018E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8g_QGEv50oEQ7kNvwEodiZk&_nc_oc=Adoxh9H1uK1GlAeLEzs3_6P-3r7P4fonglIfr2zsKKB3-DNk8nmpNCKL_toIpivoDto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gMUGP3gyKTxKOXYmdWPyWgueJh2MHLBnj8C4NT651LA&oe=6A30231E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
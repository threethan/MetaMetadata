a0a&_nc_ohc=9mwBwXvcjKEQ7kNvwHAm1qW&_nc_oc=AdrLzuoDkED9veq2_YO0JczYrBHzoc1vAtqYlfh1rAR5vn1JxwlbHBnD-BaPSWr5ZSs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz6TGZz-jbvPcF1PsTRA2PAzXSQ-oDxxnrue58ZiMakQ&oe=6AA94B87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCyghjScybUQ7kNvwGAFKkf&_nc_oc=Adqnm1TKdMGHXlc728BFuUQ6aUoPS8rclUjcjM0lslS1DObsjk3aiczJTvUYZWowRns&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv6TATFRoE6S6_DjvALHnLHr2V4pvH7QLftjAQhI3cGw&oe=6AA93D98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsUWN0RYtZ0Q7kNvwEXMKAV&_nc_oc=AdrVlkrCaIuW5Ohgue1B-zz7kiOSMcyzrSZYNmZkfQoYrR_yRjk0NENIxgSGwzxA7TU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuE_WnQnYCKlzXKUqBal3ZklGAPzrB9brNhHx8OGUNTw&oe=6AA94F53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilRtGelk66gQ7kNvwHxNqR3&_nc_oc=AdrQu_z-A-OTBPSNAvBWi1RON0xf3J49QMc6GiuOAPVHyOT_3GKYuxvajd4eB1vtNfY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcAYy5drDWPu3FUTID1n9wsWKkq3OE6UrW8vstpfhV1g&oe=6AA962E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9mtMJZ8y1oQ7kNvwHTeIYe&_nc_oc=AdpZOpNpWFBB5OAUWnDioUzf8FmvzDKUKG9CJ8EIBmulpC8mKS24lNEyZcXNkg9lWBQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcHijU_AyYHd2vrIiScj-JgH0bAfPEAHQtvCc-l9WtCw&oe=6AA934DE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
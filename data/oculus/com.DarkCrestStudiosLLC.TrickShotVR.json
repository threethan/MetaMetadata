_ohc=L2gFJY_yQpQQ7kNvwGh9RAn&_nc_oc=AdoyoV5699sjM9KqHPkcNpEXz8JDdI4RUJY0Ev30SL8o4fVqCQc6KwN3P_ZTkDupa9c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIWODqtViY75fX2vRcRNpJ6mlmxY3bfO9gx0pO2uRyJw&oe=6AE89387"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGikMQKXvzMQ7kNvwHTlOdR&_nc_oc=Adp0tT-Mk7xjTQ5uypWYMbzU8FV97Ar4XXCCmJ7HDHDKnV5Mra8kiXTFe81D-QuNT_U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS72ifiigq8TRnGaqLqzbTlNUbz6Cl3B1yv6r3FDDr_fg&oe=6AE8BDD8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-3nokFFpg0Q7kNvwEfZytY&_nc_oc=AdodB8uHnDndgL0a7yDu5OrNai3BmH4_ICdMAflTKLrp-rk51gOgvNMoiPuvGEHPiis&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxDnXh5WPk6_A1iDhUzLB363T8byoRRNXz3LZMa_ZDvA&oe=6AE89753"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se6afvQVVvAQ7kNvwGJQIUD&_nc_oc=Adp4IeHlyeqbTIIO6s5LBcqisFofI4maUz9GzzG4EpAVEmX_W088rh3Aq0HGH0tOaTc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Vc_5moyp1UWTyk1bM3khGPxgJ_ggt_eFMnYd9q4NKQ&oe=6AE8AAE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpDPvCh8YoAQ7kNvwEMzOvh&_nc_oc=Adq9ztfIM-ptaRv29RvQw3tk4nJxlZVgJK_ieLJvuAnfVj-_EEkB1NFtcHyDj9uOcGU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe0F2AnOb1BzB0pdo7-qBN_7qRTkyaRYY50ehmd05Inw&oe=6AE8B51E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
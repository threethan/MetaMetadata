_ohc=GbjldQfcSr8Q7kNvwEHiUpY&_nc_oc=Adpqt1dXvjetK64TUh5apW37-4d73L2REf0W2TIi38j4egc18SG0y0g2Evj_ABHTJcs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IrLXiibY_IOqlgbXIo7C7f0-DDJA0VLN94jbq1jQ2Mw&oe=69E23907"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4hswSQVD-oQ7kNvwHLxx4v&_nc_oc=AdpP11NpJSSJfPGQwPqGcl10qDMp2a8WZ0XtW2ZJ56n1ZWvg_rZejJpeoKlNmTI5Ii4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af082vy1IAQ99o2jv-GeCnIYIB9LpSA4Mku8AFhDCJ7vgg&oe=69E22B18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUMatOmLfXsQ7kNvwEJJOhm&_nc_oc=AdpacapIlMY5Rl0YaLaY2Ue_6txYJg4XpjtgV7oIlQ9McAWAG5doSFKtPDGjmkxsQ7M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I3QYpJPRbDgsz0O8t4ziuud0hX3CQ8h3VKjN90dH94w&oe=69E23CD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnWptyrR9wMQ7kNvwHFORXY&_nc_oc=AdrX4yXdS3ElaTmCjblaig49rhujLvjudWR48lmcn4y7esddYgj5opYZQMl5kojcOKM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yw-v5eRzUEf4mr82pDvSmpPOcXUVikjUPCUEm6V_9CA&oe=69E25067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHZ5WW3Ov9EQ7kNvwH5UJdD&_nc_oc=AdqnLoxRpoyqN79gatZdMhnh_4nGtShci82gfwiu9ZUYxxYrt-HEN2hRrOunyyFI3FY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Iv3YIUqWvxtQklwNtIKrJsTTMQrh_NT_MmcbXvKhbrw&oe=69E2225E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
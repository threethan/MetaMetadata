_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuk0-ZtfJtB66hu37deU-uQVjBPgTdEd7OJIjx8Rl_N4A&oe=69A44287"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij9q_Eyvh9QQ7kNvwFEesan&_nc_oc=Adn7PkZw-_tAln_SXrO6HLeWT7rOXBR5IOLCNRe4Qwoij4zyOoXFoTYFaZELDxe4Wtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftU-KaKwoc5CtfhYwknSyfVvELNm3Q-bv8sNa12L6BIaA&oe=69A43498"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr9qsWlBYp8Q7kNvwF3-_k7&_nc_oc=Adk7R-IWJR4rU11K3xcuyy5QHah6CX8iHgssAWM5SCB8aBQk4EJueqpLZLWbaxKirRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvX6FXsA94oB9125AqrI_MVEOnXIyN8XAgwAwJb3YnsbA&oe=69A44653"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLbL643uQyIQ7kNvwEnsGHd&_nc_oc=AdlMXELjHkNyAce_8Y5UjaDbdLug2z0W-vkWpZWFWu8k7xSWDn-TBor7DaE4rNxJSdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs7braGxEykhsv7lbv8bnwwKeKHD4iYCIlG2l6Bft85cg&oe=69A421A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKYgCP8oMe4Q7kNvwGfIPdT&_nc_oc=Adnm4jKWWwsxdyL6B8Y8yzL3S57i97cknVHjJNN9umPd6Puth4XgL-rcTmsu3spJE28&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvP4DhLjVtn2Bj77Lsbitn9lUEY5kyT7ykKl7mZrRWEQ&oe=69A42BDE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
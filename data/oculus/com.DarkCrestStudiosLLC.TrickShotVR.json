_ohc=K8a5-9LS934Q7kNvwEApY8w&_nc_oc=AdrQbR_cxeb8DXapPJWp5E1GK8BmREHMbdAfagT5KxsrffcAYzxTAgo8E1BkdBVABiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bDaLyLthfo1Fu-YdfhGRrPIKdyFqun6q2IHJ4Bp7W_A&oe=6A257587"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAVt86ORFhwQ7kNvwFB0jf-&_nc_oc=AdqGGilvIgTxA4SxgVsCf_lMZMExlprAr7viDnvc9wR2MHVQauV0uEPaG51vcns-7HI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cdLe9f_3iIv_C_gXnUtubHmAWh6-VDWbA2fSVFjGqzA&oe=6A259FD8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4_ECFs4GeAQ7kNvwHo5pR0&_nc_oc=AdolAp3A6qpMj0d25mp61pTIRzyUovm8zldBdLMlu-xn5IhGCwi4jZx3Aub4HtxY9D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aWIe83wq6dI2WX2R4TibhhPlNtR7m8kyPHIHOiB95Bw&oe=6A257953"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqeMqJD_YlcQ7kNvwHqHGEv&_nc_oc=Adpz7FU5RjnYf3T1zU-YJ254oFUKLHZiRZyZeT6RK14U95jNLUmhlzFmaTZKsACaEsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_83JFssB_uWauyUiROQVUri21ku_niaE_7e8h55jd96Q&oe=6A258CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO3ZSY25ClMQ7kNvwEgvwHX&_nc_oc=AdpI124W7TdpHg0E2APjCiVB3RKLLB99NhrzXHDN7aa_SkxpgEFtCglFf6Pf6hwvufI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uSPEzfBCbR1KuNJBVpejyXFQYDXkiSFmoIUxbxIxOEw&oe=6A25971E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=wl-wS1Y1XUcQ7kNvwG69ZiQ&_nc_oc=Adq1QcLXSCdwG4vs_k1OfdyPAyf0eIhHu5qAZ7H7NIrq_l6Actd8hOBexjV5gwAeEfE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oDJ03bABTOcYzTq7igvTV2XcMNLJw_4vqy09bz1yXHw&oe=6A33F607"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IbgJiZvtZgQ7kNvwGQmdp8&_nc_oc=AdrLbquaOrjMzVrwL0hmiOpmy3rMp9c_nJZvRbOnwhnM5NigMSCvjCO40bOBV0gZLpo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vGTReCDXUrzou5sZkuGi1CYE7dEc2daj822J_CXNh2A&oe=6A342058"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxFOoh-q6i8Q7kNvwFLC40W&_nc_oc=AdoqsK6cNWPcuaEMDQbZDpUepfxWuLyAQE52PVn95DxCn1xwjOF1loA-zD-fzqc1nUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7XxmPeScZCZVXoxuW1hggrxkIUiRa5ueTx9VTOXI_qA&oe=6A33F9D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6RA7-JVfpAQ7kNvwFrvol9&_nc_oc=AdotqsWc0WhGqbeP42DtOkn4gm6dH0ozjx5lSzbc5SL-ykUCT5ckTljBlU0WYVaYq-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y8Vg_tJtO-6xrdAO_LM0zAPVBbqjAcOIC8wPN1BAqeA&oe=6A340D67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNsbU5lXh6oQ7kNvwGcIwHb&_nc_oc=AdqA520aFi5nApG6j1L3925AWCLvh96ogkNmvNIr00yewt_4jl6TO4NYb9lPMyCsb-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rFRZkGdfrirpLRZ-62zOMWpKXkLe_QnAEQEUr8zCZ4g&oe=6A34179E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
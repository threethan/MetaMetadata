_ohc=U5H-K-DMODsQ7kNvwFVdBns&_nc_oc=Adr2wNOnd1MztlRKpfNhvLkvGLJ8DYO9KOvZVqvLB3_N5cOIJVB1hNGHPa_33ERN65c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98vvaSomdCA-S7v60drFfBdCB4q9Ko5NaoVz8Kk-R8Xg&oe=6A3D3087"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o28gi6SsXoQ7kNvwGM4d2v&_nc_oc=AdpeMGe0IeL-pxa5sK475vd0D8hYJxiuCJ8UPYqODJxFxouLSnNPgsN525ZStOJHcyA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90PGcFWZ7_JJoxN0rkHCs4W3iy1qP3cYejna7LD0mvdQ&oe=6A3D5AD8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30BcicSSgPQQ7kNvwHh_yJQ&_nc_oc=Adpwwdov71i-Dwa0q2Ebd5oEmWIVxwol-IvHzfKFeQgv0YUr8Al-4XEXYOYJJK0dvNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8DMnmdDlCvGBKFtXH0zLXO6OuKuGGmfQVStRlwgNlVw&oe=6A3D3453"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3bvWYdIISgQ7kNvwEBUODQ&_nc_oc=Adpb9TXRxiB-izU83FqGhE5gwqLRYr2rQgB0fz2xTk-7_vqrdhkj1UyB_ZLTaAODSxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Elpx6NYSq43K0JLIHv9qO9cAHiPG4OyHCxRLIztkbkQ&oe=6A3D47E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhoYlXydIUMQ7kNvwGw7OPD&_nc_oc=Adr3vs4IW13r5aPk-2_lMW4l7dVJKqeurob7WlVCY-LcJhETHEcg1WVq-NUcI5VFCV0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vm5b0I_8tDX6vCH0r2lqg3vk1BOkwiKHWefWzCQdrtw&oe=6A3D521E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
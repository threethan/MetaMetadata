_ohc=9ORvTAL5cscQ7kNvwG3f5X8&_nc_oc=AdqXm_FxZdvxxw4M6kUM5oyofJ0Y88lPttpuFoJq6xkAf8aAe1sgw4vo-ddtESKcK0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqJYAs086tr9R0IATdeVJnEOAJk2dY4sny3dsGn86KEQ&oe=6ACF8707"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVNhMifEbrYQ7kNvwHEDQV7&_nc_oc=AdpP7KShJUfFUYHML31_zz3SkCMSz-fkcPoVsbBDzYVYn9cV7lNYhicPn5Q_3Dikr54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhWEB0TJC1r-JMu4r2pchAxlJAaumQp1GFlk0sKlVM9A&oe=6ACFB158"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjSrusu42ukQ7kNvwEc_6Hf&_nc_oc=AdovB0fzfxJmfQGqOthtK-_ynZ1upYmdmjYKo4uiIVw4EvOu_ZrgwQoytUsHiQAP8HU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgHKSnChmqjGmaSN6neZYdSYGqdg-Hm7XkcwUt85HDtw&oe=6ACF8AD3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6KK8iXFlIQ7kNvwEch919&_nc_oc=AdrEqWmRTtnpg-yVJhPfgbcejo_0bi5jQja8O8k65vcKPLRnoLdlJ1C_8ecMSDKZvYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkorFhwRJeFGdGUubDOiaOAuhxU2gNwTXwCGr_zhn2kA&oe=6ACF9E67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LmaJ4ABNo0Q7kNvwEKRTVb&_nc_oc=Adpk3XtyHyxlYzfCdToNF6mzo91dQqMIsdz1qFkWZIvVt5JFQ2JVmXI0MrH7mTm2mOI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaODedC2th5CQVdfbekFLFu0_RE2xBiKk9IfVM-th2wA&oe=6ACFA89E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
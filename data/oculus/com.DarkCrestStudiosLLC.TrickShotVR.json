_ohc=Qx5CfyRpmWAQ7kNvwFTmc70&_nc_oc=Ado1hwXwkWMgie2DpnewPR_uOXoEkHsVHe3CetaE0jG5dgK5dwRyMs2_ICRO4oJwEbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkV05SYLiiGgHueGvjixtK_T5S-Csxe-trCuEKMME8zQ&oe=6AF357C7"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9QglOw5nFAQ7kNvwHTESHr&_nc_oc=AdpBtOC_qPXzUtHGNeFElmMt8LPf8Z4_N1sfuR9Ch-ccX0RrJEigAR2wwxhP4zwGP1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0kmojX4j7vs8TDvg5uksAIeJOSuvIyu-v4F3HS5-m-g&oe=6AF349D8"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2W2wDWS1-8Q7kNvwEh2cOL&_nc_oc=AdqyEYWie3UlxiqfUQIgJ9l-nEIP3GwSu5xr1attpg0d52rV_bYRYvop9ap3GQOKzQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5hoCIRDAAo6w35V-OtJVjJP6BKc_dTGDbnjdOQpyknQ&oe=6AF32353"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m17wT-wKWyUQ7kNvwG7LbqA&_nc_oc=Adrtd6a6Ka-CmPcK6VaqkH-OobED6Cy92LSVRuqyU71t_ePIaV5WwRZJH4xjY1mli7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQDrJhr5EXkwBlGzWyswe1CBwou9z8Bg553IZ1YGv1gA&oe=6AF336E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t38auiUBlnIQ7kNvwGZaJhN&_nc_oc=AdrObk1nyhM-5U_3uoUof7fAaeKEkeP4qX_GcjYqVH1fvrSmIQjPn_HQwhGdIVRMh10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE05YO8iq4x0e7nvtAPl2HjsrjqNPzV5K0GCdioB3EtA&oe=6AF3411E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
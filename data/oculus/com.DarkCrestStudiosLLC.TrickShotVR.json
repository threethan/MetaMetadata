_ohc=9mwBwXvcjKEQ7kNvwF3Uhnz&_nc_oc=AdrTwp_T7-UcWJVC3Jf8XLaFItJwctynklWm7JP_xPZ-OEuBgoJ3UjkghvLkfeYcw6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsIm7x7eXi8aVMeDLa_M2UNC606WmlahEbiuTEzozUuA&oe=6AAA9D07"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCyghjScybUQ7kNvwEtksXa&_nc_oc=AdpxWJBBEDFfF1fTKQCmPImR_Aau38qBehTQ6dthH7pZjJrGu4iOKNfdQSeGZT0YIbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv7aW4jMRXOc19sHkaDTJPt-AfUSpUGCZCXVTxgXRC8w&oe=6AAA8F18"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsUWN0RYtZ0Q7kNvwH2eCd7&_nc_oc=AdpbNWtqkh0iDGua70E6rAzO6uiolU0Y6dZ4sy5nIbWthCuj4cM7--R46aA4wWSsL4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTWCv7RZizrYEyQ4_xtbl2dAz0K1luhYsVtG2hsvmU2w&oe=6AAAA0D3"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IOYAf_rmm0Q7kNvwG9vBTV&_nc_oc=AdpAXV5jjlz6wuAJmakBQSR2AsXT3E0_ccag-f_SS5xbwP5-bm2GUYUfhZnYXsJK6lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLZYILMyPwBTurSmTTx6oO3uR4aVg_PbLD-1aJUDWbpA&oe=6AAAB467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9mtMJZ8y1oQ7kNvwExIkrd&_nc_oc=AdqiCXYH_q2_NSBIoV0pBHB8C6Bq-KTmH1TgxDNoRxWS10TNGbhnjuD80CCAD5wVFqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVmiqACOZ9RS5ebY4jdevXAlNcpFX9XxUBDD9q-750Jg&oe=6AAA865E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
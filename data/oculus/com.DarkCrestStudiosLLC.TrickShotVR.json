_ohc=_2sKWPeS6J4Q7kNvwH5ALIL&_nc_oc=AdrWM8sL-LYDItcAMVyIfP8EbbBkMbTI0xQY1OhaT-YlGY7B5uHoOIUE6HTb5wFoouY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G2cDkzMVfpnvDhtCiWZxzu9dasm25mCoaNfRhU7_fHQ&oe=69FB4587"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xSc6gvKG-QQ7kNvwFj0eK3&_nc_oc=Adp6fFTRZ-SFmKzaoeXsS9FAL59xH851FTXTWMuMY7XGn-1Dkksxs-8oeyNeRD82UuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RBBGks37WDNZSyRTWboTUm0YczYRyGFQevNlrO0cDdA&oe=69FB3798"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox6OWZY3QbAQ7kNvwHMKLME&_nc_oc=Adp2s7xbmyx7g1FpQddSWjdf0rkcHJHx6-rwQYR89xJiei_N9SQPmZoeiOa0osyb2ig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wkexmqwA1of7fnZmzJaZlDvgPExWahwPgWMIeP5BXg&oe=69FB4953"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZerX50-1MGIQ7kNvwES8Nu_&_nc_oc=AdqRWSqlfvTsCcsYZsIBdNsEszc_Ha4OOEqdZK89BJkvU-7Zqgyt0iqzu-I-Hp-4HAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X4LHcYu3Z3u3LPKzyrlPV2S2VWO4Mo_MnBYWnA6rfKA&oe=69FB5CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf96p64o7hEQ7kNvwHqzKfo&_nc_oc=AdrjBz3ljUt_CUPGEz0ZHTCd2BMcmtHteW13jpJPuEw4fwBJlWU6li4_dCW9bjGg-uE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lLubedpBw-2G_8sskvJjCFGvHIO2Bqsp72nCREZ7ePA&oe=69FB2EDE"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
_ohc=nzKYAUkXGwUQ7kNvwFG3Ubq&_nc_oc=AdrmXMVPsaUDnCD58BNXsk6l_rQSuSubyTEB2XiOXZanYQucQnioPkdZKMaCX1t5lyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJChKcTGlIPDDSwi-W3CUeuy8317ML4jk1bPkIBPJ9U4A&oe=6AB67A87"}, {"file_name": "Screenshot2.png", "id": "1048041483110126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_1048041486443459_7346039994588481179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2n7hGk8yE8Q7kNvwFwsLlX&_nc_oc=AdqSsaGIXWymqyxtzULY-Xu9ebtHAtLQjl5x-Nc12fakexpbfAK6_nZnD-M0mAkQVf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXnAJRRkgdsrPbpQj3M7f9xJCZD-bOBGYcranWK3d1MA&oe=6AB66C98"}, {"file_name": "Screenshot5.png", "id": "833704595209069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974821_833704598542402_1020522212248896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29IJw52AFssQ7kNvwH0DsTK&_nc_oc=Adog0zbZj4JPrIugqhbFdgnlHjnEvfBdgLVPT6cTiG4zPN7zXBgPkSjagq_vFlqGonM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFPtdKjZCOGPM6J-cG9FTdPjLEq137cFH1AxR2QTfrzw&oe=6AB67E53"}, {"file_name": "Screenshot.png", "id": "283171127378906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_283171130712239_38048015563775330_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaFkmmMNdOoQ7kNvwHKu-un&_nc_oc=Adpu26Y89dnf8zIG9ZwZ9L67osGKd_GwV3leUYjjeXgUMLjunJmB-mQ2eutcKJSnc3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqTbz4dzcRcfgc8OSUlU0QAwuzpGfC8VoelVE-0mazKA&oe=6AB691E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TSVR2560.png", "id": "557783223170073", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031579_557783226503406_7792884008937608733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVw0Qtj_5-oQ7kNvwEB7PuB&_nc_oc=Ado2es30zPtbJ7FiLgNPdPQ-lF2eE_4GaH2DSKd7LXfJo0iZlauVMW2p10hAEkbeOrY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnO6Oabk-1jlqQ5Ei8IyUyuquGzLup6Qju-febRuqLRQ&oe=6AB69C1E"}, "display_name": "Trick Shot VR", "keywords": [], "long_description": "Have you ever wanted to try doing the craziest trick shots around town? Now you can with Trick Shot VR! Switch between using a ping pong ball, a basketball, or a frisbee to land the best shots. \n\nEach trick shot item has 3 unique levels with their goal item set around the neighborhood. Once all 3 levels are completed in a section, that trick shot item can be used around the neighborhood in Freeplay! \n\nFeatures include :\n- Spawning on Grip - With the spawn on grip feature, you can continue to spawn throwables as many times as you like! \n\n- Interactable Openings - Doors and windows can be opened to add another layer of challenge to shots.\n\n- Moveable Pans - The pots and pans in the kitchen are pickupable. use them to bounce  throws off of!\n\n- Clear Spawned - Too many thrown items? Open the quick hand menu and clear them.\n\n- Dynamic Scoring - Scoring is based off of how far thrown an object is, and how many times it bounced. Each object also has a specific bounce multiplier!\n\nThe real question is, how many bounces can you get, and how far of a throw can you land?  ", "short_description": "Switch between using a ping pong ball, a basketball, or a frisbee to land the craziest trick shots around the neighborhood! How many bounces can you get, and how far can you throw?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trickshotvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "DarkCrest Studios", "support_website_url": null, "website_url": "https://www.darkcreststudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
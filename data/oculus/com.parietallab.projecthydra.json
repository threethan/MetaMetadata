a0a&_nc_ohc=sZvjGOdXcMAQ7kNvwHZGQ1A&_nc_oc=AdoSlsu1dNTNGElQ4sEgjcXeo_CfDzRpervo1NWY2udRy-rx92z_xM3MYYahw-ugLcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiSf-pyiy8iE5lx_V3tI0x4h6fF4ujbHUyZgm0bYPAfA&oe=6A9999F8"}, {"file_name": "ProjectHydra_007_0035.png", "id": "1647014809834786", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_1647014813168119_1418846723430161045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NbbxvDmG2oQ7kNvwFl4BBi&_nc_oc=AdrWM04QONZsXR1U54yAyGX4Jr_skYxCdeRI-08FpWDaJj4pbqdI_qBmsYEoiOSiNYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx-geoKYxkBvY8tijiKmMKxsXAsDAbLJVoiK6dPJZKtA&oe=6A998DB3"}, {"file_name": "ProjectHydra_012_0006.png", "id": "846045501852170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_846045505185503_2011991615511672221_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dF3BAK0ggUQ7kNvwFL9SeG&_nc_oc=Adr7zgKlCmprney8re_ew-K1hniSYm5ezBYxytEeHdUCEkhkOxSa4rHvIwq83FD0S0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVzI6cCVoYZ4QwG4I5lxOuPi_7_LFBayOpfo-y6EtOGw&oe=6A9979F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProjectHydra-Cover-2560x1440.png", "id": "1481579480423129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_1481579483756462_4117595164746722322_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEJnvu6szEUQ7kNvwFOSp3x&_nc_oc=AdoPK83jMooFHRPV4PCTISdAv8lr3uYI_mx9_hXEFjBJE6ngqMxdRjBHP-RTsuFik6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsxgjOqyKQ3NLbMmIgLslFx7gEul3CLTynVh4rmXHI2A&oe=6A99776E"}, "display_name": "Project Hydra: Iterations", "keywords": [], "long_description": "**Project Hydra: Iterations** is a VR art experience by Grant Hinkson (Fr0gg3r / Parietal Lab), creator of CONNECTOME and CONSTELLATIONS. The Hydra Series began as static images rendered by pen plotters and has been presented as projected installations, wall-mounted digital frames, and holographic displays at events and galleries in Seattle. This VR experience was created as an extension of that physical body of work \u2014 a way to experience the algorithm (a generative system of B\u00e9zier curves drawn across a fixed grid of rings) and its variations at scales and forms not possible in a physical gallery. \n\nThe journey opens with a sparse composition suspended above a doorway \u2014 curves reduced to just a few line segments, angular and spindly. A transitional passage leads to a gallery of smaller works on pedestals. Then, the centerpiece: the Hydra Series \u2013 7x7: Complete Cycle, several stories tall, with ambient music synchronized to the movement of its focal node as it visits each point in the grid exactly once over nearly 13 minutes.\n\nThe final room presents an alternative version of the Complete Cycle that changes the mood completely \u2014 reduced point count, shifted palette, different sound. The same algorithm in a distorted permutation.\n\nFuture iterations will explore AR, bringing the Hydra Series into physical spaces alongside its projected and screen-based counterparts.\n\nBest experienced with headphones.", "short_description": "Project Hydra: Iterations is an immersive VR art experience from the creator of CONNECTOME. Walk through a sequence of interconnected rooms, each presenting a different expression of the Hydra algorithm \u2014 a generative system of B\u00e9zier curves drawn across grid-based layouts. From spindly, reduced-point compositions to a towering, multi-story Complete Cycle set to undulating ambient music, and finally, into an alternative version of the Complete Cycle that changes the mood completely."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.parietallab.com/privacy-policy/project-hydra-iterations/", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.granthinkson.com/art/project-hydra/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26371440292523468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821919_1446818146927965_3946596912634616934_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whwFd_KqR8UQ7kNvwHkpWVL&_nc_oc=Adox_sIXQEVIRLWfpKacSJyxPHLnPnXSqhzSlewVO2LsNs21zASl6j7CJsYq_nOpOA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOKGraGJ2Qgi6PA2QkT_jKjr6sUv_1E90tVK_8Ka8XwA&oe=6A997310"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Hydra: Iterations", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1781617080, "lastRevision": {"nodes": [{"id": "26371440362523461", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26371440209190143", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1620409462497308"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CONNECTOME_cover-portrait-1008x1440.png", "id": "35213910721557601", "image_type": "A
tooQ7kNvwFubESD&_nc_oc=AdoLdG6Zt3BNKKKMIuzfZeL_8sLlBlZPwTK8jPHYFdcq0NPwwyhL15dUC8x3daByLuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p1SuqErgjJpVmQlN8mO6k4vK98niC31VDK5_CL2jdLQ&oe=69D64095"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER7JlOoJXxIQ7kNvwHoz2hA&_nc_oc=AdpvrEwVaoQ51qZReMeZgOrLD7vThSmdTSdmytMAfXy32ghZWkJ42ay2G3QKDAjzuRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HkvQCC3kh5FuyRc30SwupY6INfrJBXWooE089CDKZ5A&oe=69D64303"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo9JQyThFQMQ7kNvwFB-Kbe&_nc_oc=AdpbqOsf68fE-6j5l21kSBN86GRH-d9xrzi1zUidipqTQwZlGziyY5xd5pzd__yCPO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25bBVbylyzW49yFu8vGQFVngbacr3ftxWzlHiSCSHZ9w&oe=69D6431E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBEPcdj7b7kQ7kNvwEk0flF&_nc_oc=AdotB_Ri2c3oFRX-tQFWCAYQh7TK7ScblvWFmlsrriMoWu4iAxFyjhLCkB7Mfn0gc9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HGJTBiGVkvb5FjKQK8XNNi3mM3-tzEHDteR-KwyorOA&oe=69D6352D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPIIiTjlXdEQ7kNvwHNvGpJ&_nc_oc=AdqSCGxatCrNz3MyBmVO-6NxKaJ5E9_HaMoO3dd9uDQ0S1JD3csDtGgQEJxeUM1h-qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KP4UZ5i8XjOc1HWR5eIcNjU6ACuAgoH8LOloe5nXolQ&oe=69D655BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIE6Ihst54sQ7kNvwHxwspW&_nc_oc=AdruKzydiUeWYw_4UVAIdKDBeqoUOOpKHrPdPy0wognDHhooDXLtkQY7ldvG3SkjSmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CKjIdR8M2IIf-A8hyIdWPDK5XqO5cl6jZEmI7zlHUSA&oe=69D64959"}, {"file_name": "Cover_mini_jp.png", "id": "193
GNMQ7kNvwFxJhXD&_nc_oc=AdrMNVkMuAFQpmXXRtMQ789kx6bj7x97GuLSVtdcCmvJi9yW1DvK9UnfvLmllA6uwVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5TTmFDAs8sftkzGDpJZ8IMrbvX5uf5JRFShmuhzQDRg&oe=6A47D9D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoPgWXAC554Q7kNvwF96eXq&_nc_oc=AdrIuBZn8xuhupFHNQKavlMTybOdtORb7lzjnDWgNFEtpbRacnkvqs0bwDab_WW8KGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6MduxE-COIX_Z9R53g_eeMxkj57WXAFHC66QjBymHbA&oe=6A47DC43"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC9ob97GCRUQ7kNvwHY8Mpd&_nc_oc=AdpS5UP33Gcf_lhLOy9oKuQROVtVYpi-EF03q9AOcSUhQSXAOQXcNzpQfIq6ybGyEkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_85LoJ8twkX43k6cYp012pB0PKdUGjRf-ovwwQpohwAA&oe=6A47DC5E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OMnZw4rD_kQ7kNvwEO6u8E&_nc_oc=AdqF34Eu8mwNG1DD6WZ6PHd2rRi0GOwTBdZ_3vHlrSa5RpYjc_CNtfu-rOuCzXBl_xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ssl51RAHxF4KDp22pzCO810YXVqnqafAqawz4QDfgFA&oe=6A47CE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n29Owc6t9sAQ7kNvwEIgKYq&_nc_oc=AdrOgt1RHPTNOQ5Mv8SHzppxUv8_BLizB-_aflKu4CITzMhIwdKPlFH6IOWyG0XuUCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5mgIQT59ye9_nNwwvpO_giZrJqVKxQSRsBiwxHLRcjw&oe=6A47B6BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFdPpjA8wOAQ7kNvwFTKOs0&_nc_oc=Adqw_mDRMS6CdiXG5aglOQz6Afz4p5hF6pgRVOPfFxHDNim_mZRzEixkjr6NHbhfg-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yRHMPpM5S_gr3fMLcf0jw8zfcgIGHaDzw55JfH4VUSw&oe=6A47AA59"}, {"file_name": "Cover_mini_jp.png", "id": "193
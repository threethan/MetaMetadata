nMAQ7kNvwE2RMkK&_nc_oc=Adogl6YeubYqdqDMK4aNYBfWm0kIriiZIJ0tnkJdhthAi91wRr1kGKekw2dZYi3C_W0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76WwySoXr4mp8ax1CyibW5r609fjTmzy6B72v5t6Dzzw&oe=6A19B555"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8zxyfcGRIQ7kNvwGpPrA7&_nc_oc=AdqEWVKkaDnHV1XHF3Prqbomqnv8MgTOQg7gzT0TAFLvc1W9RssZQjjmuThEvc3oPIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JkXUAoDjktodQaeYx7sNuyFZYSe_giT54eGZRzBcTQQ&oe=6A19B7C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwxYyndNeTUQ7kNvwH03H6q&_nc_oc=Adp1hl8xO6EuGm2MXFvwIhjbqDdxiUVopGLCYI_-Kwvve5Y-HQvGFIwgIn7CvygW1n4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jHohE4GpGyhN1htD6HCGi-Be9J0Ss2xh6eVCC2iXxrA&oe=6A19B7DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBe5aUMte_cQ7kNvwHokPzo&_nc_oc=Adr3sfHHkvemH4FXhnQlAuoYrpa74JmV6ytDx092p4AOaX4ivsOBEAg0-vilYd5Jnf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xGJvW2v3HNMNrUhTdsDUhKhOBmNOra-8zQU-YcBg8Xg&oe=6A19A9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h4gJ62hXvUQ7kNvwEHpbzh&_nc_oc=AdpnxUlwyjr1D3Oe5QhkvHShZ9wdtZgFrF9tRtnaMzqK1_FAwLRpL_yR3KMTUqn5jEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k8WS1WdYRUsA_3fcI68posbwTU_Im6BAsOq1Cv64fSA&oe=6A19923C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_cDRWd0iE0Q7kNvwENMi3I&_nc_oc=Ado5KpTdhBENZdAScdhKtqp1tBBaYJzUfw3R2WB9f6cMIvJ-XEMaFchmOUxQ3V6YvVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hn1TsCfWyhbSz45dVWkUvLNhVm2JqZ4PCmHthXfLGAw&oe=6A19BE19"}, {"file_name": "Cover_mini_jp.png", "id": "193
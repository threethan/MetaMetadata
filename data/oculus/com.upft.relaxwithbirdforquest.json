zNoQ7kNvwHzvw7B&_nc_oc=AdrFoIX8mQj8mtxFCYWP-E3roNibmiAbRnkYU5lfdQ4TPycGqoCa_cxtxbZUkjgM-bE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxsBydlsbn00GINUxG3Y5Iwal7AeEOi-ssdOJukvFNtA&oe=6ACA5E55"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpwfCnfLDwMQ7kNvwGBGSyb&_nc_oc=Adpv4WZQqYeDi0Ry0jmTMffTD68bdJoPC0k8UzIQXU4IdLAGqNAGEIc19R3rb1iE1T4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhSr6rTI-pLiJ8dlZAwLNpjKtCkHTbsM2kqrUU-9ZjuQ&oe=6ACA60C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xrbv3Z8Am4Q7kNvwFc3wvE&_nc_oc=AdpU_yxVwpEs1qTUuXJHQQ76Ee817VfF0ZUfLjlYKYQkpAnsAKsl8tfjzGtoNtmMKNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4_zri5cSr_vZtIy8qWc_BgrjTvPcl63gITE-qq8BkyA&oe=6ACA60DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fkrdD5cPZAQ7kNvwEGfQqK&_nc_oc=Adq7ZSDFdpwZ41z5GiLzyf2q839URXeM-06G_C7FPOZkU0VvQBo3T1wlPgWp5eMlLgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaFtxNzXQEiLKUvNVoyPQpnCngorUgKaaIOc5NqydOuA&oe=6ACA52ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jyuLYcHBsQ7kNvwFVhxUs&_nc_oc=AdrTyuz6lYbJlhsHWbY_8h1b2a38WukHrAtTo_O8dvjK-lNCaAcZhVn0tlzdiNa4Ay0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg8V923HXEQihch5CE6AH8ba8qFuYHiXuh25i9-P5t7A&oe=6ACA737C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iXT8VZejxwQ7kNvwF18CIx&_nc_oc=AdrMptO2Vgh08iaVuuYv36B9Kk4mGhEZWfzij8hdLhHutdOx81Ug1VOP8QO9V_hLK7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSawb7okIaGyiiI4cIlSlNbuzXXCLnPtXPa8-W241ipQ&oe=6ACA6719"}, {"file_name": "Cover_mini_jp.png", "id": "193
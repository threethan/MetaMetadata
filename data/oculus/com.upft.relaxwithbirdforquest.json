HmwQ7kNvwHgspsO&_nc_oc=AdquMofbqam-wOZnztHh-ZffeFCgVyA86s5Q37SVSxDwW3F7kDb59wIT-M_SDLa_jtE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IPJ_-0iDzvUQDL_Yhfe7VohdAWGiMW1r387bDw0zD5w&oe=6A244155"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ca_BZ7uBJYQ7kNvwFX16ux&_nc_oc=AdqnyeIJP76_Iz_aMWZz4Yu2dskktUEChUQ5b0sEdvbRErOPQYDeKb2z0ZoiCoAFO6E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_caH33TskzXpdGSN77sC1pFk0j2anBM1YpBI23cdHCag&oe=6A2443C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kxkbnCn1HgQ7kNvwFk6VHN&_nc_oc=Adr_DWVxB5uo63iLWeA4rkNL21zKO1Tc-M7awkItmKoSGBaf55ti57kzVoItQpmWTig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WeevfsgmFETuL759HFDBGb6ZJetC108zDbPA6GoDILg&oe=6A2443DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwB1OxTuRXIQ7kNvwEX89Vv&_nc_oc=AdouaMK27Cbz5WKkpHHJkx3AQc0NBDmgAffTwGXjsCCeGIJ_6Vx8ZWSw9Ccqr1IyQJs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2aqdDKrZ1DqMZ3bOT6Rhl541mIXiAvkj4kJ4t9fZrEw&oe=6A2435ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt18fAle9c8Q7kNvwEk5Kh5&_nc_oc=AdqmitK31-WN4hug9U7irwRhouwg_z5iNwRq6CMNx8C1paMw0sXPl1KiwRrfM08c8G4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a1Cfb9p7OU_SovD6n-W099mj0HadmDBPAfp8kN0b-7w&oe=6A241E3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMJ2qNqdQFYQ7kNvwHjQdU_&_nc_oc=AdpcJ9G8gb0r2N58dE1-ir6PhYgE5EMuIQb2YKgC_9J4dSyvHrLFowBhroze6uYAfs4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qj8SXIrs_LnjuJ1m834Whg2rQr5nmBU5zdOc3GjYCXg&oe=6A244A19"}, {"file_name": "Cover_mini_jp.png", "id": "193
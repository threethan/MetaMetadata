_LJMHQN6ZCXqch4txvFe0TtJIGi5-yHqdhQ-cLyw&oe=69BBE295"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmzHxAhGBp0Q7kNvwFPcmco&_nc_oc=AdkFgagCfEH7daUAO_ZvYqSnw3EJQChH91bTnS1nhcjRmZzsMEFYXj9kAHKPTK4hhCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfKRFaQUHnYg7iG1Q81yDjRaT1Dm3O7yYLrz1VGArnFg&oe=69BBE503"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlo093PixJgQ7kNvwGtdqI8&_nc_oc=Adnw0cFHoubrD3Ej_lZPqmkua9HE0yqalLQhuTSI9Co84eq-bF6uRw_LEJlq_cWCqus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJ49x8C29XyipBZavJYfcAWpj2DHcNmG_33fgLvcNslA&oe=69BBE51E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgmCM3V0M08Q7kNvwHjHXrX&_nc_oc=AdksicdtN5grH0A-2fK-lJot4WkCHAbAY3D3g5d5165TrQ0Znxryg3Dv87vDNfeLQWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxYGygIlnNB--wNsZo_E9bmglbll3fRvICnw5ttFq7BQ&oe=69BC0F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykkjMiG9t-QQ7kNvwELdGH5&_nc_oc=AdnlulHzHLSsxJX2yVL8sMUZE8iFC1H6veNCUIsrzN_c3YmeSoiAXQSTKhTwdoAgsR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3njkFQ0YaAysuN_6zRaJG86tEs8pzcwuyRpgma5CU9Q&oe=69BBF7BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQd9eCzi5X8Q7kNvwGPo6WA&_nc_oc=AdmExerD79m4RRHbvOdKxykz0ac6r8DojYGAAPqfJblvoqro7Pt00en8Xj1_2DvPFqc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyypG5mg_MXfsv4ur2N9cKnbmliQayu7NZ2Qj8Zn-dVvw&oe=69BBEB59"}, {"file_name": "Cover_mini_jp.png", "id": "1938364633363580", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392056_1938364636696913_4598181808748442325_n.png?_nc_cat=104&
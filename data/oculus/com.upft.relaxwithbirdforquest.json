i_YQ7kNvwGUF-Sk&_nc_oc=Adol1lbevZ6SEKXXnZOKmeUCv7qz1hnh6CinyJNXji5Gvi38JACMlQg6YqjFIwpMRek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NILs5Z39MRgWnnx_SgF4fH4ktHOKO0i4Z-1-LN1nuhg&oe=69FA1155"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7eCZhjNeicQ7kNvwGg3A2X&_nc_oc=Ado3qvvQmnYGp5NnhyjpK--GV0lyPaXCbadqG3DuBQPZJuNVK6X_p1gOVjXMyjsq3-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FjZMdrqjQwztxAyxrnsSBlLe0P9RFeu71aUEu_ArR5Q&oe=69F9DB83"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlYzqtAcpsgQ7kNvwFDHIHy&_nc_oc=AdqyPw9jpGMQXpWiV3Di76uapO6897iLhAxLrrT4Hi_OP8ZCEC0JeAzh3mOCrfB4iOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pVGzir0E5pmcyuaSf-aHmBfJtqXzIE4DVBy_x6rA7rw&oe=69F9DB9E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkFZUcuCY4QQ7kNvwHiCW5P&_nc_oc=AdqZB9o8-Z0-R4Gc39pb94C5j6xtU0o4s5ZoXQlyHP-a0QHZP8I6JtHHbOUV3YCP5UY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ARMyvNinSvMfdmnU6xRMv7uyxmTwWxfs1oBdGf1UFKw&oe=69FA05ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUAzzkY5MCoQ7kNvwHlHBhG&_nc_oc=Adp1x7AlKa6OoynXZsb8MdsZImAlCUPb0mOJrx-_4mmu_Pa2XqfCG2PkQmOGmYzF6jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xKqnMxjzYVefMMu6o_HgLHAMuKNxbhOOQ21I9wq1DKg&oe=69F9EE3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3WudxaJwYQQ7kNvwE0JtbJ&_nc_oc=AdoI6xD_cqzH3YNX1cZGNj0l5AEd4zlG3mrutVmulS6CHheW_nXjBVTz7d5JkNfevWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hAXD2PG09Gok8xY1SHFwBOcx9miGcld_ioHgiqNHOdA&oe=69F9E1D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
vKoQ7kNvwEpqT-E&_nc_oc=AdpDqW_DVCRNgpV7qay3hYCmbExpw9SEyQyBCgfEDhNe9LBrswqFPfTRK5yW4UpA0rY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Va3CYbib48b1kHaiGc1KksDn2Irq9dwbkEgRx0090w&oe=6A577395"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZQ_t4gQs5EQ7kNvwF6gvh2&_nc_oc=AdrupnvJrc6-duiN9lh9ea-l8sguXa3zG1EDG_Bcr-SrIC_k1R87F6zbVBkNzr75C_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACyGWOSzy73gtvrUGFqt3aIWCy-kJyYELqbbEMOBM9-w&oe=6A577603"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-549bGdVt2wQ7kNvwFIQZIi&_nc_oc=Ado9xLHNXgEgPn1Tkljj93ah49ZNIcleKvW4gJqXPCraytl8rnqDFB9C9-at-ckE8Go&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKGdd8BpAGdk8EwZcqcQHgKcbufRnN0g9w3geibl2F8Q&oe=6A57761E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD8lz1KVR1AQ7kNvwGdx_EB&_nc_oc=AdpxnlZw5kVMP9rmqyCJrOvQg5aNmn-zUGhAUEgXWfEI6kzowSaPp1PW7oBYCzZNbMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVsF8y-S-9nvKkZHgpckCd1HIa0u_8flNNy0n_gWmIGw&oe=6A57A06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BqWhXK6p88Q7kNvwEE0t5d&_nc_oc=Adqax1GN4nEfR_fI6VFxJRFb9TBcxzUx6HNKVAKi3lWYNHjP_sjBJiiv_8JuroguLso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCbrMK-hPyoPv_vnMs830qTR1Td2FwVDuUsykMid7ChA&oe=6A5788BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0f0DPGY7kIQ7kNvwFw-6kI&_nc_oc=AdpHBYldcYtXv4YLYp1DGxSnm_wIuivojwlddBraSb10THwX3d7I0rgBxcEJgsZQCfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfNSbExK-02cvw0QL68_4_gDz4_zgrX49bGVQTVkq84Q&oe=6A577C59"}, {"file_name": "Cover_mini_jp.png", "id": "193
qPEQ7kNvwFI73-8&_nc_oc=Adp7cv6htGQR-kXeug8fWjTv-qsTsVdLpN4SroYN_NLZ7rhOUkze_Af9leBD0r1wO_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW0klrXfLfT-6Fa6c32oQ55toJ3LwFT-8YD8NDD-tw1Q&oe=6ABFD255"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgtidUSyze0Q7kNvwExJ2YW&_nc_oc=AdqJdInW9JvdL4rQj4ZHU13sR_WP_zQ71pBeHPzFtztweEB5phbcqttpCK6qp9c6b-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK_DbdAKQDbpoGKoexnpm2gRQEK8V-jvAGe0ozQ47m_Q&oe=6ABFD4C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI8clj_l0NEQ7kNvwGdJxlh&_nc_oc=AdrpeeI1Q9jf868Al8deCPMC1rgTIX7UVdRbZyuYt1VJpk6MYoeadWRC5efX0tZJMLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTVmoSti-Jf2vxD9AKMH3A7t9yShNvLD8YjOelgvw4YQ&oe=6ABFD4DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QguYEv9DMSsQ7kNvwGA6VGa&_nc_oc=Adqu1s4mJVc0jFsbD_cifNVtMPTTUv0Mcgu5jaFogypVnVwp276nBTM71HbrDwySk84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnF84uzGtuP025rrWdNyTAueEUrYRrG5d443_6_ZpVMw&oe=6ABFC6ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izW5fnYSVboQ7kNvwGZNx9a&_nc_oc=AdqIkgNmb_edNQATkWu03ai4zt2kEKbuGLNzA9948BGGalFvfRoInkm0OlfIULbHIKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYd5EOxd7XMkLqduEGLxT4-oSuYaLkBUVOzkfMhhP6Cg&oe=6ABFAF3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyyZxF7YFrYQ7kNvwFTbQAM&_nc_oc=AdqUp47NNVPpasWOPBErHhzgyc8DKtRUpHu9gw43j0DdLVnA40lcVEsxFBQC9z0rSeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfSaldShhG0OfzXVj3Ovr_7l_MS3sTzzI0X36MAHM5qA&oe=6ABFDB19"}, {"file_name": "Cover_mini_jp.png", "id": "193
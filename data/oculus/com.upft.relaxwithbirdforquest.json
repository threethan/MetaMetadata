nMAQ7kNvwFV4JR0&_nc_oc=Adp72Cz0l8DLrYcs9VZTSJhjd0blK1hJ1HU9eNhbcrd18lll6pQa4GlpWe9Uo7M9h94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aorBM0ib3CSo1PALAFXSEPiG46d4oBenH3czmDD87qA&oe=6A171255"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8zxyfcGRIQ7kNvwG0OcYX&_nc_oc=AdrdCydjLgoyklkHmVJVr7CdzCQ7nE-XAWttLigEda10X4OdLjQW1jCuo-OrSWKs58Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zWAG5ETJmod0XU6U2neWKO8AnJRAJWuYtz_u9_x2nsQ&oe=6A1714C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwxYyndNeTUQ7kNvwHoJVOi&_nc_oc=AdrxSXeCmcqxmg-Y52kOwqa_YXHk2IziUqaUro5nnSk334nk7d0VqWY5i2XZssEjxiY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bVC-CrZRHYzGrtnKn_i0CHJA52WNXRIS1qxubh6JU7w&oe=6A1714DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JmawaROn3QQ7kNvwHcUDW-&_nc_oc=Adq16OlJabeaVVohotSp79WnlXdwzNARqEwiROyfzmvqNhzsgiku_4OwMKfB-989GGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h-tATLRJYgUGK-Rd1SHabVfRdh-CW7tjroioAg85IGw&oe=6A1706ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI8jLFhpULkQ7kNvwH3P4bW&_nc_oc=AdrbZMkDGkjTa1cv0oELKABFpgwLcSXapEWgJWno7gMYn7RK6TyXdjvDAy0zg_VHZ1E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gBuHyScbccQqwnSSuHBNH5NZ9-7z45V0C9M-F5ZARhA&oe=6A16EF3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydqhXGIfC18Q7kNvwFpn648&_nc_oc=AdpwMNPJsL9H2CXdDP7in8CSQQSl7Pwn0tZPWT0pDkHzvsMlm8m-XngTLQlWO6GP4mA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bdTAyz-oN5bbbOl3vhZ7g-pw5vk2qxS2U4QilhA0zHg&oe=6A16E2D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
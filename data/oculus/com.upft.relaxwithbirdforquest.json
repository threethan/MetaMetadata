uHoQ7kNvwHbppG-&_nc_oc=Ado4dV6DmueTjyR0Rke6uAc5l_Iv3bI9BX9p95SZnXkrxL9mRah7ZDxk32ER0Oe-faY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4dHT9PLrA0dwwauikoGKrQTui2tJbR4Iz7E1k6OIkog&oe=6A5F5C95"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6rD2HlR_BwQ7kNvwHl2DlS&_nc_oc=AdpuvfjDlQjPd-pu1RQG62XQ4UaljdepN-aLqlTrAmymyw93pKgpnmBXGE7EfZle_78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_RvdLnSso44q9Mf9weRRJV2pwXCgB9IVhHldIlThkyQ&oe=6A5F5F03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsdvkqzYOwMQ7kNvwG7okKW&_nc_oc=AdpsvVXlwVNBMcb_3_d9b8SC0m-88zRytUSiw5tPakSMFkSLSgCEki_j-Pon-MgGG48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJdbvWaWsvhnRtHAVboLWcdivae2y_wOIs0MvhrTICTA&oe=6A5F5F1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gilqw17QBQQ7kNvwEg6wXT&_nc_oc=AdquM3Kcfz_j37So1RXRnxr4J83i9Biq-0W9U0dAX1gaXe0uc2erUqCTQOzTxcle2rI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5-3aeA_w24R6igO679gci1vI5sY0Bz3bHYjN2psCDzA&oe=6A5F512D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Avekyk9UaqcQ7kNvwF8M4zV&_nc_oc=AdpS5KOhy8wmlaoqgXhwDoDm-4Bg62JrdtZPLoMI2AJsXLt8auNtpcOxYDRhUZOZ8Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5JNq-F91QkLQ2B-9-AYc0ElA0duVXvEY2cdCHqUuv1g&oe=6A5F71BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9S1T-bqz0gQ7kNvwFDBDgT&_nc_oc=AdqOt4Ag4o9JIsoEZ7lgKr5iQyjOa3V4otx1PBtsxXDRccs1nujDCmnuxHc4EP8kygk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbx--SkPaF62AHfCAKyrGW-h_2AIHMZ74C14Poq-kTDw&oe=6A5F6559"}, {"file_name": "Cover_mini_jp.png", "id": "193
nMAQ7kNvwGipcM7&_nc_oc=AdqWCJZQ3w8sQEkGgpuNaSD88IZAVO8JhBoKihJFuMv67t2y2VtGnvqlOzgd3FQVVyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kMzzPi65yOHcjaj5mDQ3IsqJ3We2DQ96O3XqK-W8dNg&oe=6A1863D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8zxyfcGRIQ7kNvwFHWqjo&_nc_oc=AdqNzT4ClQGzYGBXtdfTamlcAP6X7qeQZXBfStLnBiAt3DGw6OpuXE8I4Eq384WTnNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PhMt8KDrJY4CiCEe4siIgf4bYqOfJ0SYqaKcNq7Iwzw&oe=6A186643"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwxYyndNeTUQ7kNvwFjW_mk&_nc_oc=AdouqZptG5UZXv-JkjIgXBPaFFo6iuufqFFDc6LZrygapSKsiO3prxt4W58E6KXA5QY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YdKepNKWFp3bBCPgKlX-gcb_J2C5hr1XNiobPfJY3DA&oe=6A18665E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JmawaROn3QQ7kNvwGkWZJ_&_nc_oc=AdphVU-tWtcKOpzpt-8T4-LbEwPhAGYzO1sqWrkGwQEv_28xeAjhsUK7qe2tSrxekWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fcoB19GeDYHAhKb9r5AqqUxNz63C3r6wQWJrisDhexA&oe=6A18586D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h4gJ62hXvUQ7kNvwHF-ThR&_nc_oc=Adpfcfb0WohXaZOh_ouY--BgvWAXLua_LATBKMGgy-e93Bu1g5iJ24VQVHX6niFvULw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cb7HympEmHuKewV0rF0tI6b9_g834SjwmVB7eQURH5A&oe=6A1840BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_cDRWd0iE0Q7kNvwETJx9Y&_nc_oc=AdqjkiiU3_EvZw-lyEEJq8drn-YYgBMW3royxEwgsjN5_a-l2ZGu7wATDdKmkxU3PhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bTTeTi750s0ZrEaCYhAGaD4WLE8auVKamXuB3ks9BZg&oe=6A183459"}, {"file_name": "Cover_mini_jp.png", "id": "193
u-EQ7kNvwErH4tb&_nc_oc=Ado7zFyFzVpVjnpyJEzOvjsJdzyVlj2NHccwfhHhHvyGPkL55NWfQ1YnGNgXNmBj-eo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNSHwpYA46BU2JvlxkBCwQWbqBjuA9_hichw9CMjXMYw&oe=6A81A395"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhcldEs1seAQ7kNvwGsb7vj&_nc_oc=AdraAHIssL50KbTB7_L-jd3oV6wEguVXXizs-WIqK_4Fp3KPqDnKiP2nUYoC7kyQhRU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW-nkM7krWqqzIUNn8kv0TizwW-JzxVpv5eRNYPJTO5w&oe=6A81A603"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNA2Dtv_dZYQ7kNvwFERhMd&_nc_oc=Adq6efRCbV-nrhjLNtfIfFt6UFV5Nn7qkxZgFpmnRFK9RZRTNVxzwOYgSiL9o27Js44&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlyXIVWpyU1Mg2_mBDgJI3eTsEggZp4iap_ZCeGXESEg&oe=6A81A61E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWcS8BQWrDkQ7kNvwGVVvqx&_nc_oc=Adq01o4G9dNiJo9OFuLs02qzMARX5gRt0LasDLg12pLqHo4ZMwykyctr9cUp_0YpbLI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_3erEIxf3rbAMo-jup4jOpAjxbCfaTW8Yy6kapdKM_g&oe=6A81982D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3P1tmWBkSQQ7kNvwG7bzqC&_nc_oc=AdrQR2bHRY_WSIiJCPUE54o2A-z6_li0IWjTvmBAcuFSHQg0txOI05fJO1tX_9PjAio&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr-wtiWzW9UT6TxUyhErZ3ugdplbdIEuOKupwQ2EIwQw&oe=6A81B8BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLGyIVXiZxYQ7kNvwGehCrt&_nc_oc=AdqKmCLpoivjxREGIZ_4Zjn-FjrrO9j17Wlj9JbiN2Ee7_t7H23dsz95KlaUnJo8I8c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtU3y2Hdv9JT6N4S6MTZVbHW9tlEKy9LlFfobtKJMW7w&oe=6A81AC59"}, {"file_name": "Cover_mini_jp.png", "id": "193
fX8Q7kNvwGur6SN&_nc_oc=AdrrAy6eljO752m8tG1rYn5vIqqsDGStyw1pvkOKEWaVsymd8pKhyZAmjycgCfE25Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTlgM83xI__VNyKy2HFop0-NtK8DU18nzOf85kjdLrLw&oe=6AAC0BD5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RODzppT91xQQ7kNvwH8vavP&_nc_oc=AdpbexGkcs8qWAMYldnepL8WehMuOZmN6mq6cBEjEuDWI6peEjOCtbrXxr8BZmjGxcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlSXjPf18abSMwhb1bZqDMvKilHf_eD4F9fGVzS2etGw&oe=6AAC0E43"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn266qzIHhcQ7kNvwHQ94kl&_nc_oc=Adpqp7KMUzoZSCE2Z8Y1_IcB5Dz4EBAvECvexNPMlhOhrQxxhcAQQoun__ozf0r0Y3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ6Z52fFobr2ZPzyKXbBLZHwLPrbVhBSJiSUc2F6M4bA&oe=6AAC0E5E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swJeBpw9wC8Q7kNvwHv7CM-&_nc_oc=AdpJ0f9Yo7Lkv8yco5MkZWYOVxx10vNuGuR7elM0Pw58sj_PmGmoHQjQZMGAFrpnnZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQPkF4Ck7yCHpqiYlnBma5peiM3iUS2YEGGZiLHESwaA&oe=6AAC006D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMwzFzmBOagQ7kNvwFrDYJy&_nc_oc=AdqXs5uSR3dwnD4npyuQFhHenR2bEeDY1b8iMKRwCp3qM7tamuiz5olzkekyC0ylnoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF7V9qgnJXZLZtaREGYLvl38EnxDZT2MZKRWKf838ptQ&oe=6AABE8BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y38hHSrCNzgQ7kNvwGY_8Og&_nc_oc=Adr6GluEn59xO5KLYMrPByCW94uRmnTixjXWIYhNqAySRoNQrERDyvwVTb9SY30meeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfZc4mksFdrTdanF5T8Q7jBZ9-uenTe_XJZ3GJh94Saw&oe=6AABDC59"}, {"file_name": "Cover_mini_jp.png", "id": "193
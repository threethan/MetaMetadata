cTMQ7kNvwEmx1mZ&_nc_oc=Adot7wvfzM0sY_MRBPLt-o7C1HaKMTh2w8G2arPJLKivl6ZiwKDcBOsF4Q7j33HDHS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61pLhxN4c6nLBejChSaXVsbCIeKlVPC7fVep_TbghcxQ&oe=6A146F55"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvRadF7ceNkQ7kNvwHZ6Rwu&_nc_oc=AdpWIAErZKw19Xqp18T886v9qphcfSlw72IsGmmHWTxbNiIQitByekcs5J9386-nnQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bniTWds6FpthIkYM8YNgTzm2ByqwRjgFv1Bju-kuqTw&oe=6A1471C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L88pSgsmFzUQ7kNvwGgFxde&_nc_oc=AdqV9l4nqRtkoKNa1dh7f_gHB_f6vZgcof5EikV5mG7yhEutBSxVlfpcynfCBaKomZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73YkkpNmHS1SOh2jen95aKHKrtalV6wYNIPD5Kx5WA-A&oe=6A1471DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i523-lTu-4Q7kNvwFffB5i&_nc_oc=Adrt7QupsYW9gm7UjtSFNU88GfJieeeYktbQGzDe2gl1W5CZkt1x9Hj6VH2p9VkPWEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b4MARvhMKtusm8jpNOWotvBkV9u-PrqtXsc67muMulQ&oe=6A1463ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI8jLFhpULkQ7kNvwETnv73&_nc_oc=AdoaoHZBOyaZlN8oO6pUSMCFEQm7mWnTPKyRDykSm7XjiW_m1y7-3lXd9HpUKEkJ9Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eymYqqdsddkh9dJNuM9WDy0g6jg41BtR_PTO0nMKBbQ&oe=6A144C3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydqhXGIfC18Q7kNvwEFMgyZ&_nc_oc=Adpg7kja0L1Gtj0RGMuGTqYaLl7k6atOuBIkK54ex6FEsALlnkezqCIwYVYNQekEcSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TPgyvCJi--OGGqBFAqlb5VeGF1h6mQkPhAT-nniHwXA&oe=6A147819"}, {"file_name": "Cover_mini_jp.png", "id": "193
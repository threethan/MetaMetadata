-V8Q7kNvwHyDqVx&_nc_oc=Adq1LmmGFheaB-3oUblZW-8Ufm8FxANKfL8gViP-EqDlPE9LV6e27nb_qqxJqx5lrQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TfC-zD5ytu1UZ4NAc9dfMy9NmzdtIKePuxCJT5IiADw&oe=69FCB455"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PQJnRdxQFkQ7kNvwFCZC3C&_nc_oc=AdrTzJm0rR_I7n10gYZvKmpGa6XSkETu24NPn-Z1YkMxwnVUs4Ez4gM1tSIUodtsLHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MBuIciHwcM6M57k1ygiWaGhhZXFHJxR4qz6vrDr2ohQ&oe=69FC7E83"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQlppVrN9h8Q7kNvwGNff21&_nc_oc=AdpYko3Xc4vhBv6f7pUTrmvVfcqcVd0dA_MTePSJi1OpOraWl0T4W0DBCFy3rrtcmhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CEAWpNUxzjQvYqbvOlLx_h0gUVuQVTpSBIl2m-7_Xew&oe=69FC7E9E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkFZUcuCY4QQ7kNvwEr2Uyi&_nc_oc=AdpgCHQSwvYQ8g9K4AHE8blv8aCGW_fosxP4gvTFYE-OMOpG6fsDqorLEEr4ZOr_UuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WVGcfs1XMymnjVSSuzCX5YdjqdNAa7_aU5vzFuA4h6g&oe=69FCA8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmBR6h_SjowQ7kNvwHf1G2C&_nc_oc=AdpdomapWJuRnvyoe7BRtiuGq0FCQUrLXWLduXtQOS3lphzdc0ehF4v7vD37kLide20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kr2oKtbzBBbQawUuO5s8vXCnnABeKzGCgcJeHbuk3JQ&oe=69FC913C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HfltaRMx8cQ7kNvwHXwFaS&_nc_oc=Adpqsms34JQi_Uskg-dJPLYLS1gg90WewBOtuyYSyvyFbIl0e5BH_CNRZb_tDjJHk3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WhMSQXtxotdYFJ-EAZFBHeiohmU6nHIG5kMx0dm6mLw&oe=69FC84D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
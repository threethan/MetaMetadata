UjsQ7kNvwGwQKB0&_nc_oc=AdqORUXTYtxEFhF2WWlGKOr_6NWwZ2ihcg5Vf8Q6umTol5jpZZ4U1KX_KwcVlbG85rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxwcjDIBgrgYMLOV31jxcBA_kF4hho3drpmtXm3IEGMw&oe=6A635115"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ylSfH5wygoQ7kNvwFMcpCl&_nc_oc=AdodettrJmmGHw4oy2GZ_WVF2eTMOxHnMQyZim8BvYnK_zJZ8PqqM7SJrGWQBorSAyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuYp0dNSgqUGjU2_Oi7UFlM470iruJmH90wRQVeZ-z4A&oe=6A635383"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UNvyVQjEBsQ7kNvwFuOmQz&_nc_oc=AdonnBbeKTnEf7xjw_cMPKKzmfgD_9DuzZmicbaP6lSZnh5HLBBeBe4YkBunUVSDfm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkcVJmA46P8_6jcqaReXtf2z_ucWpCgY87I-6yNlX4pw&oe=6A63539E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAoM8xCkSfwQ7kNvwFb1viM&_nc_oc=Adr8Ooiv-Xe2MkrDKhlboZZjTsjNe7eIRADysKjFm8M68bvbBFnpsDRfGPnMkZXJq5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA46tvYCSatpbaaDJHl3WivKFuKl_x55m3QCMLHDXPBfA&oe=6A637DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw6dh4rZfNQQ7kNvwEf1Vjq&_nc_oc=AdqHAwBdkTvw5qJ_kXVKrknm-AotKiZE3o7DHq6_d1-LjswzeiDq4SF6u2k9Gjv2dWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfxRi4_Od_YsMEZslgoOxTFJp0b9lsRC9H_VJXTdM7dw&oe=6A63663C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxlwajcaPxYQ7kNvwEoeflS&_nc_oc=AdrySQ_-3Oi5E_HLcuNLFazpwSSTr0mNJX-iPsXLfcyw1fjH-6HFOZdGDVZtWl6dUuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9s8k7mcMkLA9gVWZJS-fPXpJEEmikxpQZQCeOXcZIfQ&oe=6A6359D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
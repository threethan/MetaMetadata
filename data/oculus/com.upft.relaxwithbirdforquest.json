tooQ7kNvwFF2Myu&_nc_oc=Adot0WtU8ntMLUOWEJRvls2Ur4WauDYLpluPMmPThz1HJ8tbwDRiZjy_2waOvyCX07s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11Lt7weZa7M0grR1EDEUxYsz7RqhsWk12LiXvIn3YZEA&oe=69D39D95"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER7JlOoJXxIQ7kNvwGr9liX&_nc_oc=Adry-BrCAB8dULP-jz8mATzyGNO6pou2CvkuBkO093FgzyQxurRPWQdWi5fc8VAkG1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25yC_8xjFnB0o8tmK8fXLy0lXWZj3EeHjyt4nUMxARWw&oe=69D3A003"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo9JQyThFQMQ7kNvwHDc_ni&_nc_oc=AdolkJ0s4h8aVYibG3HuqaVXq6g7Hvz8WIyIYsi0E8J9mMCCn0ooqsSdhiQSg2LHNLI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pc3HzT0zm-tc6-evgiH4m8OACMz2qDfQYe37wtLf6Hw&oe=69D3A01E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBEPcdj7b7kQ7kNvwHXp-kr&_nc_oc=Adq7mRMKfPkY3KFvsIdbc2DJRz89HdbpXVWFz6v-Kl6jsEK9ZHLd5T_AndnDpsNRFhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hWc4-UTrwtyRPWTd2W11BBKfeGxmJjgOlhn2fvDNs1w&oe=69D3922D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur2YDlrK5FIQ7kNvwFXEC8m&_nc_oc=AdoCD84SgPLbLpaHTQRuBhkv5Y4fgJTO7QS8pzW4EeO9KykVAxh78DYS8sHv86Z_J2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WxvojSKRgO7DGnuBSvOM_0HCXA1axcHvEZ75a-WIkAg&oe=69D3B2BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN-HWVo3s40Q7kNvwGlM4us&_nc_oc=AdrW_bDlPlFUt5OAz07gsDjLWQzpCRT4RsaxmeWj3P_6baTRHzwLCx8pl-CbaOjzzJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BivWyK9DH-ChKbMjPeWcutTvPbf-N6-wmyxIbdwyo0Q&oe=69D3A659"}, {"file_name": "Cover_mini_jp.png", "id": "193
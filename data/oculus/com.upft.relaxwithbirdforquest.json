tooQ7kNvwET-1xN&_nc_oc=Adoje40dkRbND_x6oYpXxhETNwle6vSfat1y81dJFcr1F2kAD0udLH0wWycWNDsUkHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nfFZojNHhXbg-wq8CnlTSpS7nqIkDuS67VnnC3V9xlw&oe=69D4EF15"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER7JlOoJXxIQ7kNvwGRrXTH&_nc_oc=Adr4TBNvk3DZNXE3ArxpIsMtKE3bmFgRa0gXBzGs5vpl3zTruC9B8Ye3DSMtHvTLeuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JxtQWyeGVBHoEUCwtqwHakR9qO_VGFVqo5r_3qBfYVw&oe=69D4F183"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo9JQyThFQMQ7kNvwFROItN&_nc_oc=AdqBLXMhUtmFMqcnKiyQAILiAxpynLw_na5WGmFdvvAvkmBMQTQ9_QAlOgLB3gOu9ys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zyfI2kCJ0pbuSGCRW3CPkZycAcYh894mFGNyjITcurA&oe=69D4F19E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBEPcdj7b7kQ7kNvwHxxj0G&_nc_oc=AdrcUhnaKlvG5Gfb-HagbULk3l0FeGvo9Tgajx343Woz3QKpe5-K6cLiettTEvFL0jY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xkV2qJn9GSleHqC0vJ4qgbPoC5hgfNyAkBr-KxSSCzA&oe=69D4E3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPIIiTjlXdEQ7kNvwGI6anV&_nc_oc=AdoMN6JGrHc87wl8A2j9C42L2gJb1AROGRhPllCo4ejEsp0x8lpQaTF_JKlPiT2eE4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h45J4Ab_71OTIPckwk1RaUh5RMN3BEuKkBpT63ddJeA&oe=69D5043C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIE6Ihst54sQ7kNvwFOmv1j&_nc_oc=AdpwjOxvO-HFohlATmdoMGuIxl05HsRUSVBHADR11plWD-p4plI-e5w2Ys7Cd4DrkHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14Xi7nfMpDX-OAIrGog7o4PlLBo_WCt7cH0Mq5b4OtCA&oe=69D4F7D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
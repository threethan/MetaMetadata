ULgQ7kNvwGpF9ds&_nc_oc=Adrast0v46Bcy3ioS3-kBjUHwppGU3sYfvGSWs8HEvlojak-T3cGql8If_zkBzlthuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS96md7VBTljttjhHnRx86HQRQALwQ2IpO9NSsMhTzGuA&oe=6AE75F55"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7mPnnHzhsYQ7kNvwH86OPQ&_nc_oc=Adr6UKTfwtfDtqBiTYG7z8S3OXyHguH3B90ySKucMP06YTJUUoNTXQr11FaLXh5azuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ22waxBPIU8sDLpQiiAojtloTMaIG59zA3KWp_JppvhQ&oe=6AE761C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaWh-UkiOJAQ7kNvwFI1Twi&_nc_oc=Adq1d29QVIROSp7gIJyMdO8vpkU0hUIohjXq_c2U8LLsMwyvJa4AjCZrPVzOQYObH2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMHYMCgcmMsAIMEFTOJ5aYqu4AtRblMcb5OzEhvh1CJg&oe=6AE761DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAwW4W7JPu0Q7kNvwF4JkCp&_nc_oc=AdraOeL96cpXYjWN8VEhcIPsRPeGhefmnpr15JFMI4LDY3fTzoehQfuY0cV7dTyNmys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT80K-HyYxtSVTZkb6M8jtjexrxAAUYmv460cD4cl9OvA&oe=6AE753ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLnBIWoRJykQ7kNvwFVv_DR&_nc_oc=AdqvcKXAU7-aZ2k4fUDyE5Zc2A54vWfoYX93qfy34Sr8LbMXzpD0FfJm3edNkRl-lHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKgTQWC2Qar76Dgl8f8jOppfo1TH595namFidOqQ-oRQ&oe=6AE73C3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GS8vXuild-QQ7kNvwGhP0Rn&_nc_oc=Adoy0QgjPNM7BraQ1DBFTMv-HUolWUeUKBneX9Fn9EJAZBR8xvV1EJ9Nu-IFlFUh_Gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqnbclm84zPAf3h-cx4HNwCLwsrP8xmNb3p7YbnISaNA&oe=6AE76819"}, {"file_name": "Cover_mini_jp.png", "id": "193
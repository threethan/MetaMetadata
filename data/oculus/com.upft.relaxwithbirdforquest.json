-V8Q7kNvwGrwYw3&_nc_oc=AdrmFadlG-z9HKNeNAoef1814NhVeqV2EKT9aGsXOnEdpOK8_M3LmNwjJlciVVQvWgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RhJ71kzNnVZ1rXcEU1YE9TbfXwVVDbOjERJxwaxtC0A&oe=69FB2A95"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PQJnRdxQFkQ7kNvwG_Jebb&_nc_oc=AdoC1I43eBDQOjZX2m7R_vJQxOgFkeFsoZy2JJOW_jKxJLEEK1dpXl_XWQziO6uzTgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gkaIGvw6QKGPMbyin6RY8f1vtaYzWug4JgaNYVbij0Q&oe=69FB2D03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQlppVrN9h8Q7kNvwHBfS7z&_nc_oc=Adoq-TdQdXP9qbdCSepGfX73OlpHBA-AYvu-vQGzIoPV-mitZBicjKpasowYDenGuMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ce-SchiyhO_Ffo-m7hMd702ZBmZZHiJbrOP1C303UUA&oe=69FB2D1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkFZUcuCY4QQ7kNvwF20i9i&_nc_oc=AdoySUYv7UKu23sH9AoI50lkLc2EbJSiC_3H5aoaUGDb7DVtIaXC7H7EPNVLUE_a6JM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IvaNC9bZj7ur08gJPEiOrlilcnWV8nRFqYSheWMtegQ&oe=69FB576D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUAzzkY5MCoQ7kNvwEOQAek&_nc_oc=AdpNFBw-ZcE3wYzl1XAXMcBxAAjLs7YHH_N56DXc4xAKxbDoohJERLNK6opNZEOk2J4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pfd0u7DXRSCcIO4fsMTbGAR4KIpmFlP81WwSc-JPdyQ&oe=69FB3FBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3WudxaJwYQQ7kNvwE7wQgx&_nc_oc=AdrglCKV-lba40bbzPWLFMn4tcsQHyA9_BTC7K7aoCZUo4KPNMcXqPHsrgMVT7d74WA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PEKL8nCx1un-jKFoQI07ZwVNtFCJmzhWSAVOW2b42ug&oe=69FB3359"}, {"file_name": "Cover_mini_jp.png", "id": "193
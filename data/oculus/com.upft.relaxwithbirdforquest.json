k78Q7kNvwEDP-Ak&_nc_oc=AdrhHX7jiSnOctDwn5qpjJk3v4UMnCB2G8Z8u3DxyfvMOqKFQRCT48eLGG5mUiaDk5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w5JZIvjvVrigr0ogomv6mEctihOtcdhEwxEi8lvNhBg&oe=69DE2995"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEvPTP5F6S4Q7kNvwH6tRcT&_nc_oc=Adrpw4_KafuNVQceFAJZYvxU_HxXusmTy1boreQNysitrqy6rihDWQ-iKwLuwl-xvys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25mSDx01UkhGisfxydIgoYyYQhbnE5_aTVaPBO2Q3toQ&oe=69DE2C03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiVNoNlJeL0Q7kNvwFoh7ns&_nc_oc=Adp3cY8GsdLByBqjygc5WAOU9IUlSlMLtz2zQVkwsaNbdVVM9vcbuXOt-kkkCINGa6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Olsj-8R3-uuXFrsEu4xNW3dG1w-WgCi3H-SMk36DeMw&oe=69DE2C1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyx_8Ni5g5EQ7kNvwGUejdM&_nc_oc=AdpTSkgugCALCEloBtl2sYBD6GelaMQM9kVnY0oR8Ew82DHHIEsjdzOLmRzYuodeIHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GWeDloO5eNoYugZnDHfXNsLtly3es9cuT6snRdUbNwA&oe=69DE566D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB6pMbmUffsQ7kNvwHrbSz9&_nc_oc=AdrDQno2eNpRQJGa4dFvYSzawc7Yeh3b0klLA7o-pWZjFNc_WvcJKXyVydRU-QbBOOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zqTbPGcbm8AEawc-VjsoN_6Jm9w2qpBCHNLvavG3ecA&oe=69DE3EBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJs39wys_-oQ7kNvwGK1uGQ&_nc_oc=Ado14RbIe7A-FiUS_QGnlPApmPOvnTOiyuX_JLvtMQcX4cN4fAlZ89QKwuplWCDvTf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GbsnjP4p4naG-IUDYKrBvX1CZFqR8wuRMBaLYipM4Ig&oe=69DE3259"}, {"file_name": "Cover_mini_jp.png", "id": "193
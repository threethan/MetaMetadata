Y6YQ7kNvwF4ge1-&_nc_oc=AdquJLvkLCzShbYLGNPR7RH7-c_9Ub_yDYJX7O6nzvwt-TMDm3QJSEfgKXv8cd-BvY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqQdj2TJwJdkz57s-3Ad0KmGOPB8nLuu6MVc6u9UUGXw&oe=6A4FC2D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm1q35spPycQ7kNvwGBAEcJ&_nc_oc=AdpwkyH8-F4-1YfmVTooDcXfmo5-8oUB6rXW1FWxjN9coHs6TDH1dVNuQy6UaEL3TZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN0TL7blYPvspaZ-6jUvFpGWDq4XXgTd21bXlrT9Z4kQ&oe=6A4F8D03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FSG26b6c8sQ7kNvwGo4Z0X&_nc_oc=AdpN-hTMbO2gUi0DMvWj8TwmGvXEUhLwN1Voaz9ZI510PCSeOssOylhEf7xZqmACwE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1n64oCjmLi_EOZj3cn5lYov7ZQW6UZsgZZBG1T7XsAQ&oe=6A4F8D1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuMzEoVuyysQ7kNvwE3yvCG&_nc_oc=Adqm9AIov8JHgxomDtx6mflQ4URBVt6eokYo9lIQA_MpzeT9rMOvUaV_aGx-SYM45a4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVti82ysCiHrzN1qkXMI0kYKndZYw3Ln0PBgJ5K-IAxg&oe=6A4FB76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKUZwCoBjH0Q7kNvwFYRZRa&_nc_oc=Adr3pF48UVD5wsAL4gnmSV-YRZHyhfm7QSx5mG1Uz6YU2loGj1hUwQtHIwjOutkEpMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrI4X31zuCv_uxX9eBYYENJvqxaZesvbTm47QvMtBU1Q&oe=6A4F9FBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO2kOsfSY7AQ7kNvwEArqi_&_nc_oc=AdpVjkI3ktDCche5rzEAFJ7lcJJGyFM6p3AOX6_tBeYPRFHYVAIuM-DMJi2bhKG6gpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn0HpY0bG6h-RZ_eWgAbm4WMkDOg-U3aynn3YiXsJ_Ew&oe=6A4F9359"}, {"file_name": "Cover_mini_jp.png", "id": "193
HkgQ7kNvwGaGGrC&_nc_oc=AdoUr1XT95HVd80JIKX_0uI9vHUUqW9nLqsCFGJaxxb5sOt3pWAuz5sT_7-BsHzDVWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWHU2NsOLolihXBEcrhiuUZ1lMejzgw55inUWTTpB1dg&oe=6ACE52D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-yFE-__D40Q7kNvwEitS4f&_nc_oc=Adq-A8-tNYyb7a95OeE_fPQtFjW7JMwBtkjchzz78yjMm26vNjqtNb9wMgAUGZjKL0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoDVbo8Qz5xzbNMwP8MS1RdMYe8zdDk1c4iKBe4afXCg&oe=6ACE5543"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqwghleZ7uQQ7kNvwHzaxLx&_nc_oc=AdqiDaeXCsCkdw9YVJenVUSK3oTe-Fg-3FZqo3mlA56ewlNAQ2or2dmq014-6SsYJek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnsg7ga5c_mgojbNVRttpXGq6endu-op-bEgFTcCqkOA&oe=6ACE555E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJMGrHEsjhIQ7kNvwG93WWb&_nc_oc=Adrn98k2YgaburiXdc-rxxZYwRMzUl440IW4j-3zsCSTI4IUKpH6AyjfH2FsUezrwNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOECsD4a9U5Q7827yWV2rNEMCiEHT_-Yo7-EfZa0U_rKg&oe=6ACE476D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ4HicBAtHgQ7kNvwHGzyls&_nc_oc=AdoWr0LVKwHkpHtO5Tpl9Kch1Mng2aisGInRBZ6dHZ77iDGMs1Oa1HD_AHlIgfugZFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-7uvc_040OKsE9JydB1iEuFEurkkXgPHDUB55U1WgDA&oe=6ACE67FC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1oM71xuocsQ7kNvwGwRdbr&_nc_oc=Adpb7TM_xAyGT1Ou3h2_DkFpen4CZVqc-kiixjlEBXLk23ODBsE8wN989ri75vBcVCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW0Ptgw0ntj_AFG2M7vi9Qglf6qTghh5Wqyo24yEfEhQ&oe=6ACE5B99"}, {"file_name": "Cover_mini_jp.png", "id": "193
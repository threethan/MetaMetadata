x4EQ7kNvwFV9Uwk&_nc_oc=Adpyn6iRTuKE8CkuCNzecXR6I84B6KvXt2J2oRkbAlFB2fEYncm6y-4WvnC89ymtsoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NLDfLGOyxTKPNsOcahFprdZpeViyecJVH7kflpoQifA&oe=6A034BD5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcAy2swpo_sQ7kNvwFyj-6c&_nc_oc=Adp4AdLpYMQcCanYo0-yifKp9ptiyCHhxO4wLPSAMhsbbQBKKBumYSHp8XVhoxU_aVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gv25s7ZwT5G_CD6lVlBjfr05qPRLl4gJ2xqQMZEbxMQ&oe=6A031603"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRIvfdnjjZ8Q7kNvwGUT7Wf&_nc_oc=AdqKfn4WZ5fDtrIs5C5zwJ4oxhbDdgdMjyCJVed6Na4VZmS0LWe9RH8R9b--8VcJWh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WGeVVSjffhIvt7Ka0DXL-rdfKfTtOGcZJw1YpOmcrVw&oe=6A03161E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pbm0A73U8Q7kNvwEppX4y&_nc_oc=AdqjmigQnahneakZDaa2XlVGHKpxTFZh69NqQyC7Vey6b5OqioNO3jiJmPBAIZze2tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RY8KTCKGLNNMDpFCJR89SsvnY6a1Uq7khPmws8paykg&oe=6A03406D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_NUXT3ZwYEQ7kNvwGRdREh&_nc_oc=AdpKGg_iZgY_AYaG2M0dwo-AvSxajZEUEN3bB4UAGh977xalZijaEKzc7jyMliQ9eN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i8WLlLjeviXLBLkXHMHy0ITaWbSLOBUq2rXwCqmQh_A&oe=6A0328BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gctsbcs_dOgQ7kNvwEoSDch&_nc_oc=AdpZRB_71MkUXvPEoQpjIo9vpso8LT-a39_p8PRPT4OhtlqxOi0B0kOQ4G-hWEx0rsc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YqM5V5__SNQUMO2d4rSEdAH_8VeOCazaUraYsxva1Ig&oe=6A031C59"}, {"file_name": "Cover_mini_jp.png", "id": "193
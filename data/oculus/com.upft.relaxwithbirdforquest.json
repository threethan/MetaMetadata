A1kQ7kNvwEIYFQ4&_nc_oc=AdrPw7r5CiKpk9aWJ98HIXvztLy0bdbD1MMgKZ5wadSN7ghkiuoav4wCLDDxSIBcH1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZRCGdOMcSc_FhfymiV7g8Ij3VjEaVIkBEa6S1aCTI3A&oe=6A01C215"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UNZTNcPLf4Q7kNvwEvTDI6&_nc_oc=Adp9cJT-OyPSjbRN_9fGO1QFv40PcZPdvNOvW-BUWklGUf_nPD-CYsF4wV-eC15EE7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jn6zpyjZknq2UV0TdM01QGS57_eenN_uNXG07-QyUxQ&oe=6A01C483"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37ez_EeeXuQQ7kNvwHsNE82&_nc_oc=Ado3d2bVR9kprSY4V0uLTkOgkgtrkAC48mMBCsRK594ntWzSPfraS9QlTM9Sap3wh3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70ipSkiOLp4IICMTdDsbyOw27kgbqmqn6WaVkaSxuHTw&oe=6A01C49E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pbm0A73U8Q7kNvwF5FN7J&_nc_oc=Adr4R7XPmwkq-GsC1dNQqNPKHtF-9gxfNeoqgPjdqKXqdbyd3kzhB5IMhQ5YcpQc2gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lOwV-YoVrkj82wfJ_M6upJlZSFWVWRReC74p4cViswA&oe=6A01EEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_NUXT3ZwYEQ7kNvwGDkVQL&_nc_oc=Ado6A2KkaEIQS2Oi7OmD3-01890ybd4qVdHnwJaYqzBgfBFQ0UxxU-esnNd61dqcgaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IH3XuJyveZxpx-2jQofx-CNsiZtl35n-HrOBI6WFwqA&oe=6A01D73C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gctsbcs_dOgQ7kNvwFAjeoB&_nc_oc=AdqIhfOnvQbZrOh83_pZ1paUer98ixHLwbI63OskK0mdY8qIA2b7ZVejlHVDZfynrmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QS5rgQwoNMcrb2O1liKROMT3mJPS_kcVLUG2NiyMQKg&oe=6A01CAD9"}, {"file_name": "Cover_mini_jp.png", "id": "193
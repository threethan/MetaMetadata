ht=scontent-iad3-1.oculuscdn.com&oh=00_Af27htOGp7M0gP1MFjJRYehPaSYjzcY-W-WBNt8dJLH8fg&oe=69F09E95"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lj0wnc9O5YQ7kNvwHyNxwO&_nc_oc=AdreWx_vH2G5GJ9H0zO7tanD_ye5LhCSlnc21RZdwIMxBNZmg3T3sFi_dfrqpo2g1AE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2tSNyA1LWXOjTI3GDqWNt6GQ0lryJgIlv5ba7kydjxwQ&oe=69F0A103"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlzSXqHdDI4Q7kNvwGeg9MD&_nc_oc=AdqDfneHySs7iz7AupOTjeJzL3VCLjYu7JWThGSnAvdwvrILP4w3jyxkSh074hrKt10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af19OnNoHRXYYEq_qrMODa_4_vh-74EZV2uCjB349UPELg&oe=69F0A11E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-z8RHOH3H8Q7kNvwFtTCwX&_nc_oc=AdpqRavIuIwFigItC1CE86DGlMIp8R-qlEsaw-Eem-w0xlGxEk6lFFRbVVO6IsshhVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0kS8MLsaLMiFqMH-N4teTFe1se_XWDH71DqMCu-ivgZg&oe=69F0CB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZOWEPtedN0Q7kNvwE-HfbG&_nc_oc=AdqWasB8TV2NyWn89xarHGN3IzqHOnAeIFB4VSKOft8TDFzuGsoc0Xcf__-qGbrOSLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1fQkVO4ajbp3wRxDsBceP1mofVT2drlEa69-XAMCjz4w&oe=69F0B3BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62UsUvK0C0QQ7kNvwGtiERj&_nc_oc=AdpUNScTcik4MxPNpdyfXLNqiRMA3fHwLPw9TEjjnCcIpUbLxbdgA0MupWKkxu-nJeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af23qW_4W6UKNIxtK_eqlnFm_6VGXoQC2JqWhptwtEpuvQ&oe=69F0A759"}, {"file_name": "Cover_mini_jp.png", "id": "1938364633363580", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392056_1938364636696913_4598181808748442325_n.png?_nc_cat=104&
-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS5BhGWO0r0Q7kNvwFRpArl&_nc_oc=Adn-CY1bGZVF6hE4UV6RJ2au8Xlj9Wk32jRP20O9c0fIke74od-2GRGc6s99_vL9lfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp9CjfilUE4d80G061Am9qeTocpXpfFQ73Jnt7QZS_Sw&oe=69B54D9E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tMzc445sHQQ7kNvwGKOiiZ&_nc_oc=AdmhqcktXJmJ9cgT-XKnvOQqZzSNgIJ-ZaAbtam5vXhhnfXrgwogtR-aPj3Tv2c_FFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afza4ZHwGhyOVkh2zh9VnxN1nDoPT27S7YgTkGfV91IYRQ&oe=69B53FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Db10jlksL4Q7kNvwFz9TF5&_nc_oc=AdlbjaTIPgVtHbcAdrdz96oI8yieoEN2EzOv3-V0169ya2Gwddy0gN8Hc32OsGiLixA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcBkMLhhkeSeJGRwJuZcqfh-8dE3jNjGlU4tkqpaUDJw&oe=69B5603C"}, "display_name": "Relax With Bird", "keywords": ["bird", "heal", "relax", "pet"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nWhen you activate the \u201cHand-Riding\u201d mode, the bird will jump onto your palm.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. ", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nWhen you activate the \u201cHand-Riding\u201d mode, the bird will jump onto your palm.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "jv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9396853147108717"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1709319346596756"}]}, "baseline_offer": {"id": "1709319346596756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747115340, "status": "PUBLISHED", "id": "1709319346596756"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24490079150692870", "version": "1.0.1"}, "id": "585504481136806
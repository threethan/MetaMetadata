i_YQ7kNvwEq0pGi&_nc_oc=AdrypzzYFs22EwiULz-0CC7c3NGoyopslFp1FXaZ90utZI1kxx5yYNozrm49mmM38Mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1onRzZReFCiaFuVer7KnyFHX801ZIk1xtQPsQ7vU4F-A&oe=69F73615"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7eCZhjNeicQ7kNvwGECIZF&_nc_oc=Adra1mm2CgCdDDlm_CiyxAbeT_DEZGDOx15BpWbXPVL-gdWsHaTwmNglRK8Pv-hSFaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Hsws-SyQ9D7NCWUxCUNxEKgN_CW7nFFpcC3bCsE1X8A&oe=69F73883"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlYzqtAcpsgQ7kNvwGXwhSc&_nc_oc=AdpC6XhGf8SxGHhwaol8iezGsMj442x6lmIU7z4REemNjrfkyNIkMeGOeabs3jXHDME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qTVOI5IMpE6jqZ22mstvp8SEV9AfZsmURrLGksFGfIA&oe=69F7389E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdHCB4Qd-iwQ7kNvwGCO76J&_nc_oc=AdrKGn5Ht7H94IA4CKsSPE5ilN1RYlYCdWid86kIqltwNpAHMebQDNRPLfqbLZBGaOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tX3r4oM2YMTEvPUGNy9Xz7ZvG8i9BO3SMEE1c4L_Wmw&oe=69F762ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBwjhiSUffUQ7kNvwH6SlqO&_nc_oc=AdoHjZl8ycEN-ygqrvP7JCFFCbmsKyV5xVLXf-PRhTewolQdTInc6CBZk-dkV_oLLV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14nG8u_4XtgGef4MH4fF2W21R5woCI3sEqzMQrbgDm5Q&oe=69F74B3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSKsfAkHJw0Q7kNvwF9Z5VA&_nc_oc=Adrc_r4y2rL7_WUJHILhuZduhjEznqlDguQK0KzzfVFUofn8muxM4ngc1h3wafUGsKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j7PWiZ7Mx4fR_pHhEqiPIlhO5NMcfvtSB2YMx_Qoi3w&oe=69F73ED9"}, {"file_name": "Cover_mini_jp.png", "id": "193
HKwQ7kNvwG8X1Qc&_nc_oc=Adq5mBdnYYHQ4wh5MXqZ8gZxXbmuXCvs4lnAE2v6Vdf4FbIiQSQWjUQqB9LrtHwJBs0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AmbvGlTD3RX_TMEOkLj4sgAsNkRmm8VR6zp1F0cKI9A&oe=69DF7B15"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEVGBFRvWsUQ7kNvwGmiWQM&_nc_oc=AdqHkzI7fCHHXUnLhuBmowgC5XnvkoBlpW1_f19tOTEAhPYxc7yfjvP3U3VQ3buNKus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q7QhHP2b71nfMqn2waPL-kS4rqiR5VisEFcUuDll2Pg&oe=69DF7D83"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3HP92jh0UQQ7kNvwGUNzz6&_nc_oc=AdosD9KXve675wT4JAh5sarAIbH9pcVVVwBbXeAl9WsbezLM8VU0czlByH4vtnsROhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VWfVAA1d9u47e199epdFMV3MPuA6ChtuqpSeRZs-ZWA&oe=69DF7D9E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy8modoj1q4Q7kNvwFGC0G7&_nc_oc=AdpgbEXiuHys8GRoMO7J30GG-PQFw0FrXrCFkBOYr8cMGxa0D_cUzozMELcClysHhOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KmJPq53GPESdNhsqoAMQRPVgjDm0ezE3VPJoqDgT9Uw&oe=69DF6FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB6pMbmUffsQ7kNvwF__hBy&_nc_oc=AdpHlhDKNGYCgIkf668x924zPtfeKgAzUd8RLtf0bfcLStZoYAizwcN7RaeHRsBkKko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZcTVhqF5Y_Y1685HYUWTmmoLLp4aO_JJDWjS2Lo9beQ&oe=69DF903C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJs39wys_-oQ7kNvwErmMPy&_nc_oc=AdpvlEvDRIjRgRbDmClx-ch_pae2aZt3zNlT0LSUkxO2wXNa3SVOlTeMNwBI3PqeE0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_Sd6Yw9FqCqAW9KwKN7ieREEKWju5s2wBHWQpAciH1Q&oe=69DF83D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
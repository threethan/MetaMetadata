vKoQ7kNvwEv1fbF&_nc_oc=Ado7r1HcLjP96TQ7F6VPYgGn4bAuEZELcLscZFirmvWcshZoy10N7P6Cu2VwzCftoiQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaupnOmZjRqbCMXxhSiug4e0Pl6QA19ES4B5z5054byg&oe=6A562215"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZQ_t4gQs5EQ7kNvwG3jr70&_nc_oc=AdqICzoNFoy_HQX7ZfVEaIRhKTbZHy-jwUxDzb627_lEUsyYcFNLiX-bjXhcz-h-sSw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxFFGRXahHaj86yebgY3wxYly7kDYuTYIbcurElN__Hg&oe=6A562483"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-549bGdVt2wQ7kNvwEeXK_M&_nc_oc=AdqTeDlfzp-9BzxgFQ0M9M6o38HkGgdRchlwoZZGblzsUY8v8pgfuOcycI09_RMAZsg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Qft4rWXtzFIb2-m3zd1D0fnDZXxwlcE9L74s9QL7Vg&oe=6A56249E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD8lz1KVR1AQ7kNvwFcASKK&_nc_oc=AdrX8-bZ_Eg1bu3IjSeQCDriEfASD5-wtehcft5vKMFb5sa_f4Z9mtnN7R3qPNRuxgI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBNbi-wPLPp6uy2sgAID8mzi98m0tRs4yFvTiPqacl2A&oe=6A564EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yylrx_giVFIQ7kNvwGTGEdT&_nc_oc=AdrPikHKukYYMfqKdvSNRF8xFsi84BO5E9Bi3RtDt1DN5VVW52BdO4ocozw5yyj-q5Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc7G9y-xUk66TLNiBv_XQDcvn4qVOC0-DG8bdbdgm0gg&oe=6A56373C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3_3vQ8BXe8Q7kNvwFEaZvf&_nc_oc=AdrpoSLOfs_LAPvweUzM_rHEX7ALHoFpMbKoz4rFzKmDQyuZ2eQCm_2SJQNVyL7ehIo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4T-CD52Dzd3CdkGZQ8EYs6RlntwzjXk0eiQ2MZg6zkA&oe=6A562AD9"}, {"file_name": "Cover_mini_jp.png", "id": "193
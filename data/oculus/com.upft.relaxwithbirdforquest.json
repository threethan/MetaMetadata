h7kQ7kNvwFEZDi1&_nc_oc=AdrdNDMMp4nSym3GBbChmiT4vaqPrhBtDwC_fj8p69arU1DDQOSSLTABNk43XEsN_jo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWnvmUiDXan7JeCfUATpSjuyBYs4C1ml2ZvSUJWcNuWQ&oe=6A805215"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJaInY2YNNwQ7kNvwGMEpeD&_nc_oc=AdozpfU2ekDOsjrFGH2IA7XDR1MuUe-0l0py7p2nWtrsdqBx9JsdWBH7oTlynBYHzuQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjcTeHDO9Tvpcfi4MRfy82YGDrNi3ufih8UHYTALxuAA&oe=6A805483"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5OjsgMgQy0Q7kNvwG80PGg&_nc_oc=AdrDtmJj1p6SJEVX_xo1RlgCwbHQLjlSNyr7b9p5e4zKapm9RK-Oy_pueAquhYnJu_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYEp-P2Wdgi5rDdpZlhERL-HVe4GPTI9et3tUlmxWQuA&oe=6A80549E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjxUpzqb2YMQ7kNvwH1O8Qg&_nc_oc=AdoehBicX4UT16LbXEPqjGOR9aPb4bi9rlJtZy2kKgjDGrluILxloZbJ0rn4OxRRZ58&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh6fAYaM7Idvt1yTBbAOj_reYj7NM-66lEGkYChxm21w&oe=6A8046AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3P1tmWBkSQQ7kNvwFprwC5&_nc_oc=Adp3mSDd_ykx8tnVLd8DUSp6kDt_s7HDdR2snkhzOkW33fS0vVTnlAS444XV-UxYsc0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECEogHMpvznUeKhxCQ9aAWNyI-1av2u9jYmcs9NycQtQ&oe=6A80673C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLGyIVXiZxYQ7kNvwE3gBDA&_nc_oc=AdoIT1LL_PekL9BqJkhn8ZmalDfyPjD5dg_4LYatvLtUCZfm1sh6_uFIhvz9c9p9jTE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmiefve8f0YwIjX-oxt8DwGCYMkL9DQFeJF-4r3X-yGA&oe=6A805AD9"}, {"file_name": "Cover_mini_jp.png", "id": "193
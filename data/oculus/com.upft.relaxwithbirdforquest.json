x4EQ7kNvwH7Erqo&_nc_oc=Adr9vo7IaaxeeVNHSetxq7j940wdMsDpvovmAShVjgAXWt1p6kvjJavenIe2eCQrprA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wOmL3SJIif2QdDMeujxt-yBukf7-Skiv0mLFiriT55Q&oe=6A05EED5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcAy2swpo_sQ7kNvwHOxFhP&_nc_oc=AdruDFFg56c0jQAtZIrvk50WDkOiNFmq9x-7s0A5zE8njlWfmKKEnE13PXdvdzf5Bjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uGXK0o1oZDxrDXjmIDfbR19miqTr_6aNDo08X5Yi5oQ&oe=6A05B903"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRIvfdnjjZ8Q7kNvwH7M-51&_nc_oc=AdrpZI2kr0hkSbDe5KNhGMMTezWkI5D3BZs72qkdl56TU_ySG5x0zpOF0ovXsKnc704&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ubqovkwRX8aBiH2fEbBlixRQAIlsAOcwqwsje8yMiw&oe=6A05B91E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJHdT6uF0ZsQ7kNvwFiOYAu&_nc_oc=AdpsM6qsMmNvwq9NM_xAwxrjpuFpCp1zYwxgKcTICFYlCC-FmHH2o1VR2xzlHZ0OAwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jJfaLVoWt998jCksWF8v_jN3dJXbvJ3M5TT-jLj-4-A&oe=6A05E36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOuCKZV9OAIQ7kNvwGiYVPm&_nc_oc=AdpCrQ2ek-RodzS745z1xIuIcNF0bpkTQ-K59pVxR0sp1x7hEmfNC-8CjbmvjPaR6w0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I8396PMNr4YRLYUarU_071SF4Kho0miSl74lyplnELw&oe=6A05CBBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irC0YQ13X4sQ7kNvwEcW_Lp&_nc_oc=Adooj3D1kriH4xbYKIMo9jm6OQsf4eCU5BqVvsUxyK0RSP1t9ru2sZXmB2yvSkNu9lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6acj_MUuAjQObE1xHbWyZweP_iaOOMfsbNhrzrX7yCSg&oe=6A05BF59"}, {"file_name": "Cover_mini_jp.png", "id": "193
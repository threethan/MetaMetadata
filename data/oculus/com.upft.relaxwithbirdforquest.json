_a8Q7kNvwFYHsPk&_nc_oc=AdocqjEG1EqSrBJAGMYuAkViwsWGF0jkVj4o-uIlXHExwNVtQx-c3nEOXuL2hm0o3Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS5WaszRGn_z4fqF9g1mQTu5B-S6uOSlUObWGtjoRiEw&oe=6AB00055"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p04eYxhi86wQ7kNvwHWmYdk&_nc_oc=Adp3trfKKSG7g5T4UO8NoyhThNrk_W5UoLIfZy3MWOA-YcgeK4oaWgBtv8HW4b48IeY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMEqCrjrrfpl418CEgepL_hW9jyJJjja5g8TA7WbFkbA&oe=6AB002C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWZtM6f0EX0Q7kNvwHRUOKI&_nc_oc=AdqEfBsWdqAV8bjuHNaaV4kmv3JyB4mTMp_Br6tSUZBnqur5pnsouRymbXG5aCtpwGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk0PFj3VlfDDOoU72a5wrDMfvBiH98pM-AmULiD4zA4w&oe=6AB002DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvKsB-kL27YQ7kNvwHeaLL1&_nc_oc=AdpIAJF9vHWaTD0mrwCg0GltU0jYNAfVnlzcf8LaWxXacPD89SGpF2qNJOkMtxYBLVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtu_ct3B6c7RTYnu3QcUJJ1FK2nrJZ78X45QoR6iLF7Q&oe=6AAFF4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocYkFNjQb_EQ7kNvwHVQJaQ&_nc_oc=AdqAUpjQpv15QAtKoeIsQj1BX3ebsPMBeGIwtcrhqXzhHXGSDP3aLBWstusg4yHen4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8VRJrJfWmteOnbPpFGDRDXeDgkmWSED5MzSR41QDDxA&oe=6AAFDD3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBU4-oh4dTIQ7kNvwFFce9o&_nc_oc=AdqtRrNdSU3bqWwZ4yirVULcBzYZFjBRK92fdiuB-eI3B9VXjurNIYRY3yKNmrnX7g4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4nx1tghCiwXSwZEjbrbLZXNATaBwRGIkEwquj1iRoew&oe=6AAFD0D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
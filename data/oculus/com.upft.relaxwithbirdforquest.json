f8sQ7kNvwG0chUe&_nc_oc=Ado8X4gQUg4kSJAaPuzJZnCCoNbwtPP0B1I83iDEKeF7zbfYUgUjaW508YD01zzBJzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv3BmW6RAM_b1y8dHjA5xAPGpomM-es7J3EU-yYVBt-Q&oe=6A4A7CD5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PiLz4Tehj4Q7kNvwFgUE8M&_nc_oc=Adplx6NATcZYFoV-iuZR1wKrJDdwC6LMzeL5Xy8jVBMKiXbK-5Q0_Ohd2gKh7jArrvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGUxepE6rXejGz7-MbXt1_B1UNTHaxIqm1a7DYmQ4ABw&oe=6A4A7F43"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9e8jR-vJlAQ7kNvwF1zyZ_&_nc_oc=AdrHeaeNcEbb5hMJ1VsXYOx5_PDh1Zq-T_PivjF1Gth-etmuCfbv1cRiq53Sk1SEvPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4elKHFJNi1Cw9EVII4A854OsLerMlAVMyeEqP4OkrsA&oe=6A4A7F5E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpjbaEzsIcUQ7kNvwEEqtnS&_nc_oc=AdrWlh-9YBXcEaPAlG13xicfvpnGcg6fQP67Kpi3dDiknMmZBbwhvSct9DGCfZy8V2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBviEEuG-uktceYnQwQJ3yvWsAF37LfRW3b1e_FXQoUAQ&oe=6A4A716D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n29Owc6t9sAQ7kNvwGExV9n&_nc_oc=AdpYqntt2BthYjACpHe-JqAM8dZsOEBVuf4RIEoxyzlCXaWA9fv7xlly7MzgiLjt4Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARW0r1qAvI7tC0sPDBTs-J4bDBmPhChBVwKjk_qf294g&oe=6A4A59BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFdPpjA8wOAQ7kNvwF6Ah_G&_nc_oc=AdoZ__3xKEITcLfC4z76d4DxWp_FyDbaCNGbhg70GmuUA-LwTayRiUuVwVpTyhvg1xQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA91LBs3X4DVKlQMTT0HZA69Kzap-J2sueIS8P5mPJmdg&oe=6A4A8599"}, {"file_name": "Cover_mini_jp.png", "id": "193
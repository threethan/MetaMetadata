GKkQ7kNvwEUMgTm&_nc_oc=AdqPLnx9x7oezSZtwc2rIyrENxCbiC2-nF7WWlHd1ujOPM-uNRI7QHUMs8biyzgfKKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypbbqqhIKeuAVyLlnCwPj2gU7gLPlzfRi4XbPbNUKHjQ&oe=69CE5795"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clu05ayDFGIQ7kNvwHyMZeC&_nc_oc=AdrsR0oJPc6qWgwfo4n9palz5jDEV7VnoujMtJxXgjzfy3uv6oNWAb_qlfSW7Tod0Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylNDZpQJRAgYP2M94fugYgmhNTVOxfN0K5pay_WYRg2Q&oe=69CE5A03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZgH6lv_tNQQ7kNvwGZNpLa&_nc_oc=AdrdhP1RQULzZ-f3kmM2gWuGrvBk-pD3v5LH2pR6V0MiGsziDZFiF1AGHzVs59WxHW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyecKdF3HokERE9YVMO--MjsUa3j0AtUHwxAcE-gEHL4Q&oe=69CE5A1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyVKSfwp0GwQ7kNvwEMN5LF&_nc_oc=AdpD5iJUygOrVsd6pOXba6J5mqkRe-B_Z6SLxazXYcMxwIdxDxuYDPkdvAicsztc8wI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzot-gKtKHMxrHx9c2ymKnkB3_XF0x_PwqgVkkA0KPe4A&oe=69CE846D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GBvJexeLJ4Q7kNvwF71AXw&_nc_oc=AdqemPudw90lQXYzcjbKC_g3jX49-I6gPawlF_psubEvZ3NB6xT5zQG1sLrrnLOFVnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWwiCVnF7xJugtKPUIhNyieLFpRb66UkvzUvHlKbZWWg&oe=69CE6CBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z_O589ZgN0Q7kNvwHXC6d8&_nc_oc=AdoMADFqWYvx4LeP4Uf6Cub7v8mGEF_ra5U8ZzoGZw5KMm2PmAdvR0xWsGoPG2NFHtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDqVNVBD1Qxoo8oiYA33r5C20Y5-lelBh2iSOL34lIHw&oe=69CE6059"}, {"file_name": "Cover_mini_jp.png", "id": "193
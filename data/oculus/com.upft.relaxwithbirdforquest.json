JZoQ7kNvwFoA7ef&_nc_oc=AdooSQTpfTt8qVbMZpmUp0ifPFKWeY7jNeTMYcTddTkZOtk3dcGLZW9dQ0UaOYB9Qpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFR4fj379lyKb1KJEwlOJ-O_ZEf4YBR_04NMgRzFmAPw&oe=6A5CB995"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EzOB4UP5dAQ7kNvwGTXJc0&_nc_oc=AdpzcCV3RlW_2C73D99IVAYGaFZKL-FMKngzqamsR9bKmEl-E0KfTTexmnwDOIktm-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC85FrC3ijqqKRE6V3F5csOX3xXa4V0n6ByKelQ50Eo5Q&oe=6A5CBC03"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3wpbQRB-rgQ7kNvwFNteFo&_nc_oc=AdrepmHSPzdI3L8Yq4eEQpdqrtaWRdXkKgWoJFzboqnG4Iffu9ZckOZ40dbTdjNRnn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdTR73BPkOOJrOH3P4zxBKlsIzjLqC1HZB-ZyaNvy4Iw&oe=6A5CBC1E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c7Z1OD0jJcQ7kNvwHgJt3y&_nc_oc=Ado1qfFfi4gN0Bx0W1_ZVb3PmnIabp1s3TX2QMQG_7T03JAHQam0nZs8oVKkCMB_mvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsEdnFs2bj3HL0YxtOGoAWCP-wz5cPBqXB2I0AWx4efA&oe=6A5CE66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAzkY6GjmFQQ7kNvwGApew9&_nc_oc=Adosp71FJX07uVyvd5ZMx8XmkvunXHAaAilvOHDSVO0nYjnppgrUIjSnioUOgXlU-lI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSJgiwUt7JqMEo9zLRJGyv-RzF5aYGOaK7QBQCO8zaCg&oe=6A5CCEBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8X_LShJbysQ7kNvwHwxH0i&_nc_oc=Adrsu_C59Plh5ZmoBEBjZvUrw-nyaWdWYdBVB_dpSXDy2mHjI3AaO6Zjz9lhrvCXzAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJdE5uXlU79aqpXwgPP8gtgIrk1hDn65dJ6gKBQMnhxQ&oe=6A5CC259"}, {"file_name": "Cover_mini_jp.png", "id": "193
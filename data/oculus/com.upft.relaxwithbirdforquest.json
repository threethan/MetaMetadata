fX8Q7kNvwFONePi&_nc_oc=Adp632v_Fr2jEOZwk0mfoi7ZdD6fZBZXxuJcGbnATkZBE_cQ_QEUitFiWlanTlnehRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPY5jZrTva0x4qd3bBc2REItTMtArpTlqTp3HSU6SOdQ&oe=6AAABA55"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RODzppT91xQQ7kNvwH18uIX&_nc_oc=AdpyfpbkrMCmNpl4fk3N3P2sQ4WOERztTO1kvjyh0SMYYaRPieeW9q9fPcgygaGfr0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQZc5ua_gpwtRNjSZBumXodpTb5KKPVvZv-S-2qlUAYQ&oe=6AAA8483"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn266qzIHhcQ7kNvwHYSERL&_nc_oc=AdpJhzPKToTyZBjAjVgsJs6YVHX_8OgwYMTfUt3T4TAMv9HrVJErUO4ZSKQJXDfgceI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZzxS4IMspsauAuKzOosSMtfEWA9WnvNXT5w_opuzaZw&oe=6AAA849E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vc_tibd1tAQ7kNvwFpTnot&_nc_oc=AdrfHzporZ6EeslgbhxLVl9u2PA3_zlKMrzkDAhUoVY7IiYhJfoe3Pz1Wkmewfptd90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcF-ZWOfClVPpeQ3pklSVotC1uHOs-hw-d43zZ9QpXqw&oe=6AAAAEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMwzFzmBOagQ7kNvwEeHrRd&_nc_oc=AdoR7yPD2oUPo9QkIlVXmxuV0-Q6XAywj-jG7Lj4alQukzbJ1ajNLiKbSPMwg0H-Wds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq7oR39NhqkRZrE8Xz_Fo9ZozMlQpxYukThaqG6hMBsQ&oe=6AAA973C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y38hHSrCNzgQ7kNvwEgUnPN&_nc_oc=Ado0yOO6A2BSUhMYRKeSAfGRpQJHpzghqk6gqbk9LUt8PMJZP0WLqDy6odorM44eMt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJpZWLWlZvvqYOzBhLHJk9ZHPhKpeMeQLJDGWJ0DC_wA&oe=6AAA8AD9"}, {"file_name": "Cover_mini_jp.png", "id": "193
-3.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eL9jmT2WafwQ7kNvwGmXaJk&_nc_oc=Adk2SL5obQzj4fNtKXa6ERLea2UtOJHyEpxIhkqsMKjf8rqkPM8VOXZTYwsGw-HEqa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJX2dbFJ5aSJcPOns25ah1YKV9z7Iu-V0nogNeYABcoQ&oe=69B9421E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gsMDAQnKEkQ7kNvwGQOQiM&_nc_oc=AdmLKegBlnBZJmFWOM9nEO8WGkN7bEilkd3pk-tg1GspVuukEjIoA5Wpxg7tsdbS5YA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTEW6MjFTKc4G0X3PA8rsLlZbvAo90NgLSLXSMM03V_w&oe=69B9342D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykkjMiG9t-QQ7kNvwG84GJY&_nc_oc=AdkjUn8Tba8sOMZpdYFuT7rg8YQhpCkAmamGCIuJ2Yw7s-tORjPAybV-xRnkHsqU6Rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0MXBYXCKPhpIvioqmuKvfqgLMvuBA7WrwKLm0uJHmhA&oe=69B954BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "heal", "relax", "pet"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nWhen you activate the \u201cHand-Riding\u201d mode, the bird will jump onto your palm.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. ", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nWhen you activate the \u201cHand-Riding\u201d mode, the bird will jump onto your palm.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/metaquest3-app-privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "jv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9396853147108717"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1709319346596756"}]}, "baseline_offer": {"id": "1709319346596756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747115340, "status": "PUBLISHED", "id": "1709319346596756"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24490079150692870", "version": "1.0.1"}, "id": "585504481136806
krsQ7kNvwFUatmM&_nc_oc=AdpuJrieLaoyqEAjgS1EJUs1T0iPdyZwwtEl0j_7ndSw_vcf1ZoGei4A5gc4TH7gr10&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Dbclfiu9W32jQSB5ARgfE4yZdOu5IgykRn3ciDDNLw&oe=6A26E455"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7SrMdbBCqkQ7kNvwGpFXd0&_nc_oc=AdrVmlWWgwv9uV9ezRKt0eWjirlQ8Op0qBX9DQ4Dh77jGsONohVs2-2ocNVmUlrJQoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af866h73lzGs02jxXkX97NFV7_4owUJooH3syauWKl-O_A&oe=6A26E6C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLsAGECUO7QQ7kNvwHmNzSZ&_nc_oc=AdoaayOWrIg9UwxzysQ4Eoxr3VcthgNffQ7YIEFmkSJPYnRRtotxaCyjvp3IHkp1QsY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8viRohOdpWCAv4mJ5GsN4sYOMGL7ZYpXSSbxD985Pm1A&oe=6A26E6DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWMcmstKe9EQ7kNvwGrSMe6&_nc_oc=AdrdvSn0uzUSrSX4I_rgTP3CAGmafbVygF7Hv9jrtOuUl79Ed-L8erkRLLaCU9cM258&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ivCj4nP3fLu6Yqq2cg2pJFVBOC21i7DObKeY3mJ_sHA&oe=6A26D8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt18fAle9c8Q7kNvwG43ca5&_nc_oc=Ado9Eey7zbeDgYoEf8G0yZtElC-nBKvgEfA50fS0w-xCaR276ZsuPY7W5T2mEUc0yhk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C0TvJEd91xzyEo6D62H0mHNf6a-UD06zczDg_sg6AKw&oe=6A26C13C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFXOMVhS9S4Q7kNvwFgJXEV&_nc_oc=Adqq-xMtTad0wTb8TBLkrG1dlZT36Ey20M-No2R6ZGuM2Xpjt6blV9grEZQlG8qAcic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af862g4IwOMmBcad9mQdMk-MfP-Sa4Pciep8vgpYQdZpjA&oe=6A26ED19"}, {"file_name": "Cover_mini_jp.png", "id": "193
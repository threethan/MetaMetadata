6hYQ7kNvwHneDfF&_nc_oc=AdozjZcU8vy5Hlj0wqqAtVtDjS6Is6B7E7tGjVWlBkdq57xdN7cr7wxy41NDBgmqLbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOD3lWLostuMFGUjyvrKotMiSE3MSk6UcOCmny5NL2ZQ&oe=6A75C615"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmrB950_QB4Q7kNvwF5JPqe&_nc_oc=AdrZYMgJPOf3iKHeeoSb8T2cogMEdB42i4T_3MnN-kFnFUXySQnnbhFrpsLyi0mkIzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWvBD1O3z9dnQp4g2lIX_pxvtpmwGc0urloIl9Ke8GmQ&oe=6A75C883"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ALl9701i0kQ7kNvwFdUWQh&_nc_oc=AdoVosyMb6J6Tqe403yMTiIxEKqVzzUfy52-i1s13tKjP4fIeug6nseagER77CEQsKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeNUJusDkDZxfjaAtlZ9nYmhdb4vNG6qeChnyn0tQz-w&oe=6A75C89E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT9dRg0wdZcQ7kNvwHvt1m-&_nc_oc=Adq9mWffaWRMOfEXy-tu5ff8WA_Dcg7rVQBMmHaaUcL-mPkDmhUlKloKkShomUJO7mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc1hl5mStEdxwloh7VPLEUIUJjUJ1sNx8nmj5-9GltSA&oe=6A75F2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcyByA7roJ8Q7kNvwG01GlH&_nc_oc=AdoaAZyvLfWOgdtrPf_DBWqEtJVdK0W5WKKNzRwHrD10mutrxHjQgCCyTcWIgB7I1RI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5uW-5BHhFPdDG5TN34puQA_2MZXOfTIU0cavSJ1uYjQ&oe=6A75DB3C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPFw6fqiKIcQ7kNvwF_svU6&_nc_oc=AdpAMfuzsrtAaEtEaFrKGy5XO158vqNP-D81hTeTK95rQAB9StcU5DgIZx3wqae1V6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3McMfiMRrcQkmPm0FOKG2CR3IQzhmUoQPG9UomB8XNg&oe=6A75CED9"}, {"file_name": "Cover_mini_jp.png", "id": "193
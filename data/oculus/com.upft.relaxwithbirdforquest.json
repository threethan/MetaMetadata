Y6YQ7kNvwEf_3-U&_nc_oc=AdoeJSBbarccPNRNAjFA6zc79inquJoDfBku43wdxcwpivTfksSaFLNjqn-PknUjyYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi4x_3VH_yK3zkfTslVMlxtlMYG5glViunZoJlqRRvMw&oe=6A511455"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm1q35spPycQ7kNvwGijCx0&_nc_oc=Adqrh3gXWRQLpHySqKtZx34hzntF5rg6p6iAGzwam_1R_aiO7VFdzsdJh2drPbI2tZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWKOU24qp6INeGDkFg-GOp2rgoTx46teWrt42O-vFObQ&oe=6A5116C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FSG26b6c8sQ7kNvwE__rb8&_nc_oc=AdqzUryEgTJP3SX4c8-4svxxfQi5M5p_wwCkeeoGdnO-2fP6cfB2VMI4gbIlpFQt7RE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8RSZwQtNb2_yTQyvHdGo24x43sWFuwxT6nS5p4ZQwYw&oe=6A5116DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfowY5YmPj0Q7kNvwEYcYJA&_nc_oc=AdpAMoPh9Tzd34gUI1b5B433HagrRF-X_bNyWc3X0M5XaQNaU6y8Nowi5rnqWSS2PUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeYTd54Mleoo8yJLVXg5Q0OefKMOSkvgYOl1SytBdPHg&oe=6A5108ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKUZwCoBjH0Q7kNvwEkUCvF&_nc_oc=AdozrQMf1UBIRcyiGzLHo3vMAs7emgVmf8mN8xG_rQ87wTiSj4KEtbkvLCDxEX62gvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1DN-SDy-cQjV6L0bLqVfEddhajEX9l9qmTgWC5uiaew&oe=6A50F13C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO2kOsfSY7AQ7kNvwEyy7A9&_nc_oc=AdrYw5vCQmpO9JAb4JH3kkzk0V-rTFhvFzNEmaVl3zy7chOTIwty65hdpGQqTjoRIi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFpbbFtw5w9OyL4Y2mkNGmvgICAqNXVigk2eVeP4ws-g&oe=6A50E4D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
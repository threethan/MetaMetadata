CWIQ7kNvwF7Vei8&_nc_oc=AdrFR4utMWMP_AHZ1OAhjIQwsqV1y3aJWl5qs65AOxkFh1SjT4fLDviReHEP3KvFBdw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLdOE4H0gGg7XwAGCFbPSXLJXvbnfgAqTj-h9Os2DqZQ&oe=6ADCD355"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4TJ_4x_Hw0Q7kNvwGUK-Ft&_nc_oc=AdqW443o-s6qnJW4pcys5ZBdAkCSmRQ8Lxv6-bWnc4Lwhy3MQUmdo9396ntRz1YVp74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC4CTNVKjGQAt0lSc4L6mo9Qm2U75j6_xKmgg-lOZlkw&oe=6ADCD5C3"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-gpmH4uOfQQ7kNvwEmtCQ8&_nc_oc=AdrQAMgebms2KW7aj1elLanuJknJte8kqtkvedsUz_yhYSFmt9rZspvKU-VVb1zXx9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJk5Nymin71kiuMqva4lQKrdYso0_jtg7fCEZWz6mYbA&oe=6ADCD5DE"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTEoAlCeZ1MQ7kNvwG6G5-R&_nc_oc=AdoZI1hnDVGGBk5cxoSFClHRxbJJKCZLVc20KLvdHS-d4KWMUDGrLTrSRs305vxN1cM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPws17-4qMULQLHcPWRxcGaUtmCLVU4ljdtXTiuyKi_Yg&oe=6ADCC7ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ftwkf_7cIgQ7kNvwFQ_Jtw&_nc_oc=AdoBdNe__q1NOcYtQ1bupTvibw9OuOB_6vc4UTdgTfnmOFJf7BgqcrSHqzKPhrANiGE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxJaGa-vPOqECgi8yNkXaR6j4vCSvF426TE3On-jf58A&oe=6ADCB03C"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfabEvApTL4Q7kNvwElUfy6&_nc_oc=Adqy4U9e5IHfYpsI0vBpyDl2T6-PqHGr7A1dG69-AEBookCCQTqzkZsoHdq41kek6eA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOraxOlYFiHzCe8CoY9UZ_xh-5go5CSiFHi9UPQd7tgjQ&oe=6ADCA3D9"}, {"file_name": "Cover_mini_jp.png", "id": "193
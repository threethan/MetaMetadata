HmwQ7kNvwFoL3B7&_nc_oc=AdqSsHpy0frJ83QDgh6-3-gBMM_Y4AalAO06mn9ogqltk_hdeg3lVoC6zltqA4izIv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i8OlVhGmXl_Bq8rXb5PJtrP90hCHev1kdnEwil5-0ng&oe=6A2592D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ca_BZ7uBJYQ7kNvwFRNvhJ&_nc_oc=AdpixHHTSluTlSYpvd7ZuAfAKL1qlfwiXmkKGR1z_pCrN4VneDNJ211kspyArfB2SLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EKLmHD1_kPIAnsqfPUZ9-EhrmIHEcbIw9ohKC-_hoAQ&oe=6A259543"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kxkbnCn1HgQ7kNvwGZGebC&_nc_oc=AdohpSwl3yHZToREyg7o_xK5ScE3KCqrBvwU__10KuKutjUWlramRLPLiUs-f8bSZUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dmt9rlK52ovN3SWPMCwZDX4LgSqYM1t4_2X6ACQ9sFQ&oe=6A25955E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWMcmstKe9EQ7kNvwEkOfNh&_nc_oc=Adpx9N3TLCUzlqSRPNc-2zL6cwB7Xq0rL6bO017Ayh_HVSsey92S3c8jOmrIKhDReQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__6G0kUqKRa8ZEPp4oLQ_GYQt5YAwoNiH26hr50FTSGw&oe=6A25876D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yt18fAle9c8Q7kNvwGmx1Nz&_nc_oc=Adp91BU74ywZQN-QPHhiUIm_kjcDsGt8DUWh0oB4iic41i_cO6nMMgxMTFiAxz_RQV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IwHYV7VFKGLIPGTAY_xxOPuMN0vPCzQCysaEetyu3Xw&oe=6A256FBC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMJ2qNqdQFYQ7kNvwG9NZ4o&_nc_oc=AdqbejWzg5b1HfSBWWHjI_dzwpU7qicgQJDAYeldah7Z6z-rzGxGjgCIOKvOo6_tWRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LvE6cDuFuIcVz6qLZOhjQHP_srSmbA0az34vZv4vauA&oe=6A259B99"}, {"file_name": "Cover_mini_jp.png", "id": "193
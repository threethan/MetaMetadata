6g0Q7kNvwFukCEu&_nc_oc=AdrWcTePjDM5VRrWhUTP8CcmbjQc5bxCBnUuMgiAGp3wPgMZ1RlAA9RYWvae_iRkoKE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l_Xpxr-4R_2BtPZ_v7tWPQtF8PUmq5EM7kdZQUY2dLw&oe=6A1B06D5"}, {"file_name": "RWB_ss07.png", "id": "1861783944555942", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821916_1861783947889275_3595640013784231294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09LWDGgQ9JQQ7kNvwFz7cyn&_nc_oc=AdpLDkhfpfegntP8kEYlTjHsHZrFDmo4tAZrm7RFgGCNDFFhrPzDQO-7AYvUVkjExY8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_eoLTkSo-xIdSh_VP5FYQMFnwrGdr19nHIxp2Oh0b6A&oe=6A1B0943"}, {"file_name": "RWB_ss04.png", "id": "1893374304800429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823433_1893374308133762_1635097982728518186_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WjseXmaxC4Q7kNvwHUEc5d&_nc_oc=AdotIz3VxZ5F6mnLPtpereGm5STlce236f_hUv1GFqR1iDuRx09dUtfBlI_n1srUioM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jq8LujMhaCe_MheKIl5kCxGnyKyNJTZ7Tz1YsamrckQ&oe=6A1B095E"}, {"file_name": "RWB_ss05.png", "id": "1899518130785768", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392170_1899518134119101_6755452890688473386_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBe5aUMte_cQ7kNvwFsqowp&_nc_oc=AdrCfu_eGctZFxrLSoAUo2IutP36cRPjErTtdP3rrtTqqEhX-oCuUojbvL5WzySNxOc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HiQx2Aiusgzad8KRuzjapImp7awljliNsDxyMBqABjg&oe=6A1AFB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape_en.png", "id": "9611173515662561", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818936_9611173518995894_7691385312384013627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h4gJ62hXvUQ7kNvwEBxqps&_nc_oc=Adoyswd5pAG0cEPDgTlocU9bdfB9aQIHXn3AhBETA9ResIbUdnqs1fQIkfFiltjFGd4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rgbqXY-S5-UbacZvsvXaVQV4Ou88WlmvfEkcHfWpNKQ&oe=6A1AE3BC"}, "display_name": "Relax With Bird", "keywords": ["bird", "relax", "pet", "healing"], "long_description": "This is a digital pet application to heal your heart.\n\nNo need to worry about taking care of this bird.\nDuring your break, just watch the wild birds rest their wings.\nYour heart will be at peace before you are aware of it.\n\nHow do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. \n\nThis application is for gesture control only.", "short_description": "How do you usually spend your breaks?\nEnjoy surfing the web or watching some videos?\nThe bird sits quietly by your side while you surf the web or watch videos without any interruptions.\nIn its presence, you will be healed.\n \nThe bird is very attached to you.\nIf you call out to them, they will respond, and if you hold out your hand, they will jump into the palm of your hand.\nNo cage is required and there is no need to worry about them escaping. Please enjoy their lovely behavior up close. "}, {"images": {"nodes": [{"file_name": "Cover_landscape_jp.png", "id": "9445521965524847", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_9445521968858180_8946520727510859991_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_cDRWd0iE0Q7kNvwG1ZhrX&_nc_oc=Adp08BX1t-njYT5JvuF8dp4y5c0j6Cz6AXSADjJgV0hm8cvOx-KV8crRd1VaXoTabiQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C0YZxPX1LaYe2tNfKgUzhp8JtFy6oTBIPZsptfmEOyw&oe=6A1AD759"}, {"file_name": "Cover_mini_jp.png", "id": "193
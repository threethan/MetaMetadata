nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9G-avhGzI4Q7kNvwG25-Rr&_nc_oc=AdmOzAQE_eUEzyryv0lqlYQT4U6umgMDoVefH9zCqDBaaLiLZYGBQDKEWw-axrLhRFw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftOhKRSroLXKkK6VeQybFe3WuQ5NNaUHIHew08Wfny2VQ&oe=69A18E02"}, {"file_name": "4.png", "id": "436922545633811", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974834_436922552300477_1908330657692740664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9HN-JViMFoQ7kNvwHnTCVA&_nc_oc=AdlNXjZP_hqcl2-dvjBH3Ov1qRaea_rh33U3CTwKj-AvromqEhmP50J9QKV6hKEQhww&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvrNQGkv45-Mqeou2JkH02AZc0RgZC7J7z9fouRUgoG4A&oe=69A17893"}, {"file_name": "1.png", "id": "1857202404800040", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57569455_1857202408133373_8022453330039784951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCxxrRyrxg0Q7kNvwGYBerX&_nc_oc=AdmosUqgA_9ycIA36nCgOR3MJHFNbH_ihTSySUuqFXrzxkf5XD_htrh5SGLY8UTCfpU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsUz5R2QyxdI8BiUMcwrJGCGZSunqb9udxOb8bNUqPgEw&oe=69A1A8C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled64_20240514195914.png", "id": "471660415295831", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001670_471660418629164_6998377292821015207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcnrOR2Gm2EQ7kNvwF1l6nF&_nc_oc=AdmwucmxXFdULYFc73QwC4wxlJT6vI9MbyiQmTPHKuC5V_JVBtxQFgWjGMaMJhH-sf4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsyzF7uWzDfMvhR8COd9Ka-zeSmBEP7o3QjC4SWsx6odw&oe=69A1A731"}, "display_name": "Terror Trail (discontinued)", "keywords": [], "long_description": "\"Terror Trail\" is a fan game of the popular Meta Quest game \"Gorilla Tag\" It uses Gorilla Tag's locomotion system. This system is where you use your hands to move. You hit your hands on the ground and depending on how fast you hit you will go up. Your character rig has no legs which lets your arms reach the ground. There are 5 different servers 1 being the main server. You are also able to change your name with the in-game computer. Then you can go to the mirror to check out your looks! (This game is soon to have a horror game mode but not yet for the developers have not added it. It will be out soon though. Thats where we get the name \"Terror Trail\"\nThis game is discontinued. Go play Subject Zero for a better game by this creator", "short_description": "A fun interactive game with \"Gorilla Locomotion\" which is movement where you move with your hands. (there will soon be a horror mode in the game) This game is discontinued. Go play Subject Zero for a better game by this creator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/terror-trail/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/terror-trail/terms-of-service", "publisher_name": "Jackston", "support_website_url": null, "website_url": "https://sites.google.com/view/terror-trail", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8872885672755318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974887_966604621769955_7498597218876888052_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ5kALuaidoQ7kNvwH7_Wiy&_nc_oc=Adlb4DBVI8fTnVULfCO3a16g3Cbfnnfhk9IytB9T9q2uHH0dH1unr25XfJ3N8r6Uz
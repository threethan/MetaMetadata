68", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223475_814525990556101_5219378263648331592_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7qCIKzsJGkQ7kNvwGmp5aN&_nc_oc=Adrf-cQeOQC-YVODJNkvpQIcL83j8nvukdspdENoHZ9AW35ETnkvJGYiDJokHcrYiA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwwDSgxJp5NAJvbeA8NWsqQ5I3bJIHZQ-lN9NsiXu8Gg&oe=6AB51782"}, {"file_name": "4.png", "id": "436922545633811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_436922552300477_1908330657692740664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zi7KorXAZsQ7kNvwF6hXth&_nc_oc=Ado0ad5vFiiSuJpvg_-wBTK36HfFSJABlSN_8O6iImr6jVlw0hDEUgg7Gqe9IvUcXog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1UeUrfXdx9QA1BEfdBtv9GA1w1o90tqJ_Un6W2j2TTA&oe=6AB53A53"}, {"file_name": "1.png", "id": "1857202404800040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569455_1857202408133373_8022453330039784951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjVCMm7I5kkQ7kNvwEb8tSu&_nc_oc=AdrnvzD1cZpjhlejaIKBnCNCpaW7vOUZ0wv4CeKGsd02TonNdPLlt8-esSSD-s56rE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-NT0dWKsSKpBpehYfbaEPmSqnmiVHCu15Yte8IJO0Lg&oe=6AB53241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled64_20240514195914.png", "id": "471660415295831", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_471660418629164_6998377292821015207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJMP7RGNDzMQ7kNvwHrcz8C&_nc_oc=AdpYLZh_u-LLJaO7xgmpwl8M11naBIQNGjAw7AU0t35qyLPpbAl2fdKjkil7RF7R4p4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBqdPrqpj7EtNI481puJ7PR9oKMOv5Q_KHiG1RVzqKVg&oe=6AB530B1"}, "display_name": "Terror Trail (discontinued)", "keywords": [], "long_description": "\"Terror Trail\" is a fan game of the popular Meta Quest game \"Gorilla Tag\" It uses Gorilla Tag's locomotion system. This system is where you use your hands to move. You hit your hands on the ground and depending on how fast you hit you will go up. Your character rig has no legs which lets your arms reach the ground. There are 5 different servers 1 being the main server. You are also able to change your name with the in-game computer. Then you can go to the mirror to check out your looks! (This game is soon to have a horror game mode but not yet for the developers have not added it. It will be out soon though. Thats where we get the name \"Terror Trail\"\nThis game is discontinued. Go play Subject Zero for a better game by this creator", "short_description": "A fun interactive game with \"Gorilla Locomotion\" which is movement where you move with your hands. (there will soon be a horror mode in the game) This game is discontinued. Go play Subject Zero for a better game by this creator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/terror-trail/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/terror-trail/terms-of-service", "publisher_name": "Jackston", "support_website_url": null, "website_url": "https://sites.google.com/view/terror-trail", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8872885672755318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_966604621769955_74985972188768880
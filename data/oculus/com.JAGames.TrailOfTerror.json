33373_8022453330039784951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCxxrRyrxg0Q7kNvwGYBerX&_nc_oc=AdmosUqgA_9ycIA36nCgOR3MJHFNbH_ihTSySUuqFXrzxkf5XD_htrh5SGLY8UTCfpU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsUz5R2QyxdI8BiUMcwrJGCGZSunqb9udxOb8bNUqPgEw&oe=69A1A8C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled64_20240514195914.png", "id": "471660415295831", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001670_471660418629164_6998377292821015207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcnrOR2Gm2EQ7kNvwF1l6nF&_nc_oc=AdmwucmxXFdULYFc73QwC4wxlJT6vI9MbyiQmTPHKuC5V_JVBtxQFgWjGMaMJhH-sf4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsyzF7uWzDfMvhR8COd9Ka-zeSmBEP7o3QjC4SWsx6odw&oe=69A1A731"}, "display_name": "Terror Trail", "keywords": [], "long_description": "\"Terror Trail\" is a fan game of the popular Meta Quest game \"Gorilla Tag\" It uses Gorilla Tag's locomotion system. This system is where you use your hands to move. You hit your hands on the ground and depending on how fast you hit you will go up. Your character rig has no legs which lets your arms reach the ground. There are 5 different servers 1 being the main server. You are also able to change your name with the in-game computer. Then you can go to the mirror to check out your looks! (This game is soon to have a horror game mode but not yet for the developers have not added it. It will be out soon though. Thats where we get the name \"Terror Trail\"", "short_description": "A fun interactive game with \"Gorilla Locomotion\" which is movement where you move with your hands. (there will soon be a horror mode in the game)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/terror-trail/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/terror-trail/terms-of-service", "publisher_name": "Jackston", "support_website_url": null, "website_url": "https://sites.google.c
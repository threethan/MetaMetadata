s2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyou9ECR4GI7o17KFgQqQVok30WF_E1bUA5tb_xOKOscw&oe=69AEA793"}, {"file_name": "1.png", "id": "1857202404800040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569455_1857202408133373_8022453330039784951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbP8SuD_0CYQ7kNvwGH27c9&_nc_oc=Adn641KhRS4vZ96wctJ1vkUpHaoIAHRxTJGJZ8loiZaJjILXtOWr8qshYK4xa8lc6Ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx2VmhgOxZou5_PrbQdZ7Kt_18oDA6GiJlkcfy_XcK2g&oe=69AED7C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled64_20240514195914.png", "id": "471660415295831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_471660418629164_6998377292821015207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jmw7bBsUH4Q7kNvwE3ec9i&_nc_oc=AdlTscVA4MpkLB0jT3IjwE__J7Jvx2aEG7yNxblDSrHOzJYe0XeUtbfUpilmzafXnac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfysfRAddRjB90VxrGEKnkW04rd8KuXOe5pE1KJgEdob9g&oe=69AED631"}, "display_name": "Terror Trail", "keywords": [], "long_description": "\"Terror Trail\" is a fan game of the popular Meta Quest game \"Gorilla Tag\" It uses Gorilla Tag's locomotion system. This system is where you use your hands to move. You hit your hands on the ground and depending on how fast you hit you will go up. Your character rig has no legs which lets your arms reach the ground. There are 5 different servers 1 being the main server. You are also able to change your name with the in-game computer. Then you can go to the mirror to check out your looks! (This game is soon to have a horror game mode but not yet for the developers have not added it. It will be out soon though. Thats where we get the name \"Terror Trail\"", "short_description": "A fun interactive game with \"Gorilla Locomotion\" which is movement where you move with your hands. (there will soon be a horror mode in the game)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sit
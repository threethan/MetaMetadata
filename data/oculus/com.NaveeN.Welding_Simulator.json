zW_e9DPiXjm9l7tpTx3UHmJVJMSCdsHql4MNYyVVNq5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX7W1Szu6yLFB8vEra9ndKjlgPDQt5N_zmJCiJBTOmXw&oe=6AEB517F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WS H.png", "id": "1327716505887017", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1327716509220350_7769931104683373273_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqzbdDubOnIQ7kNvwFe8dZ4&_nc_oc=Adopa0NPPHYLN-uIQqzWEBjLzUPQYf8XwC8fbC6zSDvLirW9wsBKnGUORpApFCbTEHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3T24KCparKr3i725RWeRQyXOEIAlA-XCyixPwJrZm4Q&oe=6AEB611E"}, "display_name": "Welding Simulator", "keywords": ["Welding", "Simulation", "Training", "Safety", "Engineering"], "long_description": "Welding Simulator is an immersive virtual reality training application designed to help users learn and practice Stick Welding (Shielded Metal Arc Welding), MIG welding (Metal Inert Gas Welding), and TIG welding (Gas Tungsten Arc Welding ) in a safe and controlled virtual environment.\n\nThe simulator enables users to understand the fundamentals of welding by interacting with realistic virtual tools and practicing procedures without the risks, costs, or safety concerns of real-world welding.\n\nWithin the simulator, users can learn how to correctly set up welding equipment, practice with different joint types, position the electrode, and maintain proper welding angles and distance during operations. The application focuses on helping beginners and trainees develop essential setup knowledge, hand movements, and coordination required for welding.\n\nAdditionally, the simulator provides real-time analytics, including welding speed, angle, and distance, allowing users to monitor and improve their performance. It also includes report generation, where detailed performance reports are shown at the end of the simulation.", "short_description": "A VR-based welding training simulator that lets users practice welding techniques  in a safe and immersive virtual environment."}]}, "developer_name": "Naveen Roxx", "developer_privacy_policy_url": "https://naveenroxx.github.io/NaveeN/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Builders", "support_website_url": null, "website_url": "https://naveenroxx.github.io/NaveeN/WeldingSimulator/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27169282009408351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1701722944513106_5104724753996719264_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOBPqylCvd8Q7kNvwHJ4THD&_nc_oc=AdrJqJ9LLMqUQlbBG9quO0-OoAk7KBgMhggmCzQv7thdO2OKznJOByJ3BhkiJqRv9sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWSvRz_ujDIlKxKVIyEUbLxVofhG1Gk2jlDntSDP7-zA&oe=6AEB475E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Welding Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1775130120, "lastRevision": {"nodes": [{"id": "2519820810984
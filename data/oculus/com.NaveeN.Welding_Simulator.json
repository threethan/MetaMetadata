9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIeJHB1hBIAQ7kNvwEWt7yI&_nc_oc=AdrJaJMZk2izZ-tW1GZxaZxQRdh-GJg8eHsAFAfaLpkqV-QTX0AWq1MRKlK5Wtoe-KU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c-lO6rGzNcNHM1ssuNHcVf8QOTnLg0Y1t44MseoAv9g&oe=69EF55AD"}, {"file_name": "9.png", "id": "918315224492361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304229_918315227825694_9051846093010213892_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i17TmpZgjL4Q7kNvwFvuM6c&_nc_oc=AdocDiobjQqzvhoYmEUUBJDN11xv32keVUylfMeaJj7OAdBvB4D-QrRDWMMDIIDkxPM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eYHl4L4Fu8woks-qDiFO7Veg_dsxrgG_se0UBiH9jSg&oe=69EF6D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12.png", "id": "1170881038317153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824328_1170881041650486_6214734878361642161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEw4buGxF5EQ7kNvwFvKlrq&_nc_oc=AdrwE9LcMZG2xV17e_fDz2vxoyeVL1l7s1hphGoBY7yC-4QH1Pnik9-iGxerClbjKow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oti9fhv1JFsuhCpQ0mL639N5pjmnYrr21DK2D2bqGJA&oe=69EF785F"}, "display_name": "Welding Simulator", "keywords": ["Welding", "Simulation", "Training", "Safety"], "long_description": "Welding Simulator is an immersive virtual reality training application designed to help users learn and practice stick welding (Shielded Metal Arc Welding) techniques in a safe and controlled virtual environment.\n\nThe simulator allows users to understand the fundamentals of welding by interacting with realistic virtual tools and practicing welding procedures without the risks, costs, or safety concerns associated with real-world welding.\n\nInside the simulator, users can learn how to correctly set up welding equipment, position the electrode, and maintain proper welding angles and distance while performing a welding operation. The application focuses on helping beginners and trainees develop the basic hand movements and coordination required for stick welding.", "short_description": "A VR-based stick welding training simulator that lets users practice welding techniques in a safe and immersive virtual environment."}]}, "developer_name": "Naveen Kumar S", "developer_privacy_policy_url": "https://naveenroxx.github.io/NaveeN/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Naveen Kumar S", "support_website_url": null, "website_url": "https://naveenroxx.github.io/NaveeN/WeldingSimulator/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25198208069849098"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "926530553537504"}, {"status": "PUBLISHED", "id": "829065773432427"}, {"status": "PUBLISHED", "id": "1301919905132880"}]}, "baseline_offer": {"id": "1301919905132880"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779818400, "status": "PUBLISHED", "id": "926530553537504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26407790772224149", "version": "1.42"}, "id": "4242862676033390", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
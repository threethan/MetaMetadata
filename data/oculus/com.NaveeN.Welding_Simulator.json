QWCvgtKtPc0Y01D5eFZykPb5TCuHNQ3E68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CcI7I4ai5BTb1drowogYeSUat9TZVA6EmakobS3LfDg&oe=69F8A7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WS H.png", "id": "1327716505887017", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1327716509220350_7769931104683373273_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DSAHo1YLgMQ7kNvwF-C1AY&_nc_oc=AdqyrUFX2NsE46R0tS34b4gFvFhkEZf-N61sqVIg1lBAuHxVFutgQzhQlx-yVI71S8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Q7KGhlgZij0rThV2cYcypFmhRTwZNxW-mzQKtjk-e0A&oe=69F894DE"}, "display_name": "Welding Simulator", "keywords": ["Welding", "Simulation", "Training", "Safety", "Engineering"], "long_description": "Welding Simulator is an immersive virtual reality training application designed to help users learn and practice stick welding (Shielded Metal Arc Welding) and MIG welding (Metal Inert Gas welding(Coming Soon)) techniques in a safe and controlled virtual environment.\n\nThe simulator allows users to understand the fundamentals of welding by interacting with realistic virtual tools and practicing welding procedures without the risks, costs, or safety concerns associated with real-world welding.\n\nInside the simulator, users can learn how to correctly set up welding equipment, position the electrode, and maintain proper welding angles and distance while performing a welding operation. The application focuses on helping beginners and trainees develop the basic setups, hand movements and coordination required for welding.", "short_description": "A VR-based welding training simulator that lets users practice welding techniques  in a safe and immersive virtual environment."}]}, "developer_name": "Naveen Kumar S", "developer_privacy_policy_url": "https://naveenroxx.github.io/NaveeN/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Naveen Kumar S", "support_website_url": null,
zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af388F02XpcRTfWgR8R_68Do0i1fRFb7s3YvZPdaxDUE6A&oe=69DCE0AD"}, {"file_name": "9.png", "id": "918315224492361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304229_918315227825694_9051846093010213892_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbfZKz9F-wkQ7kNvwFdSnMA&_nc_oc=AdoWBY-dTk4rbeFKmGIA9q0Rcq6erZG2vxIeG_jBMWdYNFkZAfnjSt-BrEtAQ8A1838&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YMLj-OhGHKnmxJ6fv9EAXw68af0zwyuJAD6nEqffLDw&oe=69DCF852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12.png", "id": "1170881038317153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824328_1170881041650486_6214734878361642161_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2H9Kd4JoHQQ7kNvwHwzzS0&_nc_oc=AdpNA2Ctrug2nyj7_an4K66nDdfXp6i5aI3jVsmViBN1jiDkrW5CCUDAga52WaLGZ44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wWF9dImg7x-pMph5AGpY7ZpQMz0RbQ-oiODiOOFFFSw&oe=69DCCB1F"}, "display_name": "Welding Simulator", "keywords": ["Welding", "Simulation", "Training", "Safety"], "long_description": "Welding Simulator is an immersive virtual reality training application designed to help users learn and practice stick welding (Shielded Metal Arc Welding) techniques in a safe and controlled virtual environment.\n\nThe simulator allows users to understand the fundamentals of welding by interacting with realistic virtual tools and practicing welding procedures without the risks, costs, or safety concerns associated with real-world welding.\n\nInside the simulator, users can learn how to correctly set up welding equipment, position the electrode, and maintain proper welding angles and distance while performing a welding operation. The application focuses on helping beginners and trainees develop the basic hand movements and coordination required for stick welding.", "short_description": "A VR-based stick welding training simulator that lets users practice welding techniques in a safe and immersive virtual environment."}]}, "developer_name": "Naveen Kumar S", "developer_privacy_policy_url": "https://naveenroxx.github.io/NaveeN/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Naveen Kumar S", "support_website_url": null, "website_url": "https://naveenroxx.github.io/NaveeN/WeldingSimulator/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25198208069849098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1950558798869316_7437151890419980668_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2OI5qjXNNkQ7kNvwFiA-Ad&_nc_oc=AdofVZaR6LFxaPrs4Bf-3z0LDSM6-mWB4so3BvGck-ByyTh2X-Ic0wrMTF6OUbzU5dY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ttPpj4QdX23DFzi0j_nVCQXuS5tHLQc7bx4eD6fMV-g&oe=69DCFFB2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Welding Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1775130120, "lastRevision": {"nodes": [{"id"
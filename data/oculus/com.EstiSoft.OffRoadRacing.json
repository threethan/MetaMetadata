xGjlHvXwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsfE9yxNB2tUSNzEyZUMMKt4-LdCSzzqO3xJnUIdKLWYg&oe=69A5880F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1328335214894126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824592_1328335218227459_6623905544851205477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5JhfBdeygQ7kNvwEyW9FN&_nc_oc=AdlSO9uxOJRa1WlM-vRpuqtN-NJCwT0TZOcuUk8zU6mgq7kxbn92aVDQIZPWd1wmmhY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftF9t1HFvHLBE186sLShd0cegz1oO7gLkMEm-ZrtNr-Kg&oe=69A58CEB"}, "display_name": "Off-Road Racing", "keywords": ["Racing", "OffRoad", "Car", "Adrenaline", "Fun"], "long_description": "Off-Road Racing brings intense, fast-paced action to the Meta Quest like never before. Strap into your rugged off-road vehicle and take on thrilling races across challenging tracks filled with dirt, dust, and danger. Compete against smart AI opponents who will push your driving skills to the limit.\n\nFeel every bump, slide, and jump through fully immersive VR gameplay. With realistic vehicle handling, dynamic environments, and responsive motion controls, Off-Road Racing delivers a pulse-pounding experience that puts you behind the wheel like never before.\n\nChoose your route wisely, drift through tight corners, and boost past your rivals to take first place. Each race offers unique landscapes and obstacles\u2014from rocky canyons to muddy trails\u2014making every lap a test of skill and reflexes.\n\nAre you ready to take on the dirt and claim your spot as the ultimate off-road racer? Put on your headset, grip the wheel, and hit the gas. It\u2019s time to conquer the wild in Off-Road Racing\u2014only on Meta Quest.", "short_description": "Get ready for an adrenaline-fueled off-road adventure! In Off-Road Racing, take control of powerful 4x4 vehicles, race across rugged terrain, and leave your rivals in the dust. With immersive VR controls and realistic physics, every drift and jump feels real. Will you dominate the wildest tracks and become the ultimate off-road champion?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9584862478257791"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1609632003548620"}, {"status": "PUBLISHED", "id": "1793477971301014"}, {"status": "PUBLISHED", "id": "588957997571422"}, {"status": "PUBLISHED", "id": "1741368853427490"}]}, "baseline_offer": {"id": "1741368853427490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771358400, "status": "PUBLISHED", "id": "1609632003548620"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9586035658140473", "version": "1"}, "id": "1134937861769768", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application",
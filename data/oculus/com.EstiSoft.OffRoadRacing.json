MlUhP1JFc6g&oe=6AE352D4"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1435520624551464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819980_1435520627884797_6059285674357333933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEK2dw7aK48Q7kNvwFpIXog&_nc_oc=AdoAxhMQbTZz7unSj3vHUH4ly7qg_wj142pgBLaJVrcJp0_yM-GJ8HNEOQwateA8ix8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvq0I773N-l7XMvVXiydlwCX0YMqz2TLJ1sRsW1rw8bA&oe=6AE36782"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010710.png", "id": "1052182600163861", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821972_1052182603497194_2576934308269546494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VKF0E3AULcQ7kNvwFOlsXB&_nc_oc=Adr8e19H9sAvb4W044XIY7eYMmHB0YrfpY_v8w4iHuMOhJD7KpAmJPfbn6CaFDQA_Yk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSaDyEQMlgNo89TtbtiKd5E0N0Bl9_bNyo3k3K2FSQpw&oe=6AE35661"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010738.png", "id": "1074237311200872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821197_1074237314534205_3325356674526237372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGzHXNgcOvYQ7kNvwETkmSh&_nc_oc=Adrv6WESNxahDjAfP09XUQwbOcuICSYFkRlYEkWue6BwM0gHRoa4V1wTZ9QoVp3iFRk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd_ftSsFgTcwGe8zuOkRkfzjfUa6HkKPrLTEHAb02xeA&oe=6AE3418F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1328335214894126", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824592_1328335218227459_6623905544851205477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li_57SHXQzwQ7kNvwEEtMYv&_nc_oc=AdpDD5W8xGv8_Fw5_4JN7FE3J94yN0hTshE9_SlFRkaVll9iuj-_czQ3JDbb7jhswIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5smuh5VpA22t60TGD_18g75YnXdyS68u7DDmeolojrQ&oe=6AE3466B"}, "display_name": "Off-Road Racing", "keywords": ["Racing", "OffRoad", "Car", "Adrenaline", "Fun"], "long_description": "Off-Road Racing brings intense, fast-paced action to the Meta Quest like never before. Strap into your rugged off-road vehicle and take on thrilling races across challenging tracks filled with dirt, dust, and danger. Compete against smart AI opponents who will push your driving skills to the limit.\n\nFeel every bump, slide, and jump through fully immersive VR gameplay. With realistic vehicle handling, dynamic environments, and responsive motion controls, Off-Road Racing delivers a pulse-pounding experience that puts you behind the wheel like never before.\n\nChoose your route wisely, drift through tight corners, and boost past your rivals to take first place. Each race offers unique landscapes and obstacles\u2014from rocky canyons to muddy trails\u2014making every lap a test of skill and reflexes.\n\nAre you ready to take on the dirt and claim your spot as the ultimate off-road racer? Put on your headset, grip the wheel, and hit the gas. It\u2019s time to conquer the wild in Off-Road Racing\u2014only on Meta Quest.", "short_description": "Get ready for an adrenaline-fueled off-road adventure! In Off-Road Racing, take control of powerful 4x4 vehicles, race across rugged terrain, and leave your rivals in the dust. With immersive VR controls and realistic physics, every drift and jump feels real. Will you dominate the wildest tracks and become the ultimate off-road champion?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "6733851832
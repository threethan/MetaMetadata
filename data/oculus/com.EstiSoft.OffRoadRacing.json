5/491821920_1222285472600014_6292388590664720937_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M38mbyJWcCQQ7kNvwE5YmzU&_nc_oc=AdkfKmK0BmOU00Axh-diGbh8Ic37g8ipXphyTKRVt9NCMKBMs0a4sRdoFRR46F-Nf-I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs6KiRKFEQofO7xKwsoo_u4PMbWlMz4pMXVOW9TdVWgUA&oe=69A574CF"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010721.png", "id": "1222988219355229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828844_1222988222688562_2840047541969387902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sln-sN2noDoQ7kNvwENz66G&_nc_oc=AdmjTsR8gVh7IAjTHV5km3g0W198tJZ-Xu4yeLY1HOrvEjzeaEfDkJZSUcaDyYek1q8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft-LKx3Uy6IW4iVmspbSKQiYztGJo1pz262niI6-nlwEQ&oe=69A59954"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1435520624551464", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819980_1435520627884797_6059285674357333933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoDfbnIBMb8Q7kNvwGp8Vrg&_nc_oc=AdkfNSC0tJLsjSRy3FFXYfk0ud7CN85R6dWRRhxOPNZ9lpF06KoFvhCrtlXoKG2ZNLc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afuea1H9XfP5CZs4U8bJTKCQ1qqa5zCbRk0brW-EBMlUvA&oe=69A575C2"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010710.png", "id": "1052182600163861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821972_1052182603497194_2576934308269546494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=malkceaJwOAQ7kNvwHiu2lZ&_nc_oc=Adk9L9YvILz0iGcsFFSyZTEt3jhWs3bCbfgpeEfR2j8QtG4c3O5d-xOzFeQ5hotYLms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuRPrmGfAisrm0cmEqrDrG7mp30Sv_V183lSOOyJ1hjVg&oe=69A59CE1"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010738.png", "id": "1074237311200872", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821197_1074237314534205_3325356674526237372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W_LQJ9qT-AQ7kNvwHVJfbD&_nc_oc=Adk8X949QbLRUHWZ_Nuhc8woVilyV43-u78xl5lnEHJrDF_fbcN3_MQ_cIxGjlHvXwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsfE9yxNB2tUSNzEyZUMMKt4-LdCSzzqO3xJnUIdKLWYg&oe=69A5880F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1328335214894126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824592_1328335218227459_6623905544851205477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5JhfBdeygQ7kNvwEyW9FN&_nc_oc=AdlSO9uxOJRa1WlM-vRpuqtN-NJCwT0TZOcuUk8zU6mgq7kxbn92aVDQIZPWd1wmmhY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftF9t1HFvHLBE186sLShd0cegz1oO7gLkMEm-ZrtNr-Kg&oe=69A58CEB"}, "display_name": "Off-Road Racing", "keywords": ["Racing", "OffRoad", "Car", "Adrenaline", "Fun"], "long_description": "Off-Road Racing brings intense, fast-paced action to the Meta Quest like never before. Strap into your rugged off-road vehicle and take on thrilling races across challenging tracks filled with dirt, dust, and danger. Compete against smart AI opponents who will push your driving skills to the limit.\n\nFeel every bump, slide, and jump through fully immersive VR gameplay. With realistic vehicle handling, dynamic environments, and responsive motion controls, Off-Road Racing delivers a pulse-pounding experience that puts you behind the wheel like never before.\n\nChoose your route wisely, drift through tight corners, and boost past your rivals to take first place. Each race offers unique landscapes and obstacles\u2014from rocky canyons to muddy trails\u2014making every lap a test of skill and reflexes.\n\nAre you ready to take on the dirt and claim your spot as the ultimate off-road racer? Put on your headset, grip the wheel, and hit the gas. It\u2019s time to conquer the wild in Off-Road Racing\u2014only on Meta Quest.", "short_description": "Get ready for an adrenaline-fueled off-road adventure! In Off-Road Racing, take control of powerful 4x4 vehicles, race across rugged terrain, and leave your rivals in the dust. With immersive VR controls and realistic physics, every drift and jump feels real. Will you dominate the wildest tracks and become the ultimate off-road champion?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9584862478257791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824618_1736984693574375_4114685225111037205_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp407B3kFEMQ7kNvwGprc0M&_nc_oc=Adno6X9FwGyfmN7hTBSAVKCJxuQWGJcA6pEj0JhHjj-ZPUG3wHQLc0hHvbgNqWWQ7d8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvv6Yj6k4Ee4LcxDat1OvejyNvw45qiVL0FiOsTBX29Zw&oe=69A56C5D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Off-Road Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Simulation", "id": "33
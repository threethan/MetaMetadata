y8dlZ5_t_Pg&oe=6A184BD4"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1435520624551464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819980_1435520627884797_6059285674357333933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDSFmib9o9cQ7kNvwE6VLKQ&_nc_oc=AdoabbH2XM2bet9dtoQfhhnMAjbaSJHTaea7CbMoNB9mr23BHXL9L4J7deoiTYQzfbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eiMGUj_KdFAynJ65cdwHRPnkNu00x8pwc-WvhgFSbzA&oe=6A186082"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010710.png", "id": "1052182600163861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_1052182603497194_2576934308269546494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzVPQnbS1R0Q7kNvwFik3Uu&_nc_oc=Ado6HAciIjzKx6uk6VHQ1mH1Wooy5NqJ6NM-j4k4Er5yOT2vDhMJ7sXncHClgCGpw7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ItYe55m4SKqr2IvGcUhNwQMAfzglkvZXkviYEyrfpA&oe=6A184F61"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010738.png", "id": "1074237311200872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821197_1074237314534205_3325356674526237372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l47OxugMNwQ7kNvwENx3I9&_nc_oc=Ado7A6V7xjeQnjrYr4oS7oI7w9xM8HXVmA9hdjJ7T1mHI7s5WpZ8_TrJ7fQBCalKWdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59tRIVDrxj77mSFeHN2hFPcb9xAJnUtzMd8NGN36tZYQ&oe=6A183A8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-07 010750.png", "id": "1328335214894126", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824592_1328335218227459_6623905544851205477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oke0xbgWKL0Q7kNvwEsT8kl&_nc_oc=AdpmRjadmXikPBiAMi1ynYII1i7SM5VB2op02PDdubfl4wZBCTnzrSRmdy4HcJ13kNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QBoPZcwe4ygOmXf00sgT8DPRGzJAG0OycihAuhLQmVw&oe=6A183F6B"}, "display_name": "Off-Road Racing", "keywords": ["Racing", "OffRoad", "Car", "Adrenaline", "Fun"], "long_description": "Off-Road Racing brings intense, fast-paced action to the Meta Quest like never before. Strap into your rugged off-road vehicle and take on thrilling races across challenging tracks filled with dirt, dust, and danger. Compete against smart AI opponents who will push your driving skills to the limit.\n\nFeel every bump, slide, and jump through fully immersive VR gameplay. With realistic vehicle handling, dynamic environments, and responsive motion controls, Off-Road Racing delivers a pulse-pounding experience that puts you behind the wheel like never before.\n\nChoose your route wisely, drift through tight corners, and boost past your rivals to take first place. Each race offers unique landscapes and obstacles\u2014from rocky canyons to muddy trails\u2014making every lap a test of skill and reflexes.\n\nAre you ready to take on the dirt and claim your spot as the ultimate off-road racer? Put on your headset, grip the wheel, and hit the gas. It\u2019s time to conquer the wild in Off-Road Racing\u2014only on Meta Quest.", "short_description": "Get ready for an adrenaline-fueled off-road adventure! In Off-Road Racing, take control of powerful 4x4 vehicles, race across rugged terrain, and leave your rivals in the dust. With immersive VR controls and realistic physics, every drift and jump feels real. Will you dominate the wildest tracks and become the ultimate off-road champion?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "6733851832
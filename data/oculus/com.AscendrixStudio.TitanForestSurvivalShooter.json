me": "SS 4.png", "id": "992277843512973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593990472_992277846846306_3047931426836496962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA-1QENeIuoQ7kNvwHXjN1z&_nc_oc=AdrfB_PXJ1ByBO_GCL87Rqm_tvcqSGnU_XVXmjEAysMCNT4cRg3coE64uOTo3VtDdeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIFOqphLTYNERz0KKXTPlZa3xipyM1bOl325H6i8LOtw&oe=6AEDD47E"}, {"file_name": "SS 5.1.png", "id": "2227437014689728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_2227437018023061_8250838492294720504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjKU28VyVj0Q7kNvwEMJzg_&_nc_oc=Adp0RUWHJGDTwJm-yitZ27y8mzS8GWrEgMugO53x79AX75X2_JUfp8npq_IWfYe5VNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlxNGSBMbRvvG71AESYsM7NPwFbrVIDWfVikJl8E6tvQ&oe=6AEE0553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560x 1440x.png", "id": "998756206298315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_998756209631648_7084825049551000415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XugO_yoUGpsQ7kNvwG3uPX6&_nc_oc=Adroz4mR12j3Pp1ujisw725-PuzE2shsg11QwuYppxFfWb031RFCysBlwljItGfLh9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYWpe0N2odoU8nHJNvGsCGBLvs9TkAuXZADqm8EwpGPg&oe=6AEDD674"}, "display_name": "Titan Forest: Survival Shooter", "keywords": ["VRsurvival", "openworld", "Titanbattle", "weaponcrafting", "forestsurvival"], "long_description": "Enter a brutal open-world VR survival adventure where every decision matters. Hunt humanoid creatures, track monstrous worm beasts, gather wood, craft weapons, and build a safe house before night falls. In this action survival game, you must scavenge resources, upgrade your gear, and fight to stay alive in a hostile forest.\n\nExplore a dark wilderness with immersive first-person gameplay, crafting, base building, wood cutting, hunting, and combat at the center of every moment. Use your axe to cut trees, collect materials, forge tools, and create weapons that help you survive stronger enemies and boss battles. Every resource counts, and every weapon you craft brings you one step closer to victory.\n\nFace creepy forest creatures, humanoid enemies, and terrifying worm monsters as you progress through the adventure. Build your house, defend your base, and prepare for the final challenge: the Titan. Only the strongest survivor can defeat the Titan and unlock the next level of danger, discovery, and reward.\n\nPerfect for players who love survival, crafting, action, adventure, monster hunting, base building, weapon crafting, and intense VR combat. If you enjoy open world survival games with a raw wilderness feel, dangerous enemies, and a powerful boss fight climax, this game delivers a tense and satisfying experience from start to finish.", "short_description": "Step into a  VR survival game where you hunt humanoid and worm creatures, gather wood, craft weapons, build a house, and fight to survive. Explore a hostile forest, collect resources, defend your base, and face the mighty Titan in an intense first-person action adventure packed with crafting, monster hunting, and boss battles. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/titanforestsurvivalshooter/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/titanforestsurvivalshooter/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
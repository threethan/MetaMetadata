q2kXmNy64MwRAG7jMy7lwL5DNXkzQ_bywfODg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHxS330tI6AW8iUxshNcFjKoYe6eV53iqxBQkB3WXs0w&oe=6AE35ECA"}, {"file_name": "Screenshot - Jeff Winner Pose.png", "id": "1835736590637012", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820441_1835736593970345_9165624188310989171_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFJpQVzQZ_YQ7kNvwGPhEMW&_nc_oc=AdorCQfrw5CK-mfkOhWslB9c9gn8Rh6dmVZWor29YR0v182IC0wdO_acqCtZUCw06Sw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMifM8owltcj5M-fusE8DP2DujF7R_UbfJgWvJZIjmdcg&oe=6AE36629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer 1 Cover Image.png", "id": "874538758382160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823448_874538761715493_1272359225294634061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6hEDzhpnXIQ7kNvwGVeFrs&_nc_oc=Ado11Vcykbfph-GpYGUuLwMYJgWe08E7WwnE_LQRijZNcfk_Gqk8s9m3buRaFY2SESg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPu1jrUWb_ZDlW4iaGtOQF4kyW-G-VipYKWc_qVP65Qg&oe=6AE3446E"}, "display_name": "Big Bang Ball", "keywords": [], "long_description": "Big Bang Ball is an intense, futuristic VR sports experience that blends the spirit of paddle tennis with the thrill of explosive sci-fi battles.\nYou play from a first-person perspective, wielding an energy paddle to launch, curve, and deflect a glowing plasma ball toward your opponent\u2019s goal. The catch? The ball can explode \u2014 and timing is everything. Use power-ups, shield bursts, and trick shots to dominate fast-paced matches where skill and reflexes decide everything.\nTravel through a series of themed worlds \u2014 from the golden desert of Pyramidia to the icy peaks of Frosthelm \u2014 each with unique arenas, opponents, and challenges. Commander Noelle guides you through your journey as you climb the ranks to become the ultimate Big Bang Champion.\nDesigned for Meta Quest, Big Bang Ball is easy to pick up, full of energy, and built to make you move. Whether you\u2019re training solo or (coming soon) battling friends online, it\u2019s the ultimate mix of sport, sci-fi, and spectacle.\nMove fast. Hit hard. Don\u2019t let the ball explode!\n", "short_description": "Step into the arena of the future! Big Bang Ball is a fast-paced VR sport that fuses paddle tennis with explosive sci-fi action. Deflect, charge, and smash an energy ball through your opponent\u2019s goal while dodging power-ups and chaos. Easy to learn, hard to master \u2014 and impossible to stand still!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrfriends.org/produkte/bbb-privacy-policy/", "developer_terms_of_service_url": "https://vrfriends.org/produkte/bbb-eula/", "publisher_name": "VR Friends GbR", "support_website_url": null, "website_url": "https://vrfriends.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33204987209114825"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1391902452268569"}, {"status": "PUBLISHED", "id": "27747459874949999"}, {"status": "PUBLISHED", "id": "1585714296591458"}, {"status": "PUBLISHED", "id": "2157770374797673"}, {"status": "PUBLISHED", "id": "724865800686625"}, {"status": "PUBLISHED", "id": "1831405170832869"}, {"status": "PUBLISHED", "id": "1786742305320419"}]}, "baseline_offer": {"id":
"id": "1192035056087480", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_002_0005.png", "id": "2016141535977301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_2016141539310634_6712321427259261072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXgPO48Sm-EQ7kNvwGNYgJa&_nc_oc=AdozT5tDs9q3RtGj4isr3978Js80O7afzXjC-vYzuNqrlrBINs3GMkN_rcYFMlSB4PI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsir58gCSaXEIuA4a5ldQhIZrWBSIpUZATF8XplhCp2Q&oe=6AB53A9D"}, {"file_name": "Image Sequence_001_0012.png", "id": "894224239868178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_894224243201511_6484439723432924429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiYmc6Iw78AQ7kNvwHdbu2n&_nc_oc=AdpNEk-72_wP9xXGhgr2LGHZHnY-p0ff1UhFJ7OeHe9MJSSMjrp1L6LeMw0rw1sig2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBcB0YVNhR9ObgEYE3yaGQC2on7nsrFqekBnHFZQ4rGA&oe=6AB51BB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odPsci2ixAMQ7kNvwE2DZMw&_nc_oc=Adp9RW_A2wD0QF3fdVcVsJVATILx2xZKKSmA3Drw9NL1D-LDTfL74kj2BGaNus5rfZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCdDf1KRjcxMhP_WHP3pMWrnjAi8esGd6cv5SEmt7_oQ&oe=6AB5486B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWvczLg1i00Q7kNvwGR2cmM&_nc_oc=Adq0A7ngX71xUkzSkqpWBdhLZmJvW8aCjBVRzOf-n-RI6zaANwe0762Jc8HCYYJYh78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIECcASDXyFGhAfK04e4-a2x-9tbzDRXyR9_S8_wAiy-w&oe=6AB533D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBW7LulL584Q7kNvwFgumBU&_nc_oc=AdrijfWFHDXk1RQK6HVN0Qn0BijLNrfGZWI4tBsV3b9Ddsf1nGYy1LiIocuCEL1qpHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbh-Nn2Hv0VdPrjsfI5HCTtm_xy_bLjTgjzpvTXEs79Q&oe=6AB51C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBKLl-G9owQ7kNvwHx4H6m&_nc_oc=Adqs6cgbDA8KX56WrJTmOaR7mp06ht0Cked50N8vjmElJGogIX1wDFIiE5pdBeYJPPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0kqUK0qs1H2fwoiqxEP5tZAa-p63b6K2Zy8PhYNmmGQ&oe=6AB5166F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1055460340222943"}, {"status": "PUBLISHED", "id": "1511543683994515"}, {"status": "PUBLISHED", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "26878243418476573"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1055460340222943"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id":
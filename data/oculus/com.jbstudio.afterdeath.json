Q7kNvwERSCxA&_nc_oc=AdpixvTs9bsYTB4wCK9FfvUV9gZOkAs5ORri__YjjlzfO_EM7wekPZ5B93XCvXdo8UE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECxWRg1iQwiXAsY899eYKqWEIza5iPrw1K1AEIb74SQw&oe=6A95AFF7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyANmtVdeA0Q7kNvwEJPEPV&_nc_oc=Adpe45ruMhcyPBwDt6i8mOxpWaN46-ZVXSUv0BEkXnBsLmfVhbWfRWCgFVF-omkVLnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3XiODu4KJhkOIprvwTQoy7SJFBaFlD7aGUbVUK10Sgg&oe=6A95DCAB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYwHX0IUhZUQ7kNvwE8_g5g&_nc_oc=AdrJRM8jNkhOb56MDBtNEiXCVEkDZuFE0wAgcANZ70F7Cuq8nDyW02oeuHOZHJxGKR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqIHn_ymGxJYZYYpBSn5lnLizCI4vd1sFQ9SbFUUVcHw&oe=6A95C810"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv_P_ME8J1UQ7kNvwE4OGEl&_nc_oc=AdpokJh1s-K8defxYV2mAiZpPu-rfUo4FwLvCkSPDTlr7wsniy7sDgjHP7R9QZX_En0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI5Vn4TUlknjdgzo0DGPBv7UDd5Q_vpshiSWRpqw2RZg&oe=6A95B0D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QLCammkt7IQ7kNvwFSnchz&_nc_oc=AdrEc_i9Pw1Nc9CbYyhfKHTfvoUnYPpmiANyfWI-4852UAx9eMbZHqLeAZRRn0Nqqak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdI6f5J0MWfkBgju6TxLiCqWhnJitc0srDR14gJXkWhg&oe=6A95E2EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3e5Mmo5t7uHF2UDu-mK2sfdGLEPVOPl16TIg5KDPaRQ&oe=6A22FD77"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxY-AfHqmKoQ7kNvwFPZOFp&_nc_oc=AdrNDVw6T2wUL1iPvq6AUKQ_vwNGLluS_P3jYQE8vjw9alxr6XvtbjzNj1T6iQ5C_N8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g7-Y5Xngd7oEC3ukZgupwDSjIO5d6uhR7f80v-9rhUA&oe=6A22F1EB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V72IvsMDOugQ7kNvwGvvKrd&_nc_oc=AdrdUY9RMZEF9uCsjehRjwZhevg_un7DLvANHvgkIjU4lolBvd5crbY-IfuEJHBzGyM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8vE1O3IC1XRkE54AJq-Wcf_Qv1RWCCtTB4MFJPV-1rw&oe=6A22DD50"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKeoXH3c9x0Q7kNvwHaeNCY&_nc_oc=AdoCn0i7LubHecwxaVhtaNmtlkheCT0etAdDHyDzXK4JLmS8cYed-G2Q84u1IqvxtgM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LXDa78bS6n7HNJ1C5Un_JoSuUiW_NboS5lvYAAeVLkg&oe=6A22FE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFCZzQl2a_YQ7kNvwFDRqon&_nc_oc=AdrnAv1Xa29jgxfZ0riKLsd3Wt8Jy-4ERoRwi3VT8Qe6rWNdz7FKJs3Of-qJZIgg2ro&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U198uIZ9eHRytMbx74pxEx4JaEkb5wwRV75hWEL4cOw&oe=6A22F82F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
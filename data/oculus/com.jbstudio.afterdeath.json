uscdn.com&_nc_ss=7f20f&oh=00_Af_MLbpWMak2FGs3wyK6iyhFqpY5s8WfRhY6q3q4cZ_fUQ&oe=6A3FC637"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5mbwfsSlCIQ7kNvwHGE8ai&_nc_oc=AdqSfvv8QEGAqEAuU6UdPWWG06nb6AeJlTu7YAD8-Fbu9Zz9ncETiAeXpNdrJTIFq58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c6443HGDZUn3fvEOuoJ_hoXwzHx-smkdUG9ttCD4Gcg&oe=6A3FF2EB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kaIzRvp4SoQ7kNvwElYUuS&_nc_oc=AdpF7lJ7yvkubrNz7sbr2hAcOJcpkUto18QchlgPk7E0QLDNSFfjHiotrURUxVlFhoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PzcK_BTcYo-rfReGNjV4hxj5fCVvoW0n9bzXHCMVGEw&oe=6A3FDE50"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWPE0kHtSiYQ7kNvwHUohqy&_nc_oc=Adq2fpDbLoSYlX2CJnwOKDEYrVXs-9XHfeliX4S7rwZy7pX_lq9AVeMkqsOCqMyoHeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KtDzWy4UA-GfvIRpCeGSnUTA8bCSz5mifhUgzrJIp3Q&oe=6A3FC710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ST-7l7IJSYQ7kNvwFYPUve&_nc_oc=AdoclB-Hv5uS5I1N-oWadsTn-Tj3rj0c-SRrSAf58SHBN7_bY31bsaIMUOefiKBQ0gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xEJ3iwRUpeiOJk746y4VSRRLJDxhoalUV--M86mCSew&oe=6A3FC0EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
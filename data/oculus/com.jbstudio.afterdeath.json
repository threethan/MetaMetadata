scdn.com&_nc_ss=7f20f&oh=00_AQD8kCIkDVVb5SPCapIC-jqavbL8k6Qz4iD3L8Ixxw8bog&oe=6A54DE37"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHkFUiLrcgIQ7kNvwHqJOgN&_nc_oc=AdpvCuTSKh5Bv0YF5NgdXl_71UIt5R2UCR2Jp4SOdQa2DlJJuPm9AiB1lvuWezjvTI4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClcNCFvNZFY4rrfMtl0TzF9erm04OQGlv0ZqgWbMchYQ&oe=6A550AEB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV9_tNsM5WMQ7kNvwEfz-mg&_nc_oc=AdqiAr1-DC8szcLoUwpz014ovcqD0Vf2Si2BhH1R6nxX1tzTPhrbfX15QUfVAR9R8_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh6EmrQmXtsLcpveqBx94C5GacTzVOltXMy-pXmiicyQ&oe=6A54F650"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L5Z0bLaQ0kQ7kNvwGJYgOX&_nc_oc=AdozERDUOZ-L5uD7goZrOxcWT0IZv4tmB8V3Fz2ztXy5TMBcRMu-DMo-S0Em_QmnLsk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm9ajDyFqHL4IzQCrUdrhjTfg7INcUoQDCBaqMeebOvA&oe=6A54DF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz6eeSGgJXoQ7kNvwG1lqqY&_nc_oc=AdrUdZdLVEKyfqLG3D_NM-SM2pen_uB616tDiWYd4v8VM54AQYB4RLQuQOJssVI1WwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvplU2o9k7ySoS_HkhrubMk9oRAR_AboiSWno5j5u9ug&oe=6A54D8EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
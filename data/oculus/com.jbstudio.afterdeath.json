Q7kNvwHH-4ya&_nc_oc=AdpQb1ImkR6HzLdOy2PPJF0qYgk7T8x-wlPvTjvrlhBath3lxwfy9sWPzV1lFJV3yXs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2amelysP2k7kDMVneWaRa1z7UFsz1VJnjwohxbiBlgA&oe=6AA15537"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=halTauymkpQQ7kNvwFtrCti&_nc_oc=AdpZ1qVvLQvxSOccehUnj1FJU7ARbZybfpg7VRHEaV9BXJTC8ph33KulkHup0MVpfyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYSVN4ratVM4WhPIp3zVYfbawh4s90T4gQl_WbxVnPkg&oe=6AA149AB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibrgi1gUoD0Q7kNvwGFof8Y&_nc_oc=AdqWduG5U_97QspTr2GnEBW-YH4u4Y8h-aAiqDdFqrUEUfNtFvRNTnIlsy_YGs-jlv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWtm_1PEO6b3zp3xq3LGPJ0Tdm20DOURCem5Tz35b7Vw&oe=6AA16D50"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knv0VIloWHcQ7kNvwGV0ZOz&_nc_oc=Adog4Mj13fVAG4X8O7g5OyU0G1REL8VVUO5NuUgtnxvAAnrhPkd0Xq2RO0GEpGJgC94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn4LCyq8HuCV0wAFqpRJ7fUzNeH0Mh2hF5osiwqQLBvw&oe=6AA15610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el5bkucupjYQ7kNvwGQT1C5&_nc_oc=Adpnp3hg6uWhKMj39F7awU-149nthtQ4ezTUWbMvmAD4kjuY7_aJJvJN3dvMLJfvRYU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLunZOc5AKvC-EhmHDtRZKnmHi_q9NXv9kxYvfTkAmj2g&oe=6AA14FEF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
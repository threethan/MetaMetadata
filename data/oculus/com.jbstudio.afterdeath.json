luscdn.com&_nc_ss=7f20f&oh=00_Af7lJUP3F7rCNfqE8tmF0qH324DmJkplOhsClhdW1e5kLw&oe=6A12F337"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH9FPU4k5CkQ7kNvwGDMXBX&_nc_oc=Adp4vBombKVnV-iCYiHIuI4nCpuG_cjTXsoXpbztQ4zWCLdfWo0B5fosQZtiNZx0coo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qEZJTM9w1Zua5G3sA_UXk_zacgLVen7rkcPOjKYkk0g&oe=6A131FEB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1m7LIq_nJ4Q7kNvwHSDFDq&_nc_oc=AdodSgzOWNxQ4V3qSEcgCdY8Hqtv6GE99B50SXRrWiBoWmSn4_sAZtRjdWP--BjyNhI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lIsPr5nGcdH9qKIrgpIIz3IQtJBjWWe-WYAa_bLHi2Q&oe=6A130B50"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFnslvDW1CUQ7kNvwHmf_Hb&_nc_oc=AdrGexaDrn7m3EveOUJCLrW529V22riBCmxH0kHQnAnI0IV-MPLnRc5X3f_z-AmstBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nNsuqcqlTHWh7KY_P5gJGVvGu3JqssGCR2rMX9DcSPg&oe=6A12F410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mjgTSYz_3QQ7kNvwFOtM_d&_nc_oc=AdotrJk-RSrtHnpB1o1yCvlE7xfHMy-OGlJQbvVY_t68MtYo4pKMwfjg5KZZFXpKx58&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sId0uCkh5O4daNgFvzx5yFkVibsMtTrWFjBcQQGeL9g&oe=6A12EDEF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
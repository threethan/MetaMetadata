lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfWytTjz5_PYX5hTcFj0G6QD2RJAYoHSqOydn8ZBHvUA&oe=6A85A5B7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPceWa-f3uMQ7kNvwEgAAUI&_nc_oc=Adq54GJjrCe2IfTIl7y8dkDSu4Oup6zKk4iOnE-f1P8EtsoCuWs_v6paBH7CKjL9koc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2V6nXPmt4nunt_5Ch22ttmCWjtK66zoTyelB2ZuTung&oe=6A859A2B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OIChxhkZE8Q7kNvwF_B8tQ&_nc_oc=AdqzeQpkkoZkzwoK4wfPz4wz4OI4OkFu16ylyp1wP1G3RAmpdwRcw-brh6eM7tczZRM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnIVydvzTUA-SWk_X_BCKSTJitetTay9EAihTm_oCymA&oe=6A858590"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK00w9xpWTkQ7kNvwECNB-7&_nc_oc=AdrKQ3m5Xts4Wjv69lGjzf8_pWtp-RjX21VWRYptHEyeTz-60vkA6JKoVSyBJUSeOGk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb9IaemW3Je6YfGSmDy9x30xxxGQR8GjHyhY2RS-iriA&oe=6A85A690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i2Qq9kADYEQ7kNvwHPDrV7&_nc_oc=AdphaMmomPVQYZraANCnfaGpEMxkMvj8o5KsQrB2pz8GM80WeEpXtAsQ4Ca0LeQX2dI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs9ONVoikPNL6PjGZd6NLT4dQwbgHfxmyYgYoLZ0AHMQ&oe=6A85A06F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
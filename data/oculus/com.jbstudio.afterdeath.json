oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ORLKyyAocgh_kiFbLqIpgBEc6bj6BPPkj0dThg3dcgw&oe=6A392EB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehkx5Gu_JTIQ7kNvwG6beb7&_nc_oc=Adr93GyRbLVNatpkhVAub92ZjBHlhmIJJ2HvBgEB74tSDDp4jzkOukkxTsuQkaFrOUw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0nN79lxDxe6TsV1Va2dGt-eMUhVN1JR2qRS5p-2fnTA&oe=6A395B6B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezRF4yy6WWAQ7kNvwEWjtVa&_nc_oc=AdoEd5ZqdoQ8aRxb35Wjf1kmkysc7uMRaV5jD88h6b05hhA2c_7ntO_pSXnXdTdOP-w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8neQRhDZGd3PFcLXXJEkbyAiE4_ZbcPjqjRoV2hnESAA&oe=6A3946D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksES8UcHMEAQ7kNvwEOZivx&_nc_oc=AdqMW1b3h42oAHg7sLfEGTsZKyg1MDlp3vTAtqfMSamAN2OazAtCKD45SFtjy70CUnE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pmJpnfGfRHb22WLr3R2XQ2QKQyliikh9iyfGVTE1cqA&oe=6A392F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wi2LPmPvd4Q7kNvwEnA8xU&_nc_oc=Adqj9UdrNv1az1mACw24tcMzrxuEzEsb3Hy7LwZ-7xLmEbobkS8XHkmpcj1owYoW4E0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B9ey0DzoTIePDqr9jR-7wjKj1qhr85u5xh7be4uASnA&oe=6A3961AF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
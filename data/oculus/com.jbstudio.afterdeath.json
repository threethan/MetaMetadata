culuscdn.com&_nc_ss=7f20f&oh=00_AQEAXP8bdCeKb9jZvuJg_1Rc5cRRc2mrHboqd0YKXSJ8Og&oe=6A7DBCB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY-mDwrQOr4Q7kNvwHDuMEn&_nc_oc=AdqpMoZ1R604gvG4bdB_IxXZyuBvVSO5-UQilQ2uQoo8tHNcIBeeSfaBGB7ZvhrL5_U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3PzU47E3PhMyyeU_iM_5GQMabwb2BjeLpVCH_MA33_g&oe=6A7DB12B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyaHk_cafZ8Q7kNvwHU74gt&_nc_oc=AdrxVRKVS06A3wRze7CL4Oz-fhJ927_R0CIgRQLMuQ7xqEkZIYB7zM--mP9T4TeX0iQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa5DzyUWalXbo4z0vyHSekqc7SApr1ooYUdrUa_8NchQ&oe=6A7D9C90"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKc2pydKq7wQ7kNvwHFOlLS&_nc_oc=AdqRwxW7VQ9ghviFzk-wsY1O3WK3cX5ijWf9qpOc4XkRiiIQkV6hJ89PwWxD17qfiws&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb-ZaSYZc0o1GUHJmIv2dekUeQ8TetjUilpfPYW0wvQw&oe=6A7DBD90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B_PRIYUeu4Q7kNvwEoclmM&_nc_oc=Adqb-Oj6b0aQOEDv5noj__SirsXKe4zbiyTQUYYjXF9w_pD2XnBZNnzk0PY-psD3cFo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6DKw4DhokQUPhoH-xUvf9Yn7qCAcItIdAz2z2OawxYw&oe=6A7DB76F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
eath-2550.png", "id": "900489279570390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HwitTzq1UkQ7kNvwG6Biuo&_nc_oc=AdpRcTR_jMuKDXQMHgK7SjW-t8GR7cB05w6dARHMyqXCBBcPGFHSeZt1Pj-CD2kS-hg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm7wWcnW1ORtRBTxlkHuivQ_rVPVFHqMA_HAJSL4-z3g&oe=6AE09E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrs8Qc9gzeMQ7kNvwE0I2iK&_nc_oc=AdpWvdYjCDyWzBdfwM4kybw2dOrz6W7Nb_3oqlhs3GXgryvkaReG8unXv-pS5C0niu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9IMsUCoFXDnxP0OLeZwftTA6xVhieW4xjHr7j57jP7A&oe=6AE097EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1419428466325658"}, {"status": "PUBLISHED", "id": "1055460340222943"}, {"status": "PUBLISHED", "id": "1511543683994515"}, {"status": "PUBLISHED", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "1419428466325658"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792057020, "status"
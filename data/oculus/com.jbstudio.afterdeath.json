=c0RmaXT6sNkQ7kNvwEBB5fr&_nc_oc=AdoaM-C_d1Tc9V1GL1zkfe00CtfPbavo0SJL9y-RPNPmIt02-L1yIuHwgSeCgKbvyX4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhPcDKBs0GION8-VzYV3YqnoyD5A4bEMgHSctPObEWfw&oe=6A8D8EB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5GakcaAjt0Q7kNvwFI8EcY&_nc_oc=Adq6AhNPQAYM3DTfZKUyR9UmNMzcPsGLTGQ-ou_u1SPX71RHql8QLOTTs83CxKcmH6Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExMH2rhm7Vp_pIjvUu_3xeK_Y6mjHNWrTxIU06CTsO2A&oe=6A8D832B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWB22GB9gRsQ7kNvwGPzhVP&_nc_oc=AdpPtcb9lMn-0p69T_12VRnic9UD0XwHszK_UNIoKOuFLaQCr4aW4v6kGBAxvlVXCz8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb_LhgOj-AcnyNpfSQNAvv3mjfRbuayi_AAS-QNWnKYw&oe=6A8D6E90"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1llbUpE6S8Q7kNvwHwLRcc&_nc_oc=AdrDoEjpWubLleUWQ8DpNtfngWZrMCWhzhK1I23q07H_S8Hgj8rDLMvTkTnuxZ7QRuQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2huQA78ySbkep-n1haOIU-MC48RYoQ-oDoQqcppAHrA&oe=6A8D8F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjn3r-gz_60Q7kNvwGU49az&_nc_oc=Adr1RhNjzEsAfT9u9Uc9pjL752GQnhaH_XXX-HBN6dy45MWN-d7kZibz8GhgNd6UUp0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh3Qc8w0z-4l05a5omL4Vf2FOjrwyNhkhOk3L3u1MObA&oe=6A8D896F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
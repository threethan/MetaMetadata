UQ7kNvwHLNIPp&_nc_oc=AdpyzqJigCBXEqtZfaIhGOSsVMqF42TnN7fSg_SEt2tB4O9Ui_d-wTlbQ9zWvsqL61Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLp3LVBqbxu-RyIV3qK6IfBxdbt-PW4HGWral6_omC4w&oe=6A4BA3B7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFMl5arD_XYQ7kNvwG3JbPA&_nc_oc=AdouFTTMj19RNI-SRDu0_2wT3J53ifYLpnzfylcqTLC59xri0kfUrJE_F6Z9v5qkuLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDagHWwCzn-xOJOAkZjDwrN1nnOkLeeuEb8QrhTy4iQIA&oe=6A4BD06B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0XZzWnYMXsQ7kNvwEg6FXy&_nc_oc=AdpDLSlMqKpxrcBlP3dopWJDVzFtn5AftZP_ARenmuqdPmQFKpfQZNWYIaXaUWe_yFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzdMhRH6QhNDPgfiixzY5nNjFJiF1XtAa3I-OZvcozjw&oe=6A4BBBD0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ4WZlDyeq0Q7kNvwHppmRX&_nc_oc=AdpyFKGxA7w6n3hrvViTfZcDgLMxNSkwzcBmkcauMEzgKUxNQgq7t6-wuSNFGhhBgmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeU_YVtlWgNVxRJBFAQcr4SKXszWnFGZYU0af1tj7o2g&oe=6A4BA490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqjLmzd0_8gQ7kNvwHs3orS&_nc_oc=Adrh7DmX3ReV1TphwAiKKcvrbYUS_ghsqbL5IB7Jx8pdUJx_VtfGmbweA0-Zw0pSlts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0wZ4-jPIYGYzfK_s6SGiNI6uIn5Mq1sKmIFyyT5nzYw&oe=6A4B9E6F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APP
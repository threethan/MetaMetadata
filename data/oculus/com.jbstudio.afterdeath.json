 "1192035056087480", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_002_0005.png", "id": "2016141535977301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_2016141539310634_6712321427259261072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRLshMYlz8AQ7kNvwG16nxb&_nc_oc=Ado00ht5EH1llVlzk0l5jJBvdzSN0NwhhTHW0AwWdcU71t4M8TkE7-KNNMBhquYjDlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gTzg6K7C3W9Ze-RLjWZZcRUMSo9LzVqfJkm5FPXotmA&oe=6A08861D"}, {"file_name": "Image Sequence_001_0012.png", "id": "894224239868178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_894224243201511_6484439723432924429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NOgdJYXK-EQ7kNvwF2aSav&_nc_oc=AdpSdxXu9l5WKnf2HV2sQue7d95MCmdUVi4MK7wnMBKucOfrB-XxZz7AbOAbnCq1N1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zevho_GyMB9C-Ux6JOONuwK3uN4Ge-k4eV2XvbTacbA&oe=6A086737"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W9oREVPv64Q7kNvwF9ts4v&_nc_oc=Adp6rZfkgiQOB9L1nqSjpSdsYefmeGp5Vy5DNpE_eqYljgAI_OVPbaYiLrEA_70t-6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o2NNIOJcqQszIwBol2zfLt5M2LTV_lNNTAqjkdI77LA&oe=6A0893EB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGD8OZiFuscQ7kNvwG_MdGy&_nc_oc=Adqe1jIh8tmW1VFDHQz5r_X6FM2-QTJ1aQ5m9YUkLdN8pzrmA3XCHLIVQiGUhB_c6Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-WElhxnI9QQgNf5HTvpJOvG2XL-4FXQOk5_K3t7tcjg&oe=6A087F50"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_vnbOGXcAIQ7kNvwFw3-bd&_nc_oc=AdqLiG0S65YnoOX6_nZ0FUXdujH3ntTZ3nVo8w6HdbVYbnLYg0NGe11SKRlOm4dxRz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AMwoElTnJTD-p9o9Q2yokMRz84rA-rRKmVVjsd3wIxQ&oe=6A086810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjos6NNdLPIQ7kNvwEXE9wO&_nc_oc=AdpM07f4aGANC3ygbZmgWZx7bEmev-2hWMUS2zCURXl2BgdOL2lyQQXSuzVOEmtnwgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OSDujjiTEogkfnnCLbjro4XywGnIxbuk3FbDAa4TwjQ&oe=6A0861EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "949031437847617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "26878243418476573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34092834853696031", "version": "1.0.3"}, "id": "1374423747290127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only"
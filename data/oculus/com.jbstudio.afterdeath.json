luscdn.com&_nc_ss=7f20f&oh=00_Af6eNjpulVo9PU4BKjaBSi7FPr6gqB1kXrRV4B7_yi70zA&oe=6A1444B7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jlK4b1ITbQQ7kNvwGYMfIf&_nc_oc=AdqmwgJ3F3_GCz8leYmnTSBEnJgQko-llrcuDVlFPVHEayiHPrKCl5dzB_ch6j60PRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yiC6zTvui6ZQyhYlsJk5G7wOy-dlEv918Jkw6-cJ5SQ&oe=6A14716B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1m7LIq_nJ4Q7kNvwFDyqt4&_nc_oc=AdqhGzo6nya2tAouNRfpm4LrHbZnwJ9MxSrJ_OMcRbjOpb6EMSjs5D-s4oCZwsrqoOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qtGZRhxUSILLR3iGGHHn13WfkRK08DEAcX7DKhVgWdA&oe=6A145CD0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFnslvDW1CUQ7kNvwHkQ63E&_nc_oc=AdoubDQ9cM46J9n823XaLaTQ2yk6fLdEP4rzQdlauHAEgt0cXXSnpOfBJ9ZGn2_mHuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zH9oXIZL37JHjTKaLq5jO79Wa7u5WXlc7zGysl711HQ&oe=6A144590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyG-8ywRiQEQ7kNvwEDEslR&_nc_oc=Adr-RMxHVM_R1GEmYUrYzVls-yfsFF4yc-gkCKCCoGyJM2H2e4zmCDcX3-SB9BYhqGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UMpoI30JgfG-_YW5IPFbh6SGoXb2RdDKCQ3uJTobGZQ&oe=6A143F6F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
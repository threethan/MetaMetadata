 "1192035056087480", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_002_0005.png", "id": "2016141535977301", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824671_2016141539310634_6712321427259261072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRLshMYlz8AQ7kNvwGYI0Dp&_nc_oc=Adp6nUBQtxPabW_OmfMCpG2G46xocgbarj0rUzE4cqeRYYmUCMnrDJt5pBT1IcePC1s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ABeMA9nFLtVbShI31jvQAJh_7Re1gLNPyO4YH9JfIGQ&oe=6A09D79D"}, {"file_name": "Image Sequence_001_0012.png", "id": "894224239868178", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821682_894224243201511_6484439723432924429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NOgdJYXK-EQ7kNvwEOlElU&_nc_oc=Adq6F8Pg1aSs357c28VpAF1BEdBpKx1hIJjQaTHoMdN3wXDSS2xZWeYhM9Ph1RASgMA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aZdFKOQelngO-gKQVQ74OSKKqTSDR2ofnJAwCtYbsvQ&oe=6A09B8B7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W9oREVPv64Q7kNvwETEfcS&_nc_oc=AdqiCpXQ3sIh_E_sx-EUxytXsFAhxgrKBJ44LfWevBFXOTOs0rZb978w7anwn03Pj70&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GvRrDeKdXat-cygQ3_hnlx05Z8mr8QztZlGozYHcxMQ&oe=6A09AD2B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGD8OZiFuscQ7kNvwEyKZj9&_nc_oc=AdpoN73KwV2vKZCifMQ1qDDvGHXYvijjG1PYh4AhUssqEgiGfpqAFuVf7r2XUHPgcsM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77DNFOEhJg-y_Q_131hj8Vsd9P1_GYSeETfHmeezSOJw&oe=6A09D0D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvnrQU380nMQ7kNvwEZKRnG&_nc_oc=AdqT3tCJK5Bv3vt6wTjgXRkDtDlRPY-mHo59zEGC1yNlShVtsTvhSX0iDZT43zmQ1VM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y0n6DoMGZB6RKot1rG_u7LQ6eBzp5kNvGGoczOkfdDw&oe=6A09B990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjos6NNdLPIQ7kNvwFbPvSk&_nc_oc=Adrl4_c70IaDSG-U5Jwdgep6y3ZAfuXA92PSnfcYMofPkhZk6KPdZRLc6Q7c4EQxyB4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60BGG3OAp6cW6tgsrluMMyylX6ZChncUWGMTKpMhzU_A&oe=6A09B36F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "949031437847617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "26878243418476573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34092834853696031", "version": "1.0.3"}, "id": "1374423747290127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only"
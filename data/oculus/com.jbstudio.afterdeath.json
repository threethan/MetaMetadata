: "1192035056087480", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_002_0005.png", "id": "2016141535977301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824671_2016141539310634_6712321427259261072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRLshMYlz8AQ7kNvwF8K_5p&_nc_oc=AdocyZN812OU0mhBqVLbR6HISdn0ZKFKlg3T_7lr3wtlo-5tZ1ljBE1iqaC9NQpGELs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h8zckvR75boKbQUuGwQNiP4GIDZKmW3a0wZWX7oinrA&oe=6A0B291D"}, {"file_name": "Image Sequence_001_0012.png", "id": "894224239868178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_894224243201511_6484439723432924429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NOgdJYXK-EQ7kNvwECgRjC&_nc_oc=AdqWW2PYb9P453f7dztR4rqkwcviXzM1kks9k85oylUGk9tPI74hFLI_Stx6pftSFEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sgla-QG0ljCjZEK-4OeTLBCei4CEwTxvTGUMLs-Ze8Q&oe=6A0B0A37"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W9oREVPv64Q7kNvwE-TsYT&_nc_oc=AdqpIqL5x_R6GBUvN1MbD9B6gNSOZokiB0s8ni38t48eKwhT_XH92GVK6Oygrp82XOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U3gmSfmIEHjUKOI4Ml5KBjFPuRWQUC5QErdy2l7rnkw&oe=6A0B36EB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se9ndf_VKKMQ7kNvwFSY_6i&_nc_oc=AdopdwBlBb55eLwHxW06mfzFbPTxbFtozx0VMu3j-6oaDjlgPF7ffnYDt0VcXPJD0QU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af406iRlrRz5hpHtBSb70OLlPZ6M6tO8T70lPbSX39GEMA&oe=6A0B2250"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvnrQU380nMQ7kNvwEuWFDp&_nc_oc=AdrF8QJioSWs-VN7E43diaZ5xzBceKC8igtukRhZhN0dGlaQhR-r6ehp2nRlvXz4mMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ZMftehZn-U-Vx8Jn5CfxQ3eHcoRK0DhFDVnVqH8MaQ&oe=6A0B0B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjos6NNdLPIQ7kNvwHuE_fR&_nc_oc=AdpvqiR0R7E2tYOC2nMOdGFYHO7IGIb_xCwomge-lsjw_Hrpwn7h6oaVU278GFpbjIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41TkLHT1PCG1-Qbi-A9QvwQDD9VDg6NwAWDJ3KpFCfmA&oe=6A0B04EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "2405945443241024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778690520, "status": "PUBLISHED", "id": "26878243418476573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34092834853696031", "version": "1.0.3"}, "id": "1374423747290127", "channel_name": "LIVE"}]}, "is_for_oc
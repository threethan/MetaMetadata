c_8NsQ7kNvwGiSeAd&_nc_oc=Adoci60yshRa2D3Y3gJCo2qoj8rm9oNWPljbaeiL7Tggz1YDmSmpcsEhoKGaE7bN5bc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Htz8o_I1TMN_0MtKhfPQhcxksg2LAPoRHp_L_03YwOA&oe=6A465DB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY0cPzS1KzAQ7kNvwElBfUG&_nc_oc=AdrZayS0APFqPmJsfoLEH_wNVHN61C4yF-OOReDNaE2FuKZH_X2MCBCWAIgcf6qz8P0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kOEg0FmP_gqbQlyDXBFaybjEkQV7KV9zcOsgiRKTmFg&oe=6A468A6B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2s0I_sGtH0Q7kNvwGi0dn8&_nc_oc=Adr8gTJtDYt2VahJTrNP7Toovxzpzbqu9EL1Xt2YT3RuqAf66XC_3joQWvZZLexBIGk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ujEbQqkXPO2acu14jatFHkvjo_UegUj-bNbTyFEQMxA&oe=6A4675D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koHSsj76wgYQ7kNvwH8XXnh&_nc_oc=AdpkW1C1QpZ9erNwuFIRa0MchAOmVyJxWXcnwrtZCKA9hSbveafXJTEqxuVLtjVgAkc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mIm_Kin4kJr9bGg4uUCuBSroP2kfFlgfvmaIahP4mFA&oe=6A465E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZkNlYqkOGEQ7kNvwHlKszi&_nc_oc=Ado9nNSk7x4dqJIGGBCOGCBHVeil6tmMK42d6AtoqJMualJPSrhPJD3dXF8VibN-r0U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NCrwrZhhokJspQE53j9nCU85GIxzzrzAIY6cduBihfQ&oe=6A4690AF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categor
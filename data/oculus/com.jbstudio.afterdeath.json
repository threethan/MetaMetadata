uscdn.com&_nc_ss=7f20f&oh=00_Af_7wlRWxCA5gQlWoPa7PrO-EBSCLcL_qnxCOv92xFRn9Q&oe=6A426937"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5mbwfsSlCIQ7kNvwG1iY2u&_nc_oc=Adrih_sh9Oy38_fYGnX4cDEOBhNCAI9JrMyQoD4l6EmjdpOBD2FU90128QU6owNbjUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X93HiIcA8taNSv1JrEgwsjDLpE6WAxJbhj475pKqv4g&oe=6A4295EB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zadw971_xYQ7kNvwFkMF8o&_nc_oc=Adp4laVtWzO0-BVUihx6j8TCa3srb_MfemtIdBf06lOKrSpjcieWTQf6N_AHPyNfiVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qv8p2klyqn3-z9CM9T51tAZWBZZ5nVhjUp6UAdjTo_g&oe=6A428150"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04KGNiok9qAQ7kNvwFdGpIB&_nc_oc=Ado3DFRyT0odv7-fT2dC-5ZNzJAF7f2bNkpx3BYO05DGNP3IMq4kRj66U1NF8QiYeuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yWAUQTsfG_S850NUHMZCZXZ7x9j4qeg4gW62rrQjh3Q&oe=6A426A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ST-7l7IJSYQ7kNvwHOvarU&_nc_oc=AdqOZJQqKCacjN_2RlbUBC_KC_L9KwVKAbHwHF50OPkWUzU0EDf7Zxc-gR5l7JuX2ck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fjdv4Z-Ur56KedNMAw8OJnPbJDRErikWvgwIaByoYvQ&oe=6A4263EF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
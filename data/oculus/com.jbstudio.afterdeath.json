Q7kNvwFOChCL&_nc_oc=AdolSQqrAx1nv4BoytodcNrk8jOcy1Pi7tjAOmK1hCxDOeZAqZ5nyBwKghAEs3rs2O8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAqS2cp8mz_T8wXBT7603NQuCNnRS1GsD8cm4Xc9nPnw&oe=6AA2A6B7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSZ_FLWD1KwQ7kNvwHIqKZ0&_nc_oc=AdoP3qRJnkdVW6jKwjAaCSZ9-82AQqKGrBoFyMoD3to-STHySMA6mtNxDujDXOcWzWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUtt2Z2GhO5nzC3rp02qDewYeghQhWwgxxfXryYlZxCw&oe=6AA2D36B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibrgi1gUoD0Q7kNvwFy2SVj&_nc_oc=AdraHjHoCNwfGIQhgpSMZtB5YjtGAkwH_3RB5utO4ViCLx-KOl8UhmIGr2ftIjUwXDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWE-tbzX3Knpvkwo2eRV5H2dHZPwF18lugATiWjRAZBg&oe=6AA2BED0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knv0VIloWHcQ7kNvwEFbQMx&_nc_oc=Adrm2h6_vxnADxn3cRTY57qAdA8fwmz8g2gM-VnIlzV1_bUJLuW4dSpcxbs8_iCUYhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZwmkw_qguCMQ7vMqiwqdADrPCBv353GUaIw-Jm2Q4YA&oe=6AA2A790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIvneztSq8MQ7kNvwHGAfQq&_nc_oc=AdrJ48EqaNz2DgsJS_eVhnzHp4lLzsdIWJx8q-S_46aEqHNcbf5AhxCYyKVp36SWmyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLouV86D8mSv9nXeqjjZ6zzaMPTu4kDpG5x9krFoLNy5w&oe=6AA2A16F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
=T5tCY95gNjwQ7kNvwEtmaut&_nc_oc=AdruxWqv-hZZowxal1T5mdhTqET50CHiALvsPnO0XJ3OR5uUiDBBTU3oFte_fxP-t64&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDmu6cUyMLBGKxMvkVHsIMB3Y97TQXAyfOS4-UNh6N0A&oe=6A8EE037"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U-rkhU1CyoQ7kNvwGBUczF&_nc_oc=AdrbhiOvEvUkpqk_DlA14xf2ayqzDiBDMTzY6blWKds5X2IjRUmh0W7EwA6rIV0UxcM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYvVhWNe4aoFoTm6y6crUe5Rjo2Gghi1vEFdkA9sWtkw&oe=6A8ED4AB"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWB22GB9gRsQ7kNvwEap5cY&_nc_oc=Ado2pX611AU7xp8axT5WJKwXY7azPOjLwOlyACwanw4-9KrR3HRrqeWl8Q5vzTJHBgo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWykEmM5N73Xuhnsjf2N0urPtsQ2vUaMP-xxczqUas8w&oe=6A8EC010"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1llbUpE6S8Q7kNvwH3dDwb&_nc_oc=Adpfx19BYY2i-3tXCB0EoauSx7SFDk03s_jyBrGkH2D8zkOIRIG3Baroejo7zIT0Kec&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXC4jW6mC6uQ7TJI58-qSzxnfXe0_5GRA6TwuLu0d0nw&oe=6A8EE110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drSStGkaJqEQ7kNvwEqV8CB&_nc_oc=Adrgj5RZCllUYRd8P_12jhVGgUyuuCxIdfLtkzRq3vcAQKjagGzi5YLZSwMn0AH4l6w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH7U7ZwqCfdo6goiBoDQuyxhoJtDsLsSdpz67E8Id0NA&oe=6A8EDAEF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
: "1192035056087480", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence_002_0005.png", "id": "2016141535977301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824671_2016141539310634_6712321427259261072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcaDVw14A1cQ7kNvwH7pnjO&_nc_oc=AdrawoWF-5zlGGc6mpVBLCmTsUEq4EWq5kMQXGmx1n1lqBsOkl5_4AP0KPKLrfjHess&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pCsksyzTqOrgPogkC8iSj3N0TvRdmx5teD30eYs1lmQ&oe=6A0F1D9D"}, {"file_name": "Image Sequence_001_0012.png", "id": "894224239868178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_894224243201511_6484439723432924429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3comEKp6jQkQ7kNvwEbfZcG&_nc_oc=AdrT1V05EKHwo3l5j33hlee84PrVMWHR9Or_tZqveadT3urWr6VXfwR_-Mrfu0Yj-Zs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YFg9m2Zk0VhyB5b2poF7kM7Aptf4rrfCVjgBoaf4SZw&oe=6A0EFEB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lxItl3NMjoQ7kNvwFzMTE9&_nc_oc=AdrkR-Q4R1XnlJNGE53R7m9eL_yX-NOX_5JfBW8_uTgN0TLiU38zN_G2vDG-rVUqFFM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cA4fxM8YYYDJdYCVBgg5Itkeey9kL06F1viA-0aprIw&oe=6A0EF32B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgo44k8RumcQ7kNvwGKXcY8&_nc_oc=AdptoRy0I0HUlb3-7FHfafWU0Wa5QmOvmjR7OjYO5vPGhNzVU3GjPr28BIkoRtgE8RM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M7ZhLHQ0gSItSOOVdsJgaMwdVgfFXzXh7LtwF1qvshQ&oe=6A0F16D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRN8BcvlyPsQ7kNvwHjCi0a&_nc_oc=AdpVrXqDbiTMxJ_PNNY5vq1lefPdBJjEou24Tbcn3Zh6fBNJ5zhWm3_u005Q-afHanI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mKVfeh2_eA_Vw2AMaOoi8ONQoXjuJrjq38dkgyQrZbQ&oe=6A0EFF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yoi0K1iK4DwQ7kNvwE3A05W&_nc_oc=AdpvmpH3MKvg2yHcV3-IRwA1GTKRq3JLuPww3QsSwVNKH7nRCl9Qmchm6FSdSLpP6sw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lGV2yIwhyzHdcmIxggxTDfB-6F4jLXvZ3EOuE7Rq2_Q&oe=6A0EF96F"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33957809897198528"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "26878243418476573"}, {"status": "PUBLISHED", "id": "2405945443241024"}, {"status": "PUBLISHED", "id": "949031437847617"}, {"status": "PUBLISHED", "id": "1128114292811759"}, {"status": "PENDING", "id": "33488830827428969"}]}, "baseline_offer": {"id": "2405945443241024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778690520, "status": "PUBLISHED", "id": "26878243418476573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34092834853696031", "version": "1.0.3"}, "id": "1374423747290127", "channel_name": "LIVE"}]}, "is_for_oc
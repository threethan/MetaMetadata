luscdn.com&_nc_ss=7f20f&oh=00_Af7s8eVwZyvn36YloiKth-2MpyPutrvxC689NcIKF--Lng&oe=6A1C2DB7"}, {"file_name": "1-After Death.png", "id": "1215674153434520", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825305_1215674156767853_5952917089226035367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeF66dqN2UsQ7kNvwG5idJW&_nc_oc=AdrXAJfBZonoBsTlvs8nGoe0cwBEHy5z6AAt-4nzGToK3yCkhiHANXt7KWkDgIZoByI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IxI5s6knUlYqLhuUX08zrJ79gv_la0ZlW9mQ74Lk1RA&oe=6A1C5A6B"}, {"file_name": "4-After Death.png", "id": "26568570506064153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821178_26568570512730819_5476686572868603224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ0_HZxuEPQQ7kNvwENaImI&_nc_oc=Ado9CYpG5taVWgYAuvZikuqmOj2AzFkdsah3nNof4nQYVmL_O_2mVDBai5JFAFXuOr0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S9s4yPvnm0goaItEN4HEx345X1kAe3xbm_dPsEdRbvQ&oe=6A1C45D0"}, {"file_name": "5-After Death-2550.png", "id": "900489279570390", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499293972_900489286237056_2881155713361734424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz-qNftnPGMQ7kNvwE8GFiB&_nc_oc=AdpySXwdxHPgUceTEbNjmgdw6P83Epu9x6EZ7bA4scTfMK0kQuntIhmJrzlaxHNeHos&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FXbaqzNGaLFd3vuFGyLysDISCGV-9GqnjXRUyawkN5g&oe=6A1C2E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0012.png", "id": "1574626857014320", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820428_1574626860347653_8895705020804578099_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jfXn0CjRUMQ7kNvwEfWWOo&_nc_oc=AdpoR_2fBE_BnMi-1P4QqCbGLSEQEfW89OAWER_Bn-rBNsK4X4IUVgjI5H_OuBiMqWM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gO_5tSOOd5kkP3_HDPcwIzwPsi-A39fsRH2caMcS0LA&oe=6A1C60AF"}, "display_name": "After Death", "keywords": ["death", "trip", "journey"], "long_description": "This virtual reality application is a narrative-driven, introspective experience designed to immerse the player in a symbolic and emotional journey.\n\nThe experience begins in a familiar yet unsettling situation, but quickly shifts into a more abstract and surreal space where the boundaries between reality, memory, and awareness start to dissolve.\n\nRather than relying on explicit storytelling or dialogue, the experience communicates through atmosphere, visual symbolism, sound design, and pacing. Each scene is carefully crafted to evoke emotion and personal interpretation, allowing every player to connect with the experience in their own way.\n\nThe application places strong emphasis on presence, mood, and emotional flow rather than traditional gameplay mechanics. It is not intended to frighten or shock, but to invite reflection\u2014on the passage of time, the memories that shape us, and moments when we are forced to look inward.\n\nThis experience is ideal for players who appreciate artistic, conceptual, and emotionally driven VR content, and who are looking for something beyond conventional gameplay.", "short_description": "A short, emotional VR experience set at a fragile moment between an ending and a beginning.\nWithout direct narration or dialogue, players are drawn into a symbolic journey through time, memory, and self-reflection.\nThis is not a traditional game, but a contemplative VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
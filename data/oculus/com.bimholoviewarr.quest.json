scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031610_334175182982884_2490547261019248929_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj8jfeOtgjYQ7kNvwE8rkp8&_nc_oc=AdrwUPXQB8qenQ06eA3Htqi9UynWwsHAdC_dTheq-_Y4dGb-H2TRTVjMRzqQGqLVbSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIzJfKnM6bfEdrLqGSjUYkI2FEIpPYJDZML7bhGn9m9w&oe=6B05AA23"}, "display_name": "BIM Holoview ARR", "keywords": [], "long_description": "BIM Holoview ARR is a tool designed for architects, engineers, construction teams and facility managers to view 3D construction models in full high-fidelity resolution.  With support for Azure Remote Rendering it allows users to quickly convert and view large BIM models (over 100m polygons) which can be viewed either in Virtual Reality or Mixed Reality to help plan the sequencing of construction and fit-outs, and identify anomalies between the plans and actual building. In a completed building it gives facility managers \u2018x-ray vision\u2019 through walls, floors and ceilings to see structural elements and locate building services for maintenance.\n\nUsers can sign up at www.bimholoview.com for an account to use the software.\n", "short_description": "BIM Holoview ARR utilizes cloud rendering to provide unparalleled capacity to view large 3D BIM Models on the Meta Quest.  This includes models over 100m polygons and up to 2GB in size all rendered in 100% full fidelity via Azure Remote Rendering.  The App can be used in either full mixed reality (to overlay your model to actual site) or in traditional VR mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bimholoview.com/PrivacyPolicy", "developer_terms_of_service_url": "https://www.bimholoview.com/TermsOfService", "publisher_name": "BIM Holoview", "support_website_url": null, "website_url": "https://www.bimholoview.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24502368702741355"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1133943754306409"}]}, "baseline_offer": {"id": "1133943754306409"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711732260, "status": "PUBLISHED", "id": "1133943754306409"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28962169020094612", "version": "1"}, "id": "635592468560355", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24502368686074690", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28962169020094612"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "635592468560355"}]}, "change_log": "Adds the ability to hide items based on their hierarchy.\n\nThe models being viewed in this application are all streamed from a remote server and are therefore not being downloaded.\nWe have approval in writing from Meta (Ben Porter) to include streaming content as part of our application.", "created_date": 1742351833, "id": "28962169020094612", "version": "1", "version_code": 255, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nod
n.com/v/t64.5771-25/38974444_1633029160239695_7471909342320995584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTICpm6pfvgQ7kNvwEMH-P2&_nc_oc=Adpw5MiwsNolxoAZspoTmeEn37Ic9cUY4A2gD4RchGmJS7MtTg7n0SbynLYk1WImj50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSwMRiClT6HrklLzUzLgK9eBnr5EYdQw4JN4Fdr5Msaw&oe=6ACE3D93"}, {"file_name": "Golf5_Screenshot_07.png", "id": "257907399333065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_257907402666398_3641523989344504766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMnuCn5AojYQ7kNvwEKZsky&_nc_oc=AdrtP_yrNWBlUIoQALGG3gByoXs8R9rCheFJ46J3BlgeY-9EV0b3ibiiGUZPxMTY6no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgiwWOF1cCoHKTuwjiDO1uMgX-t3UXeR-_oZ7VlpTszA&oe=6ACE6826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "199590971613227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_199590974946560_7095862371395979706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TztWcm6Qzm4Q7kNvwG7ihSe&_nc_oc=AdpplL9sf-QRk4l_Fub5LYqwMe9hhpAmE7sFwM37J-tjW70ZPVXU6H1X-BdBVO3FNsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ-mn7gsFlfypBih5GlnuuVzEeitVLnSumXe0vR27Zuw&oe=6ACE42EF"}, "display_name": "Golf 5 eClub", "keywords": [], "long_description": "Do you want to have real fun playing and learning golf at the same time? Welcome to Golf5 eclub, a truly immersive genuine golf experience, that includes:\n\n* 18 hole \"The Dunes\" course, where you can practice or play tournaments\n* A driving range with all the clubs\n* An astounding and realistic putting Green with different levels of difficulty\n* When you don\u00b4t have much time, a WIPP version (Wood, Iron, Pitch & Putt)\n* And finally, a mini-golf for initiation to the game\n\nAll can be played online with your friends. Compete and talk with players around the world. Just enter the clubhouse and look for them. Incredibly realistic and multiplayer experiences. Different rewards as you improve your level and skills. Learn and have fun, while you improve your handicap with the International E-Golf Federation rules, participate in tournaments and become an egolf pro.", "short_description": "Golf 5 eClub is a new way to learn, play and practice Golf. You will belong to a virtual club where you can play 18 holes or practice like in a real club. You can also play or compete online. A new immersive way to learn and practice your favourite sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/client-support/", "website_url": "https://www.aaagamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "621687075796341"}}]}, "scheduled_offers": {"count": 66, "nodes": [{"status": "PUBLISHED", "id": "1762663988256461"}, {"status": "PUBLISHED", "id": "1063735026199567"}, {"status": "PUBLISHED", "id": "2171225030388272"}, {"status": "PUBLISHED", "id": "1668117757849094"}, {"status": "PUBLISHED", "id": "1482053950183854"}, {"status": "PUBLISHED", "id": "1568860094361433"}, {"status": "PUBLISHED", "id": "1756170728386204"}, {"status": "PUBLISHED", "id": "1521977085733925"}, {"statu
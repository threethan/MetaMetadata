39"}, {"file_name": "Landscape_2560x1440.png", "id": "192082839132219", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974809_192082845798885_6147028067783985278_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUA3CI_ObjoQ7kNvwHVtEAW&_nc_oc=AdrgPgEUfwIlGDNOTqB78EnWQhrTBqPUeknGD_VxuAEjb6fCYBQTYrI4M5qCqVWy7Qk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCg7scZiyFa8hKVrgl8TzBpKSvw1TTRxMnaL3D6Y887A&oe=6AC51603"}]}, "id": "270192468067713", "locale": "en_US", "screenshots": [{"file_name": "Golf5_Screenshot_16.png", "id": "508021100610178", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_508021103943511_6647993301034156033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq-NrWJ_v6IQ7kNvwEbBV0J&_nc_oc=Adqh0CH62giOVhEw3i3CvjgGnsxBjwU9g2FZVtSAT8UusoMuzSLlJAHXGivwb7jup1M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdYnCIqBLYfBBYkM99KoVMq3nhnrwiKM0Dnx2VJewCbw&oe=6AC51EB9"}, {"file_name": "Golf5_Screenshot_06.png", "id": "910897016396397", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974442_910897019729730_7968794591705565822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4MNxCD9kP8Q7kNvwGwBWma&_nc_oc=AdqnjK7R9E45kP_SBX_ocDGLsP7ADYsdKbSL_jobX7dUmuTRme23-Om3WTNasLAlf4g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh7unP1QtvkocOEPnBgVL2gaHXN5I58nFxamUCgLIctg&oe=6AC521EC"}, {"file_name": "Golf5_Screenshot_02.png", "id": "495543904955792", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974873_495543908289125_7127342155387579884_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR3QyYdbeQwQ7kNvwFaJKjf&_nc_oc=AdrGjdNKWLUyJPVdXialAmJ6WFkmiXQMSOaGKcjfHlmZeFhCiZlmxT6yFoUBjVb54os&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-1MoZCcKcOMMqD36nlQVT_N5Xb5k4niYIW8JM-zxp0g&oe=6AC50A75"}, {"file_name": "Golf5_Screenshot_04.png", "id": "1633029156906362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974444_1633029160239695_7471909342320995584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OU7Px5DobwQ7kNvwEpd_Bv&_nc_oc=AdrKQarbS8v2hmD9BrRVy1E2C7ED7A-bOMSXNBNvcMQrfJ9ql4yoBuiWKAfI7I49-fY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVAzaRVSH66OfFMctjBCQkbNGnmXz7ABr97QVaBB2SfA&oe=6AC50313"}, {"file_name": "Golf5_Screenshot_07.png", "id": "257907399333065", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_257907402666398_3641523989344504766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxGmqbYu5qwQ7kNvwFaGec8&_nc_oc=Adp-EpWajqt_KbA_wJXDzkBXTFXMSn3nwvjfezB3aTcQUOidqYGCql9kurRNSawEZws&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7uWlVX8dJSEGqQXEzWLzG3DvVm91pNYSsoPHbxZyj0A&oe=6AC4F566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "199590971613227", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974561_199590974946560_7095862371395979706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFgc08xVS1gQ7kNvwGO8QkU&_nc_oc=Adr_IrMB5kg7VZagd5FTDJdv2tPIB0mYk3JWI3cQXGgjA2a1HEq3F2ShRZqWbaleK5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8hBhJsCWNw7gYiKKjsNZQNt-6_JFr6I8X50XOythslQ&oe=6AC5086F"}, "display_name": "Golf 5 eClub", "keywords": [], "long_description": "Do you want to have real fun playing and learning golf at the same time? Welcome to Golf5 eclub, a truly immersive genuine golf experience, that includes:\n\n* 18 hole \"The Dunes\" course, where you can practice or play tournaments\n* A driving range with all the clubs\n* An astounding and realistic putting Green with different levels of difficulty\n* When you don\u00b4t have much time, a WIPP version (Wood, Iron, Pitch & Putt)\n* And finally, a mini-golf for initiation to the game\n\nAll can be played online with your friends. Compete and talk with players around the world. Just enter the clubhouse and look for them. Incredibly realistic and multiplayer experiences. Different rewards as you improve your level and skills. Learn and have fun, while you improve your handicap with the International E-Golf Federation rules, participate in tournaments and become an egolf pro.", "short_description": "Golf 5 eClub is a new way to learn, play and practice Golf. You will belong to a virtual club where you can play 18 holes or practice like in a real club. You can also play or compete online. A new immersive way to learn and practice your favourite sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/client-support/", "website_url": "https://www.aaagamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "621687075796341"}}]}, "scheduled_offers": {"count": 66, "nodes": [{"status": "PUBLISHED", "id": "1762663988256461"}, {"status": "PUBLISHED", "id": "1063735026199567"}, {"status": "PUBLISHED", "id": "2171225030388272"}, {"status": "PUBLISHED", "id": "1668117757849094"}, {"status": "PUBLISHED", "id": "1482053950183854"}, {"status": "PUBLISHED", "id": "1568860094361433"}, {"status": "PUBLISHED", "id": "1756170728386204"}, {"status": "PUBLISHED", "id": "1521977085733925"}, {"statu
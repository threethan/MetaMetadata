uscdn.com&_nc_ss=7f20f&oh=00_Af_PXha919c6V244XYAwxv9Nh6BzyztSXwGkj_o3Q6a5kw&oe=6A43D013"}, {"file_name": "Golf5_Screenshot_07.png", "id": "257907399333065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_257907402666398_3641523989344504766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lKphqECLroQ7kNvwE2gSmf&_nc_oc=Adr6Mmp-hPiuUUPBCeW7i6njQA-otF7D_851zjdymKynXUFQlLTlyqTdw85hmvust8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SQQ1lTOgS_6l8-WmD1b-Pm7OyKt6Z5I3PP9lGMTd42g&oe=6A43C266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "199590971613227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_199590974946560_7095862371395979706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYyDE-Wvbb8Q7kNvwEsBa3h&_nc_oc=AdoTpSJxTcakyNtpXfiMUIjpcy0ul7DnHuyNrDgySAifU9X5VJTLxHlbjb0JkxtTjG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-n3pny24GSOq4U-znQWsa3HYdI5FdpCDzgwhg5SppoQ&oe=6A43D56F"}, "display_name": "Golf 5 eClub", "keywords": [], "long_description": "Do you want to have real fun playing and learning golf at the same time? Welcome to Golf5 eclub, a truly immersive genuine golf experience, that includes:\n\n* 18 hole \"The Dunes\" course, where you can practice or play tournaments\n* A driving range with all the clubs\n* An astounding and realistic putting Green with different levels of difficulty\n* When you don\u00b4t have much time, a WIPP version (Wood, Iron, Pitch & Putt)\n* And finally, a mini-golf for initiation to the game\n\nAll can be played online with your friends. Compete and talk with players around the world. Just enter the clubhouse and look for them. Incredibly realistic and multiplayer experiences. Different rewards as you improve your level and skills. Learn and have fun, while you improve your handicap with the International E-Golf Federation rules, participate in tournaments and become an egolf pro.", "short_description": "Golf 5 eClub is a new way to learn, play and practice Golf. You will belong to a virtual club where you can play 18 holes or practice like in a real club. You can also play or compete online. A new immersive way to learn and practice your favourite sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/client-support/", "website_url": "https://www.aaagamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "621687075796341"}}]}, "scheduled_offers": {"count": 63, "nodes": [{"status": "PUBLISHED", "id": "1668117757849094"}, {"status": "PUBLISHED", "id": "1482053950183854"}, {"status": "PUBLISHED", "id": "1568860094361433"}, {"status": "PUBLISHED", "id": "1756170728386204"}, {"status": "PUBLISHED", "id": "1521977085733925"}, {"status": "PUBLISHED", "id": "1163124435676942"}, {"status": "PUBLISHED", "id": "1441821023739455"}, {"status": "PUBLISHED", "id": "719116294053776"}, {"status": "PUBLISHED", "id": "1051165540168197"}, {"status": "PUBLISHED", "id": "1338034080653368"}, {"status": "PUBLISHED", "id": "2477857792412614"}, {"status": "PUBLISHED", "id": "883745880579183"}, {"status": "PUBLISHED", "id": "1293026898357994"}, {"st
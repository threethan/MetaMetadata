kxcORXCHgj6jzEU0pQO9pwS4yt7VnmCcPELeXxNtjIhlQ87w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YNVAj-vCFd3JFo3qwmVKjdD3rRYReTqUdi_m1qjlpSg&oe=6A281E2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Block_Climbing_landscape.png", "id": "848178737795942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_848178741129275_2933171584078750117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5Mrrcsrb2kQ7kNvwElQsnb&_nc_oc=AdpSovK5dRvCjg5zDmEvk97wBqA1VcfzsYjUeCLpFb7lAy_laxZttGjrKgk3bMOKbLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_J7O1C-5xv3mI__im_8ml_Lb58fDG5QBdMIIENBGAfA&oe=6A2825EC"}, "display_name": "Block Climbing", "keywords": [], "long_description": "Climb your way through 30 unique indoor levels packed with ice axes, breakable grips, ropes, and plenty of surprises. Some walls invite you to become the route architect: place new grips with the grip pistol or even shift entire wall sections to design your own path to the top.\n\nPush your speed, uncover hidden shortcuts, and race against player ghostss. The fastest runs are showcased on blockclimbingvr.com, where you can compare your achievements and see how your climbs stack up against the best.", "short_description": "Climb through 30 unique indoor levels packed with ice axes, breakable grips, ropes, and surprises. On certain walls, you become the architect: place custom grips with the grip pistol or move wall segments to design your own route. Have fun, find shortcuts, and push for world-record times."}, {"images": {"nodes": []}, "id": "1340072250753545", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Klettere durch 30 einzigartige Indoor-Level voller Eispickel, zerbrechlicher Griffe, Seile und vieler \u00dcberraschungen. Manche W\u00e4nde laden dich ein, selbst zum Routenarchitekten zu werden: Platziere neue Griffe mit der Griffpistole oder verschiebe ganze Wandsegmente, um deinen eigenen Weg bis ganz nach oben zu gestalten.\n\nSteigere deine Geschwindigkeit, entdecke versteckte Abk\u00fcrzungen und tritt gegen die Geister anderer Spieler an. Die schnellsten Zeiten werden auf blockclimbingvr.com pr\u00e4sentiert, wo du deine Leistungen vergleichen und sehen kannst, wie du im weltweiten Ranking abschneidest.", "short_description": "Klettere durch 30 einzigartige Indoor-Level voller Eispickel, zerbrechlicher Griffe, Seile und \u00dcberraschungen. An bestimmten W\u00e4nden wirst du selbst zum Architekten: Platziere eigene Griffe mit der Griffpistole oder verschiebe Wandsegmente, um deine eigene Route zu gestalten. Hab Spa\u00df, finde Abk\u00fcrzungen und jagt die Weltrekordzeiten."}, {"images": {"nodes": []}, "id": "1201111145557160", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Escala a trav\u00e9s de 30 niveles interiores \u00fanicos llenos de piolets, presas rompibles, cuerdas y muchas sorpresas. Algunas paredes te invitan a convertirte en el arquitecto de la ruta: coloca nuevas presas con la pistola de presas o mueve secciones completas de la pared para crear tu propio camino hasta la cima.\n\nMejora tu velocidad, descubre atajos ocultos y compite contra los fantasmas de otros jugadores. Los mejores tiempos se muestran en blockclimbingvr.com, donde puedes comparar tus logros y ver c\u00f3mo te posicionas frente a los mejores.", "short_description": "Escala a trav\u00e9s de 30 niveles interiores \u00fanicos llenos de piolets, presas fr\u00e1giles, cuerdas y sorpresas. En ciertas paredes, te conviertes en el arquitecto: coloca presas personalizadas con la pistola de presas o mueve secciones de la pared para dise\u00f1ar tu propia ruta. Divi\u00e9rtete, encuentra atajos y busca tiempos de r\u00e9cord mundial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockclimbingvr.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "William Dumont", "support_website_url": null, "website_url": "https://blockclimbingvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt", "pt_BR", "es", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE", "fr_BE", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8042609392449375"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1334487838476216"}]}, "baseline_offer": {"id": "1334487838476216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767359700, "status": "PUBLISHED", "id": "1334487838476216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27365239019759790", "version": "0.36"}, "id": "753154060315458", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8042609382449376", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27365239019759790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "753154060315458"}]}, "change_log": null, "created_date": 1778748799, "id": 
dn.com&_nc_ss=7f20f&oh=00_Af_hl_RwY4EOBj64iir6QSyvRLa59HYBWFAuMDAwYdc06g&oe=6A280EAD"}, {"file_name": "sc4.png", "id": "1990319894914864", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_1990319898248197_2493341020367230195_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRMz1m_Nmx4Q7kNvwHwVfeV&_nc_oc=Adqd8PvzP91nl7aZKujm0XUpReB8zPWaXBLkjIlACzG6hyAzHOLzgUQCDcOUyfe9yz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ypUu6K5OmlWWIz7W1dk3NiTT8W0g75mbM_kSDNdyXwA&oe=6A280716"}, {"file_name": "sc5.png", "id": "1113512974149197", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_1113512977482530_9108655786159781890_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dw1FKkvp9sQ7kNvwGBgdyw&_nc_oc=AdoVqeFPHq1_mE0PneqzMSKyQiJ0LkzdgwBPoVHAapU0xSv4FSAWTcZxaCTabFRYq3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YUVRgfiu32wFXXPi5WNjhBwTIyDimt6_ng_IyNHjLEw&oe=6A28395C"}, {"file_name": "sc2.png", "id": "1220549166716330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_1220549170049663_3534035250699349976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uYA822xCo4Q7kNvwEJK3iR&_nc_oc=Adq9HcG8uzKFmoEJWyy_rqhU4EWHB1uRkoJ3O-P55ynqzsQzF9WYVewfHmatjx9p62U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zRM-67IVslxLLg4WQ5JoT8_CYfZrJ5qWan7ejCo55qQ&oe=6A2806E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Block_Climbing_landscape.png", "id": "848178737795942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_848178741129275_2933171584078750117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5Mrrcsrb2kQ7kNvwElQsnb&_nc_oc=AdpSovK5dRvCjg5zDmEvk97wBqA1VcfzsYjUeCLpFb7lAy_laxZttGjrKgk3bMOKbLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_J7O1C-5xv3mI__im_8ml_Lb58fDG5QBdMIIENBGAfA&oe=6A2825EC"}, "display_name": "Block Climbing", "keywords": ["climb", "speedrun", "race", "block", "arcade"], "long_description": "Climb your way through 30+ unique indoor levels packed with ice axes, breakable grips, ropes, and plenty of surprises. Some walls invite you to become the route architect: place new grips with the grip pistol or even shift entire wall sections to design your own path to the top.\n\nPush your speed, uncover hidden shortcuts, and race against player ghostss. The fastest runs are showcased on blockclimbingvr.com, where you can compare your achievements and see how your climbs stack up against the best!", "short_description": "Climb through 30+ unique levels packed with ice axes, breakable grips, ropes, and surprises. On certain walls, you become the architect: place custom grips with the grip pistol or move wall segments to design your own route. Have fun, find shortcuts, and push for world-record times."}, {"images": {"nodes": []}, "id": "1599630901947848", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Klettere durch 30 einzigartige Indoor-Level voller Eispickel, zerbrechlicher Griffe, Seile und vieler \u00dcberraschungen. Manche W\u00e4nde laden dich ein, selbst zum Routenarchitekten zu werden: Platziere neue Griffe mit der Griffpistole oder verschiebe ganze Wandsegmente, um deinen eigenen Weg bis ganz nach oben zu gestalten.\n\nSteigere deine Geschwindigkeit, entdecke versteckte Abk\u00fcrzungen und tritt gegen die Geister anderer Spieler an. Die schnellsten Zeiten werden auf blockclimbingvr.com pr\u00e4sentiert, wo du deine Leistungen vergleichen und sehen kannst, wie du im weltweiten Ranking abschneidest.", "short_description": "Klettere durch 30 einzigartige Indoor-Level voller Eispickel, zerbrechlicher Griffe, Seile und \u00dcberraschungen. An bestimmten W\u00e4nden wirst du selbst zum Architekten: Platziere eigene Griffe mit der Griffpistole oder verschiebe Wandsegmente, um deine eigene Route zu gestalten. Hab Spa\u00df, finde Abk\u00fcrzungen und jagt die Weltrekordzeiten."}, {"images": {"nodes": []}, "id": "1343641727610266", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Grimpez \u00e0 travers 30 niveaux int\u00e9rieurs uniques remplis de piolets, de prises cassables, de cordes et de nombreuses surprises. Certains murs vous invitent \u00e0 devenir le v\u00e9ritable architecte de la voie : placez de nouvelles prises avec le pistolet \u00e0 prises ou d\u00e9placez des sections enti\u00e8res du mur pour cr\u00e9er votre propre chemin vers le sommet.\n\nPoussez votre vitesse, d\u00e9couvrez des raccourcis cach\u00e9s et affrontez les fant\u00f4mes des autres joueurs. Les meilleurs temps sont affich\u00e9s sur blockclimbingvr.com, o\u00f9 vous pouvez comparer vos performances et voir comment vous vous situez face aux meilleurs.", "short_description": "Grimpez \u00e0 travers 30 niveaux int\u00e9rieurs uniques remplis de piolets, de prises fragiles, de cordes et de surprises. Sur certains murs, vous devenez l\u2019architecte : placez vos propres prises avec le pistolet \u00e0 prises ou d\u00e9placez des segments du mur pour cr\u00e9er votre propre voie. Amusez-vous, trouvez des raccourcis et visez les temps records du monde."}, {"images": {"nodes": []}, "id": "821805747279417", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Escala a trav\u00e9s de 30 niveles interiores \u00fanicos llenos de piolets, presas rompibles, cuerdas y muchas sorpresas. Algunas paredes te invitan a convertirte en el arquitecto de la ruta: coloca nuevas presas con la pistola de presas o mueve secciones completas de la pared para crear tu propio camino hasta la cima.\n\nMejora tu velocidad, descubre atajos ocultos y compite contra los fantasmas de otros jugadores. Los mejores tiempos se muestran en blockclimbingvr.com, donde puedes comparar tus logros y ver c\u00f3mo te posicionas frente a los mejores.", "short_description": "Escala a trav\u00e9s de 30 niveles interiores \u00fanicos llenos de piolets, presas fr\u00e1giles, cuerdas y sorpresas. En ciertas paredes, te conviertes en el arquitecto: coloca presas personalizadas con la pistola de presas o mueve secciones de la pared para dise\u00f1ar tu propia ruta. Divi\u00e9rtete, encuentra atajos y busca tiempos de r\u00e9cord mundial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockclimbingvr.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "William Dumont", "support_website_url": null, "website_url": "https://blockclimbingvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt", "pt_BR", "es", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE", "fr_BE", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27365447799738912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_4466573496908112_2041745852006523747_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1fNNKQ2lUEQ7kNvwH62iwo&_nc_oc=AdosaDWguzaUKX2RfyoE1AlRUUM5LDGYHgnlmdvGOA0u-A4-iTfA9hTleGkaxbuE-84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ke2fXhiWPGuBnfd9-rYAXBvzDZ9KehdSegsPzQHIw5g&oe=6A2812AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Block Climbing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1767359700, "lastRevision": {"nodes": [{"id": "8042609402449374", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8042609382449376", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "643304932110041"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3905174663113110", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Grimpez \u00e0 travers 30 niveaux int\u00e9rieurs uniques remplis de piolets, de prises cassables, de cordes et de nombreuses surprises. Certains murs vous invitent \u00e0 devenir le v\u00e9ritable architecte de la voie : placez de nouvelles prises avec le pistolet \u00e0 prises ou d\u00e9placez des sections enti\u00e8res du mur pour cr\u00e9er votre propre chemin vers le sommet.\n\nPoussez votre vitesse, d\u00e9couvrez des raccourcis cach\u00e9s et affrontez les fant\u00f4mes des autres joueurs. Les meilleurs temps sont affich\u00e9s sur blockclimbingvr.com, o\u00f9 vous pouvez comparer vos performances et voir comment vous vous situez face aux meilleurs.", "short_description": "Grimpez \u00e0 travers 30 niveaux int\u00e9rieurs uniques remplis de piolets, de prises fragiles, de cordes et de surprises. Sur certains murs, vous devenez l\u2019architecte : placez vos propres prises avec le pistolet \u00e0 prises ou d\u00e9placez des segments du mur pour cr\u00e9er votre propre voie. Amusez-vous, trouvez des raccourcis et visez les temps records du monde."}, {"images": {"nodes": []}, "id": "3355376137934116", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Climbing", "keywords": [], "long_description": "Escale por 30 n\u00edveis internos \u00fanicos, repletos de machadinhas de gelo, apoios quebr\u00e1veis, cordas e muitas surpresas. Algumas paredes convidam voc\u00ea a se tornar o arquiteto da rota: coloque novos apoios com a pistola de apoios ou mova segmentos inteiros da parede para criar seu pr\u00f3prio caminho at\u00e9 o topo.\n\nAumente sua velocidade, descubra atalhos escondidos e corra contra os fantasmas de outros jogadores. Os melhores tempos aparecem em blockclimbingvr.com, onde voc\u00ea pode comparar seus resultados e ver como se posiciona entre os melhores.", "short_description": "Escale por 30 n\u00edveis internos \u00fanicos, repletos de machadinhas de gelo, apoios quebr\u00e1veis, cordas e surpresas. Em algumas paredes, voc\u00ea se torna o arquiteto: coloque apoios personalizados com a pistola de apoios ou mova segmentos da parede para criar sua pr\u00f3pria rota. Divirta-se, encontre atalhos e busque tempos de recorde mundial."}, {"images": {"nodes": [{"file_name": "Block_Climbing_square.png", "id": "4466573493574779", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_4466573496908112_2041745852006523747_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1fNNKQ2lUEQ7kNvwH62iwo&_nc_oc=AdosaDWguzaUKX2RfyoE1AlRUUM5LDGYHgnlmdvGOA0u-A4-iTfA9hTleGkaxbuE-84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rPWIiR-uGHbD5mwv6T3snWvHoOPclaqpSW8h55LBlyA&oe=6A2812AE"}, {"file_name": "Block_Climbing_vertical.png", "id": "1529206954956785", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://sconte
"}, {"file_name": "3.png", "id": "1174489968158428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302770_1174489971491761_8440179366445404409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfVoo5P-33sQ7kNvwFWgAFu&_nc_oc=Adq6YcB4EM6cAog1z-1Ces_X4pEjic1FKUbTWdaUr05WgQMOzmVFv3IPMJMtvLU25ZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlVmjmk5A0RCSjvUipkH8NpUchs5GY9g23smkY2y8xbw&oe=6B0DC957"}, {"file_name": "5.png", "id": "1115858333745091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307466_1115858337078424_9020735493884132110_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBZiRhSGwNUQ7kNvwFCy5nK&_nc_oc=Ado7fLvKO8KzB-HqKyA87jHJrCT5DlTi2KRqdNfXcIJTeMlm5KMvtT9TV3CF8KAAev8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAOTE98LHjo9HDifxEEbmRBgCBKdsU3HCC-vAcGUEaug&oe=6B0DB2A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Room Remix Cover.png", "id": "1966379763924936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307326_1966379770591602_8991320770156846134_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KqiKSIb6cYQ7kNvwG1OUPo&_nc_oc=AdqBOW2dka39CLe7qQKv8aP8SH77u5_YXFSsGeVcquZoFRWaGEcnT0hPxRwQHwwGO-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmXE3XdZKZQV8SYq75ABQ45-UlYieP6Qvh6IzLR7lOdQ&oe=6B0DA193"}, "display_name": "Room Remix", "keywords": [], "long_description": "Room Remix is a creative VR interior design app built for Meta Quest users of all ages. Step into a virtual version of your room and experiment with layouts, furniture, d\u00e9cor, lighting, and color combinations in an easy, playful environment. Whether you\u2019re a teen exploring your first bedroom makeover, a hobbyist visualizing improvements, or a casual user who simply wants to try new ideas before making real-world changes, Room Remix gives you the tools to customize any space.\n\nUse the furniture library to place items, test different styles, resize objects, and create complete themes ranging from minimalist to cozy to colorful. Snap, rotate, and move objects freely to build your ideal setup. \n\nRoom Remix is designed to be simple enough for beginners yet flexible enough for anyone who loves designing spaces. Create, experiment, and remix your dream room in VR.", "short_description": "Design your perfect room in VR. Place furniture, try colors, rearrange layouts, and remix your space with intuitive tools made for all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-room-remix", "developer_terms_of_service_url": null, "publisher_name": "Artisan Reality", "support_website_url": null, "website_url": "https://artisanreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25726936620264920"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2241577013067699"}, {"status": "PUBLISHED", "id": "1280862370827266"}, {"status": "PUBLISHED", "id": "1376930984199236"}, {"status": "PUBLISHED", "id": "675036432243215"}, {"status": "PUBLISHED", "id": "2028103914613131"}]}, "baseline_offer": {"id": "2028103914613131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2241577013067699"}]}, "liveC
"}, {"file_name": "3.png", "id": "1174489968158428", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1174489971491761_8440179366445404409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fd1-7JSi38Q7kNvwHASquf&_nc_oc=Adot2QUPZOB4KUvgcumAmu4FKjHAJdzkB7l2w9EfzTmdb_PsH2L9GL0jrbW4EdMNFBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvBWGH0-gap2B_Dd_3RjAGwT8ED_ndZDRA57Jmpe8OwA&oe=6B06F997"}, {"file_name": "5.png", "id": "1115858333745091", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307466_1115858337078424_9020735493884132110_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbol-42emGAQ7kNvwFmSByA&_nc_oc=Ado6eFP0nR6ScjUzcIi1lwYUWEFzbyQ5uCkVRXAzmslLfp05y57vfaHDVh-FqIurmhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZsp8RXefGyfadBSqUvz9Gkv9GdEOJeqQ1fDov1nz3sQ&oe=6B071B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Room Remix Cover.png", "id": "1966379763924936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1966379770591602_8991320770156846134_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quLMf1xMK_MQ7kNvwGpvdFh&_nc_oc=AdqfLxcUDivE00TBWgkjrdxeRLAnMfTPNxzY-TAHRS_xuauq_FkDxVdiNbGZbxAiiEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdLV_QdXkMG02RF49Ep6ipzXoaeiA_bWwUcO7mwHk3vQ&oe=6B070A13"}, "display_name": "Room Remix", "keywords": [], "long_description": "Room Remix is a creative VR interior design app built for Meta Quest users of all ages. Step into a virtual version of your room and experiment with layouts, furniture, d\u00e9cor, lighting, and color combinations in an easy, playful environment. Whether you\u2019re a teen exploring your first bedroom makeover, a hobbyist visualizing improvements, or a casual user who simply wants to try new ideas before making real-world changes, Room Remix gives you the tools to customize any space.\n\nUse the furniture library to place items, test different styles, resize objects, and create complete themes ranging from minimalist to cozy to colorful. Snap, rotate, and move objects freely to build your ideal setup. \n\nRoom Remix is designed to be simple enough for beginners yet flexible enough for anyone who loves designing spaces. Create, experiment, and remix your dream room in VR.", "short_description": "Design your perfect room in VR. Place furniture, try colors, rearrange layouts, and remix your space with intuitive tools made for all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-room-remix", "developer_terms_of_service_url": null, "publisher_name": "Artisan Reality", "support_website_url": null, "website_url": "https://artisanreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25726936620264920"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2241577013067699"}, {"status": "PUBLISHED", "id": "1280862370827266"}, {"status": "PUBLISHED", "id": "1376930984199236"}, {"status": "PUBLISHED", "id": "675036432243215"}, {"status": "PUBLISHED", "id": "2028103914613131"}]}, "baseline_offer": {"id": "2028103914613131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2241577013067699"}]}, "liveC
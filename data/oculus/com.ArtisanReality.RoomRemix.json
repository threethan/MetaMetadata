L6UbgRXv6usPRIql94iePOaP2ofLCRhr9w&oe=6AF9CA97"}, {"file_name": "5.png", "id": "1115858333745091", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307466_1115858337078424_9020735493884132110_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmMSl4np484Q7kNvwHf_lcW&_nc_oc=Adq1FyNGXQ5N72A2GvEa5QVrzbfRwGKBIvga1nwSqGL2f2BBzAtWTRqnyo2n6UgIy2Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwfYmep08YvHT9fqNBNZfg_3wq-VRCUWGkBH_iyQyH5w&oe=6AF9EC28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Room Remix Cover.png", "id": "1966379763924936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307326_1966379770591602_8991320770156846134_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIc1p-waMXQQ7kNvwH2_F_n&_nc_oc=AdrTtB603AhSKDEYZUBlh70HP1Pu98-dvef2poIxA550THYLY2i2we2LZ0lrfdI4-kU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYXL7B_wKmwqsmlp_bCSogIE36wxppZYa6mVt0zTcDeg&oe=6AF9DB13"}, "display_name": "Room Remix", "keywords": [], "long_description": "Room Remix is a creative VR interior design app built for Meta Quest users of all ages. Step into a virtual version of your room and experiment with layouts, furniture, d\u00e9cor, lighting, and color combinations in an easy, playful environment. Whether you\u2019re a teen exploring your first bedroom makeover, a hobbyist visualizing improvements, or a casual user who simply wants to try new ideas before making real-world changes, Room Remix gives you the tools to customize any space.\n\nUse the furniture library to place items, test different styles, resize objects, and create complete themes ranging from minimalist to cozy to colorful. Snap, rotate, and move objects freely to build your ideal setup. \n\nRoom Remix is designed to be simple enough for beginners yet flexible enough for anyone who loves designing spaces. Create, experiment, and remix your dream room in VR.", "short_description": "Design your perfect room in VR. Place furniture, try colors, rearrange layouts, and remix your space with intuitive tools made for all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-room-remix", "developer_terms_of_service_url": null, "publisher_name": "Artisan Reality", "support_website_url": null, "website_url": "https://artisanreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25726936620264920"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1280862370827266"}, {"status": "PUBLISHED", "id": "1376930984199236"}, {"status": "PUBLISHED", "id": "675036432243215"}, {"status": "PUBLISHED", "id": "2028103914613131"}]}, "baseline_offer": {"id": "2028103914613131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1280862370827266"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25795816826710232", "version": "1.0.0"}, "id": "1159186906280849", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25726936600264922", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": 
Akgql0LxxcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOooP1qm9_D3elkffKDOOhUn-oBSUklolNYCEUAnmeHg&oe=69BE9E1A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWwU3dcon8AQ7kNvwH_CmS_&_nc_oc=Adkq3acgX_BbrkIfndJ13wTo-_udSJO49GDXqFAeUM0uFxLCPY-8TiKSbxPR4EHNhRg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5i9upJ1a3bcfckQhkOAVM8oDDs9q_e5erYj71UkkkrA&oe=69BE8369"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLRELIwRvFMQ7kNvwHdZ5oK&_nc_oc=Adn6OTqRtw7Y1qusTRfs5Jhn_e8xUiox6K9YR-R5CJlbZ7ZfNCYzUpL_ZjFlCodbl8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoSuOGKH16QukuWj814iuk7LKZPAj0927kwqI8wUBP8A&oe=69BE8CC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "A
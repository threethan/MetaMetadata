ECC1A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Ba3R2FX6YQ7kNvwHIv-JT&_nc_oc=AdmO5UI4WQPYoXnKB6_MmCE5H_sOxGEVtDB97TBrsz8eWC9whufOxJgyj40EVVMkcpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnN1ceu9QkFAN-Xl9NkCrWuLxO0gcWB2iXmYKHOVRlXA&oe=69AEB169"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ta7-EOM4AAQ7kNvwFk2rN-&_nc_oc=Adm7csalhfbRTilXRICQt8_MHu3KYhHLlgwvlle6b4UzMbjxgI3Ci8M-a_tZU2n7y34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwviP52dFsrondXHeMht_31Etq_GGbrZIDJc7cYkGi3KA&oe=69AEBAC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED"
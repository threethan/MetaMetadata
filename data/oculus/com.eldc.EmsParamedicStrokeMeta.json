2_6293249795286497217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc1L_R1jY4kQ7kNvwEwdyqa&_nc_oc=Adp5XfVF-npWC5E_uW-Yevi3AevMRCb8LN0QoswBNf1dsQKIpLrpW7xWlw54fUcCeTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzliX4h5CBZVUmjvCh-Y00uIj-kyJZJSVwVLgjvmry73w&oe=69CA7B9A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0JhHw_XbtQQ7kNvwFfJGqp&_nc_oc=AdoYzH0rzhA57InMwhhEFgLb8QxhvrfzCbvL1EjnL1Ew5aOiB6vxIRYY3JnyHSp6Lsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpNi9elzEYGVuCFHzl6fuKgsdqQGLCBvdY6HVrgawMUg&oe=69CA60E9"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpJ2mem8DJUQ7kNvwE7irTd&_nc_oc=AdpPOPTaWVMtTvjLTp9Z08XjMKxfIVYwLa89fwNB3p05gjGWozDpbeUkx9duiYLXbsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyrns61iZzarx9PJLcsfaBot_6RA-kiPuU02wDNJsbaeA&oe=69CA6A40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https
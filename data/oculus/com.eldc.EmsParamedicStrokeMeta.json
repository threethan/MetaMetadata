2_6293249795286497217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDlb1gBMSNAQ7kNvwHWrw92&_nc_oc=AdpTSPeJIT9WO8dNqcXi2-KYujD5Ebi4r1WXWbYZM964PRMA37rUD7PYXQtHdNkn5mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5aA2FavW81GJykqQCjLG2G4ueA28mpH-ERK16AnvB7A&oe=69D1131A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhAvhZWxgT4Q7kNvwE45hBx&_nc_oc=AdqOgYClamiTkVdbxbhOyu6P45C7GEyXtK5y4zEwrJxlFU23Dns9sgyul05-VRVEWME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMkcL3ZJIj30g9Lpy9oDwC6w_ZUeu-02G2X5WtEqQHEA&oe=69D0F869"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Un7quQBKXkQ7kNvwEXwP2R&_nc_oc=AdpcHSinZ4EOzTMh2U-wge_X-taI2GVC7TzuPM2zv17VHQt1jp1gngdci3bATf_3Dd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNJDJrC81WmMDXJQaXuM3vH6CfBwDDLCb1LPXSWu48YQ&oe=69D101C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https
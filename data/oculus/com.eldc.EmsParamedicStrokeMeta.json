2_6293249795286497217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQLahAQE0doQ7kNvwGh34Cv&_nc_oc=Adr2Hr2Q8X554rLjtezdDbH2dtVPFRwzhM6baWI4tTElen53lkAWCgISN4HTj3P3olc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-e0TSJNgYYDhLJi5f8a0boMZqX_GUd1WJ3Hho6p8XFQ&oe=69CBCD1A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7zT32feupwQ7kNvwFMw_hH&_nc_oc=AdoJ9B453ipGlt4G44Jj6aoeSPr5cIMY9qhTTHYWuGsUgQ5BmmVd3PmurXdnDdjdwxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8zw-eLhProopppxhk0lINgWGh9vdJkewwamSguN-aoQ&oe=69CBB269"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yG54kN1WsKUQ7kNvwF1kAYl&_nc_oc=Adq4X2fhsHE-9NdQtu4ovWG8HM1IoQl2ygO0nSxpFYw4iCku307QJjiDtOCEo4artN4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXclSEZjQ6-iY7d8LUAioDx6Jx2rivgnlb7fGhYT9Axg&oe=69CBBBC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https
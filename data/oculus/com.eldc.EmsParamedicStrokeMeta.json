2_6293249795286497217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrhybikcY2cQ7kNvwFf283L&_nc_oc=AdoE0xBVvxHEoujhzfsE7a18qS9Eezgb3F7Gwl0POgqW4_XnTmXGGWlVwYqod7L2AI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BA7sxbYa6vztBCJBPg1rVOzizaGF9WrgP8zYmXAhPuA&oe=69D3B61A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzrEwNFXdlQQ7kNvwEUmki8&_nc_oc=AdoikJp1CGeBKM2IoXPdBCJERiqMQ2jzjfSfttU0APi7v6ws-5Pcm2BGbL5JPL_9_Mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fkWMKoGvwehn4MF4u3vZDTMqB8lminFnYaco7H_Wg7Q&oe=69D39B69"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGL0tKFkypwQ7kNvwH07dv1&_nc_oc=Ado8hIjxiDQVO8NqdWmWWIGedkzNsg88ZovpitvdTc3m96VtOjqxSGDoZST35nlGhC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tmBb26QZ34w2x2xCO1zQowZq3NhTMBLHMaV1lxEz9kw&oe=69D3A4C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https
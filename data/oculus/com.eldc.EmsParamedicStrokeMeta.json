C291A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Ba3R2FX6YQ7kNvwGwHZJX&_nc_oc=AdlElkOrjBPF_OXJcbRFGHF6wGhb862UPqlQhiq_6NmFk9S93UxE0p9NJ5WlEkpKbvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmgwG5jcPiottE5NlCAUDKDIlhBDuQA9aefkaxZt-LaQ&oe=69AC0E69"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ta7-EOM4AAQ7kNvwESxBkA&_nc_oc=AdnxPlMyKXzW7AcvQgtzIDC6VAaBlqZhwYb4RnHInO_yEYK5gmZoAWCpS-EVVtocSes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIBrWw9J20YgjRUxwuJ33AOnX5ZtPS3qTl9_MUTjPdVA&oe=69AC17C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED"
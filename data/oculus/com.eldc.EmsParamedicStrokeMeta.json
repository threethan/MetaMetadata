fhwVZQNY8_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw12TqjjUBkHi77eORHVevP2_XCIPkRZxBFi9w1gYH4Ag&oe=69B5639A"}, {"file_name": "4.png", "id": "3814134942175577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_3814134945508910_38698433591808934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXkBSYoKj1MQ7kNvwFrlWmd&_nc_oc=Adkqge82cTi0KeFA9E5MMF3keP703587yT_bX3ZuxdL5GyBrcKPiBOs1Rx00eAs85KI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTYaWLrtdqWOjPSZTcaMRmCK5UYl_gclMQeqbNh2mcIQ&oe=69B548E9"}, {"file_name": "5.png", "id": "971138248406983", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468720521_971138251740316_4061130056684693105_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTGbIWtPx2UQ7kNvwEfQx4c&_nc_oc=AdlZ_JmPNae1iMesR7ec5F1hW-9Aquxjx6tFgIHFUKRR9zex3Tf5vMAEvg7HgtOSYmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1ySKgISjTs7Jfnnjzpa9mvuy3dQvC8boV0aX27stCKA&oe=69B55240"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EMS Stroke", "keywords": ["MedVr", "Education", "Training"], "long_description": "Fifty-nine-year-old Alan Carter was home with his wife and started complaining of a headache. Ten minutes back, his wife called 911 when Alan started having trouble speaking and could not move his left arm and leg. A facial droop was also noticed on his left side. A FAST-ED stroke exam will be conducted to examine the patient. ", "short_description": "This VR simulation open scenario is designed to help learners identify and manage a case of stroke in an emergency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "A
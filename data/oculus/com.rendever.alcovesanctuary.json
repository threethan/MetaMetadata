40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JuqIYg1HrEQ7kNvwGyaw2i&_nc_oc=AdokW7bFQ5S7qRecF1J5_sbPhpJYRw77mgxfWIKLF9YLoNe18hT6Jl88MXryQd6wxyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N63l171qe0232u9Mswlh-YN8x7TOzlKJ1UIYpsMGMqQ&oe=6A15BBF1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HjW_peFJxkQ7kNvwFb_AuS&_nc_oc=Adro7uyPo3mXgAIc7PerYYqn-RseivGnnHLuEoSOe4p7QLLEzYYPF2R8Zdksw1ICaDU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i_wkZRXnzcz0XuEEc-uWEln7eZSH8gaLy-eHhf6dgjw&oe=6A15B78D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFuZ0k_duXoQ7kNvwF6FUix&_nc_oc=AdovhjMmbabAzZbz8m_YOSSF81h8ScJMeGvGIlj_CoLgyOj9-1du7LXqaXdT2L-KhS8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LLH_-PArwTCTFWuXGABoJQWxftdBVbCp97C_QU-67Tg&oe=6A15910B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB9gZWZsvboQ7kNvwHd7UqO&_nc_oc=AdoMgPY_sprbek5eqEKcwNc1bEzTtKD--6hq3AP51fx6D3BXLCrvzVhMpVtvFaT-oQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67biWHXCjBMKL7PcsEruGiPP_OUpGe-7zJUdoY8Yy0Xg&oe=6A15BE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to7js3MBXp8Q7kNvwEmgDQ1&_nc_oc=Adqb669oRX2CwQMvp10Om0AK7V73Pu06pdVYLpLReyShG62wTqu3SZ_0S31Ghi_GSYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64mWfWG-OYATGlTDXnGUD7SrRo8R9GBuluLuQnFoZmeQ&oe=6A159F0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
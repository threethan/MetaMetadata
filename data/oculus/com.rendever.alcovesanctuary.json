450x1440px (2).png", "id": "1121899332145730", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX5qxW0HYMgQ7kNvwGroCvh&_nc_oc=AdoMKc2HnX6nAtsFsdvOB_Vw7TjAEU9AyuhzPP9eOyCNlw5K6Uk15GQcaxVLCFLpGfo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_fiNZp1xgAONx7uOnTU9qT57DTmRqmMuToSHyaHciQg&oe=6AA963F1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNkhqamQWmkQ7kNvwHG3Tva&_nc_oc=AdpOi9W16UNxVF0j85sNE6LqZGrUswgyj-Rru03RDuSgpy0Xchr3AcYaW0v3I5RUEmk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYqVQEH86Y1NwDkgM_v2BbhpD1NmYoWdighE0WHqdSmQ&oe=6AA95F8D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHVtxEyNPhsQ7kNvwG9jvSI&_nc_oc=Adper4-4do85xHXn5dw3brkkSxNjpzGaafEGscGkfWvqJdFdJPtj9BdjROfGYcBda0Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI4kpahlIAGtK1p8WT0x6EJlYbCo1TfavzyH1YkaZA6A&oe=6AA9390B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Pl3TXUT-asQ7kNvwH8pA1x&_nc_oc=AdqPpHvfphh2r4ZlBo2FiuLdn9RDdpwtghyUDaW-k5HrgOSdvt_pZiK6oaBc2SH8Zug&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIg8DZf3Ri_9jhvJUIGxVWBKymE0-0_XbxBy3BLywJHQ&oe=6AA9661D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wmzlTC7DaAQ7kNvwE6CjZr&_nc_oc=Adre2Mqx6FY4bteEaX_K2VCfmabiGNHHi0V5Hmnwp118D7HED6Cp1oow5YCnvX5KfWo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_CxxC9UgCXNlp2F8SlBLuhktc7O1qfIrVEv3faGNiww&oe=6AA9470B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc"
31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZiaNnPmbz4Q7kNvwHBzBqC&_nc_oc=AdkW9Jd-YEZnRc1Nhr35dGU6F2BfDqpUwOSoWSeeO_-s5OjntRyvLMersK_mcVvSlSU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuHDVVRExZaWuBDi9eklw0Ae4INMSJfNDKURXsBVb2FcA&oe=69A17FB1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVA6qAotwqkQ7kNvwHJn5N-&_nc_oc=AdlsBaUoEP3OlV4JDknPceloLpC6wr4SxWP1OQlac6x4l4_Vg_BXjdspFxYmpza7Qn4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuM0R1P5xaYTj8nfM5JpoRJ0xyiNboom4ig-HPOHOQYMA&oe=69A17B4D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7NX4hXor4UQ7kNvwG26x1H&_nc_oc=AdmzYg23mNBZqmBTYUld20QUVjYjsloBo4uQQwXk0HJt_Oy8g87D1JBgH3YB_tljugQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvnIkhtHdnqt0CVDEzwyW1qnoOGncnnr_l31nS703nUPA&oe=69A18D0B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMZoLwy9n58Q7kNvwFvSQL4&_nc_oc=AdkpsguiyrGkEGAGIJduN5Wo-m8d7tQJpYd3TYmaD_gxzr4O0A1J5P65zkaffcwRf6E&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftbHYbToXFpdKBmv6anDZjghPijM6W9SdXSIXgiKA-1Zg&oe=69A181DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6TtIQYAaKUQ7kNvwEAHVOQ&_nc_oc=AdlN_d8HM_zyQZjawIAaYKpuw9vmW2poXqJVunRzbSc0xyHvWOuL6D5EhScigdsNcak&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftLRfuQ7MRgIqJr8iASkNvL0eOUE1TUyjti_H0bB-UJPA&oe=69A19B0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
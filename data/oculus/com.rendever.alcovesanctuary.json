40px (2).png", "id": "1121899332145730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPFzkNRDERcQ7kNvwEhzEjC&_nc_oc=Adoxf0XoLq5KeJzaHtga6CBijQEniOmftFEibVOPumzf8X1onBP9UFd0wZwUnP30aSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwKcyfsmXQHgglGSxMO9yibqyCeJu2jZzus414SYy7GQ&oe=6A4FBDF1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ2Yg7aIiGEQ7kNvwGsTwFc&_nc_oc=AdqvLmtOtv5T7PvUhG5ms2RnX7CCk3nfSdwzLihTVsPfk3zc8vOLVrj3kOEQBb3gVyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUGLWvf7RYkV-XF32PsBz8zXrhmqsnCMZgFVAgejoVmQ&oe=6A4FB98D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejkN8fpwUdgQ7kNvwH-5LgZ&_nc_oc=AdpIY69x_hrJfIND-3D1IXRmCE5SdHqjV1QXN4GJyHZAravpleE3Dg706lak6sw9bA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv_rDdFsqv5D5utx7c1UVFiBjoGwLJiqpaiesCmpRtOQ&oe=6A4F930B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju5SZQmp__gQ7kNvwER48BL&_nc_oc=AdpPp7hHk9NVQfwMm0khHG3fLvGjkwN6lHRrrgjzvlHZ-aTUKw_-XN-gN3dllYZAi7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPWd19-tSAnuOmeE0SGnC_TcrInKG0vsqqqd6-7V7evg&oe=6A4FC01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLJjXmw91OYQ7kNvwHf3RPk&_nc_oc=AdoAGmkUqbgBQy1bRl9sPWvy7AplfVpN99ptmUjcM2C5ND1yNen8IRe9jZ5AyElAm_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKoMPJ-LNJvJl5lPo71UPspBoH-xoRX0Ic9FhUtMLXoA&oe=6A4FA10B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
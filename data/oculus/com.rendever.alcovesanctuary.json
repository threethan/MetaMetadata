40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy9AO5TV9MoQ7kNvwGXdK31&_nc_oc=AdoQqRMM8Uu3zS0fkZcR7MFK2fo1dbqmmVtQwIpy4xWfVQUlRRGsdrEN6M55yovGtbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo4JAtpdowu_srd33h4ukUY_0UAxDxa7Z1r13JXOS3Aw&oe=6A6232F1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SY37vl8biMQ7kNvwER0ddX&_nc_oc=AdoczjdEk41gph394NgZOlNjgeKqBjYB2OmxQbxrW5y-_DQPQlNqL2laJCUyAKeMPpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsDMoIXoxxOmVFO5lw1dTNMS7wnbH85P-_gmoIXORQww&oe=6A622E8D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsSa7p9kBToQ7kNvwEjZRjN&_nc_oc=AdpmmS8avgLe41jRCYjWYxTprkj8wdGe3HlRmC9-UADLuASkRRMvrD5R1l8nNdjbJOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmal44dsnSQB-Ne2mf75X2d9FVbpuW9E2QRHAzumQNAg&oe=6A62080B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRyv3UbNy40Q7kNvwEWmdpu&_nc_oc=Adq2SeuLXNMlJoDkbAyuOQsCSbhwOyTx3cZFd6mfmtH9kNpJU1tkm_P5yHv8CMc__3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChRz7MvhLkKyplkG3ZuUolYFqdNA5yCosgNmw5tNKjMg&oe=6A61FCDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc9AsFaviU4Q7kNvwGA8rwB&_nc_oc=AdoL9fbAoyf0uBpPzhGhaSRVIfWM6ZoSN-99G80BY5YdIuA9bz3Y3CkIb09-1of6owI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWMpaJwpemZfIFOe60btPkmeQ4hdfdX-a6tRwdmKjpWA&oe=6A62160B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkXOpJIoC90Q7kNvwGrf6ZT&_nc_oc=Adm-UyP-enLxh0aGi_GkS794kGrCl8lWuiY5AA6NtbHtb1xFSSGB_lvFMv3Lvxb_twQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuQ7_TYvIf5eZwiv6gxG1cAD1LV_mw4RFXXd9cfTQ1djQ&oe=69A422B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNfpmJ-wRDIQ7kNvwFk0KBP&_nc_oc=AdnENfDRWSYCHQs29AfipQN2gK91x1ShdOtEwvDKbBOG22vkCXYB_Y3nAF3rf3mJEXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftiYsXi1rF1J3pE-uO5jilYD2wBo6t9KzifAN7BGI8wxA&oe=69A41E4D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKzNAlgUnAQ7kNvwHYm7bV&_nc_oc=Adlw2RyTN7EZahkUIdMf4dx3bmdP8N3KA2m14C_cW79xdBM1K-XDwizcuPhlyU-1Vgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvdt3eN8qBaxOcLD0MOP0MR1VuCFD-BKFMA5nQ1sfYo0g&oe=69A4300B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMZoLwy9n58Q7kNvwGoMMHC&_nc_oc=AdkSH4BR7g8m557GIuYv1_3Otnz2LJjU1wSMV9nW7ixR3V-Oq-TrptC0z6B3pv5-NG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsyn3rsWrITwQn2Vd45jPy_Ye_gIAdGVlf8c6XIiC5Tyw&oe=69A424DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGJKEP0EVNQQ7kNvwFHypuo&_nc_oc=AdkZSJUmAG_LTBy2Z_87UaRLx1QyEUVa-Uqd3RgLoGCGlXrY4CQpItUGQztkjtzh_EQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuEKyCYPxG4_qPlk0B7nMRGQhIgs7yiEUMcGEXYGEdsgg&oe=69A43E0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
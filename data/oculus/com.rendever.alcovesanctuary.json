40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwKEvzO8szYQ7kNvwHyUeCB&_nc_oc=Adrs1kt6zAbuGzPsRUOghAeSR8OaiEeGEfYGI9eSRKNdRYxxcKOJ_Z9JoMnDMmeKrGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ylzI6I2JDRcCmJ5Gn3LDaK5Rhgz6Kd_izj_roa7pqTg&oe=69DF7631"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie2eg-e82a4Q7kNvwFZJyU5&_nc_oc=AdoO9r40e1zqnsv5x3uEfzTk6KPVhnJ3xWDXbNJJ8iPbvB9cfCGyEeeVfomb0Js87wI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25jMslOKhIO8s2TcvMCFzKbCyf1eyE1qskcd2Wr92JsQ&oe=69DF71CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXsFOA9OiSEQ7kNvwEYmb7g&_nc_oc=Ado5QSXxBH_8v-KKK83NWbBNkNn3_7JQjTMKYXPRwjTtBjL21WZbKi8KPlcEcOyxheQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yf2r4GTckci8tAutLopGUkkjqpOMfa2DhTyRqSwNHnA&oe=69DF838B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMNB4YIrBUEQ7kNvwF75dlv&_nc_oc=AdrMCDaY2_eNgcMj8e5-VAWY3XQ005Bobgj0Ri6K3HTjRQ63PHnzdvMOEJWIaNgW4n4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iHGdCiNX0U3nWTJkkOypCF0v2FinzW2W3OuUW5VrExA&oe=69DF785D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYm28zVq-28Q7kNvwG2baE-&_nc_oc=AdpDwf9i1OyetITkf8DBS-xDhZjYyGKgbClZkO4D59H5dSk1suk_lmeUEswNcK6pepM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UecF8eqw6GoggwhctCsxRzTp0JJLsRbilMjezcaRuDA&oe=69DF918B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
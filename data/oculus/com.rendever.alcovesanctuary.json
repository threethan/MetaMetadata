145730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ1LzWWvjfQQ7kNvwGY-pxO&_nc_oc=AdmwJWrv8lhtq3iyXy5ZEAujTV-Aw54zxN0lu545zArBdKv96x2vowWal4HI8sbdEzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybY7HiulQe2BlU1MzjVXBSml8lZQuLidUH52RpcDLY_Q&oe=69BD2F31"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUEcVWSSEboQ7kNvwHxya-e&_nc_oc=Adm-bdynpwPOpyk8RmiD-jBOKTUHtuAlfOhGnLekjk3BiA7bNFri3wdKv4XJRExt2hU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy37TsXy7OPFtswTKtH5xtVKMhLMboG-Vm_vBPG5oFZUw&oe=69BD2ACD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfv-eDwp9pUQ7kNvwHZdzyC&_nc_oc=Adnx0PCwYX9ZLRslIJKRbXilbvAIrUSrFooM-6Ane5F5643x93YAW_d1_CY3pbd8qJo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQNX0QrF9_fNY1ky7968xn6vRAC-OB7MlMYnvNYP63ew&oe=69BD3C8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNcjX8b4wjwQ7kNvwGbIVeT&_nc_oc=Adk6yd9E5uk_5aWvgFyJSU2aD1c7lolLTNNtWRKt56h6fVoVhvRelntbNsNA2dXLVhk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbzzB7mgrI5DJn_eDEGgkiMl99yCowus-vIcBgZJd7hg&oe=69BD315D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Xllo_mzscQ7kNvwGwPX1t&_nc_oc=AdnbMvPNZXmTgCxJ6hMQmdjcNrIH3NVwAUru7Wuxh8PiQl2Y2r4ieZ7pbZUjR38vu_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAmOltjvj-_GbKL3parLSzMQUx9uyvAfvX5nzlOnNHrQ&oe=69BD4A8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9085194931533488"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570292_943945173827567_7518984267903158519_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8CCGggm-UEQ7kNvwF1nk4h&_nc_oc=AdnEy6mhJ-jrc5RVDxW2kTu_81htUqKCEMZ4rqNNWUHnchi6cErrqsypFkqGzS6E6Rk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypiE1jjyZooxgt-s-pTI7p3wAWd3KbYXVvZEwdPe2Wtg&oe=69BD54C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alcove Sanctuary", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1735581420, "lastRevision": {"nodes": [{"id": "8668038959915756", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8668038913249094", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "496728909522987"}, "iarc
450x1440px (2).png", "id": "1121899332145730", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epzlbwDkxwYQ7kNvwHaHcDx&_nc_oc=Adqx2TVYtmq4JoBxZj6D7DXKVaRIgsKqROq2SAd0gTuFe-XHjp722UrfZFPYkwv6h0I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af931niwCebQFXG5ckoOJF7Fj2LiARNCg1fK5TO2547XeQ&oe=6A395471"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8U5CKzodkoQ7kNvwH-ZduC&_nc_oc=AdrF84PDU-ENEmCZ4UC8IboQGuANxcRAsmjFToQMFa0DVGIph15esnivsbjQ9a_N4R4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A-KQETdt7RNtbzARAjFcYz5CzZFXLvC9oCe7W742ZyA&oe=6A39500D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkm_b75H8ScQ7kNvwFEcOD8&_nc_oc=AdpeYtNM9UVuaW9KlEyH8bcJ3Nkj8zE6-11Zah-vdIF_3ZAE9k2AtHlzwXUCHiTtiEg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yuHIN9MkUUl1wP-xrBWnjqeh3QYXgjGsZhaemrZFK7w&oe=6A3961CB"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26knQeOHix0Q7kNvwGqYbcN&_nc_oc=AdqRbwNkxwyNrOH1qpOcfOCS6PGGX9edj-_iSXKcznQHjY2WEdm0DLxs6GzOmm5P0pQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WI7dTYYRfMoka_KtTzvfQ1s2HUmldsfLXNt9DPfnG8w&oe=6A39569D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq1DQVxF9xUQ7kNvwF6KDnO&_nc_oc=Adqw66ZsSqHGSruDQ1yuEWpw0GzAsok5t6WIwNA06iRZ8QlfWtWtGr4qtuHSdpog-lw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cTSzY87gW_AoEMt9c98aY-IIFzKG4AmEVDqr83coJtg&oe=6A39378B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc"
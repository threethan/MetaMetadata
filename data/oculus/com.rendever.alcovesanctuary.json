40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhgbVjtwe4YQ7kNvwHflOKA&_nc_oc=AdrsBsEDHEYJN9o-4Xjn1oQ8XsvfSYDH9QeIMpbdhqxpFuBzAkghswxASoUodihq61w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEdP-RalfEXZfn7y8oOS2fQXYxcYGa0ze4MCYJdNYcHw&oe=6A5F57B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLdHyZhrifoQ7kNvwETRc54&_nc_oc=Adr_HcSiKu4xlOb5hqsgcg6YkYC1uc6Nzsx-U4yMmbtRHcCBRAazCoLPTEgMeM8Okf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHoxwWIHNEwpGKnjGo02f2iPTpAUA76a4d2YH1QcrFMg&oe=6A5F8B8D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAKcm_U0XTAQ7kNvwGLCrTQ&_nc_oc=AdqNWTPYOYZzxhIjCNG6EI2-NJTpJC3n0oMgkjgE7bq3Y2boRNYlyuOnCscIlcrfnls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoc0X2lzDo8mlRqWJi3eylZxGrvYGcG_X7_hBnu_WBNg&oe=6A5F650B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRyv3UbNy40Q7kNvwGME-QM&_nc_oc=AdrzOpupI210538dBjvReaRR7kY32v6h-Pd3Thu3SxHXUEuym3pUv2BANmZw8UTjOII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtXWKMJhf9Ii1ZA47Q72YEFYBNssVD9ZSOtNntC8pm9g&oe=6A5F59DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNoaxdrViV8Q7kNvwGo5rHn&_nc_oc=Adptiy8u5m8vR-oHyqXe6JVib0vSw094ZjB2fYG7QW6-BZPGhbSm37dBR_gTP5IH-a4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWOF_0s0B3dauOCsxNU98yafhr7QdW5AsR7VaYL0qBmg&oe=6A5F730B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
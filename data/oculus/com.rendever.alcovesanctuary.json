40px (2).png", "id": "1121899332145730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy7j0BNRIC0Q7kNvwFl_DnT&_nc_oc=Adrdjh3rdb6Px1LNmrI1Gfc-JgOdSdE88G_OeyhrlMR_iYZqQu8AjQB6NT8EaJeHvEU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJQPnc4AGw_WU7-Ay5-XYIG65r_5VBY1UPieNtqQ6HsA&oe=6AA02971"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL_k4-PozbwQ7kNvwGYGgiG&_nc_oc=AdrMZ3hOKlViGfF_jp92feR2qGt2T8P2cPS7YT6Iy7k5-ktqTWDcX0vR3aIWRdJq9ZI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaSVLackDEcDDJwF7WxngsRXEiJn-WmaNt-sLlq4mzsw&oe=6AA0250D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-Y1Cc6QjOQQ7kNvwE4VmeR&_nc_oc=AdqA3-7PYCLV96X44LO6qqUJhbNzkkm3TKK0drRNtAdWcqWjlTa7W4sVhk8PJkqGzzg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIWl1PTJZ9rmgs1x5Tq7UzmAesgFELAAOwJHM584rKQw&oe=6A9FFE8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-JcY-lUWkcQ7kNvwHjyd4C&_nc_oc=Adpw-n3_EiPy6XKDgz36-p8OiBkf5Ux60OTeoXYn89GKbXUdlmbey0X4NIw746LONnU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMT2yMjD_7ZcgchBut1u8VgQWKUgTowOt4IgicmpcHrA&oe=6AA02B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzN-wE4RGckQ7kNvwGnOJ-Z&_nc_oc=AdpeBcbOxDWPKQyZrr8-QNpRi4RQd9FIVSIUsDHVJaLxpWIAdNZQvPZnDE2TTiTlY7Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOPap3StOjMsOFfYVSf4XN96cL5JwrmteVrR2ozaXzuQ&oe=6AA00C8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
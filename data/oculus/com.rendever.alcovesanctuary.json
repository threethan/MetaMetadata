31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFi1z5BvNNwQ7kNvwHmLucy&_nc_oc=Adli6EcuVFH3MGIUz9nQDZzog6EQv8g18pkWRFlnHrdl9mzm25Pb7BUzb64nH88Z2UQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu62dqZGWKAhkchUuS0pgNxrsnK2MFUR980NUSPmcniaw&oe=69984531"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htxqZTqKApAQ7kNvwH7ytE1&_nc_oc=AdlqmfEtyzQ-c_LRrKNfndhAZvhB3213ksYAXnhQv3_F0-lRamKXjpxmYfpcE00Esso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftnSVuEA3CtKBjEg_J3YwgRZeZ6bFsDxQyfzK1fI0iz8w&oe=699840CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJs2WZqKf-wQ7kNvwHZspJX&_nc_oc=AdkaVT4Cp2hkn-iBQcBPoChQrnXaf3Yr-_u90ppCGhJTgpl8cg0PGMUnoBx1QrB7HRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftix8LGOicFmsPDtQprcZUrVCr9hebhSmEwMnEy6wWhUg&oe=6998528B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eojc7smPA_oQ7kNvwGGnjhy&_nc_oc=Adl4in1i7GtkZsuMXxuuPkcD1nNAgneQlWIJj7JubtE0ZNF1EBBLlT4W5Us0o8Qw4uM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft1GIAzR7hvaZpfRKuqeMlMgSHtgLAsTeTBOEDYJRS44w&oe=6998475D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q91ew838ioEQ7kNvwFccBXH&_nc_oc=AdmZe3lgcaOKhgi4QQGGtVulcpyrl6gP8T7cJf4EzC4gYm9kKzqMAuBNdOK1CeBvItI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuCZf89hJUHzGeFv3i-OM3DXwp7DIKJzZ-QTlL2xLC_eA&oe=6998608B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
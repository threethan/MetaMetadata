40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7OYyNKotWkQ7kNvwGKzdKA&_nc_oc=AdqGtnR3QwhB0oqSLBY-EgQoYv7DWV1YjpLMmZOLc0AMojVxCBUeNSc4G4oeTIbpGsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g3e7-dIV7JHgFhysctBEals0lpwFqr7XXrXTCwodfJw&oe=6A316B71"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZWTcAu8SgkQ7kNvwH8Hnxx&_nc_oc=AdpicRm-z0SJxa4OkltDpX5xe8veaQPUuUOQ-zQ6MbifA5khMnw5nrhOGFw0xmNBWss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ixNA37DjQMyVWW87T8G8PaaMidJvtnBqXhRw9lu5eSg&oe=6A31670D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nviraoMHXwQ7kNvwE9SwfD&_nc_oc=AdobL0imKj2RmyW6VhIXspXEVqCmZJ6OugrwQ3Yap3_IieXoytud0cRtbf-TmUIAG04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nsI1ex1h8NagRa3w-mwMEwY0z6bpdTTuphPIrjUkoaQ&oe=6A3178CB"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ48tGC7mRYQ7kNvwEbv67I&_nc_oc=Adqif9q_b8Mx1hU5XglxV12tPgYlZBDzF_7jBtNpLLEMqRGisZRWmja87Bj4hU_t7Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z1MmWYWlpu0doUQPS4x1xBI3hQLIDkKvnXn-STvjskw&oe=6A316D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I0z5pOJWacQ7kNvwG2eUTb&_nc_oc=AdqQkoWHVrDDtZHkgfEPypk3Soshp36cMkSxzogXxIbGHS_1-ZEVAuXWkQaHc7EjTME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qjNXe-eEgjr4ZnFEeSDC7T5dGvyxUb8tKHB7ebpXJVg&oe=6A314E8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
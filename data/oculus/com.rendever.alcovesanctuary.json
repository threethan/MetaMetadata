40px (2).png", "id": "1121899332145730", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk8k5zIVBs4Q7kNvwEdDvDL&_nc_oc=Adq7Q0ehfGh1rnf2g64rCqaYYILYtKPGli05ojzW5s3-miEGXIPUFs2xzBVvdzOOE_o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dS1i_k29S8cOb9VHpDF8IJOcUSHG1FOGllBfJoJuN6Q&oe=6A09DE71"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAwYmwPeIVwQ7kNvwEEcY25&_nc_oc=AdrXPhxqaJlJZP8SZY-_eQWTwuoNXbJU8CnG6XyfadeMAFfmAYYdTXfzDDZD-u4ffJk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xUFx0UUq6EFRRcqIP6BbGezVF_wHLzjmVZR4EicuSUQ&oe=6A09DA0D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P6EhqeeyV0Q7kNvwFoWUAD&_nc_oc=Adqz6eDEvUodrqFGM1h4KtiCx1d7qQ7Q76xCWYhAcwX7vj8K_rv0Q4TZ6lOc2zc3ERQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZHANm_SbSXuI5ibhRt7arRzLB0J4O0am3NGsE7wrvyg&oe=6A09B38B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af_rAVm78lAQ7kNvwFUZAL-&_nc_oc=AdoPwemstUJGgokj4X-vm1tExzxoyeyXZdo5SiXZR-7_MKXGoqsXBnTdGatrcwYHXdE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vvU5V-X-zjAsImHC5c3vbTn5JKo_TWP585tE5-CAJxg&oe=6A09E09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOD-u6Ypex0Q7kNvwGcpzjN&_nc_oc=AdpkQm9MCEifI1DPY23pGYXJSySUJe51LFx_2KwoyoI9vNlX2BvoeTYhoLkDOKRkXQs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LxC3x3IrO2KNuMfzgrtHuoNfXv8y16DaS-QlZPbA7dQ&oe=6A09C18B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
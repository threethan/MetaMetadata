40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMw-aAsmuPgQ7kNvwF82l74&_nc_oc=AdqwSp87s2u7GOabuivVzTACO0UOrGqdQ3jb-HeQu5zQr3CklS8XWxbBWJBg4KKqStY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r8dHXitOcw8eyWnmrPxcfZ4t71sobWECwFM9yWw-Ekw&oe=69E8B0B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOW7qGnBVwMQ7kNvwGv2VXc&_nc_oc=Adr51sNB7hzZdTzhYtvmfm__VKx17o_31LkUK3vNbcTBfZBnp5Z0j5_y023aTl0RZcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c_Y3K0-TbYjz1jBHUTIrFCOzfLJhBNAMXj41Xc-LoXw&oe=69E8AC4D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mvjn7-y7FAQ7kNvwEJ3zcZ&_nc_oc=AdrjPqAUqSr0fCS8QEIco64KUIQ73g1qBmXsbSikaUw7nwr_fUfdkKXc8Uc2fnsQeUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OC7zSRoKK6K5AeD_iXN1SYNQIWo8V2us0DQfdlC3Urg&oe=69E8BE0B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHLQG1MnzFoQ7kNvwH3Az7B&_nc_oc=Adoeu6mAOYD6PTYXGn4zU-pJw6Jhs3wf_QWy9TzsdM_RHmA86BO83fSdnZv7BrHErmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DI2PQrKySzBBI3fNN69dAJSStwMmi9Pq-pruNzw_Khw&oe=69E8B2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyjbDYq4oIMQ7kNvwFCm7iO&_nc_oc=AdpyXnfIyN1aeCG8ZQLtUZCoS-U4EMwphIBJI78gOsXTuH4LGmytftVrz7iYmdAsZt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qwPNbRv4b6_MYFLKWfkPvHurSFJrrdElga7hHxviRLg&oe=69E8CC0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
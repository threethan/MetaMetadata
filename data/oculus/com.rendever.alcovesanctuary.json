40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtpOb0WvL8kQ7kNvwF88ksp&_nc_oc=AdoTRXyH92tn5SESHb9SUNI7eOxzq4fhJ04Uo19ATex7lkvxVIH-uXszzMdNc8x9jWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVXoj-sFLln8aB0tSP_pAZ6rZpUiHNAaLv1LjZ0Cix4A&oe=69C27531"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zXkVTwhFeoQ7kNvwGtoGmR&_nc_oc=AdrrVzIdpqRw7mAs5ul7Ql0-15s7MtWS2Ex79PjMynG5g_z3KkjUErC1xSEWJYWxB0Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq8o2YbW_SicH5PWBEhb1xWZhGVTpNumerfQ8yLKcikw&oe=69C270CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HHzV2bug8wQ7kNvwFgD2Kt&_nc_oc=AdrSakmMq-97md3cDzTtt3mgVORQTx4DP6F2Q3-vB6ODpyUxJ99U_Dj49VbNEU1iGrs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPEBKCHmLCyjrB-YKXqaQ-l-JCqZrd-bycoRUQccbpIA&oe=69C2828B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHYt04lgZF8Q7kNvwHQoDRJ&_nc_oc=AdppD2lbGPuwJwhLwWUEKijLgXv6UkNnvQ-Tp0KpGa92H9Zy6zGrhyVH-21guh78l-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_4Ci7UXFs1UyrnNS1w0TI8QQNAXP2bxhIh1tWrm83Yw&oe=69C2775D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhY9z2nHX8QQ7kNvwFOolSm&_nc_oc=Adpt5YG_CQOPYMji8lZh7mijDKvwKAkTH5FA2jS3ZKL79M7l0TsRkXEb4tXuk_vNCys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxF5fdYFRaimjJz0wqWuZ487nzEqkhJ9mkX72yC2uuyw&oe=69C2908B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
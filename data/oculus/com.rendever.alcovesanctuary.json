40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGuvL2A19LMQ7kNvwESAtIU&_nc_oc=AdqgKOhL5EKikZXldXNKZfJ5b7ZMFtpZTcnpBMSXyG2ZAiWYdXji7y79wNPDsVWIFFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST2JN6JAYWej2orR4DeIgzsDECia9867SuVMHAU26jSA&oe=6AF72C71"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3nvjMAkoC0Q7kNvwFqUysf&_nc_oc=AdopaPUbLUHZlYIXuVX-rt0-ZEPHiIJ_fYSOOcOL9f9lZJ86TukvRq06ix6KDE-no5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbWv91FWJiE3pdwEA5g8KirVokOo8J0BeSfDWoWTpcRw&oe=6AF7280D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtiqTU17M5EQ7kNvwHMmxIZ&_nc_oc=Adqql550HG7VTXWrdxQpq2hYV5nyHrjOeBE0kk6jmYcQyelpBnV3q9sIy-nqEz9qza4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk4ztZT1gIjSXnsbLsYPsPJ6kOewMRwGZ95_qRzpYTBQ&oe=6AF739CB"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GWSao4V_Q4Q7kNvwFZeVXF&_nc_oc=AdqngcyHawU3FJJFkxMmB00ZiijBA_3NoA_Aa6FRAND6NaN4bEZGUfKywKxEBDJf6CA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRch-InIRWwODxWT2DIxN-5zvnAVoNVRM9UU42s7yxHAQ&oe=6AF72E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkOQ0-VIXV4Q7kNvwHN5dgX&_nc_oc=AdoBGIN9B72CvMdWVyEGt-h1zOShwoGPO2aHhJzOZuqaN--8DeGLf7KE2J56RNXFOKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyWeDHsNpx_n1_NRuO8ivh0ZMvx-ZNK2Xk5Br-PhnMDQ&oe=6AF747CB"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
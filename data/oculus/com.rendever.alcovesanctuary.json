31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZiaNnPmbz4Q7kNvwEMQtqT&_nc_oc=AdnV5cclT-D_2gxtNAzDlzKcNDAfwkcuQyR1ZPYDQlfEIE8SEbIG6CF66b9JRtdZMis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqJV1FClyYiWJouVVCG5Kv5Pnre01rKrllAu4g9vhjYQ&oe=69A2D131"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNfpmJ-wRDIQ7kNvwEh4qIn&_nc_oc=AdmZ6Hc8u5SFb7sbpB4kg4KIJJz_tgT8TJjYNi2nQnbUyit735a6LhoCdy22mFCfMwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3Giu3H2owamknKg0J7mt4lY2aNu-C1F0ASLfFJXWVEg&oe=69A2CCCD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKzNAlgUnAQ7kNvwGhgIx-&_nc_oc=Adlmu5t1E7zdorGA_PCsr-uUK35eNr8rfsJAQr_WycsHSCI34wJTAIwQcu8Nsi3xOG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFqwzR_MGiB9eyXQzl1Jdu5SlSCA9p43SORZTKm_hitA&oe=69A2DE8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMZoLwy9n58Q7kNvwHD3iHX&_nc_oc=AdmemVNyrjnQuBkiUo22XI449yvov0SZUzWXkfACHkJZOMGyght75aZUgtbzJPmnVa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvbWhzAHkGXe4Z5t-qedBzK3szPtNzl17MPy550ponWA&oe=69A2D35D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGJKEP0EVNQQ7kNvwHJC4Ie&_nc_oc=AdkMwT2fECBWeXqI_SODHmyvN9Ers5-ZFuNr34MEQHpvMag738khViJfWwJRSR94nV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmAlghglCphTNL1tSrpBmahwV0kczXZ44lktH2SAhatw&oe=69A2EC8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82eBigG9_twQ7kNvwEboryv&_nc_oc=AdldwDXLaRBLu0qYJ0HLLqTg1JiynN-a69j1d4RCAk7V8f3TupmZ1AM9bnmG2axx3jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCWr9GTdI0Ud5tQKRJ0JsNA5ZFFVV1tauZm5a8fXRCpA&oe=69B2A331"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXjyEsLyviUQ7kNvwH8vUzo&_nc_oc=AdmrwakVjlVC3zaFmuyvmMF5F35isew8_bf5lAIXMluVC1VN4mvL7ZgkvwsUADOkDno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxScEN0eJGSzKTTT8SVdotrhNTzf7QADqFNhi_jA0Dktw&oe=69B29ECD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFXIzIdYQ18Q7kNvwGGuqD7&_nc_oc=Adm6QNuYGzwoCmPHa41kGrTBD4ZJyweyvA6xDOKzwgWzNq3_XtGzMR3ltuePf-aZ1s4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz087vnAxziUStpMMyPInllyewAGz17OVBh2_ptkMsG6g&oe=69B2B08B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttSEoWapULAQ7kNvwGgkUtI&_nc_oc=AdlrySKy4DJ9TIqH6DbtBLTXabiOg2VsSnaQhJz1wJjHlDVO6CV3h8wFdAqamZa9OZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrCrSCW7kYiPvHuEkwOWIPRVHaeDkc9VbS357WeeVaCg&oe=69B2A55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRJbFqsjZsgQ7kNvwED6ZPv&_nc_oc=AdmL97jdw_6nxUY3nRDoDxk32NrlHSuMcFyWTS07IQyyZeBRfUUKPGmKmSc9TQ_U278&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyrdrDCVDCb-nJu927ennD7hD7xCzeVhpXKVn66HKkTw&oe=69B2BE8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9085194931533488"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570292_943945173827567_7518984267903158519_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg2w5MpmbG4Q7kNvwH6_JwS&_nc_oc=AdkA1sk4C-qsQqyHlItKET_-X9gNN8clNFSO8LxJfULuf-QiLk96-rZzjkZPpN7eEHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaK15G9bGS82Xa204OZqwB_Yx9I1u5hbTfKwF9N3f1pA&oe=69B2C8C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alcove Sanctuary", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1735581420, "lastRevision": {"nodes": [{"id": "8668038959915756", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8668038913249094", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "496728909522987"}, "iarc
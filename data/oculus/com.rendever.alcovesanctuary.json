31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy6LUnqdpDkQ7kNvwHh0mUp&_nc_oc=AdnzA14KR-uOLDcYdcqIHQs8yE372IoDl7-SXT8Hm8Z2uIU7vmptuIrshTKKyitq4W4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuCRumqTFjI0jVeyeVUOCVGuO3mucsAQH9x45fz235_ug&oe=699EDCB1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVA6qAotwqkQ7kNvwFRRGOI&_nc_oc=AdkCuic9U7oCds_vBmnXfMpdolJZpZq_G4_T6bGTFEAJQWuRcEyXlTaz1EwJt2RaILY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsARrBIJY3GeHm5CZztHkkAyEapdW1TbJjqnsMn_pNX6A&oe=699ED84D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7NX4hXor4UQ7kNvwGxdg_M&_nc_oc=Adl6rc7TRjodvGk4Z3xFFo2jaJRl6CWcDEfy1GcVR5Vu52oomk0FHc7OLSFu_V2UFT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvpzk5QSmzpU4reAlgxsuUSSQvD_OV4danNtf6MaCAEbw&oe=699EEA0B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVybIC8SGvwQ7kNvwHGo3H9&_nc_oc=Adl4-U0Hsp2Wz_agz8GqUWAcKmpzEnGutaqm3SrqUzpPqbRlW762eBFJL7jU1hDyakw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsFn-SeAtNpgtAYjeU-E8urPEsYhEbgz0aQDezqlAEmTQ&oe=699EDEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6TtIQYAaKUQ7kNvwEHXcIw&_nc_oc=Admy5I3coGVH52XAwrrYjSiIC-HXXj1viSKoqhUfon1lwGjTUgSjE2TziOdrS92mxUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afttd9i-jlHZLaB0NlI0qMh-lX3yiZsHgnKNUKHnuCNQHQ&oe=699EF80B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
40px (2).png", "id": "1121899332145730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAmJxkG9y1IQ7kNvwF5HDs5&_nc_oc=AdqRxTCHc1UuMkYtxKX3lnteebbsQ9HFawu0LzJTF5gOy0TE94g7jQkqvxJ0_hSsKAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dhiOTS5s-bxd4czaALW5S5SCp4STFdpTMi4cLo5b3wA&oe=6A1EF671"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-xLrwDG1OkQ7kNvwG87nt2&_nc_oc=AdpKejpcrne1O8RclmuHKL_Tf9nGrLU5UD3oRJ9_iyZZw3qGCKHZFCaMHgtLokUiBqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JPFgNaFxJMrjoHQNXDtHaymd148HTfkOUejvgZSfDWg&oe=6A1EF20D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCHGA8UW-1kQ7kNvwEMr9qU&_nc_oc=AdqG6P39V0oURHI3rRAcEe3C5dic4XjsrIQgM6qET9Rd7oawic5UmqQmP2wO_sQVOfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VNb4KI4K0AHDo1yTIaqdjC0dcIRTM-WOwmTn9wnvwZw&oe=6A1ECB8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etR9b_8Qw6YQ7kNvwEf0AqH&_nc_oc=AdpMDC1M_mUye9bf7Q-LjyPGM1GRZH8hMYWKgfguiwTR15nxU5-Zx93sJrZs7xRQjcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ixhHfnT5SZ8a0NdQ-aU4DjT9bqgLRSQjKBGPHCprqEw&oe=6A1EF89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYS6-lTJM1AQ7kNvwH83WuE&_nc_oc=AdrSc3T9ulIW2SdlYzQvTKEawYzQJLMkB42y6pSkzTpisFC_hjhLj5dkDP2636ewqeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o6_BBOAicoCQSx7tw6kLocwiYe4Ud0p1mJwO5jWIzvA&oe=6A1ED98B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oanFGlz4jUkQ7kNvwELyreB&_nc_oc=AdoYRCTfBPpgPmrvq58ZFGXUeD_gkgUB1ThW2riKKy01QDjF77_oDfJGwbBvmtmhhFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQqCa_zy5iAAq72PG3ex309y1LYtkApnm402EGa5jdAA&oe=6A7712B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAPps3EijwQ7kNvwEvUF_8&_nc_oc=AdpHcX2jYRVoG5V9y7H3DrRCtl6DxCPaGEaKcnSKuLPMtX55qmjuoMUySGw4FJtthxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5u17Qr_-uVi66UNLzcOOrLfn8FRVmAdADjU_3SP2_iQ&oe=6A770E4D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv81ayYEoeAQ7kNvwH125Ao&_nc_oc=AdqavCe2GIjefUOH3TzGaS9DOOWJXS6-W7uR-J9YsCFrQ0-DG3qa8X51Unmj__SgItA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK61ygsROHPAoOIamaciEDPBn2TLNa5rxi1xBPXQdMhw&oe=6A77200B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou2h7zuqnRUQ7kNvwGqjWUF&_nc_oc=Adqatp5GlSc8SrcNRws-2-deR3FKFAbNFRF6kNLQv616TPoAsynVmViGlJYPrPcaD6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaXor-IZNSXQHE1BqKNOnaWZ6TBk6DoXu8CP5U5gwKCQ&oe=6A7714DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2EAXYXl-F0Q7kNvwF9k6OX&_nc_oc=AdoJLdj2JYA3_Eis0GbnWbI3ZtB3uzPiQcWGv2yHpPls-nLgxcOuoyPJziswaEJXf_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVCL3T_YmTPq7Iyh0WDCP2jXN-v2UVCEOTYXOiQTLa3w&oe=6A772E0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
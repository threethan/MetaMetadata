40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5SasFtKI60Q7kNvwF1H6XY&_nc_oc=Adp-5eFG5W6W3iZjYdTPsomIM0motcUlxYMaknwTE_dKwG9Rk6gm8_4ofrzymoYguqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LzOUg1-VWAzEV3doE1PwpSir73oUkpdUa82U9IB6iQw&oe=69D398B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYcDd93bXDwQ7kNvwH35DYz&_nc_oc=Adqo9sXipCqnXLsh6pgrYODHv_mG_HK0b_-WNBN3erGW57tkUM9_0JLTvT0KZkQ-U_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O2JAfn12D8nDQfnDacof7pH_q2N0G1Etld7ubt0vJ2g&oe=69D3944D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reut4oeUR8UQ7kNvwFxbUKi&_nc_oc=AdruyeBPYkp-nCqS9q76QKCMj7U1xgZGDqrmqeG8X0ZSw3_BMWX2s6C0j1-94lrO-Qo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zl1HYyB4xgxPYJrENmUMsUrOijsIp6_f3UT6KhHZIWg&oe=69D3A60B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEPdl-qSqAkQ7kNvwH-7vVa&_nc_oc=AdobO6_KM49D6x407RFPCH7E8f1R3iqJy-YcXIWcHOQEK8oZSL4I4k1frPSR-6qei8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kPijTktDODo3bCFRwVu8o5WBxvIKEdmRxw58RtkbfYA&oe=69D39ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFreLVr0yFMQ7kNvwE1O1d5&_nc_oc=AdrBXrEInTlzhRY2hT8twajx9omID2okCrJOCaetGSxsFW_mPhSqZXLlWbKLbonqq4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20pmp3spmLMu8TpPf4cayOwf-zvG-euYbtWaxQhOFVNw&oe=69D3B40B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
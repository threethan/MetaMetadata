31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZiaNnPmbz4Q7kNvwFtOwAG&_nc_oc=Admy1b94F06AgYziraHOzHLRSRljPBK8yant_E78wCC4jUIRr8QUjCNiIyPge74lFbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsyOX4PvBssSIqRKFMPUx0hxQopYM0EHDlmpNGxZNrKIQ&oe=69A02E31"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVA6qAotwqkQ7kNvwHx_v7C&_nc_oc=AdlkCJOOgd9SivQobmg_I4UFxigYbX7w9FED8OqyEdCPXTc555OlulO77R6_SYR44OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBBLx3Cl06A8Z4OswuWoXYyJqNU58IkXdan4KhdZHrHQ&oe=69A029CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7NX4hXor4UQ7kNvwFKNTCv&_nc_oc=Adm2uwhumlPd1RcpmrSF3JRD68BKQo9Pjm8gc5XoKYktiPOUyi6N07QiFTa-Ud18uEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSXRXDKXbC4uIPlpRg95duzQmSkNitH1Ho_z0D-E8aNQ&oe=69A03B8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVybIC8SGvwQ7kNvwGwCx5f&_nc_oc=AdlKZZOqAAU_wMC79j8sdtK0gsX4_jbnLVoRT1WAGMzo_4mJD2_e8AfBKSUfSPpboGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1l7nLy3rGflCqXxMKg26nql7cmZUODv3ree74bzSr3g&oe=69A0305D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6TtIQYAaKUQ7kNvwHGWDI8&_nc_oc=Adk67dCbylukS8cfySNvH4XGU0y746cmOo1bxUm20tZJ1gXBpSChb2VUZ399qmRLauw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7Sm191gm6ZWjIBiaDFXy_y_cum2Pinmsaj8UtCLWjNw&oe=69A0498B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
40px (2).png", "id": "1121899332145730", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmWGhDeubMYQ7kNvwG3K2aI&_nc_oc=AdrkkBChdg3Mw99s0X9_pwA5_mVTiaaKiHfJJGj93WaZqgtpQ7Z1SJDBCMk6V9W7I4I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQgceqZzYlpfkbmYXkgnc7Jv-rdL8-u7oLdYjGoQKa-A&oe=6A9170B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sz8tue3uUdkQ7kNvwEK29hH&_nc_oc=AdpkWnrOsdzfWxffI_M19RCDhMfkuTVvfhmqMSftoO0-qllRcZhI0xNrAs4zvjgb2LE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEvCu9dvXasyU0ukAcJ5hz5w0JINR2Jan1H7Z1xPzK4w&oe=6A916C4D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpSJzIXvmbgQ7kNvwEwdGod&_nc_oc=AdrDakaR4Fk5X87lAe7yCljUd-0yl1JwOe-Po4xH68DsvwVKXOAUGZv1D1vpaNA6doQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFctUlQyKi5aNbsQyd9Qa5QsZJOI_UvIwA4xmxceIXQNg&oe=6A917E0B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ5wSHKBlxsQ7kNvwHllOL8&_nc_oc=AdrRcY7NQSHkfOC4mx-X_0R3CNXn6SGBnEsMvZPlvXaiOSXX1XFmcNhgcKVsVKU86XY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOyM5af12YMdf7tN_SJ3eYNozYF3QtfqFNSSnAa3U1zQ&oe=6A9172DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_Gl0yyWkaYQ7kNvwGfKKNb&_nc_oc=AdrudaJYAzOlvVaDnoWzbBTWFbZRy1s_7caVaDbLp20GIywPXQXUxA4pqwC4AHnc28I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPDiXZj5BtKF8tJkd8_1BulsGvjhUfI_S0NMLRwgRg_w&oe=6A918C0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
450x1440px (2).png", "id": "1121899332145730", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVnVrK9xmokQ7kNvwFV0MOL&_nc_oc=Ado3Jb-guopW8f2OdLGJkQh1O45BKO1y5MRs3VCOb7f_P9pr_xtAkckhofmna7bm4sw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Sy1jRtvKAaXGjKEqn3jfMmz6CW4WyZz3JNC9zStjGkw&oe=6A468371"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_9RGc7eNf4Q7kNvwFvwp09&_nc_oc=AdqK0nu8tHaeLIbdBa5vuhSsGpKi88qj3uyrNwwa1W51Ek-EnKkfGjF2dKpFnSAM-o8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wYhc_3YwiZUrXfywRavZELK-7P3wqQ39piHYYjO7p0Q&oe=6A467F0D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-aPJaM73TQQ7kNvwHvOcoS&_nc_oc=AdqWueGEXk8e1g_0vZVteiXAy_9yo6FiJfxQVKIMqrnKy3gheHKeA2RY8xaDHQPhASA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hVfoVbxTOa25M2Wn8Ev-rGNNANdXId6GCeiNlXjGHoA&oe=6A46588B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7seM7TtpRaQQ7kNvwFFB_lg&_nc_oc=Adq5GTNHTMS-H3PYHvAD-T9nCVRKSUnZfIYGIWCSBWcqKaYCxkQPI0VpomICU9hMOaI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dbrEbtNnnR3KUf9yMvNt6ul17Tzu60MqFrAivAGphew&oe=6A46859D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TiFkid3VfEQ7kNvwFHq7wR&_nc_oc=Ado-FpaeIV7nNKcZboZnmshif7eYB7AfDAIDY_OLZ4uqxOm2oVpSawEV2sF8E3mVXhw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HwXv94VfuV-OhKqaMG5G5ZvkqLiX82yTgsELPrBoqAg&oe=6A46668B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc"
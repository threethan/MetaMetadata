40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tckHpGe4pTkQ7kNvwF95h7M&_nc_oc=Ado898DEBCPVMpZfgQalnfzjHu-LOeXeSgAK-OrJ7RL5FGRmuNjTef12slRXXfgS50k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExAOpAW6Se_sFpXpwWUSih0zmdgpFocKyY5Rcx19cRmw&oe=6A746FB1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAPps3EijwQ7kNvwGa2c3T&_nc_oc=Adptq6nh9qlycuxlBSjuDPDJWy1zcB5-n3uGSO2mUb5neZVORVFG_5FYd4_nXDRFFVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG633XQrYpMh5OIZNTxBMWDcobyLIs0tcEEevsH1swjOg&oe=6A74A38D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv81ayYEoeAQ7kNvwEk9Shx&_nc_oc=AdoFFIGkHVQjJFvJkaDUGjF0ncUPl7mGLZUh2AVZshFFc0bpW5fXg4ctjIJp5CeO1NQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Vb2ych4ygLj78cZ39i_qwoXQKIcqXAeKqztWc9-WGw&oe=6A747D0B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-Is3bfZws0Q7kNvwGdy96q&_nc_oc=AdqgsggW53Yyz4fRvQVZmduglizJcmKzqB-4hCvL0c4bfdcTKDxOE8TY1EkuiNYwW_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwqrPEy7XB5zKxootsWwfqpYYce-EmQvsyfbHBDNDF-g&oe=6A7471DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2EAXYXl-F0Q7kNvwFR14K9&_nc_oc=AdoF-nCzgeN7f35JuZDbj4dyMVuwpShGwT0RQjKgzIRixIBNRMM63pzcV_TAdXoo6lg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHeVoG8JKX3WJ2EHAbTsLiU9OWT6pW8usArR2VVQ9kJQ&oe=6A748B0B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
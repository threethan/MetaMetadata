40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9_NjPRmS3gQ7kNvwG5omDK&_nc_oc=Adp4WVetYC9mwpoivrRMNqxDPhpwcXInxrIsQf5NRrSFEDhBse3MAw7LWOfEPLL9CxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLTGT1q7nZ2wEx7wF9pt899h34pg5_SG0gtZL3DHVCOg&oe=6ABA8771"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1H-JnYDDjgQ7kNvwFp4jL3&_nc_oc=AdofScpCbEVjKVhPjxrR06igdCfGHHmbPEglY1I9IPmwuuA0Qq8B0gEufzv55rts6eM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdpaosJtymfsyACuH-B-bh_hDi5kvq5PRTQKQ9DXXqQw&oe=6ABA830D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMZg2cScV3QQ7kNvwF0VbxO&_nc_oc=Adr6z2FJKrIjFZK3_4GT4kiz70C-jmEiW8YUeXI3_trHqzHaiCpVIXPjdc38-oKuNNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILs_bUscRJbiQilcQ5Y0rECQz6XqKC_nCPJc4hGGS6Dg&oe=6ABA5C8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sn5knvNecCQQ7kNvwGo7lx5&_nc_oc=Adqpr9HASFKYHna69VaMrKiAtJVHpCCXRkdmxhG_Y4zlpDx2N3Dw6qMZ8XSkxTHvy_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1PhE1i7z8rJTcF9y1lR9yFhUQZ5zR0yXegHjc4nU7Cg&oe=6ABA899D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2Ge8CGj_GsQ7kNvwH9ceS1&_nc_oc=AdrfXF44mCdTM0sQyDjXgGqhplj7JrUpCKrE-Uz6av-OklMCJDaXwtHKWtFnDbbgQfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp66yUrxyESkFqTC_qus5bx2lWc5ckwrIm5J82PvEg8Q&oe=6ABA6A8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
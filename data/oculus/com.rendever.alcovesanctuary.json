40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX5qxW0HYMgQ7kNvwH0N6WJ&_nc_oc=AdoID0XimL-_MZUAWpAa9RYwPXpctSD3cG-U7zGMozux1KRA2QDU1Zt32JhvDzIOj14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXIZtW4eMnCXt2mlfbLqXeWUzGTxbAmHT0yDAnL74ZyA&oe=6AAAB571"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNkhqamQWmkQ7kNvwF-0wbq&_nc_oc=AdpXrXfFBu2viD5QuYYnZDnfBrjdncaa2pkrjIIgkt6eUzONUr3CRcTqubvjMeTwd0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc-QIF_mlfkdrMsWBuoMh0eQCkuxxk22ghhBcPR0F6aA&oe=6AAAB10D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHVtxEyNPhsQ7kNvwF0On-h&_nc_oc=AdoVjRNOEOFGTb_2nvKx6bPR_WeG5RRkOFgfzs8SzFmIX8YuxfwrmMr_GyG0Z2DbYGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILExNVMo8yVUdC5DbynjUcAUyM0nw_tLYQ_ShGS0BlSQ&oe=6AAA8A8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7FgpRWcPuUQ7kNvwE4v8FP&_nc_oc=AdrvGpFWSKvuZgi67j16pKZp9Zb_i1mz_XcJPN3SjtJ2xjISLCZVD75xPEl0tXtivDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOkTO_tzoD6LFc8qAmWL-cNndIzImzXApsqgZ7eZHCGA&oe=6AAAB79D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wmzlTC7DaAQ7kNvwHqs0_X&_nc_oc=AdrL0FqBUA6_Lxfw_KRqgjs-WWnpA_SBxcgoeubpDKVGIgCxWfR4HhlNy2hPpM0CBnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVSYfP_8sOz-__NeLTg9iAnrnjHC-NAN5ynNYcrxs5jQ&oe=6AAA988B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
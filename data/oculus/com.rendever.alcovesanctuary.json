40px (2).png", "id": "1121899332145730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0aeoDsTMoEQ7kNvwGrjiPv&_nc_oc=Ado5m3x4OkDyinWaYQSK6VrMbSqe4ch4byriBqxIP_QoYaRyxSbOBQyttyAFNNIV888&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsI5pEfXQq5aZQEd5r22oUYLFe5nsDsRoiryhnhusQAA&oe=6A6DD831"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_cFGJfzbasQ7kNvwFWEkrC&_nc_oc=Adr3P5yIwhINnbKQuO-vtkLLalmlQ_LiJoZ-z6XtriuTBOfQmVGe7wDOhHolNq2ZUiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVoiL-nVPa_6gGAcl6bD9uVcGE2sEQYxzWiofdDQhE5Q&oe=6A6DD3CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0xL1dPKMGoQ7kNvwHruzQq&_nc_oc=AdqXgrPLuQRDtAj9xbrk_fwBaQ8k1qs3Joy8YNMh3xr8AffWg13parDTsyb3CKVx8XE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCZpjrKnR9zxMMwKNklIMqLE57Rho3J5dAFAUXGhdRMw&oe=6A6DE58B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpXnbfyN6iIQ7kNvwFMXJDO&_nc_oc=Adpr8ARvKnYQsl61H2oHxQ2gNmH6dI8tFuaODeN0psX61Nss8Ws7EmGlWq1GSICxAps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjPkvkUjws_Eo79NOBsNg6agyhtzez-3X1IstAV5ZWtw&oe=6A6DDA5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN6LrY0L-7MQ7kNvwGuRgtM&_nc_oc=AdocHB6T0dNIfM1_AaYthDpXNTjK3lV8WP5n5Ubb_gVLUOZXcCk0X7PwWegT7jzyNOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKJvR2KExeEqJ4ebvKo7uVLT8oVl8iFr0ZLk6pyuhBLQ&oe=6A6DF38B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
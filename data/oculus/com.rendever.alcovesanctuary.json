40px (2).png", "id": "1121899332145730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVmGsepm17MQ7kNvwEqs-Ed&_nc_oc=Adoi74mEpvs_98UEaKi3Vy1_ZpQkVtj092zM_JgHF2u5hjgODJSQ-dvPeC968Ut0jsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VWtkVC8a6-RrK4N5YRMhDyJbPmeqfVPAzSPpc4x0tcQ&oe=6A3E9A71"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dTgsnUL-OEQ7kNvwGrfO2s&_nc_oc=AdoWA3eb8GEgmkkDZowjEcfM_VAXoFzww3JI8rv0IanLejes2DeAwQkWphzGgG4ka-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8anEvbBDi80KUcxpAqfcxAeSX3HrIOBvQ1mDYkUzAZaQ&oe=6A3E960D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYYbxL3ChxQQ7kNvwGniJj6&_nc_oc=AdprSr7Sd81XRwNC00X4UO_GuJVaDt6SRZtiyzBHCxRHuPHNfVkhALV4ei76nxArpSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91PyeTwOKt6ckALEnYZIQAJQYvAfxHzKmekP93jP8-Fg&oe=6A3EA7CB"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXl_efL0bXsQ7kNvwFPkU7v&_nc_oc=Adql741pYIegTVJ6-JwMIktttQnVXQiLQFQ_3yaAO2bnS6xzGoEeG8YwDGZiv4_rmMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UKcFTC2i2C9h_feTU26UwMmalNYJWsS37fzAkT1HTAg&oe=6A3E9C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQyBTt_i0k4Q7kNvwELvO0j&_nc_oc=AdpEHAihUAa60PToIMTq_dWTTOCRUtnLEP2JbSv-C7BKQigNG9iLeT0BQGNRXMrxw-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rrirFCDSWrpt92vfHX1Eys03AedRYbK__TiItEB3JEA&oe=6A3E7D8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
scdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URfYHa6xaPAQ7kNvwHs_KS3&_nc_oc=AdqlpNXyE-xTvhCWc5kJD0bd5Su6pIaOOYuYp3tRxRKAdfvLf0_08D6gpujsATiU5AM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F9uavSRkkuzXTjx4tBiTT0qOGc4o5z6Zr_GlfTqkd7A&oe=69F1EB31"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa2X-JsDYeAQ7kNvwFNrLAz&_nc_oc=AdqBj-6S9XYGRAyGLQg3UePCC1RnTvfjI74RDwzU-At-mXjg8kb1k8AzAywgHMjQOCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3kl86OeJqS-KEVgbLWPD5tZIHHIECWkppMEpRTQRJmxg&oe=69F1E6CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpouZ1H_5mIQ7kNvwFBIhhz&_nc_oc=AdqrSUmnSZfYOTKuhpaAaS5tFZB8nwbLiTBvtW_hIhL7XmhwKQONigyC42033HeBAl0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35MSlPVb6v4pe7wonfNpwO70NB-3ODYPZVdFgNkt0rTA&oe=69F1F88B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLI4ynY5rr8Q7kNvwFiIWne&_nc_oc=AdqAGZpxnSKjVXZ1yAP1hF8ER8_kBWOjiMfF7IcTx64mtTkq7COkrdaVflORm9Plcxg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06nA05DapuxTmlADg0XDbrXX7P75GrJn10S1K1yxjx9w&oe=69F1ED5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S35yOZWTijgQ7kNvwEqA2rw&_nc_oc=Adoit5NMwlhMwecQ64Mv88-hdUZVpUa1ulne4ewXPYklQxgzDaX4rnyvmDPg0TSmQ-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0syuFg1bEuhMZQ2UDb68-YFj__9WZepXD4GxZlU1JPOw&oe=69F2068B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMF
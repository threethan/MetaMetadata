40px (2).png", "id": "1121899332145730", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G7eGwds9LYQ7kNvwFGO6eH&_nc_oc=AdoaBVbc3Uq2uiOnKSV3Kru1fPbS_8pKBUIY1u6FGcY7u5l3UH47byDOO-UApA-rXH0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElE5kUUH3zi5omgMJcWuxKzQ3fmmIk7Jvxdi-jIhoERg&oe=6A804D31"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fMoNU8J7bUQ7kNvwFupYRw&_nc_oc=AdrVp07Nr8iPNIRHStE33g-ZHO7L3meWONzfiYaU0rlT6bbYa3vOVLqfpilJCGSizHE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaPyASSrTYxaBhmLECVOeOwRxGja2Ks-Hc1OyQ7jNmIw&oe=6A8048CD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31c35iAxSNcQ7kNvwGOjecP&_nc_oc=AdothGM_y_gWw20iZd5HFx_DHMTpTMpQ-whHc8WYzHs4PmdZaXYJ0UXp3rAmlccO2k8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRBKyoNRF-Woe1kCt-YSd34gtsIFQ_sHz6JS9ZFyoZKQ&oe=6A805A8B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HujajbSkK7cQ7kNvwEJt9jN&_nc_oc=AdrcOBEN7HBNXXOn4oiw-g6QtErarGwrT0Kc86TGpTGLEkCMfifX_zTMBIlffwe4LC0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuhVXbGrj6nlBzF5VpCTTz9UYx-FTbk4XzMZjJjXPRVw&oe=6A804F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ggGMX-Ak_wQ7kNvwFUwYwq&_nc_oc=AdoCrsXcgAkqcnQPC04ghMrJdBXxGnRzyekzarKoHU4iWc56nNPP7twxealjwZ6mAYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOd54IEcpZWvJ-ncJYxZ4QzUUElYO7uStueXcSHCYSKQ&oe=6A80688B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "suppo
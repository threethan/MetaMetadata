31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy6LUnqdpDkQ7kNvwHTTieK&_nc_oc=Adnt4pTiu19mW0YxCZaOXLcd5PR9IW2Zg72AZniGwcETNVRsMyPTToW5gXcnq1DkoPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvngWRWYySJIAu-klEoqEWD8EY4guJf3mxvTGfZSrrTjw&oe=699C39B1"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHwLLJ4N9jAQ7kNvwHVCp_M&_nc_oc=AdlL_Y2R3gxZa2DvwMGYWRzHnJUBr98vMvV-GCPlPzrZ8qJ44_Jn4vuDvKaDfvibyOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfveUv535mIt0_hbRs5dXXpQHv9xjYeAj3UxlR6wumUFow&oe=699C354D"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aba1hkEuD2QQ7kNvwFtlgPZ&_nc_oc=AdnMtwI3hsZlSYjrJ1En8otaui9Rg4pQY7QiOTrzwb3obm1A1S8HzCqCG1irBJSyXfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfutigaUxj_Vah4ElywfTV1UCP3wBxmrxJIjtBqCBanE8g&oe=699C470B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK6dgJduiJsQ7kNvwE-nhOw&_nc_oc=AdnDB1b7mAjebriYb4aWovoWFCvXfev63eDDgFE37ZU78z64IUb8eOpYfiHwlboHS4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftbdj6kyfwu6aLLdQxDi1wULZ7CutMzjF9NSQioLGrQZg&oe=699C3BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyuNA-JX9QsQ7kNvwH59k7-&_nc_oc=Adnt2bcNqi6H6sPhPFsnJK_S6L5NLeMzLCa020Db2AswipwztF5ZhVrtBYkpYol-MaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3QPJcQKzOSKG2Wnc6QIITW4pXtJm2_P1Acoat-UUyAQ&oe=699C550B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
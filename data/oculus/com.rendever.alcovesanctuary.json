31437_1121899335479063_7026785518110545292_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkXOpJIoC90Q7kNvwHuetOA&_nc_oc=AdnUO3vOOkSmndXBEZ43rig37P2hgj7cGC24rLeyE5Hk4JhvzdOEiQjzYTGsBqikDHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsyI50IRNydh-FqOKQXjngFiyLQb5qKvbibLuy-e7iQmg&oe=69A57431"}, {"file_name": "Screenshot - 16_9, 2450x1440px (3).png", "id": "949401269854926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75604735_949401273188259_5051973670123751322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNfpmJ-wRDIQ7kNvwGfpeLn&_nc_oc=AdlTdmHjzmTKntRel-h8hLuA3UTRmzzvSnx9OB_RJxYAaQFXQ6vOp5UD-p0dVHPMAAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvML4PzzHpt6PsTUU0awS-Z9V7T7CQUvsnJtg-RWclKRA&oe=69A56FCD"}, {"file_name": "Screenshot - 16_9, 2450x1440px (1).png", "id": "469318906209957", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974635_469318909543290_8495606831155318875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkKzNAlgUnAQ7kNvwEmUoi2&_nc_oc=AdmLLpOe3ErTqDj8cx8pgkiLwZutgOqVzJNbQGLEwFv4y0EizaSZDmFO4sDJJlyuLtI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvyNLOivQg8fmDtMSlc5PTun2OwxvN_EAB9UUid0Qw4DQ&oe=69A5818B"}, {"file_name": "Screenshot - 16_9, 2450x1440px (4).png", "id": "1738786746974907", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982608_1738786750308240_2980389231530715725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsVXpLGgu4oQ7kNvwFetH62&_nc_oc=AdkbyBxeXKezpnt1EcrZWu_Sdme-C_-On_bulmOAlREqRChtKAE8J6L3dXQzNZn8kNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftsL2klXEOM-SfU3EvdXKbVExsdaVoGOY3OLwTdSL9f0w&oe=69A5765D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alcove-trailer-screenshot.png", "id": "569725662548848", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391990_569725665882181_5181980931331754088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGJKEP0EVNQQ7kNvwFI9GTE&_nc_oc=AdkAEf3Yt9zwT4inomRieBIJvK5vBDR6uRHXKyuBHRL1v0DnNb3QA1ygsxeXpt0VxOo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfujTvhwONfMI2RmEfCJ2MHN84OOKZIivSRhS8aeyaE8ow&oe=69A58F8B"}, "display_name": "Alcove Sanctuary", "keywords": ["alcove", "wellness", "mindfulness", "nova", "travel"], "long_description": "# From the team who brought you Alcove, welcome to your Sanctuary. \n\nWith experiences designed to connect you to the world and pique your curiosity, embedded in a new space with fresh ways to make it your own - we hope Sanctuary will become your home away from home. \n\n* Customize your sanctuary with shared photos, uploaded videos - and now, generative AI features to create art and sculpt new furnishings.\n* Travel the world, from iconic landmarks to your own childhood neighborhood. \n* Relax and practice meditation in nature - guided, or unguided.\n* Listen to classical music.\n\n...plus, you'll have access to your own friendly companion along the way.\n\n# Meet Nova! \n\nNova brings a whole new level of creativity and interaction to Alcove. You can have a conversation with Nova in real-time to generate stunning images, craft custom 3D models, search for experiences, explore the world, or simply connect and chat.\n\n**All of this and more is available with a Sanctuary+ subscription.**\n\nWe can't wait to see what you come up with.", "short_description": "Alcove Sanctuary is your gateway to boundless exploration, education, and experiences in VR. And now you can meet Nova, your AI companion designed to guide you through a world of discovery, memories, and entertainment \u2014 all in one personalized experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rendever.com/alcove/privacy-policy", "developer_terms_of_service_url": "https://www.rendever.com/terms-of-use", "publisher_name": "Rendever, Inc", "support_website_url": null, "website_url": "https://rendever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
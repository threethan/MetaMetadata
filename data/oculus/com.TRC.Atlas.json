&oe=6AE7692D"}, {"file_name": "Oculus Screenshot 1.png", "id": "466914464950438", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036672_466914468283771_1555063198587374061_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQdnrgVCpVgQ7kNvwHGIWWi&_nc_oc=AdotvpVq0a2b8SGc9BfaDUL0VrWEtw9NsHcIQwPuz5FwZqfe1oxi4G4zsAGWjcj7ZoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD0BCOSBaLh0gvrwLBSut3y2svIhV_k7xkSEc98Hp-Lw&oe=6AE75861"}, {"file_name": "Oculus Screenshot 5.png", "id": "666288957716145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_666288961049478_3344841202571697091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ1FduHVBOAQ7kNvwFvUjnp&_nc_oc=Adr8B8i9Dy3dsmLdODlKsh1afAAmkgEpVOyQtCg1DSmMLJI5SJs8a4jT112C_Ah4toE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGdxWKuZSphW8mSw2xrVQxT-adSnHSwugL173SasVqDA&oe=6AE767C4"}, {"file_name": "Oculus Screenshot 2.png", "id": "578077323646520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_578077326979853_4598563677030286299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25pkUtk7v-4Q7kNvwHg1v3j&_nc_oc=AdrnylWxxdLJU0ztUiHUaXaFJ5COwnb3TOcbLZ9tS5bS1bqXZI43O5s9rcJWzXntJdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAdhRoXHeMheVWv-io9BN00M5JGS1VoEh2Xfsqw7OLNQ&oe=6AE75588"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Screenshot Oculus.png", "id": "896724631009802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974626_896724634343135_5101462650623033916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_sty2rpM7EQ7kNvwE4KGRY&_nc_oc=AdqEw6cEhc4n-NJZy_FkIU78s9B_nqvmSgXNpqhRFZ9TdQys-P-xkgJmJ3Liubj6n5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmneKrDNc6O4SfoVepkEqi6UL7ojqm8m19fMjOcmCpWA&oe=6AE751CE"}, "display_name": "The Atlas Mystery", "keywords": [], "long_description": "Immerse yourself in a thrilling supernatural murder mystery set in the twilight years of classic Hollywood. \n\nLos Angeles, 1951. You assume the role of a newly hired floor manager at The Atlas Theater, a luxurious 1940\u2019s era movie palace that played host to a notorious Hollywood tragedy. Navigate through the twisted labyrinth of the Atlas as you solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the shocking truth behind the theater\u2019s dark history.\n\nThe Atlas Mystery combines challenging escape-room style puzzles with a riveting investigative narrative full of shocking twists and haunting revelations, plunging players into a detailed and captivating world inspired by classic cinema. ", "short_description": "Explore the haunted halls of the infamous Atlas Theater, a 1940\u2019s era movie palace that played host to a shocking Hollywood tragedy. Solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the twisted truth behind the theater\u2019s dark history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atlasmystery.com/privacy-policy", "developer_terms_of_service_url": "https://www.atlasmystery.com/terms-of-service", "publisher_name": "TRC DMI", "support_website_url": null, "website_url": "https://www.atlasmystery.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_
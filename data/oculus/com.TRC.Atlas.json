&oe=6AF88CAD"}, {"file_name": "Oculus Screenshot 1.png", "id": "466914464950438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036672_466914468283771_1555063198587374061_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h7HGbx41IEQ7kNvwEU7hlJ&_nc_oc=Ado_pa0vNLuU0geDBRbMrWRPGrsX1i_dHMDL1HyFL7tbDBut3inAroZRSAi3bJqVhRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAjt_SLsi3BvoHpbGo-2hk_MnhwXoo_Emt-gcKU1CIAg&oe=6AF87BE1"}, {"file_name": "Oculus Screenshot 5.png", "id": "666288957716145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_666288961049478_3344841202571697091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAbnAsmoBxEQ7kNvwGJu-VQ&_nc_oc=AdpPgLUbOVwIw3T1fTrnX9bwFLrjscZil7JFSL99zgpuQo78fCCGWE_0FkccQRAhtmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8CDB2qgHlqy2dxzK5gRuq-v2BTTmKWGaqUkt2bpfclw&oe=6AF88B44"}, {"file_name": "Oculus Screenshot 2.png", "id": "578077323646520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974497_578077326979853_4598563677030286299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGmjiZQH134Q7kNvwFZC_nd&_nc_oc=Adp3velTCMkj4qKwO1NFUPXqrhyBEhpksRULN-NY4QMzWxn4iUTdp0267XgURk-8ey8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3_W-r8Lc7FonIluas9fVkUGt7zgUNOENxb3K36pPTgQ&oe=6AF87908"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Screenshot Oculus.png", "id": "896724631009802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974626_896724634343135_5101462650623033916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6AA59Ys3yQQ7kNvwH8fT0s&_nc_oc=Ado9zAi0cFEmuEvnG549yQnxDnCIC-21rFht4Vkxm39aLm_zzek-HQCssgHK5oVjZ_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKY8BONlpA5LTEuW3nMtK1EjnqonUdN8k8w0_cL5hb-g&oe=6AF8754E"}, "display_name": "The Atlas Mystery", "keywords": [], "long_description": "Immerse yourself in a thrilling supernatural murder mystery set in the twilight years of classic Hollywood. \n\nLos Angeles, 1951. You assume the role of a newly hired floor manager at The Atlas Theater, a luxurious 1940\u2019s era movie palace that played host to a notorious Hollywood tragedy. Navigate through the twisted labyrinth of the Atlas as you solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the shocking truth behind the theater\u2019s dark history.\n\nThe Atlas Mystery combines challenging escape-room style puzzles with a riveting investigative narrative full of shocking twists and haunting revelations, plunging players into a detailed and captivating world inspired by classic cinema. ", "short_description": "Explore the haunted halls of the infamous Atlas Theater, a 1940\u2019s era movie palace that played host to a shocking Hollywood tragedy. Solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the twisted truth behind the theater\u2019s dark history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atlasmystery.com/privacy-policy", "developer_terms_of_service_url": "https://www.atlasmystery.com/terms-of-service", "publisher_name": "TRC DMI", "support_website_url": null, "website_url": "https://www.atlasmystery.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_
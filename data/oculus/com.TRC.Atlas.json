&oe=6ACFAE2D"}, {"file_name": "Oculus Screenshot 1.png", "id": "466914464950438", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036672_466914468283771_1555063198587374061_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb0VC0xb7QgQ7kNvwHvMT9p&_nc_oc=AdqlHW_DpIub588QWQXgjPxUqUBnpakT5vdxy9ieqN5ZKk_zAo5Cd9gu9y31jgVck_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXxwnHytP_0jYQhqR1aX1rOR75TzctxBEmAk38FlBp4w&oe=6ACF9D61"}, {"file_name": "Oculus Screenshot 5.png", "id": "666288957716145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_666288961049478_3344841202571697091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxkJ7qgZ-3sQ7kNvwER6MR9&_nc_oc=AdqWxM-URSykKbbYMncNG9lZf5e2QvY8EnZlyi0lRb8fqmMwsqaAF4Ymbbb4SX0iqsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_tLxHc3fw7opPr8KUXTy0_0ElBIM74KGz0e3jO4IP5g&oe=6ACFACC4"}, {"file_name": "Oculus Screenshot 2.png", "id": "578077323646520", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_578077326979853_4598563677030286299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZgAbxUjUmsQ7kNvwEoJLmM&_nc_oc=AdqZhJ8vC7Kn1gzNYI-uZ8t8401kH1s4qeps5c3SK8i6kHUJiBcyDW0vGIyp71ujYwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4GX-7juPJI58uyu_AVMlR61WgW5Tc8CZirMYrCDZrhw&oe=6ACF9A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Screenshot Oculus.png", "id": "896724631009802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974626_896724634343135_5101462650623033916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-3QoiGJyM4Q7kNvwEj53in&_nc_oc=Adq2-PtnB2QIcSN98fDt0B1K5pcPfPfhkRZTNsxfT212OxqSShazgRJoXJz6dx90L4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuBUavwc9Z1cEvu_DHtGkVuaaZtVoK2SjkjPvWePpCXQ&oe=6ACF96CE"}, "display_name": "The Atlas Mystery", "keywords": [], "long_description": "Immerse yourself in a thrilling supernatural murder mystery set in the twilight years of classic Hollywood. \n\nLos Angeles, 1951. You assume the role of a newly hired floor manager at The Atlas Theater, a luxurious 1940\u2019s era movie palace that played host to a notorious Hollywood tragedy. Navigate through the twisted labyrinth of the Atlas as you solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the shocking truth behind the theater\u2019s dark history.\n\nThe Atlas Mystery combines challenging escape-room style puzzles with a riveting investigative narrative full of shocking twists and haunting revelations, plunging players into a detailed and captivating world inspired by classic cinema. ", "short_description": "Explore the haunted halls of the infamous Atlas Theater, a 1940\u2019s era movie palace that played host to a shocking Hollywood tragedy. Solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the twisted truth behind the theater\u2019s dark history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atlasmystery.com/privacy-policy", "developer_terms_of_service_url": "https://www.atlasmystery.com/terms-of-service", "publisher_name": "TRC DMI", "support_website_url": null, "website_url": "https://www.atlasmystery.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_
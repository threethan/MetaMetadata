lbXu9dCeJWmGo8qfQ5ERIzQoU9eS99BXw5uln8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvzC40akLWoIaoXKg7SiCQt7nTJmu9FRVGRiRrpsdtRg&oe=6AE606E1"}, {"file_name": "Oculus Screenshot 5.png", "id": "666288957716145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_666288961049478_3344841202571697091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ1FduHVBOAQ7kNvwHYnRjW&_nc_oc=Ado0mFFDIKO1eMy22YLl8uJeU4rvppqfuDMVXoqEPbvtIGU6mxuN03B-B_uYq9mRoQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQbtieT3G6V1Pt6JLmTjgX8hrkFoVJVjOg4hCvG_7Dlg&oe=6AE61644"}, {"file_name": "Oculus Screenshot 2.png", "id": "578077323646520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_578077326979853_4598563677030286299_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25pkUtk7v-4Q7kNvwHe-rre&_nc_oc=Ado6hgAcuu63kk_-CfAQ1EPcPHqerDK-KDGtB_xUQp37GVjxtlMdMIJPeG5frRdfycI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG-s59fLnZaTcfadyCa8z2wQl-_iRMk-AlXtuBRpjhIg&oe=6AE60408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Screenshot Oculus.png", "id": "896724631009802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974626_896724634343135_5101462650623033916_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_sty2rpM7EQ7kNvwHy_XF_&_nc_oc=Ado7m5HLqzJk9fR0wsZZk7nINnD-Rty64jAeyYDYG_wQeRFKNX8wB7sQCfuGDMo4mrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0p17BGWYtkHykKHmJ3FZalZuIDZJup2i9u_VykhaWng&oe=6AE6004E"}, "display_name": "The Atlas Mystery", "keywords": [], "long_description": "Immerse yourself in a thrilling supernatural murder mystery set in the twilight years of classic Hollywood. \n\nLos Angeles, 1951. You assume the role of a newly hired floor manager at The Atlas Theater, a luxurious 1940\u2019s era movie palace that played host to a notorious Hollywood tragedy. Navigate through the twisted labyrinth of the Atlas as you solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the shocking truth behind the theater\u2019s dark history.\n\nThe Atlas Mystery combines challenging escape-room style puzzles with a riveting investigative narrative full of shocking twists and haunting revelations, plunging players into a detailed and captivating world inspired by classic cinema. ", "short_description": "Explore the haunted halls of the infamous Atlas Theater, a 1940\u2019s era movie palace that played host to a shocking Hollywood tragedy. Solve intricate puzzles, discover startling artifacts, and evade sinister forces to uncover the twisted truth behind the theater\u2019s dark history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atlasmystery.com/privacy-policy", "developer_terms_of_service_url": "https://www.atlasmystery.com/terms-of-service", "publisher_name": "TRC DMI", "support_website_url": null, "website_url": "https://www.atlasmystery.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1099564924223989"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "28490787587256232"}, {"status": "PUBLISHED", "id": "1416422183579567"}, {"status": "PUBLISHED", "id": "1034196372269628"}, {"status": "PUBLISHED", "id": "1206986274963348"}, 
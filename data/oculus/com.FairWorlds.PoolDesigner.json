9", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393444_28471087425838924_6900624657920210997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX6H16KzdJcQ7kNvwHnYLdG&_nc_oc=AdpZi91uHaweCkzIvS5BdBfIwC1ZzfvWYMmM0HLqa3pVwwlgf4BlX_j8tfpe4xzDZhQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5pemzrgvynd6YHMlqoKxZhYh8rqzbW5fp-P6_DEL-2Q&oe=6A857B34"}, {"file_name": "Pool Designer 05.png", "id": "962666325821390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391883_962666329154723_3456827724171538063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIqZPb43jfkQ7kNvwGxH56k&_nc_oc=Adp61ddDBLKdJjSZPwUoMGUqXMlebkRi1VsQsjx4gfaL1v4QJN2rf_0UZP1VuBRNk70&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnogX3aIY9fDN7I4u_7UihIMGd-A4Nm6NjYVTC2Y6kIQ&oe=6A857D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Thumbnail 2560x1440.png", "id": "465720423144437", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392010_465720426477770_1156088452271494628_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwTHMAmsNHQQ7kNvwHJw_L-&_nc_oc=AdpFZXvH7RZ1FNidurcMPcG3TVSRF0aL4zOFxpcGvi8jY17t2LtuxneYIdcbPZ6ZfnQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz9bhCkdooFQnqo9N0DDgeNDdyeS1JLFjJLSn46K4pxw&oe=6A85827F"}, "display_name": "Pool Designer", "keywords": [], "long_description": "# Pool Designer helps you design your very own pool in the comfort of your own home!\nGrab your headset and controllers, and let's jump in! Place the pool wherever you want, in a living room, or outside!\n\nCustomize your pool with these options:\n- Tile Border (this goes around the pool at the water's edge)\n- Pool Edge (this is the coping around the top edge of the pool)\n- Pool Deck (this is the decking or pavers around the whole pool)\n- Water Color (this will vary based on your location and the lighting)\n\nHave fun!  We'd love to see what you've designed!", "short_description": "Design your very own pool with Mixed Reality in the comfort of your own home!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fairworlds.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fair Worlds LLC", "support_website_url": null, "website_url": "https://www.fairworlds.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1819021644882647"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29933730389559946"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1821482531964656"}, {"status": "PUBLISHED", "id": "540621405229622"}]}, "baseline_offer": {"id": "1821482531964656"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746207540, "status": "PUBLISHED", "id": "1821482531964656"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33097433696522917", "version": "0.86"}, "id": "1083380773455003", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28558158807117118", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33097433696522917"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
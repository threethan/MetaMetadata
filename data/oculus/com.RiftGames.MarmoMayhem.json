xMlUPh9VrRTo5UULXPMs03hP9F0S3MoDR1PxhcGQvK6Vm_Dah5jt46y40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPyKeoOsE0d4AOnXXEn-YnLSfPKe6lGZ1ZKsWVeoZFFQ&oe=6AEDD68A"}, {"file_name": "Sigmaicon5FIX.png", "id": "4442042796063895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507832394_4442042799397228_7956361771922111953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRiEynNF1YkQ7kNvwGtW4R3&_nc_oc=Adqsl7jhllXTIr9Grr2hJ4NVll78T5mSswxjhHto79RCbxDaDyMNmrfbtEW45qAx1Fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV7LLZs3Q82fB78uSYLildiDo2okgDKH8WGybP-YQn3w&oe=6AEDDB64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marmo Mayham", "keywords": [], "long_description": "Welcome to Marmo Mayham!\n\nSwing, climb, and explore your way through a vibrant forest built for fast-paced movement and endless fun. Inspired by the freedom of classic gorilla-style locomotion, Marmo Mayham challenges you to master your movement as you race through the environment, discover hidden paths, and play with friends.\n\nTraverse towering trees, cross rope bridges, and uncover every corner of the map using only your arms. Whether you're practicing advanced movement techniques, exploring the world, or hanging out in multiplayer, there's always something to do.\n\nFeatures\n\ud83c\udf33 Large forest environment filled with places to explore.\n\ud83e\udea2 Rope bridges and climbable structures.\n\ud83e\udd8d Smooth gorilla-style locomotion designed for VR.\n\ud83d\udc65 Multiplayer gameplay with friends.\n\ud83c\udfa9 Unlock and equip cosmetics to customize your look.\n\u26a1 Fast-paced movement that rewards skill and practice.\n\ud83d\udd04 Ongoing updates with new maps, cosmetics, and gameplay improvements.\n\nWhether you're competing to become the fastest climber or simply exploring the world, Marmo Mayham offers an exciting VR playground for players of all skill levels.\n\nGrab your headset, jump into the forest, and see how far your skills can take you!", "short_description": "Marmo Mayham a game you can meet friends in or cause mayham yourself"}]}, "developer_name": null, "developer_privacy_policy_url": "https://canva.link/g4ew0u0cd4uuk4s", "developer_terms_of_service_url": null, "publisher_name": "RiftGamez", "support_website_url": null, "website_url": "https://canva.link/g4ew0u0cd4uuk4s", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1295083833678621"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_2227792531347012_8186438642927870957_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKfjophODIEQ7kNvwHGuqpD&_nc_oc=AdpDt3_PlgENNMuIa6K0oCoPJVdCHkCsrbVTETI7NSNa8R7aTnzjBngLXNmn9A0_xUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO47vBaycfGSJi7_zP8D2SIYr-yZ2r6Lm9jUhIKayodA&oe=6AEDEBA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marmo Mayham", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1785795180, "lastRevision": {"nodes
om&_nc_ss=7f20f&oh=00_AQIAMKb2S6foRbq5enS8ou4p-nxP_XKkBXKCs_DtkmoSpg&oe=6AA9634D"}, {"file_name": "beatsaber_full.png", "id": "861990496868805", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491820387_861990500202138_5651305244628525768_n.png?_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM2G8ODO3HgQ7kNvwEUaiOZ&_nc_oc=AdpYRBh97MHhrzIsbgLfP8e_u_ImPGOcksyuKTcPuHB3mbEUE4l66hOEIBDX-KZujGE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZI6-JzHJRsqlj9k8KVjnXjlFdVBVZXw0jziZ3FQbHWQ&oe=6AA95BBA"}, {"file_name": "migrated_image.png", "id": "518486029062524", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031634_2310858322517800_8194726514764283904_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qLvFa3WewEQ7kNvwHVLVo1&_nc_oc=Adof2XAB6bc6KUmGI0phdzOFjIoR6HKxfcXV7Vv1G_RbKUhYjXv-FcZjLMbdEP9n-AI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdhFQWVPbTbaNf_p0kWYBVRhS_PCaY9bqkRg4vhds-0Q&oe=6AA95014"}]}, "id": "1827067491806187", "locale": "en_US", "screenshots": [{"file_name": "Screenshot-1.png", "id": "819365789509401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569471_819365792842734_7753633006403218292_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0VYslyFsFAQ7kNvwFrup6u&_nc_oc=Adpk_B3kmxAg4ZRIjU4cNDipvtrpWJ-UKvnSs2WLT3TvyJlKCARFm4UM37kp5vEFG4g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCMsew3BjYYERG30mqR1PgKZcufktaOnKkVadEBRmxtw&oe=6AA94E94"}, {"file_name": "Screenshot-2.png", "id": "3335522656715383", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75611999_3335522663382049_7007914867961602720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrTKHrAxEMwQ7kNvwERmN2e&_nc_oc=AdpZJatNWKdK4jyFpaoByixFSa8qfztRYNrON18Mag2-CL36V7iX7oE1Y7k3NDBCO2k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIVRSByqojCE1_Xa-Ec4lcE_LHA8Bg4BHTgsdxRUlH5Q&oe=6AA960B5"}, {"file_name": "3.png", "id": "785084300436971", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57572919_785084303770304_7604642246419491339_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beqgIe5Vx5EQ7kNvwERSlM3&_nc_oc=AdorvzOXUlX8E2uYGY9xQETcpmFjqRFhnHEEoiiBb0VWdbd2FLOkFqCLy-cn818rngw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQVUy5lZfZOL6_ljmpejqC_BxyZ-lRM34FINpVt4VeFw&oe=6AA942D0"}, {"file_name": "8thAnniv.png", "id": "997367579345890", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499294644_997367582679223_7166405391316422352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02wAFG7q0gsQ7kNvwHR5toQ&_nc_oc=AdqpwtabfoaSsHoh-kkgbd_59u9psC1Ns6S9BTnSMg6dFOMADh7Z2-wwWBLRaktPflw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLekEat_aFnoOZ0RP1__fiSllGv8ilYNKUhZe-IkhHf3w&oe=6AA950AF"}, {"file_name": "HHM2_Disclaimer.png", "id": "1041537035545970", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828008_1041537038879303_8419546164705190170_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqA3bUvXddIQ7kNvwH4CITa&_nc_oc=AdoZHQjSQ2Fkyc6VVfbadmwrMTEjtxAJUHTMcUX6F5bZdQaOE30bg0SA2tOZ4iSjSKs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF5Gao2vaD42_vy1hn-p2ZWoPVScrLApNJLPqDLwOEgg&oe=6AA968CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2752751208443618", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499314659_2752751211776951_6469504410008727830_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oCeAmVlgBEQ7kNvwFAP7iZ&_nc_oc=Adr7ZAGrNIzUHWRkBTwJU-PE4Vm_sMuOOrYzbs9EJX1b9dlDVlG5mYGxCML--6HnSGo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm2HlWwG4SVJz_l7E2w9Of_xtIrZhwU0bEOaTEtTRGsA&oe=6AA9605D"}, "display_name": "Beat Saber", "keywords": ["music", "rhythm", "dance", "saber", "song"], "long_description": "# THE #1 BEST-SELLING QUEST GAME OF ALL TIME *\n\n\n**SLASH THE BEATS**\n\nStep in and get moving! Slash, duck, and dodge your way through every beat. Match the color and direction of incoming notes to master the music and keep your body in the flow.\n{1619709476234293}\n\n**BUILT FOR THE BEAT**\n\nEvery level is handcrafted to perfectly match the music. Experience stunning visual effects and haptic feedback that put you inside the track.\n{909658475098883}\n\n**AN UNBEATABLE MUSIC LIBRARY**\n\nBeat Saber features a massive library of 300+ songs.\n* **Start Now:** Get 60+ free songs included with the base game.\n* **Expand Your Collection:** 239+ songs from artists like Coldplay, Imagine Dragons, and Metallica. \n* **Always Fresh:** New songs releasing in Music Packs and Shock Drops throughout the year! \n{1375014811444297}\n\n**MULTIPLE WAYS TO PLAY**\n\n* **Solo:** Pick a track, choose your difficulty, and lose yourself in the music.\n* **Party:** Pass the headset, and see who tops the leaderboard. \n* **Campaign:** Sharpen your skills by completing unique objectives and challenges.\n* **Online:** Challenge friends or join up to 5-player cross-play matches.\n{1642364454119343}\n\n**MADE FOR EVERYONE. MASTERED BY FEW.**\n\n* **Global Leaderboards:** Rise up the ranks and become a world-renowned Beat Saberist.\n* **Customization & Accessibility:** Play your way with 5 difficulty levels, 15 gameplay modifiers, custom environment colors and more. \n\n*___________________________________________*\n\n*See https://www.meta.com/experiences/section/1377690143243672/ \n\nMusic Downloads Not Rated by the ESRB \n\nVisit www.esrb.org for rating information \n\nMUSIC DOWNLOADS NOT RATED BY PEGI - www.pegi.info\n\n\n\n\n", "short_description": "Slash the beats, get moving, and experience the world's most popular VR rhythm game!* Duck, dodge, and flow through 300+ handcrafted songs from artists like Coldplay, Imagine Dragons, and Metallica. Play solo, compete online, or pass the headset at your next party. Jump in with 60+ songs included! \n"}, {"images": {"nodes": []}, "id": "1348067863721955", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber", "keywords": ["musique", "rythme", "danse", "sabre", "chanson"], "long_description": "\u00ab Beat Saber \u00bb est un jeu de rythme en VR tr\u00e8s original, o\u00f9 l'objectif est de trancher des cubes qui arrivent sur vous au rythme de la musique.\n\nChaque cube indique quel sabre vous devez utiliser et dans quelle direction vous devez trancher. La musique du jeu a \u00e9t\u00e9 sp\u00e9cialement compos\u00e9e pour s'adapter \u00e0 des niveaux uniques en leur genre.\n\nNotre objectif ? Faire danser les joueurs pendant qu'ils tranchent des cubes en \u00e9vitant les obstacles.\n\nChaque coup de sabre est accompagn\u00e9 d'effets visuels et sonores \u00e9poustouflants qui soulignent le rythme \u00e0 la perfection.\n\nMusic Downloads Not Rated by the ESRB \n\nVisit www.esrb.org for rating information \n\nMUSIC DOWNLOADS NOT RATED BY PEGI - www.pegi.info", "short_description": "\u00ab Beat Saber \u00bb est un jeu de rythme en VR o\u00f9 l'objectif est de trancher des cubes en suivant parfaitement le rythme de la musique."}, {"images": {"nodes": []}, "id": "1081880744386251", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Saber", "keywords": ["\uc74c\uc545", "\ub9ac\ub4ec", "\ub304\uc2a4", "\uc138\uc774\ubc84", "\ube44\ud2b8"], "long_description": "<Beat Saber>\ub294 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c (\uc791\uc740 \ud050\ube0c \ud615\ud0dc\ub85c) \ub2e4\uac00\uc624\ub294 \ube44\ud2b8\ub97c \ubca0\uc5b4\ub0b4\uc57c \ud558\ub294 \uac1c\uc131 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4. \n\n\ube44\ud2b8\ub9c8\ub2e4 \uc5b4\ub5a4 \uc138\uc774\ubc84\ub97c \uc0ac\uc6a9\ud574\uc57c \ud558\uace0 \uc5b4\ub5a4 \ubc29\ud5a5\uc73c\ub85c \ub9de\ucdb0\uc57c \ud558\ub294\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ubaa8\ub4e0 \uc74c\uc545\uc740 \uc9c1\
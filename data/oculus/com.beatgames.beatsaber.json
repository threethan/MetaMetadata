223_7166405391316422352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYbT_yNn_EoQ7kNvwG_h53p&_nc_oc=Adquid1aMxjnV34Lao4fAfjawALiV7qahV0PwgQwtQ7122Uht2qvJjTx6SYpujdo_tM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhpjJwtQfPYYQwM9lJHQg5yfCBHUWbQH6iUb-6zsvefg&oe=6AE4A42F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2752751208443618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_2752751211776951_6469504410008727830_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXhcRL-scSgQ7kNvwE-koPy&_nc_oc=AdolQeu6SvRI096kWePoGMPunWx-BPU8fWmfcGPMnI-04m7I-x7lo9obzsObtnh-I5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO85jMaFyN9OzE98WY06DWjgqxPGbvk1xy42nTC7xYRzg&oe=6AE4B3DD"}, "display_name": "Beat Saber", "keywords": ["music", "rhythm", "dance", "saber", "song"], "long_description": "# THE #1 BEST-SELLING QUEST GAME OF ALL TIME *\n\n# Huge update coming Spring 2027\n\n**SLASH THE BEATS**\n\nStep in and get moving! Slash, duck, and dodge your way through every beat. Match the color and direction of incoming notes to master the music and keep your body in the flow.\n\n{1619709476234293}\n\n**BUILT FOR THE BEAT**\n\nEvery level is handcrafted to perfectly match the music. Experience stunning visual effects and haptic feedback that put you inside the track.\n{909658475098883}\n\n**AN UNBEATABLE MUSIC LIBRARY**\n\nBeat Saber features a massive library of 300+ songs.\n* **Start Now:** Get 60+ free songs included with the base game.\n* **Expand Your Collection:** 239+ songs from artists like Coldplay, Imagine Dragons, and Metallica. \n* **Always Fresh:** New songs releasing in Music Packs and Shock Drops throughout the year! \n{1642364454119343}\n\n**MULTIPLE WAYS TO PLAY**\n\n* **Solo:** Pick a track, choose your difficulty, and lose yourself in the music.\n* **Party:** Pass the headset, and see who tops the leaderboard. \n* **Campaign:** Sharpen your skills by completing unique objectives and challenges.\n* **Online:** Challenge friends or join up to 5-player cross-play matches.\n{1375014811444297}\n\n**MADE FOR EVERYONE. MASTERED BY FEW.**\n\n* **Global Leaderboards:** Rise up the ranks and become a world-renowned Beat Saberist.\n* **Customization & Accessibility:** Play your way with 5 difficulty levels, 15 gameplay modifiers, custom environment colors and more. \n\n*____________*\n\n*See https://www.meta.com/experiences/section/1377690143243672/ \n\nMusic Downloads Not Rated by the ESRB \n\nVisit www.esrb.org for rating information \n\nMUSIC DOWNLOADS NOT RATED BY PEGI - www.pegi.info\n\n\n\n\n", "short_description": "Slash the beats, get moving, and experience the world's most popular VR rhythm game!* Duck, dodge, and flow through 300+ handcrafted songs from artists like Coldplay, Imagine Dragons, and Metallica. Play solo, compete online, or pass the headset at your next party. Jump in with 60+ songs included! \n"}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/beat-saber-end-user-license-agreement/", "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "de", "es_AR", "ko", "es_PE", "en", "fr", "es_PR", "ja", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
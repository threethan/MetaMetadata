ge.png", "id": "2276279969332163", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1934480363324363_6624070894606090240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y92ILbo0WCsQ7kNvwEUzYe8&_nc_oc=AdpTpA2s6VX2LY6i8IZ-xXLoxIvZyQg4HLhvUFunWhal4n6Wu3kLT5CZB_PJVK4QvE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoOjbZJujfEaqIBE_MnZOo0wd8xMlszu3mQ9o1MtUu7A&oe=6AB13B10"}, {"file_name": "migrated_image.png", "id": "212116429858972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_429885704256265_4881055385001132032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E9lXKQvs64Q7kNvwGX8sLR&_nc_oc=AdoGDeC3JcGUvHHiKQGmaWROP_9-ce_Hsh1cGT3slmJh4iC6IYFjhxTrxC3efRBeEHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHnSJg6GrDehV1jiHrWxqnjZfFI7CbgIZIjTSM99V73w&oe=6AB15AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SvvFYJ", "id": "345252929683088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031412_345252933016421_8974863090214502400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rytIf-VjdAQ7kNvwE2lasW&_nc_oc=AdpEfxQBF6wGzAzkMsZVbuhsbRkVAESRHzD2lgqMVO2z0eXDK1np-9Ws0EDX-uKNHeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFkNKpnwKeQ9AbOOGCu5QNMrhOPMD5MzKTPo_VfDQ5dA&oe=6AB15566"}, "display_name": "Beat Saber", "keywords": ["music", "rhythm", "dance", "saber", "song"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "http://beatsaber.com/", "developer_terms_of_service_url": "http://beatsaber.com/", "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458995789043230"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "27960603130225640"}, {"status": "PUBLISHED", "id": "1603833474798117"}, {"status": "PUBLISHED", "id": "1570801707801233"}, {"status": "PUBLISHED", "id": "1609434833261854"}, {"status": "PUBLISHED", "id": "501246542758334"}, {"status": "PUBLISHED", "id": "556795246546777"}, {"status": "PUBLISHED", "id": "763427945403123"}, {"status": "PUBLISHED", "id": "520136543662306"}, {"status": "PUBLISHED", "id": "759821042388261"}, {"status": "PUBLISHED", "id": "779307970231927"}, {"status": "PUBLISHED", "id": "964427474800955"}, {"status": "PENDING", "id": "932171208057780"}, {"status": "PUBLISHED", "id": "333786537325310"}, {"status": "PENDING", "id": "701536675074423"}, {"status": "PUBLISHED", "id": "456796693280163"}, {"status": "PUBLISHED", "id": "6882622115102958"}, {"status": "PUBLISHED", "id": "897324624864355"}, {"status": "PUBLISHED", "id": "7504139866
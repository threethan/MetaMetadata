803B50"}, {"file_name": "migrated_image.png", "id": "212116429858972", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974581_429885704256265_4881055385001132032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8NJiLiv3zsQ7kNvwFhsqQZ&_nc_oc=AdqkczETivF7S9VqSfdOoEB6l5RxBkZMgCPpp6CQ_P7dARCAcIrFguZOHkAP0c1e59Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbQD7npfyv23oyXmHvJ_i9WwxPtnz0HzzpLDclZW5kIw&oe=6A805B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SvvFYJ", "id": "345252929683088", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031412_345252933016421_8974863090214502400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-h6vfxHiy0Q7kNvwFNRMjN&_nc_oc=AdoNjlDlHeXIMWU-xtAp0Lv7Edzq7EAVOZRPoxK4qaX1yPdneYkIri51Pnvo5GrPUn8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWc3TTUNbQObrPlMD216rJtntaI_K9jOrpDqyro4-oTA&oe=6A8055A6"}, "display_name": "Beat Saber", "keywords": ["music", "rhythm", "dance", "saber", "song"], "long_description": "Beat Saber is a unique VR rhythm game where your goal is to slash the beats (represented by small cubes) as they are coming at you. Every beat indicates which saber you need to use and also the direction you need to match. All the music is composed to perfectly fit the handmade levels. Our goal is to make players almost dance while cutting the cubes and avoiding obstacles. Each cut is strongly supported by great sound and visual effects to emphasize the rhythm.", "short_description": "Beat Saber is a VR rhythm game where your goal is to slash the beats which perfectly fit into precisely handcrafted music."}]}, "developer_name": "Beat Games", "developer_privacy_policy_url": "http://beatsaber.com/", "developer_terms_of_service_url": "http://beatsaber.com/", "publisher_name": "Beat Games", "support_website_url": null, "website_url": "http://beatsaber.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
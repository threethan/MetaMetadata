tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620856_1341769017786162_3521299792539397907_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G07Qx4Gh4PUQ7kNvwHMammC&_nc_oc=Adonm9SImiryBORIKIAHsrat5xmJAdlcji5G3tRCptUTKke1OjBd88wyrKNGQaLzbP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzncef20cK3S31Y6SdNWzb02pt_ltwekJZLIuFl6hmbaA&oe=69CD2338"}, {"file_name": "NGC6720.png", "id": "1643705989999884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623210_1643705993333217_2290309286333308723_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq8DoS99oncQ7kNvwHXIiIM&_nc_oc=Ado6V8_7FSnDb2HAFT1TQwX3zyJoEJImid0KWBM5DzK8WNI1ehsgZxa2EvZ82Q5wd2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_Atm4QixeUpEi-W7-FqSfu7_7HER98XwxHeG1PaSqdQ&oe=69CD262F"}, {"file_name": "NGC3132.png", "id": "1245672534356240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618910_1245672547689572_5207695255836934326_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pm7py_Ka-QQ7kNvwE1_LrZ&_nc_oc=AdpWod5D4JtpPfKDtZs04JCpMtO8iR9MwhiVcmFfm2aAHqHKYqxRGWktSdOqI3l-4Ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhXVKXDFTfukEaXFuWsGe02DsuRKUgLH7I4cVqiprbzQ&oe=69CD0649"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AstroCubeVR", "keywords": [], "long_description": "**AstroCubeVR** \u2014 immersive 3D exploration of astronomical datacubes, from Immersive Science.\n\nLoad FITS datacubes from ALMA and other radio telescopes and navigate through them in true 3D on Meta Quest.\n\n**Interactive measurement**\n- Measure distances directly in RA/Dec coordinates\n- Real-time coordinate display with velocity at each point\n- Automatic frequency-to-velocity conversion via Doppler formula\n- Labels render clearly on top of volume data\n\n**Multi-channel spectral lines**\n- Load and compare CO, HCN, HNC, and other molecular emissions side by side\n- Per-channel WCS from FITS headers\n- Velocity-normalized Z-axis aligns Doppler-shifted features across channels\n\n**Native FITS support**\n- Load .fits and .fits.gz cubes directly \u2014 no conversion needed\n- Full WCS header parsing with automatic voxel scaling\n- REST frequency detection from headers or ALMA-style filenames\n- ZIP support: download from Google Drive, extract and load automatically\n\n**Smart data handling**\n- Auto-optimizes oversized datasets to fit device memory\n- Gaussian filtering preserves visual detail during optimization\n- Progress feedback during loading \u2014 no frozen screens\n- Desktop version available at immsci.com/volumeVR for full-resolution work\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 explore the same datacube together in real time\n\n**Pre-loaded datasets**\n- Curated nebula observations ready to explore on launch\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D radio astronomy datacubes in VR. Load FITS files natively with full WCS coordinates, measure distances in RA/Dec, compare molecular emission channels side by side. Auto-optimizes large datasets. Built for radio astronomers. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
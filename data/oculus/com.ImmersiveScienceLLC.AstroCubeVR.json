i4ahyUeuotMiV6I6nSLlAy4c7TDaHdXNL6Sn41nJBp4iWq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UochEsMxWv0cmwMHP2GCXaOXJCdRr8wxSX2AJK2DlvQ&oe=69D39DC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AstroCubeVR", "keywords": [], "long_description": "**AstroCubeVR** \u2014 immersive 3D exploration of astronomical datacubes, from Immersive Science.\n\nLoad FITS datacubes from ALMA and other radio telescopes and navigate through them in true 3D on Meta Quest.\n\n**Interactive measurement**\n- Measure distances directly in RA/Dec coordinates\n- Real-time coordinate display with velocity at each point\n- Automatic frequency-to-velocity conversion via Doppler formula\n- Labels render clearly on top of volume data\n\n**Multi-channel spectral lines**\n- Load and compare CO, HCN, HNC, and other molecular emissions side by side\n- Per-channel WCS from FITS headers\n- Velocity-normalized Z-axis aligns Doppler-shifted features across channels\n\n**Native FITS support**\n- Load .fits and .fits.gz cubes directly \u2014 no conversion needed\n- Full WCS header parsing with automatic voxel scaling\n- REST frequency detection from headers or ALMA-style filenames\n- ZIP support: download from Google Drive, extract and load automatically\n\n**Smart data handling**\n- Auto-optimizes oversized datasets to fit device memory\n- Gaussian filtering preserves visual detail during optimization\n- Progress feedback during loading \u2014 no frozen screens\n- Desktop version available at immsci.com/volumeVR for full-resolution work\n\n**Collaborate**\n- Share a virtual space with colleagues \u2014 explore the same datacube together in real time\n\n**Pre-loaded datasets**\n- Curated nebula observations ready to explore on launch\n\nStandalone on Meta Quest 2, Quest 3, and Quest Pro.\n", "short_description": "Explore 3D radio astronomy datacubes in VR. Load FITS files natively with full WCS coordinates, measure distances in RA/Dec, compare molecular emission channels side by side. Auto-optimizes large datasets. Built for radio astronomers. From Immersive Science, makers of StarGateVR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9947701328641115"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1660600645254425"}]}, "baseline_offer": {"id": "1660600645254425"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774629600, "status": "PUBLISHED", "id": "1660600645254425"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26345095425141779", "version": "4.0"}, "id": "1645121412836916", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9947701315307783", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26345095425141779"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "
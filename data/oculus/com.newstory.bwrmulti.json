391906_1417003759298432_2499213121975532082_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w15IndZQGxMQ7kNvwGi8R-C&_nc_oc=AdrXWotmNgxv4hnEtPT0Hzebx1OtVA9krG-K9ZQgIkeoU7t5dmhWI2k_e30UK-ogOg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBlBSUzssAiwPO5hJfu3ABRnN_9lmWnwDwjLMMFSd54A&oe=6ADF76C5"}, {"file_name": "screensho4.png", "id": "524660120583235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392054_524660123916568_7474097078851040340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1N3LVJolbAQ7kNvwFdKnWA&_nc_oc=AdpiD3yRQ2h2DLm1ENyw9U3z-TXlZgY1XcSf0sfnexDZjCGBki_t4s2FTRgQ4oWrdSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQPK-KOf4WX5mfi8w6FMYOoUP8TSQi5_ZPJ7kvh8RQqw&oe=6ADF43A6"}, {"file_name": "screenshot3.png", "id": "1200002448573925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391906_1200002451907258_7587383325766979279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99rJVLh2iI4Q7kNvwG8CppK&_nc_oc=AdpM7lg5VSrwDMIZ6MFmSZcSq2z0jzQB_5hhnTFrhUN49W_BaOD8X_p-s1PEDlsns4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHh8jltRn3Mix_MkLRMV6hjFYnMyXsnCjP0WswiLkQzA&oe=6ADF6319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plug Escape Landscape.png", "id": "1355048125731219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393355_1355048129064552_6885705530685530055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BYjVOFzYBYQ7kNvwFXQPDj&_nc_oc=AdqCbcG985Hdcf6p5ASOixjpkk5dD7X-V3QxqgR4BgVo461IzOcb9dQYWO-Ab4wy8hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTpLNXkVH58QJ5xi91leJltqAb7PYedDi0AOuireuqZg&oe=6ADF511F"}, "display_name": "Plug Escape\uff1aFree Circuit Room VR", "keywords": ["Puzzle", "Multiplayer", "Adventure", "Escape"], "long_description": "# WHOA! Dudes and Dudettes, ready to get AMPED UP with your crew?\n\nTeam up with friends in the **wacky multiplayer world of Plug Escape** and become a team of energetic plug buddies facing a **BIG problem!** This is the hilarious **co-op VR game** you've been waiting for!\n\nOur little heroes, let's call 'em the '**Spark Squad**' (or your own awesome team name!), were just chilling, minding their own electrifying business, when **BAM! Disaster strikes!** All the super-important batteries they need to power up have scattered themselves around this totally normal-looking (but secretly CRAZY active) room. And guess what? They need **YOU and YOUR FRIENDS** to **work together, strategize,** and get 'em all back in this **fun VR adventure!**\n\nCan your squad find all the batteries before you all short out?\n\n**Grab your headsets, rally your friends, charge up your teamwork,** and get ready for a **shockingly good time** in this **unique VR puzzle adventure.** This isn't just another escape room game; it's an **electrifying co-op journey** that'll have your whole crew **buzzing and laughing** all the way to the (imaginary) power outlet!\n\n**Unite your plug powers!**\n**Become the ultimate battery-collecting champions!**\n\nLet the co-op battery hunt begin in Plug Escape \u2013 one of the **most fun VR games to play with friends!**", "short_description": "Team up in VR! Find batteries as funny plug pals in a wacky co-op puzzle adventure. Don't short out!"}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memo
1-25/473391906_1417003759298432_2499213121975532082_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JenKyXxQc-4Q7kNvwHCW3PO&_nc_oc=AdqDMyR14KCmTJxdHwMbytB5cyXWXLP3eOX7r2LqaQ3_dntOKM-DvvfPJCuJ7kMu3pw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6pYiozfDIQvKekdHxpYvH7LyN3wGWBgnxYctxukSdUQ&oe=6AA42345"}, {"file_name": "screensho4.png", "id": "524660120583235", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392054_524660123916568_7474097078851040340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeWrJusQ-bwQ7kNvwHnPXyY&_nc_oc=AdoIJfvJnHDAuAe6wKmRGPhwu6ie5q1FNGgb4QOYxlPut7xjPn3URRC2mA_o53q39VA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEzwdhXAsHOR7sSHqaZgjRfOKWeZjvSTQx2aR0Y-misg&oe=6AA3F026"}, {"file_name": "screenshot3.png", "id": "1200002448573925", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391906_1200002451907258_7587383325766979279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWCducGd9f4Q7kNvwETOCcj&_nc_oc=AdpdNrB4j-RlNCL6RqQv0V1HkbtfPh3sbjVvB4NwjxEJTAjZHN9GHwQLm4G5adZyheg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIqsR4mRvWB4hY610OqcBIR4hzXxoUUR7k__dCi_I1QA&oe=6AA40F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plug Escape Landscape.png", "id": "1355048125731219", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393355_1355048129064552_6885705530685530055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjppzx3W_RAQ7kNvwG5nByQ&_nc_oc=Adq2GtqVcKquBdhhqZKy08ker2PPoeQeft3FH8L5G2YjUkkWpw7YA_cQ22zHM_P3ZaY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP2yfh8954hL_OWHw3sS-qXDhi1pM1YgdfdQ4ox6YupQ&oe=6AA3FD9F"}, "display_name": "Plug Escape\uff1aFree Circuit Room VR", "keywords": ["Puzzle", "Multiplayer", "Adventure", "Escape"], "long_description": "# WHOA! Dudes and Dudettes, ready to get AMPED UP with your crew?\n\nTeam up with friends in the **wacky multiplayer world of Plug Escape** and become a team of energetic plug buddies facing a **BIG problem!** This is the hilarious **co-op VR game** you've been waiting for!\n\nOur little heroes, let's call 'em the '**Spark Squad**' (or your own awesome team name!), were just chilling, minding their own electrifying business, when **BAM! Disaster strikes!** All the super-important batteries they need to power up have scattered themselves around this totally normal-looking (but secretly CRAZY active) room. And guess what? They need **YOU and YOUR FRIENDS** to **work together, strategize,** and get 'em all back in this **fun VR adventure!**\n\nCan your squad find all the batteries before you all short out?\n\n**Grab your headsets, rally your friends, charge up your teamwork,** and get ready for a **shockingly good time** in this **unique VR puzzle adventure.** This isn't just another escape room game; it's an **electrifying co-op journey** that'll have your whole crew **buzzing and laughing** all the way to the (imaginary) power outlet!\n\n**Unite your plug powers!**\n**Become the ultimate battery-collecting champions!**\n\nLet the co-op battery hunt begin in Plug Escape \u2013 one of the **most fun VR games to play with friends!**", "short_description": "Team up in VR! Find batteries as funny plug pals in a wacky co-op puzzle adventure. Don't short out!"}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
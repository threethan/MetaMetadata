 charge up your teamwork,** and get ready for a **shockingly good time** in this **unique VR puzzle adventure.** This isn't just another escape room game; it's an **electrifying co-op journey** that'll have your whole crew **buzzing and laughing** all the way to the (imaginary) power outlet!\n\n**Unite your plug powers!**\n**Become the ultimate battery-collecting champions!**\n\nLet the co-op battery hunt begin in Plug Escape \u2013 one of the **most fun VR games to play with friends!**", "short_description": "Team up in VR! Find batteries as funny plug pals in a wacky co-op puzzle adventure. Don't short out!"}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "23922446260685738"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1416789942800987"}]}, "baseline_offer": {"id": "1416789942800987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747379640, "status": "PUBLISHED", "id": "1416789942800987"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {
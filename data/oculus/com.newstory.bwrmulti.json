391906_1417003759298432_2499213121975532082_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM3EroggMj0Q7kNvwFn7QM4&_nc_oc=Adp7Ju7zW10SbYGnukmTsJ_9VWbq6zLD0NDXLy-DGHjvfGWsDLeLDYqXvmSPQc8jjTE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSEShqXCZcG3dYScgyRK24GdWWZMWe1SMwBZr2V1ajOA&oe=6AD39945"}, {"file_name": "screensho4.png", "id": "524660120583235", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392054_524660123916568_7474097078851040340_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8OdCxGoPK4Q7kNvwEVAXfL&_nc_oc=AdoeopQak2R5y6E6EBrHRx6vRb3Di6vBxxZrrlxXEAClqirGCcM2dpY63MSqcxKhKME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg_wxgGIg9BJ6I6QePuGXzG-dVT8i-rpDHlGSbtTaqPw&oe=6AD39E66"}, {"file_name": "screenshot3.png", "id": "1200002448573925", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391906_1200002451907258_7587383325766979279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF0OhGc7F6wQ7kNvwHzNR_h&_nc_oc=AdqYKlvxmq4EkFD3Tq-WXaTb2gBFOJxMMt4dYvnf0OB77w5HC_u8o0n1FFzf-4ORkxk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzDomCZ9BUX-kp8RPntu1dBuvKwR-gkSlnncTIqzGX-A&oe=6AD38599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plug Escape Landscape.png", "id": "1355048125731219", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393355_1355048129064552_6885705530685530055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i77Iw56hDsEQ7kNvwGI9MFB&_nc_oc=AdrBfDhZl6yRpwsc40YZD4dKktvqqXOoRR7xyz9UHizuEwC7gGXHZbKkqkrc2OSBX8I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI-Pfe3j8vA22RAMl9i44D7Ap4HQfIC4S1ZnnXVAUEbw&oe=6AD3ABDF"}, "display_name": "Plug Escape\uff1aFree Circuit Room VR", "keywords": ["Puzzle", "Multiplayer", "Adventure", "Escape"], "long_description": "# WHOA! Dudes and Dudettes, ready to get AMPED UP with your crew?\n\nTeam up with friends in the **wacky multiplayer world of Plug Escape** and become a team of energetic plug buddies facing a **BIG problem!** This is the hilarious **co-op VR game** you've been waiting for!\n\nOur little heroes, let's call 'em the '**Spark Squad**' (or your own awesome team name!), were just chilling, minding their own electrifying business, when **BAM! Disaster strikes!** All the super-important batteries they need to power up have scattered themselves around this totally normal-looking (but secretly CRAZY active) room. And guess what? They need **YOU and YOUR FRIENDS** to **work together, strategize,** and get 'em all back in this **fun VR adventure!**\n\nCan your squad find all the batteries before you all short out?\n\n**Grab your headsets, rally your friends, charge up your teamwork,** and get ready for a **shockingly good time** in this **unique VR puzzle adventure.** This isn't just another escape room game; it's an **electrifying co-op journey** that'll have your whole crew **buzzing and laughing** all the way to the (imaginary) power outlet!\n\n**Unite your plug powers!**\n**Become the ultimate battery-collecting champions!**\n\nLet the co-op battery hunt begin in Plug Escape \u2013 one of the **most fun VR games to play with friends!**", "short_description": "Team up in VR! Find batteries as funny plug pals in a wacky co-op puzzle adventure. Don't short out!"}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memo
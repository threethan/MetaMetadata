_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXclxgtDG3JMzbXW5Iprn3jLIuUSKFDIUKE9y9E68cCQ&oe=6A674B26"}, {"file_name": "screenshot3.png", "id": "1200002448573925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391906_1200002451907258_7587383325766979279_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywxBUQqkyNkQ7kNvwHwCPMQ&_nc_oc=Adrck2vH5bW5pE_4mzf3yxnnk1qOY3YW4LZ75ZUg5ey2wP1u2o12--dR0NVp_WdFTMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvKds4GPBsKNukksPtjTLitTNHyLavJlRQNE9TbFn8ww&oe=6A676A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plug Escape Landscape.png", "id": "1355048125731219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393355_1355048129064552_6885705530685530055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgAf3Fj25xMQ7kNvwERRy47&_nc_oc=AdoDbKOdgOYnYKTL02O23ThJwE5o0F7qJxgdlMTe6OETVw5l4vCtw00CoU6NLyYohbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIBwyZadLLjVU8UCR2KiXCRS-XcvO7kGdopc6zqdqbjQ&oe=6A67589F"}, "display_name": "Plug Escape\uff1aFree Circuit Room VR", "keywords": ["Puzzle", "Multiplayer", "Adventure", "Escape"], "long_description": "# WHOA! Dudes and Dudettes, ready to get AMPED UP with your crew?\n\nTeam up with friends in the **wacky multiplayer world of Plug Escape** and become a team of energetic plug buddies facing a **BIG problem!** This is the hilarious **co-op VR game** you've been waiting for!\n\nOur little heroes, let's call 'em the '**Spark Squad**' (or your own awesome team name!), were just chilling, minding their own electrifying business, when **BAM! Disaster strikes!** All the super-important batteries they need to power up have scattered themselves around this totally normal-looking (but secretly CRAZY active) room. And guess what? They need **YOU and YOUR FRIENDS** to **work together, strategize,** and get 'em all back in this **fun VR adventure!**\n\nCan your squad find all the batteries before you all short out?\n\n**Grab your headsets, rally your friends, charge up your teamwork,** and get ready for a **shockingly good time** in this **unique VR puzzle adventure.** This isn't just another escape room game; it's an **electrifying co-op journey** that'll have your whole crew **buzzing and laughing** all the way to the (imaginary) power outlet!\n\n**Unite your plug powers!**\n**Become the ultimate battery-collecting champions!**\n\nLet the co-op battery hunt begin in Plug Escape \u2013 one of the **most fun VR games to play with friends!**", "short_description": "Team up in VR! Find batteries as funny plug pals in a wacky co-op puzzle adventure. Don't short out!"}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "23922446260685738"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1416789942800987"}]}, "baseline_offer": {"id": "1416789942800987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747379640, "status": "PUBLISHED", "id": "1416789942800987"}]}, "liveChannel": {"nodes": [{"latest_suppor
dn.com&_nc_ss=7f30f&oh=00_AQVRYB1zaDRqTn0a4E420z2d-KTnIfzDhgNImhgGgUHp5A&oe=6B104182"}, {"file_name": "7_screenshot_3.png", "id": "908231089043155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_908231092376488_3571624423057275408_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j3I7XxafUMQ7kNvwHWNWs7&_nc_oc=AdpVoTDAeb0txBJub0DJOI4mNhLmRZj7GoJJ0NdoYxRe83bIJs75EwOLL5ExvpM6-OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMEErZiZFUjWlcRda-wRnEaPc0vZlzgFI_TnYEJJK-sQ&oe=6B10360A"}, {"file_name": "7_screenshot_5.png", "id": "963344669883006", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_963344673216339_6994924900450683490_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j20aFZHRxWMQ7kNvwEF1on3&_nc_oc=AdoN2742g9Re5lWh2UoVrD4FC4yOdY6RxplsnOLUnwrzyBCLSM2XaTwYDA9Me4n6wWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbyfDeDPbyUb9ZYpBFK96VxNMkPkXTmLfhOeyFu0HF-g&oe=6B1039A9"}, {"file_name": "7_screenshot_2.png", "id": "1534378068981003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1534378072314336_6106076897436410251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN74fmYLBS8Q7kNvwGbMUdV&_nc_oc=AdrvXtOBjr4s0RCUdVJ8iS-rG1BjOGCsh1W4nRpbiFvvqIY04XdZaj4TAswDbNsA2eQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUS3iLurL6kM8N7PdyBUayEGhEGNXDpWH-5meWQYA07fQ&oe=6B10538D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racket Your Walls", "keywords": ["arcade", "racket", "bricks", "breakout", "walls"], "long_description": "Racket Your Walls turns the room you are standing in into a brick breaker.\n\nYour own walls are cut into bricks. You hold a racket, the ball flies, and every brick it breaks leaves a hole in your wall. Behind it is another world: you look through your living room wall into a jungle, a temple, a city of neon.\n\nBREAK YOUR ROOM OPEN\n\u2022 Bricks fall out of your real wall onto your real floor\n\u2022 The more you open, the more the ceiling opens above you\n\u2022 Open enough and the whole room melts into the world behind it\n\nTEN WORLDS BEHIND YOUR WALLS\n\u2022 Jungle ruins, an asteroid base, an Egyptian temple, a crystal cave, a neon city and five more\n\u2022 Each has its own sounds and creatures that fly into your room, and most have a special brick of their own\n\u2022 After the tenth they come round again, faster and harder\n\nBRICKS THAT HELP, BRICKS THAT HURT\n\u2022 More balls, a fire ball, a bigger racket, a slower ball\n\u2022 A faster ball, a smaller racket, hard bricks that need two hits\n\nMADE FOR A REAL ROOM\n\u2022 Play standing in one spot: a small bedroom is enough\n\u2022 Furniture in the way? Point at it and make it disappear\n\u2022 No walls near you? The game draws walls round you\n\u2022 Hold the racket with a controller for precision, or with your bare hand\n\nKEEP COMING BACK\n\u2022 Your run is saved: go on from the level you reached\n\u2022 One score table for all players: how far can a run go?\n\nNo ads. No account to create.\n\nMade for Meta Quest 3 and 3S. You need a room scan (Space Setup) and a clear spot to stand in, facing a wall.", "short_description": "Your real walls are the bricks. Take a racket, hit the ball, and break your room open onto ten worlds hidden behind it. Mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hearth-software.com/racketyourwalls-privacy.html", "developer_terms_of_service_url": "https://hearth-software.com/racketyourwalls-terms.html", "publisher_name": "Hearth Software", "support_website_url": null, "website_url": "https://hearth-software.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192
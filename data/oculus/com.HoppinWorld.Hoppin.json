c_ss=7a30f&oh=00_Af0n1f299ui8Crk6o4dGlABbaV-7iho6drZ4yxxt_VU_Tg&oe=69EB72FF"}, {"file_name": "Screenshots4.png", "id": "808197603102183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_808197606435516_1163271569636830159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9J_B96T6y8Q7kNvwFdRUVu&_nc_oc=Adqkh5z3bv_U5uKyKSlZnC5-0ML5c-oQ3ldmVvpN_LuPZtUAXyiPZaCUInNy_H_EIzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af007a9QroMPPPuigmSbbZcNv69wauLukTv3E62uUw2rog&oe=69EB8274"}, {"file_name": "Screenshots5.png", "id": "1856438794557963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625129_1856438797891296_1499696175572873419_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW0JBFvpaY0Q7kNvwHu4IBS&_nc_oc=AdpOGIE92eaPe97Y6pg9qpOi1KHGGgf_CAE8AkqinsvdJqbH_OPuhFyj3MoLinaZYjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31bnc_RrcxyKNZLwfBJvD56_41JJiJpIDf-fAEK3w19Q&oe=69EB5E8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppin'", "keywords": [], "long_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Follow your host or lead the way. When you like where you're at, send yourself some information about the Hoppin' place by email.\nActivities, culture, events, landmarks or touristic locations can benefit from this unique opportunity to welcome potential visitors onsite. Contact us through hoppin.world to participate in the media revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Hoppin' is the Social VR platform offering telepresence in real destinations together! Meet in real locations as avatars in 360 videos. Upload your own content. Promote your location in public channels. Hangout with your friends in personal channels. Invite your customers in private channels. Previously on the Oculus Go, now in Beta on Apps Lab for Quest. Let us know what you like and what you need next! feedback@hoppin.world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoppin.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hoppin' World", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "fr", "es", "fr_CA", "es_PR", "fr_BE", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "620614662573959"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1720355391912629"}, {"status": "PUBLISHED", "id": "379810056743344"}]}, "baseline_offer": {"id": "379810056743344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1720355391912629"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34130718039876187", "version": "3.8.2"}, "id": "228885958890273", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "
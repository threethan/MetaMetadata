c_ss=7f20f&oh=00_AQOXM0RDsZbbhDwr2myICF_yNp-Af5f23tKGxkCMRj-2QQ&oe=6AE34CFF"}, {"file_name": "Screenshots4.png", "id": "808197603102183", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_808197606435516_1163271569636830159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSQYgQQSYr4Q7kNvwFBh5ME&_nc_oc=Adpc4zHwTKb-40tgvr6F25suI-LB85lbUCrkQYZj0s2Yopxd1Xgu7uQ4T6bWrKfNvSY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRv-V3J_K754UPrH22XJsIAfeYMW_SXA-jKY1ixxfSxw&oe=6AE35C74"}, {"file_name": "Screenshots5.png", "id": "1856438794557963", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86625129_1856438797891296_1499696175572873419_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77-HsWeK12sQ7kNvwHV1Kb5&_nc_oc=AdoxG8ztFdR3fSWLnVWvGsLhbZQcvixKRCZ-hNCnAzmFJda6oSifcFcSCACVlCvxKow&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNeTzE4RywPJ1VNOpe0Ju-jt19z9JgGVmEMZwKofzeOg&oe=6AE3388A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppin'", "keywords": [], "long_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Follow your host or lead the way. When you like where you're at, send yourself some information about the Hoppin' place by email.\nActivities, culture, events, landmarks or touristic locations can benefit from this unique opportunity to welcome potential visitors onsite. Contact us through hoppin.world to participate in the media revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Hoppin' is the Social VR platform offering telepresence in real destinations together! Meet in real locations as avatars in 360 videos. Upload your own content. Promote your location in public channels. Hangout with your friends in personal channels. Invite your customers in private channels. Previously on the Oculus Go, now in Beta on Apps Lab for Quest. Let us know what you like and what you need next! feedback@hoppin.world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoppin.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hoppin' World", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "fr", "es", "fr_CA", "es_PR", "fr_BE", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "620614662573959"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1720355391912629"}, {"status": "PUBLISHED", "id": "379810056743344"}]}, "baseline_offer": {"id": "379810056743344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1720355391912629"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39447478061533465", "version": "3.8.6"}, "id": "228885958890273", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39447478061533465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": "Hoppin' 3.8.6\r\n\r\n- New: 360\u00b0 photo scenes.\r\n- Email addresses of any length can now be entered in \"Send to mobile\".\r\n- On shared Station headsets, the previous visitor's email is no longer remembered for the next visitor.\r\n- If startup fails or there is no network, a clear message with a Quit button now appears instead of a black screen.\r\n- Fixed: holding Next/Previous now always opens the experience shown in the preview.\r\n- Various stability fixes.", "created_date": 1792544643, "id": "39447478061533465", "version": "3.8.6", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39447478061533465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1784932776, "id": "37298013403146619", "version": "3.8.5", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39447478061533465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1784653287, "id": "37223080663973227", "version": "3.8.4", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39447478061533465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": "Version 3.8.3\nNew\n\u2022 Request info without leaving VR \u2014 tap to have activity details and booking links sent straight to your email, right from the feed and toolbar.\n\u2022 Saved email: enter your address once and reuse it, with your saved email shown securely.\n\u2022 Redesigned recentering: a smoother, guided flow to realign your view, with passthrough-assisted alignment and comfort checks.\n\u2022 More comfortable startup and viewing \u2014 fewer black screens on weak connections, reduced dizziness, and better head-tracking behavior.\n\u2022 Refined toolbar and menu: clearer selected states, better spacing, and smoother navigation.\n\u2022 Improved playback: more reliable auto-advance, play/pause sync, and next/previous navigation.\nPrivacy\n\u2022 This version collects anonymous session analytics (which experiences are viewed and shared) to help venues improve recommendations. No personal identity is collected; email is used only when you choose to send yourself info.", "created_date": 1783348644, "id": "36920236877590942", "version": "3.8.3", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39447478061533465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1772128396, "id": "34130718039876187", "version": "3.8.2", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
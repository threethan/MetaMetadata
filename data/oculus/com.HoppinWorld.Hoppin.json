-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCDDZE5ar8uI6WrcbyZuU1tswV7QKwD46a__2Px1V92g&oe=6A85B27F"}, {"file_name": "Screenshots4.png", "id": "808197603102183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974677_808197606435516_1163271569636830159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_TS9xQJ9dAQ7kNvwFVWfZ_&_nc_oc=AdqLUSX9egA3pXG80NJLjqkt1BhRKewLfoYmIMb3eBqjhcH2i_BBU_80X578a6KvYsk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtJM7i3EhpoGBsfbpDAEPxkv_kIQ9SMNVV6O8aPYrWng&oe=6A8589B4"}, {"file_name": "Screenshots5.png", "id": "1856438794557963", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86625129_1856438797891296_1499696175572873419_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6Z0psieykkQ7kNvwHUEbWn&_nc_oc=Adqa9WNIPi4ID4lsvrMsoxIMYsnWn72zTHohQB-6L00jdjKE_CXDvqfErvsV2KqPgqU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGv9S5TeB2zQqlJ7mPmVyXbEq8ONkov_iI3TRaNaj_kg&oe=6A859E0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppin'", "keywords": [], "long_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Follow your host or lead the way. When you like where you're at, send yourself some information about the Hoppin' place by email.\nActivities, culture, events, landmarks or touristic locations can benefit from this unique opportunity to welcome potential visitors onsite. Contact us through hoppin.world to participate in the media revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Hoppin' is the Social VR platform offering telepresence in real destinations together! Meet in real locations as avatars in 360 videos. Upload your own content. Promote your location in public channels. Hangout with your friends in personal channels. Invite your customers in private channels. Previously on the Oculus Go, now in Beta on Apps Lab for Quest. Let us know what you like and what you need next! feedback@hoppin.world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoppin.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hoppin' World", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "fr", "es", "fr_CA", "es_PR", "fr_BE", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "620614662573959"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1720355391912629"}, {"status": "PUBLISHED", "id": "379810056743344"}]}, "baseline_offer": {"id": "379810056743344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1720355391912629"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37298013403146619", "version": "3.8.5"}, "id": "228885958890273", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37298013403146619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1784932776, "id": "37298013403146619", "version": "3.8.5", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37298013403146619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1784653287, "id": "37223080663973227", "version": "3.8.4", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37298013403146619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": "Version 3.8.3\nNew\n\u2022 Request info without leaving VR \u2014 tap to have activity details and booking links sent straight to your email, right from the feed and toolbar.\n\u2022 Saved email: enter your address once and reuse it, with your saved email shown securely.\n\u2022 Redesigned recentering: a smoother, guided flow to realign your view, with passthrough-assisted alignment and comfort checks.\n\u2022 More comfortable startup and viewing \u2014 fewer black screens on weak connections, reduced dizziness, and better head-tracking behavior.\n\u2022 Refined toolbar and menu: clearer selected states, better spacing, and smoother navigation.\n\u2022 Improved playback: more reliable auto-advance, play/pause sync, and next/previous navigation.\nPrivacy\n\u2022 This version collects anonymous session analytics (which experiences are viewed and shared) to help venues improve recommendations. No personal identity is collected; email is used only when you choose to send yourself info.", "created_date": 1783348644, "id": "36920236877590942", "version": "3.8.3", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37298013403146619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": null, "created_date": 1772128396, "id": "34130718039876187", "version": "3.8.2", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5105861412788569", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37298013403146619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "228885958890273"}]}, "change_log": "What\u2019s new in 3.8.1\n\nThis update brings important improvements to navigation, onboarding, and hands-free viewing \u2014 making Hoppin\u2019 more intuitive and reliable for both first-time visitors and public installations.\n\nHighlights\n\n* Improved onboarding flow with clearer, easier-to-follow interactions\n\n* More precise and intentional portal activation to prevent accidental teleports\n\n* New hands-free viewing mode for guided or autonomous experiences\n\n* Improved menu positioning and interface stability across rooms\n\n* Multiple fixes to improve overall reliability and user experience\n\nThis update is recommended for all users.", "created_date": 1770626066, "id": "33830563739891620", "version": "3.8.1", "version_code": 97, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwGLdeKiG6oQ7kNvwGrD-9F&_nc_oc=AdokrrKDWV6uHZ3SzZqjfUx-5xqLJ0tNltKn01Khp5xXc8OCvfdCSw-4-WXGvpZ3xmA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiw0voxRek9MN_FnB0rfVuPuDaNIPa-Veaq7lLKrjoqw&oe=6A859BD4"}, {"file_name": "Screenshots3.png", "id": "131893748814949", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982535_131893752148282_6700874958459513544_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8azid29J-4Q7kNvwEs3yvq&_nc_oc=AdpkzVx3ME2rIer9JMByMVm7F0jwm51lx8FV2bAP-P11G8T1VPJFJvnHLPeHMHgahIY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCDDZE5ar8uI6WrcbyZuU1tswV7QKwD46a__2Px1V92g&oe=6A85B27F"}, {"file_name": "Screenshots4.png", "id": "808197603102183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974677_808197606435516_1163271569636830159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_TS9xQJ9dAQ7kNvwFVWfZ_&_nc_oc=AdqLUSX9egA3pXG80NJLjqkt1BhRKewLfoYmIMb3eBqjhcH2i_BBU_80X578a6KvYsk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtJM7i3EhpoGBsfbpDAEPxkv_kIQ9SMNVV6O8aPYrWng&oe=6A8589B4"}, {"file_name": "Screenshots5.png", "id": "1856438794557963", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86625129_1856438797891296_1499696175572873419_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6Z0psieykkQ7kNvwHUEbWn&_nc_oc=Adqa9WNIPi4ID4lsvrMsoxIMYsnWn72zTHohQB-6L00jdjKE_CXDvqfErvsV2KqPgqU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGv9S5TeB2zQqlJ7mPmVyXbEq8ONkov_iI3TRaNaj_kg&oe=6A859E0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hoppin'", "keywords": [], "long_description": "Meet with Friends and Family in real Hoppin' Destinations, 360 video chatrooms, using your Oculus avatar. Follow your host or lead the way. When you like where you're at, send yourself some information about the Hoppin' place by email.\nActivities, culture, events, landmarks or touristic locations can benefit from this unique opportunity to welcome potential visitors onsite. Contact us through hoppin.world to participate in the media revolution.\nCreators, producers, studios or 360 capture enthusiasts earn commissions when referring their favorite destinations and posting their amazing experiences. Once approved and published, they automatically become official Hoppin' creators, and we'll send their way anyone who asks about immersive content production in their region.\nEnjoy!", "short_description": "Hoppin' is the Social VR platform offering telepresence in real destinations together! Meet in real locations as avatars in 360 videos. Upload your own content. Promote your location in public channels. Hangout with your friends in personal channels. Invite your customers in private channels. Previously on the Oculus Go, now in Beta on Apps Lab for Quest. Let us know what you like and what you need next! feedback@hoppin.world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoppin.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Hoppin' World", "support_website_url": null, "website_url": "https://hoppin.world/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "fr", "es", "fr_CA", "es_PR", "fr_BE", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
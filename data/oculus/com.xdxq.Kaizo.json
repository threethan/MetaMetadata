le_name": "Game_Custom..._08.04.2025_18-21-26-removebg-preview(1).png", "id": "658149416974911", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393355_658149423641577_8132385362234704043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXoUsOjjBEoQ7kNvwF-gB-D&_nc_oc=AdqJ5itq1KTNoTjEtr0SkfsGI-oBHgeQTtPFFLHoS_DOLZ66KLXSJYqB9g15KpXoYZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U0LyIZitA-gAkPP3GGY6GaohlPRK-ARvunwzFVxNUYw&oe=69F1F8CE"}]}, "id": "1212562660443589", "locale": "en_US", "screenshots": [{"file_name": "Game_Custom..._08.04.2025_18-28-49.png", "id": "1855886348567304", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392036_1855886351900637_5024586103105160987_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g97TQwuRimQQ7kNvwEea0tD&_nc_oc=Adqqp2vjkRUzQt49Y3WvDR89GomjSUPS5wjo997FPisshexN49yNn5wi_Ar2beu2WdI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0xusYZ1Oniqa2x45QFNApehSZMhNtUlAAfq2M9E0X0-w&oe=69F20AFC"}, {"file_name": "Game_Custom..._08.04.2025_18-28-16.png", "id": "9399794596798000", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392192_9399794606797999_9078663125448913530_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQLOQG8HrYYQ7kNvwHZl8ok&_nc_oc=AdoyeTyGRmGzZflLYK4kAq0Yw-5mxKJOuoD3WfNsnM2xToVd6YpdJJFeXWcajbDs_7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2X4MFwS3mzRucm9ufuSf27s7e3VAw_v3gw1lKudgSoBA&oe=69F1FDDB"}, {"file_name": "Game_Custom..._08.04.2025_18-29-32.png", "id": "648557181223398", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393372_648557184556731_256361769319454583_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPENMxycfQ0Q7kNvwHJ9YV8&_nc_oc=AdqaybCIb9QGByipP_KdDiAWczFLB8WYHkW1DWS3HcaRdkVaM9hCmu-90nMEa8uqqS4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0R0U-fNVp-1lvJdS946VFyZPjtAOQw2t48SEoa3XxGjg&oe=69F21380"}, {"file_name": "Game_Custom..._08.04.2025_18-28-35.png", "id": "980612047594267", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392192_980612050927600_4004035728577556531_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxzCEgI961MQ7kNvwFxSakS&_nc_oc=AdqloyyWvdet8jnYnV7Rsjq5DE1zmZbJbYXizPIBswo5KQgyr_uu-rsdNZjW6nbkg3M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1AjwFW50yxdr2x1kFN8zDN-mx1MM6BGE8nlzUFrXAnAQ&oe=69F1FC46"}, {"file_name": "Game_Custom..._08.04.2025_18-28-27.png", "id": "1020129416708642", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391921_1020129420041975_4188773779701387374_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x72kV64_jIQ7kNvwH8zax3&_nc_oc=AdoDQdmf7s5YUyx1Jz8sJisVh1AY-zxGmm7q7imgr_TowqdZGttnTCxtJ0MD2gkJXWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pJPmn9Dq02FIIWztZqVNLE3kSkoCPxnBQMji8bdLmRg&oe=69F1F203"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaizo", "keywords": ["gorilla", "horror", "miner"], "long_description": "-- Kaizo: The Next Generation of Horror VR --\n\nStep into a world where fear takes physical form\u2014Kaizo redefines horror in virtual reality, plunging you into a relentless fight for survival. This isn\u2019t just a game; it\u2019s a psychological and sensory assault, designed to push your limits. With hyper-immersive environments, adaptive AI that learns your fears, and grotesque creatures lurking in every shadow, Kaizo will make you question what\u2019s real.\nA Descent Into Terror\nYour journey begins in a decaying mining outpost, abandoned for reasons no one dares speak of. As you progress, each level becomes more twisted\u2014claustrophobic tunnels where the walls breathe, derelict facilities humming with malfunctioning machinery, and fog-drenched forests where unseen things scuttle just beyond your vision. The atmosphere alone will suffocate you with dread.\nMine. Trade. Survive.\nThe creatures of Kaizo aren\u2019t mindless monsters\u2014they\u2019re cunning, patient, and hungry. Some stalk silently, their presence only betrayed by distant whispers. Others charge in frenzied packs, shrieking as they tear through the darkness. Worst of all are the ones that mimic\u2014sounds, voices, even human shapes\u2014luring you into fatal traps.\nYour Mind is the Real Battleground\nKaizo doesn\u2019t hold your hand. The VR immersion means every flinch, scream, and frantic breath is real. Will you master your fear, or will Kaizo break you?\nThe ultimate horror experience awaits.", "short_description": "Kaizo is the next generation of horror VR, Traverse through many different levels, mining ores for cash. Yet, you're not alone. Scary creatures await every corner. Can you survive? Find out in Kaizo today."}]}, "developer_name": "xdxq", "developer_privacy_policy_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "xdxq", "support_website_url": null, "website_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9333055453489043"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
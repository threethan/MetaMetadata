31_256361769319454583_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFofGDRlSqoQ7kNvwHChv34&_nc_oc=Adrp7VcUIfDj0wbAiSOXcYQPnmw9kMds0mUFtQ-b8OJPWUQT1E8QHw1kd9dI35cVKB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyvag0_7guaE-FiCxMnCNPduzEsTchsvlSN7JpjqrHZA&oe=6AFC6280"}, {"file_name": "Game_Custom..._08.04.2025_18-28-35.png", "id": "980612047594267", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392192_980612050927600_4004035728577556531_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNyeWMT5In0Q7kNvwHtadVG&_nc_oc=AdoLcuy1vPcAo6LQf9zpAG91iaSxWOEZZq4Ge1IBhnRwjAIi6juhsvp_bqup8JcsFV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxaKXZLYESsRqTWbRf7MmjcHIrOxPQqdO8Ze0sUv5FPA&oe=6AFC8386"}, {"file_name": "Game_Custom..._08.04.2025_18-28-27.png", "id": "1020129416708642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391921_1020129420041975_4188773779701387374_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQLpqhrR9VEQ7kNvwG_Y9t_&_nc_oc=AdrdSYW1OBqiqUHloS222MCMDFMuaeKKMG9qszQ7g6oyPzgDS2p3KbW2cB68OybWgCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI7xuY84YJzNGeKbkJQqEZWfJ0L4DXm8OOaq-ag_1Gaw&oe=6AFC7943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaizo", "keywords": ["gorilla", "horror", "miner"], "long_description": "-- Kaizo: The Next Generation of Horror VR --\n\nStep into a world where fear takes physical form\u2014Kaizo redefines horror in virtual reality, plunging you into a relentless fight for survival. This isn\u2019t just a game; it\u2019s a psychological and sensory assault, designed to push your limits. With hyper-immersive environments, adaptive AI that learns your fears, and grotesque creatures lurking in every shadow, Kaizo will make you question what\u2019s real.\nA Descent Into Terror\nYour journey begins in a decaying mining outpost, abandoned for reasons no one dares speak of. As you progress, each level becomes more twisted\u2014claustrophobic tunnels where the walls breathe, derelict facilities humming with malfunctioning machinery, and fog-drenched forests where unseen things scuttle just beyond your vision. The atmosphere alone will suffocate you with dread.\nMine. Trade. Survive.\nThe creatures of Kaizo aren\u2019t mindless monsters\u2014they\u2019re cunning, patient, and hungry. Some stalk silently, their presence only betrayed by distant whispers. Others charge in frenzied packs, shrieking as they tear through the darkness. Worst of all are the ones that mimic\u2014sounds, voices, even human shapes\u2014luring you into fatal traps.\nYour Mind is the Real Battleground\nKaizo doesn\u2019t hold your hand. The VR immersion means every flinch, scream, and frantic breath is real. Will you master your fear, or will Kaizo break you?\nThe ultimate horror experience awaits.", "short_description": "Kaizo is the next generation of horror VR, Traverse through many different levels, mining ores for cash. Yet, you're not alone. Scary creatures await every corner. Can you survive? Find out in Kaizo today."}]}, "developer_name": "xdxq", "developer_privacy_policy_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "xdxq", "support_website_url": null, "website_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
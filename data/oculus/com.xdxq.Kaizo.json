z33-wINMujk7BsVijceSA&oe=69FF4280"}, {"file_name": "Game_Custom..._08.04.2025_18-28-35.png", "id": "980612047594267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392192_980612050927600_4004035728577556531_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ATV4jWwQXsQ7kNvwEjty1K&_nc_oc=AdqzE1_C1L8MT3v7WHm719KFOjsAO2I2z0E6ZSxkOnwDhRAE5H0dBmOXhBG6JeZcV4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UqzrPsOh8vVrIVtHsw-p8zGsMBNs9BezHFXXDFgRz0g&oe=69FF2B46"}, {"file_name": "Game_Custom..._08.04.2025_18-28-27.png", "id": "1020129416708642", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391921_1020129420041975_4188773779701387374_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INqOgQxUmUAQ7kNvwGCV3gj&_nc_oc=AdqpfEBerBGRdLM6M7_7HHpldxjb9faFiG47nPw3c_0oJ4rTXWpGvJKqR_ln0n2nUVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VeO1y8-U7kAnh17LAQeXPj8dCsUNEIZ6vv7FoEdNqpg&oe=69FF2103"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaizo", "keywords": ["gorilla", "horror", "miner"], "long_description": "-- Kaizo: The Next Generation of Horror VR --\n\nStep into a world where fear takes physical form\u2014Kaizo redefines horror in virtual reality, plunging you into a relentless fight for survival. This isn\u2019t just a game; it\u2019s a psychological and sensory assault, designed to push your limits. With hyper-immersive environments, adaptive AI that learns your fears, and grotesque creatures lurking in every shadow, Kaizo will make you question what\u2019s real.\nA Descent Into Terror\nYour journey begins in a decaying mining outpost, abandoned for reasons no one dares speak of. As you progress, each level becomes more twisted\u2014claustrophobic tunnels where the walls breathe, derelict facilities humming with malfunctioning machinery, and fog-drenched forests where unseen things scuttle just beyond your vision. The atmosphere alone will suffocate you with dread.\nMine. Trade. Survive.\nThe creatures of Kaizo aren\u2019t mindless monsters\u2014they\u2019re cunning, patient, and hungry. Some stalk silently, their presence only betrayed by distant whispers. Others charge in frenzied packs, shrieking as they tear through the darkness. Worst of all are the ones that mimic\u2014sounds, voices, even human shapes\u2014luring you into fatal traps.\nYour Mind is the Real Battleground\nKaizo doesn\u2019t hold your hand. The VR immersion means every flinch, scream, and frantic breath is real. Will you master your fear, or will Kaizo break you?\nThe ultimate horror experience awaits.", "short_description": "Kaizo is the next generation of horror VR, Traverse through many different levels, mining ores for cash. Yet, you're not alone. Scary creatures await every corner. Can you survive? Find out in Kaizo today."}]}, "developer_name": "xdxq", "developer_privacy_policy_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "xdxq", "support_website_url": null, "website_url": "https://sites.google.com/view/kaizoprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "9333055453489043"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "li
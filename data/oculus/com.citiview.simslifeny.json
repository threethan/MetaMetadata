825_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld-WQkgs0J8Q7kNvwHYB_ip&_nc_oc=Adp10k0vxXCEG48Uij5UfWeS73LcBRdbSXM6BhSRR5E410veUVARgijWOb935SIA9lk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY0VgG1RB5gdwUQ10qmOLi1DQUwESAI5hWv2ODzBRCzA&oe=6AFC6D61"}]}, "id": "1782753099702152", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "2176515549886104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673780696_2176515553219437_1282854577308316098_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60cKkLGxF00Q7kNvwHVEsYY&_nc_oc=AdoCfMCO7SM4v6DgbA2KE9FIxqjofs3M569qg1dksTH8XUnSl_KU01Ygn3OFCg-uOck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUfnym_wXBSPG_WNgYa72qZELWeELve9IgWHTfd8Ctfw&oe=6AFC7E70"}, {"file_name": "screenshot_4.png", "id": "1604398414470118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_1604398417803451_7404964403691491173_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZgDvtygLEwQ7kNvwFVfMUe&_nc_oc=Adopl7pDVju91_-F-SP7dVM3kfSE5AW7TTV6WoOXCp65EANhTpZflvul2xryNyxD5Z8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6W49JbYeEtI-huhzOi9QGXfiQLCp-3YJioX2MGmY2HQ&oe=6AFC787C"}, {"file_name": "screenshot_2.png", "id": "1121911396997852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_1121911400331185_3652563266674717428_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBpg0p6KZF8Q7kNvwE6Vhp5&_nc_oc=Adoeilrby3XqOAFMuGAApJW2E0RSddQx4rHy9I8C0QppJz8cBATzGKyIo38-ojPSGho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXv3Y4GKfI2LNDYdTTAXWIayJ87Vew0XFVPvK4CjdyxA&oe=6AFC68B0"}, {"file_name": "screenshot_5.png", "id": "1574591427775315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1574591431108648_8645570332456385835_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MRE8OGefHgQ7kNvwHfSYkM&_nc_oc=Adr-B_ZqbltAifwDeiKPnIs41o4py09FYk_MWwlrAC3lkCeOn-7eti9RM0U9AzYDlms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9Q56i-zUtiZK-y_YyK1GUy1Limjq0Vf1S2UID0-8UIA&oe=6AFC7B4A"}, {"file_name": "screenshot_3.png", "id": "973665631761341", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673536876_973665635094674_4724760597349034538_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYyMHRLiA1YQ7kNvwFGvVza&_nc_oc=Adry9Wi6qJIZkXUTHI0T9zRYGCobhIbfUtGMruhj0Z-227VPfg6hxUzBZAshIykJZSA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlV413tMiq2aD5OoNqJHIn_1aujxCg_DXomUKJu1tpHQ&oe=6AFC69EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1103825302451658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_1103825305784991_3585303069939312710_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj_VZqAppJEQ7kNvwHAPD04&_nc_oc=AdoFVs_QaDbdkuqdRA-8LbV5rsU8asCmaG2y5UNTdOXZzfv6WjuH72oAwWgEHv5qp1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ4-1DGelkseVy8p_cAcl_dX3Ej6FJazvoa_fUq8vbwg&oe=6AFC7E82"}, "display_name": "Sims Life New York", "keywords": ["life", "simulation", "family", "dollhouse", "sandbox"], "long_description": "Your family. Your block. Your New York.\n\nA LIVING DOLLHOUSE\nLook down on your flat with the roof lifted off. Dan, Maya, Lily and Max each have six needs: hunger, energy, hygiene, bladder, fun and social. Leave them alone and they look after themselves. Point your laser at anyone and tell them what to do: cook dinner, take a shower, watch TV, play video games, go to bed.\n\nSTEP OUT ONTO THE STREET\nPress A and you are standing in the room at life size. Walk the flat, head down the stoop and along the sidewalk past the brownstones while the cabs roll by. Press A again to tower over the block.\n\nA NEW YORK BLOCK THAT LIVES ON ITS OWN\nBrownstones and walk-ups with fire escapes and water towers. Neighbours you can visit, kids playing in the spray of an open hydrant, Sal at his hot dog cart, Mia at the corner deli with the bodega cat, hoops on the basketball court, a park, a subway entrance rumbling under the street and the skyline on the horizon.\n\nSANDBOX MODE\nSwitch it on from the home board and do whatever you like: unlimited money, free furniture you can place anywhere on the block, needs topped up, pick morning, noon, evening or night, choose sun or rain, and start a dance party.\n\nWORK, SCHOOL, MONEY AND SKILLS\nJobs and school on weekdays, bills twice a week, pizza delivered to the door, skills, friendships and family goals. Spend what they earn on furniture and place it yourself.\n\nDAY AND NIGHT\nThe sun crosses the sky and at night every window on the block lights up.", "short_description": "A life sim built for VR on a New York block. Stand over a living dollhouse as a giant and guide a family of four through their days in a red-brick walk-up, then step out onto the sidewalk at life size. Brownstones, yellow cabs, a hot dog cart, the corner deli, a basketball court, a subway stop, the skyline - and a Sandbox Mode where everything is free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/simslifeny/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/simslifeny/", "website_url": "https://citiview-games.pages.dev/simslifeny/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
content-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA-_k-48sRL7_rsGZGwSu1tongWFv1lKCHDGMWudIv4A&oe=69B40651"}, {"file_name": "Untitled-1.png", "id": "474447511709609", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569440_474447515042942_4588377074727843287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xfbJack3gAQ7kNvwH7pV6e&_nc_oc=Adl2TqT6ImMPyA63wwHMsswNy9Qhhuqho9HdaJGqEtoLlyF2ZFyb4Ic8yBh-nICcE1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxO5WR3YV8YuNMCayXu01wGUxdnFf4_Zdkle8aKjGc3pQ&oe=69B4038E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT_Thumb_Textless_2560x1440_JDVR_ANNOUNCE.png", "id": "1133284977902193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1133284981235526_7157341157232235707_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEi_OC0v0Y4Q7kNvwE0EjtJ&_nc_oc=AdmMgQER5B143g5AZWP9OQnjZ--WB-hom08gSeEkCumhrmsPWhZ9PFRQNYY1cKMxKKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYTtEv9uKU_uPYKA8vjScRLXFsXuMN6T889JYDO-ernA&oe=69B3F50F"}, "display_name": "Just Dance VR \u2013 Welcome to Dancity", "keywords": ["dance", "multiplayer", "fitness", "music", "party"], "long_description": "Take dancing to a whole new level within an immersive world thanks to Just Dance\u00ae VR: Welcome to Dancity.  \n\nIMMERSE YOURSELF IN 360\u00b0 ICONIC UNIVERSES \n\nDiscover a new Just Dance gameplay, with an added 3D dimension and two-hand scoring thanks to VR. The music surrounds and immerses you in a way never seen before. You can compete and interact with up to 6 players. \n\n\nENJOY A TRACKLIST FOR EVERYONE\u2019S TASTES \n\nJust Dance\u00ae VR: Welcome to Dancity features 25 songs and universes, from chart-topping hits and original songs, including: \n\nDon\u2019t Stop Me Now by Queen  \n\nBad Liar by Selena Gomez \n\nLights by Ellie Goulding  \n\nCall Me Maybe by Carly Rae Jepsen  \n\nStarships by Nicki Minaj \n\nA Little Party Never Killed Nobody (All We Got) by Fergie Ft. Q-Tip, GoonRock  \n\nAnd many more!  \n\n \nDANCE, PLAY & INTERACT WITH YOUR FRIENDS & PLAYERS ONLINE \n\nHave fun with your friends and dancers around the world thanks to private or public matchmaking. \n\nDiscover the social hub, Dancity, where you can roam freely, meet up to 18 players and shine in your customizable avatar. \n\nCustomize your avatar and choose your body shape, facial expression, hair and outfit.  \n\n\nCHALLENGE YOURSELF & GET REWARDED \n\nImprove your skills and personalize your experience thanks to rewards. These collectibles range from in-game emote stickers, toys (basketball, glow stick, magic wand...), aliases and badges for your Dancer Card, to full outfits to customize your avatar. ", "short_description": "Take dancing to a new level within an immersive world with Just Dance\u00ae VR: Welcome to Dancity! Dance in 360\u00b0 universes, roam freely in Dancity & shine in your customizable avatar. You will enjoy 25 songs including Don\u2019t Stop Me Now by Queen, Bad Liar by Selena Gomez, Starships by Nicki Minaj, Call Me Maybe by Carly Rae Jepsen, A Little Party Never Killed Nobody (All We Got) by Fergie Ft. Q-tip, Goonrock, and many more.  \n\n \n\n\u00a9 2024 Ubisoft Entertainment. All Rights Reserved. Just Dance, Ubisoft"}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.ubi.com/privacypolicy/en-US", "developer_terms_of_service_url": null, "publisher_name": "Ubisoft", "support_website_url": null, "website_url": "https://www.ubisoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
ta"], "long_description": "LOS40VR is the first Virtual Reality app from LOS40, the biggest private, and music oriented, radio station in Spain and Latin America. Enjoy with the interactive experiences from your favourite artists and discover all the secrets of the recordings in the behind scenes scenario, full of extras. This is the first world ever VR containter of music related experiences from the most popular artists in the Spanish and Latin american music scene and the first VR app LOS40 developed hand by hand with Samsung.", "short_description": "LOS40VR is the first Virtual Reality app from LOS40, the biggest private, and music oriented, radio station in Spain and Latin America. Enjoy with the interactive experiences from your favourite artists."}, {"images": {"nodes": []}, "id": "251955749146069", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LOS40VR", "keywords": ["musica", "video", "40", "cuarenta", "cantante"], "long_description": "Tus artistas favoritos est\u00e1n en LOS40VR, la primera app de realidad virtual de LOS40, repleta de contenidos interactivos listos para que puedas disfrutarlos desde el sof\u00e1 de tu casa. Descubre los secretos de Dvicio, Ana Mena, Adexe & Nau y muchos m\u00e1s en LOS40VR y prep\u00e1rate para sumergirte en una experiencia \u00fanica.", "short_description": "Descubre los secretos Dvicio, Ana Mena, Adexe & Nau y muchos m\u00e1s en LOS40VR y prep\u00e1rate para sumergirte en una experiencia \u00fanica."}]}, "developer_name": "Estudiofuture", "developer_privacy_policy_url": "http://los40.com/", "developer_terms_of_service_url": "http://los40.com/", "publisher_name": "Prisa Radio", "support_website_url": null, "website_url": "http://los40.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"
135992643907563_8451330729970365931_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqNt3t2jjrMQ7kNvwEzl8oX&_nc_oc=AdohEjzpujlGWLiv7SaL25lNPumeGQB-yLhr2ul4uDbxp1P21qhGEzVjVbXGQPD0M1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkQG-TfcOpNJeHRLyfm1JtaEhJn4wvOwqdUXYm3HJa4Q&oe=6ACB9CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "3850692641904916", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_3850692645238249_5087322127492127432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNQVPzxRWeYQ7kNvwHwCvBP&_nc_oc=AdoxnZbqgNWeCGng0IcbAIceS7SPrZsyQdAfqQU5YTGsSGRJIJ4MAQYJ-6qHEPo-6Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo0Lkg4vd1BqOtuSCtIOCKwJWdvltNtu3j1LeGE39ZpA&oe=6ACBAB17"}, "display_name": "Titan Zero Cold War", "keywords": [], "long_description": "Titan Zero is a full battle mech multiplayer game that gives you the experience of being a mech pilot while playing against other mechs. Compete against 5v5 and 6v6, every mech has a vital role to play. \n\nMechs come in different sizes ranging from small, medium, large which carry unique weapon combinations. Choose from Flankers, Outriders, Assault, Direct Support to Indirect Support - which carries long-range weapons. Aesthetic and ability upgrades are also available to showcase your chosen mech. ", "short_description": "Mech acquired! Titan Zero is a multiplayer battle mech game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1LaG3VpGLWrmIeAmii_txtMpIn1K4SC9B/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Maochi Games", "support_website_url": null, "website_url": "https://www.facebook.com/maochi.isme/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "159219297431
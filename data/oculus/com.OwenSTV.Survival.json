: "SampleScene_Custom..._30.11.2025_01-00-54.png", "id": "863326916096376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_863326919429709_9130830002313389979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o3P6hS1QA8Q7kNvwGfP290&_nc_oc=Ado6cwED1Rqtg2gldxq0dJFFwnXEicNP0yZf0C6fFpwuim_BTXtKKP6HfY2NcZj2rgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmoAaye0bBxS7Mra6JddA96UsI35WH3Bwi8LiMtH8AVA&oe=6A897F92"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-01-06.png", "id": "837579118867279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_837579122200612_6615653193436602450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvQ-xzZrgmMQ7kNvwFmtyuR&_nc_oc=Ado0INx_IlbFQzGBqpqVBuFmZ07mB2Z1SIE1lamzEiouA3y02Y1TmKXpbMu0oIqsJrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH15H-kZ0NG-vC3Unux4iWOUhLxNaoZNQV-Qt31fIyZYg&oe=6A8986F0"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-59.png", "id": "1145432037719515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820428_1145432041052848_2049516853376749800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIpZ3_2hHjYQ7kNvwGRsupK&_nc_oc=AdogEUGyvfnna4L3RKGrH7kphkBuIbz88jy3ibp3_2yGODQx2qT1oUljFxQl9tAXL84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaoSqIrx5LUXyEBy4ySH0gmuyw8Jcc-27rzXHjRXm7HA&oe=6A896E11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival", "keywords": ["Survival"], "long_description": "Survival throws you into a chilly VR world where you play as a monke wandering through open snowy terrain and cold mountain paths. You can run around, explore the wide frozen areas, and mess around with whatever you find along the way. It\u2019s got that mix of goofy fun and a little bit of mystery \u2014 because every once in a while, you might hear something strange echoing across the snow.\n\nAnd yeah\u2026 those creepy wolves? They\u2019re out there somewhere. Maybe watching, maybe waiting. You never really know until they show up.\n\nIt\u2019s a simple, fast-paced VR experience built for players who just wanna explore, vibe, and test their nerves in a frosty environment. Stay warm, stay quick, and try not to get eaten.", "short_description": "Survival is a fun VR experience where you run around as monke and explore around the snowy, mountains!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivalvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lanta Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/survivalvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25811973645052804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1211237287734178_6470605020150618376_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqmQWnsjYC8Q7kNvwFBS931&_nc_oc=AdpDR3eenfZ876FZoeoUOYtq2rGnEGTSrXj9VRIumPzaiahYnOEYI5hJ0YBuEDkh1gY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiKgY-q7hl_7yh6px2WtKwGijfeofnPCfbcQPVcrd7vw&oe=6A898BD3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "G
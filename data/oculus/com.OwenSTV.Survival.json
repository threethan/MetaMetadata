r5e24nmuYLmvD4BU3UfJiBBTn-nkC6jtGOiZkWVBgZnFmqCKA0HhV2mP6U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_YI3qafiBCbi3PrPJuVgz5X6XbTkmVRsDG0PrfuDlsA&oe=69AAB212"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-01-06.png", "id": "837579118867279", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823746_837579122200612_6615653193436602450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi_FNUF0wmkQ7kNvwEjrvaR&_nc_oc=Adl6Cq2WVaBzOLn2NknbDv6o2Hqy-jbuWVi1txNCCm1DqFCpFnuKTTK0roC3BRP8kTU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzX7q1-7gyO_-jMDGiU-gN6FGTENYcKAKHPCnG61AVQQ&oe=69AAB970"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-59.png", "id": "1145432037719515", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491820428_1145432041052848_2049516853376749800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcTnFuZy_rwQ7kNvwGl0puT&_nc_oc=AdkR877T4HyiyDkkMz1HUfFo5_hBhsxMbGmo5DKIfCxz4NASOaFmiKtQ4iCOdlyRL48&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWhUxjMF9YX2XO3YzI3R_LSjAF1oGP1AOGMRxAygaGoA&oe=69AAD8D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival", "keywords": ["Survival"], "long_description": "Survival throws you into a chilly VR world where you play as a monke wandering through open snowy terrain and cold mountain paths. You can run around, explore the wide frozen areas, and mess around with whatever you find along the way. It\u2019s got that mix of goofy fun and a little bit of mystery \u2014 because every once in a while, you might hear something strange echoing across the snow.\n\nAnd yeah\u2026 those creepy wolves? They\u2019re out there somewhere. Maybe watching, maybe waiting. You never really know until they show up.\n\nIt\u2019s a simple, fast-paced VR experience built for players who just wanna explore, vibe, and test their nerves in a frosty environment. Stay warm, stay quick, and try not to get eaten.", "short_description": "Survival is a fun VR experience where you run around as monke and explore around the snowy, mountains!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivalvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lanta Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/survivalvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25811973645052804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819281_1211237287734178_6470605020150618376_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfJUmSCpK5wQ7kNvwHP_i20&_nc_oc=AdksmR7rO0UnRDRdJIIJ2VeVFazuB1f0z4mp7iVLl3jPs7TzBrDcyLt4sXwCDqXsz7k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxnq5tvdIM1VQp29sheULnIe2XmUQZfJDQ9AN8_nBUODw&oe=69AABE53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1764875100, "lastRevision": {"nodes": [{"id": "25789506113966224", "release_type": "SCHEDULED", "administration
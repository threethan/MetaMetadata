png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZBK3Aeyby4Q7kNvwHFsvEw&_nc_oc=Adqe8-Tz6fY2j_Ga4-vaU5RPtf4AWCWEC4p_-nAOiKBGiaV3XEHaI89373Y9fm3Ufvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14sTvtH88WUHhA6-BErztjet3cDJFZlEwwPhtYiiUWOg&oe=69F0C9D2"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-01-06.png", "id": "837579118867279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_837579122200612_6615653193436602450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDKvHuzmbwkQ7kNvwH63Jsq&_nc_oc=AdqAIvDH58z9c05Muh5wRLAlungFeS7yJQ03KdJ2IcPqXFXfA_smsT_Z4yGA4t4v-EU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ZBsRrkBzCvrh9wqPrzmCMWZ0d8UOUS-xlcgmHmqLmjQ&oe=69F0D130"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-59.png", "id": "1145432037719515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_1145432041052848_2049516853376749800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUPuQtOvCygQ7kNvwGEBsxd&_nc_oc=AdrCWhpjdnzbCVgH-h1DnPbc7Fizb6nj_X-DWKhqHIRPrsXvXVZVF3Pk5zu8cRad2Uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3K9hgkaRzcRHPaN5wMe0-WZqXvQ-h3ER6MlwKPZtE37Q&oe=69F0B851"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival", "keywords": ["Survival"], "long_description": "Survival throws you into a chilly VR world where you play as a monke wandering through open snowy terrain and cold mountain paths. You can run around, explore the wide frozen areas, and mess around with whatever you find along the way. It\u2019s got that mix of goofy fun and a little bit of mystery \u2014 because every once in a while, you might hear something strange echoing across the snow.\n\nAnd yeah\u2026 those creepy wolves? They\u2019re out there somewhere. Maybe watching, maybe waiting. You never really know until they show up.\n\nIt\u2019s a simple, fast-paced VR experience built for players who just wanna explore, vibe, and test their nerves in a frosty environment. Stay warm, stay quick, and try not to get eaten.", "short_description": "Survival is a fun VR experience where you run around as monke and explore around the snowy, mountains!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivalvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lanta Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/survivalvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25811973645052804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1205986661432530"}]}, "baseline_offer": {"id": "1205986661432530"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764875100, "status": "PUBLISHED", "id": "1205986661432530"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25811780428405459", "version": "0.7"}, "id": "4049548262041517", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25789506077299561", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25811780428405459"}, "release_status": "RELEASED"}, "bi
axN9&_nc_oc=AdlhrIuMZwAXex4zMYoBhDCGjG4Y-GpsinbpMg6qykjmobI4a72EQeKWAe8iV-JNrO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz68YHtZDny5veSXF0d5HTD2bh780R1n5Pxvqs2HNbU2g&oe=69BFD653"}, {"file_name": "SampleScene_Custom..._30.11.2025_00-44-43.png", "id": "1164558845824163", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1164558849157496_6214712726513066796_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3u8bRD8CtwQ7kNvwFGgPdJ&_nc_oc=AdmKlWDNM-WN5cYV0o8EEE8ZMvxdzti2aLp6W2kGLGjTtJn1pvnd_porZ2qMNIawB7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFM4aT64x7AWxCrGTp5n7bmGvWw2Bkvo5RnyNmTsixQA&oe=69C001AF"}]}, "id": "25412266768411698", "locale": "en_US", "screenshots": [{"file_name": "SampleScene_Custom..._30.11.2025_01-01-13.png", "id": "2852691874941958", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_2852691881608624_5122229978883383897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnlMetLUorAQ7kNvwHysxk9&_nc_oc=AdmGOi10aA7yLnUVSwRKmNL_z4asdaS-hO6YAYJrNo6-vuCfBykoYCVvwhEaHZCUNiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysQM854lk9tPwNWenpOZONLAjCYTn6TYbzhRbbCm3FZQ&oe=69BFFAD6"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-46.png", "id": "1533894184400688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1533894187734021_8069440879223946390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273p6vjcDIgQ7kNvwHi7KP9&_nc_oc=Adkmi0PaVzmyIHNNXVmeejAsRKw0emFRXjjBsDRnyamz4Cje8JgwFcdwKm3suVKwqIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbk435yRb9ZNrRBkswSIFfzYixDy-ff7E34CgdV2qriQ&oe=69BFD4ED"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-54.png", "id": "863326916096376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_863326919429709_9130830002313389979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZQp7HoHo_YQ7kNvwFo-VmY&_nc_oc=AdnowAHIJGr8qqBVlU-atlYuj7byhkRvVyb6dseWFqktXnlglnVlRtDpCd6SwGQDKhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxP2XHQ1sq8tKNKJP9uojAxElDAsA8Mh21izC30TmlyHA&oe=69BFCA12"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-01-06.png", "id": "837579118867279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_837579122200612_6615653193436602450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8D4MMRsU1UQ7kNvwG1XKwG&_nc_oc=Adkkr07lS0tc264ojWpuBojMfMEzr1DFo-EkwZ0Nyt9UZf4P0SfcJnqVyoCg-TMgMGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfydkRj-MaAW73phTUGuEP-15uxCZCTZCwMZ3HLvgb4_OQ&oe=69BFD170"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-59.png", "id": "1145432037719515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_1145432041052848_2049516853376749800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaNZbf2TnhcQ7kNvwHk7xPa&_nc_oc=AdnDud6PW3QkZxVXrPDnXT7gj8dQXussguodkOcei4n8gb_UUPdNspRoBAAGnbI_6lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7LUtYzmC5ciuNYR3unSFkIpx1XeGSFSzDc9yBeXVaMw&oe=69BFF0D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival", "keywords": ["Survival"], "long_description": "Survival throws you into a chilly VR world where you play as a monke wandering through open snowy terrain and cold mountain paths. You can run around, explore the wide frozen areas, and mess around with whatever you find along the way. It\u2019s got that mix of goofy fun and a little bit of mystery \u2014 because every once in a while, you might hear something strange echoing across the snow.\n\nAnd yeah\u2026 those creepy wolves? They\u2019re out there somewhere. Maybe watching, maybe waiting. You never really know until they show up.\n\nIt\u2019s a simple, fast-paced VR experience built for players who just wanna explore, vibe, and test their nerves in a frosty environment. Stay warm, stay quick, and try not to get eaten.", "short_description": "Survival is a fun VR experience where you run around as monke and explore around the snowy, mountains!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivalvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lanta Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/survivalvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25811973645052804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1211237287734178_6470605020150618376_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXsfbOY3b_QQ7kNvwFRaxN9&_nc_oc=AdlhrIuMZwAXex4zMYoBhDCGjG4Y-GpsinbpMg6qykjmobI4a72EQeKWAe8iV-JNrO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOISxvkRwZoMHxLYDkuhvSu00WIGxYQXNfLwwcL1Wzpg&oe=69BFD653"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1764875100, "lastRevision": {"nodes": [{"id": "25789506113966224", "release_type": "SCHEDULED", "administration_status"
: "SampleScene_Custom..._30.11.2025_01-00-54.png", "id": "863326916096376", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_863326919429709_9130830002313389979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o3P6hS1QA8Q7kNvwHEUeeE&_nc_oc=Adrq9UDqn1Ck57XGHilzRPPqJgn4hypmhz-8ptUBSQNXFkzV1Fo6ag66kfByPh1zi50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVmsSz7PZtWr1Klh7zz-zFycQCMm-Ff_ux-Gdj9znTxg&oe=6A86DC92"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-01-06.png", "id": "837579118867279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_837579122200612_6615653193436602450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kacVCdpGqwQ7kNvwHTq-SD&_nc_oc=AdrUes0zcLWTp-CV477S68W9OL2GpInbZlXUh9erIO0qhL-8awc8Ssr0Esq1RLGkNgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu49lH8Qq2FYb2vuQ-kCenLmIMYwkCOpD-B2xh1mdnlA&oe=6A86E3F0"}, {"file_name": "SampleScene_Custom..._30.11.2025_01-00-59.png", "id": "1145432037719515", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820428_1145432041052848_2049516853376749800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XYlZNWIRqgQ7kNvwFQSC5I&_nc_oc=AdrnyrEI87jWZ2L1v-tFp9YKL8oVdFmpXWHGw06tP3cu9y17pIm1cGS0noeyivX7BrE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8EfNK5uOCPraPIgA2ihTCJVRtby0th9k4w07C_f2Taw&oe=6A870351"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival", "keywords": ["Survival"], "long_description": "Survival throws you into a chilly VR world where you play as a monke wandering through open snowy terrain and cold mountain paths. You can run around, explore the wide frozen areas, and mess around with whatever you find along the way. It\u2019s got that mix of goofy fun and a little bit of mystery \u2014 because every once in a while, you might hear something strange echoing across the snow.\n\nAnd yeah\u2026 those creepy wolves? They\u2019re out there somewhere. Maybe watching, maybe waiting. You never really know until they show up.\n\nIt\u2019s a simple, fast-paced VR experience built for players who just wanna explore, vibe, and test their nerves in a frosty environment. Stay warm, stay quick, and try not to get eaten.", "short_description": "Survival is a fun VR experience where you run around as monke and explore around the snowy, mountains!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivalvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lanta Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/survivalvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25811973645052804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819281_1211237287734178_6470605020150618376_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8p_7dFj7DgQ7kNvwE9PAk4&_nc_oc=AdpLVK8SMS37HU7etKQJliynJhd5Mo46txVukA7vH6JsupNfQnB5aXvaIOnOWh4Sj2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkBrCH3y38VxGnO7K60ndSU49jlimNnMH7VeSCONZdLw&oe=6A86E8D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "G
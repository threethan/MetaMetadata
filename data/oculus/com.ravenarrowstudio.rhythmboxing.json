 "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623115_1113829807976492_3888184027714765216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuUrDIjwnXcQ7kNvwHhDZVH&_nc_oc=AdpgtCNIibHO_LMKx9PQ-TE0quE_zuXx1qmroks2yZUUMtKWMkkwmzVgrT9MFM8Cek4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_Aqjje1dHf79ria9D447Rn4nW6KIj3IsDCJTvMQHaSg&oe=6AAAB0AC"}, {"file_name": "leadhook_final.png", "id": "1094484556589361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1094484559922694_6525185511220638412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNpWvzVYW6AQ7kNvwEI5RX5&_nc_oc=AdrzT5e7eVe2igaIMt8xgc0beILXZ_oiBZLVdGju7Sl5H5WpPUBtKOjJQ1vDE-7MLtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYW3yOGkyFooMWQyz-YzbiiZSJHInaUeZZW4SVQrkWrw&oe=6AAA9B2C"}, {"file_name": "uppercut-final.png", "id": "3554810104668903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295992_3554810108002236_1158757554572052337_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6srIJkgenB4Q7kNvwESdYAG&_nc_oc=Adrh-Y7OsR-zH0ZkqNiuK_pewXVVZxaYsx0qtPYpJY-OJA8VEF21qj9iTowbfAA1xYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsUII5At7F5D-fLfI40afp28IeBsiilkHLJGyWoNx13A&oe=6AAA8FF9"}, {"file_name": "training-UI.png", "id": "1532787778084531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623295_1532787781417864_7666690173298947485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb6LDYh72BIQ7kNvwEALhQ0&_nc_oc=AdrYYh25mLTJ6x6IWyR8LE2IW2kXXHLUcBN-Vo4w0o_iqcJ7HkCeqTuEK_2doNW1_Uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITTGwgFgLniGSbsWU0NpeG5sY-iX_RmAf4NDgfNuKRiQ&oe=6AAA9EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "1436508361728560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295279_1436508365061893_515455906662838977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPcOeBsHfdIQ7kNvwFfWl9A&_nc_oc=AdpxuzeRqFu1AQPedlSgfDdQxIccX1ZNTfAO90j2Q5eIz93yijpWfZ6QtPiqLr6fK5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhPOl-xtmIG_C1MND4DSg1m5s9-lcn4DH7qV587ug1Dg&oe=6AAA957F"}, "display_name": "Rhythm Boxing: Padwork", "keywords": ["boxing", "sports", "fitness", "combos"], "long_description": "Step into the ring. Find your rhythm.\n\nRhythm Boxing: Padwork is an immersive VR boxing trainer that puts you face-to-face with iconic fighting styles. No opponents. No damage bars. Just you, the pads, and the art of combination punching.\n\nTrain Your Way\n\nHand Tracking \u2014 Ditch the controllers. Train with just your hands for a natural, comfortable workout, or level up with weighted boxing dumbbells for added resistance.\n\nPassthrough Mode \u2014 Keep your real surroundings visible at all times. Train with confidence and avoid collisions while throwing combos.\n\nMovement Mode \u2014 Short on space? Disable physical movement and train from a fixed position \u2014 perfect for small rooms or seated play.\n\nTrain Like a Champion\n\nThree complete 12-round workouts, each built around a legendary fighter's signature style.\n\nSpeed Demon \u2014 Lightning-fast combos that test your reflexes.\n\nIron Fist \u2014 Devastating power punches demanding proper weight transfer and hip rotation.\n\nRelentless Force \u2014 Non-stop pressure fighting with aggressive forward movement.\n\nRhythm-Based Padwork\n\nEvery combo follows a distinct rhythm. Land your punches on beat to unlock higher scores and longer combos. Miss the beat? The pads reset. You start again.\n\nWhat You'll Get\n\nMultiple style modules \u2014 each with 20+ signature drills\n\nFull-body workout \u2014 engage your core, shoulders, and legs\n\nEndless replayability \u2014 Repeat. Refine. Become instinct.\n\nNo experience needed. No gym required. Just put on your headset and find your rhythm.", "short_description": "Feel the rhythm of iconic boxing styles \u2014 speed, power, pressure, and beyond. Train with virtual pads in VR and master the art of combination punching."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ravenarrow.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "RavenArrow Studio", "support_website_url": null, "website_url": "https://ravenarrow.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1286847367847240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_4467727646819589_8295293927101311172_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GgJlZFj7OAQ7kNvwG2lwql&_nc_oc=AdqlRcCcsxOij340V5nLoh4lgn25cbx9a5vOt0TKS2DbHyq2olv16TQYw6DSR5NCbJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITPUfnksDzZPuvqPjfV3F6DEN_OXXXYGoq_P_awZiAfw&oe=6AAA8ECD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Boxing: Padwork", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1787410800, "lastRevision": {"nodes": [{"id": "1246744741857503", "release_type": "SCHEDULED", "administration_status": "APPROVED", 
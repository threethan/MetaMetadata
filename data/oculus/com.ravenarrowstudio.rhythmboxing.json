ilkHLJGyWoNx13A&oe=6AAA8FF9"}, {"file_name": "training-UI.png", "id": "1532787778084531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623295_1532787781417864_7666690173298947485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb6LDYh72BIQ7kNvwEALhQ0&_nc_oc=AdrYYh25mLTJ6x6IWyR8LE2IW2kXXHLUcBN-Vo4w0o_iqcJ7HkCeqTuEK_2doNW1_Uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITTGwgFgLniGSbsWU0NpeG5sY-iX_RmAf4NDgfNuKRiQ&oe=6AAA9EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "1436508361728560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295279_1436508365061893_515455906662838977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPcOeBsHfdIQ7kNvwFfWl9A&_nc_oc=AdpxuzeRqFu1AQPedlSgfDdQxIccX1ZNTfAO90j2Q5eIz93yijpWfZ6QtPiqLr6fK5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhPOl-xtmIG_C1MND4DSg1m5s9-lcn4DH7qV587ug1Dg&oe=6AAA957F"}, "display_name": "Rhythm Boxing: Padwork", "keywords": ["boxing", "sports", "fitness", "combos"], "long_description": "Step into the ring. Find your rhythm.\n\nRhythm Boxing: Padwork is an immersive VR boxing trainer that puts you face-to-face with iconic fighting styles. No opponents. No damage bars. Just you, the pads, and the art of combination punching.\n\nTrain Your Way\n\nHand Tracking \u2014 Ditch the controllers. Train with just your hands for a natural, comfortable workout, or level up with weighted boxing dumbbells for added resistance.\n\nPassthrough Mode \u2014 Keep your real surroundings visible at all times. Train with confidence and avoid collisions while throwing combos.\n\nMovement Mode \u2014 Short on space? Disable physical movement and train from a fixed position \u2014 perfect for small rooms or seated play.\n\nTrain Like a Champion\n\nThree complete 12-round workouts, each built around a legendary fighter's signature style.\n\nSpeed Demon \u2014 Lightning-fast combos that test your reflexes.\n\nIron Fist \u2014 Devastating power punches demanding proper weight transfer and hip rotation.\n\nRelentless Force \u2014 Non-stop pressure fighting with aggressive forward movement.\n\nRhythm-Based Padwork\n\nEvery combo follows a distinct rhythm. Land your punches on beat to unlock higher scores and longer combos. Miss the beat? The pads reset. You start again.\n\nWhat You'll Get\n\nMultiple style modules \u2014 each with 20+ signature drills\n\nFull-body workout \u2014 engage your core, shoulders, and legs\n\nEndless replayability \u2014 Repeat. Refine. Become instinct.\n\nNo experience needed. No gym required. Just put on your headset and find your rhythm.", "short_description": "Feel the rhythm of iconic boxing styles \u2014 speed, power, pressure, and beyond. Train with virtual pads in VR and master the art of combination punching."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ravenarrowstudio.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "RavenArrow Studio", "support_website_url": null, "website_url": "https://ravenarrowstudio.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1274334119098565"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "889594100601540"}]}, "baseline_offer": {"id": "889594100601540"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787410800, "status": "PUBLISHED", "id": "889594100601540"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1286836077848369", "version": "1.1"}, "id": "1748711922923767", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1246744721857505", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1286836077848369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1748711922923767"}]}, "change_log": "V1.1 Update Notes\\nPunch Registration Fix \u2013 Fixed an occasional issue where punches would fail to trigger during training. Hit detection is now more consistent.\\nPost-Workout Results \u2013 Added a results summary screen at the end of each session, showing punch accuracy and reaction speed to help track your progress.\\nGuidance Skip Option \u2013 Added a toggle to remove the slow learning phase during the initial repetitions of each combo, allowing for a faster practice flow.\\nInterval Time Setting \u2013 Added a new control that adjusts the interval time between each punch in a combo. A lower percentage means shorter intervals and a faster pace.", "created_date": 1787946213, "id": "1286836077848369", "version": "1.1", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1246744721857505", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1286836077848369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1748711922923767"}]}, "change_log": "Welcome to Rhythm Boxing: Padwork!\\n\\nWe are thrilled to launch the first version of Rhythm Boxing: Padwork. Step into the ring and experience the art of combination punching like never before.\\n\\nGame Highlights\\n\\nPassthrough Mode \u2014 Keep your surroundings visible at all times. Train with confidence, knowing you can see your real space and avoid collisions while throwing combinations.\\nMovement Mode \u2014 No room to move? No problem. Disable physical movement and train from a stationary position, perfect for small spaces or seated play.\\nTrain Like a Champion \u2014 Step into three full 12-round workouts, each built around the signature style of a boxing legend. Study their rhythm, master their combinations, and train like the greats.\\n\\nWe value your feedback! Put on your headset, find your rhythm, and let us know what you think.", "created_date": 1787166189, "id": "1272570882608222", "version": "1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1246744721857505", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1286836077848369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1748711922923767"}]}, "change_log": "Welcome to Rhythm Boxing: Padwork!\\n\\nWe are thrilled to launch the first version of Rhythm Boxing: Padwork. Step into the ring and experience the art of combination punching like never before.\\n\\nGame Highlights\\n\\nPassthrough Mode \u2014 Keep your surroundings visible at all times. Train with confidence, knowing you can see your real space and avoid collisions while throwing combinations.\\nMovement Mode \u2014 No room to move? No problem. Disable physical movement and train from a stationary position, perfect for small spaces or seated play.\\nTrain Like a Champion \u2014 Step into three full 12-round workouts, each built around the signature style of a boxing legend. Study their rhythm, master their combinations, and train like the greats.\\n\\nWe value your feedback! Put on your headset, find your rhythm, and let us know what you think.", "created_date": 1787162871, "id": "1272386202626690", "version": "1.0", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
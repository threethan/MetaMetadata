 "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623115_1113829807976492_3888184027714765216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8qGpqLe5GIQ7kNvwGkOA3q&_nc_oc=Adr5UvBXw96w2By41JDIsXhviEgCyFZlLM90iJAmaVYd7pdIwriyruAleQQ_z-RxQBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWBKWbNv3MqpnxYEw8ygrhX7tK57Ca7NqMXuGeqSvN9w&oe=6ABA82AC"}, {"file_name": "leadhook_final.png", "id": "1094484556589361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_1094484559922694_6525185511220638412_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVsCXRv1SMYQ7kNvwGQnN1d&_nc_oc=AdqKOt9KR0UQzLrHTyUflHazXF_4Fjn0OrOUeaUVuLYX78YMOOa5Ej-WwdUHCdoTlkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8tJJgn7k8CxEnLsU6FdIlTKfTV2YZn_giWmzuAuHd1w&oe=6ABA6D2C"}, {"file_name": "uppercut-final.png", "id": "3554810104668903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295992_3554810108002236_1158757554572052337_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAulHksE1A4Q7kNvwHWNOn9&_nc_oc=AdpWlwj8Hy1wUh0dBJPojnGlFlnxx9WGmwEwJwfgTJ4wSO-cLEhLW7Be_auFzhITyn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPG819Cn_n4huIU5adM3yeENtT2EzAo3spBEdy50KDdw&oe=6ABA61F9"}, {"file_name": "training-UI.png", "id": "1532787778084531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1532787781417864_7666690173298947485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGN2ESq_xMQQ7kNvwH1soKD&_nc_oc=AdqHoe_ktG3uzKsRiYAQ6TA26zxfm_CEJuTj_voH6vg0YrDDlUYlOOntHDSFqK6P5GE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ101TjbPIu17UXqIl-exvJqDWaYHelpalXMEB3Z94AOA&oe=6ABA70E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "1436508361728560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295279_1436508365061893_515455906662838977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kquDWXJpKvQQ7kNvwF57D2k&_nc_oc=AdoZuKHMIE-Z4ftjZ9rx4pRp7PkW7NnjMStq6LlS8VYcMAv0Rw0BS7OYSCwRGSVKIHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ7a2lh_0yBcpnw6QaNkhqaYM2-fNuEUL5QkOVM46B0g&oe=6ABA677F"}, "display_name": "Rhythm Boxing: Padwork", "keywords": ["boxing", "sports", "fitness", "combos"], "long_description": "\n# Rhythm Boxing: Padwork\n\n> Step into the ring. Find your rhythm.\n\nAn immersive VR boxing trainer built around iconic fighting styles. No opponents, no damage bars \u2014 just you, the pads, and combination punching.\n\n## **Train Your Way**\n\n- **Hand Tracking** \u2014 Train bare-handed, or add weighted dumbbells for resistance.\n- **Passthrough Mode** \u2014 See your real room at all times. Train safe, no collisions.\n- **Movement Mode** \u2014 Lock your position. Perfect for small rooms or seated play.\n\n## **Train Like a Champion**\n\nThree 12-round workouts, each built on a legend's signature style.\n\n- **Speed Demon** \u2014 Lightning combos that test your reflexes.\n- **Iron Fist** \u2014 Power punches demanding weight transfer and hip rotation.\n- **Relentless Force** \u2014 Non-stop pressure fighting with forward movement.\n\n## **Custom Workouts**\n\nRounds, combo sets, and every punch \u2014 all yours to choose. Your training, your rules.\n\n## **Rhythm-Based Padwork**\n\nHit on the beat for higher scores and longer combos. Miss it, the pads reset.\n\n## **Track Your Progress**\n\nReview punch accuracy and reaction speed after every session.\n\n## **What You'll Get**\n\n- A full set of signature drills in every style module\n- Full-body workout \u2014 core, shoulders, and legs\n- Endless replayability \u2014 repeat, refine, become instinct\n\nNo experience needed. No gym required. Just put on your headset and find your rhythm.\n", "short_description": "Feel the rhythm of iconic boxing styles \u2014 speed, power, pressure, and beyond. Train with virtual pads in VR, master the art of combination punching, and build your own custom workouts round by round."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ravenarrow.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "RavenArrow Studio", "support_website_url": null, "website_url": "https://ravenarrow.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1315633178301992"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620532_4467727646819589_8295293927101311172_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2FNx0vzaGIQ7kNvwE7V7jQ&_nc_oc=AdoiciI3uBV7eSkY4jpLVo_CDBbLh3SPc13cOiv0m3ycok1vncacyJFLYsF9qMil43U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxICBS56KYCL9HPR39uHhbyEF8VTkR-azhZIiJJldCpQ&oe=6ABA60CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Boxing: Padwork", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1787410800, "lastRevision": {"nodes": [{"id": "1246744741857503", "release_type": "SCHEDULED", "administration
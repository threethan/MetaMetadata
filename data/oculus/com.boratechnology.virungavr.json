0JvsEQ7kNvwHeeCiC&_nc_oc=AdotzhjrPqk9-pmsQwdqBW_EaEJ-rRYgPWMZNbgEDrpMZ6sbkeV_a3R00kn1vCAintg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFtyVypeImMT3mHpijLVg7i9t3W2_0GOantmtL3y2qRg&oe=6ABFD484"}, {"file_name": "01_gorilla_encounter.png", "id": "1795718951783077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292329_1795718955116410_5128132509123249539_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpib4uVjc6oQ7kNvwHc0YP1&_nc_oc=AdoPwZ_tQNBwlA9_oVw1CNSkO97-rLvqkfiS3WuBAJ4jAMWgvPtSD4qTvXMIrif1E2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUyTAzRT_eAZ9wPzyakd1InsziKqyoTH76kEJ3VEjMIg&oe=6ABFD318"}, {"file_name": "05_crater_shore.png", "id": "1620252923001764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297170_1620252926335097_3505977575638968359_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tE9aO1_M3IQ7kNvwFewHvY&_nc_oc=AdqwOh1AEOphGR5eSdKUty-5RjWSlh4U6T9KhcEI2us6SntM4HBnNWoQzhiXxOhsjic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYK3cNgwf056pwpBJukJtbhVENq4jdrNjygE1pwemQzA&oe=6ABFDA77"}, {"file_name": "03_forest_trail.png", "id": "1758095115341228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312231_1758095118674561_6897883256515585024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrsYolG--nkQ7kNvwGHnQnX&_nc_oc=Adp9BYSIfVFDnXgTHbH5E5XIZgdbUaRIfue6Mb6uVBSIJHjV9OA5RswsxCP2B4kwGvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7PdegR1EVj95p8MTgY8sCdeRiTc8LMNlB0FuywLPXlw&oe=6ABFCC26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virunga VR", "keywords": ["Virunga", "Documentary", "Gorillas", "Exploration", "Nature"], "long_description": "Step into the heart of eastern DR Congo with Virunga VR, a peaceful, narrative-driven exploration of the Habinyanja\u2013Bukima sector of Virunga National Park. Designed for mindful discovery, the experience features no combat, fail states, or scores, allowing you to absorb the breathtaking natural beauty and wildlife of a real-world sanctuary at your own pace.\n\nBeginning inside a rustic ranger cabin, choose your path from three distinct, fully voice-guided activities in English and French:\n\nGorilla Trekking: Embark on a guided 7.5-minute trek to encounter a habituated mountain gorilla family up close.\n\nCrater Lake Hike: Climb to a dramatic crater rim and descend to the shoreline on a 5-minute scenic excursion.\n\nShoot for the Park: Take on a self-paced 10-minute wildlife photography assignment, capturing four target subjects for the park's permanent archives.\n\nComplete with intuitive locomotion, comfort-focused options, and authentic narration, Virunga VR brings one of Africa's most iconic conservation landscapes directly into your headset.", "short_description": "Step into the heart of eastern DR Congo with Virunga VR, a guided, narrative immersive experience. Explore the Habinyanja\u2013Bukima sector of Virunga National Park through three unique activities: trek with a habituated gorilla family, hike to a scenic crater lake, and photograph wildlife for the park's records. Featuring full voice guidance in English and French, peaceful exploration, and a comfortable, self-paced journey through a breathtaking real-world sanctuary."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boratechnology.org/privacy", "developer_terms_of_service_url": "https://boratechnology.org/terms", "publisher_name": "Bora Technology", "support_website_url": "https://boratechnology.org/virunga-vr", "website_url": "https://boratechnology.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
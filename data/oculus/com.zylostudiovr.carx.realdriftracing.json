ng?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIh5jMABO9IQ7kNvwFuWWGu&_nc_oc=AdrdWFiKBk4q_9VIV6_t-NDj-BAR44D2sOTrQNf3lQeFt_waX84CJPdgr-1X4vVY2gQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrGK0QZjYeYkRAkic1sHXuiCrBCpSpHbkoaFaLlelAvg&oe=6ACE5EE0"}, {"file_name": "1.png", "id": "1313988817026593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_1313988820359926_5700102725865024141_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COEwh8xozpMQ7kNvwH1FN76&_nc_oc=AdoMLmwMiw8pV1iGuveLEelLY_CX5-3O15fWdZvETIZMA2nrryQ6-rhje0V-iiLBBiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQM7O0G6ePAY4LtMH2cIiHmOWANdl0pP2jcv8NASzNAA&oe=6ACE478E"}, {"file_name": "2.png", "id": "1702661617612913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_1702661627612912_327440395859162614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11sOkmXztYgQ7kNvwE4Wr9_&_nc_oc=Adp-dVsapGZHPsco1V6-W4nqOFn3iTMxEobtIm-Ga9buxld_3HPPt1bDa86__Q4suM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGPPFI4cE0TDUb3bEShP36Wi3rhRwvf1dwtVJjb_mzWQ&oe=6ACE4B54"}, {"file_name": "4.png", "id": "26893703396998897", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_26893703430332227_4126540956910869619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STDV0rmM564Q7kNvwER7PKD&_nc_oc=AdprmRiRIKnz4WDdyDtx6N4ZayzMXpjRrUVyI4RkSFYB3PZOAd9XP6qcvMhAwweCIFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Aen2Ea34m1vzwxedsT-KBDuJImVuJtrYff4TjHnfNw&oe=6ACE4B0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CarX Real Drift Racing", "keywords": ["Driftracing", "CarDrifting", "RacingGame", "DriftCarGame", "DrivingSimulator"], "long_description": "CarX Real Drift Racing \ud83d\ude97\ud83d\udca8 delivers an ultimate drifting and racing experience for players who love speed, control, and realism. Step into a world of powerful drift cars, challenging tracks \ud83c\udfc1, and competitive racing modes designed to test your driving skills.\n\nEnjoy realistic car drifting physics where every turn, slide, and burnout feels authentic \ud83d\udd25. Master precision control as you compete in high-speed drift racing challenges and become the champion of the streets \ud83c\udf03. Whether you are a beginner or a pro, the game offers a smooth learning curve with advanced driving simulator mechanics \ud83c\udfae.\n\nExplore different environments, upgrade your cars, and refine your drifting technique to dominate every race \ud83c\udfc6. From tight corner drifts to long highway slides, every moment is built for excitement and skill-based gameplay.\n\nCarX Real Drift Racing is not just a car racing game \u2014 it\u2019s a full drift experience combining racing game intensity with true driving simulation \ud83d\ude97\u2699\ufe0f.\n\nGet ready to burn tires, control powerful machines, and rise as a drift legend in the ultimate racing world \ud83d\udca5.", "short_description": "CarX Real Drift Racing \ud83d\ude97\ud83d\udca8 is a high-speed driving simulator built for drift lovers. Experience realistic car drifting, intense drift racing battles, and smooth driving physics in detailed environments \ud83c\udf06. Master control, burn tires \ud83d\udd25, and become the ultimate drift king \ud83d\udc51 in this action-packed racing game. Perfect for fans of drift car game, car racing, and driving simulator experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "67338
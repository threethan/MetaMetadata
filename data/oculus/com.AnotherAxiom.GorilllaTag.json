5771-25/473391841_661760079870407_8365176869094103421_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qeqf4sgq6PwQ7kNvwFgxZ5O&_nc_oc=AdqLMzearY5UFwyC1e0iBWt7XKjFfOmn_kpIAwpoIjPDYlEXERR7Y1t9R4wovK-_If4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROml_tC2Dfjd40_cPfrI8rBRP9bAwDPazBpeBALWDLnQ&oe=6B084B3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Christmas Taggering", "keywords": [], "long_description": "\"Christmas Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Christmas Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Christmas Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": "VIPER", "developer_privacy_policy_url": "https://sites.google.com/view/christmas-tag-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VIPER", "support_website_url": null, "website_url": "https://sites.google.com/view/christmas-tag-home/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
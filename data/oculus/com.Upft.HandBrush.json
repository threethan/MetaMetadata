305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmshuqcSTHUQ7kNvwGrQTGU&_nc_oc=AdkNltSRlSQ_TD1lW-8i3Q23wkPpcgJNbGhGTTKYRwqJRWJTR9tjclZtPOATGVkNuT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuo-H5weLfbyB1lGQrkl2xUXz6Ic6x0AOXMGEkVMaf_gw&oe=699C31AB"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLAt5QaY7Y8Q7kNvwGyrDYP&_nc_oc=Admy1djCbWKTnSS0NcZNO_Ng2k-bcCA9u86j_pe9Kvd4jwMZ1FzzTScfKI1E-FXHFR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsHzhD9LFyeokOnCivwNEi81d6oH7Omy3AfCf7dDPtRew&oe=699C31AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11qxBVhLUE8Q7kNvwEz79AD&_nc_oc=Adk0k_AwojbEZsUMZ6ux4zrxcWILUGcu9c9mPw9gNSS14tS6qswQIElOj8XIBfCX8_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4K4qJZT0y-kDSNKeHG3nrvQtmnfVgTHIrAnig8H9Hmw&oe=699C311D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
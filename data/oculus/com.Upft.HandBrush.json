305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULI8qn0GZCMQ7kNvwEDPAdW&_nc_oc=AdmmciY1bU0UuvsrF7wVKkadGjQHhoa13cV2qz2gVZcFA8SODTm1ZwtT2AkG_JHILZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscbxzShOtdTEyu-vWA6OsqC0KiG4LNcq_hjDQdU_K3fA&oe=699D832B"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLAt5QaY7Y8Q7kNvwHdc8to&_nc_oc=AdkcEWTMq02Y1VGrwbFJT4h6t6SFDD_Jd9ejKgQPP_k0suhkSthaTLCC5nQNsxtNwCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsH2wQI5XHe31SB_D73My2KWqvs8q-b_tWtcx3XQfPPmQ&oe=699D832D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXFOGX_wjvUQ7kNvwEaR80O&_nc_oc=AdkV-YJJd5zieSdRJ67NIRTPvWEB0WZn3Qqen4655GjuSxAK0DRei5LhfBbaqQaU31I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKJP5B_5v5xCgLcIEGysVgAlUTQaFhaOYHdhM-37rCEw&oe=699D829D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
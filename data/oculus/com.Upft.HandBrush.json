cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ9ltvpwutAQ7kNvwFcJUse&_nc_oc=AdoZLKmS6ib4eog-9p-_5Dg47XmhPhyqSJ7AtemglG6_wqWK4P3ckT6nQ4_u0QHxYGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSx7ACjjaMwAdEooBv0rB6HmyhhBp_lTCQPWdy6SJ_4Cg&oe=6B0C74AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFWOPuFex8MQ7kNvwGpZAsC&_nc_oc=AdpD6QMu4q0vXgE7OrSyfkHvEIUz2m_Ks-sOCtJJzDLSE87SSgOrZ3G5hFZBlyVqslA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjw5vyBEW7hPZ64lNSVmRgkmQ3zS_N5IkTiQpFA48Lsw&oe=6B0C741D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://up-frontier.jp/company/privacy", "developer_terms_of_service_url": null, "publisher_name": "Up-frontier, Inc.", "support_website_url": null, "website_url": "https://up-frontier.jp/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED
305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf-RhpYgbN4Q7kNvwGDqO87&_nc_oc=AdmK3xxbYUsqlRFjp2UMAtrhQUWzM4hz8cQ_OpVcHQL0wgnpRHCQmyBuJfxlHUxa-Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuY4jxTZOm9lvtaoe46hphg8Tv-GAhynglVwoO8NBYCzQ&oe=69983D2B"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1iQLFE6XN4Q7kNvwGnT0HB&_nc_oc=AdnK7JMKHcpD9O97MT7nZZ-j1XT5MfDiZpVaABaTcunUSRhrQ2d76M9ceNKEYRE3qQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftYAZySJB4-9rfjZq9ULPS1rhUru9mZX8tTrvx5_4W00w&oe=69983D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQMWixFtsEgQ7kNvwGMTnvs&_nc_oc=AdnnMdn6HNoMWNWi-653L2p3BjfhzyLzUCC0UNVUgYhix9Cn2rmragdZ3JLekOvU1hA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs60TnR199a3N3wXayBcagxgoDhAt226f8W5zUzMxYnXQ&oe=69983C9D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
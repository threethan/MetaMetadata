305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULI8qn0GZCMQ7kNvwHaNxNY&_nc_oc=AdmPkSAiUf_PAgAm5i8sT2k1noD1c0eZB1jbK3aigupwLv_9PvMF6RxBTJyiHTxqnQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afun7egcs2Dl7zIEzIuT-OS3DapXurB5LQFgTG_STtipXw&oe=69A0262B"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht8ghxDDZ1sQ7kNvwECLHdi&_nc_oc=Adlm2tXlONGvKCGG6x45RZOOFbfr4TGJ4dNRPohJtL5EDlEZA30ksJStsNOX0OOMFhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWfUzEwxyJMQVXv78QT6MQZiAS1fuXpC985qK0sdHQ6A&oe=69A0262D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXFOGX_wjvUQ7kNvwEYCFPG&_nc_oc=Adkc-ijo_shq1RdsXsJ0FtpbPIUCvZSuNUy7QNK1uNzLTqM2mw5B4weYuMfD5Y7lZu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLLugdXbopbfg9M7f3dKibVvalDMav9jr7bJ4LOmYa-w&oe=69A0259D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
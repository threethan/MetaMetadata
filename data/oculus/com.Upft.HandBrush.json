305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnXPls6llU8Q7kNvwHc9cEV&_nc_oc=Adn49VSx8zQwkmkhZz4pMX3EJofslIah9gHhvfqSBs8dWElOV0C1BInxpGvYftmnJwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfseHYxKjqw-aoe46UD6SIlvK25GfhunJtRLY92aEEEp6A&oe=69A56C2B"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ9gECqu60AQ7kNvwHHWP4y&_nc_oc=AdnHIaf9vaN7LdTcIkbWy81V2rY1GuRllEnFZNfGHlljH0G9IoGWphK-PYMDzWB4COo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvU7OyiNfytHgehicWtSYQK3QpbWBSVXq0CccJLqyJyuw&oe=69A56C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mckMabNAumgQ7kNvwGEC9yD&_nc_oc=Adlgtag4p0Qt7UwTpkXgZ5AB2HBNAIUaFQlylJtiL1cYiAxreJRIpMnL4DRJY0V9CI4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftnEt5GrIKymEeqj5quPMfKGHrmAhpnrVlJTlPuRbKXoA&oe=69A56B9D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
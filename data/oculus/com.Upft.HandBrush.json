305673658046121902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULI8qn0GZCMQ7kNvwGa3OEK&_nc_oc=AdmkDrAtQyewS_XEouLj2RcbD0O-lwoINteb4ykf1nYgQqBm0eDAOmorP4DHdFIsIOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfshIYZU0WfL3yP3oP0SSiii8gh3m4vtlBZWmzD1zr9zEw&oe=699ED4AB"}, {"file_name": "HandPaintSS4.png", "id": "3580895252014851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982542_3580895255348184_5116071747278364834_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht8ghxDDZ1sQ7kNvwHfB3TU&_nc_oc=AdlsPSurcn1d7fAGilQg6kVGUBCW30dyCe_bDLxlGEEkBhxAzJYCEl4iuPr9rYCwHS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftGHjs3GjeAPUQUU5EQU_S0hEobesK3v7QpeSIxTDJBbw&oe=699ED4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "handbrush_2560_1440.png", "id": "503517510670985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_503517514004318_4954347346057839852_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXFOGX_wjvUQ7kNvwH9L5S1&_nc_oc=Adn0tO-CkxOCvubbPVQL_DHX9xUgmbg3HpCfJx62E02iTjl4WgGVtcY-BcmroYpDDgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuzMgq4OFMu_H4JEnfg1RVf9A1GdvJYpBHyQgwEkkPGOw&oe=699ED41D"}, "display_name": "Hand Brush \u201cwith your friend\u201d", "keywords": [], "long_description": "This app supplies great VR experience for you ! You can draw 3D paint by hands in VR space.\nAdditionally, you can connect to player that exists same LAN.\nIn other words, you can play with your friends.\n\nAll of actions in this app are able to doing with hands.\nIf you would like to draw something in VR space, you dip your hand a color bucket.\nYou can also erase something that was drawn by somebody.\nJust you dip your hand a transparent bucket and grip something that you would like to erase.\n\nLet's play!\n\nUp-frontier, Inc.\nHP\uff1ahttps://www.up-frontier.jp/\nTwitter\uff1ahttps://twitter.com/Up_frontier\nFacebook\uff1ahttps://www.facebook.com/upfrontier/", "short_description": "This app supplie
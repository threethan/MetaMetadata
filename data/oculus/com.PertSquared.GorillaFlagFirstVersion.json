cb=1-7&_nc_sid=6e7a0a&_nc_ohc=L00XDC6q7_oQ7kNvwEznj0D&_nc_oc=Adp2k3ggYYY8Fg9UsLFdoiL1hJO8dT53COjxwFpFQiy76xo4z_whjkLfARS0OmOSbYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGeBOmtF8IZW4upwJpHN1cyaE-yPIEjkTw6KVmuOFM3w&oe=6AEF564F"}, {"file_name": "LaserTagRESIZED.png", "id": "734359672337310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295424_734359675670643_3491053100841919748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oV5YL645EAQ7kNvwGv0nlL&_nc_oc=Adp-MlKzh7vFc9QeiEe-GDX5-YTSI0ygZhICS-_j22RzQnHMDlftLbOpS3TbwDKNj84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAbAUTHBtpqudA3ZepPWOBzGBGS9nLP2PMmpQuPf6-MQ&oe=6AEF4242"}, {"file_name": "SandBoxRESIZED.png", "id": "724929970460566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308217_724929977127232_8897844125458197415_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqmgRj-X-2cQ7kNvwF5P9qH&_nc_oc=AdqFJqito_KO5FTjl_GqCBwRI54bm_vy_nuMqX0vgjsN6Ec8GHB2kfSEJlFWTRgFbBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREc7vleZsUWfltfuukhW4cG5fMqCb0Hb1hxrlk7RGz8w&oe=6AEF4284"}, {"file_name": "IFDepotRESIZED.png", "id": "1234612071327506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619742_1234612077994172_5791893806099019655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Xvk_gFkUQQ7kNvwFeDIKB&_nc_oc=Adqdhei2zFzsBZ9HApZOyb6xSETFcH_rMeTf1a4WWoWa9A0tg2HQC7QkNSunQJylKBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1_kticlnrxCpy-A0zm02ziO4Hm-XlkkeMI3q_a_LtKg&oe=6AEF321C"}, {"file_name": "LoadingScreenRESIZED.png", "id": "1960621038074408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620701_1960621041407741_3504608240047111639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZK8rqSMseQQ7kNvwGlO6WR&_nc_oc=AdqDvAPChjRMnkQOBkd-Yv_AumF3eS8Hz2SJ8X49UMRFBR2DzCn4_j-GsOtccz92igw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-jKgcsNZx_6SP6QAUtymJv5_syXdUCy56tL47IgL_aQ&oe=6AEF5A65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Flag", "keywords": ["flag", "laser", "tag", "social", "competitive"], "long_description": "# \ud83c\udf1f Welcome to Infinite Flag!\n\nWelcome to **Infinite Flag**, a multiplayer VR game where there's always something different to do! Battle against other players, take on challenges, or just hang out with friends. With **5 different game modes** to choose from, you can switch things up whenever you want!\n\n{2204421413622473}\n\n# \ud83c\udfae Explore Our Game Modes!\n\n## \ud83d\udd34 Capture The Flag\nTeam up with other players and go head-to-head to **steal the enemy team's flag!** Defend your base, work together, and see which team can come out on top.\n\n{1140594864973285}\n\n## \ud83d\udd2b Laser Tag\nGrab a blaster and battle it out in **fast-paced laser tag matches!** Dodge incoming shots, aim carefully, and take down opponents as you fight for the win.\n\n{1440847791309930}\n\n## \ud83d\udc7b Horror\nExplore creepy environments with your friends and try to **survive whatever is waiting for you.** Watch your back, stay alert, and be ready for some unexpected scares!\n\n## \ud83e\uddd7 Only Up\nClimb your way through a massive obstacle course and see **how high you can make it!** Be careful where you step, because one wrong move could send you right back down.\n\n## \ud83d\udee0\ufe0f Sandbox\n**Do whatever you want!** Build things, experiment, explore, or just mess around with friends. There's no competition or pressure, just a place to have fun and get creative.\n\n{1816351822838161}\n\n# \ud83d\ude80 There's Always More to Come!\n\nInfinite Flag is constantly growing, with **new updates, features, and things to try!** Customize your experience, meet new players, and enjoy a bunch of different games all in one place.\n\n**\ud83c\udf89 Grab your headset, invite your friends, and jump into Infinite Flag!**\n{3634023070094691}", "short_description": "\ud83c\udf1f Jump into Infinite Flag, a multiplayer VR game with tons of ways to play! Compete against other players, team up with friends, or just hang out and have fun. Whether you're into fast-paced battles \u2694\ufe0f or messing around with friends \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1, there's always something to do!\n\n\ud83c\udfae Game Modes:\n\ud83d\udd34 Capture The Flag\n\ud83d\udd2b Laser Tag\n\ud83d\udc7b Horror\n\ud83e\uddd7 Only Up\n\ud83d\udee0\ufe0f Sandbox\n\nTry out different modes, take on new challenges, and have fun with friends! \ud83c\udf89"}]}, "developer_name": "RomanEmpire22", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pdZZBjlG4QXvsar6HucDBIgeZ9Epw9fUA92VJ3HHdb4/", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus57", "support_website_url": null, "website_url": "https://infiniteflag.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39195845263396295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391893_1857061361753486_1744514072227355013_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVWJPuo8vVUQ7kNvwGhP466&_nc_oc=Adre7vX8uGLsgPoiiJ1Fxv1XcYsqgvaI0zV-MDpcs11tWj_dY6i7XM5uuqh2rPVEIIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculu
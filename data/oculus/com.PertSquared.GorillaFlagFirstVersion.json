cb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E4I9U3ZSZIQ7kNvwFTm_bl&_nc_oc=AdqLMI5O0VF269emeC33HCNz3VxuR_v24dyWfaYZ4Tn5ykhtWPFSNHKm1XjElu7gU_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn-UpEcXz3QIF-6Ot4hZ0YXaoJdbjTudTlnPqIQUp-Gw&oe=6AF73F4F"}, {"file_name": "LaserTagRESIZED.png", "id": "734359672337310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295424_734359675670643_3491053100841919748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqxJPqv1K9gQ7kNvwFg7nvP&_nc_oc=AdqzOGlNOZrF9bFyU8bhsIDkCwsd-FWU7D5xz6GYHdL9AZYasKk_RjNEYDO12urSK9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR6hdMdvBzCA7hDWYixUguMMrTu2fv0uW1NhA2XbKxaQ&oe=6AF72B42"}, {"file_name": "SandBoxRESIZED.png", "id": "724929970460566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308217_724929977127232_8897844125458197415_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GtTaBO1IQ0Q7kNvwFowONn&_nc_oc=Adp0zgv2JzUXN6lEp_TERd_cOiHPmCEhJyN_GXJMVKjwxtEMZ9ssMh9AoJOkB3Wd1ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSWlq2pCNSbObOoNtZOD0e1Qqki3geQ3WDpQfT-eujfA&oe=6AF72B84"}, {"file_name": "IFDepotRESIZED.png", "id": "1234612071327506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619742_1234612077994172_5791893806099019655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yNruzK5p9UQ7kNvwFu1DN-&_nc_oc=AdoQmXMEwDE_XlEXkbKcgUpU4uR6xH1gKpQCJVu2ush9jYz3EU7mynAQ8ApvbPYJTqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZ4JFHXJOT2r3an6eOtvySROBjIGgiW9UjoUndbyAbw&oe=6AF71B1C"}, {"file_name": "LoadingScreenRESIZED.png", "id": "1960621038074408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620701_1960621041407741_3504608240047111639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXzkqAKr8dMQ7kNvwH-5cqF&_nc_oc=AdqhafA-Gxp0wvrgir1Ioy98UciyYaCXD6H-e9fiqQxAw98IceAXoJygBVpsqtvPQKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoh_t6EIqOaEwCB5C9R1P6ADlebqesNrE7NjSVfxTP_A&oe=6AF74365"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Flag", "keywords": ["flag", "laser", "tag", "social", "competitive"], "long_description": "# \ud83c\udf1f Welcome to Infinite Flag!\n\nWelcome to **Infinite Flag**, a multiplayer VR game where there's always something different to do! Battle against other players, take on challenges, or just hang out with friends. With **5 different game modes** to choose from, you can switch things up whenever you want!\n\n{2204421413622473}\n\n# \ud83c\udfae Explore Our Game Modes!\n\n## \ud83d\udd34 Capture The Flag\nTeam up with other players and go head-to-head to **steal the enemy team's flag!** Defend your base, work together, and see which team can come out on top.\n\n{1140594864973285}\n\n## \ud83d\udd2b Laser Tag\nGrab a blaster and battle it out in **fast-paced laser tag matches!** Dodge incoming shots, aim carefully, and take down opponents as you fight for the win.\n\n{1440847791309930}\n\n## \ud83d\udc7b Horror\nExplore creepy environments with your friends and try to **survive whatever is waiting for you.** Watch your back, stay alert, and be ready for some unexpected scares!\n\n## \ud83e\uddd7 Only Up\nClimb your way through a massive obstacle course and see **how high you can make it!** Be careful where you step, because one wrong move could send you right back down.\n\n## \ud83d\udee0\ufe0f Sandbox\n**Do whatever you want!** Build things, experiment, explore, or just mess around with friends. There's no competition or pressure, just a place to have fun and get creative.\n\n{1816351822838161}\n\n# \ud83d\ude80 There's Always More to Come!\n\nInfinite Flag is constantly growing, with **new updates, features, and things to try!** Customize your experience, meet new players, and enjoy a bunch of different games all in one place.\n\n**\ud83c\udf89 Grab your headset, invite your friends, and jump into Infinite Flag!**\n{3634023070094691}", "short_description": "\ud83c\udf1f Jump into Infinite Flag, a multiplayer VR game with tons of ways to play! Compete against other players, team up with friends, or just hang out and have fun. Whether you're into fast-paced battles \u2694\ufe0f or messing around with friends \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1, there's always something to do!\n\n\ud83c\udfae Game Modes:\n\ud83d\udd34 Capture The Flag\n\ud83d\udd2b Laser Tag\n\ud83d\udc7b Horror\n\ud83e\uddd7 Only Up\n\ud83d\udee0\ufe0f Sandbox\n\nTry out different modes, take on new challenges, and have fun with friends! \ud83c\udf89"}]}, "developer_name": "RomanEmpire22", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pdZZBjlG4QXvsar6HucDBIgeZ9Epw9fUA92VJ3HHdb4/", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus57", "support_website_url": null, "website_url": "https://infiniteflag.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39195845263396295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391893_1857061361753486_1744514072227355013_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmK3Vy_d3IAQ7kNvwG3AVyL&_nc_oc=AdqrneMXIRleDmueF7T_tScjQvWmOfzgE21fkir0zfzYDTbDCPuJZNPDLKMdyMGe4A0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculu
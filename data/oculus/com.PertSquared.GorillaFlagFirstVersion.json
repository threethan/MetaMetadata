cb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK9tsyuxasEQ7kNvwEEAwuZ&_nc_oc=AdoVBhTCuF-dc9BtWTxrRkiMOhBXJULDxULzQonpD94l3bPx85zDUjWUN57zW0hhav0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUJzHcNThGOTjSuk-poNTNX5TPikzqiqhYvFp4kuF2sQ&oe=6AE8BECF"}, {"file_name": "LaserTagRESIZED.png", "id": "734359672337310", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295424_734359675670643_3491053100841919748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvmIIJgXum8Q7kNvwGNZGob&_nc_oc=AdrluDmZ_q6yVyDw5Xz9RMbUqtMHwg0M1MsoUyVbAwEr61dGKl7dmMRk284bfYvgIrs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_lNlc3JQx0gWuJIbXajMW5r5UhdYJWC1-2y74T6JySg&oe=6AE8AAC2"}, {"file_name": "SandBoxRESIZED.png", "id": "724929970460566", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308217_724929977127232_8897844125458197415_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmOLK2mvQqcQ7kNvwElFdR4&_nc_oc=Adq7swbO5yqkIZOokBR96SsmLPZKDIR0Mcy-UAZsfe0Cvb91wW7l57ijsGodHzOfdt8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqwbSt2mrZF7hkWT2_9oOj6J0KjfvyTigfjsV6ZMGviA&oe=6AE8AB04"}, {"file_name": "IFDepotRESIZED.png", "id": "1234612071327506", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619742_1234612077994172_5791893806099019655_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXxJH8kQG6UQ7kNvwGMpJbL&_nc_oc=Ado379SY0trQ56vjx0PI2cPVqtEI5BzU1Fi8xzYx6ibCZp23OTuydS7QbaDkJ2zbTKg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7V8tQ7QqFWP_aIaE55_EqTfWDxl5fqDv8je1UBsqM_Q&oe=6AE89A9C"}, {"file_name": "LoadingScreenRESIZED.png", "id": "1960621038074408", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620701_1960621041407741_3504608240047111639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCAN9wSj694Q7kNvwFed2DN&_nc_oc=AdqlZ3DQZ1hay0x_CjZ_BTVOr4t5Y5k50roE0B-vcllichYqXf7nFnMs3C1Av5T0wyM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuolo1gnlXd6S7t-JfdjpXjJcbrvYksudRcHo-QJX5sQ&oe=6AE8C2E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Flag", "keywords": ["flag", "laser", "tag", "social", "competitive"], "long_description": "# \ud83c\udf1f Welcome to Infinite Flag!\n\nWelcome to **Infinite Flag**, a multiplayer VR game where there's always something different to do! Battle against other players, take on challenges, or just hang out with friends. With **5 different game modes** to choose from, you can switch things up whenever you want!\n\n{2204421413622473}\n\n# \ud83c\udfae Explore Our Game Modes!\n\n## \ud83d\udd34 Capture The Flag\nTeam up with other players and go head-to-head to **steal the enemy team's flag!** Defend your base, work together, and see which team can come out on top.\n\n{1140594864973285}\n\n## \ud83d\udd2b Laser Tag\nGrab a blaster and battle it out in **fast-paced laser tag matches!** Dodge incoming shots, aim carefully, and take down opponents as you fight for the win.\n\n{1440847791309930}\n\n## \ud83d\udc7b Horror\nExplore creepy environments with your friends and try to **survive whatever is waiting for you.** Watch your back, stay alert, and be ready for some unexpected scares!\n\n## \ud83e\uddd7 Only Up\nClimb your way through a massive obstacle course and see **how high you can make it!** Be careful where you step, because one wrong move could send you right back down.\n\n## \ud83d\udee0\ufe0f Sandbox\n**Do whatever you want!** Build things, experiment, explore, or just mess around with friends. There's no competition or pressure, just a place to have fun and get creative.\n\n{1816351822838161}\n\n# \ud83d\ude80 There's Always More to Come!\n\nInfinite Flag is constantly growing, with **new updates, features, and things to try!** Customize your experience, meet new players, and enjoy a bunch of different games all in one place.\n\n**\ud83c\udf89 Grab your headset, invite your friends, and jump into Infinite Flag!**\n{3634023070094691}", "short_description": "\ud83c\udf1f Jump into Infinite Flag, a multiplayer VR game with tons of ways to play! Compete against other players, team up with friends, or just hang out and have fun. Whether you're into fast-paced battles \u2694\ufe0f or messing around with friends \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1, there's always something to do!\n\n\ud83c\udfae Game Modes:\n\ud83d\udd34 Capture The Flag\n\ud83d\udd2b Laser Tag\n\ud83d\udc7b Horror\n\ud83e\uddd7 Only Up\n\ud83d\udee0\ufe0f Sandbox\n\nTry out different modes, take on new challenges, and have fun with friends! \ud83c\udf89"}]}, "developer_name": "RomanEmpire22", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pdZZBjlG4QXvsar6HucDBIgeZ9Epw9fUA92VJ3HHdb4/", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus57", "support_website_url": null, "website_url": "https://infiniteflag.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39195845263396295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391893_1857061361753486_1744514072227355013_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZwfF5dj4MYQ7kNvwG-4cd1&_nc_oc=Adr5OtJLI5Ppsc3T8FQ3oBIz9lDJepYg4rAYiNsgactF13gDHbn05G6ZdLw0sf59gAM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculu
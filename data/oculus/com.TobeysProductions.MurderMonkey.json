/scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499621314_1551844426701778_7384548658420879847_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYkn_E4u97wQ7kNvwG5ufkZ&_nc_oc=AdpEM_GkPN0AcoUt4TQ21kSanqw_hDSHQqgUpqn03NoNjuKflgIThFoX8SG8WXZxSNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYefMFy9RjRX98YsDcCtW86QaIZsHlsAnftTAG5SS1SA&oe=6B0B2F38"}, {"file_name": "Screenshot_2560x1440_2026-10-24_19-12-14.png", "id": "39786771530937037", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593784242_39786771560937034_7396680804945952784_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvT-6Er-LLMQ7kNvwHhKe-P&_nc_oc=AdpBiTm__0PTA2Iy97tBotD4-2vhJ6JV7CRdq6XSGNDRFPZOrnW4b9-EShuKpCnWjtE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTjd9Z03GkBo6c0R6V9o2W7rTlv6psoVIW2S_JkrEYVg&oe=6B0B4277"}, {"file_name": "Screenshot_2560x1440_2026-10-24_19-11-29.png", "id": "2115138942468572", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593716858_2115138945801905_5838826176464586958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAGtja01RnIQ7kNvwEPmxHX&_nc_oc=Adq3GcM3Fmb9VA78VU00WlLoKM_MeydZ49sDg7dhjGbHHBVikQ6v6BbGdRDzWQ8yL9M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBFWHHnWJZnEJAAEfBijVjRVEop4u310BBb70Bx1Gu2g&oe=6B0B3480"}, {"file_name": "Screenshot_2560x1440_2026-10-24_19-12-43.png", "id": "1534440665112435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628108_1534440668445768_4449969486581674516_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmsV9Jp-MBcQ7kNvwF3YPQK&_nc_oc=Adr5nFaoZYRlCmgVTrdKyYO7uURUV2GtDPhElIbghJP6UY_dxf5TaUvg3t-hTzl-TUI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRai04SfcmXrwMufMZd0rOb9cMnm3nnxHppbakInE4NUw&oe=6B0B284D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Murder Monkey", "keywords": ["mystery", "monkey", "murder", "shooter", "action"], "long_description": "\ud83d\udd2a Can you solve the mystery and survive?\n\nEvery round you get a secret role. Find out who the Murderer is... before it's too late!\n\n\ud83d\udfe2 INNOCENT\nRun, hide and grab coins \ud83e\ude99\nFigure out who the Murderer is!\n\n\ud83d\udd35 SHERIFF\nYou have the gun \ud83d\udd2b\nShoot the Murderer. But if you shoot an innocent, you go down too!\n\n\ud83d\udd34 MURDERER\nYou have the knife \ud83d\udd2a\nGet EVERYONE. Don't get shot!\n\n\ud83e\uddb8 HERO\nIf the Sheriff goes down, an Innocent can grab the gun and save the day!\n\n\u2728 WHAT'S IN IT\n\ud83d\udc35 Move like a gorilla: swing and leap with your arms\n\ud83d\uddf3\ufe0f Vote on the map every round\n\ud83e\ude99 Collect coins and finish daily quests\n\ud83c\udfa8 Unlock knife and gun skins\n\ud83c\udfe0 Make a private room for you and your friends\n\ud83d\udc7b Dead? Become a ghost and keep watching\n\nFind the Murderer. Trust no monkey! \ud83d\udc35", "short_description": "\ud83d\udd2a One of you is the Murderer.\n\ud83d\udd2b One of you has the gun.\n\ud83d\udc35 Everyone else just wants to survive!\n\nCan you figure out who to trust? \ud83d\udc40"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/playmurdermonkey/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tobey's Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/playmurdermonkey/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
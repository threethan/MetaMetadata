etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZDMx6l_kLAQ7kNvwFjqhmR&_nc_oc=AdpyOAuEFn94MbbdBSiAFq2JP6rxJ0-PM-b6skPVFPXMlAMxpAFOphGq7uU4mDb0sCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG43rAvqngGFo3Y9g1TjfVQrh64x7KMSIFzlArH6PNQg&oe=6B007E37"}, {"file_name": "Screenshot_2560x1440_2026-10-24_19-11-29.png", "id": "2115138942468572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593716858_2115138945801905_5838826176464586958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0VIVW-OescQ7kNvwGpzQe4&_nc_oc=Ado1OEBjFfepRkbqmHi6h8Z8vepYyQ6aVu6jmGvWRnRbM5jsYszel0ajio1UFIvdAnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzyNMB-u8cQIjruDQCQTsfcFKNicCK7jer7p1eVj6PBQ&oe=6B007040"}, {"file_name": "Screenshot_2560x1440_2026-10-24_19-12-43.png", "id": "1534440665112435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628108_1534440668445768_4449969486581674516_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8ayLuae86MQ7kNvwEjHEhn&_nc_oc=AdqE5uPySnB0qhXJcY5kmwXNQ83gv2l4YgTyq-8Whub4egU-03WZMQviAbXqTJDmxo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW5Cbp5XGtTyO0p8XHdg7WyVjZFMW7wce3gxtkha1aJA&oe=6B00640D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Murder Monkey", "keywords": ["mystery", "monkey", "murder", "shooter", "action"], "long_description": "\ud83d\udd2a Can you solve the mystery and survive?\n\nEvery round you get a secret role. Find out who the Murderer is... before it's too late!\n\n\ud83d\udfe2 INNOCENT\nRun, hide and grab coins \ud83e\ude99\nFigure out who the Murderer is!\n\n\ud83d\udd35 SHERIFF\nYou have the gun \ud83d\udd2b\nShoot the Murderer. But if you shoot an innocent, you go down too!\n\n\ud83d\udd34 MURDERER\nYou have the knife \ud83d\udd2a\nGet EVERYONE. Don't get shot!\n\n\ud83e\uddb8 HERO\nIf the Sheriff goes down, an Innocent can grab the gun and save the day!\n\n\u2728 WHAT'S IN IT\n\ud83d\udc35 Move like a gorilla: swing and leap with your arms\n\ud83d\uddf3\ufe0f Vote on the map every round\n\ud83e\ude99 Collect coins and finish daily quests\n\ud83c\udfa8 Unlock knife and gun skins\n\ud83c\udfe0 Make a private room for you and your friends\n\ud83d\udc7b Dead? Become a ghost and keep watching\n\nFind the Murderer. Trust no monkey! \ud83d\udc35", "short_description": "\ud83d\udd2a One of you is the Murderer.\n\ud83d\udd2b One of you has the gun.\n\ud83d\udc35 Everyone else just wants to survive!\n\nCan you figure out who to trust? \ud83d\udc40"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/playmurdermonkey/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tobey's Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/playmurdermonkey/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1129763763121123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_1653542406484709_7389320711346856576_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLoXqCrWEyEQ7kNvwE7f8bO&_nc_oc=AdqYvI8KgOPV4H2_fD4I5GOKeKfl9VJqMC_rO2zxgG240J9IrOil8WEZQaL
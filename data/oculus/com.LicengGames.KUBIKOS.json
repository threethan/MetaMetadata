5771-25/39003282_1127246451092652_894795109150974798_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zuko9zcl8RIQ7kNvwGDReEn&_nc_oc=AdpS-Qqrh8O-wLSDiuXYmlwVZu1ZnIXmKpjiBrmBo-7MW8p1hQfmjffD1kaA_f-tVtY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEttzcUd3nkMQ5J6PSg1CLK3I86S_blMq5w_A5z4QNAog&oe=6A857912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "210978287513785", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974896_210978290847118_7672800902019600580_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCs2yIZGICsQ7kNvwGkpZJF&_nc_oc=Adr4hh_QZ-CLFWJub-PEOIliVdYJO8btdbmww7MOwG-DfZTB-_5-qzmqeZW2EGoPlAk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0rwK5hrNZy7eDA9YwnFBA5hdti0DGjPLzcW4lFbzPzg&oe=6A857D40"}, "display_name": "KUBIKOS", "keywords": [], "long_description": "Many block types:\n\nThere are many square sorts extending grass, square, water lava magma roads, crystals and much more. You have numerous choices with regards to building your realm.\n\nFeatures:\n\n*3 type of locomotion Flying, Teleport and Smooth\n*Autosave. Your progress never be erased\n*Big Landscape. You can build more than one world\n*Enable or disable player Gravity\n*Perfect game for the whole family.\n*Build anything\n*One of the best simulation games: begin constructing your dream world\n*Fun game: Play with villagers and animals it is so fun!\n*Cool graphics: enjoy the best graphics with animated cube.\n*Building game: Build your own construction", "short_description": "Build your own village. Decorate your house with your mates ' furniture and your own eyes. Learn more and more, and you will never be able to build massive castles and temples! Start building and show the world your best game and constructions. Crafting and Building is best game for the whole family."}]}, "developer_name": "livbogdan", "developer_privacy_policy_url": "https://livbogdan.wixsite.com/licenggames/privacypolic
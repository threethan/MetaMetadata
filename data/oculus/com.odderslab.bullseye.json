0FctMmA_aRFG7PCxfs0rxYK8TGx9EilQ&oe=69B15B06"}, {"file_name": "screenshot_0001_freepik__enhance__83993.png", "id": "587844084267971", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_587844087601304_8142383784158903201_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIg2-0gTEboQ7kNvwHLW51M&_nc_oc=AdnnX50f-3h5bSejRIzMZco2A9dhOzETYOyL_wlo1fyScbNYqPlHbI1bNq9tW3Hs9po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVx9Xmr0nZGiXPv9ygyKrWdkpcVa0tirQzXS2Irh41ZQ&oe=69B1640D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KEY_ART_BULLHIT_2560x1440.png", "id": "1374980766891837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821712_1374980770225170_5925596769972335206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m824X8fvN4Q7kNvwGfgKEH&_nc_oc=AdmhFYnwLHL9oLm5Sy_Tt3CaAuxuiEahteu9C1JBlDp00_Ooy2fCAEusN3blN3SHmeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9uyHCylmNDiXq7cPgGZpb-_pKlBWqx8O2eihAApoJmw&oe=69B15225"}, "display_name": "Bull hit: all FREE for limited time!", "keywords": ["hit", "bulls", "multiplayer", "free", "animal"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruits at everything, paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n{954593440159466}\n\n# MAIN FEATURES\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n\n- **Customize** your bull and your rider with absurd skins.\n\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n\n- **Free to play:** join now, regret nothing.\n\n- **Powered by LIV**: We\u2019ve got the tools to capture every glorious mess with zero effort!\n\n{1181477160337895}\n\n**Join Bull hit now** \u2014 chaos is mandatory, logic is optional.\n", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24818175254433847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821568_1262348641947804_7153520629584236738_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5saqFM_fu3UQ7kNvwH1pbCb&_nc_oc=AdlYreu6qbOdT2C8ZmADZkh_0gM_zi5seDCBJYWJ_1BG1p3gETD0CLkM1qdcbeIYTmU
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjE7NKeKfZYXrmFw0IZEmSVS2wy2ChIHOZP40pfZrgOw&oe=6B00545A"}, {"file_name": "Screenshot 2.png", "id": "1006933524132471", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391890_1006933527465804_8959695001210741990_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZddhJ0Awo8Q7kNvwERWGV9&_nc_oc=AdpyE3WVmjPAeMQcgDM2IXdnBZsfdu6Sh4FzQ7_k2f19kTCTrjeZ0S0bQ4U-1V90pLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Tk5iFOt-eyzcflrMWBlcij_hk4Uw089Z_kLGbX1hbg&oe=6B0081DC"}, {"file_name": "screenshot_0001_freepik__enhance__83993.png", "id": "587844084267971", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_587844087601304_8142383784158903201_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTUpHpP8w5oQ7kNvwG70OKT&_nc_oc=Ado3disO7js8T4TlbNtWNJxy4TB4U4hLZnMxqCbYWWcJsFV2Lyredn3XrfNEBRpqG9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2e08XVAPXH7biJYF3h9zMykh2wD1WgaRNKwFPZt3duA&oe=6B00794D"}, {"file_name": "screenshot_0002_freepik__enhance__83992.png", "id": "1101112042033200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_1101112045366533_7922147564674682918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0_qZgLNRxIQ7kNvwGViSVu&_nc_oc=AdpWPR3U9MfK_8Fk-l1chKuW10ojT6JcoEtpuefm3ttg3Li3cKVa6SBbpaJtYFpyuVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa9Oawe_msxm46JR5zPEc-oF9QyHVswMtyl6RyJtaSfA&oe=6B007046"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bull hit", "keywords": ["bull", "hit", "bulls"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull like, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n- **Customize** your bull and your rider with absurd skins.\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n- **Free to play:** join now, regret nothing.", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9858665657478052"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
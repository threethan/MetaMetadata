7K-4LNCe9sQw7ovzIeVwvqTRpwI-gViA&oe=69AD6686"}, {"file_name": "screenshot_0001_freepik__enhance__83993.png", "id": "587844084267971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_587844087601304_8142383784158903201_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK9IrRcOC0AQ7kNvwGNEus0&_nc_oc=AdnXsx4OpWDGox8GFQqVcvZrNMnN5ESjvxge6eal5mtZyY3ue9SeQH6Ezx9YertCmz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-LVp1qeIq6DHDrpJ6S9h21UWfrDYGwJ96EXmZmEKcgg&oe=69AD6F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KEY_ART_BULLHIT_2560x1440.png", "id": "1374980766891837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821712_1374980770225170_5925596769972335206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rkZT5pjfwkQ7kNvwF4HTuJ&_nc_oc=AdktVK_mYVKPyP22bsIu_LVofKGhODcxSzqCJysDzY96hd7MTElfmnjQzn6hAjKqkbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV6YNbzhb3BHg3RXBCYiZWPWr-N9HUCUwlhU75jeglkQ&oe=69AD5DA5"}, "display_name": "Bull hit: all FREE for limited time!", "keywords": ["hit", "bulls", "multiplayer", "free", "animal"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruits at everything, paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n{954593440159466}\n\n# MAIN FEATURES\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n\n- **Customize** your bull and your rider with absurd skins.\n\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n\n- **Free to play:** join now, regret nothing.\n\n- **Powered by LIV**: We\u2019ve got the tools to capture every glorious mess with zero effort!\n\n{1181477160337895}\n\n**Join Bull hit now** \u2014 chaos is mandatory, logic is optional.\n", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24818175254433847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_1262348641947804_7153520629584236738_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pSPjSTY7dcQ7kNvwFwYwr8&_nc_oc=AdmHKs050XwvFpEztI-fYfUV3-MGR6YEx5ou-pUMZpccJ1UlezrLGBt34CVI83MrwXo
lkOWfAuMUabg7pYUpWw23-tKIalSODqA&oe=69B94406"}, {"file_name": "screenshot_0001_freepik__enhance__83993.png", "id": "587844084267971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_587844087601304_8142383784158903201_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqx_A020U1QQ7kNvwFLZORn&_nc_oc=AdkQqn8zAUPKF8DI8TNZ35zUibgxMz1qfQINvGZyVqI0SEbP4e00ZTnGHVyiSizuKLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyidh-30QQ1_kl656cKyZbI60nZytaVnLd1-E16tOEZOA&oe=69B94D0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KEY_ART_BULLHIT_2560x1440.png", "id": "1374980766891837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821712_1374980770225170_5925596769972335206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nanfAJz4dQMQ7kNvwFSycsw&_nc_oc=AdlVGr-q3xDDZGFInSFBGvSRTePvt-LG6shXAR9J1MWU2MuswI23hLUTKnprEIFvZrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPNvLgiMtasb-eCtVvE7X2f47HE0hq0cMKQYn2UOuGEQ&oe=69B93B25"}, "display_name": "Bull hit: all FREE for limited time!", "keywords": ["hit", "bulls", "multiplayer", "free", "animal"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruits at everything, paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n{954593440159466}\n\n# MAIN FEATURES\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n\n- **Customize** your bull and your rider with absurd skins.\n\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n\n- **Free to play:** join now, regret nothing.\n\n- **Powered by LIV**: We\u2019ve got the tools to capture every glorious mess with zero effort!\n\n{1181477160337895}\n\n**Join Bull hit now** \u2014 chaos is mandatory, logic is optional.\n", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24818175254433847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1262348641947804_7153520629584236738_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FChGLzX3jYQ7kNvwFjG4KL&_nc_oc=Adn0VapcIV1KQoTkBiWI51xr4tspo-L49IRDp4sNyTzlHVwo6lMXlcEckliy68VRMCI
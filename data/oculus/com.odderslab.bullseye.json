4_8142383784158903201_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zaimmgVwMEQ7kNvwHXbSFG&_nc_oc=AdmQ01RXMw0dlB67E3YUsS2HBhHC9Jgg3iXFv6ZVzIwUgkLidQ-TU0NvXPiuFNVSHqE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwmgc8LQPppfy4H-Y24wrKMBkukPzhoAxr0QoQ7asRQ0g&oe=69AACC8D"}, {"file_name": "screenshot_0002_freepik__enhance__83992.png", "id": "1101112042033200", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393887_1101112045366533_7922147564674682918_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-sSys9HthUQ7kNvwEH4SSs&_nc_oc=Adl41OeAkmkletay_0hbWocxyoaub_JhC6s-ofT6nlbjrDdAKnYBgSBvch3bhw9lphs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxAlwNy0kwDwroVoOg28kazLJW2xCramsqi5IV7onc5Yg&oe=69AAC386"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bull hit", "keywords": ["bull", "hit", "bulls"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull like, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n- **Customize** your bull and your rider with absurd skins.\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n- **Free to play:** join now, regret nothing.", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9858665657478052"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1412996626498494"}]}, "baseline_offer": {"id": "1412996626498494"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745492820, "status": "PUBLISHED", "id": "1412996626498494"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24194206066830772", "version": "0.1.81"}, "id": "3513505862126133", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9638789212799032", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24194206066830772"}, "release_status": "RELEASED"}, "binary_release_channels": {
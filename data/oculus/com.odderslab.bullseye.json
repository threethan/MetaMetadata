-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRxEaaUF8AULn2Q_c_9wTJ8bxJ-uyPz8ebkc7A3uAFzA&oe=6AFF02DA"}, {"file_name": "Screenshot 2.png", "id": "1006933524132471", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391890_1006933527465804_8959695001210741990_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZddhJ0Awo8Q7kNvwGhTOm2&_nc_oc=Ado5a552gWsXrRAvCx--dURYdxGBQL_9ZNWsHgLyXixmsQC1FOUru6lUw2Dt8qVo-c4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Cqg0vXzC3aE4dWVTk_TNJm26CzhlBm8vECFVh0e5yQ&oe=6AFF305C"}, {"file_name": "screenshot_0001_freepik__enhance__83993.png", "id": "587844084267971", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391952_587844087601304_8142383784158903201_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTUpHpP8w5oQ7kNvwH9mVX5&_nc_oc=AdpaTOjP09Vm7rx3w_Pj0KHR3xlNyA-Jftrjk3J7dVrN9PDh80BOjkCaMBAUO2unVz4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxg-FDjxWMfJY8F4HgthYa5Qxo2d3cbOY49p3RxIGMjg&oe=6AFF27CD"}, {"file_name": "screenshot_0002_freepik__enhance__83992.png", "id": "1101112042033200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393887_1101112045366533_7922147564674682918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEDEsCDQVggQ7kNvwEarDh3&_nc_oc=AdoEO5-3MNZ7kSYhMHUomViqQAU5-lbYtAnS2OUJVZGM7GcjTIVljwsFtitTRt1USQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjZ654kfQGQtehKq4c3eXywrbKqlr8_2eyHrF775_kOQ&oe=6AFF1EC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bull hit", "keywords": ["bull", "hit", "bulls"], "long_description": "**Bull hit** is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull like, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat.\n\nIt makes no sense, and that\u2019s exactly the point. It\u2019s stupid. It\u2019s wild. It\u2019s free. You in?\n\n- **Ride a bull**. In first-person. In VR. Yeah, seriously. NPCs will fear you.\n- **Play your own way.** Seriously. We don\u2019t even know how to play and we are the devs. Break stuff, throw stuff, do stuff.\n- **Online multiplayer madness:** no rules, no goals. Just crazy bulls.\n- **Customize** your bull and your rider with absurd skins.\n- **Voice chat:** to chill or troll. Challenge other users or discuss about crazy topics. We don\u2019t judge.\n- **Free to play:** join now, regret nothing.", "short_description": "Bull hit is a first-person VR multiplayer sandbox where chaos isn\u2019t a feature \u2014 it\u2019s the whole game!\n\nRide a bull, launch fruit at everything that moves (or doesn\u2019t), paint walls with zero talent, play rugby and basketball, or just scream at strangers in voice chat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odderslab.com/bul-hit-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odders", "support_website_url": null, "website_url": "https://odderslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9858665657478052"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
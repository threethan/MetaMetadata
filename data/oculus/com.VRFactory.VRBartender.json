ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJFdbuYxJkIQ7kNvwF0PA7V&_nc_oc=Adr4U_GShafbY3XyqPovecaRL9wiChLVXCk9mcLyF63c7WY5bzRpyRNYTSKQi8a_WV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7LL2Hr60q9kNYso9CoqH0GtsN2W5BzHgAjre1OkwW0w&oe=69CA6390"}, {"file_name": "04_ROOFTOP_001.png", "id": "256205720301779", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036646_256205723635112_1369683091072364262_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl-rITfpO7QQ7kNvwFe9Tr3&_nc_oc=Ado49KFnu07ovhZg00-Nz2zhP6mzhIsavLhJOyDgCd9tqxa6tObH0hf9sgEzVcKPbEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhREgf-qLOkQssC9O7D4z4lybyQ6wzfRk2USli-hiZ8w&oe=69CA6C24"}, {"file_name": "05_VIP_BAR_001.png", "id": "191792770362029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001732_191792773695362_8601594000717301485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrLNt9qjRrsQ7kNvwEVy-pA&_nc_oc=AdrYkI7mHCPyxH56KNzzBr1Ethjr513kbwL--2oQwyV5YMmIKNUtGOdO1nn4dLdQMpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3LsitZ8-_3_h_XGai3I305a8ZiDbVoSu4U-SDx1sO_A&oe=69CA7F0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdj\u0119cie w tle.png", "id": "737488934724253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003258_737488938057586_7754330107928197856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dL-8yk2jncQ7kNvwHqRXAB&_nc_oc=AdrbjAU1zVkrqQKVdZCqFpNDqvJ04Xe6tCAPWir2wygtt6jIbKBzIpbhbH18D7S1pZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQh9XiohVSqSU1yDF4W-E4DpwmxkVDsJwkcvYTSguS7w&oe=69CA631E"}, "display_name": "BARTENDER VR SIMULATOR", "keywords": ["drinks", "challenge", "drink"], "long_description": "Working in four unique and professionally equipped virtual bars, you will experience the thrill of the art of bartending under the watchful eye of Tomasz Ma\u0142ek, a six-time Bartending World Champion. \n\nBegin your journey in a music club and learn how to make four basic drinks. Prove yourself and win the opportunity to train and work in the next location. \n\nMaster more and more demanding drinks as you progress to new, unique bars. Earn the course completion certificate and take up a whole new challenge in the Pro Mode.\n\n\ud83e\uddcaA range of drinking glasses to choose from, different liquors, beverages, and additions. Crushed or cubed ice? Professional bartending know-how. Various bartending techniques. Item destruction. Juggling with bartending equipment and drink ingredients. We serve it all in a super-realistic quality.\n\n\ud83e\uddcaWho will earn the most money in each bar? Who will make a perfect drink in the shortest time? Who will earn the biggest tip for a single drink by mesmerizing the customers by using the flair technique? Today you are in the top 10, tomorrow you drop outside the top 100. Every day someone quicker than you takes your place. Don\u2019t let them get ahead of you!\n", "short_description": "Bartender VR Simulator offers you a unique combination of a simulator, bartending course and incredible immersive VR game. \n\nDeveloped in cooperation with a six-time Bartending World Champion, Tomek Malek. \n\nYou choose whether you follow the path of developing bartending know-how or having fun. \n\nYou decide whether you fight for the best possible result or just have a good time without tension.\n"}]}, "developer_name": "VR Factory Games S.A.", "developer_privacy_policy_url": "https://www.bartendervrsimulator.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VR Factory Games S.A.", "support_website_url": "http://www.bartendervrsimulator.com/", "website_url": "http://www.bartendervrsimulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type
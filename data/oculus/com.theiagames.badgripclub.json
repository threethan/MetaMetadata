e=6ADE0FA0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiYv_9RCU0MQ7kNvwFMRplU&_nc_oc=AdqMtdfP1QCes2Q6yX-MBJ7UwI_DzAUC4dDJ5NU6zv_4uuAd-jQrnQ1Vqns69-PCjQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ4qC7x9a8SFQMzrn2JVnTTIG0olYFs_iBlc2rTp0Ngw&oe=6ADDFDF8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjmx2IFLo6cQ7kNvwGoHZXl&_nc_oc=Adr9qCAmMtX7WRFS7lfl8yC6OxAj2WRUSHG1IpqKEe-cP8gXkQ_r0j4r2NqYOFnWEV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHHVFabfUsGeArQewEmWznk2AbUvXaeidwLQP-f-7Paw&oe=6ADDFA17"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MTYupBBK_kQ7kNvwHTubfM&_nc_oc=AdpzO2EULayOEqnYm5th1f08-EMy2g63m6WvjPjCLwsDNcc9CBIVgtVhvHlh3tNHpvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdBRJ3RBGzBbZPZ9hB7zK4xN48bKB4ZX61aKgrLq_9yA&oe=6ADE0F9A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lNehv0OezsQ7kNvwFunbAd&_nc_oc=AdrzL6OVDnnGvQfZlfxaSHHRFs5C1ZNALZMCzcQCMuSQWq1J5_tx8GuNFcwNRW3CCiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlxQmVxzCFm9c4UNWS9LgnFJhkV7WsxoKqoj3rwIjGvA&oe=6ADE2055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf3JZjxyQYcQ7kNvwENfQj9&_nc_oc=AdrH_54mZAaEu3nXOtdmPuw99HGGUJFyAqOYQqDczdGtY8RCLGAhf_bb5DjdNJOz0DI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp5Pb_dmW0jl-5u-s6NpdYVeO6HDdMLWBoiDhmP9jj8w&oe=6ADDFA47"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
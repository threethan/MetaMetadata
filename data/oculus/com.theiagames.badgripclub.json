6I6zD0XA&oe=6B05B229"}, {"file_name": "bad_grip_club_03_2560x1440.png", "id": "1320100972873090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1320100976206423_4929576594960785010_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7fEk2uj9h8Q7kNvwGjSk5N&_nc_oc=Adr6Asn6rDNp-7yZ8540T1uVCPFDW_WdclAS1t26BS3iYw49U642CZQ8lhgLNM_gW30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1ciAUyGWtVOJos3SXChrBzbetUZ9KVR1EC76XkO0uMw&oe=6B05D2F0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2mJ2Ary1_oQ7kNvwFSZCT3&_nc_oc=Ado_SeFGw1_FLUL0n7tbySJfb_PnTYHvXe61sKVTg9jREz_oZdjOkMnBsVXBPY3a4Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnkyDpcm3WyTY7brOQYEQQlztp_4wuf1AY3rtuYFnIkw&oe=6B05C338"}, {"file_name": "bad_grip_club_05_2560x1440.png", "id": "1303082218604358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308578_1303082221937691_6592266893564327779_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cNZpsbNUBMQ7kNvwG7ZfUq&_nc_oc=AdrdAaL5KrgxuSwxgZudZP0Duk2MAIcf3UvoQdVoUpgIfbHTim7tX5IwxSEnrc-6KZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd_PolosO_gVbtQSIlbn_eX1BwOURL1A2vBPOep4bL8Q&oe=6B05AB34"}, {"file_name": "bad_grip_club_06_2560x1440.png", "id": "1466561438557531", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828918_1466561441890864_4400500347052304863_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7el5wvQI8TEQ7kNvwEeFv9W&_nc_oc=AdokE0BoD_wJ9BNsPzBYkLpEpE9tpFEOGjB_3oKE_J68ytSQsZy1J9Tl0A_VeGf1ky0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRsEqh7jrWoAUvEKkxKlAsPXya_NTA3asZagC7JD8aRA&oe=6B05B3BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bad Grip Club", "keywords": [], "long_description": "VR IMMERSIVE CLIMBING\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect immersive, and comical crash landing!\n\nCO-OP & CROSSPLAY\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nDIVERSE BIOMES\nTravel through cartoonish zones, each with unique hazards and visuals. Cross giant gaps on ropes and adapt to a changing environment as day turns into night.\n\nNEVER THE SAME CLIMB\nEvery climb feels fresh due to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
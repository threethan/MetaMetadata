e=6AEF3320"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mWpp1i3vFwQ7kNvwHnzilG&_nc_oc=AdoupCmu8Ziv7Um0IZuLXeuJ8zLM0lLrXNnrIg4Qk3WmWWOn2BMNk4XzV_iBAo_y-l8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfkCLr7je7sN63b-E-oJyfXYp1audcZaRCER0NrC03Rw&oe=6AEF59B8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTF8oLdk7dUQ7kNvwG4AuQ0&_nc_oc=AdpMQihbO6vYLr-aBAwwxoV4Qv7rfHkvq2tn7zSD8MGz084Yc53yd7yyp6p4hnpjh3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQycvpzbBecOBeatwCw885WfB8tT9Mc09C-IPYm4YP3lg&oe=6AEF55D7"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGElfKHBA6wQ7kNvwHDIoxK&_nc_oc=AdrD62jx2a3z2MpO2PL8qkBAcp72ZF8W6ZIjPPGtqH0GqvXX9ewNLO4YMIaNdTNmkkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0V36vM5kv5IvhtGlrsnbrAujvWS5mEu9qymrocxY3Ag&oe=6AEF331A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgULm9XredEQ7kNvwFOIb72&_nc_oc=AdqOrWBrQ9csqjRIiHgwvZf6vbNYLsU9Ipk-vTGwMtoW-JT1V7Rs7ZBs1FvCbijFP-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCeeYJHo5RAPy0IZFLsBKt1EZXMHjgZwlIYSN_yfVvIw&oe=6AEF43D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFCCuAu_ij0Q7kNvwFLKRXo&_nc_oc=AdoXLxVdDchCoH2SeqRraO9Cfo6I_2_dJf6WOXiHUqJVYH7joUQwWjwf-9cVrJQJ5Sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWZXhWeRHPEIryH0lVRs_HeWQdjjYTIYM0eOw8AR8Ixw&oe=6AEF5607"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
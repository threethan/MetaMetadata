e=6AE9ED20"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5KEPb4RS2UQ7kNvwHPdQye&_nc_oc=AdqVNkGx3WXRPKk1neINOwTwhtwnT_49fDW4GBbrPIbWA1b9GBe5aUm4-PXS-I-DyZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjGmd5e4Y7pDpXw-yDq0KxeNKgEaDpFBUTpAqn4KnupQ&oe=6AEA13B8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caoZGJsSAJQQ7kNvwETQPFQ&_nc_oc=Adp1oAb60B4kBNfKagDvi--mpHHllDz62ewrMa36iRWLl2lD8plFQ3Nj6Uj3q90LEBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ613O7upLWxIUSTqZRLeRHWPXBOz5cxtecJJlJFiB7Cw&oe=6AEA0FD7"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIb4ewDBzsIQ7kNvwEa3NMa&_nc_oc=Adp_b4rAubK2cG_LjKUQ4XuNWD4s5PgKXoHnbenHx8xcgKbjWNo_3oGeTpD_1Z2XLfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpU7ygjW6X9I_j-uFqeNkBvbIn0_VmYJ5KxPnaWPHjoA&oe=6AE9ED1A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvsF_lcQj9AQ7kNvwEHtf1Z&_nc_oc=AdrzJxKF16hk7MEJPAs8I-wZXM0dTbayB4_yjumAkq_mx0ENh59rI482G17RPPIxgN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTacCbn17BL1DzI0BGmMOsbfJ91zsYbH-sgEQNLO9pqqw&oe=6AE9FDD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XfD4SFAm9YQ7kNvwGlwlWv&_nc_oc=AdrW0TFfzltFnTl635kjxmx6UBPALsoU1UQL1Nzl7o13PjuJN46xO8BArevGENb35Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-P4AZoq5KnV4P7Ht9ybPUnWQYiwd7rIEuNYK7MMVyNQ&oe=6AEA1007"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
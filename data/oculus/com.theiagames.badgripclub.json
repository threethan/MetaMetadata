KqDc-jRA&oe=6B030F29"}, {"file_name": "bad_grip_club_03_2560x1440.png", "id": "1320100972873090", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312454_1320100976206423_4929576594960785010_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-wK8W6N2xMQ7kNvwFA0qwf&_nc_oc=Adqkmw8ltiwAHjSSHYLCEjiqfvH5FkbEUEOioMRNKvIJ668A2VNqQvJWD-V82tn3e7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaxADVHrXageiOcojgKgJgkphwk6WXT7U8YJWTZ6nNOA&oe=6B032FF0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JkNjAn4Q-4Q7kNvwGwGrCi&_nc_oc=Adpj0D6J7IVwA7lY5Um4ae8yq5L6acg8dgDm-caJuF8aQyW1RUDbD_Q_rXHaKpYKyuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo9HolfmqNA6GWV4t-HlBwqv6SQ13YQJ6zR_OQCfinQg&oe=6B032038"}, {"file_name": "bad_grip_club_05_2560x1440.png", "id": "1303082218604358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308578_1303082221937691_6592266893564327779_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGLJ44IKFUcQ7kNvwHE40bc&_nc_oc=AdqL1j0ur2umxELxUg4gO5qHzN3lt7EEqabF8t6oVsn1FMPnAzdseeCDU_HxsSn1PtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYNQix5brx84a3uoY7uJmRjHKhRlDnMuRcx__LJDbmsQ&oe=6B030834"}, {"file_name": "bad_grip_club_06_2560x1440.png", "id": "1466561438557531", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507828918_1466561441890864_4400500347052304863_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNFIlJQoeioQ7kNvwGbDp6P&_nc_oc=AdoTH0EpdyTLoN3Zdc7_UKdwq401xyP6EykyTpLUcGkLVD89zVSUJOy71p0A6PV4TBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd7fGfFitd3ZEy7cz0sS0vW3cRcvEIqA8cr_6Qihgb2Q&oe=6B0310BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bad Grip Club", "keywords": [], "long_description": "VR IMMERSIVE CLIMBING\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect immersive, and comical crash landing!\n\nCO-OP & CROSSPLAY\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nDIVERSE BIOMES\nTravel through cartoonish zones, each with unique hazards and visuals. Cross giant gaps on ropes and adapt to a changing environment as day turns into night.\n\nNEVER THE SAME CLIMB\nEvery climb feels fresh due to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
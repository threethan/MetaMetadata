e=6AE20420"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smFb8AquqOAQ7kNvwHpNX7s&_nc_oc=AdoIGAyiBp580Y8Xl44aKaJU9at1wIcpebmlVUC7WdRCPmCTqbvaFrYCxleP7SrbjGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYhXlsZNyFCSV1SFhp13JDx2SKd-n1r_YOpEsqy9bcWQ&oe=6AE1F278"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjqpksRK8VUQ7kNvwGpp1Yk&_nc_oc=Adqv6StpvFUzN8sGBYTiltUeVKj3o7NRMQAWPKKfhb8dCPQ0g5AJgIzB9UmXfI6uBL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_plfMVq-i-MEzqvgZzleidU_R8sPY1Fr3TNdripVHBQ&oe=6AE1EE97"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJVz1RkG4wgQ7kNvwFT1oih&_nc_oc=Adraz_7euU6v9ydKKV5NdEjo1n2EZ9Y4YTQK3SSkjLUgkS_Kgp_ghqGQu_cKbhsH0Ok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOymJafNmP7DquaJhPayAnmy7vUz6WmI_ygWzBnc93-ow&oe=6AE2041A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IosC0YNThVoQ7kNvwEQChI1&_nc_oc=Adq3JNwwSAe26kUK2BDl5FAjeYMwNR4fdYBoEbvq-UXTdf2NtycrEgdtwNun7CI_lRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZteuleq1Jvxyha9GQ3tUpW7FQ9eo2rFWy1N9timU-3g&oe=6AE214D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpgkKi8CtXAQ7kNvwE6tC3I&_nc_oc=AdqJv2sHllbFPlfPRF0TsXyIwkztYvDuNSVxCTk1_Q_gv5HyXJGVh3yuuEyZMp1MQ2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMGAkSFtlEzh3qD0X-6P3Z7MTqxhxJqcb__qt0ITVREw&oe=6AE1EEC7"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
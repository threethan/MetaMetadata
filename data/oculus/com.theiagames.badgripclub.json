6AF327A0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-DBiVqjcDIQ7kNvwH73kpN&_nc_oc=AdpvIMZdNNAMiS2pvSW7dXUUeqb3xahr1VC6jkhfQVwI9TkZv_3Bdrwt2YORveQWg6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8kpbKiyrQUxLd_OdC8M1oyrevrLUeKm7LtRvYJmLQZQ&oe=6AF34E38"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJWn_QfFteoQ7kNvwF-PShs&_nc_oc=AdpGzxRUtSsdw50Ohy2pezOSkWLfId6dkf2hzGseV7BlQi5JxrVKfbyVzbUwUIQvyyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVUsgCq52qNmZY_ALAvZ3RH9mADZyrJcosx5rdcHMTIg&oe=6AF34A57"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWLE2L4ziz4Q7kNvwE6YBQG&_nc_oc=Ado5qKYzfbmqPWF8usS_W1nc2SX1RHlKugJhp8IN7aVF-ukAXZ6PUOkPRxK4GdRUM-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTyr7mcVD9JNKHdrsc-38dcp4PUFSADo2QanT90QbJMA&oe=6AF3279A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09Uhw5Mr_84Q7kNvwHu2t6b&_nc_oc=AdqK3peNHJrcrs5cFcM6Im7vQaF6tA_05XKn6HUOl02B0SM5bxxEyR-LK5WvXS9QGD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsYOJOUYmy8Mdg8tg-0jcIzHgDST4mGBfEZ6UFbSsemA&oe=6AF33855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zEbo66jjsUQ7kNvwGK0Ges&_nc_oc=Adp06fzaRU8KYpaxkZluG2uqpoEKmr0tXQknoAJawxU22A8ANTMaQHzLivCNtdMCMeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYu8rzcyCk-89MJYEwzEGoNetsNhQN4DYBq2FaMJ5qjA&oe=6AF34A87"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "contex
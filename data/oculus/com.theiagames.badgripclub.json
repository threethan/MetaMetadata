_Eya7rJQ&oe=6AFB2629"}, {"file_name": "bad_grip_club_03_2560x1440.png", "id": "1320100972873090", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312454_1320100976206423_4929576594960785010_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGc43njZkR8Q7kNvwFzs99N&_nc_oc=AdpmfJ3xfBZBc7PM2SY3QK6m9f1e9zjnNMg8wsA251AV35MWBjkf9LR_-n_ta51A-5c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO1XgFEsDmrbr57jtguOyEk2piugeqTmCHKNwr_dWuQw&oe=6AFB46F0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHh2XxngmvgQ7kNvwGN96cm&_nc_oc=AdoUletYQgq0myuZjIJo6beRraA2hzi7IXKDxlkKg_mDLR0Y8d4qX01MIQDE466qzVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO2vBEmuvh8JbDGD520iM5AOOiFqc7kgfH_GyDg_UyOw&oe=6AFB3738"}, {"file_name": "bad_grip_club_05_2560x1440.png", "id": "1303082218604358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308578_1303082221937691_6592266893564327779_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqa8zqOE7MAQ7kNvwEj8zrb&_nc_oc=AdrGwwJBXDvjma0stSG-ZvICtgpXo2dhpHckkOEDnAQK3iD8S8ZFw7dWzRE1SXqTLAA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7bIr6POxJRx9_V38AkPYwLR_yv2KthbEV77k7a1qbsg&oe=6AFB1F34"}, {"file_name": "bad_grip_club_06_2560x1440.png", "id": "1466561438557531", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507828918_1466561441890864_4400500347052304863_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py2P5vKWzgcQ7kNvwGWdCNu&_nc_oc=AdrePY4nL2eI2a92QGbDIbB76L4DRMkZQ10Kam4gJB_iV8II8xaiuOAixFaO6hlUxMs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzuFM9IPGALpE4YmQSyXdSQrWzcMfBftgjlBxMoNGZFQ&oe=6AFB27BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bad Grip Club", "keywords": [], "long_description": "VR IMMERSIVE CLIMBING\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect immersive, and comical crash landing!\n\nCO-OP & CROSSPLAY\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nDIVERSE BIOMES\nTravel through cartoonish zones, each with unique hazards and visuals. Cross giant gaps on ropes and adapt to a changing environment as day turns into night.\n\nNEVER THE SAME CLIMB\nEvery climb feels fresh due to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
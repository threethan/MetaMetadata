0.png", "id": "1531056698419582", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiYv_9RCU0MQ7kNvwEmIG3m&_nc_oc=Ado7r4U0GWznqH_WNmwF4CiLOEKTvrTnJwQ05gJ-u820mJEjJl-WpYdVUrPKqX1C1hc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8a5JWyZrYRr4dw2X2h4uLL20WPH6w_OSrwlo9hq5T6g&oe=6ADCAC78"}, {"file_name": "bad_grip_club_05_2560x1440.png", "id": "1303082218604358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308578_1303082221937691_6592266893564327779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhlOr0_znXwQ7kNvwEL3lXP&_nc_oc=Adr6ntv4xu_DMimJObq34Ep-h1RgwW_lzHmevWUO9Es-a1dnvoXFczBHCG9MhJT-S2o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtSNg9VYtvBoimorl7l_GvxoxA7xt_RpcVmXNhdJd56Q&oe=6ADCCCB4"}, {"file_name": "bad_grip_club_06_2560x1440.png", "id": "1466561438557531", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507828918_1466561441890864_4400500347052304863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQVp0RRAilcQ7kNvwFrTkPS&_nc_oc=AdpcqbUCS0fsdsLF8DqYRT4gvHwPz_6hz9_DBaglPase940NnWQvtjcgE5FQazYPNnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK2qbWggN4XCJgtzThDuS2uTKsa2yzO-4QBpFeJKiw4A&oe=6ADCD53D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bad Grip Club", "keywords": [], "long_description": "VR IMMERSIVE CLIMBING\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect immersive, and comical crash landing!\n\nCO-OP & CROSSPLAY\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nDIVERSE BIOMES\nTravel through cartoonish zones, each with unique hazards and visuals. Cross giant gaps on ropes and adapt to a changing environment as day turns into night.\n\nNEVER THE SAME CLIMB\nEvery climb feels fresh due to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "26875593558796758"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1309215384524965"}]}, "baseline_offer": {"id": "1309215384524965"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791471780, "status": "PUBLISHED", "id": "1309215384524965"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
e=6AE355A0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smFb8AquqOAQ7kNvwENu_oA&_nc_oc=Adp4YLLCMVlg-PQ0JvGiznOBDoI6bOARWodU2IK3efq2DmMwdsQM_wkiXWT8j9TS6Ts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2K8OmnenfClhZUYODEehKNCP2VqxYOWNg84Y9Jsuf9g&oe=6AE343F8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjqpksRK8VUQ7kNvwHmbohS&_nc_oc=AdpQFxjWPysUznpCxZOUwf9H34RQ839YD1QZOuD9x8oaw4q92lVFOFww6CyKYUYx7P4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKLwsPBdt-n9R2IyNZHs3o-tUaPxVyR297YDngte8r_w&oe=6AE34017"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJVz1RkG4wgQ7kNvwGM7USO&_nc_oc=Adppz-Ku-nXzk9rddw9z0bFbpbBoEyPHJ5Cm26H904wD05UU9NqqsGjUWb79sikCdds&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKDp6fJ0vOH5ps4LHjaI0XoDW5tynSG0CKjf9uppgXIA&oe=6AE3559A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IosC0YNThVoQ7kNvwFr4aji&_nc_oc=AdqklC8DU3Et8gimhLLuQWoIRv2pl85Un3qQXM4TEq9JsOnuLi755Tsgfa2kK9ExqPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQzqvEOR1OojqduuroV74zllly-gr_fNXeg63eJJNehw&oe=6AE36655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpgkKi8CtXAQ7kNvwFEJbLk&_nc_oc=Adpdps6ElRtVjj3jNiE6voCElYB-IHixG8hP8iJ3cg3nQsk2sQ0p2-X8DvkkB8PhEYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmh6AqJHTUPblWxgGVPksST5zw2gYpH-azNsxLv_a0MQ&oe=6AE34047"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
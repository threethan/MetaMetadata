e=6AF71C20"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYmaf3tfuiMQ7kNvwG92Ooq&_nc_oc=Adoj3KWhFx4OTQ7FxKsJmed7yFK1Ms4BgMyOqVL2lqGyRjNfOgg8vBXPuMQkdcatOUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIkSXRXCajjnLFDvSjDUt0V09mpbvu26vsKWgKQTQ4Dw&oe=6AF742B8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh0DsFJSwOEQ7kNvwHgLlfx&_nc_oc=Adp6Yf75Mvwtct60hPBfeE6zgRNomHFr5dKgR3zvxzjj9NcZ_O_a0UrHz1uG3jq7ikw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPpRC1p4ql4wqqYfXQ4B4bfqiH05VamP3ibPU4qU7lBw&oe=6AF73ED7"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inyFAXS1evsQ7kNvwHX5GrL&_nc_oc=Adof0yLXXbEKNJoXqLR-o6pusDCOww-EfGpEB3Kpja7KDaca35ijnBrJ53NmMZCRRfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwEP9mYC_DNnyyCISgiuy0ZWvF3qGfznCTctPFI5Ys3w&oe=6AF71C1A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLokUwDxro8Q7kNvwEP_bTw&_nc_oc=AdqWRYm2oQp-V2Q15dYrCUjkx2Midk53VVr7tL5PlB6a48SIonDM2y2pa2t43EBIcIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKFZnlnJjr8tcxH3gAm73PyvzzhKKHZ2lJpJgbPUvzLQ&oe=6AF72CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vuKaGA9ercQ7kNvwHqJ1li&_nc_oc=AdoY9VtaJLsAk2-ySDnMNBYY8VP9eBYhfVawOw0lyUdhmEKSDF6XiW7JmEDCcnsK0Bg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEy-H6nDXBv5TaV4KgqLmnT1F5ih2KDRIf3mK7-tgLyg&oe=6AF73F07"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
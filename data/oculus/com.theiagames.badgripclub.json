e=6AE4A720"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIgkZsAYKxgQ7kNvwGSLFHh&_nc_oc=AdpOmBaiyBy4kuun4x7dEhwl9sHZ2kskYgw3ahKjTj0MFU5YqyecrpEh3eOJQGAoWqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxmnF-87N0xlS0EFxuosI-EUo755ZhWyNUhhnhh011uw&oe=6AE49578"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riF2t7wQHPcQ7kNvwFUysUp&_nc_oc=Adrd2g5sFJvWdMmqy4m2eEBHplXqMWEz9HUu3oNVCqpfaZCWI-9laBGPNfgLddzT5jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGxPkSgcdzdN-DjZn173H7zaAO9RK-v6txqSaeR_xFlw&oe=6AE49197"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJVz1RkG4wgQ7kNvwEKFhQi&_nc_oc=Adph3_2Vrky8sIFurNaJXevdOyHEMBsYycE8DO4MF4gbP56E_ZE2kMhH5aPg39yTGXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObqqwDSsXfykhUIfEWk8GEoqzVyAunylnq-KGzP3corA&oe=6AE4A71A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IosC0YNThVoQ7kNvwEcvp7z&_nc_oc=Adpq79Tmja5S6ZtH9zrG3ygGWnQu5biwRr5m2Xi7U3jjRIJZpdAQxsGF0sHHmvzpigA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyt-_bKlSj7t6VJonr-sgu8d9kSlf7X0Kuq86Uf5Fzbg&oe=6AE4B7D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG9rqDZgIBEQ7kNvwEloYmG&_nc_oc=AdpjvFv01htIwfuUrQfyxwy1t3PYVnGNFBSgYoA04wPhLmZRkXz6i38QR235lNxwJL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM7Lxq0MyQyAZcELBu3ImbZ-3JR0mkLH5Cy5-5G-f-zQ&oe=6AE491C7"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
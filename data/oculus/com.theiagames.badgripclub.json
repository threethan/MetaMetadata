6AF47920"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYmaf3tfuiMQ7kNvwGh_GD3&_nc_oc=Adqtw-xCBYFmJbF-sNrCbe2hOzoneOtrB1gPpPZLjz_cA6Nf1nchAyUtfQRaZE90ZF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcGsRcTmNFRI0WspQaohsZEUgqrqEvA93CGU9s6Bvq3A&oe=6AF49FB8"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh0DsFJSwOEQ7kNvwHkoAax&_nc_oc=AdoT3XYuHkzHw2XtQ0fsgXY8YML5eir7dRX_VsAjyZGBOcsP8ljGli5WEWi0kzd6RLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsi_MA_8kech0wqp7nrdRmqZ3YFSZE7JvsCsYU5kbC1w&oe=6AF49BD7"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWLE2L4ziz4Q7kNvwFA7FQI&_nc_oc=AdohVGtvMWosmKDHTXussVOGis_OiX8xATp3AT2AtZiYm6B0Ej_dQpkL_a1vkoEn294&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDKxkrUHTLNyCU0SfN-qQ-N_XQ5K2qp1zNmshqY-y6hg&oe=6AF4791A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09Uhw5Mr_84Q7kNvwEA-tkn&_nc_oc=AdquXwyFYt5d1dM9FY8j_JuKFMEBAxcjiZCwYb7sN-jJS73ooaQHUb6zsMk2rGul_dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1bKRMmzVpsj4WoNGOU6EsSSic4TIsP2kfawSL9Midig&oe=6AF489D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vuKaGA9ercQ7kNvwE4_JuZ&_nc_oc=Adob80YL2dLKYOKctvfIB8Y8LT12Gdeko_6j1tUgCW4ngQfBVKjuqUk8izpNFTA24Yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8edHYt-700hycSVcIw7d_XWQaO3bXLynqvuAvVejvMw&oe=6AF49C07"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "contex
e=6AF5CAA0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYmaf3tfuiMQ7kNvwHLc3Cx&_nc_oc=AdoRja5P1g9j_BTWpY0r43gtFe4LB1igV2gKJ4bK7lbRJHAKtd2BomJuFRkO2yw6p7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0gRRe8j1ElPacRRgnG55EEbpTVPqHmvAerg7ZLi4ncg&oe=6AF5F138"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh0DsFJSwOEQ7kNvwEKqEiz&_nc_oc=AdovRml2-aBTJcX5TpnVacFnoRXrJcu3p4cUmFcY-kHN9qkpw8DRNKH6b1zW9MmGEo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2DIapC0KdDUDaIQ6ZfVPmb1EUHiO8vpRRtUziBgcY0g&oe=6AF5ED57"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inyFAXS1evsQ7kNvwH-w1ta&_nc_oc=Adp2XEIZJn67H3_VSSu1IPUAPxmlxaXi5i2R0yVO9n-jlkoyecj4StdDL_wdv5ReQFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnjCx6vXRwzxvZhP0NtLt52muwrX_wviXab285Rv-EwA&oe=6AF5CA9A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLokUwDxro8Q7kNvwF99qu5&_nc_oc=Adr0bZRGQ2GUUyZ6O-RQ8poYKtj9NjlsE9aD5c98IoVU_z-oQmJiSvpdgeLZuQ2yL_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy1MRegN8IYorozK77oXPTyQLlwj0mfY0QXjbwysbidQ&oe=6AF5DB55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vuKaGA9ercQ7kNvwFyhcxC&_nc_oc=AdqI3HmJiw62HCQzlC2z_fJpGWhgQpQj9jqiOazRgbFlf4AWhO4R3EeG0aWdnc1Lygc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmFArj-MrNwUQ2LPGTedSJrF0k72CLO3nq8srA5djjFw&oe=6AF5ED87"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
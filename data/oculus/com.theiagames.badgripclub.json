e=6AEDE1A0"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mWpp1i3vFwQ7kNvwF8gLQO&_nc_oc=AdqYXti8MJcr7It6JlxarTZJi0LVkVFezzqXyfQFADxHKIEFR1n4aNVEkHxmFJbqxxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv_Pw_cgGbmCh0YnYodWa50913oI9Wn6Rzy7L6iF51UQ&oe=6AEE0838"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTF8oLdk7dUQ7kNvwE5QdlE&_nc_oc=AdqQB1ykHwg94rsQJoxzzqpuait257eKnR_jy1tatG4RN8EcDIqICiPPye7HSbnSUBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfMHBCdyPr9tKjOjyt6DkBS-1J9eBJudsXENyWC8bHgw&oe=6AEE0457"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGElfKHBA6wQ7kNvwFm2nj9&_nc_oc=AdpJq1CC_PLOR1x5sIgokyWOY4unuKGhlO8dNcwyl1ow2w30ndJwH6M8hCq59XmBCwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpS7ea1gMTP3KHL7U6iN8wCeKT6KT-uihLb4duI5goFg&oe=6AEDE19A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgULm9XredEQ7kNvwGFRgm0&_nc_oc=AdrChkXNPXUz7nl9-GqimoI283Q-EqtL4XVd3G4FwRs2hjSYxc92a-hUHe6tDvJBvMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBN5V5pu7wLz9ry1svlJRzp-jN5u8KZMCRBdBuiyrv5g&oe=6AEDF255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFCCuAu_ij0Q7kNvwEkbgZ3&_nc_oc=AdpzxFmglRuG1V0sjw-FJogySDqWNVFqz_2JmlZ1zj-C74VuHx62767bT24Y1XqprPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlmNNFfCsOUSkN6Nvv776floKk9O8iuPmeXBL24IlehA&oe=6AEE0487"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
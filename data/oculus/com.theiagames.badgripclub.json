e=6ADCBE20"}, {"file_name": "bad_grip_club_04_2560x1440.png", "id": "1531056698419582", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313063_1531056705086248_1203277692154211219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiYv_9RCU0MQ7kNvwEmIG3m&_nc_oc=Ado7r4U0GWznqH_WNmwF4CiLOEKTvrTnJwQ05gJ-u820mJEjJl-WpYdVUrPKqX1C1hc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8a5JWyZrYRr4dw2X2h4uLL20WPH6w_OSrwlo9hq5T6g&oe=6ADCAC78"}, {"file_name": "Screenshot 2026-05-14 at 14.33.15.png", "id": "1867703684642976", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_1867703691309642_1408711567496764734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjmx2IFLo6cQ7kNvwE9UUyL&_nc_oc=Adrg4-ezjre-jEyXBjWwwn7VCJu9crbT7JnXD0Q3m9_xY2FQyPzIpicbwrfVThnKYUI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwExizKJkwthT5RoiZ-A-GGV1LBE-sOpycMz1Mng5NcA&oe=6ADCA897"}, {"file_name": "ice.png", "id": "1633903161431943", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823905_1633903164765276_1107170422501788167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ8rGibDvkYQ7kNvwGdsIbJ&_nc_oc=AdpCy_VsrHOxIg9YhijicdlVnPud2wTjEBB8qkotrXW_Hzao5Z1HJCgRR6iGYDybcDs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoh3p2IYn3XL3WgYhOL3TGVSKJxPVuyee4wiIZ9-jt1A&oe=6ADCBE1A"}, {"file_name": "forest.png", "id": "1071776495709849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828028_1071776499043182_4604604871953982035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RxPImrIAfQQ7kNvwGKRf74&_nc_oc=Adqe2_6RMdI11l-SvT9XQzhI3Wf6hsl0ZjGFu49TylgrGf-pJMxTt43A2-QguymnlYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMORPcFK9QFHr6cFOLY77EeKuDcmZv1ZUVyqmmQf0DJzQ&oe=6ADCCED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "1794803055189013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825345_1794803058522346_862275323348482313_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf3JZjxyQYcQ7kNvwGBvZLV&_nc_oc=AdrNtwdVClSB0N01ej5l1APXatfrnJ4PpumO9MoJRr5pbxmMppysgt7a_ut7CkeYVsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMMJIWSOr9FjCIg-jXZpWKCgrtBahddc__YbqnxXPslQ&oe=6ADCA8C7"}, "display_name": "Bad Grip Club", "keywords": ["climbing", "multiplayer", "physics", "adventure", "coop"], "long_description": "**VR IMMERSIVE CLIMBING**\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive yet comical crash landing!\n{1412392577730003} \n\n**CO-OP WITH FRIENDS**\n\nTeam up with friends and coordinate via voice chat. Share items and pull each other up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n{1079353631517972}\n\n**DIVERSE BIOMES**\n\nClimb through cartoonish pine forests, glaciers and volcanoes, each with its own hazards. Cross giant gaps on ropes, and when night falls, light a torch and keep going in the dark.\n{3037720806608569}\n\n**NEVER THE SAME CLIMB**\n\nRandom loot makes every climb different. Chug an energy drink for a stamina boost, use peas to fly over a gap, or take a break to roast sausages at camp.\n{1123987396811896}", "short_description": "Bad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope. Pull your friends up, use quirky items, and survive diverse biomes. Can your squad reach the top without falling down together?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
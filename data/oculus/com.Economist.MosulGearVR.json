mage.png", "id": "2965897510140001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504691_1538076806501127_1592255168_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gHasWX5oG0Q7kNvwEPVVV6&_nc_oc=AdnpK9OrWOYllQNxRH8J1uBCmtRFw520TNa1CI8qTTwFVTATt24xwdJTGgrDuNjfKdg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftB1qWzxZdlhnVZmJZOzlDDtwDC_EpjzuFpV2ilSnnApQ&oe=699C41D0"}, {"file_name": "migrated_image.png", "id": "764231927439237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138898_1696443677283342_1693109109_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjf5pLBZlksQ7kNvwGshpQ-&_nc_oc=AdmBp3j30B6y5-r7Meujsn6mtiw613Y6Jlz0Rr9ZZ6vh9P8pbus0eS7_y2ZLy61bNX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucE1VXW-Qsfr7bzvtCzWUa_e1xS6S2tukri9TkP1BmZw&oe=699C5B0A"}, {"file_name": "migrated_image.png", "id": "138812284225645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680264_1620558368271892_1484809645_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-4loIP-CS4Q7kNvwG5fAt9&_nc_oc=AdmD4yZHkJk17QTeTwKx1SnEgatVDFsZz_r74n1PlMIaIUUE2rfeIFYaBw2hbeFt8z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6J07G7tlyrO6AaTrHiuRn0OQ0tbu2TE1SF7GOKQ8aDw&oe=699C4840"}, {"file_name": "migrated_image.png", "id": "597643347457298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12448840_1561342750826781_1226998868_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM0QupOH-cgQ7kNvwEzb9LZ&_nc_oc=AdmyHkYmY5b0LUukrmlKylVhQuYuwtldmFoIGVTqM5ZsydkNTDdGJ6gReuqzlceg0NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuG8llN7S4T_YQcO28DI3kUA-AvzT7at4sbp6knf8e5aQ&oe=699C561A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RecoVR: Mosul", "keywords": ["RecoVR", "Mosul", "Economist", "Journalism"], "long_description": "Welcome to RecoVR: Mosul, a collective reconstruction, the first virtual reality experience from The Economist. RecoVR: Mosul takes you on a tour of the virtual Mosul Museum in Iraq to showcase the work of Rekrei (formerly known as Project Mosul), a heritage project dedicated to restoring lost cultural heritage through photogrammetry and 3D modeling. The tour highlights antiquities in and around the Mosul Museum that were destroyed by Islamic State in 2015. It tells the story of their destruction and explains how The Economist and Project Mosul reconstructed the antiquities and built the virtual museum. RecoVR: Mosul was created by Ziv Schneider and Laura Chen in The Economist Media Lab and premiered at the International Documentary Film Festival Amsterdam in November 2015. This version features additional VR production by Visualise. We\u2019ll be posting more virtual reality experiences from The Economist soon. Please be sure to check back.", "short_description": "The first virtual reality experience from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/RecoVR, Mosul, The Economist, VR, Virtual Reality, Reconstruction, Heritage", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "871959816831630"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "984654978347770"}]}, "baseline_offer": {"id": "984654978347770"}, "is_
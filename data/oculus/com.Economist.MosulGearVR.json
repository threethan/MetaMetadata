d-jtiM9rU0QoJ-VprVoc8HThxo-9QwvC_iF2DTJ5fKO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUneeEZZ2E-TdYIxrdVAfj8jJgp5fLHIVa9VLcGpmOIA&oe=6B0DA480"}, {"file_name": "migrated_image.png", "id": "597643347457298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448840_1561342750826781_1226998868_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy43G6nax84Q7kNvwGZLwci&_nc_oc=AdpC3EOA44K5BB1luHxIochEKXidIxo5yRTHjguwMEzkTWEqXQpGGAlHyNSr-VCp1AI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXKbq0eMYGloC7y_FLFvN2PGAQltqoeO6KIj0KOLUSKA&oe=6B0DB25A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RecoVR: Mosul", "keywords": ["RecoVR", "Mosul", "Economist", "Journalism"], "long_description": "Welcome to RecoVR: Mosul, a collective reconstruction, the first virtual reality experience from The Economist. RecoVR: Mosul takes you on a tour of the virtual Mosul Museum in Iraq to showcase the work of Rekrei (formerly known as Project Mosul), a heritage project dedicated to restoring lost cultural heritage through photogrammetry and 3D modeling. The tour highlights antiquities in and around the Mosul Museum that were destroyed by Islamic State in 2015. It tells the story of their destruction and explains how The Economist and Project Mosul reconstructed the antiquities and built the virtual museum. RecoVR: Mosul was created by Ziv Schneider and Laura Chen in The Economist Media Lab and premiered at the International Documentary Film Festival Amsterdam in November 2015. This version features additional VR production by Visualise. We\u2019ll be posting more virtual reality experiences from The Economist soon. Please be sure to check back.", "short_description": "The first virtual reality experience from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_term
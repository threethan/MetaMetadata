VSk8f_Ts3apt2cit3gSsykJk6hN1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvrmvrHSjb8PhqEsuBQOkXzhVAgi9YAXB7Q_QAE2Rn-Ew&oe=69A42965"}, {"file_name": "migrated_image.png", "id": "1076103536080703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138848_1907222076178618_9124499072202309632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Con47HJUlmkQ7kNvwFP9RNV&_nc_oc=AdmApKhObuQ7A9x09fdu-y1zDMdc6OqHeF8zJoXhq6REwp0stdjrL9eFop7bduMsvW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuOYdw7zKsQ6itSjU70rl9BtGreF26p2zxm9e5uDj8b7A&oe=69A42EB5"}, {"file_name": "migrated_image.png", "id": "145928616714821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386450_1744330335896357_6338900914581012480_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP7fSqytLW4Q7kNvwGkyxYA&_nc_oc=AdkxjGIDKGIR0sjTn3vPfvHNFP-U07vPbFfN49C0Nfg0hcsf1YdLeee_3tS4hwvMGks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsHMh7pEFkiT0AggffVjsPRPLKwO2algO3KBNYLXkgwHQ&oe=69A4300A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Economist VR", "keywords": ["Economist", "Hyderabad", "Osaka", "Oceans", "Mosul"], "long_description": "Welcome to the Economist VR app, providing access to VR content from the world\u2019s most influential news publication. Featuring:\n\nPassport: Hyderabad\nHyderabad, India's fourth biggest city, is fast becoming one of the most exciting visitor destinations in the country. Its booming tech scene is attracting global attention and transforming this ancient city into a cosmopolitan hotspot.\n\nPassport: Osaka\nBright lights, bath-houses and seafood markets \u2014 explore Japan\u2019s second city with a local who knows its best-kept secrets. \n\nOcean: The mystery corals\nLukas Isall of the Palau International Research Centre tells the story of some of the world\u2019s most beautiful and mysterious corals. \n\nOceans VR: Net positive\nExplore the case for limiting fishing on the high seas, from the viewpoint of diner, fish, fisherman and policymaker. \n\nRecoVR: Mosul, a collective reconstruction\nTour the Mosul Museum in Iraq, destroyed by Islamic State but recreated in VR in conjunction with Rekrei, a heritage project.", "short_description": "Virtual reality experiences from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "DOCUMENTARY_HISTORY", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3122345907984451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974695_883758371985484_2124568721870553088_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZmwHCa9ULYQ7kNvwGi-N57&_nc_oc=AdlsrTLkxZolKTixz55XspeYlGyP3hKqDMvpY0f6kCtdHlRZVw2HdvOTY9LyN6FOW4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvqsnyprpK7JYhEpDuaIsxHVwQe75wiJAi5ANGlrZBUdQ&oe=69A42B2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Economist VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1477551600, "lastRevision": {"nodes": [{"id": "943708629075548", "release_type": "SCHEDULED", "administration_status": "
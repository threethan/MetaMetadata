a0a&_nc_ohc=DyWyhdq_yGoQ7kNvwGAQoQc&_nc_oc=Adnl_W-ExA0bAldomhuXf09hdjwXzluqFqa5K1WBi99vdWa2AuxHG616CJZ2F3Vbmos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx29fA7FzM1WSQolbNfX4I1rtb0d8dUM0YZeC2hEsoIVg&oe=69BD35E5"}, {"file_name": "migrated_image.png", "id": "1076103536080703", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138848_1907222076178618_9124499072202309632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A5iV8p89r4Q7kNvwGXqJah&_nc_oc=Admv_45c08rwdR_XdTwr1u2v2L71hW3xo74u81zp3v923U6W2hda2Ni_mVIhN1k3ZhQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzD1wPRkXuUQKwDDw1WCF94-RKeAbLQiXOVTcNwmThXg&oe=69BD3B35"}, {"file_name": "migrated_image.png", "id": "145928616714821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386450_1744330335896357_6338900914581012480_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39XDeU2J8lwQ7kNvwEkNH2D&_nc_oc=AdkRl50jZImOke-NtM8tBAyCSn1qy03JfMRl60Rh5hFQeoLe_lQDS36HdNmQANd2jyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYmhJsYWvk3z_4Y1Op5cevCpSnBCJvf6SICf5Bo7m6ZA&oe=69BD3C8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Economist VR", "keywords": ["Economist", "Hyderabad", "Osaka", "Oceans", "Mosul"], "long_description": "Welcome to the Economist VR app, providing access to VR content from the world\u2019s most influential news publication. Featuring:\n\nPassport: Hyderabad\nHyderabad, India's fourth biggest city, is fast becoming one of the most exciting visitor destinations in the country. Its booming tech scene is attracting global attention and transforming this ancient city into a cosmopolitan hotspot.\n\nPassport: Osaka\nBright lights, bath-houses and seafood markets \u2014 explore Japan\u2019s second city with a local who knows its best-kept secrets. \n\nOcean: The mystery corals\nLukas Isall of the Palau International Research Centre tells the story of some of the world\u2019s most beautiful and mysterious corals. \n\nOceans VR: Net positive\nExplore the case for limiting fishing on the high seas, from the viewpoint of diner, fish, fisherman and policymaker. \n\nRecoVR: Mosul, a collective reconstruction\nTour the Mosul Museum in Iraq, destroyed by Islamic State but recreated in VR in conjunction with Rekrei, a heritage project.", "short_description": "Virtual reality experiences from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "DOCUMENTARY_HISTORY", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3122345907984451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974695_883758371985484_2124568721870553088_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDhenJ5h9-YQ7kNvwGeqFTw&_nc_oc=AdnkpUy_A6NjPFKRT4KKy3URuyQjKCEfUzGlRsxUs2eqeLQaY0OVC2YDG0VNHTbUqww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoEK_UF1TgAKKaGpjm3xpO5e0EmiQAv33EvA1hCWJ1lw&oe=69BD37AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Economist VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 147
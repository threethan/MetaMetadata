a0a&_nc_ohc=Haq18Q1Mr-kQ7kNvwFPJhCb&_nc_oc=AdlW7MxgNxnU0H_UBmBNF8Rg052xUqkk6Gl6xdj48BDLq3vlNY6vInTm8D7eOoB5Mhc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH31g8d1uhSs12C3xissbEwpSxYwkr4mQtqgmeb2ZTXg&oe=69B69E65"}, {"file_name": "migrated_image.png", "id": "1076103536080703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138848_1907222076178618_9124499072202309632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JAn3hm3PZYQ7kNvwHED8_E&_nc_oc=Adn0sNvG8dTaFBbSuQg9JVZDZubgP9_iWAM_lb-68qbLRS1R5GzzQqHP2zB9YX-u5PY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN43S9YLtwazysY0pR6Dc_Ek-JjJvoIOvhEHIWP19O2g&oe=69B6A3B5"}, {"file_name": "migrated_image.png", "id": "145928616714821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386450_1744330335896357_6338900914581012480_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNkz3dea8LIQ7kNvwGjTp_5&_nc_oc=Adlxef0x0gyTDo6kTA3IU8ocd1xMJX6_VmE6pu65ogbCTW0B_nUJajpFhKxCkJ9F_R8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySvY0iiBlXudKc08rni7AVQTJRdymZIWfn7LcWZCTFMw&oe=69B6A50A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Economist VR", "keywords": ["Economist", "Hyderabad", "Osaka", "Oceans", "Mosul"], "long_description": "Welcome to the Economist VR app, providing access to VR content from the world\u2019s most influential news publication. Featuring:\n\nPassport: Hyderabad\nHyderabad, India's fourth biggest city, is fast becoming one of the most exciting visitor destinations in the country. Its booming tech scene is attracting global attention and transforming this ancient city into a cosmopolitan hotspot.\n\nPassport: Osaka\nBright lights, bath-houses and seafood markets \u2014 explore Japan\u2019s second city with a local who knows its best-kept secrets. \n\nOcean: The mystery corals\nLukas Isall of the Palau International Research Centre tells the story of some of the world\u2019s most beautiful and mysterious corals. \n\nOceans VR: Net positive\nExplore the case for limiting fishing on the high seas, from the viewpoint of diner, fish, fisherman and policymaker. \n\nRecoVR: Mosul, a collective reconstruction\nTour the Mosul Museum in Iraq, destroyed by Islamic State but recreated in VR in conjunction with Rekrei, a heritage project.", "short_description": "Virtual reality experiences from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "DOCUMENTARY_HISTORY", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3122345907984451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974695_883758371985484_2124568721870553088_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xS2atZbF0gQ7kNvwG5gQQv&_nc_oc=AdkbCmHz1KElXeIO7scPkt_zFdRb68jp5VQQ6E0TL67JXETerBxPAjeU7hNJpuEKAcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeW6Bt4hw6CSrOkB-ZN0CWAYXVtwnWB1FR-KX_4ljpYQ&oe=69B6A02A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Economist VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 147
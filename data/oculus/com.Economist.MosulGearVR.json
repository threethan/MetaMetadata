.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WLc86OAqzoQ7kNvwEXchiJ&_nc_oc=Adq7q0er_Oi7f-zOTfog6hyY-kaRgyOTJQG4ypNSbInPXauT0rgaKQMGLH6yfw30oTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMvQ9dPXnulFTn1Z9BRqeQr6CAUlJDp97ViBUWxV26LA&oe=6ACBB1A5"}, {"file_name": "migrated_image.png", "id": "1076103536080703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138848_1907222076178618_9124499072202309632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pjSo3LF9OIQ7kNvwHxCD90&_nc_oc=AdpfotkZ0jFzs6j_0NGfomN9BS_VYEbynNN0-H4dQx4J5sy6wTR6F3ovEXEiBq0ExcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkHKx611pgXKtL95ENtVe5fpJIulEp2QwP2MauQtsNYA&oe=6ACBB6F5"}, {"file_name": "migrated_image.png", "id": "145928616714821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386450_1744330335896357_6338900914581012480_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0vln9-uSoUQ7kNvwHSFccu&_nc_oc=AdrvklVk8tPIEAvGCWaLPYvhn0wasJJcoFchcXXkARStud0JJjt90SVsuCenBoPtyTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPATuCAH16pVril8bk8nZZIjPVPcqD5Ar5_5khHt1g-w&oe=6ACBB84A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Economist VR", "keywords": ["Economist", "Hyderabad", "Osaka", "Oceans", "Mosul"], "long_description": "Welcome to the Economist VR app, providing access to VR content from the world\u2019s most influential news publication. Featuring:\n\nPassport: Hyderabad\nHyderabad, India's fourth biggest city, is fast becoming one of the most exciting visitor destinations in the country. Its booming tech scene is attracting global attention and transforming this ancient city into a cosmopolitan hotspot.\n\nPassport: Osaka\nBright lights, bath-houses and seafood markets \u2014 explore Japan\u2019s second city with a local who knows its best-kept secrets. \n\nOcean: The mystery corals\nLukas Isall of the Palau International Research Centre tells the story of some of the world\u2019s most beautiful and mysterious corals. \n\nOceans VR: Net positive\nExplore the case for limiting fishing on the high seas, from the viewpoint of diner, fish, fisherman and policymaker. \n\nRecoVR: Mosul, a collective reconstruction\nTour the Mosul Museum in Iraq, destroyed by Islamic State but recreated in VR in conjunction with Rekrei, a heritage project.", "short_description": "Virtual reality experiences from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "DOCUMENTARY_HISTORY", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3122345907984451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974695_883758371985484_2124568721870553088_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAo4JyP06FIQ7kNvwHLPrMi&_nc_oc=AdqB20oH0_PbUqyqBqmIPsvPamg9Oycm1EtmkJ1Maf51wHLzUH1JBIWlb9gszKpEf5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtXidvx-xACMP4yRJzV5E1XUyvixWxXL6-kSYil4rlnQ&oe=6ACBB36A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Economist VR", "platform": "ANDROID", "context_catego
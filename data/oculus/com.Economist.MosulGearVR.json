mage.png", "id": "2965897510140001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504691_1538076806501127_1592255168_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgfLZTIVmvIQ7kNvwHLj2Ci&_nc_oc=Adl-7yeJlVjd5RvGw5PUXdVDQcEguD7EkcASwnOGaJATTnTtVYqsMWVkMosxujM45-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsLIwdbq2w1wdxy3y2olOx6PRnaPAz0hI1ZgNimV9PtbA&oe=69A03650"}, {"file_name": "migrated_image.png", "id": "764231927439237", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138898_1696443677283342_1693109109_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfQuG4j7qvQQ7kNvwFbmRBU&_nc_oc=Adngt7-AT_e-Y8FSsXS-J8J7HQix4qMMRxiZwQKPaT6JiFOUMUQrFOPurYZ4x4P1xyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu00zqkkevPuK5qk-9ZZQO1F2eolqOuRIb_qIY_k3ZHnQ&oe=69A04F8A"}, {"file_name": "migrated_image.png", "id": "138812284225645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680264_1620558368271892_1484809645_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFUYg4JSisQ7kNvwHYzfA_&_nc_oc=Adk1IC1tjyBsRoCP1gj_4UHZOtB_5kIBqeHM_ylh4p34T6KYtKoRms4ODDwy7Ty4MYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsn-MjOvY5HnItvHPndzJJ-uod7PzSJnZ8k-cbkJpgaUA&oe=69A03CC0"}, {"file_name": "migrated_image.png", "id": "597643347457298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448840_1561342750826781_1226998868_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8uOBbK_1fEQ7kNvwEMCr93&_nc_oc=AdktcXClnflLbCMfS4_htiIvPy9VnNBK_5fLv0U2KjVXs6sOQhHIaWCeOdNQi1lp_7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftH-kwi2tyoIzHHYr67JSZEtQVBIpyKC6bMaTEzDF--rQ&oe=69A04A9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RecoVR: Mosul", "keywords": ["RecoVR", "Mosul", "Economist", "Journalism"], "long_description": "Welcome to RecoVR: Mosul, a collective reconstruction, the first virtual reality experience from The Economist. RecoVR: Mosul takes you on a tour of the virtual Mosul Museum in Iraq to showcase the work of Rekrei (formerly known as Project Mosul), a heritage project dedicated to restoring lost cultural heritage through photogrammetry and 3D modeling. The tour highlights antiquities in and around the Mosul Museum that were destroyed by Islamic State in 2015. It tells the story of their destruction and explains how The Economist and Project Mosul reconstructed the antiquities and built the virtual museum. RecoVR: Mosul was created by Ziv Schneider and Laura Chen in The Economist Media Lab and premiered at the International Documentary Film Festival Amsterdam in November 2015. This version features additional VR production by Visualise. We\u2019ll be posting more virtual reality experiences from The Economist soon. Please be sure to check back.", "short_description": "The first virtual reality experience from The Economist"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.economistgroup.com/results_and_governance/governance/privacy/index.html", "developer_terms_of_service_url": "http://www.economist.com/legal/terms-of-use", "publisher_name": "The Economist", "support_website_url": null, "website_url": "http://vr.economist.com/RecoVR, Mosul, The Economist, VR, Virtual Reality, Reconstruction, Heritage", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "871959816831630"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "984654978347770"}]}, "baseline_offer": {"id": "984654978347770"}, "is_
=6B0C6B93"}, {"file_name": "05_pov_compact_1v1.png", "id": "1442224324761410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673645340_1442224328094743_5667332411827657017_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIV2wmp-xF0Q7kNvwEy6Kpi&_nc_oc=AdpiQY1r9o89Dk0889Mqaxi36jJcLKTcriKn6k2N1_FgDfHphUbnZIQMLwd0rNz9Gcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-hMF4nyTijaWLF7NVtEvAJ7xFsNTT3vjLA-kuu2hWvw&oe=6B0C4F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1113386211459426", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/772632092_1113386214792759_6304043394097676001_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTedFHEESEEQ7kNvwGJ7MkG&_nc_oc=AdqA8MK-lhUZUSj8i0lTf0hskrvEvbxl7hN_URYS7jPel9TJ70qSOf3IHPGMw9iFh10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTst6x8SIzG_DOvRD2caCmoJnMKzI8erD5HYfUXoJpLfg&oe=6B0C6D03"}, "display_name": "RealPadel", "keywords": ["padel", "racket", "tennis", "racquet", "sport"], "long_description": "Step onto a padel club at sunset or an indoor arena and play 1 vs 1 or 2 vs 2 against bots from beginner to pro tour.\n- Real physics: the ball comes off the back and side glass, the metal mesh and the net tape, with topspin and slice.\n- Your racquet like in the shop: shape, weight, core and face finish change how the ball leaves.\n- Plays in any room: the court fits your space and the balls can be sent where you can reach them without leaving your room.\n- Train like a pro: ball machine and coach drills (glass exits, volleys, bandeja, v\u00edbora, bajada, returns), plus MY DRILL. Pick forehand or backhand, left or right side, down the line or cross-court, and land it in the target zone.\n- Tactical games coaches use with real players, 1 vs 1 or 2 vs 2 against bots that follow the same rule: cross-court only, down the line, attack vs defence, no volleys, lob and take the net, serve and volley, king of the court and more.\n- See yourself: your avatar plays in front of you, with a slow-motion replay of every stroke.\n- Bots that read like real players: you can see the spin, the power and the direction coming from their swing.\n- Short set, one set, best of three or super tie-break, also timed.\n\nEarly access: the full game is free until January 31, 2027. After that the base game stays free, and the full game becomes a one-time in-app purchase ($9.99 / \u20ac9.99) for everyone, including those who download it now.\nNo sign-up, no ads, no personal data collected.", "short_description": "Real padel in VR: true ball physics off the glass, real racquets, and a court that fits your room. Early access: the full game is free for a limited time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infomemoniq-projects.github.io/realpadel-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Roberto Coscia", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=61596084852231", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1462669342490409"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4062517014053464"}]}, "baseline_offer": {"id": "4062517014053464"}, "is_approved": true
14090266_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NcMWaYoxqQQ7kNvwGiv4jy&_nc_oc=AdqWd5kFw-rG_CEzRgQF5ykPmJLue_NVpC69MR7OVIMg0yqPOjW2yl8g60gJRv0sEMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQP8UQdPP218d2MsNeM1Z-a155URFdUB_rWFoalH2MOQ&oe=6B1062A3"}, {"file_name": "Townkeep-04-Castle-Enhanced-2560x1440.png", "id": "2180555729336192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622186_2180555736002858_6270726006280708375_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dsUXv1QBlUQ7kNvwEgnWKe&_nc_oc=AdoM_Aiao_Wy-vdQtfNW3X5uL7EmSAse13xcs5HpzvdDsYBHH_VqSVf7TQ_EQEKcZBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXr66NNhUhZw_eDuZlEXxAKaDYu4QUptH-lhoFsRpi9AA&oe=6B103D98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Townkeep-NoLogo-2560x1440.png", "id": "1684499936626368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622184_1684499943293034_861309882947800938_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXByOzWlElIQ7kNvwFLxga4&_nc_oc=AdodmPBOL7UwRZn7N3qh7C_IccRQztF7fGVYpSvMjxXZ2MHQYWytQrLX43QUFebtufs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyK12ZAL9aWorw8rMDN997UAKkzp_mwghVB47nA4WoQg&oe=6B106527"}, "display_name": "Townkeep", "keywords": ["Sandbox", "Building", "Medieval", "Procedural", "Castles"], "long_description": "\nBring your imagination into your room with Townkeep, a medieval town builder in mixed reality.\n\nBuild with procedural generation that shapes houses, rooftops, towers, and architectural details as you add to your town. Start with a small waterfront village, create peaceful courtyards, or build upward into a skyline of castles and turrets.\n\nExperiment with different arrangements and watch your town take shape. Explore timber-framed houses, little docks, boats, trees, and flags, all on a virtual board in your space.\n\nChoose your colors, paint your buildings, and try different roof styles to give each creation its own character. Use hand tracking to interact with your town, view it from different angles, and adjust the board to suit your room.\n\nUndo and redo make experimentation easy. Save your creations and return whenever inspiration strikes.\n\n\u2022 Procedural generation that responds as you build\n\u2022 Medieval houses, courtyards, castles, and towers\n\u2022 Customizable colors and roof styles\n\u2022 Mixed reality with hand tracking\n\u2022 Adjustable board, undo, redo, save, and load  \n\nCreate a little village or an extraordinary castle town\u2014one addition at a time.", "short_description": "Build colorful medieval towns in mixed reality with procedural generation. Create cozy villages and towering castles in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1I1FWpavThZb6pIA1tZ5o3W8QeWMvy5y9cD4B5euZtNI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "http://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1685856906658145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771
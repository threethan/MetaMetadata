CgKy9Lnvi2Hf8zQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG_Z7uZc7KMtB_Xphu8rfY8XQOLGfzZUu7-M8aHgtsVw&oe=6AE49138"}, {"file_name": "4.png", "id": "3196526990552923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314351_3196526993886256_7408489207938938733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4R00a142hAQ7kNvwHUnRBk&_nc_oc=AdqOO4e9Y-5fGfSya2r6TuLOFrnil-xTNtT1T7tW0Ce6jLgAidxErVzYCRzcH5K7v80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIrplLVfEkxul5SQ1zt-GNxp649Nuw6juzElWzUSFHqQ&oe=6AE4C30D"}, {"file_name": "2.png", "id": "1765479704479814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1765479707813147_4752679550105436237_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj8q9ck1g7sQ7kNvwHQeCFX&_nc_oc=Adom8LpVp_fRATwaPzOBtl-DuWDj88RFZeyJrGSNj5qAPYWSg6e1qp5vIufmaybaUDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSi-Od-3U2hahgL3lhxf67QS7ZAGzsmvpoSX6tvMyiDg&oe=6AE4907D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Animal Hunter: Hunt & Survive", "keywords": ["hunting", "adventure", "survival", "animal", "wildlife"], "long_description": "# A ROUTINE FLIGHT. A DEADLY WILDERNESS.\n\nA routine flight ends in disaster. Stranded in dangerous territory, you must hunt, gather supplies, and grow stronger while predators close in around you.\n\n**HUNT, TRACK, AND SURVIVE**\n\nFollow animal trails, find food and water, and hunt rabbits, deer, and boars. \nUse the bow for silent precision; take aim with\npowerful firearms, and defend yourself at close range when predators attack.\n\n**EXPLORE FOUR DANGEROUS REGIONS**\n\n\u2022 Jungle Edge: Learn the hunt and gather essential supplies.\n\n\u2022 Deep Forest: Survive coordinated wolf-pack ambushes.\n\n\u2022 Mountain Foothills: Face powerful bears in close combat.\n\n\u2022 Tiger Valley: Enter the territory of the ultimate predator.\n\n**DEFEAT ALPHA PREDATORS**\n\nEach region builds toward an Alpha encounter. Challenge the Alpha Boar, Alpha Wolf, Alpha Bear, and Alpha Tiger in battles that test your aim, timing, movement, and survival instincts.\n\n**GROW STRONGER**\n\nUpgrade your camp and weapons, build your Hunter Rank, complete quests, discover animals for your Animal Book, and unlock five Echo abilities: Sprint, Stamina Boost, Power Push, Sense Boost, and Iron Skin.\n\n**Wild Animal Hunter: Hunt & Survive** is a single-player, offline VR survival adventure built around physical aiming, exploration, progression, and close-range predator encounters.\n\nHunt carefully. Survive the wild. Become the ultimate hunter.", "short_description": "Track animals, master the bow and rifle, upgrade your camp and gear, and face Alpha predators across four dangerous wilderness regions. Survive a plane crash, unlock Echo abilities, and become the ultimate hunter in first-person VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1297043730166557"}, "review_messages": []}]}, "cover_square_image": {"u
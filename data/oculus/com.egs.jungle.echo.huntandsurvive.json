-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJObRSM9XgHwdamvacjsWa7xMtrJYmU3Cfz3h1-68dcUw&oe=6AABF3AE"}, {"file_name": "4.png", "id": "3196526990552923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314351_3196526993886256_7408489207938938733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctSmaUSV9RsQ7kNvwFCQvIg&_nc_oc=AdoxdbtyBS8R0v5o02Gt9DwH3IkbCbgIaClhz6Jx1SsQDgg1RU2Y1JrUh-3JDKmBMz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIheHzqMECdDOV1WF-tRWcKP5cJOs041Ov08ID6g1VcrA&oe=6AABDA4D"}, {"file_name": "2.png", "id": "1765479704479814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1765479707813147_4752679550105436237_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE8ZDg-GAfkQ7kNvwHdcqK_&_nc_oc=AdrTMbTxzEvgtX7aw1hAeAsl_21f64pIWBGWp1cd7sUSmpmW4NBmKVUkcNTyNIsZ-OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4fgjsJ9JoB_efyfCU6eflzoxcLnUxtOnJ6CEMPsZpVw&oe=6AABDFFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Echo: Wild Animal Hunter", "keywords": ["hunting", "adventure", "survival", "animal", "wildlife"], "long_description": "A routine flight ends in disaster. You awaken alone in an ancient jungle where every trail can lead to food, danger, or a predator watching from the shadows.\n\nGuided by the mysterious Jungle Spirit, you must learn to survive, hunt, and grow stronger. Draw your bow, read tracks, collect food and water, upgrade your weapons, and develop your camp as you push deeper into hostile territory.\n\nExplore distinct regions with escalating threats:\n\u2022 Hunt rabbits, deer, and boars at the Jungle Edge\n\u2022 Survive coordinated wolf-pack ambushes in the Deep Forest\n\u2022 Face powerful bears in the Mountain Foothills\n\u2022 Enter Tiger Valley for the ultimate predator showdown\n\nEach region is ruled by a fearsome Alpha beast. Defeat the Alpha Boar, Alpha Wolf, Alpha Bear, and Alpha Tiger in intense boss encounters that test your aim, timing, movement, and survival instincts.\n\nUnlock supernatural Echo abilities\u2014including Sprint, Stamina Boost, Power Push, Sense Boost, and Iron Skin\u2014to turn the jungle\u2019s power against its deadliest creatures.\n\nBuild your Hunter Rank, complete quests, discover animals for your Animal Book, earn daily rewards, and become the ultimate hunter.\n\nJungle Echo: Hunt & Survive combines first-person hunting, survival progression, mystical powers, and cinematic boss battles in an immersive single-player adventure.", "short_description": "Survive a plane crash, master the bow, track deadly predators, and challenge Alpha beasts across a mystical jungle. Unlock powerful Echo abilities, upgrade your camp and weapons, and rise from stranded survivor to ultimate hunter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1151306491406949"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1337501901925378"}]}, "baseline_offer": {"id": "1337501901925378"}, "is_approved": true
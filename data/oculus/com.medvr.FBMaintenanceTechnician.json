t-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1126691256450504_134527046774737293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOncIjC1ZegQ7kNvwFzQa1x&_nc_oc=AdqYf4_nHFVhQ6hcql4Pniupm3RH1Jgfj8XRPI5JnPKRPWmskh1na5CA50dI25rjX1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo1AY-TXSwF8tDIrMj8yLIevpmHBUI3FGtnNJ2leO7mw&oe=6AE21311"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facilities Maintenance Technician", "keywords": [], "long_description": "The Immerse Learn Facilities Maintenance Technician VR application provides immersive, hands-on training in a realistic virtual environment. Designed as a component of the Immerse Learn Facilities Maintenance Technician certification program, the application allows enrolled students to practice essential facilities maintenance procedures, tools, equipment, safety practices, and workplace skills through interactive VR simulations.\nStudents can develop practical skills in a safe, controlled environment while building confidence and reinforcing concepts covered in their certification training.\nIMPORTANT: This application is exclusively for students enrolled in the Immerse Learn Facilities Maintenance Technician certification program. Access is restricted to enrolled students and is intended specifically for their hands-on VR training.", "short_description": "Facilities Maintenance Technician is an immersive VR training application designed as part of the Immerse Learn Facilities Maintenance Technician certification program. Students gain hands-on experience through realistic virtual training scenarios that reinforce essential facilities maintenance skills. Access to this application is exclusively available to students enrolled in the Immerse Learn Facilities Maintenance Technician certification program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immers
ir hands-on VR training.", "short_description": "Facilities Maintenance Technician is an immersive VR training application designed as part of the Immerse Learn Facilities Maintenance Technician certification program. Students gain hands-on experience through realistic virtual training scenarios that reinforce essential facilities maintenance skills. Access to this application is exclusively available to students enrolled in the Immerse Learn Facilities Maintenance Technician certification program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1716866587106812"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1806284827379646"}]}, "baseline_offer": {"id": "1806284827379646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792138080, "status": "PUBLISHED", "id": "1806284827379646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1760117496115054", "version": "2.1"}, "id": "1649240346925998", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typ
c_ss=7f20f&oh=00_AQSgA_mT50hquVSJOQ36or5kZ-YWGUm1-dS6Z9WHKVUe3A&oe=6AEA0AEA"}, {"file_name": "5.png", "id": "4008391412805907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_4008391416139240_2549433525366724763_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4ueu2CJyT8Q7kNvwFMte-w&_nc_oc=Adqilo1yQwTRGOCjAWjsbL3JOuiIrwBHwBG-bUiil9GgHRdruI9AuyZNUXjxCZ4l1KE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNypgP4Czp-x3MYm8cBPb-OT_w_Uqx_jxhGXAf2fC17w&oe=6AE9FDDF"}, {"file_name": "2.png", "id": "1109301481280470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_1109301484613803_397059983357940007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIRchd092FwQ7kNvwEzW08l&_nc_oc=AdrrRR6Du_ErBONj0RExEwmSpD4oynU-45g59iSlUEeEdMOHwfSny87-6v3ehsgUTpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdSq3xcmdUWJI1U1wrsU1rpRQbVYfDVT9lWu_Ov0EWoA&oe=6AE9F7E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "948049484494496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_948049487827829_5663346083942508391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oRJfk49rxsQ7kNvwEwqZrJ&_nc_oc=Ado9sDjaSBS16ol9Rk-7MHkDUrswSHaRHJiObIv-VsvLGXhTkmjBkQfXjmCQBzfg9aA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRilCOZW0BUIwHIJetVlcnssWeVCbkpKJCmpY0qe8gHkw&oe=6AE9F876"}, "display_name": "Escape The Cube Demo", "keywords": ["puzzle", "horror", "escape", "room", "thriller"], "long_description": "**DEMO VERSION** Only Contains 2 levels \n\n# WARNING!-- Please read before buying\n1. Not suitable for people with disabilities.\n2. Since it also includes sound-based puzzles, it is not recommended to mute the audio.\n\n**FULL VERSION:** https://vr.meta.me/s/20kcVnSpMXSS6IY\n\n{941003565472736}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{791086930495623}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{2774330709585701}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**", "short_description": "Escape the rooms by solving puzzles and staying calm!\nTry to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38574143385564731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_1346611697205164_458564626899875839_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZJcoRkZg_8Q7kNvwHfQGdw&_nc_oc=AdoY8gXdOx3wnp6bBmP-zpUAex_r9QDSArH0sUtXgq4R_HfRgo3mMYiDoVggr-Nv7Pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20
luscdn.com&_nc_ss=7f20f&oh=00_AQEELD1FtTCOunIlDkmUsjkSlPYwrtl9IdIlBt-GvAdwlQ&oe=6A8EDB2A"}, {"file_name": "5.png", "id": "4008391412805907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824307_4008391416139240_2549433525366724763_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpeAuQwCb2EQ7kNvwEVKD7X&_nc_oc=Adr0EZRJAW3ZHkx6ubZscCYZTbIx76ceI4xLT67GsA4O-hPfGGyQSty9-8hRXVtVsr4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFgouxwn-mOpaNDN_IoIGX__nkp8K86oOITXGl523-Wg&oe=6A8ECE1F"}, {"file_name": "2.png", "id": "1109301481280470", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825497_1109301484613803_397059983357940007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V3U9vjBP6IQ7kNvwG5-8H_&_nc_oc=AdqVSAUEK2VG-DGDMKKPNZnusAvgF_TYxXI8A26xD3Fmys8XBvdQ7IlSRwN7IEPlsPo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPDDNLtobgqARfeobwscCFZ5-8uZzKlmC3Drc0BBcKCg&oe=6A8EC823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "948049484494496", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618432_948049487827829_5663346083942508391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NWasJJjsjYQ7kNvwGC0wHV&_nc_oc=AdpfVF9BT6ahXC1vsElufQV1XYObMryJDeqay6UUVfyexxpsoTBIUi9leeOvZ1BpDe8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaVNKRWFVVBRuH5RqQhF-9iL9fi8GmTibmkSukC9Z1Zw&oe=6A8EC8B6"}, "display_name": "Escape The Cube Demo", "keywords": ["puzzle", "horror", "escape", "room", "thriller"], "long_description": "**DEMO VERSION** Only Contains 2 levels \n\n# WARNING!-- Please read before buying\n1. Not suitable for people with disabilities.\n2. Since it also includes sound-based puzzles, it is not recommended to mute the audio.\n\n**FULL VERSION:** https://vr.meta.me/s/24gWkwhlZiGfGOn\n\n{941003565472736}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{791086930495623}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{2774330709585701}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**", "short_description": "Escape the rooms by solving puzzles and staying calm!\nTry to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35194645150181255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824328_1346611697205164_458564626899875839_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4MrkxP7PgQQ7kNvwHGbEgz&_nc_oc=Adpr-KdG7OCkPN9gIUsWt7EjTzqW_JptfWZDWme3-2Z4AgRmEnJHYfiQANBV0w2u6qo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculus
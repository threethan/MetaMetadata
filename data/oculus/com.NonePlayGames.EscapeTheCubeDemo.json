c_ss=7f20f&oh=00_AQRqRN4TkPmJ5Iv2dhTET7WsIaRwMlteqRqnB7dv-bZHoQ&oe=6AEB5C6A"}, {"file_name": "5.png", "id": "4008391412805907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_4008391416139240_2549433525366724763_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4ueu2CJyT8Q7kNvwGrPc9D&_nc_oc=Adp0hO7xMCjUx-xNM7gKFOtClPgkpxpejq-Nv94OOOCbGgXZUnaSEeMKuvO0qEx-Vps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWGMOYZCTr1IytoTIE8ROVmEb0wgPL8LpSU84QJrfRvA&oe=6AEB4F5F"}, {"file_name": "2.png", "id": "1109301481280470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_1109301484613803_397059983357940007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIRchd092FwQ7kNvwENQYvJ&_nc_oc=AdrmzVr4oWiA51CK4bGfYB5Y3a_ee9DDAL_egeRFyKZoBP0xHwMXlZfoC1o3zXBV9bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjhM3dqUGKCf1NcjUVdtHSyrj3gquGua-n6Ngc-AvymA&oe=6AEB4963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "948049484494496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_948049487827829_5663346083942508391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oRJfk49rxsQ7kNvwFcLYx5&_nc_oc=AdpgILh_hmqIbwQPbuxoBy-DXLNUivTyglNrZlypHj3VRAM72tdrUquzdVkSVjt_rQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmbiTZV9s6-WDdNxQYaPPooiE6Hs0pmwi1K4wWm4B_Dw&oe=6AEB49F6"}, "display_name": "Escape The Cube Demo", "keywords": ["puzzle", "horror", "escape", "room", "thriller"], "long_description": "**DEMO VERSION** Only Contains 2 levels \n\n# WARNING!-- Please read before buying\n1. Not suitable for people with disabilities.\n2. Since it also includes sound-based puzzles, it is not recommended to mute the audio.\n\n**FULL VERSION:** https://vr.meta.me/s/20kcVnSpMXSS6IY\n\n{941003565472736}\n**Strange sounds echo around you, eerie reflections distort reality, and an unsettling atmosphere surrounds everything. Experience it in full.**\n{791086930495623}\n**Sometimes simple, sometimes hiding in plain sight\u2014so obvious you\u2019ll wonder how you missed it\u2014and sometimes demanding intense focus and thought, the puzzles will test you at every turn.**\n{2774330709585701}\n**In a tense, unsettling environment, you must control your emotions while solving the puzzles. Any rushed or thoughtless move will turn the rooms into places you can never escape.**", "short_description": "Escape the rooms by solving puzzles and staying calm!\nTry to escape from rooms filled with unique puzzles and mechanics.\nThrills against time and an atmosphere blended with horror elements await you!"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38574143385564731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1346611697205164_458564626899875839_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZJcoRkZg_8Q7kNvwGyLDaQ&_nc_oc=Adpnr0F3cf3x6EO_o-nt_e3CU7WXof-oCgB76NQG8eIizH91cgUbOkdnHGvkK2DRJUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20
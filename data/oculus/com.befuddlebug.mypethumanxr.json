3mDhE1EbE7Lkz9jg&oe=6B0F199B"}, {"file_name": "09_three_arms.png", "id": "971062605524319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624583_971062608857652_3019064664754954082_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COT1YDl35FsQ7kNvwGwLrCa&_nc_oc=AdqcpCfCjnjOH8DU2_YmliiWRa_bsc-QXVzATRODlvEJeEvpI2P18RoxZMU1k1l801w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrUKL30t4_LvWWreQJroCyV6uBuSxLLqptNOpvAJeDlA&oe=6B0F0A4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Pet Human", "keywords": [], "long_description": "Congratulations on your new human!\n\nMy Pet Human is a mixed reality pet sim where you are an alien taking care of a human. A glass habitat sits right in your room, and inside it lives a small, likely confused human who now belongs to you.\n\nCARE FOR THEM\nFill the food bowl, top up the water cooler, and set out a bed, a toilet, and a shower. Pick them up, pat them on the head, or give them presents. Treat them well and they will trust you. Leave them hungry and they may stop working. That's bad because selling small human crafts is how you get your space credits.\n\nEVERY HUMAN IS DIFFERENT\nEach human has their own look and personality, and their own set of emotions. They paint, make crafts, work out, nap on the couch, and have plenty to say about all of it.\n\nEXPLORE THE GALAXY\nRaise your ship's console out of the floor and warp to alien worlds. Shop alien stores for gadgets, toys, and furniture, and enter your human in an art contest, a pageant, or a sports day where they compete against other humans in races and boxing matches. Don't forget to pass by and get a full human inspection to keep up to code.\n\nMAD SCIENCE\nMix colorful potions at the mutation station, shake them up, and see what happens. Could be anything.\n\nFEATURES\nPlays in your own room with passthrough, and gives you an endless array of unique humans to keep as your own. Fly to four alien worlds, each with their own stores and events, or head back to Earth whenever you need to abduct a new human to keep as your pet.", "short_description": "Abduct a human and keep them as your pet, right in your own room. Feed them, give them toys, and keep them healthy. Every human is different, with their own look, quirks, and moods. Fly your ship to alien worlds to shop, enter your human in pageants, art contests, and races, and mix strange potions in the mutation lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://befuddlebug.com/privacy_mypethumanxr.html", "developer_terms_of_service_url": null, "publisher_name": "BefuddleBug", "support_website_url": null, "website_url": "https://befuddlebug.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1458038844053735"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1138192665332892"}]}, "baseline_offer": {"id": "1138192665332892"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793554200, "status": "PUBLISHED", "id": "1138192665332892"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1458041244053495", "version": "1.0"}, "id": "1417683667118149", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
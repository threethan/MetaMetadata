y-COHW39TM5fLV-V4neqx7fA&oe=6A971CFE"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGIhHs3yEoQ7kNvwECULEQ&_nc_oc=Adp7hdpgzrZgecfG_sztwdM58mT5omX9GIVRyhXcrxfF-xoXL2YnNJoBtOFp9zNlyD8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHplzLLLTKa1L_cKL7VJsYkTzmkY0Rb7UzvdZOM8wH7xQ&oe=6A972E98"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE3k6UMttFgQ7kNvwG2V85q&_nc_oc=AdoZnjmECCLs9pxqZbiu5uSOkuCk0rG3SHd1kbM5VA4eK259MWa4eAg4ZbE5DSSntyQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFah3wy9i2cVZcoslxG2u3lRrNI1RvhXePakXSPalg-w&oe=6A97349A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB8OFCfJH34Q7kNvwHUx3tZ&_nc_oc=AdrO7O88qEp2ceGX1hCEb4PPR-S_IVou4CftDPscd1y9R0VWMkdCd6Br2jVVSr_NH6g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg9SGRKCun89pQomQ10BPuOFiw8r4XqLyulZkG7eNgkw&oe=6A973027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_ALKfiGfwkQ7kNvwFrKANd&_nc_oc=Adre-g1k9XSPxB0T9MOjrlWTq0Wb6XFKU8aWCGztCBr_Xv3heNI1-7jEt-tncv-X8qI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEirbXDhEm5au3J6_Ai4MZxzCReFS6YV3eDQ26CaKbQnA&oe=6A9733BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jLAYsKrF5a1SHzJKENhHfOnPJFgR9GIEkJxIj4Sku0g&oe=69D79498"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya2nj8foBCUQ7kNvwEE-gf5&_nc_oc=AdrD2zs2BQTrT_49HFq2LkP6pVn3uKtFh8yxnDtI0tmnEwJELBWzBOJMu_kZMhVpMTo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iqO8FlAxzLuU3UEMk6_6XpcS_buuBWQIdOYM_D7uz5w&oe=69D79A9A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIgAmvTrvFsQ7kNvwHN7oWn&_nc_oc=AdrEg53CAAsogSjL7qKmFrhyi9cIAIf2RKPPGXI2dQvS9Kfyb-TPOLsURWsLNt-FqgU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JHe6i42iJe5mrcX4gd_ViqJdjRzx0C9dgkXzW8z5KDw&oe=69D79627"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl5SVYNCixoQ7kNvwHuZnBU&_nc_oc=AdpcGW_z4jZ8jOsWjugX6doScEM-zdhVxqRXr54CRUPB8jiLplj9LeWZ3oMHa55REek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JTVZzm-rM_pYqJ1AqGEA6zb6C_Odat9rZRH_s_yoypg&oe=69D799BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1350778278803106"}]}, "baseline_offer": {"id": "1350778278803106"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687554000, "status": "PUBLISHED", "id": "1350778278803106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Android
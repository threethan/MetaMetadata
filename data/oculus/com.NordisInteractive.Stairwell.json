"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe4ygvBEFZwQ7kNvwHTHqT7&_nc_oc=AdmCwnC-E2P52G3RFzsbV6Ky631umcCSPf0as13SacKuyzCrnHyMAllJz4ZDj8Q4VNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6L5Vo_Wx5iY1Rux6c5jWHemTLPeveEmqxibI1qLof_Q&oe=69AD6498"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DNPnwh2YpkQ7kNvwHSdHnY&_nc_oc=AdmlJd2l5tSroNgqpyD5-2ba9QW0__wC2WbCQfvCWzbWBQaUJHQlpffjXeH23-xHO24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7Chbo8-P4rbIb32XOd3Mp9fdYQz7b0cyz5OjTQGho3g&oe=69AD6A9A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_qlp_5zlCYQ7kNvwFCG4Ky&_nc_oc=Adnl_74Rmxw8jfmKjFSJPrMPfIwvnTtk0FBmzuMYHmIQ4vdwwDiXoFEbDrpyjqxRHRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVPeHyGJYazR-fzK0b8Rsknp4rv7_oAfHKnJ4CGZp6nA&oe=69AD6627"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuj7bmC5ryMQ7kNvwGoLPew&_nc_oc=AdnzFYkstlQddjVhEeYMoFP4eclqoQUnFYdhu5VRlcRcxV8h5Th-iRK9bvc3qtbW8Kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkGNZRUI9tvX93Tx7KI6zvchwHyLimlCEv3XbC5c0Qqw&oe=69AD69BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6856754711024225"}, "review_mes
"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGGbOu-NDr4Q7kNvwHn0kWx&_nc_oc=AdlbmEwZVoneLeYzIfVrQir3nx9g7s4STTS8wzYdd_bUUd6kI1zoO7cnmnvf1uqF6HE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO8He5ARDPd-HP6mv7PE5KfigAU7BPvpWqVpusQkLukQ&oe=69B15918"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eO7j5WGMn0YQ7kNvwGlkPja&_nc_oc=AdkUmCN7jsuTuFLD7gk5KsBTf9X2x5NXeFWLK21KPjHXlB3XyFckh7FLTGnkaZ7luHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX3QDtuq_1ZpiWYH2R3fgzKgm4DD9Fl-qql5PsM7jPPg&oe=69B15F1A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDoirgOJy4YQ7kNvwEsg94V&_nc_oc=AdleGVLVNUXTFHHiSz5HHXzyJCXsLQ0HX21OtEMU4HcvREPzCpp1kD1Juwvh8YnxfNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK7vLN_VY7bdd_XSADBfUwHSTgvj14kDbdK6y7ZEm8Qw&oe=69B15AA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bQj6eFAoqUQ7kNvwHCLt7N&_nc_oc=AdmlBFQ2n1IHlqD65UKb1urQ9vhZb3Fc7npWBMOvGqaszxqf7Ys419XPFx4m2qdQ6i0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx65SYL_utEj1-bZVKwSJ6OHiEN3hAym4psLBGMXv8DJg&oe=69B15E3B"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6856754711024225"}, "review_mes
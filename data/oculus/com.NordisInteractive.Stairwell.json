scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LtMDTuu0yG65xn6YaENlOCBnkutkh-u9QkcqnA5IhQQ&oe=6A36B8D8"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDrvVuY1TVoQ7kNvwGP6BiL&_nc_oc=AdqccawK5melMGzSINakHC6p9O7TldFvttnWq9au5XY4adigVOHMY1XgOI4oqtvf5-c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TrN6F_frjLo4TfduFSa3-26SE7KiYA8hROeTDfMLTFg&oe=6A36BEDA"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqdqXO4m53gQ7kNvwE_tNFU&_nc_oc=AdovhfYhAFQ6c4HkFyXLTpMRSwGgLiJPBfDoDrDQSwKMMBVA44_wZi0duptx_oAm7J0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KoaXjyknULvjR0V4l8Cd8qJl1bYKb1h5KeyRoLWYTZg&oe=6A36BA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJzHusseEvgQ7kNvwHLN33A&_nc_oc=AdqRyvN_KjLXmVzb_GlDB33TujgGIJ12KEfmO-Zj-xTTmFRiiMC0vEfZcKQdLwcCcUk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EcD0HviFeLCTA3MEuOmNj4CjalS8iE-YEdNKz4PxLkA&oe=6A36BDFB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6939798972718490", "version": "1.91"}, "id": "782422676709751", "channel_name"
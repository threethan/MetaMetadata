Y1mGgj1tJHo4C0jrFa89C-t-hgnbvEKuwg&oe=6A8EC37E"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQruE3QqInMQ7kNvwFOkGwi&_nc_oc=Adrye7kWDiHxUB1AujY0pVZsPgkleI52UYbyMXXMhsV6IFFVojGQtPAwnz60XTbG5xg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_AQbk1TbSsCDDG3uSQ_q_foK1gLel3o46BqUVh3dl0w&oe=6A8ED518"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmGR5ukLAaoQ7kNvwH6ZKo6&_nc_oc=AdqnonjH5nTew-Zc9NSMWSLbUvEUD2Ys_-FtPQfgplbkE-C6vtGUiakK9VzCH1jqCKo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFngDOvHJZlYN2Zsi9cy65eYNBZZCrj8478SvvzznC4zg&oe=6A8EDB1A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eudqi-dFhhAQ7kNvwHYaLJh&_nc_oc=Adp1afS-Iezoi1zLok9EvEJbV81QQzCGHf5d42kCghhvECUwIJZ1iihDu4B7ljp6AVw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2gh8jSis6J2nTkYWzeakg-CuRuX-MtD2Ok5RSdi_xrg&oe=6A8ED6A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVNRAZOvHIUQ7kNvwHCg1O4&_nc_oc=AdobAtLDnETJ6zO-MG3XhV0MxbFUukLuRcPFQwAkRJcMe5h1EdjOg_8bbQD-K8fvHP4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuMW4-wpZ4AgfLIY5fsAH083RZUY_GG39MvgY59B0TdA&oe=6A8EDA3B"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
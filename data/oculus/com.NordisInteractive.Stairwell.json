 {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvlZ2oeIEEsQ7kNvwGANHXM&_nc_oc=AdlE9nq6JF1VM-v30HLRpTLG07ZVrB9Bz6hDXsQNgRry--Nqer1avIB9Qo1_5BLxdms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuVoxyqzyh0a3pBscDQw4l1qJMwCXYg8MnrkkBdYleHQ&oe=69AC191A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_qlp_5zlCYQ7kNvwEodnfA&_nc_oc=AdlLiqliLxC1KVokYf1NfNbu8u28B55J3j4wB_13pNapd6KCQ9w3dFTPGEjrLODbd2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJEjZRFGRBo7pPZqJTgevfe_KnqyPeEkcImoSwsnGvhg&oe=69AC14A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huJUs0FTiIsQ7kNvwGiO1-y&_nc_oc=AdlQ-5KERzGuog62o8_tD2E0DCyI0m_n622HPUqg8i-7jZ0t6EWimIpOEFPGMv22Up4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkAoYY4hgyphkJTnzGkt-NblleZQC0qukBZ62q2kbBvQ&oe=69AC183B"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1350778278803106"}]}, "baseline_offer": {"id": "1350778278803106"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687554000, "status": "PUBLISHED", "id": "1350778278803106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6939798972718490", "version": "1.91"}, "id": "78242267
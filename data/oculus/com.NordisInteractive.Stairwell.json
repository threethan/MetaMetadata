r4aV_hv2SPw1zq9U0Bupb5gA&oe=69F4BC3E"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO-Of5PQJZ4Q7kNvwGqJxrz&_nc_oc=Adp59pzprh8izqsZNsJcEcxh1j0S9UaWXGulFH8EI9HfZycjTc4vKVov82FgwdLAyNo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zfar6NP4UP0pUeeTwh18awN1tvjWligju2a-amZw1Fg&oe=69F49598"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40hoeCWxgjQQ7kNvwFNuxt-&_nc_oc=Adr_rCDYCwSU_ygr5XHJ7D3aXCRHtGkUC0IWAp56Xma2-SwBqxXU6pmolu6bhL3A3kw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OWpbANO6m8ShhCjhFvmtLxXi6QbinjGb8mAaFahIkNg&oe=69F49B9A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwMNp_EaTWMQ7kNvwEADbt4&_nc_oc=AdpLTZaylR4mqlkrYlsN7jy7U1uBZaiFdn_13TSfJxc0f5raLMJMCCKXscZpA5o9S9k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18VzkmfBx7yFjuuZcurtqbnm9yMUM7Z_5aN4ISwtoz3g&oe=69F49727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-3a8KTy4C0Q7kNvwEsLwPl&_nc_oc=AdpU5laaQIhT4lAqvmkcHSrW25O9L3q068loKXPmskbG47jnOlcL6ff6pYX8sFOrT8U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wbYvAgyDVYbRUOCDzXdcR2tXIfeoQspXYtWmb_aACFw&oe=69F49ABB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
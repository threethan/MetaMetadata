"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMfLkStYb-YQ7kNvwGDZQyl&_nc_oc=AdlZ79iruIZpngjl7_mMfAWl_fS2kWrIRPGXsUstdYsdk6wnZBBkWxsc33-6rDfDJbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwfi4Wg_-YR4e_Eyg25tuFyFgM9Awr6-Jjl9lS5NYDCXg&oe=69BE8818"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQQEvNkL7tMQ7kNvwELcgKW&_nc_oc=AdnJpbje7wE2HCQT7QUNURQhTdHCEms27OtWxFgbH_IjqGcBqGRLzQf2aCpr_G-oAxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGQKkju0Q6wWMy7_uSXN-1msK0QZsVVFe_ocbqIWQfHw&oe=69BE8E1A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAAWKg6G8mgQ7kNvwEYLvjZ&_nc_oc=AdmXNVh0BEQcHgs7nFgnqacjRaxPSLW3zFvyClYZkO8u_D4RuOXTA_jgJMB-GjL3MzI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-fTsrOqk4Egn1AnDoEFytaYbd0WpWvEDjONKhByPTug&oe=69BE89A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gaa8JOOslHwQ7kNvwGFc2on&_nc_oc=AdlPJh5v0Kk7XEsHCqVG3r9g-odJM_viaKkbKcnyqWJxHIFB1hS28ZgahtTRbKTlZPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5DuVdHLNR6RD5Df3_nE-Fu60PeNUGyeF_THg_9alpdg&oe=69BE8D3B"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6856754711024225"}, "review_mes
LYqcaYjV7fsQ7kNvwFyXNaQ&_nc_oc=AdnPq3VLMR1ZYYoEhJQ9GhH65xTGFGqoE2PKaVy4KDub70TB0c2CDpwZv0_vFrGE9lQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfttxZTUOhvGXi-wm-2JKo96i3ZoFpjIswuYQ5q9dCQaEg&oe=6998529A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cENPeluCyFsQ7kNvwFMCaPO&_nc_oc=AdnfijGGuRj-TqhA_2VWLFEkaQNa3i3EHbmt2gYjDKXDAQ2qH4aS0fmtKJle0Qg0IVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftwBoeO7abQPxhHtZ3mBn2W4prLRks6aRnVdS7doaHlXA&oe=69984E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IEeIYlBK6kQ7kNvwEAuz2X&_nc_oc=Admqgy7UcUKqNbIta66tEPqoC-PEP-IHLiweVwf3dSomLvt-YoBI8OYFa5RyUUyfcrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvUm5mQGHWQvqE42QjKP99T8HAjkdbuGmeMpPMwYJiZ4g&oe=699851BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1350778278803106"}]}, "baseline_offer": {"id": "1350778278803106"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687554000, "status": "PUBLISHED", "id": "1350778278803106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6939798972718490", "version": "1.91"}, "id": "782422676709751", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6694399563925100
"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yz4UR6bMaIQ7kNvwEh3Z8Y&_nc_oc=AdkufFN4pNB2Xmol7NyEUJvSAo1j-udbVlL5DOr9jxQ3nlm4W2bDiM9YxvJjNPnVtNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRSeMRgJawmACLWEjGe8rvdzousRjCC9YQRuwpeXRKMw&oe=69B54D98"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfAS67Qt5IIQ7kNvwEUsN1m&_nc_oc=AdnbJw4S2ywi6QKr5MNk2pW_RgPkepbDrNbS70t_vIhSZn0sy-YMnlma3D46C8B1szU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL1yCYnTlJSzHtXSgcP166uS1rSY-dCqZvt28ddhxWAQ&oe=69B5539A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQjEpLnQfEwQ7kNvwFatTiH&_nc_oc=Adlve5BDXOyCvazrYAqGuMLSBKojdM22V5Su8yPl7MZlFQGc4L76s-uj4e36oN2W9vk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9WH1nm4A7UhOCF8mJGioHvJfVNadsEbMneoxFGXFVsQ&oe=69B54F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMH6fOCCj44Q7kNvwFhSAPR&_nc_oc=AdmY6L4GsBKwrwKEcu6xouePFpDH73m52BkMp-pQKO-k07HO9DwazExPWoaBjTZh0bY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7gtmrOIZPOqRGHF9uvTeaUEH0dI2YBKJcxKKwcnC56w&oe=69B552BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6856754711024225"}, "review_mes
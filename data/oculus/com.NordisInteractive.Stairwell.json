1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8zpejYZWaAYUIx6UamFEha_3jvKUpiwiBYdw_IMiXKQ&oe=6A6B3C98"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT4tlLiD3xUQ7kNvwFZerPT&_nc_oc=AdrRQz3OE-Q4XWLC4FHiNtp71ce3x0MGlYu7ezcU3BiBksArn9VNV8lQ9GRR7IjQghQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX0v58P-NrgqKSJzKQBwOvvqPHhbvmDexAKefzbJRBKw&oe=6A6B429A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta1FEik9JcIQ7kNvwFKTMEb&_nc_oc=AdrJy2BlO0sqR6GjOr3oWpdQwdK6b6K2bHxrpvAk_mOHCzJpSJO7geklz9WCoaxcws8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvcUU6B3IkeF4dPqEazoWG3XzrofqgqH6t8nwpL5alkQ&oe=6A6B3E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2wWgyT9dj4Q7kNvwFe33Q1&_nc_oc=AdrT7-FTz3S4LqEXusSsb-YTIoManEKPLDmSwZC6ri8OSJZLiVZyNZ-XT_3ZXc-PyNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9BoC3IcTNAOoLP98EbD06OTIUvqwVtXrkSvSW-MUruQ&oe=6A6B41BB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6939798972718490", "version": "1.91"}, "id": "782422676709751", "channel_name": "LIVE"}]}, "
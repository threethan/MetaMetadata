1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvtd20lXEzUewJA3AyXBn0CWNWW5GyOzZ1-_MlXIE56A&oe=6ACD03D8"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9m_HpEKGcsQ7kNvwHkgPLP&_nc_oc=AdpELe4KOZzPtR53APrrlV6nNpuy2joArkms_T-40iYi8qwoBrdq1VODqy2vWA5hhdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuPNVMr64eqQjSwUeh5JoqJC096mCJDIo81rpfHaXi3A&oe=6ACD09DA"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9aVE_sedfcQ7kNvwE9PqIw&_nc_oc=Adp1ZsE4a1hGE2Furk0H8We1kz4pGLZjHdcRM7y5_gY7JDVZh6yoiGPQFRx5hau1tLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY2ct3CqyQR6oNrFi87y6795Z8D-ZNIn7nFO0GObgWFg&oe=6ACD0567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHSRYqtvICYQ7kNvwHAQb3S&_nc_oc=Adq3Po8q5w2ulw_AejomtSMFhd8tCbPhRVXJeZABQgcjpfstt57xhfn2JlAxZcmJIxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWH_YVspX564fVAp-WqlYSJchLLaww4DvfIKQfqvGeyg&oe=6ACD08FB"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairway is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairway is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "573598231423689"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6939798972718490", "version": "1.91"}, "id": "782422676709751", "channel_name": "LIVE"}]}, "
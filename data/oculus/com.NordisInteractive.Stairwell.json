LdrMSu4qmB5GnHbtj9DJOjkg&oe=6A94097E"}, {"file_name": "image_019_0000.png", "id": "1431067254318898", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036620_1431067257652231_342924114105536266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGIhHs3yEoQ7kNvwF44IKR&_nc_oc=Ado7ixC0s7suKecl5foAv1Li_4-iIR5Nkh6ttu2nCkOTy3zkX42Ypxt2ScWFrn9wdlg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd_kxcsb2sHO9ivJJGoXxAkxcrUkvM6jklBiTjd_TAqA&oe=6A941B18"}, {"file_name": "image_023_0000.png", "id": "931757481387949", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75608439_931757488054615_3786678459991641192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ivg11hMBJJYQ7kNvwFqBHy6&_nc_oc=AdpCgc68Y2IVyywcNu3IPmRBb5-7IViXQ9pry6Ts8iNbD6iTl7pWwbQAD-30sDMVCw4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpN8kkbcwxALqHwZrY-QsRRg_h-545HjEaPjVkleOxcg&oe=6A94211A"}, {"file_name": "image_026_0000.png", "id": "1665604277246252", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974617_1665604280579585_3144429094464536851_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T5778Zvt0cQ7kNvwHzrcB5&_nc_oc=Adr4psXbfz_RJBQ7lWNWnwUQ7OrBBLK1mON3MOnW3-5RkUJ0DN9D-ZjXXSKqQKnp2hE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4INEOnxrHZzZJVtUceRqlnpFWFc3dXlbH8DvtT_b72Q&oe=6A941CA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stairwell_Cover 16.9.png", "id": "1407330956713605", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568677_1407330960046938_5084686050953040633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMh8X_S6wVMQ7kNvwGGlajj&_nc_oc=AdqeN9sxO9EyLq9k-YJhaw5BkBzrAiHLP--mBUsLFzQeKga-lkzR2YP2gYMabUTAKXU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVx21dglz86p5ETd--JhOYwPjS7_mg12ps7NYZam7UPA&oe=6A94203B"}, "display_name": "StairWell", "keywords": [], "long_description": "Stairwell is a spine-chilling VR game that plunges you into the depths of an endless staircase descending into the abyss. Armed only with a lighter and a torch, you'll have to navigate your way down the treacherous steps and unravel the mystery of what lies at the bottom.\n\nAs you descend further into the abyss, the environment will become increasingly ominous and otherworldly. You'll encounter strange symbols etched into the walls, and whispers that seem to come from nowhere will taunt and torment you as you make your way down.\n\nBut you're not alone in the abyss. As you descend deeper, you'll encounter otherworldly creatures that will try to impede your progress. You'll need to keep your wits about you and use your torch and lighter to find your way down.", "short_description": "Stairwell is a Horror VR game that puts you in the shoes of a character descending an endless spiral staircase into the depths of the underworld. With only a lighter and a torch to guide your way, you'll need to navigate through the darkness and fend off the unknown horrors that lurk in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bdce2fd-cbbb-49bb-bb71-d2feee63dcd5", "developer_terms_of_service_url": null, "publisher_name": "Nordis Interactive LLC", "support_website_url": null, "website_url": "https://nordisinteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
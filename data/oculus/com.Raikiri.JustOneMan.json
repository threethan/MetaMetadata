?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvNW5I1zUfYQ7kNvwHmuGQx&_nc_oc=Adp1oolSL2XMzsVC_R3LiuuOb-lN8UFvot3m0BVMOXyf_sFAOJG44rKz5tMYNns5kew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3xaRUHbMj_aICw3rYZm3wcFhlq_2JtN-pjPBMChcpfRQ&oe=69F0AE8D"}, {"file_name": "Still 2026-04-10 190700_1.2.1.png", "id": "1936156877020680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820983_1936156880354013_5419716690279816012_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y80qzkhHY9AQ7kNvwHzCCtB&_nc_oc=Adr_XdFEScHG4HwdBfTPWVsauvg2y6BEqbXVA_kp1SX9xHkxIhR9u6UOu1m3qkWeiJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1IO6N7WOljyyrgrENzxH8kwaYKGSrKAZCDjy7UF1EdEw&oe=69F0BDFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image (Trailer Thumbnail).png", "id": "1444222363820610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1444222367153943_5627906645182398030_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R29HGL6dujUQ7kNvwGL2ZYv&_nc_oc=AdqO1UPkfSaC_HPrPXQuieZuu7rDqsu7ume5nOddad5F9UffGRnYCvSBi-j1USaRwLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3524f3ERepjxxtnnuRqmDcAHnzO6DhUaDDpCJWWmbNXQ&oe=69F0C71D"}, "display_name": "JUST ONE MAN", "keywords": ["combat", "sword", "fighting", "ninja", "arcade"], "long_description": "# < Secret discount code: JUST_ONE_MAN-0EAA6A >\n\n**JUST ONE MAN** is a VR hack-and-slash game where you are the **OVERPOWERED ONE-MAN ARMY**. Stylishly slaughter enemies with weapons, combo attacks and devastating abilities while listening to banging beats. Choose your own playstyle and invent the wildest combos to achieve the highest scores imaginable.\n{909086745451293}{34949601584686126}\nVisceral slices, impactful punches, lightning-fast dashing. The fighting is designed with one goal in mind: it has to feel **AS SATISFYING AS POSSIBLE**. Immerse yourself in the flow of the combat and become the ultimate martial arts master.\n{1992925994956517}{1504269921444260}\nThe basics are simple, everyone can learn them in minutes. It is up to you what kind of fighting style you want to come up with, but only the **COOLEST COMBOS** and **EDGIEST EXECUTIONS** earn you that sought-after SSS-rank.\n{846124878501060}{2208279406592999}\nTake on the **CHALLENGE LEVELS** and hone your skills as you conquer difficulties from Easy all the way to **GOD**. Learn new mechanics and tricks to achieve the highest scores. Get sucked into the thrill of the fight while listening to **BANGING BEATS**.\n{2034587237100685}{969797432399066}\nFor the ultimate challenge, play the randomly generated **ENDLESS MODE**. Play as long as you can while the difficulty constantly ramps up. Show off your scores on the **GLOBAL LEADERBOARD**.\n\nWill you make it through the emperor's armies, even though you are **JUST ONE MAN**?", "short_description": "JUST ONE MAN is a VR hack-and-slash game where you are the OVERPOWERED ONE-MAN ARMY. Stylishly slaughter enemies with weapons, combo attacks and devastating abilities while listening to banging beats. Choose your own playstyle and invent the wildest combos to achieve the highest scores imaginable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raikirigames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Raikiri", "support_website_url": null, "website_url": "https://www.raikirigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
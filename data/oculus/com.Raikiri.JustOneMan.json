 "25405927172437680"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4310240962544538"}]}, "change_log": "Patch 1.2.1: Endless Fixes\n- Fix a bug where enemies wouldn't spawn correctly in Endless Mode", "created_date": 1782500811, "id": "25271949255835473", "version": "1.2.1", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8802299089893750", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25405927172437680"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4310240962544538"}]}, "change_log": "Update 1.2.0: BIGGEST UPDATE YET! Ranged Enemies, New Weapon and Two New Levels\n- Our biggest content update so far!\n- **Two new levels: Sunset Sunder and Fall Feud\n- **New weapon: Kunai Fragile and fast, made for stabbing and flinging\n- New weapon mechanic: Weapon throwing. Katanas and Kunai can be thrown at enemies. Katanas can even skewer multiple enemies in line. Aim carefully!\n- New enemy type: Ranged Enemy. These can be found in the new Fall Feud level and in the Endless mode. You can deal with them by blocking and dodging the projectiles. You can even deflect or grab the projectiles for the air, if you are precise enough!\n- Some UI updates: challenge levels and level end scoring have a nice scrolling view now", "created_date": 1781817143, "id": "25183909511306115", "version": "1.2.0", "version_code": 60, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBin
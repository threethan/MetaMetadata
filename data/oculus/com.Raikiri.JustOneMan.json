fVZ2aRRMoXuaZ-Q9w&oe=69F0B8B4"}, {"file_name": "com.Raikiri.JustOneMan-20250919-165211.png", "id": "1572492757531208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298502_1572492760864541_2844250130893269348_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9ATf5r9K5wQ7kNvwGptjlr&_nc_oc=AdrnofyMUQwVEP9j-qVi4rTD2lemjBT4ZcIv9h6QRNDYfLun6pWlNYyeYHJzgWZCAbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3RQMsOP8EV-ODXcow3s31Jtl7-09fi5dQByAp5Tbvhiw&oe=69F0ADAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 672 (1).png", "id": "631324013384594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_631324023384593_6448166735450315319_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZSHPR5y1BgQ7kNvwFrxBg0&_nc_oc=Adq2rbHfNYZcIyZU_g6rOyva0rna59B70OoyQtjKMFiVwJtBWJ4RLozbuqyfxVG8JuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2SlBHcZoEUsRaqMdI-rSNMRE8B9LZqw-9g_dpvUjidAQ&oe=69F0BFE9"}, "display_name": "Just One Man", "keywords": ["combat", "sword", "fighting", "ninja", "arcade"], "long_description": "**Just One Man** is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with a variety of weapons, combo attacks, and overpowered abilities while listening to aggressive beats. Invent your own playstyle and achieve highest scores by performing the wildest combos you can imagine.\n\n{655969647562970}\n\n# SMOOTH AND SATISFYING MELEE COMBAT\nVisceral slices, impactful punches, lighting fast dashing. The fighting is made to be as satisfying as possible, letting you immerse into the flow of the combat.\n\n{812629087883775}\n\n# EASY TO LEARN, HARD TO MASTER\nThe basics are simple, everyone can learn them in minutes. It is up to you, what kind of fighting style you want to come up with, but only the DOPEST tricks get you that sought after SSS-rank.\n\n{1354834099550340}\n\n# FEATURES  \n* **PUNCH**, **SLICE**, **PARRY**, **DODGE** and **DASH** your way through unrelenting waves of enemies\n* Use your **FISTS** to smack and punch enemies to pulp\n* Grab the **WEAPONS** from fallen enemies to vary your combat style\n* Unleash powerful **ABILITIES**, unique for each weapon\n* Scoring system that rewards **THE COOLEST COMBOS**\n* All the while listening to the **BANGING SOUNDTRACK**\n\n{1837366653797577}\n\nAre you ready to **BECOME THE VILLAIN?**", "short_description": "Just One Man is a hack-and-slash game where you are the OVERPOWERED VILLAIN. Stylishly slaughter enemies with a variety of weapons, combo attacks, and overpowered abilities while listening to aggressive beats. Invent your own playstyle and achieve highest scores by performing the wildest combos you can imagine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raikirigames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Raikiri", "support_website_url": null, "website_url": "https://www.raikirigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8802299129893746"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1494853638863044"}, {"status": "PUBLISHED", "id": "1268359218194014"}]}, "baseline_offer": {"id": "1268359218194014"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "14
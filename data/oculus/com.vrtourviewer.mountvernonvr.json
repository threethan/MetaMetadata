plantation"], "long_description": "George Washington's Mount Vernon estate is one of the most iconic homes in the world. Now you can virtually visit this historic home and plantation in vivid detail.\n\nAt the heart of the Virtual Tour is a set of beautiful 360 degree panoramic images that you can fully control and view. \n\nTour every major room within the Mount Vernon Mansion, and see the upper garden, kitchen, the Fred W. Smith National Library for the Study of George Washington, and George Washington's Gristmill & Distillery.", "short_description": "George Washington's Mount Vernon estate is one of the most iconic homes in the world. Now you can virtually visit this historic home and plantation in vivid detail."}]}, "developer_name": "3DV / VR Tourviewer", "developer_privacy_policy_url": "https://www.mountvernon.org/privacy-policy/", "developer_terms_of_service_url": "https://www.mountvernon.org/terms-of-use/", "publisher_name": "HULLFILM", "support_website_url": "https://www.mountvernon.org/", "website_url": "https://www.mountvernon.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "710860416958737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75481470_601327697220501_247168969039499709_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6lGe92GbGoQ7kNvwHdVbMx&_nc_oc=AdqfOMZ_BsD4ELfG01zWLVv9n5UJKI
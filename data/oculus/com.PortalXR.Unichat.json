BOH&_nc_oc=AdpofqryoDepQiVenDF3m-CE4vWQGP2_8owoZ5anEV9qqNJVsaXYfne7fi3t6JQ_5Bg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4b_7B7wKlWZ0dEFAKGF3H8rwDF5U6xPtU3igFvRypyA&oe=6AFB427B"}, "display_name": "Unichat - AI Partner", "keywords": ["AI", "girlfriend", "anime", "social", "chat"], "long_description": "Choose your AI partner, talk about anything on your mind, and have fun.\n\n  - Engage in Lively Chats: Each character has a unique personality, ready to be your confidant.\n\n  - Interactive 3D Stories: Experience engaging adventures with your virtual partner.\n\n  - Watch Dance & Perform: Enjoy entertaining performances by characters.\n\n  - Roleplay Games: Step into various roles and experience adventures tailored for you.\n\n  - Dialogue Challenges:  Test your wit in dialogue challenges.\n\n  - Customization: Change outfits and personalize AI's appearance.\n\n  - Interactive Movements: Command your character to move, interact, and respond to touch.\n\n  - AI characters can speak all major languages, including English, Spanish, German, French, Portuguese, Italian, Japanese, and Chinese.\n\n  Go to our website and join Discord to provide feedback and contribute to the stories!", "short_description": "Begin a Immersive Journey with Your Virtual Partner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://portalxr.ai/privacy.html", "developer_terms_of_service_url": "https://portalxr.ai/terms-of-service.html", "publisher_name": "PortalXR LLC", "support_website_url": "https://portalxr.ai/", "website_url": "https://portalxr.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_me
": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4108471262596874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24619802121037154"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1272357253227323"}]}, "change_log": "https://www.notion.so/Change-log-a8ac2b4cebe84c06993cd9e14732923a", "created_date": 1730812581, "id": "8470127233097900", "version": "0.7.0", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4108471262596874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24619802121037154"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1272357253227323"}]}, "change_log": "https://www.notion.so/Change-log-a8ac2b4cebe84c06993cd9e14732923a", "created_date": 1730648262, "id": "8458712717572685", "version": "0.7.0", "version_code": 17, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4108471262596874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24619802121037154"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1272357253227323"}]}, "change_log": "v0.6.9a [Jun. 09, 2022]\uff08Early Access for v0.7.0\uff09\n Gym stage added, one trial dance added.\n Trial Passthrough function added\n Added manual book (removed \"?\" button on UI) \n Added the ability to copy VRMs from the download folder (Vroid can now be loaded without a PC)\n Item page tabs divided, items added and coloring method changed\n Reorganized configuration screen UI, added options (mainly VMD-related)\n Shadows added to character's feet, footsteps added to some stages\n Improved LookAt eyes (more natural gaze) \n Fixed a bug that caused SEs to go out of control due to interference with SSU swaying objects and items.\n Added slow and fast character expansion/contraction speeds\n Magic circle design change,KAGURA Stage Enlarge\n Changed to start from the previous scene after the title screen \n\nv0.6.9 [April. 23, 2022]\n Changed from VRM material adjustment screen to preset editing screen\n Improvement of material anomalies in VRM\n Fixed a bug that caused VRM springbone to load in an abnormal state.\n Fine-tuning of facial expressions during VMD playback, load balancing during initial loading\n Addressing a problem with not proceeding from the loading screen.\uff08Output error messages about VMD\uff09\n Fixed a bug where the sonic boom in the CRS stage was not working.\n\nv0.6.8 [April. 09, 2022] \u203bPlease see the notice above.\n VMD Improvement\n The UI will follow you.\n Load balancing during character selection and summoning\n Fixed a bug that caused VRM meshes to disappear part by part.", "created_date": 1654796353, "id": "4950060058437986", "version": "0.6.9a", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
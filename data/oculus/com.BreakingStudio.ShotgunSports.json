_nc_sid=6e7a0a&_nc_ohc=tMAKYrOD3JsQ7kNvwEVJG6s&_nc_oc=AdqnUes3tEPTXhyeyZVGJpYJl8mJjdsAQIb4Ka5I4bFoPquW7dcU2KkEV8XNhwCYKmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdo_BhzRyBtjYJLjcPPLMlOVfMwSbQsZLgmmoepax99Q&oe=6A4E4A4F"}, {"file_name": "5.png", "id": "792034731902716", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031421_792034735236049_1738609048231208373_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGrKRyYjroQ7kNvwFJMxR3&_nc_oc=AdpTAcZPvP2z20J-sfwuRm_hSikRIC1qmdiF35h_2M3IE7HHvdlwhEo-KuVPwGVZ79c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAONRUZi98vlp3BxSyuijMezHi0z_-_2XQ2Yhpw2Aq23Q&oe=6A4E38CC"}, {"file_name": "6.png", "id": "611749187371423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035419_611749190704756_211869886182649934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v732zcnZac8Q7kNvwHxYEry&_nc_oc=AdqSimybiRVvCqLinzFxYZNa9Osb_VpCSbf9sBG1sx8Kpyt7r1Ysbr9Mx5GadtlqwwA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuxxC173oC7sElyJBOBWSzUt8wj_q8Spjzx6HmtjmSJA&oe=6A4E5800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "2145150215933064", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391798_2145150222599730_6137304757567171638_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRenxgng4VoQ7kNvwF_C0iF&_nc_oc=AdrSzRs8TGhVvOcG6LZcocfoQA8NMi1yqKwv-9Gfqx4GJ9-2xVAjS-46EiCVeG1JLGM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrqWThLojXt4oGDO4I05pKhAvljksoCzXCcNNOlkxdwA&oe=6A4E5037"}, "display_name": "Shotgun Sport", "keywords": ["shooting", "target", "precision", "gun", "challenge"], "long_description": "Welcome to Shotgun Sport, where the thrill of shooting meets the excitement of a virtual party! Immerse yourself in the ultimate shooting experience as you hone your skills in skeet, trap, double trap, and the challenging Plate Invaders game mode.\n\nBut the real magic happens with our unique 'Party Mode.' Grab your Meta Oculus, and in an instant, any gathering transforms into a Shotgun Sport extravaganza! Picture this: friends huddled together, each with their Oculus device, ready to embark on a virtual shooting showdown.\n\nCompete, challenge, and let the good times roll in our immersive virtual worlds. It's not just a game; it's a social blast! The Party Mode in Shotgun Sport brings people together for friendly competition, laughter, and shared experiences like never before.\n\nElevate the fun and turn your social gatherings into unforgettable moments. Shotgun Sport isn't just about improving your shooting skills; it's about creating memories with friends that last a lifetime. So, grab your Meta Oculus, gather your crew, and let the Shotgun Sport party begin!", "short_description": "Dive into the ultimate shooting party with Shotgun Sport! Elevate your skills in skeet, trap, and more, competing with friends in immersive virtual worlds. Unleash the fun with our unique 'Party Mode'. Grab your Meta Oculus and turn any gathering into a Shotgun Sport party! Elevate the fun with our Party Mode, where friends compete in a virtual shooting showdown. Share the thrill, challenge each other, and let the good times roll in immersive worlds. It's not just a game; it's a social blast!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.breaking-studio.com/privacy-policy/privacy-policy-for-shotgun-sports/", "developer_terms_of_service_url": null, "publisher_name": "https://www.breaking-studio.com", "support_website_url": null, "website_url": "https://www.breaking-studio.com/project/shotgun-sport/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "in
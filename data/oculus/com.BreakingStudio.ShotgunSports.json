_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820421_551227161374848_5629384971981643838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGDF1T2n3PoQ7kNvwFwNY1R&_nc_oc=AdowlkSlPdI9ZcKiBa1Q21tMkLQTO-_Cf1p2Ykz4hKmdjFO2X0RpMLTdy0UK9ofLqM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXthIZENo3jfCvuMeIEjujYRq243KPqFJIZUMtQ94heQ&oe=6A8305BF"}]}, "id": "1053640873806433", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "523298622550066", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031652_523298625883399_6494553337701070187_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stj23gTuUKcQ7kNvwFhVFON&_nc_oc=AdouX6OWN7AZcOf3g4ZJ5ftLfHjORaLVs1ZY0qxn98jTjzqt6cRBIomr8LSn-S9CzX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN9GUUcy9tltfwKaPPzSA6QGI4_4zxEgEdeo2TyFz55w&oe=6A830D86"}, {"file_name": "3.png", "id": "428195392821419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982586_428195396154752_7746379169462511374_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM91yElZnsUQ7kNvwH39Tdj&_nc_oc=AdqkmXqSaI80QWPKpgVJMo1ZhrMoeAKksGDTCtUIsAqkvm_9BLGbbD7iurTSFEwPlwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrSWPfp8tJmSefMTozvi_OB4YWTs_0Ka3xdVk7S_TI0A&oe=6A82E8D0"}, {"file_name": "4.png", "id": "615890783524616", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031515_615890786857949_9211230718835249295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73B_9jt-J0wQ7kNvwFKj-iJ&_nc_oc=AdqqbsIsJXyV1qP9KhSd0dSpkfoS5y2ABstH2D7zBjme-t4bUviSKjJgCsN-_4bvdJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo5uxNz5zoupKAFtcajRbPNC7vCAOcE9KbA1F_Qj3Rng&oe=6A83064F"}, {"file_name": "5.png", "id": "792034731902716", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031421_792034735236049_1738609048231208373_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0oA_-ZX2ZEQ7kNvwEVP0I0&_nc_oc=AdpOaORbtD4f8wH6-8aiHx3sq4E-2fe77cVaormnS28wfXcQ-q0loV3Sgx1eXFkDVjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyk9qBhxTarbxPqawaRkOWh88n8QpKeqmkEC7Wyq2oYQ&oe=6A82F4CC"}, {"file_name": "6.png", "id": "611749187371423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035419_611749190704756_211869886182649934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKq5Qe1g-i8Q7kNvwECfjdQ&_nc_oc=Ado5LnSGNZPzHnGvFJGg077_Et7-Dvm063Dp2IcNq7awQ1slB5RtsrxGIRqFBTmIAws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRYj-5-6Qw2ATnq14GXgKXX83CBLx8tLST8wc376Viw&oe=6A831400"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "2145150215933064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391798_2145150222599730_6137304757567171638_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CMdRKtMS28Q7kNvwFPT_aB&_nc_oc=AdqTq7T8XF1wM76QOfMJaJRX0S6zXe23bnycEgZFaHWxNPKG8nf-yhHDnhhxHhEyskU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMme8VRX3DHzcD9X8Xhr6z86fFdkWkVdaqb_crU0grZw&oe=6A830C37"}, "display_name": "Shotgun Sport", "keywords": ["shooting", "skeet", "trap", "clay", "party"], "long_description": "One headset. Take turns. One shooting champion.\n\nShotgun Sport brings clay shooting to VR with a local Party Mode designed for friends and family in the same room. Add each player's name, choose how often to swap, and pass the headset when the game calls the next participant. The game manages turn changes, scores and the in-match ranking. Use headset casting so everyone can follow the action on another screen.\n\nPlay alone or take turns competing across four modes:\n\n- Skeet: shoot from eight stations as targets arrive from two directions.\n- Trap: react to unpredictable launches and use up to two shots per clay.\n- Double Trap: track and hit two targets launched at the same time.\n- Plate Invaders: face fast arcade waves and timed storms with unlimited ammunition.\n\nLearn the controls in the tutorial, practice your aim in the training range and choose from five difficulty levels, from Very Easy to Olympic.\n\nCompete across colorful locations including sunny fields, snow, beaches, ancient Egypt and more.\n\nWhether you want a quick solo challenge or a shared VR game night, call the clay, follow its path and prove who has the best aim.", "short_description": "Turn one Meta Quest headset into a local shooting competition for friends and family. Take turns in Skeet, Trap, Double Trap and arcade challenges while Shotgun Sport manages player changes, scores and the in-match leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.breaking-studio.com/privacy-policy/privacy-policy-for-shotgun-sports/", "developer_terms_of_service_url": null, "publisher_name": "https://www.breaking-studio.com", "support_website_url": null, "website_url": "https://www.breaking-studio.com/project/shotgun-sport/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27756194550700920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393659_974727008150104_2178527895416868873_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz3Gu3MbY_sQ7kNvwH3F9FY&_nc_oc=Adq7wRB3ehciX1
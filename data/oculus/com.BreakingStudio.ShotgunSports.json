mage_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820421_551227161374848_5629384971981643838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2MW8myPZmcQ7kNvwHdc4so&_nc_oc=AdqUPiPAPVWgfP7xjF2bkSGKQ4TNEGGxIFMDL9GYjVBVEQkjloN9avKygsB1CaAXd_E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA9CPrVY-YVYuKrb06ng0Y0XbPIqm_Y3QfZhaaBm1y1Q&oe=6AAE873F"}]}, "id": "1053640873806433", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "523298622550066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031652_523298625883399_6494553337701070187_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yOlvDy_aEEQ7kNvwH2--pl&_nc_oc=AdrVPaRKDUQ1n3xkpt0VzGf1unLMDZnEmbHOUYODIAqfQsfe2teuq42lGgXLBdMe92Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy7ZyRfBXJS4OONEt1f7IZ_twTxcSq5aKGR-VQm-hm3g&oe=6AAE8F06"}, {"file_name": "3.png", "id": "428195392821419", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982586_428195396154752_7746379169462511374_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16MIl_uwSjcQ7kNvwFRG_Gr&_nc_oc=AdqNMMr1W7iHtims0C9aXAqbvnZUiVi3Z9XISKvkARX6hePwh-8c_r1SQ1oFC50d70o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1uByeVB5yqo5gYibG8TTEooS_p2MhX4_2rWa1X2bqLw&oe=6AAEA290"}, {"file_name": "4.png", "id": "615890783524616", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031515_615890786857949_9211230718835249295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PduI5oLYFYIQ7kNvwEoQAEF&_nc_oc=AdoJlLdW-GfpoOogt_qD_92NKUI6OyY7MKR-0SUKc21FrXLe8DqZ3xUqXGAC04cDW0I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2-Phgbj9Huru7ai9t8ZLGs5UAzkZWJtlzVODqgAg8BQ&oe=6AAE87CF"}, {"file_name": "5.png", "id": "792034731902716", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031421_792034735236049_1738609048231208373_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcuCzF8MsIoQ7kNvwEy9M--&_nc_oc=AdoS4SbP7lijpc0OR4Mj6Yh4VPn9F3ylv-__MNPYtt3jI95TcQdFxFrNwHCE-QLJU1A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2FdTqkTOxn6ViLkDsDIqML8jvMabFJiH1ZO5LczABIQ&oe=6AAEAE8C"}, {"file_name": "6.png", "id": "611749187371423", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035419_611749190704756_211869886182649934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gTrf1JS0REQ7kNvwFwkybz&_nc_oc=Adp5BNHy7-cU-bvS7ZptkX0dd8vxbN1GTz_t1J6meNt8UKMuTwIt0jDjrcx0fx4dc6Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWY1BNQ7CqUl0DXWVV-_T6uM83SXG4001v4KQAYkEYhQ&oe=6AAE9580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "2145150215933064", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391798_2145150222599730_6137304757567171638_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNu6AkbG5usQ7kNvwG19oj0&_nc_oc=AdrkZPGAU4fxPvjmM9b_YJKKIbnk8GkalkXwkTr9yI4rjZf7HgG9iPzqHzd9mHeMxBY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQVBdVPGnXjPwVSwNvLiX7P3z06Prjhk_MXqfTBp2J1g&oe=6AAE8DB7"}, "display_name": "Shotgun Sport", "keywords": ["shooting", "skeet", "trap", "clay", "party"], "long_description": "One headset. Take turns. One shooting champion.\n\nShotgun Sport brings clay shooting to VR with a local Party Mode designed for friends and family in the same room. Add each player's name, choose how often to swap, and pass the headset when the game calls the next participant. The game manages turn changes, scores and the in-match ranking. Use headset casting so everyone can follow the action on another screen.\n\nPlay alone or take turns competing across four modes:\n\n- Skeet: shoot from eight stations as targets arrive from two directions.\n- Trap: react to unpredictable launches and use up to two shots per clay.\n- Double Trap: track and hit two targets launched at the same time.\n- Plate Invaders: face fast arcade waves and timed storms with unlimited ammunition.\n\nLearn the controls in the tutorial, practice your aim in the training range and choose from five difficulty levels, from Very Easy to Olympic.\n\nCompete across colorful locations including sunny fields, snow, beaches, ancient Egypt and more.\n\nWhether you want a quick solo challenge or a shared VR game night, call the clay, follow its path and prove who has the best aim.", "short_description": "Turn one Meta Quest headset into a local shooting competition for friends and family. Take turns in Skeet, Trap, Double Trap and arcade challenges while Shotgun Sport manages player changes, scores and the in-match leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.breaking-studio.com/privacy-policy/privacy-policy-for-shotgun-sports/", "developer_terms_of_service_url": null, "publisher_name": "https://www.breaking-studio.com", "support_website_url": null, "website_url": "https://www.breaking-studio.com/project/shotgun-sport/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27756194550700920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393659_974727008150104_2178527895416868873_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufJ_-yeJbEkQ7kNvwEedXMo&_nc_oc=AdqMw8A
1wMmP6Q21Cn_Qy5Kk4jUQTaiBg-AW9faTNrR7UWGsB0MCQEoFdO4AnqSBsrAR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq4ERSJQWCPf_mR6jEzjWZb9gLNAuvhwg5LvRRSX_HHw&oe=6A77174C"}, {"file_name": "6.png", "id": "611749187371423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035419_611749190704756_211869886182649934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCeUIYlVlWAQ7kNvwF5-fRE&_nc_oc=AdpcEGRpknR4WAmrtb7JF74jqNKbi2tBiGjqDGorKOCGgkJ4JpTNdb4530ns9HckZuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1DCCeovDy7C7oD1Ng5vF1PWm9oyzLfDfGgdqhpmDO7A&oe=6A773680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "2145150215933064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391798_2145150222599730_6137304757567171638_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXTG3UPBLBgQ7kNvwEbMoAr&_nc_oc=AdrZuHOfTDOQwWXJELh5XLAb_XduwV4Xr2HZGISmm4sH1YKk4VY8TqjhYLM3cxeeHf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmgwBvCE8hg28tiCnsyBsQowNz8lMoFGNrOAPEbs4OnQ&oe=6A772EB7"}, "display_name": "Shotgun Sport", "keywords": ["shooting", "skeet", "trap", "clay", "party"], "long_description": "One headset. Take turns. One shooting champion.\n\nShotgun Sport brings clay shooting to VR with a local Party Mode designed for friends and family in the same room. Add each player's name, choose how often to swap, and pass the headset when the game calls the next participant. The game manages turn changes, scores and the in-match ranking. Use headset casting so everyone can follow the action on another screen.\n\nPlay alone or take turns competing across four modes:\n\n- Skeet: shoot from eight stations as targets arrive from two directions.\n- Trap: react to unpredictable launches and use up to two shots per clay.\n- Double Trap: track and hit two targets launched at the same time.\n- Plate Invaders: face fast arcade waves and timed storms with unlimited ammunition.\n\nLearn the controls in the tutorial, practice your aim in the training range and choose from five difficulty levels, from Very Easy to Olympic.\n\nCompete across colorful locations including sunny fields, snow, beaches, ancient Egypt and more.\n\nWhether you want a quick solo challenge or a shared VR game night, call the clay, follow its path and prove who has the best aim.", "short_description": "Turn one Meta Quest headset into a local shooting competition for friends and family. Take turns in Skeet, Trap, Double Trap and arcade challenges while Shotgun Sport manages player changes, scores and the in-match leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.breaking-studio.com/privacy-policy/privacy-policy-for-shotgun-sports/", "developer_terms_of_service_url": null, "publisher_name": "https://www.breaking-studio.com", "support_website_url": null, "website_url": "https://www.breaking-studio.com/project/shotgun-sport/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27756194550700920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393659_974727008150104_2178527895416868873_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7glaF_Y-5oEQ7kNvwGPqS7J&_nc_oc=AdrKetEHZ-IIfH
uluscdn.com/v/t64.5771-25/38974525_572988198552860_2238038614375501048_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq5DCPAq1l0Q7kNvwH5N4SS&_nc_oc=AdoTQq7WiV8cnaDJyH3_UewJot37p6mi9w7uAiEHKCAFVm1I_YM9Eug_ckS5KV-2Y7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af02lLrMmLxTV5crPL4NnefacPDXWioq_KqefKXKtIgHkw&oe=69F0C57B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa: Explore the World-Famous Cathedral", "keywords": ["pisa", "italy", "travel", "tourist", "sightseeing"], "long_description": "Immerse yourself in a VR journey that presents Pisa\u2019s cathedral in all its splendor. From a first-person tourist view, begin at the Piazza dei Miracoli, gazing at the impressive cathedral facade adorned with intricate details and historic symbols. Step by step, approach the entrance and finally enter the interior of this monumental building.\n\nInside, the full beauty of the cathedral's architecture reveals itself. Towering marble columns reach skyward, ornate ceiling paintings draw your eyes upward, and light streaming through stained glass windows bathes the space in reverent atmosphere. As you walk down the nave, you\u2019ll encounter masterpieces of sacred art and finely crafted altars, telling stories of centuries of devotion.\n\nYour path leads you to more awe-inspiring details: the vast domed ceiling, delicate carvings on the walls, and elaborately decorated chapels, each a testament to history. Every step brings you closer to the depth and beauty of this sacred site, as if you are truly walking through its hallowed halls.\n\nFinish by stepping outside to take in the full view of the Piazza dei Miracoli once again \u2013 an unforgettable experience that brings you close to the beauty and spiritual significance of Pisa\u2019s cathedral. \u200b\n\n\u200b\n#pisa #italy #travel #vrtravel #tourist #sightseeing #oldcities #historiccities", "short_description": "Experience the splendor of Pisa\u2019s cathedral from a true tourist\u2019s perspective! In this VR experience, explore the iconic structure inside and out. Start at the Piazza dei Miracoli to admire the majestic facade before stepping into the cathedral\u2019s grand interior. Inside, marvel at the ornate ceilings, marble walls, and historic artworks. Finish by viewing the altars and feeling the profound atmosphere of this historic place \u2013 as if you\u2019re truly there.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Explore-the-World-Famous-Cathedral", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9587575841258568"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2114131522721067"}, {"status": "PUBLISHED", "id": "1433007091741406"}, {"status": "PUBLISHED", "id": "1817975222232184"}, {"status": "PUBLISHED", "id": "1232597065593612"}, {"status": "PUBLISHED", "id": "3037171173121710"}, {"status": "PUBLISHED", "id": "1502179281230784"}, {"status": "PUBLISHED", "id": "1060618072781378"}, {"status": "PUBLISHED", "id": "1229661902012980"}, {"status": "PUBLISHED", "id": "590701833669426"}, {"status": "PUBLISHED", "id": "453558297559907"}, {"status": "PUBLISHED", "id": "587588503744776"}]}, "baseline_offer
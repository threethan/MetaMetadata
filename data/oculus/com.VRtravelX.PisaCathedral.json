5890", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1071788654686962", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982687_1071788658020295_5975089015825909624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMJL7OZdeosQ7kNvwFboHrP&_nc_oc=AdmSvo5xDA_eMCFgqhavv3OlTbhdDqywOfcP9LUJ1zJIRWKAOFVtPsyDOxBXxTfwAKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCBC46j5XUjEcDCbzyeV-VX5UTIOKEtfMQpVtVl2sRyQ&oe=69BE7D4A"}, {"file_name": "screen2.png", "id": "1119552893067812", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_1119552896401145_4686109587216066668_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4OoN8iUEvIQ7kNvwG8sVsh&_nc_oc=Adm4bGRriXN8tg_f_5kUdFlF1IyVI6qT0C6BaCG_vx-Nypiw7IX6_BR4ept5l8WIRxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf2AOTckXB0Wp-5rFoo0KHBO7ReEjtEEIuoOldVAu_Kg&oe=69BE834F"}, {"file_name": "screen3.png", "id": "1812595129275025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982508_1812595132608358_7557656962943907195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzA--eFjkhMQ7kNvwGVAtRd&_nc_oc=AdnDUzUKVLAzw-q290pHjm7YR5CrMO8AIUC2OuFCbznYoy0An2qGiWui4bZXFdGkpg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAQATtX3GnCEeF9J1Uqd6cdXaiqZiIswLlWBea1nC3XQ&oe=69BE81D8"}, {"file_name": "screen4.png", "id": "969376518551976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974504_969376521885309_2694655985439314347_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htBlWKeeaY0Q7kNvwGuGErL&_nc_oc=Adk-LbiW6XBG7RY1BdvuAFsdOTUGlzONuLAvauC3zVIh2b2OyzRcNvSsGvn2ivZ4wQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcqsWdfO8Ak8tGfy1hazPi5OW6b6KZs8ZQrxgzpx-Ung&oe=69BE8BAC"}, {"file_name": "screen5.png", "id": "572988191886194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974525_572988198552860_2238038614375501048_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHhy2OnOGZ4Q7kNvwFTXgrA&_nc_oc=Adn1dIBJWtQ8JgPNofdfVZ37O8kA_fV0dS-W61TZamU1HFoChOMmcf5n9Wn_rEpYpt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq6rxlrp1VtEppnf9OvmMD9yGUeSAlhQ1VK3Q58RkCCg&oe=69BEAC7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa: Explore the World-Famous Cathedral", "keywords": ["pisa", "italy", "travel", "tourist", "sightseeing"], "long_description": "Immerse yourself in a VR journey that presents Pisa\u2019s cathedral in all its splendor. From a first-person tourist view, begin at the Piazza dei Miracoli, gazing at the impressive cathedral facade adorned with intricate details and historic symbols. Step by step, approach the entrance and finally enter the interior of this monumental building.\n\nInside, the full beauty of the cathedral's architecture reveals itself. Towering marble columns reach skyward, ornate ceiling paintings draw your eyes upward, and light streaming through stained glass windows bathes the space in reverent atmosphere. As you walk down the nave, you\u2019ll encounter masterpieces of sacred art and finely crafted altars, telling stories of centuries of devotion.\n\nYour path leads you to more awe-inspiring details: the vast domed ceiling, delicate carvings on the walls, and elaborately decorated chapels, each a testament to history. Every step brings you closer to the depth and beauty of this sacred site, as if you are truly walking through its hallowed halls.\n\nFinish by stepping outside to take in the full view of the Piazza dei Miracoli once again \u2013 an unforgettable experience that brings you close to the beauty and spiritual significance of Pisa\u2019s cathedral. \u200b\n\n\u200b\n#pisa #italy #travel #vrtravel #tourist #sightseeing #oldcities #historiccities", "short_description": "Experience the splendor of Pisa\u2019s cathedral from a true tourist\u2019s perspective! In this VR experience, explore the iconic structure inside and out. Start at the Piazza dei Miracoli to admire the majestic facade before stepping into the cathedral\u2019s grand interior. Inside, marvel at the ornate ceilings, marble walls, and historic artworks. Finish by viewing the altars and feeling the profound atmosphere of this historic place \u2013 as if you\u2019re truly there.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Explore-the-World-Famous-Cathedral", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9587575841258568"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2114131522721067"}, {"status": "PUBLISHED", "id": "1433007091741406"}, {"status": "PUBLISHED", "id": "1817975222232184"}, {"status": "PUBLISHED", "id": "1232597065593612"}, {"status": "PUBLISHED", "id": "3037171173121710"}, {"status": "PUBLISHED", "id": "1502179281230784"}, {"status": "PUBLISHED", "id": "1060618072781378"}, {"status": "PUBLISHED", "id": "1229661902012980"}, {"status": "PUBLISHED", "id": "590701833669426"}, {"status": "PUBLISHED", "id": "453558297559907"}, {"status": "PUBLISHED", "id": "587588503744776"}]}, "baseline_offer": {"id": "587588503744776"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "21
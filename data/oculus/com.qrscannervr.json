name": "4.png", "id": "936221049350489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308045_936221052683822_2393134125121488634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZYgy-m0wvQQ7kNvwG8DYCU&_nc_oc=Adpkct1xPBFvOxGw2kiIoKL1MENyStCroyReOdS-HvTsXAMjL4IdoYT3wMamK1WszVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMtg7bCPDxOAj9s1vNnVYOfXp6cItx0UftevIW1npvMg&oe=6AE4BB86"}, {"file_name": "6.png", "id": "1289311403206923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1289311406540256_8222422092377036341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMyLw4s4oN4Q7kNvwE5Jaht&_nc_oc=Adp5Z5rJ9yx9DLnNhv98-ZUyDd_XiFtCIFpGDrQ0ENPLRY05XkqNEkUTIHpjyfhBRv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZXg7vFftf-xDURb6uQskN5XHpzC2DQCjtFJsxxE7wEQ&oe=6AE4978E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner VR", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "QR Scanner VR brings real-world QR code scanning into your Meta Quest 3 mixed reality experience. Using the headset passthrough cameras, you can scan any QR code simply by looking at it - no phone needed.\n\nKey Features:\n- Mixed Reality Scanning - See the real world through passthrough while scanning QR codes\n- Instant Detection - Powered by Google ML Kit for fast and accurate barcode recognition\n- Controller Interaction - Point and click with your right controller to copy results or open URLs\n- Scan History - Browse through all your previous scans with thumbstick navigation\n- Multiple QR Types - Supports URLs, text, WiFi credentials, contact cards and more\n- Copy and Open - Instantly copy scanned content to clipboard or open URLs in the browser\n- Native Performance - Built with OpenXR and native C++ rendering for smooth 72fps visuals\n\nHow to Use:\n1. Launch the app and grant camera permission\n2. Look at any QR code through the passthrough view\n3. The scanner automatically detects and decodes the code\n4. Use your right controller to interact with results\n5. Press Exit or B/Y to quit", "short_description": "Scan QR codes in mixed reality using your Quest 3 passthrough camera. Fast, accurate scanning with controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qrscanner-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/qrscanner-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34480285768283405"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "922689593733455"}]}, "baseline_offer": {"id": "922689593733455"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774031220, "status": "PUBLISHED", "id": "922689593733455"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38946010588377545", "version": "3.4"}, "id": "1615068473109791", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept"
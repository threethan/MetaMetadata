 "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308045_936221052683822_2393134125121488634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1MUccKKEQwQ7kNvwFELmKm&_nc_oc=Adqj6alzpy2O8MKiSLjxARofufvXXdqsT5uT34K3i0i7xhD24CKpTZ7U9cqPcoWPgco&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pOzkxbKFx1rYygYXUehL2HPY3fqd4Y66YAZHdZ959xw&oe=6A09E286"}, {"file_name": "6.png", "id": "1289311403206923", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823930_1289311406540256_8222422092377036341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZU1dFJLvKEQ7kNvwE7xScV&_nc_oc=Adr4Fn14gl4fWVjKwDHryurCG6oEjcDM5D-Nun0i_nW_a0E3f-0sjqQuhXF1-a2-5Sc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eo3BIMcxgrZu7JLGE4tdjkL-10MmUoE0hwg_uCuhjqw&oe=6A09BE8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner VR", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "QR Scanner VR brings real-world QR code scanning into your Meta Quest 3 mixed reality experience. Using the headset passthrough cameras, you can scan any QR code simply by looking at it - no phone needed.\n\nKey Features:\n- Mixed Reality Scanning - See the real world through passthrough while scanning QR codes\n- Instant Detection - Powered by Google ML Kit for fast and accurate barcode recognition\n- Controller Interaction - Point and click with your right controller to copy results or open URLs\n- Scan History - Browse through all your previous scans with thumbstick navigation\n- Multiple QR Types - Supports URLs, text, WiFi credentials, contact cards and more\n- Copy and Open - Instantly copy scanned content to clipboard or open URLs in the browser\n- Native Performance - Built with OpenXR and native C++ rendering for smooth 72fps visuals\n\nHow to Use:\n1. Launch the app and grant camera permission\n2. Look at any QR code through the passthrough view\n3. The scanner automatically detects and decodes the code\n4. Use your right controller to interact with results\n5. Press Exit or B/Y to quit", "short_description": "Scan QR codes in mixed reality using your Quest 3 passthrough camera. Fast, accurate scanning with controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qrscanner-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/qrscanner-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34480285768283405"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821674_1600922110950896_7152988319109859567_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGzRTl_8KH4Q7kNvwH1Khy-&_nc_oc=Adr9JBjOG4eKQ-s22CStPjIZduBDZjG7JV7tIN-VVaz1HX7oVEG84MpGZdw5_WQ6EGQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GTL9a9ADCu_T4wdnD2Sh5Nkn2OEBkSTMgJxqQJvLefA&oe=6A09C03B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QR Scanner VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1774
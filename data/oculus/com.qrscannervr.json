7fNpRNy9Z2BT0PD0zNbT8-UhuHuLgWkJm7Y7QM1xCwQ&oe=6AA2C2D7"}, {"file_name": "4.png", "id": "936221049350489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308045_936221052683822_2393134125121488634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UTC1W1Mo6gQ7kNvwHAZ1Pr&_nc_oc=Ado0JMChPDY1I-q0JknMFe4y7F-cUL9xnltt-7H-7cd-iKkgrJn41A8-A7tVz8o696M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgVqToTgSKyc0duiwZQZPw_oVRUkdaDWWksmEIxsW0fA&oe=6AA2D086"}, {"file_name": "6.png", "id": "1289311403206923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1289311406540256_8222422092377036341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_OVvffGe7AQ7kNvwETr_qH&_nc_oc=Adr_-FhQBcI76otMAsIHbeBwCf9uEnya6WJ-QqJUVX_dQw4Vm1Wg6QLGKzFougeeCDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuMW4WPzw7vsgD64gdXuoToKSxORyGaqlRizANNcKivw&oe=6AA2AC8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner VR", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": " QR Scanner VR is the fastest way to scan QR codes without taking off your headset.\n\n  Point the reticle, pull the trigger \u2014 the app recognizes the code and gives you a one-tap action tailored to its type.\n\n  WHAT IT DOES\n\n  \ud83d\udd17 URLs \u2014 open in the browser (YouTube links route to YouTube VR)\n\n  \ud83d\udcf6 Wi-Fi \u2014 auto-connects, no password typing\n\n  \ud83d\udc64 vCard \u2014 saves to contacts\n  \ud83d\udce7 Email / \ud83d\udcde Phone / \ud83d\udcac SMS \u2014 opens the right app pre-filled\n\n  \ud83d\udccd Geo \u2014 opens in Google Maps\n\n  \ud83d\udcc5 Calendar events \u2014 adds to your calendar\n\n  \ud83d\udccb Plain text \u2014 copies to clipboard\n\n  CONTROLS\n  \u2022 Right trigger \u2014 scan / click\n\n  \u2022 A copy \u00b7 B open \u00b7 X pause \u00b7 Y clear\n\n  \u2022 Stick up/down \u2014 zoom panel + scan area (zoom in for tiny codes)\n\n  \u2022 Stick left/right \u2014 history navigation\n\n\n  FEATURES\n\n  \u2713 Persistent history (up to 100 codes)\n\n  \u2713 CSV export to Downloads\n\n  \u2713 Audio beep + haptic feedback\n\n  \u2713 Optimized for small or distant codes\n\n  \u2713 Native VR with passthrough\n\n\n  FIRST LAUNCH\n  Enable ALL camera permissions (Camera AND Headset Camera).\n\n If scanning isn't working: Settings \u2192 Apps \u2192 QR Scanner VR \u2192 Permissions.\n\n  Compatible with Meta Quest 3 and Quest 3S.\n\n  \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\n\n    \ud83d\udcac \ud835\udde6\ud835\ude02\ud835\uddfd\ud835\uddfd\ud835\uddfc\ud835\uddff\ud835\ude01, \ud835\uddf3\ud835\uddf2\ud835\uddee\ud835\ude01\ud835\ude02\ud835\uddff\ud835\uddf2 \ud835\uddff\ud835\uddf2\ud835\uddfe\ud835\ude02\ud835\uddf2\ud835\ude00\ud835\ude01\ud835\ude00, \ud835\uddef\ud835\ude02\ud835\uddf4 \ud835\uddff\ud835\uddf2\ud835\uddfd\ud835\uddfc\ud835\uddff\ud835\ude01\ud835\ude00:\n    https://discord.gg/5gUHResGZU\n\n  \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d", "short_description": "Scan QR codes in mixed reality using your Quest 3 passthrough camera. Fast, accurate scanning with controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qrscanner-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/qrscanner-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, 
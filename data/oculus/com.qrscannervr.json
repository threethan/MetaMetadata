4bBpdg4cQ4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSNZhmX924Bg8j-tfCUMcXkJS37tz3D-z4MAebIeBTVA&oe=6AA2C787"}]}, "id": "1248199707460100", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2000258190840321", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_2000258194173654_1816301919515288752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN0gIvnFifUQ7kNvwFEknmK&_nc_oc=Adpw0WpGW6Oi4mAm-CYOw14B_wcDFVepFFS9DJc4q7u9cmsIKEgQJLINwwn9_J18bOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe3TdfOoGxUi_s9mlLR2aGtRXvu1yCu_bJ7AlI2D9Iiw&oe=6AA2B59A"}, {"file_name": "2.png", "id": "1445592320594737", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1445592330594736_285994732080298539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA0c0FhQIjsQ7kNvwE6zsUI&_nc_oc=AdrwYGLAWLX9HvZbchiKpuQyGm6bW6oh2bX2R_lM11W-E5csgL8XHD3qdjrNmwj9d-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJnf7tTlYAPvpKhiS_nYC3jhxGlOrgF9pHvsjbR2f68g&oe=6AA2B57E"}, {"file_name": "3.png", "id": "950220984178480", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_950220987511813_6312653769358299262_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0woLcEp2KkQ7kNvwEHn5iT&_nc_oc=AdrR_D_eNKy4n74NJMUzwfp7o8O1lcmHWXdRBZ3wNU4HvlZGlpEUPI8yi-ek1DSZGgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7fNpRNy9Z2BT0PD0zNbT8-UhuHuLgWkJm7Y7QM1xCwQ&oe=6AA2C2D7"}, {"file_name": "4.png", "id": "936221049350489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308045_936221052683822_2393134125121488634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UTC1W1Mo6gQ7kNvwHAZ1Pr&_nc_oc=Ado0JMChPDY1I-q0JknMFe4y7F-cUL9xnltt-7H-7cd-iKkgrJn41A8-A7tVz8o696M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgVqToTgSKyc0duiwZQZPw_oVRUkdaDWWksmEIxsW0fA&oe=6AA2D086"}, {"file_name": "6.png", "id": "1289311403206923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1289311406540256_8222422092377036341_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_OVvffGe7AQ7kNvwETr_qH&_nc_oc=Adr_-FhQBcI76otMAsIHbeBwCf9uEnya6WJ-QqJUVX_dQw4Vm1Wg6QLGKzFougeeCDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuMW4WPzw7vsgD64gdXuoToKSxORyGaqlRizANNcKivw&oe=6AA2AC8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner VR", "keywords": ["QRcode", "scanner", "mixedreality", "barcode", "passthrough"], "long_description": "QR Scanner VR brings real-world QR code scanning into your Meta Quest 3 mixed reality experience. Using the headset passthrough cameras, you can scan any QR code simply by looking at it - no phone needed.\n\nKey Features:\n- Mixed Reality Scanning - See the real world through passthrough while scanning QR codes\n- Instant Detection - Powered by Google ML Kit for fast and accurate barcode recognition\n- Controller Interaction - Point and click with your right controller to copy results or open URLs\n- Scan History - Browse through all your previous scans with thumbstick navigation\n- Multiple QR Types - Supports URLs, text, WiFi credentials, contact cards and more\n- Copy and Open - Instantly copy scanned content to clipboard or open URLs in the browser\n- Native Performance - Built with OpenXR and native C++ rendering for smooth 72fps visuals\n\nHow to Use:\n1. Launch the app and grant camera permission\n2. Look at any QR code through the passthrough view\n3. The scanner automatically detects and decodes the code\n4. Use your right controller to interact with results\n5. Press Exit or B/Y to quit", "short_description": "Scan QR codes in mixed reality using your Quest 3 passthrough camera. Fast, accurate scanning with controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/qrscanner-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/qrscanner-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34480285768283405"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "922689593733455"}]}, "baseline_offer": {"id": "922689593733455"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774031220, "status": "PUBLISHED", "id": "922689593733455"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36642466038732023", "version": "3.1"}, "id": "1615068473109791", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36642466038732023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615068473109791"}]}, "change_log": "v3.1 - czysty powrot z przegladarki (Meta Web Task)", "created_date": 1782322314, "id": "36642466038732023", "version": "3.1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36642466038732023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615068473109791"}]}, "change_log": "v3.0 \u2014 Version number now displayed in lime green at the top-left of the panel for easier troubleshooting and support.", "created_date": 1779630491, "id": "35894140160231285", "version": "3.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36642466038732023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615068473109791"}]}, "change_log": "What's new in 2.9\n\nDiscoverability\n\u2022 Big OPEN button on the right after every scan \u2014 one click takes the right action (URL / Connect / Save / Call / Map / etc.). No more guessing which controller button to press\n\u2022 Highlighted \"AIM HERE\" and \"PULL TRIGGER\" hints with a styled RT keycap so first-time users know exactly what to do\n\nSmarter launch flow\n\u2022 If a scanned link silently fails to open within 2.5 s, the scanner now auto-falls back to the Meta Store with a search hint\n\u2022 Long blinking message after launch (\"look around / press the Meta button\") auto-clears the moment you return to the scanner \u2014 no more lingering toast\n\u2022 Permission-grant flow: after enabling cameras in Settings, the scanner detects it and shows a one-click RESTART button with a 7-second auto-restart countdown\n\nPolish\n\u2022 Save button greys out when there's nothing to export\n\u2022 Smooth max-zoom hysteresis (no flicker at the 1 m boundary)\n\u2022 Calendar QR codes now honour the TZID timezone parameter, not just UTC / local\n\u2022 CSV export caps very long entries so spreadsheets can open them", "created_date": 1779569819, "id": "35880866171558684", "version": "2.9", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36642466038732023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615068473109791"}]}, "change_log": "What's new in 2.8\n\nScanning\n\u2022 Major scan-quality boost \u2014 analysis runs on a small region around the reticle at full sensor resolution, so small and distant codes are picked up almost instantly\n\u2022 Scan area now correctly tracks the on-panel reticle (no more misaligned detection)\n\u2022 Joystick zoom resizes the scan area too \u2014 pull the panel closer for a larger zone, push it away for precision\n\u2022 Pulling the panel fully close switches to whole-FOV scanning for very large codes (posters, packaging)\n\nSmart actions\n\u2022 YouTube links open in YouTube VR (not Horizon Browser) when installed\n\u2022 Maps codes (geo:) fall back to Google Maps in browser when no native maps app is present\n\u2022 When no Quest app handles a scan, opens Meta Store with a search hint (e.g. \"search for 'maps'\")\n\u2022 Better support for tel:, smsto:, mailto:, vCard, calendar \u2014 proper package visibility for Android 11+\n\nUX\n\u2022 Scanner pauses cleanly when a 2D panel is in front (no more random beeps from the background)\n\u2022 Red overlay over the panel when the scanner is paused, so it's obvious why nothing is happening\n\u2022 Friendlier message after launching an external app \u2014 \"look around or press Meta button\" if not visible\n\u2022 Controls help on first launch highlights the joystick zoom in yellow\n\nStability\n\u2022 Several fixes around camera permission flow and lifecycle on relaunch", "created_date": 1778241992, "id": "35518861831092455", "version": "2.8", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34445410471770935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36642466038732023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615068473109791"}]}, "change_log": "What's new in 2.7\n\n\u2022 Precise aiming \u2014 only the code under the reticle is captured, even when multiple codes are visible in the camera view\n\u2022 Smaller, more focused reticle for easier targeting\n\u2022 Fewer accidental scans in dense scenes (walls of QR codes, menus, packaging)", "created_date": 1776190676, "id": "35006400582338585", "version": "2.7", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
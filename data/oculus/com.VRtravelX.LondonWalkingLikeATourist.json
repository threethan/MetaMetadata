cQ7kNvwHLcf8Z&_nc_oc=Adp88ebGsnXTU0VMDrHbjVqezIaKYLJe4J9JFiodS3EOyZyK0QvzsScZWX_M2w4OyE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAxDKiSmucdtx8rdHUYX3coLgQQibrPFlQ9ZwNrBb19g&oe=6B09B66A"}, {"file_name": "screen3.png", "id": "898900988347271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPw1V5zaMwAQ7kNvwEgUC8r&_nc_oc=AdoGK_JhV0jSqvPgEwdTsT_2kO8kGKGOOKHx2Pt0NAZx8SzT0-vFzwlU6_BZp9tl-FU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCm4i9v4a5nN6WmARN2JL8p5FGka5Hb8_UO-rX4lB2qQ&oe=6B09B9A2"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrOX6nQcytMQ7kNvwGRTOa2&_nc_oc=AdrcSOzkxWyC8BRbkMcql0IcpbLDO7K1YZ7juY7fvdNqcU5W5lIUs6YluwqRALhsAy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGXO5a_eN3ZGuEODNDdkjOlWiOwwZhZztggqKNTOePcA&oe=6B09B9E1"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FcJC4va_NUQ7kNvwHUInSR&_nc_oc=Adq1j4diYdY72adadcyojI5yjBTPRMK55_tFA4NLjeCnkYkXFS7_nSEOIVEUspUr4UU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmARzr95lcY9m2B5RqQfuQ-9MnXvnDZxHJcZ_3I8GBbw&oe=6B09C9DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg_7ywU2CoEQ7kNvwEFohBL&_nc_oc=AdrDeRkAVi93EzBkWOXQZTnW-ySFgQnritiolB3j0aOOFVR0ZETrr-rLCHwLCoftV34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj8fXwHQOmDp6UTGy0iAIIp-miXiJcVEFMzqrw7XUJGg&oe=6B09CEC7"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8471867119529633"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1428581469038564"}, {"status": "PUBLISHED", "id": "1259753342761296"}, {"status": "PUBLISHED", "id": "2060417434795878"}, {"status": "PUBLISHED", "id": "884002834529297"}, {"status": "PUBLISHED", "id": "2593873320990014"}, {"status": "PUBLISHED", "id": "1104965315053793"}, {"status": "PUBLISHED", "id": "1810122596282175"}, {"status": "PUBLISHED", "id": "722886087094297"}, {"status": "PUBLISHED", "id": "912200210884301"}, {"status": "PUBLISHED", "id": "892761946357012"}, {"status": "PUBLISHED", "id": "931994205461895"}, {"status": "PUBLISHED", "id": "2044589155991581"}]}, "baseline_offer": {"id": "2044589155991581"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1428581469038564"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9267018626681141", "version": "1.3"}, "id": 
scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDTh0hF8k68Q7kNvwHZMusf&_nc_oc=AdrdbbK8O2LP-RYVz0jDmqhbJ2J1xbFFiXS5j9OAHrjh4xZi4yMPqRodnRIuwwxIhfc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHCA1zAy2TDF3iuaLs2beAtiqPiHveBLuYi1ysGUiX1Q&oe=6AA15AE2"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1sCc93UVQkQ7kNvwFdDMEz&_nc_oc=AdrSv9pbUzcJvs4YiOqD-BG3H7oyPyclEamPH_9DbUz6vYZ67KqnZrTLNTvR7eq-TN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaVZELAOzxLbgDO2gznlKsh7w7iQIbqhqBroFSat3-5w&oe=6AA15B21"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIDJvKpMuYYQ7kNvwHddjwu&_nc_oc=AdpGrBT6Lc_8oGMhGBnS0SJsASqmOsF_JyOqv7D7br2MYUQYjt_tGWus8E-IR5gjL-Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDrfeJma1s9IsFMHlyOFcWAimmxLHMXaqCgAuDNzDWJg&oe=6AA16B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zjGBrAmeTIQ7kNvwF-xs46&_nc_oc=AdqiS4eWs6CeAHqSgB5vxTrdnB3558VqaCSEvOg_F_uE7Ud3VA9qrbqxl0azmiu1FpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNTbjnrZUhPshKG4tIOnunqtSkODUEqSkXfTUEFvQT_A&oe=6AA17007"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
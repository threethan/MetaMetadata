scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnHqCK9vjSYQ7kNvwH42ERw&_nc_oc=Ado6GMlGFGy4e7VvstNAHVeqoHXiB34wGwJSJ2ouHLzRPFwd_PpJEcS2uYG8ian6rZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhbY61QcJDc-0M2D7OiTQMzKUVE5AbKmCaSCiqniJ0Ug&oe=6A79CDE2"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkCWEgCdvLQQ7kNvwF3RVNR&_nc_oc=AdpATtpdTGiberPeW3ziujBdNsSmz9TABKdVMGvUWG39d7LWiH_Xl6oMpJsDKn1G_Lk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCe1IVT8O8ZP92RaBTcBU_966j0Hb_7cJ9Gj1Ds8F3qA&oe=6A79CE21"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5ReLl9hTG8Q7kNvwEUoPaw&_nc_oc=AdoDihLdm1dJNxUV2ZQwILR5b4NpliT2-c3s98qM24k0S5FF-cGIytWoVSlRB4VC86M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBygEG6DkyhGIPJCbcha6wiB6BhsJm1xMQ-DGbuJLa7Q&oe=6A79DE1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbpJn3D88H4Q7kNvwF3ill4&_nc_oc=Adq7fAlX2g810xwPxuTPpdmd_a_PAug6deKGkgAZecv9HGTneeDphvnhPFnDtFL7fsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgp2oth-IbBnosFN_4Br7peWWhLwXB9rr0hZNQKcMDLw&oe=6A79E307"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
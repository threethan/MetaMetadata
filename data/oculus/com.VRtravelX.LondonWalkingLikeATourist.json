scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5aZjDKzU6cQ7kNvwGVgXVq&_nc_oc=Adrz0Y-_G8ZfrPS1z0TBfpqUnyRTgs_3_GutiobnruFpVWt76TKvgEPn1D9TxMeFvIg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWs_F-UNUxetsV0n_holbbelZfQsOrTP24eCKJW-9cIQ&oe=6A942BE2"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QHIRMdOt-UQ7kNvwFIDniW&_nc_oc=Adq8v-wqC3WxQyV9oH3n-w80ax_S90XFRUhBBAdujfPvJf3sxrG5zS2PYrtNWrjlAmc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoqrXGveYqcC-_Pj2beEpc63-FxUWN0WWgPjNZNg7IUA&oe=6A942C21"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKPHHMF7CbkQ7kNvwFHR9oc&_nc_oc=AdppgfxdiBto1oq5T7ABhZzbTtwPlK_rAgFBI_w7RkjjXIC7MhT9p2iGb2EDbekCABA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_ZkvoJBuZF9j1dfQijRrIBtwjBSRTuVdwFOTSJ91rpw&oe=6A9403DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV7n0rUEjicQ7kNvwFHKzah&_nc_oc=AdquccHwfYGHmpLrxV8Fu4_c63LsBDunL20bXtWBi_tBIvA8Y54IvE3ee8qjkYBBZ0M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkcRdtSBiYp2CQ9tZceXvhVzwmL5qeE5oqB0dHohBk8w&oe=6A9408C7"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
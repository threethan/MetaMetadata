AP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_416995958100437_6131110493581289684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qvjQYlo94gQ7kNvwFS7490&_nc_oc=AdkcE0fVTpz-LCz9fcnLnya7dnnSlTrzWaSg1miFfQZyNqOTb2fXh1I3mDVj9s7zlMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWsUMXq2b_yk0hQRw2swREc-3Dw_l4phskT3OSbgHx_w&oe=699D8708"}]}, "id": "8706180626113555", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "508789841952175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035396_508789845285508_7989382406479042993_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33eoqw2rdjcQ7kNvwGBI9JO&_nc_oc=AdmSmUnUml1iHQ-Te9HX9SFBU8h-8I5mcQobG6BXUBsco1zmYUMzFowj6q9K92Lyt9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOIVofglyuLh9XwzavUYL-EuPmcN6ApIB61FhPBmK_Sw&oe=699DB623"}, {"file_name": "screen2.png", "id": "510325685259902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_510325688593235_6153548243770529811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtYcDPBy_MQQ7kNvwHjd4wZ&_nc_oc=AdmoZrvCNRWhqSKfMy7DbM9JasXypqzRJTFgIorYc9Tepo-NaIt7sgpbxMNT52QPQKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQDNzN9yOtNxGDMJ4QcCov27yRnRkup6QcmLSU-aI7MQ&oe=699DA02A"}, {"file_name": "screen3.png", "id": "898900988347271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo6Vq_56_0AQ7kNvwEF-L98&_nc_oc=AdkuGqNjqTvu_NXDlBkYL5ZV2e2l_37T9qp7UcTdoHctE0sCo3eQZ2TPr-_OpIXrEvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsyt0_1UptoWTQtGer9KIH1ig0a2IADmfO3rIDixW-obw&oe=699DA362"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2IWg55tmAQ7kNvwG9HftP&_nc_oc=AdkM4-ckbkK8OxQk8GNpyhAPqJNIWL5FRjLQxgbLugNyNtE0PemHEjLrwgm0BOLsxDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZ4fEz-RDShgp4RJpyDxY0l3N9LZhskdGtfpadVSu72g&oe=699DA3A1"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iJspXjps3AQ7kNvwHRr6vv&_nc_oc=Adk7UEfJ16VdsdBTcEUrvxFLZjX7XcSlsFGfgOnBnKKijLO4WnIOBxqJ70aQy-3GHHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-0FCHUm5pN9mQgchJjiAes_gcaTrZnv5T-yJxI6zkQw&oe=699DB39A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BglvQMeweTwQ7kNvwGZHTg8&_nc_oc=AdkqBW6sv5n8AAa8NcK5ruJz26bHVBeh578NFcWSc8qBovUz5EheXDEF4XNqmi6OYv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBaqHWf9YtIZsZyDpcNvgWmV0FmNXuRI8Wtz6SlQAC_Q&oe=699D8047"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8471867119529633"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "206041743479
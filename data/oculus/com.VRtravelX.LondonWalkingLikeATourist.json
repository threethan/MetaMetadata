AP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982691_416995958100437_6131110493581289684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR0NCJXQXOsQ7kNvwGQH3_D&_nc_oc=AdmwJ28lXm957vn-m1lmajarNYQivYNTFDgzhB1ko5lgu-3RTzpSOS9SfkDp6a4ki3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsmzIwlnLDfu_ML9u5RsSrzMIN8ou5xvyL1xJ2WQvj8wA&oe=699C3588"}]}, "id": "8706180626113555", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "508789841952175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035396_508789845285508_7989382406479042993_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7kdW-Fe4TIQ7kNvwFFTgvl&_nc_oc=AdlP_Wkt5eI8rGmmO1xVT3e5Ay7nV13EkTH0t56dxSmEpQMS0zvdSHPQqC7oOazog2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftiNsybtHuMc-rEHigGV3jSgnzy30_wvcQwTPv5Zr6F4Q&oe=699C64A3"}, {"file_name": "screen2.png", "id": "510325685259902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_510325688593235_6153548243770529811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX7G0-U__1YQ7kNvwEL6bhj&_nc_oc=AdmYWEldL2Qb-xYdJncL2t45DTBsOyrWLwgmWF8nRtI4ZJvo2mxwRAqN_o6Pe1ZTCeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsaOtIyXOnO5mofriPL_LaHGoyLr9wUsHVO1a8uQe9NaA&oe=699C4EAA"}, {"file_name": "screen3.png", "id": "898900988347271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974518_898900991680604_4064162559334927459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo6Vq_56_0AQ7kNvwFddDFz&_nc_oc=AdnlVLuBblD7eIyHL5SxcYt4E2EUv65kd-Vvb5UrhsLYvo4EtpGsJHeEqy9tmdQsHPI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvj6CwSFBVBqtKNOblNby_lM8KCe3Xo_vboKS0wU3gHBw&oe=699C51E2"}, {"file_name": "screen4.png", "id": "1550771415533107", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035420_1550771418866440_5124599204833349204_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2IWg55tmAQ7kNvwFWNrax&_nc_oc=AdnVSf1x6RGbSxmylwnNGJr1aVaHNG3S9_VM4yibj_KGGqXyV7Jpj_BerSRgFh6ZJjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1hB7e-utI4FSV1Yl__jU6AQ9P8HTwHkADPHaQTm1Ixw&oe=699C5221"}, {"file_name": "screen5.png", "id": "1246664026750408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_1246664030083741_697450064622171552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iJspXjps3AQ7kNvwFzFNT5&_nc_oc=AdmR6FL_7nCzYvjChRiOouQjadGyMmeRtsh0nMpGDhoubIviL_A2DxhxOhSbejw1f8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs22_ACc6UFvYTsFSy185nuE_ZgzTzMQDAKXspbQ3faSQ&oe=699C621A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "3720853248168753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974785_3720853251502086_3604682786672398780_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVpIo609tSAQ7kNvwFlQSPM&_nc_oc=AdkoADVIV3gQEkDq2rz6q2EIi4A3W029zuR8v8qGfyf8AjQS3kY_yTxfinOGjUWPo4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsxwzIx5QWSNmpyBMxknlRDNYN87o2HG1sN4wRFeNKjw&oe=699C2EC7"}, "display_name": "London Walking Like A Tourist - VR Travel", "keywords": ["London", "Travel", "Tourist", "Walk", "Sightseeing"], "long_description": "Experience London through the eyes of a tourist on a nearly 2-hour immersive journey.\n\nA Day in London \u2013 Real Time Experience: Whether you have an hour or a full day, this app lets you explore London for almost 2 hours. No long planning\u2014just dive right in and feel like you're walking the streets of London. Perfect for a quick virtual getaway, it fits seamlessly into your day.\n\nPack Your Virtual Backpack and take a spontaneous day trip! No stress, no planning\u2014start from bustling Victoria Station to the majestic Buckingham Palace, stroll across the Mall to the Horse Guards, and enjoy iconic red buses and the sights of the city. Discover hidden corners and flow with the tourists.\n\nEscape from Home: Break free from routine, launch the app, and jump into the lively streets of London. Hear the city\u2019s sounds, from the rumble of buses to the hum of conversations, and soak in the real atmosphere of this fascinating city.\n\nFeel Like a Tourist: Not a guided tour or information overload\u2014this app gives you the feeling of freely exploring the city, just like a real tourist. Experience the meditative joy of wandering the streets with all the impressions of a real visit.\n\nStart your 2-hour virtual day trip now and immerse yourself in the streets and life of London.", "short_description": "See London through the eyes of a tourist: Stroll through the city as if you were there, walking for almost 2 hours from Victoria Station to Buckingham Palace, across the Mall to the Horse Guards, and continuing to Westminster with Big Ben and the London Eye. Enjoy the city\u2019s sounds, see people, tourists, and red buses\u2014no guided tours, no info overload. Jump right in and take a quick virtual day trip! Relax in a meditative experience that immerses you into the streets and life of London."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vrtravelx.net/home/londonwalk1", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8471867119529633"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "206041743479
peS-sHlauVBYGt-QpXOdOLrqh7b1BQl0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afszr7nqnsY_FHeD4MHqr2ZjCDP8umfQnQ8dd4iEuRSijQ&oe=699D8B01"}, {"file_name": "SolitaireScreenshot4.png", "id": "1189693819982277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292426_1189693823315610_1646303222247698398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84RlkyiVkXoQ7kNvwGe7W-c&_nc_oc=Adk9Pla3G4CYd_H3zpPkX8fERwHQz6Wa5STgYMXBw0FAgUOuqZfqW54Ymxzyrv8OdIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpvgiOSIXoMs9ZLP4_sW8o5YEj1Nj3TblRdJwUdiInqw&oe=699D8B3C"}, {"file_name": "SolitaireScreenshot5.png", "id": "1210805374492292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830815_1210805377825625_4930939265427360613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1hdwq2-MtwQ7kNvwH3aOgp&_nc_oc=AdkMJmAgt_IxVFHBbTk_qkYLEw5JdbTuyzjF6zwVEPduM7uxf0aynW9p0aG69LkxJik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftoag3MTSer4HNeCGuCgEilRLyViHkUeIeSBhz0aRb5lQ&oe=699DA239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SolitaireVRPanel_Landscape.png", "id": "871500632313941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295279_871500635647274_5005781711240289746_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng0a6iyXN_EQ7kNvwG3PX90&_nc_oc=AdkSs4j4K0g7UO8-ffGOe9Sh2hYI9bU22I4gYAZEEGCmNVy3NLTmu7GP2-_0VXwCspc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afub9Kbl5Jdb85vVXBA7vBJqZiRHzyUSXBhYByPTGvSlzg&oe=699D979D"}, "display_name": "Solitaire - VR Panel", "keywords": ["card", "2D", "relaxed", "solo", "klondike"], "long_description": "Solitaire \u2013 VR Panel is a classic card game built for multitasking on Meta Quest.\n\n# **Play familiar Solitaire in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Whether you are taking a break, filling a few spare minutes, or just want something relaxing running in the background.\n\n# **Traditional Solitaire, in VR!**\nThe game includes all the features you would expect from a modern Solitaire experience, including multiple scoring modes, draw 1 or draw 3 options, daily games, hints, undo, and auto-complete for completed wins. Customize your experience with different backgrounds and settings to match how you like to play.\n\n# **Designed specifically as a VR Panel App**\nSolitaire \u2013 VR Panel lets you enjoy a timeless card game without pulling you away from whatever else you are doing in Quest. Play at your own pace, your own way, while keeping other content within reach!", "short_description": "Solitaire - VR Panel brings classic Solitaire to Meta Quest in a lightweight panel you can play alongside anything else. Enjoy familiar options like multiple scoring modes, draw 1 or 3, daily games, customizable backgrounds, and more. Perfect for a quick round while multitasking in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26466681212938039"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2
_thumbnail": null, "display_name": "Vyom: The Combat", "keywords": ["space", "shooting", "galaxy", "fighting", "aircraft"], "long_description": "All hands on deck, like literally!!! Shoot your way out of the biggest Asteroid belt, protecting your spaceship and finding a way out of the rocky mess alive. Be amazed by the jaw dropping reality effects and graphics that work seamlessly in tandem with the controls and be the one to change the course of your fate forever. Smash\u2019em, beat\u2019em, crack\u2019em or whack\u2019em, do whatever you please and vent out your anger.\n\nStrategize your game play and hatch the perfect plot to fly your way past everything. Shooting guns, lasers, and other special powers that you can only get your hands on, in this amazingly thought of, well executed, and one of the best shooting games out there for this niche of a platform. HOLD YOUR BREATH! AS WE PRESENT TO YOU: \u201cVyom- The Combat\u201d. ", "short_description": "Shoot your way out of the biggest Asteroid belt, protecting your spaceship and finding a way out of the rocky mess alive. Be amazed by the jaw dropping reality effects and graphics that work seamlessly in tandem with the controls and be the one to change the course of your fate forever. Smash\u2019em, beat\u2019em, crack\u2019em or whack\u2019em, do whatever you please and vent out your anger."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ojasvr.com/privacy.html", "developer_terms_of_service_url": "http://www.ojasvr.com/terms.html", "publisher_name": "Ojas VR Studios", "support_website_url": null, "website_url": "http://www.ojasvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "FLYING", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_g
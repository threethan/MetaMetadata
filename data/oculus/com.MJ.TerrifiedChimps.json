830888_1627683091947741_9118787673799297890_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_FvadJQdz8Q7kNvwFElR1E&_nc_oc=Adp8QZD6jDE6ALlER4fPj3Y4_ayEi7uxHefWoU5jJ0hK2FUjTVNJNz2jXelVv551EW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxJKanRSsidzRPb_JImEyi8iu1-IGa2WdUa2Y0ZVui1w&oe=6AEDEE04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Terrified Chimps!", "keywords": ["horror", "chimp", "scary"], "long_description": "this game is tuff, why? because\u2014\nit\u2019s not just a horror game, it\u2019s a nightmare you can move through.\nit\u2019s not just gtag, it\u2019s gtag with fear built in.\nthe kind of fear that makes your hands sweat and your headset fog up.\nyou hear footsteps behind you\u2014are they real? probably not.\nbut you still run. because in this game, you never really know.\n\nand yeah, some might say it\u2019s just another gtag clone,\nbut nah\u2014this ain\u2019t slop.\nthis is tuff, built different.\nevery jump, every chase, every scream feels earned.\nno goofy nonsense, no cheap copies\u2014just raw, terrifying fun.\n\nyou don\u2019t just play it.\nyou survive it.", "short_description": "this game is tuff, why? because\nits a horror game\nits gtag\nbut, isnt it gtag slop? (no, its tuff, not slop)"}]}, "developer_name": "MonkeJadon", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Watermelon", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
QbMGk0x9TAlzdnBE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmAe3uiN-dq4B5QcNTuswBcxQlJWZddohK4EXyu-ktow&oe=6AAE9369"}, {"file_name": "ss3 - Copy (2).png", "id": "1627683088614408", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830888_1627683091947741_9118787673799297890_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J3vUZTsqfUQ7kNvwG8Li6N&_nc_oc=AdpnGfHfemSPjEFq8ohEdfdsGb8N3EvVG5eXWFR0sZ5n8brVKaP71GOvgB3YkVY41sU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAAFA4dKNk_VxJymTh6bXWtiwEr33NkwKm7k5cnfG_Fg&oe=6AAEA604"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Terrified Chimps!", "keywords": ["horror", "chimp", "scary"], "long_description": "this game is tuff, why? because\u2014\nit\u2019s not just a horror game, it\u2019s a nightmare you can move through.\nit\u2019s not just gtag, it\u2019s gtag with fear built in.\nthe kind of fear that makes your hands sweat and your headset fog up.\nyou hear footsteps behind you\u2014are they real? probably not.\nbut you still run. because in this game, you never really know.\n\nand yeah, some might say it\u2019s just another gtag clone,\nbut nah\u2014this ain\u2019t slop.\nthis is tuff, built different.\nevery jump, every chase, every scream feels earned.\nno goofy nonsense, no cheap copies\u2014just raw, terrifying fun.\n\nyou don\u2019t just play it.\nyou survive it.", "short_description": "this game is tuff, why? because\nits a horror game\nits gtag\nbut, isnt it gtag slop? (no, its tuff, not slop)"}]}, "developer_name": "MonkeJadon", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Watermelon", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odXjnKTaN60Q7kNvwEq_4Xm&_nc_oc=AdruKe06DYqVZeuZk3W4MucE1KjY1o1JEm-DWAE2P4op5xrRTgTiMC3uROBi0uujsbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QMieoTdXB6RJqvQ07PhO7mIsczL4PukIv9DVqMXlWzQ&oe=69F4BFE2"}, "display_name": "Ethereal Planes", "keywords": ["virtualdesktop", "productivity", "remotedesktop", "mixedreality", "ethereal"], "long_description": "Transform your workspace with Ethereal Planes \u2014 the ultimate mixed reality desktop streaming experience for Meta Quest.\n\n**Your PC, Everywhere** Stream your Windows desktop directly to your Quest headset. Your windows become floating panels in your real environment, letting you work from anywhere while staying aware of your surroundings.\n\n**Natural Interaction** Use your hands to interact with windows naturally. Grab and reposition panels, scroll through content, type on a virtual keyboard, and resize windows \u2014 all with intuitive hand tracking. No controllers needed.\n\n**Unlimited Virtual Windows** Break free from physical display limitations. Open multiple windows from your PC and arrange them anywhere in your space. Create the ultimate productivity setup without buying extra monitors.\n\n**Key Features**\n\n- High-quality, low-latency video streaming\n\n- Full hand tracking support\n\n- Virtual keyboard for typing\n\n- Multi-window support\n\n- Passthrough mixed reality\n\n**Requirements**\n\n- Windows PC running Ethereal Host (free download)\n\n- PC and Quest on the same local network\n\n- Stable network connection required for streaming\n\n- Content is streamed from your local PC\n\nNote: Streaming quality depends on your network conditions. Internet connectivity is required for app functionality.", "short_description": "Stream your Windows desktop into mixed reality. See and interact with your PC windows floating in your real space using hand tracking. Work, browse, and multitask with unlimited virtual windows while staying connected to your surroundings. Requires Ethereal Host app on your Windows PC and local network connection."}]}, "developer_name": "Ethereal, Inc", "developer_privacy_policy_url": "https://ethereal.glass/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ethereal, Inc", "support_website_url": "https://discord.gg/A8jHx68hNS", "website_url": "https://ethereal.glass/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25651103471209512"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1633859207607628"}]}, "baseline_offer": {"id": "1633859207607628"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772832660, "status": "PUBLISHED", "id": "1633859207607628"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25829101633409694", "version": "0.1.7"}, "id": "810068618707472", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25551773701142490", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25829101633409694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
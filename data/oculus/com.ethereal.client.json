8D9wG8vVuk1JLsw9mYoErmXjwRTMiVqEUZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HxN9C_ktqyt3SEGGP8b2ogwXk-WakcXwHyFs2sRmZ-g&oe=69F4A6A3"}, {"file_name": "screenshot2.png", "id": "902587462730076", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298502_902587466063409_2389161068815211221_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAYZGvooTFcQ7kNvwHSLnf8&_nc_oc=AdozOLngdBr63NPWwTU4AyjI9eborBSdlPmstn49NwQL4eNssFZTJW8LIGsmne1apxs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dof6Q6Kegm9dsGTCKkLL04tlbO5FUohQHFXFCO7F-Pg&oe=69F4A527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_5.png", "id": "1443039913824658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307346_1443039917157991_6161691794413494339_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odXjnKTaN60Q7kNvwEq_4Xm&_nc_oc=AdruKe06DYqVZeuZk3W4MucE1KjY1o1JEm-DWAE2P4op5xrRTgTiMC3uROBi0uujsbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QMieoTdXB6RJqvQ07PhO7mIsczL4PukIv9DVqMXlWzQ&oe=69F4BFE2"}, "display_name": "Ethereal Planes", "keywords": ["productivity", "remotedesktop", "mixedreality", "ethereal"], "long_description": "Transform your workspace with Ethereal Planes \u2014 the ultimate mixed reality desktop streaming experience for Meta Quest.\n\n**Your PC, Everywhere** Stream your Windows or Mac desktop directly to your Quest headset. Your windows become floating panels in your real environment, letting you work from anywhere while staying aware of your surroundings.\n\n**Natural Interaction** Use your hands to interact with windows naturally. Grab and reposition panels, scroll through content, type on a virtual keyboard, and resize windows \u2014 all with intuitive hand tracking. No controllers needed.\n\n**Unlimited Virtual Windows** Break free from physical display limitations. Open multiple windows from your PC and arrange them anywhere in your space. Create the ultimate productivity setup without buying extra monitors.\n\n**Key Features**\n\n- High-quality, low-latency video streaming\n\n- Full hand tracking support\n\n- Virtual keyboard for typing\n\n- Multi-window support\n\n- Passthrough mixed reality\n\n**Requirements**\n\n- Windows  or Mac PC running Ethereal Host (free download)\n\n- PC and Quest on the same local network\n\n- Stable network connection required for streaming\n\n- Content is streamed from your local PC\n\nNote: Streaming quality depends on your network conditions. Internet connectivity is required for app functionality.", "short_description": "Stream your Windows or Mac desktop into mixed reality. See and interact with your PC windows floating in your real space using hand tracking. Work, browse, and multitask with unlimited virtual windows while staying connected to your surroundings. Requires Ethereal Host app on your Windows or Mac and local network connection."}]}, "developer_name": "Ethereal, Inc", "developer_privacy_policy_url": "https://ethereal.glass/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ethereal, Inc", "support_website_url": "https://discord.gg/A8jHx68hNS", "website_url": "https://ethereal.glass/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25956354317351091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
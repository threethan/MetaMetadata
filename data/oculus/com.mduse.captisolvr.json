.com/v/t64.5771-25/11162676_131714487475479_7370042671663939584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjcXHG-z7UQ7kNvwG0CRtF&_nc_oc=AdociO6pH2jtg3aEUgEtXd_CAc875bgWDrmiEuj519jftx9gYiUTuiN8JM70lqSCZs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkI3KvTWk6KQSnE0gAnR2YKoTB7eS0emeYKD7w_ETW4A&oe=6AFC6AFB"}, {"file_name": "migrated_image.png", "id": "286976812282395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162676_119480978761272_495440725454880768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29qc8rCEKhkQ7kNvwG6sZIq&_nc_oc=AdoajYJHVAG8WtvzaY_4G5Dp1n1nRDn9_xXJifSShuccBuqGNYF01H9abL4zpyc6YQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUgO0pX2enR6X4JeRIKKTz6EbN9M79stxQkwkp1CN14Q&oe=6AFC9683"}, {"file_name": "migrated_image.png", "id": "214293819781967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_200122047194294_7934792920756912128_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKBPJpGarVwQ7kNvwE3qYpj&_nc_oc=AdrdwMOumfyx7WU0DKenEh4eOEaDIcGrDxVpRV1CmQka9pzgT_0vzOqm9SiiCJtD-sY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_1zgNcpZw_rVfWAcIXk652TkqoiKlN6EvDOjRkTlzuQ&oe=6AFC8409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ollomol VR for Captisol", "keywords": ["GROMACS", "Captisol", "Ollomol", "Molecular", "Simulations"], "long_description": "Captisol is a beta-cyclodextrin with an average of 7 sulfobutylether (SBE) substitutions per molecule that was rationally designed to improve the solubility, stability, bioavailability and dosing of biologically active compounds.\n\nOllomol VR for Captisol was designed to visualize in 3D-VR a number of Captisol-based supramolecular complexes. It allows viewing in an immersive way the movement of the structures at atomic resolution, explicitly considering all the classical degrees of freedom. The movies were generated by Molecular Dynamics simulations using the GROMACS software and the GROMOS force field with a specific parameterization for Captisol (considering a structure with four SBE groups positioned on the C6-OH of alternating glucose rings and three additional SBE groups placed on the C3-OH of the remaining glucose rings of the cyclodextrin).", "short_description": "Ollomol VR for Captisol is a Virtual Reality (VR) molecular viewer developed to visualize 3D-VR movies of complexes formed by Captisol with the following 12 drugs: allopregnanolone, amiodarone, carbamazepine, aripiprazole, busulfan, delafloxacin, carfilzomib, melphalan, posaconazole, maropitant, voriconazole and ziprasidone mesylate. The movies were generated by Molecular Dynamics simulations in explicit solvent using GROMACS. Water molecules were removed for clarity."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mduse.com/en/", "developer_terms_of_service_url": "http://mduse.com/en/legal-terms/", "publisher_name": "MD.USe Innovations", "support_website_url": null, "website_url": "http://mduse.com/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466119198397196"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "175403413038833"}]}, "baseline_offer": {"id": "175403413038833"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1510164000, "status": "PUBLISHED", "id": "175403413038833"}]}, "liveChannel": {"nodes": [{"latest_supporte
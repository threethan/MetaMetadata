.com/v/t64.5771-25/11162676_131714487475479_7370042671663939584_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjcXHG-z7UQ7kNvwHgfHV3&_nc_oc=Ado1K9WBkMF0ha02b49QKI58xa4AosJ79U-ETNK0eQ1v7yJBN72_sh71_f9O3UchcHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCnUMuJ8F741J3-sIYjPQAN5upqjGMrjw67cTmUy-Hgg&oe=6AFDBC7B"}, {"file_name": "migrated_image.png", "id": "286976812282395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162676_119480978761272_495440725454880768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29qc8rCEKhkQ7kNvwFERnOl&_nc_oc=AdqIz4ZgB0N70YnlamG5Jlv0wRuQ_jAF24XPLawKYp4veHUzm1fY-i0rZlVMq7h0D8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzUrwYw8vZqyPz96Rz2GHmv5IARBWqm2oga6S7itI36Q&oe=6AFDAFC3"}, {"file_name": "migrated_image.png", "id": "214293819781967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_200122047194294_7934792920756912128_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKBPJpGarVwQ7kNvwH4IWZt&_nc_oc=AdqO6XtMNq1ZKjqV7JqIV6pLEJB_J6n1lCrhjl3JIO3rJ1EyRyu4LTXbE7Ezt-c2Xhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKxLGVhhufSOd2tqRfKRr5EgfHXnNH7tFG7TDZJZC8xw&oe=6AFDD589"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ollomol VR for Captisol", "keywords": ["GROMACS", "Captisol", "Ollomol", "Molecular", "Simulations"], "long_description": "Captisol is a beta-cyclodextrin with an average of 7 sulfobutylether (SBE) substitutions per molecule that was rationally designed to improve the solubility, stability, bioavailability and dosing of biologically active compounds.\n\nOllomol VR for Captisol was designed to visualize in 3D-VR a number of Captisol-based supramolecular complexes. It allows viewing in an immersive way the movement of the structures at atomic resolution, explicitly considering all the classical degrees of freedom. The movies were generated by Molecular Dynamics simulations using the GROMACS software and the GROMOS force field with a specific parameterization for Captisol (considering a structure with four SBE groups positioned on the C6-OH of alternating glucose rings and three additional SBE groups placed on the C3-OH of the remaining glucose rings of the cyclodextrin).", "short_description": "Ollomol VR for Captisol is a Virtual Reality (VR) molecular viewer developed to visualize 3D-VR movies of complexes formed by Captisol with the following 12 drugs: allopregnanolone, amiodarone, carbamazepine, aripiprazole, busulfan, delafloxacin, carfilzomib, melphalan, posaconazole, maropitant, voriconazole and ziprasidone mesylate. The movies were generated by Molecular Dynamics simulations in explicit solvent using GROMACS. Water molecules were removed for clarity."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mduse.com/en/", "developer_terms_of_service_url": "http://mduse.com/en/legal-terms/", "publisher_name": "MD.USe Innovations", "support_website_url": null, "website_url": "http://mduse.com/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466119198397196"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "175403413038833"}]}, "baseline_offer": {"id": "175403413038833"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1510164000, "status": "PUBLISHED", "id": "175403413038833"}]}, "liveChannel": {"nodes": [{"latest_supporte
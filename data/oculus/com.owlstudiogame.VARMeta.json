7249_1608313293086943774_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hvjoQoAbnkQ7kNvwF4Wn2m&_nc_oc=AdrM94eatTE1KnXm4OsywraKlWaBZ1OCK5LCPuw4ZRqmep3iIpp1GDjuBxBgeNOxO10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg9bzZEX1snAmxK22J6T-nX6NZV5DoDKmeX5OY_sMbJQ&oe=6AFF2056"}, {"file_name": "444.png", "id": "1287691715552353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031491_1287691722219019_5558679888528577366_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3EaOyvYrEQ7kNvwF4qmUD&_nc_oc=AdozDyOzn4jCdjCV4ww49W4aj9m_EsENC7p5QBXmraYL17JqeTrtJrjgAyHidiQX7gw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRnCTYymJXTsGJ5mmUuvvFjHP4jYkkoKHHhSalWCHyGA&oe=6AFF136F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CO E.png", "id": "2286502571688121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974562_2286502575021454_2445887145770267501_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1rs203qnNwQ7kNvwEJNABM&_nc_oc=AdqhwJyK_lfISDjo4W_vWm4Jh_0ug3liVAtJtoRXXyfeC7fGf4LWqvjc50gPlLx95lE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZHgIHUbEv8-hEMDuyghsGogRXs_GfbUneyy5M2KdV6Q&oe=6AFF2ECB"}, "display_name": "Video Assistant Referees (VAR)", "keywords": [], "long_description": "The role of the VAR is to assist the referee to determine whether there was an infringement that means a goal should not be awarded. As the ball has crossed the line, play is interrupted so there is no direct impact on the game.\n\n-The referee informs the VAR, or the VAR recommends to the referee that a decision/incident should be reviewed.\n\n-The video footage is reviewed by the VAR, who advises the referee via headset what the video shows.", "short_description": "In this simulation, you will be the video assistant referees inside football match"}]}, "developer_name": null, "developer_privacy_policy_url": "ht
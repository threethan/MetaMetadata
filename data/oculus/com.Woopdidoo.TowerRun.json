i1uR_xmBymx9KnSx5-km_D6zHrI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hO179RFvfP_qEgonDmdvOpXj0VNv-BC14zyb1oIKYhQ&oe=6A33F531"}, {"file_name": "Screenshot_4_2560X1440.png", "id": "346328877924980", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982614_346328881258313_7127484113356874876_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLiUdk6n7_kQ7kNvwFuL2lc&_nc_oc=AdrxIzXGNL4qcufVqLp4MzNPnXCTIcrVv4rI-2Z8fYmS8GSvz5yOw1QP7iS65Z_l-Es&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-THBUc1sLqRn10i6dbC6TvqRtgoyZURjeZ3uxCjJfaCA&oe=6A341629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstralGuardian2560x1440_1.png", "id": "1512573919540644", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_1512573922873977_6935595617295598712_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqp35NCCzGsQ7kNvwGbJnk3&_nc_oc=AdqiGBGGpwt_pry2VscOPe8ucsyasfqqeg5ycA9opKXY5EETe_ZglrbaifFd_sq-fm0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Bhzw56MIzkrWcvlICbuQwKvbWY7IOOP3wkhCDlYL5A&oe=6A33F71C"}, "display_name": "Astral Guardian", "keywords": [], "long_description": "\"Astral Guardian: The Quest of Lyria\" invites players into a vibrant, cartoonish universe where dimensions are at risk and memories hang in the balance. Under the dark shadow of Mordrax, the tyrant who has enslaved the universe, players join Lyria, the last Dimensional Nomad, on a quest to recover Memory Fragments from various dimensions. Each fragment not only holds the power to challenge Mordrax but also preserves the memories, histories, and very souls of every dimension's inhabitants.\n\nWhat sets this game apart is its innovative mixed-reality gameplay. While guiding Lyria using the joystick, players can also interact directly with the environment. Grab, shift, and manipulate objects to solve intricate puzzles and help Lyria succeed. This unique blend offers a fresh and immersive experience, making the game stand out on the Oculus platform.\n\nDesigned with families and kids in mind, the game delivers fun, challenge, and creativity in equal measure. Although currently featuring one world with four engaging levels, \"Astral Guardian\" is ever-expanding, with more worlds and adventures on the horizon. And for those competitive spirits, the integrated high-score board adds a layer of replay value. Battle for the top spot, see how your performance stacks up against others, and immerse yourself in this captivating MR adventure!\n\n", "short_description": "Dive into the cartoonish universe of \"Astral Guardian: The Quest of Lyria\"! As Lyria, the last Dimensional Nomad, traverse dimensions and collect Memory Fragments, vital for saving the universe from the clutches of Mordrax. Experience a unique mix of joystick gameplay and hands-on MR interactions, solving creative puzzles and challenges. Perfect for families and kids. Ready to make memories and top the leaderboard?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.woopdidoo.studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Woopdidoo", "support_website_url": null, "website_url": "https://www.woopdidoo.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "976737776778108"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"st
nc_oc=Adllh3b6exGnkYtkPfgG8Lk28qsgn6GvaEgSxfB4kxLxKKbyib-YrKuEmx-qFl7gVsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy-XOIfYSriqMZ5WuRWJAmona-aP4jqixRO9ryA1quGw&oe=69AECD47"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [],
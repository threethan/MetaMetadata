": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031316_806565933935461_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg2JcQQQZ8oQ7kNvwGoac9v&_nc_oc=AdmVgsvWDG0jN6S7j8FPQvDnlOdWLuDL-f7M-9ctuazm4Mq3K5Hppk3gXGBT-p-wz0c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoqssC4bj7LqM29idbZ4QkxMQG71Kzv0BDKjVdUFN9cg&oe=69AAE6C8"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irnMQHQ8pu4Q7kNvwGADGDu&_nc_oc=Adnl7vEfOtY9jkc9XZUtNfwnPQ2gr5MBG6L02GwZvDmYr8IPXOaJw03kr0pNKvVMKm4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTuVfowUezwiaunTIaKxtdOwEst7PEXb_LAnyYSb-XVA&oe=69AAB273"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXIuC3_i6YYQ7kNvwEaK_7g&_nc_oc=AdmlZXvpZU0fayXiM8HTvGlS8bjC5Zbo4VPqsZeuJwMv3qDGR7Fc4Bo9LyzkVgkTaRQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAgbUm_u3_-og67fCHEk84oUrKiarsXVAKP_zX9fx3aw&oe=69AAB4CE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa7SeNH82lQQ7kNvwE2MclM&_nc_oc=AdkXDB7RduM0vHuDSs5rGPmuBtcINrlYtMszbQqBvBrmWZ0PO0bskWVmqLn9kAUi6GY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF37peqE2ro8dTtr7FBF643sEkosBMFgRZtEIp4tbKjA&oe=69AAB46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXjQHgHUkiEQ7kNvwFtTdUF&_nc_oc=Admi3dOqZ__dr86JA7qwjtuWNuoIGkku6s9WqMtanQLKbxtM9ElRUR0HpORi6waBRp4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwe8sSfc5Pwwr5WEev5wOacMDepMm5uQQgixDbzJ6HpCw&oe=69AAD8C7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracki
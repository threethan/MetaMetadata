BE78F3"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF9zh3dLZvoQ7kNvwFuySF-&_nc_oc=Adml4kewdY1vvKa3KLbjBxE0fitkzeOAedHtODIniu0BGgOG2q-OxlwDNfR2gPSzx74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5PiNvmMDSH-4f5HqBmDn29p2iCMt9X6AtxCNvN_i_Ig&oe=69BE7B4E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUoKBT8-ac4Q7kNvwFTk9-w&_nc_oc=Adm03C1FCfMn9ZNRDdzB5krmsCqcLIrsHLYIID9UtmpUe4aaWr-hwvuaHvWpGz9qdIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5WfIqGXpPtE008x8kFZgvxV7OPMZt55DEJhTdoQpYxg&oe=69BE7AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndY_icPcF8YQ7kNvwGVFIxk&_nc_oc=AdlHOxxkdGR_Iyr33x1tGtP5xRmAOiACd70f1nPmEXMqwMdBXd0z_T3Wdvd2lhvn-zU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6EA5JFZfiMbDpqREvbDXy__1AZHmtaxIK6OxuGbz7hw&oe=69BE9F47"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "712149673578486"}]}, "baseline_offer": {"id": "712149673578486"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668445740, "status": "PUBLISHED", "id": "712149673578486"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4824397637663019", "version": "0.2"}, "id": "2006247629568408", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4645122938923824", "is_concept": false, "latest_r
_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-heCWGogP6AQ7kNvwEfcG8j&_nc_oc=Adm0yayxfQg0WUnm-6gj4wlm8VgdntZPzQLBCbyyMvytrCV7_9h-zwxIa7i3WVFzL8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvrtSuYTsxvnMo-Igso2BoVCF5_hrjpg4x7fRe3KNKRzQ&oe=69A56888"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSRQPEmsKyMQ7kNvwEPLvZ2&_nc_oc=Adm8okRvapIWsiioqzfZ68581O1QhHwuy6mOjeYeioC_7ZhscF0-NEkm0Sbbi_9t9SA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft_WA7fyK5L20yp9YExvQBwqB-nbfsnQF2s-LfGbCbRLA&oe=69A56C73"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6s3F0x8oXQQ7kNvwH7K9Ny&_nc_oc=AdkgjAaJeS318Qd8O7L5XQY4ofoH2LPWo1W89CJkZmUD3pPW66CAIcfIIM-WUv8txtM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuwE1HOhm36ctTrbw4ob-aX1DCp_qFtjU6PIn1tyuBZ2A&oe=69A56ECE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dy89DFMW_8Q7kNvwGrYJoE&_nc_oc=AdmoyYlYyrvxFUVQYtBgdvp7GEBRUnxCz1zmrHaZHFFz-RceUV4WNteCcbel6V1WmAs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft-zgVzWhhwaaPZNyNZkmXGC0ANo_GcaMFcH1I1bv0awA&oe=69A56E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oadhd6Q_jsQ7kNvwHwqsz_&_nc_oc=AdloEcrfOC0xZzXESKlshUnyjN2DqdeN2MvbPSJv-nAlnU_Rz24mcSGdJp7ksXhSKg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftG5kPBWr7s_Efrenlp5PKu0qkaSJSS1bG-ahZAYZWYkw&oe=69A592C7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
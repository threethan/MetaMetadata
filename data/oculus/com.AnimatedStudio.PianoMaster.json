_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbomHUHNCSsQ7kNvwFqAgxu&_nc_oc=AdkbBjMZrzfHrYSdNm-MVAbLfBNHWRgNfaUGzxMZDcUqjoK6FYkt6kNIDBlaj3s24YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsv77tgE87cwCopIK7xXFw4YLJDMbgeS-lhWary7X0XoA&oe=69A05AC8"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ds4aXSlWF8Q7kNvwHvUaVa&_nc_oc=Adnm-ws3wryHTovnUfOV3S8sLxzAgyRSqb0pRpmLilVFpzIFGTSsYRqsSTUgHHs-D-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP410DdYm-CD9y2qu4C3XEP0upctypIVwZiFTntSjIkA&oe=69A02673"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxLnQM9B9M4Q7kNvwFU4Wki&_nc_oc=AdlZqLppdpbYNyrFa38tLwDL6E4TeoVbNQ3ZGyS_-Dvfqakiwws05SSIA6XY1wEDhzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5dLLwwLHlH2UHRo-AC40y3zvOTZGuBqB1kEWaaY8gtA&oe=69A028CE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz15b2s3XPoQ7kNvwEEdfRx&_nc_oc=Adl4XatkYOD7tpIhgMWgobudRMqsHogFVtx0em6wzaiFHYwXPl8RzbqhdBy3lsAVFuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaWn0aUwANXxpiGEFib3WuO66hO27qa7SkysM7VZuwsw&oe=69A0286B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uBk3kn1ZWwQ7kNvwFH5TuI&_nc_oc=AdmPHoZh6A-HAFeibzJ-A5twYh8jIbxHaTfl3_WSN7pOjv6Ez7qQ3AziCJZbbAMNp3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3rLTctK-VYDkT7jjbm1Qi-AsMP2DGQ2u2PqcGmnp3xg&oe=69A04CC7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
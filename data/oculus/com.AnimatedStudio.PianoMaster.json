_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRhndt_EPvsQ7kNvwG5YMFQ&_nc_oc=Adk_PL-GJptpWkTP_ma123rUTOqzXs15xG6sPMLAlxFXr1YF-JC8n3dmBG_jMUHPH-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8mr3hkQ_Jr5tQerom2BVnXEdoZsNBEFjOLFc_sXWdvA&oe=6999C348"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4orN97YR_34Q7kNvwF-YDvA&_nc_oc=AdnTToxZtA8WIgoGiK7Z4HLH5UkXfmBLeMyoSpGcQqJxXd-WRsNqtVjMT4Eea9HPPEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afszt-uiBFkcczfByD9Z7hdqScXoxf4Ai5hQ83c2SFUPeg&oe=69998EF3"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unUdk1it28EQ7kNvwHRvCpP&_nc_oc=Adk2WXTW9SSWJTaD1mOdlLJH11aWvbwjw4NK3tz3qpzeVN0ThIn9ME_ClB09QJ7GMhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxyIlRnSGNkSZYURLNWR96VUtO-U_6YwulRpp-Z2g5iQ&oe=6999914E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kJ-iXLalSsQ7kNvwGbRCF7&_nc_oc=AdmwK-DSNpKTvQvrx0VXmDfEIjvJZcD5MBQGaceyK85y3PI47EkhSEltAsz9v0y428U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIJYU7IYloGdOxJX8xLovkYOYXrROQAx0oeIUKPQ1o8A&oe=699990EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk3DCSQTD4sQ7kNvwFAO5m6&_nc_oc=AdldsSqzYawemFS2fQ9838glLr5bG5nSR_z4YDCgJ_frUBSdt54Vnf4TVIQxKSD-36c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftljex0g2vAXKlp5t6I8niAoJSPs_udlb5StfDg85PEXQ&oe=6999B547"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
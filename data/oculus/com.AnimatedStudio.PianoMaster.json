_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbomHUHNCSsQ7kNvwG5cvQI&_nc_oc=AdlB4y9SiVIa4-x4co0-57NyqlkZMmLUrh2n1U4AawsZZGT84BjCXbpe-TunjLZppr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvTzt0mOcN8e5LkzAZgwScIwOkDa3w03be9w1OjPK-nKA&oe=699ED108"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXgTZ_jlb10Q7kNvwG3SDyY&_nc_oc=Adko6bAV92mTiwVoLi9WWJ9faVls_6BkMY98qXHYfj55En-CWgt8ORhyYx7GVX3Kk3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3BOQzHPdabYlXFgmhrvxNnLWErWalhimoq7b2ldOyNQ&oe=699ED4F3"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MslEMITtyL0Q7kNvwGqVSEh&_nc_oc=AdkEmCV8B0RRyRrBmNFo2BeiPU8ro21-6p0Zhwy5csWiqgqj5jkzJ8hsKvkWkcvmKac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUHOfptAva-4MZ31rrqia37K2XjQe5yMv-C67ujFYjXQ&oe=699ED74E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz15b2s3XPoQ7kNvwHnPi27&_nc_oc=AdmNI2WuCy97ynUm4XKtV9gZT2WYZ6GitP6fNDnTs7oJDlfs5jWyyaVCtJWQUDOFxA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5o0mt08QTocDxlgYuTy6eq_KCrXm53uLaX3b-GQnF4g&oe=699ED6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uBk3kn1ZWwQ7kNvwEj7l62&_nc_oc=AdmrQ1zEUyOgCTUyzpffRXQdSPQMsk7HZ43tG8yC1S6PUzeIJr6Ex_lFb93GuzOPdrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvOTZTh-zGK8G86hvZhiCSZFKMi6bDiNQeppZ_gFoB7Ew&oe=699EFB47"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
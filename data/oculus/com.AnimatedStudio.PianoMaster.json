_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbomHUHNCSsQ7kNvwFLghyc&_nc_oc=Adl7ON3DgtuBYmEpT7H-XR7KNRlUmU2RzpzQnPde3XkbZN88B0DBwww_-GdTXt67FsY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu11fXR2rSSgSVqKaxkxdNEjlkxdvS6m6kySIkOa-XqtQ&oe=69A1AC48"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ds4aXSlWF8Q7kNvwFmy5XE&_nc_oc=AdlsmaE3O3AABbDSNVhyQnUnM7Z9XZTYMCBBg9rkkxu3vpaKzJ9kx5HfAvwwd_hisPE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftJ_LP0REto0FfZGP5QNy8B6mjpzxO4_rf6piIcedLisQ&oe=69A177F3"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxLnQM9B9M4Q7kNvwFeaPsj&_nc_oc=Adleq1ahq67myMXcdx54rLSJvb7_ytSsHqY42n-tDf7cLWcgZhVoGtQBA3uWRB2TEj0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuKK007bGu5k2jqv6Uix607__T4cuLeiA0M2HlNtjmZ6Q&oe=69A17A4E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz15b2s3XPoQ7kNvwFLDFC8&_nc_oc=AdlYkbyzMjJbq1pE0AflORD_3ep0zmW0axBt_nXLh_uZmYuGInrjXxMssbgUnrItCK0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsl3iM_GCEEQDMmLry6CS2pNIWq6kCHBfb_VjLXKaRC2A&oe=69A179EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uBk3kn1ZWwQ7kNvwHgWFZ_&_nc_oc=AdmekflcSdgQ2f3VHOWEMkkfpaYP7Q7IBCBrREa-6J78LSc_xB13QDLsJPpefQW-2l4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvox7kJnjLhk6U1rqcmZUZNN3nlc5HhApsDCebg_rkLxQ&oe=69A19E47"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
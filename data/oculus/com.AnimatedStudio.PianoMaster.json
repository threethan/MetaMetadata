_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRhndt_EPvsQ7kNvwG0HBpV&_nc_oc=AdkKD_6fZmsRz3xmYAaePFVQ1W7IAJhiApmL6JH5xFPEsXFfHT7dgeSd1Bq5YE9gttk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsw4zgl60H5zmWGllzT0XQFvix4S1zjB5ucIwyHIPGogg&oe=699871C8"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4orN97YR_34Q7kNvwHvoSO2&_nc_oc=Adn9Ajihzmy6yu7oSSCKw1_MRL_WLlEA7YgElN_UQInBl5L0d2Qd43w33tkx21Jk2mE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs5FUEFHsfCpnR-FkHQfNTMKz__IcHzcTjZ9F2IYg_PJA&oe=69983D73"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unUdk1it28EQ7kNvwH7nYXy&_nc_oc=Adk7gXHyCFuqXA01UfVDj4RoN4gtS-lClga0j5Luvj5dX6c6eeRqtkn9RI7dBOCS2v8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuvdMoSEQKIbr2Od2B2XhDfPmGOUb-JhSDl9_PYuFiDUg&oe=69983FCE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kJ-iXLalSsQ7kNvwE1mqcZ&_nc_oc=AdnqzUPKSuGK9J7o5A-Nl4bSaCc38JSbLhLH4Ld1UPZDcnUblFdHJeCA8V7LXH7YWbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft43fbd3WkiysrRPvfG7NiJCiOwPwUwcKi-VqFvE3CCPQ&oe=69983F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk3DCSQTD4sQ7kNvwFdrfz1&_nc_oc=Adkr7hnM_QSOnjELV7rg4pFWg338OiAibSaoL7nHucx9UgWqj3vDG1ZNnRjUGsZ2UbQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftqCsMjzRPKzWASAhA6IhAI3ULQJ6Yn2NwX5QjC4nCNKA&oe=699863C7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
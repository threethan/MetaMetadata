_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-heCWGogP6AQ7kNvwGoc4D1&_nc_oc=Adk5jbuNvFETU6ZxyFwQUZPnZe0rsoz5bTkwB1Xvq-o9qijqpcWR2UISLQ0gSv_pVGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbB0OTCQC8RQymetBjjZ61D_ZxWh_F9GZmxC0zdPMstA&oe=69A2C588"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ds4aXSlWF8Q7kNvwHQonSg&_nc_oc=AdnPlH0XTfC8RSBpfT-SikgPXvIHYCv6r8uvb4CVwl1bxtA3P2e-81rCx5vqUlLRqZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5HcmjlvlPvYnwRjq1MzpeikFvkeD5AfWEII1MqPJlFw&oe=69A2C973"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxLnQM9B9M4Q7kNvwGgqGWe&_nc_oc=AdlQlXX6NgzeDC2mKHOvI4myDvQNUXKYbxMkmXlnNBOjJYP2BsyOaRsMJnGZmINtIXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRgVauyBWlP1rC8pIG3NcwmQGbM_vX7h1Gre0k6Ecfbw&oe=69A2CBCE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dy89DFMW_8Q7kNvwFmNxVy&_nc_oc=AdmiRxp7VlS3ibOvtlLzNqhajfepWf02LEBQS705OeIOxdnGeHrScjORM6oZfZK-ZOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsV-JCkZ-PrIclcsrW_MX8_nmDJPjbRtQ_ooI2EiGDYbg&oe=69A2CB6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oadhd6Q_jsQ7kNvwFGJZmr&_nc_oc=Adlt5trXQszEVSmih6nFq6fcdf8dNnPUkNtmysem2j19A7EskD_ImqW-_PCRTISX_BM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4N_jMlRNfm4bhVRgmiCv-gvR2cBJTsjmvCFQiGvfGAA&oe=69A2EFC7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
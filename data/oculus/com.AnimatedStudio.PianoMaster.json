_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM0p0CtmM2EQ7kNvwHartqM&_nc_oc=Adl_RVwjk_uIyZ_KD8PQtndoH5Qd0StTIgQDgVSMo3Dy_U54nNhi9cEh7DGHIikpj_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0s_6u8wc3Bt7g-5yOeOSkYBhkE5ctUoNS5wMuViTXbw&oe=69A6BA08"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSRQPEmsKyMQ7kNvwFFi4ia&_nc_oc=Adm9BQWlbYnOTjFm8uYwhznZunjBz9t_p9fH-uYueqJb--KazyaOOwgNpZay_GYRm4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMIat6Mxmrj8FGfbnfoi_H07EnL9XzV_Usi38M2PK69A&oe=69A6BDF3"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6s3F0x8oXQQ7kNvwH_mmHb&_nc_oc=AdmT1u-nthDQPwukCApYkC5UjU0FDIhCfUOMPVTHYIb-HrKm01o5_GZLfYvkbYqxexc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft36YNmuBiVWLK_7batvAM-MhWA3Jx513OnzqzivyFKEw&oe=69A6C04E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gof3IuUnYzkQ7kNvwH3RcMj&_nc_oc=AdlJ7P5oKMa2iy7SzX9_aqsnnHc059kKG9zrSbqXofjFAMA5n9Df4lq7te6ZxljuAIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuLjjDTjVmTAA7do2IEz0RPRK5XPRLWUJu8soTtXdUUA&oe=69A6BFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v82BZsxHDYQ7kNvwGpqt2o&_nc_oc=Admhqz5ivfFSy3ME5Yx5q6llWXTEHstu8G_EhUfamtYWGgMIgHsf6y5QX2jGk9nERHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxHwcAVtac4yHfGeMGtdpuoHzQqXe-LT_2arFZ60zgbQ&oe=69A6E447"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
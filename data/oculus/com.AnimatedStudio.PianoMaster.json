_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufm_mjkpMe8Q7kNvwG_dXXv&_nc_oc=AdoW_p956JPdsB0Yx6cHQmRUotbFVt_Oac_AFy6UvIrENstMJ8QTJuZqVaGvhYcPoJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af35lwwPa-3_Ufq3UfBjdOB0TExat1RheiK7ergDOFbjfQ&oe=69F0C648"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRxj6C-zz_wQ7kNvwHnZhnH&_nc_oc=Adr6qU4RcWUsGbizKTOwJXoiRY6HXzjGCeqGlGkIsFPgK0uyb3gTB4rM4xNrwtmnYM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1jgd3kPlBQb-PTHATpxIC0w9ry8CDc-KgUPJX7WwSRpg&oe=69F0CA33"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4eEnaos974Q7kNvwFEFPbT&_nc_oc=AdpKjZWH7BC7b1pYBPOCS6KWv0emTnAHulYmU5Lk2kMMW-ZgpS4KvTGx9fDE5y97qqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0WKx9BTwaCHM0DZb1AtNRnBEzGKc7mcqlUImbuRkkBbA&oe=69F0CC8E"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMBLtXCjaXMQ7kNvwGss1Ea&_nc_oc=AdpZeb3mgB9BBkd_zfsmB7dAuaZ63SiAF9unj3-xwYXVsA72AjLVr9CMWA9MBNaegzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0kDlTNOb0wOksINYm9IwKggJ9phE7OuZejUU_McMObDw&oe=69F0CC2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UIb0yOFW2QQ7kNvwEQ2g5T&_nc_oc=Adp8Ceo8lBWSK7GmzhBbU_Rpv6hITSjENbVdGKTCMKu3FJTbPYeAxLmbJfGVnLACBq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3ZNbHtrwrn7L10z7nQVbUQXkJnncMZx4CwyE5AIskHTQ&oe=69F0B847"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
_4626090537241292661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_98GYgMTczwQ7kNvwHJOJDc&_nc_oc=AdlWH8jXjXx5UQgdygoC7DEzH9G-FLXUfiH25BFtVNSaCxuSg-6LhPWkhr58xwmXpo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvwKBvghHmMvdPiP5GGNv-2ROXZW1BbPi4Z3Cvjf_kD7g&oe=699B14C8"}, {"file_name": "PianoMasterScreenshot2.png", "id": "542382091050305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031325_542382094383638_3593005796986321830_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4orN97YR_34Q7kNvwEcBQCC&_nc_oc=AdmrK1ZkePtRYgYi3l6f_zW5Ztt4M-YCYst_l4uXijCKYf_yqOhrccrG7WXYMoiR8YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsTzkYT8rjj9QYQBCue9D249D-cv01yFTB8ftoyPzGInw&oe=699AE073"}, {"file_name": "PianoMasterScreenshot1.png", "id": "1468841946959296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031337_1468841953625962_8555948057900594293_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unUdk1it28EQ7kNvwFBFnTs&_nc_oc=AdlZszAI0xR7Ck5KnA9n56IiVnLYLh7k6rAM9jkvrFGijTvGNUhgdIUxB01pyE1ML9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-VAP9dlPcZuP9vQsATIpHGj21-M2xzxEEA3VjGku1jA&oe=699AE2CE"}, {"file_name": "PianoMasterScreenshot5.png", "id": "1144364969531007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_1144364972864340_6791246435628573982_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odAmn1HMI-0Q7kNvwEoKvUo&_nc_oc=Adnlclj9ievjvqhiHbqGi6Oybl_1fpHKHinMZffuUSkyweHDDc62GJpa7c_tszKFFHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsLOtFPDyYyNDS4MYO9dMHRSLWphL4ZvzIxFhJzmDo9lQ&oe=699AE26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PianoMaster2560x1440.png", "id": "682657800087044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_682657806753710_1134793654629226174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r90NDhZzzh4Q7kNvwGwiwRH&_nc_oc=Adlq-1CCZjnSRhzSFhiidlEOPOOii-WbG2i0GH2Zy6Qv3ga7Ocj3IthhdZkZGDZhQqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftUdk74Bfb0_8zSY5l3KtYbe9v7S7XKfNlKa_tvZGqUvQ&oe=699B06C7"}, "display_name": "Piano Master", "keywords": [], "long_description": "Piano Master takes the user into the fascinating world of the piano, through a complete learning course. The course contains both written and video lessons, with demos. If you are already a professional, you can play the piano freely, or if you just want to impress you friends, the Famous Songs section is for you. You will be able to sing famous songs easily. You just have to press the keys, we take care of the rest.\n\nPiano Master uses hand-tracking for a real feel of the piano. You will be surrounded by a real theatre, so that everything feels like a warm and professional place for playing and learning.", "short_description": "Experience playing the piano with your hands and if you are a beginner, enjoy a full course which will take you from the basic notions to the most complex ones."}]}, "developer_name": "AnimatedStudio", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicypianomaster/pagina-de-pornire", "developer_terms_of_service_url": null, "publisher_name": "AnimatedStudio", "support_website_url": null, "website_url": "https://www.animated.ro/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463699174109102"}, "review_messages": []}]}, "cover_square_image"
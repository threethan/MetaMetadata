5275878652_1063682198096940236_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpSyjOjSMnEQ7kNvwEPssbF&_nc_oc=AdqUgVEvMeNZDhTeq7IwzMcRpdwuxVeCuCSqKT3Bdwgbf05EeyK7lOrhc8ZdArCgqQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoI3wKGeIwegNJ1xeGlvXWaG94yd5fZxK155YalVaNLA&oe=6A52328A"}, {"file_name": "Screenshot 2026-04-18 200036.png", "id": "2534761203593957", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_2534761206927290_2296623682160429728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4g7GlmwwkYQ7kNvwGEc4qs&_nc_oc=Adry9qwME1ZvP_MNOv2JgFuJGF4QYdvi-laCdZLLUegUJMAGm8voKYAYmxzXZF_xRd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwKoaPKA1SUbLodJ9sgKBH40gEZBf5X6d02PUsAcsQkw&oe=6A523635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-09 150257.png", "id": "1251874797092021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_1251874800425354_6853750832506280831_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcY25zjWXncQ7kNvwG_jbEW&_nc_oc=AdpbXNgxFH6BsPRFXO3AdIOommuzcqyrvAXnIVc__-OmbvoDJwc9zcrYHUnWDfI_j4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSE86pYulcnBmNp6ZA7ogsCdLI5jpNaEhCRHgIVUWHog&oe=6A525342"}, "display_name": "Last Call Delivery", "keywords": [], "long_description": "Last Call Delivery is an immersive VR delivery experience that puts you behind the wheel of a vehicle, racing down the highway and navigating a handful of city streets to make your deliveries. Feel the thrill of driving in first person as you dodge obstacles, speed through traffic, and shoot pizzas at houses to earn money.\n\nUse your earnings to unlock new areas and buy businesses to grow your operation. With intuitive VR controls and engaging mechanics, Last Call Delivery delivers a fast-paced, hands-on driving and delivery experience you won\u2019t forget.", "short_description": "Last Call Delivery is a chaotic, funny delivery game where you drive around town shooting pizzas at houses to make money. Use your earnings to unlock new areas and buy businesses as you slowly take over the city"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Jaime ", "support_website_url": null, "website_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26700930126224299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_941133748621274_5525659080105015683_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYaXyE2gemIQ7kNvwGL92_z&_nc_oc=Adp2YVEbNQEmT4dUf0K0OV0bOqL6qLrmVgPzHwwXHwJLJB8or-staYkP_DJ0gr8eKrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTOQRkAoM6GqRDTVyte_XmfXQK8Qy2bJduFJ9N7sXAfg&oe=6A526382"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Call Delivery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1778040000, "lastRevision": {"nodes": [{"id": "25609039658746690", "release_type": "SCHEDULED", "administration_stat
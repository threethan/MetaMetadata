https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_2174546657280223_7213475315598617025_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA6vzr-i0PsQ7kNvwEkZsn-&_nc_oc=Adpq7-RL-o-KQaV7JgiVBZrXusdrRfPBrd2EQopmWglxbfxBhhS5KM8YgU20Wk5_VfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGlZwC6CKfJB6JjHLxygqNYuPL6SqvF6Trjtu6PU_InQ&oe=6AE74192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-06-29 135529.png", "id": "1300844158740943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1300844162074276_7750567699025893880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqazEnbqXZ8Q7kNvwGZ8eWD&_nc_oc=Ado3A1faYxifpdIdCO5T_xP_aR8R9z8OZcpT1XU2AH6mDiRmcdEyobfGErL05S6u6gI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0DS6-rJEc6UheE4h7iF7R-YE2e2OWbGMPCwbW-x0PcQ&oe=6AE7584C"}, "display_name": "Last Call Delivery", "keywords": [], "long_description": "Last Call Delivery is an immersive VR delivery experience that puts you behind the wheel of a vehicle, racing down the highway and navigating a handful of city streets to make your deliveries. Feel the thrill of driving in first person as you dodge obstacles, speed through traffic, and shoot pizzas at houses to earn money.\n\nUse your earnings to unlock new areas and buy businesses to grow your operation. With intuitive VR controls and engaging mechanics, Last Call Delivery delivers a fast-paced, hands-on driving and delivery experience you won\u2019t forget.", "short_description": "Last Call Delivery is a chaotic, funny delivery game where you drive around town shooting pizzas at houses to make money. Use your earnings to unlock new areas and buy businesses as you slowly take over the city"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Jaime ", "support_website_url": null, "website_url":
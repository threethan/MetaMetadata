https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_2174546657280223_7213475315598617025_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L9UKBxWeZ0Q7kNvwEc1oVk&_nc_oc=AdpMXB_-giM9ySR4BrDVFuX8wAJJbh3MRrCjnqUCaXRq3Taqb98B-BYAGtdCIteCM9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8EmikEOFwXHjYsiWxz6zB-RIjz2AZnvo4bongGCkf_A&oe=6ACE3512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-06-29 135529.png", "id": "1300844158740943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1300844162074276_7750567699025893880_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k09GHKoHd0UQ7kNvwExkfyK&_nc_oc=AdpNcs3z0C3ySdV_DEpVkS9Us65UzZJXS1L348I4btfr0jY_8baL1Gk_XZZd1-DUFwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM42z7HTdXF585hYDT3_6L1hxsg8WRh3mX9AqG-juoaBA&oe=6ACE4BCC"}, "display_name": "Last Call Delivery", "keywords": [], "long_description": "Last Call Delivery is an immersive VR delivery experience that puts you behind the wheel of a vehicle, racing down the highway and navigating a handful of city streets to make your deliveries. Feel the thrill of driving in first person as you dodge obstacles, speed through traffic, and shoot pizzas at houses to earn money.\n\nUse your earnings to unlock new areas and buy businesses to grow your operation. With intuitive VR controls and engaging mechanics, Last Call Delivery delivers a fast-paced, hands-on driving and delivery experience you won\u2019t forget.", "short_description": "Last Call Delivery is a chaotic, funny delivery game where you drive around town shooting pizzas at houses to make money. Use your earnings to unlock new areas and buy businesses as you slowly take over the city"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Jaime ", "support_website_url": null, "website_url":
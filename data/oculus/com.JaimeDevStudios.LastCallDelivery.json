Dpu2RdnQFRJ8ddR9qcv5YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqC1eEvVmULF803a_ZyNnnPrQWqgVAFhFqNdlir0m3Yw&oe=6B1034CB"}, {"file_name": "Screenshot 2026-07-07 011514.png", "id": "2174546653946890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_2174546657280223_7213475315598617025_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYbzIOt5XoIQ7kNvwGtYjtI&_nc_oc=AdpqnVVB4v8682zLB-X6s3TbEKFlCGGk4u3r7CNcy4lFrR2uYSFVmtw2ILDTOZ33pEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXD7Yt5lP9-lZrwLCdYArwQyfLtn_s4WP-ER11_fRd8Bw&oe=6B105852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-06-29 135529.png", "id": "1300844158740943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1300844162074276_7750567699025893880_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3FMOwnXjR0Q7kNvwGIyWti&_nc_oc=Adppstp3NgR--XCQXAsuMCMojKwoYc_vQRzqSjNc-a9P4Y10IcBlFXQuAqCB0GijzgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXG1Q3Kdgq_8PLkv1A6m1lH7YKp9CQSuC-4ZFUZU1D1pQ&oe=6B1036CC"}, "display_name": "Last Call Delivery", "keywords": [], "long_description": "Last Call Delivery is an immersive VR delivery experience that puts you behind the wheel of a vehicle, racing down the highway and navigating a handful of city streets to make your deliveries. Feel the thrill of driving in first person as you dodge obstacles, speed through traffic, and shoot pizzas at houses to earn money.\n\nUse your earnings to unlock new areas and buy businesses to grow your operation. With intuitive VR controls and engaging mechanics, Last Call Delivery delivers a fast-paced, hands-on driving and delivery experience you won\u2019t forget.", "short_description": "Last Call Delivery is a chaotic, funny delivery game where you drive around town shooting pizzas at houses to make money. Use your earnings to unlock new areas and buy businesses as you slowly take over the city"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Jaime ", "support_website_url": null, "website_url": "https://sites.google.com/view/lastcalldeliveryprivatepolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28522647924052501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_941133748621274_5525659080105015683_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhCL_7wsiKUQ7kNvwGG5x7v&_nc_oc=Adpthu6nZMBGaDvBQHKn61QTm5aj7bKrhru71yfDkrVgoYaVlq1gcghcjksneiqPvJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1-F16XPU1-2I00r6cTrdEDi3MneVgWSo9N4SIGZ7i6g&oe=6B103B82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Call Delivery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1778040000, "lastRevision": {"nodes": [{"id": "25609039658746690", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "
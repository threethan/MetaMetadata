cdn.com/v/t64.5771-25/604370996_973514045828500_437672135868339769_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoocHxMFd8wQ7kNvwGibNTg&_nc_oc=AdreNU0voH5vZ9v7rXxDJ7u6zEK2UjH-GU-4QLDvBilV1tAuh-c9tuAWyNnDJ4vi2XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1M3HpFyFtvgad-p_S30qlItnG8X0LZrGTinleEapbPg&oe=6B1054B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "T1_Ghosts_Branded_2560x1440.png", "id": "1113730007729542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/748811223_1113730011062875_2234424475025791135_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqGQsijTD2YQ7kNvwFXVcQN&_nc_oc=AdrQbBcstgyNMpxSoOk74zURWl-yYAoNcv6tzxpG-dZ375VUuuXPlx5k1_juYIzAWB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1uAW3khB7zSv41fqOMqNMxGv8ifRQTE-V4JWYOT4a3Q&oe=6B106A2A"}, "display_name": "Witch Shop Simulator", "keywords": [], "long_description": "Welcome to Witch Shop Simulator, a hands-on VR potion shop where a normal workday can get wonderfully strange.\n\n\u2697\ufe0f **BREW IT YOURSELF**\n\nGrab bottles, pour liquids, grind ingredients in the mortar and work the distiller. Follow recipes, bottle your potions and finish them with a handwritten label.\n{1162895559757411}\n\n\ud83d\udc80 **SERVE UNUSUAL CUSTOMERS**\n\nTake orders at your wagon window, hand over your creations and collect your payment. Some visitors are more polite than others, and your potions can make their visit even stranger.\n{1892189478813311}\n\u2728 **EXPERIMENT & CAUSE TROUBLE**\n\nSend a customer to sleep, watch one vanish or enjoy an explosive surprise. Grab, toss and play with the objects around you. Keep a bat handy for visitors who need a little encouragement to leave.\n\n\ud83e\ude99 **EARN & UNLOCK**\n\nPut your coins in the register and buy new ingredients to unlock more recipes. Each new day brings more customers. Buy every ingredient to unlock endless play.\n\n\ud83d\udc08\u200d\u2b1b **DON'T FORGET THE CAT**\n\nYour little shop companion enjoys fish, attention and getting in the way. Feed it, pet it and take a breather between experiments.\n\n\n{1601582794477037}", "short_description": "Run your own witch's potion shop! Grind ingredients, brew strange potions and serve some very unusual customers. Earn coins to unlock new ingredients, experiment with surprising effects and see how quickly a simple order turns into magical chaos. Between orders, feed your cat and give it a well-earned scratch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ologamesvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "olo", "support_website_url": null, "website_url": "https://ologamesvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1395460780322951"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1134599135989767"}, {"status": "PUBLISHED", "id": "1854507885789963"}]}, "baseline_offer": {"id": "1854507885789963"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1134599135989767"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1440580009144361", "version": "0.5"}, "id": "14
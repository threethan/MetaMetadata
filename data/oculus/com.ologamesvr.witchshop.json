mers_at_counter.png", "id": "1423132580016516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/646423555_1423132583349849_9050030111972873701_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgyMoBwna7QQ7kNvwGoO53Q&_nc_oc=AdoZhCMxUuKyuWcTvjb4VGCwlchCL9BImT37DpFojHP2KQKvcZaaNQBTTAZDHc6CIyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbIueB1d9hevuz33KAwFjDNW4bzdmr8X4JCM_AqECxvg&oe=6B103B03"}, {"file_name": "12_skeleton_inside.png", "id": "973514042495167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_973514045828500_437672135868339769_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoocHxMFd8wQ7kNvwGibNTg&_nc_oc=AdreNU0voH5vZ9v7rXxDJ7u6zEK2UjH-GU-4QLDvBilV1tAuh-c9tuAWyNnDJ4vi2XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1M3HpFyFtvgad-p_S30qlItnG8X0LZrGTinleEapbPg&oe=6B1054B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "T1_Ghosts_Branded_2560x1440.png", "id": "1113730007729542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/748811223_1113730011062875_2234424475025791135_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqGQsijTD2YQ7kNvwFXVcQN&_nc_oc=AdrQbBcstgyNMpxSoOk74zURWl-yYAoNcv6tzxpG-dZ375VUuuXPlx5k1_juYIzAWB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1uAW3khB7zSv41fqOMqNMxGv8ifRQTE-V4JWYOT4a3Q&oe=6B106A2A"}, "display_name": "Witch Shop Simulator", "keywords": ["cooking", "potion", "magic", "fun", "alchemy"], "long_description": "Welcome to Witch Shop Simulator, a hands-on VR potion shop where a normal workday can get wonderfully strange.\n\n\u2697\ufe0f **BREW IT YOURSELF**\n\nGrab bottles, pour liquids, grind ingredients in the mortar and work the distiller. Follow recipes, bottle your potions and finish them with a handwritten label.\n{1162895559757411}\n\n\ud83d\udc80 **SERVE UNUSUAL CUSTOMERS**\n\nTake orders at your wagon window, hand over your creations and collect your payment. Some visitors are more polite than others, and your potions can make their visit even stranger.\n{1892189478813311}\n\u2728 **EXPERIMENT & CAUSE TROUBLE**\n\nSend a customer to sleep, watch one vanish or enjoy an explosive surprise. Grab, toss and play with the objects around you. Keep a bat handy for visitors who need a little encouragement to leave.\n\n\ud83e\ude99 **EARN & UNLOCK**\n\nPut your coins in the register and buy new ingredients to unlock more recipes. Each new day brings more customers. Buy every ingredient to unlock endless play.\n\n\ud83d\udc08\u200d\u2b1b **DON'T FORGET THE CAT**\n\nYour little shop companion enjoys fish, attention and getting in the way. Feed it, pet it and take a breather between experiments.\n\n\n{1601582794477037}", "short_description": "Run your own witch's potion shop! Grind ingredients, brew strange potions and serve some very unusual customers. Earn coins to unlock new ingredients, experiment with surprising effects and see how quickly a simple order turns into magical chaos. Between orders, feed your cat and give it a well-earned scratch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ologamesvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "olo", "support_website_url": null, "website_url": "https://ologamesvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1440627182472977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_1223752230298472_712161740555417980_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXRn10_sf8YQ7kNvwFdteae&_nc_oc=AdrNSc-A8vuqYPkLZSrU1mWkkoUvyHklsYo-yWVooZ36mbADRRtwVdjlHvoCnzd_hnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-F7loypfU6XNYxZpZ0iaBO2o5yQSicCxRbmgN4qwBZg&oe=6B106945"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Witch Shop Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1794857340, "lastRevision": {"nodes": [{"id": "1395460790322950", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1395460773656285", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1882989606415468"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "master_portrait.png", "id": "28743986781938894", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/804229564_28743986788605560_1843689980158297456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02M-ICYmsEAQ7kNvwHYV5dO&_nc_oc=AdqLwNyUuX79mN5b74fm_MJ2llPder9NHM01e7FQ0rNKm8J0_Vtcksz1ITI2-ngCbRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrz0BWE47YomtxrZN6OF0KLxDp22aK5PikA-tdzeyMwg&oe=6B106986"}, {"file_name": "Icon_512x512.png", "id": "3002191036795823", "image_type": "APP_IMG_ICON", "uri": "h
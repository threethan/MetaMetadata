5477205177_6447089955585026236_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzpSR6noqCcQ7kNvwGNU9WA&_nc_oc=AdoQc4EzSe6sIjXX81IS1fG41JHqhhCxQ_cK-ZqpcW-Oq9P4pgWa8hQsyJNx7teT2L4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPgErLyZpYFISUo-_-0tpcHA3GiOHAXtaSbzLYD8ZDkQ&oe=6AF9DF45"}, {"file_name": "VR Scene 5 (2560x1440).png", "id": "2231783297392082", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310817_2231783300725415_376515537482511610_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC7LNDXf3D4Q7kNvwE28RTe&_nc_oc=AdrnANDC9nCi2YTBczyEoZxDS7UpLy5gBk7rX9Pw90EUF3STFKAgMySiMghtW-7j79k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuMlVf5h0V6IMI1l6oVkkOcUelakyzbjSQKJJ-6qSZtA&oe=6AF9D063"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vicky", "keywords": ["Simulation", "Training", "Clinical", "Health", "Education"], "long_description": "Vicky is an AI-native simulation platform for clinical training, giving students a safe and repeatable environment to practice clinical workflows, interact with medical equipment and build experience through realistic training scenarios.\n\nAfter signing in with an account provided by their institution, users can access the training labs assigned to their organization.\nEach lab can include guided clinical scenarios, interactive medical equipment, educational prompts, knowledge checks and step-by-step assessment.\n\nStudent activity and performance are captured throughout each lab, allowing educators to review progress across individual attempts and cohorts through the web platform.\n\nTraining labs and updates are delivered directly through the app, and individual labs are downloaded when selected. The app includes the core VR experience and an interactive tutorial that teaches basic movement and interaction. A stable internet connection is required for first-time access, content downloads and updates.\n\nVicky is intended for educational and professional training purposes only. It is not a medical device and does not replace supervised clinical instruction, practical assessment or real-world clinical training.", "short_description": "Vicky is an AI-native simulation platform for clinical training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pi-tech.gr/vicky-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pi tech", "support_website_url": null, "website_url": "https://pi-tech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1049499327668301"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "27802538539369245"}, {"status": "PENDING", "id": "1070977448728108"}]}, "baseline_offer": {"id": "27802538539369245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787155920, "status": "PUBLISHED", "id": "27802538539369245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1125030926781807", "version": "1.2.2"}, "id": "28372472325684028", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1038455445439356", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1125030926781807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28372472325684028"}]}, "change_log": "What's new in 1.2\r\n\r\nComfort in every lab. A new Options menu on your wrist: choose Seated or Standing and fine-tune your height at any time. Interactive tools show you which button to press when you reach for them.\r\n\r\nWorking together. Take an instrument straight from another participant's hand.  Equipment held with both hands now stays in sync for everyone. Changes from the professor's panel now reach every participant.\r\n\r\nUpdated labs. More labs are now available in English. Smoother interactions, and patients hold eye contact naturally. Fixes to session restart, shared equipment and end-of-lab results.\r\nGreek and English text corrections throughout.\r\n\r\n\u03a4\u03b9 \u03bd\u03ad\u03bf \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 1.2\r\n\r\n\u0386\u03bd\u03b5\u03c3\u03b7 \u03c3\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf. \u039d\u03ad\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd Options \u03c3\u03c4\u03bf\u03bd \u03ba\u03b1\u03c1\u03c0\u03cc: \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u039a\u03b1\u03b8\u03b9\u03c3\u03c4\u03cc\u03c2 \u03ae \u038c\u03c1\u03b8\u03b9\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03cd\u03c8\u03bf\u03c2 \u03c3\u03b1\u03c2 \u03cc\u03c0\u03bf\u03c4\u03b5 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5.  \u03a4\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03b1 \u03c3\u03ac\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03c0\u03bf\u03b9\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03bd\u03b1 \u03c0\u03b1\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03cc\u03c4\u03b1\u03bd \u03c4\u03b1 \u03c0\u03bb\u03b7\u03c3\u03b9\u03ac\u03b6\u03b5\u03c4\u03b5.\r\n\r\n\u03a3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1. \u03a0\u03ac\u03c1\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c7\u03ad\u03c1\u03b9 \u03ac\u03bb\u03bb\u03bf\u03c5 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b1. \u2022\u039f \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03c1\u03b1\u03c4\u03b9\u03ad\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b4\u03cd\u03bf \u03c7\u03ad\u03c1\u03b9\u03b1 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c9\u03c3\u03c4\u03ac \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2.  \u039f\u03b9 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03ac\u03bd\u03b5\u03bb \u03ba\u03b1\u03b8\u03b7\u03b3\u03b7\u03c4\u03ae \u03c6\u03c4\u03ac\u03bd\u03bf\u03c5\u03bd \u03c0\u03bb\u03ad\u03bf\u03bd \u03c3\u03b5 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2.\r\n\r\n\u0391\u03bd\u03b1\u03bd\u03b5\u03c9\u03bc\u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1. \u03a0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b1 \u03c0\u03bb\u03ad\u03bf\u03bd \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac.  \u03a0\u03b9\u03bf \u03bf\u03bc\u03b1\u03bb\u03ad\u03c2 \u03b1\u03bb\u03bb\u03b7\u03bb\u03b5\u03c0\u03b9\u03b4\u03c1\u03ac\u03c3\u03b5\u03b9\u03c2, \u03ba\u03b1\u03b9 \u03b1\u03c3\u03b8\u03b5\u03bd\u03b5\u03af\u03c2 \u03bc\u03b5 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03b2\u03bb\u03b5\u03bc\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae.  \u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b1\u03c2, \u03c3\u03c4\u03bf\u03bd \u03ba\u03bf\u03b9\u03bd\u03cc\u03c7\u03c1\u03b7\u03c3\u03c4\u03bf \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1.\r\n\u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03b1 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac \u03c0\u03b1\u03bd\u03c4\u03bf\u03cd.", "created_date": 1794240661, "id": "1125030926781807", "version": "1.2.2", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1038455445439356", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1125030926781807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28372472325684028"}]}, "change_log": "What's new in 1.2\r\n\r\nComfort in every lab. A new Options menu on your wrist: choose Seated or Standing and fine-tune your height at any time. Interactive tools show you which button to press when you reach for them.\r\n\r\nWorking together. Take an instrument straight from another participant's hand.  Equipment held with both hands now stays in sync for everyone. Changes from the professor's panel now reach every participant.\r\n\r\nUpdated labs. More labs are now available in English. Smoother interactions, and patients hold eye contact naturally. Fixes to session restart, shared equipment and end-of-lab results.\r\nGreek and English text corrections throughout.\r\n\r\n\u03a4\u03b9 \u03bd\u03ad\u03bf \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 1.2\r\n\r\n\u0386\u03bd\u03b5\u03c3\u03b7 \u03c3\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf. \u039d\u03ad\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd Options \u03c3\u03c4\u03bf\u03bd \u03ba\u03b1\u03c1\u03c0\u03cc: \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u039a\u03b1\u03b8\u03b9\u03c3\u03c4\u03cc\u03c2 \u03ae \u038c\u03c1\u03b8\u03b9\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03cd\u03c8\u03bf\u03c2 \u03c3\u03b1\u03c2 \u03cc\u03c0\u03bf\u03c4\u03b5 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5.  \u03a4\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03b1 \u03c3\u03ac\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03c0\u03bf\u03b9\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03bd\u03b1 \u03c0\u03b1\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03cc\u03c4\u03b1\u03bd \u03c4\u03b1 \u03c0\u03bb\u03b7\u03c3\u03b9\u03ac\u03b6\u03b5\u03c4\u03b5.\r\n\r\n\u03a3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1. \u03a0\u03ac\u03c1\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c7\u03ad\u03c1\u03b9 \u03ac\u03bb\u03bb\u03bf\u03c5 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b1. \u2022\u039f \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03c1\u03b1\u03c4\u03b9\u03ad\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b4\u03cd\u03bf \u03c7\u03ad\u03c1\u03b9\u03b1 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c9\u03c3\u03c4\u03ac \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2.  \u039f\u03b9 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03ac\u03bd\u03b5\u03bb \u03ba\u03b1\u03b8\u03b7\u03b3\u03b7\u03c4\u03ae \u03c6\u03c4\u03ac\u03bd\u03bf\u03c5\u03bd \u03c0\u03bb\u03ad\u03bf\u03bd \u03c3\u03b5 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2.\r\n\r\n\u0391\u03bd\u03b1\u03bd\u03b5\u03c9\u03bc\u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1. \u03a0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b1 \u03c0\u03bb\u03ad\u03bf\u03bd \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac.  \u03a0\u03b9\u03bf \u03bf\u03bc\u03b1\u03bb\u03ad\u03c2 \u03b1\u03bb\u03bb\u03b7\u03bb\u03b5\u03c0\u03b9\u03b4\u03c1\u03ac\u03c3\u03b5\u03b9\u03c2, \u03ba\u03b1\u03b9 \u03b1\u03c3\u03b8\u03b5\u03bd\u03b5\u03af\u03c2 \u03bc\u03b5 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03b2\u03bb\u03b5\u03bc\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae.  \u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b1\u03c2, \u03c3\u03c4\u03bf\u03bd \u03ba\u03bf\u03b9\u03bd\u03cc\u03c7\u03c1\u03b7\u03c3\u03c4\u03bf \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1.\r\n\u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03b1 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac \u03c0\u03b1\u03bd\u03c4\u03bf\u03cd.", "created_date": 1793989292, "id": "1122123477072552", "version": "1.2.1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1038455445439356", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1125030926781807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28372472325684028"}]}, "change_log": "What's new in 1.2\n\nComfort in every lab. A new Options menu on your wrist: choose Seated or Standing and fine-tune your height at any time. Interactive tools show you which button to press when you reach for them.\n\nWorking together. Take an instrument straight from another participant's hand.  Equipment held with both hands now stays in sync for everyone. Changes from the professor's panel now reach every participant.\n\nUpdated labs. More labs are now available in English. Smoother interactions, and patients hold eye contact naturally. Fixes to session restart, shared equipment and end-of-lab results.\nGreek and English text corrections throughout.\n\n\u03a4\u03b9 \u03bd\u03ad\u03bf \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 1.2\n\n\u0386\u03bd\u03b5\u03c3\u03b7 \u03c3\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf. \u039d\u03ad\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd Options \u03c3\u03c4\u03bf\u03bd \u03ba\u03b1\u03c1\u03c0\u03cc: \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u039a\u03b1\u03b8\u03b9\u03c3\u03c4\u03cc\u03c2 \u03ae \u038c\u03c1\u03b8\u03b9\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03cd\u03c8\u03bf\u03c2 \u03c3\u03b1\u03c2 \u03cc\u03c0\u03bf\u03c4\u03b5 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5.  \u03a4\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03b1 \u03c3\u03ac\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03c0\u03bf\u03b9\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03bd\u03b1 \u03c0\u03b1\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03cc\u03c4\u03b1\u03bd \u03c4\u03b1 \u03c0\u03bb\u03b7\u03c3\u03b9\u03ac\u03b6\u03b5\u03c4\u03b5.\n\n\u03a3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1. \u03a0\u03ac\u03c1\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c7\u03ad\u03c1\u03b9 \u03ac\u03bb\u03bb\u03bf\u03c5 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b1. \u2022\u039f \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03c1\u03b1\u03c4\u03b9\u03ad\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b4\u03cd\u03bf \u03c7\u03ad\u03c1\u03b9\u03b1 \u03c3\u03c5\u03b3\u03c7\u03c1\u03bf\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c9\u03c3\u03c4\u03ac \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2.  \u039f\u03b9 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03ac\u03bd\u03b5\u03bb \u03ba\u03b1\u03b8\u03b7\u03b3\u03b7\u03c4\u03ae \u03c6\u03c4\u03ac\u03bd\u03bf\u03c5\u03bd \u03c0\u03bb\u03ad\u03bf\u03bd \u03c3\u03b5 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2.\n\n\u0391\u03bd\u03b1\u03bd\u03b5\u03c9\u03bc\u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1. \u03a0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b1 \u03c0\u03bb\u03ad\u03bf\u03bd \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac.  \u03a0\u03b9\u03bf \u03bf\u03bc\u03b1\u03bb\u03ad\u03c2 \u03b1\u03bb\u03bb\u03b7\u03bb\u03b5\u03c0\u03b9\u03b4\u03c1\u03ac\u03c3\u03b5\u03b9\u03c2, \u03ba\u03b1\u03b9 \u03b1\u03c3\u03b8\u03b5\u03bd\u03b5\u03af\u03c2 \u03bc\u03b5 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03b2\u03bb\u03b5\u03bc\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae.  \u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b5\u03ba\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b1\u03c2, \u03c3\u03c4\u03bf\u03bd \u03ba\u03bf\u03b9\u03bd\u03cc\u03c7\u03c1\u03b7\u03c3\u03c4\u03bf \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1.\n\u0394\u03b9\u03bf\u03c1\u03b8\u03ce\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b5\u03b9\u03bc\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03b1 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac \u03c0\u03b1\u03bd\u03c4\u03bf\u03cd.", "created_date": 1793865202, "id": "1120629250555308", "version": "1.2.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1038455445439356", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1125030926781807"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28372472325684028"}]}, "change_log": "What\u2019s new in 1.1.2\r\n\r\n
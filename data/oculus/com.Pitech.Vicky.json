"2877299415986161", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310667_2877299419319494_1874373042549371036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAfTnfAFwKYQ7kNvwEwb2fp&_nc_oc=Ado0D3vYLUTwUU-zzpQ3z8djzL2XrpxX2wy-HHQ50-7E7I7xGaqI17pdpzpkaW4nbl8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu1fll5e8fd5CQNv8YmhFWhU0vxzv1L2cFr2NAgU5MBA&oe=6AC91B5C"}, {"file_name": "VR Scene 1 (2560x1440).png", "id": "890075473871844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307962_890075477205177_6447089955585026236_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxNl5_bF82UQ7kNvwHisLtQ&_nc_oc=AdqLSX3L6HSXEmneT0r4oXI-lNcTTzAEF2mUwZuaFA32Ut43sgnARgzqh_-XZuFvwYY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOirD6feScjCqknVkJbvETpX6_OY_7L5iKLswlXY56_3w&oe=6AC917C5"}, {"file_name": "VR Scene 5 (2560x1440).png", "id": "2231783297392082", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_2231783300725415_376515537482511610_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIVTt6CRbUoQ7kNvwGlidf3&_nc_oc=AdpfB3tXzxNLz3vN25_SJ8QSbCNILC5Ax-zYd9ctUO01Hz5IxhFKSWR65mrVP46mD3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxzwwR5uwogXKRdOyCyNBzDABU5cLedBsv6jUaR-LBKw&oe=6AC908E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vicky", "keywords": ["Simulation", "Training", "Clinical", "Health", "Education"], "long_description": "Vicky is an AI-native simulation platform for clinical training, giving students a safe and repeatable environment to practice clinical workflows, interact with medical equipment and build experience through realistic training scenarios.\n\nAfter signing in with an account provided by their institution, users can access the training labs assigned to their organization.\nEach lab can include guided clinical scenarios, interactive medical equipment, educational prompts, knowledge checks and step-by-step assessment.\n\nStudent activity and performance are captured throughout each lab, allowing educators to review progress across individual attempts and cohorts through the web platform.\n\nTraining labs and updates are delivered directly through the app, and individual labs are downloaded when selected. The app includes the core VR experience and an interactive tutorial that teaches basic movement and interaction. A stable internet connection is required for first-time access, content downloads and updates.\n\nVicky is intended for educational and professional training purposes only. It is not a medical device and does not replace supervised clinical instruction, practical assessment or real-world clinical training.", "short_description": "Vicky is an AI-native simulation platform for clinical training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pi-tech.gr/vicky-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pi tech", "support_website_url": null, "website_url": "https://pi-tech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1049499327668301"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "27802538539369245"}, {"status": "PENDING", "id": "1070977448728108"}]}, "baseline_offer": {"id": "278025
604385997_1067577299326888_7614984161752160134_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95szGKGAqqEQ7kNvwGdtaXg&_nc_oc=AdrE0TBXRo8Kp6_H5zzoXTz27xYlC4MzRFbMi8Nk8kdKr4x2DnueRvoCl1Z5CUUFiwY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjoWkxVmAlwZYd6SPLitPmhqg0gKgN4wYupT7PgkkwQg&oe=6AF9D0C1"}]}, "id": "1500228941923073", "locale": "en_US", "screenshots": [{"file_name": "VR Scene 4 (2560x1440).png", "id": "1026923123570215", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507823984_1026923126903548_2043387434556872723_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghIrvhq1ugkQ7kNvwHXco_3&_nc_oc=AdqDvmNWKIsCc3IBZ8hfJ2lm8FmEDI9gL7cxMAKeC4GvH_zGmmMm5Ed2RvkSgQ6EDCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe0bRFEJ3LdGRyMkXoxj8zM7XCLq0aHmKAiH9Tk8lObg&oe=6AF9D7E2"}, {"file_name": "VR Scene 3 (2560x1440).png", "id": "1079973047934289", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507823854_1079973051267622_1310145233891332287_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wej2RquLUAQ7kNvwGb7BIj&_nc_oc=Adqbw4bMapOoPmCSgyIV-0kdCj4-eevfM-3iyeP95-uuVILf9QthRRJObkslw83NIlU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQoc78JUKw962LdZsQgdRi4z8aWb2Hm70nbO7J2yfsmg&oe=6AF9D01A"}, {"file_name": "VR Scene 2 (2560x1440).png", "id": "2877299415986161", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499310667_2877299419319494_1874373042549371036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InRW81azEh0Q7kNvwG2th_i&_nc_oc=AdrGmQqSYrsxSj6742rMADZZ1uMG3NzKLVgT5w3HhlFc6WdbkNoti2vVLa0lV1exU_w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvDfODv9aWjebmlCxkRgbAXu7AsL_146f0CYgZyI_v4A&oe=6AF9E2DC"}, {"file_name": "VR Scene 1 (2560x1440).png", "id": "890075473871844", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307962_890075477205177_6447089955585026236_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzpSR6noqCcQ7kNvwGNU9WA&_nc_oc=AdoQc4EzSe6sIjXX81IS1fG41JHqhhCxQ_cK-ZqpcW-Oq9P4pgWa8hQsyJNx7teT2L4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPgErLyZpYFISUo-_-0tpcHA3GiOHAXtaSbzLYD8ZDkQ&oe=6AF9DF45"}, {"file_name": "VR Scene 5 (2560x1440).png", "id": "2231783297392082", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310817_2231783300725415_376515537482511610_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC7LNDXf3D4Q7kNvwE28RTe&_nc_oc=AdrnANDC9nCi2YTBczyEoZxDS7UpLy5gBk7rX9Pw90EUF3STFKAgMySiMghtW-7j79k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuMlVf5h0V6IMI1l6oVkkOcUelakyzbjSQKJJ-6qSZtA&oe=6AF9D063"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vicky", "keywords": ["Simulation", "Training", "Clinical", "Health", "Education"], "long_description": "Vicky is an AI-native simulation platform for clinical training. Students practice clinical workflows and medical equipment in realistic scenarios, safely and as often as needed \u2014 alone or in shared sessions an educator can follow live from a web browser.\n\nSign in with your institution's account to open the labs assigned to your organization. A lab can include a guided scenario, interactive equipment, knowledge checks and step-by-step assessment, in Greek and in English. Educators review activity and performance on the web platform.\n\nVicky is for educational and professional training only. It is not a medical device and does not replace supervised clinical teaching or real clinical practice.\n\n\u0397 Vicky \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03bb\u03b1\u03c4\u03c6\u03cc\u03c1\u03bc\u03b1 \u03c0\u03c1\u03bf\u03c3\u03bf\u03bc\u03bf\u03af\u03c9\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 \u03ba\u03bb\u03b9\u03bd\u03b9\u03ba\u03ae \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7. \u039f\u03b9 \u03c6\u03bf\u03b9\u03c4\u03b7\u03c4\u03ad\u03c2 \u03b5\u03be\u03b1\u03c3\u03ba\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03ba\u03bb\u03b9\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03cc \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc, \u03c3\u03b5 \u03c1\u03b5\u03b1\u03bb\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03c3\u03b5\u03bd\u03ac\u03c1\u03b9\u03b1, \u03bc\u03b5 \u03b1\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03cc\u03c3\u03b5\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u2014 \u03bc\u03cc\u03bd\u03bf\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03ae \u03c3\u03b5 \u03ba\u03bf\u03b9\u03bd\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03bf \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03ae\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03b5\u03af \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03ac \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd browser.\n\n\u03a3\u03c5\u03bd\u03b4\u03b5\u03b8\u03b5\u03af\u03c4\u03b5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5 \u03b9\u03b4\u03c1\u03cd\u03bc\u03b1\u03c4\u03cc\u03c2 \u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1 \u03c4\u03bf\u03c5 \u03bf\u03c1\u03b3\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd \u03c3\u03b1\u03c2. \u0388\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ad\u03c7\u03b5\u03b9 \u03c3\u03b5\u03bd\u03ac\u03c1\u03b9\u03bf, \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03b5\u03be\u03bf\u03c0\u03bb\u03b9\u03c3\u03bc\u03cc, \u03b5\u03c1\u03c9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03be\u03b9\u03bf\u03bb\u03cc\u03b3\u03b7\u03c3\u03b7 \u03b2\u03ae\u03bc\u03b1 \u03c0\u03c1\u03bf\u03c2 \u03b2\u03ae\u03bc\u03b1, \u03c3\u03c4\u03b1 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac. \u039f\u03b9 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03ad\u03c2 \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03b5\u03c0\u03af\u03b4\u03bf\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03c0\u03bb\u03b1\u03c4\u03c6\u03cc\u03c1\u03bc\u03b1 web.\n\n\u0397 Vicky \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7. \u0394\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b9\u03b1\u03c4\u03c1\u03bf\u03c4\u03b5\u03c7\u03bd\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03cc \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03b8\u03b9\u03c3\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03bf\u03c0\u03c4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b4\u03b9\u03b4\u03b1\u03c3\u03ba\u03b1\u03bb\u03af\u03b1 \u03ae \u03c4\u03b7\u03bd \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b9\u03bd\u03b9\u03ba\u03ae \u03ac\u03c3\u03ba\u03b7\u03c3\u03b7.", "short_description": "Vicky is an AI-native simulation platform for clinical training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vickylabs.ai/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pi tech", "support_website_url": null, "website_url": "https://vickylabs.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "support
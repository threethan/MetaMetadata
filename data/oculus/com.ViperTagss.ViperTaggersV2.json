"file_name": "ss1.png", "id": "5098101100414378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300837_5098101103747711_8575138959564541072_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HcJLvrsNdEQ7kNvwE2w_Le&_nc_oc=AdovR1l4tSigmMzeFT9Kqlhct1WqmxdCT3WWaq8_n-wOPiFVAXbYNaTfRAY2E5ZBF4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1GYZHfMRQ_cHrepxlM4l3n7eCz11tCIpKzSuqDKOaOg&oe=6B0470CE"}, {"file_name": "ss4.png", "id": "1315092010260137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_1315092016926803_9207746242435519338_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ljcqyAJqWgQ7kNvwG02FUX&_nc_oc=AdpASqaSikuaeBnppOeF_-4tYahCV_0af-NG_HZmKtoseYekz1zC0bSMNIoxVe8cxWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWbzx5pNtfocM8_gc1-IJE3FCJfQWvjgJ-gvBW8d17VQ&oe=6B047235"}, {"file_name": "2560x1440 (2).png", "id": "2054487195290473", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299891_2054487198623806_8033253318863216722_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjvDpJjQEIkQ7kNvwG3pioe&_nc_oc=AdrBSU2iTXok_UIE1-Tdasoxf5lL6i3jb8lLBSIZqK_P9w5UM55Z-LTcg_OXoKaSl7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3PC8uaRn7li1cdg1ZDBCH3wjcCOGqwvc9tsCjaVVF-A&oe=6B04733E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Viper Tags", "keywords": [], "long_description": "Viper Tags is an adrenaline-fueled multiplayer tag experience that puts your reflexes and strategy to the test. Step into fast-paced arenas where the goal is simple\u2014don\u2019t get tagged! But in the world of Viper Tags, nothing stays simple for long.\n\nRun, jump, climb, and dodge your way through chaotic matches where every second counts. Whether you\u2019re the hunter striking with viper-like speed or the runner desperately trying to escape, the tension never lets up. Quick thinking and sharp movement are the keys to survival.\n\nWith smooth controls, dynamic arenas, and an energetic community, Viper Tags delivers endless replayability. Will you outsmart your friends and prove yourself as the ultimate tagger, or will you get caught slipping?\n\nGet ready to move fast, play hard, and strike like a viper.", "short_description": "Viper Tags is a fast-paced multiplayer VR experience where players tag, dodge, and outmaneuver opponents in dynamic arenas. Use speed, strategy, and precision to become the ultimate Viper in this action-packed virtual playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vipertags/private-policy", "developer_terms_of_service_url": null, "publisher_name": "shiny", "support_website_url": null, "website_url": "https://sites.google.com/view/vipertaggers/info", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24910716455216624"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622290_660749343494069_7472410337168269559_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLMATOd30L0Q7kNvwH7-5qJ&_nc_oc=AdrWsecT7-vrdSUDInjS9_Dq46vBbQS8xgn6rG0rIkzlr7xuAK85LoSXvtWYfBeED9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdYIG6GHZk4IS9QhrL2zHI
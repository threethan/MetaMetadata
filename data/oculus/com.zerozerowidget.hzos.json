ity-20260929-192733.png", "id": "1097480262695107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1097480266028440_5795786906476668027_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H0itDS9KUMQ7kNvwEMnjlG&_nc_oc=AdqoYYOIlIM49TxXoFagrjiaGYtyYGJzwVnZD8YeXesaQwBq8EqsM6Sy8xvrr0jtQcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZb01_DKqCrkL9x_DfeBdjBxjPQqgg8glCE9QAk_ylQ&oe=6AE9F380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "00Widget", "keywords": ["mcp", "agent", "dashboard", "ai", "widget"], "long_description": "Keep the work you delegate visible after you leave the chat.\n\n00Widget turns updates from AI agents, automations, scripts, and apps into a shared status dashboard on Meta Quest. Arrange it beside your workspace, expand a card for more context, or pop important cards into separate panels so the information you care about stays in view.\n\nSee what is running, complete, or waiting for you. Follow progress and ETAs; inspect charts, histories, timelines, breakdowns, lists, and briefings; and run supported actions directly from a card.\n\n## Why 00Widget\n\n- A glanceable control room for work happening elsewhere\n- Movable, resizable Horizon OS panels\n- Status, progress, trends, results, and ongoing activities\n- Optional transparent panels that sit naturally in your space\n- A built-in sample dashboard to explore before signing in\n\nConnect through your phone to the same 00Widget account used by compatible AI assistants and API publishers. Publishers send structured updates; 00Widget renders them as consistent panels.\n\nUse 00Widget for releases, research, support queues, service health, automations, deliveries, energy, charging, or any changing work your tools can report.\n\n00Widget does not create or run AI agents. Connected data requires a 00Widget account, an internet connection, and a compatible MCP host or configured API publisher. 00Widget is independent and is not affiliated with or endorsed by AI assistant providers.", "short_description": "Keep your agents\u2019 work in sight without reopening the chat. 00Widget turns updates from AI agents, automations, scripts, and apps into movable Horizon OS dashboard panels you can arrange around you. Track progress and ETAs, inspect charts and briefings, pop out important cards, and run supported actions from your workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://00widget.com/privacy", "developer_terms_of_service_url": "https://00widget.com/terms", "publisher_name": "00Widget", "support_website_url": "https://00widget.com/support", "website_url": "https://00widget.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1379066988612768"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2518365598643563"}]}, "baseline_offer": {"id": "2518365598643563"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790924400, "status": "PUBLISHED", "id": "2518365598643563"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1403860509466749", "version": "1.5"}, "id": "1436385225259110", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__t
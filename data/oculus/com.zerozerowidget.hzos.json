7f20f&oh=00_AQSnSnRmKIAAME-wPA0DJd6BoDdemf47eRZ1ynWo-fLxFw&oe=6AE9FDEC"}, {"file_name": "screenshot-details.png", "id": "1417981943103650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1417981946436983_7088206187809769977_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyPl0AzTp84Q7kNvwF-jlUo&_nc_oc=AdpsHrFbUFAolfXXRyHA1_ywLHmd5A_1F2zWDEPJwYcuCeWTFok8xcTBvH_2QJLKorQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwMxicT5RPEKbHuFk0BoA5ZRNYlTAj6GQpFtzGshp48A&oe=6AE9FD0C"}, {"file_name": "sim-dashboard-20260929-200555.png", "id": "1424064439924322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1424064443257655_7113218521548082548_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp8c1YuFXFcQ7kNvwGiMi3w&_nc_oc=AdrDmizM7rVpYV-JNmKIt4MMJQNUblXsTHqraSkVIMyMr4XHdzAYgHVXFZiGGYVIyx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGb0rLNC8Z9Op_TFsa4iuQAcfUtAlqtoakx1I6YlGQ2A&oe=6AE9EF6D"}, {"file_name": "sim-card-20260929-192808.png", "id": "1743701713554515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/806363909_1743701716887848_7026283547702120652_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDV2YfzB1BQQ7kNvwHNcN7Y&_nc_oc=Ado1Sj82sgKl94BimiJiMtCRZnXsT_HAroS6n8bh0iK3n2dr6i-lpfZ3nndylyrSSgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzG2TQqTaLpn12sE9XVt-IqO8oFuFHt2-tbfMC7bx8Q&oe=6AEA130E"}, {"file_name": "sim-activity-20260929-192733.png", "id": "1097480262695107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1097480266028440_5795786906476668027_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H0itDS9KUMQ7kNvwEMnjlG&_nc_oc=AdqoYYOIlIM49TxXoFagrjiaGYtyYGJzwVnZD8YeXesaQwBq8EqsM6Sy8xvrr0jtQcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZb01_DKqCrkL9x_DfeBdjBxjPQqgg8glCE9QAk_ylQ&oe=6AE9F380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "00Widget", "keywords": ["mcp", "agent", "dashboard", "ai", "widget"], "long_description": "Keep the work you delegate visible after you leave the chat.\n\n00Widget turns updates from AI agents, automations, scripts, and apps into a shared status dashboard on Meta Quest. Arrange it beside your workspace, expand a card for more context, or pop important cards into separate panels so the information you care about stays in view.\n\nSee what is running, complete, or waiting for you. Follow progress and ETAs; inspect charts, histories, timelines, breakdowns, lists, and briefings; and run supported actions directly from a card.\n\n# Why 00Widget\n\n- A glanceable control room for work happening elsewhere\n- Movable, resizable Meta Horizon panels\n- Status, progress, trends, results, and ongoing activities\n- Optional transparent panels that sit naturally in your space\n- A built-in sample dashboard to explore before signing in\n\nConnect through your phone to the same 00Widget account used by compatible AI assistants and API publishers. Publishers send structured updates; 00Widget renders them as consistent panels.\n\nUse 00Widget for releases, research, support queues, service health, automations, deliveries, energy, charging, or any changing work your tools can report.\n\n00Widget does not create or run AI agents. Connected data requires a 00Widget account and active subscription, an internet connection, and a compatible MCP host or configured API publisher. 00Widget is independent and is not affiliated with or endorsed by AI assistant providers.", "short_description": "Keep your agents\u2019 work in sight without reopening the chat. 00Widget turns updates from AI agents, automations, scripts, and apps into movable Horizon OS dashboard panels you can arrange around you. Track progress and ETAs, inspect charts and briefings, pop out important cards, and run supported actions from your workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://00widget.com/privacy", "developer_terms
=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v_RTCE3AdUQ7kNvwEegjh-&_nc_oc=AdrwPmY4SWlO2vsq2GIAZbxaeGGh9mrMW7bZGyJGD76AfJpNiG-Zg0-S8DfGuqP7DUM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGZ58Tkdw6CRvxaDcw_JiR8kcunqc0Nubw_Mg6nQK2uA&oe=6AFF08AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Chaos", "keywords": ["fangame", "fun", "social", "exciting", "tag"], "long_description": "\nGibbon Chaos is a thrilling Gorilla Tag fangame set deep within a vibrant and sprawling forest. Players take on the role of agile gibbons, swinging and leaping through dense canopies, towering trees, and natural obstacles. With chaotic gameplay and physics-based mechanics, the game emphasizes fast-paced chases, teamwork, and intense strategy. Whether you're outmanoeuvring rivals or mastering the art of swinging, Gibbon Chaos guarantees non-stop fun and adrenaline-fueled action.", "short_description": "\nGibbon Chaos is a thrilling Gorilla Tag fangame set deep within a vibrant and sprawling forest. Players take on the role of agile gibbons, swinging and leaping through dense canopies, towering trees, and natural obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JpG1HSvUWsXfNnj4FKbSYFI7TkXH5-NL7P7jYYQzhD0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "W4LLSVR", "support_website_url": null, "website_url": "https://forms.gle/qcGve7WDLyeMtKjWA", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
_oc=AdoKd8dh8PfjSlSu5Vl6d4A_eVPKlhzBaYTHF3PllpIu-2kotuX_wKGSIyzPDCN3xO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF5e3BBBcYZwmHN6fq5FgOGEmxrltx1oB1vhZjvO1qug&oe=6AABED56"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0upgFgza5EQ7kNvwFPneiV&_nc_oc=Adp3huxc1GMVRNjyiVO_I2R9qXvNIh-nhUO80MbMIawIXNRyycdQdTh2QkS-BdVj1nY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjNeCy_tFZNmluatdvJvWkKGkzWcn8o9SxGbP4xSvAGA&oe=6AAC0F54"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj3Cj3CsyYMQ7kNvwFcuoNH&_nc_oc=AdqXxxT4sDIgcyfZ7Mhrxmy3XxcHmfIXyFovqqKyV24RLXqVvO1JLfbZDJWTWyVx_Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ2DScSQ6FonynjubVXRjCiKTy1YqYUvkVqQDeAEKkWw&oe=6AABE896"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaoI9r7X-vEQ7kNvwHiBOps&_nc_oc=Adp86AsL0iusluOiBHkUQZvNgHoHmR-SfQOGNplrCqOLjLInQiJ7oWqC-QYO95lnXSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYjPmTog7695sW5gQ9u6G_w1TtFIxxJkxFkK1-gnyXow&oe=6AABE451"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAHZ9m-aWCoQ7kNvwH1f6H3&_nc_oc=AdrYEfMv3HGDuENWFXvkTvbgf_1IlugZKGRCQc7LAmBSxNf78BHygT2aYdA-Nkqwt1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1pc45izlrI2717T_kv3CTIkFj5RGsWEzjHwrIEOI4Hw&oe=6AABE478"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
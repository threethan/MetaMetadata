p-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6MLjMw4Y-8Q7kNvwG8b1nn&_nc_oc=AdqxmuK9XECR60ZjtUYZ-kbFaUNg7aCax50sfKS9YHC0HkZ3ZQMJ5isg1u4AJBTsHjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYPBSD5nzqW7rqTeQbpsBWTub50UhlcYIrSYn1bMSZWg&oe=6A5E2016"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfmxBlwIdZAQ7kNvwG7ei8p&_nc_oc=Adrw2mY2ybZcZ9iXMISDnafyn1a2SQndlColWglU4anykLuhA9f9ssNfNZw4bmZRkoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANisyCz4nPPwKeaPNitg9WqEq5-xa8aeDx9vuEYCvxuA&oe=6A5E1BD1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjAgGVxEj4YQ7kNvwFcxP78&_nc_oc=AdoYpDkQJrJh4nfhmmKbCsPbq6mDVBjaxtNSAylhTvqAWPsRxVw8CGHK4m00-66nFL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYWt0WBCFiP-SC4Pp7PKEg76qosgkS9R3tkECE02TayA&oe=6A5E1BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "Certified PV Associate is a cutting-edge VR training app designed to provide hands-on experience in photovoltaic (PV) systems. This interactive simulation covers:\n\n-PV System Components: Learn about solar panels, inverters, batteries, and other essential components.\n-Different PV Systems: Understand grid-tied, off-grid, and hybrid PV system configurations.\n\nTrain in a realistic, risk-free virtual environment to develop critical skills in solar energy technology, system installation, and maintenance. Whether you're an aspiring solar technician or a professional looking to upskill, Certified PV Associate equips you with the knowledge and practical experience needed for the growing renewable energy industry. Start your training today!", "short_description": "Learn the fundamentals of solar energy with Certified PV Associate! This immersive VR training app provides hands-on experience with PV system components and different types of photovoltaic systems. Train in a realistic virtual environment to enhance technical expertise, improve safety awareness, and develop the skills needed for a successful career in the solar energy industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7345558678901642"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "968565098117756"}]}, "baseline_offer": {"id": "968565098117756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739336760, "status": "PUBLISHED", "id": "968565098117756"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bin
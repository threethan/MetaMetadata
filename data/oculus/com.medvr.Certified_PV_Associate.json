file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH4_CkagVEcQ7kNvwFTt_wK&_nc_oc=AdqQr05S6UQEZafP1QrvXMmeKa5eneVf375fKOD6zHcOxQkMa2Dy7_j7k2Bopn2OIw8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYgMd8cIgmWaejornmJYAJjFW56HGySiygYFayHy03PA&oe=69CFB9D1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDRGE4FwzmQQ7kNvwHY5Qtp&_nc_oc=Adq8wYRNMnxV1R97eyBrTMveTWyFsb2XFd_v0mtDHhptSL0dX62YxSuckWkjYZno-PA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwC0XlW8uRnCKG3qNEfGT_r3vsJXbNP5iYaCNNOqXinvg&oe=69CFB9F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922622324528595"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392301_978431013944804_2786393938396333404_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXnIH4frR5cQ7kNvwF-t-mW&_nc_oc=AdofRJrvc5CvhnsOz2NcBOQinJUrCTRgQbavBgFvfIHNRXuQJiVQIh93DyRn98Uc8uE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrt8ehvTRWFXYF04DWmCpr8YfksfMmYUPQ4LU9cHGPTA&oe=69CFCBAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PV Associate", "platform": "ANDROID_6DOF", "context_category": {"con
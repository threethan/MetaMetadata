le_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPEdatvSjUoQ7kNvwG58a3V&_nc_oc=AdqXylnEnfvrsNrPMPEs1h9_rUIGHcudwvbIwY70HHfBk-O-4IJVvww3cqHe31LKFLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QqGfy2sJQj3jssVwOUZfj8swenYtl7DZ8fxPOolpfgA&oe=6A295FD1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWdZob2JptYQ7kNvwHLpaqZ&_nc_oc=AdprU5R2Yfs0dSUjZba9mnaLE5_EksTdd2V0TJoCzF9Ue2PjsuxTtj-5nh1R06gXD2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qk0sGNz2svSVBaVZkfyPX0xFSd9_COW8xNVRcCrgfHA&oe=6A295FF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24638137702550471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303707_2427834617692511_8867570024104678483_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzyTMvtHltYQ7kNvwHybUzW&_nc_oc=AdpMH3YcSrgEPp5Ghp3_ivGtwSi_gkJdKQzTEj_U0hqyG40za2G090gcaxpSLDeMiIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d8fHkbk_rWvmjR0FTyH8W7IGao56TiNkRcdAwPAVwFQ&oe=6A29564A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PV Associate", "platform": "ANDROID_6DOF", "context_category": {"con
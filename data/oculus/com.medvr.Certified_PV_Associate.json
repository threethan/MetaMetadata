_oc=AdrDZtkDtZvauLbHu4Yb7CLS9TAMiktpZWHt7unXsAk6eSCdSmzGvrJeESZAjjtgmzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-4FEGK-F1L9_S7DUivf5PuWcTTclW43DZm4GLkomJ4A&oe=6ABD10D6"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuyeMNR9UKMQ7kNvwFT3rYq&_nc_oc=AdqDokz7V8R3GHbNwhAfoUlgLeS2rAkqnPuX5cfbfgbaUUrcoHGpCcZZaZ4Gw-jw8E0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImhOWMmRD59Tt2ww5k3HHwniL8djEE3oEiu_gMwQ4G7A&oe=6ABD32D4"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmEb0yI24_4Q7kNvwE7M06T&_nc_oc=AdoZ2qQS82p6ayTD_K-NViQEJlFCaRSf9xqJFJMcDgGQHmv_YY05UzHeKLu8kxPVYfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4gOhPgKb40eaFgUoS_z_YuW9-h3YVcjRZknRGzaKiww&oe=6ABD0C16"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PX0THtupXsQ7kNvwEwoZhL&_nc_oc=Adqqvw_3Kod_l-nzWjdBDrUk0RXOHSvlP28SrmwilBpMXFP3Q1bWEmLWA85go78FekE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdt1n2IsrvQoBUJp7ClxVSR1x63vxAoXGMGqHBfvgqIQ&oe=6ABD07D1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlY55u1YLMUQ7kNvwHZ_Rnk&_nc_oc=Adrdb6NisZFB277GpOiWBimewdLJBXywiKQXjUB0qLLNq3RCfczZjVrDcjr_4EDX9Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGZukB_Sdxx3rfp93HIAg1AlvLOYSULaCgq6XXxXPl9A&oe=6ABD07F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
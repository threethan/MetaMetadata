_oc=AdoY20ErxMLz_DnlhUm9oQgAjTqS5mmdYTM-tpIETFsllmwUQyt1mDTsiGpAVw9ga5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZVC1xMfeyLaVzckYnlhLgL7MMZTrUxLRpDN2JTI_y9g&oe=6ABE6256"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuyeMNR9UKMQ7kNvwFxtv30&_nc_oc=AdrqlGuNsXWRJouNrcAlFNibZtjnE8GpjXrXLlobRiABWpGUCxvEQStNgPJw5qXJHuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJItIv7ryn1_evB3uULPImosSn2g8jRsWPbfTGNzDwgRQ&oe=6ABE8454"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmEb0yI24_4Q7kNvwH4PoXf&_nc_oc=Ado_ZIFAwDwKdy3USu9OMg3_hAl4M7EzZ9ll5l97wqplSYcz0j2tyH6MTGoaMsT_Txo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8K6LtKk73j8Z6ExlTJeHg6auxw2xjEsC0b5gWXa0FrQ&oe=6ABE5D96"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PX0THtupXsQ7kNvwHOymZG&_nc_oc=Ado6xRJmPQp288GHHD7AptLgy1OH1jo75ChNKrHoyhJxs1lqZ0lIbzbPy3155pc-vyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa5TGijY7bKWizgzzmTWlrwVMrlKMNJfBHSSwBhQ3Amw&oe=6ABE5951"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHor2mbM63IQ7kNvwFgOaa9&_nc_oc=AdpGFxc9KYUxLzDeErMREHEQtH--ic_2t9ZyCU2lfaUafpzUPrTeyhCUH3okBoW0Ouw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFGSbvPb_CMeM4o-1j0qPyqRmSkEKX-6GaNLPOHmKLBA&oe=6ABE5978"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
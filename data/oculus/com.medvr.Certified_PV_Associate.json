0f&oh=00_Af5epZMrDR5HNod4s6649Q93QZDIXFM2LmjBFRbT-hwr4w&oe=6A0C67D6"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0qbtbcBCw4Q7kNvwGyVyPr&_nc_oc=AdofTj7p7-MOvaRQBpYcctsSueV9gNI7bXOyhAuXvVRBFwnQpIyFGqw5aBtSDs8j60Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sltps0m2LQqvF6ykkr5K-IM3zZgo7bhy9yE2yG5kR_g&oe=6A0C89D4"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvRDK8QsN7wQ7kNvwGAeAUe&_nc_oc=AdpQBRP7Ue4o_SC8vbcX2o9u7yUWfTmfjI-SKYeIYC7k_QFSJzCFXTxVjZZs94AxF_Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KLonTu4rdlEOZDGBnWfgdHTAZjK49Lee1_wepfidqCA&oe=6A0C6316"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzFVRSyZDssQ7kNvwH6eq2J&_nc_oc=AdrTDSLMf6HgC1N7Vayd512-WdtXYss9B5yI-g8W-gMpPFIGchp7FmXN-Jnxm4r7ji4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IMA4Xp4VnEebFFZWvLoiJ6q-EcfLR4andmbCN-aOCiw&oe=6A0C5ED1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyeox_g0pmgQ7kNvwEFyjm7&_nc_oc=Adq7OaF_MlBVyL9sxIpe2erY6NNdFWBabBoa8c6ryBnBD1Q6mQU8kbKeMEA4ZtQPqew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Gt33l6xjReNoyDKCuMmJdtYZYtprna8X7JL-YvvTlw&oe=6A0C5EF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
/473392046_586218237586390_8024457248509373081_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehv3ytFBWbwQ7kNvwH1mRBL&_nc_oc=AdpwnDleLLZ1pczu1k6FIUBBvvoAlvEayv8-zNlks4TS26aCSevWbcR-otVnqGXK5Vs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fMFeoEFsjJfwbRXGr3igun87Rtu_pc7VmgkguZI1s-w&oe=6A1AE856"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs6iVbDoQtcQ7kNvwHt8SvN&_nc_oc=AdrhLM9zUkaar0R4ZKT6mMWlhkWQ_xB2zmiDNYv6TKElNQSwDPSkTdBMfy8hyS-JXRo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QkKUGRp60OsObz2AXVtIlgvBf7LZSw9vpNBD_OkC4bA&oe=6A1B0A54"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-aKpu8_jzkQ7kNvwF03a9_&_nc_oc=Ado_kOePHOMi70H6EHSunba-tGXfyvoXBP9JeSaLyV1HJIY9Rrxsr7q95MnUMVUToc4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zl0J39HkwvhqZU1F_lR2G7fJJxrfnQrdnbX20XNAI1g&oe=6A1AE396"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTOyEc8zS2AQ7kNvwE_zbwn&_nc_oc=AdpAwrb4i_sRN8nJvMjvSIs5F5ZB2jS8Khu0tV0l0v8hfFZGRVGMev1ovmfcs1A1L4Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48jepAmVJDZkhZhKe7RmnwONo2-LSvUpLXohVDjR_hPg&oe=6A1ADF51"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsToZektp5QQ7kNvwELA6tU&_nc_oc=AdojEMlPrRua5ICNd_DmfG8gTxwXZtjzW6KGJQv9XXVN9atSwnRME0hxx2hp5_l7Cpw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d4n1T8-yAYWSxUqGAN7-dw4M1SeennMjUrPgG4m8D8A&oe=6A1ADF78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
&_nc_oc=Adq8pjo-w0_12d_j3WeFi96ebDcCbHWjxcaf7VX-PE4PstbCaqIk_YtveT-T9ITm5v0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8jIRoO-5BdblZmHY5-F6Fy3Jdw3dM3548EdZbRzazg&oe=6AA94A56"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H86XUlDFUX8Q7kNvwEHC6tP&_nc_oc=AdoJG_Xz75cIXGwZWRsxB2X_XBrFURs2uO3q-6tGjkQ5KEzuxigsArEJnhacpelwFus&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwX51vXV1Xafp3ajcWbjgtGIMYjKiVD41isGiCHVQJvA&oe=6AA93414"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPv91LI5wXQQ7kNvwEUd_D_&_nc_oc=AdplS429fL4vcprBQcNiC9oMVhv1Sj6NsbZoR83WR_JjWlQk-waPaDocY5oFvhvDsOY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ9RXcBeJVukuVQj5wLhA8oGBA7mdvBQ2-zCCzT1yfGw&oe=6AA94596"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaoI9r7X-vEQ7kNvwFUEmPA&_nc_oc=AdpDev79sjC7OeQjJQoyh00H2r5TrPj0nE246afdfZKbTajAV4YL_Wu43k54VNfe_xw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1iAeKEqEB7ugUH0-q1FFMxaVkw7BIijYziYNxJ25lcQ&oe=6AA94151"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7fNYTBGnfAQ7kNvwGpEXqz&_nc_oc=Adoj_ppd7o2vBzS1muis-XCWO9aoEMNkk-mwOxkEFj1aHiXiJDltcHObwjnImliCa9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSvKINFSy-M4TCy3vXByMafStMhafV0bd53ZrDnfm4Ng&oe=6AA94178"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
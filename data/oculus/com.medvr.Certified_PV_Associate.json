_oc=AdqyiQDsI9h1yNVR-dfOXVrsXB-l_-7d-TTVrzYFarz6cDAhblT8etRxS9WRuzABGOM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlV7UoVqX7RZ61brsFMu5n7pkSTRaHqelKST1N9bo5Tg&oe=6AA16156"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEs9_bfJ1n0Q7kNvwHXhPJp&_nc_oc=Adqp49pchd4-XHd6-hZz2gegtggbWc92nh8fCfIx2hsHrsZffKu4_W0rvC3uRL_ri68&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAgsnKh4L7qbnsA2VTIGEcfsGuWn-OCSUEFLaJ70x2gg&oe=6AA14B14"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhLFjdrHYRIQ7kNvwHlfsZd&_nc_oc=AdqUH9GuXb8mg044Lhj-QnCROrHSxCNvcN89dgwIuj2H--DVfhCooXAOPsnl0BG7cec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTwdabAENHSzPJAEsfzC021slN5Dq3nFwVCHwxw15agw&oe=6AA15C96"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0y1ecoxN7oQ7kNvwEdF4mK&_nc_oc=AdoPA13at94pjQkwc6GPEw-2uHQmLChRsQOZObtH5tJXhA3fKn8ZJHiujOdrIK_B8LA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhu4jJXGpHAHQMtlOa1To7s9IEadwscXC8YLlnFR039g&oe=6AA15851"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LxFHSR_ZhsQ7kNvwFQWtVM&_nc_oc=AdqWn39MpjWeg4N4tQpEDKyNe91UYqow3slOW9pIpLDyGp69FFY6QGnGxCDYMgkH3iA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZmMoO91oorVs2ZahLHFtOO58TO-YNZ4BAE1zf-BPjzQ&oe=6AA15878"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1A0vO4hRiYQ7kNvwFE4maC&_nc_oc=AdrTIevgXD1MHDMKXl_uLyFOImm3JG6cAbSp8j1UtgqWk4Rhh3GdPBXUcNNLKf-bCxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GHAfuysmWn-Fun3zoebhUZbzq6F0nJXGdoZYAbOCq4w&oe=6A032896"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Xtip-1GkHYQ7kNvwEXZyQi&_nc_oc=AdosV5PKCqhXHfr4oSTFDr864n0IrTbaZhaBFvb7Lx83B9kI6uUZfuPYpCxJ7wU3XWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R9T2IdK3QpExKJZJHzL5QC23wY12Xp_pK9d-7OYBBfg&oe=6A032451"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eelfkKJIcR8Q7kNvwGIlJFc&_nc_oc=AdqvH_PNqHDgO5ctH0X2dvZz_RW7KN0qh67hT04ypqjwqbhjVgOb1j6nMbfaD6tTBco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BfIh4_kB2PPS329Svt8UcssG2nny9xFs8sj12EaXomg&oe=6A032478"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "Certified PV Associate is a cutting-edge VR training app designed to provide hands-on experience in photovoltaic (PV) systems. This interactive simulation covers:\n\n-PV System Components: Learn about solar panels, inverters, batteries, and other essential components.\n-Different PV Systems: Understand grid-tied, off-grid, and hybrid PV system configurations.\n\nTrain in a realistic, risk-free virtual environment to develop critical skills in solar energy technology, system installation, and maintenance. Whether you're an aspiring solar technician or a professional looking to upskill, Certified PV Associate equips you with the knowledge and practical experience needed for the growing renewable energy industry. Start your training today!", "short_description": "Learn the fundamentals of solar energy with Certified PV Associate! This immersive VR training app provides hands-on experience with PV system components and different types of photovoltaic systems. Train in a realistic virtual environment to enhance technical expertise, improve safety awareness, and develop the skills needed for a successful career in the solar energy industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7345558678901642"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "968565098117756"}]}, "baseline_offer": {"id": "968565098117756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739336760, "status": "PUBLISHED", "id": "968565098117756"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9337711656352991", "version": "1.8"}, "id": "605041745580879", "channel_name": "LIVE"}]}
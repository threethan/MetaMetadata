_ss=7f20f&oh=00_AQEehjrbAAeXKDr6W79dg21SC8D20IcEvOxDKBjL8Z_gEw&oe=6A7DC8D6"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lERFb_ZlAN4Q7kNvwF12Dre&_nc_oc=AdqGa9dbB6z7ThwChGQjwO_j5_32foVAMPeGUTg8w15KBv98fRaKw1yQVitxgOPAS3k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsJllKgxks44ghfKAJMXlrg1DcsbgX5qHUrIiRIlJRaA&oe=6A7DB294"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZop0ELP8sgQ7kNvwFSQfsO&_nc_oc=AdrmOsFrHggb5AIIWQZ89E__MDpzN84YTnXDEvyb8yOtOdHVqcM1iCsD81bB1vkZyAI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6xBfrCZR3c0GX4Qqg52wP08rkU0WJ1T3_uRp3kD4TQg&oe=6A7DC416"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2RXQJEFI04Q7kNvwHmXWQ6&_nc_oc=AdqbLTxG0wPSTF4bMNDlIIuaGJrTHJziuhYhuAi7qRxWVOKwnQO0jyfdhVhW7aR8VK4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd5DdqCLjJ_oHzGItlSnO3XdIlagpQ3SU80xx0iWJa9w&oe=6A7DBFD1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nYGABLhyJQQ7kNvwFK2myl&_nc_oc=AdrGBtaTxIoLW8kYL3T3dVyw0hbwYgXjb08LmzT4CvUZAXTnFmjxut4ZgDL7kTN8-tg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG29xmySNh1MiPuud-zUJHnresbo6kk56sEtd277jPG_A&oe=6A7DBFF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
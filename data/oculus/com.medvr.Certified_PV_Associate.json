_oc=Adof_j-hplXUCWZHcxYVC8oGx3c_eJdVbCXTaHuCTFnO4uU4u1J95_O0mwTMAZJtnYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG08Tt8xrBamG9uCJxVuxjZdVSKXfwYqCM0vrmx_uyb0Q&oe=6A92E0D6"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9orb4Eq_FU4Q7kNvwE_I0jO&_nc_oc=Adqfe581pYJ1flBGID_cimVH7NS7kEkaJHYVuZQ6PY9LGu_yQfl4jwV86ZqabnVGwOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYvubIj6NEzCHzWRVyedb2dVFyoE145_76XpXyQq_nQg&oe=6A92CA94"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ9CIP7sbtIQ7kNvwHNPGAR&_nc_oc=Adp7hdLMPHkPJd7F8BbXAjg_hf41jCi2KIKg2oT5Ng2y1N0SyyOI6Tjz_0Dq9TgS7fs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLtnVzE-yompZ8Zw-7c5bRdFgE5PzeVwoO02XgbfO6nw&oe=6A92DC16"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruiXEILGi5gQ7kNvwGg4L9W&_nc_oc=AdqxVahaUZCC3kV2myz7gluLNe5mBoKRU68ZqrdZzftD2V1SweNmiZowKb8W49F43a4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlE8XRzB6ovOCMLhe6bs5V2EiCeFQAITCLrT4x9Cc6yg&oe=6A92D7D1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNLT3U9b4E4Q7kNvwEhXJgW&_nc_oc=AdqgnNsKkSj_oyasJ6m7pjZ34U11zfnficGkqe5UmD1bIy8MDt4fW9PnJgXYXB8uVxA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqMlyhk7KWuT0_TIWUUPeEPVo6A3wczm_Uqi_4wt-EVg&oe=6A92D7F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
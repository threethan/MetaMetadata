768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifo55wQIAT4Q7kNvwH8qxJB&_nc_oc=AdosJAvTpgwcgijVBOeXWkd9OnNxnCHJlsBC8zyPFyazT-9D-pyO6iRhfoHWdbyDMVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvJ_hDeKNBHijdkU1hP5-R8ApfqEVi5EE1Z_-vjF2Gbw&oe=6A4BD1D4"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oa2lK-erV8Q7kNvwEUN29G&_nc_oc=Adr7IrMXrlhbUBdNyTQiIIZ7uUbqIBfUsz8oKHzBIYk95Hho9grmp7M6gkGwDPLrkKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Gz219kM_mmKIJ22i13fqtjy0HUqO9B5WSRCm7aOCHA&oe=6A4BAB16"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTAklhR3wlsQ7kNvwFjkGNh&_nc_oc=Ado39xgTUWcxPlLGHnoORo9eEY8jiZ64YD7iXHr2x5iXM0THW-SVTeADP82kf8M6Wow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDknhEidH4yJyUDME6c9OF6QOaLEJQTMUnDK_Gdi3YXJA&oe=6A4BA6D1"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q8wSkS7FlMQ7kNvwE_7fPZ&_nc_oc=AdqraLwvs9eJF_hSBLS3dZul0ZXnQufvCBqsV4Plzk1pf2KNTaWjCHgbpxXiasbNzN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi8Wrj47pruPXZQeYtYz6fCDW7xwANltW8grX81bVX_g&oe=6A4BA6F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pla
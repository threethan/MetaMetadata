uscdn.com&oh=00_Afsf2veeSglqEO91Ajo_BC2a0oqpPcTHnpFjQu5Pm0UM2Q&oe=69A6DB51"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdjtCCj05MMQ7kNvwH6QBGZ&_nc_oc=AdlGhhei4_A0I-3zR6Ebl7dKTYh3CpolfTFTie24FLp2UNjtLReLy_DgUtpGA9bKa3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5oIGXT5jP_PhTIui-4RzJvZ9B0tJnxPU4MrbHe22o9Q&oe=69A6DB78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922622324528595"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_978431013944804_2786393938396333404_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua_EqP6JeI0Q7kNvwEsxw4X&_nc_oc=AdnmMr6_kdToMsrzS7-fNT97lMle5t81Tt7tKAx4fiVwEpO-wrZHIZjbIVgRRvY3Z2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afso0KSibJ7m329dCaDRcJRE13Pw3laiG4saNUYnqerfSQ&oe=69A6ED2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PV Associate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1739336760, "lastRevision": {"nodes": [{"id": "7345558698901640", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "734555
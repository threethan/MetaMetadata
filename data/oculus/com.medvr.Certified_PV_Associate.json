_oc=AdqZfRVAInN4klQLgcMlo5Wd97wZi8Js80na3kFhOfqPUlQF_j-67vh6DhnbCpihgO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl7RLpwNeZ8JV9n-CGq6VCqlr2jJmTr_1kdzYyI6hR9w&oe=6A896E16"}, {"file_name": "vlcsnap-2025-02-04-19h11m26s654.png", "id": "1155966559241832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391887_1155966562575165_5734748218768174927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ6tWoRXjEMQ7kNvwEyPWiq&_nc_oc=AdpzNfHDENZJoPg2dNtMQRUOnUo_xvGjWdxqtK12xETauKVt8gyJKJX9p1bk3akRpZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI994L2chbC575Xc9zTFtJ4AkZ95Fy9ge9RXnNKAFz1Q&oe=6A899014"}, {"file_name": "vlcsnap-2025-02-04-19h11m37s275.png", "id": "3679539902338259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393469_3679539905671592_2627122416349441720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsIolxv8wHsQ7kNvwFKPLGL&_nc_oc=AdqGNnp57PnRdhrMGWipmiQK3NnmSWJKg3E3WsdFZoqouuoutb8vJPHiG10pdfw87Ew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmm1dY8knEbATVFoQxa8Id5t9WUQ69HfovM6HT4sRKIA&oe=6A89A196"}, {"file_name": "vlcsnap-2025-02-04-19h10m04s938.png", "id": "1356238652047964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392170_1356238655381297_7560635897474581615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34PaOXDpehQQ7kNvwHYM17f&_nc_oc=AdqowIA-msoiBAwvgr7VFs5ilI8O2-7rDqc2zatvxFQgVDOaCKWIUm6C7XbBgjbQ6Z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhRuVj9AkzGovrtJa5_r-pZ0Xtu9DJz7dKGoNVdIDXhQ&oe=6A899D51"}, {"file_name": "vlcsnap-2025-02-04-19h11m13s754.png", "id": "3910164702587175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_3910164705920508_8933309247422837719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib7xpV1aBK8Q7kNvwFWmVFs&_nc_oc=AdrwcDZwIK5MrACL_BhaA3Q2YhS5BpOU_Y93Bw1lyCHTZ31K3zwaZaZ-jj1G09kciG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEET2zAC4dYphCKzx8utnE8MmYEL0PMrG-K-lhj0hPoQg&oe=6A899D78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PV Associate", "keywords": ["PV", "Training", "Immerselearn"], "long_description": "PV Associate is part of the Immerse Learn PV Associate Certification Program and is accessible only to students enrolled in the program. This VR simulation provides a comprehensive, hands-on learning experience in photovoltaic (PV) technology. Training modules include system design, installation, and maintenance; PV components and their roles in operation; safety considerations and regulatory compliance; solar resource assessment; system sizing and optimization; structural and electrical requirements; energy storage integration and hybrid systems; commissioning and troubleshooting; and long-term maintenance. Learners will also explore financial aspects such as incentives and utility bill analysis. Developed to align with industry standards, PV Associate offers a safe, immersive environment where students can build technical expertise, improve safety awareness, and gain practical skills for real-world solar energy careers. Access is restricted to enrolled students only.", "short_description": "PV Associate is a VR training app developed as part of the Immerse Learn PV Associate Certification Program. Available exclusively to enrolled students, it offers hands-on training in photovoltaic (PV) systems, covering system components, design, installation, safety, performance optimization, and maintenance in a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707
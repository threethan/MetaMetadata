}, {"file_name": "Screenshot_Harper (1).png", "id": "1357285639599660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307326_1357285642932993_32973557341519816_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sDGailT6r8Q7kNvwEFC4Wr&_nc_oc=AdoogzcR53w1brMyskNcFJ9-kHMGLgJ1Vvjm_3_liBG91By3qCPm2aMatCsTSEEyzrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoBWVdAZAKPLUAlUBFFxzTrNQ2hBKRs00HjstUtZ9lTA&oe=6A5B90C1"}, {"file_name": "Screenshot_Harper (7).png", "id": "864574513338725", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300897_864574516672058_2815258612716607696_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egfRlSkTU1wQ7kNvwGPQR3Z&_nc_oc=AdpC68Oxl5rJv2DO5sKiFuGYKRshFUpBuPxMMH4vOLDSv_99VLiArj2O3Bl9mWCnfZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCywTcBCtwYeJWSYh54v5JTH1z665tMqVB_TNmG_E4HfA&oe=6A5B7914"}, {"file_name": "Screenshot_Harper (4).png", "id": "27446161915002157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307931_27446161921668823_2852591317927360316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLbNXmrxwTAQ7kNvwHcaYQ8&_nc_oc=AdpOAuJujWV7F-tibSd2R0DiWbUp_CngTfBKAr_nV7hstUFV8p8TuTn6hnnlg1f3_5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA93U5gd4ku3kowVhewkS3TB50cHphbpxRYjdi5aOyVfQ&oe=6A5B94E4"}, {"file_name": "Screenshot_Harper (8).png", "id": "969512552388831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_969512559055497_1433427386006382152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfPtiIsLfDIQ7kNvwGt1tVy&_nc_oc=AdrtHiVfGtiNWLjqFB4TMk6BG5UehKFrTGVT1Wp3UgKoud8D1IEAunI4xo255tnm1Bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxbfdxNVZHzMzQyCDmwvsYrdQBbjNuw4sSOdrVM24sxw&oe=6A5B67DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Music Performance Kit", "keywords": [], "long_description": " VR Music Performance Kit puts your sheet music, chord charts, and practice patterns directly in your field of view while you play, so\n  you can keep your eyes on your instrument, your hands, and the people around you.\n\n  Load your charts as PNG images onto your Quest headset and they appear as crisp, floating panels in passthrough, with the real world\n  fully visible around them. Whether you are rehearsing alone, playing in an ensemble, or performing on stage, your music is always\n  exactly where you need it without a music stand, a tablet, or a page turner in sight.\n\n  The app displays two panels side by side: one for your Real Book charts and one for practice patterns, scales, or anything else you want\n   at a glance. You can turn pages with a simple pinch gesture, switch between panels with a fist, and grab and drag either panel to place\n   it exactly where it feels natural for your setup. If you need a clear sightline to a conductor, a single gesture hides the patterns\n  panel and slides your chart to the side.\n\n  A built-in chromatic tuner listens through the headset microphone and displays your pitch, note name, and cents offset in real time, so\n  you can tune up without reaching for a separate device. A live volume meter sits alongside it, giving you a constant read on your output\n   level.\n\n  Everything is designed to be operated entirely by hand. No controllers, no buttons, no interruption to your playing.", "short_description": "  VR Music Performance Kit puts your sheet music, chord charts, and practice patterns in front of you while you play: no stand, no paper,\n   no looking away from your instrument.\n\n  Load PNG images onto your Quest and they appear as floating panels in passthrough, keeping the real world fully visible. Turn pages,\n  reposition panels, and switch between your Real Book and practice patterns using hand gestures alone: no controllers required."}]}, "developer_name": "David Harper", "developer_privacy_policy_url": "https://www.atonalfugue.net/vrpolicy", "developer_terms_of_service_url": null, "publisher_name": "David Harper", "support_website_url": null, "website_url": "https://www.atonalfugue.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27706015975653109"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27748756564712383", "version": "1.1"}, "id": "1471830100994676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27049175058003874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748756564712383"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1471830100994676"}]}, "change_log": "Added menu for the user to choose scores to display.  Included music I've written for the app, built-in, for the user to experience.  Quality of life changes.", "created_date": 1779157026, "id": "27748756564712383", "version": "1.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27049175058003874", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27748756564712383"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1471830100994676"}]}, "change_log": "Version 1.0 \u2014 Initial Release\r\n\r\n  VR Music Performance Kit is a passthrough performance aid for musicians. Place your sheet music, chord charts, and patterns as PNG files\r\n   on your headset and have them in front of you while you play.\r\n\r\n  Features:\r\n\r\n  - Two-panel chart viewer \u2014 load separate folders for your Real Book charts and practice patterns. Both panels display side by side in\r\n  passthrough so you can still see your instrument and the room.\r\n  - Page turning by hand \u2014 pinch your right hand to advance, left hand to go back. No controllers needed.\r\n  - Panel repositioning \u2014 pinch and drag the right panel to place it exactly where you want it.\r\n  - Active panel switching \u2014 make a fist with your right hand to switch which panel receives page turns.\r\n  - Hide/show patterns panel \u2014 make a fist with your left hand to hide the left panel and slide the right panel to center, giving you a\r\n  clear view of the conductor.\r\n  - Loudness meter \u2014 live microphone level so you can monitor your volume at a glance.\r\n  - Chromatic tuner \u2014 real-time pitch detection shows your note, octave, and cents offset.\r\n\r\n  Setup:\r\n\r\n  On first launch, the app creates LeftPanel and RightPanel folders inside /sdcard/Music/ on your headset. Drop PNG music scores into those\r\n  folders and restart the app.", "created_date": 1778824863, "id": "27698169083104465", "version": "1.0", "version_code": 1, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
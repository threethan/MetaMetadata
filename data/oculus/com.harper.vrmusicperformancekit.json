ttps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307931_27446161921668823_2852591317927360316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLbNXmrxwTAQ7kNvwHcaYQ8&_nc_oc=AdpOAuJujWV7F-tibSd2R0DiWbUp_CngTfBKAr_nV7hstUFV8p8TuTn6hnnlg1f3_5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA93U5gd4ku3kowVhewkS3TB50cHphbpxRYjdi5aOyVfQ&oe=6A5B94E4"}, {"file_name": "Screenshot_Harper (8).png", "id": "969512552388831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_969512559055497_1433427386006382152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfPtiIsLfDIQ7kNvwGt1tVy&_nc_oc=AdrtHiVfGtiNWLjqFB4TMk6BG5UehKFrTGVT1Wp3UgKoud8D1IEAunI4xo255tnm1Bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxbfdxNVZHzMzQyCDmwvsYrdQBbjNuw4sSOdrVM24sxw&oe=6A5B67DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Music Performance Kit", "keywords": [], "long_description": " VR Music Performance Kit puts your sheet music, chord charts, and practice patterns directly in your field of view while you play, so\n  you can keep your eyes on your instrument, your hands, and the people around you.\n\n  Load your charts as PNG images onto your Quest headset and they appear as crisp, floating panels in passthrough, with the real world\n  fully visible around them. Whether you are rehearsing alone, playing in an ensemble, or performing on stage, your music is always\n  exactly where you need it without a music stand, a tablet, or a page turner in sight.\n\n  The app displays two panels side by side: one for your Real Book charts and one for practice patterns, scales, or anything else you want\n   at a glance. You can turn pages with a simple pinch gesture, switch between panels with a fist, and grab and drag either panel to place\n   it exactly where it feels natural for your setup. If you need a clear sightline to a conductor, a single gesture hides the patterns\n  panel and slides your chart to the side.\n\n  A built-in chromatic tuner listens through the headset microphone and displays your pitch, note name, and cents offset in real time, so\n  you can tune up without reaching for a separate device. A live volume meter sits alongside it, giving you a constant read on your output\n   level.\n\n  Everything is designed to be operated entirely by hand. No controllers, no buttons, no interruption to your playing.", "short_description": "  VR Music Performance Kit puts your sheet music, chord charts, and practice patterns in front of you while you play: no stand, no paper,\n   no looking away from your instrument.\n\n  Load PNG images onto your Quest and they appear as floating panels in passthrough, keeping the real world fully visible. Turn pages,\n  reposition panels, and switch between your Real Book and practice patterns using hand gestures alone: no controllers required."}]}, "developer_name": "David Harper", "developer_privacy_policy_url": "https://www.atonalfugue.net/vrpolicy", "developer_terms_of_service_url": null, "publisher_name": "David Harper", "support_website_url": null, "website_url": "https://www.atonalfugue.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27706015975653109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313105_1412289560705097_6729130691326949165_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geN_Fd_Xh_MQ7kNvwFoX51r&_nc_oc=AdqoD7aCOSqRGz3dZR4AEMjn60uB1V_ksEJXUTPMKqK1AN2F00H0iROysUe1IuVsc4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5kmlNTmAvyhu-UClIO4qow5trHOh8vyUcDnkOryX9LA&oe=6A5B6EE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Music Performance Kit", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1779201960, "lastRevision": {"nodes": [{"id": "27049175111337202", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27049175058003874", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1276799547950909"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "VR_MUSICPERFORMANCEKIT_HARPER.png", "id": "4379686705639990", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_4379686708973323_472316868766662585_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyNZXMMJfpgQ7kNvwHWyAAa&_nc_oc=AdpgTX4hClK5Kf1Y-Du17EkIswE1Kcc1Hwjn6B7jdhCo0N7wWfp5dRtrjfon4FwGrOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuSFFc1UE56Pj75dWvc5kijPFnsDD2xcZShcxeBOTmMA&oe=6A5B8C7D"}, {"file_name": "VR_MUSICPERFORMANCEKIT_HARPER.png", "id": "2149773389197553", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623115_2149773392530886_5099467165598598716_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWbUXfr73M4Q7kNvwFwSUEe&_nc_oc=AdryCBUdUF_W0i6jef7iwVLODcg7KlpVpZeAjvb3K1LJOaEZZOtCtGVyopS4wv7pgug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtdSunPA-pOe
&oe=69A19997"}, {"file_name": "New Project - 2024-01-06T215648.214.png", "id": "680025047340789", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75250459_680025050674122_3648483511544736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaxIhpaZs7kQ7kNvwHI2zm5&_nc_oc=Adl1UGIyPkxvTQomYpSV4H717hRO03ZvY1V8ZLVXJrAXqvbUICNALh4IiSplGggT3Hg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvA6XKRiqEpCAji3MnUq0gbUDnn93Zs2iedpde_yJuknw&oe=69A1925A"}, {"file_name": "New Project - 2024-01-06T215553.359.png", "id": "257224123882949", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982463_257224127216282_1137768492201069815_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42pGQ_GDyAYQ7kNvwEsWjUd&_nc_oc=AdmKgK56D5Vm2Bbh8E8hSivEnZ-Y9FeYGqX2d5mxT1zpTz6RpAVw166UghEf7Lzc0U4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs4Qv9BBpSkkbZP8fWmchXd-4FFDGx52Y0JsofWiMv4xQ&oe=69A18B85"}, {"file_name": "New Project - 2024-01-06T215600.402.png", "id": "331702363070682", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75222943_331702366404015_7481664393385781819_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbX_GwbDaN8Q7kNvwHe1BFf&_nc_oc=AdnQB6qn_SOMe-xovGzrwo726U9HPi0WeIsu4eA4FkKt5M8tiN34VNkv4W27Ahe-smw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu4plYaXqcCVjWznyy0ca3dj6Vd5xdy3TDW5K3YnAiM3Q&oe=69A1A324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2024-02-05T204420.134.png", "id": "704094651861664", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974746_704094655194997_7311925853293178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh4mbaL1mqAQ7kNvwFC_Qvz&_nc_oc=AdntVn3GFOWvora0jeYCNdBxBJVxlHD3E-NYK-yrDEVPzPHIZaHp1B9-z_a7EZQ23Z4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsMLKwOugrPscMRppDKgJeWHNupMPBOlfPjSjEqai2ypw&oe=69A1A580"}, "display_name": "Juke Jungle", "keywords": [], "long_description": "\nWelcome to Juke Jungle!\n\nAbout Juke Jungle\n\nJuke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!\n\n### Game Features:\n\n#### 1. Cute Player Models\nEmbrace the charm of our adorable player models! From playful monkeys to colorful creatures, enjoy exploring the jungle with these lovable characters.\n\n#### 2. Diverse Maps\nExplore a variety of intricately designed maps within the jungle setting. Each map offers its own challenges and surprises, keeping the gameplay fresh and exciting.\n\n#### 3. Social Interaction\nEngage with players from around the world! Form alliances, strategize with friends, and compete against others in this vibrant online community.\n\nEnjoy!", "short_description": "Juke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/juke-jungle/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JukeJungleTEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/juke-jungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["M
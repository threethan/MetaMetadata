_-jYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bpbYQ6WDCcOXE7ZCDLaJZEWvXRXbb5VPMOT3xmqxOpA&oe=6A032897"}, {"file_name": "New Project - 2024-01-06T215648.214.png", "id": "680025047340789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250459_680025050674122_3648483511544736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNHo6n02jzQQ7kNvwHepK_C&_nc_oc=AdrYputw5A_ng8hvRTGxaimML0KqkZnJKbmspCtbRUuwDySeJNNdTAZcHztKVw2ms4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eMG2EMnPWpevIcse45IsycA248ByDSSlF9z25dDI7lg&oe=6A03215A"}, {"file_name": "New Project - 2024-01-06T215553.359.png", "id": "257224123882949", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982463_257224127216282_1137768492201069815_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLU4SVWangkQ7kNvwEnXt65&_nc_oc=AdqdVv6Fo7TJxNMUlYfd9gJ-hm1n9F2smUC8rD_yOpe-bWmOzl6319rWrX4KowmjxJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65MBGsTYS2ZA5NZvsgnZx-GFrKrn98sWrVRm41Cc2cHw&oe=6A031A85"}, {"file_name": "New Project - 2024-01-06T215600.402.png", "id": "331702363070682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_331702366404015_7481664393385781819_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ4fjalDkWgQ7kNvwEgN66S&_nc_oc=AdpvEhEVgMD8b7Szqe7f1uF5o6G7nRTm4jsgXWSBekKJRRm_e4EsK4svbq1iYzqm0Gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kPLRRwGBgw1C9XxxhIUbfZVCfAGsmhj7kIQweRlqGtA&oe=6A033224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2024-02-05T204420.134.png", "id": "704094651861664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_704094655194997_7311925853293178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyUeWdRaVacQ7kNvwHOboiT&_nc_oc=AdpIk9f1AMEjhmZX-ugNLNC-sPGNJtz2WegFVmnWa0aoOX_dd4jrUVLP-89LWF8dTvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y-ydsgi_pZGBgJfgL4AdWHrFlstf4TBo8i-y7oAEojw&oe=6A033480"}, "display_name": "Juke Jungle", "keywords": [], "long_description": "\nWelcome to Juke Jungle!\n\nAbout Juke Jungle\n\nJuke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!\n\n### Game Features:\n\n#### 1. Cute Player Models\nEmbrace the charm of our adorable player models! From playful monkeys to colorful creatures, enjoy exploring the jungle with these lovable characters.\n\n#### 2. Diverse Maps\nExplore a variety of intricately designed maps within the jungle setting. Each map offers its own challenges and surprises, keeping the gameplay fresh and exciting.\n\n#### 3. Social Interaction\nEngage with players from around the world! Form alliances, strategize with friends, and compete against others in this vibrant online community.\n\nEnjoy!", "short_description": "Juke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/juke-jungle/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JukeJungleTEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/juke-jungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
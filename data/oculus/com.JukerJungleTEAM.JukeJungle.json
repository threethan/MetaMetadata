&oe=699EF697"}, {"file_name": "New Project - 2024-01-06T215648.214.png", "id": "680025047340789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250459_680025050674122_3648483511544736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecXKSnka9iUQ7kNvwESCAfx&_nc_oc=AdmQnML5x-WlMSqK9e-kcbD1IW6uY4EhnAxmYmN3GwY2iJ22ywUX_WlJIFXgndk5O1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvjzX_xKjGtI9KBveTDE74SgNiYBpKZEKlEK2H1-0rVtw&oe=699EEF5A"}, {"file_name": "New Project - 2024-01-06T215553.359.png", "id": "257224123882949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982463_257224127216282_1137768492201069815_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OohcW_Z54VAQ7kNvwFISkFf&_nc_oc=AdmQt-v84Ol4YM9r-vV4pgkjq4H2bSzmJITeWx6TD0NRQn2NnFWNTPd-ay2qXmxfIkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvBnmpiuKIGxbIRu3jaMuxbR4sPGwDT6u2xFMMzaS0G8A&oe=699EE885"}, {"file_name": "New Project - 2024-01-06T215600.402.png", "id": "331702363070682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_331702366404015_7481664393385781819_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgg6UCDOvYgQ7kNvwHshvFa&_nc_oc=AdntvTDu2a9ZPah42z3v9fNb21D4gLZ2xHWliUUgNr7mfwy2s-Kb-QKiDh9cf54IsUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfscLfgZ1IodSfl5qZCoDT9ANvk0gbRAPDeHqU2jxELqeQ&oe=699F0024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project - 2024-02-05T204420.134.png", "id": "704094651861664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_704094655194997_7311925853293178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG3UhZeeW9cQ7kNvwGSQxSS&_nc_oc=AdlY5MsMvcvFTjxDUfSPEl-Y2CKq80TJiW0scLSE4cJUmpvLv1B7cyOtWJNK4TY15UM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3StRurmYOry3oUjKoXtcEj3lNunW0lvAMSqWqz9i_sQ&oe=699F0280"}, "display_name": "Juke Jungle", "keywords": [], "long_description": "\nWelcome to Juke Jungle!\n\nAbout Juke Jungle\n\nJuke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!\n\n### Game Features:\n\n#### 1. Cute Player Models\nEmbrace the charm of our adorable player models! From playful monkeys to colorful creatures, enjoy exploring the jungle with these lovable characters.\n\n#### 2. Diverse Maps\nExplore a variety of intricately designed maps within the jungle setting. Each map offers its own challenges and surprises, keeping the gameplay fresh and exciting.\n\n#### 3. Social Interaction\nEngage with players from around the world! Form alliances, strategize with friends, and compete against others in this vibrant online community.\n\nEnjoy!", "short_description": "Juke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/juke-jungle/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JukeJungleTEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/juke-jungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["M
uscdn.com/v/t64.5771-25/38974746_704094655194997_7311925853293178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dk9Ej10B2QQ7kNvwEFca9N&_nc_oc=Adp_2363R2CYNqRzSLiyVV5wGILrE1hGjDs33vF2J5z-cMVdz6Yb_YvBdI6TmXnhOqw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqnoDmZdjOQmaBZrKURkTmtYaStyDIrFB68ddbmvNd1g&oe=6AFB46C0"}, "display_name": "Juke Jungle", "keywords": [], "long_description": "\nWelcome to Juke Jungle!\n\nAbout Juke Jungle\n\nJuke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!\n\n### Game Features:\n\n#### 1. Cute Player Models\nEmbrace the charm of our adorable player models! From playful monkeys to colorful creatures, enjoy exploring the jungle with these lovable characters.\n\n#### 2. Diverse Maps\nExplore a variety of intricately designed maps within the jungle setting. Each map offers its own challenges and surprises, keeping the gameplay fresh and exciting.\n\n#### 3. Social Interaction\nEngage with players from around the world! Form alliances, strategize with friends, and compete against others in this vibrant online community.\n\nEnjoy!", "short_description": "Juke Jungle is an exhilarating multiplayer game that takes the excitement of Gorilla Tag to new heights! With its adorable player models, diverse maps, and thrilling game modes, get ready to swing into action in this vibrant jungle-themed adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/juke-jungle/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JukeJungleTEAM", "support_website_url": null, "website_url": "https://sites.google.com/view/juke-jungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
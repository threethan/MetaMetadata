t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2wnihFWqwqqvaXwOfusvmm_Mal-ERcbSUkJosD57kxg&oe=6B033718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9e572c3d-a351-4d74-96f3-60ecfcf2a396.png", "id": "1406785104331497", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619382_1406785114331496_396606674342700229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn2XAXYY_7sQ7kNvwHxXSVm&_nc_oc=AdoQPv86yYWmaEuZCEj-A1LO473Sa6odzNCh722T4WSTQSA_gK3m1GDEniCPo06fmMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6QyORpM5fwX2PNi_TCbEgBWqnIQQQO2DYYBx1hqJISA&oe=6B03237A"}, "display_name": "Soccer Punch", "keywords": ["soccer", "football", "sport", "arcade", "multiplayer"], "long_description": "Step onto the pitch with Soccer Punch, a VR arcade soccer game built around fast matches, spectacular shots and pure fun.\nKick the ball, charge your shots and unleash devastating strikes that can send goalkeepers and opponents flying.\n\nDiscover different arenas, face new challengers and master your team on your way to becoming the champion.\n\n\u26bd Fast and accessible arcade soccer\n\ud83d\udca5 Powerful shots and spectacular effects\n\ud83c\udfc6 Adventure mode and new challengers\n\u2694\ufe0f Intense versus matches\n\ud83c\udf10 Multiplayer\n\ud83c\udfae Easy to learn gameplay\n\ud83c\udf0b Multiple arenas with unique environments\n\nNo complicated simulation here: Soccer Punch is all about action, fun and ridiculous football moments.\n\nKick. Score. Dominate.", "short_description": "Explosive arcade soccer in VR! Kick, score, unleash powerful shots and battle your opponents in fast, fun and over-the-top matches."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/soccerpunch_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://splendorous-profiterole-f7db93.netlify.app/", "categ
THmttgRGfmYYMaH7XmfU4g1nJABXkaojVANUdNHqwbFryXlj8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi0p4lGSYkotLNPN3uiTe331UnuEFdnAO3ln66TP68IA&oe=6AF8977A"}, "display_name": "Soccer Punch", "keywords": ["soccer", "football", "sport", "arcade", "multiplayer"], "long_description": "Step onto the pitch with Soccer Punch, a VR arcade soccer game built around fast matches, spectacular shots and pure fun.\nKick the ball, charge your shots and unleash devastating strikes that can send goalkeepers and opponents flying.\n\nDiscover different arenas, face new challengers and master your team on your way to becoming the champion.\n\n\u26bd Fast and accessible arcade soccer\n\ud83d\udca5 Powerful shots and spectacular effects\n\ud83c\udfc6 Adventure mode and new challengers\n\u2694\ufe0f Intense versus matches\n\ud83c\udf10 Multiplayer\n\ud83c\udfae Easy to learn gameplay\n\ud83c\udf0b Multiple arenas with unique environments\n\nNo complicated simulation here: Soccer Punch is all about action, fun and ridiculous football moments.\n\nKick. Score. Dominate.", "short_description": "Explosive arcade soccer in VR! Kick, score, unleash powerful shots and battle your opponents in fast, fun and over-the-top matches."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/soccerpunch_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://splendorous-profiterole-f7db93.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
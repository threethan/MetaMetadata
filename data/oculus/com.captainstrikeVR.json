hc=3cOMx3LHhoYQ7kNvwE3KsYW&_nc_oc=Adr78SWH730eujoK9GCzyhBO7hZhMuzHvkC_ouPOtA7EMoilBVfOjXhz2PQemCnmCBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8ibiSRgKP5sH4TwT_V9X-Qqrm14qSsqy1dRnoAUtbpw&oe=6B0844D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9e572c3d-a351-4d74-96f3-60ecfcf2a396.png", "id": "1406785104331497", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619382_1406785114331496_396606674342700229_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLdM8AXiUxkQ7kNvwGKzvER&_nc_oc=Adq3dte0h8_i2RNa3XuhKc6KEUs-P-sp31GUvXY1B6G22RXlhPArM6XDCObJ4kxBZTA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZTOqP5BYFR87BlHIuRo9kK_vlDaXLFDeBNYJ2QNzc7A&oe=6B08697A"}, "display_name": "Soccer Punch", "keywords": ["soccer", "football", "sport", "arcade", "multiplayer"], "long_description": "Step onto the pitch with Soccer Punch, a VR arcade soccer game built around fast matches, spectacular shots and pure fun.\nKick the ball, charge your shots and unleash devastating strikes that can send goalkeepers and opponents flying.\n\nDiscover different arenas, face new challengers and master your team on your way to becoming the champion.\n\n\u26bd Fast and accessible arcade soccer\n\ud83d\udca5 Powerful shots and spectacular effects\n\ud83c\udfc6 Adventure mode and new challengers\n\u2694\ufe0f Intense versus matches\n\ud83c\udf10 Multiplayer\n\ud83c\udfae Easy to learn gameplay\n\ud83c\udf0b Multiple arenas with unique environments\n\nNo complicated simulation here: Soccer Punch is all about action, fun and ridiculous football moments.\n\nKick. Score. Dominate.", "short_description": "Explosive arcade soccer in VR! Kick, score, unleash powerful shots and battle your opponents in fast, fun and over-the-top matches."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/soccerpunch_privacy.html", "developer_terms_of_service_url": null, "publ
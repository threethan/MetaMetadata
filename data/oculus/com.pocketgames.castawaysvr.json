_trailer": null, "video_trailer_thumbnail": null, "display_name": "Castaways VR", "keywords": ["castaways", "adventure", "kids", "cartoon", "pointandclick"], "long_description": "You wake after you've been shipwrecked with your grandpa. You hear someone on the shore calling for help, rushing towards it you realize he is your grandfather below the remains of your ship. No harm is done to any of you, grandpa is smart and you, Kolos, are young and agile. Together you begin your journey on the lush island, gathering water, fishing, looking at the stars on the night sky. This is Castaways, a cartoony adventure game for curious kids and adults alike!", "short_description": "You wake after you've been shipwrecked with your grandpa. You hear someone on the shore calling for help, rushing towards it you realize he is your grandfather below the remains of your ship. No harm is done to any of you, grandpa is smart and you, Kolos, are young and agile. Together you begin your journey on the lush island, gathering water, fishing, looking at the stars on the night sky. This is Castaways, a cartoony adventure game for curious kids and adults alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocketgames.eu/privacy", "developer_terms_of_service_url": "http://www.pocketgames.eu/terms", "publisher_name": "Pocket Games Ltd.", "support_website_url": null, "website_url": "http://www.pocketgames.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EDUCATIONAL", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
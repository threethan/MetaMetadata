s built by our talented build team, find published Community built planets, build maps with other people publicly, or build your own planet by yourself!\n\nYou can also visit the Mall, where you can purchase some fashionable cosmetics for your robot!", "short_description": "Orbital is a space themed VR game focused on sandbox building and community builds!"}]}, "developer_name": "Magnified Studios", "developer_privacy_policy_url": "https://orbital.magnifiedstudios.dev/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Magnified Studios", "support_website_url": null, "website_url": "https://orbital.magnifiedstudios.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35702015782745955"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507828592_940617528335600_71295331675354331_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcCyQAVBeQUQ7kNvwHX_vM8&_nc_oc=Adroan2Z8Wf8y0kiUaM0_GaaG_CqHRxQBvo3lVBLGHhPX-cp6uOTRG3WIEcKoJPFRSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2JtQUGtxNz3Qyli6qyo4iiTv9ABRrjJrzSLAn_qscww&oe=6A5787B6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Orbital", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2
28_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTjD82k1tFAQ7kNvwGf5IbI&_nc_oc=Ado-iijc0ehYi9ynJ8TK4bmK7ux4uw0Zh2HM5sat3XJOTXGOL_hgxbmvH9yon0BlkZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3yDQ7dw_-Gtzv7K3rj2zuKn0y9SrAIg1KCUV7EOLLK6A&oe=69F0ABC0"}, {"file_name": "3.png", "id": "1274699934250911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1274699937584244_8569799209673060711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JeY2xiV0qYQ7kNvwGVY-vX&_nc_oc=Ado556_ddve6iLFrfoxZ01oyPRtol9a-md97jmJdA0PHsCtLdJXwNTp-sqqAAl86BxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1NWCQWbY8qWgd0FHdSlYtFAtaqwo8S8gn0B8t-XcVdfQ&oe=69F0A9E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-4.png", "id": "1709948519886888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301053_1709948523220221_7813363641265614497_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fHUCvHynvEQ7kNvwE7qdLI&_nc_oc=AdqtZbYbeYFvrzUGiIVaXkNs7_bVa8vUqYkXD_TtH-P2Okzjgwi5T9vmWiMAi85IDGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3GEU2oHHuXNRi1WbLY-jI1rdxIXwfMS7PpveAwuzvy8A&oe=69F0CC78"}, "display_name": "Rainbow Hide and Seek", "keywords": ["horror", "survival", "escape", "hide", "seek"], "long_description": "Dive into the eerie world of **Rainbow Hide and Seek** \u2014 a thrilling hide-and-seek adventure designed for Meta Quest 2 / 3 / Pro! Your mission: collect all 10 toys scattered throughout a mysterious house while evading the relentless Rainbow, a quirky yet menacing entity. Explore dimly lit rooms, solve simple puzzles, and use stealth to survive in this immersive VR environment.\n\n# **Features**\n- **Eerie Atmosphere**: Explore dark rooms with stunning visuals.\n- **Unique Antagonist**: Dodge the Rainbow!\n- **Casual Gameplay**: Perfect for players of all levels.\n\nCan you escape before Rainbow finds you? Ideal for casual gamers seeking a fun challenge!", "shor
rvival", "escape", "hide", "seek"], "long_description": "Dive into the eerie world of **Rainbow Hide and Seek** \u2014 a thrilling hide-and-seek adventure designed for Meta Quest 2 / 3 / Pro! Your mission: collect all 10 toys scattered throughout a mysterious house while evading the relentless Rainbow, a quirky yet menacing entity. Explore dimly lit rooms, solve simple puzzles, and use stealth to survive in this immersive VR environment.\n\n# **Features**\n- **Eerie Atmosphere**: Explore dark rooms with stunning visuals.\n- **Unique Antagonist**: Dodge the Rainbow!\n- **Casual Gameplay**: Perfect for players of all levels.\n\nCan you escape before Rainbow finds you? Ideal for casual gamers seeking a fun challenge!", "short_description": "Survive, collect 10 toys, and escape the house before the Rainbow catches you in this thrilling VR hide-and-seek adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://elixor.app/rainbow-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Elixor Apps", "support_website_url": null, "website_url": "https://elixor.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23962892250018173"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2688898304638916"}]}, "baseline_offer": {"id": "268889
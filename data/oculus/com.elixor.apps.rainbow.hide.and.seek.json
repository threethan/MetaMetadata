Features**\n- **Eerie Atmosphere**: Explore dark rooms with stunning visuals.\n- **Unique Antagonist**: Dodge the Rainbow!\n- **Casual Gameplay**: Perfect for players of all levels.\n\nCan you escape before Rainbow finds you? Ideal for casual gamers seeking a fun challenge!", "short_description": "Survive, collect 10 toys, and escape the house before the Rainbow catches you in this thrilling VR hide-and-seek adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://elixor.app/rainbow-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Elixor Apps", "support_website_url": null, "website_url": "https://elixor.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24016552671318797"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827038_764271039278757_6871919688931452053_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdhp_S6np_YQ7kNvwGb5URt&_nc_oc=Adolz8kUAOnOmuPGs8Hw9On1hvoqWZapUqZUI7ZT7Gxiy5oXpZjvDjI3dn_PWFR8mo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr9NOkmoqV6shLAAIv1FOzkWcDsk8WVwRznsY_pbPFaA&oe=6AEA07A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rainbow Hide and Seek", "platform": "ANDRO
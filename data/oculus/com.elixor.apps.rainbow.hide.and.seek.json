28_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HN5YoSUsWwQ7kNvwFbfDb9&_nc_oc=AdnbdMiU77qpZMM3Ep1O2uhQIXEDmxeyaa_GFKAmqdXjsT7LVcrNmQ2ON50FlFFRmVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVgG3OJCBmjCHEoKsLIyJ3Ls_V9Tx1xQPqflmAxiN72A&oe=69A04040"}, {"file_name": "3.png", "id": "1274699934250911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1274699937584244_8569799209673060711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsTvS5hm7MAQ7kNvwFl9WqS&_nc_oc=AdlE5tmFlXmdVuG4xyzuyxC7RO9HA4zh-_ybj13tL3KuPwNj3tcDBz-Tf8wIfF7jx5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_vQxDftw2Q4ecBOagrts3xNQPjy-THnpL8m_hKlS6Lw&oe=69A03E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-4.png", "id": "1709948519886888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_1709948523220221_7813363641265614497_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbDt1vTXjEEQ7kNvwHr8F1d&_nc_oc=Adl92S5qhTUQt_cWSojfbDnvby0xcKk-7zg9ZnOWhNmR67N5HsWPTvL2Sitzo9yVI-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSMb1Hy6tNx9qnRxXZcPY8IqqNDDs8PvAP5PA7eTtzWw&oe=69A028B8"}, "display_name": "Rainbow Hide and Seek", "keywords": ["horror", "survival", "escape", "hide", "seek"], "long_description": "Dive into the eerie world of **Rainbow Hide and Seek** \u2014 a thrilling hide-and-seek adventure designed for Meta Quest 2 / 3 / Pro! Your mission: collect all 10 toys scattered throughout a mysterious house while evading the relentless Rainbow, a quirky yet menacing entity. Explore dimly lit rooms, solve simple puzzles, and use stealth to survive in this immersive VR environment.\n\n# **Features**\n- **Eerie Atmosphere**: Explore dark rooms with stunning visuals.\n- **Unique Antagonist**: Dodge the Rainbow!\n- **Casual Gameplay**: Perfect for players of all levels.\n\nCan you escape before Rainbow finds you? Ideal for casual gamers seeking a fun challenge!", "shor
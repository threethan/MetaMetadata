28_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WePnwnOguMkQ7kNvwFs0BDU&_nc_oc=AdkqrJIJLFlNi20MksTYyfQHYwVAY-vPoKrQZFxQ1c08mEylIYXdslliKs9Lmex61OI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvC8nqfQJJGx3T3jMHJmD7b55RuAmhkMzm1y4W5IkAZIA&oe=69985740"}, {"file_name": "3.png", "id": "1274699934250911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307315_1274699937584244_8569799209673060711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pled_NybE7AQ7kNvwFqwCNB&_nc_oc=AdmuOfhLW3oODLTvSXXP4D1PXtZAW_wuDacqfngor8-ewOARY1zBJdSwf-ke9WlPTr4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRnvXQ6ZqvpLrAqVADTquipCRpWeliF0Ko7d3U8raQ1w&oe=69985569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u0411\u0435\u0437 \u0438\u043c\u0435\u043d\u0438-4.png", "id": "1709948519886888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_1709948523220221_7813363641265614497_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iao0RUz2GRAQ7kNvwHzawEm&_nc_oc=AdkVYHORSdLwmPUmAF03RpVK3K0bXKah8noh6M3hRBTZBN3Q3-yNE4noH2ZOvSMWzE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuR31kKa8oODtMelshkQpZ2qeXPavm4a0uwFkPRTE-aew&oe=69983FB8"}, "display_name": "Rainbow Hide and Seek", "keywords": ["horror", "survival", "escape", "hide", "seek"], "long_description": "Dive into the eerie world of **Rainbow Hide and Seek** \u2014 a thrilling hide-and-seek adventure designed for Meta Quest 2 / 3 / Pro! Your mission: collect all 10 toys scattered throughout a mysterious house while evading the relentless Rainbow, a quirky yet menacing entity. Explore dimly lit rooms, solve simple puzzles, and use stealth to survive in this immersive VR environment.\n\n# **Features**\n- **Eerie Atmosphere**: Explore dark rooms with stunning visuals.\n- **Unique Antagonist**: Dodge the Rainbow!\n- **Casual Gameplay**: Perfect for players of all levels.\n\nCan you escape before Rainbow finds you? Ideal for casual gamers seeking a fun challenge!", "shor
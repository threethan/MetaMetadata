png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J74ZZGOLIrcQ7kNvwFzGRPm&_nc_oc=Adr_fJNN2BA20T4uSeTw44H28-UBLEJHnJimK8SIlwhaLYTOKzf7hXK6nVCqzy-QgTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-9o3RK8ySJW_mkDsLfCTP3h8LzYJ0TBTo1KMU8fg8fw&oe=6AEE0A9B"}, {"file_name": "05-settings.png", "id": "1396303385985943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628016_1396303389319276_8754195179024771070_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dzkRDqYTCYQ7kNvwG-rf0c&_nc_oc=Adou5LwedtYXQ7t9Qyn4TYKgTGJUuFeRexLLobhB_GsBnTzuscAhrf5vQtMjk5dzsDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3fBe3PSlSMNg010jUctbe60_XnK_4MAJ0tCqcKWXrqQ&oe=6AEDFBCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mushaf VR", "keywords": ["quran", "mushaf", "islamic", "prayer", "arabic"], "long_description": "**Mushaf VR** brings the Mushaf Al-Madina to life in virtual reality. Settle into a bright, sunlit majlis lounge: the complete Holy Quran rests open on a wooden rehal before you, pages glowing with ornate Madinah illumination, while a giant panoramic window reveals a slowly rotating planet Earth drifting past. All 604 pages of the true Madinah pagination, rendered in clear Uthmani script. Features: Complete Quran \u2014 all 114 surahs, 6,236 verses, true 604-page Madinah layout; ornate Madinah page design with illuminated borders and surah headers; turn pages naturally \u2014 tap with your controller or pinch with your hand; surah navigator (surahs and juz, jump anywhere); search \u2014 jump to any verse (e.g. 2:255) with quick chips for famous passages; bookmarks \u2014 save your place, resume anytime; breathtaking lounge with Earth view; Arabic-first interface with English option; adjustable page brightness, text size, Earth rotation. Private by design: fully offline, single-player. No accounts, no ads, no analytics, no data collection. Your bookmarks never leave your headset.", "short_description": "Read the Holy Quran in virtual reality: the complete Mushaf Al-Madina in a bright, sunlit majlis lounge with a panoramic window onto planet Earth \u2014 turn pages with your hand or controller."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muse.ai/s/mushaf-vr-privacy-policy-2-jh6cx0xvgzvxjv", "developer_terms_of_service_url": null, "publisher_name": "USA", "support_website_url": null, "website_url": "https://muse.ai/s/personal-website-xzu6bxtxsxrrsjxb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1338259872707696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_2099180534320017_3703230738375809907_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4yBggNvswkQ7kNvwEH3wt7&_nc_oc=AdrgvEmS1hHTWu9pVC3o8W7Pnvm06scnPx9Zo4jgYfmSlO8AQOAF1w-v3dFPy08f7sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Svf2Chi5-ht86cnydSAIBOqX-kwsac7XyOMQVolM_Q&oe=6AEDE2AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mushaf VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1793207280, "lastRevision": {"nodes": [{"id": "1300385286495155", 
187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fkNQ8bo6c8Q7kNvwEnSX2g&_nc_oc=Adr9vsgco-L8O3kRtTSlEs8TP6tFl1_qeS2ww7nroQLyQK2rlNxPKMKXNC6SzxD2RbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u6kcmplJyNirgm3PmUKMzw617ft9wmi5qnO7THIbUHg&oe=69E61DC7"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3CDIsQ4MU8Q7kNvwHgqYxF&_nc_oc=AdpemwQNzZ0nqcyYQ5P5DnElrcj5Tx1zsbjtqBe3mRk02jlPhE8Gj9bc178X-JKGYes&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qg0kGevOlpmLs2uM0NTQdjAEVlzLSyfOsXpmNeo64qA&oe=69E62348"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8r8EO2hvPYQ7kNvwHP5Yd1&_nc_oc=Adq5nAopGG_paEwkME84elU8y35L3YW17O7hW5afosJUrTd3_oXdvDHbAD8eQKWDUK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bo1KwF4xKamK1b3l4nGvG8AFAwTX5i1YhC6FLfgZmpQ&oe=69E63B0C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnF5MKcFrbgQ7kNvwFc56EA&_nc_oc=AdqZ3fc2sALxgLpuHohz3K37JjWjcZfEVQWt8XlLLhZJ9tmR5COw0KIi4jzIYSjc79g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QcoOf9OtFErLyfDYJXe1hyDOF2enDcHIbPN4rJV_VnA&oe=69E6437A"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfxhSvRZvXoQ7kNvwHHoJ2C&_nc_oc=AdrBopLBqHPvczC7I6sijhFonLO7kDW8szAEWBWnRgSBlIpqglOui3WzRisfJVL-snE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bKqgQjaZtO9vDVO9Syc-n_oU7BaowZtemEEFPrv3ZGg&oe=69E628D8"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZf3rtLd9MAQ7kNvwEAwBcf&_nc_oc=AdpdTrQa0Novgce1M7ZBKiRbUDtf3UKP8vmUwPfMqsSvexPJAGG-jT6jNv7k2x6mTNc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dGoBwlaY1Q4yF4KdZz3gmzXbhT40NBVdsY3KSphKPCA&oe=69E63898"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJnpv5yqkQoQ7kNvwHxe3An&_nc_oc=AdpYU5hk1H6goAOhYFLZuy6iJEVKEUd9h155T1ts1osy24Zz-12yKHb-Pi7MZY9vFvU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i1Xi1SvoHwCNz51PXml9nhRl0EbjbicXPww76vD8ApA&oe=69E62587"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34961689623477881", "version": "0.47"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34961689623477881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.47:\n \nAdded a new mechanic to Axe: Every 3rd hit in the same area does bonus damage (25%+)\nAdded a new mechanic to ClawShield: Every 3rd hit in all different areas does bonus damage (25%+)\nSome areas in \"inbetween\" places (like the area where legs connect to hips) can count as either region (leg or stomach). So this bonus system is more lenient then it seems.\nThere are finally decal wound effects on bosses after you hit. If they are bright red/orange they count for the bonuses for axe/clawshield.\nTreewoman: Nerfed her damage by around 33%+. Increased delay between the attack you have to duck. Also increased delay between the projectiles attacks. Made her attacks louder.", "created_date": 1776020819, "id": "34961689623477881", "version": "0.47", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34961689623477881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.46:\n - Added Player Lifesteal to all the custom menus for all the bosses.\n - Lowered life steal from 25% to 10% across the board (experimental, try things out especially in custom to help me adjust).\n - Added a \"Copy from difficulty\" to the custom difficulty menu so you can copy the values for a difficulty, and then adjust from there. So its easy to go \"Hard mode but more health for the boss\".\n - Increased boss health across the board by 1.5-2x. Except normal and below werewolf and paladin who got much less health increase (so new player experience isn't that different).\n - Added endurance mode difficulties, that are basically same as hard/trans but much more boss health but player also has twice as much leech (about same as it was originally before this leech nerf).", "created_date": 1775340337, "id": "34807656272214551", "version": "0.46", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34961689623477881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v45:\nJudith now avoids staying far from the center. Stops blockable dash attacks from going through.\n\nFather now has much faster windups for the first attack in combos. AOE Smash is now interuptible. Cancels combos if player is too far away.", "created_date": 1773187264, "id": "34318875684425948", "version": "0.45", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34961689623477881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": null, "created_date": 1772756932, "id": "34233035979676586", "version": "0.44", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34961689623477881"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": null, "created_date": 1772492295, "id": "34179188945061290", "version": "0.43", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
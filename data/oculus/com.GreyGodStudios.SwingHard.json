g?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQgpkwSC20Q7kNvwFcwvYv&_nc_oc=AdpTd2Uq9kx8c84YByqjYZOsoFIe-UMZyVHxtJOvA-zsFAxJW0-JO58SIRswxDcC4oA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxEJ-LTDRKi5dyyfe24vomnUJZ-K554a7Jpl2te1xXYg&oe=6B06FBFA"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRbFDxtnF-AQ7kNvwFeMSHw&_nc_oc=AdrC7s2ghWgbyl3Uhmxzv7It6jCIe8EJ1wCKNnXbsjTD4Fj9n08ISM5z7m7SEpPGqrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1amMBBPQE0uHLesrcgrZ-MxD4Qs05XlWuEdlTGTuCCw&oe=6B071998"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBBNW3QNJ6cQ7kNvwGkUXFS&_nc_oc=AdqAdUn3CZPNx7YEWicf6nsg36BF318Bx5ovMoE6Ces8-gjs0TsJZLeBRStlC47fQlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSza2U1q5Z1j0GtAponmNdkrYPMbIf8olXgvPAbPTyOWg&oe=6B072958"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIzf4MDKx1UQ7kNvwE5XQe3&_nc_oc=AdpUxM3ll5YNmcq81oHj9b1HvkNo2A0gWJt3Y8XWihmIITwiLkiLV1AUEMHwvl3GstE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuV7MvliWGXuhALB9G1TuHfWfgsZzBTB0nkoRNAa9XFA&oe=6B071647"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40181257544854370", "version": "0.74"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40181257544854370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "Lower Knight health 1500-1400 slightly (<10% decrease)\nLower Father Health from 2000->1600 (20% decrease)\nLower Father green base dmg 30->18 (40% decrease)\nAdjust bjorn duckable attacks to be more obviously duckable. And made a bunch of his combo attacks slower.\nAdjusted Father attack animations. Trajectories should be a bit easier to dodge, and some hopefully a little more obvious how to dodge too. Also some combo attacks slowed slightly.\nMade trails left by attacks last longer and brighter. To help players figure out the attack path of attacks.", "created_date": 1795025095, "id": "40181257544854370", "version": "0.74", "version_code": 74, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "40181234298190028"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40181257544854370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.73:\n - Father greens don't come out after his short non-combo early phase punches. Normal and easy they come out every 4 or 2 combos.\n - Fixed lighting for bosses in passthrough for the new Cave level (Father, Bjorn, Judith).\n - Changed the health bar to a circle similar to player health and there are dots for the phases. No more weird Eye thing. Adjusted health bar positioning for all bosses a little.", "created_date": 1794407377, "id": "39987070450939748", "version": "0.73", "version_code": 73, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "39987037517609708"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40181257544854370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.72:\n - Father, Bjorn, Judith now fight in a new level. They also each have New Music, and the duo bjorn+judith fight has its own song as well.\n - There is now a 4th weapon option: Per hand. So you can do any combination like 2 spears, an axe and a shield, etc.\n - UI menus now have hover-over displays. Let me know if any are silly or missing.\n - Trying out a fix for the Pro controllers, need someone with pro controllers to test it.", "created_date": 1793920787, "id": "39837477339232394", "version": "0.72", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "39837454555901339"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40181257544854370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "Adjust Bjorn anims", "created_date": 1791301813, "id": "39033776672935802", "version": "0.71", "version_code": 71, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40181257544854370"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "update v0.70:\n - Added a change grip settings in settings. Lets you hold weapons at different angles, unique per weapon and per hand. ClawShield has limited rotation angles to prevent some gameplay balancing issues.", "created_date": 1790205107, "id": "38733793576267448", "version": "0.70", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
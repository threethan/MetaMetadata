d5-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9mr6d7CMOMQ7kNvwFM815B&_nc_oc=Adosm7M6JKnF-tnsXg4Wy6aneNJb-JqwdbUrJl6CmnIGP3o00BNxEaXzgidcH6rRPYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsCopfj3Y1qZCkvdFrjORMRSmspHXAqc-XzHGQ1SBolw&oe=6AAA9858"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UilBJz2Qv_QQ7kNvwGjRkvX&_nc_oc=AdpW0Kly5hn2TgG2Q_SrE1R7bP6LumM4j9Dx2VSoX_watlFmGLb-cCJnM92nPBqLjk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrcMf6DnZYdZwHKgk4Jy_xbPmQOL34rO3eK2xhpIH32A&oe=6AAAA818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "youtubeThumbnailBig.png", "id": "675935912179470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298137_675935915512803_4797339970572124358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mmIGaiQBuoQ7kNvwHHs-le&_nc_oc=AdqCh3JIaaTeGLNcU29Nyn2jgRNa7VlehckzWaljWo9hJbyelIJxWU-b-c0xH5HVy0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJd65HYkYI_PO2XpazeBQITL7niCitqa6iVfKRMhwPlA&oe=6AAA92A6"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "challenge"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVMUJws54y4Q7kNvwHKpFgu&_nc_oc=AdpNzZj__eTvBz8QjvlzEIlTN1v8--gv9R3eHnVeyZDJd6AAaPV8VEalS1I51QfpKLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuL5F9KS3SqIAifKj5hLDQqv5H4JDJpcFa4oM1jDaxmQ&oe=6AAA8D47"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCFHXRlnPt0Q7kNvwGLYIBt&_nc_oc=AdrQvnYZ1lf-au4Mi3No92mk4DVGTU9eNnUU5XvuQbOM_oSL6v4wy2nJxptms3qVDCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOGIKGOUC11tBnySVmhrWJRFVRIUbAODeI2bmSCQ8SPw&oe=6AAA92C8"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-fcNKrU0JIQ7kNvwHfR2Rk&_nc_oc=Adrx9xpR8qf6QYr-2TymKtqLMfVMy0b1OUXW-VruLghE9FyBMeyfaLom4VNV3YFtTag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLygv74_suqAywA8SPZHQETzMkNtAm-cxgb6uyZA84ryg&oe=6AAAAA8C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUf_bvTI8-kQ7kNvwFVGK0F&_nc_oc=AdoR6o1Y4Srh0HEtKQ2GiRXFR9dUx6xLjfRrd0yxjU6NsdXpdLfnY0sJw_nT5LwBL_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR1PlGxLEWijUmAOeKAZv3srEJKrhHE0Y3MUXn5Sya-Q&oe=6AAAB2FA"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9mr6d7CMOMQ7kNvwFM815B&_nc_oc=Adosm7M6JKnF-tnsXg4Wy6aneNJb-JqwdbUrJl6CmnIGP3o00BNxEaXzgidcH6rRPYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsCopfj3Y1qZCkvdFrjORMRSmspHXAqc-XzHGQ1SBolw&oe=6AAA9858"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UilBJz2Qv_QQ7kNvwGjRkvX&_nc_oc=AdpW0Kly5hn2TgG2Q_SrE1R7bP6LumM4j9Dx2VSoX_watlFmGLb-cCJnM92nPBqLjk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrcMf6DnZYdZwHKgk4Jy_xbPmQOL34rO3eK2xhpIH32A&oe=6AAAA818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8URTpqzaMEQ7kNvwEXgQJl&_nc_oc=Adp-TgZQA9ZyFNtaHtW8KZIqC9zVbf-ORaQoQnZxCfNdy4QICxY1h85f5-yy9BFiQj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3PQNUqkriNlgIJmqDeluq5oFVQawnmXnLk1aNxnHQA&oe=6AAA9507"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38336861272627349", "version": "0.68"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38336861272627349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "Update v0.68:\n - New Scene! For the \"Elder Sister\" treewoman boss! Hope you all like it.\n - The Dummy Boss now has WAY more moves and attacks more simultaneously. Unblockable sword, either direction, and other side sword blockable. The Head and Feet can do blockable attacks on either direction! It's like a whole new boss.\n - Both stagger and life leech are disabled on attacks when you get hit for 2 seconds. So you have to dodge and can't just be purely aggressive.\n - Endurance modes now have player health much higher (5x), but no leech on damage.\n - Stagger damage required to stun a boss multiplier is now configurable on all bosses. Dummy and Father bosses now require more damage to be staggered.\n - Some more slight Bjorn anim tweaks to help with the \"too close\" issues but not much.", "created_date": 1788908191, "id": "38336861272627349", "version": "0.68", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38336861272627349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": null, "created_date": 1787355931, "id": "37899589866354494", "version": "0.67", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38336861272627349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.66:\n - Fix Knight animation speed not changing based on config\n   - Changed his custom variables order to start with speed, damage, health like the others \n - Buff Judith: \n    - Faster on various attacks. \n    - 2nd hit of her triple stab combo now unblockable. \n    - her must-block(green) dash stabs now hit more reliably. \n    - Her 4 hit swing combo that has unblockable duckable now lower so it actually hits if you do not duck\n  - Bjorn adjusted some of his animations so he doesn't lean as forward (In progress to adjust other anims).\n    - His dash attacks mid combo will now move him backwards if you are very close to him to prevent him from going inside you.", "created_date": 1786749944, "id": "37736146682698814", "version": "0.66", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38336861272627349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.65:\n - Add dates to fight history\n - Slightly adjust some Bjorn anims", "created_date": 1784933673, "id": "37260418973604923", "version": "0.65", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38336861272627349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.64:\n - Adjusted 2 Bjorn windup anims for the two \"double down.slash\" combo starters\n - Knight now won't do 3 purples or 3 red/greens in a row.\n - Added a fight history panel to main screen and death screen. Note old fights before this update will not have accurate dmg done numbers as they weren't saved before.\n - Fixed some difficulty name mistmatches for Bjorn and the Duo boss.", "created_date": 1784334256, "id": "37108963945417094", "version": "0.63", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
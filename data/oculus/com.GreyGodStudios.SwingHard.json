187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz2EdqWQ25EQ7kNvwEnp3xx&_nc_oc=AdqczaIAev25Dn89rFxpGQmToJcg2vxbmmtqCTqEt7lIOv5NWMwyt7UtDPAwqssMFcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MGAzkShlepqcSiDza0XW2Cm-V72G9WOiLKd2TzkdNuw&oe=69F9E447"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBdouV_gfZcQ7kNvwFonmum&_nc_oc=AdpVzoJxq5SMCFaEhqlIkzkLhU3Ug7ug9UY15Q06W-_KeLwWFWXVbz_UZpAZjRzPZKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q5211pOMAmW5hlbyPaqWFRLZR-LgdH5ZYJXZq-DLENw&oe=69F9E9C8"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QRIh313BuQQ7kNvwEtMMBI&_nc_oc=AdqDuPIZY0xCRuCt7OM8Lxmf_3VEmafSc2R4e_D4XH5fBCp2KIl_VUx4nI1gsmh2CMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BdgdeKFDlTtD5nLsOMV8UZ0W-G9GsmgZv6uGlV_1oLA&oe=69FA018C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XefZS8GzGpIQ7kNvwF-C4uQ&_nc_oc=Adozz3d6vKCqEGBaxr4DO0B7rlW1WzuSvXgL_b3fOEMqhQYa5IRB_bZDjkAsAkv87VQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7glVbq8bQSbhP0JV4T230W9Sc6PiAtlrtlw4OOAgn35Q&oe=69FA09FA"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8rooviitMIQ7kNvwGwWZ1Q&_nc_oc=AdqyEpwxvKD6pvPkkoaOqBhBpxp3rtX2O7rJGncF8Ma_cpdDuPSIXpd36JrCIvr_Mt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jhZyMSmrwnuimdEcG8rTCNqwNnTi7gR0i7WsgF3SjEg&oe=69F9EF58"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0oid7Kkyw8Q7kNvwGnSAH3&_nc_oc=AdoIosCYn-cUvOueyj_3TzATKwfzePtbCY01Pn4TVgiLRcBMbnfZEtbM_ZPg_RJlHUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jTWOnXD3FS3piKawvnfoeau8SPgij-2GqyQLp3WrApQ&oe=69F9FF18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fMshUbJhAIQ7kNvwE32cYI&_nc_oc=AdqdeWnTZOwmAhIEohPQ9QzWOCrC32GAKwFaIw_asi6LVQD6kFh1vu_Lbe1LH5VgVSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ZVzRP4O1YF8q4bobWdt7STazWzp03Z9aCeEsGojxbg&oe=69F9EC07"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35214623971517777", "version": "0.51"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35214623971517777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.51:\n - Fix performance issues in the town scene where you fight Knight/Dummy. Especially was an issue on quest2.", "created_date": 1777089431, "id": "35214623971517777", "version": "0.51", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35214623971517777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.50:\n - On quest2 especially I noticed passthrough IMPROVES FPS!!! EXCEPT the red blurry vision effect when you are hurt lowered FPS a lot. So I disabled it for now until I can fix its performance issues. With it disabled performance seems alot better.\n\n - I noticed some performance issues with the blood particle effects, fixed them, and it improved performance a lot.\n\n - Enabling the rest of the settings seemed to not hinder performance (on hit effects, scars, blood, number popups etc). I think the scars became less of an issue once I limited it to 10.", "created_date": 1776989144, "id": "35186054367708071", "version": "0.50", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35214623971517777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.49:\n - Redid how the straight stab bonus works for Spear so its much more consistent\n - Added setting to turn off boss scars. Limited scars to 10 max because of performance issues, especially with passthrough.", "created_date": 1776903794, "id": "35162630426717132", "version": "0.49", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35214623971517777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.48:\n - Added Passthrough mode to quest native builds!\n   - Tested to work on both quest 2 and quest3 \n   - Enable/disable option seen on bootup and settings menu\n - Added a health bar for player hp if you look down (It's circular).", "created_date": 1776552974, "id": "35083159794664196", "version": "0.48", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35214623971517777"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.47:\n \nAdded a new mechanic to Axe: Every 3rd hit in the same area does bonus damage (25%+)\nAdded a new mechanic to ClawShield: Every 3rd hit in all different areas does bonus damage (25%+)\nSome areas in \"inbetween\" places (like the area where legs connect to hips) can count as either region (leg or stomach). So this bonus system is more lenient then it seems.\nThere are finally decal wound effects on bosses after you hit. If they are bright red/orange they count for the bonuses for axe/clawshield.\nTreewoman: Nerfed her damage by around 33%+. Increased delay between the attack you have to duck. Also increased delay between the projectiles attacks. Made her attacks louder.", "created_date": 1776020819, "id": "34961689623477881", "version": "0.47", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
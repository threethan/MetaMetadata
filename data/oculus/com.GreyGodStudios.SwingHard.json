187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx4cTwCt_ZUQ7kNvwFt9OEx&_nc_oc=Adril0ZUUpjNtUXAW_pqi8WVXS-XA1UDVkMs15dqD16Xqqyi-rqzUlB-LHPOHtHBl1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKSBf1h9U3vBREUVX-1b_4sesfa4zV833nuU6812UhoA&oe=6AF5EB07"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOwc6eWKAfEQ7kNvwGf_3vP&_nc_oc=AdqLsKBgHUw9WUyrJ5Qan5cOLNe7wuIzS5pMb42Gn_R7O781Tps2ffEmFQ2loMGh6i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNsUQrIQ1b4fpAo4q9v5mj3JSH81KJMxYj24N39GW1WA&oe=6AF5F088"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR3QWl2HG9YQ7kNvwHHmlqP&_nc_oc=AdrU8V_-CCxy1ox3vsdKgrtuPNX-n6l9fYIV46rassLBXSRsjdzBuKrVpHiTwOHLX6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScnntlvdHG2YwDYRSKaTchzQR734L61aEbP-x4bv6GFQ&oe=6AF5D00C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIY9g4vOzV0Q7kNvwFtiQCK&_nc_oc=AdpVXhN4lGG6FD-XC2CHgSmWh-20PWsh11CVSwuyY2XFM2YSP4PsR7LPYtpm1NzX-sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWYo3Xkyv7I5zDU21_W812JO96LDxZPgCzCrSLyV2ELQ&oe=6AF5D87A"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBl_ztFi32IQ7kNvwGsQRgV&_nc_oc=Adpi4aObqHA8XbnatrDq6ynykrgbPy-AT40x4HnxvBgbXC3YcbZkVo9Tzg2BZQmD7lU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfVdlVpo4mbDuAGjeXeTOICZ-T_8rLuSfeeC5RoZ74zQ&oe=6AF5BDD8"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_d1KoBfhTsQ7kNvwG83U3D&_nc_oc=AdrnF5pGQdZCAtWrmXrm0R_kjJBPnARhPLoVI7jxtNcrQy3LIvUCay-ArXOiamAxk0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeqzczr_TAUj8vlGA3QC7Omy7lsOdLfpDjsdHr0dWFGg&oe=6AF5CD98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=God9WmRvsVEQ7kNvwFwcqkT&_nc_oc=AdpDlRKlhiR4VCQhXkgRgh9A8kS-5hLdaF-tR4LDlbt5oknNczvzEYBHjdZbNZhT5Rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvoV8aJNhXMLISS8QdoIzAFaRjvWWxpK3q-_RmimYhRg&oe=6AF5F2C7"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39837477339232394", "version": "0.72"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39837477339232394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.72:\n - Father, Bjorn, Judith now fight in a new level. They also each have New Music, and the duo bjorn+judith fight has its own song as well.\n - There is now a 4th weapon option: Per hand. So you can do any combination like 2 spears, an axe and a shield, etc.\n - UI menus now have hover-over displays. Let me know if any are silly or missing.\n - Trying out a fix for the Pro controllers, need someone with pro controllers to test it.", "created_date": 1793920787, "id": "39837477339232394", "version": "0.72", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "39837454555901339"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39837477339232394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "Adjust Bjorn anims", "created_date": 1791301813, "id": "39033776672935802", "version": "0.71", "version_code": 71, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39837477339232394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "update v0.70:\n - Added a change grip settings in settings. Lets you hold weapons at different angles, unique per weapon and per hand. ClawShield has limited rotation angles to prevent some gameplay balancing issues.", "created_date": 1790205107, "id": "38733793576267448", "version": "0.70", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39837477339232394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.69:\n - Bjorn is now like 20% smaller. And his time between crouching mid combo and dash attack (looking for his keys) is much shorter. This should make him feeling like he's going into you a little better. \n     - Animations adjusted so the amount needed to duck to go under his high unblockables is about the same.\n     - Made his blockable attacks slower startup and have a larger deflect hitbox.\n - Dummy hitboxes adjusted so deflecting is more consistent. Before the hammer I believe hit you before the deflect did, now that shouldn't happen and deflect hitboxes are more generous.\n   - The speed of his unblockable mid sword attacks slowed.\n   - frequency of his top hammer and foot mace attacks less.\n - Vulnerable windows now only let you get 1 vulnerable boosted attack per window.\n - Endurance modes adjusted to have 6x player HP from 5x (so 20% increase)", "created_date": 1790044262, "id": "38680967214883418", "version": "0.69", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39837477339232394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "Update v0.68:\n - New Scene! For the \"Elder Sister\" treewoman boss! Hope you all like it.\n - The Dummy Boss now has WAY more moves and attacks more simultaneously. Unblockable sword, either direction, and other side sword blockable. The Head and Feet can do blockable attacks on either direction! It's like a whole new boss.\n - Both stagger and life leech are disabled on attacks when you get hit for 2 seconds. So you have to dodge and can't just be purely aggressive.\n - Endurance modes now have player health much higher (5x), but no leech on damage.\n - Stagger damage required to stun a boss multiplier is now configurable on all bosses. Dummy and Father bosses now require more damage to be staggered.\n - Some more slight Bjorn anim tweaks to help with the \"too close\" issues but not much.", "created_date": 1788908191, "id": "38336861272627349", "version": "0.68", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
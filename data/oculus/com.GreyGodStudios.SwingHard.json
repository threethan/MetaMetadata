187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya8gCAm6ivQQ7kNvwGsK_6y&_nc_oc=AdquvjV2TxuMkp7dM84RaGpBRp5Ob0o1hrqbBGSS2ujcaxrW_ZIutiu80l8JycDe9-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DvZdpKM2IzsrryRWWnXzK5m3whv2anifGjIdfat6nnQ&oe=6A1593C7"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyrbPvEj9LIQ7kNvwHaedNT&_nc_oc=Adq3m1Rz0gPYGdEp0SK7XK0CIqsgkWFGn1FcHkG_RCUmT_DcLO_n71R30L6sMXQ9mkA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ws9HBHOVsJOs7ENVMO_1Ncl1rr8sG6Olxj2oy6MaI7Q&oe=6A159948"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQs5ax37EbUQ7kNvwHTdPd9&_nc_oc=AdrdaeWghxpZhRVfg5iJ6aUmcmiG4FHptKhlP8HonI4SiSW0M836z3TmeQn0WEPKYD4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c0_2qbmHLbw-Y7WdtBZ_rz7OKFV4gEZvjCd2sBBZ58Q&oe=6A15B10C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEgyPAP9h8sQ7kNvwEJ5jXC&_nc_oc=AdpHC9EfWdx9FUuRTqCwujkKLIEl3aJoEK1cytS6mBPFj8jWwP0hlNcbg1Y72CSNxdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SkIgifYTXBwxBQVHOAGQUhMsqzw042svhGia2JORLyA&oe=6A15B97A"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIrg9wAOFE0Q7kNvwGjk8Fq&_nc_oc=AdrN0Ww1tNY7-OZoFp7HXKZvMGlcBFkheM8VU_lzSfTv2mSgXHRNoR25T6228cq6Gq4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HgXmApfpFH1XvhqeCOLJ0Oj7VXqFV2w6VDDprnD8egQ&oe=6A159ED8"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV8MzjDBSTYQ7kNvwFyr6vk&_nc_oc=Adrb1eE6NtS3iDKZukIZW-6AYUvt99PM25XzLZIcXAN_0r3p5eXy_gv4haJmhypmAMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DDUgXFXG2C5obTmLLalZKsVilBJZPmpSXIgTtpovYOQ&oe=6A15AE98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3psTPob-YcQ7kNvwFne4DB&_nc_oc=AdqL4ye5hu4CpTJyOkC0jEuNxY3c0f2IHWQSA-W-HBB76ee3QNOjSjfML1ol109NHz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af688BoweJFjTD9eJtHNo--VuOTuePu2pchyB7wO7Y6LCA&oe=6A159B87"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35686608947652608", "version": "0.54"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35686608947652608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.54:\n - Bumped player health from 250 -> 350 across the board.\n - Made threshold for joystick crouch-to-move movement much higher.\n - Added arrow indicators for each controller when joystick is past threshold for where its pointing.\n - Nerfed werewolf double swipe from 60 dmg per arm base to 40 to prevent 1 shots (% affects all difficulties)\n - Swing Soft or Hard menu is now only asked once on bootup and then not asked per boss selection anymore to make it less annoying. Can also adjust it any time in settings menu.\n - Slowed down Craven's reposition attacks by about 20%\n - Moved health circle out and up a bit so its easier to see", "created_date": 1778889033, "id": "35686608947652608", "version": "0.54", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35686608947652608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.53:\n - New Mechanic: Vulnerable attacks. Some attacks the boss will leave white after images. If you attack them during those attacks with good timing you will do massive bonus damage and stagger! If you do it successfully a red ring effect will show and a sound effect.\n - Enlarged deflect hitbox for tree-woman and father. Added warning line indicator to show their trajectory as well.\n - Stagger meter regenerates half as fast on bosses now.\n - Fixed a bug where special bonus hits weren't giving a big bonus to stagger damage.", "created_date": 1778279412, "id": "35517626091217562", "version": "0.53", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35686608947652608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.52:\n - Added a new stagger mechanic! Harder hits and special bonus hits do much more stagger damage. Stagger meter regenerates if the boss isn't hit for awhile. Stagger meter is Orange circular meter near boss HP eyes.\n - Fixed some bugs with Father", "created_date": 1777682202, "id": "35367958566184316", "version": "0.52", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35686608947652608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.51:\n - Fix performance issues in the town scene where you fight Knight/Dummy. Especially was an issue on quest2.", "created_date": 1777089431, "id": "35214623971517777", "version": "0.51", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35686608947652608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.50:\n - On quest2 especially I noticed passthrough IMPROVES FPS!!! EXCEPT the red blurry vision effect when you are hurt lowered FPS a lot. So I disabled it for now until I can fix its performance issues. With it disabled performance seems alot better.\n\n - I noticed some performance issues with the blood particle effects, fixed them, and it improved performance a lot.\n\n - Enabling the rest of the settings seemed to not hinder performance (on hit effects, scars, blood, number popups etc). I think the scars became less of an issue once I limited it to 10.", "created_date": 1776989144, "id": "35186054367708071", "version": "0.50", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
187024365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-AXW_OooP4Q7kNvwG0Mlyc&_nc_oc=Adofm_6cTuPYN29jRu9KcjmEGm4WyTuBsoYyNZBNlXgIeF3RugnMQ1CBbK2G6nqRIQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxuHewhXffu06RAYdwrGPN2Zn-uJLpUl8h_lRwYmQe5w&oe=6A5E1647"}]}, "id": "134981459648116", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-29-14h39m20s776.png", "id": "1442883444242852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298451_1442883447576185_1504424597560084694_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v786XhtG5KMQ7kNvwFlwC4w&_nc_oc=AdqJLZjBOFUg_TiO8t_j6K4ouHUSWruCjFcLsz3loZ9Hz86bVWY6fCu7lZkUBn6ET0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqQRa6-b8cLAr5Strt0Xn3A_EniC8Gq6FEXXcW3pLZcg&oe=6A5E1BC8"}, {"file_name": "vlcsnap-2025-12-29-14h43m14s394.png", "id": "737064912348925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830893_737064915682258_5529841253404627905_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF6SvE4lWTUQ7kNvwF4In9n&_nc_oc=Ado7lHUtvLAb1ydL5SJhc5HKwW9t0b0i0GeSKEkkT9YYSJ4j_AyMGrjv8Y4lBV5LvEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApNrSbz32WoQ4M01KXq8MC_xPxEnmk2OYapZGbBLnVNQ&oe=6A5E338C"}, {"file_name": "vlcsnap-2025-12-29-15h20m50s175.png", "id": "749878854282542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301236_749878857615875_930399863017285609_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clZ5cTnC5vUQ7kNvwGCDiUI&_nc_oc=Adoxe_jIp6shT7rwkGQ5i7UMYB1k9nvYICgGrkza4zbehB8wCKoa4axVVcAzUVvkps8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvGywOKuJI50H-5Y7dpgjTpaPmiQMDfb6CB00LA9qP2g&oe=6A5E3BFA"}, {"file_name": "vlcsnap-2025-12-29-15h40m35s071.png", "id": "2711760105823713", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302344_2711760109157046_7958586485741452919_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71ems8E9nLkQ7kNvwFEQ4dL&_nc_oc=AdqOQwMbMVD6n5j9W3fc9W5CFzQc8LyLjVoeGoqszWIEbAWd4sE7JJ0eY6cDEqolfJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt-GrQ2GPKqXp8DIktgQcPPa-KDuyxX2LDE3rbemiXsA&oe=6A5E2158"}, {"file_name": "vlcsnap-2025-12-29-15h43m25s276.png", "id": "2047731346075736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293732_2047731349409069_1818981348444882214_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8RSncUH_LAQ7kNvwGf2f6E&_nc_oc=Adoqn1J-574iSh4UX4ZN8WUJ9p1WC4y2zvcl36D9xakA86QhsWIYrzzAhCEk5jh1y5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7UIRPMbWO3jdE6Lqdd2uVCV-eeitS9JimLaXjKf0Dnw&oe=6A5E3118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-12-29-15h18m52s464.png", "id": "1262783269310416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299132_1262783272643749_5519705476992591808_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk3kHox2AgkQ7kNvwH7Jgza&_nc_oc=AdoAwdW-6RM9sGashj3D07-TVrj0yKwNIPesnZuKMzSliSQIB7p108MBnZw0ehvTanE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAQgM0nHceuhE2WIdo5oZ9-ynyv0uwFppNgWghCH6LRw&oe=6A5E1E07"}, "display_name": "Swing Hard VR Demo", "keywords": ["melee", "combat", "sword", "action", "demo"], "long_description": "Free demo version of the first two bosses of the game!\n\nSwing Hard VR is A Dark Fantasy Boss Rush game inspired by Dark Souls x Thrill of The Fight, that will give you a real workout! \nDon't just git gud with your fingers, git fit with your whole body!\n\n# Features\n\n- Several bosses each with their own unique fighting style, special moves, and mechanics. \n\n - Multiple weapons. Swing with Axes or punch and elbow with unique weapon \"Claw Shields\" or stab precisely with a Spear.\n\n - Damage based on how fast you swing. You can't just wiggle the controller to do damage like other VR games. \n\n - You have to move your body to dodge! Duck, Sway, Dash, and even Jump to avoid damage. \n\n - Multiple difficulty modes. Including customizable difficulty allowing you to even change animation speed of bosses. \n\n - Dark story, what unholy power has corrupted humans into monsters? Can it be harnessed for good? \n\n - If space is limited use unique \"Squat to move mechanic\" to reposition where you can use joystick to move but it requires squatting down in real life, ensuring a workout!\n\n# WORKOUT GUARANTEED!\n\n\n\n## Credits\n\n\nSongs: \n\nNoire Antidote, Mathilde Nobel - Dysphonia\n\nMellow Sonic - Gravitational Singularity (Xanomeline Remix)", "short_description": "Dodge with real footwork against challenging bosses.\nMove your arms as fast as you can to do damage.\nSwing hard, move often, you'll need to exercise your mind and body to win in this boss rush dark fantasy VR action game.\nGit Gud, Git fit, Workout guaranteed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://swinghard.greygods.com/page1.html#article07-1m", "developer_terms_of_service_url": null, "publisher_name": "Grey Gods Studio", "support_website_url": null, "website_url": "https://swinghard.greygods.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2264435127280407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "905639995329733"}, {"status": "PUBLISHED", "id": "3752661631535105"}]}, "baseline_offer": {"id": "905639995329733"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768571940, "status": "PUBLISHED", "id": "905639995329733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36970939215886235", "version": "0.62"}, "id": "857991379659787", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36970939215886235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.62:\n - Made the slash trail more noticeable so its easier to see the trajectory of enemy attacks.\n - Added two new songs to the game! These are not placeholder but likely the final songs. Werewolf and Elder Sister (TreeWoman) have the songs.", "created_date": 1783739961, "id": "36970939215886235", "version": "0.62", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36970939215886235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.61:\n - Adjusted some text.", "created_date": 1783648636, "id": "36950694667910690", "version": "0.61", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36970939215886235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.60\n\n - Adjusted a Bjorn animation slightly.", "created_date": 1783644414, "id": "36949873324659491", "version": "0.60", "version_code": 60, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36970939215886235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.59:\n - Bjorn, new and final planned boss is out! He is very difficult.\n    - Optional Super Boss: Judith+Bjorn. This super mega hard fight unlocks the 3rd ending of the game once story mode is out. For the absolute master players only.\n - Adjusted stagger so its more linear.\n - Adjusted clawshield so it cannot bug out with impossiblely high damage when tracking is inaccurate.\n - Also increased distance clawshield must move for a new hit so it cannot double hit as much.", "created_date": 1783643694, "id": "36949738091339681", "version": "0.59", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9821045494635641", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36970939215886235"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "857991379659787"}]}, "change_log": "v0.58:\n - Adjusted the various forms of the inn scenes into one, let me know if you see bugs: Tutorial, Tutorial Dummy Fight, Practice Training Dummy, Fight Training Dummy, Knight Fight.\n - Judith: Now has much faster windups for deflectable attacks, and much less recovery time so you can't just wail on her. Only the first hit in her jumping attack is vulnerable bonus dmg now.\n - Father: You have to be out of range for a > 1 second now to trigger the cancel into ranged attacks. Minimum 2 second cooldown between green projectiles (though I haven't seen this cooldown matter after the delay for ranged attacks).", "created_date": 1781963664, "id": "36536310902682404", "version": "0.58", "version_code": 58, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
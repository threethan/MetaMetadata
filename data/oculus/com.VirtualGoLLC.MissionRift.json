t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvQAkGct_6uKkM5MfVIgphMbHdQKMTzVwe3i3tBrH2Gg&oe=6A983CB5"}, "display_name": "MissionRift", "keywords": ["MixedReality", "Shooter", "Mission", "Rift", "Portal"], "long_description": "# Mission Rift turns your Entire House into a mission driven battleground.\nYour space sits above a dangerous rift, and you play as a secret agent defending it from spiders, soldiers, robots, ghosts, turrets, zombie like creatures, and supernatural aliens breaching in from an alternate reality. Fight through story chapters where terrifying worlds line up with your real layout.\n\n{1380636837264178}\n\n# House turns into a massive battlefield!\nEnemies can flank, ambush, drop on you, and take cover using the environment around you.\n\n# Fight back with over 30 weapons found through out the game!\nfrom flintlock pistols to rocket launchers, each with different damage, while experiencing environmental destruction effects throughout combat.\n\nFeaturing Story Mode, (Advanced Mesh Sandbox (Quest3/3s)), and Spider Kill, where you survive and eliminate as many spiders as possible under a time limit. More content to come.\n\n# Important\n- Quest 3 / Quest 3S and newer headsets support all game modes including Advanced Mapping Missions, allowing the game to scan and use more complex real-world environments.\n\n- Quest 2 players can still play Story Mode and Spider Elimination Mode using Meta\u2019s manual room setup, where walls and doors are placed manually. Advanced Mapping-Sandbox modes are not available on older headsets because the headset does not support the same environment-mapping features.\n\nMissionRift is now Fully Released!\n\nIf you enjoyed Mission Rift, please leave a review. Your support helps fund future updates!", "short_description": "You become a secret agent traveling through portals in your home to ancient temples, hostile war zones, and terrifying nightmare dimensions. Fight to survive as spiders, soldiers, robots, ghosts, and dark creatures invade your home from parallel worlds.\n\nBattle enemies throughout your entire house, complete mission-driven chapters, and unlock powerful abilities, advanced environmental scanning, new game modes, and dozens of weapons.\n\nEnter the portals. Defend your home. Survive the rift."}]}, "developer_name": "VirtualGo LLC", "developer_privacy_policy_url": "https://www.virtualgoreality.com/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": "https://discord.gg/53d4NQnDE9", "website_url": "https://www.virtualgoreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27590133900669278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299891_2449361872213577_4744591757303477894_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJbkpSMgFi4Q7kNvwGoNdZX&_nc_oc=Adq6NZZ5c9Yu9JwpUrcwIWEBzTtxMarQ9rtoNnO_ELeWVbfbwMHGwAeKi9096oGFif0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLisqQc2WvJaHXQGifdqP-O24859-OvB-luTAvDEhvI2A&oe=6A983B73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MissionRift", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433
6762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0Pzv7M8EGEQ7kNvwFtMw4Y&_nc_oc=Ado1bpzZdACppzTOahEaIKCNX5vv4ejRSwHwO7Me_vZGLI45TqCHUun16TdIPY76rRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_vCCy_n_MnfWfUDTLl9snbwQBtUt9xn6t5KFbBuqsEA&oe=6A37EB10"}, {"file_name": "p3.png", "id": "4712423975647071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_4712423978980404_3492724583130810812_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRcXTFkKrpcQ7kNvwHkcVsk&_nc_oc=Ado468g3gy3ZXSLk98Q3vmOzXhqiMIOGqpiJZ7uXYq6GgMz4aw8wdHMP-FV6pDeZAqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-90G-Txom6oQAYJDx_Z-My_u8a20ASag5Uk8Hdehg6ig&oe=6A380A6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title2.png", "id": "1774959736541539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1774959739874872_5170862874178960097_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opOm2Gswt3kQ7kNvwEFvasM&_nc_oc=AdqGtZ-1dDZysV6AvqLxjIVXVeIolPOy5U9pmOIqu_aHn69UTfzewHpYAqGx5gc5O-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f4KCUE7ukPImf7j6fMhS349IVmE1AYqH6eF-7i6qrPw&oe=6A37F9F5"}, "display_name": "MissionRift", "keywords": ["missionrift", "portals", "mixedreality", "Mission"], "long_description": "Mission Rift turns your real home into a battlefield across realities.\n\nUsing a custom mapping system, the game scans your physical space and overlays alternate worlds directly on top of it. Step through living portals to enter parallel realms, then move back out into the real world fighting across both layers of your environment as missions unfold around you.\n\nPlay Mission Mode through multiple chapters, each built around unique objectives, enemies, and set pieces. Survive escalating attacks from spiders, soldiers, monsters, and unknown forces as the rift spreads room to room. Spiders aren\u2019t limited to the floor, they crawl on walls, ceilings, and everywhere in between, so nowhere is safe. Defend your area with dozens of weapons across all eras, from muskets to futuristic firepower, each requiring different skills and tactics.\n\nPrefer freedom? Jump into Survival or a sandbox mode to explore worlds at your own pace. Some realities are calm, others are far more dangerous.  Your entire house becomes the level.", "short_description": "MissionRift turns any environment into a mission-driven battleground. Enemies and spiders can use floors, walls, ceilings, slopes, and even odd shapes to flank you, drop on you, or take cover. Other modes open portals into alternate worlds that perfectly lines up with your real layout.  Brand new improved meshing system enhances immersion "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualgoreality.com/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": "https://discord.gg/53d4NQnDE9", "website_url": "https://www.virtualgoreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24722034790812551"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "27479600891680465"}, {"status": "PUBLISHED", "id": "958907063510529"}, {"status": "PUBLISHED", "id": "1212022481095279"}, {"status": "PUBLISHED", "id": "881197461502663"}, {"status"
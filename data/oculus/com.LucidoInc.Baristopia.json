cdn.com/v/t64.5771-25/499293144_597945192871559_8762861003651137965_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE1pt3-NHg4Q7kNvwGtNcoq&_nc_oc=Ado16S8KTR2vUiiNRx8JFCjZUKpFs7jnp7em0fbU8tOF97BSL_n1WlJdHbkiFqcoj_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBvqObB_18-rDXpJnomN2LCDPZjX5uqEr-Ciax0hW66Q&oe=6B047E24"}, {"file_name": "7 (2).png", "id": "1220670026508163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296397_1220670029841496_5874116420936538996_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlc6XXLTnccQ7kNvwEOD_lr&_nc_oc=Adr9xfAUz96p-OLNCzLhCLMhajx7DB2FIIQ2MV-zi-kH0IpT67D6DzitJso-ZaNFsbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWvS2lQ0vJq__RVZxSNbIndqJvFTOgLq3ScFg9zL7nQA&oe=6B047577"}, {"file_name": "7 (2).png", "id": "9957963657572040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293153_9957963660905373_6344059176195779541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lehbT7SC73QQ7kNvwEh8c8A&_nc_oc=AdoeaLLjEFN8Vv5KVPuMyvPWll-EwEyuKH9Iit3a5OaW772RIq9qW5edmmVggv0KsGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJB02V30KkdFgz-ZQDqgo1kkqjbiudIe8IEK6f0oJwsw&oe=6B048024"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baristopia", "keywords": ["baristopia", "coffeesim", "coffeemaker", "coffee"], "long_description": "Step into the role of a barista in Baristopia VR, a dynamic and immersive coffee-making experience set in a beautiful beachside caf\u00e9. With customers arriving throughout the day, your challenge is to prepare and serve their favorite drinks as quickly and accurately as possible before time runs out. Using intuitive VR controls, craft everything from simple black coffee to elaborate espresso-based drinks, complete with milk frothing and flavor customizations. The game\u2019s realistic mechanics and time-based challenge create an exciting blend of skill, speed, and efficiency. As the demand increases, you\u2019ll need to multitask, manage ingredients, and keep up with the rush to satisfy your customers. Whether you're a coffee enthusiast or just looking for a fun and engaging VR challenge, Baristopia VR delivers a fast-paced and rewarding experience in a relaxing beachside setting.", "short_description": "Baristopia is a fast-paced virtual coffee shop experience set on a scenic beach. Serve a steady flow of customers by preparing their favorite drinks under time pressure while managing multiple orders"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/baristopia/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9939162446164993"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618531_1889944871844267_4321824002570663390_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3cnYiJxYFgQ7kNvwE2OWjn&_nc_oc=AdrpCiPB0Kt0fP1QDzBja1hmdpKKR5eWPHKHuFvrC9NdyaAtoLV5eNFrKeATy9EYJ-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDA0bfda9SwEi-JxMWv39AcpFET9_Wq44fNcWaH29egA&oe=6B0458B1"}, "is_concept": false, "is_t
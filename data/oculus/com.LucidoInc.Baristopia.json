ontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLTKWYtHyEeL2BQBG_49isZk67n-44utfHUk6rnOti2g&oe=6AEF6624"}, {"file_name": "7 (2).png", "id": "1220670026508163", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296397_1220670029841496_5874116420936538996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOYfoLzpdzsQ7kNvwHle5Bg&_nc_oc=AdrVsgmb_N558a5UqN4QRo0art9e5B0QoZPoOR5poqzB6gwzpYDXop9Qpf83cI8QXzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuTBfVWmUr5-MRoPo7CPJewGxdTVkALFzvFuGe-dfQfw&oe=6AEF5D77"}, {"file_name": "7 (2).png", "id": "9957963657572040", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293153_9957963660905373_6344059176195779541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTO5qJZl7hMQ7kNvwEt8SQS&_nc_oc=AdpUDI6-u5HuncS6t6yxDjYrQf-ZWVF7lOypVF7_5288BRQYnVr-ipZYteVfqECw4Zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzVCKRrqLzKt9AQC2Gneyjnv5BaA_pLR8w6R7OTgZ27Q&oe=6AEF6824"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baristopia", "keywords": ["baristopia", "coffeesim", "coffeemaker", "coffee"], "long_description": "Step into the role of a barista in Baristopia VR, a dynamic and immersive coffee-making experience set in a beautiful beachside caf\u00e9. With customers arriving throughout the day, your challenge is to prepare and serve their favorite drinks as quickly and accurately as possible before time runs out. Using intuitive VR controls, craft everything from simple black coffee to elaborate espresso-based drinks, complete with milk frothing and flavor customizations. The game\u2019s realistic mechanics and time-based challenge create an exciting blend of skill, speed, and efficiency. As the demand increases, you\u2019ll need to multitask, manage ingredients, and keep up with the rush to satisfy your customers. Whether you're a coffee enthusiast or just looking for a fun and engaging VR challenge, Baristopia VR delivers a fast-paced and rewarding experience in a relaxing beachside setting.", "short_description": "Baristopia is a fast-paced virtual coffee shop experience set on a scenic beach. Serve a steady flow of customers by preparing their favorite drinks under time pressure while managing multiple orders"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/baristopia/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9939162446164993"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618531_1889944871844267_4321824002570663390_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jzC9101INwQ7kNvwGb7YZv&_nc_oc=AdosyFDug3HoNAg14FDl9_iS-_t9yEVU-WhVsKkR-ONyODzWHfI_RBoD6I4xy6nlYs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF6wnpnIZhjumP4hweZXRGg3f3MjvHDiDXddzPT20qwg&oe=6AEF40B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baristopia", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1751010480, "lastRevision": {"nodes": [{"id": "9934510303296874", "r
8721164183722_2534490493773938688_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sIjyTXriUgQ7kNvwE0OYH0&_nc_oc=AdqslWfG5OQE-BH7IdokiQLtsgjetERZXGeR5pjvJBdNsVUPML5X-dvcy8ai4Tzxd7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-wM25uGvE8KNSANWbj8tYthuImIVAquFs4tS4LjiMQw&oe=6AB66890"}, {"file_name": "migrated_image.png", "id": "214550833288288", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_451589555589364_5962970372851630080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzVYZk0pmKAQ7kNvwEhr9pC&_nc_oc=AdonUcCkqpSMZTbQ6QNqshQaoUiSYxORLDwfGNSA1YUTcM2M9qU_RZWTecyon5ZUeaw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpiK1Ihm35NUu5bi0QHDT0d8Gx-3Y-RkoPolRfVIlbbA&oe=6AB68783"}, {"file_name": "migrated_image.png", "id": "550967269135255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_374619903264023_7889663886901641216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLMSpvqEYT8Q7kNvwEpdY0b&_nc_oc=AdqJ7CGXqR06DFwmRRq-cja2W9booLYtv-Sdu77uDf0oRLMI6jK1D0nyo5H9LAMJ38w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJWcWmNdVnl8Jmg_sYYv1ypHk090z590gUQZN8r4moBw&oe=6AB67BA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sling TV", "keywords": ["TV", "sports", "shows", "television", "drama"], "long_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save. \n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime.\n\nOver 100 live channels available to stream instantly on all of your favorite devices. Watch your favorite live sports like the NFL & college football, hit TV shows like Fear the Walking Dead, Better Call Saul, SportsCenter, plus 10,000+ hours of on-demand tv shows and movies.\n\nWith Sling TV you can get both TV and Cloud DVR on your terms - add it when you want and choose when you watch, for just $5\n\nThis is TV on your terms. No paying for useless channels, no long-term contracts, no hidden fees, easy online cancellation.\n\nThe Sling Orange service offers 30 channels for just $25/mo \u2013 including ESPN, Disney Channel, AMC, TNT, TBS, CNN, A&E, History, and many more.", "short_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save.\n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime."}]}, "developer_name": "Sling TV, LLC", "developer_privacy_policy_url": "https://www.sling.com/offer-details/disclaimers/privacy-policy", "developer_terms_of_service_url": "https://www.sling.com/offer-details/disclaimers/terms-of-use", "publisher_name": "Sling TV, LLC", "support_website_url": null, "website_url": "https://www.sling.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "NEWS_AND_INFORMATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_EX"], "id": "2999589760304906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_293074828275778_7606580419168829440_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEHUEdjQ3yQQ7kNvwEQ9Bf4&_nc_oc=AdoNu5ajuTnGCrdl2Q6nhrIijP2xAfDMBWT7IIRD_WIQFEj7zKepH58v04od77ykTZQ&
82197", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_374619903264023_7889663886901641216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umeuX_tL7FwQ7kNvwH2sq9F&_nc_oc=AdqKVCHwZ9VMFwDfxoVa11LQUzgO0tPRD4_thKlY3O-MI04-c-YMcUnBo1CY_RKxiuo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LtKYebUpuhdsBqghcXC8Pl3kdjtSjsXDeCtzRQuI7xg&oe=6A26C822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZzBak8", "id": "2452381391650374", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982685_2452381394983707_8297693717121204224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IFgLHtGURoQ7kNvwFDwdqK&_nc_oc=AdrkRVAOOeYXRwsVidpxmkI9rmXolCsJKVXfN6ZHHLd8mFJHKrJRL8pM0VVdkpmucNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90J_NTjwY_h6I-IDsqzFUZz5HfDB_K8PGTHQCUZUlVMg&oe=6A26E495"}, "display_name": "Sling TV", "keywords": ["TV", "sports", "shows", "television", "drama"], "long_description": "Sling TV is Live TV, Only Better. The #1 Live TV Streaming Service that lets you personalize your channel lineup and save. \nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime.\n\nOver 100 live channels available to stream instantly on all of your favorite devices. Watch your favorite live sports like the NFL & college football, hit TV shows like Fear the Walking Dead, Better Call Saul, SportsCenter, plus 10,000+ hours of on-demand tv shows and movies.\n\nWith Sling TV you can get both TV and Cloud DVR on your terms - add it when you want and choose when you watch, for just $5\n\nThis is TV on your terms. No paying for useless channels, no long-term contracts, no hidden fees, easy online cancellation.\n\nThe Sling Orange service offers 30 channels for just $25/mo \u2013 including ESPN, Disney Channel, AMC, TNT, TBS, CNN, A&E, History, and many more.", "short_description": "Sling TV is Live TV, Only Better. The #1 Live TV Streaming Service that lets you personalize your channel lineup and save.\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime."}]}, "developer_name": "Sling TV, LLC", "developer_privacy_policy_url": "https://www.sling.com/offer-details/disclaimers/privacy-policy", "developer_terms_of_service_url": "https://www.sling.com/offer-details/disclaimers/terms-of-use", "publisher_name": "Sling TV, LLC", "support_website_url": null, "website_url": "https://www.sling.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "NEWS_AND_INFORMATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1056755078440796"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7979615918776877", "version": "9.0.77326"}, "id": "563338427502637", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2703538566384665", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7979615918776877"}, "release_status": "SCHEDULED"}, "binary_rel
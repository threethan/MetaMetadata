png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKesDlE0XIgQ7kNvwGvREfS&_nc_oc=AdmBgvHdW8J1HrMiGsY_h9RuDsjMlewaI32gAt_yxaV1u8rGhdzbUcEgWTq8_nF_XYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6zEkSgI3NyZTvIXcNdJ0X9ktcWXZWYS5-Dd5NQviooA&oe=69B7F710"}, {"file_name": "migrated_image.png", "id": "214550833288288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_451589555589364_5962970372851630080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUVfF7fSczkQ7kNvwGjE7E7&_nc_oc=AdkJOrf7TezNkEM_aXoiGI4B513eRpGkOuBSz9KdrPEX4hsomGEcnTNIqMEisJ7D3AM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEID5CDYIfBAi5lXPaNGUUyi__HGOtXfN7BzCQ7__BfA&oe=69B81603"}, {"file_name": "migrated_image.png", "id": "550967269135255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974549_374619903264023_7889663886901641216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDEIc0zcTUgQ7kNvwE_9p_v&_nc_oc=AdlZS50E6qKyfEenYikCEsd6bcm27NcPTlU61WyYryYzCon4QOAAkiCLaG0VQ0IHoSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy0ibYcfOEtHyWk6w6Q2GuRs_48pGR5tgZ0eQxdMJWRQ&oe=69B80A22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sling TV", "keywords": ["TV", "sports", "shows", "television", "drama"], "long_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save. \n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime.\n\nOver 100 live channels available to stream instantly on all of your favorite devices. Watch your favorite live sports like the NFL & college football, hit TV shows like Fear the Walking Dead, Better Call Saul, SportsCenter, plus 10,000+ hours of on-demand tv shows and movies.\n\nWith Sling TV you can get both TV and Cloud DVR on your terms - add it when you want and choose when you watch, for just $5\n\nThis is TV on your terms. No paying for useless channels, no long-term contracts, no hidden fees, easy online cancellation.\n\nThe Sling Orange service offers 30 channels for just $25/mo \u2013 including ESPN, Disney Channel, AMC, TNT, TBS, CNN, A&E, History, and many more.", "short_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save.\n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime."}]}, "developer_name": "Sling TV, LLC", "developer_privacy_policy_url": "https://www.sling.com/offer-details/disclaimers/privacy-policy", "developer_terms_of_service_url": "https://www.sling.com/offer-details/disclaimers/terms-of-use", "publisher_name": "Sling TV, LLC", "support_website_url": null, "website_url": "https://www.sling.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "NEWS_AND_INFORMATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_EX"], "id": "2999589760304906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974567_293074828275778_7606580419168829440_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgy2oadmefAQ7kNvwGYwF-6&_nc_oc=AdmmldsEP0x0d2lbTGMGz6aBHTZZgzzEVT57XBkIcP3WdzrzGw8HsExm7ywKhhcyTA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
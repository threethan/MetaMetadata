lwCQMarV6rZdTmbCVXJzda1eo081XbmTn0zeb_fixsTYF-gRZhyRkCH0RLijWbYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvFYEcY3eKjomm8CX2OkkVYw8InS0DSSK6PsgidnMDiIQ&oe=699EEA90"}, {"file_name": "migrated_image.png", "id": "214550833288288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_451589555589364_5962970372851630080_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfOjlqc3JWAQ7kNvwHHdQpe&_nc_oc=Adn75m9uSEapSNsjKfI1MigKMGJRdKHTIGVdMgG30P2jo9r-rftSNeVeRs0u3Gm0394&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsVLoj7--AGOEai0l5Qf6KyQRZ8lQ-_HdPspT9StB8Vlw&oe=699F0983"}, {"file_name": "migrated_image.png", "id": "550967269135255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_374619903264023_7889663886901641216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM9X0KKL0jIQ7kNvwEbh9rE&_nc_oc=Adkp1SGnUN0FEdTKub-c8a9Xd7TftKhXH46vGIfS-cORwBrAEiKopjGnn5K9Yu8DJLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft9Mnw5pMc4ARSBDtI0tDCA99PGxfMc4iN2MO3FRgq0MA&oe=699EFDA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sling TV", "keywords": ["TV", "sports", "shows", "television", "drama"], "long_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save. \n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime.\n\nOver 100 live channels available to stream instantly on all of your favorite devices. Watch your favorite live sports like the NFL & college football, hit TV shows like Fear the Walking Dead, Better Call Saul, SportsCenter, plus 10,000+ hours of on-demand tv shows and movies.\n\nWith Sling TV you can get both TV and Cloud DVR on your terms - add it when you want and choose when you watch, for just $5\n\nThis is TV on your terms. No paying for useless channels, no long-term contracts, no hidden fees, easy online cancellation.\n\nThe Sling Orange service offers 30 channels for just $25/mo \u2013 including ESPN, Disney Channel, AMC, TNT, TBS, CNN, A&E, History, and many more.", "short_description": "Sling TV is live TV, only better. The #1 live TV streaming service that lets you personalize your channel lineup and save.\n\nStart with the service best for you, then pick Extras in your favorite genres: Sports, Comedy, Kids, News, Movies, Lifestyle, Spanish, & more. Change your service online anytime."}]}, "developer_name": "Sling TV, LLC", "developer_privacy_policy_url": "https://www.sling.com/offer-details/disclaimers/privacy-policy", "developer_terms_of_service_url": "https://www.sling.com/offer-details/disclaimers/terms-of-use", "publisher_name": "Sling TV, LLC", "support_website_url": null, "website_url": "https://www.sling.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "NEWS_AND_INFORMATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_EX"], "id": "2999589760304906"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_293074828275778_7606580419168829440_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27FR2kgBNiwQ7kNvwGxyzKC&_nc_oc=Adn8tjaJMs-oGWGg8IOPAV1YhjGLtCsgmCb5aQmhphTaO9pbbstnPYz-MvNpLW2jDO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5cn4eMVRlz_SRnuFyLfm9vNLmYTRqX67DDp4-Pjindw&oe=699ED458"}, "is_concept": false, "is_test": false, "is
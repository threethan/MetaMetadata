LUtgRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNRf2mV8kLI1E2Sv6OJgDkYNzBaEOJ3pmtZ6CDmtWB2A&oe=6A9020E5"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7RsyXZOxIgQ7kNvwFVIVFE&_nc_oc=AdodNwtahygiZlkpA6CjIhNOYsjW_KRmE-kSfpHHc1_nQroDDbum0u5ruCCnpbPqGqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLOUfhEnG9jMSIG1PgrIGQkUXWQmLPspt5mY7CZKuvgw&oe=6A900EA7"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4upAcGAfXhYQ7kNvwEBtRSb&_nc_oc=Ado1yP3MJjYKkTxHNNxqeHAAwiXUI6aRWH4Jp78wf7IlbCNKlshU8mbNuWRdtlheetQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwLlJm2AMK0YyYNhVNMgwIpxQLH-i8YUfuBg-Yr6WchA&oe=6A901286"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gDbNpVcvVQQ7kNvwEs53Dz&_nc_oc=AdpmPVWu0Tl6Bom9SsqbDsaa0dk0RPmhC7wYpQk5fJ1dBn-DyLSHLQLSeljS-ELDTVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElxPR1cjtVTI0Qp3hzHNMMSzvUAmwpN7xBKx3BkljDjw&oe=6A902D91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeZBzpMiJhUQ7kNvwHR_5Di&_nc_oc=AdrQsfFYhg3gmVSdkrev6KRUiMDY0a-7PWVDEQQQxFXBxMOmH5cef6kBcXFmX-zq8QU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOtBqkLFpYUL1w-VxrDteuSOjiS0tP0OJUag_rz3Y6ig&oe=6A902561"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
w&oe=699C3B65"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiROknFUR9wQ7kNvwEjE_-D&_nc_oc=AdlDvy5AlCscvDR5ZICDrmN3Kmw5CAz96g7NPU0x0SsAuXpmxd1cxiEIxDQR4q249vM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftVEv_haUBY3PBSlwME6RPOg70DK60wHS37AYvHddtSfw&oe=699C6167"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jE3Akgr4_8Q7kNvwGExeVg&_nc_oc=AdkMf_zvpCxocmZsz4Vm2ZvGr62LZC2gd5wluEvmkG8wyT8iqI7WvtQx_EFSFgNuDoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuI7KKe6Kx0z0OJ5SMOaBdSQYn40TJumzApaCQCdL1JDg&oe=699C6546"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVlwjr9bAycQ7kNvwHxC6dB&_nc_oc=AdmxfRwd10e69twdaoE1-6fIlb4x1O4apm3eqyS8i2t4HKqw5W43pB3-L3ffDte3g_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsSbGSvKdaqj7WOTJ3qGObQtw8p3wPuPlTEamS-S9Olew&oe=699C4811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XojLS529FZQQ7kNvwH14i7z&_nc_oc=Adk58wiZlulKIQBk3yTsUO6shhSfT-X1V8Td31_RxBgDz8C5dv-sFSpogAvsVxKWBeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2mOj5Wjf6YOrfnRPubuoNne3o7nzpLFpAj3I6LKj32A&oe=699C3FE1"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
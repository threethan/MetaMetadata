Q&oe=69A2D2E5"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yunftp9Hb-wQ7kNvwHHkEWy&_nc_oc=AdkUL8QGnQ65hi7AhPP_M0GZVaPf-e95iiStrsTOpIY7ecY6fk_5g_z7HqZiou50Vkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsmn5k4TrFsvKWIrBml_EQYF5hkp_a_upJiZijQfFvJ8Q&oe=69A2F8E7"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75fXNsqQ0dUQ7kNvwFXmQul&_nc_oc=Adng4Uxzej1k9OJHSjSu0hTs1A5fUkI-sl45th2GTcvaTRXzDvfSjSePI9X-jc2kT40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVmfvjrfLtD1lTyISavmSF9_WaPr8EzegXn1iNwIOGUQ&oe=69A2FCC6"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEpn2N9Zp9gQ7kNvwHjPZef&_nc_oc=AdkvgzOnKZWUFOKpzUf909FQ_nNYixV9ezRuydNDpQnf6Hh38IX5rR12TKnQ8KkWE5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsj2YqYeya0qbPZH4-nK12bWZR1DCEC4AT9ndbq54dHgA&oe=69A2DF91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29xYUCBINOoQ7kNvwHIJlSn&_nc_oc=AdkhODGHj18KYbjXbdu7vDmna-pGz90WrLTeI2Z9UZfFq2aJnvnAreYqNhb2W0PhPu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUoRbGPQL_Pa8bnUf7DrheO3zoulWYTsNhDJtHyidQLw&oe=69A2D761"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
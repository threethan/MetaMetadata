B4tPzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt1_OYBbxzJ4rT6pwOZi_Nx2j0CnDfRVMJ7IrnMsCTRA&oe=6A6CC0A5"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUbqV_fS_OAQ7kNvwGns0s7&_nc_oc=AdoHUYiCIyjo_O86KUNs8oIC8ENWORT-TO74sGu6_UpfgT8S9lps1YvXZfpZsVnYB2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWICxAHHgeT6b0f1fNIwEC960zKsAYR9b7LtkmIkqAAw&oe=6A6CAE67"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZSx8cq8mzwQ7kNvwG18xDV&_nc_oc=AdrZymsvm9Lv-pdSo0DJrXYiu9Zxl1DyYstejtRNEnNw0RD3Hxq8uzSoSD5X_B0H61c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDndVFm8i4WWR4cg9KsnET_cbyU0a03Lq8AzCEi_JTkFw&oe=6A6CB246"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wj6sSoSdkIQ7kNvwH207iw&_nc_oc=AdrAZk9KRQsb8jrtPxrDkzcLauuh11R1QT6BzOBtrhV0PYGdZrhZDCPjvk2vrHznsbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCFsxFE9WN6LHUfWiUQ6VjpG8V8nNwuDIj3Nr3ZN2BPg&oe=6A6C9511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0uWngEUN-IQ7kNvwGu6CEd&_nc_oc=AdrnyupdLxkKAkBG5FaeWVHPjtOktEIy4EQ-ocPtoKBTuQGhvNzfOQOzC51APs30T_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcxOpSJeL2elG2po7x0gSkidXT3HuRmlnLW9FzfcDFcQ&oe=6A6C8CE1"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
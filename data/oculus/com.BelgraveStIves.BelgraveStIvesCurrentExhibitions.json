FY7O_c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84iEZLvriFsUeLBsGXwmWl3ghGaXXkW4yOJdqmObJZVA&oe=6A3D4AA5"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljbY_krg5j4Q7kNvwGFWt3D&_nc_oc=AdrqCCvNrE7M2e-HrUo6Qyt_ybuBmJVXUjqy7G9DcnXqWKWJKGLNLKzpqmigONB7xYU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86ZaaKJkPS_zHnESQgXAu1VYG8BdZl4dNe2qa4BRQOJQ&oe=6A3D3867"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGHzVpUK_1QQ7kNvwGQ_uuy&_nc_oc=AdrjKsyTpH1rBNLTxWTdeMuQuoExwOfYcuzcjZbFMoBZ4cX9w7ElAsis_0rden_Als4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eXTA3Y06xkYC3Pb9KF3rJ9Lunk9HAh-tDB6C-ikAMew&oe=6A3D3C46"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmNUz_kRj2sQ7kNvwG0mcDm&_nc_oc=Adrf8AoYBUHHk0v-10tHotQribNBCx1MemF9MCXT-3XNnm9T8pU1pRqGkHnNC2fluAk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F1kDZrFz5UcytadwESHykZAEKA8TIuPY1leJtOredwA&oe=6A3D5751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrplhOR61GEQ7kNvwH7GsNu&_nc_oc=AdozgeXf11N9ujnpoCUIUsT5ig3QBMkCKOVqdEPcVehU64SpJFXgU5Vi6NdH2L0cEwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aVMka-PS2Ip8mFYYZ4q8ij1ss1fYf6ujBRxgY3a_r7w&oe=6A3D4F21"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
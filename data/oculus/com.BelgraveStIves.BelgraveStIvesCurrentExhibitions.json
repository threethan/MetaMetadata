7fJLlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA6vPqfhfvLeAsxC8y0fi4JLcKiqrVjmGMIjm2G1dTGg&oe=6AF72E25"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuBVRTh6XNsQ7kNvwHZw-mK&_nc_oc=Adqz4Clo3IekZ6TLhZd30BUGTghtN6f27rjD_c9cJI5y-01IRid3BUMqP3Gla7IRtFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIJGDFIBoR52zbAeb53XiK9vOCby8PFw7jhINbRiwwMg&oe=6AF71BE7"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXCtuO5ZisoQ7kNvwEx5ffo&_nc_oc=AdpxzWf3sHVVNlcGJ1TA7iA3sQ6NJtHIGr98I9YLgualmi5IH13AtqmYT8OMC5pdyPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_vWuiJYGdmZ3eGLR8wXOdMMxCKIUsH8ZJ-ltJY9dTBw&oe=6AF71FC6"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eDOr0BByYIQ7kNvwE9y6OS&_nc_oc=AdqemsXQQacOmgKNUk_SBQizFq_-peAM-uf-Vwz-rQ9Exi4BM6YF0V9SRvr85IfDiWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfBTEDv8eYD6xXOwMFW92VkmNkPcoNypYR1vSdxoi8Xw&oe=6AF73AD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2bLK-R-mwQQ7kNvwEpDe-d&_nc_oc=AdobZ6Fhnz9Nw3DzNOh166goZ1oW27NwKKE6a5Evq41DaUUtp3whToG6sgiTB64oN40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQai49boT4BMRo7b1k7wkdSgKgiLDMowevqnolEu5BnpA&oe=6AF732A1"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
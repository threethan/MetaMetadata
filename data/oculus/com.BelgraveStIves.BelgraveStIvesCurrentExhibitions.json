TrKisQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65zbhN8xT10MLwW9rca259UTaXRieH6GE5LmQm9g5tXQ&oe=6A1B03A5"}, {"file_name": "Gallery 1 -2560x1440px.png", "id": "325103103004835", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982552_325103106338168_8242998297074154514_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr2uI9nUyUkQ7kNvwGMzJsj&_nc_oc=AdoWKIO9ADJODob741FnJmGKML80Rexm0qxeUTht2AvtuX-N7XdMFFfQBHP7OWd1A8I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eNANcWrsO_rh8AaKzMLp5JUgRpHxRovEM5XqMynYzPw&oe=6A1AF167"}, {"file_name": "Gallery 2 - 2560x1440px.png", "id": "714012749816534", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974666_714012753149867_7610495835160463778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csBPYw_9GFcQ7kNvwEO0xs4&_nc_oc=Adq9W7u-SXM3MZ4LKSR_FgkSTHU7iBIrZqaP4o_u56E0soLE-REn_tjw4i5TRRNv1Ro&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aR_1j3-CqPInr8ZuSHfaAlk1yMfMH4LhmGkfMUdqbSg&oe=6A1AF546"}, {"file_name": "Gallery 2 - Pan shot - 2560x1440px.png", "id": "1077390123161145", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031309_1077390126494478_536309961900728809_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEoOqXh1fCYQ7kNvwFv7OIr&_nc_oc=Adp34VQYgP_2vZ9k4SHu6ltssu0FbLHTlw9q6r89SfOru3vvMkD1eb_-eXaJOY3WpvQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JuGVDR4jcs2MuvSU7MDKPsEVHNoAigtApWiPvelrzkw&oe=6A1AD811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarrisCoverArt_Landscape_2560px_1440px.png", "id": "439407404353784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003261_439407407687117_4137811950026480009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkhCALQVG80Q7kNvwEMQMrg&_nc_oc=AdqPcRAp6RFX4ZBI769SwGqF-Ra3KsNP3UEZTS0NrKK_bducxSa0oDNOsZveVl1zfX4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rBtWnRYJRI1D9_YEogOXMX-zNdIAYy0v9eBbVmjIHbw&oe=6A1B0821"}, "display_name": "Belgrave St Ives Current Exhibitions", "keywords": [], "long_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" showing in Galleries 1 and 3.\nA retrospective exhibition of work by painter and printmaker Jeffrey Harris. Born in 1932, Harris studied at Leeds College of Art before moving to St Ives in 1956, where he shared Porthmeor Studio 7 with Tasmanian artist Gwen Leitch. Gwen and Jeffrey worked from the studio for 15 years before emigrating to Australia in 1970 where, now approaching 90, he continues a daily art practice. Long overdue for reappraisal, Harris's expressive oil paintings, subtle reliefs and carefully observed etchings of St Ives return to the town in a show not to be missed.\n\nA selection of \"St Ives and Modern British\" works will be on display in Gallery 2.\n", "short_description": "Belgrave St Ives (Modern and Contemporary Art Gallery) virtual exhibition of selected physical art works from Belgrave's current exhibitions.\n\nCurrent exhibition \"Jeffrey Harris Paintings and Prints from Cornwall and Australia 1968 - 2022\" in Galleries 1 and 3, with a selection of \"St Ives and Modern British\" works in Gallery 2."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-bsi", "developer_terms_of_service_url": null, "publisher_name": "Belgrave St Ives", "support_website_url": null, "website_url": "https://www.belgravestives.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
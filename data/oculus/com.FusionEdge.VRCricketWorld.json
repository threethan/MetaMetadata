KB5scHKMDDu_FLQ&oe=69E0F2FC"}, {"file_name": "ss.png", "id": "832782259747896", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_832782263081229_5339215664793244967_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4Ck2NMfEJwQ7kNvwHszG35&_nc_oc=AdrAr7crAJ4Cax4SsEAI6v1JJ9SMYdjGQFzWhSd9fCfSOXkFKfQVHm_bpznrrtSVMDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IKffoNqakyyocao61PLn5fe93MCSX1hNwu92Bn00rFQ&oe=69E0EF5B"}, {"file_name": "ss (4).png", "id": "2882858985258380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_2882858988591713_829135218938515427_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i7pajZCS4QQ7kNvwER685I&_nc_oc=Adp5m6TnKJibwNzIdhmE48Ys1OgY_PBl2WGDn5if-4x0Y8yARDozH3dq9v0zl2X9F10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37c7KwYuNZPEfUddu8WO_dlEyqWwFGLMbVehMW6yyTkA&oe=69E0C9A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Cricket Pro: Ultimate challenges 2026", "keywords": ["Cricket", "Challenges", "Batting", "VR", "Immersive"], "long_description": "VR Cricket Pro: Ultimate Challenges 2026\n\nStep into the crease and experience cricket in virtual reality.\n\nVR Cricket Pro: Ultimate Challenges 2026 is a VR cricket experience focused on skill-based gameplay, designed specifically for VR headsets. The game places you inside the stadium, giving you direct control over batting actions.\n\nPlay Cricket in Virtual Reality\n\nThe game emphasizes player interaction and presence, letting you experience cricket from a first-person perspective rather than through traditional button-based controls.\n\nDesigned for VR\n\nBuilt specifically for VR interaction\nFirst-person batting experience\nOptimized for Meta Quest headsets\n\nWhether you are a cricket fan looking to experience the sport in VR or a player seeking skill-based challenges, VR Cricket Pro: Ultimate Challenges 2026 offers an immersive way to step onto the pitch and test your abilities in virtual cricket.", "short_description": "With intuitive controls and interactive gameplay, you can focus purely on mastering your batting technique, improving timing, and chasing high scores. Compete with friends, track your personal bests, and rise up the leaderboards to prove your dominance. This is offering unmatched realism, precision, and entertainment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fusionedgegames.com/privacy-policy-metavrcricket.html", "developer_terms_of_service_url": null, "publisher_name": "Muhammad Talha Nasir", "support_website_url": null, "website_url": "https://fusionedgegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26471582415764442"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1462425522170550"}, {"status": "PUBLISHED", "id": "1549738812772991"}, {"status": "PUBLISHED", "id": "1526793481917483"}]}, "baseline_offer": {"id": "1526793481917483"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773082800, "status": "PUBLISHED", "id": "1462425522170550"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26463184376604246", "version": "0.3"}, "id": "835589509272160", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries
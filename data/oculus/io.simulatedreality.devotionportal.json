6e7a0a&_nc_ohc=4WoMhnEYWHAQ7kNvwFhF1B0&_nc_oc=AdqLHoALS_szJhrNoj_U7TZ7golXF4tSIYZ1hcrvx08RtKLGu8wNuHSVXy17MtCVZ6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0PK5DZFDV-rQ0gUyeqbYTTkiIIYAERiKdRWwUwWvd-Q&oe=6B05BE04"}, {"file_name": "screenshot-5.png", "id": "8793089194103374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982679_8793089200770040_7301813246085288225_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnKHe3mG_t4Q7kNvwGgJv5D&_nc_oc=Adovt30wBLGZFxTsANHy0qcUNALhrPWSeyDTPD4l6qHARdSZjZBKewmsyUHZteoAOSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbi2Awwe1tTD4NEcmefHxX2TrB_zWCMXOU9H00uqm_4w&oe=6B05C26D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DEVOTION PORTAL", "keywords": [], "long_description": "Devotion Portal: A Journey to the World's Most Sacred and Inspiring Places\n\nGet ready for a unique experience that combines spirituality, technology, and emotion. Devotion Portal is a multi-platform app, allowing you to access it from anywhere. It\u2019s your passport to guided tours of the most sacred places on the planet, immersing you in atmospheres of faith and mystery.\n\nDiscover the serenity of the Sanctuary of Our Lady of Lourdes and experience the spiritual energy that draws millions of pilgrims every year. Explore the majestic Sanctuary of Our Lady of Guadalupe and the vibrant devotion of Aparecida. And it doesn\u2019t stop there: with Devotion Portal, you\u2019ll be at the heart of the most remarkable moments in sacred history.\n\nExperience the film 7 Miracles of Jesus in a 360-degree immersion like never before. Feel present in every scene, living moments of faith and wonder as if you were there.\n\nTravel to the sacred city of Jerusalem and uncover its ancient secrets. Immerse yourself in its culture, rituals, and the devotion of its people in an environment filled with mystery and meaning.\n\nCultural and Spiritual Immersion\nAn epic collection of spiritual and cultural moments you can explore with incredible detail. All this is made possible with cutting-edge technology that transforms each visit into an unforgettable journey.", "short_description": "Devotion Portal: Your passport to sacred destinations, diving into faith and mystery with cutting-edge technology for unforgettable experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simulatedreality.io/devotionportal-privacy", "developer_terms_of_service_url": null, "publisher_name": "Simulated Reality", "support_website_url": null, "website_url": "https://www.simulatedreality.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8481810408595520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1995584024232063"}]}, "baseline_offer": {"id": "1995584024232063"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736451480, "status": "PUBLISHED", "id": "1995584024232063"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24557987243884580", "version": "1.2.1009"}, "id": "475037388801504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typena
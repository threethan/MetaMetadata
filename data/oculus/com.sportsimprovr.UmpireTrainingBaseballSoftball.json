C6"}, {"file_name": "SlowpitchHomeplateFromSlot.png", "id": "450568113031669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556803_450568116365002_978325448333690175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bDWO-E13l4Q7kNvwFkgE0e&_nc_oc=AdruS8y2_OIVDBsD5TNnccwBf6GtsMj-s-3XLJ0PK3ACr93epxC2_zCgh-f4KF-i4sM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoTS-C0ZNBhafmvA53eq6IcdnNt45F3hEMEBQgCuGEzQ&oe=6AB27C5A"}, {"file_name": "SoftballFirstBaseSafe.png", "id": "1690565424482868", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_1690565431149534_330151894391608105_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlSobSjDj-wQ7kNvwFRA_kE&_nc_oc=Adp1nCLv6_4EJ1NTd_CtGrAAWoRGIQd9qM5UGtugyZCTUqEnBxPnD2ryo63W7WgNMmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgN7L7yUe1NUbLkdbH0U8st6CuacoU-iVKCvzoMXagbA&oe=6AB27015"}, {"file_name": "BaseballFirstBaseOut.png", "id": "424431458818269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569471_424431462151602_8019044293190999348_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36kXaT6xBTsQ7kNvwF42iLX&_nc_oc=AdpdLM75of1KyMfaNdWAHwAqN-oErRDF_C2gOfv61yZ7VscaGcez23HZHw3esHOkSOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCLMBXCQJIebRgDmWxwwRBpA_UYB0sS5u5AOEEHaiRZw&oe=6AB28316"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Umpire Training Baseball Softball Slowpitch", "keywords": [], "long_description": "This Umpire training helps you work on calls at home plate and at first base. More situations are in the roadmap. The training is available for baseball, fastpitch softball and slowpitch softball.\nAt home plate you can select the pitch speed (or height for slowpitch), the location, variations, spin and wind. And you can select if you want feedback directly during the pitch or afterwards.\nAt first base you can practice close calls or work in a game-like context where the system determines the timing. After the call you can replay the action to see if you made the right call.", "short_description": "Practice your umpire skills at home plate or at first base"}]}, "developer_name": "SportsImproVR", "developer_privacy_policy_url": "https://www.vrbeelding.nl/PrivacyPolicySportsImproVR.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8105576332807027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75572660_1015122609017435_4100744274224948835_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J3PWp9b_5AQ7kNvwH8MD12&_nc_oc=AdpW-JFxeYyYRZ1Yxo0xtHezhkSFgE65I9i9UQbezY4sE-lPsqwuzTp7JhEAdJyub0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOLe7bvXL4ewZQ5Hw-V7d8IxqHMCHPrP4pr7ZO2eAt5g&oe=6AB29CC6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umpire Training Baseball Softball Slowpitch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1661208228, "lastRevision": {"nodes": [{"id": "3775
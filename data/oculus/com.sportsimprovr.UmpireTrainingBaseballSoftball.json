06"}, {"file_name": "SlowpitchHomeplateFromSlot.png", "id": "450568113031669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556803_450568116365002_978325448333690175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwSWGakAwD4Q7kNvwFWCbTd&_nc_oc=Adq2rRNG8Jl6uU41KsqpgLDkuXa5JIouj4vuHl6uKpoPdYUNyG0CGr-mWvTGHlB6EIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMpg-Z9j-0EwG6BtWTP3632jZYjLUw6MxOQDCXBOkhoA&oe=6A95B39A"}, {"file_name": "SoftballFirstBaseSafe.png", "id": "1690565424482868", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_1690565431149534_330151894391608105_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5uyNT4j_YAQ7kNvwGgkzNV&_nc_oc=AdowGKo6wyRs5XSZblOQ-GUfau6RVxe0oq_i3EmBxrG2bMYHn5ewJUhBYjXT07x5tpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlgvx4QEGx28v_Lvu_Mr7lhcHqdlFCAdA4odmFdGbTQQ&oe=6A95DF95"}, {"file_name": "BaseballFirstBaseOut.png", "id": "424431458818269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569471_424431462151602_8019044293190999348_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWmTwAZhaJ4Q7kNvwEN2Gjs&_nc_oc=AdrRXDAQg4vGXRW_uUzw5P9rH0nbeFit6iCOgo3qdEOYKJB6GaywVYQuwlT0rsWSdPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFCJnHZ0zmO5Wb4xdtDUVOSBh6TF_pevCwoB4dj0xXYA&oe=6A95BA56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Umpire Training Baseball Softball Slowpitch", "keywords": [], "long_description": "This Umpire training helps you work on calls at home plate and at first base. More situations are in the roadmap. The training is available for baseball, fastpitch softball and slowpitch softball.\nAt home plate you can select the pitch speed (or height for slowpitch), the location, variations, spin and wind. And you can select if you want feedback directly during the pitch or afterwards.\nAt first base you can practice close calls or work in a game-like context where the system determines the timing. After the call you can replay the action to see if you made the right call.", "short_description": "Practice your umpire skills at home plate or at first base"}]}, "developer_name": "SportsImproVR", "developer_privacy_policy_url": "https://www.vrbeelding.nl/PrivacyPolicySportsImproVR.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8105576332807027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572660_1015122609017435_4100744274224948835_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMRQwrQgeGMQ7kNvwErUyQq&_nc_oc=AdpaM6s7PCaF4Qlqubp_sxZhQiGgxtoVdjkg6QQmzJ24Ns3juzNopPN_o2GJWCpQCc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2YcZsMzM77NPg-Icw2Z29NBZi43bPkuGmQG762Glolg&oe=6A95D406"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umpire Training Baseball Softball Slowpitch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1661208228, "lastRevision": {"nodes": [{"id": "3775
C6"}, {"file_name": "SlowpitchHomeplateFromSlot.png", "id": "450568113031669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556803_450568116365002_978325448333690175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bDWO-E13l4Q7kNvwGcUwie&_nc_oc=AdoswtKcdM_cZ7FLUaOfdwfSdL9F_I3ZknVpNDYvmW79X1Hv_9VVG0sQf6rnxUMObIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-tmakh2Ebem_lerRs8Mo8ffP2a5VFjeHapqSW6j9RfA&oe=6AB51F5A"}, {"file_name": "SoftballFirstBaseSafe.png", "id": "1690565424482868", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036632_1690565431149534_330151894391608105_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edEoVbeXuewQ7kNvwHL8b-3&_nc_oc=AdrjrDZvc_Zm1MG78PIFlcX_97pJHtp7q2EGWLsDaIdHdPHiUVxCkqECDe_YuBIKlcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwEXqknsqVl2y2G2I2B9W9iguV_vFnWj5WL21oojpUhw&oe=6AB54B55"}, {"file_name": "BaseballFirstBaseOut.png", "id": "424431458818269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_424431462151602_8019044293190999348_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geAPfz7xZqQQ7kNvwH2JHwh&_nc_oc=AdrLW4hagQqQnmapADQJTQw0BEx4EqHy1SBwrq5wHnX1yDdtaUS4McL_T8BwKiSyGNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtp-7uKF7ENW9T5_YVcAYRJkEa6IkYhU8In6xwNNicjA&oe=6AB52616"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Umpire Training Baseball Softball Slowpitch", "keywords": [], "long_description": "This Umpire training helps you work on calls at home plate and at first base. More situations are in the roadmap. The training is available for baseball, fastpitch softball and slowpitch softball.\nAt home plate you can select the pitch speed (or height for slowpitch), the location, variations, spin and wind. And you can select if you want feedback directly during the pitch or afterwards.\nAt first base you can practice close calls or work in a game-like context where the system determines the timing. After the call you can replay the action to see if you made the right call.", "short_description": "Practice your umpire skills at home plate or at first base"}]}, "developer_name": "SportsImproVR", "developer_privacy_policy_url": "https://www.vrbeelding.nl/PrivacyPolicySportsImproVR.html", "developer_terms_of_service_url": null, "publisher_name": "SportsImproVR", "support_website_url": null, "website_url": "https://www.sportsimprovr.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8105576332807027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572660_1015122609017435_4100744274224948835_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=645auvJZnrEQ7kNvwHGiUeF&_nc_oc=AdraCP6KMAAaRbAMnJoSG1F9wOiaedOuNd5yqEuhSd1itrvql3a5wxoqEVkuYhBdPuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEdaTfl9dP3UUrduYw23e2Clk0McFO4Izk3rYetaLlAA&oe=6AB53FC6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Umpire Training Baseball Softball Slowpitch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1661208228, "lastRevision": {"nodes": [{"id": "3775
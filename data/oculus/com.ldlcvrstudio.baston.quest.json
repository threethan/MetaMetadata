.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVZQ95BuMb0Q7kNvwGLmk_d&_nc_oc=AdoDnDoYe416-_UG7fBy9dnf-owGErUbcshGKMW4D1BS7nUtjhKyBtGfD6ybU5kIijI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBzYrkADKPSaFcLT11Qu8k7f56Rd6TI9BWgkHvtaNAtg&oe=6AE9F181"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEdA3dDHMF8Q7kNvwGpO67r&_nc_oc=AdplRA7810lCKyEALtukzByYiz8DJHRbifZnrGpfXqvNZ0xIBRiEDlBAg4Apkv1aaNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZNjlFu_yHy4iECiqZvNsZPzEmC3pf2GmHReO4sklhNw&oe=6AE9ED16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdC3pKRjSv8Q7kNvwFfuBNG&_nc_oc=Adoxm5UhZSJMMW5KsSDcTBMzjcCe9_ksEMJsn4V1lGhDgUOBlgs8NpgLlTocfyFsSV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnGRuN5qHwwTcF4n_y3HKku2JfG2lLABlLUlbztjwiVQ&oe=6AEA10BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tgT024su1gQ7kNvwHvGfSt&_nc_oc=AdovB7nhHxP2Wu4RD-1a8O0XSLHfgGE2Rq4zGdN4elnZiWVXXEPP5wPkcxg_i9TsbGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkLOvsKe06I5-hHXVxy0DYyIOOdcr3l1S4PUQt6S2xWw&oe=6AE9EDE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DSM742Ph9wQ7kNvwHuKzsx&_nc_oc=AdqLEy7viez0d2z0xDMFqxqy0PDeXhawAFneps-ByxLt0XXbd3JgKFHdr6DSlnObrps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbxyJ9LpYesC1_kE1KOZZMnpaX8cC-y-S8kIVaT42j1g&oe=6AE9ED3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C66ndQnXuu8Q7kNvwH4eIpq&_nc_oc=AdognYhiIW6Xp5-fTr2Imo0Y1mJI548OXsFw9qSAbu2kGXGoS-iw
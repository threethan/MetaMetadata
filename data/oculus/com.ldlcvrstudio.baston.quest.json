.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbzhWxMkFgQQ7kNvwFpu8aO&_nc_oc=AdovzfxA95O9GEBi9wfacujQF3oCfHXwHBdIYHSCTg0-Lc4emINwCFXj8l77pihKSRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5avlOunAKU_zXEcQPhWMtkEQXoR7nBbbSKTLhyCLUrnQ&oe=69FA0081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhmOPvJ6LGEQ7kNvwHv4xe_&_nc_oc=Adp-64069PGlIFW0hm3a9YkjtNnv_hDmLojmAD8HvjGd7X9zK1Lv2GwKOBRyV4u_yKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cIjaPdi5RXQT8aC-dfrAc1Dd0OsnWYmKAmJL5IR1LXQ&oe=69F9FC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZHPFQYT5lMQ7kNvwEBuQu7&_nc_oc=AdqNIUP29_nRSgFqcMou9LTLlrwD8VkjzBhkoPZ6yiAv--SkRa3cFvYEmI5C4Hj_eTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mPmjMC_hdVNWcvjGzf2XBUpt1ej7sAE-DDDmTgSk6Jw&oe=69F9E77D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQRPLueWH7EQ7kNvwGFED9a&_nc_oc=Adrnh-XplIPQEAGxNiaqeqQkzJ1VbLo-rvsE7BK_5FyNp9bQWp4tozyb9QwvIQCh2ek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Liyb4EblEFtqL_kgFz6C88pTirw53FPMg--SCO7Lcxg&oe=69F9FCE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q3RIU6wam0Q7kNvwFwLBJL&_nc_oc=AdptTsOKsb1qN3ibsO6qak_LuFbfqKlKhOsvuBT9_hKtHtwA9dvU_OtkdVwAJVmD8YI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-S0Sy57vL9wGFjAyn-NUk9ibnNyU2FRM0hNQEfxbcCg&oe=69F9FC3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP_DHbXeS58Q7kNvwFBfBse&_nc_oc=AdrKz5r_e-jhelA19A_n_-F5_xA4DUrr0KEiBIEJ2pLB3Oq0I0sd
388_6932010296335491220_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkU3bC9Cyr0Q7kNvwFlGe-F&_nc_oc=AdrAMLPxd912NbeIKwkivvxDrohyZOEk0Qc0JGwQDVtyIeEfCBhXzdjOUO1dvXQ8zwA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj9BegaGEZ7SN1S85vYmjdKBMQm3DbBbTjnGwMhkW-bQ&oe=6B0B1D31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wZkwxrobHYQ7kNvwGy-Ko5&_nc_oc=AdovGqbWJbC_2TefFHnjYybwa_dxNd7kvsK5bS64wUU-V9iVHuBCTj3y6AHVNMmPvLs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGcaBkQXr8mFBA_2kAaPGUS0hnhG4k-QgTm9JcU8gjRg&oe=6B0B3D25"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr4wc-xbyVoQ7kNvwFsZhJl&_nc_oc=Adr_MDkWoAs4MMdWrUMnOubHleYyuk6D_wdVBhJ86TO9QRjDCBcJIQWVLB--whI44dM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaxSm0OGvjtxKKqUxUNPRkUZ7XFikuQrbhRcjQ26f6MQ&oe=6B0B3A85"}, {"file_name": "CoverImageSafeAreaTemplateSquare copie.png", "id": "1880433679219419", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821796_1880433682552752_1980421045084427771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWh3weON60cQ7kNvwG4NXn-&_nc_oc=AdqfrOmzKNmaECw4Glt3KunM4kXdad7Sk2NXBahddFkj3EeSzicNS6L3Hf_AhMefvYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4BBDGBp4nCgxJ08Fi9Mk7eLYCgRXpuHtM7ynwSSz1og&oe=6B0B294E"}, {"file_name": "NHBK_Logo_H1440.png", "id": "1660891154542652", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819944_1660891157875985_4872676651041472123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmJMdhq23HIQ7kNvwHj9B-e&_nc_oc=AdqqZNMCgEJS2wX3JqbuivCFNm4tmyOtduqDxi4zWmEsSCpYyTzYX2hLXJDEHqqYObk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5spaRA-tYM_5biy3elIZ5OPp9fS2Yh5a6cpH58A01AA&oe=6B0B3A5C"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1417701233407141", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823270_1417701236740474_8916931527861982871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-
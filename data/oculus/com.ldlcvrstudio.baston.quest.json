t-atl3-1.oculuscdn.com/v/t64.5771-25/491820855_822137817339573_7229760179140916545_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swnWhAxu6vsQ7kNvwFU7nnj&_nc_oc=AdrucQOlAPWx_XjTl7cSq6-Arp_a-auoJVJWHU8to-a5ZmDMqliYWu06nAA0pjInsWI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkHl7e-JV64kLESrTuClgeNsgMg594AyTtjdkLK3_uEQ&oe=69CFC08F"}, {"file_name": "Screenshot_25.png", "id": "722112044246292", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9_79ykZeWgQ7kNvwEa-OxK&_nc_oc=AdrqCzbt1-CV1R5q0_CPGIfR0BAU55iHCpkGHgAqkH4ZbQEHzsIdBcSqBCZcVBl0vPQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx47lv5Dggpe3Odf_I1iIv_BqNDZX81s-qeJga54OdfBA&oe=69CF9E3A"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UggbJfe5srAQ7kNvwGvU4_h&_nc_oc=Adq9x0ERH2PI-60WcSLE40no8TiLh7S2w7o1ESekAUiD4MWn0MgGd4ylIsLDrqmZ8o8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvG-r080g0HE7Yu6t4GjAyFxLwgFTTqTrLhhcwhtTQTg&oe=69CFBAAA"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Y9e36P1FdR8Q7kNvwE3XJGO&_nc_oc=AdoCS0OEbfvYVMxZcR5MZGLAwjMBOYBRhdL1rXUNy2GSKheuU511F9ZGPy1ooxXjOog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi766zNeJC_y96qhISOlc56hs4vKCVKfIjdx1IpEuQlA&oe=69CFA202"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvmUj_PDsh4Q7kNvwHvtdvt&_nc_oc=AdrjMnW_LZM8-chKs6r5MPAYZRhOi2ApeZbeTU-J7Q37cJcAv2GKmC0P5a7DS1rTXhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbEv9a-acCckhR-A4MuOShkdWglYSN80LLHsugTWgiAA&oe=69CFCE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0sEkEsV2TEQ7kNvwEGpxGv&_nc_oc=Adr0r82cugj73a7rj-PKsd58LPySTG1pggWyMnSzH58qshQrQi2b-z8mIoofnnCUNxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYHVEf4aGjOT_yWHjWlMCwJJ5w-AuV31KOwcfa_xpVig&oe=69CFB625"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "318330666520
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqoaYds2GbEQ7kNvwHVfdPv&_nc_oc=AdrjD5TqW-39J6HOszgWrtiXz4P_-tGSYzzFkn8Z8xJ8BjT6fDBNEdvoBG64JjXE1K0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMNRO26SE50gHdth3R6PYD-G8lud2qm0Fiic1-EIHLrA&oe=6AF9C381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTi9gobPmVUQ7kNvwEBvklD&_nc_oc=Adqb-OK2ONydoYdJ-bzdC_gdFrZp5I-JxWkOBU39iunrtk-blUbgYThIXU0KxN42BBo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV8-Y5zM95MOxnvD_IVxJuEPysiZLfabfYaitSRLqv6Q&oe=6AF9BF16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUN8-Rvc1JMQ7kNvwF4E6iH&_nc_oc=Adq3OUF8ndaqi6NnidqODD5RKF2hrI33Zi2CIHzw1uJPLofXZZt1Za6Byze-vhTwSSQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxOHEaBD6ANXikh0O7MRBoZNdt7ULMiQEy4s2hUx-62w&oe=6AF9E2BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTfbuhTwt0UQ7kNvwG_yLs9&_nc_oc=AdoilVGVP8Laocac1HBhF3tWFssMCClmwWt_jUnr-YTBpMLnE7gHOZEqZ1TJwXqtBk4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-nt6BDXG66QbTZeS20vDc6srvXfz9wF5JPQmD-DGrjQ&oe=6AF9BFE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzlw2PG63fwQ7kNvwGN7zgA&_nc_oc=Adr01WKhu1TUQ5_tNowe8AnE7Wee7n5KmS-uCmkQJIDbP6pEAzIoYhHEaWt1iCGCFX8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6cvWDwFCixuXjIxZECcCsKOG2NIDhGXwzwTkaWWXhJA&oe=6AF9BF3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA12SYF6dagQ7kNvwG7FUnO&_nc_oc=AdrqHWeXJM73esTqIpBfljW48SFiB06VpbKtsVke5XMhQIigvguW
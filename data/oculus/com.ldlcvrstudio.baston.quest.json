.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdwOznL-IIQ7kNvwF6fcQt&_nc_oc=AdpWPFrWlS1SK8G_0XfXNojstlMQ4Pa_ynGZiiwydAEaNs8wqSEU_dK7l9V9utxoTbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEckKvaqewBDuTSFsbiP7JYgmndZ9zhz12G3f39AwF6A&oe=6ABA7B81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77HLv-Ob8X0Q7kNvwFfNg73&_nc_oc=AdpELrYZTuAUnkDmO5ZuayA4cSapxSkGNXvPU-okpjPftbT53R2_wOnyCKL0ZDoMh5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE6_92g9CfQactV-uWleP-SnQG7BPlYT9FnhYpBp05VQ&oe=6ABA7716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzO-TshToOsQ7kNvwFlv39K&_nc_oc=Adpu6IHrDUUMCF8hFaUNUGDzKn2SVLWJpG7ZyWW5qEGzSJ5mw6tDZiusxXCpQJ7nwNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhCEKzju9amKAicOkuYh3E8EJKa8N7KVGHx6Av3F4UQA&oe=6ABA627D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRNkmhqtuk0Q7kNvwEwvmml&_nc_oc=Adr4uej00i-tfNPGb8vsKE80M8oYlzEP9wTazT2uKTUpD-wbHJZB8PvYXhVNx-LMv0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdBHt_938LHDyBXnR0yVdSREd0mdFZMH-6ugKrWINOTQ&oe=6ABA77E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6XsZJ0SNGYQ7kNvwG9BdZJ&_nc_oc=Adqe8zIXGeWO-Wpo120AOuOPbizlfxa85DDzPPyluAqT9CCWTvCvHycwXbiXZx5_QYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf-NSQQQXHoa4KnOkcdJhSNNiTNLQgkJy7ppmB00__kQ&oe=6ABA773C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DuW7v0iI58Q7kNvwG3Qk3V&_nc_oc=Adr9HeOus9mNr7Fy5WGqxQcPgy9ikktFhwLycchSZWCWDSFodS2D
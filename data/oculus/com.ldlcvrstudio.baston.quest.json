content-lhr6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CKDKHITPsgQ7kNvwEYWQpr&_nc_oc=AdrxGEc4qkcawyoBJM1mYAR3swNCk5ciVDGpLOrD6Quzg21zF1g8FNRcFSOymFVxjqA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExG7KAzVA4a0xqrz3IBN35L2gA7EVUHAdepU445mF4gQ&oe=6A8EFA01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR-pdyfkP-AQ7kNvwHtbpBN&_nc_oc=AdqhA-3wJ5hoIg3hsaxeUJWPvALKK4_-J7_wx3cQ3V3q8TOrqMrtcgyb64N0fuDRjTE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvpxBnzbozip4sdkCwE2STkLqn-kUpj49CRr3R5CuxaQ&oe=6A8EF596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2FETKxb2aMQ7kNvwHZxpye&_nc_oc=Adq6ONhTkCQirFGLI6b1vH69IH3JsddHH2R21opl8IdEcOUtsuytkpqSk_0vvYBmVjE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-dsgTu-3XKqnf4C-o9hajp7BxhEFRzO_A2IqpwNPSpg&oe=6A8EE0FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfC5vLqhac0Q7kNvwEQZG6t&_nc_oc=Adp8-ztZqKRS3z5mvGtgcd8GFSqP-XqtZj-nFULbdPRAxvL2R6fkjJLK8MdjAAV_GZM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLMUDKpt7nn0OYP0BWFx1b3M0iOpF_J3FiorNOKBo1yw&oe=6A8EF664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tas-7Oxfm6sQ7kNvwGJnyVf&_nc_oc=AdrEDRAbvhACAyMTgHoy44nESpyo6cznulvAyek8uZtcANch3C0la28bKE3fgn25q34&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbq_jBgGlGgB9ce0K9RmB4kseFIaMcRlPADhcJRVyxRA&oe=6A8EF5BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD1_7U8IkwcQ7kNvwFwlKTt&_nc_oc=Ado0USJAbwRGCOEuf1M7XFeelnG6C7xaRpb1
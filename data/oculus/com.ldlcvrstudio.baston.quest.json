.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AykTLusYW6QQ7kNvwHreXTf&_nc_oc=AdodaEoXRCEixsjn_msuhSwoJUX_r_FVQb9elWYmQlIeN91E7RaYzu3A5JlHpmcoAzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i4DXtIviwndEjhHCS_tQwRylBuuZmFuJ-faLdm5viIQ&oe=6A282501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs8FCXWOPLwQ7kNvwESA7pE&_nc_oc=AdqwpWzig-lqKmfBcNZ9OKpWVJT1Piui_571cmP7buT3c6-S__sTRa-8Ik0mmCuLhS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8-P7ItEJ_f8YWz4pYhPhfaaEBZ_CTczOeVRcctD4NKg&oe=6A282096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TljnG6Fvoj0Q7kNvwHjTonE&_nc_oc=Adqsxeid8sGygmo-ciJSDtR1ChAOmNtKjK0iUUr9I3zX4giFo-BKczAnxaKdH-l-370&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_j_dQLeAhGvA9d8u3ph0haJG4xkW1UvgFPVL59b2Iag&oe=6A280BFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S35VlA3c3kQ7kNvwEdxZVf&_nc_oc=AdoBM3gCRuwkfJu_BPjYvpYiXU0ivbFMRCLSxL-0h4oUiwDROaYXtoLyGAaZYQQlONM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqAfUYE8lbxFQkxtgs4ggBxgl6aUx4mRo3RqIyCx9uw&oe=6A282164"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goq4nDjWb4sQ7kNvwHUvdUN&_nc_oc=Adruq-nQ1Phvvi1RKrFt9iANcF3jWU9qPqpHIjvUFvJAsa6kkm0-v-t_eB71yAUAN30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E00FkmPsaNQrO-xuB90RmcVvF5locvoqzD2809Y9UEw&oe=6A2820BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWepuNHVFwQQ7kNvwGso_iD&_nc_oc=Adq6gAwgegxm5ue9859PaSqYHpY3Fshf4omAGO0rG4_YKHcv-2rT
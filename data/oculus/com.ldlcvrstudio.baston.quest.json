.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOtoza0hEkwQ7kNvwE0BJNb&_nc_oc=AdqJY23TmNjZ6LyWC_scygcR1XnL4fHIn7EPD66-CO9emD3TAzbk65D4MQGMIuCiMZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WFKuH8ei4gvWEwCUr-voXy4d8Sejx4iXW_6CgxvC9uA&oe=6A033B01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-S1m0gBw8gQ7kNvwHLY6S7&_nc_oc=AdquzdiutIcUfa4tIcfz_-AmNHy5aE6q_vRkQClSL6sncPxrCZouHBp6bVCFCx-2SFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6glCC8Lnjj3m3oA6T7Pcq2Mqi2q3Bepbub6lf-Q6I4ug&oe=6A033696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXOe8NsFLEYQ7kNvwFONaTW&_nc_oc=AdpahkofgHRjXV2rm7HmyG92wTjKBz7lUeAezN2BhjAbNOwHX-v0BW1MhtGEJuwWjvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6boV9jC4dJj4k1VQOS1O7NnJNL5W9mCM95ddUpgVJuqQ&oe=6A0321FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PxzgL-435kQ7kNvwGAaSYr&_nc_oc=AdpMtY0utJhKR9g22_PpBy3WtoTXhC6JmV2pRStlk3VaacvTfAWqS36SSAdnGIDSfJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T6mI5E56jjJ32gtIKbEdXM46tA3ncAZa9sgceBllItA&oe=6A033764"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5DeN8rRhg8Q7kNvwGvWixr&_nc_oc=AdokyhP78pjF5viYi9OBjgsE5HnZ7h8ic5HSL43cUzvcmazeE_AHAOvITievekYx68Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50MJip-led2i-gBzgpeO0-ClCrglBp3aHSpHmBfwKNqA&oe=6A0336BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOHZnA7fqBQQ7kNvwH7h_fW&_nc_oc=Adq-tOGTgGJqx6vIqtGVMG5fwprcVl7YbocrQbYT0YjZOQ7G-grK
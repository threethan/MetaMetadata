.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeUhsOrkf4sQ7kNvwEF65oP&_nc_oc=AdqJ_iu4XIjXPWCYoCKr11csl6e6GSAkn9QloKtAve3nVqm1hun0sx9qcGwpTC90dUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rqbK65s-jtpLlBjTtSvojHxGZvlFrXYrhAJdG2FivbQ&oe=69FF4681"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYNa_0OTfkQ7kNvwG0SUse&_nc_oc=AdqY8C0pObYexdvJQnferxRYhvZFL9oKeS6pGjcbiqoaJfIFT904Qfn0u7mW-mX-hkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46_by-yuyMV2Eb5iCWwJNAP89H8BKXcVVKcrzA6U-pEA&oe=69FF4216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOnyfjiPDhEQ7kNvwGiQO_I&_nc_oc=AdpSfHdIZ0jdarAkvfhQ6RzcTEhWzPs2fE-QTyBUnjpMlSvGjar6qeGj3AOeYlXXPu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q6xjcdq3Sv4nAaGz_nzOUwti4ilBHgb_e3ITZqmyKJw&oe=69FF2D7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akjnp_sP_5YQ7kNvwGOFIJb&_nc_oc=Adpry_-57cU3OuyEYZ3hpvzbOD_1YqJ2lK3eoiU1Vb2P5wbzKnFLLN3-4zturE8jHA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QJj_cKYXgDyOtRSJDdmAgUz5ih8g3KU_5meQnftRs3Q&oe=69FF42E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl0nKUBT-IAQ7kNvwEncU-M&_nc_oc=AdqWAT9gguqhcIKb77whAyOgIOSidzWsjh-IOMjehFk1yxau-9HdotFDB500ZafOAOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y3x8lGGkb2PHg9_upL9qqh9Q93GLllzY4RBAIX6ICQA&oe=69FF423C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFNmqTqYDVcQ7kNvwEyoijj&_nc_oc=AdrEbZ3UNg64vO--7KcpvM68vm-Hn4nMkKtwZ9-UbyHRuGB2v_EN
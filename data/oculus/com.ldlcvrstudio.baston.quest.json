.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HsSeJzRDFEQ7kNvwGTZLO_&_nc_oc=Adr4r9jy1nIKEV1bY6z2VhupmvbR2BfZnLZKbyHlo3Etoufub_XUqCkPofwg4gHjDks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNp_xckECrFanjj1sWZWPtc2UxKhuQ0fk7puF4QmsJLg&oe=6AF08901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqxcBAL5lNEQ7kNvwG5N9um&_nc_oc=AdrPcRDgo0q9JxekUKdFmoRJxeeg9UaufsbzCWnY6uOCLJ2Ks3WmFw4NmV4sS_vx8QY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2L4WnDG2bkjBdfPrrJg7xlKzF7pvGxBCiHwIOku6i5A&oe=6AF08496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xydWS3DxPmsQ7kNvwHq12AZ&_nc_oc=AdoiITEOTd-oHp_LZNvUX7PjISdiEX4Yfz-EpKMRjQwLggUp3-OSz1Rb_4t1_uAc2zw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI3Fg6DiehLxGAygbvj8rfWi5hQlT8aBOflzHGqGgGsg&oe=6AF0A83D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw-y_dDvA38Q7kNvwHeBTfU&_nc_oc=AdoVczPnyEtf5ubwHwE5SADWvJNfVmeSoOH53lfZr1kVAhy0NcrKC-YVUckhz-WZaKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ75vuTJLQdJYqvcODT0RMnNb3xW8kNftCLT4qlFtOrRg&oe=6AF08564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSn-v5jO1Y4Q7kNvwGtES7b&_nc_oc=AdrUtPtonX0WUT66zpcFanWF4n7A8tShlQPCj1fCXtZ0pFOlUrjcevGXgKmClS-jMwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYE7uVWnNj6yFw0dzJl-x9j4EKqai_w9KQjiEzfyXvRw&oe=6AF084BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnS2bonLp0oQ7kNvwEAeN3Q&_nc_oc=Adr9cjpBOLZk1wQG3VxcQZjRLbMYefDxCEHKJcVgF158mcFy6g68
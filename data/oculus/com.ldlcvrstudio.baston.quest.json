h_RIxFA6GPRCShI9C6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDt4gDPztkKbPEW0wFl15TTho2J8MIN6AfjtpyJVv7yg&oe=6B106760"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otdRtu3nNFYQ7kNvwH1GhBx&_nc_oc=AdoJjk8MDMXLrfwenTrXJRzml_EGCBLy1g808K_q7slp3m7W1IE-yH7-VAsU_KDBAd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuvsQPMNC9NCt9-pw6Pj26PhjBsrXiH8NXz9fCInfwqw&oe=6B106541"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXS6IBQbARgQ7kNvwFsDQg4&_nc_oc=Adpd0TiF62H1zg6WE9TkZqJ-82wiofQFJaDWnGSjKlQ2mZu0Jz1oaSl7m6J5tmEGZhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9aGTx9ybdHR90P1wuK6RqVlQYvKX2lFBs77z440oZqQ&oe=6B1060D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcFF52rhmkQ7kNvwGTwic_&_nc_oc=AdqNp87h4p1j-yB8rjsN76JU_Ju-Rfjx3dp3fn1Tv1zG97QITdgM0XguKAPEg7eG8ZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFuJ8SZYJhKTvcvHaFQFh7be7ppFYgattEW24UitA-9g&oe=6B104C3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8hXIYaBnJ4Q7kNvwGzqisr&_nc_oc=AdrxPlhWx33e-8Y1PakCTndafOQDPiZBkNfA4-hGalZvo7jWL5Vv6MKvmKcnlQ4i-nA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbIFT2gCTVCWBnsG_4nSkmgF4s3l3bPZyJdEQe5tG-Hg&oe=6B1061A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wIKiWL5Ou0Q7kNvwFUbGd_&_nc_oc=AdortynHtKciOL2geGvbMQnj4V1CDHqONPlnEAOZr-jxjGPVbLmV4DJADV-_Eo0S2c0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFH5YGrBjlkSxnJqfirCu13ABZFqw0sMIJdsXe56YADA&oe=6B106
358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc5-4Kj4U8oQ7kNvwEwnxzt&_nc_oc=AdrpxQetQqTBKZffKAzMahWZZHlo1Sx_usOymq_qV5MXgcHjPYnfp1_yLIxtt09EzM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aDnnitQm-gSVVExWmvc9Wv-3aRcwjfavOzAKcW2ovGg&oe=69F21781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daf5gIeN8AQQ7kNvwHN4L1t&_nc_oc=AdonCi-5DA820lySx8-gkWz7VYaSGvaMA9-YONRQH7c8jz20DpLGmj-D4sNI_RDqAnk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af11QeZg0flNmrsY72yQMd4Lo8msqZoC5CQGQ1in_O2qdw&oe=69F21316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX2r0CQMJmEQ7kNvwFgRlDC&_nc_oc=Adrzfi2tc-W1n-T_Gx5LKK-i1tvEgIlY0x-7etVCUkkRXEsiZaQeA8udZOXFKuRiW1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cxLIO6OeK05WxYt8OUqCpBStJV7SjVPLz8wgwb5S8vw&oe=69F1FE7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDwFkRbWazsQ7kNvwE32qDR&_nc_oc=AdorXszV27tI2aeDd0m-sgUAgui4RWTWTJuXifCiy9QUjZsJ6vBrKGehU1DAAQ2Y1bU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nZsDj0fDq1OVr4BDtYFJJ38ARPo8pdQcu0hZBC13pzA&oe=69F213E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFl5_miL-zoQ7kNvwHVDPBc&_nc_oc=AdpuNH30s1yg7_5pR4uTRTEcw3waEzv5YI9yM9KcmsTV-ns7Xhnb-XDJDKk2FyyR3ws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af26mZGWQkDUA4qwssYtXMZkmrwQYGEvFgUWL1xbycQN8A&oe=69F2133C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfQvEUZunsMQ7kNvwE-evtI&_nc_oc=AdpMP-ejRcfq6pluz-iw66epZs5G4LHKSKmKE2F0DhCAVqvYtgybKYSRc-XPKRX8C2w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rvU-e97nvU8Ge2TMX9E9MnkwyeOdrZmHHyPyEyuNMmQ&oe=69F1F8C1"}, {"file
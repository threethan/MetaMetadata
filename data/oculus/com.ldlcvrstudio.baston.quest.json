388_6932010296335491220_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoE2AXXhpc8Q7kNvwHfjLT8&_nc_oc=AdqhOc0fFspBRUfrdpyRMX9MZcnK_dWgfObiAlvuKXP6C1IxrMy3BWJwk5sKXOJWRB8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTparGjB2qdbdjBIxEa0SCGiCMDtYYsD_1J9pHV8GNzZQ&oe=6AFB4B31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ijXSizybwMQ7kNvwGlAkvu&_nc_oc=AdoOMnkUiyo4aZIAmX2u07Wemq-244bO-J479KYihgjpe5P_6IXPEec3IfH2luxRPyA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDrLGD9s70u6Za2WAyagyPdvS_iiIYoV649iVlekpX9g&oe=6AFB32E5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V69H5bDESFsQ7kNvwEF494L&_nc_oc=AdoZP_ioYH8Yxxp7tfmg2Ia-W7KKgp-wlZiNZcdTv7WTm6S9l6-OGS2NiM9ti5gkb08&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx5oZsrA8rZIqIjihgt3wllfiss4L3fF8mbUxaIKXIJA&oe=6AFB3045"}, {"file_name": "CoverImageSafeAreaTemplateSquare copie.png", "id": "1880433679219419", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1880433682552752_1980421045084427771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiZvl_9AABAQ7kNvwFHYN-F&_nc_oc=AdrFOTNk2VPPkXc_jq_FKqLTHaJUwisPo_1JI4GWCYtX9S4xbetFsRyIa9bC8nEDAN8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0XRLmtvAei9Bc36tWJVr5FyLOq3StCMalTp0q00HvXQ&oe=6AFB1F0E"}, {"file_name": "NHBK_Logo_H1440.png", "id": "1660891154542652", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819944_1660891157875985_4872676651041472123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHY3ZrqEDPYQ7kNvwFKMbQn&_nc_oc=AdrBjZTm_pNyuTIqepLP6-OpKdQxL_CdEM8Gy-lLugwCfYzw8ON-Is3ppPn7r8vWx4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu4fwZ0jDO5td2Bs0TteBW6b6cmXBarL4QvWaU4kwQmg&oe=6AFB301C"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1417701233407141", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823270_1417701236740474_8916931527861982871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-
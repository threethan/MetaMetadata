.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLMDpsXxeNoQ7kNvwHEVjrI&_nc_oc=AdoV3x_vxWmg9rnuVjkglCOu2kahfNhorzj9PIGwki55o2ab8jzGbfvh-lzFy7HN8fM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGye0yrL-qo8L62tD38CRsFCBvmXfpWrrRVxyOwzj65Ug&oe=6A70A781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdpyuGQMGDQQ7kNvwGCXbbO&_nc_oc=AdpjkGsaNiYqTZULzMQzS5XUIQFKkh8XSlTnG1pB6SBBV9SqbyqGq-f5HfbwJyCwd0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpv8GeJMDoRf6lbpEZh4ILK-Drk82hCumpxfJdxONw5g&oe=6A70A316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S96dzsS0ioQ7kNvwGcY11d&_nc_oc=AdqGSlPY0POZS21yNKPvnhEcqFWLbgCNAlgnYEjMKtzY7XlGx0cDYHyYuLK57884quo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHpdEQM7FthrTZoZb1hBgdpiUHcBqSjeTkie0Tl9qgfA&oe=6A708E7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihpbrCnc-PsQ7kNvwGejnYt&_nc_oc=AdqhaPOcM1Iijq4K-QgthVGY8eAdkA3Q8GgBau2RmxdIAkjbeUeQuY3RXYfdmmKbmXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8t9AAE7axuGutwG3xM75taLwoVrj0RDrETB4Xszztaw&oe=6A70A3E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBLjjiBF3psQ7kNvwHujd_l&_nc_oc=AdpTMg4AojoOCDto8m_YtohKAI_qxTSKlcv1v4h8pe7OlH2uO-nZkBBR_iXFQ3yQg_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv2eUr7wwSY0P6FPp5ns7mBoXjhhTw5dA-09M4fn5s_A&oe=6A70A33C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyNtIjV0vlkQ7kNvwEBAbaT&_nc_oc=Adq-GKl09GsHc60uP7_B0AG82gI1nuXuIpG1zwVueUWQRxTSu676
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HsSeJzRDFEQ7kNvwFu7hYI&_nc_oc=AdoIvlL_s5FH1xz2vu8hjvWv39oEGIN5wvlCPe34XL2h8sQW2OiinybRoDU4XP_fE-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWodp0Emf57STJkjcDH8eylcG1FIUc4RSDz0Ga4gSIww&oe=6AF1DA81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9WnkQWwo4sQ7kNvwFcRfUF&_nc_oc=Adpj8kwd-uCnLJWO-6hT0HNatD0sl-1vqef4OfpynBIPdVeEEEu7vES1rxc55nJ4xeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWEvfw625g1mBkio53qVBz99mFifiXqRqR2uA1aUrpzw&oe=6AF1D616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8CHMZfyHa0Q7kNvwElVLer&_nc_oc=AdoVO29h81RIFg2D6hFT6r9WYxjSOv2nSHN6bVfnnU_ReFwmj-SeJ7h6cYq4mnCnwi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdsZogvrp3I0s1oSbhSqyOY8YR17WvZhltlU3UNs9g5Q&oe=6AF1F9BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw-y_dDvA38Q7kNvwHQfF8C&_nc_oc=AdpYtR2I9_lUDeMA_rn-42I4rCCI_L7gOk9ia8FfzAKkdjJz0PJoGO-ANr3txzXH9wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROmXtDUJb-48j-EIJ2LB52cWiYXhMTh_EcfCFugOmluQ&oe=6AF1D6E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSn-v5jO1Y4Q7kNvwHsWEf8&_nc_oc=AdrRYV1YeSOwZbGg32v1GEKFfV7MUhPZfaui6YIPkq_lSbmPQxSNTth4vOR9hFqjDZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTScMfGznzIR5tWHuuWAMol-nB_1sRU3R3WtY4z2mvCvw&oe=6AF1D63C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnS2bonLp0oQ7kNvwHLxhYX&_nc_oc=AdpCmgKVhWiSp3lMVUUlWTIpAr_mFoITa65JJmpdwhx3l5z_nzYl
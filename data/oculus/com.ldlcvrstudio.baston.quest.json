sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vo7R4MiEzwQ7kNvwFkC8rk&_nc_oc=AdoRa1uqHdzSKoqume446BwaZGFxzNCTgpfNRxCMrHxx4PUGaeTMKUQO_qmyNjEU_xQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFas2ZqPJqQ6NiNnK9k79AAhYa_Z3af-1xPHGKE7fxag&oe=6AAE9E01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCmVG_ejdsYQ7kNvwEgly6o&_nc_oc=AdrjXCtAddlH0Xmje5tFerob3nj5OA-Tid5LCdjl9DoTx0yXRIs1sJc_uONqCg_DOPY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAHB96ZIksxhdeAzMDItqG7SAB13sP1UhJuCk65kyVzg&oe=6AAE9996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkHZOqq7snEQ7kNvwE_NwsS&_nc_oc=Adr0wlRvcwuuaUHXYhhcDRGpORMeOKXoD06c0sJ6YG7v713gfhUigcnSeIG8RuRptdE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXbuXEpkkba1XZy7y27b153KC8EhEEn2HNJeY1OdmyNA&oe=6AAE84FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E-GAGCvSy4Q7kNvwEpM5fi&_nc_oc=AdpLED5E4rRo7NrAeuMxtGoRIXBkNJAw4JnKV_qFNAEwM_U0PAkCbOO9oVH-L9GozaQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7apu0Vzh8Y2lP-Xjy47mdMv-POmdZMu11R21z9BzzNw&oe=6AAE9A64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkxGBezgGMQQ7kNvwEajJfO&_nc_oc=AdpqM1iYjIWuZ6dSXEutyWXEHvb3r6R6mabUkPwmRMg05M--_K807Qhyt7VZL5N0HKU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoJMfqbUEVs3UA81zRsQN-iaumnfoWmGhYobrn6gWhbA&oe=6AAE99BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0qH6InlU8EQ7kNvwFb5Dz4&_nc_oc=AdrpQ-HZ1ONFdJG-yzT8yocd1oltusbQ_HB9K_kfGkEPm3
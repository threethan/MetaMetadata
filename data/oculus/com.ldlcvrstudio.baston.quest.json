.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkvJROs0jisQ7kNvwGvHU0B&_nc_oc=Adpu3Pfna_Rd0C7PhtSUMtKLKFHWGbR-w3UtNz_PsXBgOlUQc-txq1egqEPvPjwNBd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSysKFJy8SEK45mxZfbbA3OzxUe2_s2o_YdMua55J0E1Q&oe=6AEC9481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEdA3dDHMF8Q7kNvwGukTpV&_nc_oc=Adrvrplq_RcKtCFsgRNRGXd8ZzOEaE9V451kDk4bR8qdMe_rBUcxGhsD3GHkit_A2x8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwvV0ZKN5MMLCUcc2TrcDEb_REcr-cvM4Jq2pR3gaLuw&oe=6AEC9016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdC3pKRjSv8Q7kNvwG8YzVI&_nc_oc=Adr61aZl0lG4dk8eYjmRgvN_m_6vQiY2kTHjQ6lmW13UMLi6Xye_o7GZLXJPkT0R78g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf4ZwXLzEGxqh2AY5En_ndBTjvolcml9rLM5mIB5ZgvA&oe=6AECB3BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cEAiR511p4Q7kNvwF28bcs&_nc_oc=Adr-AeMTmz3MIT5QciH2dan1RBdjEv5qdjrqI_-wqmGU15J3A3rHTxJ6LxjldNczozQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF-IbEYMtCWlabNoVFoMuMuFYMkezwjhBCKLKRM-GopA&oe=6AEC90E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auZ4HN3Bn9oQ7kNvwFGVGm9&_nc_oc=AdoNTi5iWUz7npmUiPGlnlxM-t-ttdN2tjRy6kTEFqQBZR5J49kxMUDWJszsYIMYXzI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnemEo7liqT0g7e15Bm5Pcn3STV56dwCr3iiZmMgQz2A&oe=6AEC903C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dOuqujF7YoQ7kNvwFPy_Qh&_nc_oc=AdoJE5wjDdg1-m8R12Qp8qMIvMRqBBRgSYPnAEL5nBoSVBPkPhKp
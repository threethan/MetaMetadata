.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qzLIj94QC4Q7kNvwGqr5Zo&_nc_oc=AdoLwiOvNBZe-GtzGlVrXhpgNFiwRO3U-IEp-7QZsNKR7FgrOIaJnEtbP-NDdBXzt4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66r3B1xU5RGkvrJklXBoFwu_oVTCXy6Zu2lE8YUdF5sQ&oe=6A1EEA81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aJVhLvjhJgQ7kNvwHrl9bi&_nc_oc=AdqTbSoBFDnwQ5WEtKDUhqviI4w1YfjWBk11OyElHg61df5EYLR63wjnGy_AutM_y3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HDNnSywI6IiGiV04B3XfJmbKjMeC_lsa99gV5aseYnA&oe=6A1EE616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZq1smGpMe0Q7kNvwHdXbps&_nc_oc=AdqVz0VgXTnmAIkrwJA3zYEI6vExzFnSK3CDNO15EgUh83nIQOatYf5NA2R247U4Do4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YRIA_T2byrciIcMZNJkh3D3bgMwt-b6qxDt50jRVgvA&oe=6A1ED17D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXHXUvSa89cQ7kNvwGPlv2N&_nc_oc=AdqtEIwViqhE31RYkWKWefATecoWyrRMdpwpuFgCzQBN7H1UoXPgTDupvIm7cAVNKtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DuBKA_H5j5ZzhBdKWycsfiu6IP5UNbUzbHx59FhLgNA&oe=6A1EE6E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLp1bN8wJDcQ7kNvwH6mufm&_nc_oc=AdpMcP4s6sr2s7zCJYoPfxReFn0vgOtUocONV3f86TmFBaJhbiepcxFcOKNcYv3nC_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ll0VsCzXmlT7aDnGUoUYYhA6osTGksrr3opPLbGiCuQ&oe=6A1EE63C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt2FNUutCVIQ7kNvwFYEoIK&_nc_oc=AdpdrxWTZ6C6AwBai-JyQLZJrIxZn4bNsXVyZ-QQiw1yxVqEJhku
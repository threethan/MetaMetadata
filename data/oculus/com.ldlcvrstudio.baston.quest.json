.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zk73kU-z8MQ7kNvwEYj4F0&_nc_oc=AdonIIXDALTfTTAdrwW8fLP9iZaFtTik-CRsUq61iam6MSBAGwXdzb6JUxfQ4-XnNUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYcbDkaa8AolQ8EYml55yO0Yuo6YcG7AS3ieCCG-cqnw&oe=6A622701"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5qbPRSPlLEQ7kNvwG-ewyW&_nc_oc=AdrPuyXLVrdltwMvX-NR_bKiRw_my0Ou6De7TNPDCGuTrJJHBlfofVscO77WtkzxIrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoWKvBg-j8bQaEcAgHpB-GMXKgkELbH-26RPR5fA0MyQ&oe=6A622296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lXj-hd11pkQ7kNvwGEnf9g&_nc_oc=Adr-DKs4REOQIXPNm08ZZIu-Ns1q2zi7RpWyNCZf0tc0i0G8ba7u5S79pbIH82wH64g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1Ay4q4vdSN09HGiffMgQD1kQsStParieAiCX3surjjg&oe=6A620DFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeNFnvRv5fYQ7kNvwH6kk82&_nc_oc=AdpQcI9TmJVqDdCE7UTb45UaoxK-y_n-5akXyVLYnLouBtg7iAuT7NXgl6q8A-jEroU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzJBxf0cLl-7-8evihxa9QT27GoZD9aoIU7X-sRGHYjg&oe=6A622364"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlpy6mBA37MQ7kNvwEy5XmO&_nc_oc=AdriafhoL9yKV4Tm6J6a3nBljw1aMZspK5AbmuUL0KCbO13AwIlnvu_d-q8-u46egfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaHqMujLHHfx6UGnLQM0P29a-Aq9B4bBg1-EsBFuwf2w&oe=6A6222BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1k6xcr9eKEQ7kNvwH2lIAI&_nc_oc=AdqH6IWzTW91Fs6VKzh8kGTogwg6n0jbQnN8PTMwvNjQflvK7GqS
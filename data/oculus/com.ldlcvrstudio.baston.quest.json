388_6932010296335491220_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa3ELL657roQ7kNvwFeOhCn&_nc_oc=Adr3agcAr_SHj_4nYsGRvpkbkEHGJHbuzdYnG7x5j2SyOxxdbNxkbTVsNK-mPQ9AFqI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbW0zur-gMwqWMyCccAN_SNyyvFr__pUbiJsCioPb0dA&oe=6B0841F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNPDANA5QLYQ7kNvwEtuLHF&_nc_oc=AdrBccvSym5G4Ra5WAXGjaaAIielv7yTbSKXZ5UJr72ujbLcCpMZqnodFdSMZkBt02o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXg5Gtotx5rkOgjfLNbcxnZ2ZEXTWwDHxEYlIwsKZQCw&oe=6B0861E5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NJ9p3OOiIEQ7kNvwGPEi4R&_nc_oc=AdojNZ6QIxwZ20J-ow2P53Ve5aeQyMrRuakkELFxmy1NLY3WmhBweDA-uH_ipb1Pkbc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbGqYfzB0txIoJ_39uYvrnXQ8aqf1Hz1k2j5Z4delgpg&oe=6B085F45"}, {"file_name": "CoverImageSafeAreaTemplateSquare copie.png", "id": "1880433679219419", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821796_1880433682552752_1980421045084427771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75pa_UqaKdIQ7kNvwHBHzYb&_nc_oc=AdoRq9DR2XkHaoQlO75G3YaZxf6OKz_D0hLlMzIvxpvEKhf5dlO_0fKcpWI7LKP4nS4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK0ozRPa-ZXE7SKOKRj7d4N-5Kc38iTyMm42xWLzHj0g&oe=6B084E0E"}, {"file_name": "NHBK_Logo_H1440.png", "id": "1660891154542652", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819944_1660891157875985_4872676651041472123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmJMdhq23HIQ7kNvwEv9Gaw&_nc_oc=AdrrBP9fY_5cUCEbZMZW-pi8eAXf1EV1o2j9n2oIkNn33lYP7yiknGrPgxLysSHZB1U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTxCa2Q1BMVMeUqsQ_Vv5C85JbBu3Wrw_9-2NsYTUUtA&oe=6B085F1C"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1417701233407141", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823270_1417701236740474_8916931527861982871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHi5P36Ty1IQ7kNvwF9fB3K&_nc_oc=AdpRlFjrpJPkPDS8jkGzmgYd5SOdD5Uiq2kds5zs2wgHk30SRyonlnjCZHMOIz16Msg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7yPFp32T_CYHLF9KRuJhICizuXg8kxiWAPviJaZzu4g&oe=6A7F2801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuvLX_IGesYQ7kNvwGzu1oD&_nc_oc=Adobhi3T_n_GePstFkIqJDNjlQmsk49u3mLOO6BRAX1EkhIMBej7BtyqoXflZvpz0Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7tJvUVdjUD3bCsalpTzMjrUJXKkltv6oEI3-Mwfy8Ww&oe=6A7F2396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Y2iwio0UQQ7kNvwEKvEX0&_nc_oc=AdqAXdrBvfylxcqzK3HlV0nApLPnACEi0__A23kpaHtnRNA77fN-3qIcnQw6VgcNYjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFgLGeZAPlcSL0QV86T7O8nuJwfN-KDKB_lhoGQLDUAg&oe=6A7F0EFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIuiB2izH6AQ7kNvwHhO2_Z&_nc_oc=AdrdWBTQlUIAbeIe5L_0teoTAd12a7cYhoioMUWqMznaQwecoKoN5V4oT0BZMw-iUvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_VFm3MI56Pj_VmX-jC8HPUEyloE5I7FHq_OmbdsllQQ&oe=6A7F2464"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwmX9X9yx74Q7kNvwElkpYH&_nc_oc=AdrkC7hl59ZKOp9nmirMLqFXfTOlWy97FAY9ms9OesVfPXCedcf3g111GXRQqUgaTBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg73YmykCohm_I64WGbTRl5P5GIOwOqhk8ZTPv4CpU3Q&oe=6A7F23BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkqpokAb14AQ7kNvwEaheVR&_nc_oc=Adpa9_EMkJEJntgUXvMUfwO5ptrihSCGDuN0R1arzO-n--qAxcTI
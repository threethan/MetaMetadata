.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zk73kU-z8MQ7kNvwFC4NvY&_nc_oc=AdqHPrp2JnRDnyx13-f04cy79uNbesz-pvzcPF8DKsrms-T8Vecyo_J6dQWTYPQe3Lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACTF3aWUNWSdy5ywk_bh5lOliDhOLy3vfVueHng3IZsw&oe=6A64CA01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB6JXEV6D_oQ7kNvwGiue6O&_nc_oc=Adp47lpyblhIh3CgQuhZBf5n8H98N9XMjozduWmv3VcNIymtwCsi95LpyXYi8OAw2vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv6szv9uDsFUf7j-rwJf7p99ENgkSIvg3rKqh6moHG3g&oe=6A64C596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apD6PDvzpbEQ7kNvwHkdc01&_nc_oc=Adr45GYxRr-KL6Bp2vXT_n6EpXzplAWGg8Hd-6QXjvwkEVUPyqiHsgtFh2MK3tdk-Ek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy7tagwehvJWFFgGiAGHGD5YOW_gEylhuPFnT0yqxGyw&oe=6A64B0FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4M3NVX9E8oQ7kNvwES6104&_nc_oc=Adq4t6Wm_gseM1I9LRpC6bp8oQXF4BE87sgiXnCbYStCtFmuoJjVY_1xCYsTTGymP40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9hQEh4lkBCl1taS1VHd3pD_EYYqrUcjeH_6ROEOOXVw&oe=6A64C664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO_6ttut-YYQ7kNvwHdVrqR&_nc_oc=AdrHLDZhdoSXBb9X-ARlqoX09J42vZ34RoIOlMEjlUO5QbXLra2T7hMNevAC2vy0Yzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyWtObgsax4CTPt2LLfjk1DD8htgj988k-32t2tDI3yQ&oe=6A64C5BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Olc9z4_kkmUQ7kNvwG28ed0&_nc_oc=Adp09iUKKWtnpgKxrUME04BEfCXq5tUwv19UtpoOr_keN-Q0Dd6h
sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L0qLvxN2wIQ7kNvwENthsC&_nc_oc=Adqie81rbApEDccj1vSKnPQO2Kw4jW6zKUhbcL-fcveD-M6KIVfz1qcqLF-YlSSwcok&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Som8cegxDW6JLyy1rTDDCjLrclnz7L84yrIK6ZIPsyA&oe=6A394881"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHLeGgC0gyMQ7kNvwFWDTID&_nc_oc=Adq93BoVWHL2kxm17X5Y-e5RJr1i4O3wJ1exFdVh6jPj5yVBLG3z0smT-TpxbraDaWk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d2by8Z7IFSOZlsD9eHbpInJTScFluz0uRjEaRSAbhsA&oe=6A394416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFzN1QbsJNMQ7kNvwEXLAHu&_nc_oc=AdrZPq7fo1TdmN52MdBRCsCH7XNGBuv-z7fV7_eHThx6SidzI8Mo4EFw_ovPamNCxB4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f93tMckww0-W2taFv3b7IOS500TdR3qM5E7HhZ2Fyaw&oe=6A392F7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWJGyC1UsKAQ7kNvwGkN8B_&_nc_oc=Adom7PxcWkba5hIReODKi2MBsYnv3sNU4bwESUb_M21AwM-eTCvjrBmIiGK5e_-e7y4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l17-qneGbRhiKl4lNofJfbLbOCVT9Z8p98CYFYJ3TUg&oe=6A3944E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtvzJrjFYYQ7kNvwH-lIs4&_nc_oc=AdoAZLgTuC7swOxousqCYbUwdkd5Xhu2TMRAbihbYh_ma0sJxOEb0_MQcPtInqiPQxY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dq2KwZMrkOUvBiTbhwgaAfGHs3qMgMSG_YMgoROOYuA&oe=6A39443C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I3YTahQPuoQ7kNvwHdzECC&_nc_oc=Adqp5x2k-f7semtvGqmmo1MTVJ9a1bcjbYl1VPKpKC_3QQ
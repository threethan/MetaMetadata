.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vo7R4MiEzwQ7kNvwFd-GMF&_nc_oc=AdpC-5O5tGDUiilsAA3jfMDfyqPRPeqJnwMiRG3hU1rOF5srbbTROh7WzFpUdsOP0Zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnODyUIN00cMiRwKANXC7cODRpAOQVVMb0QoSc0kaK6g&oe=6AAFEF81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCmVG_ejdsYQ7kNvwHwemlI&_nc_oc=AdqarZ_E8CNKsr5itGkmkRc5op-Yeps_C-WC8cq5atIPxSyiTUtaurh3huP-4RXJtQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFvgBAtorTWyN3NENWwiZXccisTXFspqQxJ6--z1LlxA&oe=6AAFEB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkHZOqq7snEQ7kNvwEPW_r1&_nc_oc=AdpJ3ENLI0PassKs1TK-UU4RHi8paNKWeuSx0SdXa-5GVsY6iIByJcmjRCA4a2OToYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5LK_hC-_2mqNNbvB9bWcv6_IClkAk_qi7i6fkP_CL1Q&oe=6AAFD67D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3V-JgJVXwQQ7kNvwFvHufc&_nc_oc=AdotunQKQUenWmTPwPwHNdIBEPCWGtHXguzgdkZxJDz1jTwr2tNw004JVxMuPkSEd98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZwgZoYi63lXUGbSTD4AwwvBlpKIUQFvuUEOWVyAhdtg&oe=6AAFEBE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTiR5oxm5s4Q7kNvwGeAYbg&_nc_oc=AdqvdIJrlREMQ94DFaCT-4qw33tTnwP0hMjp1MbFPBYzk5uf1l40Sz95m06jdhzZGjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4sccVCwtoFQEpIiojeTmtWEm4o1E6uErjmzqONTS-Kw&oe=6AAFEB3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouFrOPQleAYQ7kNvwHwIt6v&_nc_oc=AdrEoya5jP3O6FmVwm_mwDcbweajZIkwe7VsZI6DD8VQvtee7Hhs
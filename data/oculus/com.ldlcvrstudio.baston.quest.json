.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir_NDIw7yUIQ7kNvwHFMkeW&_nc_oc=AdrjfYZ1LDzHDFQPuiPlYGspryU9qAJFbMecoQ9mGzGL0twpUQQoi9q5AW0wB86WW4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IsZp_2hwm-Oc5elNPYkc9Lb-L5-AslUQ0QZpyo-lcyA&oe=6A452601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0dbrLemH7EQ7kNvwFkxNSa&_nc_oc=Ado607ibveSM4bolncxnWI12rCNjNmnWYyU6aZ3tUrE_nyc3HGqBAQi9bJR_fs2y608&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L3aGQYMG0NhTte5xvUgOU_Ca71N2zeGTYS8OggvOquA&oe=6A452196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AnpWsdxuPUQ7kNvwHyV_KK&_nc_oc=AdqsKHaUVsq9QOde3nvLbwALBqXRmUgqIFx0Cjm9fLwK6JcRgtUWVrPcS8ibEppYRuI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YUvKqY4FfgqIghqoA2Fl9RY_f3l8E_512kfWwSQ61EA&oe=6A450CFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga9C3QH28kMQ7kNvwFP4dIn&_nc_oc=AdoixByoscGPykVGYoQq46hepP4od7mYjIsmXwRXd0SzxwWKrIQDLUMkDY1qwxqHVos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D688aksNI7sZLdKk3v2TtO1nQN7yI07odTUwun_L2oQ&oe=6A452264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UryYsCvZvIQ7kNvwHXOY0I&_nc_oc=Adpts2jtHTfps4zjTGiFB0Z2Pft5vetlxrDFFOAenzRz-pcyLQM3UsdXh6aHWHnPXq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d4E5XncloZl1iqmrH_X4eC5izqRR-02f5t_j7KtaGAA&oe=6A4521BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs1AbcPuxTAQ7kNvwHolFd_&_nc_oc=Adqm47lV9Pnr8ppyUwgrKGYoiOasktIlc8hI-0_HqvaLNtwJIC-z
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkLjyiyBNsQ7kNvwEcaTdX&_nc_oc=AdpgMeqNFosPjvZGYAcLqXZjrHFRJB3I-z7__leqDn8JZlHquQdCVWSQG4MpsnXxjD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ntc5aPBClfL3NWb5dPbcvNV7D3lZChzW2q1R61DvIZA&oe=6A3FE001"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De-n1_7Fh4AQ7kNvwGGm-Wl&_nc_oc=AdqFEOIer8jayYR0tuNco7v1KoYFFgnpXq2Q7MtU354dLVgjMMJa0yml-wZF1Q47JiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K9a_4nreolBqncFQdNb49U1gplVg_xMyt9KG_SW7oaA&oe=6A3FDB96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zqS5XD_7nEQ7kNvwFWvAvh&_nc_oc=AdoBuzh_g8ZJzVitknNDAp-3o0bjOPAujSoON9FWY-zdwdPFgPFbszWKtIV-Uxy1_lg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v5Mt47Unn6GZe6eHnZ7qTL5tW-IRr9WpAGQn6kYWXdQ&oe=6A3FC6FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl2qzxccbsIQ7kNvwHM3Og5&_nc_oc=AdonCGSDJowx4PLTqyD2KMKpC9Q5ePnlVg_TvdMoYJ3iq8ozFhtkAB89t5ga-CtbPT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93R-BW4-VaQMiKq7SczaAuhxrYofWmF0xy_VWxI4si3w&oe=6A3FDC64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlFuyst7n4cQ7kNvwFiPuAz&_nc_oc=AdrdBGu1_ns_0tgG8XkMJ39A13GxW3NJwGY1HByPtTes6lMpSx8ohi7lCehS-FE-Mt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tMB1VBH8nZTTUASO_xU7S1SeqiSZ-PmYRA9b3BWhyqw&oe=6A3FDBBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwZqvFtSr9kQ7kNvwG8qrMM&_nc_oc=AdpYsh86db3zetNRexMIblgAXusOPE-zei8t5gmcsrjlr35iNByL
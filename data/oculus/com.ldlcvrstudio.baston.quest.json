.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAxA5CrYVb4Q7kNvwEBHyC9&_nc_oc=AdrfM4ez-D7iIIXgWRuD2Y_KFESObTbQgvJfhE7eHeuwjBQoOxHZRPg5ESXiDeEunyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfrhNOd-0HfHm4X-kttfX5cpb1TlYXfuPtH4Ct3CvG1g&oe=6ACA4D81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1S7c091_4UQ7kNvwEUgD6q&_nc_oc=AdqNrdEJ5RI9q4rf7dZ6gfCczQO69r-AiTCBT_w-HNWRh4_LGkxE82t-UWC98W3Chbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOfCiy1Rr5me9vLNQfNvtImGDNj_RxRXsHL5t4au5_fg&oe=6ACA4916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiNsrRhec2oQ7kNvwHM0YPq&_nc_oc=Adp1sdmPCQOP-jCvICIq2xMAGsp9oqWCDSNivTG-Gp1RxW-cjALv1xZrrEeIDQjexvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQbMBIyz0u5j34EjK4uCe-N83_lnDr3MhLXaCwmqYBDA&oe=6ACA6CBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJa-JnnIZjIQ7kNvwEC2R7J&_nc_oc=AdoUyWf1hhyshOHkSPsWSZSCgT4TdeOM0lWuI2ct3Z6tCaTDBOwH7Y2a7ZLmGMb5-fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcXki7ubwhFmejPN4yiIUaGbjh4qtZUtsk5HjidyLM_A&oe=6ACA49E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dko-7mQ80f4Q7kNvwEzBn-y&_nc_oc=Ado3Y1bAa4qdvWQJ2mpUE3LtIsrgQx1mNVWU2mztnxWxhF65m7h1oOuUsHG9D5Nkptg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJsajEwaEqivc_4SUgzbPBPmwWzz8SpUXRbQ-h4TpUPA&oe=6ACA493C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCq2g_-4zHYQ7kNvwGXD1sT&_nc_oc=Adrlf4GmuDsbFXWm5tpB0F3x2Py7aJlr4GChpW6tO5Crkt6FCkly
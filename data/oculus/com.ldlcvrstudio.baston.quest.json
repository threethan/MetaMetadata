.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF5EI6k_aoEQ7kNvwEPAE0B&_nc_oc=AdqSBG3XiFbrwhVydma5gVK1ar-8OWxVne5kS5QiV18BEDhQrkmHpYUCvdnVaLP5650&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fdGdT0dUTBpKta6kmGkbpoEs0vsUwGIHQAMMyhfjedA&oe=69F36901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daf5gIeN8AQQ7kNvwFfoWpz&_nc_oc=AdpU3pBF6EewwpG5LIW45StfwQav-TO2YoT9kl05OalBW_9ZOOHBPVE-KFX-tN0z1r8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34EddrCteqi5W0wInOnMrCqsbfCl3hOWglqLjrNWw7Lw&oe=69F36496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX2r0CQMJmEQ7kNvwEs3fI5&_nc_oc=AdpwcZ7kWx6y3w2TYD3xU_Ksx3Jh7sOK27Zts06UQtIqDnJZDUpJqB1isALBNPN6YZA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bILJoAz6xiwPluHfmI1y3lxCTUeMKsPGPZFPeWU7Ahg&oe=69F34FFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDwFkRbWazsQ7kNvwF-Vrbz&_nc_oc=AdqwRJVhkGTgtse07SB4nGutAKVaiHujhvkun_wDUAOOo-v5xwxndX_dNXLaqUMX2g8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qUATATsp0K_uWbbqkfKA4M3bgJWRKWbjrgxMNh7aMhg&oe=69F36564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFl5_miL-zoQ7kNvwFuP5d6&_nc_oc=AdqpM9yyu-cPW0WeN86_UXqMo_g8sMiVZhDqJEfIhEqtsvi_IjAe9WvnlUJI1SxVnws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YKI1R5QSJAXE2TtIQMJy6JRk3RbKHiLoilAGaphi7ZQ&oe=69F364BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfQvEUZunsMQ7kNvwF05aNd&_nc_oc=Adqhg--PKpXPYHxJa2dK00Aaz7cbmNyfDzHSDowyOeurfLnZwDY3owTYzYOwhDCOZHY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f
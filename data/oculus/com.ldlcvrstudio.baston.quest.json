sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHi5P36Ty1IQ7kNvwGm2DYm&_nc_oc=Adr4pyHrGjvGkHcWMnP2c1sUT_tBo1NG6xiYJQCuClRn65NQdZqiWgGP2wzjgYdOuds&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr46B75MWRyXwy01c4h_wOvrCBQXOYUMUpMW2ZK6SVmQ&oe=6A7D9E41"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RFgp6iH3BMQ7kNvwFyjigM&_nc_oc=AdoD8oKjIftVXbpQVlo1d1s-d1bDZR2LVS3_6PwmS8Mu54EsZLkv-IKquxDjJtUo65g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp_llnhAsSwnjAIoyWtlEmM03PnS-5GBsxANpxCEZqbw&oe=6A7DD216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rdvOW3H6dQQ7kNvwH5TCyI&_nc_oc=Adp2WTw4dZzIeby6-LCGRw_EuxDvmeQAu9ftzg0KMPuVPKbRwWEtRYcOvubROv7ia-0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUAdRVHqWLr_bjEHMCVA63tawhbV7uh8UYQPKd2_fWmA&oe=6A7DBD7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIuiB2izH6AQ7kNvwEESLLg&_nc_oc=Adp4wMVIrkzNAU7L9SXTYHZpqTPFzkBLYdHJvOg548jiiR7rDRq0df3BbeL59ROB2rc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4EwAX02jPU8oF_P7C0s1tlGdqNPRf_hp9473rXfM0vQ&oe=6A7D9AA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwmX9X9yx74Q7kNvwF2w3ny&_nc_oc=AdpfriuLkHY48W3S_cvqUizhpfFieHqE4wIB2yyzMAPW4dXXYBzsNgtcfLT_UYLzgwU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHREi8bfPS_tHKiGpONIrzUmnOMAK6ttsKeGF8G2FffHQ&oe=6A7DD23C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkqpokAb14AQ7kNvwHSslwS&_nc_oc=AdrFzononPS8YzDaNYDDbe8fP4A50MUhVRegLvDDqd2kmj
sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quOvU14itPsQ7kNvwGfejBS&_nc_oc=AdrfiHYkNSg-aLQx2BRyexdHBp7hQ2wqFGJuSMbCXomiWfjklXPZVwh-JLL8BitmfkI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EeJTTqoblV2tJslznXjsVVTGcKOQBLOF8HMfIlmqAIQ&oe=6A467781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0dbrLemH7EQ7kNvwFQUiI6&_nc_oc=AdpSLdqw6Y-ICb5MqfMHXrdIsajiIwFRcXM2QiFzXKLqRrsnSl2I9a8WtiCgFDh1DwM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hNcNiBHDGDrn31F5uQlHqdokf7YKGWpKB2lB_EYEVKA&oe=6A467316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AnpWsdxuPUQ7kNvwGpIZHp&_nc_oc=AdpA_VEo1VdqAUmB1xc5d5lcytfdBXaO7RMiKpaBZZ2mYeE9Ldt6FFDdZUoJY9qlCgE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0tss7LBkAL3zfUg2D21OU_0JTH5gPedRAO42Q6ZokpQ&oe=6A465E7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga9C3QH28kMQ7kNvwGam0eK&_nc_oc=AdpNB-wYCNbDMxqSxmDXsACtQvJzioI3M9bYtXXhhno2VbfsRldG1fPUHeIhEJ28hUI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DmcDC1UDe4F7HLsNXdyUk4TaeeHL4fg52eatn9pqa_g&oe=6A4673E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UryYsCvZvIQ7kNvwFXf_2F&_nc_oc=AdrcuZSdcod-y3cTeQDTib_HDDppoTxPftd1DmFHaovMvsWd_hj8a89UXQdVvI3u8wU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--5Wfr-hqzdAnVTfn9cMmQP9HAUkFlu52clF4flUkHeQ&oe=6A46733C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs1AbcPuxTAQ7kNvwF1EJfN&_nc_oc=AdokpUFWSKrBpKqZlu1JyOjFlddfdb2tRQ8Q7eT6f7EWvW
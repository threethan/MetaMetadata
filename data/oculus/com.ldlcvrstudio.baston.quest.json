.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2K8LJRsxAYQ7kNvwEFIBP2&_nc_oc=AdrX2WiZrq5cYlFpz5FYvfX6Z0Srztx5HIyMSo5DNbprxbDKls3Yb2V5x1NeLV0i8oo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOof5wHUvRbV_EElzfoSWVnbJxnMsPiMHVqnnxiEQ2Xiw&oe=6AD38801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Blf8ExkaW_UQ7kNvwGqMZKZ&_nc_oc=Adq6hzqqAzbeD8sYHoGS0AbbUE8OY0JRvOSm-GjGIrZhwY04mgJuASDiSJ5xddc42zk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg62_Be3GBaxoJD_nCdmuK9sPDK6Gg3gLX1xMnU9ypNQ&oe=6AD3BBD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoGBQ7lzWyEQ7kNvwFpyK8F&_nc_oc=AdoT3WxjBUlZgviFQ2dKl8nAEfl2cMmqojpOc97nG1eBzPmW_2U8Po4sOzrR5l-zJQ0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfAJkucHEbJmWwzL3DDvD8SJAMsMrJx-lHm6ON7CSQbA&oe=6AD3A73D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ8fK_s4UHsQ7kNvwEXne29&_nc_oc=AdoA_cK3NMD6K2-69ZDg3McL6kbVsp0zA3jOnyAaALNEQf7s5XxHzZ6fGpZ3yD1E2nw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHndP37l0nCBl2zH7PI1czIu81YqBD4s-hoWH7Rv2dIQ&oe=6AD3BCA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD7BILMlyAoQ7kNvwESHAFy&_nc_oc=Adrk9cMjZ_LB66t3Sz86DSdkWxMp0peNL4wwspwr8quWUzkuvIZbVHbFEQjzVZ7C4G4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxnHyDtwO7EPx9eO2DKObYWzg97F3ujKuiIdXASmrQ4Q&oe=6AD3BBFC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKnr-W2XmtgQ7kNvwFzHz9r&_nc_oc=AdqwRQkRWE7Or2M4fcKpNeR5VsUlAgrSM5u1RSNuRKpC9aqE4Pxm
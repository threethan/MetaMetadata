.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir_NDIw7yUIQ7kNvwEO4djf&_nc_oc=AdoE_JzRcVWcYwg_8kWtIWXjXwjrZzYSAqgFnsaSnFu7_TBx3Hw1YlBgAMDtYxLHWR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GGhftseMUScIYNGJIhZ2X2FWZ0yATgeM-hNN7pwFHbg&oe=6A43D481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0dbrLemH7EQ7kNvwGVnMtf&_nc_oc=Adp_n6J4udNR4XTIH8QABma-X8SFC_nSPHhxBZ-oZqxbWM3b38G6dLgcf_aLVLMbor8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SF4zhcprHmqbPFGuo32LwKL2wHq3pJxmiQEky-Tll6A&oe=6A43D016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AnpWsdxuPUQ7kNvwEA1NB6&_nc_oc=AdqZhBe15KNBp6-vc-MfEbxnHwcAv_y8z8-SaxYppYWeBr36K-7YPp7nqGc4IiEfdaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SYqS1IugYBWLQdK3VnOfmWTG7K_QADGnYy1TxoUJ0PQ&oe=6A43BB7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNL-SCQfCbYQ7kNvwG-cTbd&_nc_oc=AdqkBuv_k-WoOx8D0gzliQ1lFzLIMUow063VS81bxkoeoQfwDgnWh0L-_naa7t8_C3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9riK8T18S1TjfFCEt71KC4nGom__kWRRKFeqH9t62CKQ&oe=6A43D0E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K95OWaNsT5sQ7kNvwGfLjG2&_nc_oc=AdruGcHbPLcRlPTIBSxCB4OjtGU9rIfDspQpBDIGmO-Y-EF9Whmqn8Dx1XlF7r16L60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r-G5NsD50HKYno6aLPmu2I5d7hCMTS7L1N3rCKcGmfw&oe=6A43D03C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgbuFUy3sWgQ7kNvwF6iYPA&_nc_oc=Adpo8g8I5eIAQixuTLeePsB_MD0rvIHc0zHTTaWpm95rC351RBpJ
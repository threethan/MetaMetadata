.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L0qLvxN2wIQ7kNvwEH1bFd&_nc_oc=Ado44hDQmMaAkBjCI7hLwF7bRIhBxVK9HHVA0J5d2fGfAOvRz0S-ftI9tzFaO0RzaXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P3eXOrkIjyivNT4rd9D6cbQtq0BACh_JBsRW0PulReA&oe=6A37F701"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHLeGgC0gyMQ7kNvwG9T5QZ&_nc_oc=AdoMzuMtU4kR1ZkKIV9Frxd2WfmfdiDrW2At0Eqjx5C994_XBzoQR7VupcImnbQvFgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-txpmREDYzmW2IWcaoUiRmnr0gqd3krOs6V5B5v3D0YA&oe=6A37F296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFzN1QbsJNMQ7kNvwEjLASb&_nc_oc=AdoLB9WoSCMyBHsIRpTlhUzmVZI-b8AXa9UMVy2dhOsxIlN1gbrPRiHNaZEt9b0YLEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Th_AendIiln8d4ZY_RRpnF0YRdYUQHcqS6f_Gj0Zs6A&oe=6A38163D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-Lz6IiebdcQ7kNvwEwKGle&_nc_oc=Adq408yY9vca1b57J7mnl9CtY7OHDQsLNNYcDeSwsvdkw0ER0b7V2aVDSeRLfWqHJf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EcHO9RqdQ03zqKGhYf4FHr8xM8Vy24-dBiBVtP65gFA&oe=6A37F364"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnAd6UxJXq4Q7kNvwGtH85s&_nc_oc=AdqD4ul89UbncLIyOpRGWPxB-AHtpAVGnwiRUDiFx2K2GJPpgsQMDU7k33TaRnKJq8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AwvHRFypFjuVeulQzoYvLxwQLTkx1s3sUOI9Tbo_z9Q&oe=6A37F2BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfKl_AqaQQQ7kNvwGE7ogv&_nc_oc=AdreNP4m97Ard8MRhU83UH-C3zIIHzZ8vRijavaK1YOxwvtJD9su
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdKSxyOUMoIQ7kNvwH9EJkU&_nc_oc=AdpYYhA2VwVpcZI3tEqPH1rCJENClb-I7iqWvLoqJ6g0udpRwxnaXVGc6c-ZO_gIRDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv-NdEYtNWadAIX1Zd5DEL3p4baOwI05XZhJ-qHSF1rQ&oe=6A86D8C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6SDqGqxdGYQ7kNvwFspnCP&_nc_oc=Adpu6nvgRht3xC7landA3nonoK2Cp6CfjPTXYbgY-4VPmBb40BsJfb_cENDlmRSekeA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGljML-REu9ntvDzxudmwfWuYxo20zR2NgOybCjnIq-XA&oe=6A86D456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wJti2j3i5YQ7kNvwHilf1Z&_nc_oc=AdoYUuQ-WNiK2tua27-Zekvpy4rQC0QpCIV0AqXJH6PNDWIa9v8tdE9Kt8UvnWrpqQU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2QTMBA9MS3wS9bjj8KH8yG5gwJaefy0rLU_w3U_gELg&oe=6A86F7FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5xREehhAUYQ7kNvwFCK3gz&_nc_oc=Adqf8rYJ2TgG0yEniIlSv0rt1r-TQPNpWPu8AB3Su3be3UookW2o9FkKUVf9_9VW8dM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUAFk9_LyzjbpBk_UpX2NHfpPmya_PPtMuH6B-P4wN8A&oe=6A86D524"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrGcAE2zHmsQ7kNvwFAeTfy&_nc_oc=Ado-Udw562fSjxmzAjGfqW7yrC3iZe0xigg7pAVh1y04wLambli27ErOytqqkfVwZUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsJ3ie9RksNfcr2xxxIFzK85jsRZd2j3hMEodfGtiFag&oe=6A86D47C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRKux01TwW0Q7kNvwFm_yUx&_nc_oc=AdrnYgMYzcIzPdhjXhzaALck7PndSI7m0UhJ6pl3wUCy4RnqcOPF
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXyFoN8crgYQ7kNvwG7XCJc&_nc_oc=Adp0ymcq0yA44yUuZccvOcGQXdBavkeNk5M9UWejdn5jqmHVi5GQR7uczGPy2Oojb6g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD4q-kM-ab5wgl-09jDdOpBf1R3SeaJYDGPMCIrcV82Q&oe=6ADCC281"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQtvdR2sXl8Q7kNvwGI6dRa&_nc_oc=AdqVvQnnxWNkjvkPpMLDeCp9txEvQWZnSYGV7SO9wxgKPUultf7UNUQuQm3qZh7_tk8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODDcTk1xc9gUduqPgyhZ5DA4kefKGK3hme5PedTXK_sA&oe=6ADCBE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ilMOpLun1EQ7kNvwH4ueda&_nc_oc=AdouYbdBYhfAhPuHtDqo6ldycZ7QrZxXarq6NGLH7qYDaoxhDT5ZBCoiSPIISVb4t2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrKyBKbrvUXf893F75sEIz6g1sQoiNZ2_b2n59QXXaow&oe=6ADCA97D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKk6GKSgsGwQ7kNvwGS2gut&_nc_oc=AdoYVlGX79NdeKXBvDHkJPJ8JbbK2Q58o9IhmNfaQiQX52QGnUYPh9QizIWWHwDw1MQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPguBYjuAJs3RMaMBWEf8c_wJ9UDWMH4mBmoTzjvE3-Xw&oe=6ADCBEE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaSglx2zi9IQ7kNvwHmIToz&_nc_oc=AdoSmlpR5_WXD8axUHLA6KwNFf8dWsi7aDvfOvXBmyfLTn3ntIZYRCNFx_BZPzrc6vw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvxRHhksnUEsmKyAyVhzx1REY2VNmeWQAEdB7cw3eeVA&oe=6ADCBE3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdC3vZ0nC5UQ7kNvwE8esLY&_nc_oc=AdpDPZozgQWJFwWkp_cKlEY_TFmH20DGfav5xSdbMwPoG6-ZsTe0
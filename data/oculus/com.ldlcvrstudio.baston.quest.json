.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk8SXGoL0dcQ7kNvwEYG_Av&_nc_oc=Adr3ypke015WjbVbH4udNBroi2PvqrilBLElD5CJJFMuB3B6j5mpXc9_-bkHTm5GSC0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqflrE5MKyiZuCCO7lPZWLCBXUG7uurcrHY02j-zrSmw&oe=6A5A3E01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKFdWwujs9IQ7kNvwE9OjyF&_nc_oc=AdpQjUndCrK-2HTFdSV0J6besWYqT9NAW6cPYFBEdCZcmqBI9VMzqSvrDUEPttvRzT4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrGXqGC23LLI5OEktMYUbCxNKFS4HePFqTm722qRdsfg&oe=6A5A3996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSgPcyVMZlcQ7kNvwHogAzw&_nc_oc=AdpJEga-7fwJhIThQtRVAwYYFQOFmTGN0Zzmv8EIX38LJCRTOutrH88PPgaYTq_mHo4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2TgmNbW6koHeZn0PHz8-2AZvnYS1oJyT1x1thr9MnLA&oe=6A5A24FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUDWHqn9E0UQ7kNvwHiuPUp&_nc_oc=Adpcw0zXxbhCYcA_g5CtrYL3n6j9SNPmJ4rVmMX3zCHhHw0Q4qSc9Wn1_Nf45ZgWw0M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7kOmM5LR2_y2Q2fMfcU9CmcicYQBbpZAZDH5EXFG8sg&oe=6A5A3A64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzV4vM83BZYQ7kNvwG-fRZZ&_nc_oc=AdpLhsfDjtX2bVxLhUHpG_8KLPt5Qvs7vrg9RxJmusbbLRAUAdFHvmaYR3hAzwvf4A0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc_rTUZhVZMyFX3xDBxfaQWTv9EY1nFQQZdjlt1qJzgA&oe=6A5A39BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhGOF-tBPqQQ7kNvwEPg6Ho&_nc_oc=AdrczYZYF92WXXTE6QnwxmJ0wuEfc3NbYFuIeLapTE3ki9avq-iS
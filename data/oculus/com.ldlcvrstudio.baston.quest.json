.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD_1TWj1xjYQ7kNvwHvh_LA&_nc_oc=AdoGfiTwCMFEAgoZy9Zxu0mghoWORv8aHFe62Bf0BgvVX8Uc7MpnMU4XOxyWXRl6_i8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SwkwWL2_LPiGYWmdbSi1aV6-QTy9Lxa47rpyuGg8Fww&oe=6A2D6B01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ua1IAn0CdUQ7kNvwE7_RkU&_nc_oc=Adqar46kEoPGPU9W6RGmDgwNW2jc0AI0hBSTp9JPMd8TAnPZZOZMNb5X0BrfhoZbn_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R53EjeOJjCD0B6v7uvijUJT3fFeIdJZPuyb7XMMgcbA&oe=6A2D6696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DAXqCnflVQQ7kNvwH0dstq&_nc_oc=Adqah8lQvAflp4hGnQqhPt7Kcoz90NcRj5j5Xkuq5uJLAwTxswTLVE3JURWV9H5FD4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-65IIDv7ow-WKNd6_yC7eJHzM6Mcjn4uZHniTXFsb-Xg&oe=6A2D51FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM11OrhSMBcQ7kNvwFvKWzc&_nc_oc=AdpdY_1fNsiAA_xCjYKJn1MZ9soprloA6f0Hv3JrSmKiccr3x79-edbGGPdmo5vOQrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-NKE4__0hJXUw-9lGZw-S1V1y1Nzqjjc9bhEa1pIvcg&oe=6A2D6764"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlBSxD5YuL4Q7kNvwG9ONHl&_nc_oc=Adq6WLG6PEuA3H0INLnBGENBkid-rZd1eNoM2vcxfflNmu3u_2GxpKVMrjVDRVKARss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i_1y77Z8w71KypIUCfyJ0nCoP6C2faxWqMiOYpJKpEA&oe=6A2D66BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_-YeXMG7gkQ7kNvwGxq1QG&_nc_oc=AdqVpujeJWApGGZiH4d1XpQYnlcI1JMPZqeFLlnhwlQZV5W_RRUy
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qzLIj94QC4Q7kNvwGHDEtT&_nc_oc=AdpCwUCilB9D4NueeTK3Z0JtOduASnQX1Bxc2E4CJ_WHycpdb9YflUcbrUsMu19Grl4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UNbgf8KfCDR9XKVt28adayI6qlGPXBcMxZ5e4_Dr8vA&oe=6A218D81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ww4QsA3ngQ7kNvwHtWGez&_nc_oc=AdpeZ2XSNsFJsUFuy4u9-yhVnrdrnJqwn-xPXZhIzlT2BzuDg2HykMUkwX18s--K2Yk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FUzEugqlXyyqOO8v7shGPUdF_n_P3ooAMgGW3rLpkWA&oe=6A218916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvVTMkb0UGwQ7kNvwHQgPc7&_nc_oc=Adrgl_mO9ixr9ybZfKP3BSg44F_6e90tuhsMEN_rE0HIlkvHOlAb4FnkfYL17zYlYRQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6M339q8u6EP1H8ej0J07f6v9Y5zuWRxqqWuGO32RV6Q&oe=6A21747D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H9w232Qo68Q7kNvwFRpK_w&_nc_oc=Adrr7Y0GMr271C59ImKFW-Gfo7zEYMMqnrAZE3FcwLZJFrKJlq9pz8qZz_LF1afDJk0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eaTsj-rc23rsRu1g1OnW17F-mZ4K1kNgiQEkjBPKLgw&oe=6A2189E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poIA3Cv_krIQ7kNvwFAZd2D&_nc_oc=AdqxWOh_kKq9WDcoqENjMk30B7e-OexnQ7UEZGHhr9cJ6FeAl-W5WvnFm8kGvWdacLk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zKSbyMnHwsYbLWo1xUxrc5AA4WU1ue50v9qwOeWJBbw&oe=6A21893C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzdFXmk2LEQ7kNvwFnM4OR&_nc_oc=Adqfj6G9_0hQtRlTGjzgxUpFt5VNIW-J-ZHwSrnjNsxn-PkfuTSp
1162446619309842_4882016780126414533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUWajQFAFC0Q7kNvwEpqV6_&_nc_oc=Adpb_DYVOlc6g_UZkZwv9r6onpa5Ksl8tiEwDKHGUBPCsGBVdW_XOtzmhSpwUvnBFUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydrkp2IhDBapcWOogbPmG-TvGc3NRjZVSMzdrZmJdVMw&oe=69D0F4F1"}, {"file_name": "Screenshot_29.png", "id": "1153213020336966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_1153213023670299_8282150417532215900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4Mr9HBogUoQ7kNvwEWxR38&_nc_oc=Adq4Sc2jtcwDI45dLyrZVddYBuFZqikE0_kHCTqSe9898ixL1uVbkCsoJEVFsWwxGoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_PQHU5GGR_BwMKLul-xvd4ZjjXyoevs1Bhfc8CeE_fQ&oe=69D1022F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1721481028535123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1721481031868456_1060556618134437396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7KKpvVC7U8Q7kNvwHlsXht&_nc_oc=AdqawO7ZoAHQ61m38vwFjhnHhvwpLIuohOi0M9JcD2hbimxb4cWKtM4EUHyaEPwvOj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_EGVvDHzuIK5Ty4DM8dcp8_YwzhJqVFkAMWY00jHWeg&oe=69D0EF54"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "fantasy", "tavern", "punch"], "long_description": "TaVRn\u2019s Takedown is a VR beat\u2019em up set in the hilariously messed-up world of Naheulbeuk\u2019s Dungeon, and developed by VR Studio LDLC.  \n\nIn TaVRn\u2019s Takedown - Naheulbeuk, your mission is to save Mliuej from a mysterious threat that\u2019s ruining the local breweries. Bring order back to corrupted taverns in immersive hand-to-hand fighting! \n \nHow? By punching, smashing and throwing anything that isn\u2019t nailed down at your enemies: goblins, humans, or anyone else stupid enough to stand in your way.  \n\nAnd you? You\u2019re just a perfectly average hero (or let\u2019s just say\u2026 an adventurer ?) trying to save the day. Or totally screw it up. Either way, it\u2019s fine.", "short_description": "TaVRn\u2019s Takedown is a VR beat \u2018em up from the world of Naheulbeuk\u2019s Dungeon, developed by VR Studio LDLC. Punch enemies, break taverns, and fight for the fate of Mliuej\u2026 or just create total mayhem!"}]}, "developer_name": "VR STUDIO LDLC", "developer_privacy_policy_url": "https://www.ldlc-vrstudio.com/pivacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VR STUDIO LDLC", "support_website_url": "https://discord.gg/TNazD5geRU", "website_url": "https://www.tavrns-takedown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "ja", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25397202896630643"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1290518126363493"}, {"status": "PUBLISHED", "id": "834487779601941"}]}, "baseline_offer": {"id": "1290518126363493"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774548000, "status": "PUBLISHED", "id": "1290518126363493"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26171195355898056", "version": "1.1.2_11371"}, "id": "404487178801899", "channel_name": "LIVE"}
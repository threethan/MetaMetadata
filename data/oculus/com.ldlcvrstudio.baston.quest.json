.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkvJROs0jisQ7kNvwFa52r0&_nc_oc=AdrU8JrbHNziUldD667XaFk3dzyBnGEba2LBQsruXK1Ci9subgudTx3tS-0h1BHWfdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcer1ExWf8DcimGdnV4U4RPFpqGFkug862SO2AWERl2w&oe=6AEF3781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqxcBAL5lNEQ7kNvwHvp3YP&_nc_oc=AdpNqDXrGYEgNRJiJxcjjQHxYD63Jfj0DqSI9bVBxOCfcCAspdB6earDVmLH1PNEKPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOfqfsfcuQ7oAi0R7JhcUhH3V0ANPJJOci8z-jCGCoOA&oe=6AEF3316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xydWS3DxPmsQ7kNvwF_odxK&_nc_oc=AdqS99mPUtBcgu3fW42KCyU2TVISfsv5Yba1QKYHmJZd87XPcmIcGf5kbW1aW8NOudk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOZquMeMuXe_w1G-O-KsBDlBNkwrVgrnnWjjaCIabIqw&oe=6AEF56BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw-y_dDvA38Q7kNvwHBonW8&_nc_oc=Adpo8QNb4Pfrjo5cJ2vVckZjyLVplbvmdzCEl4XdG61BPD6dnrOy0Fy9A5lPx1WkIbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfXJvnyulHH3wIDAEZR8HoP9gaTe98v99uwLOf-Qz9yw&oe=6AEF33E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSn-v5jO1Y4Q7kNvwHPL4mL&_nc_oc=AdoJRCbV3ke_p5ttBNpnb9AzaPE4wUFl9SYT4f88soSdhhhwR23BAiH2A-DT1xjMVME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWDcI0QKTE7s-6OxzouCMvp0-IHmi8Xm0CdGRqL31cMw&oe=6AEF333C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnS2bonLp0oQ7kNvwG7S7Hy&_nc_oc=AdrZEBxVI0efkQSvOyiva2tMna2Jor7c6LteSUYz8lHjuXkR0hXX
x-6Zrv1g-2KmklogUlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRF5U6qrsUGfANA89IUrhNqiOxzsBDdJAxNypbixVYALA&oe=6B0DC460"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFMZ67SUhxAQ7kNvwFLQ67L&_nc_oc=Adohfa2s60N8CS7SqPywiIITeVno7J1LYQoMGEsZMo-Y-X4ydwHGdCZbJHNg2QzaIcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGllMIe11qKDGiXp85MM_8BRT4YmvjG3CwcetQs6WKTA&oe=6B0DC241"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXS6IBQbARgQ7kNvwF3EGIx&_nc_oc=Adr5kv6A-u8BR6ixS0tj3wVyWr4j-alv0cBEyMd-UC9CX7X5MCp5ba_uhPSLF_zPCf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlka3KrmzD1lg0cGLsoybJK531fIe4dJ3kjhWmaZlyeQ&oe=6B0DBDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcFF52rhmkQ7kNvwEO9NZA&_nc_oc=AdpOgeDf5e_My9vds7Hl5fVJ0rtZ5XIoxtUCD1A5Gl5dA9JEnkTVrsq8FWZzgQ6SDJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg6oXMCBJXMTYCeGGBN-uoPEz9yQQHfcu_MZgaeeVmSw&oe=6B0DA93D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mitJF7-dRAQ7kNvwE_GD8v&_nc_oc=Ado7zKgdPqPdItHDZXJfAV5zjP6PpSqo4yqbfb_22JzkRZgOdnSAWHx05QFeEKtUeZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQO8QUSGKJOlN_uIhU9Pd2EKe2B-DsNY29jQ_K9WwP7og&oe=6B0DBEA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq0Oa6pPhAQQ7kNvwGHlyic&_nc_oc=AdoNff69eKbkAvQisgYhDo-6ooUPSEOZb9icQZ4rRCmamQtflqJxt8Ub78DQZ2JxY40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9zJMe2OJTbthfC7_PMMWy5iOxZ4DFkBSGIs25ZtL3yA&oe=6B0DB
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vo7R4MiEzwQ7kNvwF6rifj&_nc_oc=AdohUNZS6rU9P5407OshAkNdEszvFCG1ghbnSrKH1Jaw0QLwlah0tJI_emzbwVOGPv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2V3d9VD_ErfY9tGWXhzcmEAnDaHicC2AiBc5g5qYHRg&oe=6AAD4C81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu2r5CNQI94Q7kNvwFdfSsc&_nc_oc=AdomrFmiAauLK2IL70Yg3B8VLslNS_yUxpKr4_cSDtaC2mujdkFx8qIgKg-lncfxiGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKHnXPDsUCJkSLbjBq70_dsTTGKaFAewGUSoC_Mvs80Q&oe=6AAD4816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InIVvflp8KwQ7kNvwGCCtcB&_nc_oc=AdpQTHBFIue9JzuWiSVYbeK-s1h84S4spUDpykdGuBzxvQBkhwP1vzdUQIP2tlfKyiU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpeTH10oq6oBGP_dcJk4qyql5EoNPFV-95_mt4Wi7Nxg&oe=6AAD337D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E-GAGCvSy4Q7kNvwGnLao4&_nc_oc=AdrtnjXWQXtM6hnvgmVKX6UHoTKymhddbllimQqVzQqCOg_wSqsp45XEXEPwpsj7WfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFzA5AWAJ7o6v8bddbYLXFm-ESuvKyW2aaKOAnb6DrOA&oe=6AAD48E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkxGBezgGMQQ7kNvwGr9NO1&_nc_oc=Adrc-ahe9hh9Ih7AcdbmPhVHEhuiiB2eXcZdJ8rItK_nbtj4DUFuI8V9sbkE8_wscP0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICri6BrDBIIcyitlZHOzYioJSSifTeB7A-mOvV971fLw&oe=6AAD483C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0qH6InlU8EQ7kNvwHo_hPM&_nc_oc=AdpFQsiFBC7JMMpKal3_YqbnwzMOBHXGPW799ywaYlN6M3-yHweI
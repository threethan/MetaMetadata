.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeUhsOrkf4sQ7kNvwHIa9qL&_nc_oc=Adrt9X4BuzbWw4AqBnkv5SfsgdHpTMt0EFKJttwkymu-kPYZ4JQtOaXvOiCi_q-h6qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af543ivLb--CpbM0bZPDP62Md0FSYoP4iCHHjFlBFx5Z_w&oe=6A01E981"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-S1m0gBw8gQ7kNvwGmxpJ-&_nc_oc=Ado8hP84uBXGIOy6FjvCg24YbndeDHP6HUDhShzA3KQD0whZcn2Ym2QddX3BENINkOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67AUi0uvhE0aOYS1dvxhPN2ZsDK_v9dxX6DJddqNjdhA&oe=6A01E516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXOe8NsFLEYQ7kNvwGd5s4y&_nc_oc=AdqwQg9c4cdA6uz1qDUk6JoVHhh3T7iUOjCO_TonX8gInAh2SJLo-FduOdAvwzAdMSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57fOZRqAAT9bDiXbO6nlZeHDv6NaQzVTN3JDb108eFSA&oe=6A01D07D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PxzgL-435kQ7kNvwGnGSzC&_nc_oc=AdpS3PyEMi5yemrk-59uDmrv7pEmIGNc-IHVLa3Vk5GS_trRW7LMzer5tEZw8dFVYSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LUIl9jQrRJ9FLpGGjyz0mXx7hBLNQGsyln16ieSlkiw&oe=6A01E5E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5DeN8rRhg8Q7kNvwFvzd5C&_nc_oc=Adr_cXniaJ_jswZ2yaS-mCaIe--u-y-J5ye4fygTxGl_9bJHTDRX8qeWwosJk0CTpkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PLPAW6F0qeZn0DKBrZiGdZjt77RiD8cF_T1ecz3EJXQ&oe=6A01E53C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOHZnA7fqBQQ7kNvwH66XJM&_nc_oc=AdpR3on61B9MI4vcfYv1FZIwZXAzb28PcAwHkjc9S5oOExmDGUD4
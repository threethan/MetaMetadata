.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RmyCOpk6M4Q7kNvwHw0PT7&_nc_oc=AdrPKwqi8G1V8_7Tg5Ewu4bDZMpw7jpAIybOLTE-wq8oLvsyp70QhQp-iXiyumI3b44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wD6qM8TYCqDPGQf-8JydVazkRZR79MiQPTV-m74-HLQ&oe=6A315F81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGChz34FSSUQ7kNvwFAMjld&_nc_oc=AdoGx3UTaVfHLJr24RrqY_Lw03L9rAE2n8p8-XzU3gPZF3jUPWC_Ag3-yT_BkssgCjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q6Qq_4lT-9gWeOkfHs2jgMphx5egZSV48CZp6-h1Jsg&oe=6A315B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIn3XNwdl1MQ7kNvwGS6Plc&_nc_oc=AdoDcagk8gSysxOWL_0iZb2tlCwB22kfTfVgPnffddOK4DqmGxn11lk5IdQmW6E_EJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UbADHmk6itUjlptigiNKn_icB-vnqGC3pDEvqKbHJog&oe=6A31467D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZbmWh44BgIQ7kNvwHxoyGN&_nc_oc=AdpQo7yHuy4zQBlgeLMeI2rxb8uhsSCmiJ64jFDWPncyYDmWDZuEzfC1u9qARbV6S0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-fmgwgCcfp1YwqS9LNrM2dHo9OTOR6xy-lZl2_ykAnQ&oe=6A315BE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUnEZA-LipAQ7kNvwGaW89u&_nc_oc=AdpzBSEpWq79uygfBPp0YZX81yXKQUqFdTcgPbJCm5E3hT_w_Ii46-CeBnuS_Ul346Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gSOYpdixavWPjMPyqI782ColRyNJAtIw37zoS6hTjrA&oe=6A315B3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O76oJtn5sYgQ7kNvwGRcnfz&_nc_oc=AdqgYYtSh_LPLYEHIDn1jcY0dKRqBc46jkwdT4ubPBhFtO77rkDm
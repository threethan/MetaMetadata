_nc_ohc=Tc5-4Kj4U8oQ7kNvwFN5k9j&_nc_oc=AdrTqHX8XxLKitJ7vtdkXvJrVN5Uq266XBNaQ_bFTTuGrT4MgdY_gUxADf24XizTUL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2MxpIZbYdk92-9HkELWBE7AYabvPK8WhN7fYGbNcksPA&oe=69F0C601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daf5gIeN8AQQ7kNvwFm2htx&_nc_oc=AdrRMqwFgoMzx82fGagUBjq8DK8DYdv8uOtzZSfzhtkMXCjpz1oIQzvS9SSd6T98EdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2pnNKajdCdnDlQZTA9kZxN1fjMgcGV6B_TLNUZZJj0Bg&oe=69F0C196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX2r0CQMJmEQ7kNvwGzR1Lc&_nc_oc=AdpswxHv0yFJMGKpWisrh8djnrAKbka1QdpWtt_fJwphZQyH6hpEHxEX_NvWawTc5ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1sJsXzJPP3TUfOdwbur7HlZiDgP3V38tmzbkiv1_EQnQ&oe=69F0ACFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DADddy9KcmoQ7kNvwHvW7jt&_nc_oc=Adr6sF0C0oN3Jbzb2kfhhVbT0htWWy7dwOBVlxMZLw8ncS1slBaA1C0e9QFHWO4U9Ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2_XldhXlFhUwcXz0AX9ERtahJz2ZCTyoV7QTKmFhZaYg&oe=69F0C264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DDd_dQSQ4Q7kNvwG1D_g_&_nc_oc=Adq2TndkpiArW1mivfRLYH1tDisX6hzNBlUUWtzoXFiJovejoSpGs0JRXd8GQH5dDG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3vbt387CVDnXEVrxW-zBoxsTmsyPinUMumJhFqM3eldA&oe=69F0C1BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJoyUVlYrFgQ7kNvwET6t3O&_nc_oc=AdoRcF7WG7XwluqUdM3Xu02odNNX9GuVsbL7GYuD-1O8fVqK-EENcu87ARtz1Y9IXH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3aGnlrNmqKP-PCVFBxvWnD2d7JT6G7T-gz64J28gW4ZQ&oe=69F0A741"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1687600089064805", "image_type": "APP_IMG_HERO", "uri": "https:/
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VPG_6WvyAQ7kNvwFrx9CQ&_nc_oc=AdpQM10OHYh09rhwrwgz2CbFSwB4GuSmR9nLMQEyoekrlmsRpOVJ9czZdschEyEe7BM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FtjlRiAdNvnKqpJf2ExGwWNja1zBM3Ijp_w0pdpUkMA&oe=6A0C7581"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLWD4psPP0QQ7kNvwEuYfyw&_nc_oc=AdpQDNxNBIeXXA6VQQ8CSfrQYfcuP6KuD3YN6NST-sU63g9vKcv24XZwT5q0dw9L3nY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tdFXW8v0to8iKpl6p927DlD221VBqxsjaEYPfX_qljA&oe=6A0C7116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFYZDzuY4vQQ7kNvwHqjxiF&_nc_oc=AdoOT9MLBfV3snjGNWEZeA24jTq4FBP6w-8v4Einy3351uvHtm955MI6hMF9FZmBS2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QFY2DMj_JNSrEYJW0_uv7REBKoXtaHq3ROr7X8_L0_Q&oe=6A0C5C7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRZ8TDHUNqgQ7kNvwGONh36&_nc_oc=AdrhNlcGQ2tmEhMLziXkeDe3_RZmzHCTbEOCXHeqJEoyQC0jHlkumGFVt6a2VmS7qQs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fdJZE6zPX7hC_SYVLHJBX81tNgSpmIFg7hw3phHS5wg&oe=6A0C71E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7utswaKgGwQ7kNvwGQY-Gc&_nc_oc=AdrZ1KS1DqFgmmFVrOHlRw2H7eF2y0iwY4vZXX210KqG42Y3v9E_a1gpEXfmWXZDseE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vbe_vcPJMAPkNL8A9h2vKBJygTTP2m6OHsCUk7Kl0KA&oe=6A0C713C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL9l01MiN2IQ7kNvwFpzJt6&_nc_oc=AdrbYipZLhFsdy-o_VZDQs_Uaj44ooaZTvHKPwEsyIXvxgkmtvKt
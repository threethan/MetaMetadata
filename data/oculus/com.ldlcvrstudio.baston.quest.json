.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXLBpHb2LloQ7kNvwHY9o17&_nc_oc=AdoG30rB2Jl8bVgyCWOwzqqG0JafYSPmbhdxbR0d8qNPP16SwXEYYGQbCANSTgnmcJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa7Ms6wIXHSOvptl0D5vmxjqAMWX8dIubGs4DJztlvAg&oe=6AA80681"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPbjn9c4AKkQ7kNvwErvO4E&_nc_oc=Adrhpquw2xpByeFcf4u7lZu-COHhYBuxCHir9juErlXcowV_Upl_cc0Q0okYeultl4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFud3mc-I0ePjbX1FbgG6j7WiDqkHzOPqes3UrP0rEcw&oe=6AA80216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhUAVq4Px0YQ7kNvwElw776&_nc_oc=Adrol35j5c77Vue-uI1XzvA2KBBy3bjuOouqxsWM4G-lrfPM44Sww7oQE5OkQOiX4lU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIYY6X_o9928hedjJivH_DfWHwjVsHzgznDc0gL0A_JQ&oe=6AA7ED7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ6TB4RN9KsQ7kNvwH30_16&_nc_oc=AdpW3sFGEJFBW_g_ujOjwPnKt4tszbaCSjr3S4q92pWCEfepUiLwBu5wbQD2l7aqPt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpXV4xX-wH-KPNWehnV1GJYc738SWaRS0ZcZus8Wr9Kg&oe=6AA802E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RThlnBdL1g8Q7kNvwGSgm56&_nc_oc=AdoHA69kFQDNRgYdV6c3QIBgibydohJz4YJNQZRfUms7dMFRtNZetSndXskAWDPHWvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJjcDDe3TmFwOo4dGAfMYJG8Z8kIMCyJefuC8q1LtqIA&oe=6AA8023C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFvI5Fx2NBQQ7kNvwG6-Say&_nc_oc=AdpfWSf1yflV_yqH43M6boR4G3cQVRupjbf__CtxLlPF73yV2g6N
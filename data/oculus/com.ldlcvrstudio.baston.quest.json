.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mYP7d8xVWQQ7kNvwHa_gfR&_nc_oc=AdqZ5sv0X5IH5xfnO2uaF8ppmOjURoIsUGthOnwsovYCaSzQBndBJHJiUrqwL-QxlTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLJnQXvBOeDSBeUhXKtv8OvMy3Fr93NBFKm9p4OquhXQ&oe=6A54F801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeO4aiTUntkQ7kNvwFZblI1&_nc_oc=AdrP_OdaYQwFzlY9OJnTmgRiZtRZAJ-Xu9fo6q7l1vX3FEYr4daUjzs02FGZx35rk-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFVF8xgRXm0lAY8z2zamRf7Ryn5e7sRK1faGFMoE8kOg&oe=6A54F396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC-4wuuHJrgQ7kNvwHFCUln&_nc_oc=Ado43zg11Vq2RRtZpjKqnuKVjCXNPT8RNvVeqXBvuBLrF-2fp9exnK75MwXL0iCU7Gs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB82B8poWowlzvNkWkTaKlw3nSL-E1FwaRVY3FhTgFdJQ&oe=6A54DEFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFV1DlVVBjYQ7kNvwGYOOJN&_nc_oc=AdrfqbQqzs6F9nLFlUxoRMFolzMAVXBM-dTKjRYNqtOxvOFjROv15nguNdDPUujRAKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzOaQnNG3cM0sRZFWI7xACp9pY28NIMfcQkZsjb5Km0g&oe=6A54F464"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49czuymjNqIQ7kNvwGsfeRd&_nc_oc=AdpB6jLgr9WDhh0-wvswUczSgWS7NH4S2h4I59UtK5iLcKx5ZpR25LG_woMcwKvEhKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI40gD8SazhHtSAyYKXg1uQZaJ9d3dhmTeIuMgvATs8g&oe=6A54F3BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hOaRvohOw4Q7kNvwENRgJn&_nc_oc=AdqEzP-WX7L3nlWjr96Xw5S-_ZGyXiS-1gv9ruZzWTfcCPz0SKx9
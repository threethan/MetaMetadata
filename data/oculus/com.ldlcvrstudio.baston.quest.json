12044246292", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBkFQFkRob0Q7kNvwH0J0IY&_nc_oc=Adrhc0GeLZGKB2UAXrc2hUipCpS2GQ2R-DRqWuTrMjRH9CwQIaKcgScEetxj5hX2yw8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XBHw3zgzGDd1orlhLhZup47wT8ZrSKnNgDBSNRWCM_A&oe=69E63FFA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP_ecJxGWtcQ7kNvwH01kWK&_nc_oc=AdrPcHmlITq43qw4XExt0bpAKZfnZlbvn5sqU2ANG5RHkH9RrMH5XGJ1DvGx1Jlxg7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d3PajbqvY3-W7rogmCraWxPtp94TYs4kFkBM32Ia9zw&oe=69E6242A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=tIUxedBJSrwQ7kNvwFtEaPj&_nc_oc=Adro-CYKaN4H-b9tDW-DcYyEH5rKtmuCrAxntZbO062LV4BQFQeN9w181ueCs5d2jTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B7PN3VWnUj-OH5AeKqBHAQz4Sgwjz1yDnv7LyHDFD1g&oe=69E643C2"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGaLqtS-YJ0Q7kNvwH0fzjZ&_nc_oc=AdowqQsJsnHt7HjpN5ZRBPW8M3Cg8DWE6v6SgoDA4hN3qS4OL6Mp4QkRMoQ2wqB5RrI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QyHv1iXo6fRMwCkHdz0nZ2wNY7nQzuhSOXU5lRtZydg&oe=69E637F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUldmgpt23MQ7kNvwFp0gxR&_nc_oc=AdruYUasLv-ojD14oHAs0LDVog4GrMRTPmZ_JaL_1o24rpWEaAg6g_vlqeI5Z-eP7aA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nsUbGzHYL5ZZTsIKQN5PPQahiHMlg2_qcU82-X8psaQ&oe=69E61FA5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF-r001oq1EQ7kNvwGOTHzF&_nc_oc=AdqURQyXjId_YN3m_wzui8fvv7O_h9UHX201VjYp9Ffav14Z1QnFxl-s9x69xWYZwFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04LEVB_cff9J5pZx2f7QycUbMNDJpYTDTpB
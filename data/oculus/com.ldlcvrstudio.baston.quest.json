.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlGC0ppUygQQ7kNvwGe67no&_nc_oc=AdoA5EEyfweXLomHCw5G66RMohFOEBA3kj9mCb2g2QWqCRbVZAUUoCyqkdNrmE8MU00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55xlRe-BDxoz8eStjB8y3O30wFpOAohYnap7iJJCB0Ig&oe=6A1D9901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aJVhLvjhJgQ7kNvwHWMqUl&_nc_oc=AdpIN7Cvsi04Sr1xJvQRqPWuiKk8Qb3WG35hWOi-fK31Fbm6C5fkDDdVPfM7QHJhcfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62jO6DFq3189te6Np7Cm7g2jQRc3Ieipe4l9UoteAE8A&oe=6A1D9496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZq1smGpMe0Q7kNvwGRaxey&_nc_oc=Adowbr9BnxM93YwkrsZ09hqYG1yYyYJxrL8vLVhfFc6FiOzEyoSls-NvNL4t9p1glVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZKmKctt2FeBgfn2wC1AtH2nEunAMtDdCBCiOjzySr7w&oe=6A1D7FFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXHXUvSa89cQ7kNvwEVUMeA&_nc_oc=Adql3iaKi7YF-20-5YhbOziFPjYDZhJ9DxjAaXvZAB0ak7pCFT-B_mSAoOsc6waQtK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DbTfZpRZS_VNEUahIpvj-zdREV43ZRycn8ZsXpAOmVw&oe=6A1D9564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLp1bN8wJDcQ7kNvwHo2OWD&_nc_oc=AdqXiW81aGIUuq38IYGYnYy3RUy_xBLcbkcEbUQe05ZPUP30eEB_-FGD1pUisnFOfTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I8gnOlBLUqzecYu8IamzBH2r-f55Gs169ND8Jgx0EGw&oe=6A1D94BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt2FNUutCVIQ7kNvwEwvUL5&_nc_oc=Adpru4cYRfehm4iVKhHJ1UciqU7ZCvDFTMQXk4VlM9zDsvsEiolG
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc5-4Kj4U8oQ7kNvwE6bjlp&_nc_oc=AdpkcH3I-tj0ACX3u7s25yGoWUODTdhYQ-cwOnly6tr4OH5dxXD36STfWqgdMKAbyBo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IBjiCeZvL010g37UfzYU_yjO8YZ1M2vIUBsnlVckRGA&oe=69EF7481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I92y3qbbuGcQ7kNvwEPRB6d&_nc_oc=Adq_pFqLIu4Hhh3EjzoClM3Nd_Qi05kA7e-QKa3kqyjR2hbaa7Io1OtoprZvvA2gL98&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2azasMlbcF_0uwB8hzAUJEQKDAw8z1IwkA1Cfiv_H6Dw&oe=69EF7016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_J5vx9-HRwQ7kNvwFfwC7I&_nc_oc=AdozPUxCXSNE2YeOtKMjX4sIgz5Yi1UmD2dnoPo6dv9cUPqdt67tflFYdAhL09V46vQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0r2EgMKfwmmEmEiXEcK6kN6qxfInWFC00MqIRGukuHAg&oe=69EF5B7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DADddy9KcmoQ7kNvwGlbW8x&_nc_oc=Adp7sGgFVPMcpcyhMHlHS0l_I-amVdK7PdcBDpQ3HZmK433-tSmO16AlJhezzl_epWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aRbytERkFkyCcCkSfuZNwnewxUVeuT5On8rILFAaGBg&oe=69EF70E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DDd_dQSQ4Q7kNvwFMsXEg&_nc_oc=Adr9ECOsKzdZyV7nC0ugrWnpJbBeh_zmmOhs1iqB75bkfuiNImar6RMYVwzsxNC6-6M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vL2_klFBH59FSFVOGKaPUlSANT726LgS46PJDZz1vsQ&oe=69EF703C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJoyUVlYrFgQ7kNvwHBbb1V&_nc_oc=Adp0yvnLZiOY83o6BDVB7tmrbgIyQ-nGEV-hHYB55yhJfTNhwZyuRmXDjSctP9M7iNg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f
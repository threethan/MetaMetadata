.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAVVkmYIuUQ7kNvwHwCbR_&_nc_oc=Adq9Obs0oS1eZadtLvp0y5CiKEoa4A8_ZOQiHbKPBBW8t-drQd_hw-nSN9ScBb4zq30&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO_zOH4Fiu-8bIsNXxF-T5N_MBEClKnvlC-Wz-_oUF9A&oe=6A564981"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeO4aiTUntkQ7kNvwGLf5LU&_nc_oc=AdqAhQtR6VHlxRp5NGFDlTRPnbweyx7HXrM01muoHumV_GCnpgsA0gRkUqh8ZILyVAg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRGmJpi0622TWXfx0csSXBwm8Al8NMfdWaRlkGuxFYRw&oe=6A564516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC-4wuuHJrgQ7kNvwHLxRNH&_nc_oc=AdqU9-ysARtohXHJWjaTTzgX6soUzc5d7k3GLAaJDIg7qKSf7fUUjHegydL0Cnj6JRE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCxI3Xr4wSHf5peqFm1UphLxcNku3N37hG40urDo3ZmA&oe=6A56307D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFV1DlVVBjYQ7kNvwHrWcVN&_nc_oc=Adppkc6V7SR_robdMfoBe39ZaaRFtXtaw52dmfkLWF1LNydcXNaZmkiLig9SApVl4FY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk6wp93zoIOm06JKOH9M18rI_X7qnkWMsKiUin0kS86Q&oe=6A5645E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49czuymjNqIQ7kNvwE2hZEr&_nc_oc=AdrMNfOpx75RGPWDoXQIr8l3FSmTUqxXpXygKDhScxtrwj4xicvkOT-A2LzU4Zfb1ek&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVau3FcDV_3vIyXvQXT5nbJZC73ljQDDzJT0XmgLB1cQ&oe=6A56453C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hOaRvohOw4Q7kNvwHjiEmr&_nc_oc=AdoWAbv_HExDyk-MuyJi2faxwM5oLe64cb1IbG_bloCV-vd3STC9
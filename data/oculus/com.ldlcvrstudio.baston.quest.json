12044246292", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lyBbrCvAQUQ7kNvwHIY8Js&_nc_oc=AdpHKsihzFFCTysJPmFEKTNDiAQ71fthA6Tczmn7HwMIm6-VnJe4aRk3OTRg2vJGgVo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XVHd950WKZ_uJUJRSXQz_O421f3DI2OEF7kAhUIfJeg&oe=69E24B7A"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izun9z72yuwQ7kNvwGBnv_N&_nc_oc=Adp2g2_W6US7ukP4NBe8_pVe0kfMxbbYUywC8GPIKXADc8ELSukHtKve7rtEJn4Jyvg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CLe3dyWx7B9BYgBfMj5gkrzCSz8xMb9bUy6wPKeHgyg&oe=69E22FAA"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=FzTyZd8x50QQ7kNvwFPYhWR&_nc_oc=AdoBYQttlLooSsY51-CuQmXllafZ4-eWfLIjK6CiKYOX52REmxJXj-jEYg3AatpZgaY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22E7IkD2PLrQrNQ2_t4AGtnaZxh_vnPPg23sDvq3RQMA&oe=69E24F42"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBWQwv_UnvkQ7kNvwF6nJdP&_nc_oc=AdqW_hUGgu5DZZH1XzyQTrFUqFsT02bdSmNTyIdLzLHKahuFBdNcZxjfvBYKbDN3DfA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZlonT3sCD8ikwwdvO-XLYsgye7u_nMhFBfkFA9Esspg&oe=69E24371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbzl2LMp2GYQ7kNvwG7fAEU&_nc_oc=Adof7L5GgaOcpbT5fT2FrXelOo6dpUhUlWOrQ-2HEfyRNKur78byGfOHQCjXrFnfMQc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17GbIrwIHOwyr8f8XYLf71kXfCKJ7jMwOeDJKwauv5Eg&oe=69E22B25"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KKF-9ibwkUQ7kNvwFQuEiy&_nc_oc=AdoympbiVKVBNfpFtw2zoTlKUpS0M3PHdF8Hdz6SFwgzl0T0jXoiQ1IxRNpt4tn5Ls0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vyRXbPLQOs8by9eG6-xE2qDAKj3ex2rceP
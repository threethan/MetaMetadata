.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OZOyMjBxqsQ7kNvwHHceoY&_nc_oc=AdrQJE6iR6s9udJhRZk1tHf7kx99sjqwOW670nz5Tr5aRHMxwjPMzx2Mp7oYsX4-69w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1YvNP6n8eEYjrL-eTh8M86jGnO8Ac1JoO1AkXCYVrHA&oe=6A4FB201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WlgTN69HUAQ7kNvwE6_ieA&_nc_oc=AdrcUguAfUPWf8IyhgiTJ8b6aebqB4jkMwieWanCL9SfSso5VmKlaVDWNT_m696YipM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPHIVqYuAVYk8DA4jIzaaxGBu9HK1s8cIB4DmxmnuJMA&oe=6A4FAD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpLZ7rw3kqsQ7kNvwF2ayRw&_nc_oc=AdpnFJXDwl6sAY0p4ZpThlUXcPbYCamsqEjuzYZ1yXHUcU5nc8KxS6-yGEp2BXogy7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE9uVjRgiCb5fVj9bHy85vLj5Byp5pI7bqv5hQz0ikQA&oe=6A4F98FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIdTkOrFh2oQ7kNvwGl5zj6&_nc_oc=AdoTctBGkfpdQKNE7kndTDUCkSx5b1TX7bEWsn1XU7Nv7sgwTUwczAuqmnXuYQ0nb1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD8wkr5XPCWtbXxqrtgAPKZACzT0emxD1Fxxv-S67ufQ&oe=6A4FAE64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV-FgYxR7MgQ7kNvwH5wOxs&_nc_oc=AdqrWEItQcyHeyTvFVTAci30QB381G_mhwhZaeZZHvOqXy9i8hwfH9-HXDXSNUMW6Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzq7NNVkSIckQC6D0xpetfyWPcRXcevNYH1xQlsi9zNQ&oe=6A4FADBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8ZHEuVpcW0Q7kNvwEorTy4&_nc_oc=AdqR6bU8TMsRN1LB3TqV0u1UAkzBzDlNKWAC5tQ9ACk8KJubCeLg
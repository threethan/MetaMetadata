.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOtoza0hEkwQ7kNvwELO8BW&_nc_oc=AdpzRer8gk00nLlFIBYjefRQ91bbePwiK9rHIE6O0-NrajeG_hiOtaJhyZQyk2UwPrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LWcOdhhgPsmuP4lq8NnU3vDkcFgvctKxyt12tFHzQFQ&oe=6A048C81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZcrBfqJdu8Q7kNvwHUi_RJ&_nc_oc=AdpklJnEbLeiSw-OynWfGuCRNyTvM7q0uDwCcynoWVf20G_agQIpxc_0n_zpIN__n1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xNui1iuK8-sWUb7NAmuox3dELoqheenqGrlw2ENyudw&oe=6A048816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmAjovxX2MYQ7kNvwErPVF7&_nc_oc=Adq4koRIDrxxutCcYMTrjuKvJAoA1t8RIHzFyDglk7yPQGq3ojQ75AkhK3fir1Okvzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uKsh_cmNeeEwAf0PMAIM5vsOxXFtLpkQEXNFDIIrQkg&oe=6A04737D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PxzgL-435kQ7kNvwH9sBOE&_nc_oc=AdqTtdrYuubmsNtUqLEQkWmErnY7-sasbtu1c-mHRBsHPQkVgIgNhdXwcgEQu2AZ0x0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SdLbYjaSSXJ4prGA6rW8QqdNKJU3a2C_weWGPLTIONg&oe=6A0488E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5DeN8rRhg8Q7kNvwH0kuo4&_nc_oc=AdoxqwjVTR_e9gdDYW-LilBIq9uQ9gk8H8OLZbSX543bh2GsIHKqt2aARPsv6SHasxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-fVV6OybUzB9aBYY5F1B3k7Gagt-4ecvZ8X-NwmGMpQ&oe=6A04883C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOHZnA7fqBQQ7kNvwG5h-cd&_nc_oc=Adqe78bPlBw4zaVLMqR_Klxn2LNYUhzb7R79Jhr4T509nA-4S1Au
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNdi5mYhkBsQ7kNvwFUGwZF&_nc_oc=Adr7tQrGMX-eaV-UBnVv6YMgtzX-nksS_zB-oQbCIRQAzLVu_uep7-ccRDQWc6sTDb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N8rwJp6GwVsQeRql-FF5C2BuWMZymahlgADuE1vuKbQ&oe=69FB5201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhmOPvJ6LGEQ7kNvwHc5h8q&_nc_oc=AdrbYHi39v6oDd00aXk6ECZ1I2B_7luN8oO3yrnIcRl071bK2cRpzCuLca-l4NzjAtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jbG6nAGuswSjGpSNIvpDjyjsR843wfFXO0xBw_G2IAQ&oe=69FB4D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZHPFQYT5lMQ7kNvwGP1Ur5&_nc_oc=AdqO1M0P-FIkFNOPIwr72daQcTeOxFdklpKiZEqjUiI54yQ2FK4HDOiZPqcRL_-agGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49REwWiyfZXMc5JzvnNbmlLH4vbNK18x6g6Wb7FKze3A&oe=69FB38FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQRPLueWH7EQ7kNvwH5r0wF&_nc_oc=AdqYChDHlf3IQHA1W3pyKTcVwNkeCFvVDKYEx9C_cX-ppAM3418Eg7Ngv8SkIuH149I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oaTUnfuruWXf2lpNNNkLhHvZbQyT1ocG5E0si4CBpyA&oe=69FB4E64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q3RIU6wam0Q7kNvwFH-s-l&_nc_oc=Adp6mhdrCXBqxLYfsetCME53Aje8AXOYEr2yLP614-ErsOenqV5OxQhXjugB_lRaVBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xx7rkddhdJbdBrc3KWYc2i0kw6zY0Ks0xuTuBi_o8Ew&oe=69FB4DBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP_DHbXeS58Q7kNvwEqKjj7&_nc_oc=AdoTH_Ycf8wVaQOTL-BLIeWNQWL9HebcJS-GkfWwJKHEYKFBPrao
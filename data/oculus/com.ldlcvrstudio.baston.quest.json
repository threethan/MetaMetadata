29.png", "id": "1153213020336966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821702_1153213023670299_8282150417532215900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja-g3EsgJ-4Q7kNvwEspjAR&_nc_oc=AdqHUXVub1kr2XaQrWBur3BXXNbrkFjmiTPcxYBhY9Dz2gcrfCR37PkiOQ3XTj97rpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-rfA5I1SNy34i5cJvOZYNJHSkdCH9JRih9JYd7UvKgQ&oe=6A4E40AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1721481028535123", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818849_1721481031868456_1060556618134437396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1SkJUyqW3UQ7kNvwGIGo92&_nc_oc=AdpcphZ0FpLH225gsj63I13KYDwLLJgBGN_8Vq1zCe8g0i9cecemQTU83L6dSlu9eSA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG14_Ehm2qZb3EgbJscAPZ5W7gwZYChx5Q9fItpP7e6Q&oe=6A4E6614"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "fantasy", "tavern", "punch"], "long_description": "TaVRn\u2019s Takedown is a VR beat\u2019em up set in the hilariously messed-up world of Naheulbeuk\u2019s Dungeon, and developed by VR Studio LDLC.  \n\nIn TaVRn\u2019s Takedown - Naheulbeuk, your mission is to save Mliuej from a mysterious threat that\u2019s ruining the local breweries. Bring order back to corrupted taverns in immersive hand-to-hand fighting! \n \nHow? By punching, smashing and throwing anything that isn\u2019t nailed down at your enemies: goblins, humans, or anyone else stupid enough to stand in your way.  \n\nAnd you? You\u2019re just a perfectly average hero (or let\u2019s just say\u2026 an adventurer ?) trying to save the day. Or totally screw it up. Either way, it\u2019s fine.", "short_description": "TaVRn\u2019s Takedown is a VR beat \u2018em up from the world of Naheulbeuk\u2019s Dungeon, developed by VR Studio LDLC. Punch enemies, break taverns, and fight for the fate of Mliuej\u2026 or just create total mayhem!"}]}, "de
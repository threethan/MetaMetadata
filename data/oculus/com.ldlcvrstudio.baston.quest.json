mzoS2m0gQm4uoZl9FFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYu-uP9musH9SIND_aVv4wAZHqjLrg-HpD2LSkE4zwWw&oe=6B01E6E0"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_CcmAGmSk0Q7kNvwHtQc0F&_nc_oc=AdqU1oFP6o7wfdXTSrHagRVk_KPalFqOZN0P-jmsOVCErd2BThSMLW8i5B2JvUwOFFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfjSUtUGIMb1CDB65S2xOBLISMNr9bc2fgtwgqCncLqA&oe=6B01E4C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zt-sofVTmQQ7kNvwHyt312&_nc_oc=AdpnV7LSZGS4xWZvHj3mKTfwUPyHeNxsYWCnGkJfBXZXIC-CPFlkIGrVztsQ3T7lEpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5oVTLZ8cvhwJcwVjlwqcAmZob5KNxyF3YEUjUithThg&oe=6B01E056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npD1qvXoksMQ7kNvwG-QOTS&_nc_oc=Adpp8H6s8a2aXZOZhgtPzxi0DekaCBOOtG3u-gGpxj-IXPHbzloJZ_XGuURtUwbpF5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq0FcsTpnujzy5jjiZyafxOa2cvLNqzQWAByHpkTjjGQ&oe=6B01CBBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKZROH_WTU8Q7kNvwHiPmAh&_nc_oc=Adp2V9v2rDVbhGGRAbzGLMFmACV21fqakWWVQFQYA7jNz8BP16iPKZ3tSh50vai7XYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScG2JlxvmBHEZbSftk85ODfK27kf5xn26CU5xG5jmoog&oe=6B01E124"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LTjrIShPBAQ7kNvwErRo00&_nc_oc=AdowmBFW3jOY7PRun3Da6xUM1Pze0ypXsxv4vQUlDrBz-UmLlncyPm6C_WPR_oTYidk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROKGI4vyTsctXkY45HYdhqXtTEQLVeZf06SOHX18o4cQ&oe=6B01E
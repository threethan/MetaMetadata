.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkLjyiyBNsQ7kNvwETGv9g&_nc_oc=AdqiBD4idJDq4IXk0_wdsXmNDRMU3OLEuKlfs0_cML9rtcE0WtGrD6NulF1QaeKKFXI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGTfaOr-efhrlLRsA0tZ2MGWqbbrpU5cCpmWGmHLmjQ&oe=6A413181"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De-n1_7Fh4AQ7kNvwGlJW2Z&_nc_oc=AdpK7R1Wmhkln8ARJzuN9I63WmnJk9BK_hRwGP53bkI7y7_bf_sgi8xTm0aLqXkEXIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IZ7s0tGI7oMu7BykU_blZIdkWrODL_OnXoJ8OMlurZQ&oe=6A412D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zqS5XD_7nEQ7kNvwFvpd4b&_nc_oc=AdqgQX6by7CaHWrKkbUOueBTWClMJ-c6ZpORsihUU0M0Tnp1iftDNz_6yMvt7hGrgJ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ScOCvtMpzCZSJmm2XyHZ0aDZbERLWvRRIUsguUehfpQ&oe=6A41187D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNL-SCQfCbYQ7kNvwFNT_qB&_nc_oc=AdoJuoSk_UXenrsFdv6VlSWt2oTXXrL_fKVlIc4qgqaCca20dG5fnTWZC_jYrju8NZI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-sJ45eZtll4zWNMnA2Wp4ZH8JZ90G4-C1TrLlzxA8Lw&oe=6A412DE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K95OWaNsT5sQ7kNvwE4AK7a&_nc_oc=AdoHV2ZzQapqUmjbGQdIADA75AhzmLDE5s9LZceZgyMWwBrGND3j9YvIdXWPceBoVkU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kxUaKHFqlUpbqtaGNUSJypI77oUg6h_z27Yxp25k27A&oe=6A412D3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgbuFUy3sWgQ7kNvwGO9Uc1&_nc_oc=AdrIGGX893rI4saF7ZtVqk7C5uhYaIi393F9vt9mKoqQDZC6iB4M
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgSAPStrWlkQ7kNvwF4ogNd&_nc_oc=AdqjDHoaHbw71qH-SO-xv_KkGLIdb-17biA_iMFz-tLT0MWdWd_UtK5w0xn56jj9U6Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgJWLNv2pUyJte19EFaDiAJN6RnjML30JM2-9zMIEvCQ&oe=6A9407C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jk9r0Ii7XUQ7kNvwHlGj59&_nc_oc=AdrMYdAOc33WquW5GBlSmeuAbbErecROil8G0c484GffrubN1FkHAPRVkilOLcnnAlE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQl3yFD_0l4CZVwFZnHgnmMoBcm_QkvQPvA-Gr2OJYkA&oe=6A940356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6KMF7Ln7fsQ7kNvwHm9y_Q&_nc_oc=Adqut70pySYhvn9YHvR_a31qhSyUsCJAm9EO0JCE2frDuUHFv9UKsUFTGmwynAJAGWo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc-c89cD-xBDyiw25HnJGxPJJI8YylcYe-NeuYNPQPCQ&oe=6A9426FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X76XHu4o-28Q7kNvwGITt1h&_nc_oc=AdqJJfa008KERqfclfbTrvLbsfDRIAa7aLA4t4JyM3z87aH2KegcK-tt1ipH4lZF63A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQzV_uxtoTdyc1ffvd41Xm_ltN1KEl4dg7vgv2LC2hDg&oe=6A940424"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buTfZtNFJBgQ7kNvwFa4V7o&_nc_oc=AdrztSBkVMSKNvLKx5UB9EqVQVNp4hk1q8C6gw-Lw369ZwVGOCssDS4o4kbok9HMlmc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7TV0LR-wwOsxVxEsFMPELKA_rcq_9wFDY0RQsJUvaDQ&oe=6A94037C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZGvCW9QwY4Q7kNvwGv4qp6&_nc_oc=Adpr8ZfUwZfudj4lciiegW2D0sNh-ZbNlfaOWiQguDJ_Y8TsRmRy
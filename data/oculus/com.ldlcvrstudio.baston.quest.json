sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QOQIaCJ6wwQ7kNvwGSOV6W&_nc_oc=AdqgspqMtlgKNyFiH8YIP015ZuLeWpJx8881kR6Z7hOKPObz68DjxAlsoI1yb57R6R8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ74Th4GlS4-OpgefwLN-xTtj1NQ3DfzQzgyWc5kzjIw&oe=6AA95801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPbjn9c4AKkQ7kNvwEsvfkk&_nc_oc=Adq7GAXxsvTigwHc7pxrz2MpEOY9RC7WA5sA3eKvatZt2D4QwLIErlui5BJgiVchlC4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5g4C9xnNi9OUPAJ1PgouQFOQpEbdMvWb1LishN3Te_Q&oe=6AA95396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhUAVq4Px0YQ7kNvwFKBLy8&_nc_oc=Adoi3RH9k5eE2tHwaNXKQ8iDiaOGp-dhZDMAVkii6aEXg7HmwV85ZIpL4-8dO17lRMs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmD_O-ve0RNnMc9916JJV8sucnbLT9F3LvJaw1jSBRuw&oe=6AA93EFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ6TB4RN9KsQ7kNvwETuXSR&_nc_oc=AdqM8-q2ArDdEz_rzl1C52MNh73Qf6jEccBx5Se92QjC_EIG6lyMhIbngb9r-Dey3Bg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw3x945YiVVnqQeYeytgcP69mliba7L57c1OdOBdVOww&oe=6AA95464"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RThlnBdL1g8Q7kNvwHvz6PZ&_nc_oc=AdplzOK2_87p3Ad6Dsypei-klcUfQ6Mz90tfgJWcAfxonvHrtG4atjtrTGq2GLLExXw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BMuy2-Ro99D9Hy7HVCPZ79Awv9boIbzY-8JmxGYYOw&oe=6AA953BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFvI5Fx2NBQQ7kNvwELFJqW&_nc_oc=Adqxii1UMCLaUU1hjZejRfuFSrU-LNbMXzAb5NcYLw0YF3
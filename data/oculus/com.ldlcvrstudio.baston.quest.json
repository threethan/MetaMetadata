.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE_1QFTZungQ7kNvwEzn6dl&_nc_oc=Adrzm_LM5XG9JyQl0_FMf7MWf9VqP5BaOR7SHlIvNNQJAKd4V9pufYUXqAUSMHnp9l4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40CrMo9_5bOeg_y1-oMRdTbVrCBsS7GxFfbV7Y1Xu1nw&oe=6A15B001"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPbeN-0OGCMQ7kNvwGsfLUJ&_nc_oc=AdpUxrq-5piLObIsSxz60QCQ4Q9ukZCc8RoL4SVzwKTbucP5KmWnf_D5t31up0quJ9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vcnLsPCMMn0vAYu6m4ABsN-e5oVqfSfK3Rw3TZ1vOTA&oe=6A15AB96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc-EbKT7EtsQ7kNvwHwTkj8&_nc_oc=AdpD2O4lsGJf-OByTsgQeMFyHjCIo0oIozK4CI_UQ_79gAYAZzhOYn-zGDgMCItPX8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6swQR9qDga7oKEk7gZ6v0YMa1rDTh1WfsnNuCUdVbdZA&oe=6A1596FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgyhXvLN3XEQ7kNvwH5si8V&_nc_oc=AdrY7xXZUoW3I0x675T_DTkRGyl7C0hazlhPFjYWqtBH8uRkHgHcwSBskARZu1NeXNc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OfkNhhzNf8YWQZaS-lDQMNWpTAhsSFKCLGB1E0rotjg&oe=6A15AC64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsgytExY_80Q7kNvwE16Ncm&_nc_oc=AdqnDEKrdhOL2wC1X7fnd-8btsEj56eNLAUVRFcxXG0PoPPujHgXmpdOz_kQV1DYzAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FdNcUYc5lIk_9--vGv2hvwFefMwkNU1LKN_KsKRBQ5A&oe=6A15ABBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDQvRifU3lQQ7kNvwE0Aqqd&_nc_oc=Adov5njcRN-wyrR7XetipMC2XYg4ICpiUNDNvdPW5Ymnm1HQ54g6
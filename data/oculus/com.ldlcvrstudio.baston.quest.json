.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNdi5mYhkBsQ7kNvwFMSdVZ&_nc_oc=Adr6Nx1dVl6caMGXWS6B3mikC-EjmRVQu95mlyBdSIUKsa0ZMYtK7GB-xtpyvdtrqT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pu7aNJO66BnNZ0q62fPeKQ_Q3Qk255Hn7ECDlvpiyOA&oe=69FCA381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYNa_0OTfkQ7kNvwFlYxfM&_nc_oc=Ado-T_f0hs6B3CC0pi_1OwDycoYjaqTLL56o1f24Sf__RNsNBoocdg853GVstUpjOW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62s6wfurHmkS13g2UVsReWFjmx2vU-_nNtZgEpQl4V5A&oe=69FC9F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOnyfjiPDhEQ7kNvwEvaYuf&_nc_oc=AdqxVqyXaGJXczghyOhA_9Yuaj4tt8PuZptb0-I0haEofV8yrN5vaXDF9q923X4heKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YUGZFq_TaJvnSzSYsFKHj1bpbrkjcMA_UuzhdxjZa2g&oe=69FC8A7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQRPLueWH7EQ7kNvwGaLfpw&_nc_oc=Adrztr_kU7M28mPPzKggisUq0KZ-2Fz1R__xXu1MXkP0j5n92yH_lJzo7R-gXcXvBco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EnJ63e0rHw5dMI7LHfG6je_1rTDb909RbxXlir2T92A&oe=69FC9FE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q3RIU6wam0Q7kNvwHgBKuk&_nc_oc=AdoCOlDz7Xsvdf2JaoDk0ISTYI0AY4mpDVna0bNU0Oe5Fs5Pz4xKfACK4ZoaKIL6NYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XEUClC8kDYLTXUQUkUKjgsnQRUUq1GStWVd5Yrd1nkg&oe=69FC9F3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP_DHbXeS58Q7kNvwE63SYP&_nc_oc=AdrEmrxjAZgP6QQkaNqzsPUmDIm6pxVVJXfyv9703gXqFMFlDegZ
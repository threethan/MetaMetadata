.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAVhCh0EQSQQ7kNvwHag85l&_nc_oc=AdqdTMxjZpno102DjcCh2YE3bxvcCPs-za0bUf-4QzIbvJWb0aRINrYSUSsDmAn_x6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmYlWEvNQqWHP4s3uRvgZ0skd5tVxO3FkfoaLmGBNaFg&oe=6A661B81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB6JXEV6D_oQ7kNvwHgOpuo&_nc_oc=AdqnB9WqRmEEEQTFVCXIqC_6PQezzNt80Erl82l2YPwZ7XebOxYCXNBdx2EQaYHUc60&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhLXW_VqOcmNYLVWCBEl2TgJOMnFg-J3hq37NH-0EMjA&oe=6A661716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apD6PDvzpbEQ7kNvwE__8hr&_nc_oc=Adp_q2LA7euJKHZ8h1kjT6-7vE5RhMwHP5bN0rr9UyW6sjuQ61pUtT6u7w6zJFk0Gf0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd6SSNHPeD3r5fFIYAW3jroeaTolCPjx7CLFw96BF8lg&oe=6A66027D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4M3NVX9E8oQ7kNvwGjuhH1&_nc_oc=AdqygTIpZTcvmMmFndU96HE6ZLGnudIDA7mwReBp-G3uDBDg81cPeTiW3AOSl9p7E3o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChLeHWq48u4eWuMIOIAPW_nbFiA6KrqYYKpSnewXpBvw&oe=6A6617E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO_6ttut-YYQ7kNvwEmFWaC&_nc_oc=Adoh59BCLu8Z88L3JFndLnFxB3xPp6W9uPiDtANtbUqhefpEJVTH1OlP7EfEfRU5nM0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt9yoSywOwCLUDDWxZCB-MmBHTk4ozW45lXrph4vpUyg&oe=6A66173C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Olc9z4_kkmUQ7kNvwGdz7QH&_nc_oc=AdqZj8hzhwbl9AzZTbcihlE6KkjZCfONVtNrLVHnk3MH1GnvScG4
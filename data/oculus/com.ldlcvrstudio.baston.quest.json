g1wDxxl3qXppOoV0OSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0r10YvsJg95DxILfMl6QIZeOXxPD8FplVDKKMb2i5CQ&oe=6AFF0BA0"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnTiXvjeZ9sQ7kNvwHMjGmp&_nc_oc=AdrGQTs9W_7l-gIbzpcOfe7Zi_jtnjG5OMzf-Mg93tRWmQKcxCK6MB96Lm1dNyVqMXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyFYtWJgNTTPJDRVqlpS9eCdeD9RIS23uzCci32s0cIA&oe=6AFF0981"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf3tu94BB6AQ7kNvwGGyLaX&_nc_oc=AdoVEc4Bjme5WCD7jPiVOkIfNHlRtftase826uYRzsEl1UpGiQvnsc0pURP6YoNYlnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcVmmWBKMS42G9SjBDcw1lwH_YVOdvor6ufDZSCl5Wow&oe=6AFF0516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1e0u2KB9IsQ7kNvwEcTFrN&_nc_oc=AdpXBAmyqMfGyXuNnHj4yITjnO4vKYjeEzbzZwop6WIOJkK9O09Mjkh8DNqsFjXky6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkj-9an4YkW9vZeVSyT35HT3xy4KqeW5EwgqUKGYD0UQ&oe=6AFF28BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKZROH_WTU8Q7kNvwHUTG8q&_nc_oc=Adp0YzgaQOwTvye58qVDB62b5pBzU3I1GsTJH3ojTDrx5tJcUsGVoQFJvXM8piAw9w0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-hdQWADO2sx79PsxwAQ2H6JZa5vBw3sM5HBODckf51w&oe=6AFF05E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LTjrIShPBAQ7kNvwGqXQQy&_nc_oc=AdpuUkOXfVOULUOoteOkmmMS4gXYeU8JYnhXb0RlCQesPOChIRdLSlgVTGNqQqFEEqw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSjtx0hSBGmwN5AtbzoLZcoA87aZgM3wtNeM_qibJCag&oe=6AFF0
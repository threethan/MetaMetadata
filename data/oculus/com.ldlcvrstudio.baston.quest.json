.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QOQIaCJ6wwQ7kNvwH2WLSU&_nc_oc=AdqjXVGdTDAunxNQI8D1kyY4cAC01DNpKnJSsYspWVnUNFpjbA8VcqqFLCltC00qnU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS67U-9YhBUjZddMAi2gKs9LcX_xhbdvwO7E7m-dFzYQ&oe=6AAAA981"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu2r5CNQI94Q7kNvwHnwbp0&_nc_oc=AdqBxpXJ-nNqyPeOvRmNiw-4kyyrD5o5giPzZf5D4I48aSOZy57C-NJw5-fDHJRF3c0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJGQcpj2xa1lM4AGDfy_6Bhh-u0aEUx98svtlj1oMNdA&oe=6AAAA516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InIVvflp8KwQ7kNvwEXum7a&_nc_oc=AdpS13E-23c7ayXcrUUO4E2FWNh_nC11n8XCiB1sJ7GJOeV2xBOUKGhtd5KXIoSGMYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9U1_H8ZHRtxRmqbMfTOLDJ8IDoX01Mf0Mp8MGFKXrjQ&oe=6AAA907D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ6TB4RN9KsQ7kNvwHbwREd&_nc_oc=AdoNIQlVs_Mo-2npal6Pir0VPDOMtMkGN0dTbmR5Gyw7I7_GIMpgzI5oWxQRIDOH01w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0W8FUR3Nl7KscOWgPKstqNc0EMTGawMyHr0_0KtJcCQ&oe=6AAAA5E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RThlnBdL1g8Q7kNvwH5YyRO&_nc_oc=AdrMoeRANNe3vdReKm6Hd5NRhpiQ4i67jt6oV0I0v9qLQ2HGd8YwlVhZCIGCVt0eJMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUoZm8U--ID2vnmB5PNInXzg5-PxmcHjEWdBPEcyboLQ&oe=6AAAA53C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFvI5Fx2NBQQ7kNvwHGzFUL&_nc_oc=Adq-mwp0mQdUR5iP-t7yUwEB_9vpg7f0iR026VlIYRiBllUU5enb
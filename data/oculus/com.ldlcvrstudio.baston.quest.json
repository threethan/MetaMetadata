12044246292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lyBbrCvAQUQ7kNvwFymqpw&_nc_oc=AdqSY2OZMwVV79V0umehvqEGsPpo8rpyHy1FAiKZ9Uil_qkEBaFKjTNGQn3E9R5AyYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LeX0s-kEqzyp0Nx0LBPwVAS6uy5WcmaaKQ3_M0QuThA&oe=69DF703A"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DnA9jPzKggQ7kNvwERPVfB&_nc_oc=AdoDv0Xfk2PPLz7l7QZ7U7Q2Ccrt-fp-lmjwJzt-J_j_edLxir4vssEylUkZ6NpwYto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ow-rzG4TjYhFqb2gGbBDMxjKKrUj573eKYa5uIwRZWw&oe=69DF8CAA"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=sNdHLjUNUesQ7kNvwHP-HZp&_nc_oc=Adqxg4PX34AnZ1IXHRY0An6wIca-ZymUAS5r8iPhhHYYmdQSxeqsVJOnS_XfkOIswVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cJX8l8V40cioLq2vc4Glsj2mwlBAIGIXbGIFju5UgtA&oe=69DF7402"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBWQwv_UnvkQ7kNvwG-36x7&_nc_oc=Adpx3I5fy1XCsWFp98v-BEi5UjFL4JHuz7B-QkOAm9rLZR4h_CujVPKcy5MEGqbtCVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lm05rMb4mwRqCj33BhDfooZd7sXsdeI351IpkOFKq_g&oe=69DFA071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxdoZ_v5AeoQ7kNvwHdme1a&_nc_oc=Adr31i_fGen8-96M83qVxexZAxAaVm7j0dq7t-ijhdbH7p-QBQuH22EWaZ_VjWkca8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22YFL_knyetJy4b0XUQDdAbGFcSbRH_HZNjAZBY9wzow&oe=69DF8825"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=admYnmVXgJsQ7kNvwGrUoTo&_nc_oc=AdpXVJNno3jtbfZXCjcYiZdGlO0LnoBhSNjgIKX5J-SZ4-EJ2AmdzeWm0trHIt1LkF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lNA7DusiqTluJLFFCiOSbtgUwtRpZ-Ip4J
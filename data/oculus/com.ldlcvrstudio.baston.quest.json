a28wc6D6u47IeFB2lGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShUt07-alu05oJRSzQQbJ24exa0SvdQukQmuK9wPxsog&oe=6AFDBA20"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnTiXvjeZ9sQ7kNvwHGhEZw&_nc_oc=Adp6BAF4dtD-g1206UvrijBaX-UqujwEQgfG_k2Bc7MAapP8M3pEEXZo_EqV9rbpKuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzCqL9__HnQ8mnU89ZjFJkb-tFYqjUMN8FKV393Xwmig&oe=6AFDB801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf3tu94BB6AQ7kNvwEayA5B&_nc_oc=AdpHiM24KdBn_HHVO1GkNAeBTWd2GWrVathFTxKNaM-HBlHLDbmzBzDbLsKKx14IVTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLYJn7_xCyRcKWp25VqysvvxezeGYF1rp6yd5Z0LXupQ&oe=6AFDB396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1e0u2KB9IsQ7kNvwE10PKy&_nc_oc=Adr8R2qZQsyToQbUIiopm0NOEqfh7jIs--eO_y6UIauu6DRkhVijDp3nxxaFIX6zjnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtNjZ-JRBByO9jBXL1UQcjbXrmszrY_CpZYFuoxF1tuw&oe=6AFDD73D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrmnDjkHZOUQ7kNvwGWbUc2&_nc_oc=Adrz_kuuE6KaUtcTA-kEBFEG61ja51oNC4zBqk2oUyJPvQVketLoquZC0RuXC9PWUUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcHxXc53M0QeIGezbCrJkq6CpavRHlXOEAhLVHo471-g&oe=6AFDB464"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woYp0mcxnbAQ7kNvwHSpDtK&_nc_oc=AdrbvAkVBYh4T_X3K42steJUTpRz76oe6bvYzYFbYk9A6C4L_BkNhx1q-iUYlzbVFG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdEe9siGGfx8R_0cqv2-XzrTvmLef6D7Q9-m8ZBQ08aA&oe=6AFDB
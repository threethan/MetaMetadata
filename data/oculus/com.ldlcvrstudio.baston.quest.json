.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArRdTKcNZ34Q7kNvwEZou7D&_nc_oc=AdqtamHCyt1cpycLLYsSO8u2mdIiwwod8g08ZPf3hMBhqIshng7nW4vALaMK1Qtnm8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn8Py8rc-b_2FV7jMHE74gJN44GFvTokAUW8bfNA0Gvg&oe=6AE5FD01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9gthH5pFzQQ7kNvwGM3Lbv&_nc_oc=AdqmZSpnIXvD5BRKsKFMKzduLiPXXn4x_Bwe9FLcDWP7BEBzO79-vfXH_dXrEmoG5M8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_1WBGnZaMLjlDSUaFzRxw_kU1SNnSywMFgVxJEjcqvw&oe=6AE5F896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGPOIR5g3DYQ7kNvwE_K63p&_nc_oc=AdoaXWqEtOQdoCkjq-HgSQEAJeNTXAbxlRCkCgoVs9pHZI2lo4Rq3dHgZt0Vg6pEdCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC4sas3qkEhQ4F-0h0jd9pUac1soI88qd3fawalkNUuA&oe=6AE5E3FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CM-c1ftzdAQ7kNvwFYbdXF&_nc_oc=AdowYrgxruuY4OYWoX6wpXn0eYJeujnFSckw6gbQ7ZWtUWbBIpjVNf1AtkFywONTRiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3K_3MZEFkA-y1TDDwGmZXlJmRcGe9eY6KcgMBGhweow&oe=6AE5F964"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-CvVAI3LUQQ7kNvwHh4BVe&_nc_oc=Adq9kZ_wGkqX2-0Js3TpwTdbBo_vnV0Z3tJpW2yzsPrfLg9rK0F9NrgEn6ES99arg4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7PYZbCWGNn9Ih2nRfMbpO5erMMaOWGZikHVW0Mb6CJQ&oe=6AE5F8BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe-DlUi467UQ7kNvwHkZaJb&_nc_oc=AdpSggyhKGSe1JIYHRwsQHff9X_sbpSRzwYot4xbBQXgt15CkI38
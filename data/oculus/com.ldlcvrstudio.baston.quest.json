5MTPjqyO_eqPbRa1rLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4tbueZK1wmzeMTBQCoftGYnMnFJ2MHpKHPwPB9ZZrVw&oe=6B030020"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_CcmAGmSk0Q7kNvwG1bUvF&_nc_oc=AdopAb9l8n8fTMMajn_guDrh09C7C8tNBHvNf-SLI4ScFNHWFimCIjoPcy-I1j3Ke0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuKyQBrbIn3tQojvh4Eez2FXcQ6TTEDNN3BbyUfGAyCg&oe=6B033641"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zt-sofVTmQQ7kNvwGPqZum&_nc_oc=AdqfG_9Rdm44jDBLLPJ2V-mWHJWVeV-61UTRbiaz200SxdqkCeUgKR71vT9ZVIyR9A4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsRwr0PhNAdobXgQfpjXKIkYCMeMJYUcXHKo_Hf0DSIQ&oe=6B0331D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npD1qvXoksMQ7kNvwFJPkeg&_nc_oc=Adp4BzmIEVMxVa7TlyPcive90PUHpSxv0B-YWOnCnpQvERSMVPnKrEMGdtSZJsD6mbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYcxieTRoQ76IPj9V8NgFSeyIZC8w8obwAWnVoROmQ7g&oe=6B031D3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC_3Rvi40bUQ7kNvwEbvPbn&_nc_oc=AdrL_1LV61TXQLW25XnMs5TBI-Gkub2Sw-l5_UMAHeQeCeCbGkYNeww9NhDgvRo2alI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR34a9lG2Gv2DFy_h2l9q8iPh1WIjAhyVvqb6_RySlNng&oe=6B0332A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E68kaQAK04Q7kNvwGJsEEB&_nc_oc=AdrMm42V2cjXAWED8LPLLXRLni2PGTWE-VxxxgJMyTfWRPG_pPYhf0YR8Mss87nihA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBkuaHjIMxIVPltDyx6wBMNlb4Ne51Y3ILS2q02BwjaQ&oe=6B033
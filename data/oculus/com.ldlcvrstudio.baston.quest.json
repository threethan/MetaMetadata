Rw2ndJr0VhLEKamtdRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsSUI6GFUVBldjeRzqESMCt8koH6bchNrXGD3LfNJ7HA&oe=6B005D20"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_CcmAGmSk0Q7kNvwGXZPQj&_nc_oc=AdoaaX0C33BSMIeWhtY0cyZAFPC8QYFMODKZOBc6JYkdawxF2z-OEgTq8o2EkXN2vpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV40WBJPBhgb-ljgpNyDibJit2oBZWFDWaf7zurxAiHg&oe=6B005B01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf3tu94BB6AQ7kNvwGpbcYG&_nc_oc=AdqfMO5_3fuiqo1T8gcPpXcm8AdyrfWel7hEJKy8evOruZ1g3p8fx386JOtycG6rZ7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXNK9CEUsLF-a60YrJXWXyNGayhxCn8wBAvV3GmBtqxw&oe=6B005696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1e0u2KB9IsQ7kNvwHTD8dN&_nc_oc=AdpqaE3riy1OdBUo8B7mgICEquETk_kwEZ89m7vnuiPQo3fsrGrKlE00ykijTPTgbIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZKIOQMAHaeqIx9lXx-cxxtOQLicsLo-dm1WKa6tvPQA&oe=6B007A3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKZROH_WTU8Q7kNvwHtAoOg&_nc_oc=AdqX_QZAdtugLusxCi_a0bEDt5Uz3ALpccTkdkntR0Z4XbqTKO3Mfm_yHI0sqZTWWWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw6PwjY101SD2Shu495j3vR8dwfGCyNcuM9IiSI6i_4Q&oe=6B005764"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LTjrIShPBAQ7kNvwHHWTvF&_nc_oc=AdoEhUBoEuPPqTBUigxWXcOOioDclx2Lp4vKAe7jiFQ9ztel4AUPeSph-czBEJkj94E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT5xQkCweMUuzU6TKR7OSc4IAqIOQH2vfUDNZ_dLTmVg&oe=6B005
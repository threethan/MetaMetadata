12044246292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBkFQFkRob0Q7kNvwGXj15U&_nc_oc=Adqioe4zRqR41tq0RlED8pdbVhzkkP4lFVbQjrw41-owIHeTHb5dhvNWnHGyFVM3QOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mDqpSBxXHPy8Ru2Z9VHf7cwmBscHN8m7zYSFBqugHFA&oe=69E4EE7A"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izun9z72yuwQ7kNvwGPLUCl&_nc_oc=AdrbqBjXMVih6ryd-S1tKLamgS0opcLmNdL-h1swsdCxkwRlJhfYX9izlEeprfJ9ejc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17KahJ1XdnUzxhHo2pB1OL7qvR-dZPx6umnj3mJsek7A&oe=69E4D2AA"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=tIUxedBJSrwQ7kNvwH8Z_8V&_nc_oc=AdqXCmbdnY7SyBxNHorEmlqx3cVu_kLcq5K-RAJasbdQGYiEL7GjMieZbWPE7XtH5N0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oX3E0wO_7eZcHTqvc5xMNl7rrRw8nnGpnXI41Sh3llw&oe=69E4BA02"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGaLqtS-YJ0Q7kNvwHYd4hX&_nc_oc=AdoSSStRqQSm3hAz_4FnKe_kuYng2fM3Ti5O042FYJjQ11GY_G-B0sC2yTu5egJAxL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0goU6X290CzOs-wzp1XD9sxvdC8wN6OAgdA9IgmtamiQ&oe=69E4E671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbzl2LMp2GYQ7kNvwEFRXAG&_nc_oc=AdpE9td2RTKeP3f3Nid7W0iR9HBP0Urhjv3xfDpemjCtOcKigLWm2e8d5P8vQtIXNTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fr1vt0Hup9Lk3jmWO8qBPkd_u6_CxsEneoWwMYkXRhw&oe=69E4CE25"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF-r001oq1EQ7kNvwGG0GFD&_nc_oc=Adq61_1ifv-OstKOypBp2pLhY4-0kQ9zWkpm0wOVMeoM45C4ALvCDGYm1pEFHNYM_74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N8TlM8G8JGk2oh_PRDP17W5HVy15j-cjEj
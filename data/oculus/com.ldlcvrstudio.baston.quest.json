.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQRcESSDmC4Q7kNvwHqEbfb&_nc_oc=AdphGYx151EON9Lbp0QkwjYrwBt315wLHtIBHZf9YGC0B06uplNbp6CyU-xj1oCb7iY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Zna4S5XKE8aW7McHXoK-pNH4qZ39zQjePO9yDgC2HQ&oe=6A088101"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhXQJkpIu68Q7kNvwFIjnj1&_nc_oc=Adp9wP-PrP9bxPuDLGUtLiZHS5LqosT1Xulee0eYa-kBt2Y9IuUictHPeeNk-qHWDq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qeOeCz0UW829pqZAuiodOHIJS_pMDRY0MiU3FkT-T2Q&oe=6A087C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEWBJZBaUlYQ7kNvwHP9ZJ7&_nc_oc=AdqyoQ5Pu2OdaWtrnYKnkQXIh6O1hJlECfI-LD074O8i1xbtp_7I0wTKpQordxy5o_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OYLKkp6_wAEXP_kmZWzm6AL92WXNwiu0qNiH8lOakbg&oe=6A0867FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2OtpdsezDoQ7kNvwHKWAeB&_nc_oc=Adpm75xa6phC0sHzfLjiFP_KltlfNJ35g47Bbf6Y-xBpec5WyUv8hMky7oQGteQUqyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eOX54Hsw96NljPlvFu_J3PqHo0O6FUluHIcYBaHrNFg&oe=6A087D64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeucD3ls1DcQ7kNvwERRWxc&_nc_oc=AdooAsmUSOj1eS262_hoFyeRvntoe0FQL7eMLedWDpbOjNv6eDxyxZGFlCC3O7-kZ5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jz_vi15t_2UEvHxZ4m4qah2tN7FhYIgZKZKlHKAtWzA&oe=6A087CBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZiCT7C-1oQ7kNvwGpqRC-&_nc_oc=AdpAp-S0w8ZC7dsXbjQPJzSelYU0sF354x5PyZoesNlkovl4HefH
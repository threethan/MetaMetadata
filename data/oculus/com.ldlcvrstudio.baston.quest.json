LT7T_tQeqrj3LB2TCiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyaJBcF6U4-cNp_bEFWb0i5Ff0rALpJJ0K2kwDBrbD4w&oe=6B0451A0"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjwz1e-SrfUQ7kNvwFQflpg&_nc_oc=AdqBXLDMdnG_Ni_ikZJhU2-LweucF0IouiAnV8I9DClVOn_3HZtRvDM5zpmNn63JlC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREJRHCBgSv6u0dCwZEgFtlyVU4pzCqIz0IsVLnslHhUA&oe=6B0487C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zt-sofVTmQQ7kNvwEAwHMX&_nc_oc=AdpR7TjcNO2NkrL5X521Ng6GjurBRhkWUmqYpsUzyJp5aBgTbzdi93V7ub6uWuoVTdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgk4qR52gxcFLcrM1Ax4sR-xYmra5bnML62oR8VJkgTg&oe=6B048356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npD1qvXoksMQ7kNvwE7Er4V&_nc_oc=AdohBA4TWgtS5idQEiNBQTpBYoDzambBpOc3qxkKaU8w86lFzrfXoJeysPOL2fNklus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTknoFB8sDAEVqTPC_8MsqB8ztyk1KAo0pWBxaCOBhzOg&oe=6B046EBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC_3Rvi40bUQ7kNvwEdRhmj&_nc_oc=Adr5Iu70UDBMb8ooFg6NyPbBpO7WRshLvOl5gZYns1G7fw5uues7al76c7yd_PNy_0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFCO_uOaDfZuK1P2PGOp2DeVlA1hnNSGNe8M1DTTHs9Q&oe=6B048424"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E68kaQAK04Q7kNvwHX88Lb&_nc_oc=Ado8Wis3rvB9QJkqHCFckxcPKnIjDgy76x02J0Wy6DmF1IqSXhNJXInIOFggt2xvWLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCJVKQV6FFKfyH-jUpedl10CKlizce7UsNDAsE0O6X8Q&oe=6B048
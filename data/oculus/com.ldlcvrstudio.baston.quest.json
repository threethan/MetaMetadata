.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eif4BI72FLcQ7kNvwE2WLSm&_nc_oc=AdomgGaUJGDwTBfMlCBrOUgx5YOYY12197xj4IyzGcTtVslIbTj5_nTKXaHXCMpLXDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDEdzbE-jQB244OUC_VanewjSSJ3CH6VwjFpAvLtHl8Q&oe=6A79E201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrbNUErQhoQ7kNvwEb0eTm&_nc_oc=AdrkrHQRMZzljzt9Wf41bOt00b6AjxbUdG3PhbcY7wvMN21x6fmwFj5Oc3HzTVAAHJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEqGCuPu7m56HavmK4TVmWU1uTMTPYGmdERYeEKx0d_A&oe=6A79DD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymQcWsgLRowQ7kNvwEr3GgS&_nc_oc=Adox7ft-1xkgpK3xcZyi2F9z5z01zEXPKERelYVx7xJhfxNyQdx1bqKbZMPcGc959Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHij2yfOKVHbcezJmxPqb0VV35I5ASQJe1XBOFdBhALJw&oe=6A79C8FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPOL_c12giUQ7kNvwFS3_xa&_nc_oc=AdpyQGClyRlKOuHlTlERNvzHZT3ugPczIWKySerAjEi2dAW5wCCyWxxMUeW_JNq0aQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGgeDQz1Kk1mNrTWVLi3ll1dymDL04NtIfcybEyA9yGg&oe=6A79DE64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7qBtxDCMdcQ7kNvwGeeRxJ&_nc_oc=AdrqB_nO9S95tWaZM-cYuq7YfsMgbk2CeLNInXR1t8ekd5ZB3JjYu2PApTZMlXpdC3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2XDM7L3Kk3MesOagvQ_BYyUa2Epwaoeq8Dncnh_izWg&oe=6A79DDBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSvQAzUTJmUQ7kNvwGvFIWO&_nc_oc=Adow2CIRk5z5zMp0KZzHbRumkLg_UtjLUfGytZqefamAMQx_4msU
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArRdTKcNZ34Q7kNvwFuxoGm&_nc_oc=AdoufenoNE8-6YbloqTVCAnvD08-sx1Bo6VzKnWTts-0hxqbsdmvWj7TWV1M4lBLE58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPHdsIjkkYbFEXt7KtmUplWKGA4vcitVfgF8kNOQgMHg&oe=6AE74E81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9gthH5pFzQQ7kNvwHrEt32&_nc_oc=AdoWBRKIjHxkCwajGbdpevpT3u9COiC4GpZzVVatm9-8bsKTYgxAtdoT2JY2KIfeDvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtHbW5bgp-kUywS2Dq0DoszSMuwisk8dbhQz6kccoW1g&oe=6AE74A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGPOIR5g3DYQ7kNvwEo9paO&_nc_oc=AdrhVAYA04YaT74RQiv-n2Gvgf73ZzBIDzJ4XS0b2MI8mJ_F0xaXUFZBnJvc0RbKDTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE8TcYY--PCXi4BvLTWbRQdHBfGdwVD0OEk7sSPT-i2w&oe=6AE76DBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tgT024su1gQ7kNvwGIg3w9&_nc_oc=Adpj8QxMfgmkcAIYV0OL_9C3TdVCPUN9cqfvcVwlzNFlu-3WiwFHoa2aZs-ytCmbQgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi9kOg4lOUlaAYZAOaN5j86OY-J2OKlQGMhLO060jTFQ&oe=6AE74AE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DSM742Ph9wQ7kNvwF0ApdB&_nc_oc=AdqexxZUxeNVHyCQkaFDRsR03NsmU88MjD5Fo86Wnq5ggXPjfwAixG8v8GB5KLtG918&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtt1zdgvyLT7wDkwGEWDyaF_7stBNyf8tNZFT11oWXfQ&oe=6AE74A3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C66ndQnXuu8Q7kNvwGwaHsm&_nc_oc=Adr4DfOK6Ns1Kfbb0bibwMuQ2u27guZlhoRIOHWLw5Iu1DSL1X73
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvuWqL9iUcQ7kNvwGVSslc&_nc_oc=Adox7JAIQQvOOvqeXH1TlzEKYxyzNPpxgbb1sRf7eG1EZg0Y01ejWX_JW0fHA2uhk4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa9X2oj7irf4y0418qvTSKT8sxn2BBanjtzJ7qxyx9_Q&oe=6AC65901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XODl2IpRGAEQ7kNvwFBYcnV&_nc_oc=AdqwlhP3TdAIXfWrgBj6pHLnEMC6VlcMN2gz77QCo1pkYXHAlDXepWoDb3RW3B-el98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwYATS9gXiSDpcYOtMJbZUfJCnRW8qzzVitfjMsEW-Lg&oe=6AC65496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEvn2RPGTrwQ7kNvwFSz2L2&_nc_oc=AdpaMJnBWSCDjtaVY6QyXsb9kC6Jsf0Fco4w2WCaWtNPcp1Rr_0QDsE_209680RwoXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGbTS9EHsOkLAT7NLIyD1RBxtJuNz30XcAgaTdivLs4A&oe=6AC63FFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-POQB5zFcbEQ7kNvwF3sNtL&_nc_oc=AdpMhNwN-MsIyA0tjYonvhohD67tFCsiQ1UCjy2ZZmNOmaYiw8L4kxwvqUSBPYezs_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgO39XHxHaSDn5bQtniNU7j1QMmHraH0iY3VJP_tYlw&oe=6AC65564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS6KUSWBhE0Q7kNvwHTqh_d&_nc_oc=AdpIT0DpwzPEITU8E9U7ER-X--ob45vP7COfs_kX0zrOrbfKTneuPw2rYXi6JOY2BF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdTocnYGE5Y6HxSOIXEE0UJ7YTAxyUhg8YO4uWqmfovA&oe=6AC654BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_A1fa4hc4Q7kNvwEFrqVH&_nc_oc=Adp8XbE_41otjUzewlJVza4VxPEAaIPTsq5rXriJuWVf-7vqat7Y
5-2.oculuscdn.com/v/t64.5771-25/491825462_1712394683504261_4797876061434285158_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArAXwn469YkQ7kNvwFgP-8T&_nc_oc=AdopGTeAmrloHGWCrCHyCA3h5UOaeigfBydxEnHEL0C31BAxKg_MlYn7XL-3vfYiiiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bhFZjxBMmtbaB3h3dV-JsinISpkIPqauaX7SfYiw7kA&oe=69D4F8C1"}, {"file_name": "Screenshot_40 copie 2.png", "id": "1254075780121223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_1254075783454556_6146154837893247505_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFGOy1GdPYYQ7kNvwH98So5&_nc_oc=Ado6fjpYcwRuD9sNY-_NfRwQwLyUXngVgkycm1tHh_fjzSHrYaEuzVxTh9Y0kgcJJuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mnqNBtLpIi8E1q1ic2GbkMabfpmeP2Yc8shxbtW9-8Q&oe=69D512B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1721481028535123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_1721481031868456_1060556618134437396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3mSHkWbSKgQ7kNvwHOPdt0&_nc_oc=AdpGEdWedbPrk0eqcdOLt1THZn55zc9kyZXmCeQcoA3BZFc4HOn69dNaeL4jxCu1SDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1voVJc3dxNqQi17DkVAn-bhrd_upMn8JzjTteGdMY3yA&oe=69D4E3D4"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "4290199564603143", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_4290199567936476_7851007294464347955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdDM9ouypPYQ7kNvwF6ll1H&_nc_oc=AdodPgGW51vq8cjonWqU2jd3mCRGXLqeQgSd0OzEo88xUqQ-mo24RPByEaVqBX8KdyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13_aLB1wcKcLtTTqCnexNdnXdoq_kEEAdYJDKD7InDcA&oe=69D4EF39"}, {"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ytF9CI0hVYQ7kNvwF-mNJ0&_nc_oc=AdozWrAPRDVAemnygD_oPyGn59DPUgm8tyQ7j8YgK8-7oEVmFbqUCgKDYp4V_6C3kAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E84Jp7KtEIdJaCPCl5uVgy4eE7RCSDBvv1Frcam8CVA&oe=69D512E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH0lV0ZbxokQ7kNvwFc8Q7h&_nc_oc=AdoBSu4YCGAprZFjrL8mdFMxhtMRT8URPElIXb8Nv2cKlSsJMoc89D65Ol_3Mn8zrpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17
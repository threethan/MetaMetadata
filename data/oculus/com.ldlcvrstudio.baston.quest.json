.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zk73kU-z8MQ7kNvwEPPW5C&_nc_oc=AdpsJRFgB9chIfXM35UQVSPj79hHTXzPU_RsO8yt3NcPRTohu_19hp04-v5LDXU2esk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMys_FOqb-uDwoiFDs0fD9FO4zeBOl5OI63oVnV2Xcqg&oe=6A637881"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB6JXEV6D_oQ7kNvwEmPIps&_nc_oc=Adrkum-gSarHIMc1e0kpEFkLbHhDye4gVEivcC3EFRQLy5Kykj9dGD5KA7pKWjnPwhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuwM1KS3vk1Ws9uknSJJs-PVf0488uzpgoyHDbTIEwCg&oe=6A637416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apD6PDvzpbEQ7kNvwHFFxxv&_nc_oc=AdrflGVetU75Dut02GlAiekDMQSJJXenhefUlcN77AAbWsPbm5iuG94gJnc7HgT0os8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLPp3f9O0tpniGWDTSAnCpW4oJhY2P-rU_n4-GAILdgQ&oe=6A635F7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeNFnvRv5fYQ7kNvwFvn7X7&_nc_oc=Ado1OQYyfI4YTfgZxBOUCdYeOcWAw-z75eSnjI6ZgUFb5W5PcHzTeqWf7ygTbotfZe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnSH1gIOO1MTLPllefrYWx9_J0Z7z58StAyvB2boUZpw&oe=6A6374E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlpy6mBA37MQ7kNvwFmpKt3&_nc_oc=Adq5tbsVjtInwW6DjZT3E78fLbrIOBs5nf7VAslW4id81x1vw9Cdr4TNeSvCGPDrQis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxAWnY7RhcyS2VRRoHBF7C5SD9XcTSs_C7-jN_YCKYtA&oe=6A63743C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1k6xcr9eKEQ7kNvwGttY2q&_nc_oc=AdorCelDfVqWpVufZJOMAgtLFlipz1D1rKPPPWdffcqteQzkEmrx
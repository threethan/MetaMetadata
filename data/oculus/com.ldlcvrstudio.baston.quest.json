t-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_822137817339573_7229760179140916545_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtElu82t1aMQ7kNvwGK8wOZ&_nc_oc=Adq5O_EiALMo4zAg1vwdM8he2hrf4Fe7FEh8IwvT7J5t8JiN16eNu5QFMpjl_DDYOvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5PVQsAIApFBZbehRZxVpEuv7npIN0EibiIyq_YDOKcw&oe=69CE6F0F"}, {"file_name": "Screenshot_25.png", "id": "722112044246292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGnm2uv_6AwQ7kNvwF8SuG0&_nc_oc=AdqwYmKYAJiEqchlRBfbyCjrF0X7VAX82ry3rLEUVLXN2li59Wi6GNBjCqnoEoUTQac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzed-SCQlwP2XRs1R84WlmaJEGSyshoBlVVBsrI-5GaNw&oe=69CE4CBA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UggbJfe5srAQ7kNvwFQReu8&_nc_oc=AdrYtqtNd1bQwA-717Ie2Llb3AVqCyH08ccWvmcI9T8UiR8LBeJITmtb4l7Hc-zbROE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9mHQSZFoht8FHkXpChAEbRnB2VBv-1YVEaYX3sx4drw&oe=69CE692A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Y9e36P1FdR8Q7kNvwEl8ci_&_nc_oc=Adprp9I2jAJdxKCmm8DlBhyLrHPeKtafgKWTItUw5n4VdZOriXbxsDxfDWzwTPxQiIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJqeeb1nUubZpRMgHazZPKfzrAcGgDYbYqN1n5twZKJA&oe=69CE5082"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evm94WN6PJYQ7kNvwHAELiq&_nc_oc=AdrcfAc0LzOVB8rWVLReQkrBYqIbYuS-KHLMxEvVa7IYqFOySr2tJ32QdOdmby2VGSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLU0wCEfzLf6feOz-N49k943OUPd9VCx0tYHHT73zz2w&oe=69CE7CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0sEkEsV2TEQ7kNvwEigeCU&_nc_oc=AdoJPzacJpUPbK2ZtyJvUmDO50C8Lugw03_iKWNlCPGbhcnahB5zrI0jYAnf9WOuBzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz5EGZnxvdxpPX-HQiTjTl2eZ3JH5G99zgs9LXF2KroQ&oe=69CE64A5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "318330666520
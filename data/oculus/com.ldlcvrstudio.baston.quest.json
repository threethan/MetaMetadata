.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp6XsZBgibEQ7kNvwF8cj4O&_nc_oc=AdrV16I97tjqJlHFunbJ4wfpB7MFHMRiJtdvFjDA9C66eolRESmHVne7V5FVQcWmxDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7SNhpAribESbvEVeSDgoBL2oixM-z3jurv2we2Yipyg&oe=6A5F8401"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5qbPRSPlLEQ7kNvwGWTrH6&_nc_oc=AdopoGK9IOKT8Smyafi_VYCSMJOQeQ9gzAUJYSI_RFpJ68Mf0UIvsbrXA7A2W_MwHCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJqJCQ9zlhfk7koFd8usVJHbvFCeyT5GOSkAJJy7VgcA&oe=6A5F7F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lXj-hd11pkQ7kNvwFLnMJM&_nc_oc=AdrCIsjNnXjLrt9DikLNF4Bx3I26C1DL4DObLDhd8ebz8lEPm0uRfoDhnfuRMvZuAB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXKRi6VXxwvuNJV0DvEnDO9l0_C6y4TuuKlztnlVf-_w&oe=6A5F6AFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EW0RKS0RBYQ7kNvwET-KcP&_nc_oc=AdpeFznX8q1AUEvpjvAHLvE3KZ-ttK9LFGykj-B0fp2QwULOl-gcONp7EhxpEa3b3JU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9I8JEx_ZheJSeoKrnB2mppkG0yBQl1M_Eas89cVjsyA&oe=6A5F8064"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp1Q69FqV6oQ7kNvwHdUgBL&_nc_oc=Adq9esbuIamIDMHvEx5KdcNAJ4CBiuZkrULKBmmJVly9SAnui2z8XEIVGu0h7lkBW70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5ID6x1E9ir8oCe2krtIvt73q3euNCpJkJTLeXde989w&oe=6A5F7FBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS3ZFIMXZCUQ7kNvwF1lQ_M&_nc_oc=Ado8d0Z95N4wm0PWDiD0K10AnKf5kz9hcIwtAQZnOquTM58sKCKU
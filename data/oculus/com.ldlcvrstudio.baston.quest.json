.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mYP7d8xVWQQ7kNvwG1zokx&_nc_oc=AdrAr7Ffm0Fu3dpYjm2qEEcKl4_JdpyEFDLyPTalR0FWFl046GwcldldGyUHHq1gCl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB7ScgGBRre1kuxjpv1NRbvUnzekfpZffDzxt4cOKr1Q&oe=6A53A681"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeO4aiTUntkQ7kNvwEioEgB&_nc_oc=AdpkUtc4eOhdWkMCpoLZdoF9uza5RdKCLn5yDapxb-XeCqPwACy6Tafqq70sxU9pmGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgixpZTxU2aLnWUpBCidRurNomcI58JUi50NPAzM2wbw&oe=6A53A216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC-4wuuHJrgQ7kNvwG-9jt2&_nc_oc=AdqiZ8LVxx-lFRii4ncW7W6DMVX-N3B5CTc6Su58J3mJMfYo-DfxlExBQ4foR4FdJz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXTxEoHwqpb9UDTrSD2sOU10v08BHQh1hQvLVeotcQlg&oe=6A538D7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xvQxXZXATwQ7kNvwHn0f5r&_nc_oc=AdqAUkC7fcZOfx6X3SY5KVovR7YxZDwH87g19JmxVb17ZKKZaz1mmZ2FeCV1qxo2aYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzDXR_4WwO7dCswv8q3XDHiGJCSLps6NtjYgptmltU-w&oe=6A53A2E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC4ah-xFsLwQ7kNvwF1bt8u&_nc_oc=AdpRGI5-Crt8qAHT4irP-ksG6lF5eweyBM3mueMpA9_Jx4O3rSIjdtu11evPFLPBbpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzOHiv7h93_XVALf50oRnTqMz_W-QfCQ21tzOFdTQl3g&oe=6A53A23C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnv3rQKWsxUQ7kNvwGyv9r5&_nc_oc=Adq-Z0GGNluI4gCxjDDhtXrCmmwk78F0dKSm_-gICIYIjftNDuuf
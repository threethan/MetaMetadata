.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLMDpsXxeNoQ7kNvwE6ijla&_nc_oc=AdpRDYoUEWkfhRlnm_LK1lh8OLJNmjsEf_-VmXO3vvEazP0K3ipRDVVre8H1-nLP5Rk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADPUBh4mwiGly848sTp_TNWpS2KSl1v4ZI2NcIkmANUA&oe=6A6E0481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJYpjpoxE9oQ7kNvwEojh4L&_nc_oc=AdqvgUX2H4lOtLr7YbFYJWNIkRkKiZP_N16hu5yyFk7DH62j0poIAlEAETkUg3NjBV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeMXiYq4AdjmLnXUL4nyNydXFV_nSlEV_b-KQJ5qAtgQ&oe=6A6E0016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfF_iL9M6IIQ7kNvwFAEULK&_nc_oc=Adodux6p9BXLlcPCYWTovKhpGVeNf7tco_2pQnviFED5-p-be4W6pmmniwjzOta0gnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSNHjaa-8NeyxoJ3rzCiEfXlXOTXDw8et4K79APgPKxw&oe=6A6DEB7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtvvcRpn850Q7kNvwE0Au3q&_nc_oc=AdrTaC8NZNTXi1ihOVVo6vk_l6wd6hWk5mnAp31DRodRlhfrMugTDOhIxkPz8FC_8JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgt_rzswIzljnLO0kNXuF1rYjWMUyj0heWrfl8IDrzGA&oe=6A6E00E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPPQKpaYRAAQ7kNvwFQ0c17&_nc_oc=AdqVEBxKT6AAXbxWPp3dxMrZ74Iodvf6VH-hlJI5-cAQs8nuhfMDz4rD2oBHQy29Jbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvRFiR5EgQZPgSemi9qz1SaENM1c_KzEff6ePMbjRiWA&oe=6A6E003C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Clwv-cTrHYQ7kNvwEOgpBG&_nc_oc=AdomU-honXigPcbHW0bx4S5vXBF2mY-1iJjDqH5bPFRykMVFmLF3
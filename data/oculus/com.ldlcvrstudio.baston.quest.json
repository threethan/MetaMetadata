.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqoaYds2GbEQ7kNvwHPPn3j&_nc_oc=AdrFbJop8Z_sfOzeZ0-3RmytPvdzAsV2ZdONDZ9YVGvqYBGA-fcqxCTZYKUo2BJEY5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXKs2TqMLcmm4DDtHJ2s6vx8YSUBjHCcXIHwMJVwP8LA&oe=6AF8AA41"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFD8XfuxJcoQ7kNvwGSh55i&_nc_oc=AdqKAnLzk2esohnO-Iu03eAyAr75yta1hBLdIdyljwiUjZ2qJXny0k0ZEBPeB4An5qU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDQDzSvFysnCBl8PBwqb5oOckSbvHfpCaVig2hG5uzGg&oe=6AF8A5D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MqOPt3RujkQ7kNvwHtmcvw&_nc_oc=Adqa8ShUfDzIG18zL6YI1GbPwvla4W6XcNr4WD6Hszr82BHSZb6kT8jNSlMSER8pYLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPhoq3EOfZ3mcI2keNiFh-busRHJvTB6bz-6O5Madz7Q&oe=6AF8913D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTfbuhTwt0UQ7kNvwEjanEB&_nc_oc=AdpYEXIuJPvBfdPoaQYGkvp_sju0V47FXhuSdif4ZTdU4m_HAa56OeoPytOJ_6AmJcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVvt4nKRZiKVdsW7ZJSBhxDbI5OKrVjo7AcmOfODgv6Q&oe=6AF8A6A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzlw2PG63fwQ7kNvwEymAVO&_nc_oc=AdqHxAoiAHQQ6Z5OjkB5BBFTJ0UoVy7Q2YmJX52AJLegz7IheRqFIt7nIS7OmqTkmB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbLY5qZUstG0pmVp2PK0uG7O0k47H4dkrho8s43uZUJQ&oe=6AF8A5FC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA12SYF6dagQ7kNvwFl3wtB&_nc_oc=AdoKFq48KJq7W5uRqbXuoyhM7JZ6KQUho5J5xsYFx82-dLaU5jsC
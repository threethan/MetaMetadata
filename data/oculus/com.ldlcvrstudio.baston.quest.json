.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf_ZuBPZT1cQ7kNvwHTg_Ql&_nc_oc=Adq1XrTWfkKG5QgYIF2TtAFtXHqqNh4ctCNk5x7VSqzY9sF3a6G8ur1-ja_pMbC4-Nw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEXyzgQRgXDoGbaDAz0T7GPLPltFPB_6dwlgCA9z6H5w&oe=6A75ED81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtz77Hjr0gYQ7kNvwG8Ieex&_nc_oc=Adr9uU11mI2M9H2Y_xxYDcVetADklxDfmBN424IkEEhlpMSKxcEzxkRcvz5KuFFOQ2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZgwNDoGXzEUIZc9Pfdo04ZyTEEfxqWAzcvrZzL4_OWw&oe=6A75E916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riY5TEiTJUsQ7kNvwGQ_FGV&_nc_oc=Adoy_5J4uUwrFAQwSieTysU3QRLF2h0r94-N8i9QlRtBGLJf933DroP5k99neZMWHIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq-nz3XdQxfW2JgRS_a0jzviJ_HcQmccDgOOTR8AcoJA&oe=6A75D47D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPtb1HLsiOwQ7kNvwGN_DZc&_nc_oc=AdpRApDJwZPJxwBFWeqKDs49kGa2FeMP_1lcV6eSzGYEt_IbTKZ7mqrVRwqHJvxPrw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFW3JlZYdTMY2MXaALc_5H5R679qrIHNxomkRfRKHuNw&oe=6A75E9E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcT1JPRYNaMQ7kNvwGbh9jy&_nc_oc=Adrz6-mo0mXqb5-IrNPXqhYLHW0zZYnq_0rDxvnMPDxP5Q5Ip3DTkk-V2FPLA6xiIck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDh02IWewboOmI9TqV8RT8VNPfyMpQDfibyLt0DJE-7Q&oe=6A75E93C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdywH_vd550Q7kNvwHp5kYW&_nc_oc=AdpPN5Ml3xIw01lV0QU_7qj6grQufBykE113rYAdcA9u6u3JjT58
t-atl3-1.oculuscdn.com/v/t64.5771-25/491820855_822137817339573_7229760179140916545_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtElu82t1aMQ7kNvwEYmUsj&_nc_oc=AdoPAfUzpfnTLTKQpv2wP25h3Hgyu9XBfSWRi4b-Bm-UcrABlklFPHJbgDglZ9RUYbw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0VRV2NNd_3xtN9x_q65xAcKFzDpyZxo7T3vuca-Egrg&oe=69CBCC0F"}, {"file_name": "Screenshot_25.png", "id": "722112044246292", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGnm2uv_6AwQ7kNvwEVA7lR&_nc_oc=AdorwKLqCJTLRSImHWqSkjA405opcrFOMOMxgBXyqDGTKW-WFMpfupp2whkfAtdW254&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjCltZvAsth7TNCAeibFheBEwYybkxcVsx5ooGreDNJA&oe=69CBA9BA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqggSDlJ_pwQ7kNvwEhUvcM&_nc_oc=AdrRLQM3zf9V61iV9MZMwJgWgsmK1H3Id5CVt2TOKuhpNHdztiGPL-EfaIV_r0TLSYk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQsumvPZ1bw1-LBRenHXIqEHBo08sg8cfXhCvYtRj3Xw&oe=69CBC62A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=nvRfampKKXgQ7kNvwEOAviX&_nc_oc=AdrO7xJA6GUbhm5FDjvkRwUuRS6e4g81ZiIuW0LZOoHfGMixhpIB7XXCK7vf6xyZDfc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzu2JmNJTyxSIBkDqMgc1AYwAs5nFLq7vzzP_V6lW-V8Q&oe=69CBAD82"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evm94WN6PJYQ7kNvwGVXpdf&_nc_oc=AdrzfYCoTfvc15mAtxQ4-gJbXXLVcaqIcNRJVdroymvDJFca4scLLtUuBDQoyE1MQq8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwa--yRQKnC0PrZfaFnzr_6jzSoi9qxuya3V6vVIQtIQg&oe=69CBD9F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEjjQqcIeyIQ7kNvwE5u1db&_nc_oc=AdrrWB2xyTXGNJ6oJT5Lb766ic7HeBV66-hnNqH-LwPyG_PO1znfJII7uoPchYkHlQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5G6jHdTqlD6yLB1EoBim13k7RZ2ehL20Zq0PgU3Mpzg&oe=69CBC1A5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "318330666520
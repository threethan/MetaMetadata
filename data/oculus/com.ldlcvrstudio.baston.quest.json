.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQRcESSDmC4Q7kNvwHTuy6I&_nc_oc=AdrL625VH893ip4NO0Wu79OiVDYbZN_PtCQMiUPnAlT_tKj-V3Kk8zH5gWATo-pyA98&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U5NfoiA2g1X0Yah5ns87YLgVFXE-RIAU9QqtY6GPg9g&oe=6A09D281"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhXQJkpIu68Q7kNvwHvYmiU&_nc_oc=AdrKKfgAM8xYXlkSpCh1ksBQgxyzyiSvEeH9jLFq7ebdBU4A8hGj8NvF3EjnWKkPwYM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61DLEf_gVl3ZY4JjxsnnMZcNNl1XSbcapJFIVwTooFhw&oe=6A09CE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEWBJZBaUlYQ7kNvwGure3k&_nc_oc=AdosLx31mbPFDrm975740KX_Ur57B0HGsPgRRJ0wqHneHrRhcxfFN3BbRRtpkfWPEc4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BvWAmKpF06AV5gG56oSiR-_87Sm7lwojvSjBzJ1aysQ&oe=6A09B97D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRZ8TDHUNqgQ7kNvwHpv4Wo&_nc_oc=AdrhSYx9ErfzwSRg_4Z-LVuEzVbXu77ioU2xID_1bwENnt_ITzOPzBS1Tu4r2Z2-Gd8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hbys6dxO_pF7-c6MM7bkdfZPSJwxDTIqr2Pf-lRRgFw&oe=6A09CEE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7utswaKgGwQ7kNvwF-q0Vi&_nc_oc=AdqZkNvUuTpFRSwsamqKtxkpv1YqQM_Xd02RFy8tsTJYGtpNRTVlmMXdFm0sMInK-zA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bk4lFJa9-ju5ecAA3ERNihUtrPtbXuCtUbx4p-Qv_-A&oe=6A09CE3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL9l01MiN2IQ7kNvwEl6X1z&_nc_oc=AdpxiF9jvKxog2sZF6fi3Aq7BE5xUj8HH3ishOWIzuHTWaXOQetf
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul2lfXxDM38Q7kNvwHTqHK7&_nc_oc=AdoVXwUaIiypEWGUj-Rc_8CUMmpWHvXt1fdCR4-BcmVKayCsIGfKbPwPQKHUxxJNA3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1g2OCFS2xPkq8Z2aXaqyzkPzBUQMXBbLyxOieXrc3BQ&oe=6AE35A01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAGSps68q3gQ7kNvwFf3mAN&_nc_oc=AdpUfhXx7CdRwsDG1Gh1EH9lEcDTst0mEhSObp-9TZHJevaCtnAzWKqpVOWeSMbQKfk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMusPjIDDnkGfx3unHBDavvmHlroLmnSvcV_7Q4ZXkJmA&oe=6AE35596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyhRhFUFjPIQ7kNvwGYnjG8&_nc_oc=AdpsF3pyxN1wY-Bth93pMjMxI_W7tKHi1vKgYV7iVxxgsfmI1l_Lh9VD2IIObfRyGXY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk8oZD7gaTsD2CZuADjIdUg7QiWxYtEUJNSe6quQd5SA&oe=6AE340FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CM-c1ftzdAQ7kNvwEtU09b&_nc_oc=AdpBhnDpfge2WZaypkcvH9MO_XuGF3tTdpUROHOoc8UDsVZd9LwwLIVOzl4MfHqheJE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrwyBXkj0Nn7kRlRsMUYdacqD3r7SQqFDyrBfoRrEpKw&oe=6AE35664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-CvVAI3LUQQ7kNvwEy8Ipv&_nc_oc=AdrBeo6ZOcdlxLZtkrCMFq7KbeMg3WjHo5jsO_1OZ23sFrwqVzpVsEsfpvQDj7-g8ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ8-jM2tOBeIt-awjSdlFr-i4_LC5K_PHwjkLaEmzXCg&oe=6AE355BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe-DlUi467UQ7kNvwFghwT1&_nc_oc=Adr9KTgEmGqwWQduhimGIJQhKhZupRelFMDukEe8o7NPVmJU5zwH
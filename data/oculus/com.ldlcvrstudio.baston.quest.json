content-lhr6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CKDKHITPsgQ7kNvwHcQWib&_nc_oc=AdrwFvIgoCSrVgCkPjF6VKFHClBBOfoWlPqw2AQE93uOFf46zf7tZQzG2PU0MHAxwJA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsqiR9QeTom6gxzWiTgXZxKLJOvz7pKs93jal-8C25HQ&oe=6A8D7041"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ds7tu6EzRekQ7kNvwFUpWm4&_nc_oc=Adp3kB6OxygH_0hTLFnC1RzOVAgrXaA1WcCbuVqt9wKc-h8mdz6lbFh1m9u98AcVT4A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-qsFSqiqyE-Ip82EC53-m0RAR2nD2Rk1kq1uZL9hjgA&oe=6A8D6BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5zHGmK753AQ7kNvwEnySCO&_nc_oc=AdpLiHEWAh3S4D31KmhFMAqtrFboYXWSYf0clfji9vA1qSG4CDM6NpwNwykk-_u0GlI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5hLKd7IDyBhyTi-07e2BkBgCD0s1p6Q88ifyvpaeZvw&oe=6A8D8F7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfC5vLqhac0Q7kNvwEhNY-L&_nc_oc=Adqgja22Uuc9ay_LIzo1YFoIScVnhViOb904DIZnRi0PIhSZfQPOnzBSyPOw0a9VTDI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrC4VN0ptdWJ90TZ1vAl_DXDGgQyZsCKwmKpO4WhB-YQ&oe=6A8D6CA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tas-7Oxfm6sQ7kNvwHgojbu&_nc_oc=AdoUGs3L9O6ZL3Cp_Io544UgAv4RTv9wRrJI2KjW-fpBEptWKtqMWRV_vzxdRs6PQPc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg_Ss06ro4Aq8fkOjBr0EWEkU93Zh7Z3zDC9rk7LbRNg&oe=6A8D6BFC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD1_7U8IkwcQ7kNvwG40EzF&_nc_oc=AdpY1-tG8565WzYUKm6UKEis9xTNUxUK5tKD
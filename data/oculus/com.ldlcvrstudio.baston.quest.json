.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGUTB3Zmj44Q7kNvwHneMXr&_nc_oc=AdpYpU5p5bVA5oZNq6X9ua_xr9jLcfU9k1RVs0LomRFQFznSqy_8267gbbm3eUaR4dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmroUa6kYLQuj7rWUNIBZSU2a0rII4kwThpUhxi0_aiQ&oe=6AF72081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFD8XfuxJcoQ7kNvwEgIcoy&_nc_oc=AdrpfrYsYRN-Xqgma_K03aAqQZp2dGdLLcm6y9AxZHdk9F8Hs-TgVm9euJdv0u1-t6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqUy4MqfwwXQsnyL6HMdIfamvoXNt2YVkCq6XhIBWHyg&oe=6AF71C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MqOPt3RujkQ7kNvwGSkcko&_nc_oc=Adqo96Y9-8yK3QGM04SQxiQBnCHZnjeNAnC3OqvUw6ErhHiS0CbMpPZxW9AT65CeL_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPpUYM1XmR6xobFgnWBs7bHxh0jzqvssGa0O3fZadgMg&oe=6AF73FBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTfbuhTwt0UQ7kNvwE0wyJH&_nc_oc=Adrz8MgH-WwNXAIL8vMWp48GnPE4vSqNPZ8NgTlRWoXwXmS9Losn34C1l_4LvSofcIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBZDSedsHIHAaZfGdtvsAopGVinteat8v8-MWSJ0QHfQ&oe=6AF71CE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzlw2PG63fwQ7kNvwHfZnDj&_nc_oc=Adrq_2o1E_SUJ2GLqacLP8-TR8hqoHPI3HxmndpLM0EJ6mYaS47xqupwTJnVwVEjqgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_cAM3vgBRQcdFJUxjBpAC3GsqPqxMo9lfVpXnyWdqMg&oe=6AF71C3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA12SYF6dagQ7kNvwHHtmHr&_nc_oc=Ado59t3hb-YBcxA4SPp5pFEOW6JtwoKbjBeAZ0hBs5pEHKUGe796
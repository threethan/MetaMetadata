.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V4FHTqYDe0Q7kNvwEJXrLR&_nc_oc=AdpsMlKDD0JtGO9Z9Ud6DH5MR049vnl_GhRbwmUPtVTpVjMH3OdxHpiH0ghZ7DsjZkg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2lZN4zu2cEA-CRcSXVqxUnqB-NCeQQyEiCt_-wQY5JQ&oe=6AA2C081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwkRDCX5HmcQ7kNvwGzhYME&_nc_oc=Adqr0OUE6Gj8up5DoneR0Yfay4GpoSHHe9T3KAxXZquTxFG9ra4SihN8-MKbYNg0h_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyFkwi1xzCh4eckCVV0_sGeywfF0NhxDg_cM68gH34LA&oe=6AA2BC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN-0kwwwlREQ7kNvwHZs2cS&_nc_oc=Adp12bUtwZTFeYNj-JkUApIHio2S-QVkZj4w5yzrUGkKXugThYixAlaBc7cYQdIQAW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUl9sKuEpe3YX6PYsr5Bq59gLj1mIDQp-JRCSLQuYlEA&oe=6AA2A77D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmQmbzYKnaAQ7kNvwEbQMLs&_nc_oc=AdqZgWNnxMK2XWVKyEr0pq-KzM2CLTqq30d79BL_E9XKbTGNagNbETzgIqRlKGx7yio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp6mMQUcsGocSpCF1olfVdwefw59SIV512oZoZOWHmmg&oe=6AA2BCE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHdNcOjKlMYQ7kNvwGyfXym&_nc_oc=AdoOWoGl8hdL4RByQqcphLexA-OWblWtJbe8mi5mat_DxV4XqMt0Iofz-VXQZ0anKHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz0vtrBILVP0MCo7ZetEPPWhicFoRWt0pDL1-kg93MFw&oe=6AA2BC3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZzj5zVLSnoQ7kNvwGkGv_P&_nc_oc=Adqgzp0BCKAd7sWQGdNw5vxDQX4kh5cq_2kAMb2uX5FjR7_WSqQ6
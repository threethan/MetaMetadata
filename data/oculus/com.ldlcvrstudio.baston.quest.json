sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGw-YF3HpIQ7kNvwF8I5ST&_nc_oc=Adqws82R9DbpqjV0LE6VjoHXP-qtoQ1HA2hUxV71JX87r6c6Zzv8ecZ1oYzUIRUcr6c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5spoTwqcXko6S3iKJhPuPUCBNKwv1Wpk1aCfT9eDXFEg&oe=6A11BB81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S-lFTHNXw4Q7kNvwH9VSOo&_nc_oc=AdoYZ7mbOu545dSdHQWwc_hDeYaoLjbroKe3bxOLL--JTjlhdJVHQyuqUAn9ebwMvBY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GQ1yeC5WMi6jv88fVMzIhB-x32EC1E02LfgxAwwPYJQ&oe=6A11B716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1XzmT3dIeQQ7kNvwFoRPII&_nc_oc=AdqxvdC0JZdpdzDlNtYsBPfkBZzo84tCDm05ijbV1-cY2qn-_Asglrs_O8tkOy-kvUw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DtmW9P5JKCwHgDOYC0ou51q2V8XfLVk6liOrSDsA4kA&oe=6A11A27D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUlqb6OzWTAQ7kNvwEVeZi7&_nc_oc=AdoyDBReslnV7UAqiZMCUkIGAtL_zFgKOzBqvjQQsbIvxlPGmL5zDCT3y1f-1dthB90&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70auMywdS4qLS1RNnB0BhE6zGDT5xvKBfA4AhO9FN3dA&oe=6A11B7E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfCK5O9kFIoQ7kNvwFvQBfz&_nc_oc=AdplPyhLovAmKOT8LkDXkyvW-in7ClOq4AnMlVEhcntD7OGQnhF0-bOhLU2DfoYaabc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a614iojZ0Ud6KvPz4adPpcZUiydz5m5OnFevXzs8X0g&oe=6A11B73C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JWle5hx9tYQ7kNvwFLHHTQ&_nc_oc=AdoRgeIa2erLtGnue8pqH1UqLzRvgSmFEehzZ2qQPywJc7
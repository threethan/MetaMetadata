sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V4FHTqYDe0Q7kNvwHJR4p8&_nc_oc=AdrErTQ9tivbFqyBCBY9ETYM29HJtJ7KEZAd-PMOpZfxt-s28VsDNIkhauFJPJkTKqQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr5XeexT7TgBSql6OhX8NyK8tf0in77Ef3gdK-l5VY5Q&oe=6AA41201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwkRDCX5HmcQ7kNvwE0X7pV&_nc_oc=Ado1TPBgVZk8txSaCh6f929JPyw-Qmj3ORghyytFv7dC-uUbfi2B1x_p0NiyUxZjJoU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVu7bk2V6Qj21_ozA5e5aPnWD6U_JVzP-_TiYw96ZTZw&oe=6AA40D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN-0kwwwlREQ7kNvwH2HYRO&_nc_oc=Adp8yYhHW-f3P6XCPlOI3hS_cUpGfxjAu5RTn5qwO1tWGhtg5lKWAa2rSobQ0O6wZnI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg-y0Vj7ywkzb32oYBSd5Io6AfUBCy_BHJ_tkNi_o0kg&oe=6AA3F8FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BayNeBSjBQQ7kNvwHkWQMj&_nc_oc=AdqGtOvo9yH0fNoFCkUElt8bg7U95BZow2GZyZn_YwCS-WgAB3Jvg2MxxBWGVI9yqe0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDnyk1wRQuMxhGr9lKPxnyaPJi2Z0qfdRx9rsV8oIPyg&oe=6AA40E64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi42uZPEkC0Q7kNvwG4Hgcx&_nc_oc=Ado0VGZvbqBkmmJtUi4HP3qIY66rTUY-6gBBwPqC4eFJIvBvl0J__RliPvlw7LI_G68&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhvOJhKWgj9zadJ7MOXEyb9vUmyn4rI7RlLjeOA9-hBA&oe=6AA40DBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtu0mrB_z3oQ7kNvwGi5t0Y&_nc_oc=Adr_POd0l-xI08fggt7GeWadUUSD9WWTq3vYf8PUuFbPve
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RmyCOpk6M4Q7kNvwFLoIiN&_nc_oc=AdqVGiB5qMtF3QVo3CAoF2dAE900XpEWaRQFNN1O02hd6hiBhkS1sBcGu-OjuNyRdvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Zsc1AsdjcrU1V-Bl2SgetMzuTrpd6MkFyCY7G751TQ&oe=6A2EBC81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ua1IAn0CdUQ7kNvwE_8IJW&_nc_oc=AdqLeFZlIydPsvK7OAfv3IE9DLJ0w5IC9z24Bm-Zt_rapF8cNuJ90yPrjnhN7CPf2Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IKp7OcuzaOOYoEpg-Aml9mrzcaF7aIuj-h3XIeVC_EQ&oe=6A2EB816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DAXqCnflVQQ7kNvwH8eBwb&_nc_oc=Adq-tyDa4FMQr6URI5LuVh6kClJd5TzgH0YOy_gbJPTGavHh9QIt_b3HfXbfkAg5-qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f41fIAUaHdBLChl75qrd9A_1Ryj-tC8HLZZveQh5MdA&oe=6A2EA37D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM11OrhSMBcQ7kNvwEqtHqu&_nc_oc=Adqqz0DkGTvYE3ha3cRc8jI1d12E4myAqutaUlC2usjWtt4o7wJKF8JB3sbwQhqO7K8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88sge5UlOEBPS3wbTw6x4230ak4JD7HrQaSLXz5rB_iw&oe=6A2EB8E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlBSxD5YuL4Q7kNvwFSktaI&_nc_oc=AdqpQgc7d74rZCcrJ1lCzkf4wycV8cS1zUZvWAGEOYSw6QboQfCi1dnbE4OvDAI--14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WtDiMchhlvMERzfFqLvcEHwxcoOyR_Kxf2rlfQ7S2dw&oe=6A2EB83C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_-YeXMG7gkQ7kNvwHWXnso&_nc_oc=Adq3_ADiThjO-bXqtjXK1xi5daoBlbI4GyXJ7AqbqfOchRQGvW4l
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkLjyiyBNsQ7kNvwFWnPkJ&_nc_oc=AdpS9uf3pU7YfyYTJJHTbHt6YY3-NFOtpyuby-jF9jLetMso1hSV2QWvBMVBFdwJ3vY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nVD7dxL3zrrYlH4HeviPcWEyS38DnbPTJ6FxdS5YvMQ&oe=6A3E8E81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op5dCtOzA48Q7kNvwFeuvzO&_nc_oc=AdpqeQDfB_qYCv_auNAtDg8bJhb_MKY1HNk2RgwThRkV3wRwPcxGwpffEgZeaB3-fUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LmkWhMEXp9gzBJp9MSKrQVSUdQvbwCMQ2sIxCUXOz4w&oe=6A3E8A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qdodfi3ds8Q7kNvwE-pXx7&_nc_oc=Ado7JBdlTsNz40J9crU4D4PlCqbrx6IcM2XDPUqkcxQPKTzvX32gZ7-_EgiqYQ7tQ8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UWi6FZH4xggvKQlQtt7nQty7sGSYJ3Una6kUd3Sigdw&oe=6A3EADBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl2qzxccbsIQ7kNvwF0ZhxI&_nc_oc=AdrK4n9X85GiV8dQyy5jsCbMVBJZ3Us1hzjagIKKoBeagYgz2zW843FllYIruxgvbQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JTtEc3lNAXQ-hITiNOC2UAgVJjIG-0Xt9G7pqSRLsGg&oe=6A3E8AE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlFuyst7n4cQ7kNvwFeQaA8&_nc_oc=AdqFwCnNm4LKANls9WneeAJsK05hLzTLkqK5dED4S3o491mf3R9F-cz1tFmNnlEs42E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TOH-olA-O7EzVPDnaUqpCOpRBYyh-n9yDr-QAoHbSCg&oe=6A3E8A3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwZqvFtSr9kQ7kNvwFdElTQ&_nc_oc=AdpvmSAFCl8vQI8e9-FFDd81NFCZGlMsOy4VjYAkNTH1w2IWZVf1
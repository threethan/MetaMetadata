.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siHY3paBT5MQ7kNvwESMH4M&_nc_oc=AdrCyZBO94Lj9nVaDBfyJHctT0zGR6P0UP8bv73aru0tBAmo9MHbng6_oOkShMDz4cQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5JdjGw8sTR47pp46fdEpSn6jDTK7nma3RJJpjw5_LDQ&oe=6A71F901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdpyuGQMGDQQ7kNvwHZBZqv&_nc_oc=Adpklgdf4XmRIBNeJ1dr8aIdsfsy0E8D31IW2OSIakrCjtrqljAR_JQCfPeU63mghoM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz-4IItBqYPFBJWhz4Ro0vD1XUQcaPCmNkbgpRFViBVA&oe=6A71F496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S96dzsS0ioQ7kNvwF0GTYg&_nc_oc=AdrNuLWGfy9YxAmP_3IXSiONMZ9VjhxGbZ4nyRid68PitBuEeoj0VO5lyAwKF5I85Hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM8sdKuqqYYrZ8u89DHmeBwygDRg7mE4cqnB7775Qliw&oe=6A71DFFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihpbrCnc-PsQ7kNvwHDXr0a&_nc_oc=AdpaHda8j7wATbi3awOe_Ur8bMyNYZTlo3hCO314IgaUfWBEwd3i3RpYQUtICIyEHO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgquA-ZdKSEX37agh_35UHgv7W90NW33gdefvVbwk3pQ&oe=6A71F564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBLjjiBF3psQ7kNvwHvLzlX&_nc_oc=AdrODcKF-QD50Y4sm5_m0fnEoHr2ihCPsGjykgweVcSg0ObEMRKop0iiY4viGLhZ0I8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpEVsYZHkNmGRQBOk2CRpFV1fxMDIyWzlwYLIYiiCO9g&oe=6A71F4BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyNtIjV0vlkQ7kNvwF-JZmx&_nc_oc=Adqruwy8PVkMsXkZsIvv68CNDedyJPPodzfrlpozVEDi8aLvF5Xt
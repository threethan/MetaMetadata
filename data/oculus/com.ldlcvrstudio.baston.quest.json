.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul2lfXxDM38Q7kNvwFvwpSW&_nc_oc=AdqySlQr0SgqoM7VFPE2-37jTMCvWYeGq0PiZprv0AMq3VPEtx7T5D7l4FaSdcgCY_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeFNS8_gV7cWYN5uKRn-YiJ2LvPsicxfRqykb4boHeYQ&oe=6AE0B701"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIhHnzAng3YQ7kNvwGcCVex&_nc_oc=Adp-D039jGB15ZeSQ3nfbnalqWMiRBCVRmsJVerc5tPnQsylzAZZlrQVMJc2xI12BZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTYrEYj-LJB0zLSYNmaWjXYm1dPkqNyX1-W-wF7T8i_g&oe=6AE0B296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5V1aY9wIn0Q7kNvwG8axyQ&_nc_oc=Adp3RcgNu6Fklb-8COnZ1Fay1UmdZmDVwHccs2dVAEQP3ztc6acj_W2YHL-Mub_icRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqZZT6QcarOScXLTwN2HsCsXV24xq-5kT0Zc3WstogwQ&oe=6AE09DFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8Z6rxoqD54Q7kNvwHq-DSB&_nc_oc=Adq45F11l3MtgzujT4hG4G78XiBYZWj2eVJhmciMhZCLCnAI_QT1izzpoBdmTIKM8y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH4vKqSlbch3XqhOp_r2S_PffkiwUdNpjyMoK7aWQzxg&oe=6AE0B364"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvsKeksBbXsQ7kNvwFraymO&_nc_oc=AdobfOzgN7zr23Ggw33sCRnov--OZikbCd7blvsk4yWIguoW7sflZacqV1I8qE5Y0g0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKnHqC2e-FVc6c1HCAW231eOolb7oAdJnnJ64TL7lSNQ&oe=6AE0B2BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaWo41p_RggQ7kNvwHh3WYc&_nc_oc=AdpGpl2fHb7VetH9s_HpX8n5cXowqLZYkGx42g5tEJ9w7IRJqBmO
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdwOznL-IIQ7kNvwEpgZlL&_nc_oc=AdoVi-AAofZ72HJesXa2Tiy0frTExAIVkvLPyJLV-_nDUVKDkXgVghLypoi1fHWSUkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL15txq081WJdVfr0lmM3Y6GJYminVldhw3KJuibKPq5A&oe=6AB92A01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LsVdi5jw4AQ7kNvwFRYclS&_nc_oc=AdpYTKxBCrx8diLb4VDSuQIiFPbvnVoyBimZJRaVYqM4sF-_96S6gu02Btyuw8ue878&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeaLlI7JT7ooVLW2b8xU9XaVXyMpmzS6hYOcRlTGJ0ug&oe=6AB92596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxbaDT9aqqwQ7kNvwGfVsQd&_nc_oc=AdqrtXpl4Z-5QpjyrqvEvr-2vkaNMX5D20RQLjIxgAVYnzvHR_Rsw8w1xDU-Bk9lbiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxzcZO_PJEos1IjuwsgCGnsmtGR_ytic835OgRFLpRUg&oe=6AB910FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRNkmhqtuk0Q7kNvwFGedI0&_nc_oc=AdpEHU6np6apGW-HRnbfJB9_wHH-Ma4IWCZI3VijsmEVTHI7-709w3965a38vUyWFfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKukNg5K7y_xnfQtNuLiLoTrABYNEvbSjWWGexqCW8zvA&oe=6AB92664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6XsZJ0SNGYQ7kNvwGdIAg3&_nc_oc=AdoxFf0Fx0XIZMk5mZ41Yr4OjkMscGdPeAx6culVtzl1SDcqw-7POSrKq_uyzl_xu9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqt-CFGRS0ErYV7a4kMxbkVb6dJ9vPDtaZiIf3u66gMQ&oe=6AB925BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DuW7v0iI58Q7kNvwGw4MC4&_nc_oc=Ado7UxC0JEDoXqJvFwvho2Ijby7iM7AQ9nqX4dF44_LXwOWOTJ_3
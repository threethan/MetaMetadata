.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1tpCMWHXa8Q7kNvwF8k28N&_nc_oc=AdqAarHIxARIhorSfefOWaEZo76xkK0XeaXOzcA1DF16tT0Us564T3XvQPibfQIfWh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLOYFOr8U_Q1Ll66epgtfYoH_Icz-L7g8Nl_x5QZTQDQ&oe=6ACCF081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1S7c091_4UQ7kNvwGY4WYz&_nc_oc=AdqR4WwO-j3BLjyAs5vTcdyR4_yuTpt_c-mK9ZgCK1VFWr_JMPrmDBeowkmEIIZ5doQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO79EVsLy5RCdN_ovRJRL2DYB5P1MSnOJOTNBebngH3bw&oe=6ACCEC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiNsrRhec2oQ7kNvwG-qCqW&_nc_oc=Adrbe3u3YC3ZFEQBhPJF5DxU1WGcI6r1_bFNl7sYqaLqd2kAxljZfbQvgTEkVVvy4gM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUyrqwUfSInW-pjrjiBL0Sp2OqePltywFHQtEDx0s5Qg&oe=6ACD0FBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfz1VijTaCYQ7kNvwG1Up0O&_nc_oc=AdqbhyvSPLSeuAFpWn-frn74sBzRbwLRVlnf0x_V_ua6o7WNqH8WxyBfze8IkapskTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsPdTSU-k6itCNV9w_6C0NU8s5wsTW5Xut75BuJsyhpQ&oe=6ACCECE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-WOukNMbsQ7kNvwE1g8f0&_nc_oc=AdplGOyTrTpG9dK0dr77ieGWL2_knNpytjWJ8DJJ97tiF1cIw7DFW5FYW9hekQRF78o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3ffdkSW195EnMuIq6gysVUoiObq6ZqqQEswboM7OabQ&oe=6ACCEC3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDrCORVITcwQ7kNvwG7Su-y&_nc_oc=AdoxWRdwBsUCBH7QiFFSiXGwOFePwWNTZ7WTWpONFJahBGu0vmzC
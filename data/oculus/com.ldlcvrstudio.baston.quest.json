.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRDCidsPWTwQ7kNvwEiXTE7&_nc_oc=AdoQNZ43qzyRutBYwXls4f-wo8gRaVIUd6_0YuV93FV_7kwYkKJcwIZIlF6uXZwF0jc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlAP-kGESC31P-jI6PHykilnX9z2IEBsIRAVmEvfzcnw&oe=6A82E441"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u-iePDag4gQ7kNvwFyMZ1c&_nc_oc=Adp-1mkOCLQ7Uz8_fLNtS9aBfvHrHSKlvRvB7_X8faCUNHMAzJ5hyTbm4sT_A5bKkwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXsQz4CKpV487RZTvGrrZzN9g66yeOWqCz21Z8jx2snw&oe=6A831816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy3TIvAR5qUQ7kNvwEpe7Ao&_nc_oc=AdoOcGrIVwLjxFG3BgUqi_2mNmI8Ejn3zRg7GeuAAOLj1ERYXaaInfaY9aVy6KZ3MbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmr6ZrjTpEhsaNRjOB8HdfHtNT4wMVFTTozszELgej8g&oe=6A83037D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVYV_aKDaRkQ7kNvwEz73bk&_nc_oc=AdrnD6ulxEeObdTgi7w-FrK9ibH7FQsPg493nS-vVNEDBpmkNfBYDQN7Dr-roW3-jaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwIQPHmvvAmzE6PdSCIn7IQAxI9RY895iKbvJnsn_ZXg&oe=6A8318E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQuxMs0AYbkQ7kNvwGcGAmL&_nc_oc=Adq5bZLrSgNmjPrcI5zdQlctp9MxzM7Ely248MqI2Hb1HOKhXWpbxSvN3IyBKIM94ZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ09-6vbCK0shoIDiZbZlsG31HBwX2sSPhmHchMPN9Tw&oe=6A83183C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOT7SpRbQAAQ7kNvwFZnnz-&_nc_oc=AdqgZo9Lll0cZDy4pWT_JgT2rgS06gIs6eNqw8RRNDe0A0CCccUv
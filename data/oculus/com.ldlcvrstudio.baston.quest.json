.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eif4BI72FLcQ7kNvwEQ5gf_&_nc_oc=AdoezhWv9-V-E5EP2DEcwx1gTfiFnKaPPduK1r5uXVZ5-5WlsN3xDLnhfJer_VdUlGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfcbmtp66WZGNUbSOvQBywc0d5lB8IoVL42UvTQRWSYg&oe=6A7B3381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RFgp6iH3BMQ7kNvwEtztfY&_nc_oc=AdpHRjxNRWmufM_TFfLYMwlrqB5Mlxnu_IIZySB-vACZJtVeLy1sYswI9QgpjHWtSag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsU_b0MHUAoEGvBrR7uFN2LxapX-djfPUbKGCKBbW6hw&oe=6A7B2F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rdvOW3H6dQQ7kNvwEE9HIb&_nc_oc=Adqyt90U5gKCZYP9s5gtes4avb-1gJTZAmJxubspudYRsNlE7cd2va49ubaeqLb9xJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIvXwhZy4K9nX9uEMhLhhTD4ro8bRLCpJb1D_jCHrQTQ&oe=6A7B1A7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPOL_c12giUQ7kNvwFANIJO&_nc_oc=AdrXoudwU50TzKZW08PeiebS6dAfzXU2IlZ2hVezprsKHUx7dV4KUOPR9PGF4E_MWyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7q8b7PdewRNi62wRZ0UhgWhOz1F9aBiuQ7AbX5KFdYQ&oe=6A7B2FE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7qBtxDCMdcQ7kNvwH_bv3-&_nc_oc=AdqkvGtckgMzogJzIB7u2OFy_PcuyGoOb7GKhDkz31g_8CtM1BnXJzVondRN0RynwBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcdueHfi8lr67ADynU7bIQpprg7jNONnParLx1ZKgazw&oe=6A7B2F3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSvQAzUTJmUQ7kNvwFOvDmZ&_nc_oc=AdokxBz712HP_KuqMtgsg4O6x4JiYribt76VA_LMoA4BjlUbSRjV
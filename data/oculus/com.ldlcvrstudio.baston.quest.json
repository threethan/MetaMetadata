.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siHY3paBT5MQ7kNvwGP0IXa&_nc_oc=AdrYxfT9qlXW7sHZe0LfuAnRowDtANoWwjCdcMymkpWQGD9z9nwlBGaR1k6VXpPpSFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9h0N8iU_VEGT1i1t-GaBg5AEAjcylfbPb26DaTPVxwQ&oe=6A749C01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtz77Hjr0gYQ7kNvwGgIPgc&_nc_oc=AdofnPVWzxl-tIB1QGk1p4JOhX70N_RqMhbx4K2GQn0Jjwvc0tdt1ANLvpGJt_8Yw8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlwq9fqGwKOKlK4WzTZK1jpLZiJ74nTKL-0KmMBs9FGA&oe=6A749796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riY5TEiTJUsQ7kNvwFuQ_5T&_nc_oc=AdqUmQMr3DfTVB8rTydd6VgHoFu5aYQqouyV6-vD8mArHekYA7I8j4R4vyK_ZS0SshY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0HRliC5GVZa9ZPLoO96IwyhCFqxLzEow5C6ePnTpI7w&oe=6A7482FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPtb1HLsiOwQ7kNvwHfiPVh&_nc_oc=AdrRkfIl90x3ZNf4PNCfENykL3njucFwFLg5cU4OfmV7wuKSk6v-6AS7n-thPxGCiK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjooAgF69fwulQTUs61VGe-35VptmLa-4VkCgZR5yFfQ&oe=6A749864"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcT1JPRYNaMQ7kNvwH0oITZ&_nc_oc=AdoxJ7fIjKKoxNXKFM1zok6HX_DyBp2vnbVjZq6jqi_83VggZx0wZKOc1hoxTy2_Znc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu5S3oCppKiHo7mnYjrgyB4bit-W-ftLUzRjo8GWWoMQ&oe=6A7497BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdywH_vd550Q7kNvwHqVdbZ&_nc_oc=AdrWtA6oj_92n5ePmo3hz2r-EQlonjjiz7SeJtXwfEp_-aQerblr
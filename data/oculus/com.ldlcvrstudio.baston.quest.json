.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRDCidsPWTwQ7kNvwEG156c&_nc_oc=AdovSbGOClv87afglHUMi89QrML4unKYCkRXbzUcf17nlUgHaculCpLNVs-e8g_7IoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHqHgLN4J19E6Mji1DAMy4jTaRcPEVYR78B87KekZEVQ&oe=6A8435C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u-iePDag4gQ7kNvwEZiIli&_nc_oc=AdpUJWQ3N5wig7lVYM4k2EmKZgbGdjvihPAtgTUeGrMvqmi44VqeCg0Kw6V0CYKgp6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoEBQdSirrR1DjEKEPzkRVQZ32JYpZ_mUh87RgDaCj8A&oe=6A846996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy3TIvAR5qUQ7kNvwHKagKM&_nc_oc=AdoFYGHezVoYOdWwkPW5JurQPgI96XmZNiegM-dhxaf71nBDe_7JNGPRDOp8NdEMR3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX0P7ezTqADbiQJTO2z_SgZf_0FEFoHIpm8ro5oswiwg&oe=6A8454FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5xREehhAUYQ7kNvwGaLVb6&_nc_oc=AdoG7hBVrhBFUB6Ok9Nt-CQokXRtcslEW3pgoTV4lxpyIP51cqVwY3vNxOz0rtXODXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLMagyqM7amQQCQIH6uiWfwmkqlpJukrpkCNoWhX1WMQ&oe=6A846A64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrGcAE2zHmsQ7kNvwFf03dQ&_nc_oc=AdqLX4-KgQCORP2AZ7jToqUqr89QdXC1Jtx4pNsLyPQm5zhTtdFnMEp34jIEkXm86xM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhiXBVKnTu2cbUuzBqENaLSVYUuDPzioG4ABJZlVW8vg&oe=6A8469BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRKux01TwW0Q7kNvwGNwE1v&_nc_oc=AdpwhLqYIOmXi8BWp9HQBxn4C6FZ6x8lZKg_BF7VIDXB4GFZfZ0-
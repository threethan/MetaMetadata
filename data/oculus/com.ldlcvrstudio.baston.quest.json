.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD_1TWj1xjYQ7kNvwHBY-E3&_nc_oc=AdoQLIw55F6OLTtS4r9yyVZLmY8lWTFW2EEspl2V15HgZ3-jIiKrabWDju5xMlknrbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qYEZWPm6VZtYe8KOe5i1elhsdkLGS3I9dlbMTSacJOg&oe=6A2C1981"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ua1IAn0CdUQ7kNvwFDyOsb&_nc_oc=Adrf2lr_2s04iGII7807Ce7wYI88pLbwjDZpK8E8GHdrH2KhdqKZ0bMhOIIH6ekmJA0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aRyAMALOkIvO1idADOSPQfFl_xZgqt6g0tKzllvpFcw&oe=6A2C1516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DAXqCnflVQQ7kNvwFmZuO7&_nc_oc=AdrXc8RxVueRxoOwmtFSH9eP4GrNggyfDtqN-lQPjtJXyIKmEtC6kyhRNfFJPA3zeyE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MvqbEK0J4tpsAHVF-gQ6d8CrtzBZn6s9pdP_lYmrhdw&oe=6A2C007D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPPL0JizeRIQ7kNvwExQLfa&_nc_oc=Adp3-8EMonUhIXvYK04OQ7bHBYdN4yCMXSn9K1z0UkHu1EVar248mi9OyZfNXfI0Drk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pweeWon0TgJTb8NQAr1AJ5hqiHXMSAKySc56ePka2tQ&oe=6A2C15E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pUdXwlqefMQ7kNvwGb8veB&_nc_oc=Adq8KBx2T7Tsxw1c8bw29GeZdfHCJioaM2RiKyuPhjk1Cqm3pyR6t0-rDzAMW2_Rhk0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WkxsRKI67-IQDRL16DGiYo_bXuYA1m8DagfQG19sIMQ&oe=6A2C153C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaKETxT8lB0Q7kNvwGLn0Z0&_nc_oc=AdqowxYrmddDg6AWuK9G084RxTXwul1dFboEScveAOEVGo0_zXfQ
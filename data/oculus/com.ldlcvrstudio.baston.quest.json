.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CKDKHITPsgQ7kNvwG3cMXC&_nc_oc=AdoCri0l5StyjySwqtry5N5ruELlEz3uVEqnz4gZYdiOb3BISmnzWc8j6KaprXcJn5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9eLpe3UfbO9E6pEHR3BIuRr8Zqfh48zxNv0IB7RdVWA&oe=6A901341"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR-pdyfkP-AQ7kNvwEIYtRA&_nc_oc=Adqv3qrfupJ2XBRu-siFKixmtcdXlS6W4Jnwq50LF0W2WkP1NzYW_Y9qngefo1SIOZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5o1EXc4mZaj9bYVUk3mnV3V72bqCe6bWAfT24vs-dzA&oe=6A900ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2FETKxb2aMQ7kNvwHGm1Xo&_nc_oc=AdoU3kzDdBDQXVdo-8kW9zpSi1tT_YcFpIyFOe_widc-_vvE_QCEGOnQPcCwRBXY6S0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2hx6eI89oVcvcXEASRTyeJsnVnAXajsADRJKxS522Yg&oe=6A90327D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwQLI_-bdnoQ7kNvwGo1Xn2&_nc_oc=AdqKeeUCy9jOblqteU47iiHRbh93MhGYasVAn9Tet9jR4CD4EE733dioiA0Neh1YkAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj1Qlf0zGAvBPnISJdBFOYQ9rxew6V5Y-YZhWZui9ypg&oe=6A900FA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUZxnrtQ7xQQ7kNvwEtyAwQ&_nc_oc=AdrsSP96uc1qMH4tOAnANPtcw5GMLsmGUKI4Es-MXFE40R0f2-_TFlLZVnKLrhv9dps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhT00Fs1037QwzyCnMdlXpai35QKNgd_a_MfonqnJnSg&oe=6A900EFC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4lPmtFXQFEQ7kNvwGI8Mq4&_nc_oc=Adrk4TalSZ1QHtcJsCyIRWZH8JvluWJaSBoRuUPxJ9OdExLrwhck
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eif4BI72FLcQ7kNvwHwc6eI&_nc_oc=AdpikG71M6dY1UUkDhXkVngOAcWuOgvlcy6MDdgKwoqfa7t9Wb_kx_zNbs154_X0qGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMQ-tlC8XQZa_oq587PEL_V18Bp1n75c2QtZslIhwaRg&oe=6A7C4CC1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RFgp6iH3BMQ7kNvwEWtx5T&_nc_oc=AdrZgPoTGQ2fz5oK8WwNBrJkIT02N70WftX34hGRh_H6dzK6_lgr7ywIH10My31YL3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYvy_lGcWOxlFT5dIXXAuwfIRKhaWNhgQ-IhEGj8lZyQ&oe=6A7C4856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rdvOW3H6dQQ7kNvwGkuoFH&_nc_oc=Adpf2Ro-c4oqUtbmBqEIvcnwMVFPFxGE3ZxJ9tbaSOjKIDgB3GyHA9rAQkau9ZiCiUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2oFboVj6YoPSHsjWN9APCP3KK_U3K7AOtkE0QvgoZUA&oe=6A7C6BFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIuiB2izH6AQ7kNvwHGD4WS&_nc_oc=AdpZmUhMyA9WvEeGIi4RYuOPYu3URmHDS8XY94PjG238RmNvTU0J6pHZgflzJBN9_1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcbqPDCvVnVicZ14YzYbchDD8UEeZVqP8B6qJtwpoPdA&oe=6A7C4924"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwmX9X9yx74Q7kNvwFxfJ6d&_nc_oc=AdqKxYZHbrXnK7WjROChfGbwwX-YJuLCwFJM0YKDD7CPZh5wPgpQ5gqKjxiXmbO6_Lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1avyBJsAKE-wWdvma4vywdzt9-jUg2TeQ2wmzHgMf_w&oe=6A7C487C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkqpokAb14AQ7kNvwGjcl7R&_nc_oc=Adr7b4igdpsOrRdDglSlHyco6jxrynLG4iqlAPwMgnvNYQuA5JXh
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-9y--NWTzoQ7kNvwGoRZY3&_nc_oc=Adpv-AQU7A8-UDYrjMPrpw2fiTPN8NYkBirIyextygGVRWhf4UYSODGt84HpCt_h-sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl91y0qJzEOEkfiokpTV2Z6SALzVTZ25FCv5yzBDXisQ&oe=6A998601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P9lvGq6yCoQ7kNvwG5aKlQ&_nc_oc=AdqdVTtHdXJQyzdcoujpNz7w9m6tcMBDJiouj5CYpAJU2vrFA_wX9TKmO_yAy0HsOLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjvq_2HJ8GxQHKNhXvNMYd2K67Cpndxyg439FZe36pug&oe=6A998196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZxRlYmkMjwQ7kNvwFGe4WP&_nc_oc=Adpz8Ak-3SQXb33iex6LcpYA6g52RmDmnh-G2SMLV4Q4LcAU_2BIqJ78lNyg8cVswXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWgBBd3Ef0sgCzaTGE9ijdSUn8WFTNfo-yLUHTWpE-4A&oe=6A996CFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvGjnie-THAQ7kNvwE1RcnV&_nc_oc=AdrdU1OtFUeloR_qVX-SX1sqytAJbdKrwgKt79Aem8dHWO77wW378GcJl_bnW1lVMVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOKElFtWspFvM4AIHpLYF_RKVRTvoh-wCsnxJAkwanXg&oe=6A998264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_pv4UWnAWEQ7kNvwHzavSm&_nc_oc=AdpBrwRwjMaPnf5C_Pc7q_52DDp_1kqHh11Jhi4xo-EtC3Zzb81T1sdlSqSpfOCDq2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkQdE5Pr-O2UCZsFnxoFrqvsJe7SkrJuzf-YScdt77rg&oe=6A9981BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zJCyJyY-fAQ7kNvwHhCgIK&_nc_oc=Adrk4ntOCASloSHTpbyRsMcdofM6bjgAwy12opb2cUz9_KxUrdZk
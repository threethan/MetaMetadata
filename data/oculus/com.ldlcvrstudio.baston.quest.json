.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VPG_6WvyAQ7kNvwHjpWFo&_nc_oc=Ado9AilrjIOlv0u8-oZ6S-CqcClVHPXTy4P03WTtoo_YAQW3l-LL8ujVLNmp0RnxJaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LF2TfatTZjAwdnDTCOsEMgGXbm3U-paZiaLQLwZ0qOw&oe=6A0DC701"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLWD4psPP0QQ7kNvwGIhRL-&_nc_oc=Adr3cAxGBquV_696GjDD6ITvm5BfhundsVu3y4--aXaHtxbrjgLax9TLPZ8x56KAglU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zCX88Pj4tMkNW3HdvG61Ymbk7u5-wT5-CrIveYaU6xw&oe=6A0DC296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFYZDzuY4vQQ7kNvwErNBvS&_nc_oc=AdqwJkVh8AeJ7Mj4OaOK1u3ApkmTqVbbBB2v2YbMmsDAlhKrFZ3kYah3KyKho7LQI74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MaxF2txKNiGLphFumZJoFxkJlfCwPqfvHvlhngc1v_g&oe=6A0DADFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89nx9pZu2gEQ7kNvwENS5WQ&_nc_oc=Ado_H5msvdIOihEEkgoaSVLWDd6ST9_nz8g894lfpMyKVKV0QFHZp3sp6aS31lr_1H8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_dmP7rg0csqkr7PUViUyxW_cDGbY51ARUYnuALkv_vQ&oe=6A0DC364"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WLqchR_Ds8Q7kNvwGDVoPd&_nc_oc=AdpM2QMX8X0jPp5kAOPC9H5JEUgd7UbXXQQgBnG2W63Lu3381iws-5n2jo8L__DsFJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WhO6mUsrnQAPIy9dad4a0busjpQz-774z97-HwlVWUw&oe=6A0DC2BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp9Ui5tUSykQ7kNvwFBhlQU&_nc_oc=Adp8ffbYUc6ec-9YvTbNO2arx2TEbE09lJTaK3B0CqKcngikXHrX
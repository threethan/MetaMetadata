.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNmfjOfi7F4Q7kNvwFY5s2T&_nc_oc=AdouEb3rlwxVS2RpLhdxQAR_JK_mukH71jRqRc_NOdOYRIvAWOKAGCBA9oTPX58b4YE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbLFMNeXe5nTJoO4AMwTtJtWWgStGRJltTJGtnuu6LiQ&oe=6A8ACD41"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ds7tu6EzRekQ7kNvwFCQNea&_nc_oc=AdpTOKiyo_AYe1i37cVVTk4O0qu1C6TUOa6vVRoKEn0E6EeRHsKhwLZs4UEMD89XyKo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE846NW8QwZU5TRq6FPEmJCIDH_YcYVWWlM6M_TpG5flg&oe=6A8AC8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5zHGmK753AQ7kNvwGqeLj9&_nc_oc=AdqjP-aApLDDdHbaVn31cu1WtNJ0PAiGAJOy3LglOghdYZC5P2hzHfceI50qx2USgNU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfh6JyLq3lqy5BPcgoPewMrlIsPAgpAs4wBi1720Kgag&oe=6A8AEC7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ-gL5LJjDgQ7kNvwGcSPK4&_nc_oc=AdpSccMiSbt4FI7xsr_YT9mnr2VHFZLQjxHDyMyb-GlcYKogMRdsSId-Zrsm_IhNjoU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6KP9G4OWIUpqfAKsJ76LNLmLudAGbBoB8vaNzivj6xA&oe=6A8AC9A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4qzGatcWbEQ7kNvwFUPgsk&_nc_oc=AdruwT0h2479quYBKyRV9hoK6G3l8P_UDIWeCNldVJRok8trUR9DV0tOkPcb0DLh1iM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZ5EO1-jACrUGEcieigPq1BbPj9cstgXrM0TBvlPgEw&oe=6A8AC8FC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVczwzkunMAQ7kNvwF0pJLN&_nc_oc=AdqFdBIEC-VwHH3eNIw_O5jnxgmDK7ObyuZbBrwJFFvAryZOAkwx
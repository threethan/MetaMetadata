.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlGC0ppUygQQ7kNvwFMYljJ&_nc_oc=AdrYKTMrBDWHf48HuBJpXj5GuRklEnZl5bcOeSJSvQVLKHw9RT0RWO_XJui88vzKauw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pnQu6kxlt6Wnl8VIZafh5J7RFutxzPzczprNYHwxitA&oe=6A1C4781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aJVhLvjhJgQ7kNvwF2-4Bd&_nc_oc=AdoMLdTZ68Swf6zQ2bIvyBjnv0je-29vSpTFeLW6zvO21t5IGMyOwl4CbLhuOlXwEXI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jj6wj-vgOWljUDrI9f9KkxKE7kolJ7f6UGncIAnR2Rg&oe=6A1C4316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZq1smGpMe0Q7kNvwGKsRF-&_nc_oc=AdrJIHvA78vDCGIE5-RRlojn0G3tjWFFvH_utKwuKc3K9wOOe7Rb1tEbLpm-kYj6AnU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EwH_KCDQfLAKoQCQ4-dmNhbdKjkhyvrWHXjAen-EPnw&oe=6A1C2E7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tineG2gR-cYQ7kNvwHqMhW1&_nc_oc=AdqOjyKhD55Ao79Wd9c6gZAxJGAwhfPl05fEP2kgmU5zAMBzKF0ivjqomVqLfDcjCJc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JzgR9EYRBLavtcrMSh4upBYxe8fS_C298SYkX_KTobw&oe=6A1C43E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3jC-1kJxi4Q7kNvwFD4cuS&_nc_oc=AdrGQTHLIyVriALYgAOjcX60nM7DizLBq1VzQGzfnTxYypgnnmp7HE3B1JTKw5u2-6g&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eTW9-Ab8BG5zJIKIMpF6fbjVnYUXi7oC9MokgmPG1eQ&oe=6A1C433C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA2BUsfM3UEQ7kNvwHkr5l4&_nc_oc=AdoEtxvZjQPkCNB3eVJpdR9YCsWhhc9Aek6vpvHWRkctegouO1X4
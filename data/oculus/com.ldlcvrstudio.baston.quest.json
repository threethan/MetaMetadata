.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXyFoN8crgYQ7kNvwGd0wID&_nc_oc=Adq6ITrUKwJfru-hkHQFiKWS8_7E4lBA6mrRfOaULfM_Mdosg1OS4CPnG-xPVXqUPTM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOACgbgvUbEyN9aGFCsInwOrbay9xutK59RHrYLGrcosQ&oe=6ADE1401"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIhHnzAng3YQ7kNvwEL1J4z&_nc_oc=Ados0QfAdSglKS5z4hSOOkL2UmYLNe7cQ6fEuCOrABGtCWt80mx_-a7n7Zlq0pQqB4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSc6V_nRzXHTLQEOCu480vvLiWkNEOD-K6TSPEmZsAlQ&oe=6ADE0F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5V1aY9wIn0Q7kNvwErvXb5&_nc_oc=AdrQxnoyRd48r-VCsfbxTkJpLNlgVlit2l6gpSgIhuJKgp0ATaBEaTFFwfhgJM0n26o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwn5CNIMYZxTMoSQVsFwVx0WOUiFhQt6yRz5XjrcPmxw&oe=6ADDFAFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKk6GKSgsGwQ7kNvwGpI28h&_nc_oc=Adr1Ta6bkO1rFXqybvUIOGWTptBzJTSZLNI38IahAdIHj3Qe2w3LKyxxxkHxpteT0Mc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmqIe-VFDbciNICbGf4E7S7FJ0T9bVez8OCU0kTrlPWQ&oe=6ADE1064"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaSglx2zi9IQ7kNvwFdO6ql&_nc_oc=Adr4ZuOfxVV7gH9FO8IRZrgkJ2yGjUPRa8lJZl6lzuwDpCKvMFZmObWbcMltJXbwaDk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtbxwx26Mw4FFibF3VwCJ_zbLOBJpNpdtSrHFW7Q3sWg&oe=6ADE0FBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdC3vZ0nC5UQ7kNvwHX4rw4&_nc_oc=AdpoJYObOVoLGDjJPp3MN5sgXcFzhTwVfkbEpNooiQTFdoUODd_j
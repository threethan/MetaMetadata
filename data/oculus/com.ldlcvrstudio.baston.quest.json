.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skkgWVyhWJwQ7kNvwG1EeQ_&_nc_oc=AdoPE46wXlvMoxV_rieh_OFf1qm4X0WjvdpfkX4EDav9oz_zEpti98pmcKLN-InplGg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtHzWHrWDrHYQy8LRG4fxfRuePYPtdpXu6HoCnL3bJcQ&oe=6AA01D81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHjuSrm-x_sQ7kNvwFUG6JT&_nc_oc=Adph0s9tbi76XnNjisSZEaQT-fpBoLjbuMjUcmkWagnyjuvIFsd2mTeItmnTRy6uHqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu_jItSkLYb4lpjzkxqMFB8sg9t49avPrs_gDpmzJSLA&oe=6AA01916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcjOPmEvrFYQ7kNvwHF4Xua&_nc_oc=AdoSX385ILR6OiQgU_yeT8c5MKNlPL8g4sKwZL-F7vbOjc0kQhVYCFbojeVRspEJmiQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITWWs7sCc0wO0oputVHpsVXlQ0JGaCgzL0lXUNb9dW9Q&oe=6AA0047D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmQmbzYKnaAQ7kNvwH7Rt3I&_nc_oc=AdrHW4dnxc__5hUD1J5POhf7VfjFCKNqLJIaistQf9mJ9TObvt6ZgCWbwi6L2tZjc6U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXZN1o-9BGK80eNF8ulurIYlua6qZEXiT37a1Fw6SrQ&oe=6AA019E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHdNcOjKlMYQ7kNvwFiTXgp&_nc_oc=AdrhWkNNsyLD3uKr9LDR6uMHpcXXJJwkJENtdFacd5j6_8bu7uhmN_zcULMarQOSc64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLedc8kQ2hgXnVb99fiIzI_rvgIvV5__j0jb--Ef8tkuw&oe=6AA0193C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZzj5zVLSnoQ7kNvwF18IoK&_nc_oc=AdpcB8Sm9BSjpBxBRc-5pleg_znA-fKtl3HICT3kaatf0QndRXlA
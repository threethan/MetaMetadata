.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkcSjmRgTFkQ7kNvwEUosWx&_nc_oc=Adp6iWEyp8wQb_Op2TiAx1xvPaTs-YN-1E51IBEMCxaDtP95DN5PXYbPpsPIFpx4F9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I4hqbMtlukPgG_aQEyPah27ie8Su5denUmvO5FeDxzg&oe=6A170181"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPbeN-0OGCMQ7kNvwGKI_NY&_nc_oc=AdpIITCsxv4LdGlkCvLnpxZcoMgrwtWdWgaSr2ILX0u0WEOrVCke7M5Q2gdrcP3wpLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dPGtZv39agDYlu__axTZt577R3X-B5T3yiRnIE55mtw&oe=6A16FD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc-EbKT7EtsQ7kNvwF5FojX&_nc_oc=AdouNC4vq9PcntBTJEplbZIEKOM6MsufeYd2brVVIeC6_TD-Kt1xmDdKS19bvlEMLhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rAOdSTX0mutahLiqFzhCVRMnYRZYo2ol0W7Aet258TA&oe=6A16E87D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgyhXvLN3XEQ7kNvwGK0G_k&_nc_oc=AdqiyBwIhBjlHF1pIFgf7s-GGqrYcLr2bfJSCR54VTzdbIG2il9E1b8Apao8uTweJrM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69C5hnwQsn_6WuGPsvXTKh8fO24JYan6E6pKMLOmyeEA&oe=6A16FDE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsgytExY_80Q7kNvwGnv_tP&_nc_oc=AdrZ9Lb-XZh57eP9xRQ1NfnlPQcmkaGLQpe8giles_Awgyktc4XEcBzKdCbsaP5naJw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jIQDcWRTcK-zYrVjDFkC56piS_mH6dbwV7hY2kjSZ_Q&oe=6A16FD3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDQvRifU3lQQ7kNvwGt7f8x&_nc_oc=Adpydw-NaKrLo2VuI78CaTxMyczO727z8AVrfiBfPfn_ycYDrbTj
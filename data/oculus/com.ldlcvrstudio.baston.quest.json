.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGUTB3Zmj44Q7kNvwHg5Q4o&_nc_oc=AdqO3OJhWLIPqJSU26BtiDhv5nxM18DelVYPc4xvfmW7MHw-jk1h6HWFuomypm7W-_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAOZnv0vez_a4k_ZPnu9M1CwB6IfjUnPKNw2UIXHQEcw&oe=6AF47D81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9WnkQWwo4sQ7kNvwGJjQSm&_nc_oc=AdrWT1VPb_fex4VirG9pTk50GD-u1F4Sy-FGSOl1s-0ga7dZX5bD1hRuCvt09zMfIm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMYUg-yxgkNu8VrSOkx62A7VNPYksjf7qI-8GXTjvCQg&oe=6AF47916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8CHMZfyHa0Q7kNvwGAKcZn&_nc_oc=AdoJJeY2kqD01DrL46dLPuQLAhbKQRRNQEq-nFtsUlVRHvd3xlHExhXQZL-EHW2_1oQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhVrIcloBcBcac_WAGn1UyrOeCaPr3sOnfyUzRceXzlA&oe=6AF49CBD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caAMyglBi_YQ7kNvwFxXERo&_nc_oc=Adr1lbRwqeJmthRKjGUXHBcB5On6xbzbOh55Bc6ItjcdBN26gdQ84vY7BQtiUx8Kf9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR-3PHoALKGxJ_y0wYnqsOrzKdVv3bO_n91SyWvwM2qw&oe=6AF479E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7pY1f_XcfkQ7kNvwECG2Tk&_nc_oc=Adpf4y7eMfysDLj-x7NKBcIQndYkrMSimz2tCHPwpC7pu6NGtMKZ2KxAXlpR4M9giOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRvyV9ecrWSxsGpFibb99i6zraQmObbzc5N1LTJ844Lw&oe=6AF4793C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WPrOWAjNecQ7kNvwHvcSlo&_nc_oc=AdoPmluZVG8zfrsRZ-3UJxdbUdtHF_7_7mcTa8wepiGtCbjnJ2it
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r11EgINyujkQ7kNvwHNtnNB&_nc_oc=AdoKpoJza7OLEc7aZ_u2HnbbOBSkwQLI8HzpDYjd8Dwsd8IGOl_P-Tt652EgusRyhcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgzAEfHIrpAP4sY7luvAPMm0_sj-IoqvQaeHpGlrelVg&oe=6ABFC181"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8Ht-ECDVaAQ7kNvwGMl99J&_nc_oc=Adp-ZKcGuApio-5P2NF70cJKkiXbiPhMEukIRYfweEpamBxEq1-I9yhcZOMdQZ9Z2gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEnhMGoNmuRxai3PMAW__96evr658x3uOFXYjrAe5o7w&oe=6ABFBD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaBQlMST7zgQ7kNvwGwM4eq&_nc_oc=AdrO2oxhTxIct8llkV0iCJEnSiQWVyqwYqH84sSYORY2_tt9FJG8e0nOJL3RDRxwOLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtTYhPC5YBm-SLttF99qyvEzxaQojdrt23ENiIRg60LQ&oe=6ABFA87D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSz4dj2jVm0Q7kNvwFcuvw7&_nc_oc=AdrB0GjqEpmkELefzdmYfufBiOC7XyqoFWlEFJma8y66P7n9d7isxaHH96RzPWed55I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_k4zhNW-PvhljvZqaJfOyX3Ch_Z847_QBOVI5T7BfAQ&oe=6ABFBDE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKc8s9X03AUQ7kNvwHRcOMa&_nc_oc=AdrBELI2Nvru5GTleqBZvGfM9w2TA0xyhIkauer2mZRyvFuWmqSLygL_px1zhgwV_uA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6qHj7A3KrOxIhuWvRTr9eBALSwSqnMZ212adMcs5cRw&oe=6ABFBD3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVDRSI3_nzYQ7kNvwGvj42L&_nc_oc=Adr-OMV1fh_u4fRv5hsMv-1PESpTwyho_idPQZb4XwLbJCMjgl5F
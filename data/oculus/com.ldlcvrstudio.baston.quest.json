.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuy0OQVkv5IQ7kNvwG94GrB&_nc_oc=AdokGIZ2pmmnMyp8mWCOGPQuB-EuxXYqPvcIrSVM6yNBQQPd0RP7-SaYrRBQ8i5SYXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1mgYb3-yvWQwL7zAqab_Kb9XHNmEdSq1Tlx0qA1UCcw&oe=6AB7D881"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LsVdi5jw4AQ7kNvwGThHPW&_nc_oc=AdqYXhFwzlzRfLLrE068CJgK1uhb58U2aO7785hBjIXHGSPqAyo42WN2q6-fX6-4WqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-jbK6hOf8x9rBv80zf5lY0V-ZPDuWCOEKpBDTZc869g&oe=6AB7D416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxbaDT9aqqwQ7kNvwEgVvU_&_nc_oc=AdqC4uzJnV8ZmZhigA1H-fXckyTOfYIjvq7FirNtsE2caQhggPatKchmbOyuLXwYfqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJpVCFleAMvn8VNd89mbVewLBGughpLq9OWPQ7hOmOkg&oe=6AB7BF7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRNkmhqtuk0Q7kNvwHNT5w0&_nc_oc=AdoXCei_N3XUs7qiUEfUtEDWdpRo9I-a9FWe1UQBKaOz-DRTysfeVSMfj17dXFEy3Ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNykqpd4XL3Upl_GKD1k39mNTEFRgCnqkbVsAr3nklhw&oe=6AB7D4E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6XsZJ0SNGYQ7kNvwGJAJq0&_nc_oc=AdrAcLrF7R2nZgIS85DIGX_5mRNRnrNekT6giHr0TGRJFmJ_ECtEy6ThiTEWEIpCvxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISJRqG_JMZM0PJabQ8ET9a6aeaIfmvfaTkF-2HcmeN7Q&oe=6AB7D43C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DuW7v0iI58Q7kNvwHQzdRK&_nc_oc=AdrMVNYk7WMx-jpMeULqmRSsvmWDLE1lVvCFQtI0_n5-nuj8N7GJ
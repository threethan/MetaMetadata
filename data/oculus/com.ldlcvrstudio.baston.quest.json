.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hglIdTMw0bQQ7kNvwHeAcwc&_nc_oc=Ado9MAVZulyLFvruzQX-qd5d3mE47kbyTfzBRemkjEilfkz6-DSBzN9_Z-jVjGLJlTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EQnmlvMQVFMwsrvGi_TQSOwWrMAeh-FEETrM9rlJp3Q&oe=6A258201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fArzU93ETRsQ7kNvwH85Bzk&_nc_oc=Adr1JcLJWnvvKO5A_79uUAaNkT9ZXOoHYFF90RX3p1B--At9vNxgBJo8EqWC7Lc4x8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WQ532M1hLEeIfy68CzfNUHlvoOPDh8OdeWYnOmMIuyw&oe=6A257D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRe7_jG4AUIQ7kNvwExihRC&_nc_oc=AdqAeqagI4AD9qexNbM7hIXk_0Rw0YR62X5j6VdT4FAtSH0LUzDWGg6gSG1IuC5kw9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iF5TcxsarurT0eEzNnMapTpqU4028gXX8_E2leo6MHQ&oe=6A25A13D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S35VlA3c3kQ7kNvwG6NELf&_nc_oc=AdoYndkVf21Q5-juiCrpWxL1-otym3-sZLjf6iQaQdRZJegneeiPmM3ghSB5H0woeC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__c6C3m8UrZWZYK6vDbDpH3woNkQK0Ibo8VWS67blvIA&oe=6A257E64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goq4nDjWb4sQ7kNvwE2KNWI&_nc_oc=Adp7MpJOPu242Z_Oy2P9VWXGyw9BtFyl1FBXVftiOHtCTdbOjTLG__ztAJ_h2E-yN6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88JcTyMt4b3ER9xKqAP3zR-2CBCHQszipvW0vt92t4AA&oe=6A257DBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWepuNHVFwQQ7kNvwGMMWMX&_nc_oc=AdqqQEo6vTPDaqXe9U_pkIm8ir0kPksvQ6QXwvzhMG5-T40Ch_uK
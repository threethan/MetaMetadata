.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk8SXGoL0dcQ7kNvwF2XDXv&_nc_oc=AdqsqUphJSfcTt0Mk1I3Wb7PaVxyjlLSlEbhqY8AliLzw9S2s05JlgoujvwWPxKQhqQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyVvmSxqIGIJXRxJpjuqgokrkhO_ExWcAnd8QjmmUsYA&oe=6A5B8F81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmwwK8AaD8sQ7kNvwElci-0&_nc_oc=AdpbTKZqtl5L5vDv4K2hcjGhPrfVRq_468Rl60OOAc-p1-ct1ZS6NDtHZm7JPoox1P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZzQvmi_sby6zVrxhPWtWBGT_S7SAnjy22Q93fg1JzXA&oe=6A5B8B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T__iqJAaRd0Q7kNvwE_A6Ln&_nc_oc=AdpAYMIU_e-9bZODTV-kt492dK-ghb7hvhsTnZs5vFEHw5o8PhvGRE5p5KLqP7PRLd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_bHNBouYJz5JoBfrqirOBxWC_CLEFnlc8KVo6NXWr1g&oe=6A5B767D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUDWHqn9E0UQ7kNvwFfZFqX&_nc_oc=AdqKHhbdalmP8OCH6Oa3zNI8Q5lSXqszievOZ8F-B3f5OoB2Hn-OXLbfeCLpL8e-xjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6w5DiMcri-UXxGg8DnLV8jedJl5XWHiJsQtZOg_P59Q&oe=6A5B8BE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzV4vM83BZYQ7kNvwFjQVsl&_nc_oc=Ado98Z4qK9RKe-nDsH3f5k-K2TDU5h1A2vDOBdYIMEG0kZrqReKTUY2X1MmRzC2f09Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCg_7gJzcmqfzdwbku683l1ctj5zBL8ZsPvOzjDQZtLA&oe=6A5B8B3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhGOF-tBPqQQ7kNvwHciClH&_nc_oc=Adr78bJrydttih7HQtTKUqk8bwhsLRumxdD5rKik_RIiv7aL1ql7
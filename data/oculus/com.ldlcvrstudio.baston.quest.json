.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OZOyMjBxqsQ7kNvwHzXzRH&_nc_oc=AdqQAxs-hRPxmh6QTnN4OF4JKjSXKPuB5uH5tI_6_s7Bc22louAbC080eOJicEY16JY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBphTQrViBXZvR_l3SD8VCPpxNEVhLG6qpXiIMnA22gQ&oe=6A4E6081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqHvgLa2kioQ7kNvwFVARNA&_nc_oc=Ado1r9xpGtkUpfAwKLwM8kdfUpbPONyCoqCFRxb9tJcjaq3JNaL-V_Xla0HlDPmLrbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3Fz7pi6RjNgH7aV1pDuSEP6IVTQPvLTuBEjmLocpAcA&oe=6A4E5C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaUlZ3F1UL8Q7kNvwEHANOA&_nc_oc=AdqascbHgm9vZefeXrFQXUII7Ntl1vKjA3AerI8-4eOdI1FHN72PBsIJPVbRm2cB1Hg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfQyqoqcxjridedJy2_EagfqP21zB7iugmIHM1BWA3zA&oe=6A4E477D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIdTkOrFh2oQ7kNvwGMvWGl&_nc_oc=AdrndYKqVhyiFOMAXBInoy2gzCPc-v61YyjVk5dNsdNTkAVkzX_L03xEmNxmIDR480E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM5c6BvSOSo2VS6wVDQii-Y5Rrwn0_528g9Dh3vRW9ww&oe=6A4E5CE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV-FgYxR7MgQ7kNvwGw11bU&_nc_oc=AdrgHLUK2z5uSmRWHH9CzER819bKQ2rpBCZKQ_Bl8MlWjBYzbrToWSRR9bMYVzSCHNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC68DfVAKPo7s_vWvVjOuoHMYO1IxkZgCpgOXv7OjCsRQ&oe=6A4E5C3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8ZHEuVpcW0Q7kNvwGBRl7Q&_nc_oc=AdotBh936_4pgXHm4aW7LcobXzxuhphxnAotrc3ChbbWQrtOVOE0
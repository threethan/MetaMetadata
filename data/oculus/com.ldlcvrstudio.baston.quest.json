V2jPOMAIRHIz3dAnJ7A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1aJILaa1-02Fhl-sNKEt7Lk8BqoYrQfY-AM5OeD1Y8g&oe=6B0B2160"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raIiU0KS-7gQ7kNvwHpdXcB&_nc_oc=AdoOHi5fN2bQg3-XGmLKFrySBSZKz83wavT6wUogeubx3a11CrMgHuPERKIFfnfeUwk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNUA1fRGzHbk_3N1bxY1NnWqARSo8qAn9PWYF0Ntu2Og&oe=6B0B1F41"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6qRKVMvAe8Q7kNvwFkKZhe&_nc_oc=AdrxIvUXZWjUpozDV72W4_GKgRJqDRu4zOJ3CmbORG_uBYrypSbpbtsJJhhWpAIX45Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSB_sx9ixHw7pziz5VOHmXeK6tZadVc9tNo-rM_T8EFXg&oe=6B0B1AD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYUg7RRYnnYQ7kNvwGGFJfc&_nc_oc=AdocahnmgCWIqxX5Ax3nISaoK2wIQbxyVO3lrw6UYIRKa5iumvpsnUE2cLdRYowBNZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSYB63Z272qsP0SGXT-SgujXdGq-AaBUuThNxJni1ZTQ&oe=6B0B3E7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mitJF7-dRAQ7kNvwHxgOll&_nc_oc=AdqFszMTc8RV82tjXLzFV4FHz-WvQKBHnfSxaYpyuq68K4yX5Tvw-tyAWV2LgMBud0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD-Mp0ka_o5FxxoorCSTacEoQBJ419Mik44jC6mzdUUQ&oe=6B0B1BA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq0Oa6pPhAQQ7kNvwFZi8C0&_nc_oc=Adq5hLJyedrmp2BgQWS-349mR23i0m5Xtp-ChyXsIlO-u3E8hoXgSXPCzCWx7EQdBAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpzVsKlNxZehalbf-zCSheUzJ_DAgOnNnZh53xD3G7Iw&oe=6B0B1
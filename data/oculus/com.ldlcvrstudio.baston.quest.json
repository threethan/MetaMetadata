_1162446619309842_4882016780126414533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdRX-Rc0VvoQ7kNvwHahrxz&_nc_oc=AdqJxHlKAHx-0KEntsqPXY4Uai6FyN7fGjdkbVbarQaNzjzlWsV-P0EJW-ujeGP7pLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k3-2MyEq7kbToM14QDwvMQq3KdJSewfS7nVqfmlaO3A&oe=69E4BB71"}, {"file_name": "Screenshot_29.png", "id": "1153213020336966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_1153213023670299_8282150417532215900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61GiHbM5EWkQ7kNvwGt2kkd&_nc_oc=AdqSEoTnk45LcuDXGzdmFpd2KdQoziz1UKRo7f-US5vIWud8Vvk9sev9xZK6KbHnB1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BClONhf8qQr-FElIlXEy7fK4rIVKhgSEjWhWY9lvFQg&oe=69E4C8AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1721481028535123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_1721481031868456_1060556618134437396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W60pSAByL6wQ7kNvwElBGX6&_nc_oc=AdpDNqiT4Bo0DUG50YBOf6FRfOUrfvY-zNuVtzoJ34yKt-6AhvzZ8mTzz5kxpB1t-ME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bV34iG3xOCSn3xSFq6aqldKeIA2nz0OHEqJw64F2Xpg&oe=69E4EE14"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "fantasy", "tavern", "punch"], "long_description": "TaVRn\u2019s Takedown is a VR beat\u2019em up set in the hilariously messed-up world of Naheulbeuk\u2019s Dungeon, and developed by VR Studio LDLC.  \n\nIn TaVRn\u2019s Takedown - Naheulbeuk, your mission is to save Mliuej from a mysterious threat that\u2019s ruining the local breweries. Bring order back to corrupted taverns in immersive hand-to-hand fighting! \n \nHow? By punching, smashing and throwing anything that isn\u2019t nailed down at your enemies: goblins, humans, or anyone else stupid enough to stand in your way.  \n\nAnd you? You\u2019re just a perfectly average hero (or let\u2019s just say\u2026 an adventurer ?) trying to save the day. Or totally screw it up. Either way, it\u2019s fine.", "short_description": "TaVRn\u2019s Takedown is a VR beat \u2018em up from the world of Naheulbeuk\u2019s Dungeon, developed by VR Studio LDLC. Punch enemies, break taverns, and fight for the fate of Mliuej\u2026 or just create total mayhem!"}]}, "developer_name": "VR STUDIO LDLC", "developer_privacy_policy_url": "https://www.ldlc-vrstudio.com/pivacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VR STUDIO LDLC", "support_website_url": "https://discord.gg/TNazD5geRU", "website_url": "https://www.tavrns-takedown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "ja", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25397202896630643"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "834487779601941"}, {"status": "PUBLISHED", "id": "704285566077351"}, {"status": "PUBLISHED", "id": "1608727640184435"}, {"status": "CANCELLED", "id": "2137957327040511"}, {"status": "CANCELLED", "id": "911372468568661"}, {"status": "PUBLISHED", "id": "1290518126363493"}]}, "baseline_offer": {"id": "704285566077351"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775749560, "status": "PUBLISHED", "id": "704285566077351"}]}, "liveChannel": {"nodes": 
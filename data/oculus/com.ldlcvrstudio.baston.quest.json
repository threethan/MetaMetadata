.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsAVVkmYIuUQ7kNvwHVqGnv&_nc_oc=AdqwYyo2IOqvQUHi3jDOrZr2qAHxLRQM3EPtYICfTLDe-4-G7MO3z4sqQJdlhUgZCaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP3MSAd5TGIuGwT-vEncfvb7VN77gKhx2e4YRkbk_HhA&oe=6A579B01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKFdWwujs9IQ7kNvwFpPW8D&_nc_oc=AdqXl-kiaciPsosM7DjJj3iFH9sVihahXErBTJ4BzpfholnZPmrNpYGStlKBXmhm_7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC7UELHPIwVBS-EPFLsUC70nZvA1fX3_eoorCjolgcWQ&oe=6A579696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSgPcyVMZlcQ7kNvwHtlaYD&_nc_oc=Ado1g7PrEw7FeN-N9N7R5kyYKQ8aD8hJV1x34nUl-oBkIzWwWUfDGHzovu3yWFsjLR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO4t1JyyNzgLN9ImXzxi1GkvUTpfotLOViOMfEQQvDQQ&oe=6A5781FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFV1DlVVBjYQ7kNvwFarcgl&_nc_oc=AdpSPZhXaE2J7Sdq5PrIYpOLIhkEhdnEmckFb9B8FHzVmW6Lj0oqqugrDgkZegB3fm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgNFdoZU2RZyx3EtB5_m-JG87zYI7qLA4Z8cd2_IkcKg&oe=6A579764"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49czuymjNqIQ7kNvwEcdDuF&_nc_oc=AdqkwnG8CV2ih-SShaT1NeqAFFauiyU3uv6B-cM6NaDp9qq90Xdd0IIRotqL25_362c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAencLjHYsETx_qixn6objXFiIx2QDbGAILQNcfghDF7Q&oe=6A5796BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hOaRvohOw4Q7kNvwEM16Ir&_nc_oc=AdrspWQPWIIeamPWaE-17O1OZALQyF6ja8F7HhkLzKoB2-w3vCjj
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eioW1thEVOEQ7kNvwEMp2UB&_nc_oc=AdoJEErNKIrUn7g19drsXLB4d0F6283uqyVpSuHo75CRv_lxzGv_0TQ9lERsiqVaeyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQqdW6piIcVExuwssR1dplAd07mNdosN83kPp44iIiJg&oe=6A95C9C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jk9r0Ii7XUQ7kNvwEN7uVW&_nc_oc=AdorMMq9tmd5MebMHbzQSq8vg4nYMhFC0SwT5POzChYwwxrSnXR3lZQdTXKdq7Uwkok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncA7zQlrg6ZlI4UjVLTJkjaDh9fBYE4L374fWZE3EoQ&oe=6A95C556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6KMF7Ln7fsQ7kNvwGoWSWy&_nc_oc=AdpJrcYPHQxS3HcdJkeuyMu9JRxLQOaN-QeAWdbzeILlF0MI5pNdn_bzesmShec9Hk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPGZisfVzSOEXkYIkkjwXgK1g220IrxcIp8ZqFk45XWA&oe=6A95B0BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X76XHu4o-28Q7kNvwEoL14H&_nc_oc=AdpDkdOL4kUJnsif8CCp-9dbJTS3sP54F7hHbldN9ZlK-owpASawo5wkVP7Wnz9Hwfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl3utdl0om-rb-GouvOxlxtuylDQbtPTwnoq4VYX4HsQ&oe=6A95C624"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buTfZtNFJBgQ7kNvwHSvPb2&_nc_oc=Adqbc4wHM6E6zOrRJ3oXi9vaR_29L0OS8-e9luX_Y5PC6htCTQcw-b477FmfLsRu1bM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaGZc_2N-UIUxaogcWPgeRSd_f57Hw6q_kPo8-n5RmCA&oe=6A95C57C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZGvCW9QwY4Q7kNvwFo56iz&_nc_oc=Adrf-J-Ttfxj1bSrJAwrN5KpvXfDuqHXwBwD3ID0HJaNjxRl2B6t
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnDLTDd3IjEQ7kNvwH2GgyW&_nc_oc=Adqwi5SjNX0HMwY1Wu_eJNXyTARQ7uouh6VUIlsqMGKMmcvL3FdtCpyS6xCU2eB9k5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4ZRiuUfYM_5tOZwsq272NjMxi_KNWSDGK56rKanBNTQ&oe=6A4BBD81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqHvgLa2kioQ7kNvwFDht38&_nc_oc=AdoVZYdwgCCmiIq3SwONXdLVrWV4S_R-QNJAgJleiZktbYUH7PX5dpedDtU_3abMgys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6OB6oAtfdZjF9M0gyYzK7buk5S4Nb_W-OFbwkr8XnZQ&oe=6A4BB916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaUlZ3F1UL8Q7kNvwFzGVPn&_nc_oc=Adpcw_ScwZx658p6B2Hnu_bnwQgBsw9eCNF3D6eV02AaGXeTWJpG54jpermrBKsC4Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl8hvofWRFQrkkqtwXvQUoxjR6b_VPZVhUyQuf_gZZdg&oe=6A4BA47D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6JzTzbXgOYQ7kNvwHWFHko&_nc_oc=Adp1agcx_om0HBda3DCxUrL-hHZJpCcgDpyry4ofMOViA4qU8B45JlXX_aDjnFU6dTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFZsr1wyYSOfPwW5c8nrAuIeNNXpyq4LQ1Vvu5A0FWDw&oe=6A4BB9E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGoyFXzjP0EQ7kNvwFX262O&_nc_oc=AdpPvfrmxgEknKBN8wIN6uTicmw4S5ICSDp6uKpOaG-ulFoPAn8Ryp5a6jujDULUWCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcL9w_s1jPDDxitMMiCCC9THTA8iEL5epIcYceh10zRg&oe=6A4BB93C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7EBaYG65M4Q7kNvwHIY5Sa&_nc_oc=Ado5VWE7B0jR-lsARK0aGMWRZF72qK-TmTzgx32d5Ff59mnTITfX
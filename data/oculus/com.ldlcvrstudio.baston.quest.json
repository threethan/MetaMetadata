.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuy0OQVkv5IQ7kNvwH8A_rB&_nc_oc=Adp5i6zcb9q5Ca4LLssD74wW4lbmY4UF6FwOCrN_MEbUxhKBw36gBcuKf8XB5rWwsAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGKM8333gwrkTgciWwGn3ldNHqfeq5Nr-pc2jk6BWuNw&oe=6AB68701"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LsVdi5jw4AQ7kNvwGJIF_g&_nc_oc=AdpGiO7LxPAxiQRSZYaSuysHMbATENxXZ5SqxFS4KwMV-Ekf3SKupEp8oobX4lV3bpI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWr35jGXmz0uY68hUFHjJa2pfkNXxxqziyIQXUN1Bh8A&oe=6AB68296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxbaDT9aqqwQ7kNvwGMEF6r&_nc_oc=Adrq8CNC_k-zaw2Z6fLEKKrFrhYBVtDMa7etu1jEhDVRPF8EKWVEA0Wco6myf0Pd3Z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAxFv6ha7y8tHR9FF7K1eTRU23HMu6nG5NNbu56dJf3A&oe=6AB66DFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r421Ldo6JAQ7kNvwG-t0_F&_nc_oc=Adpgie1fTOgLReT-GPV2e00_QtV2NwNGUDJ1y4uPWFbJkrbT4DDOH6A5r40Lz9mqcdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0OeBxWENmEPL1Hm8Ll0_97pVUlLdsxm_x_i4WcKHhcw&oe=6AB68364"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsUA-HmfKvgQ7kNvwEJ8pKG&_nc_oc=AdpPJ59LA0BTSSHe0sRyEOS4w7YAn8ceWCm7FiC-yvjb-b7-FAOVxsr5vIvbyxklCWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWSD0Xf-IqWr2txSr5uyRulDQtMU3gkZujVjb43dz3DQ&oe=6AB682BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyDFAz_wDr4Q7kNvwFUpBm7&_nc_oc=AdqWz5Z0nHwRBRT4gcz9bbGNRDfStllkijwDR-syyk9VA-HdCXUj
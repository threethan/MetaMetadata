pyNPVyo9SfjBBV08Z5g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcOObaeLrDHEffhxgwyC45spo1VN3-NY7qTWkbex5nrg&oe=6AFB1720"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqoaYds2GbEQ7kNvwELGrxG&_nc_oc=AdpNTK4hJTB0NcptSSAQ1-jT6ppe7lIREPoPmQT1sQoP6IKFJOI6TO3I2pZnKc9kbl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROv4IdSHVNbRYAnhdJPceMYBCcm3_O4lbQsEZ2kOr9Gw&oe=6AFB1501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTi9gobPmVUQ7kNvwEjPytZ&_nc_oc=AdqnC82sY2lZ8WyHbIuqy6JOhCKGEDemYM0ANhUJJ4lvPtn7nhTqtemEyYskqrizAr4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlkBfyt1SDLF-oBsy34l99UNWSaFrOFzIbrqeifdMdzw&oe=6AFB48D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUN8-Rvc1JMQ7kNvwER6Ze3&_nc_oc=AdrcOrtPaTUMpwBGUHtlvDL9tapZffwL4NCxbhqffN7qrBRqdzw5dtDbtky6B7EeP9g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVOMMBruzk0khYrkEHjOPFL7wyuVJUIen03xKu9inJdw&oe=6AFB343D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrmnDjkHZOUQ7kNvwF11TKf&_nc_oc=AdriXppJS-pwJ1CKaz3ebfjLpep3_un08SCwJO2GXz-R4CmI0RHmUyjNf5y38SvkAec&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKznVJUYSOjW8xwFGbEhGAPIjk70AvAdQ1TSzmk4xjdQ&oe=6AFB49A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woYp0mcxnbAQ7kNvwG2RZrO&_nc_oc=AdqCH-1Sgeu-lKog1w5Z9kw1c93EZ6sEoEBHWIf6y_ouTKlhAGhu-kFTBmC78o4Bfpw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQym4r58aKTG4dA5-JZdzEnEX00nF_gckpsyNxGsbX9w&oe=6AFB4
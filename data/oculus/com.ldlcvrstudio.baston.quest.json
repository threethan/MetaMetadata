.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlGC0ppUygQQ7kNvwFEi6mo&_nc_oc=Ado2MRizXKTp4yEjiGFNh3FPMuEen0Xvfq7wHhO-OMM9_W4BByrT_2AE8HIgTFqewBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7otjQB9nHtLJCj8TG5oiDho7Ssa02DsEQZWbl5HYFhwg&oe=6A1AF601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_POViGGldgQ7kNvwHGl55l&_nc_oc=AdrYBbGzZINtZiM5hwwC-L-Dtb3GixPYafbReUG8qjhOTb5A60YY4NAg1XqbxQV90Hs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XMC0W6q8OjIVmF1tL7qwekyFiiV8qIolCnFIRU621rw&oe=6A1AF196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8kHCBmOD_IQ7kNvwF5suKA&_nc_oc=AdpdLOI3rjeR23T9U-lernut2stIInjME_Pa67Yv_0tZ-e7FZMP3pFdOTc7NKWEPRUQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qRVyNHPAgKZJt1MXbDu3FeMriLyBQpOuYNHTvd_Fz4g&oe=6A1ADCFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tineG2gR-cYQ7kNvwFy1NM0&_nc_oc=AdpHutHcZo9hHXzWGVbmbHJLRee6emPNvt981jHla841gXdxqFp5tdWCrQpEdwn6NaI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dT9fC1MYrRzF0nJpcFZqbV_llLH_UzxUfF8Tn71XpqQ&oe=6A1AF264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3jC-1kJxi4Q7kNvwEy1WCI&_nc_oc=Adpxg-7we2BPDZzP-qo66wgWc6ZrDGOt1hAzhiGZcebY1bzFBsP1PrOC7rk7FaYs9nI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fudu3irLUqpBK8zWwINV4_u_TG6AblrhLXXl-pUxvSg&oe=6A1AF1BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA2BUsfM3UEQ7kNvwGSbmN0&_nc_oc=Adq7ICzKbiEt4MZwu-S95EPPSdM85MwTerHKtERw7Yp7Y9HICzpH
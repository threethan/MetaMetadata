.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntcEg39tPQYQ7kNvwE_MIG-&_nc_oc=AdqpwbhlLMAliySTX5Ig4xkuQOli_j7g7yMh8zI-0WCHPzkQSiR-66rCNYjwE8xhcZ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKQ5bs1Cf4TXicEJyBOEeaA-ex6YKFnc4sph1eE4QPTg&oe=6A6CB301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJYpjpoxE9oQ7kNvwFzYChK&_nc_oc=Adp-uuYMlGlPrdTMGBJZb69qNjozi_Jr-8gHfclJwsLl8Rsz_kO5GwqVMhfW_gDqPog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlL-y2wrUSUerHYsgDk_5UM2GnlvsX0nYYlK-w6IrvwA&oe=6A6CAE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfF_iL9M6IIQ7kNvwHbPbnB&_nc_oc=AdoW2FZyrsXXUFHXdyNygdbQ7qRgwwBi3S8cSO9t3CxQAQNmepCGx7CyrxKdbtPM9oY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPC3rNfyQWFXH2af4BBDPqXxHB96LNTrPKlZ1ZdezY8w&oe=6A6C99FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtvvcRpn850Q7kNvwHX0uod&_nc_oc=AdqHlwhF8o-ksNkPJp1SxbxqM6afA6Z8NiJUuxrSC_bZic7M1Eq0GlVPu2wxDPJsnSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5CG6LlqTZJbGy76xsnWmCCwb3aHMadoX355c4VJGAgA&oe=6A6CAF64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPPQKpaYRAAQ7kNvwGv3FbO&_nc_oc=AdotrH503-dU4syK8GuGBrYr9q1AmOdbyyJ_z6zMc6Qa_-sOWqP0q0EkKAxqa8lWrLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt1ogv6d8-LAlNCuij-E7IysM1AyzmXB33ze2i2Tfpzw&oe=6A6CAEBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Clwv-cTrHYQ7kNvwESX4DK&_nc_oc=AdpJifClbEf4YWTsW4ShqdAT6CDBD5fX2MEHhDlYCoV1CSWcC58t
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwR7dGJGzUgQ7kNvwGD_Lgz&_nc_oc=AdoE8B8HjhaSrZz48sqH3vgMMNJWnUFGxQ3tjINFXi5tDOwRFVJiS9usFdZz4W8iGDs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rlFlkmSnTePWYCVykzBwo0PdlJmDj3qN1rdbd37kONA&oe=6A32B101"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGChz34FSSUQ7kNvwFqhfhz&_nc_oc=Adr5NNzlafOrHgIdlEtUg9jz1zNrRVaXzC_rE1rkUWS9eqM6SYScSQGTVB7qyc4kE0M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97LNEfOUOEVXc5Qw0wA-Defm9R9FAvblkVkjR9-uWueA&oe=6A32AC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIn3XNwdl1MQ7kNvwHwdL3z&_nc_oc=Adr1cUPtoQWAOgo0R53myAi2CdAnvX6E0BkiCR4CiQueMOJe2ShjAbUrh_t7AAni1EM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mBVw34L6Aq2KY_FZvDHTEtrm0mdf4aTtMaFytlncWyA&oe=6A3297FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZbmWh44BgIQ7kNvwFup71K&_nc_oc=AdouYAWd2OwEG61RIx9tPbT_X0FePsj6cUEcR7Jy0j1HKsGo5K21oBSzPZ1txvHvQ40&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SIuoSjsxsl3H76OY-RbPZxyEp4hty5PeseGF5BRi-yg&oe=6A32AD64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUnEZA-LipAQ7kNvwElpgIR&_nc_oc=AdpEv-YIk8ZAiZiQSUz_iLImJW6lD0ZZH9AVpPfKf1JwobA2YySFJFg6IZVrggHe9do&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J-GDYIKLh3Bfcuom1V4mqvy8hxGTFOddV8xZNcSARAw&oe=6A32ACBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O76oJtn5sYgQ7kNvwHONLJ2&_nc_oc=AdpAio4E4fk_f9FJdMCa-itXGCz2Adtevmb1tXK7_aWRbOj3xak9
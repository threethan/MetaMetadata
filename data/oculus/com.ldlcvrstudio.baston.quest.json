.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdwOznL-IIQ7kNvwHxTksD&_nc_oc=AdrGzm9JfISbHok8IVw05r0qop1AtNhOwP_pjBp4fDapp9pF2j3RD5OhRgg7dlxANvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr5I6NJ-e6CcUmoYU9rdIYHrfecL2AR71J50SNstDmKQ&oe=6ABBCD01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77HLv-Ob8X0Q7kNvwGCT0Sq&_nc_oc=AdrroVIo7b7R85FV1RU11xOeVKVSbsLvbEUftHuG3QxK8KEFoKBgDRspoIyhbBPgVj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC0ZBqk-5Xj5Pc_-BjRZHVIdsNS3uEk1hzSb2sJu4qMQ&oe=6ABBC896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzO-TshToOsQ7kNvwFE929z&_nc_oc=AdpZjtD8zUed9fGj0_UE0nuQMLIw6amd6a3sD0rgIjHGgZQgywHO3hNAma_SBPJMDO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa4hVa5T0Rm4qtKs8amF1o8g2KwdpOE9Y760FlcbfSyQ&oe=6ABBB3FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oba5jc2tOYUQ7kNvwG2gyll&_nc_oc=Adov-RE-vNxgLYumwFgAdIWkEAifLlri3TfoHS0Lsz7SHmVOmgAmLI8YEpf1IQcVkQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYO_SZDqHELdMLIAkv7mNHpDeScRoh7ZJGh35catPdrg&oe=6ABBC964"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xnt1rRoeXfcQ7kNvwHyFAtF&_nc_oc=AdpZB48oelzpLqa-b3H6KIRY5eFhExb3W1ggM8yNxJW-Cu9xLcTKaHr8DfFrBkD_Pfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDgIJaSPCfJ9JWNrm1Una997vg-yHvCuDdK0ajwcpVvg&oe=6ABBC8BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km3zbeVcd20Q7kNvwFtNI_V&_nc_oc=AdoZPirlo57OW0xdR-IRcIFF3EuH_Wz7gYcteON2CcJPTfiRaNOU
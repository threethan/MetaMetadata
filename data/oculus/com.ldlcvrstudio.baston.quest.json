.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvuWqL9iUcQ7kNvwFnJSxd&_nc_oc=Ado1diarIsVdN4kDAo07Cy-4xv5LIV4JcSp_Rq3l94Z4mATuADy7pc8t29d-tMTr7hU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaNPUwavdsZzLZwCs_TgTdKTd1JfQzj6ekog-BToeNVQ&oe=6AC50781"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBh3S7zcXfgQ7kNvwEx2sN3&_nc_oc=AdphJ2JPwmrVIt8p1JdLBQVOp1TMGsKHuIAxPjh9D2NuXjrG1TSIPVbb0uK62J7w9zo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOANjswn-zVXXC0Yu-p1YyoC15ZnUcsMgW7jRNZuzO50A&oe=6AC50316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRQAcODkP4kQ7kNvwGwcPRx&_nc_oc=AdrXeintju-8c8cOILkJM-YmiaCBbM-Vh85N1a_hcnnkO2cnNfpOR8mfClaYY7Kuz4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-GDjVehRBarD6wvbMfEW7w_E87FBDKo_q6WcaHEuYCQ&oe=6AC526BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-POQB5zFcbEQ7kNvwFhxtUV&_nc_oc=Adqetd5fpXZxeb1_R3uzCuW164cF4vKkrq45x685jWvn1feuEH6XV4ueS2Pv7s0bYdM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdJLGwknennOrhFZKk9UThdZxsap_YpoaIZB227JYHpw&oe=6AC503E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS6KUSWBhE0Q7kNvwHNAMNR&_nc_oc=AdpZUIPvZU8tTVbTRnBCCPg76LlThtLixoc_VflBpYYXUTnl4VDkH1Bvwkml8MZHiB0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6diYaZOxKl_60gObUjrmHbb0tOjVe0CGhJbyLZUVowg&oe=6AC5033C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_A1fa4hc4Q7kNvwG2IySm&_nc_oc=AdoOwsiM0kTw6YVf-qj7qyByrQdrpf6OvArEjfPrQBvlphrlLoQ1
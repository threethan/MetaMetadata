29.png", "id": "1153213020336966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821702_1153213023670299_8282150417532215900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMhLXAJ_Ia4Q7kNvwH5FLqj&_nc_oc=AdrsuXDHNKXIQOnF9r_n77-a44jQrT_gQWwM62d7PD6Oj0BGEXMjxUdA1xp00L0ss9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57HZ5xwgvYUk026ApNs3iMp-rtw8qaCrTPjVHodFqCNw&oe=69F9E0AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1721481028535123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_1721481031868456_1060556618134437396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBxSIqDMa8IQ7kNvwF_ZZ6U&_nc_oc=AdqtSpxYWekWqNsOp1qo3as75-XrZh58pmyXHBwFigY3-PP0gaM_r2C9H8SAY9VjWTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ELFRz2-K8j4rg3a9BX8ucsqGdD01I6IlF6LgIiv01Q&oe=69FA0614"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "fantasy", "tavern", "punch"], "long_description": "TaVRn\u2019s Takedown is a VR beat\u2019em up set in the hilariously messed-up world of Naheulbeuk\u2019s Dungeon, and developed by VR Studio LDLC.  \n\nIn TaVRn\u2019s Takedown - Naheulbeuk, your mission is to save Mliuej from a mysterious threat that\u2019s ruining the local breweries. Bring order back to corrupted taverns in immersive hand-to-hand fighting! \n \nHow? By punching, smashing and throwing anything that isn\u2019t nailed down at your enemies: goblins, humans, or anyone else stupid enough to stand in your way.  \n\nAnd you? You\u2019re just a perfectly average hero (or let\u2019s just say\u2026 an adventurer ?) trying to save the day. Or totally screw it up. Either way, it\u2019s fine.", "short_description": "TaVRn\u2019s Takedown is a VR beat \u2018em up from the world of Naheulbeuk\u2019s Dungeon, developed by VR Studio LDLC. Punch enemies, break taverns, and fight for the fate of Mliuej\u2026 or just create total mayhem!"}]}, "de
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skkgWVyhWJwQ7kNvwFY1IvK&_nc_oc=Adoj74MEz9kGwls9Dq1DnBoH7NO9iDdueXjxUomvkMfYNpqOmkmq5CFiiyUZOHIAK5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9QS6CvizGhRH1m89IzLKNyDcbFRLNH3S2Az2aumjRtA&oe=6A9D7A81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfDT7VUtFP0Q7kNvwE1p5k4&_nc_oc=AdoZBEm9phfITsUcLKQ9m7gFPdbgez2tkraKuSF1bKuXO90Vc3NH8Hy7aZMCFjEbDis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt24rOHPt6a3MDNit5bu6fQTJXBO4WecgC1IsQhfWI-g&oe=6A9D7616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaWz8mf410AQ7kNvwFI0_eE&_nc_oc=Adql5TZXqiAmKuNz7BO11Lkf_87xcgWmVUl6NwTgMf2RTehJiCzdm9pwbwLjgO2kPnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzvncFuz1USbq6s1TkxSX5MqGWlFdwIhkjce4IKWl3IA&oe=6A9D617D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTSEdw3ketoQ7kNvwHYdwGe&_nc_oc=Adpfo16a6DffDtppofb-o-74EGc-9b6VkbOw6Tw0MHN409oezDivcSMWkxsLlDJwBuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHsHaVKts8DfJMXTXqT580U3YJwEF9jVR0YP0rR9MvYQ&oe=6A9D76E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP_ruoCPkugQ7kNvwGmJu_v&_nc_oc=AdoWwNSWtPLTFVU4dQLuVAnLdMU1LpUsrrGSWxHO9V1XcOvEJIsVsKANMTWMC9JF_D8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1oowW9jJTl6Rzif9Sz0NujYMKa0Qgt90Ss4Go9B-eQw&oe=6A9D763C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsnGElbIHXAQ7kNvwG5p2mR&_nc_oc=Adr_fwyS3XQyQLNTCghfQG3_34T-ZIlFM6qVwTa72zmTToyREjvR
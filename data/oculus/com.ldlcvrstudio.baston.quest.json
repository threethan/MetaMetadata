.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-9y--NWTzoQ7kNvwHkLBBF&_nc_oc=Adq8PtAUpVnqalGHNNqp8qhea1GbR_IBrTopa2zF_V7yCOcVTnXsL0x5ipoeYxd9Nmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV1dV9X6gbrCU9Bu5wZNkU9SE_oR-46sTA7wGWvt7SXA&oe=6A9C2901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfDT7VUtFP0Q7kNvwE1dxH1&_nc_oc=Adr-Db1aqlvJgUFOkScrjydtKPsA3TsaxehIwbU5fn0UvpHFknQ7fwI8VUYPyys_WNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI19TipBbaI141WTrtyYrXudKsWXhVUZvMhF_E0vd310w&oe=6A9C2496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaWz8mf410AQ7kNvwH0TsMV&_nc_oc=AdoHz_ywQfiI1ckwriZnGpj8RnkkHOT1_gCK5Z8WGFRqbINoJ2mU7lguHuKTsdv5MzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNQ9GdeWOshv3WNHH5a1pX11ruJtuduUuXBbE4MjlCvw&oe=6A9C0FFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTSEdw3ketoQ7kNvwG8MHBp&_nc_oc=AdoTqEecA7IccsJHpn4m-SbXxJSs_siijSplPuNliKUSeixgzlySgt6JFyVZ4-dwEgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRFgChickvDi-WOYeZPjULNkRWrdNo8RyP28TNg-aJ4Q&oe=6A9C2564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP_ruoCPkugQ7kNvwG4PpuC&_nc_oc=Ado1eL0ETrxudpAtEQ4KzELRhBvZkSfyyvG78Wx5rpq9B-oiarjn4Uq8pOnOFizso-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAuW6oxQ1wHLTlkBdnxVaktexTWthg1kA7FIRju1ZQ0g&oe=6A9C24BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsnGElbIHXAQ7kNvwEEbdH0&_nc_oc=AdozJK80EQjW6OGziLzAZymh_uJGI3iWD_E2HpDLghUB6iY6reSI
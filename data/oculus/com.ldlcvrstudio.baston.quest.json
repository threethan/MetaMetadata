.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vaTOoMHqAYQ7kNvwFPckVB&_nc_oc=Adr97aW6k-GJAGU2ewB8JCuHIPyl_st2ZDUZtqBhgkYrzL7sc4lkD3HdmnyjZNZyPWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsW9V6WOg7JMBVh1W7Vqlya8A0gc6YRMTwtLQ8Ag7kiw&oe=6AC11301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8Ht-ECDVaAQ7kNvwGQlZ6k&_nc_oc=AdoXURUA3-5osI7gCzLgx-MKR-cIVF7dSDiG3f_WA_hW6xyp8ZGNDNIoRRiyhVt_gBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkhA_KvktQ5nEMlARX2ED7LVbbUgO_GnNQq6pf09h3rw&oe=6AC10E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaBQlMST7zgQ7kNvwG7H10n&_nc_oc=Adp6eHQgjasJoJrM3_S8Mz7jTAR37B3aEBVjRHJm0mGxftWVN8m6NxzWlc10bDOzZbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkgp9FK_J44lJxww2amTKPDDD0Kx3vCbsVha1n6dKabg&oe=6AC1323D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSz4dj2jVm0Q7kNvwEwOQQM&_nc_oc=AdoY9O1r4vLaAZaPe9A3aqBuTytl19yUAAyqgypfmF1T3nYyupG1bEs73ONsOPAe5nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXa8pD4bbAvWuTSYQrYCylf3BRaHDR2odb55xHxZyT1Q&oe=6AC10F64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKc8s9X03AUQ7kNvwGMvqk5&_nc_oc=AdoYAP5MnZm3wVSS7MaIfxWOz0G77jzLV03q-dYhCGgzLNadoV0grXn3OF68qHViPlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNre5szqEdF4Ojl3M0aA14eFjh0HfD8FI_8drzNz_95_A&oe=6AC10EBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVDRSI3_nzYQ7kNvwEpwKHT&_nc_oc=AdpZE81xUZWS3IfbuNHTzdPnPiNEGnwPLrVKXEavisEIFuqX0tRd
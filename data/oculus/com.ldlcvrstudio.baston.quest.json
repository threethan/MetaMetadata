.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXLBpHb2LloQ7kNvwGxTd-H&_nc_oc=AdoIye-rzxQ5X_jGYJAw-rfHVzG8DOWsHiw3rCGlXPwovyNcFNJuJgsD9cBAEAb2CXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsh63qzICR7zgutCBhEBWMc1pvYephiuVAWsYy1F4H6w&oe=6AA6B501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPbjn9c4AKkQ7kNvwHR6BkV&_nc_oc=AdpSC9rauk0fgueLL5MKYHyZ5ObDm1stwNRlwb5_VY_9VI5J0pH4f-Wpcs1Z1RC8MFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAe5xE35OdSs8x6PQJ1eRqGwR26lO6eB_PfyTUT1fZsg&oe=6AA6B096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhUAVq4Px0YQ7kNvwH2hLqE&_nc_oc=AdpmfRVcec5ZiQDy0SCoQ1WtJqyxue7ULOTuRSKvFNARP7VTbvi403e9H83RIr0fuOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjRl-SjKUeXn3mK_0bYm5wRBSrAJklNmFHdbF3SeDtZw&oe=6AA69BFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BayNeBSjBQQ7kNvwHlb2C0&_nc_oc=Adr6ifYwN4Fmv8RbQwD_StzrfVFGB955w8GVpYtrH1ZxBM92LwIYgUFa_3kR4iEncAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaWVVYqNkRNfIOVcgNDlxIwh29C1tpoo_5-6AyJ0BrWw&oe=6AA6B164"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi42uZPEkC0Q7kNvwEzmXRq&_nc_oc=AdpIgsjWsxMorLc0dNu4rKFhsBoHgjmJUtMDf0nsjHP6onVCGYakGRio6EdshZ6U1p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfNTxZJ421eSDpmQvPwo3JxBaJQx_tSw1yIQ6DiKf8ow&oe=6AA6B0BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtu0mrB_z3oQ7kNvwEHIXz5&_nc_oc=AdrLOt-9Hvd7VQAp0UWGaWkWpXCyizXvqPRNcmgwNo1LMrMnT6Ns
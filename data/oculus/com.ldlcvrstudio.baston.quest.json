.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNmfjOfi7F4Q7kNvwGCK7YI&_nc_oc=AdopXT2dstKqh6cKakcKZnOrTWBu2cN-HVGNiu9ZucpwaQ-rZyq2sGfOrYxH5PBM8As&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyB03Etnho-FK9rDuRyzcWS0pZmRovYhbE8oTKFPMCcQ&oe=6A8C1EC1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ds7tu6EzRekQ7kNvwF1gt-l&_nc_oc=Ado8YlgDZuQwhIfjuEly2nBl8DLe4emI8y_xQ7ItJKRK147ffQAtG5rR1PKqkOivsas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGTMGiA9P6mB0cJWdv1gWZaXi0xBOKkMP5FpcpH-iuXw&oe=6A8C1A56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5zHGmK753AQ7kNvwH93pEs&_nc_oc=AdpRo4C--l0xSha_ldOD7nfKygL27josLFgqxKEHVGhGuOk2asrmYnERiTz-ZTJszGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH13zQnxtLA2vWH6VcT-FXCwQOp3iwJsQo4kkeHWvIbJQ&oe=6A8C3DFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfC5vLqhac0Q7kNvwGuYFk2&_nc_oc=AdoKiO6i6Zg_Jf3tmvLi7n9fbDlb6csa_nk-u1bPTfWAWDXLDhSMjL71Ci_mNFUsHz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB0AP3jqFqvOP_pMZn6V8z70ovXXZ97mtAhyS1sz8HBw&oe=6A8C1B24"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tas-7Oxfm6sQ7kNvwG5wOwr&_nc_oc=Adrza1gd1Ujktd5VUX7cEl_KdOFjUSKrwPkYShaNh2hgTrI9To5QCtONCyMvYiqYdH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHafMXCctKuBEqhJ9hUqbUR3NBrsL_bHDVpMCKz94KIMw&oe=6A8C1A7C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD1_7U8IkwcQ7kNvwF6EJAf&_nc_oc=Adp_iAY1WE-nLHWHE_0UTw16tU77Z7M0U6D2PS1oNjCygMrVb2xZ
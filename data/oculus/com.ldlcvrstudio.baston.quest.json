.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mYP7d8xVWQQ7kNvwEoFgFu&_nc_oc=Ado4fBf94lMjdwbV7CfjnFT7-FH6dSWDwwk6cVy9n-80IEmek3vSnAmpnCm2SAyHz2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUSYqKo-0Tg35oWwSieamxCyxY5BUYJ_nZGwiGtHnX2A&oe=6A525501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WlgTN69HUAQ7kNvwHCLrpS&_nc_oc=AdpmpM6fa7lUkFkpLF4tosvUg3E50PoIwkKnMNFLR8_IxaA-uOjEi78AK-exoxauCR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYInR2EOX77YFUhFg6NEar2_XduWlBtDNaCfwtSMGYbw&oe=6A525096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpLZ7rw3kqsQ7kNvwHBPoJM&_nc_oc=AdpZAK69rBYuMOAsy0A47b0xH245Plz9RZmeLU_Y5bhTMup6WqtWAHcNWrSbcodzRGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGOjR3oKbfWeGMl3sezBH5_k3FpQ0kpoVTx1Cmvrp34g&oe=6A523BFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xvQxXZXATwQ7kNvwGtd2-2&_nc_oc=Adqg6dz-qfNvWgyJzrJ6KrqXCMEDSD8oQgJsdgPlNvoFW7G4QJJYZVBu1Qkx8C_zykw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaWHbJ81lFco2Y16iE0ci5-aAui_f4S9Cz0EkhqCosrw&oe=6A525164"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC4ah-xFsLwQ7kNvwG4QOi3&_nc_oc=AdqyU5M2AUNmmEzcO-uEwqKM4-A4g-a1Py9_za6G2idh-59r_ZYgNDsailVex_DvLMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybun6afaD9b21DnCYlrIDGpX4LjU7NFwI3q9JsHTbFg&oe=6A5250BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnv3rQKWsxUQ7kNvwEE2GnO&_nc_oc=AdqPIacC_ou8FvIF5x4MAxwU4JURr-0IgYhdklXPhZ2i4379UzQs
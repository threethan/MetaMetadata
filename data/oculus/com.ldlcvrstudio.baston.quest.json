.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQRcESSDmC4Q7kNvwFagWyQ&_nc_oc=Ado71TTKbyXq9emX1M9ExWK5pAjjNnmBzUbr6DCg3Ur8P0ZpqGJbzEn3oxEQ0rJhZro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g3Vup4GjC9Ed6az7lQWwLRB5ZKP7QnL4HeFocUH7Lyw&oe=6A072F81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZcrBfqJdu8Q7kNvwFc4bF9&_nc_oc=AdrROxemlky5M384Py1tghhHi4fhAE5T21mvKXkfXtNct5VKKSwTfLqODPu1dhM93aM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dzfHqxxMW56s2SzJEV678ybN_WBQVdO3wGACPRA-4cg&oe=6A072B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmAjovxX2MYQ7kNvwG6gm5u&_nc_oc=Adq895BwL-wg8Sv4xZ9s8dfYEKylyagc1iPcgx8ciQ_cygNNGnJCxw8IEmu4gpW96t8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uVn9V7_4zIKRpx_2ELJ3sbE5KtsA03ZzWCrNbHbhCqw&oe=6A07167D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2OtpdsezDoQ7kNvwFDWtkb&_nc_oc=AdqpuOB5jvGgeoXQGVPVnVy6gnF2zsznIT4IGnSMYmvvYysiJfI5-DENJAVDz0byXo4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4juJOMmIKe16tQR1IPEnA3jMftfwTgK_gQjaz79wHyjw&oe=6A072BE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeucD3ls1DcQ7kNvwE6FZH4&_nc_oc=AdrIJhF9XXjBsEUg5X9g5T8gdgcJhzmewm-dQHa1BDR6WMTZ_L1BOYXvlZUzEWfzz0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T1TDkJ9XtPcqfDpRzl6wjoPGCsEY8zt09CSuQAHHmUw&oe=6A072B3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZiCT7C-1oQ7kNvwHs2HkW&_nc_oc=Adqdkr41j0HoQ2PyBCU6jFYR-amIJsBqrmoOrnas7H_T31kZ5BGP
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vaTOoMHqAYQ7kNvwHOr6Qf&_nc_oc=Adr3cB3P1AxVziG5jr34M3hcau_Ba1m4_LDqytS2qMBcomCoA-cN2n_2sbOTgaprLz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFHyI_fLtio7aJbFjbkCXPEAmoCLY7v-CYSH0jQpwyzg&oe=6AC3B601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBh3S7zcXfgQ7kNvwFYhOAK&_nc_oc=AdrKwY6CIB0auuonOglNTX73InVx9w63SMCY0ppLhUZ4vxBcTYFrC0P6HBswaASTlHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9QtExaQf3AyuIDqgnN8hlkxseFnjk7JSn5qag_muclQ&oe=6AC3B196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRQAcODkP4kQ7kNvwGNvBg1&_nc_oc=AdqzPcIRjQ-GlmKSTc6t_3nmn4YxBUYfbmYnx0V-qe_UF0-4vuAAytWkK6Gl8amftvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvfriGv8j0eAqPMu4OsBWR_t8vbJxxy2ITfQmtpKw_Hg&oe=6AC3D53D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-POQB5zFcbEQ7kNvwHPiznU&_nc_oc=Adrq2FU7_E4tg32KQH2rdV74TxGQ4jt6NcbFqG72-3imZ7KnuX6Gt-W_2U1U8PlZTro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrJ9bN2osF6mW8HUQPrD97WU-xLOpn-BG3awFGx0bImA&oe=6AC3B264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS6KUSWBhE0Q7kNvwEEqihj&_nc_oc=AdoT4JuCI8i2dzHg13TiPmWLjnJ5XVXToCKO4d206lxMmoEFn_bV2XT9DGh2fnZgP5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAAs-xXCBgx9k6D1pq39odvjIiGCiRTQAqXTGSNQEzEg&oe=6AC3B1BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_A1fa4hc4Q7kNvwEpOc8s&_nc_oc=AdoA59zBCTPuopJ1LW7Xj3MEVfakUZFfNOfdYgCpHvcvy2QE8e4C
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD_1TWj1xjYQ7kNvwHE54Lg&_nc_oc=AdrFlVdvhuD6FmTmSXuJzx9e5uRIRR9FaLj5tajGcE9R7qI6-pc7DnyCj20HmHrHgco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2TUDcTbnkFDtTj9mUL574VUtRZ40fQmpf1_PDyQMz9A&oe=6A2AC801"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs8FCXWOPLwQ7kNvwEUtZ-j&_nc_oc=Adp3yAp6_zkH0SyZ9zeaqsziTlW5Y2XGhn5yz_oiHxRXotVla4h_NoIEIx9fl-S9EMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82myGoicMZxvoyLQ-CDqggPVe7JRvxDyeWl18X0wBrCg&oe=6A2AC396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TljnG6Fvoj0Q7kNvwG9zQDI&_nc_oc=AdooO4vdrG2w3F7_jtdNtWblZ593-2GUFb597FInyvQrPdp7wjA4-voGK90LI275d-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83RaSGI9yL6iebA1Ty6SV8cTq2X8WOXXG4uJXfKXd26Q&oe=6A2AAEFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPPL0JizeRIQ7kNvwHQo6KQ&_nc_oc=AdqGr65VWCFwQMCJ4JIyBTBVhKH6rrb6ZD8XR3F4yUi4iNmiQaXenYLmsdM_9S4eoDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91mjG9FmKhZuSLmwG7NHeT1bRSG5L4hrKfQuxdwZZQfA&oe=6A2AC464"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pUdXwlqefMQ7kNvwGIXzD3&_nc_oc=AdrFdgn0wTUDGYzF3QPV63ym7PWskO7BypUO24N8Gketa-QNbGFJbC22t6xO_qG8kQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VCt7G26kQ1mmwgIwbYEIRXVx95RTYUABWxsrI1fQlTQ&oe=6A2AC3BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaKETxT8lB0Q7kNvwGuMc0j&_nc_oc=AdrnwR--4jpN7aVFqJESa_XiYMWEsqixLiT9skQNIeQelhwzlnQc
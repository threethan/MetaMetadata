.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbzhWxMkFgQQ7kNvwGe57CR&_nc_oc=AdoRxuenoCUiHSVzLx0MrjhYH0rgCwmCtrRWcv3K6lRlw8GmjGS8koz5U79VHpzwm9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10cUnkLAVfoewb4oO5kE5NfhT3Z_nQC5aVI9NzbLvryw&oe=69F8AF01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhmOPvJ6LGEQ7kNvwGyk8Jf&_nc_oc=AdqS92dZHz6UG67D0OysAuX5draJUtqjyqg3s0YCjx6KHWmEHG-GbpBBgoCi1KqrlUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30KwSKCDoS4bhnW3A51F4OgNL2I58foa3bGpsKgrcOJw&oe=69F8AA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZHPFQYT5lMQ7kNvwEZbS5h&_nc_oc=AdpThZHfDm-_FTGea7WlfaK-ha3Psx3j6qLSSvtV0A-bW_cayk4oGj6h5NAZ-vgrGjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JerRXLG_l9tXxbR218y_ClyxH3-FQIL7_z2CY5OXQ7w&oe=69F895FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjGPcmiKvRoQ7kNvwHOOtMW&_nc_oc=Adpb0KrJacyLYYV4hbvt5RNu82qp0_sSNbAMScUld-fVLeiB6aMm12XkQ-3qtaiTvv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37-tXIuOXWfhjaQFW39daOE9CL4ZjtXVmB24MwlD-RYg&oe=69F8AB64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSAnAUFzwIoQ7kNvwEPXGz3&_nc_oc=Adpa2mSgZrIMhTXNKC1O4UQVkp4-5kaIsSJsxZFHLVa11gM121upJjz4WXx5frNtW5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NQBXuYwVYc24yTpYv8gQCRDJZqHulzJgTxZFg8zSnJQ&oe=69F8AABC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DLm_d5MnjAQ7kNvwEDo-K7&_nc_oc=AdpzKEBTVkfMjxLtZ5TTK6CdIvThPBBLLs9pNkUQ8ne2p4diG11n
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz-ubbptyHwQ7kNvwHsqJDc&_nc_oc=AdpUU_-KUOZsx9BewmNFD_gGNEfYsH9hTryWeP14TFWz06yxzy-PHCrqOgRBeKR_COc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nLTDkxc8tbFNwrwE2xxiz5lHcMKsZy8_qA36YPjbcLQ&oe=6A3BEB81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op5dCtOzA48Q7kNvwFxV26B&_nc_oc=Ado_rfg1SbLO8CPSM-yPOla0PPVYgEfOKy86S8zAqABdtFBhx1DwlsM4DwzQFHRe_B8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MHMSyc9eP4rk_xgnMbB97Z343lQrgYOOpETR3CeMvlg&oe=6A3BE716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qdodfi3ds8Q7kNvwHMZCYX&_nc_oc=AdqUlrdM2CO2OiMh2D6bU9DJ08VOs-N71_sS8ztCBDogDsEwEoySgVW06WTpNlWNa5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mS8UnRylsQaMnvJK8kgJZUrREL1AIKgXBKpV2tJfUnA&oe=6A3BD27D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWJGyC1UsKAQ7kNvwFdiIw9&_nc_oc=AdpqxDnl27bIPLRkFuENHg6K4C7Ic4WlnRF0Pm8lWpU70B4fiHeeIFY1EmVsvYn7KTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83UHotXkIHq-DynvxhfkrUKClzmKs1hPRNQ15yznSV0g&oe=6A3BE7E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtvzJrjFYYQ7kNvwFSidFo&_nc_oc=Adq2GfaxkIIw3VP65YSn-izT9Q7J4YAs-xgy_Jh6d4I3gDfQ_GCdw8QqQsPAwYEeC9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v-rwIqA4Xxy6GhY8w61NibS6FjCS89sVmAL0cStIKcA&oe=6A3BE73C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I3YTahQPuoQ7kNvwGiF8Fz&_nc_oc=Adr8i9qN4hTuSOdjj36IUaNKkoZ8EsPsYzSJgAzM0Wg-ResX8AtV
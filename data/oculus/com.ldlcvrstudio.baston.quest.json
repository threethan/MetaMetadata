.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArRdTKcNZ34Q7kNvwFTov3B&_nc_oc=AdpLPOiXmGUG8EE2SQtT3YSZAcFOPlYNqUWI_P9nOGc3PPhThbHipTOfpeukQXK_-zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPerSErlrTzASy8VD2bTsLtVU-q5Dw83-Gi8LCkuWhb-Q&oe=6AE4AB81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAGSps68q3gQ7kNvwGliGRU&_nc_oc=Adovk4Lf1dbTgCrhu7YNeIptqBBdnxVhVrlFaVT8qMN2jGfCu6udRxT9Qp_J1VUn4r8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMkW-Ulo0QkkeSqPe4uZELlfF7K6PwCFmOgLGNi1APDQ&oe=6AE4A716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyhRhFUFjPIQ7kNvwERK8bP&_nc_oc=AdqrEaLvN2P0cTw8Y6zKY4DivO-CHW0ub9K6GF3hotajP4rXz-iCmnMYbpnDt7h-ap8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN61C54BHYyFgmJM-mtpyQWA8SeocLhbGewcFbsGaKKPA&oe=6AE4927D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CM-c1ftzdAQ7kNvwEfG5Ee&_nc_oc=AdpfTw3IUIs_FIKeERcuNf36lhmWFM-NuBJWmvoIuifZgAUKfPlG5_Q71Roubw_3l5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6vZ3cq7lhA3-w1BUOwo78PmpLQvvoN0XQhLV5pUYMfg&oe=6AE4A7E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-CvVAI3LUQQ7kNvwHNpoY8&_nc_oc=Adr68u9S-AB_oNu_EGK3AgcrgUzIoa7RqeCYNM08Jx_kJurz_D2FbXbxDUTImixYtRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpnJ1O24_1XDYBvi5aSGn2o2C1eLbacBhVOOvemJix2A&oe=6AE4A73C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe-DlUi467UQ7kNvwETLJUc&_nc_oc=Adr4L4NOJSwCZX5HKjMEdHeFhfvtUk6NY63_vgKkXKP4Jq4-gKM3
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnDLTDd3IjEQ7kNvwGAQAeH&_nc_oc=AdpYUrVKT7wYhNQ-sW28Y0_3oJdBc460zCaYKBlg7p1BlziJt4Gb8iUcXcycgr5u9zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrEVpNqb9OjFl89n0j2PpI1UhA2hvSzMmYzPtniI060w&oe=6A4A6C01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5TodBR_zsMQ7kNvwFldtxz&_nc_oc=AdqnAkaK-q479sQNCNIUfsAY63s6qN62y6HNmaRgxzqC68glCgxjuXq6ewPnziCLAEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjGGaOonerBH1KobZAU-WC6ccAL1mnts49TdYIrtjn-g&oe=6A4A6796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbl6QQk6XvUQ7kNvwEiEcZI&_nc_oc=Adokd6OplL5cvjt8WZh92phPlRbVURqlEByDbhCJlxj153z3MEjF4NgAiX9YMVNPmlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFEaRyr0lViSRnoqxo2iY_vgAOK1mfmGeZe0subuhN3Q&oe=6A4A52FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6JzTzbXgOYQ7kNvwHjDCy8&_nc_oc=AdooL-9rBwgwURunyD5hCZm86jSAZR1gtN43JVbM0oiEF9MEGJ0_ozhExDosZzG628A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq11atZUrCIWcYd7c48cRkIitFfv9b_TQZdlgE72cSew&oe=6A4A6864"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGoyFXzjP0EQ7kNvwGvZ8DQ&_nc_oc=AdrbjC1xvAfZTF9exXPT23rrm6y_tkpnlJWji4hMNTvhUcnjkg3gC4tPQr5eog-ioa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX87ls3mvI5CODHjgkYMu7u4U5auttCj5IS1wV8crbQQ&oe=6A4A67BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7EBaYG65M4Q7kNvwF6nUjL&_nc_oc=AdpIGmwE8jYnFO8Yi_Dry2teCPMfIracRtqOtQevORNdvbQJZJHU
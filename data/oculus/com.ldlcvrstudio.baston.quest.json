.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OZOyMjBxqsQ7kNvwHELtyT&_nc_oc=AdotxX-NiDCIUIsXd2K2kGGOvXAehhk2oYlnUYwpSbcD56_vgGZ4KS1RQed4SiUFy8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMfgz3u76c6tEHLhGwnzi_pt3JPwSceeiVqkLoSafLxg&oe=6A510381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WlgTN69HUAQ7kNvwEIE4i_&_nc_oc=Adok_WXh9RSNKLpgWuB32t1Xyt4MUGbcSRVJjSi0fLIMBacMm4KVCFB2qLJvaLOdmwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUXjWOi6RcxoaLv8oC15j3mJEJuLGnsw-TxmTwyatc3w&oe=6A50FF16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpLZ7rw3kqsQ7kNvwFtqRYR&_nc_oc=Adr5rQ8UNaMJgs4OJZLeKf8t_DFkeyUFEXrdGIuCpYMWJ_l1GBqWSGsWhJHt6IVRkxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdZhhmcz7KrVFVtVczHbV-610HZKBmsZ_wR84eKp9UuQ&oe=6A50EA7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xvQxXZXATwQ7kNvwHwVuVh&_nc_oc=Adqcl4h9WJNgc0UfNHY95Z8G9VDwcPULPElNU735WwOSN9pzfJD5MuRYQeWpAj-jew8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf8whlfAa3IFJ2xoIOvVY_OiM5EYwRbBXAldYX1klULw&oe=6A50FFE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC4ah-xFsLwQ7kNvwGlcKsY&_nc_oc=AdoJO7L1PYxwK25kb0xWdLFt2ixuZO4SR47IbanFncLQdoqbHexjzPj3T7OxNw4GNzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBawzi_rKW2DKi9albRR8zidJlAeVD9nfrO8RJwMYHXcg&oe=6A50FF3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnv3rQKWsxUQ7kNvwGSP-i_&_nc_oc=AdpljAcI4kJaZgnmUBHxX8Om5QXtD56BnIuui1cEZsxT4Ht3FT51
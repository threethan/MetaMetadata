.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul2lfXxDM38Q7kNvwGZTqXC&_nc_oc=AdpIKIEGItDmmYzFG5Uval8krzNIpaXEqQ6JwD00MxQ4ptUc2l_55inJdjmqQwxo7Gk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyrDhzS8b2CSO2QWEpRkp_nWyKLWCaZFq6Pb3EdjxrwQ&oe=6AE20881"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAGSps68q3gQ7kNvwGkMvUX&_nc_oc=Ado6qleS_G7G-AJxZsM3bRb4-qMbCYWn1Id1g08sY96QXeZJxifoCWTBD_jYCo3Re84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5O_tPmge3LRkz0jsPMQ3I8jI5iD8jTJp5ao25LzmP4w&oe=6AE20416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyhRhFUFjPIQ7kNvwE27u6X&_nc_oc=AdpACKnOfPItdCSByhWPMtks7u2FMVvywdZeXjaHDQEKHNQHxWpszpp65EjBy7H6zUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ9z_YqqfNrQZRQuA6d4kRAJtRu-Z9lFL176ytKgpFXA&oe=6AE1EF7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8Z6rxoqD54Q7kNvwEwFht3&_nc_oc=AdrUZl91DuDrW5n4uTkkaeobkUGUnxn5zMK_Rso0L5egCN0WZPA1p5Xv2w2M6XKSdVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvIabK9rVHP-Zd5HsOjSwfS96XDAIm-ABpsrrjBC4fCA&oe=6AE204E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvsKeksBbXsQ7kNvwEbexVa&_nc_oc=Adoo0Uvh6imRmhEIKCiXY4p7SariJaFgfsRFhzsrSubtw88M7tRKhyXHt2M0lxNkGH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOAHIeOpYed2iLU_0n0yQ1jjuzmoI27hkKbebzcfwAfQ&oe=6AE2043C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaWo41p_RggQ7kNvwGa8ZeB&_nc_oc=AdoiAAOo0TYhlMK07LCerDtt6eWbWFEvrYMWkqvxUNAu2cGrG9s1
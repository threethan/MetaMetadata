.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHi5P36Ty1IQ7kNvwF40yLO&_nc_oc=AdqUAfR1BQLPSwItFlmstqLu5W9slCapqmY31tXRTvVhjt3-V9CE6LHvBmycA5Ta1XA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqts3EPeYdcMwfDbiHWY8YCs9Y6HPoCPBA2fwQ8MyLDQ&oe=6A804141"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuvLX_IGesYQ7kNvwF4yYrv&_nc_oc=Adp1TKptqTOWNQLIGPb0vaE209-4Or6-VV9aqgBcQ5_6OxZEtpXeNTt0KkVC7GjuGSY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwL9Bp8aFOostof-0PlKrx6TSqYmNv3THhnWuiE1xMpw&oe=6A803CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Y2iwio0UQQ7kNvwGVrzwK&_nc_oc=Adp2wS5aKgF1-VC_uD5Zw4o45XZ5GBcU96Z__A2eEZXiOF4-gWkOg5r3rToDPONYeqw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhh0HPWw6rZI_HTGaAk0GykJ3kWnX6saAGeDjfnS7oZg&oe=6A80607D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVYV_aKDaRkQ7kNvwHiTMoF&_nc_oc=Ado7_l16JxlQmiIfBosCFISYhBPwOn4krwqCnhzT3i3-JaonNi7W4xFKkeBXqVNQk1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHokHj8UsfSLiSJNzmbQyBd3bTHnVWVTBVxYtawr_i2Cw&oe=6A803DA4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQuxMs0AYbkQ7kNvwFhUasv&_nc_oc=Adqi7JRlrFoGa1VkmONK7kSuiA-5Gn3yqGU64r0i41mRnmeKy5MlmO6MTGaOnByHNZc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ5QL0sy8TncjqJdlIMTCiuv3X3p7MVujbD6WoTU7iIQ&oe=6A803CFC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOT7SpRbQAAQ7kNvwHNATw3&_nc_oc=AdrdP_blrvH-ttKnH0ndibHb3qmcN-sUJKtr3JpEcE7D35noI3jO
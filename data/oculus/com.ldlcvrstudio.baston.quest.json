.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAVhCh0EQSQQ7kNvwFrteKG&_nc_oc=AdpQlwgv9q9FAu-3dL0jIEaoULPonY05Z_2eiOqGEcL4HWpR5DmVY0APW9BGefL6wjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4DwxpH7BZAY94O-HqkLLg-_gCRgNle8_bVfza1oP1Nw&oe=6A676D01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BITLqncjYWQQ7kNvwGLjxOk&_nc_oc=AdrzTRG9I28fU2txw0MG_E3Y738Nkc4iZnZ0OTeRaqW_rWtxjpjOrjfLexJpd-Z5WtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0k_RJ_jdIgqgZtnYgZ6G0l38Q8n7bDLI3euzRdIOYlw&oe=6A676896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=retdq_lWaIoQ7kNvwHWXOMz&_nc_oc=Adrun9FTr-f20ixgyiJL6EkofnQKF8bQ4WjNX7cHezTuNV6YymcI-qxvnpW7xEcRm-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpnjVtZKQ9XnApJMXOpunhBWICCBL4v2HB3tf-8-AIuA&oe=6A6753FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4M3NVX9E8oQ7kNvwGaQV-c&_nc_oc=AdqXShqYKawTkc5849TsERE36OFRbowTdEnEuVg8Fwb_E2yLuL9gDgbjJtBL-bqJMco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBemC7sIEg-SQ8ZnNfxE1DPUsCkQ0nZwc6qAwEvA0g9_A&oe=6A676964"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO_6ttut-YYQ7kNvwEQO3Ij&_nc_oc=AdpZfJhB90DNxAUaQDdYwyEbPn0Ln0ugOh1w766sqwRMATcfM98G8XK9ExnEco58HoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCmZcGeiTXkTu8kSUil8jh23U5b1TY2ekA8CKCLfAoSQ&oe=6A6768BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Olc9z4_kkmUQ7kNvwESsN-e&_nc_oc=AdrjgPgCdfRh9v9GSLqpxe7ZfDC1EqHIVFEAKeRP78NtXLdGqDyA
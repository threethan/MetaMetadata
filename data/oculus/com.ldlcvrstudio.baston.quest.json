.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hglIdTMw0bQQ7kNvwEp2YAo&_nc_oc=AdomOAEuObEXMx63sgG-AdUbWnuhg2woD10Qnghknp81fpEBtRVFAOUvbGon3Xl3L-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1iCbkdp4gf21wZ7geKC7KCIFsgwPoBBP5RZ2reilFCg&oe=6A243081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fArzU93ETRsQ7kNvwENjaak&_nc_oc=AdoqX50abiIZ7QrM0Fa0m76WnGpy-7OMPGtXeKB62wo_ZLXCDOWG7U1ax-vlkNmhMtM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BeMx63E145sxaf4e-pHWgSxRVma1CH1CO_aR1XQSIkA&oe=6A242C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRe7_jG4AUIQ7kNvwGPmuWT&_nc_oc=AdqX4d23nxy1InsOww9k6gxRxrx_qick4aQqwDnwB4IO7RSzWSpR6oFhMwGqiN0Mgtk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iPuf26hY2GTCFyWbkXA3ALPC4Rky1aD3OCxRdv_H_jQ&oe=6A24177D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H9w232Qo68Q7kNvwGe_Lw4&_nc_oc=AdrWumKfdcmYT7BCNvWnQ4v_OM9JhzYR-w6mUcQcg7eI7b9IxXTu4KSq5Np-MfevZJM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LXHRGmD7ssi0bL_XAC3E_akdpJfmLPXIGCbiGf-tvPA&oe=6A242CE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poIA3Cv_krIQ7kNvwHgvzye&_nc_oc=AdqeDCZ7NBX0u1Q1KQgem1b4TjiRkbPl3ZTgwizZscrSHS3ZNL8ks_f07y4XVb-gKjA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EbV2aqEusTPu2H9QRjCde3UGS4FV2Ztdv7oDrM8xH7w&oe=6A242C3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzdFXmk2LEQ7kNvwEE27P_&_nc_oc=Ado9djo_q6hyJEREBZ9Eu5zwtu_Y4kL1FAmoN4X6bmQ_my-oRh-e
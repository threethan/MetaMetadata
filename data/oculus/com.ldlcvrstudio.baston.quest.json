12044246292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gho5-wTP7N8Q7kNvwFHyjrF&_nc_oc=AdoCwpqvjmB-EO2eajuIA220mJdKWDGuFB3R_OkYlbXTnSao7MtfUhVYYhrsj1OPQMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cPPTGSJyIPpzIoKb63KOeBSRgRJ4YvBJAyfHluB_SRA&oe=69DE1EBA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DnA9jPzKggQ7kNvwHlmTyB&_nc_oc=AdpsWp8i3TdJlOSselEyIpN4IhNRXhIdOFTBN2Xr8kx4r6PxaHioZO-K5LjRJ_YRf24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WRgbAeY5mV1QDaZ-IWO1Bz64IE2NGIucuUvr4nQo4Sg&oe=69DE3B2A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=sNdHLjUNUesQ7kNvwEMYaEw&_nc_oc=AdpunjvDBLuXir6gzXD1EQ_3sA99M0L9XUSidM75xwNaEmGJ-BhPrHY-Pqxk5o2xry8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sCEoIrDY9z0hBqSTIlDNXvEOZOV1F_MXgYpzRpIXxBg&oe=69DE2282"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6aGnrSUSVQQ7kNvwFvMVoa&_nc_oc=Adow0B9YsPPqT5ljoZ9TAQsqZJHLSOuaYQ6-KItiCdd05wOjGqLsi5kFYOU3EYBuzMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lnr0rd2h8ZXt0VREZqOBY-HmOUgt-PHU3XBLovR881w&oe=69DE4EF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxdoZ_v5AeoQ7kNvwH5OGH0&_nc_oc=AdqsJRYp2gOq1PrufIKUNL3r_Cpy9umTPIvYEKS4oEYg4r7oS8xVKemz3ZrblqHxwvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Flm2Aq8iCxHMXCQjRJQGspWLFZoplFXGvlrKoFpzYfg&oe=69DE36A5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=admYnmVXgJsQ7kNvwFivtwC&_nc_oc=AdoNmT2gVE87Mx5kgA55-UQlMp6SNH4tmHuRLnC09BnFTqE5UZOYIswDHCpLopXCpWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bAFaIv24KWOADAirktGE9vHau0kusy-2sE
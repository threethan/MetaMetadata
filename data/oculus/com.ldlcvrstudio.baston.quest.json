sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hglIdTMw0bQQ7kNvwHSeuYH&_nc_oc=Adr5CFYnm9_C2G8tS663V6xZFFs_4VApL0Oz3peeh5R_T82oB7CZr6sY_biRooR4L0g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uCvaRSEfeuqIokt7ohvc1kd15Xv9FxKpL4pL8jBr3vA&oe=6A22DF01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ww4QsA3ngQ7kNvwHV36v0&_nc_oc=Adp5kX5YS4BJ81wIwBCxGfEuhxEZtZfyOU9ccMtWl8VtZTWkxY8U2_IrCANHbyKEpes&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b1gPdqx9ZEsJcNDNtW6IUJTIwkSUXurkV2nCVhSAA_g&oe=6A22DA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvVTMkb0UGwQ7kNvwEpp_EC&_nc_oc=Adoq5W3V325whL7hPQhSzAOUASQGUEkMafoFH2Rh_W_uRMaiQIzE4wBVu96qQ3HwgpE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__ua4mW5Meu2KCvPPqoGsROUrI4PwS9sX0tVpo_N2kpw&oe=6A22FE3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H9w232Qo68Q7kNvwHzZFYY&_nc_oc=AdpjhO55BgwIkIkDQcQRlPscHLG0RKZSbMyX75__gYJy_Pv2VctoES0dN0hMVeELepE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BUu5rDw7aOA8G72m3sXmKqum-H2m3iBiyQqBfQtas7w&oe=6A22DB64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poIA3Cv_krIQ7kNvwH14vuO&_nc_oc=AdpEiqB67T8J2KdQX-pNDuJktv3yRlM8t4Alpe16goSUclep4wFeJdxqAKirmIj_LXs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94cAfMqzIkaqOyirqljqsasZf4Sbko0Iha24BeOxrLpg&oe=6A22DABC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzdFXmk2LEQ7kNvwEet6ew&_nc_oc=AdpSApfGjJLVeFj79uL17_CMxsUlK-J0N7tdrLkxxdfVzF
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf_ZuBPZT1cQ7kNvwHvnLT_&_nc_oc=AdrGY6KvhLsrU6zY-6rCDi6SVwSO7zxXiGPzU1Y9o4ELq0rpftllPwGRXo0FzbYWtAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeDUGZRPT3lB_CgghBftQg5LgOT__fhkp8ZW-NaO5cNA&oe=6A773F01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrbNUErQhoQ7kNvwEmIpex&_nc_oc=AdpgMmmRPmNAvsu8r8tYN5z6T9mJbRgP69USIGGwssJaodFKZA7ETTJyv8xWa1L1Vw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFDiJoXVmPODHi3K94etuR0W7fzj58YYOmuOsO7FnO3A&oe=6A773A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymQcWsgLRowQ7kNvwGYNaQb&_nc_oc=Adqkp-eejhf6V_fyBs_FpdvN1tufHh60olKlE-iVvcZyY-YTutnLw32bb_HFcPlPFC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF2f2M2Y2QKsUpxSjYRjB6Ard3fF2KJFUOCPQgYDvlqg&oe=6A7725FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPtb1HLsiOwQ7kNvwG2Mt2o&_nc_oc=Adp2_KwnzdZsJ1CEJ35w0MsLkS50YjnsbGJD1E8L2oZPVjeMGWTR-ADZ6oyE9eB-ulM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiv9ssBenN8aHZSGimbLCFt6MP9_MtSGQX1XOGfeOmmA&oe=6A773B64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcT1JPRYNaMQ7kNvwH7azYr&_nc_oc=Adq0RtdtuteZU6xy1xgwJWqHhxucGuWQjA3ZuYKofYxaDfPGgLdaIHh7BEkTPIJYIZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs1rUNijCvLeQM04fF_5Ous6vUM-H72giwZe01tcedeg&oe=6A773ABC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdywH_vd550Q7kNvwGJJ6hv&_nc_oc=Adqp-FDkrhjf3NbvlAuOSoIG8d03hIoApZfNItt4bdfdCryhpSVc
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVZQ95BuMb0Q7kNvwFCHDhf&_nc_oc=AdpMJpeduJWAiMau6j1nQQwRsUtJJbDHcbKw1hb6b5JJ33-sE7-JxA11wdEulQVfIck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzyeZzXgTn-MPvRJNRwYrKtRgcFTf6z_YNu2EWWRlTiA&oe=6AE8A001"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9gthH5pFzQQ7kNvwG5m6tP&_nc_oc=Adpp6_TOlLqHRZorw_s1P5cG9tUH_a8wM4hp3oFCOVPpuwSk-UpADeiDwBjv1gwkctM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj7uKT9OTPSFuhYaweggaSi1hDfaySaUvxSSP1E9alpA&oe=6AE89B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGPOIR5g3DYQ7kNvwGqJbc7&_nc_oc=Adq2uK5sdh6SNz4bbdEM9ZWE6z6NdMUpxoY394uzSfqOFnqe-4Dx789RwW9EBEVi1vc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3cxPE1cXhbvHdGvLWHnxdNnFcwlJqEf3UMZW0yoVDMg&oe=6AE8BF3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tgT024su1gQ7kNvwHxIbhC&_nc_oc=Adoh1z-0G-nWXYIZkvR1osDXqfMXMT35YGXpKs1P4uXaLLA0s60i_tQqwrvd0Y-Gz7A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYY-TO3MjHv2JZfd9TLg-q13eJK9b0bQkeWUroRoW-gA&oe=6AE89C64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DSM742Ph9wQ7kNvwGJBSZG&_nc_oc=Adrm0dZjDegf6f1Rp3rYnjDO1RSNf7W3lR4BgvkhWQ5D9ubTWIOQXx9wunNuFn-R5uk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRODRFaK2xa_FMNHl7kMMMod4Ns9gQMpZRAFVPullZMIA&oe=6AE89BBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C66ndQnXuu8Q7kNvwEpKSe_&_nc_oc=AdqOOJz3Un6_sPACZYyzA5FFIqhWGoqFwPMANRIx0dFxkCIy5TNn
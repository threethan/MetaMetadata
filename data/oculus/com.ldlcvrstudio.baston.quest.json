.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siHY3paBT5MQ7kNvwHtZMEv&_nc_oc=Adq7ammq8O9wA1HvTgy3rmc045OlAzIV9BWY2LQyWN-F3ENsrCqXsHkSOy_hM5kJzCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Tu_PGIpTMsejTexLOrW0qMZrQE2BGGZ8cL-_OJvMMQ&oe=6A734A81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtz77Hjr0gYQ7kNvwETIr_n&_nc_oc=Adpk9R7P6OCkW-D6WQ4f8dRuz2Jeo3E39fGuvrczja7YexkfKWnoXz-gVMqzX5nsG3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtQJ6p0-6dJq7GzlwUu5_O77gQw8s5iw3pV58ZLP8P6A&oe=6A734616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riY5TEiTJUsQ7kNvwG-tJeY&_nc_oc=Adqg18EJ1RgHWnOIDr40L6I21_vUSWYy704pStQOijuqlkFo9gOsMDOZo8Ujtz14V_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZBTu1Gquxexrf5CZkc3E4hZ41A-8QZVepcjlut0Xa3A&oe=6A73317D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihpbrCnc-PsQ7kNvwFdDX30&_nc_oc=Adr9yPACrJhCjZjHe9JGJDEkK_3SVGxeA_Fs6IjggEegAfsPsXllKsZTqRwW-YGWsQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD1aJuEg4hu01Z2uvcD1nAqg1QR47NfRB0o6uKFXz26Q&oe=6A7346E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBLjjiBF3psQ7kNvwEKwRSX&_nc_oc=AdpiVr2P9Btp3xlLpfR44g2rDHSUGg4XPz0qbSW9DleN7W4RspqmZZd4bp_Gan1jMG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk0hrKjR06KZSiWBbtZB7H3e0wdM-Q_sTymjqoNvsPSQ&oe=6A73463C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyNtIjV0vlkQ7kNvwH8J3hS&_nc_oc=AdoGxiJiCQKuKGCbqUFXKMouOR-ENpYdUHPP2WnEkIpTOcrUi5ky
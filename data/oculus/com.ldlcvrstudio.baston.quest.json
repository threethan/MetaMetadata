.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgSAPStrWlkQ7kNvwEaKOVI&_nc_oc=AdrxdmCCl3GPL1s2eI4h0JIBLjyROBcEHkp0ChhNg7wL5uFTLcuVrB-61_H0Nmgzkoc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJyNevurNsTXqmn2HkWyhpSNljHN09w8_g_xDkSiizpw&oe=6A9164C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR-pdyfkP-AQ7kNvwH173ef&_nc_oc=AdoYXD65jUvcY06lUdRwV6yeo9p2LtJdTVDDBLn8eh61eWFlr4r_-f3qyrpxIPE0cuE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIRXcCBJfIzLlEQ5RQBgV-DuiabPEZglM5nm9-t08siQ&oe=6A916056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2FETKxb2aMQ7kNvwFhuBg_&_nc_oc=AdrOOxCAphbTf6yvg2iWx0FO0YYLjGHd4byrwa_cu28EIbhV8qBeX5TAJ4lA2GtADSU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPy0d14TOJ_BFe2SL-oSUxWdWmMg0u4PIECnkla5wndw&oe=6A9183FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwQLI_-bdnoQ7kNvwFtwcWo&_nc_oc=AdqOZ0AUnGdLXOQxP8_ktHW2pf6yNs86NTBgZff2kgDr9ycewOsyn2H1eUvslf_pnsU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgfxBUJwtt4adieK7aQXvqy0-3PoddyiKFdInGcTI2Pw&oe=6A916124"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUZxnrtQ7xQQ7kNvwEoUtER&_nc_oc=AdpkZQMDo88bcwTOSzsL3aXC0GZ_SXeldT-osQIP-I9Qk2e3v-cHWP6pbXjYboOYLaw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHFxNGESPzIcAWRsq-7ZoSnhWgpDpwasFRd_Kl6RaK7A&oe=6A91607C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4lPmtFXQFEQ7kNvwGhzUKm&_nc_oc=AdoP5vADbKt2GYI3IgSB2t8dTRLz_po2kMbVLQ94O83C_sSJPClG
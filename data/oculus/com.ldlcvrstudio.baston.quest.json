.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quOvU14itPsQ7kNvwEtdCYW&_nc_oc=AdpnWTd3rpKGXvCO2-7KaY2vHPumxsvMEhrZbv8Y9zVeWnuTSxgw2B_KsfByHry03-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyMd5f2PcMXleL0fsBuWsRmteRyXb1dhbYB9AiKHQxIg&oe=6A491A81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5TodBR_zsMQ7kNvwEpk8Pk&_nc_oc=Adop2vhNML5wZV4WJmSnIux40-vaHUuoUZdQ5_PlUhe0LeWunym9gdxfDdlLHYVpa0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuMVapWbKM_GGTbBsu3FX5-YzTxfX8zUzRUSWH96Vpng&oe=6A491616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbl6QQk6XvUQ7kNvwHwcSYs&_nc_oc=AdpcbJgkkdNy_kfUv80WM5qclOxjsfORf1ntnIKju8EslylUK33wD3ZeDdCXlbghK58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUZ-kxdAgr_qkRGl_TTkcgT9WpKSEDKzDlamgs5xz1_A&oe=6A49017D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6JzTzbXgOYQ7kNvwFPCA3z&_nc_oc=Ado0LU-ixgAg4jVvelDRzjl-BTbNOQ3CW5E_O3y0Zk_Glsa1ZbZEtylxBDB1dvWQ6f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC09q5p3sm3e1Qzv4Oo9uRQvmcdAywkrmfpRVERuA6uBA&oe=6A4916E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGoyFXzjP0EQ7kNvwGUGQYs&_nc_oc=AdqJy3uCZ5iBqEnOL6WsMKa6QoNYXvuoTZxJNsOIT3w8toaEKJgkxCxr9YPYqG11oP0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5MZV_tO_MZDoYdDEUQteBfATV7oHIzot2SFSJox7naQ&oe=6A49163C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7EBaYG65M4Q7kNvwGNI0DS&_nc_oc=AdrAW_pJy2Y6p0HhWmVL6mEefLMQdeQp6rtH9ezHTGbzS0vtbv3q
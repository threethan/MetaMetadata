.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbzhWxMkFgQQ7kNvwFueL_w&_nc_oc=AdqjB7A9n792fznxSK4PIYM6cikKsLTDvM6lLRnOVAU5dULb8M3k4ovrMmjnTYjnXsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rruHVNi0MgCKRKQ0kCOMUdZ1_czpgZeM8o0Q8jsozHA&oe=69F75D81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0_8Bb4m_w4Q7kNvwHMNzrS&_nc_oc=AdoTSvicKD8mLI5wUPJuTVxUbQyLFflplA56Y4wR9-NMe939tGryofSan--qC7pN1pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20bQW6dV-H8v0S2nUxY4YtRUZ2c6WycDMJBlgaAFxoXw&oe=69F75916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIlZVeiW9rAQ7kNvwHWn3cD&_nc_oc=Adoq_2T_Ymd4A57oEQ635lGYijQYj-LgYFLId7mPxHIY5gBMQDMbKcnIxjCbxTIdSfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Or6iNPO__fK-O8KmGnGcmXba-BTPUDzOComXrn9EoiA&oe=69F7447D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjGPcmiKvRoQ7kNvwEJwW68&_nc_oc=AdrWD_uI3zgoy3pxCjJxRx_zC5Cy1ok03Kbwio2slSYUAzRnDhKBBHwTsMi-gRwTt4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xebBH6P7vfK4oaQRSxI2_KkE-Q5T0vzqOj08QiI3ZfQ&oe=69F759E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSAnAUFzwIoQ7kNvwGtL9W-&_nc_oc=AdqoZGK0fJnvRWZbfbURIzZQ6wNTSCaxq8Tuoi_ZkLVnmaVGvLkw80A4bU9amxe0THI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MDVXrczBSM0qukPcCZvSPqeSFQuwuYVTjy6XtMm-QMg&oe=69F7593C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DLm_d5MnjAQ7kNvwFA_mhE&_nc_oc=AdonpAkJkGV0crSgP-mEwSxdUf-By4UNXKczFiRlkgr6PDSG-udA
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkcSjmRgTFkQ7kNvwH2-7g5&_nc_oc=AdqpYcb-FBGbqi-_gMAPvEgxshtQJG03ObQRiqTMB-KOS7fln283cuMfsA0vHPlMylE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mHRAVUWGpDujnBxpW5wwXloM967-KaBWRAKkv6W4-fw&oe=6A19A481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_POViGGldgQ7kNvwFRmEW1&_nc_oc=AdrOMWMKx7LZLGCr_QP9HQ518OkjKULErKtH6f4FiP2zoDemSeIyZRrlekio_m0PrGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qsOnn1SzIelteDpNIKru991NXPSyGDgX91Zdv92j5rA&oe=6A19A016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8kHCBmOD_IQ7kNvwGdAJ4x&_nc_oc=AdpU-iNoDV4nfb8sBdw6iTLr-AwjdW6vK8NtJJ-9eww-rijfgYS9WwA12eq68MasEa0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C8bNuSeZtqOa2Jw19lRtWf_REimiM9PFCNMoxuns5ug&oe=6A198B7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tineG2gR-cYQ7kNvwGqPWh6&_nc_oc=AdoLiZDLDnNwOrD7MVxBd-Hc5y2b7nN5EBBur4jQwi9HPU27tmy0-ycCcq17hlUNHlI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VGkiUZvdmKtUWdl2Mn6QEJIhk8AS0-9ZxatkrYAGFxQ&oe=6A19A0E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3jC-1kJxi4Q7kNvwGV5E8h&_nc_oc=Adp2aFIz8yIxrmWS2NU6saw-Lvm7arEKPPjbEaDq0oD2bnZ6zB-liQiMqnDr0MPRo9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QtG4Nre0ufopE343y6Eq4JYJtIz6fYah9VVwvwlTevw&oe=6A19A03C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA2BUsfM3UEQ7kNvwEjD1p-&_nc_oc=AdpcvAhLydG0iXwtke3qnMS8SQMTj9OwJZrRpSWcZOchSyY199wR
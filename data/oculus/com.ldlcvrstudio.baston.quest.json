content-lhr6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdKSxyOUMoIQ7kNvwFN7qTW&_nc_oc=Adq6eoM4RiGyBidRI6Oh61FVJmg6av7vZhpqG-8l8Lyk0co4fhZzd9BE8CWOWrLSpTI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmG1Kr08Em2F2gWuRGfe-vMFD6ra0S2t1ecY4K3pghHg&oe=6A858741"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u-iePDag4gQ7kNvwFJdMZX&_nc_oc=Ado0HTUqwVnGBF5xqs1KS6luV0qs-3Xape-5xzqYiRoWLU6HR_-gKo9sLkhATURRcsg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFScLL1OSsqUZq0_6eUndeQ1K9ehiLXZaSHn7dVmRNOeQ&oe=6A8582D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy3TIvAR5qUQ7kNvwFcABlx&_nc_oc=AdoZkhsOP4-ieStUpnogXnWcMnftoctd0edHgRNrK0J3yEyW3Y7Vv18eNDIV5ZMh4LQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYC7aHEbQeOuHeKV_VVYtvcUCkyioaa1hXWd9ofSWK1w&oe=6A85A67D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5xREehhAUYQ7kNvwFJh2w9&_nc_oc=Adp2lV4jdjY_o0cVS9q2INAbPAKAlBhExGio7NwUiDWZR5nyTfgzAnIxWZVKrFpZ-wc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9oWxJPXif6nQbph7Ymy6oLPTjVVGKpQhiCqqKhcu4DA&oe=6A8583A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrGcAE2zHmsQ7kNvwFl556D&_nc_oc=Adpq4Z-nz22TQvLGL8B_N-WEhzLv-MGzNoKKV-TEj8dR-uVxIff_-Z_xCRh89IFXhH0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbUxN-REzo_e7EdK148VXXdQTC735lTfoawBhcDTmbJg&oe=6A8582FC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRKux01TwW0Q7kNvwFOiVwB&_nc_oc=Adri2l5dtbtTDl72xXdsWTrVh0iWiXdSG_d3
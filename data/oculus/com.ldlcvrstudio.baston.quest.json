.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNdi5mYhkBsQ7kNvwEYEHQ2&_nc_oc=AdowpjH7HHHAKNNTP09pgD-woz98TuVmTolwI0tLZlSpKYSs_Eh_InU6e8_zhUthtjo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4alnK_7Z3njU9SFFkwzQ-LascZ_EGe4pyED6mWQgpw5Q&oe=69FDF501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxYNa_0OTfkQ7kNvwHWibOI&_nc_oc=Adr4tiaBVcw2Tn1DFsLTGxlGikyQ8QWdhTbvLTEE5wYvIPjivnhIu9ojSsep8bFSG0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yLgtrIaYzG4pm6R0881yvSCYvFwq8X5kpFXmwhPs2UA&oe=69FDF096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOnyfjiPDhEQ7kNvwF9weL6&_nc_oc=Ado5L5dDy9bvyyUyP9duU7Ao_MKo0VJZCD0GKZrm_UP6Vp5sCsqjHnHDngbjBIQxs6I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jN13E9BWda-cf_WXueZBGL7BOAvC-u9qFxZFjVk0szQ&oe=69FDDBFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akjnp_sP_5YQ7kNvwFwsm_D&_nc_oc=AdooOIlCJZAZdo-_xx62DRQOeP0lI6-h3IHRjtQKaIDhiv7ibT57R3t3ydBFrNAa_Kk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xjif0rt5onr8J4g7Hc_x20jVRLJh5IqiuUP1e7-d6qQ&oe=69FDF164"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl0nKUBT-IAQ7kNvwHGoYM9&_nc_oc=Adr2fZfRkahLXXF-0Co_Ym9gyZhrCKfai35yZd9rCqlD56Nz0BBA1-EjmAzOS9Ankqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rVEeCsu7cxLDXrurNVkMvnCUKSwCiPviNWD31Ofelgg&oe=69FDF0BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFNmqTqYDVcQ7kNvwGOWDq3&_nc_oc=Adog5NURff2V1fHqirgwVQfcWbuPqikg5iuyTcB6YM9m3CeIgOUR
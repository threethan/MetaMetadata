.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNmfjOfi7F4Q7kNvwH5QURF&_nc_oc=AdrUPfLZXBD1u_P1q1_oO7HuCBMRjRYbIqGoNIVxgSuFqe7h9RB92hhQm6e0gawc_NM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOennsRd-7jaVCDLI1JcTbgLHep2GG87CH-Xu8Kek9Gg&oe=6A897BC1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6SDqGqxdGYQ7kNvwEJ35BW&_nc_oc=AdoHu2r--daqPTGnbG6aZ37gB_HbkNp5QTmS3CZALHB5ZnKi2x6zvk_ueYCUCew9zT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf5_SDp7aZT6lNv36VuuXQM_Bx2JAk6b5URgOJ2aez8g&oe=6A897756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wJti2j3i5YQ7kNvwFMcXSe&_nc_oc=Adq_1NIXfQeWzEPRaJaSabzwrzXGjd8d66_BBPG4ctibQklOeMZ4NsXetzqQ-k3Z1gQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRWd3u0UodYn-aJ2xvbfQ2v4xGE7Bq8jc-Dwc9ui0aiw&oe=6A899AFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ-gL5LJjDgQ7kNvwF5_2hb&_nc_oc=Adr3-q8hnHnavvEHTPzuAH8Gp66RxRcck4Yyau2iB4E7I8S70-irIiFthc9KMPZF2Ds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgz7XcCHn2XsOzDb8zANl4rjNrWkKuI5bxxtjbs085DA&oe=6A897824"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4qzGatcWbEQ7kNvwH27h-D&_nc_oc=AdpRxXN_KmWiZFsgrKbepjtfwxiGhecvgGM39FOIUwFaRD6_5-nxk8wl-NX6jA4LV70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM_6WuEcHtE6PfGEdfCm9Qx-9VmWhqOmgnQKiKcXrUXA&oe=6A89777C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVczwzkunMAQ7kNvwHXbSfi&_nc_oc=Adru1QUhqrC-c9i0bcw_TNRKDWYZ9v9qVxTf8rXV1s51pH5v1UM1
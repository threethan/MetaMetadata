.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntcEg39tPQYQ7kNvwFMVwSb&_nc_oc=Ado9LT7KvuSpZtTBcs9icJ_x4H54-qAn4_Rmc45rPVY2CO8Vt8Ao6LRHxQo9ZVQtBPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHlqal7GWB0NmJRox_-id5sIjtJb4yAacnyuv9dmIPWQ&oe=6A6B6181"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJYpjpoxE9oQ7kNvwG_KMXC&_nc_oc=AdpNTrT9JEEF6CGr8Rio6OmaY7y6FbrXsF5sYdM8NlvG4dTRLlnumGp_hjPVsjB-j8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBglcp_AHZwHQ4pZahvGqSFQYw_jI8hC4hw9MgNbs_LaA&oe=6A6B5D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfF_iL9M6IIQ7kNvwEAmRd2&_nc_oc=AdoaM102ImXAvl6ivmtsfpFoHNZvISojvEGuN60YhDYGxYyYlrzE31HzsDvsj5SOzMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnoF8woEG6vrCagJeJzLatdE2C7-54BRNwXQTqonc-5A&oe=6A6B487D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6CSmAM_X_8Q7kNvwFQqnDl&_nc_oc=Ado4j1mnzGigTHxTfUQRNGZ2GixRNWJ4t1zKOk7e0Q_D3LC1fE38i9POYr7kn3mKl4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiJzQmZTrkIOOvPu7EFRWT2zAx_B6GN36xbT0g1X52UQ&oe=6A6B5DE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXnA719FANsQ7kNvwEqU5Tg&_nc_oc=AdoXgVNu8TF8kwr7GK3FzEQgY0eUdhktUELuTRIBO7sFrNmRPCcX2hulp7XF04L4ScM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1FPptMcCUzMahupNkuAsHDDWysD2jxdRYbKFu5Wdvaw&oe=6A6B5D3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sM2YwrY7YIQ7kNvwFQNUIn&_nc_oc=Adp7_gBll5ynElOOcLUWf1GfHtkfCX6DSbadurDonzSEBg-ZrMLv
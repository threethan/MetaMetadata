.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE_1QFTZungQ7kNvwG-KKIS&_nc_oc=AdpgD90N_OoNsR_TRC2yZm7hxWMHLFnQ2xXCNc0hMecy9r-S8nKIrkaMgKYlV69N5ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oF3vug2wmlk-lt4yXFAVDCRxJsIIxRYBFstgIhIrbLw&oe=6A145E81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPbeN-0OGCMQ7kNvwEqVZxz&_nc_oc=AdoEKRMjRIFlQhOrTMSoCYrggAGrg2Jaim5nPVY7MVN-Z9gttr0KMXD754qiStDqMXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zac8g_Gy2tnK95ydm_jnW3iTxHAsiL7NHyowctrBslw&oe=6A145A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc-EbKT7EtsQ7kNvwFjO-7J&_nc_oc=AdoXQcEE585_ihVaWEinG9d0jZz8lrIn8RyhFTBdyYkbn8f3KKMDZGWqPvbg34cd67g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xT76PHES5tpeULMMckwdDNPhtB3l7LUtD9rQLnyPAxg&oe=6A14457D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUlqb6OzWTAQ7kNvwGSb6Ln&_nc_oc=AdqrBt0SJbzGV4HX6FEwgTgyvf-Vsq7pSmlvut_jnD4JGBPSVSfH0brSCighvZ7SZTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NCrrzlb9xalVBusp9bN789AMTRJNrDRqh3LfUx5fEVg&oe=6A145AE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfCK5O9kFIoQ7kNvwHobGe7&_nc_oc=AdrYGncq3sA8p_kyOyZ_TwXwmwB7EUnfGSyKBNkubbj7bvPcnQE2J0e9xput1GGXMh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RNuwhHpsxrQEUnVIAQGRM-Jp2WVpU-iLuWfp3GNWoQQ&oe=6A145A3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JWle5hx9tYQ7kNvwGXS7mt&_nc_oc=AdqPz5kuYpznPnpmxYaL4PrZfQFUxDqGDVBHw-hW-A5Hz8lJ-kEh
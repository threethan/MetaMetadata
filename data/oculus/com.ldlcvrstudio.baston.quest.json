.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qzLIj94QC4Q7kNvwG5h7nq&_nc_oc=AdqtoHCXCglTwBuEtVlhLwcdA5QZcCPoTMDecaIf9Ij5xHPUYijYGlNT5dLTTi72xSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vUseHBJp11--jf39HfxBoVGQAtwIIYUOiBwffwfTgWw&oe=6A203C01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ww4QsA3ngQ7kNvwH3zMzS&_nc_oc=AdroSA271hxpRTUU0ZbpnmJ7y_jU1ECZPYIWPdQVKIJcGLGPM3kyk3Bz2IiVanCup9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sH7RUGnA1QlUdZN7voAMsbtOuMND8SfkmDNV9Ar1H9g&oe=6A203796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvVTMkb0UGwQ7kNvwGFOotQ&_nc_oc=AdraUClnj6SPdoCc745_tIQz27kkNc0ydknOWRC60FSHKQiXdM2FrDcpO0_achVGoNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tMiPV-ENedIx92Okz49lstjWeAL8PdKGZxLcevjE_Ew&oe=6A2022FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXHXUvSa89cQ7kNvwFvQGbg&_nc_oc=AdqAHQT3UmXTKuJ7owIJnLMUmt0FmLv9VgTK4Mth4zbOfxk4Nkec0Y38jNtrmikbgUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49sELjyNFKXFuERVWq9hBo1h_3VHeMPMo-Tsdd31sCLw&oe=6A203864"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLp1bN8wJDcQ7kNvwF6LLOD&_nc_oc=AdoBObSZE7BEwDWdn4RLLkp-UtnXcvz3UE86IHcWEmltjFFKe_eg_ruNS6QaRMt2EmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SFv4968vo9A1TU6MyETkDFvQJ1F0JK5zMhn5rC1jJow&oe=6A2037BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt2FNUutCVIQ7kNvwGe7ew-&_nc_oc=AdrhN9dqlCk1rYgHKx3dkgyxZPljW7covbnFWFowyeXA79GOVzSI
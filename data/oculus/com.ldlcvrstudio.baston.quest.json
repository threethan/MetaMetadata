sin2-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L0qLvxN2wIQ7kNvwHMjNNI&_nc_oc=AdqCn1iel-v5wtDGfeaBW-oPKcmla_odAriN1GWjipXFFX7wV_ca4GS3ezNL2-KPUqg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XLygLv_l0zrugzad5iFyGbop5_eLUR3d0r8KlWN1H_w&oe=6A36A581"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcQ4gKu3sGYQ7kNvwG6b_Nk&_nc_oc=AdrXtkng1tPjZqvLm1fYV5PusSyb34ugXELSwpdtv3-1r6F1EJq9HJ80weJgmqdggqs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VtOKS2ydjcgin4zQ_pCq84Ud1wR5uqi49rcRISHQnTg&oe=6A36A116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeXRNAZyaKUQ7kNvwFy5x-z&_nc_oc=Adqnhvvya614HUjx93MRpxb77x5ceiWr2xE85dR8jzLJ8e2OZQfJMVL29rW_Y5OApd4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M2Y_7k57x89PXDcbViR9TmsNWclFELsEMtvc3AYHumQ&oe=6A36C4BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-Lz6IiebdcQ7kNvwEwHtrm&_nc_oc=AdpWpI0Skwd4qILIc9Jmi51I9dYWnJ_VAMQqdKjwEH4HHYnCM9NdUSDlahehMQj8C80&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MVoO4jlIhjBk9U_w1J60ZfDPNSsadSmHEcDNY_3T99Q&oe=6A36A1E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnAd6UxJXq4Q7kNvwHG49S7&_nc_oc=AdrvGjCEuzlYHG3vjGhhNYDyCPHLBrRzbQ_Q_zw8SNUvzhyXj6z-NCvhqo55i322rk8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OVtGcUYwCiL0lpV-IozfrXA0L4yjj2gxeyZI6SqWPpQ&oe=6A36A13C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfKl_AqaQQQ7kNvwGnwllG&_nc_oc=AdqCuDOQKKHaPuBTW5xfBxX2g1Pfm97pd1mlaCv2vZBPWE
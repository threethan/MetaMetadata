.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2K8LJRsxAYQ7kNvwE6Z3AE&_nc_oc=AdpD2g5B071Rx642bnpIZ-R0l-eTi7ArZGr4WZcptC6JhzfjPwuzGr7KoNKRF8u0bwU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkb6kxkhtHUi7hud-_7U4lUJbtAGnefhL6pLTgEgnuzg&oe=6AD0E501"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePqd2OOgqXsQ7kNvwGwAei2&_nc_oc=AdohPRTv5wOcG-HvMJwUzFChYwo7R87L3ICJw5ZKPw3CzA9gDxh-Ku16AtEVNKBXiSA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtW4Q1kR4aseQ-y8W8h5F1TcmZuUB09nlBc6Gr3enhXQ&oe=6AD0E096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndhmhzv74wIQ7kNvwGHOkE9&_nc_oc=Adpjlnpb6lRj5dYRXs70TUHe5qd87T28eqQ41YB4lGUXH93rwsoLjC1ebaNETH6sHac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw85LQxuGZZuPJZJSvocVyunF7IqC4klWC96ytV6jAcA&oe=6AD1043D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49QTXHgC3NkQ7kNvwFylxCC&_nc_oc=Adr-KbmyrI3A4SaLpiwrLwBCYxLffyYEU0xGjYIED8orXN9GjrAf78XHthZDMwRy8mU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDwtJAEBDfD2WrS8ey8DGJiNPAc99W9e1EFlSEAplVYg&oe=6AD0E164"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfnf9k7tMsYQ7kNvwECpv9f&_nc_oc=Adr7biliErdfKA3FVFb6gBnsytg1-ivDIc0N2V0h7Use-pHpHHK57KgE5t5GU1cTYuo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4OqzupckSzyXG6VSUgak9NCMEzhVd94zISWocQi1Cvw&oe=6AD0E0BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBRtm9w4bZ0Q7kNvwGcCyVH&_nc_oc=Adrzf3k4UjLHOhyciNspEKHTWRjMEQe9XsQFmzMkjcHukwzYIkH3
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntcEg39tPQYQ7kNvwF6_U6I&_nc_oc=Adpzb5WnLrDfv0SHcmzrmJL6nmCJJRjqa_VzXlzZPvCcQVxCxNSaCTcxF2CJVjKBS-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA81uQyeERo1dRsVWD1zpZgK6aPEysKnsX4BY99sjv40g&oe=6A6A1001"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BITLqncjYWQQ7kNvwEEWV5e&_nc_oc=AdrlJH_tOm69NjqnmwRbpVgToiRTxK7gdeDDk_YtwLRcE402Bw8RwqfbNIQCC-xlEUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQf-LjYqsgqg2MCVxA2DbHnpjhsqJ6eY82OB-OEQjgaA&oe=6A6A0B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=retdq_lWaIoQ7kNvwGGe7S3&_nc_oc=AdprgX480iBhmOOTnrJawiDK1XENJK50FjxJXDJMcMmWbGta2DFNdt_ns_LUpyJXYh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMWhFwl-gtGsuP0iUjw7jOETu2bNDQDSWohT5kMjK6uQ&oe=6A69F6FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6CSmAM_X_8Q7kNvwGUQ_bf&_nc_oc=Adpndyh2U074k5zloP-2gk-AXThyU41QMFIEj30b7hamVCiiw6NSrs15bMDYDspwp08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZBH8KmR2MSEElddG9JcV2c4Y8QwGAxmVWzJnmK63vDQ&oe=6A6A0C64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXnA719FANsQ7kNvwEyGUbI&_nc_oc=Ado8wOTKp_8TphDEeVMuI05eu7p-KgTFLVmznssu1-doEFMStCQ-HTc_HY0dquPcs7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS3oy-c3QLtGnrwxW4pPZpNQHMalFDAyGNiFoMkXxdOw&oe=6A6A0BBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sM2YwrY7YIQ7kNvwFrgo9z&_nc_oc=AdqcPmqu3pcPdb99swmjm0nwCNixAO6T0fFGpm1Z8dN7UHjnMzj0
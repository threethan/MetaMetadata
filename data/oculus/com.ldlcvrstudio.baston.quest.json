26"}, {"file_name": "05 copie - Copie.png", "id": "1453983449551219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1453983452884552_1798539668773253697_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnZ7Pz7zM8IQ7kNvwFP1Yav&_nc_oc=AdoVThDz5AXHkKQ-2EwmGY0FXJ9cGHL1olN-QEkVPhE9lx2Bx0B7cLqFa1FCkgQC4Bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2gJxwEpLbQ-Wmdy90YO05hMiIQoQcBXRwAU0Jq3rRTw&oe=6AFF0659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "941364848503484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_941364851836817_4253794432826244431_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxW6q6t9IekQ7kNvwF_22Jl&_nc_oc=AdqrAuzgSUbCy-ZcO4ropLCpojQj_2CYlDaBztNlVhQrH1rwGAHscF5Xf3bMWCVugOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTboOrDElCLLHO_7epUc32KP1G1eWWcCaGmrUe-xjOkCA&oe=6AFF037F"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\n{1678717459821345}\n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\n{2046261419573723}\n\n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. \n\n\n{1314549333936828}", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, avec les voix de Franck Pitiot, Davy Mourier & Brigitte Lecordier.\nColle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !"}]}, "developer_name": "VR STUDIO LDLC", "developer_privacy_policy_url": "https://www.ldlc-vrstudio.com/pivacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VR STUDIO LDLC", "support_website_url": "https://discord.gg/TNazD5geRU", "website_url": "https://www.tavrns-takedown.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "ja", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26558886920462229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1831775427502413_7943365838221871493_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53ReCE6kDyYQ7kNvwE0CxW_&_nc_oc=Adq90yldRxQ6pB1boOAzLMhLw983VZ6duM8Vi-8Kzx1ZdsoX9ajKuyjCBycbtE54CI0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc6Y8Se62HrRLn8CT5UhvU2alC-Ht7rl5A7pd2G83
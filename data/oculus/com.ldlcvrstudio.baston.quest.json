.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkcSjmRgTFkQ7kNvwGOAjOd&_nc_oc=AdpHbvzBqsvBQH_JH9xlZKhhnXpcncjQRKfeAFmwSstVWNj34r8sr5ZB-gwzbVx7_SQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IxuLnqy1XXmDixai4N-4A5qhsfCJmQcLmGZCjn0F6UA&oe=6A185301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_POViGGldgQ7kNvwFyLTZx&_nc_oc=AdqDFkFLT0zY3pYRnfZ3djMPdz_nnGjXkzBIFjAYPkqeyqFt6lVoCUUIQt9SGMOm5AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nlsr2VMOXNli9ZudZvDmCP8tMw9UQfcgrgvpSFPmXFQ&oe=6A184E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8kHCBmOD_IQ7kNvwFaOp3P&_nc_oc=AdoevEeVUDMPoLfl9iDOtii_w_7nPjvR_RWTKMOnKG8gMsHeMptmkVsZb5qr8rmg4KM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZfCOzipz8Nk0dyuVoOCjEdSneknuVQmLx_iVaJ_JqLA&oe=6A1839FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgyhXvLN3XEQ7kNvwFGCxhI&_nc_oc=AdpWxJu9evJaYWVYVpEWGZ7pAstApql8Zhlr2IIerHauMNYBLus8wYD0cd7WIFY1DqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RDC7cFXJt_eXBqP2kIDwqIXhh3oh_yAiLKzbRGanO9w&oe=6A184F64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsgytExY_80Q7kNvwEWKWGc&_nc_oc=Adrsb2bPhjtK-qUcmzAgF7OviYBran6zLeJrsy1t5qq83msCr7W_8vvOhgTIB6O2nQM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7haHBND7SpZhD06fwQX8y9xscmFc6dzlpmur7DKBa6Lw&oe=6A184EBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDQvRifU3lQQ7kNvwFrP3wN&_nc_oc=Adr-HHI_uqwQ3pk-fgDizpgQ1Ycv3HbDvH5dR3QnbebGwYvs20BI
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VPG_6WvyAQ7kNvwHqYMHG&_nc_oc=AdrbIPBEk8RXUhjZNinz_3LVKCGKRfY7hiPQMwQd3mvwMRPl_CotxFsLZiqnyX_ZXSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q5Ka2BMfx5Rl65zFB9Xq439YT7hqhNFpe1s2DIxvlWA&oe=6A0B2401"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhXQJkpIu68Q7kNvwGCSEop&_nc_oc=AdpdOdNAwTHYcPgzUhIObI_8c-P-P9BQOGpF9nKwh6YdCbeOl-S1YUZOgzwlPVZuK7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6622H2gFymVQZ5PIwlMUuO1ke5hABBzrZVcyyedcpwGg&oe=6A0B1F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEWBJZBaUlYQ7kNvwFRzQHk&_nc_oc=AdrDakzlKpmcVeDyvrD45lAu493oRuAf79qxZBPslgVKfBXpmmtYMAlDt2y6NUd7HX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k5xm2mZTKQamkAfwZpdnuEZ-wJt4M65Usy6YymoeqUQ&oe=6A0B0AFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRZ8TDHUNqgQ7kNvwFVHGAs&_nc_oc=AdqGoLnTbXEREoufHGFZvMOrsd55jqHovleUMiqI77nN0HTSCj9lJrpgWLVvvHEU1yM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gtPygURmVJJwDQlvR5oOqvooYtSpEDWROa7sYixIb9Q&oe=6A0B2064"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7utswaKgGwQ7kNvwGADhac&_nc_oc=AdopBKxkeyMqJb2bnJ4wIOVwd-zNN_5EoumhSOiOzH_7K6yZS1PmHsOhfT0UphenbiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sf9THb35glhXWSLcCNObAJMiHY4irDybKoAQVV-lMcA&oe=6A0B1FBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL9l01MiN2IQ7kNvwGwc0I-&_nc_oc=Adqy4MMK9B2JHIPxx_h3P183RhY3Xju1JVjTW5QSxBg1GKobDWCe
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AykTLusYW6QQ7kNvwFic9UI&_nc_oc=AdpG8SPCheH-7FcuVU5KlZZPoIDrZm7two_vDFFYDG3TK49dkvKFiyEahIGa6H5jiXM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AReQfu1EpzeaZDUR_KEi_oPwM9pAw8A_XM1jRQoVKSw&oe=6A26D381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fArzU93ETRsQ7kNvwEkLE3u&_nc_oc=AdqUmRzM6Z4eqll7Tor7oxjDuQCLcK2ph5oXLDSNpjVGrNuRHuJf78l2rl7iLpaV0cg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Ywdalu4h1RXPbqRWDql27Bq9wCl03ALL6JcfkiHnrQ&oe=6A26CF16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRe7_jG4AUIQ7kNvwHWcDCS&_nc_oc=Adr2yN3ITAvbQYDr8e7RGgtR6V57r-7lFpADlTaWUHIzmvJ9X0Qo8lcYiK8TXGyPr_o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LJAbnOAB5hB00z-3a1tgJMFLdqfJAPX9w8hNheUSfgw&oe=6A26BA7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S35VlA3c3kQ7kNvwEYsFPC&_nc_oc=AdrinkcyXTNrShiGJFGDHIslgG_4aZVKnRimVD_iHeT6CD701poxJ4xUq2WenZPO3uM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZXZlKq7PnWydIJLuKOdYAEnsHGwjNjGHpB9U98wXUSw&oe=6A26CFE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goq4nDjWb4sQ7kNvwH98nLo&_nc_oc=Adrwe5fXlgQ5yrNgWCESVG0ZiYpEisOHGjzXpE24a0o3cZR-2ot7K9ndMKTbB5RIYvY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h7bU5GlIu_yGBFuRWDX7dNbjN_AReLpfNNa_4JRsByA&oe=6A26CF3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWepuNHVFwQQ7kNvwFdCRkE&_nc_oc=Ado71EtiioghTNg_glPrwDTvGwRU08pH9RamSGMltKkQ6YzoIqto
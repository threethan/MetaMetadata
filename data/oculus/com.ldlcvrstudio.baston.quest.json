.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkvJROs0jisQ7kNvwF-doeH&_nc_oc=Adocsas-WN9u19Rd3GrEzpK57iAOMTqPL2Bf1I23JxN7aoGBkzOUKKp-KjCfbDcEJGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKz7HDNjoQws4nD0LRHEQUcKXIi8rKOUlH_A6OliBBFQ&oe=6AEDE601"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqxcBAL5lNEQ7kNvwFSxqP8&_nc_oc=Adp8NYugxeaWCaNXtFuIXLkczH9Q2hnsXqLyeDHrWHmI8ibTRosIB8uWOUgOlfj2SVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN4W1Jfmx35l-MGvEjE1ypcqj9c2c1LuHUYRvqytPZvg&oe=6AEDE196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xydWS3DxPmsQ7kNvwHbWx44&_nc_oc=Adp5cbBkhRzKiVExhZqYLFhahpfBH1gc4LcZd3Ig6Y4uGBURkYnK5nk2_G9W6AbGMLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKVXDSTgawfksTmjiQZs0Fw0ir1cnyKc1RNg-rYuCfGw&oe=6AEE053D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cEAiR511p4Q7kNvwFFMh5G&_nc_oc=AdpKZn07swqrY9ZnjtEAEWIf4tNjFCY40e2HOfdPNtV5PQIIeWUIcxmKk8bzigzSfK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSKzqgPkHO2RUNXIemh0wvjmMBgHZYx68pEUaDh3A10g&oe=6AEDE264"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auZ4HN3Bn9oQ7kNvwHIA47s&_nc_oc=AdpQj4teCZjbLoLgtc4Z7D6QL_Jkk7nKEHhp9M8X7tepgyHQ7d68pCRta6boHtMCfn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjCgSd8dei9OMutStKy9B8HVrySdha1VQop6kue8KrDw&oe=6AEDE1BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dOuqujF7YoQ7kNvwEhPF-U&_nc_oc=AdpxxbpTq4crvJh-OqVTJYz3fc8U8OYvgbVjSzyMdPNePUPHS1_U
t-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_822137817339573_7229760179140916545_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtElu82t1aMQ7kNvwEXmXCU&_nc_oc=AdqKNvx5gO8t3VUZjhn6SxdGU9K9FTGsbLO3mcNWxuizSunDvu2CPdIcx1g3jRmfEMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVLufAvkQu-1KztLQ3t-BtfSTfeyvMMBpDMQZRJkwk2w&oe=69CD1D8F"}, {"file_name": "Screenshot_25.png", "id": "722112044246292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGnm2uv_6AwQ7kNvwE0An3M&_nc_oc=Ado2fZiALLOWz6NqdVvjOLwEo6nA8LW6VnNZvjI7Km2AWQvRyZcMLV8FBpTIiR_rUbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyabPMpNBCUpBXVxTxo1plmhZOah2H7AIO6stQElqha0w&oe=69CCFB3A"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqggSDlJ_pwQ7kNvwGUTI9N&_nc_oc=AdqkV_82cefXKmFYnW3pnXsl2tIJXffmt3qtN7uOTJnxbygrfD8v5XluYSW_rBDiGSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztezbkLBcCl9QogDYBWd33VuCWtwuKctW03oSPP_Zm4g&oe=69CD17AA"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Y9e36P1FdR8Q7kNvwFdc5V-&_nc_oc=Adqne51x6UfoEE7Y1RAyFPRGYV01mEcroJnwM_IF6oPm3ab-oMFmUYFexSuDpW371jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj7SYYwrVVo5n81l3dnXjISvpf8xnH8I_6S5TpzazmRQ&oe=69CCFF02"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evm94WN6PJYQ7kNvwFq6nFW&_nc_oc=AdpyXd33Pva14wr4QymV0JLmnzK1dqkZMQDQrMehs2sZId6YBVomaErx8yLBs0J---s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU4Ia6oWnBY8_FF2TWaZc-kp5wSIRcuWLPQD370U49MQ&oe=69CD2B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEjjQqcIeyIQ7kNvwEcfXKU&_nc_oc=AdrchGQwhI13q--e_YI01hNtJvshYTwIKnzZoCBH2_bdyuHLhifu-1R-BS0uYCYjDY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlOyiYvUHlnwTc_9GNfH0QMOB0hw4VMsXb2Z_ylD5VlQ&oe=69CD1325"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "318330666520
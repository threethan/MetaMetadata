.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quOvU14itPsQ7kNvwEbHaCe&_nc_oc=AdrttIc_5IK6lTjbl85b8n_WuWGU85Kjp1FqviEmLoTrS2fjwSgACD7viAtk8_aR5dQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CHIHPy21IZGZnX9M8oXuh1YT7NEGP49_VKGR0UmUgrA&oe=6A47C901"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5TodBR_zsMQ7kNvwEWfJuQ&_nc_oc=Adocb8aropWbwxk7kCDeso7PfqQ8VWxeBOSfZyeYxuTRtWaVlOypJY9rO09CcihVI9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QVlTXWnyX8myC2CHxJvPRLa_y4zCJw-y1cevkuhXpbw&oe=6A47C496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbl6QQk6XvUQ7kNvwF2OvCB&_nc_oc=AdolQpEbWOzCHHyhvxJs5pivVf-u3FqEheVGDmmPxXKPQQZOY8lT6_ea6_o1sy6qCM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SUibfVpoesLkHwO8BmY08y5mNV72wGgcVZ1YUZcPkMA&oe=6A47AFFD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga9C3QH28kMQ7kNvwE2lIuq&_nc_oc=AdryzzWyPlOjIm6rCDnLvAvQdvYsmiXmb0M50LFYc-_ZiYh2ZumXeMHmm5GSof_dWfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OtHC1r3sSwuOWMZu1AdUW4TDKNpaIh9LdHVFMhZEhcw&oe=6A47C564"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UryYsCvZvIQ7kNvwGTaSkt&_nc_oc=AdooYpr6OjJwWFIxIP_P76BOdfL3mkj2fA9CTtCGsVDo0X4zBsVCFUxovvI5ST3CVSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B9v3zvpZMHNZm10COz5C9t229i9dmLW3IcTjx364iPw&oe=6A47C4BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs1AbcPuxTAQ7kNvwE0J6Fb&_nc_oc=Adr_Jzp6M1oDZbCjUpgaTg8XaszcVE9R-kEC5IN3HbGvSz7Scqh6
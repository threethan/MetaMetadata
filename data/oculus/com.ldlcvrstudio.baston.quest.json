.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAVhCh0EQSQQ7kNvwGvDSd8&_nc_oc=AdqUAI-Q0Es6Qwj6G8wm-GIn1PlEGCf7BUbsKbAOfRRVmyQgXIP2GR-Z7ZQxIKqBfUQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqTY8O1MoyarWoisrJTThNslzm4jpTZEeeDSGoCAejfA&oe=6A68BE81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BITLqncjYWQQ7kNvwHaobJn&_nc_oc=Adp38-FZbdfzvDcx-7C0s7C78KDWFWuFRnMpjX3Hc80jPeJgitWldKK_carIWoN1cSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNILS-NQJBZ6Hqe-OScqubQRExlVnH0vZaTs4e2CgYFg&oe=6A68BA16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=retdq_lWaIoQ7kNvwHo6jwC&_nc_oc=AdrvGD6OvKfzmE3bXxjpoxMTtTF15I0m1ADP5LijxgCikSV2JvZvexE_7YEgERbipD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0sGesTEdxw_8yrJtgsuf3aGCL4UZupngIad_ywAaLYw&oe=6A68A57D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6CSmAM_X_8Q7kNvwETN1d0&_nc_oc=AdqiJc5PCeHIQP_SKaoTfYFyuj5G7coqJc8xnDCigXwdl5ODcIXLSv_vSFubyzwmRgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn8fu-fIcpEWfHwoFOh68NTH6KA_MbLxiB7drmhFxEWg&oe=6A68BAE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXnA719FANsQ7kNvwGNKR7e&_nc_oc=AdpfDyDXSHb7PJy5L0WqHLGLbXIZQY5ej6boTuE0bHCu18g9DW9juvxfzMR-YeOpBYA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSE-uLKDp5q3iAIoeuTGQ5_Drnqu2p-F9MJCFaG0uYYg&oe=6A68BA3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sM2YwrY7YIQ7kNvwFRFEP_&_nc_oc=AdrK6GK7EPd8dk65DPfEnSrsFEHhK9zSsCmChOTi6i0YZAvwFh79
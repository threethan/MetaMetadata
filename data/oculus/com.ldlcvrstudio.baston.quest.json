388_6932010296335491220_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9NjwSh-z84Q7kNvwH-ANrk&_nc_oc=Adowqp_qMYk_SO9fbiI-bBRQphNkv9_u3YQZ_2vkD6wAkoja2p3A3Byle9dGQMp6Dls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHRRkn41hfbk5P3Qnp___EGjucq8yPtcIPH7p2RU5gBg&oe=6B0485B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezHorxrrdCkQ7kNvwHpRBsj&_nc_oc=Adq-4T4wIqq7HoHvb9BTo6kgBRqMuisNpscxORWT3eWfDnkMPJhNT6RdFz7Tx3JvZXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSzMVejtqgDt_rWedrHSOURhY6g6tf3rhYEEN8ueZ8wQ&oe=6B046D65"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws2NNVF7xF4Q7kNvwHarN9j&_nc_oc=Adr6vRwldxk1DF7eqsNqtlavmwxdxHTBrqSFH3utfUZZZKzxM7amBqJPNgQqFDKH9EE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZrIQ-ojia9gHL94U-W5LOX-XvPu-dG1baZzhwxfOTuw&oe=6B046AC5"}, {"file_name": "CoverImageSafeAreaTemplateSquare copie.png", "id": "1880433679219419", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1880433682552752_1980421045084427771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7wojhFR_TwQ7kNvwEmJhzO&_nc_oc=Adqf5WiCrH0Om-d3aZP5pik3uCMfeEGqvjuztZKIu1eowb-2RUWrw0DFCnnYQY6ypGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqi2LOa1lipZqxcRg3NN5VQ8A9fQe03LiOYHD5rVe_wg&oe=6B04598E"}, {"file_name": "NHBK_Logo_H1440.png", "id": "1660891154542652", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819944_1660891157875985_4872676651041472123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USz-34lAdiUQ7kNvwHCZXr6&_nc_oc=Adr1iwy8SwVIkDudJcqUm_M7-w_EoJBul3P6h-YOMeYCw0R82yHUW_39A1O6kXXj-tE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3VMPGo-5nazZltW7L1GezsHnX9TeoahaepiCCzP_EsQ&oe=6B046A9C"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1417701233407141", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1417701236740474_8916931527861982871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-
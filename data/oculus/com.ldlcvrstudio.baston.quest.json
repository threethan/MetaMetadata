.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r11EgINyujkQ7kNvwHbsN4p&_nc_oc=AdqJ5VDBo0Niph-x1TfL7aO4Di88nKjZcgP-PRkehI4_FUphVebKqxj-seNfgOoFNyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1FYz37Nr4Y9c1QtcNKhbQ5TOEAvUJ-IrdKu5TKXBGPQ&oe=6ABE7001"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8Ht-ECDVaAQ7kNvwGigmID&_nc_oc=AdoQ3bZEugHfyT43Hl87HZ2N56uw4L6dZ_MqObDWyNgTZY3YRvMtNdhWYl95LXHcgTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDUizbm6xG_bteD_adfblPPLfKXHYguSnqmwuesTXg2g&oe=6ABE6B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaBQlMST7zgQ7kNvwGHR2XD&_nc_oc=Ado-_vMwO5VUN2W2wn0pzSE06PvfIPumapok-wTjP0YHf4iouWe6H4E0mhgEYxKwVXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo3aUqLuJnn6eB6kXWIsHFCu65Rd9gUVFAE1OWn-Q2vw&oe=6ABE56FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oba5jc2tOYUQ7kNvwGT7_Ut&_nc_oc=AdqItg8lt-KP21IOhU3ZvRoNhNV3t22Ym9NjY9D4NSV85S70kC4Ehd3srk0X0Emtnkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnKn1zn-yt5lc9uN2HZ_tFCdT93o71bn1JZn4U0d6FFQ&oe=6ABE6C64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xnt1rRoeXfcQ7kNvwGzFcX1&_nc_oc=AdpZxN5nbvHFQNNBUccTSbBLYjniptBMBbpelkZnqNa57wHD9RobcKAgCLhDA6bKgh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiHG8Q4Xl9chUKa5ckH9CphLfHOz-fGrPomC5rG-hWwg&oe=6ABE6BBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km3zbeVcd20Q7kNvwFIT2oW&_nc_oc=AdqhdzKCHGtAeuTAGTo7G1zKWsieJs39lbSfnJ-k4rpUPhTlHZe0
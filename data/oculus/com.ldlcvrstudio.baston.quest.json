12044246292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lyBbrCvAQUQ7kNvwEZyFvk&_nc_oc=AdoOgk7pfDJLOtR4v4Wq8ffnnrUVbQ3dWQbFflDNwuzNJxkbrGSkVA1yoK7mlgO3wt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tJHstt3ai0Pcee85kw6tJ9pmJI58LDexvYeNgNLH6Jw&oe=69E0F9FA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DnA9jPzKggQ7kNvwEKhVQU&_nc_oc=Adog5DAxjv2ZAgv6tcNwks6t3DiQjaNxsxKIEYd5TET4VF9VxbwPIxCDWrTje1_Jvuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a2ehWHIDp4K85EmN1UsTMxaRPaU-vgsIfzwVswiJw6g&oe=69E0DE2A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=FzTyZd8x50QQ7kNvwGbyytc&_nc_oc=AdqMniapSU_L19rcEBkTMaX7dwWmYQ7W2LaorsUZd7cSYBzFNbTry1VW5G9ZPxag-pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HYGpV2F4ctDS6lHJzvDc7J7SEWW6_1pnEW8rmd_rGww&oe=69E0FDC2"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBWQwv_UnvkQ7kNvwG4rLnM&_nc_oc=AdpwYKMUzBHsDQGv4g-3_WxSWc5lE7kMnT-T_WhU77Di5Sdnt-MDxy2nntsLvSS8w-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DuIJWejdoEcS51S1mVauCUJdMEQeSOnAb5Ry9ZnKNFw&oe=69E0F1F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxdoZ_v5AeoQ7kNvwHHjzD9&_nc_oc=AdqDtPb9RaWBlGCw6YsH1kUd2uTqNYsngOqaLBo-S6RzEWqZkfZFGe9y0YW2nvlnuzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xCCAqAhNO_F1iHc-8RDBtZdePUhlNSbCyYlV00xaRbQ&oe=69E0D9A5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KKF-9ibwkUQ7kNvwHApMy0&_nc_oc=Adrqk5Hz77ZVBQPOVUQkufta4GwmplAnUkJeA1QwSXPhwiM1D6a057wiLsLoiOHDpls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cGPlDBLslbxrOSbNwDQMeynzXO454H_Ow1
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1tpCMWHXa8Q7kNvwGtD0dI&_nc_oc=Ado6FcOuw1-v4LLXjuV1g9shwX3a70QGBkTkh7FZxk1P4P4gfc3G7B0gkD3Qrw0qraU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLzSbgp9KBbNbDyWBI2xrXihQ_vHnpjE7Zw7uqJYIJKg&oe=6ACE4201"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePqd2OOgqXsQ7kNvwFRP34Q&_nc_oc=Adom3hWBKikiNfpZBGYvEr7B9Pr5RQ5_DEZKwQXrHa25xiaecPF-tFfmgjoCQeoJF4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUzJHkmemvw94AmlzI5dW40H-j3LdCKzOpw3kU7SRoeQ&oe=6ACE3D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndhmhzv74wIQ7kNvwGlEINN&_nc_oc=AdpN90FBYn1_-6QYY3yVDvlSB3pjXfFNRNyE1nZUHbBWG2QJnL0oLFf8ZizVVIrAhX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTHc59EarrX1U3tA5NwgtOeXDl_drhtTnfWcfYrLehyA&oe=6ACE613D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfz1VijTaCYQ7kNvwHL50oI&_nc_oc=Ado_tfJw98bwfLZe5lRsM7ytHQN4aJyNWw733uuHG53e9fY6i8a6A4GeshwDYMj2z00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEdmNNoFOB_z-k9De8452OyaTpBe_GqqYcYiIIHf9g0A&oe=6ACE3E64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-WOukNMbsQ7kNvwH143Zi&_nc_oc=AdpKC9fOzkJr4s0AcmYqtzXSm6-oEutLH9Qb4wr1KFq3eVT7vFyTlZnGeCv6HFpD-us&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_lhSkfZCCK8br5GtQfoUS3vddNx8DkXY8_tFDgou_8Q&oe=6ACE3DBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDrCORVITcwQ7kNvwE2wGp3&_nc_oc=AdomcJH_SQplDcTqHCou9Ox9ufwKzTrmUU0-jhk5IgaQCciV3kmB
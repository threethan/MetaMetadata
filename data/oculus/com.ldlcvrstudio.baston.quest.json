.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItJN43CZJ0sQ7kNvwH9aVNA&_nc_oc=AdrXyn2WdLtdG3BsP7PgqFhJN4uDzMVGRxQnlfzmD35qCuYjV4WTSFZ_o3KJsNL3DV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-cHOKuyUISJI2d_-Kv2rkrSytr2OsYEN_OAS7Wka-Kw&oe=6AB29281"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehiqn6APliQQ7kNvwHcVVmd&_nc_oc=AdqZbFuBWpbkeF4ZzyLaSRJc7Go09kkmXfP_uVNEOmCqONw-IZJN3L0mxnL3Nw8UVHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6VYHuAklvjtB06Azd8Z7hMu0PYr5fGD47BzeYxk2rQA&oe=6AB28E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOj_phqxBBgQ7kNvwHOFR8N&_nc_oc=AdpTMwTtMHyn0xqGOHdt0i69FtZ6VSgLIptkx9bNi2bRHhLdL9XfcRqmqNNgkXYT9Eo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwp9BzVMlS5ipH8Bt1VQsB-_yX9HVwbb6_I-DJEOkGdg&oe=6AB2797D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3V-JgJVXwQQ7kNvwH7ppJL&_nc_oc=Adqb4zhtyAueHvSmHMso_zW2nWhGsSyuTrNH8eV1Ws3Q7xm2GvF4qGZvirvWvKpe90w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdxsptaeOXegdtVmQLnzpwVSLByJrTlhh7rwS8kitNMg&oe=6AB28EE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTiR5oxm5s4Q7kNvwFq0h9j&_nc_oc=Adp4191RP3eY9xRY3rnrB8gvK9x6z6_oS0Z4RKUEW3keuZ3zh7us5CnAhr9JmSNIytc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJc_MyH8dQupOak4FTsLnMFY83KzDonNXg0qy5oO7x8A&oe=6AB28E3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouFrOPQleAYQ7kNvwGvO0rx&_nc_oc=AdqdtypuA-Aw6TsVYmq37Pz4OyePsIg42xVEjHM3aftf0kVA0UMn
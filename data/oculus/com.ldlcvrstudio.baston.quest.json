.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRDCidsPWTwQ7kNvwHZ9Whq&_nc_oc=AdoQqXKCRb2pgJlb2BDGI2hT2RPYCurgrfaoixBbNnxril7UOlyaFeNXCR-K7XxElUk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_xA6nztcvGZdnmJcTTkC4t8BneaC7PsRh8N9pLMcb8A&oe=6A8192C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuvLX_IGesYQ7kNvwH06s9z&_nc_oc=Adoi1vYTUNaSWy2o1q-9GUPXn6GkqYEhkNBtmtdIsA_SQNUaBAbdFZ0m6p_k22XrXaE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEBgLUIT1ApDO6oxDdaLrYzoQyrJJ6THXPqnJ757X9yA&oe=6A81C696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Y2iwio0UQQ7kNvwH7fitk&_nc_oc=AdoFaZxex1JeIZ_YYwzGiHErcQTTlBciEhXLrnimSXFOz0GfXfXOaSBJyDRuxDhrN74&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7dpTg3uP_hG5jsbeeAuWVzTy2G1c4LFNOieA5JJUQBg&oe=6A81B1FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVYV_aKDaRkQ7kNvwEA7iqg&_nc_oc=AdpmG_76mKlFTDd6JnS09UTxgR5wpWJ7whjCrMncSUi_ztUmm5G0YDIE-AOzzxvTxD4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaW-Kc_IBm3Tz77emCSfvyB9FONY6LzmKDa9ZVd4juag&oe=6A81C764"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQuxMs0AYbkQ7kNvwE8J0Ps&_nc_oc=AdqnSA9M1TfhtXVAgCL9q1pfUS8cMHYvbK9HObg3G0lJtobSyGbInwUQNq3D7Ib1B6c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJFLU1KOk-y3zl0HQZxptsGBN_sigpaYGwHsQVpOSuuA&oe=6A81C6BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOT7SpRbQAAQ7kNvwFlmPct&_nc_oc=AdopWzhPwb0NlT5CoHR5FHE52DHKfqolf2RVyzKD0vVlAspPm3m0
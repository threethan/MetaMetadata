.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf_ZuBPZT1cQ7kNvwGvYhQf&_nc_oc=Adq4Mq6v_K-rkfuS17T36p5sDxWJDjcPk3fi1Z-cDsgqddvLRiISabf-FrwDPF8uQPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgLlUaGrlcdR_EfPc5GOHq21LMl-VYv-AWtz5RoPxmPg&oe=6A789081"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrbNUErQhoQ7kNvwERFI_X&_nc_oc=Adq3S4A1MUnzbjctsgZYT8bIXEjIjnLapfFJ7u4DOzDi7WxEYxuLl-lbBZ2V9qhAMnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpRhO9myCjnQfk4A5LB49tUzWPBKwHuIksS8bYaCv1lw&oe=6A788C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymQcWsgLRowQ7kNvwGoGtNJ&_nc_oc=AdoTiBiZMrPHQ7BIE2AGPqaw6l9LKbP_olghv2v8F24izuWEkunPpG2r2zD4f82bARE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdhD_OOrsfzcX7JGzCS2rC40Rt02IQlIkI2Ey5h07QBA&oe=6A78777D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPOL_c12giUQ7kNvwE5T_AL&_nc_oc=AdoC8AJvGx2cJE1HpYOjQvTxDBDj0iQlf-GwdXvp6Yb56k__zS1HRbD6XnXz59-9kMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuLvon69PTxgh7SPGKYSujh-nvHoNfVKzjPuT4HaWyvQ&oe=6A788CE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7qBtxDCMdcQ7kNvwETVQYw&_nc_oc=AdopkoWA-Pp1mGpLarJwkuIm4EollwRmJ-uB4ordBr_iNXwqQZw8vhxHYf5Igp-Ul74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbquUno7vs9fKfJv5G9VMzGmS1EBgp4Ulpm2RMDuYlVA&oe=6A788C3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSvQAzUTJmUQ7kNvwHtiKHz&_nc_oc=Adp7MFCIcP8PK2SG2jQbq-jq9Sby9ADu3jLUX0d24CO87IgUTuRh
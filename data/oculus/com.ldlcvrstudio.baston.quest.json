.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V4FHTqYDe0Q7kNvwGzrEPb&_nc_oc=AdrBFUCt79U0TZ8ONouxJjIE2pF5oyijQ4AmXAUT3kA0hbVB0lqinBZOfac45vmDL_4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5pkVVd1hpHAoJhcWMq-g3wofUFL26wDEWQ_ayWs8LyA&oe=6AA16F01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHjuSrm-x_sQ7kNvwGqougC&_nc_oc=AdqT79cYP_Xn-42x_gEHo9aQuNAidycXLnQ1sL4W_SLGE7h1spgnuzU_TMg5JZP9jaM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaAjyfVdWRsOZpcXtsEGXUJe3q-RKZimzezI50hX38Rw&oe=6AA16A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcjOPmEvrFYQ7kNvwF0eoLb&_nc_oc=AdpX_-kK52qd6r4WupWmbGEVHNJZs68N5ky6FbtND3CtkPOw8dNoS9CHHi2iDSFCFxc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTLB3vR9O43NdOuoOyDYHVFBAUL5GhFUwtTSx0KxxwwA&oe=6AA155FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmQmbzYKnaAQ7kNvwH7JP4J&_nc_oc=AdrN4C3XxjFB0HNT0hdH3B_doVb6riZoBEnlJCpcDSpPH0ZYdzG-pVzoW7pGEZzSads&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiHoOiOp6vXorFWrMoTdxuOLDZOEnqz_AVRsGrtIWkww&oe=6AA16B64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHdNcOjKlMYQ7kNvwH6v22P&_nc_oc=Adr_9v2G0KU_HWu_PxnD0KAj1n8JyXsi4CotP9e1oROfQ3m-lYYhkH0yA1tqInoau20&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-eYxlOyEAzH0rdJnofBy2MpL-BkZXJ6oSUSC_mECtQw&oe=6AA16ABC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZzj5zVLSnoQ7kNvwEFgunN&_nc_oc=AdryCfUquZIyVNUPLi2TACC6A9_QalWfZYLDnALmpEBZBKMOob96
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvuWqL9iUcQ7kNvwFePMAP&_nc_oc=AdoPPy_SztcOCBOKvwjDT65iEfWAO8ulvrah5RPfbFzIN_YF5cUQAGS86qwEiUxoTW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4SwJ91HnjK7OgoGIovmcX4_EOQ4ckvN_UL14CPADeHA&oe=6AC7AA81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XODl2IpRGAEQ7kNvwHG2Kkl&_nc_oc=AdrSIWSW3ARHHM9QUFy1SV1jI0znXwdCaChbOmOnJ8yOIHaey_PEfxsmvT7QddG-eGs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh1FaRkhO6OizC7yGVEYhyxNq4aVJUHETJVHTjNq5uMQ&oe=6AC7A616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEvn2RPGTrwQ7kNvwFOQxt8&_nc_oc=AdryN1uAnJp0es1m-oWYt9E6Tyqv9ksVmq1OLKet2cLKEYhREGZ3dm1lioxbUVoWbYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkH0EN5hpmxzKRjqT6MZyFw69mFfFqs2uj_FdFzCRIhg&oe=6AC7C9BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJa-JnnIZjIQ7kNvwF0W6Bt&_nc_oc=AdrmMnOKAkbmPZRNFA2nHWX2MtOWDX1lnHppCli9myBRbGH0o_OE3yoIjqRTjejfaiU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8uw9kZKc7wPrGOPM4BzK6tS34P9Tu9S4TgMAq29PdBA&oe=6AC7A6E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dko-7mQ80f4Q7kNvwGe4jHx&_nc_oc=AdrCEkuaFN7HUGxayTXIZet59owan6semXfqjk-c74jAJgbNmCCxIuGy3X90nd_zBH8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV3Ug5d4liP58P53QpAF8NaOr-CpehRKCZZyEj7Oh7cw&oe=6AC7A63C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCq2g_-4zHYQ7kNvwFaNXOB&_nc_oc=AdptamZMZp2pSaNdqDbBf0SL7PGQuiRLQCHxaf-njXdiMMLlwMAm
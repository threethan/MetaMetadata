.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRWdnYijDNoQ7kNvwGfJ4Gx&_nc_oc=AdpMZ0VUBlGYBxAUC_iK4vTVZTy0fRkjCsxSFCEyilqCNb7dumELctV52orzaYJ8q1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D2ShEJF_0Y3NYUUhMoDR7T5JNUZ2pWARIvAMGENsxhQ&oe=69EE2301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I92y3qbbuGcQ7kNvwGnRvyI&_nc_oc=AdoY8nVXzhHXtoeCaCosqCMPBfO7ffgBrxONQc4P741niWIW_CMLxYL_zx5E3UWHrAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rm--Zs3b2oWaaopjibu9tH9Pypc7jWzWzzoKAxtNNBw&oe=69EE1E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_J5vx9-HRwQ7kNvwEiD4j5&_nc_oc=AdrKyIRP1gCc2mq_8eYY-sENdNY5RnGinrQS2-XC5EC1IOYr8NXT9VNHT6hNtgV04nE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HwmEodD9d-OaKBah7J6zUsQbNwsPaIAQdIMIF6oeMEw&oe=69EE09FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DADddy9KcmoQ7kNvwH5BNpi&_nc_oc=AdplPhUzxk8uKyfVvXm-BbyNN1Uu5u5c8uqc29V5_UaroucWw1NxHsWQhdq6MHbNpls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ImvO8Wlz05Ya3HLGw-Soa6uXmU8KEZqHJX_g3aJfzmQ&oe=69EE1F64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DDd_dQSQ4Q7kNvwHfnhMb&_nc_oc=AdomKyMfz20gJgF0_7GUTfGkdKz_WVfQzdi-F8KbT0luejNC30-gr7KpsF39kh05efU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_6Zf-Xcj4ObPMq-IaywOazhdDNML4qoC5N1Q6E_Wjfg&oe=69EE1EBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJoyUVlYrFgQ7kNvwH-gUto&_nc_oc=Ado_ZmxatQRkl6jQ0Dat8RWybyIivf_KrZfN2GgEJ4u3bETrPyWU-EVISlCGYiRwAhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a
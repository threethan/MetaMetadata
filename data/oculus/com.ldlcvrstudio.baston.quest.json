.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGw-YF3HpIQ7kNvwHG5TBR&_nc_oc=AdoN9hiIo0ZRYn12FRP-Bs07aDItmQDmiDqUDMk33DZ1zIzuNjCqqPl2qQvPM7Aegi4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61aOoiZo1T18jx9pqyrbPAhoN_evQKrVevYEb20Wq5PA&oe=6A106A01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S-lFTHNXw4Q7kNvwGno1Cq&_nc_oc=AdoNrg__pvalbYR1CzE--TMUOJsAjrSrQZ9uXHflVjWamXc1-RML6t3XgKNUiVO7JRw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7upTiTymZ7aKA9vBZ2y6ItemyzxYHBpehazv-PFaSjUA&oe=6A106596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1XzmT3dIeQQ7kNvwFVxLsB&_nc_oc=AdqrLy2nkZVqT6gziWLJpzeWDmkfoFs96aCkEKOex_yFwM0_PsUCdU0Fe5GJsPCAa4A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FTzPpVaEPmZ68gXlcPZt_DFyqKr2D-Zq0WTqgQKV6uw&oe=6A1050FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89nx9pZu2gEQ7kNvwGm9x9Q&_nc_oc=Adqi72KXj6bj7mZDiyHTFxYtUmGbhtQIpBi5uQnhet44ad-CxobWPrlC2Xb1_KCdbSI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o4HBD0dkwJPAERCECOljw2tVnarutb1LpWJsMjM0l1A&oe=6A106664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WLqchR_Ds8Q7kNvwGJCsBO&_nc_oc=AdogX-AlLLlrgH81EfczBS1XESol7Q74Jtq45Z27CLUMrYV4UCRdyRVAkpsBxMYpEZo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vUchFviQE6UE4ekukWiG9iIfHGUTcnQPijnhbuXVENQ&oe=6A1065BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp9Ui5tUSykQ7kNvwGHbsKE&_nc_oc=AdpwpBVHjMoJoS_RdxlyhdkBR-CTydXnR_f19HXpwH_ATAR98fMs
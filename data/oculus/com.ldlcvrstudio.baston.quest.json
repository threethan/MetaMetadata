.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp6XsZBgibEQ7kNvwHXCPsJ&_nc_oc=AdrnVRbnFJiGToUhGiWEcbzu_xYy4Gj8qZfYUJL_1e6GLh0r44mT8ysTidwvh4ApgAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAccERo8-Sr03RODnFL5V4Hw3Ne2OEGfYWdYy8aDK287g&oe=6A60D581"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5qbPRSPlLEQ7kNvwFxqPII&_nc_oc=Adri8TFfqCyd3UIOIXLrWBE_lfrkrcUpg2r2D7eA6ZQw0EUruM8oNHwlo5piYXwiKKY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_5prvzRSYBOXlKQBuAVJbUOOhIcpiQHt-zXNwWJLI6Q&oe=6A60D116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lXj-hd11pkQ7kNvwELl2Ej&_nc_oc=Ado4IET4ybf8hO-AHwFDCL3djBDtUGlPbdo0CIcY0a9GXpNVm1zKt-Hd6n87aq5sgSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdmKU_d3GZKdN8GtpaviriYVAUYbCk8534LNfcSF05Xw&oe=6A60BC7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeNFnvRv5fYQ7kNvwFtdi3O&_nc_oc=AdrDRjWz6b1jVJLBXvBD3b5A-4JXMcw9CRMxYK_M-QzUI09oDFByT39JoXbO_TgRo-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbi_mY8lLBoDo0qWwWP_GoF-pzSE_W9L5zflnajOpSXQ&oe=6A60D1E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlpy6mBA37MQ7kNvwF4SiuJ&_nc_oc=Adq8jrrGpCPOddnnrHyJ5zJUs9PPvEEvGMl4O2_w06Fzulws5M-1u899rV8eyZvhplQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB8cqvMqTd-G9ShUGTKHMppIsJfUEkGXYao3umPTRbdQ&oe=6A60D13C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1k6xcr9eKEQ7kNvwH6ttc-&_nc_oc=AdrWr7vG8YgH6B10uS0seGP3uRYAyHMiG9Fx50IoXhhN3lxibmGo
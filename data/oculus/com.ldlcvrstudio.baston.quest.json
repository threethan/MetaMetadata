v0KMy4jX6MvggBFIGWI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHz81t9qdR_WmdJ_paTlwp1CKyV5249sXUUiLxWrsMmg&oe=6B084620"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raIiU0KS-7gQ7kNvwENcmff&_nc_oc=Adrh0PAXL0Sz5kyCy5r6UJW8beRQu0B0wBB3j3hbdXKkCIyT68er3tD1kTKc1Alri44&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROKD2OBRPiGoMKNXfBwhhC2N_eLa9F9Rpia1QfVZ8hdQ&oe=6B084401"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2o1QIzTmvYQ7kNvwGtJDPi&_nc_oc=Adq8xLj2DYwJV5HjOztIG1mh9jYJ9WSPxxDQcazW7rwa2OGsq1fUafxIq3pms7R3g9I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3nNKUNNHAVSfO3nXrZ2yKc1grs86SsbnfUkDC65UrqA&oe=6B083F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UcKgKnLvyEQ7kNvwE-YVZg&_nc_oc=AdrqkccJAeA2duBqN0LMzH0y4zL3PWe05-fMthK9ZdbbgAGwATcWnGermyXSPH1VGDw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX-VbMqUlIswSbqRT8vYlUqyBW6MJO_xxCoAmKykyg2w&oe=6B08633D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeJYEV-0vDAQ7kNvwFnvVFO&_nc_oc=Adr-LLwYAEMrhMiltLsdLmROr9Jyok7tk6XSktadiNvDKADbDJdsoD4R1Ks-TLRdjYo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxD6kcOmnKilLs4Ycojg7vzR4q02fc_xnPLntuRZyMLA&oe=6B084064"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCHWqw4kgG4Q7kNvwHeVP-e&_nc_oc=AdoZoiI7PmaaiqTUGqkKMAXII5mn7-D4hcuWB4fLQs5BQhX9e9BA2ZIHRd8UfU401Xg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUotBvANKQkPzn-ooYrNtlRBo1yfkPq8j2D3ubdnX-Tg&oe=6B083
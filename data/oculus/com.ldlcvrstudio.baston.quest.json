.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGw-YF3HpIQ7kNvwH86xlx&_nc_oc=AdoMaqZ27xODIqXukSCwC_hwyHwTDQG4TEHLOf_HO36CZxM5gYC5jxMESy8NvAkyUaM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nv5jkBJOmhIHJD-_Wbi30f-fIG39GvgBcGnd5X4M_fg&oe=6A0F1881"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLWD4psPP0QQ7kNvwF6ZQPp&_nc_oc=AdqydsZ0yFr8AlZmaiGbPj76s0xrh7h73SmoT7ZLKojogN8tvOcCN_64xlvEhuoT9j8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51tTAIbDRzCOht4ubJTShA9Hb2SpjsU8y18FHuwJWKiA&oe=6A0F1416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFYZDzuY4vQQ7kNvwG2OI4U&_nc_oc=Adro-sdlF97QQYZRiPz7JVfPFTDeHJlMGrucivR19Xt0yPc7U_7IfTj9A4zl7acLvwQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ATpRk6PzOH5PYSUFtlLiyyr4QIw7K6hat2ad_zEZqXw&oe=6A0EFF7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89nx9pZu2gEQ7kNvwHTv52R&_nc_oc=AdpajgtlvWUgkAUfvmOt4gwDEDRSh1-_kieDtbp-J-zgjrvx7iiEjWkO8_UF3Rykihs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_DyHi2zbPaa1tyhrrkrZDp-9wGAl_M2Uv6CImcWtFjQ&oe=6A0F14E4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WLqchR_Ds8Q7kNvwFxf-ZH&_nc_oc=AdqgRV1H0fk3AqDMXQ3iU4VBYNTx89PWu4o5wW6ex1WGr4G0K8CiqK2c_-ZRwW4v7YQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m4qvpo0D6oPZacvV-EF3AAQvBkZIJyq60w_tQnSekmA&oe=6A0F143C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp9Ui5tUSykQ7kNvwEsXu7u&_nc_oc=AdorrjjAP07-ciaszUbvmQd_gUikFUEQ6cmGr3Vy4_kXkKoNXMLc
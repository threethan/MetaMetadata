.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVZQ95BuMb0Q7kNvwFDCCHM&_nc_oc=AdrGdgnofp00aJtmpotWidrBjssRChxF_aavRG4Vf6EfonxfOgQOaF6Ie2BRHFMJtoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1ONjMbjhgQxgl6yXh1hoQrbCgoO9f_fBWHOUY9Jtm_w&oe=6AEB4301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEdA3dDHMF8Q7kNvwE-WJiL&_nc_oc=AdpiwHumBhiEZ_NpVwTw_dbFoWGnEiRSJIVqLZIAcuPnjjkgl8VJw2fGm8ljzJr6INo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Q_ivAcGSclTp530iMr7F2Ri3KSKx_4lV5LWxDXHl9w&oe=6AEB3E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdC3pKRjSv8Q7kNvwF9Dvsh&_nc_oc=AdoPKOHXMep9R2wPpRfS_AOx7sgPMGGeG2rUbdiMfeXGw8Jn1Ayk__MLIzocBjBIXpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRla5w9sp2uNmIFYglaTEBPmvjAczOQgWO3zs2AqZR7cw&oe=6AEB623D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cEAiR511p4Q7kNvwH8j5Y5&_nc_oc=Adq0YYN_n2-E8x5ev8Qvm-8CgKEpCQbrkL0d-hdt8HUzJZ6aoxpDgrIMrJDWyhVncLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTNs4WyiRx8Wwu_4dI8qQFvv60cuDykH0VJeDYq7d_HQ&oe=6AEB3F64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auZ4HN3Bn9oQ7kNvwGby284&_nc_oc=AdrUxuP3YSUNiyrwsGm2l1s47Mb9uUrXmd54mSA8p9fy3Cw7hBXKEWOrta_kOrcEwqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQShe4cYaFl-39_BHoV68Ej_HSkaUH2bryJBvcrGJq9pA&oe=6AEB3EBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dOuqujF7YoQ7kNvwF_e3GG&_nc_oc=AdpJo8KefK6lBqulj2mywmvmIBgU3uOtomMhKe9QWMDtFEBFVIXz
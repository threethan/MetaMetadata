.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir_NDIw7yUIQ7kNvwHYtXNE&_nc_oc=AdqyZTbOSqbO_n00HOweuqZnCaBsBDPlg8KhGiRYsyH5x1sY6U4w6hIn57F49Fai1qc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9qd0qAeJkuxa5xoPKkfXNi04RuW4g0sJygiBx_ArRnQ&oe=6A428301"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De-n1_7Fh4AQ7kNvwHvKSX2&_nc_oc=AdqPIvfHmHOU7Wa0juljIhSGjuXr25ULoYz5ei5hNM-b4airEndJezUIYSI6SRaAAAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eckEbsvb2olUjBLDvTPIujMO74Wq0lLQC0W755hgsTQ&oe=6A427E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zqS5XD_7nEQ7kNvwHup4B_&_nc_oc=Adq0w9yx95LoKhikTvfzTvmsmOQBy5X8aJlmf-B7HRoybt-mWVqc2c-wyVgaO_wFOLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ayaWwNQGCGKTPjKyumU_Pr3PH7SFzHh8a-NbeMDfoyA&oe=6A4269FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNL-SCQfCbYQ7kNvwFm_Tol&_nc_oc=AdpRzgy3DHCsBYQqe9eXonuq6bFVG7FUW5OPVD4nvNALID0xL1DdXBnWmsFqTOtlUZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkLx6STKL7sLR9QrqyC807EiDG5ccxhp_qclPR1t2YA&oe=6A427F64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K95OWaNsT5sQ7kNvwF7dcZt&_nc_oc=AdrUlmEV9DmFgOa21dnMT_Tk43iL2zfZ3rDsYUDjxD2rb7b92hOo2DqOVezLDfmHh1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93k3XMcsVnnuxRdKcFThRNBGNV3kcRZLBbtE-P-rEhyg&oe=6A427EBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgbuFUy3sWgQ7kNvwEtSi0f&_nc_oc=Adrb0spNR1aIf3YH3WIIVxLWScTdMRmcB18r-UHYp44kMdIdp7YM
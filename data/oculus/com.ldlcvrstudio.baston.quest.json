.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eioW1thEVOEQ7kNvwHio39T&_nc_oc=AdpLJ2PliyDgA3eK_M6cRDqIPdaMaFUR0bkAFn8EojvP3hBiUAkwlHJJEbNCuU0JeyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxg0Qfn5CKLA2PAoVTAhVBL0pwMEeEXDUGGUhcJ25PPQ&oe=6A983481"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P9lvGq6yCoQ7kNvwHPKn-Y&_nc_oc=Adoyouorb7B0XkXQ3cXwKMrVqQ8lP2VhfS_jOqFcRt2-zYABpUqi4OF3zGmRxMFxaK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCmeye28fLHhnwueF58cegJPwGwgmj9-zhzXs8h8j10A&oe=6A986856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZxRlYmkMjwQ7kNvwFOm9ed&_nc_oc=AdriDBNWTCOoyhzxniMg0By-oSNUPtTJfsGoaIm9AyyZ0dstNHS2PRQDP-FHAfpGVK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVzEyyUxHwX1t_zNCDrBqt4MqDeCgPmI4dmVYsdUAt8A&oe=6A9853BD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvGjnie-THAQ7kNvwGguG3l&_nc_oc=AdrD3ED6aFQlys4bfT3Bok-skUW7ZYj-4kpKWkhstyyUKFnbmw2BNgtiDwN5yHjqwyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG2APxIPl_JSp7FhYR4WTzLKUVA81Sk4pCrEg12oK0-g&oe=6A986924"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_pv4UWnAWEQ7kNvwEVRS1r&_nc_oc=AdrgZVQstwL3A5zl1E30VinPkLlOb6KZaC6szaGk5r3mWFbJL3SpM0dwmMu7umlFaHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_1Z4LlL4jnNOo6dFQQA5T3FgRX6Pl5iQ_itj81ZKZWQ&oe=6A98687C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zJCyJyY-fAQ7kNvwHvvpMc&_nc_oc=Adr2ax6FGiiyvvbm0tAlkEVZ7VDwdSF1NV7EXV4b43TXeoSmlVQf
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r11EgINyujkQ7kNvwHQ-WC4&_nc_oc=AdrEzxUF4eCenLrUanq-BjJEoohB0_14bMbUGQgEp6iZOwa5Dz0v7bZ8B0EfSUFk6Lk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6ggMyM6A1vXV8G4JUpqMte6AqpGBoo44c_FT6Cxfe5g&oe=6ABD1E81"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77HLv-Ob8X0Q7kNvwF7wt6-&_nc_oc=Adq7L3RB2oOGbwyOnIE9061WkoIgWbgRFOg8fe_xnJ53d1EGXs_bu_4JX-vw05Gx-FU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR_QzlNe9UzNusnWTCAg8py7PkNqrcb8nn940Cy3wjGg&oe=6ABD1A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzO-TshToOsQ7kNvwEPAXnH&_nc_oc=AdpVYn53WgsKszxYIeRbFQeSYpkRK7ViJn5_J2bDCOueGTc1qEUfboxGepYrtweXRvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7x61HgxVeFiHlX8HV7WylGJztn6DGwubBYlCkyf4Dxg&oe=6ABD057D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oba5jc2tOYUQ7kNvwEnRE2n&_nc_oc=AdqBf68gom3EJPRuKlO0xhMlCXA0lBhjVv6W1glY6wP7CD2JaGglrkvKM5qV_qrGBEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4g0_sA8YlKjYgk-HFphEUX7cOhrJU5HdpCb_MxiK42g&oe=6ABD1AE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xnt1rRoeXfcQ7kNvwEjvctR&_nc_oc=AdoCGE4y34JfnWXOS9R62Z8GvfZ5Erj-x6KIuLr5C_58paimRnwaC1J2FzsZBGU71R8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuiqWhsULsTBootEYvvWofJQdVlDwjdls3zxsjf_PmmA&oe=6ABD1A3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km3zbeVcd20Q7kNvwHlTlfs&_nc_oc=AdopX-pjh02lG2d03emafD_MEjYhUg2fJEoRRCWKG-XztBky2EMY
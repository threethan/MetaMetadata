.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RmyCOpk6M4Q7kNvwH_3ozo&_nc_oc=AdqE1jTGPALK4QFZTQzI5Vs-2-sNHJD5rud-0mumyvz0qW4iUFn_H8j9VWCdIga00DQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BnGSIjgxDzhHjbk9_4NMZrto30wQ59NxY5833PMyvzg&oe=6A300E01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGChz34FSSUQ7kNvwEb01rn&_nc_oc=AdrgdQNoNhjGh3XaEuReJSlNyvB1nc8Xzg6GJfthtX91CcrXZdbqH-r1dOuDIJLrymk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88MzA1Xq0EIlDJhEpT464bccUhZQNX5Sjf_UK2rxN_sA&oe=6A300996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIn3XNwdl1MQ7kNvwGp52OG&_nc_oc=AdoikhJrKVP093bPPlzc0OhFonSROYviIDqjKm49_oDNM1vhMcyaIhgOzv8Z8_urpRE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gtOJdKV7xF7Hyvz55XUfZXCAV7yUsWdzzVIgnWMHrng&oe=6A2FF4FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM11OrhSMBcQ7kNvwHjPsjT&_nc_oc=AdqvPyHBGwmXMG-ZVfSCxfk8i5d1cFzQhwPDxKBs-3MKgZMXMJPO_UqPUG0SaxOYL-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TyW6Xz89ShsJzCMXruIwPG7BZPsXKhKywpQshFMP0jA&oe=6A300A64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlBSxD5YuL4Q7kNvwGvA0xG&_nc_oc=AdryWZKBjclvi1j-pLedM5rZ904bc8GxftJhw9WJdjrzTwXR7OqLNMip1s7bYldWUH4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95yOXwaZujSr6KSZjVSUaTP1CKWRvcuhYNIAPNkRJhDQ&oe=6A3009BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_-YeXMG7gkQ7kNvwHRxZqx&_nc_oc=AdpQiwZnSiBK4Ps8NF55KoYNWrrYuXaSohzJtD4lPIjo6i_4gXvG
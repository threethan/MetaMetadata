2044246292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9_79ykZeWgQ7kNvwE8czaB&_nc_oc=AdrWFgyR5JYqf7HXdD4xnJCxiriWgiK4fLqwGP2trjWdcRFbZANkxZycIQ8ZVFat9v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrZQvWzUchy-GOh2UiYRuKN_f5CXweYyDBAg2hCy22cg&oe=69D0EFBA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UggbJfe5srAQ7kNvwFvLL_G&_nc_oc=Adr6J-Q11zAFVsOg9G6tsM5avuMl8Nm-JZQzddXl_AvVNU_ikWZzlDfVmap6_1X09ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnMpUB61oS0GsnUWK23ALhNSs2UvnBleG-JC8NY7Rl9A&oe=69D10C2A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=HgzlblRsfvIQ7kNvwFmMOlv&_nc_oc=Adollw364Cpl77w4vlMvJkYEY__pGDUZ5qsuZJO_Sgcy-726NZDO-d7z9L2YGUI0IsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmmgyYFc2xYRDasAAuL2WJDJ_M0-FfG-6ztnaHAoGuFg&oe=69D0F382"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvmUj_PDsh4Q7kNvwFaVUnK&_nc_oc=AdqJt9j7T06e3Qk4E21ECBn60T1UW7oKM8qVh9IZ7hgI3-ZFrJrEgP5ifuiBYNAqBoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMN0NePMqNBL-GxR97mSw4OMAspURVm-wyIFjTpGHmXw&oe=69D11FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0sEkEsV2TEQ7kNvwH-TURY&_nc_oc=Adrt5FJdyGRJ7MUGYK0biigcimTI_Ye-FnI5IYHITHydRN7IS3UKfgQl917glRz1OOo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSWQjzDC1c8MzdKrhVgtnpMx7VOWtzOC1eLl4SCuZ0FQ&oe=69D107A5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RhaR64iYQkQ7kNvwF9FJeR&_nc_oc=Adqq-qUCqs95b88OdHDV7_DARQypSoatUG5mYz--eRFcTQV3mVrlfNrBqe-QJajfH18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu0AVha5yKQXhBDfwhE0bf8hociYSSEtYROx
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE_1QFTZungQ7kNvwEmx1Jv&_nc_oc=AdpnsL2jFrzcMghftZcGqWKtSLbwYlygj2EBuWG7uVlHKoJ6VgYGvKtWMl5q7Teu360&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cBGsbymV44gTpHTO6sqzeC6Lf_5yFJOTzGRT7iCWh0g&oe=6A130D01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S-lFTHNXw4Q7kNvwEHbxXa&_nc_oc=AdpVT0BWuapDbIbpb-mzDJzHOmAU_yl7hAOPKH_Ydxyw6CtX45UkatM_gJq2sfVtkbM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZubzXRMWfiP0oDXbvdTJQFuDfsWwoLng70dNnU907Xw&oe=6A130896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1XzmT3dIeQQ7kNvwHnA2SJ&_nc_oc=AdqTyV-h_GgGSpSH_pe-F82EUQZqJlfYG_G4P1tj4IEekU2N0Bpo57WQyLRebesNSec&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5STXoIuyma4EB9zcLSoyZc0PuXZFvNowY5PysYtzH1JA&oe=6A12F3FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUlqb6OzWTAQ7kNvwFcTmvJ&_nc_oc=AdprA_2FgJIIHrqUpEo0IFyFnx6cCB7xGsO3F0Z6P_HephZ-NLTlzIM_jwaeawHBnYA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vIVfGDvBoPMEDpjHEgnxRvmxZE0mtN-bWw7-Oqo787Q&oe=6A130964"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfCK5O9kFIoQ7kNvwFcAKBI&_nc_oc=Adr2nXkC3bnvHfSEXm-4cYtJodw7MbQSyG5D-LvtqpWvpbE_gRS05SLT8AVk51AmWjg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WoP7ofrVB8WAznspBETxAb8hwzFdm-nbcD3rczcEbMA&oe=6A1308BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JWle5hx9tYQ7kNvwFpjdzb&_nc_oc=AdrIri8I73MNpVsoXWyuUl0YEDNS3g6rTCipjA6WCL4_KHd90I1L
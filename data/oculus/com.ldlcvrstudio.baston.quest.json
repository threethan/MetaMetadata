.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAxA5CrYVb4Q7kNvwEL9SBk&_nc_oc=Adocu0TUj2-XKS9JiwbO01kJjcAPOhWRuNHv9L_jlHewNLO9DXGNZKj7NkKvorzShDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXpTPziM-g94mxRlcDseS6rdBLh_VWwqWPdCt1bO0Iag&oe=6ACB9F01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1S7c091_4UQ7kNvwE66S-0&_nc_oc=Ado1FVLmhia8cISMuFCSioX_7mxyzZ9wHwmMNU4YhGQxkUgs2sVyDr57qh9cxpsYrLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEb9qmehS0aQTn5TJ4i_zSuDXSg7cEEhfLouBWZRn_XA&oe=6ACB9A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiNsrRhec2oQ7kNvwEVvbUC&_nc_oc=AdoUQCxIYkeZNLoFDRTz26gJGCjtlZrNHnpoKPm8Y2WWATP8f_yAb155yqMTTN330FI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmfeYdx2gTDGNK_y1TgC7FXJY72zpfKLKxNUHyvNhhMw&oe=6ACBBE3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfz1VijTaCYQ7kNvwHviCrp&_nc_oc=AdoCIvQgPDlJkDRMINBIKmnT8HHsulmiG2Hbh1CN9D6ISVWo67bjsBmfIK8zvbQRQ8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS8mPahKE0f_x0iAbJqv3A2Q3pDK_Ohjsdff-rkzBxpA&oe=6ACB9B64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY-WOukNMbsQ7kNvwHLGKJB&_nc_oc=AdrVYQrjAa6MLZ6dN8ywNS2NwnmtZ9YVttrmTpXlm6DModuDLW0fuz64hZgKcjjtSc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7eImLl9zoipHUrM03FnmIaH3WslhRLOk00VYJW-2xUg&oe=6ACB9ABC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDrCORVITcwQ7kNvwH6MBKQ&_nc_oc=AdoFQWDDc-0eVHVGtl2YeMnBlwlVpO5a9m9L-6Fa5nNG6Yf7KjBU
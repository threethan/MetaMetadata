.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz-ubbptyHwQ7kNvwGgW-0N&_nc_oc=AdqaBDlu1OVKQj0vreveIH3_mEPgZlrzDEW7_kGJ2xmLhlQuQHu0_8Rs4BEBU1F3MPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CyFOKZetarW7S6GHi_qBTyrDRdb5qN550qTU5s4OhLg&oe=6A3A9A01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHLeGgC0gyMQ7kNvwGJ5LDi&_nc_oc=AdqU6OpfACn6BSFJ142rdJNd9a_DKIYTIpsAKZquGJFllEVFDCxD8-vQX6ltoB8p95Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X8K1zmWTQPNdVr71xaXCkdiC3toaUsw6OLYXqDNrkoQ&oe=6A3A9596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFzN1QbsJNMQ7kNvwE9EQhj&_nc_oc=Adonbsv9r1UwKs4OtBVhD-gH8b4DH-MxCdNyzPtitZ3c0JWhEV9wYBOi3uxUdsXVjJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SvyFReKO_QD7Ud1dlG-zi81oQWLUD7bEQr4BDtwUiZQ&oe=6A3AB93D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWJGyC1UsKAQ7kNvwFvrxkU&_nc_oc=Ado35NCzPtW2og0Eab13zJLVZ4r6ycSUPx9HbQcSUfffi8H6UvDwtEELsHuLx0pz9r4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Agk7aX1j3DthprfID5ucSH54TdlGwJtJOmzW0bmPBsA&oe=6A3A9664"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QtvzJrjFYYQ7kNvwFkmU_w&_nc_oc=AdoitM50JAgDDLRlwVxX1KZx0Qu0pvvh6EpMuiMvCY1pd8BFwAjSxC-wEa-lvfY5DMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D-_heQyeaDSC9yDCe9Z5H86Tpqn4nUMCBSKjP3SZ3PA&oe=6A3A95BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I3YTahQPuoQ7kNvwFGMrIR&_nc_oc=Adrc0gNG5-9RNT_rXyEDk6jRNmZ867VFnOh4TO2a16J96O-U2645
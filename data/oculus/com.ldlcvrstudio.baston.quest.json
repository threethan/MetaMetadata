.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF5EI6k_aoEQ7kNvwFe7NSh&_nc_oc=AdoMiZkafVcSVOnYpBYmN8iroBcQzv13Dd3WmkEf8pXi3D6HdyRmfncI9H1rhmVwA-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Uzo_6-g99Lru0lRxSBv801fogXNROT9nB5w9FqtXw4g&oe=69F60C01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0_8Bb4m_w4Q7kNvwHH_-Cq&_nc_oc=AdroBj4FQivfuaq8wdtita_feRhAqRZ9s5us8ucOH5nnrEKmQdgiVe255xPv2WQL9d8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2U8WFPN7OyJaj4Ir6iXRKFlDdcSAxE3DzPRLMQcfUgzg&oe=69F60796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIlZVeiW9rAQ7kNvwG51j1h&_nc_oc=Adp10FR4JjqyuzVoomASOVANG-WEshjkhdfbA7k_kk-m9zd2wh_-M-tbSMp437UCsqU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ETfCKjEWWi1GwJRwduYmF9AD5WAG4MU8Kl3rpYZXqqQ&oe=69F5F2FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n\n**Physics-based VR brawler**  \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n\n**Step in. Swing first. Think never.**", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjGPcmiKvRoQ7kNvwFGJWAR&_nc_oc=Ado8LuPUwUvs0EYsyUCLFryraSh5L2uvWjsEfGB444nL6tCqAPdAi_g5o53icf-sE-U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AYCk_mtFPmni-rS23ZKDQA9EN3GPMOULYQLnBSLsvVQ&oe=69F60864"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSAnAUFzwIoQ7kNvwGf8jhn&_nc_oc=Adrv3qHSaITOto1qfB_4vo6XsaG6QmZ5nOfnPbkA4r3fmASTbcW9jaUcERrpA3eBS3Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gdlbZ-oejJsBpXc69yLpuCFgjYCizcTdyjW9dJ_Q2lw&oe=69F607BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DLm_d5MnjAQ7kNvwH2EdfC&_nc_oc=Adpx5TsYDqpA-Q4PTdP_S3tmFL-SZJiXJQgCHhJeIQPvjp2BsNdKyCrUh7PNiAgsFeY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXLBpHb2LloQ7kNvwGQ3O_k&_nc_oc=AdrlLlRF-y30kYClwiK8MPewxkiBu2nIPHiWUUxzVFh2HLd39mP6KFacXh6dQZJCzg4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmZuikcj1lq3gEF0HXOin6268B5V6UuBV7MgLqTr9now&oe=6AA56381"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwkRDCX5HmcQ7kNvwGnipHW&_nc_oc=Adr0kKNCa0zBbrASXENlKn4db6fJzMn_rNRyXm0SaPBqDFtSaUGNQ5-Lh2bokshGdeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKxUVnQsFFYuwSDY1JaiIW8LzJEyOZyUHWr8jTjU3MwA&oe=6AA55F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN-0kwwwlREQ7kNvwGxAwam&_nc_oc=AdqxlDoK8FXWqoKKtCgICavibPcyi3ae6XU2GJG9TR5sSMoq2Pdp7wUjGED8xl6cErA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV09YSUAuqldvKg11yVcgs7hiJ3wWniB0Kp4YH0nCHbQ&oe=6AA54A7D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BayNeBSjBQQ7kNvwFCrMkk&_nc_oc=AdoYJ6DWmXr7SnVPsCQkkKYf_F8i-POMiPC5pou0NqtstIL248KwRWp0PlJa2aQako0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJE1Ag4umcPT2BD9o-j0rSaxrBGV3vjpBpV-Bta5rPVA&oe=6AA55FE4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi42uZPEkC0Q7kNvwGYzVL7&_nc_oc=AdoDKUmYFVqMEALxoa37M-4Tk-JurnydMUJKNCdCdIgXF-gSF5tvw2KkHt8JMHZeN_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Tn3O4imBpzmj-UizrehHHofWK5V5Ay3s7teg-0Ax3A&oe=6AA55F3C"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtu0mrB_z3oQ7kNvwGsJMRu&_nc_oc=AdrtlUTawBNeTzOvpPes-KLwmLopinac_kMHlFz6TbMEY-3slpdr
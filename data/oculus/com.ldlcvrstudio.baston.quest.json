.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOtoza0hEkwQ7kNvwHs_qno&_nc_oc=Adr8OGBr1QGfQ9G84lfTCW4tXL3VeGwIV4GazyPxs6eej45BINswgeqn3l7710-PgxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c3bQuSzpMbenjgmDm9CjZ85_p7hlqFJX3k2gvkrPZ3Q&oe=6A05DE01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZcrBfqJdu8Q7kNvwGlOu-S&_nc_oc=AdrY1vTarq6h_8h5RNxiNPayGQarSol06jKEQE9TFjoY37ugTDP08NkI9m8J8JTt0yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5brydUHfMN-rmRuuNH8PmP4rbpOiWoWmzLtclbRhYKNA&oe=6A05D996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmAjovxX2MYQ7kNvwFd6qzc&_nc_oc=Adrbq-q0aendKCRza5CP9XaolGY009Ezu6c6qIDDwGe5H5yWAub8aA14xipbSS9OSO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j6mndYGXdXQQxxQAAK6jtCBY7Bdah32HEsk5rdlAL5g&oe=6A05C4FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2OtpdsezDoQ7kNvwEeQM8w&_nc_oc=AdoXRT0hhyb0Cst5A6DrGyJDOYRQK4Slm0bHX49g6LHTQy5RA-R6VgVjnTPNg2hWqcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61uIP9rnXAjOZ6yF8JV9HCdNOOaTmJnGEB8fo2oZ6rrw&oe=6A05DA64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeucD3ls1DcQ7kNvwGbx3ad&_nc_oc=Adq3h4jF5ixXWFP9ufLNUorRWmzzeQWSVvBbyNErXi3F3Hj_dCr8pSyeamTqQRXLh7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kCDJNxrzD-qz65WVMh1AKRWqRDWmhgB9M9DpHz-S8gA&oe=6A05D9BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZiCT7C-1oQ7kNvwFWYc1R&_nc_oc=Adqn1-zIpN_k_nwKKnzAoVft7KkY7qntJH9Z2wCD7iAPz2fJvMJ2
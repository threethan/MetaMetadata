llRXS1E63OmjS1kDGQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYWtyqpJtsH_wAj_hO2_mGnexWexEarhHBVVANULF25Q&oe=6B0F15E0"}, {"file_name": "01 copie.png", "id": "2096468631211025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFMZ67SUhxAQ7kNvwG2LU8P&_nc_oc=AdofbVeav5BT8kY9NRMxrH7ZTGnuZAUfb4vR6RbB6FD4wIRKg2VjNHrfWCUtcfjBUts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFsLjg1Sq05X6EA2Xucoi3OyAHLlurqBWH_i6NkycdUA&oe=6B0F13C1"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXS6IBQbARgQ7kNvwFElKhl&_nc_oc=AdoNuEy8TpgOj8ldKpgL1SlvCO73-0vNi-pKoYVdmx4z65KltV7mBBvCy--kibRVYqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVH_tIZKNL_OE4GmPExEc_7JSKBH6zdmcejPqSNs3MGw&oe=6B0F0F56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFcFF52rhmkQ7kNvwFBSNj1&_nc_oc=AdrTOR6lNjVowKKhJ5vcaQsfsl_9NYDFJ_DgAo1rlcKWEwJZmyUWR7cfTCQau039Qdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhOtCK05N0J18KtqAGKaxznLVMdyzv3fSGgstpYuMXfw&oe=6B0EFABD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8hXIYaBnJ4Q7kNvwH0NAbc&_nc_oc=AdoefMhB3a3YbyOqqCswVMlGx99vtbqNvOBrQDBOfkXFxocTod3y8dzzxQNaui6F5AM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPHKH1Pf1KakxM_d1qxORay35lW_Fm_msY7YYzZI5-5Q&oe=6B0F1024"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wIKiWL5Ou0Q7kNvwFufaD7&_nc_oc=Adoryj8-gXgH2H8Z6XcEe2tdQT0mA-so5Rc5BgWlcHoaZoFJ18Bp1WtUdo7raTS9Fzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdSJ-jUeNXvTytC2y1gpmcJMf5UQ5L4ihjkJUFO8BPtg&oe=6B0F0
388_6932010296335491220_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9NjwSh-z84Q7kNvwFZ-Car&_nc_oc=AdqLM5TdDHUa0GR1QZKEl1e8OHe3-2IMrYx8ZDvcb85uknbEZlyPYBo4updOk4HgbmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ03qataGJBJTJD2t7GjQjfFYJ6XkGGpdraWeEOEepJOg&oe=6B05D731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezHorxrrdCkQ7kNvwFuW9et&_nc_oc=AdqxLTzihPcHX1LCjvUnCycNxMq1vL6QzVduHTET5LzVtDlMkfs9AQ0V7MiI3cxQL8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlgUIqJORPfjsaiUftPIvUVMD4Wmakrt2Hw8tFLiWwDQ&oe=6B05BEE5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NJ9p3OOiIEQ7kNvwGJPOh2&_nc_oc=Adqso8NovzZqQPtvrOlN5Z-k6VJ57GVhL7EWgkytTERb6KX0Ie722PdDTDRxPgS-DRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW8N4jXWnF5MknNUlIqrQO35IvNPnEiei_lhWBEx8X2g&oe=6B05BC45"}, {"file_name": "CoverImageSafeAreaTemplateSquare copie.png", "id": "1880433679219419", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1880433682552752_1980421045084427771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75pa_UqaKdIQ7kNvwF0xrst&_nc_oc=AdokXPjmbB7dDBOKWWXyWNGD5tKhKMPMuLNVcrSIdti9-RCXmZQUPTHDNtQaEMOzEyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHQSTgGAGRW479XpdJwAcNye-eUJTShhiA-S0vkYbvFg&oe=6B05AB0E"}, {"file_name": "NHBK_Logo_H1440.png", "id": "1660891154542652", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819944_1660891157875985_4872676651041472123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USz-34lAdiUQ7kNvwEXofuO&_nc_oc=Adpag9gM24xZj3Kx3vgPsI79EK9T-xZ82m1gjVbuAzKGTXVSRhRkTfVfdF1q9sC9TIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSafPjGOicrmN4T0Z0IdthCNi2SXP-Uok9RgOus6cjwow&oe=6B05BC1C"}, {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1417701233407141", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1417701236740474_8916931527861982871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk8SXGoL0dcQ7kNvwEDzrYa&_nc_oc=AdqQ9PYsXPUD2jMijQe9CSfOwL78bMPvxoeLLulrHrlMnNGlJmmOXfixmSv4f2JlVYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9LDnn_kHXb0zWjvFD90MpQ9vdFxfmK0Wkz3zp-Avlgg&oe=6A5CE101"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmwwK8AaD8sQ7kNvwFUDEFX&_nc_oc=AdoRlewLexMXDMTRRrj5Am2xv9pyc-L0wTLh6seyNqMqhz6V-N8_ifJ52WMdjqbVOMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALtb04PLtKbqKJaanj1mos5JwPhNJ3ZpH6G-vyuOPtyA&oe=6A5CDC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T__iqJAaRd0Q7kNvwGEXE4T&_nc_oc=AdpFkINR2LxmlzvmMs2xp-0ZxPb6ozz2Sb4Is1dofKKBriHvkupiWi4GWhe_d-NB0sY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBurLnYg8HW1wGC4z4VNsoygZEy9aIOERDTVGk8LLBDA&oe=6A5CC7FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EW0RKS0RBYQ7kNvwG1IzLO&_nc_oc=Adr1AVsFXmJr9ueYuidOO7XtlU6j1kSAGqsOb7spD2od0G9w_D2lVi1-jFqQSjm886M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn60mWdJ8_j0-yTtKIpKWXfNU4QqsnxyA0GP3llgPuTA&oe=6A5CDD64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp1Q69FqV6oQ7kNvwHKliAs&_nc_oc=AdqYMT_k7X54-neK1D4yHIYHSXdAMx5pyvKTT36TDTa0AEbwr37cKZ7oYK8GXHdXxxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsHu8Aq9CMGpLDMATVmy_8PGgVTLz5uArI77u6Az-djA&oe=6A5CDCBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS3ZFIMXZCUQ7kNvwFy33Pc&_nc_oc=AdoM2KRyCg9tJ9ljOWALt3x35LM11ajl2qDfXsNAUWD1_XUSYW9L
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItJN43CZJ0sQ7kNvwGHYrjF&_nc_oc=Adp-7qK-qypHga4fEoOQOy4HOFKFN-QIrNfX2QPrlLbYZYhtL_HawV-vFpoftaMVNL4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId_q7cGG9aOZhOAgC8m55kAlkgC-fRQUctZL_HL8KTfA&oe=6AB14101"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCmVG_ejdsYQ7kNvwHaDGq-&_nc_oc=AdrPL5HhOoiHjI7LYMkSup2LBWRPwgpo3YRkRPtFNBynEXT_3nlSpzuauInNEk8PGuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3BQa0OZMJbaDL6F3gDwl0c0zgoB622wFhkEoFEvYFlg&oe=6AB13C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkHZOqq7snEQ7kNvwGX3Gp1&_nc_oc=Adq8yhGefY7qcH2_y9bZYRX_ZzXGFmM8EZPfA5btXjndnFk2DZZnF3kIN-lvIzpLVhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5l2aSZG9d5hZoJKyNBnrWDMm4uqduccqSulLbrUigSw&oe=6AB127FD"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3V-JgJVXwQQ7kNvwFMFMyW&_nc_oc=Adodv9ZuFAQQk3URV22KfY2AlbTnuGqNL_MRJVggOuhIGUC_wKnVK8QiOfQQCQDpzEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLvoWXzs6CHn6Y1cQ-pTW2USyqKcDZyzWkWLj9p7961Q&oe=6AB13D64"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTiR5oxm5s4Q7kNvwFKTQF-&_nc_oc=AdphQpNfxyYLF9VDrBSUqtA-QfmrTu0_cUl3r3OBUO2rBwShVMnrmxiDuRmXD-Xm6vQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-D91ygmSUrrvxwqSr7GR3cv7Gz12x2Mennnov_PZf7A&oe=6AB13CBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouFrOPQleAYQ7kNvwEFfaO8&_nc_oc=AdrdnsN08W0qigACju0Uek5pbY_Qa5jP7nJKbRY27SDH0zRX6sGu
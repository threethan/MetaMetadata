.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwR7dGJGzUgQ7kNvwHt65gg&_nc_oc=Adr1Tq2F8rZY7NkljYZ2-VVp_Bz1EiOPp6_M1oy05oLDmK0sSbD1i4KQLlZYAgmfUqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3tHUB1gBE9UsWcJNj5KCg1-41szinycgUqWo0ZLa9eA&oe=6A355401"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcQ4gKu3sGYQ7kNvwEwv1Lt&_nc_oc=Adp2NORXbCIvi_m78AGAU1-Je0F1QgKqi91kSO5EG2dq4Fpv8nWOEBTZbCCoPqqMrPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ibxtUIpLgIuI--qYpX3SkrN_WtUr5z5fZO__HCJx3Dg&oe=6A354F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeXRNAZyaKUQ7kNvwGd067U&_nc_oc=AdojiEZD0e0OGd5zcDmzasqzxOiECTXeU-uS5E2p8_v0CIMS05lo0yJMTHIRG332ggo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d6-gzDKLXWeHQusYreSHsmrlFk2tV0b7mERqtfmB0jQ&oe=6A35733D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-Lz6IiebdcQ7kNvwHh13Pf&_nc_oc=Ado9eCJ31QJHJ8hrg_tODRgTo9yiRQ_4j_THATcMP5tgydVgqyU4fJxY-rDwRj12jqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-Z7k6pblfGa8ECOJkFoPlwcz4SPB5pc7RmSvSmrbUA&oe=6A355064"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnAd6UxJXq4Q7kNvwF2gijm&_nc_oc=Adoe9g8ys5o4tszk9ysQcmupZzt_4r3qD1dOI5WBBiQp_Ff89EdhWjgShLVPfeqNO0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d_h44Ob9jWSEeBGxD77GzMw2IqkZeTOmvLo3HQmAGCA&oe=6A354FBC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfKl_AqaQQQ7kNvwFcOxAM&_nc_oc=AdqC5-vZb9IHBoNqycNpOIyJ5Rz01RasIkPaaT0sWWgEKTha0S9N
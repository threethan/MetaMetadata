12044246292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_722112047579625_6844270122240688832_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBkFQFkRob0Q7kNvwExSqkp&_nc_oc=Ado63sZObK-DgW33vIb--r04Hpj9D9QBqNbK5xyMa1auRBXVoLaQ0XMN9D4Lp8MeNMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12ekdddMzS_4Vnbbtg3i_yG84SYsU1B05M4fSyuQ0p-A&oe=69E39CFA"}, {"file_name": "Screenshot_44.png", "id": "867967472277515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_867967475610848_1351511277835059103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izun9z72yuwQ7kNvwEtONW-&_nc_oc=AdrX-6bVGqb6IniKVIAoIztUXSCD-1fZMoAJqZPhc_5rGpV2XLiy6sGxlscLT-bauqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oDrtt2o_5yaac54LIG-HDqcRAHwDDwNAE5Vu_1trMrA&oe=69E3812A"}, {"file_name": "Screenshot_33.png", "id": "715812097666802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_715812101000135_3241392836646707521_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=FzTyZd8x50QQ7kNvwHx-xaM&_nc_oc=AdpBRho1HEFZwVe-9ulXrlbE1Wt4Sw1LaZvJiLBBZa_rXRdhL2GHOltzX24QEpYVfg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07wi1iIARDr8vvcJflvgwXWd1iv4XRkcrAcOCSUNrCRg&oe=69E36882"}, {"file_name": "Screenshot_29.png", "id": "842338085013055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_842338088346388_6932010296335491220_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGaLqtS-YJ0Q7kNvwHDAF0w&_nc_oc=AdpsQtnfegGTJpemV5AV1jmzO0QYI5oqUmvsveAB-dkiU9xzcnpXP6TlRCzUsR5XS9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TF2qtmzV4U5sAhverz5dtvM3GrZa0el7rb0LD4cYsRA&oe=69E394F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2115001645697513", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_2115001649030846_1030506476172579137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbzl2LMp2GYQ7kNvwGbjyVr&_nc_oc=Adrs3nxtM3LCPczyFL4_Xlq0IoHe1F1Yol8Z1n_8u5WV-QAXoZ29_AxiqQQz_6YDjYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af290hppkPzyiDi1FEBcNmu9jh7LqvLlYiRb610gj_5_uA&oe=69E37CA5"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "brawler", "punch", "tavern"], "long_description": "TaVRn\u2019s Takedown est un beat\u2019em up en r\u00e9alit\u00e9 virtuelle qui se d\u00e9roule dans le monde furieusement d\u00e9glingu\u00e9 du Donjon de Naheulbeuk, le tout d\u00e9velopp\u00e9 par VR Studio LDLC. \n\nDans TaVRn\u2019s Takedown, votre mission est de sauver Mliuej d\u2019une menace myst\u00e9rieuse qui sabote les brasseries locales. R\u00e9tablissez l\u2019ordre dans les tavernes corrompues gr\u00e2ce \u00e0 des combats immersifs en corps-\u00e0-corps ! \n\nComment ? \nEn frappant, \u00e9clatant et lan\u00e7ant tout ce qui bouge sur vos ennemis : objets, gobelins, humains ou toute autre cr\u00e9ature assez stupide pour se mettre en travers de votre chemin. \n\nEt vous ? Vous \u00eates un h\u00e9ros parfaitement moyen (ou disons\u2026 un aventurier ?) qui essaie de sauver la mise. Ou de tout g\u00e2cher. C\u2019est vous qui voyez. ", "short_description": "TaVRn\u2019s Takedown, c\u2019est un beat 'em up en VR dans l\u2019univers barr\u00e9 du Donjon de Naheulbeuk, d\u00e9velopp\u00e9 par VR Studio LDLC. Colle des baffes, d\u00e9truis le mobilier des tavernes pour sauver Mliuej\u2026 ou transforme la ville en immense chaos !\n"}, {"images": {"nodes": [{"file_name": "CoverImagePortrait.png", "id": "3183306665203162", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823876_3183306668536495_1618518139851191842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KKF-9ibwkUQ7kNvwGHSySl&_nc_oc=AdpjyOWM4XQ8QI8bTVskiSfqcpd5KPs5qP6yZ8Ly-txvyWhHqJT1SZaIjmLNVtzrf_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tEFxbkFNlZA0gmqMeUgS1FsqTkOHnxlMuQ
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgSAPStrWlkQ7kNvwFpTixz&_nc_oc=AdofdNI4hw90FO7k4Wype9k4zCQYbJnQTydSYfL1euS8arDbnU4uqmxnW9rlwd02MbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2GWvzm3cjU5pBCV8-xmhDCWslpfBOFdW7uPzwwVHkrw&oe=6A92B641"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jk9r0Ii7XUQ7kNvwHpM3bR&_nc_oc=AdqN1G7O_eR8HCXdlsNV_y8qblpxYf00T73G7g3FTHVTP-u_lD5TS0ukryMHQ1N8NSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYD_turueStBI8Jfu0gm6ancg6V4zT3W0a4tcBcWIQNg&oe=6A92B1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6KMF7Ln7fsQ7kNvwHJSJ89&_nc_oc=AdqRFynJ8Ltg1WkzA_qobATYbzBaMCZ3arYXIHg2IGz1q5iCOe2XYllE8o_3pDL0WWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwwFdzunx-zZ2BhFYbgb27QDtI2vvow-7HneHVYRrkRQ&oe=6A92D57D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwQLI_-bdnoQ7kNvwHjSgGE&_nc_oc=AdpN5mZ1kC_FNY3enK6zY1BM82LHm23NWMP4QgJrI92uDwqhR0mJpYwxxDSTuA01fGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMpbKZM4fw8yZ0Pm9AXMrmL2gf7A3mkXzQxP3SZXAACg&oe=6A92B2A4"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUZxnrtQ7xQQ7kNvwExSV9g&_nc_oc=AdqFXbrPRrMjWfoIcgbrYwIdeA4_bkqCHmLhFi00-8BorQ167QmLFTiPfVdXWW2Q81w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx34pVP2sXhi9IWWfsQIrta-3yjbIlZ70KuqZB3YZonw&oe=6A92B1FC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4lPmtFXQFEQ7kNvwH40cyx&_nc_oc=Adrj_68VuQzcliic7VDBDGDWXJpW4pj-a02o_7FcuP6lq47joxCI
.oculuscdn.com/v/t64.5771-25/491827567_2096468634544358_5391592433140759622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAxA5CrYVb4Q7kNvwGX7lrb&_nc_oc=Ado_eSYkCA3JFX-F_vopMrF6Z62ArV21Ch3NTfVP1DkY7Jk7GwgaPoAmdcrXsQtgLA0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9RS65FSf63T08eV9SFDE9YAo14aMjFWy9wRYdKhjHTg&oe=6AC8FC01"}, {"file_name": "02 copie.png", "id": "899466709809467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_899466713142800_2571306538576435823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XODl2IpRGAEQ7kNvwELARaM&_nc_oc=Adpi22O1wEYCsT_GYzYsVG9LwSt2WVgMlkY44OaCJD6axBpKkWiilnL9IRc7Lt-dTHY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODQAJI3yWyCdbxYJ42bil01idAIFyIIsVzfJFvOkkQkw&oe=6AC8F796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape copie.png", "id": "973362135558293", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_973362138891626_8930418574887943116_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEvn2RPGTrwQ7kNvwHalEQn&_nc_oc=AdqVH815_uwcVBbReHvYgE6PD_vMQ0lHu6fVMx2mDjuZjDbnphHJGuxa-2qDVOMHWVA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPe4cccYcv_LhaI_olRQVWiKmjc2iY52SRxdkWUDejIQ&oe=6AC91B3D"}, "display_name": "TaVRn's Takedown - Naheulbeuk", "keywords": ["fight", "tavern", "brawl", "bar"], "long_description": "\n# Enter the tavern. Start a fight\n\n**Physics-based VR brawler**   \n\n Grab a stool, throw a mug, use anything you can reach. In TaVRn's Takedown, you physically punch, block, and brawl your way through chaotic fantasy taverns. Fists first. Strategy optional.\n\n{1312148514349398}\n\n**Real physics. Real impact.**\n\nRoom-scale VR combat that puts you inside the brawl. Duck, wind up, swing. You feel every hit, because you're actually throwing it.\n\n{1863868044180982}\n\n**Unlock wild powers every run**\n\nDrink magical brews after each run to unleash absurd abilities. \n\n{2944429129098038}\n\n**Voiced by the cast of Baldur's Gate 3**\n\nTim Downie, Andrew Wincott, Tracy Wiles, plus Luke Dale (Kingdome Come: Deliverance), Corin Nemec (Stargate SG-1) and Terrence Stone (Hearthstone). Yes, really.\n\n**Set in the Naheulbeuk universe**\n\nA cult French fantasy franchise, absurd humor, memorable characters, hidden references everywhere. No lore required to enjoy the chaos.\n\n\n**Step in. Swing first. Think never.**\n\n\n\n", "short_description": "Physics VR brawler - punch your way through fantasy taverns, unlock wild powers, and smash everything in sight. Starring voices from Baldur's Gate 3."}, {"images": {"nodes": [{"file_name": "NHBK_Logo_Medaillon-512x512.png", "id": "2644386802620941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_2644386805954274_7004892770017824157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJa-JnnIZjIQ7kNvwG6EUl1&_nc_oc=AdocahsPo7wy5ORS9PT4Pxifp6VOvUfJMQDKSnsk1kSmHDfPtuvzZLqN8J4fnliTA1g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqTHrBB1_Jemu_S4AuJHDGGOKX43UY4ORhKvtUMYB48Q&oe=6AC8F864"}, {"file_name": "CoverImageLandscape.png", "id": "2369550500129735", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_2369550503463068_7152466926173658340_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dko-7mQ80f4Q7kNvwFat7b-&_nc_oc=AdrFovLnwcu8DzhQpAOQZiwAbZXInuE35v_qpy8tugOvLPecEM8S8tiqSCN2WeedfC4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKRqBPeFZ5h9A_83Bm0B1rb1DlRL6xPUUwLtLnunwPqw&oe=6AC8F7BC"}, {"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "1760414508271169", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1760414511604502_6891267850168896373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCq2g_-4zHYQ7kNvwE92Bxk&_nc_oc=Adqkjy-_CEQX3z1tcsN2Hm4I5abI30tycjMPPEvf0pSLaC5Cj5tn
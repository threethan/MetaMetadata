ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-70QImGaHYQ7kNvwEyvw-k&_nc_oc=AdpKLUSGt4eYL7jiZfTYsKMRijfu9U4lmjNratQ9hPktlsk5PGgPwei1LYP6AnJOgng&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtBFp2nPmFg-UZjWZ-zQTiBSOMOQXUszt00S7rjSJwSQ&oe=6AF9C344"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR35eeoZCEoQ7kNvwGti79h&_nc_oc=AdrVfKjS9DWb4n6jy2IuydOXQYP86v6ip8hKQRmfwVE1nN3jzv0AwOm-Voip3joTz9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToEM6pKsixPj1ty_QlPdT4mRxIwLdq0KCWXcv28xuZ5w&oe=6AF9D5DD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFAOnZiQ4QwQ7kNvwG_cnI_&_nc_oc=AdqQ6yfjT1fK93KkwOtile4KgvfpnRECQqHcYKzd1SCHmhI2njJqebtvcwtBZvCcnMw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTef_dOrQ3zUBADNkENEZqDBOpiNu3tN32ddqsJcQCyZg&oe=6AF9CB1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWBOJMfrEesQ7kNvwEjO59r&_nc_oc=Adr2AsBE7ciWKikW9Du1v9fnDDk-GUqnrsKU4Kiv0Yk6JYHRilJ6DB0T08zlbZxzJgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO0MnjzrvH3Y5YoaJy3ijEJ-4x-j-Rs60d_c6bs74bLw&oe=6AF9E2E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WYy01_nyeEQ7kNvwHcmMmi&_nc_oc=AdpsQyc1aX4hriu4R7DPfuxhA0rwrk-Kmu9k8jXdlH_QVD0QZP1SVMqd02YS76ia7Q8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbz-e87KbOj6sFccDu9H0kOqF9WJw70-iJxbneKibKvA&oe=6AF9D481"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmRnu1I3KWgQ7kNvwHFInzR&_nc_oc=AdqVn_vMHBlqxSPnEQGdfzq9_xVG9nhMMAQMEQVy6XM2rYBtmcENVPlYbSg-7wyAsMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqx-DcZpJ3TLd77S4qNzZNyTc9iJWzu_tfWQPacwHrig&oe=6AF9DAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfMoOijZYkYQ7kNvwFykMOn&_nc_oc=Adr9Q83eOXIPniFoOZihu4ywQvxNwwu3gf0TmiyBG-6kV3ivZh6zKbIowm207GaOPhc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNFHy48Ul7i3X2SdgAPy-BTDzuCUdL3ACFOV1AvLox6Q&oe=6AF9C29B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLXN6EKlVk0Q7kNvwGdWUqS&_nc_oc=AdqiWtHXOTNw11b5pu4Wq_nv3CbW3OavKuVVRvz3MPFY08fC6y4g_qTpUc81zKIi444&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnMZHrihmHhzrCS8l7vHSnqa4zqS7GC-QX_5Z-Kqsa4w&oe=6AE20844"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hu6AWWIKmIQ7kNvwEMpBNp&_nc_oc=Ado2IGXAC0WWzXeBQLlcdfzdmWDcVqlkx54bLJXIZEYqX52EyNjo3tTEHQcg4y_O2ys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkp94ZqBjnxxd1iVIOispO-cWSs_IFCnb9yq1VGFuBsA&oe=6AE21ADD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIkesfAtjuMQ7kNvwFI9Ru5&_nc_oc=Adooz-_U0RkHkSEXZj6-hKicjgZ74CRA6FNikTujT6GyYGfXHr043JoQqo6AnTPlOlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcHQeDDXlorkjSQZtBd-6lsmxlGXrNyWC4SFwQyb_ClQ&oe=6AE2101A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tlkn7HFoBYQ7kNvwGVBBEm&_nc_oc=AdoUHWT-ZO19JEgn33Ag-qkHJR-M0q-9olwPVoN486WSRjc7lVPILZv50Z5P2ZcdC8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQfEKqz9_2GQk_T_s3oNduppBoJyhXSVcnGn7nMxvGHQ&oe=6AE1EFA7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrOUvq5DmmwQ7kNvwF3ZFhJ&_nc_oc=Adrrh9ZICiQqQibJs4kKDoGWvdNo2AcgxS23GqslGnzQW1mKkvFg7Hx1ZCd6WWCGzcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGAYpVRVFuf5QINzPoKfkztl2JCuQTsNh9Y52Qk_vpTw&oe=6AE21981"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opXbA5pyo-YQ7kNvwE1g0Pi&_nc_oc=Adq7S-bxWZV-u5_Swedu6Z8zamMk8Q0w0pWB5vPSc1blyY8SZsrxgrtYk-PiN7Bd4M8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfOAdC-hA1YULlrEAZMwszJkpHhfw68RkNkRNb7CMsEw&oe=6AE1E7BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqHSckOTl5kQ7kNvwFJn0JN&_nc_oc=AdqL1KHK8q-QfRjEG00Q94mgFblDzZSu9gOQTtRDYnS6DnW_HzGCFhQ5p9SWsGOQUjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTMU8iHiw8gU0vip2t-YCEGT8K5-8ty9VWMtuamq5XcA&oe=6AE2079B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
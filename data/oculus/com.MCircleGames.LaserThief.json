-25/507823854_749234541248258_5284942602912148025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxBjuyywhucQ7kNvwHZLXzf&_nc_oc=AdoIP0jaL0f8uUSN4J7m49S_TqAgHiY3f1zbO5BMuF_LdFSaSbz1BaQ0O5vzZp323fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-cjxXma0yQjhwAP5z7U8OV_03ecOkF23OoMKGKjk8zA&oe=6AABEECF"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0knL1YTSYQ7kNvwFWx3Xe&_nc_oc=AdrJUbqrOrUOOGcHaIKGsVRuEjR2u4NThZjLXbjt3lEI8dcvAt6c8XQ75cxK0Tece6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1iLWTU4Nzt2xwSvIb4a17bLZCHZ5RktUgbtMKfCAT6w&oe=6AABF282"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sARCIoA5lBQQ7kNvwE22PVz&_nc_oc=Ado8gMwGx6jcNyOgtMWcU9tg7qOR3Pa6i_yR3NUk3dsVQ1v2WFQxS8JQ1jIwerhroT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWCcrGNHbpn9XLNaUoVFUw62tY-jWm9ziNK8xtEM-Ohg&oe=6AAC0C01"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsIyv1pr9EMQ7kNvwEv83w9&_nc_oc=AdpsYpnmSz_urDSv9J_CL6KCAOI2La7RdapYgSZpkcGJSRykWKpWCqtFQBCvtmyaPqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrtXDPZDPKfugsfXZZQREp67iX190SdrlICYjVakmDSw&oe=6AABE227"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7p9tKjI2ZYQ7kNvwH0cD4f&_nc_oc=AdpsaOo_pF8YMf55KaZYGwvKzTDUU0mwiXR2rtVeEQw6Z2Y0DhblB5tmIShB1CNfmzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDscHoNk_MZDtuhiYk7NzUOWy40RrSOBTqzvJ0YhmhhA&oe=6AABF0FC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLKAi385bgoQ7kNvwHE5WC0&_nc_oc=AdrNbVtdiCBwePc0SExBMfVbL92k8WNGE5q9Uq1TZlt6dbFBprf3k7sJyfjpKF97mXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW8459y1RBnaezCqhlKn_PXOF1epqXN1aTWjuLmiyhgA&oe=6AAC0D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2GexxIP67YQ7kNvwHugWVo&_nc_oc=Adp1tKkvjjJ4u-TWlp4E3Ck5sg-1mN2CD1XB83o2UdYhUSpYMnAJ1eDmUZj75LXWFtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV8EBQYExs5-hgJ3T-eFUNlDBPtshNXIobysONXBIdzA&oe=6AABFA1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "su
11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJc8We3BsV0Q7kNvwF_LWdh&_nc_oc=Adm2TZqQNGpyg3DxuthBpiGAraVE-wGQnsiV17vCMl8-vIOzchwMFBCyJ5krmqC6CQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvjiZuPLNNd62OlLffQ_g3fQingB8QZzhlu_Th4WPiquQ&oe=69A44682"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iMAKadyyzAQ7kNvwGJvPpa&_nc_oc=AdkUWUYbwNEVR1YmL-LuCOxu6KIO6ljn5oRVu4lrbASYSuFpN6pP0tMCq-0rMRuyRzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfukZc0Q7ol4M1RtoC1DSGVnej2JqX0T-yClZX108QyPcQ&oe=69A427C1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xv7uGJ7ogMQ7kNvwHUXskg&_nc_oc=AdmIhtQCUYPUC924d5lToRu52-3y4MolmSCbQYoYCNZoWGD6RnHtcUEEOK3PLquugg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvbh20TMYItKDEKQjECTzr0_Bs6C2C6srBWvmGVvzS-bg&oe=69A43627"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPFm2XSfaFIQ7kNvwFRfMDf&_nc_oc=Adn1wJFMxJ6xVwWF9gk55i6g3GatM7DHzNqPuJy31IGkVtvJiu3hcNxQyqtQlUKlx5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsNZ8UP6-KOmY2VT2r8iqeQusCUXHiZQ3aLRdHOIeuY5Q&oe=69A444FC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU5mq9uBGuwQ7kNvwHSBJkU&_nc_oc=AdkBZz6C0Fdw02yxWEcr43zRSH8hByg0GxQearG5HBYWSyL-JjHJ5f3_PnxR3DaX1vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuLahuzKV8BkJexZ-C6KH7Q9o0uIfxTVWbG7-1CYDKpeg&oe=69A4291D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abWVoXwBZcMQ7kNvwG3xUoy&_nc_oc=AdmoNfB3QoqdoMP0JtWC15t3Upe_dBMqDORw1Rs3z02aGfBqQgBptM85WHfquXJNf8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs2ffQ7uweoR2OUfPsoz5J_FGTu2i1wT7xKL7CBl2JX2g&oe=69A44E1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE6WUiM3Mh4Q7kNvwGvXmbY&_nc_oc=AdnWInVJt79SOYcUb0r5au8UdifUljxPgcfQ6qdP4nAxQw5LyOphic0-uGLp5hhCsOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvyyt3L0lByzUf6DCapm-b6o-K0oAnbwdWZawqGM0iKKg&oe=69A44A1B"}, "is_concept":
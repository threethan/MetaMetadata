_oc=AdpzsbVU3d7vTAByVxSZlHr9ALQ01KS1XPjws2NRA8cL73EgUDycWa9LvHQfCBzhdOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BEj42DVBVZGR8UizxiBqv5g4-VYECp5qPhBiVMB-1yA&oe=69DF964F"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAL2LNdNQhAQ7kNvwG7z1qs&_nc_oc=AdqqxtyTfXjdnWXBBMN_DRR2JFrLlmKDw49-O8F03_E7d0urD5CHEhxYQnT4yoaqFqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t8kOFoE-ZsC_ImyFywFSpG65NgM4KP_FX2ql-TGLQwg&oe=69DF9A02"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v_0HeY_H_0Q7kNvwHvRzHz&_nc_oc=Adqg8QUSWG6I_8WscUjN4u4xieHuFlsxpPcwkPT01q22bd1vxBZEcDkAD1wY00TBrwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29azeCJqJxtMRFzakQsymhDSIEGMpr3NSE-xhzQJYSTA&oe=69DF7B41"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0hLELLyngkQ7kNvwFff8-D&_nc_oc=AdrAIHx57RSHxJobsLlYJqRPkkrChDdWRy0Kwk5uXPTbp6QGRkznt8FMCoZO1t1cWe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_RsUzAXAuaktuVdg6qvVZkvsmS6xEhwDLAGym1HJ3cw&oe=69DF89A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-eNdJp33j8Q7kNvwHsh1TY&_nc_oc=AdraDG5im4IFEl6_tY5h-Up7n9S4VvSPGCP3QMjjOEWwP2kHbYas9stHF7SGBIwnVCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uveWgtgs1FFX6KCM1cuc1CSos4gAX24F1ae5boQGn5w&oe=69DF987C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRiUZqDaQN0Q7kNvwFlzQtR&_nc_oc=Adq5Bbr17ER_cEppSp6ugiS9FaiJ6TwIXbN77uljQ6zo6R_BHJOXdTy0uLrF7XREpQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k4_qcTZP-sI9iYzGu0Dq7EZm-Eja5mgOJKSytfWiyVg&oe=69DF7C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R2okDInmZ4Q7kNvwFRYeOS&_nc_oc=AdoWkpQXwkMspe_md-_OV6QOtbE5Pu9M4tS6DwpTpthB9Ku8-Uw2Uab4_2CfoZj0eOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o8FzKwVoRO_yjjrt7QmQb3ltJOLTCaWc-y8EGZxBWkg&oe=69DFA19B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276
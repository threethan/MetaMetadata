ng", "id": "545808301751962", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974477_545808305085295_1031268306104307207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG3jL5RkyYcQ7kNvwEWqFMq&_nc_oc=AdlPBFWNOH6Euyhu26rl7t4ttJFCP8SJJxzOwtYix_ahopTJc4kVskoIzPvTvLkF0nA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXXmWmCaFP4WoJWqAylfGwVGay-PCwe85eDxU1jrKjPA&oe=69A42CC0"}, {"file_name": "3000x900_version2.png", "id": "463692662900477", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974777_463692666233810_3328940693686505984_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wizi2j8bvgQ7kNvwEkpo4d&_nc_oc=AdkPikDAnnKz32mQCtDKl50icYIm_dpBBTaxWY7JZoiVCB5_timG0fnXQVG0qULOCX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvAPKH0pSWDsBQXLMMEJQN0k1fNsh-oKZxbPceaJO1qkw&oe=69A41F43"}]}, "id": "1078393417148212", "locale": "en_US", "screenshots": [{"file_name": "2_highRes.png", "id": "443445362127668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556279_443445365461001_2354796727794151394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95UMOz7rMakQ7kNvwH4MDr6&_nc_oc=AdlBHO26GxaRowJUXvdm_Z9kS4n32D1ZsQr5zDhiYWY4vZz4ebfgsKz3mzlPGhbm8ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvdKFcg72d6I5xp-tmK7TkpnZLZGBf470M-H-HZ40bb5Q&oe=69A43CC4"}, {"file_name": "3_highRes.png", "id": "4736066316619347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0qD4Q1igPUQ7kNvwFjY-UC&_nc_oc=AdnBmRdmazWNpaRgqr6Av4_YTQFV3KU7pnwUY9W6MHk9nRSU_TSJDMulCNU0oWhdCYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumTQtRQXB9cZ6fw6VHNoN8rxHzcb6U8TSaMMCyzNNNXg&oe=69A432DB"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18IP_RKoGoQ7kNvwFQzuSm&_nc_oc=AdlvuYYaZPfOwyepv-vy4U1PYSa5BCKJU7PPTfr3UWXniNe1AOHX-FCQXT4CvDuXynw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvVb5vYcZAhKfSmVyOQ36CmuyTZWk7lj1yi193lLsxSsw&oe=69A4393E"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRhwq2BBRDUQ7kNvwEEAiqj&_nc_oc=AdnEWboACYaZLtVc-cSLypMft-Pwpjl5WcOolJPFNMV6qHyzzDPGxf4T8SZ3i4YUM08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAIqLF3Yk29lmA4eyy3ssGmvyAsTUopTldHcvhrW-Dhg&oe=69A43FF8"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLv4VN1SGmcQ7kNvwE2TNN1&_nc_oc=AdmfTod2rxPyJu1bXKdAwaNYTJnfI7-dyDrIxf7Kvgch1Eby4soCtgyMUQ2tADBwOew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv2Frbvb4X2JnE4Be2fgZj9apDS58UHMP_zFb9jF1JCPg&oe=69A44E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81V7rg99fegQ7kNvwGdtKrA&_nc_oc=AdmvPf5TJPVwFC4J7_j4DQb228Ozis79_f2DCMMLz6zphKo2VAB196MJeelpDYsAlqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvGIW9nPHmY1SRA0gqf24wczTEsTUJY8MoLpx3YaUgnHg&oe=69A422EA"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThi
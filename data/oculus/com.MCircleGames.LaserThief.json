11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbTy8MnBN-YQ7kNvwFDXsC7&_nc_oc=AdkSXDu8sMXbgRhHrzGr3zOtwSy3Fe2C030uck5RQFpYjGw821-5j3GQclqsgGdgb6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5rDqs3bZ7xb1pwbdqSaGLAzZy8vGBXDyXnzJLCLR0Qw&oe=69A05202"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3HXT70br8Q7kNvwGdN0Ha&_nc_oc=AdnVY2sxoqX6ZMSu7JGE5T1nOqy5Y7VH94BoUW43uno-pRrTztfNuxd9iOiOfbOy0kY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHsoRBW2NrWZ2eijtSoh1hYHafvtOrZLCH6Vr14hBunA&oe=69A03341"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyO9ve11wiMQ7kNvwFhuQU5&_nc_oc=AdlFzgT10XQAKbLuOVxQw-wlkGVwRer2h5yDp_km6T4Nt1mAYAi7j-oIPYQdKzTovfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJZGm1BP6OY0Z-iKf0cNIA4btgcGMs9Ctmh_y7uxSz8g&oe=69A041A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBrM8MXcGwAQ7kNvwGsNIES&_nc_oc=AdnbAJaY-yHE2By2x2Fq9l5MISxf7bkVF3sIxmKK9Vf7Rz8KEZWa8On3PhSfZxL8xOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj7M3mbbl2pMDh2uWN0fAPDP5YeTYxeKLlWTmX4qBkaw&oe=69A0507C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IttDn9PWtBsQ7kNvwGhCKTs&_nc_oc=AdkPia8zLrvvT0HSUdJJsvmMtegPLrtSSFpTWZrdWsSGpESC1dxHV5_JdGhPovlfknU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGG5bFkXUM0EaQm3q_nbIFqRHk7nUPdtVBfBUZdAjKWA&oe=69A0349D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPAmRBeJF7kQ7kNvwFZ9CN1&_nc_oc=AdlbgLKyzv9s6qp4O-zht9zE1X1lDCnJbey0EAUrv_dWr1ATQ9hJwcDOvwiPR8vHlFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyI6eULMZzN3DEDqqM9ANFiW8Ui1qGcFYzQWUbgF7gfA&oe=69A0599B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsYh-PukteUQ7kNvwEwXypS&_nc_oc=Adkd0yxH4AVUZ0b8l7yMFkfl3lbhi1V_CW2-HZWc9pF-keLemUo9HuB7oTA4jWWQU3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftezKuthijAgIKKvLHDGOr4bkfFTWC1Mq4v5HHSEVrjkQ&oe=69A0559B"}, "is_concept":
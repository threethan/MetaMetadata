ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWn2RfCFUCsQ7kNvwHsyguJ&_nc_oc=AdozpQ-v_RrZ8b8C3YT9fkflQfnDCO_z4Pd7-weUS0I_7qaonkV60cw18eYk6Xob7oY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY0XffPSFyb5QdBV0U4fhHY1QwiuUfV7H44kHCjj2hPA&oe=6AD387C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd8wO20N8BEQ7kNvwFphSCG&_nc_oc=AdqOVPuTj_Uz7FQMTJTVaBmAwIDxwtiF3esF3Ck9W_xQTuZIo9BcecnFAsune02mpyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0mokVvQe84kpnSWQ9zBsb4lUodfX-xE9leKD7xjCzOg&oe=6AD39A5D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLgH8R2CwLAQ7kNvwEg5-5V&_nc_oc=AdpDO2DSfp85pJUgJbjF3YK7C3DblPFg8rWSn9FAzlr5wkjz9jVgeKZbRC8nrdZF1M4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR_ewuC_vQDpMLkZec_jZMW-qxDLLCJNyB5r_mYRYsOQ&oe=6AD38F9A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cNZXsyiZt0Q7kNvwFMMq7x&_nc_oc=AdoiIHVDFJy2FsV389cMdYwFG2EHRY2ib9dQmxClxOy_h2cKaZ1eTglznyL67bpE7Fc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXEOKYIg1xyDsftkp-MD-AeCyrk3sI_RrSW9eqYRrVVw&oe=6AD3A767"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnNT1zjNszUQ7kNvwH49W_k&_nc_oc=Adrlt_bsqatwQPDgEn3hHo_MWJoY3hZWRoa1KVwMtSlwtkvUxWuxm0tpQ2eCgVbc5_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0H9Rs0h0Psw8BbzCvSvniKEDagbx9O_ze-VFbOPQbbA&oe=6AD39901"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmRYLSYP8lQQ7kNvwHsxd1B&_nc_oc=AdpYexW2RDcnP7cS1INGIpkA77zCE_N4qdh0zdTocbsCMvjniRXuNYHuoXZmPUx8r2o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZcICm6axWDyA0ZEUaw3qd3VC3fUiq8RvPFeTShC96iw&oe=6AD39F7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx7KAeYEa8UQ7kNvwHY1x3g&_nc_oc=AdoI7sJ3VAU-k8BtFgC2nk31Re2hEDFUAt2wLAeh3O6an0nQs78lJQ7LwNvVRQrnSsM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc0ZglSKYUpSHk8ijY4FGo_iS8k8LDf3z1iMZY8DUCCQ&oe=6AD3871B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLXN6EKlVk0Q7kNvwF5TF6V&_nc_oc=AdpKMlimJQTEpq0L-sfnppEE7kU547wI6ZG_tEB1XiM-4ksyiiAfDopjgLHxH9ZmNQE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0WLMWbh9iTjbFKgCuL88O79u1NsalwAOJSjVAahUU-g&oe=6AE359C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hu6AWWIKmIQ7kNvwEUSieT&_nc_oc=Ado7zxI8f7HJG3rQT2QsQ6W9tQ78wKbQBD4Sa4sbf6L2G7yjywzJau9j20MWdhL5Iqg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGrDrZNxqiFvr_Tlr9MNPd1-QWWOnzlAHB_AnZgR-JRQ&oe=6AE36C5D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIkesfAtjuMQ7kNvwGeusU9&_nc_oc=AdqghvUIBHurxohuAFYr1NuIS6QOvjaSu1mGsyAfFhGJeGentta9hqUdOe7VjlFg3ZI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAadVG2_1eeoM5jUPMyEVWs1ta4j5uNqykAmiGLUeJvw&oe=6AE3619A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tlkn7HFoBYQ7kNvwGKdRWV&_nc_oc=AdpBE5nLWDyq-hbD50HCt6H0cNrZp8xzuP6BEFNt9VkKqwn7obVtbzM0dReTJUV-eBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5az9y0v7lfyTWTne11btCbFkezcNs7ZIiSD2AZWHxAg&oe=6AE34127"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heEZ_9CGDmoQ7kNvwEqWW1E&_nc_oc=AdreRH-G6DOx0EZYwuuYdyxkKhLKB2VNII9oRFkcZ_ib-2hl4MNnzrdHVS1m6k0-WH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPbvSpKxSt0sn5AjcPjva89fgb-oLwe_wMfZcS2Hwg8w&oe=6AE36B01"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opXbA5pyo-YQ7kNvwH7OJmk&_nc_oc=AdrChzDFjohiuOE_MaW4hWn8kyramHKzb8V8Del8Lqe8qnQwsCaO1K4h80fWacoYudk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFZOEIa9h-WzNZAgDY8YLjiBLGhk57ofua6knTQyswQ&oe=6AE3393D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqHSckOTl5kQ7kNvwFbQfu-&_nc_oc=Adq5EAPMBMy3tjCeb5pj_be_ofoIOdXGQdQK-m1KowQETKSuGadcoz81Bj_dYLM-lEo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2gKrdrmZ1P1ZD8yVtY-6kdhYLUtSbWD7sM5T1532GIg&oe=6AE3591B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
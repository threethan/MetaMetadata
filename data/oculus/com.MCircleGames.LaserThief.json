ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PYadK-f23QQ7kNvwFgBbjN&_nc_oc=AdpjXgkPHpFILVAra8lkLsU9tLo2njGOyrQ5820C4mFlnu3cCq9kvRneVOI5Ni3cU7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqkvuCsNfpSUWWplOtqa2EURXbFeTXz_mW84nT_RjNBQ&oe=6AE0B6C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hu6AWWIKmIQ7kNvwHUPTEM&_nc_oc=AdqaKmLduel4sTk-tkPyI9WSzm3M8w9PC2_dHoUnRUcsXwRumWKd8tKSs5O8gyEhBF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-TSs6gkSnknsdYvAFTalprN77au4TNtnob9p6EwLGHA&oe=6AE0C95D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIkesfAtjuMQ7kNvwHStg-i&_nc_oc=AdriJf8SB1T7tmsy0eOx3V2ua4kDOUeZMAAGHu_QRmEr-k1oTMmlYBo6m-r-V855zv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo0Glr9sYwzyOw8HIXYviKOdy5pgE8jHJdjdD_NSrRQw&oe=6AE0BE9A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tlkn7HFoBYQ7kNvwEyn_to&_nc_oc=AdrPK5EJ7uvR2E73U7Tla9s7bdJQ1ahPQuvbxSlxOfviYVG3nqFU0AylT03ptLv49qw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZdCZZpa-mNthe_37aks5xtLB1NgnhCaN4zgzFnYYrjQ&oe=6AE09E27"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrOUvq5DmmwQ7kNvwFodp7u&_nc_oc=Adq5gpnovYfir6bY5j1AabnbWtl-Ye5Tg8xdYL8AGxWd89tabBn-1uhF6mwmrdkiQGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRiZ5-0uLnlcSZKrvJd95VjJkrd9RigZDUCakG4huMDQ&oe=6AE0C801"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opXbA5pyo-YQ7kNvwFrzgJT&_nc_oc=Adp9iQeicdLPhm34YCUX2W_2X8UIugRD5eITYp0dAljWQN3EqAKU1dSqNYF7JzuRvf0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl17KGlyulIDAIcEBTgwPa7ZQG0BbeJwALITNNpPe1yQ&oe=6AE0CE7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqHSckOTl5kQ7kNvwGw5uQg&_nc_oc=Adry2G8bzZLuUGjnfkWrWcG5csN3TTcuFypRoNolvLJ7D90CNCZAJlWIyt3_umexAYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOifE-WujzovbPe1BMhkmUbJ6Q64XO2Eqw69Sskbgl7ug&oe=6AE0B61B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
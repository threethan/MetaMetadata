ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHLoCuwpzUQ7kNvwGOUt15&_nc_oc=AdraTJtqzeWTaHRZCGpBnXHg5ZP8fMtf9lmyBiKZSGlJEciC58ZmmFsmyHqMTdwcGec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-2ybiypofsJs1ygiHM0fXze16aoVTx6SzPjaXo4O27w&oe=6AEDE5C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr-iu8BDFIUQ7kNvwFoloQH&_nc_oc=AdpaX8fEnQEgeV-xvD7D2bQd_99Neui5iupI7DV9-L3IWuBiu3dWSGWRqDtXaBXWJiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuSfcsXkqbeYuYXsp8j9pNgsjVCXjtJaVhjBsQaybtRQ&oe=6AEDF85D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFqvpt_vXKwQ7kNvwEzNhCj&_nc_oc=AdpGNWe8GcXJK_PBy6C9mXvY4OPhBvRMGD79Io3SGB8LQUV4_kdRZ_NbQo30mlMk7Hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDNMIMTAdgC6W5VPtnlgnvKjLCP3c1uM-sfmckywf84g&oe=6AEDED9A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsEjjmdEXlgQ7kNvwGiN04e&_nc_oc=AdrvD3LPsCqzFSU6lVq3NcFhc8Yr0GIdlwt7jdw5GQ3ra7Jy7byR25Ou5zk1rhiypJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb9uIXj2fectNdJkKNBXP7rH71ZJ_NyUqCRT_iXOfJeA&oe=6AEE0567"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9_4j8ob5bAQ7kNvwE20FEM&_nc_oc=AdrWaX5VKWmYB4z_vyHDtFqFjyOQ7bAXle8j7398f8Kg3ODHNJ6Lvel3Sc0k-Tw25To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJhsHBCYtfIg9X1VceFdIJBBIEfM3GgzRJi00jCxdJNg&oe=6AEDF701"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdw3b4HVHI4Q7kNvwGFgy3p&_nc_oc=Adr676mMFKhrYRgPaADEJi5vDBFcGErR8XSVI7IvHXd8NJAv279GFFvklbz-GfbmtkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScSyl9WT8Yf79buAWJWD1p835NplFipsenavzjukYIBg&oe=6AEDFD7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e09HNg5Gqm8Q7kNvwGjrxEO&_nc_oc=Adp3CphjSuW9ZUS0www_TkYoz5MK37R8lFSu525UvEGLDHo0lqoOdQVogJ4Z-Pii7VI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-G_rp4lDcV6mYuQCoqujjzc1jwymn3dUGmvqJMg8cOQ&oe=6AEDE51B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
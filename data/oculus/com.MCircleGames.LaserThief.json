11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJc8We3BsV0Q7kNvwFfg3FX&_nc_oc=Adk8vDg9td5tAXu3LGTZULQSNepfJ0KASSbvJ3JwnliCKtM40TTDigoUBjAqxuHHTAY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfviANSquFVUlGZdQ3hqIP8yC6S3kFKyKPmPxEPFZEqkgQ&oe=69A1A382"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3HXT70br8Q7kNvwF8UsCb&_nc_oc=AdlSroGK6GWRLzBzfNPv4pmpYGsh5sx8JGW-9UWiZrCa6x9LFLs0XA4tkbnaldofAIQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsHtvLOQ3EEedbeOT-9PdoQEzsCl0IJnIEGyY3GHO-0Tg&oe=69A184C1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyO9ve11wiMQ7kNvwHlQ42x&_nc_oc=AdnaeMV4w8q-94fFm1U6LANbYv9h3nug0vTJtOl5C17aCX3G9KTpxD89GPeUYhy2Ebc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftJxNam4Ll8YZbVFijvkdxqJz6sY4V9PwhPnmJ2EhIo5Q&oe=69A19327"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPFm2XSfaFIQ7kNvwE7dk6F&_nc_oc=AdnC89Dny_Ru-46mT7SPxG9oOPuQDvnys8Qkl74OJTl4-5AqPMjik6XxSD3DUgSny5k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afuvym7HPhMjyrj8uXLWXWgfDBenAr0qgXjH5G2L7LfpyA&oe=69A1A1FC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IttDn9PWtBsQ7kNvwFloP1r&_nc_oc=AdmemtxSS2dQnkI6yFYmS33YS-CE_hPGIQ6--f0YNRSyqh0wvNgSF7hZTAmD32nxrW4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsgB7gA8i1Q8G8mIPLbtUFlmv98VQckpCGvhS3hSxFSWg&oe=69A1861D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPAmRBeJF7kQ7kNvwEJnSzg&_nc_oc=AdmOAiGt2SEHgbLGeXiAEnmTXPJMCBl1KIbjF7R_8GOKSqL0ZfP2p4NPg1b4YPK12MI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftpCY2vWfxFQ9ojijcC5FrOjS4t_BLhH9tTx9itjLYp1w&oe=69A1AB1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsYh-PukteUQ7kNvwGaCDYr&_nc_oc=Adm7k4lmwyIuBt5S63UekfugAo85muyTD68veHjn6CexjR-wxLHS7kjDhJEB9JHBbJo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu81t4bb8hY8tFtrDaTuPdmPFLaQIaocVkbriSioCtDeQ&oe=69A1A71B"}, "is_concept":
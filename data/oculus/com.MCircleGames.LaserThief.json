ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c98HpnPKsUsQ7kNvwEbZoiP&_nc_oc=Adq7gENH4lELk45a4D-yxdDV6bh_OqeqB-yMbJUeHypE0vqWqYKw13htvyK1xtMydME&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrOii3U_BLG8eZy_Cbp7Q-rQAqTfeQlYfW6jZyYPEE9A&oe=6AD0E4C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd8wO20N8BEQ7kNvwFS3kSn&_nc_oc=AdoeELtqiCleQltMAhpUDLP1dQOIXMvGpuEbI-hxx2CF9-Mio_3OV_hdA8RBxWpuOL8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLXpd3m-uBMg50DQP7FZErpuHi6KhMaU_mw_8pduPXsQ&oe=6AD0F75D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD-PHT2jvZgQ7kNvwHUeI8h&_nc_oc=Adqzgt5eBnySwsrV7o14fLktX8YWcagBm23g1CJ_BM-ICikCXlsTkHH0J9p-2D3bmvU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzRxW7srwvGLLboGkYxZp_Clqqjh6VsYAzdKyqJX3B7Q&oe=6AD0EC9A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cNZXsyiZt0Q7kNvwGELIW-&_nc_oc=AdpJakj8zQWfn6gDxD5B30CsoXZPfilbnzK3ja17IVb2iT4YxA0YT0oXl4px58Tvfvo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0ztplcAJKFSemKNrvyb-0ebwmb24zxqLAibx85Q6_AA&oe=6AD10467"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAqygIULsdQQ7kNvwEhHUR2&_nc_oc=Adq1ZkGBlzKjC_zrJM2EwKVmgBgmt_K7S2t33_5dwisQnMWycLxvLOmdZFj7GpBU9R4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDwOgInglhGW1r9gtbF6-vWf5Lajk4BycgulFuNMDsMg&oe=6AD0F601"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmRYLSYP8lQQ7kNvwEDvgHS&_nc_oc=AdpZNea0rRcL8GHufrgANQgQUlygODwAKwgsJadY-FAvcUBq-dDbPnMCJeLxRL1O3K4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvG5e8m4FRpXXgWFfd5S0U7Ld8SS9y3T_3FAPCK8vM0Q&oe=6AD0FC7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx7KAeYEa8UQ7kNvwF2lJrI&_nc_oc=Adr9zmrN8-45-cIjYDo0rOUymUGipJru-4e2Wdz5fjID_DfXoxgwt0UWUSujtA4iVWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU_52KX7wayfHcwi9-Nqky0mIaNLGx5rkqHzo8iKNvEg&oe=6AD0E41B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHLoCuwpzUQ7kNvwFJQFdk&_nc_oc=Adpb2CxJ8FWFLUcCohyclkju8ntie_joqIvI_KuPGL3T6unbzs4u0JmGg_dln9zJjPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3XWDxXQNFCDAkrUPLr2-gMa-067sc-_b0qcX36H3JcA&oe=6AEF3744"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr-iu8BDFIUQ7kNvwGvp4Qe&_nc_oc=AdrhFnky-pTq6Oxd53ADo-oZHyCgMmB1XAMrPHBtDt-cR8wAaA42JvEsss0EUq2-Nwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReqY8YEWfLmIl_bUvZaUnud1GPDNXj6s1d1cDUaI38Hg&oe=6AEF49DD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZwrjJXLwpQQ7kNvwHc-uiZ&_nc_oc=AdqCVdqjAJROIrPnNEM8YH_TP-WqNNJHXlVCVdfcUoRS5Y2ggtBv4wuLg8dnnqJuizk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQrYuJEWfRayS8PNkXZu1q_7eBYqHZukEGkCKNgFK3ng&oe=6AEF3F1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsEjjmdEXlgQ7kNvwGwokFl&_nc_oc=Adpjy6TqSidwqrkehaUEFHZrcSJu843XQbhc0xC2nxlzZIZkvdP0v1vgUaxbkuKh4_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2VBfbR9d6Ct7ID9qebY0P_z2KHNovwotvjZ7ASRm6Rw&oe=6AEF56E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUvrzTVt1_8Q7kNvwFDhPUZ&_nc_oc=AdrGfBSy3srnxZQAY68j-NMRCPWSuAacA6J7v4T8Co_Dp9cHs6g1suDjiM0VpMIuuKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBswwfZoFLl5m0dhG6EwfafnNWZfBlzaOCz3H4FJTNTw&oe=6AEF4881"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdw3b4HVHI4Q7kNvwH3Jdh3&_nc_oc=AdrlXZuoUSA8GLBoBlACMOT2jcQZbatCW7PHMHzMy20QtgKEUkOg2-KgBXtvCdZaQlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7GTUbwsA947GlopJQhX5R60WFO225sbOFjfe6r70rVA&oe=6AEF4EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e09HNg5Gqm8Q7kNvwGhstdk&_nc_oc=Adr7n1d1fZWzX8NWS3NEzJAJSF8E-hgfbuyuo4y6a3gplqf-mmdVJHiGykvsIVBJjDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC3-uwtQqIxAWfTwGX4XvNYuEVK9p4AO9PCoKxBbRTrQ&oe=6AEF369B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajHHkbCq_x4Q7kNvwFQCP7G&_nc_oc=AdpKhQqr4nSK0Ut9QtgUBD_J92RUp28ZONUvJ_q3X73FLyCujOdMUNmN0xLrTkrOtAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScoOAvIC2UfksEVv3GTaVJ2n2sZlfHqjw0Q4tpedo5Cg&oe=6AF32BC4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvOK9JJvIQIQ7kNvwEpeJSD&_nc_oc=Adp6_RAU_3s87yjcKPqlaLIAs833MYUrg6wgMZDljGdT4o4Sjgcp58ElwLGBGjQF0Ww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVrBorXT30-lZaoinYsQnIquy-ywmVmwxyvKkdxOIdmg&oe=6AF33E5D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2McNG9DuiAQ7kNvwFcZud8&_nc_oc=AdpotyBJC3sVo00-fykjYVJC8IWa4-ctMrC7ZembG_Wh47awd5o42J1PxO-AUcrSkL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-sOgU2tEt8iXCHLyaVOZSZByubottDUoCOG-ADKQy0Q&oe=6AF3339A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdL6CMTXUpgQ7kNvwGHjqLq&_nc_oc=AdopHnwJrel_RFZchPS6YLcgpKQ1tLg-LIt2XYDGxTJVgRu5nifOANBCttRZLe7YhF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR91qZisOZ7cs_QBC2SaObpSMsj83X6zluCeVVgy4YkAA&oe=6AF34B67"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXO2URN1XS8Q7kNvwG-Pqu_&_nc_oc=Adrpjopqotoa8XGQMkULMQzsgjHM08_1vo2D2KiAXK_aksJWjN0km20hhX0awmGPnwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwBHvlmI6s1E9UyUS-TLXG16khKfNOq11PHCs3FDSgSA&oe=6AF33D01"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6D6Dgx4qPAQ7kNvwHQ50ax&_nc_oc=Adpdm60RA8vfWEiGat0TxEOmJi-ZElWa3OOAxyBTCAdyQ2FMAMhG5w2or5jaVDoPGh4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSreVWIMv1IzQbWvM7vzdKy7I0ygDOr1L3NnBGJtjyLlw&oe=6AF3437D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7dpB4dGvcoQ7kNvwFlaWjy&_nc_oc=Adq9nle9ZjkZnjLfazJK2UZKl64oIB9NHiH-r_IKPeGG0Q3pq3oD4XafYRy6gMfuuu8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdTEKzSxHLCWjO_FkpcmXA5hurYfviD2eljKpK8V8ETw&oe=6AF32B1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbTy8MnBN-YQ7kNvwE3YnAI&_nc_oc=AdmrPEBOyk-KBaLQh0EZrpXnFqVoBqPYyU0VGgQc54OBk-ifv0OA7Gz2BsXmrJiJBC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZRvNwibL7kSWjxm-GoL8eMuFhhXwiEn1yhyfd1DjhFg&oe=699F0082"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U3HXT70br8Q7kNvwHFOkHZ&_nc_oc=AdlNIElnfHPCSKoebzKjM4AKXHPOpbr0PXgghNsZuig6dGOQhN9NU4_3xM1772-5J_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXTMwef8HuHzajLsbE_j-fWcWj-qjf1maLoxsyPPXfQA&oe=699EE1C1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_6eb3rYHpoQ7kNvwHf5knE&_nc_oc=AdkZ2O0bkSNR3m68xR4_5ahTY2bL4keQ1yGAFmwhnsxAbCf1_4EiNTwBFBjIkC8XRzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu9fkaWpA0_K3OpksW8Zt3GLeasqvHzpkcN5OnVCKM_iw&oe=699EF027"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBrM8MXcGwAQ7kNvwHRvuNf&_nc_oc=Adl5eil6UyWtKQOpszlKa_BTv4ohwbWX_Dlr0cHZZDCmgDkPtswKj1hVpn_ODkBEFJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_qjCBr81gO-4m4g358a49DnztKVimjQ_ZPiLj6e8wbQ&oe=699EFEFC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB0zaaxoqvEQ7kNvwEyzK8r&_nc_oc=AdltvESNu-aoBpGTrMfa7YejSLYEbkEiBYRlIqJXIKLL8VP87SHmWAiXI3zo-h1NYf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsmBuXha0pZL4jqya74lcFYR41UnMIggk6c2p_hT73TQg&oe=699EE31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EYwY-XxEWsQ7kNvwEGOYo7&_nc_oc=AdkiQtxB3C3V4iFJDptQrAEzrXM0JEUfZfn9jA1ZaIaZ6Z7AVR4ZRUOL76oVppcnu-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft9W2k5zTWXq_Y7eaJ_AG5aEIa6Wp4tI9LAwlaTZrKWyg&oe=699ECFDB"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7lkmdX8zHkQ7kNvwFGpl4P&_nc_oc=AdnX1gE19ncglgTgV_rnFyCQLm7otIY3yLxknlfY0I4Fo8807ZWw3vq3X9c7fTvtpmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXB77r72IpqJyPQ5-v0oeLCB9o9HIt8FMFrF_iD64QbQ&oe=699F041B"}, "is_concept":
25462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBz24yHKnvUQ7kNvwEBo2xR&_nc_oc=Adrztcqua2WNeyITYvv_4lmwzKCIsz6W9w2FaUjp9nkniR3Jv1xs8DJOiUlcgGWnWkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo8GShmzMQr8aIOI6Rt9U18s6MP9swXl4561lkMcW6YA&oe=6B06FA1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofSkKRSpdgUQ7kNvwHRmXo8&_nc_oc=AdrQOuNPMKu-_A0P3GXlg8lb_AYFVS_QARdF1_kqsqrxaFtNfnnjHymH102KmlnVgKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJbLbIBALi8C1vKT1xilyNMdD2ePveZbwZwgPbOcGhJw&oe=6B0711E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgSjUtDEQ9gQ7kNvwHt9e0G&_nc_oc=AdrpcgLdECSqFwRMEzO6C7xcX35v0ff87LJ2sM2XALQT3txFnwdIVTCn8_qPhEiLMNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZFlSAeqXxbMvw3IyzwrEhOQ40Gy5DmtsTM2OOyArwfw&oe=6B070381"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhT9tG1MBuMQ7kNvwHVvzbK&_nc_oc=AdqPI4krBMN1TVxxFmQz2zJLqaMRyQ-Yd79nG7Rwgoa34Y9Au9GMXgfq0XyAtJvlxPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUdFO01pfyyMGc2XK4bxlE3ld2nxoFLAmXllOrHPR_Xg&oe=6B0709FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir5Ifn1yvAIQ7kNvwEEdSEd&_nc_oc=Adovm_NnDLJQ6ySUOv55cv1fS1hQxCvEaj7HyIfvDsL8oAKYafszajI2U7dOwsE_cEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuShM1jCBzLja0dBAadkuZvFpp0gXnggOv6_yBg6Fk-g&oe=6B0729DB"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28505012289095196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfpkSX4UxUYQ7kNvwHpzLLF&_nc_oc=AdriKSJQlV1shFz4JNIExAtxgfv1-tFXwiRutVdfudtTqhV63BkETnRSuzi2u7rIgtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw6Vb4L-2q-HNuky8-080btjuGf42M_4qzZMppJ0Zkgw&oe=6B0725DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laser Thief", "platform": "ANDROID_6DOF", "context_
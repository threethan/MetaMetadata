ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63Yx1wLjbbMQ7kNvwG-YHeY&_nc_oc=AdrV7o4XmQkmE-dWoMEnxR45fWGKgpNLtgyH95VmNZMO2MUanPENBTkVwoLTHC3uddA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTfmmAABB5hHFfHd18z8UvhHUOUqU0ku506rrGZrzlbw&oe=6AE89FC4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb7kcd-58dwQ7kNvwGFzdzY&_nc_oc=AdofOSor09z1KNLeBCDig_RPqV3UtT8KjYI3ikXxwuwNJO2J1c67u5_m7m7VgpSrXlk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLsGawWEZJpVU_zmusLCHyFRBr9593Pfk4tkgWzHjHbA&oe=6AE8B25D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHLudHvdsuIQ7kNvwHm9mAL&_nc_oc=AdrxA-3wPQQCsAXOe00P0VQWlokOpNQFOl8SsxzDFVEt1lt_pyFpuG39HT6pfzymEl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Ax3gc-PJLVZ-FPHs_PWe80n7gWb4CkoTMkLpFEa0jg&oe=6AE8A79A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHeClSMtpnUQ7kNvwGI9SPo&_nc_oc=Adpa-D2r1obdMucBnGC9EYf2qNPA20ZQyZwQ6t4dzBDPMu9WnTgfbCCbgKEoT65Axy0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrJsFJyhQplhPpP7JxR-cAzZcTCErN0wL39Sjud-Sy8w&oe=6AE8BF67"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kak3nikAC1oQ7kNvwHwgo6b&_nc_oc=AdohvYxf1Tjh38Riowq212hpVDVuHuuKn0hSC4xLNxhXV0MBEa0qsXPWFyeLqHLi0G0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfe4CN3Y2zGnAIC_YnQgar6MZfJgD_ntKFTvMnPe5gQw&oe=6AE8B101"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps2r-tULQC8Q7kNvwFoyrRI&_nc_oc=AdoSakk7R1vbU_j1EySkt_Y3p8c9pll5dw8TInaoPer1OW_D7fAP3K2tWsqrfM_bbUY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQECCYBAhUVOpfJGi3C4Ox8FscUmLZzcEpaHlRXUel15A&oe=6AE8B77D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IiROKPO_1QQ7kNvwFUjCR3&_nc_oc=Ado9daBIjcyZTqz8Xqdtac-oE0tGXn1fMpbcl-IE6eEh7_JbtK6dwYjKcWl3mLHgXq4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_UsazASaOUg2evrNQgUcWwNgU440RVPSYhHng3TeFfw&oe=6AE89F1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
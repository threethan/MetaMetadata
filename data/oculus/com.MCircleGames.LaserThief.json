25462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXOX3qN3Tx0Q7kNvwHvQeEZ&_nc_oc=AdqgbFN0_gRvFzoNPCiqInnDIFAtlVqm2Md0VroqX26s_52mrQgxowbybi5TiPK7ULk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWj0RLds2UearFq0ATkUpLObPoZH5RUTIfXKMO7nW1kZA&oe=6B10349A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl0jZbKw4QMQ7kNvwH_1X_b&_nc_oc=AdrUZVPX95IzzBvyBvO8j9DRwRctzzG0uYMztTFnfNeEi_H_r1r3b0OC5MQg_N5CBxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW90gZ3I-KRGoe97c1ckrpVsjLpOnLllRAoW6y8nTTz-A&oe=6B104C67"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IRuQgc6y3MQ7kNvwHODpC1&_nc_oc=Adpu6zPcCYQd2adkKcik0Z8B8FGzhB-nxxmRMROmuPeMaOmCwI16jk3dWXQFEmT6mbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV4sYRLjAMF2kv3W9NkO3VsKW_apypWz3g3NjQ9sRQaw&oe=6B103E01"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuSemRiLs-oQ7kNvwFiCTMM&_nc_oc=AdoZypY5EPxlf7CogOpPMOIIDQLCrcQO1_KWiVGlgOUj30ZRNlKSCRgEmDxyLJD7EMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfeK7iVMQ5GHbah9YlYjvrRW8KbqXQ2qvRa-fNpFJqAg&oe=6B10447D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Npy5uGc08MQ7kNvwEWV9il&_nc_oc=AdonPYfeIkSyqfv6kWVzi8CbLXHdGi_SvHo79JL-EsyXNe2SJ_ugBhca114KaSGuBdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOyDds8krgFtiJ-emUyf1_F4ps3Fz0C0UMJaDukW02eQ&oe=6B10645B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28505012289095196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYj_fLJzieAQ7kNvwGlLh3U&_nc_oc=Adq6EvK74HGHr1arjey5QqwQtxVm0EfTyxnv7qQspcbfZCVgsF6LJkOLu6CTZDmM6gU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgVwq8kUzyhkgsM8Vp_ovzaxYuP1ewRku9khgiiro_cQ&oe=6B10605B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laser Thief", "platform": "ANDROID_6DOF", "context_
m&_nc_ss=8&oh=00_AfuLzpESx_3EsWcazpbzx568DnxzcgOCgJZcF88ZlY75Uw&oe=69A8374F"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqTL0iYr2fsQ7kNvwHWDc-a&_nc_oc=Adk_4hfwYxuA8ZQzecq7Vf2aJbfixVc6XirTef5mOcSrhdJPCtOoZEzq5CscBt4-Ge4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftmlztfZzDlU8-WzxJnQ4RyJdjKJW3-XvccUrFp-8MaIA&oe=69A83B02"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zOJlkiJc-0Q7kNvwFr2527&_nc_oc=AdlAxs6C1l11gh38q0CciL9IaqlFeKc_06Mevd7T7d540XsasFSXyRcWXbtRCxyWu_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsorST-IAuQ3_uxmZlRc3MXXDSVlGOuhuVZgBlh9OjpFg&oe=69A81C41"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR5vHlztna8Q7kNvwFjki8J&_nc_oc=AdlOFXMbzEAtrxG-gneTfJbXqzDbxoi44uld-OZGuncrsXjLBXlhky3OfwI318sh6DA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKOGJbpFMjIp_qJkIiWIzL2Gs93kHKvM1h36pgcFKf9A&oe=69A82AA7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y901CYQwAMQ7kNvwHbOKza&_nc_oc=Adlas1ppotcKISdZ-OKNfEESj3HxuN1XB4KnEpPDF-gsRF7F3V3tBaMwzTmu5p_xV7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv382rt8o83mnL0PZtUYZxF3PT9hu7l_HyGswT1-EZ-Wg&oe=69A8397C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgnCczuUwOEQ7kNvwEvfpLX&_nc_oc=AdkfSqamq50-MFy_EAiYsTHS-64jP5LkfRFvCTSFyAR69W_rogMJUpSipgZp-4UZXc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvY25sTbjb1qUVr3boa15mb9OvJa1v8W9p5rQM-H48ipg&oe=69A81D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa69fUshOxIQ7kNvwGRQo8x&_nc_oc=AdmjicT4c-GTDC7UzEQmEIquDMbpNJixFecScIS7sjMog4nfaSfiVoyXugMfxqy-f3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYNsjdCMWjdsAN5tZf1zrCD9fL7wMRac_nGU5kdpGAdQ&oe=69A80A5B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499315359_127313640
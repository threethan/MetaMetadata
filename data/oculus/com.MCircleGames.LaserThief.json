&_nc_sid=6e7a0a&_nc_ohc=htFfahycvnAQ7kNvwHpDWc0&_nc_oc=AdpRdmFciOSZhV9hwQD6X10rpA4AnbNhx4gYVNvxLfanrP7U8rE69wBXvWOP2pAQqNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3A9j455JUZWn3gPDmI_hARKuuBWq602zH_f0mvN3-_8w&oe=69F0B03E"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSS4T27Lwx8Q7kNvwFArX4w&_nc_oc=Adoakxg87ECDj_lTKggl--GHnx5WXmit3oSZREJaE9iJxmA_On0pwVI2EGvrR66tysg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1OAWJ9CtwlnnXb4X0Av51fH97bDTv-3ENXLAf7dipntA&oe=69F0B6F8"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnVaSA1DpikQ7kNvwEA2Zdy&_nc_oc=Adrcta_7Ca8TL1DFShZFfFRSYkagSEtYtpqd4rh9Hk26V546xMpp239ErrHnl_vH5Fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08_IIpwABYXZAWCAk1xjnI52NsJvVcFvsJm6f-Uv-JCA&oe=69F0C565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS43rI8Ec08Q7kNvwGpk2zl&_nc_oc=Adr2Ntr9s2Ok473WGlQQ9eYOFw-ry-P16toAX2G0jfcepxJ3L6eFJ7rZ5A9W7d69w-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Bu3S0R95dyvlViLU03P8t-JZhwWnLBdogJOIwS_E7Mw&oe=69F0D22A"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8793536314002753"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1024213449904383"}, {"status": "PUBLISHED", "id": "1124593239661971"}, {"status": "PUBLISHED", "id": "2389540991460996"}, {"status": "PUBLISHED", "id": "1161083548930744"}, {"status": "PUBLISHED", "id": "1967563697348499"}, {"status": "PUBLISHED", "id": "715297811442186"}, {"status": "PUBLISHED", "id": "1154310359438377"}, {"status": "PUBLISHED", "id": "1375771556753006"}, {"status": "PUBLISHED", "id": "1192341479117824"}, {"status": "PUBLISHED", "id": "931738599013978"}, {"status": "PUBLISHED", "id": "1118898076501913"}]}, "baseline_offer": {"id": "1124593239661971"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1024213449904383"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26728996423363467", "version": "1.0"}, "id": "1071044161244069", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
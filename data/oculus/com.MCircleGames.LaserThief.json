ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHLoCuwpzUQ7kNvwFMfD35&_nc_oc=Ado5VA6m_bN3plZu118ZPvBFHEv4nTbRqkny9xoqlQpEExne8JRK8-HPiRdA7m0V_5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUHNrUNAJwJ1CtOhMaVpBrLXAe4BPcQzO1i2Dy_VWxpQ&oe=6AF088C4"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvOK9JJvIQIQ7kNvwHBb_r_&_nc_oc=AdqoYgL9vrJ81e05Y13lpm4XAAHST7NnPiGlD8GMUL0FAzrXAqvp8j6l3XTqZq_IHIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGUbPPb_2VN5C1FtjLCtvvbXxGo3ihksy7CqXZtyeTtw&oe=6AF09B5D"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZwrjJXLwpQQ7kNvwFMt3EJ&_nc_oc=AdpPoD6PnhYDIzPP-0G5x0Xygo6Y73MHXyFGB-kkLJfJSpiEFn8A6qyCe0tt1W8GVgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThIRGliYxDpJ_yBSQYL7IgXDelHi2QbE-3yXO6C61__A&oe=6AF0909A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdL6CMTXUpgQ7kNvwE64B5g&_nc_oc=Ado0UIY2ROqxXS7leiXEGH8tAAw-GGoE2IFZdygQClWiVoXEq9uxd_mtX2avK0hy1P0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNaxQHHIUJaPNMpFHspJuoIIu9cX05-aLgHlSX9maiqA&oe=6AF0A867"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUvrzTVt1_8Q7kNvwFaFFPx&_nc_oc=Adrt8E7__arcRwpYqO9rjvwEN0W7J2aPwLXIj6Rm3Wy_sO0wkIpRIHUE3S04ekH26ho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKHl_-LhabZ_93WDHZBtB3OdTCsZELdq94AuoXW_EuyQ&oe=6AF09A01"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6D6Dgx4qPAQ7kNvwHoKrII&_nc_oc=AdpIP601ENc4lG25IwSXHOmBNPzxxDWnwCEDmAt9qtRsql0jtl9Ujja9fQsqOeeNJ7A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmNdoqRZwNx_dOnJKM2xBCfiHdQ74bGofMUtT75OD8Kw&oe=6AF0A07D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7dpB4dGvcoQ7kNvwE3JeCh&_nc_oc=AdoZCXo0lkZF6DmxNt5bDPmujb15tA3T_ULiIcN8JVILkQiZP9VERrDO7Td7TDGWKVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk2hyHZDOHJERNujmPepc-w9fJuznJU3rMuxM7RF6LRA&oe=6AF0881B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
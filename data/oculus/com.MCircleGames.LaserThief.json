ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWn2RfCFUCsQ7kNvwGo9QRw&_nc_oc=AdpKq9DR6DYyL2BEnRN12qz6L03CJpkjJhNAk5TEPJqtzc0FAeh1Zb2MkFD2pnW10BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJDxmo2u_CHE2mRB6xY8edWY2Jhra7VtIw2njb75NKuw&oe=6AD23644"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd8wO20N8BEQ7kNvwGj8Y6G&_nc_oc=AdoKUW6zWhY6Grg6Jh9msMGU9IavYteYSUsMPhjUxTVlXowFTq5QYjIGNPSEvAxHvGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUXJEd5343BnkLrTDJvMHdPB1Q-1ZCfRSSZRSoYMDKIg&oe=6AD248DD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD-PHT2jvZgQ7kNvwEc4DGV&_nc_oc=AdqjJ3z5I5tYlj6fuB14MtyLsGcYh0LJzt2rCXVYouVjThGuOhrAI-6wxvUR9BD14XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdFtnkMOa7q7bMhr2zPEOOZw0zZNj4fk56FbzyL8D53g&oe=6AD23E1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cNZXsyiZt0Q7kNvwH5mjzV&_nc_oc=AdqgapEhxicr6uO1Tve91ITf15kvsBlQ8eO13_hxSw3N15Xi4GWTRuBaJYBGRTaxI24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUT8ebmHTO9wepCc_p1Xna1PcEkbwD6Vt9-5qiYclZqg&oe=6AD255E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAqygIULsdQQ7kNvwGYSB5L&_nc_oc=AdqfWCqqtZnrN0fRO0YSo-QougEp95WgTimXFQNMuvw8fM4SLLHD8HZ2M40W3VQgTjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiOC8p6pXHHV9n5JS3XsvVIFx-ABspn2sZtHsQ-B3mNQ&oe=6AD24781"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmRYLSYP8lQQ7kNvwFmIXjX&_nc_oc=Ado5sDG6eg1vMSZUWgMLIdVcZUtbKS6gyYq5WCaZFltahX-p00kUUghLbYUa6pRMDaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2WwvU-h-hk6jF80ZoalabcUst87JjGrSdtdKd4dhLOA&oe=6AD24DFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx7KAeYEa8UQ7kNvwGlIDv8&_nc_oc=AdpT7Bm58mpzRIsE5j3OH_8rG5xHyHffstt3CW1Kjh4QCtvVgbKH2rf9T5jwxhtI6yU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgygxJnuw4yUiUOVYHJPiS7ZYJfD9U_pqTI8dXFWkkTw&oe=6AD2359B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
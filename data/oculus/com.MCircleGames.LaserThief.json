ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c98HpnPKsUsQ7kNvwFW_ZVw&_nc_oc=AdqG4dMTqB0crjlm1ia-Q97G4hS-MidbpTUjLdZT89LAPh7p9T9kNEQpPlFTXP-sPxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAX1j3FRvg4FdK3dP-kOv96jn8WbQWQmyjNApGairnRQ&oe=6ACF9344"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kop7I2WAPZUQ7kNvwFO6FUF&_nc_oc=AdpScXW92z4v_c2IeCV8RKCUL_ZxK7xCbco3Kn4zTQga02Id-yeb1OCbcOuFflT1T7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ5YH5jNNRQn9Mk5F3radtD-HOvnoWf3V5McbcZOM7aQ&oe=6ACFA5DD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD-PHT2jvZgQ7kNvwHnSTHB&_nc_oc=AdqwHMVG2AskR3k80EC9ViDxqAfyr1CIkGZchM-hyPiPzaoEQJb-IozqajQaBxwZSWY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwEytGhrfhacQpB5twV_YCeqeSV9JQvsiW7tUqAhbwbw&oe=6ACF9B1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrnUUd8XB94Q7kNvwGmm0hq&_nc_oc=AdrY7FR7w2faO6X7hrFo18wAwi2az4Jpm89vD9AOgoA0OUzrGjmTT3ln4HqvfH1NMrA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQccu79VQcanUG1Jv74Nb7hxl_jlcIVlOF9i1mhADFcQ&oe=6ACFB2E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAqygIULsdQQ7kNvwGwChXN&_nc_oc=Adpd-jVgkX5MmyPRhWqmdznJt1guMduIh-mV4U67aTrRsgY_RzTp7WYpgtK8ZdRMUTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKPtlj52m0Q-wiqlzfJQgVOsZd0cgVrzl3SBRmavaYHw&oe=6ACFA481"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RLtRa4NvOsQ7kNvwF7KMm3&_nc_oc=AdpmAZtkpMDdvNh8J98NCIhW3mXdMUJbv7YAx3B-vcitcPZ8fgGPfYP0qCH8NlXN2SY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA80gVD9CPZXsFDUUF1FFCq7IFNe4YEGoSnqlrQQOuBw&oe=6ACFAAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDRRx3ZZgoQQ7kNvwGhJPEe&_nc_oc=AdoJyciMqSSO90U_wVDs39QzVmVT2neuZ0gIdCFfjz0Iqro9Zuljcs2RAM2WtEu3q_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNESDOx8yUv7rw6dG1ApgXHrwIzL7C6JBxghGT-Ug2IyQ&oe=6ACF929B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
ng", "id": "545808301751962", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_545808305085295_1031268306104307207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LznZ3ea3UrEQ7kNvwEmZZTN&_nc_oc=Adn-ydvOSuDyNtB_VnYpfZ23O_kuXv-aOu_llhhIjIU6nr9QEq5mUEVMantUyJmOZpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvN0-55YEEmTgQcMjtMXWF-M_VXhEWBE6JxMRLHhMa5fQ&oe=69984F40"}, {"file_name": "3000x900_version2.png", "id": "463692662900477", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974777_463692666233810_3328940693686505984_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTYOc6ss4xkQ7kNvwGpi-qb&_nc_oc=AdnhAZODAtl6vUbV-k3t3lQ6ZM8CJK_mhY3ySur8mOchd9xERtdysbnUiyC7LsK4Y7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuUvZ-OYlc2FCtlUJhOcZEJ4yQl4V-OsQcN9L0pd5rl_w&oe=699841C3"}]}, "id": "1078393417148212", "locale": "en_US", "screenshots": [{"file_name": "2_highRes.png", "id": "443445362127668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556279_443445365461001_2354796727794151394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeZB8qG3sBoQ7kNvwG85pz2&_nc_oc=AdmfC9D4Twv6sfLBkVTcqFy5xEcvT29YuRqqyjnr4s_pHgYo7gOkHEkT8L10noH52EY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvoMErlscEE29smKnXKZh718XCeswb2jLud5tMb1NXggQ&oe=69985F44"}, {"file_name": "3_highRes.png", "id": "4736066316619347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z0KuuubzvYQ7kNvwHOGRja&_nc_oc=AdlFxdisUyXZdKrzjaFbqqkTc7nRUml0NowUo-J7-oRHBKW1mvHMf-GrM-9PG5FXpec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuuSZ-_pmG9zKbbljN5By1lMoeF4xg0v2NGSR9KCpCD0A&oe=6998555B"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNIibbw_-ScQ7kNvwHxxINF&_nc_oc=Adkt6Cv4RlsbbCT0qAFFiB4KPdL8ul6Ly1I1CMRMcMwjkYEL0-FjF15_H1NAMZF5Fns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuH1iDUgogSDb0Tm8SKnz8zHunj7tWbVtfoqIBjasNToQ&oe=69985BBE"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ogyvJVFRLUQ7kNvwHN3yeb&_nc_oc=AdkUYaPjdomKPKJQGXYXPUkBqh6GtnDIERJz9m3U1a_59Jr-bSuAru1-c_3NJv3iov0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftBCVgK34pLnjurtVscBLJgwjd3mybZTu49wb_3Gv8QQw&oe=69986278"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpxbsMgdBIcQ7kNvwHUHkE0&_nc_oc=Adm34cYGN9UTWvhQknxPhAaN06Utp5BA-FyI29h4fkPsVKXPTIPUbLogGKD7TUE73-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs9EG4RS2c73eqnHgEvv3_qJkZDAFRbrLGO-qN9_En6rg&oe=699870E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auIzeJDTHXsQ7kNvwHDTQlv&_nc_oc=AdlFQXYFPI99uj0224WId0YjuDp1fXcHN-4-u15JLps3zFqlztzEMCtXYJm6fqLXID8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvCoPK-rPbPP0duQelreGdycBNYOrQnwqKf1tnqmiGRYQ&oe=6998456A"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThi
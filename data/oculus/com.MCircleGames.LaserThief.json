ng", "id": "545808301751962", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974477_545808305085295_1031268306104307207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqa7huz7lK0Q7kNvwHzFhsR&_nc_oc=AdlqWtWDuKtYJq-WhbczqMvzFPijFs_aubzWomT7Bgjy_tZq7GwopWDtcdCRjPo0abc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsLNR2-ERzdbzC5cgyNwKDbztcHlvu5dtunkZmCJQ8bTQ&oe=69A57E40"}, {"file_name": "3000x900_version2.png", "id": "463692662900477", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974777_463692666233810_3328940693686505984_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wizi2j8bvgQ7kNvwGIScFM&_nc_oc=Admod4Y_8DFH2Q_zVxyuNEhN83cPY6x8Sfe-pxlrc8fVfJaq6iPpwEyRlyhX1JcftIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv3d-OSrWhHR3pmbNypSoNRqb4tKGxgZao4gHfhUsMgZw&oe=69A570C3"}]}, "id": "1078393417148212", "locale": "en_US", "screenshots": [{"file_name": "2_highRes.png", "id": "443445362127668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556279_443445365461001_2354796727794151394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjakMaFZrNsQ7kNvwGUtIp8&_nc_oc=AdkG0IZ6X5UztDncrDc1Fkn1xD9jSvvHyFaC572sB9c8ZKPOVl_Q2ELuhUCdl-6R4Ns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afurmt12I10Yg8n6gCkib_HRQn9gKTPTG0gHACZkrF9jZw&oe=69A58E44"}, {"file_name": "3_highRes.png", "id": "4736066316619347", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0qD4Q1igPUQ7kNvwHAriij&_nc_oc=AdkqgMXVJcwCcrUGTNvXymOIO0opXVs2sPyFhD2Ztl45vwA8X8XsMZdCCwjIe1sAxm8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu4xX-nDcUzLGSFLMFlrkHGBrsdGpBz74WG4To4Ry9XbA&oe=69A5845B"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18IP_RKoGoQ7kNvwHfQoiH&_nc_oc=AdklwJ88-wXaMgDKLvkr-9FSvt9aupm_3JWMJtl8OKWnZCfG0PJsfcZ3KrLcI1hE2BE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft1oHgiwad97iL7fk_j-8KNYJOApwvHQsuBlcYOwqOzPg&oe=69A58ABE"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRhwq2BBRDUQ7kNvwEVYiey&_nc_oc=AdkJBpxzLR1dQvl6gYmlufukwBYXKzBCUZHkTcJbx53NDCoc50TsryU4RgO_LyWx01Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftZ93uAx9yX79wrfbB4h-5eplW4KtmWNqgPXa4Y0GIoGQ&oe=69A59178"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLv4VN1SGmcQ7kNvwFMy94H&_nc_oc=AdlzD7YoWuu8TMIFQkfNRmssOnc80-jleTbzbDSptB7Zv56F78YoLGdrROWCY36OmAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvMj84KK2dmz7eZ_1sHJgHQr0O_koYzvGWrfFxE8fYRFQ&oe=69A59FE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fEmyAb8CbMQ7kNvwGeCvQa&_nc_oc=AdmlaBaohfYTwiH71daTpJxKqje_ts0vjdVQRrmJPkif8vZoyULYdyOS7qpIts7kW_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsM4ClL4cPNG8ZmAZpcWHoGa3eznEl81c_LeT1OCk4aaw&oe=69A5746A"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThi
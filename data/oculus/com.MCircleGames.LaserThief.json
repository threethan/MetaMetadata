25462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwN7Sug8NGIQ7kNvwHamMBq&_nc_oc=Adr4jpPQTnHwk-B9zFXwSeNFVh9N-TDH9BQDjMCeMQuJ34z3M2W3Slrkm24W9GbbNII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUk_H95leCXAuYwKGS8xJ78RB0qCt8LVCzM82xUEYx6w&oe=6B0DC9DA"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuZ72jRWu7oQ7kNvwFffaNG&_nc_oc=AdqLavm2LUfJ4YP3yOEjvzb3TaMCEsZgs2MWC5eXH_ClrO8T-rpd-1pi_BvpS0UEYrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTh0Ta3rApNNG6450rKz1H19X3_MvpPRaDjksp6UqMOog&oe=6B0DA967"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81nwbmVUalgQ7kNvwEpEbPl&_nc_oc=AdpOGFQb9VI0hMnqT9LX6SUxRS-Rvc-9U8gIhz4Fsn2g_Ec4fnbMVaKSDGziC1T6Pvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqD9KbuD3WjvYzvB5nKnbUfEfaf3mx_UjxkVv0GHS4mQ&oe=6B0D9B01"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82OrlbRw8RYQ7kNvwHCNOn5&_nc_oc=Adq-eWvKI4yt5fOVKD3sm0rDU7YDaWASepPGMc5DdRm0WCkG47qgDgS-reJmUDLeJOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGsH3qpNO_3QQSJ-z2COcNkA0f8XpYBgZxg_IkPNJZyw&oe=6B0DA17D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An0teZTeulEQ7kNvwF7ElYB&_nc_oc=AdpXJ4T8Jyge2qfJcwX57epzne3h4smn22wG5AI4tIXgS7-F7V59gZDFdqOJT1XFfM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiBDa6rk6JOBtztTRJm3EfUg9zZ1FDqAosUwliWti5ag&oe=6B0DC15B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28505012289095196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4DkzwIzUkgQ7kNvwGLthes&_nc_oc=AdpmfFbp2m8GWtRiJ24ZN_TG8aVk-8AC9D10EgbejCFVQyq1_51wrK8xyYUxGEkpYhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ61_Tk9mi2L8z2ac-bq3UWj6s0C3Z7VhMs3JpMlXDfmw&oe=6B0DBD5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laser Thief", "platform": "ANDROID_6DOF", "context_
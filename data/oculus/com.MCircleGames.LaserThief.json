25462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXOX3qN3Tx0Q7kNvwGCibpG&_nc_oc=Adp1u7UxS1Utw-C9F_MABvlCe13qKPU4wLNIYVVZAsvqh7jUP_Kt_I9jqH6jUvDMZO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-9pE3wx5FgmYMrTeZBCXzb6WP5BO6WbdiIBavMsry4g&oe=6B0F1B5A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuZ72jRWu7oQ7kNvwHJuYcW&_nc_oc=AdpVh3tBODxxqMONi4WVi4LxHW2SUvXLHpIcWroZxpzSvuaayxUlOSMeH6We4YtRJL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnYVZ9KGaxAbeDuzRu_r-yvFEPNP6-CWE3aQahMzSTYg&oe=6B0EFAE7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IRuQgc6y3MQ7kNvwGbvKDg&_nc_oc=AdoSz7Fj2g7u8D2kUueSweSSFxrNV_AnxZflOFglyLG-taJ87W103Qaa7T6LBaV1woA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuZQAia7AwQQ9nJhNy82mwFQONj_as3TjCXvcvpYdS1A&oe=6B0EEC81"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82OrlbRw8RYQ7kNvwEKqDsP&_nc_oc=AdruvNinQH8S56qgWTWPamv8PCRS6jushsgg37FF9qsv2oikpix0Ozk_jRwTOdkdpkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQpenEibjLGnkmfX7gxouu84s2ObjmeFIMETvDC6h8oA&oe=6B0EF2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An0teZTeulEQ7kNvwHDXqlF&_nc_oc=Adp7aBkczynFZdmTudbgICNW3ofejE568brORu888W_LaFHRm1M3Kxg5JzMcUUaq53I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtXU4eVXCMDH3OoVgncyr8j1UgrvDXWyVn3VTFxzFklw&oe=6B0F12DB"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28505012289095196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4DkzwIzUkgQ7kNvwHTsdC_&_nc_oc=AdrqDcmZQNsVGLuUTQyguXP_2G2AU3YLLgEnZyB9xevvEOCOjP-zivENbzWw6BKAwcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIi7gHFmTZIQ7D-YPedR-sCWjJxd7AOspoe-uRlBKCtw&oe=6B0F0EDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laser Thief", "platform": "ANDROID_6DOF", "context_
11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqTL0iYr2fsQ7kNvwGvXerP&_nc_oc=AdlagbTlaGoJsFm2whXJ8U_-h8ND-l--yrD4BBuo7PWRkZxtxqeJbK_D1AKS1DEGZyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsQYtWtqyrnmhiMiqHdH7BCSZMq1EDGA0BktWVheVBwmg&oe=69A59802"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iMAKadyyzAQ7kNvwFZhi8C&_nc_oc=AdnHPanGVI7RxHwiAL4DxjnIKHjomWjkQihAveMcMe46-OuwZkIEKObH2yXxnuRRieM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvrYwYdSmJaSIvrIE4JtgZv1G7U1rrwhvTX3HP28KU4_Q&oe=69A57941"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xv7uGJ7ogMQ7kNvwHqm73q&_nc_oc=Admn8PQIusIXruJxrggj9RAyn8bj3Ej6JMBcbM376cxIuKn-oQjlcRl5cPcs_Kk6hwM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsAwBxdW8rjurp3vq7ndIyLTDOHVhsME149gfUOobINzw&oe=69A587A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y901CYQwAMQ7kNvwECeXoI&_nc_oc=AdlL2dils1-etrvAVsVCIxUH0YKLUI1Rx6GejSWous32TfJmdegAY9Lvp76NgdnEYJM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afujmk0dRsEFlB3981g0fYdSwmvbWL74f0_amqrG75qxGg&oe=69A5967C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU5mq9uBGuwQ7kNvwGo9p4C&_nc_oc=AdnAbQ6zVGXJFnK737otvyuwamnvs0PmDzuItfSGZLYuJn4FgVLRVkKfx0hUKO0Sp2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs_lDuAI_SdkFXj2UF5Eziso8kdIhLEMUb2nbrcJ2XoHg&oe=69A57A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abWVoXwBZcMQ7kNvwF52j7h&_nc_oc=AdkX6XUMvBe62kL0BIsQzEAn29mRkRrvA7hwFXHl4gyC0zqgwVM3zi07IncujqCmzQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsODfSFBHN83FN-W5PKzkt_WqPPiRuvn3bItQT2n37y5Q&oe=69A59F9B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE6WUiM3Mh4Q7kNvwEU06T0&_nc_oc=AdleDm1qez0oVdG_hFbGt9WFnQ4nD60wMCtdovM4cWpqvTL587BsalDRd4-5RAPxCvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs__dqjILnevP4IowUOkPCKu9iGm4WWsgFDDqHQtkW2Ow&oe=69A59B9B"}, "is_concept":
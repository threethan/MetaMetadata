11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDTk-0iqWioQ7kNvwF_UBLc&_nc_oc=Adl55ZziMWEAyTPPZD55xB1BLF-O7XZD19qZDpSOm0jGQqDpT1AiG5Lf1bxo3g2FsEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsn-Tz-nn9ThEa0ibldr52zg9N43vkk3Ule146m2ahNLQ&oe=69986902"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfRiUMndtX4Q7kNvwG_QuMs&_nc_oc=Adnr83Cn7LhI77ZI7CEXpfRMvzvXYX_8yhhwx-aDqD61QLuIQga3Vzr0PgyjBDjVujM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftAlq-LSkSN4ddHS9FuSmmtpf98jIW-Cuo0X0K2IHuydQ&oe=69984A41"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw6M5rh4bUsQ7kNvwEhbL0f&_nc_oc=AdnY3GuN1JWGY9EP0ahHPEHt4tDo79b-k-Ug7vhAymsF8ycnF_gqGWUEYD192VZ3uNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvsDqxwx8IdCUmWfaGRR4Ht6ay-olUoghvu-lblZawuTw&oe=699858A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKgWRKKIAZEQ7kNvwEjwhca&_nc_oc=AdkcmdNYMgMWs7NCGC0uDYwOcUp7uM6m0JUV8l1uLBSCaKLb1HBPO2nsyv_n_ngLylw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs_L38vPj8tEbR33RgSz7SXBETAlqRmFEPUe9DzOFBsIQ&oe=6998677C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QYYJRtv8EIQ7kNvwHinpeo&_nc_oc=Admu4go5RBJIdnTjh_Gk42vZ-aGUvoGUCQdqXfd6-GQAQ8LHflVkV3rFy6MR18FxLHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv6j4iyhg3u283Sqmd7rH2faAdwOajc4Uu1oYnyU3NDZQ&oe=69984B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU9JCuyNgLkQ7kNvwHfsbTy&_nc_oc=AdmRQ0NpekH2aUIJw2shjFVWLioWCZCuIp3USC5wOjYSpE3zSGzPOmAFjSe35wYjLFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft4C_txt-49oeDReDYObCwqvxyTecgaMlgjh59mpreMNw&oe=6998709B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1s95vE6c3IQ7kNvwE-j0mr&_nc_oc=AdlCrUjWzTWIlOixjvV-i5LtXN4VjXUQQW7MmsjqouGiIMeEnqJWqfov4TwYV9ZETpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft_-j2TBslr6nJGO6IFNPyK4-7AOqpXcp8mPEnE3gEhHQ&oe=69986C9B"}, "is_concept":
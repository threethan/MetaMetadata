-25/507823854_749234541248258_5284942602912148025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxBjuyywhucQ7kNvwEMNGmC&_nc_oc=Adpl2jysEBKvJwL6wufqqVpRdjiS6oomTNGWoWEDoQ5EbPw51OuQUiSgT96Xzg_kAlQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPUllShyA_0yZg9VXraZ3Od6U2tC278UzjGaYSqPtgg&oe=6AAD404F"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0knL1YTSYQ7kNvwGP6F0w&_nc_oc=Adq-9zKOjRfWQQgGnKhFpUWbWQq-3Ba2UG_CLYmTPibBGMxV9QQKNLS1cyAzUobhkto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCnNw7-oy074F1RPBxNRqB-W9BmmwPWgiTvy0-2Hpo7Q&oe=6AAD4402"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sARCIoA5lBQQ7kNvwGY9cOt&_nc_oc=AdpVGwqqwloml2gcTAUtCjcoZEvlse3B1M2cnKseR7uBHA4E_Scea9tNT_PpP-s-Cuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcZAmBW7N37nXG0cvSqAFBU7_AA87T1yP439rmKvu3bg&oe=6AAD5D81"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGGfRYdNNlAQ7kNvwEQNC_s&_nc_oc=AdpvHHRm9JdvQK3ap3xRyjU9OIn9idOJ1E_ucNvi8WTGctbmFsWmCKPAYq8SJdWjUvs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLXtPDo6UuK6iGJNZ3-P3J5h4wjMLN6jRl5FBO0-O0ew&oe=6AAD33A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7p9tKjI2ZYQ7kNvwG_ZC81&_nc_oc=AdrRd-oHOjHNXeyJhvI67xqJ_he-hS-_s8WorEuHlGuy5hj3jZu4p_jPHt6ImOpWp24&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK72Gfhx808ke2VMeifgx56KX9F9sShDxPqnGHBSBc0ug&oe=6AAD427C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=823kEX3yfawQ7kNvwEjayZq&_nc_oc=AdqzS2_VCuSmAbTK8Z5niaS_Q8YQqnaKZWTTh4KVeJOmzQ_Ffq4RZITj7HJc5KTjEPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyt3eH8_juaMbspaBXnetik_jrOWV_15mSRjuAk77ziw&oe=6AAD5EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1eFuY9Hv3AQ7kNvwFvZMkt&_nc_oc=AdpPj808WlQl9b1LjZ_e3oaBuW-rrBIIZj_nXbylFKNC_UAx8hG6_NoacvePfo1va0M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL86xhNrmCGHGpdsHfYWUQb3JSUqJUjExsasF4jBnK6UQ&oe=6AAD4B9B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "su
F"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80rbirIPG3EQ7kNvwHFiuIF&_nc_oc=Adrf81JAeDJDp9kex9resFhCy6F31bt25rNfb3q2QT7PJ7qsuY3d91_Fvr21hWWN1oY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XQCldwynxGQcbE7cW4ocflSNWtLWdP0WGrjwXSrOuDQ&oe=69F20F02"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sQGj9myI3QQ7kNvwEA7JjS&_nc_oc=AdrbY5hTpJfTSve4v9Nlp3CA-qF4faF5V8zdYx3wVsqVSlk7IDVk8vdMSCc9TNRaNQE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2uoJ7csrnl4DGKjU9QQF-aNH9kN_RqRReP1EQSPmlfUA&oe=69F1F041"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ljo7wBjOl6oQ7kNvwGmpw_y&_nc_oc=AdoHQNMq2ChJmJUDqUj37qec5SzZiWrv8Rkf4M8-hwUad0szdlfvs4CK9azYaQArYIs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y6mjjDG0kmKglPzdnCbQmZjT23Lf0iOgPlpMowc5TGw&oe=69F1FEA7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyxDhAUkHhoQ7kNvwGNgBgO&_nc_oc=AdqZ7VXBOuautMXjiOtmHhz2MpYNe76QX-_DefycFe-FgEuBm2ov1U17UXHiD_gyCuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14hVrh7Vf6E4cNxGph262fV6iWGJuA5qfpsn3jhjmmSA&oe=69F20D7C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdp5akjQFV4Q7kNvwGhNWrS&_nc_oc=Adrr7PmH8E5pXECP9kNhg6VzpmP2eHk5QTdy_P-FZ-_9hMVZwjlol7ceh66wbywiids&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BqKGD_tXvBXJbcwPBq4n87-f7LhW-hJJXOT2RIxQi0Q&oe=69F1F19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weiudK8zi14Q7kNvwGsUgtt&_nc_oc=Adq5XAstEfidc_vUUxuwzpmFyQhSK6qljbJCZHeAGOIwhSz2pmWXl9HATqdVpqC7JVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3h7mi5vFJG0Rfu1lxvUrpWBbLt9v_CSjV03HA-4CY8sg&oe=69F2169B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=
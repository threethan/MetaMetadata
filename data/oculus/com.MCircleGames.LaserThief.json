11320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MaOxpbrKuIQ7kNvwHxFdKl&_nc_oc=AdlP82nT9po8qVASfpDrkOnJJzyn-sx4pH1Ir3kMqBKGlqdyAQPKf6ZGh5QmntG-MCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTk3oOmtl_ib2GrpHtW97NVYZ1DQWjZnHBzKliSfCefg&oe=699C5D82"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTjNjv1AvLwQ7kNvwEe1KXT&_nc_oc=AdlPzllFD-Vc6A-1ZOFB1Z1it70-KQ4ehyZSy1Cf3Kb9tdT1xZVLTJoTXF9bX0fMsZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs8aOnMfJmkjYa3vYuo_FDxgKot58vB3nyTNH7KBeWf8Q&oe=699C3EC1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_6eb3rYHpoQ7kNvwGrN0WW&_nc_oc=Adk__mnh51SdgojqoXvKDRUj27dCPiesEhuTA6hxylD8QKeKOadd5HUXMFtwrJYXoYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsCcM8hZA1G1vW5khxxuxD94Yy9a3BQtXjiuMppsXNe3A&oe=699C4D27"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcIERFpl1OkQ7kNvwFeD-Go&_nc_oc=Adlqn2qMbjHYwKonWaEiE3zP3lDobuHs3NTA6MmgBmk0jK35BD16v5aTylMgPneZeVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvR9oWXPmeVb5cjVO58Wobvthf4I4yRpCItijT6zKd9_A&oe=699C5BFC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB0zaaxoqvEQ7kNvwEflGS3&_nc_oc=Admh_xPLQNmX6Ja-GYZp8FvLJVVFMRBnyeZjELDemONdkMyU5KRnN9Ux0jsg05iro7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvB-5-YKOAj0bLnwXEUVsuKBJmg0QVc_9vZ6FsopK49Tw&oe=699C401D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EYwY-XxEWsQ7kNvwGac83j&_nc_oc=AdlO2OFMB72Cx5nhyJe2pzqJUKLnhTO1RZvql2uVnOaHKqwMQeIIF6bV8WvEoytq7rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDmA6FkgEQ-M1ln0IoA1mqw9_KS2QdG7lv8_qAXtLBkQ&oe=699C651B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499315359_1273136407792392_1160153309064206649_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7lkmdX8zHkQ7kNvwEnkKYy&_nc_oc=AdnEYZMI0o694z_m9xGYkXrTDU17ZIwtugWXurTJTZ7nQ_aaGeqRljaM2pSGhbOoQG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftgkQpzm_sbRAjEu7kkkjmRD7mohEgiCdiFAlrRxB0rUg&oe=699C611B"}, "is_concept":
_oc=AdoQD1OjTS-lyyN0t1O9HdYtcQV1C9PMH5t4FLSfci4xRy8fflrdaITo0IZdjwfT4Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UPETuThAkNdfd_7g7k0Lr-iQqH3GOjP_US3_eX3brtw&oe=69DBA1CF"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5F0xrE0V90Q7kNvwEMU3fK&_nc_oc=AdpdlzCJwNKHAZWsTstxlyO5fGM5Xx0aRSQzsLxXtmevik9Zt6ir3dPQiNx2da230YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lAi1_e8Bpn5zQ2f1qJv-ntFvBzNRFD_rF5kQvOVCOkg&oe=69DBA582"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2n-qkWQfD8Q7kNvwGRe5Yb&_nc_oc=AdrH6xAG-C1KLZLfX25ZRYNmeiISvYRblSWU-nyvUT8kaaD9k79iBVHsBvIXf-KQ7WA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hPio5Lo1ybBruR3OrW4XESqGuobsG_pyFQ3dXcds-iA&oe=69DB86C1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs_9P1FiuIgQ7kNvwFZnVPP&_nc_oc=AdqoE89xuI-oCDO0CJFzXVV8QiRUIT5plI7UXSRMVg5Ehu7jxnVPKtvYPhbWOjYDhXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Iw99rGwMR-saTJm8AIihnSaGpINgIqHVpSuQB_8-Jtw&oe=69DB9527"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_XyaML_H3sQ7kNvwEy8rE1&_nc_oc=Adoln_ipQBO8D6QRd2ggKLHmiEbMHMhXRgCqB7EcS2YhCPlTCYpqw3Ln1EoTWR2d5ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UP4sLY1yCQ_7v2UL0uOXE_i4r4cyIndcJDnZHeB1AVw&oe=69DBA3FC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmNDlCUydFcQ7kNvwGgN7rf&_nc_oc=AdrCF1QbRyjWgvfakFC4MmAAgc8OG5UFihxTk8zjUKT78lJwxNdmUGsiqdEglbx6KXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vhu0BFO7jczYZdFk9Aib_Otst-cUWNVBJIwiDBHnj_Q&oe=69DB881D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcbaGQu7DGYQ7kNvwGpxgxe&_nc_oc=AdoXN3ZN5NE1QjM9Q286IcGkszS9yYtj03wF1E59_pMAuINBy7lWAZJMyW-MB3ZwIl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af156H38ti1ySFSvXrN6BXWE8qj9qW4IftzSAd8HopcsrA&oe=69DBAD1B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276
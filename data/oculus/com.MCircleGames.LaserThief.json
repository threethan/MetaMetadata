ng", "id": "545808301751962", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974477_545808305085295_1031268306104307207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmOOcBGSPbMQ7kNvwEkFHXZ&_nc_oc=Admx8kuBH_dY6sfQWZVu9yoHvoHzApxCDBlEQf0e4wL2NNv1u5Ne3jQFHKrhRULY1OQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsl1cb7m6QbIQVZ6Opxjv5xt4PpR76MbMfAG0G6kP_Rpg&oe=699C43C0"}, {"file_name": "3000x900_version2.png", "id": "463692662900477", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974777_463692666233810_3328940693686505984_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s5umNJWmMIQ7kNvwEYTK87&_nc_oc=AdmSB46U6ER7E_F5llfJwQyny7zMRSxBfKsx1S17f-gHHIJ1VYOEcEWy5Hj4DR3ya3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afst89rf-vjVLz_Vg621FUOWoaMu8TH-llGZA0Bex36VAQ&oe=699C3643"}]}, "id": "1078393417148212", "locale": "en_US", "screenshots": [{"file_name": "2_highRes.png", "id": "443445362127668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556279_443445365461001_2354796727794151394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI6akNYKxuAQ7kNvwG4ejfu&_nc_oc=AdnU-eZSykvhUMzEl1_VHcbp1jB4f8S6v5hzSxcR_kQl5VetnAU8WgY6KNGDY9_Tt4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft7DWn_MhCDYk2n1aP873pjW7xOJJEYfCqRmq6zawqtzA&oe=699C53C4"}, {"file_name": "3_highRes.png", "id": "4736066316619347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q813Rx9YUIQ7kNvwGS8QsA&_nc_oc=AdlEGt3ZOe4Ogyemi0LE1rxhGsfrHLA1p_tkihcYTotagSm7QCMvBSyzW5kckW8SpeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu1d6cVRSbDviFY43Z7L6vBnO510-Kc7tHU43dKCgzLtg&oe=699C49DB"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAWOZOm_-lQQ7kNvwGY80Kr&_nc_oc=AdnsUMjqrNCmpt12IFbtquKLHqG88suQ-ccvgLL0_T2HZMQsoW9Dbdy0NHKakjd4vkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvr1cUypK0QH74DRDodNzLDGv-jAc670bJskWZ0EcO8YQ&oe=699C503E"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-BgLvDW_NQQ7kNvwHfMtvj&_nc_oc=AdlzZPHQMW028hmaWm6AFtYVp-H38TVM8mCH0-wuuXSNEfbX2CZW5rE5fxxukEragWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfutByH5d_qGg0bSBnptiLPae6HixFpzwCLSCr5uZVvQIg&oe=699C56F8"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_lFDcyQvWMQ7kNvwEp15OM&_nc_oc=AdnOF7Cr_NFS_wWZstqTv3WEL5MCDtuJnGyFh0K9FICUWw7wW2v_a-8VypiFIdPKs_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuPxJUbTCwrpN37wzQHIcplJPzXLCFkEd11f2DEX5ffDg&oe=699C6565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X961vVVug28Q7kNvwFd_49_&_nc_oc=AdnNlFoKhQu8p3iuWOOVoIThslBhEKvBajMs8IMELXAJtGc_3xsF1Y23srF08G-eSzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsal8pFhvBJVhZ0h-HzLJ5Kk1ULgRhSuKKvzgwjOdsrTg&oe=699C39EA"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThi
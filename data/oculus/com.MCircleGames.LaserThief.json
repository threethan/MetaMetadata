-sin2-3.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK1bwHe-A1IQ7kNvwGNTeum&_nc_oc=AdkpBccFO4mj_KdUb3oocchwAkvufyhHA1qvq-kYz65JI4mQyNYKuZithdq89fEc6A0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTSiFn55h-8yzBg-PSh_VuZBOIWRhH_qx38dGujbZiWw&oe=69AACA5B"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-17yVf13FcQ7kNvwEPArdL&_nc_oc=AdmuYMzKM3h7Bz24iUcDxLetq59SzOF1cZSCAL_sRJ2UZqQGPlCIHyB99anD-wwZq3g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyH6D_CXQup5V5X4i54wtZxBKdZb8kZdKheEDvY_7GCKA&oe=69AAD0BE"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSLLk94_KjMQ7kNvwEK8CdX&_nc_oc=AdmBviDGEiEUkpD8A1hG-goA-vqaw5QsDk9U6VBUPruwp6sGsfyU3s7cpPJRxroNFw4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTRGiYLhsIMTowtzWaxce7XwWXYAolV7HZN3nu_wV_Gw&oe=69AAD778"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl3bEBHJONsQ7kNvwF69li8&_nc_oc=AdnPpsKvlPxIT0iG-JIE7Drw9TVRVIG22L3NwdlLGmrkX3DsevCkiRgY5RFTIFGLC10&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqoKmDj256miIPmrQ-2ywyyD8R62El4-e7ZMauy2zPVg&oe=69AAE5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVw_KRUCdKgQ7kNvwFF21TV&_nc_oc=Adkq8dqeAwnylolGoJA-WET1oMTvWfjkTj8SyrhLvSCh6EYjhKiZfjMLnEcAQ17-EV8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxA3sOMf8FCLpodt6GvEVJSQrGW6z6hK6KQgubuoyXBg&oe=69AABA6A"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8793536314002753"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1024213449904383"}, {"status": "PUBLISHED", "id": "1124593239661971"}, {"status": "PUBLISHED", "id": "2389540991460996"}, {"status": "PUBLISHED", "id": "1161083548930744"}, {"status": "PUBLISHED", "id": "1967563697348499"}, {"status": "PUBLISHED", "id": "715297811442186"}, {"status": "PUBLISHED", "id": "1154310359438377"}, {"status": "PUBLISHED", "id": "1375771556753006"}, {"status": "PUBLISHED"
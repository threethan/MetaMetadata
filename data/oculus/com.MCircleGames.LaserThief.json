-25/507823854_749234541248258_5284942602912148025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxBjuyywhucQ7kNvwHz0ugs&_nc_oc=Adp_SiQqwlaG28BS-SDAPZ2Zcyr42Tr-w4ZPixLeZ6ggNBoeBNDBOKhOG7qCTYLAsjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXRlHCAFhYFE2stoqrUnQKkLqYyx7I9xMjfarADxVlCw&oe=6AAA9D4F"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz0knL1YTSYQ7kNvwGkvcNF&_nc_oc=AdpkYpzVIb2FbD2qsr3roLrdF3TTScRMDcXLb3PmB8LlGKt4Wi4EpNdXKjaJ5zNRA9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCz56OC8nmAlzFdVSJ023xcQY9QD4j5Q9nnxF39iMnMA&oe=6AAAA102"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBNvs_a-cQUQ7kNvwHA1XQ0&_nc_oc=AdpOVogm0v52carJovimERDK5jWi7ZNFxdPjL8tudeZHHdKX3BcAy_o-jFMAFU8NrQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbUO03KhPXEt_Sj9GsPHXHevUqnlt6luNcehysSsRnBw&oe=6AAABA81"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsIyv1pr9EMQ7kNvwGRKaTu&_nc_oc=AdpksHGq-aKyImuqV_8ohUH6FGH5aEfGTorYmaohm74xJRCp3udsGdGoPNDiM7C_0N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMRl27WAzQA2w7F99wJUgx2DUvsKQZbS_tcwWZ_FEYhw&oe=6AAA90A7"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7p9tKjI2ZYQ7kNvwH40cgm&_nc_oc=Adq4GfW6GYhTLshahoDe6gKvkC3vfYpuoLJ_uXP_GmOFQf15-T9kKknb3DJHikZVtqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImp0AwKTJ_xljQGc6_TQi9y03FLihHoxxdy6QwF5zsQw&oe=6AAA9F7C"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLKAi385bgoQ7kNvwFLR_Hf&_nc_oc=AdotQyxO8qCgv9v3zUnvWaXh49ouT5VLSrBN-eDucN4VISz83gcMWyUYvFBuWKXCsBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9Ls4D7ft3wjM4ptiSfX207NGNxPyfmEvYRmbMXOFuNg&oe=6AAABBDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2GexxIP67YQ7kNvwG17bRD&_nc_oc=AdqjqrweBgvYP6ZBLALpBooD0Oq2l3bwEUX6gnzmyaL8EgRu7StwciF2K3hrhJ5mtLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIwdQMzsafTavCZ7nBoepNV3ULhh8d5nQJDsbKJJqXhA&oe=6AAAA89B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "su
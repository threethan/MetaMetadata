ng", "id": "468255582947074", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974746_468255586280407_337517984640062450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtIfTZbMLksQ7kNvwHN1DD1&_nc_oc=AdqMfle5WeTbEjgfk2PqZGFwmdhiAYK0JNPUrsnAl4NplOZAlLdPvUqEAMEu433pqa4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWb6uB5I9OvfYrZq0PgpZjfpGF6X8jTnLXaFhGb0WpRA&oe=6AEC9444"}]}, "id": "1456854253159579", "locale": "en_US", "screenshots": [{"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr-iu8BDFIUQ7kNvwEwzQIV&_nc_oc=Adq-0-Lfb_OyoipzgfrnpL2e9mpztPjwIrmb-i4atfamkUUm9FeoriMzHz2GIw7mO-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtzHq-ESo4Jsql7hbHsfpYfdiXB6tksyXXmZO_l5YuQQ&oe=6AECA6DD"}, {"file_name": "tmp48fc24gq.png", "id": "1810354230409062", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825462_1810354233742395_5822613936805941119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFqvpt_vXKwQ7kNvwFvvWUd&_nc_oc=AdqwoVtBKqH9aOcogJ_SQMtcoP8f_xQI5lum3gFkdIIzrR7v0bFIiD5OMm3XtDIM5Gg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGA73xgef0GYlI7vmuLV80r4DnPlCvZIGjVq167Xoe6Q&oe=6AEC9C1A"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsEjjmdEXlgQ7kNvwG79g_r&_nc_oc=AdrNNm-hc4o5Bl8dQWK_0DoYqdUc27oJ_WJlN7-u8ff3kgbyOak5SZzAxIC3EG_5B18&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-5T7dIgf9fjI9YcsDnyeTKw0SvAyEnNK43q1hYoSC5Q&oe=6AECB3E7"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9_4j8ob5bAQ7kNvwG4Q0d9&_nc_oc=Adr1o8BSoMYQNVI7HsQEGfdeb3R6NtFOps0cAZP0Cinvj5UVtXUapB4gmLNaaDmziW0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsqy4tDD1XFbPdV7uCCIVUNi_Y-L8UvjmfbTQlviOlZw&oe=6AECA581"}, {"file_name": "tmpbvw2r7px.png", "id": "1657738152369458", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823901_1657738155702791_9013150087638104233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdw3b4HVHI4Q7kNvwGE-T3F&_nc_oc=AdptsNcA13XsNSRPt2O4aB6tKqzEZJ3Ewv8Ou7tVrQpezsR9o-gaxBI3TyUyUDH4EGc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYNGDidOy00FdLDALCN4DoOGbJHz7Tudl2nYUQ8DaAMw&oe=6AECABFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e09HNg5Gqm8Q7kNvwEHLgo5&_nc_oc=Adqee4FV-jzPHrvDDSKY0WIwrlv7limAU_oi3b4eUpvcNSTrA5aWretKFd4MtULhVAk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTiITdcZba-GZnOoJuUa_zlxfDMeVed4TRztTh65_KSw&oe=6AEC939B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": "ThreeFlavors LLC", "developer_privacy_policy_url": "https://three-flavors.com/#/laserthief/privacy", "developer_terms_of_service_url": "https://three-flavors.com/#/laserthief/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/#/laserthief/support", "website_url": "https://three-flavors.com/#/laserthief", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
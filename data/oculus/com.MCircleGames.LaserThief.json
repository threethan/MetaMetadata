m&_nc_ss=8&oh=00_Afym334FhbuAYdW3E_M2b8BY_36a-FoRoEg7bBxv83v6Dw&oe=69B414CF"}]}, "id": "1472091717210747", "locale": "en_US", "screenshots": [{"file_name": "good2.png", "id": "5059511314274310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820855_5059511320940976_6376712890900679535_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DkA_f-_LzcQ7kNvwGC0l6U&_nc_oc=AdniuxLcJWjbTDIDuiOKEw2zKl9G5WIGR_d46hVwtV0MFQ79jvnbXQxnYaXNHSEkxsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzX2GKTmg1D_QoykPQ9FOwkYROlEh6HxXVe7-WlKIkm3Q&oe=69B41882"}, {"file_name": "screenshot_5.png", "id": "4426880104202080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_4426880107535413_9108096943838119621_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDzn5lqltlQQ7kNvwGiG4gu&_nc_oc=AdlSL061flFZZ1CojL1w3CdbPYNhEc16NuUkGiRfHQqC5CSpylsY_lxf8SmU0VinaSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7tdY9N4ECzRG3nj4MzW8GJxG66yizUHUhaIXcoiXUxQ&oe=69B3F9C1"}, {"file_name": "good1.png", "id": "1902203407332140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1902203410665473_6060060829832396208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZh0HzMn1Q8Q7kNvwGf4f89&_nc_oc=Adm4FDs0onAl4toIlh4IDlZsQ0burr-r413advO8Y6viUwSwbFX1i12OgRFcvmxNQlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyz5XDge9PsgufX_PlSNKwwKjSIxugAeDvJsy1785GgbA&oe=69B40827"}, {"file_name": "good3.png", "id": "1448085479625599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1448085482958932_5953111824722095392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06TuJCoV8agQ7kNvwHxqliT&_nc_oc=AdmEvrEHgrk3S4ikdbTn56pwLv2l3CL_HUsi67pGdAiMUq5runC6VBEvOsMuBhmbzzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbaYhWnuKaMWMxyYisSIbPA9g6qydDsux4kdvrlR_OZQ&oe=69B416FC"}, {"file_name": "good5.png", "id": "845590001293410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_845590004626743_7502137712784022119_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4YR9sJeya4Q7kNvwEWdzKy&_nc_oc=AdmxvbrjLS59xEMtJJu_rw8yVqb2NrFdqgGwD8lGmMcZ-U0oq-6W3m8eawbuQe4ixCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqP85UlsmprmdLX4X-Crmt00ecEEY7QexPenkqeJpRFw&oe=69B3FB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laser_thief_new.png", "id": "763185966657254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_763185969990587_348442427727467025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq_RYJxQRDAQ7kNvwF6Q0MN&_nc_oc=AdnFsdiwm38EmjdovzocYKWOqZg9UkODLY9fTH9h6yRx61tAAHGYdWPlzZuIpjRa8IM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWObwTalN-ljnJZuA8UyNYXXLU6atZhlAe_OVZR7nh1A&oe=69B4201B"}, "display_name": "Laser Thief", "keywords": ["Action", "Thief", "Laser", "MixedReality"], "long_description": "# Laser Thief\n\nImagine dodging lasers in your living room, just like the most thrilling scenes from action movies! Laser Thief brings that adrenaline rush right into your home \u2013 with cutting-edge mixed-reality technology that makes you the star of your own heist!  With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Recommended Space**: A minimum of 3x3 meters (around 10x10 feet) is suggested for an optimal experience.\n\n{2266929833778351}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n{1556869225449453}# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n# Unique Worlds and 150+ Levels\n\n- **Food World**\n- **Viking World**\n- **Transport World**\n- **Garbage World**\n- **Furniture World**\n- **Money World**\n- **Warzone World**\n\nDuck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n{860722222960958}\n\n", "short_description": "Imagine dodging lasers in your living room, just like the most thrilling scenes from action movies!\n\nLaser Thief is the ultimate mixed reality action experience, where you\u2019ll duck, dive, and weave through high-powered lasers to pull off daring heists. With every step, the tension builds\u2014poison bubbles, shrinking shields, and a ticking clock in Bomb Mode will keep your heart racing.\n\nAdrenaline-fueled gameplay, laugh-out-loud narration, and all the thrills of a Hollywood blockbuster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThief.html", "developer_terms_of_service_url": null, "publisher_name": "MCircleGames", "support_website_url": null, "website_url": "https://mcirclegames.github.io/SubwaySprinters/websiteLaserThief.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25276032015326589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499315359_127313640
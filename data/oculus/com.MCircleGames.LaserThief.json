ng", "id": "545808301751962", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974477_545808305085295_1031268306104307207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXfd3yPegsoQ7kNvwHreFs4&_nc_oc=AdkL_07jMZHBXm2p3AVQAEc9NpIP6fZ05Bj9hs7Z7blwPpZkP1FHTCFUZw-4Lg-22BM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuP2rc5t_w3Ka-ASXGLzSoT-DyOUQwh6GEWdBA5LHLoCA&oe=699EE6C0"}, {"file_name": "3000x900_version2.png", "id": "463692662900477", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974777_463692666233810_3328940693686505984_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwAm1UR_hRkQ7kNvwHsUK2q&_nc_oc=AdlCPfcPnkB27aTBMPxngX56MGUcnk9e2ieZRcLlrq7rrSjR1tOA3ireZ-o3i8QrP40&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuj5nmKfi1MPT93M3E5pgo1-TnwkkYVdKndD1tzgm8b_Q&oe=699ED943"}]}, "id": "1078393417148212", "locale": "en_US", "screenshots": [{"file_name": "2_highRes.png", "id": "443445362127668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556279_443445365461001_2354796727794151394_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVsCHa1bXewQ7kNvwFdz2hc&_nc_oc=AdnNK3zCVCuMzN8QSGMhZZGuflt7SLI8i5s5r82PeywHzBh0rvEFdvcJl1e5MYkKtKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0fUNFXoX9zbsLJhlKVAxgB1SvJKq4wgfpBYy4wiuHGA&oe=699EF6C4"}, {"file_name": "3_highRes.png", "id": "4736066316619347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_4736066319952680_2172825344038890551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q813Rx9YUIQ7kNvwHq483f&_nc_oc=AdkQxp9nTKkzE1lW9EhCaaVURn5qr6Go1OzWd6ZMV7nZ0oeT-uoqLiBl7jD5t0LYn2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNHBfJVPolbNnf2fz2VLH9Pm_FnGMRoeHC0B9xbdv28Q&oe=699EECDB"}, {"file_name": "5_highRes.png", "id": "1236244090967078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_1236244097633744_7240096610020896747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhaN-Eysj7UQ7kNvwHLUZHm&_nc_oc=AdnioOUKqImlrZTuSwf57YC1hjNFIoaAntJmu7IUbw1iM3s6qtsP_qZ63a2NEzCsbPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfueUe7nC7V-gZEqdYNKpjRlFFhA6SORTxiJ0RGCqqxYqg&oe=699EF33E"}, {"file_name": "6_highRes.png", "id": "1702597553915568", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1702597557248901_1753727345272603092_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWQELfAAOQ4Q7kNvwHI2E7G&_nc_oc=Adl6EDxymXxYvKmqBtVF8qyExVSwfz71i0f-icuu2pnMHm6fUKjsrywvz32HbYSmomo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvaM__ZoyIzW4LhKUOug6m43rS4-X1GGNzU4rpXVyeXqA&oe=699EF9F8"}, {"file_name": "4_highRes.png", "id": "448529714588388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984466_448529717921721_5463884957979087376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_lFDcyQvWMQ7kNvwEra-ke&_nc_oc=AdnviWuTMR6DBlErwJKdHCo0sDjiwmdJLssmhtG0x9rNhfMhLmWrY9NPB7X8_PIOvgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQQ6fAas39r4-5NFIUMDR1ReixgHDCxqBmfMOjNfT4xA&oe=699ED025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_version2.png", "id": "2238034616582127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984452_2238034619915460_1218888742017544350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXa6hHjtJ_QQ7kNvwFrmqS1&_nc_oc=AdkAULH3eG7A368hWVAjFCtXfqVASa9dRPYrDNPCkmVeblnZhAXE_0KJl5hs4ghTOgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuFdgVwytvuRDGzgyJmXRf3q4N7Rmc9yFskNx1gPf6WQQ&oe=699EDCEA"}, "display_name": "Laser Thief - A Mixed Reality Laser Game", "keywords": ["Action", "Thief", "Laser", "Game", "Cool"], "long_description": "# Laser Thief\n\nLaser Thief is a heart-pounding mixed reality game that brings laser-dodging heists straight to your living room! With three exciting game modes\u2014**Story Mode**, **Bomb Mode**, and **Free Play Mode**\u2014there\u2019s always a new challenge around the corner.\n\n**Note:** Laser Thief requires a minimum of **3x3 meters (approximately 10x10 feet)** of space to play.\n{468255582947074}\n# Story Mode\nIn Story Mode, you\u2019ll break out of prison and tackle **seven unique worlds**, each packed with lasers and inventive traps.\n\n# Bomb Mode\nJump right into Bomb Mode, where you have just **120 seconds** to grab as much loot as possible before the bomb explodes! If you hit a laser, the countdown continues while you reset, but you can carry multiple items for bigger rewards.\n\n# Free Play Mode\nFor endless variety, Free Play Mode throws random levels your way, keeping the fun and lasers coming.\n\n{950000973851566}\n# Unique Worlds and 150+ Levels\n\n- **Food World**: Start off by dodging simple lasers.\n- **Viking World**: Wield a slingshot to destroy laser devices.\n- **Transport World**: Steal luxury cars while using a shield.\n- **Garbage World**: Beware of poison bubbles!\n- **Furniture World**: Equip yourself with a shrinking shield\u2014a handy item that protects you from lasers!\n- **Money World**: Navigate synchronized blinking lasers.\n- **Warzone World**: Outsmart tracking lasers!\n{877949347453398}\nWith a witty narrator and thrilling action, **Laser Thief** turns your home into the ultimate heist zone. Duck, dodge, and outsmart lasers to become the greatest Laser Thief ever!\n\n\n\n\n\n{937914688201726}\n\n", "short_description": "Laser Thief is a thrilling mixed reality game where you break out of prison and pull off heists right in your living room! Dodge lasers, avoid poison bubbles, and steal treasures across seven unique worlds. Play through the Story Mode, test your speed in Bomb Mode with just 180 seconds before it all blows up, or explore endless fun in Free Play Mode. With hilarious narration and epic action, this game brings the excitement of laser-dodging heists right into your home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mcirclegames.github.io/SubwaySprinters/privacyPolicyLaserThi
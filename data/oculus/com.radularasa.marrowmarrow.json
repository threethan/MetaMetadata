103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G_yhOyes48Q7kNvwHNvqTQ&_nc_oc=AdpCnH2GzcBuVtdOPYEeOOGyDpqs2Kp_jMF8yuCaapEp5oeWGqJtHoYibYsEA1Hgmks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-hfzJXwtyab0oSC7SOiUGwo4S-puCfFZrab-nj8p0w&oe=6AFC7CD7"}, {"file_name": "Screenshot_BloodPool01.png", "id": "1325397069074136", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307326_1325397072407469_231826357942605516_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HEX1IP1APoQ7kNvwGFAC8z&_nc_oc=AdqOOEzjZj0Oxyoob-8N-r25bW4ASeKq2axysIzsv4v1syq5ij5RhbY5IUHAkp-zbFg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLc18039WrFcC5FY2prH0FC9B7RsvNfZqUYOyvRbGZMA&oe=6AFC639C"}, {"file_name": "Screenshot_Temple01.png", "id": "1812540279349457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819396_1812540282682790_5139322304496402000_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jto1q2PrueYQ7kNvwHySCuo&_nc_oc=AdphITbWFqzvyLO3fNYRp0zgzu0MraQYu6zRtpX5RlQL5hwLIVTclXGYZW-U36y_yf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcieyK07gXzAqwYJrxdd3Zj_8OZwx7Or2thy2QRcveYg&oe=6AFC8F16"}, {"file_name": "Screenshot_BloodPool02.png", "id": "1118474783601260", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499305027_1118474786934593_794513890139059547_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL0_ugLn_SgQ7kNvwHBF-RE&_nc_oc=Ado7UJRBvrQYhUaRjp6k9-oemXf4ptDmpGCw7GeqxtYOoPu1c55jSogd6ErGDPVR9bc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhRytAO0iB3hCp7HpLhRQt5Tna-UrBe_ORWhb_cOHN0w&oe=6AFC8B0A"}, {"file_name": "Screenshot_City02.png", "id": "2207195003122752", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822581_2207195006456085_1594530072257681561_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLRFCjd_VMoQ7kNvwFOxZ4m&_nc_oc=AdrOE1O7UiQ32L8MjbV7KgcjQYDHCW_bV2x0ahq-qa3K2CK_LQaYQ3hhFpWU6Dija3o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsfHTpzuRZ9Diq_CLB4yiiYAc5gBEy7uTSzeKvDtoWsg&oe=6AFC6E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover01.png", "id": "1218473946757544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1218473950090877_4275743793965084434_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYOwDcotQXcQ7kNvwHJ3sst&_nc_oc=AdrY_WUL6BgIpJ9hMhFf5D8QyTwLpED8pEU-iamPtP3_iOuCFtasu-CEcyeWP5MExLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt8tuPdta0N9np9Xl7rLor48nu8vZAjo_XDImwPfaD9Q&oe=6AFC788D"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "**MASTER THE MAYHEM**\n\nMARROW MARROW combines the fast-paced combat with nimble parkour mechanics that allow you to traverse across towering levels at lightning speed. With a weapon in one hand and a Grappling Claw in the other, the options are limitless as you take on hordes of Vermin.\n\n**ANNIHILATE THE VERMIN**\n\nFace a relentless onslaught of Vermin in combat encounters across 9 levels; after each, you are rewarded with an Upgrade of your choice that alters and empowers your weapons and abilities. Levels grow progressively more dangerous, and each world is capped off with a daunting boss fight. Only the truly skilled will reach the sacred Terminus and face off against the vile Hierophant.\n{3381129562056307}\n**BECOME THE CHAMPION**\n\nHone your skills with customizable loadouts in Unranked mode or compete for highscores on the Ranked leaderboards. Avoid enemy attacks and retaliate with ruthless efficiency to build your multiplier and maximize your score.\n\n**Key Features:**\n- 18 types of nefarious Vermin out for your head\n- 3 unique worlds, each featuring a boss encounter\n- 7 Arm Weapons, each with a Primary and Alternative fire mode\n- 7 Shoulder Weapons, powerful recharging armaments\n- 20+ handcrafted arenas\n- Mutators that bend the rules of the game\n- 2 Daily Ranked leaderboards\n- 1 maximum intensity Weekly Ranked leaderboard\n- Unranked runs with customizable loadout\n- Playable standing OR seated\n\nMusic by Karl Casey @ White Bat Audio", "short_description": "Wield deadly weapons and master high speed parkour combat in intense arena shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9173719082733984"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1616223663337731"}, {"status": "PUBLISHED", "id": "1733939797744481"}, {"status": "PUBLISHED", "id": "1975877009701178"}, {"status": "PUBLISHED", "id": "2076707002888160"}, {"status": "PUBLISHED", "id": "2199983647408784"}]}, "baseline_offer": {"id": "2199983647408784"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789570800, "status": "PUBLISHED", "id": 
ps://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819396_1812540282682790_5139322304496402000_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W4UjAu-DdgQ7kNvwEADMYS&_nc_oc=AdqA9ve0_B_w7vAyHiUMnO4OD0hfa3eLvup98FO19Z0V4vliAOEAfUMjHQUr7irJhx0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uGogPnMK9cwZpdBXP0rNubZYVj-qf-hqcSymPd_t-gA&oe=6A3695D6"}, {"file_name": "Screenshot_BloodPool02.png", "id": "1118474783601260", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499305027_1118474786934593_794513890139059547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAGoNhtLWpYQ7kNvwF3s8Ew&_nc_oc=AdriLl0Nnxm3BSc8ZmWUA-Zq6Uu2T3DhyqGt1aDWe1UkogfE8PMM99l-VknxU54NfX8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xnKTBScxCNKEfNxFU4mcqMSrRInmBPyB_j38dBUJI9A&oe=6A3691CA"}, {"file_name": "Screenshot_City02.png", "id": "2207195003122752", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491822581_2207195006456085_1594530072257681561_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXnzz73CmKsQ7kNvwFFMmVQ&_nc_oc=AdrKrnoGUSRYB3pSdZ_LAdUVwKC4JXvQYIMxhBoqn3E1CjROSu_ikumCn3-4j5FCySk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82KGTlFLecFs4wKImezpwh6YxGGM1hYPWEcr21mEWn3g&oe=6A36AD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover01.png", "id": "1218473946757544", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499304019_1218473950090877_4275743793965084434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h57dqg1F1EQ7kNvwHraj9V&_nc_oc=Adp6lVi8inJFpa9G2Z_RtqcjdyQZp06IWwIw8dhnQ8i5kbBhuG8AFqiPIksI99uwkls&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qhQ-N-mjQ3snWllhiEGJceDtvsT1K1W_GDzyzL1WfMQ&oe=6A36B78D"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "**MASTER THE MAYHEM**\n\nMARROW MARROW combines the fast-paced combat with nimble parkour mechanics that allow you to traverse across towering levels at lightning speed. With a weapon in one hand and a Grappling Claw in the other, the options are limitless as you take on hordes of Vermin.\n\n**ANNIHILATE THE VERMIN**\n\nFace a relentless onslaught of Vermin in combat encounters across 9 levels; after each, you are rewarded with an Upgrade of your choice that alters and empowers your weapons and abilities. Levels grow progressively more dangerous, and each world is capped off with a daunting boss fight. Only the truly skilled will reach the sacred Terminus and face off against the vile Hierophant.\n{3381129562056307}\n**BECOME THE CHAMPION**\n\nHone your skills with customizable loadouts in Unranked mode or compete for highscores on the Ranked leaderboards. Avoid enemy attacks and retaliate with ruthless efficiency to build your multiplier and maximize your score.\n\n**Key Features:**\n- 18 types of nefarious Vermin out for your head\n- 3 unique worlds, each featuring a boss encounter\n- 7 Arm Weapons, each with a Primary and Alternative fire mode\n- 7 Shoulder Weapons, powerful recharging armaments\n- 20+ handcrafted arenas\n- Mutators that bend the rules of the game\n- 2 Daily Ranked leaderboards\n- 1 maximum intensity Weekly Ranked leaderboard\n- Unranked runs with customizable loadout\n- Playable standing OR seated\n\nMusic by Karl Casey @ White Bat Audio", "short_description": "Wield deadly weapons and master high speed parkour combat in intense arena shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274332603592
30fc\u30b8\u3055\u308c\u308b\u30a4\u30f3\u30d1\u30af\u30c3\u30c8\u629c\u7fa4\u306e\u653b\u6483\u6cd5\u3060\u3002\u8155\u6b66\u5668\u3068\u30b7\u30e7\u30eb\u30c0\u30de\u30a6\u30f3\u30c8\u578b\u306e\u6b66\u5668\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u6700\u5f37\u306e\u30ab\u30b9\u30bf\u30e0\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u69cb\u7bc9\u305b\u3088!\n{1494481975640911}{967237065988020}\n\u30f4\u30a1\u30fc\u30df\u30f3\u3092\u4e0a\u624b\u306b\u56de\u907f\u3059\u308b\u306b\u306f\u3042\u3089\u3086\u308b\u79fb\u52d5\u65b9\u3092\u99c6\u4f7f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3002\u30a6\u30a9\u30fc\u30eb\u30b9\u30e9\u30a4\u30c9\u3001\u7a7a\u4e2d\u30c0\u30c3\u30b7\u30e5\u3001\u200b\u200b\u30b0\u30e9\u30c3\u30d7\u30ea\u30f3\u30b0\u30af\u30ed\u30fc\u3067\u6575\u3092\u304b\u308f\u3057\u305f\u308a\u3001\u5947\u8972\u3092\u4ed5\u639b\u3051\u3066\u5f3e\u4e38\u306e\u96e8\u3092\u3075\u3089\u305b\u3066\u30f4\u30a1\u30fc\u30df\u30f3\u3069\u3082\u3092\u6df7\u4e71\u3055\u305b\u308d\u3002\u3055\u3089\u306b\u30e1\u30ab\u811a\u3092\u4ea4\u4ee3\u3059\u308c\u3070\u79fb\u52d5\u529b\u304c\u3082\u3063\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7! \u30c9\u30ea\u30d5\u30bf\u30fc\u811a\u3092\u4f7f\u3063\u3066\u52e2\u3044\u3092\u3064\u3051\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u7d20\u65e9\u304f\u6ed1\u8d70\u51fa\u6765\u308b\u3088\u3046\u306b\u306a\u308b\u3002\u30ed\u30fc\u30ab\u30b9\u30c8\u306e\u811a\u3092\u4f7f\u3046\u3068\u7a7a\u9ad8\u304f\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u7a7a\u4e2d\u6d6e\u904a\u304c\u53ef\u80fd\u306b\u306a\u308b\u3002\n{966091556139473}{1269706578060841}\n\u5f37\u529b\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3067\u88c5\u5099\u3092\u5f37\u5316\u3057\u3001\u81ea\u5206\u597d\u307f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u6975\u3081\u3066\u3044\u3053\u3046\u3002\u6a5f\u52d5\u529b\u3092\u9ad8\u3081\u305f\u304b\u3063\u305f\u3089\u79fb\u52d5\u901f\u5ea6\u306e\u5411\u4e0a\u3084\u30b8\u30e3\u30f3\u30d7\u56de\u6570\u306e\u5897\u52a0\
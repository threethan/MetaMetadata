"}]}, "id": "1224830916164758", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Roguelike", "Parkour"], "long_description": "                                                                                                                                                                                                        \n\n{1481570560284463}{1642706776884295}\n\u30a2\u30ea\u30fc\u30ca\u30b7\u30e5\u30fc\u30bf\u30fc\u3067\u99b4\u67d3\u307f\u306e\u6fc0\u3057\u3044\u30a2\u30af\u30b7\u30e7\u30f3\u3092VR\u3067\u4f53\u9a13\u3057\u3088\u3046\u3002\u300eMARROW MARROW\u300f\u306f\u3001\u7d20\u65e9\u3044\u6226\u95d8\u3068\u6a5f\u654f\u306a\u30d1\u30eb\u30af\u30fc\u30eb\u6280\u3092\u878d\u5408\u3055\u305b\u3001\u305d\u3073\u3048\u7acb\u3064\u30b9\u30c6\u30fc\u30b8\u3092\u5373\u5ea7\u306b\u99c6\u3051\u629c\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002\u7247\u624b\u306b\u6b66\u5668\u3001\u3082\u3046\u7247\u624b\u306b\u30b0\u30e9\u30c3\u30d7\u30ea\u30f3\u30b0\u30af\u30ed\u30fc\u3092\u88c5\u5099\u3059\u308c\u3070\u3001\u30f4\u30a1\u30fc\u30df\u30f3\u306e\u5927\u7fa4\u306b\u7acb\u3061\u5411\u304b\u3046\u9078\u629e\u80a2\u306f\u7121\u9650\u5927\u3060\u3002\n{1655946168775735}{1692667631737546}\n 7\u7a2e\u985e\u306e\u7279\u6b8a\u306a\u8155\u6b66\u5668\u304b\u3089\u9078\u629e\u53ef\u80fd\u3060\u3002\u4f8b\u3048\u3070\u30c7\u30b9\u30dd\u30c3\u30c8\u306e\u5f37\u70c8\u306a\u30b9\u30e9\u30c3\u30b0\u5f3e\u3067\u6575\u306b\u63a5\u8fd1\u6226\u3092\u6311\u3080\u3082\u3088\u3057\u3001\u6216\u308b\u3044\u306f\u30ec\u30fc\u30eb\u30b9\u30ec\u30a4\u30e4\u30fc\u306e\u30ec\u30fc\u30eb\u30ac\u30f3\u3067\u9060\u8ddd\u96e2\u304b\u3089\u6575\u3092\u6bb2\u6ec5\u3059\u308b\u3082\u3088\u3057\u3002\u5404\u8155\u6b66\u5668\u306b\u300c\u30e1\u30a4\u30f3\u5c04\u6483\u300d\u3068\u300c\u30d8\u30d3\u30fc\u5c04\u6483\u300d\u306e\uff12\u3064\u304c\u5272\u308a\u5f53\u3066\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5fdc\u3048\u308b\u6b66\u5668\u304c\u63c3\u3063\u3066\u3044\u308b\u3002 \u8155\u6b66\u5668\u4ee5\u5916\u306b\u30827\u7a2e\u985e\u306e\u500b\u6027\u7684\u30b7\u30e7\u30eb\u30c0\u30fc\u30de\u30a6\u30f3\u30c8\u578b\u306e\u6b66\u5668\u3082\u9078\u3079\u308b\u3002\u30b7\u30e7\u30eb\u30c0\u30fc\u30de\u30a6\u30f3\u30c8\u578b\u306e\u6b66\u5668\u306f\u6642\u9593\u7d4c\u904e\u3067\u30c1\u30e3\u30fc\u30b8\u3055\u308c\u308b\u30a4\u30f3\u30d1\u30af\u30c3\u30c8\u629c\u7fa4\u306e\u653b\u6483\u6cd5\u3060\u3002\u8155\u6b66\u5668\u3068\u30b7\u30e7\u30eb\u30c0\u30de\u30a6\u30f3\u30c8\u578b\u306e\u6b66\u5668\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u6700\u5f37\u306e\u30ab\u30b9\u30bf\u30e0\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u69cb\u7bc9\u305b\u3088!\n{1494481975640911}{967237065988020}\n\u30f4\u30a1\u30fc\u30df\u30f3\u3092\u4e0a\u624b\u306b\u56de\u907f\u3059\u308b\u306b\u306f\u3042\u3089\u3086\u308b\u79fb\u52d5\u65b9\u3092\u99c6\u4f7f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3002\u30a6\u30a9\u30fc\u30eb\u30b9\u30e9\u30a4\u30c9\u3001\u7a7a\u4e2d\u30c0\u30c3\u30b7\u30e5\u3001\u200b\u200b\u30b0\u30e9\u30c3\u30d7\u30ea\u30f3\u30b0\u30af\u30ed\u30fc\u3067\u6575\u3092\u304b\u308f\u3057\u305f\u308a\u3001\u5947\u8972\u3092\u4ed5\u639b\u3051\u3066\u5f3e\u4e38\u306e\u96e8\u3092\u3075\u3089\u305b\u3066\u30f4\u30a1\u30fc\u30df\u30f3\u3069\u3082\u3092\u6df7\u4e71\u3055\u305b\u308d\u3002\u3055\u3089\u306b\u30e1\u30ab\u811a\u3092\u4ea4\u4ee3\u3059\u308c\u3070\u79fb\u52d5\u529b\u304c\u3082\u3063\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7! \u30c9\u30ea\u30d5\u30bf\u30fc\u811a\u3092\u4f7f\u3063\u3066\u52e2\u3044\u3092\u3064\u3051\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u7d20\u65e9\u304f\u6ed1\u8d70\u51fa\u6765\u308b\u3088\u3046\u306b\u306a\u308b\u3002\u30ed\u30fc\u30ab\u30b9\u30c8\u306e\u811a\u3092\u4f7f\u3046\u3068\u7a7a\u9ad8\u304f\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u7a7a\u4e2d\u6d6e\u904a\u304c\u53ef\u80fd\u306b\u306a\u308b\u3002\n{966091556139473}{1269706578060841}\n\u5f37\u529b\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3067\u88c5\u5099\u3092\u5f37\u5316\u3057\u3001\u81ea\u5206\u597d\u307f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u6975\u3081\u3066\u3044\u3053\u3046\u3002\u6a5f\u52d5\u529b\u3092\u9ad8\u3081\u305f\u304b\u3063\u305f\u3089\u79fb\u52d5\u901f\u5ea6\u306e\u5411\u4e0a\u3084\u30b8\u30e3\u30f3\u30d7\u56de\u6570\u306e\u5897\u52a0\u3092\u8abf\u6574\u3059\u308b\u3079\u3057\u3002\u6b66\u5668\u3092\u5f37\u5316\u3057\u305f\u304b\u3063\u305f\u3089\u9759\u96fb\u6c17\u653e\u96fb\u3001\u8150\u6557\u3001\u8ecc\u9053\u653b\u6483\u306a\u3069\u9078\u3076\u3068\u3044\u3044\u3002\n{1262244765976051}{4210529589259749}\n9\u3064\u306e\u30ec\u30d9\u30eb\u306b\u308f\u305f\u308b\u6226\u95d8\u3067\u3001\u5bb9\u8d66\u306a\u304f\u8972\u3044\u6765\u308b\u30f4\u30a1\u30fc\u30df\u30f3\u306e\u5927\u7fa4\u306b\u7acb\u3061\u5411\u304b\u3046\u3079\u3057\u3002\u5404\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u6b66\u5668\u3084\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u5f37\u5316\u3067\u304d\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u624b\u306b\u5165\u3044\u308b\u3002\u30ec\u30d9\u30eb\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u5371\u967a\u5ea6\u306f\u5897\u3057\u3001\u5404\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u6700\u5f8c\u306b\u306f\u96e3\u95a2\u306e\u30e9\u30b9\u30dc\u30b9\u6226\u304c\u5f85\u3061\u53d7\u3051\u3066\u3044\u308b\u3002\u771f\u306e\u5f37\u8005\u3060\u3051\u304c\u8056\u306a\u308b\u30bf\u30fc\u30df\u30ca\u30b9\u306b\u5230\u9054\u3057\u3001\u6975\u60aa\u306a\u30cf\u30a4\u30ed\u30d5\u30a1\u30f3\u30c8\u3068\u5bfe\u5cd9\u3067\u304d\u308b\u3060\u308d\u3046\u3002\n\n\n# 20+ DIFFERENT ARENAS\n3\u3064\u306e\u7f8e\u3057\u304d\u30d0\u30a4\u30aa\u30fc\u30e0\u306b\u5e83\u304c\u308b\u3001\u4e01\u5be7\u306b\u4f5c\u308a\u4e0a\u3052\u305f\u30a2\u30ea\u30fc\u30ca\u306e\u6570\u3005\u3092\u4f53\u9a13\u3057\u3088\u3046\u3002\u30a2
n.com/v/t64.5771-25/499305027_1118474786934593_794513890139059547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyQA08YktB0Q7kNvwG0HnMe&_nc_oc=AdqbFx4PPaRUJQrKrFVLrsekrPsRNMEx-WOs5sPox5PPVdFBeDu5-erwik226R5uSvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZerAL3PiTIHwoUsPJxw5IG0wEWgPQSETy47f6BCuZlw&oe=6A4BA9CA"}, {"file_name": "Screenshot_City02.png", "id": "2207195003122752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_2207195006456085_1594530072257681561_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heNgcQwYbecQ7kNvwEGG5Xf&_nc_oc=AdpQuFO9TX3TEJxCoJCgYpMR4ShFzL_3-3EHx4zAIXlP7uHJME66TrZyDv8MDe2oKf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzLjzQTToJAdi8tTGWgV58me5fDrh2kac_B-QtMiZBJw&oe=6A4BC596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover01.png", "id": "1218473946757544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304019_1218473950090877_4275743793965084434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA_03szxXHQQ7kNvwEX_oCe&_nc_oc=AdrsKQieESClm81Fud41dk_IX0IuM4HoR7KSSfrQ0hOYBfjdgK6lsoketr6EbhgBk5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlfvozyFz6kR63n_oGfrbwakdKJAeMmNpbhMOooBkJLw&oe=6A4BCF8D"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "**MASTER THE MAYHEM**\n\nMARROW MARROW combines the fast-paced combat with nimble parkour mechanics that allow you to traverse across towering levels at lightning speed. With a weapon in one hand and a Grappling Claw in the other, the options are limitless as you take on hordes of Vermin.\n\n**ANNIHILATE THE VERMIN**\n\nFace a relentless onslaught of Vermin in combat encounters across 9 levels; after each, you are rewarded with an Upgrade of your choice that alters and empowers your weapons and abilities. Levels grow progressively more dangerous, and each world is capped off with a daunting boss fight. Only the truly skilled will reach the sacred Terminus and face off against the vile Hierophant.\n{3381129562056307}\n**BECOME THE CHAMPION**\n\nHone your skills with customizable loadouts in Unranked mode or compete for highscores on the Ranked leaderboards. Avoid enemy attacks and retaliate with ruthless efficiency to build your multiplier and maximize your score.\n\n**Key Features:**\n- 18 types of nefarious Vermin out for your head\n- 3 unique worlds, each featuring a boss encounter\n- 7 Arm Weapons, each with a Primary and Alternative fire mode\n- 7 Shoulder Weapons, powerful recharging armaments\n- 20+ handcrafted arenas\n- Mutators that bend the rules of the game\n- 2 Daily Ranked leaderboards\n- 1 maximum intensity Weekly Ranked leaderboard\n- Unranked runs with customizable loadout\n- Playable standing OR seated\n\nMusic by Karl Casey @ White Bat Audio", "short_description": "Wield deadly weapons and master high speed parkour combat in intense arena shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
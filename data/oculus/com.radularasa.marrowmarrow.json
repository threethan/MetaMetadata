96723715", "locale": "en_US", "screenshots": [{"file_name": "001.png", "id": "1493750162297812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_1493750165631145_3384279999103884519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZlLFPQHVgwQ7kNvwHsXzPT&_nc_oc=Adq8UCmWrSe3llKTgu0a9C46gCQV5Cx1ylW0dX1z0YcPfhrLz-k-qBoIL5mVAlvdWvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2OB5avA9wwrovrorVCJA1e1yJwY_btM8xiidIyvGow1Q&oe=69F0AF7D"}, {"file_name": "002.png", "id": "875255582239254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_875255585572587_4782470021058525959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZD4CXsQbcwQ7kNvwH8XAEP&_nc_oc=Adqw9jL1_JxWloSBswxFLM54sA3pR8tl42YCq0XG7zEJzliFQXEiW84WedCDDAAzXXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YvhK4hkHpVUrY0_q3L8i33R0MmxUmpmgQ_pwWz4DbzQ&oe=69F0D0F8"}, {"file_name": "003.png", "id": "1315407727116773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1315407730450106_816205515320149761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikudwjk3ZckQ7kNvwHzQcvR&_nc_oc=AdpjdTyY9PfMgOg2Fc7LPstda_QtWK3nBP_a3ewG4gy8ceVGKpTIKGfkii80XhRZ17Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2pC7ztKF1cpJKoy6smIO6ZzHtfESa77OWpHOuLKPWxuA&oe=69F0C3B7"}, {"file_name": "004.png", "id": "1480522350478787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299139_1480522353812120_8151815144466324764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bidJlvQHR2gQ7kNvwGRqMlr&_nc_oc=AdowvOSmlxgotfxvP02yDgeyKKIDx0IsYGkjSfGEUSw7yeRbGBBTrXiePsDBLqJ40oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af30nmWv-UweIGPJhhvNT17N5gjxwjRTlP_kS7YJv76FSA&oe=69F0ABEE"}, {"file_name": "005.png", "id": "3126616211061894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_3126616214395227_7799638510484502470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QCmAU0bXrwQ7kNvwHCR6bH&_nc_oc=AdpcR-k_7gBgYRacu97aRouULNzuOkz3Jcy7fXhu2CwyM9tg3JotN7UhbubLOkypENE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2KZmd7RYHfXtiUBt6SHFsaLapsZGmVIWUOwz7cGGYNew&oe=69F0CE2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumbnail.png", "id": "1473349277670537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619677_1473349281003870_5191474009580807201_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLRz5JNFnYMQ7kNvwHB9J1D&_nc_oc=Adr_8_lnakLru1Y8z0kidlA1E7R8gaT9vqjD_G3Z7txTjtaWW5e3E9heEl4udx5OWVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1MV2og_hBL4MqCELmhXoxPRxAp4ndO6Pn5SxA4l1audQ&oe=69F0A55E"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "                                                                                                                                                                                                        \n{2038755116702783}{2375427979589402}\nExperience the high-intensity action of arena shooters up close and personal in VR. MARROW MARROW combines fast-paced combat with nimble parkour mechanics that allow you to traverse levels at lightning speed.\n{2055539702040977}{1259166945709500}\nMaster the movement mechanics; ride walls, dash through the air, and grapple to walls to elude your enemies or surprise them with a hail of bullets. Use the Drifters to slide across platforms or leap into the sky and hover with the Locust legs.\n{950251894181579}{1998659797400552}\nChoose from 7 unique weapons, each with primary and alternate modes. Blast Vermin with the slug shots of the Despot, electrify them with the Orchid, or snipe with the Railslayer. Complement with 7 powerful shoulder weapons that recharge over time.\n{1234701835497416}{1559343555136446}\nPick upgrades and define your playstyle. Improve mobility with faster movement and additional jumps or empower your weapons with static discharge, withering rot, orbital strikes, and much more.\n {1610286616786944}{1230119435979561}\nFace a relentless onslaught of Vermin across 9 increasingly dangerous levels. Only the skilled will reach the sacred Terminus and face the Hierophant.\n                                                               \n\n# 20+ DIFFERENT ARENAS \nExperience over 20 hand-crafted arenas spread across 3 biomes. Embark into random sequences of arenas in every run and learn the ins and outs of the world.\n\n\n# BECOME THE CHAMPION\nCompete for highscores on the Ranked leaderboards. Avoid attacks and retaliate swiftly to build multiplier and maximize score.\n\nMusic by Karl Casey @ White Bat Audio.\n\n", "short_description": "Wield deadly weapons and master high speed parkour combat in intense VR shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25795987053413925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_9439869
103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jezoNj4z9MQ7kNvwERaZrH&_nc_oc=AdoQFz3bPZCU101nQcwx889EOYCCYGivNzv32_LCz3jAqGhjKdCtsf6dBsZA2pu5Zh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUR_n-8GyYf-lTuJLO-tgYh9eH0t05Ez8oU90EzhSYvQ&oe=6B05B757"}, {"file_name": "Screenshot_BloodPool01.png", "id": "1325397069074136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307326_1325397072407469_231826357942605516_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMyctXEEOPsQ7kNvwHOAJYG&_nc_oc=AdoFITpqJtfWZ9n9u3fuWlH6071wS0oHjalip8lIAlxDa-gZc07p2l_5_d9IU7SN-jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZQeCVlhIFD4w72AY5NAL7AxpbjG6h_I2XRZT28VkamA&oe=6B05D65C"}, {"file_name": "Screenshot_Temple01.png", "id": "1812540279349457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_1812540282682790_5139322304496402000_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUz2TWzh78UQ7kNvwFqomBK&_nc_oc=AdrFR5QFOmiXJR17U9EmeuynQAt5-rYdE2IGzfklyw-JTrdTH5jofW85eUJrwF3UMeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmjT1D5KkgoBtKS0WsXMs__SH5JavvtEUpFBJZSITnqg&oe=6B05C996"}, {"file_name": "Screenshot_BloodPool02.png", "id": "1118474783601260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305027_1118474786934593_794513890139059547_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkCfTbnioi4Q7kNvwG1eeOu&_nc_oc=AdoyZ5WcOzRk12HGKOFkcJQkcTNKb80BdAueFozBIg8WD4qDareQH4yCpU7UBBRjG7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-hQ0zl-ZsBrkiRhGmBQ_I8oICdATbbp9P74KiQ99OhA&oe=6B05C58A"}, {"file_name": "Screenshot_City02.png", "id": "2207195003122752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822581_2207195006456085_1594530072257681561_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNT_I2vNDZoQ7kNvwF7_o-T&_nc_oc=AdoBI8k5DvoJAEURrU_lyMHh-35DNgfRQBtKIz64wFVal_we_tFo3PB4P6yQc9gahbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbxjbRV6Ukp96J3SCo0G6DPhT8B3I4DAf9v6wd3rEXXw&oe=6B05A916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover01.png", "id": "1218473946757544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1218473950090877_4275743793965084434_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSZcu748SEsQ7kNvwEkKd8L&_nc_oc=AdpcwZro-dLpq1EQDLmjMXEii2pyAFmKRAjD_zdPNPO0dvb8npRYGmsYCwplLUHMQVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtUQxOx_hQINTciVDxHPicbPkrNb0B6esfejy-hM6hvw&oe=6B05B30D"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "**MASTER THE MAYHEM**\n\nMARROW MARROW combines the fast-paced combat with nimble parkour mechanics that allow you to traverse across towering levels at lightning speed. With a weapon in one hand and a Grappling Claw in the other, the options are limitless as you take on hordes of Vermin.\n\n**ANNIHILATE THE VERMIN**\n\nFace a relentless onslaught of Vermin in combat encounters across 9 levels; after each, you are rewarded with an Upgrade of your choice that alters and empowers your weapons and abilities. Levels grow progressively more dangerous, and each world is capped off with a daunting boss fight. Only the truly skilled will reach the sacred Terminus and face off against the vile Hierophant.\n{3381129562056307}\n**BECOME THE CHAMPION**\n\nHone your skills with customizable loadouts in Unranked mode or compete for highscores on the Ranked leaderboards. Avoid enemy attacks and retaliate with ruthless efficiency to build your multiplier and maximize your score.\n\n**Key Features:**\n- 18 types of nefarious Vermin out for your head\n- 3 unique worlds, each featuring a boss encounter\n- 7 Arm Weapons, each with a Primary and Alternative fire mode\n- 7 Shoulder Weapons, powerful recharging armaments\n- 20+ handcrafted arenas\n- Mutators that bend the rules of the game\n- 2 Daily Ranked leaderboards\n- 1 maximum intensity Weekly Ranked leaderboard\n- Unranked runs with customizable loadout\n- Playable standing OR seated\n\nMusic by Karl Casey @ White Bat Audio", "short_description": "Wield deadly weapons and master high speed parkour combat in intense arena shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9173719082733984"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1616223663337731"}, {"status": "PUBLISHED", "id": "1733939797744481"}, {"status": "PUBLISHED", "id": "1975877009701178"}, {"status": "PUBLISHED", "id": "2076707002888160"}, {"status": "PUBLISHED", "id": "2199983647408784"}]}, "baseline_offer": {"id": "2199983647408784"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789570800, "status": "PUBLISHED", "id": 
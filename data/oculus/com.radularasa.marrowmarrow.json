jXYpV902tXXhiRvl51oE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xCqyH1UiIywK706F6xSj3HjRcG8ZbFP5TKHjYvVWHSQ&oe=6A36C3AE"}, {"file_name": "005.png", "id": "3126616211061894", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619159_3126616214395227_7799638510484502470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xgPe3RjO58Q7kNvwF5AMY0&_nc_oc=Adr0o5yaFpdlOzawPQSpjuyGbOKcq6CcN_MKPCRCzYd_57wcRBVdc8vgDYTwq0QB-FY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q81Oq5RQPuFVby1z4OUDakCq0-3EH1Onlzr7jKNiXLw&oe=6A36ADAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_thumbnail.png", "id": "1473349277670537", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619677_1473349281003870_5191474009580807201_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLUuOH_fcJ4Q7kNvwGV3WGh&_nc_oc=Adriabvo3XhuqGAUI3qe9ynZKLvd5cdH4NYh5N1LWIKHpqG3qSXyfI9HDGJ4uUWe4y8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_829uWQHnMj_iaNUpHYOjJUuGtfFeikDLdChffj6k7fQ&oe=6A36BD1E"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "                                                                                                                                                                                                        \n{2038755116702783}{2375427979589402}\nExperience the high-intensity action of arena shooters up close and personal in VR. MARROW MARROW combines fast-paced combat with nimble parkour mechanics that allow you to traverse levels at lightning speed.\n{2055539702040977}{1259166945709500}\nMaster the movement mechanics; ride walls, dash through the air, and grapple to walls to elude your enemies or surprise them with a hail of bullets. Use the Drifters to slide across platforms or leap into the sky and hover with the Locust legs.\n{950251894181579}{1998659797400552}\nChoose from 7 unique weapons, each with primary and alternate modes. Blast Vermin with the slug shots of the Despot, electrify them with the Orchid, or snipe with the Railslayer. Complement with 7 powerful shoulder weapons that recharge over time.\n{1234701835497416}{1559343555136446}\nPick upgrades and define your playstyle. Improve mobility with faster movement and additional jumps or empower your weapons with static discharge, withering rot, orbital strikes, and much more.\n {1610286616786944}{1230119435979561}\nFace a relentless onslaught of Vermin across 9 increasingly dangerous levels. Only the skilled will reach the sacred Terminus and face the Hierophant.\n                                                               \n\n# 20+ DIFFERENT ARENAS \nExperience over 20 hand-crafted arenas spread across 3 biomes. Embark into random sequences of arenas in every run and learn the ins and outs of the world.\n\n\n# BECOME THE CHAMPION\nCompete for highscores on the Ranked leaderboards. Avoid attacks and retaliate swiftly to build multiplier and maximize score.\n\nMusic by Karl Casey @ White Bat Audio.\n\n", "short_description": "Wield deadly weapons and master high speed parkour combat in intense VR shooter MARROW MARROW. Slide on walls, dash through the air, and charge head first into danger to get the upper hand as you rain down destruction on the foul Vermin onslaught."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mwpolicy.monstermoon.io/", "developer_terms_of_service_url": null, "publisher_name": "Monster Moon", "support_website_url": null, "website_url": "https://www.monstermoon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
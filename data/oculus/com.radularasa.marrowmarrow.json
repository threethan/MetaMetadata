n.com/v/t64.5771-25/499618102_1493750165631145_3384279999103884519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSsc9J6AOmwQ7kNvwE52fYo&_nc_oc=Adrj-VaoTOpm8p3i8AEQxUxJ55ACeYWcSCYFbJQM5H7pis4y5gnKCD7wmp7S6tSVkDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxReSEUrTX5ZTCqu4xYdgaZzVg4xSxBAEe5rWkn4mj9g&oe=6A4F9B7D"}, {"file_name": "002.png", "id": "875255582239254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_875255585572587_4782470021058525959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0owG-6W_Z9MQ7kNvwFNI18r&_nc_oc=AdqFkI8m5MMKqhOA8Tp2oOc2fngGH0m0OWsRwZ_lxk1fQV_RtYwSqiZl_ZNP3PmSyK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnp9TiZc2qgEUlHR_nl0gw9bIoZpKERskRP2vsMMrgFQ&oe=6A4FBCF8"}, {"file_name": "003.png", "id": "1315407727116773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1315407730450106_816205515320149761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQeZYFgbG6AQ7kNvwEQOp96&_nc_oc=AdoGKCgTQRtwl79mUBUwhzf-2LaBPh0rW2pVAW0s2Z6LVMXeAvCGsNevm5zD_-GLObE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0QETSNCB069hIevz1qGCJM3H8hrPhk9dynYKum_OiCA&oe=6A4FAFB7"}, {"file_name": "004.png", "id": "1480522350478787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299139_1480522353812120_8151815144466324764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFiE1HkVaAoQ7kNvwGqkHYQ&_nc_oc=Adpt9D7lB1TjLXKOKOrJoEcmFzolNzeNn3U09knJonkGZqqz0NKNsjTjECzLxGW91m0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvRyg3WGbl5XkcU23Diso28qKMyz3i598Px6BpHrGRnA&oe=6A4F97EE"}, {"file_name": "005.png", "id": "3126616211061894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_3126616214395227_7799638510484502470_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF-iObOuC8EQ7kNvwGFOIzY&_nc_oc=Ado-JnfWljLNzptOpymf9lngXhTs3jAfZlTr0kIRWOVAyJqzmwLEdNBlzE8f7PtsfBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwKQYgLdBv8X2eq5JbdR7X2H8qUwFb6YmjRIZb9Gl-oA&oe=6A4FBA2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "1002757895695949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623601_1002757899029282_4142100643413937638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpCzycT_kaoQ7kNvwGR8cX5&_nc_oc=Adp8Xyg-yQVAmp45GvUX8sccoWcKmmFPyRLzBC8e2R8l74QjHRNN78jS53onPVSKVGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoADJPDVRAvzRZcdP-3e0bqk6XhKLfB3JxVC-gk6xauQ&oe=6A4FBFC0"}, "display_name": "Marrow Marrow", "keywords": ["FPS", "Shooter", "Parkour", "Roguelike"], "long_description": "                                                                                                                                                                                                       \n{1272870495008361}{1259166945709500}\nFind your flow as you chain together dashes, wallrides and the grapple claw yoink. Soon, you\u2019ll find yourself gliding through levels, weaving in deadly attacks. Alternate mech legs let you slide across the ground to build momentum or hover in mid-air as you rain down attacks.\n{3070471319830009}{1998659797400552}\nTear through your enemies from afar with the gatling-style heavy fire of the Despot or up close with its bouncing slugshots. Perhaps all you need is one well-timed shot from the all-powerful Railslayer to pierce through enemies.\n{1043952672142139}{1559343555136446}\nCall down orbital strikes, emit static discharge, or spread withering rot with every shot. Grow your strength with rogue-like upgrades that amplify your abilities. Whether you wish to bolster your defenses, accelerate your movement or amplify your weaponry, there is a path.\n {1610286616786944}{1230119435979561}\nWhether it\u2019s the leaping Apostate\u2019s razor sharp scythes or the blazing projectiles of the Acolyte, each enemy brings its own deadly weaponry. Anticipate barrages from the Carrion Prowler, evade the sweeping laser of the Asterophore, and pin down the elusive Mnemosynth. Only the truly skilled will reach the sacred Terminus and face off against the vile Hierophant.\n{2038755116702783}{2375427979589402}\nFinding your favored arms is just the first step on the journey to mastery. Each run will bring you more in tune with the movement and allow you to traverse more freely and nimbly than you ever thought possible. When gliding through the levels becomes second nature, you are an unstoppable force of vermin annihilation.\n\n\nMusic: Karl Casey @ White Bat Audio", "short_description": "MASTER YOUR MOVEMENT. VANQUISH THE VERMIN. Experience all the exhilarating high-intensity action you know and love from arena shooters up close and personal in VR. Zero in your aim, hone your movement, outwit the vermin, and soon you\u2019ll be flying through levels leaving a wake of destruction."}, {"images": {"nodes": [{"file_name": "SelectYourWeapon_Meta.png", "id": "1655946168775735", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1655946172109068_2913228223281679909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErhzHIyKYiEQ7kNvwEnmncC&_nc_oc=Adqu-uZtjpav_20K7a5Z85fBHH8F_FXmEIiHEWNa-2Q_sFtpPRbriQsCqy5zWIzOiuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5zmEuGqTGKN-0j4lRgJpesWGSfwyDC-7k9aUvWRMbFA&oe=6A4F9980"}, {"file_name": "JumpDodgeRun_Meta.png", "id": "1494481975640911", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1494481978974244_84412558284257064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhOZhcBFjiIQ7kNvwF6qpl1&_nc_oc=Adrvk1UWL6yNffSl6MMFbMJyGD_Z6WmzwEbQDCSnyFInal6j07tcNehxfLFP66ek-5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfJKgKV_vgGUoyqU4k4FBO_WPfYIyKRvBkyQX0m5ApSw&oe=6A4FC0FB"}, {"file_name": "MasterTheMayhem_Meta.png", "id": "1481570560284463", "image_type"
8434748", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCenXWGiEhoQ7kNvwHCpCJp&_nc_oc=AdqFsKsgsT_8xppEY2bRPx2daZoL1gXmFyZSj7LdIpPnN4Xuj1W23AwM9iaHs_hKgMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V_pYm5bhRYVABT1H88kpb6YT8_cYyCq4NOJa57At1eQ&oe=69DA5C9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inj_1vYnhNIQ7kNvwHx3Rxt&_nc_oc=AdpfS8Iy5A9EPuzJ9G2UEPyT5-A-tnPvTu45NcNkk5hk5fsGU1dSL6kcyThpia_6cbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tExZcPI6M28WQ5vawIVH4RkEGDc8-45Uk6ZY4QqYP6A&oe=69DA4E92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1rrVc86aMkQ7kNvwEJf_2D&_nc_oc=AdqsXg4t1nelJsBwWmj6d66M03PLjnx0Ny0k-6L5hbx-GK2pNkZSWLrirwsM53M8Anw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nCgVctKkKUAhk3X0zYxix1Dhe2j6nCvjZczedlOfrxQ&oe=69DA57E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78IsxYKsGUoQ7kNvwGRO-sE&_nc_oc=AdrnBnANBej_S_PjchTwUaem7yfMvEeEM3Vh-LlFZR6pLRvUYlWqTqzYkfoND3aSnYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27uggOVAy7C6-eK3mUyRmdq28S0XpxrY1zfc7Mn0WB_w&oe=69DA5AC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMNEKIkkW2kQ7kNvwFJVSdY&_nc_oc=Adr2DT9RRlDJlWH5PejGy7LJP4WstEhYIM2k7uDyFDpiIyhNWKSBV6qPNCANS1XsLAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qGKRHMJ-iMwJ3bgNI1Fogn0o6c2aJDRr3_vnaDa4A-w&oe=69DA3CC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxBM61sNsO4Q7kNvwE0N3zB&_nc_oc=AdqAMoeeEW6OjxREKIoDD1on4M5wzK9QIO1AIZ974mmyKPelQV8nYaFhRz
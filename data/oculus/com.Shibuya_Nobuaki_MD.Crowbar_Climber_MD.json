dhlxfxdHrdmKbTPg3dUbcaw8wrTNuqv5JktMgB_ZyY1pSSanshve8zseoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v6xA4e1LvoePMZbpIkhhz2y_KiBz0RUf1wQiy3qbRQw&oe=69D4F5E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFRxINhmnS8Q7kNvwHs34IK&_nc_oc=Adq2-alJYsgRpYh5iX1b0KH1wh6E25WPcP_lq_jNJtB-BCpT9DZb1_vymC5ObgNgjc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P7S2HjGCmlZ1TTQ32rGMvecgzgGEg6H1Z_kXPDpXFJQ&oe=69D4EF79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvYtY5B6A4QQ7kNvwFHW2bj&_nc_oc=Adou4Vu-UGWpsCV3kc3CmL1_pLdJby93K2LVxxcmsa1x26D-385qsz1pbo4BRXru064&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af159zEQgg7bKH-y1rIxD4JceGrjLi86UwxfCeDy7PgI2g&oe=69D4E1A3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0CavrzK1owQ7kNvwGuZO51&_nc_oc=AdrRpuU40-7WAnhRCbw0AgYKX3pohDpV86rKbU4CefhPd62Bnst9miZrgzlnOrtsZ1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04LH4wyCnMlhVDw2pR-k5zJdt7OMHbXPtlfFEHxy7fAw&oe=69D51640"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CEL7l7MGMQ7kNvwHHTi0Z&_nc_oc=Adr8aRbFi2xYkdrZnXA4iK2bp9wO4qApgOVk2YGoW0YNsVIqClBvmKtU9vUyFS76dnM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UAOG29F2FhBvqGXT-TWX-g-vG3ip58qeTDLxYwhvJcQ&oe=69D50836"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBjLSqauJfsQ7kNvwGHbJP2&_nc_oc=AdoM0exUzGDPAGUhaSOohK53_Rkctf5NlgU8XOkdkBanffg9svM15SHaUfu8c9imxn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23bGJiD4BQ2pzZbAq9ztDkQ7Is9Vt6Fy7Sfsgy3u2hbw&oe=69D4F5FC"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il-_DwG6PzYQ7kNvwEZsx_j&_nc_oc=Adq4M4y685fbXBygOn9xPX2iit1XJlzMa15u9PMvtEdU5ZZFNOSohAeV2Yrk6LAX3CI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09o1zJFnRDBvhZVVKXLqxvP5XXwa0A5rKDfUJClh_HCA&oe=69D4F24E"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=657lSSgbWJoQ7kNvwHc_9hm&_nc_oc=Adp26lOZ3QKv3EG0sEiloOm2NeYAsqxF2lK_QSVXm3nel8Z89SbdvzJ1vnt4vIyLM7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KXpHA0Wui-hP2qmFpxlDj8aLt_rc2trQId72WW9PNbw&oe=69D4FFF9"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb
/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue5yPsJkq34Q7kNvwHhOby3&_nc_oc=Adr4hVHeMt2yoiRByo9AJmA9P7ukr2S7QMFiq2FgoSr8ABgcGTFot4s96KTqiOdRaaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-AJHMVU_pUkfcMci4832-31RMSwHkbRCKg2Lpq4IX4A&oe=6A26C592"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB7kLbRht6EQ7kNvwHH6xg7&_nc_oc=Adq_ZeG458T8L5SGe5tkON-Md7Uea64KVkG3Ft59JC-65LXY_O8NC-q8LN0_BmekrF8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dq3IW6z-sRM_3aSHh3slBUQdhfhGVSYnl7jLjcNrpcg&oe=6A26CEE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRSuP4rbaRYQ7kNvwE-0ib3&_nc_oc=AdqJlgcYJuJ1pqljuIA8zmWmiXdLacY82IuUZxmUIKgeucNLftjZX_MVVttMZAEECXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_09D_Jox6FI0YCoEQvTWn2XyWWqfnJGPxRSLz86tAAng&oe=6A26D1C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueBHD8rY70kQ7kNvwGGHwo9&_nc_oc=Adq3dyeZpVIztfOnMGMoBklAteGRzyxXMRJ61RrDkuxUPplnthj2eGwA7x8LB8S5TLk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TdfQFXV3DNOO6eANU1n_4rt1O_jGqzhN2AMatPNceLw&oe=6A26EC03"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dADTGAaMt0EQ7kNvwG0DzcL&_nc_oc=Adq1XYhEeVy_wXA71qOoHk0_ZTYxtK0uKySpQzppznH16YcKmTwNlUnV2XlTxr5Wxy0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gPwCQrOko-p56dgmfjap_zuUlMZQM4PMeKVXjVLCgIQ&oe=6A26EA8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97jW3o3K4koQ7kNvwFCZzg9&_nc_oc=AdqrL9lwsQiQAjLk3W-PK5U5mQZfHAmZew8QdfvO
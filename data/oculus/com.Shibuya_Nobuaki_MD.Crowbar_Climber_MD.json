=S-HG-m1IVt4Q7kNvwHnrM_Y&_nc_oc=Adro6SXwDlLRinswIml6rGJ9qLZ3ASdjOQ8n3uo6iW_6CSQhzRsLJ5iW1YyZTZLPWIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRc2DVjts7yTlJzcI1QStZRYC0czR-Cpn5icNfhJSDhA&oe=69CD28E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbqZwjdXLucQ7kNvwF2oAQX&_nc_oc=AdoS-SwwL4RwO3KmmMOnYDmr6qNMj3o03KnV2vfo8zA0GpfgGy3HqONZoF2Cw9ePW1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb7g9vQTqFvdN7S0EYYkHlCGTDLtguCLnpaLiFdxgVZw&oe=69CD2BC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5KiIWa5fyYQ7kNvwH5iWjJ&_nc_oc=AdohK0ik9bFj6p2mspQDdkFwc4NO49-0xj9Jj0Px6ZzM0sKZYESs2BMhy_CgMGhkbxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6DDFn8sPsQZYNNZCsje4H_YWZfWYAg0uJ1-VCgER0pw&oe=69CD0DC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96FLXx31iFYQ7kNvwGBO4oH&_nc_oc=AdqOa_uSXl1-kPfmQ6foo0ZEXzMK-MjtK9VeTFC2n0vfMwI_0xGxYNdxE6Nw0F4biAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiwEi71c8_S8pkqe91QDVtiv-jViEr5KJkrY-Ind3fmw&oe=69CD0C4F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dJG59Lp5zUQ7kNvwHA2XV6&_nc_oc=AdrePaAOcOqs85VtFba20r0UYoHWPvBgQF1jWMAdrOXZcshc09gSr4lU0mT2DqANAIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyq9Dq01FNnzCq7aUKMQ5xpkYSz2tzFqcsRggDqQq7GIg&oe=69CD22CC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIQupur5k74Q7kNvwHcUb-i&_nc_oc=AdonPm1V_TAvEq_YZ0YBwSHgWjxXJ1rEZi1MQUQ_NY2gsfGCirQhzQhhM5f0zLo
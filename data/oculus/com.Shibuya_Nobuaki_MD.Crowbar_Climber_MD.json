64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa6S3s-BFnMQ7kNvwF7IbQQ&_nc_oc=AdrvMkqc5b1szWCsc-UXCSetf6dCD_OLVEGvcpGNAGV8E09vhccVVrjENxJLBUvxC5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtEWTRfQ2NhpwgpdzOqecfTBGHF2877_zhj2aX2nX-8Q&oe=6A510340"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iX31JD7v9YQ7kNvwG-sysV&_nc_oc=Adq-ULOuAuRK__7f4WcNcIzCW3ABu07eUODvM-d0ifDFkkUK0pHlohCYy_qzZQmx3iM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASE0ElcdGiTYf-C0n7v0LRsfGOR5IBmsi6fW-6AmVoPw&oe=6A50FCE4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7CrFugHVCEQ7kNvwGq67FA&_nc_oc=Adqg3iPk0-LAAPQefKb1wypkBLf9tfwQXzOnYrl4qh1wflgvTU0IaMoX2-wi_I7dufk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgjibUghIVwpqrcCWhsw9uHj_xVuChU8YHBKYmpsN1ow&oe=6A5111C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb-NGeDbpWAQ7kNvwHIz7Jv&_nc_oc=Adpo8tA0P5qA0F_HGL1D24w482HM7bzWH11Lk_KCfvg7vggswTVoaI1vpNfP5EEp_h8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Uy469i-y0DsNEX8sjkvAsidO2wiX_sOVtGIzCQhW6w&oe=6A50FF3D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjXwzhtILEMQ7kNvwHROA53&_nc_oc=AdphMmRTe-hLLEPl7Mva3MBmMTelILdWZ0yonklRgp3V6i9ZTbTl2QfviimnBuxMsxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe2dGk35Tr4aLemGzEZVrE2pTLMFAGb1iJd1NytCy3-w&oe=6A5119A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
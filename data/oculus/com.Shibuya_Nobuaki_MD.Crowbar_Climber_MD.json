D4j4fXTNcRbAgMw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXr8VxRUrF7HWKFZZrvuXpL5k6OJuO_htWZqaIsJMgIA&oe=6A4A6C1E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNiOsTtCYAEQ7kNvwHZcX98&_nc_oc=Ados4beOrZUs6a8ffmGSrDKwWWG_OtppWyE-91ySPIiGR6pSkzRMvnOMUKCNMdxJz88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg6UzsJiNeLcZWAlLDofp-nQ6rOBgFGxFBwucuQtHQlg&oe=6A4A5E12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw5Kt2Yh_gUQ7kNvwGbI3UA&_nc_oc=Adqq9XGPJCeMw7Eer_InFhmxO43bUEHFAndGObYQUHhqL7g4jhwWVJXG4Ef48k2Rntc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjTOQwhYpdZJgJCen3M9zRGSDngMppVk9nTyaEOO0fjQ&oe=6A4A6765"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-5JePZsrWYQ7kNvwEPU7gc&_nc_oc=AdpcgxGlO4teWibcEZyCa9LFBS6kWrZf5rFsjm2132Y_QKS-mxK6x9N1rCkel0vdwNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhn2_hO02U3SomLHSlOMdhkuR70aL6P-63jnnBQqbRyg&oe=6A4A6A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IcsYxKZh0QQ7kNvwGlIlwZ&_nc_oc=Adp7hcSdkhHQS0PwNGaSkcJrtkOH6GAJAZkjg7Kqzpg8W4uIBGIdqqjzPh2fvbw3jsQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfItovdl6nZlscgpgOzImhpX30-5SpXw6zeK3r2pQbRg&oe=6A4A8483"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgEzFhz9lDAQ7kNvwG_ZQKg&_nc_oc=Adol53uPrcTqJxR0Svs-4yPzhqXy3RGtS8QE7mZBZC9bnJEXMIM89yiKO_Mnd3DANyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJQ_dv56MTs-vmo7kr-DQq5XLFczN8rezzlyRHaoQxwQ&oe=6A4A830F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
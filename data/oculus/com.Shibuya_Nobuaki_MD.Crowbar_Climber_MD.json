3Qm1zW_FGvKmFiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l6lyaLC21Rv-s7WuaYcNSuMVF3eM5V5CYbiTCFNL_Cw&oe=6A42831E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2jPTTtNJlYQ7kNvwE3EnwK&_nc_oc=AdrtZFTvlkWmmsenEY4rljGcqep1tl8oJpRxF7tkH-eFstV8wdFZByOLvOIrpgqZlvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82Fn8qXZxIeR0OgWXQc2C40lXPa5Z67mdeJQx4ruWvUw&oe=6A427512"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcGPGb12-j0Q7kNvwHoLC-k&_nc_oc=Adpl8tK3GcasADoyplibGqLTKd-LUkdVbS8gH11jrrH5SEwefW9SH9Q36gaFSR8noNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CZ4hF1DEr0nVoNe5W3zhE7PmVkFOPOHzc1EaihbRz5w&oe=6A427E65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CScD5H_i7U4Q7kNvwGbF8Q7&_nc_oc=Adr5c0MC09AnkVP772UqyqnJhZq5KKrlfwK4qQvystYQCiVZcX1rSzsMpY7pXN0kUxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QtkSt08zFHT24ZkGYk8VA9XIIkRBzy0cMc3_ikjPZMQ&oe=6A428147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuRvjrGyrhkQ7kNvwEAQr_p&_nc_oc=AdremT5k-StNscYnS3udR8RorLYVkhj9dEL-T4m8uEcG6jmf_TbGo-YqblPYVrA_S8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wyVmp1hln7vhSumdWLwPsa23kmRyAswaE3JXaBwo_Zw&oe=6A426343"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ypt02ZgsLgQ7kNvwEGH653&_nc_oc=AdqMI7767USP5wlv3h_N-xLaco-hvIhOJgC2nvx9gamRjvsdRWnN9dYEhyiD4NVpi5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fjNqWhidHgGp8aZFuwGnLHNpd_vzsxROoBoSj0iIlwA&oe=6A4261CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
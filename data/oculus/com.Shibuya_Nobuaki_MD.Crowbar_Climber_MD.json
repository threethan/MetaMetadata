com&_nc_ss=7f20f&oh=00_Af8n1qciUa_8tZy96A_IxT7Fi0XM1vbCrv4GVvUHpqR4xg&oe=6A22DEC0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6d4tf_Y_UoQ7kNvwHgLwSM&_nc_oc=AdrRYHTpHnFX8dPGebEqQnWohi58kdaU8CCB6_7ID6q3KG944HMDfSdv1pLkbVbHHZ0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86rVgqgTUwhZGGcMk_jwBR9gi4gDvROUMsF5H2AP-NYQ&oe=6A22D864"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZs0qhs0M4Q7kNvwEjTgJ3&_nc_oc=AdrYreB2uu8Nrmg4PscU4gXVSVltGEDbYLCWk-YhqlAmL1BDxBIOjSLpT0XatLJNYiU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84pFM-7ZVXyDF7ADG9x12iXq6VVbSpJX8CYmca_x1z3w&oe=6A22ED49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "997194399682950", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618910_997194403016283_2414986522900241963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbaeojme9JMQ7kNvwFoH-vH&_nc_oc=AdrnjBgJV7SOdCY9sGQiUylArJv_SbYslkyIF6v06pgvzRq-okE6Xfxlhl9L90NbHQs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xFUEEReY8CEshCNLcyp9f1_tnGXO5zk-xCaqD7uBsZg&oe=6A22EC56"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{1671435490707886}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{2339678569868647}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all?\n{1683919399266895}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from!\n{26712839881658080}\n\n\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2491874854662321", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620860_2491874857995654_7151269643203248800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YnpE0bl3hgQ7kNvwED6ShG&_nc_oc=Adp4WgVTNNSvaseYWWvrmLgQatSBxEO_neUN6-vtRcOCn3QoEYlDJnX4OSbtvOCYr2w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tGfJ8ny1dF1HN990IDIGCpQFusTRgFrHxE0LJO00mCg&oe=6A230074"}, {"file_name": "Hero_Cover.png", "id": "1963731821685694", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/595112037_1963731825019027_4734823188066437645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z81o5ld629EQ7kNvwHQGbjv&_nc_oc=AdpgT4J9qFyG984bpXF6oefAy6Jn_zlFc9RlWQ9tkU2
/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpHFby8sBA8Q7kNvwH8WpIG&_nc_oc=AdqT2WsSpyc91Awrvj1tyILmqKpLDwwjf8_ubHhTkR8dPw1qlhGzjfBORirAH0ikePo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vUx0nKNCw-jFdPPs7dUaRvvVd6kJ1QOAnxXFHl2bZgg&oe=6A217F92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goYSFoDA09IQ7kNvwFTJdMd&_nc_oc=Adr10w2K46PkbHMoSBhgwKA2l-qbmnbN3APG6MG5szS12ccy6YeMHbfvMiYNbLNBsgY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bypziD6Y76g-fRWQzo6imadMjJGnU4kaaSbxDwNPOTg&oe=6A2188E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhn_LnSYBMkQ7kNvwHpsPda&_nc_oc=Ado7rRFWdhBWx8ZXm6gH8wflXJVM7cGor7QVMrKD7FCP9YhR90nqj_SxqjOTc6NL1Us&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r3-dfvNrUWoIZKf7Fg67DLSplWKU62EX22r01q6RwGw&oe=6A218BC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgEsR_bFeKYQ7kNvwETaW8A&_nc_oc=AdoT2KVO_xpXBZYtHH4pQiz3jjiSYZAVK-ytnTicn4EZCuwQ25gYYNmAGy74XaBN1ak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AUiBpJdHUzLV6kNRKj1F3OyzWjoxZvipdXVVvxGaAsQ&oe=6A216DC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opLOHLJxcEQ7kNvwEwaJcf&_nc_oc=Ado6S3GtSVbs8Ypo5xTPxqpkUXh_hIWGmUkk_m4xZoTuWQJfBQleLDKe3Yy0nxqBIL4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qVBSHRtre4nUpBgTwPbo-m_leaSOV2tg20VSMh3kLMA&oe=6A21A48F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPUei89IL1MQ7kNvwHG6KTr&_nc_oc=AdqQCv0zvXbqPLH8vZkWnuEA-RgLy-ptUKSJ5Flb
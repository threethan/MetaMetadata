7yZ5BDTMSQLgg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kn24i_9HpcUCU_EXwhSFYJGUAGuRJlNe54LHlNJPX5A&oe=6A47C91E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNiOsTtCYAEQ7kNvwGftF7l&_nc_oc=AdpGDZCnuk56wLK2GeErwiPTCeDn5R6C1F0MLdBhGmzGBnC_O2lj9hwMCUcRbcbb52c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eM55itbjtrBvzla5A1GezB5wFU5HKbZ3rG2u2AOV7JA&oe=6A47BB12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw5Kt2Yh_gUQ7kNvwEWRIEm&_nc_oc=AdqQYGukmeGfXej5nUgYsYJ6kGl2INwq3NgJyoDoCtgEgzMktYNKpjXxGKblEu4gxpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hd1_9P6BTDhWK4R1he_4gBD8tJgIyaVRS5I-BbLC5NQ&oe=6A47C465"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7um452iz1AQ7kNvwFPssN8&_nc_oc=Adq-o-Gtlz92ebwssTUv-GOUmFBgzb-4rVoue1r4X5abHgoAhdV81LDaK009BH_-BCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D0d8WCY_sGtw3Pb5IQkQrfsKZofNbme_VjQksZjibAg&oe=6A47C747"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IcsYxKZh0QQ7kNvwGT8YGB&_nc_oc=Adq5P5RnRB6d77nGf4f-T-ltNcznViYnm0ceb9I7ujqXQGDAkCtq5nyUvIRbbFPi_QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G_xG2k_9VUHHY0TBA7ogMVr4wtDy5MAEW9AX7aHBeQQ&oe=6A47E183"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1uQ_awX6U4Q7kNvwFE8RfB&_nc_oc=AdroYP_1_PVMh-2FY9UFDv55f2460q2Yd4OXZhR5G8hEOcTlHDxrVc8LAiizG5sfuiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FzwmJbS8LOpA0yn1XR08LuCrVYNmWdAJbpLFsaCG_xg&oe=6A47E00F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type"
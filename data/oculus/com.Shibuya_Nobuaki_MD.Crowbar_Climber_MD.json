c3-1.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foO9P9OfwF8Q7kNvwFuv4dz&_nc_oc=AdknuDxxI1HUfmYYl_6Fn8GOqJM0bMxliztFCum8cQtqrAjigHLHVn6wjr6aYU9PXJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMl-7tbRoEKRXDwv_d5LyewpGFo9UBF0OJlH9M0Y3N7Q&oe=69B68BDE"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnKc-HqtmBwQ7kNvwHeGbwq&_nc_oc=Adn8uSjCLz8HXuUZJi7nyO4EngKDoLs9cawyqchVbpvaYsbk_3qY5iaw0aEqD19FsvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEKoNGuQzMZdtF0QwCXLhfrLcXs8USX3rXyrHXtq_D3g&oe=69B6B612"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7ZCqFZoNEEQ7kNvwEXcsDH&_nc_oc=AdlQvm-KR2miNC_zUwippjsE4JLmmdHZOM1l94eJzLKOzVYEy1UAcEfBsD0JD4uu_go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2uNmkjDcv-PnQFi0iS3tannuPzWp-lM0uxV20amou1w&oe=69B6BF65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ9peZEdRacQ7kNvwGByyHt&_nc_oc=AdkyXPKU_H0T-I5fEdVNJJ_pzduKJZDEgtrC8YRQ1BRzCqwDqvUZ1Xa9HE_dykyn87c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGl1VRi3fDh_lfYV-jmiDU2HxqF80dP-0a7XjSugfrzg&oe=69B6C247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00YP9dL5G_8Q7kNvwF7hxFW&_nc_oc=AdnfCJcmx5-L7kYHyiiza8LYWB3QySvbPFPq1S_-kuZXQTUXS8qxFX6GgWnxqhZ1IMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzjl7k1PeB1VdCt0pP_2TENjbcA1urEQy3uaiE10r2AvQ&oe=69B6A443"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSkjG4dt4QUQ7kNvwHyBMGl&_nc_oc=AdnFRDJTnmmXAgHqgLtn1KO3Hn0HNkYr0KBovfUepw7YxJdMUd7EbRrHMM-O80YPaWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_
64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDaWv7_RMVgQ7kNvwG4MweK&_nc_oc=Adpa_1LdIlB8ny94D_Ob8jVt_olOC1lZWqJKq0JT0G1rvI9CV8VSOFpzYvr3FAbRE00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALySOaNm4FUSygD5GCtUwJq66Txzrj9NNpcGPkgi2p4w&oe=6A4E6040"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uve_ydYI3MQ7kNvwExF_6I&_nc_oc=AdpRQ1t0zBDShWR9l8ZIPurRqjazQPdUJMxkcbTCDOzhfv9wvhy6KKTeA3VGDlWAL9M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGsK1VB8LDONndZqVawWZEGWw3LBUhtekBre8g60gkhw&oe=6A4E59E4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhzxiF5rMZkQ7kNvwHeYrKu&_nc_oc=AdpSxiJmsfcop2V6g7Y9VoxdSzDVyCB1D0nRbAS58PXtElAbjK0cLHXZkOd2-MTdn6Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARcKH-c3uFJ_gA5oYH5LhPr_dBscoZA5q67cHTHsctfw&oe=6A4E6EC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb-NGeDbpWAQ7kNvwH6O7Pi&_nc_oc=AdqpYauDL2h0qCyFqsgiO1TiMybrk06PyFS_QaAQHJG57-1lD7ukdcp4IXTXA8ublIQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoOWCQ5RMTYu4XJ-XuZ0i-RRhIbXJ8hw7EY2CrDIlFag&oe=6A4E5C3D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_1JJOI--w8Q7kNvwHf1ZPZ&_nc_oc=AdrIpOxtaD39XEHBXVSYOsBwbPh0yYjNA-bk6u2PybWer_BdBQ11xH131v_IfkyrYcI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA9W0X96arMaUACtA4ZO-3zL6Zq4VekUT8s8w_Y6dpBg&oe=6A4E3E62"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
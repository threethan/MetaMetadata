Z5W-By5jw6RVHvndEHVAaoKhldmRQuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afykw7E1Vud1OI5NlOp4hvH7D8ajEIY2pJl2CBtwtSaLgw&oe=69BFDDE6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYYUigYG6OwQ7kNvwH2ihZR&_nc_oc=AdkrQmSz4DJenz8BJ-4DXEFbvRK7KzxmOBXKohSe7fQ3MLXwLruZRhdroCrTwRtKj3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjAmfBqhVCiQUh2VfyY9M-LlTNLOUPhnYItQiQivWybA&oe=69BFD779"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOixu8BymdoQ7kNvwFwn9Fz&_nc_oc=AdlG1xG35PBzuCK6Cj5GZLdIdrgjDuFpEu74vpCMuokJLx5ChwiiN1M1RdBMbDRxnyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz329Wf-MAkmvLk2lLeL3D690v-OTzGck74wekuYywGWg&oe=69C001E3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu_LuFL9olQQ7kNvwHz_ZdZ&_nc_oc=AdkmQl5fPSlG8vLj5oq0V2L-TvRTvAuZZCZ5pqM0I07OGfUCrAxvWzdlGSPj6t4G9eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw16XE0oXXDbqNl_-h1nJ8eqbbgs6vyjupHPpuGaZunEg&oe=69BFFE40"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyrHl-69ZIQ7kNvwEDnZth&_nc_oc=AdlF0rYlIWx7prx8fR3z0rGbO178K0in97c1tIdqNCp-aeG1MlA9mgrYac1UR_94eyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlJO_3trCtcHtkzXvUdwG_EKJbo1VAwb2NIbbdeMk6gw&oe=69BFF036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n2gb4df1rgQ7kNvwG9Pxcs&_nc_oc=AdnLfz_tunJR4rf03K89CbyUdDhI0_oUUinZA_kmeyLGZG1dsXA9LcTlcS6Q_fL0wss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afygd4c3casyZqE3Yyb6QFUWW5yL-sWFC03Tl04LsPnkQA&oe=69BFD620"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUSUAMF8_DcQ7kNvwF6m4GH&_nc_oc=Adk27CEikUDk79EW-B8CqHF0wUSazn1LMtM2m_FOTruV-dfVRVoSfUof-tU3oE69cFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUKciN2jWyd-fT8lokbU_6DvJcm18n2hzL0LtvdH79pQ&oe=69BFE98A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu2K9I5rjXQQ7kNvwGaOJM-&_nc_oc=AdnONp4vfCUBOh1-UKsXbUFx-tfrrmuO9Q3AGkCzmZG6STmS9WDALgU3K3LbFVKAY9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOGZHPhJB70CRxFigefgRyqzotEJsmOT4p6Gdh4TAkig&oe=69BFEE08"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EUUMsVeQxMQ7kNvwH-iq-k&_nc_oc=Adl8
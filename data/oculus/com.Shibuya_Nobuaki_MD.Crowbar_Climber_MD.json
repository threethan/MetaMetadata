v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqqkmIbM-eIQ7kNvwGoOWIi&_nc_oc=AdqLEdrw_VUxnJuzEcDUfnWK8SX6NUFTurKtz68Cn9toe0zQzxLNtCFL2VW3C9-aw6s&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rK0knhqserjsHkYZQjjimUdGx6-YO1PdzzTKcXwKKWA&oe=6A1C3992"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNHNSPl5A_IQ7kNvwG2Fydb&_nc_oc=AdpX-hsLDCPaFa9T4CcfogfmYXOl4cbwqligv9TW9jm5XU5fCs9EUx1UmX5yeE9Xx_c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cZ9JMhT-T2tkbx1ygZbYsu_hoHI0fpfy6PUxzZur7Zw&oe=6A1C42E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnxzB0nWCBsQ7kNvwFVU0Bm&_nc_oc=Adp7mReXFD8p2qgdWDFH1P6WAnFF3ku61eXm3MzDBRH7JYGTNcSsjw2M4DCWdpXqfZs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ywBbKH_yWahH42fPqpW26soHu4JHIZZTThrV6tjVLQA&oe=6A1C45C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_mnZr2hTOoQ7kNvwFYgXdK&_nc_oc=AdpQpPVc3IBRBex9NW1_lUyvrjh3ZsIFWF5fiHVNUxk5oossioWfpUJt3JmHMjNnPeU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xmf15oqyfASI8PIPBAiYuXJc_r5cue1Y42UM5gmgfZg&oe=6A1C6003"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT1HeOrZpF4Q7kNvwFI6UGO&_nc_oc=AdrKsWf6PMXMWeP434ZQzewSATCBGprZffvppv8PIzqODyv-UCaQ20S8F5MuAfhXxlk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ne-iNXAjQIzBSpS1kDPmD64VvvvDuxGQBrBloc6i1Qg&oe=6A1C5E8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaO5DqanZBwQ7kNvwHipS2C&_nc_oc=AdpM5rQhgCP553w1qM13DpfyQqEXUKBOsNfSsa2
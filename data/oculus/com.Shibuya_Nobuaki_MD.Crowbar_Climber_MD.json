IYe93QjVXJ4kOo02HJM-EYpYVaHcZHik6OEPYz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmHKJu9hGjEsn-C-u27LTAlkPvJA28h-xq0jKXhzn_BQ&oe=6A9ECA47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34qN1d6lNhMQ7kNvwGAiLEY&_nc_oc=Ado2folDIQZcm36qVDAf-NDx0NzfddqiQbOQ4tON5YNiAYo1fdL3lh5mkYPOZB-fJjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRHSiWx1kLbgys1HiyiMpie8FOZ_FkDGlIVz3Rl-OAyw&oe=6A9EAC43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuLIR_wjcRIQ7kNvwHFnfq7&_nc_oc=Adq591uqJIi8V82Xk68ox75idLM0Awh8pJBF_phxrQyAo6ppaoY5_4pi6kizwlkFUI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKhc6iEtp_uQmstnZgp9pfwhLx2acRNmBEd8l1k7Mn8Q&oe=6A9EAACF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr3_d0zUtYYQ7kNvwGB1LE2&_nc_oc=Adq-x9RwaqsfPafcMGf8rsDc6_S_gAfGw-JxQQJqTAvCcrZP9Q2JrK0gg6l7L1M-uJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLejdc9FfqxT06sPC4EhyEp1vQWCBJyH6nOg3t111zIeQ&oe=6A9EC14C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW-t3Dbq0MIQ7kNvwFdLY4k&_nc_oc=AdpMcTcoIpSj9c72ThKpCb-OM1aQ9vbpQuLFywyL8DO6NrzYr0aeUqDNsxvnXVnzSc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsWGTosXi12DR9awfjvQ4K5p5AV58FDWBrAr9OL6Lpaw&oe=6A9EAE23"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "908659141179566", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035372_908659144512899_8652328318294046392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emNks_xpYhgQ7kNvwHPBv4L&_nc_oc=AdqXuWIKkPwzkUuJSJNpBlGUJSWnXKSDaUQQhJpSakDPUjDzTn8r7urCjW1KlO72Dsk&_nc_zt=
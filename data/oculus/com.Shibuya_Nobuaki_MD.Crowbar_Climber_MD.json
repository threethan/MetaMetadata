ent-ord5-1.oculuscdn.com&oh=00_Afv6YcOotQMi14RCbTZrwXnGWxNAN36Ysgq8OUtEwUhB2A&oe=699C4566"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw1yktR-k8UQ7kNvwG60EyU&_nc_oc=Admx30bJr8Erh7sqxmhov6HUX4NcTjsBO9YVg7wX6kUJiCDlwC1wYxrUlRiRYqCjVCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afukp_sSLhWj_0iZDWm53XLSPcNElTxN3FFsjV0H7BslJA&oe=699C3EF9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxMaTRvUAcsQ7kNvwH1sfTf&_nc_oc=AdkNtIO6pKT85OxWAJbLa6eOAp4h4T1myrAc1rTbx-JaC-HLT48HvDAxvPD58V_9E8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7D0soMqiEFXg-8-TIiRqwhEQphB-ySBceg8kmjfWp9Q&oe=699C3123"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FntCTPOvQQ7kNvwHLraod&_nc_oc=AdkCPkRyVukdiLBLz1fT5m-jD2alk249h5VRrKWv7G4dr_V0_hduCMVJp7YNexTc4NA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmyzOpmE4KcW9UZUicxUEp1yxNqM7CUqgGtts-4ZE2Ug&oe=699C65C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pc-wvrR85EQ7kNvwHRTlel&_nc_oc=Adn5BjHxatLxumpq7Sr1_hJ_FhUNTeD_zXn1cVM-WRNl0diN0nrEwITq6S7DLJGAZvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsna43vbzkf0hL60wESaqMiliQ6-Za8Cd2SJe1qAcv2ZA&oe=699C57B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4AxjhkG6GQQ7kNvwEQtecs&_nc_oc=AdlxxY2RKZe4K0p-SB-t1peQK1Lk9A62glEZbJc3u5YIeM11grTZekYzUUFZrW67alU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsAGi_If30CjGHWGqxGs5M_6uT088vuKzwyIPGqatBvjA&oe=699C5D29"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP2hKZjQjx0Q7kNvwGFRSM2&_nc_oc=AdnW4qH0WR99_66W6cLJFnQToMOCXP1FrlEVytFDBxR6ICc8m9sjYkKnN_jnXHkqfNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfucsMtUsYRtgmSDsqynSxLGP07pdQ7bu-aDCQafucHziQ&oe=699C3E43"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6yS8vkDMSQQ7kNvwEMCa4b&_nc_oc=Adlj4BKiENVsVr9MtY3M7gixl54ZSa05fFeTV8nXhLKdkaW4SaNE56CyGkCLg7UG3Is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftyy70Fyfy4yW9k07zCgdy0Xg6xgRf8Fp1GGUtvtNXluw&oe=699C5E62"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEU8POB8A0Q7kNvwGCW08r&_nc_oc=Adn6LHxg0wQ6Nj_FYxF3APWgN3_mJpL4J091But1x_PmEkV8u0m4zyLAj2Xn3NcPjRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvNnLE-Xh9MExUQ0T6ywhlek7Vig8sD8q7un-7SCYbUkw&oe=699C4AEE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_12
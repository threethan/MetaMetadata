Qi_rQ65UUj3qR3Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-bZmjC4UKar6ViiwGsMJIqgfTUb966tOGTY2qpE_RjA&oe=6A53A69E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u0HruRVQ5gQ7kNvwHJHt1_&_nc_oc=Adoy4edOiIANtLRRjruQg6qfLE1wx7vsogKU82feCtsFTjFuTDX0lRbQ2wB0jiuk9_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3MbYMDfGs6Y_hI0SuE-FsFVoVRyJLVL12kjoKbll33g&oe=6A539892"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp4KpuGT8W8Q7kNvwHqdvu3&_nc_oc=AdrXzfn04fAl7IZv7nSm54Dglj3dxv6oHzFd9Z9BTAOiS8pvcS1GxnqDxWwpemJcY10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcxjueusU2Cj-un9PTW3rADtW04RpPQxIdY55Y0RSjMQ&oe=6A53A1E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRUjobhK-74Q7kNvwHTl29o&_nc_oc=Adp8XVZzyKeD2drVjxrcbUEt6xmDNm6XpTDpr9jHuybqb-fguoTd-j5Gsqw6ELH0cEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjCvCEBD6rhNnCUNv4x1BBFQuK0cnLgfXAlLKJ9nZfJA&oe=6A53A4C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQgW3xhEqHoQ7kNvwGc7Dk4&_nc_oc=AdrTUQLjROaveBS2jc41X8Q-REpraeINcdAYFN0L1l4vtT6M1AFAL0HURVEatv-UsJE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANbHxHvDDT-lpIGP_FwDYkAMdvRkXyYUknqbwK-RgCGg&oe=6A5386C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vf5DFun8FgQ7kNvwEZF_FK&_nc_oc=AdqBblKVgOjutNfcVpAQTHqLjrws1Cbi4Q3NyroEIGPazlRIqEabSH26N9nv1R9lcKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu8mvjwUxxzhxJTZXvo7j6lL_OuAJ0G-zaz9S4VxeC1Q&oe=6A53854F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
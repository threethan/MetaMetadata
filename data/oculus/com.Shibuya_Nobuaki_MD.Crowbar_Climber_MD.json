QUJI2TMVhkgrirB3b6x-wFHQWpJZJrzhgdhc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf9piBoTf5qtDzh4DK94KmkHAYvsu7d_HaWFWCtkVVSg&oe=6ACF91C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8IlKi2evtsQ7kNvwGpqPTi&_nc_oc=AdrfhpsIeGbx_G8YqkthTI3EF8PwNzl5ptLb6Ia2fKjD7XTCYPxtXx-5ccbKTAnswdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObpYekdufQk3Y0-R-kBhOvY1KoIqgG5wJPzS2nSoTtEA&oe=6ACFAC03"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnBq6mydvHsQ7kNvwGPyUx8&_nc_oc=AdoYjV7bj7N0ItW360AqsjvAyZ0j6KMKEscsaNzcp1OhL5wABDPrnowhGDSokK_6krE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYk14v2IVzmZWA5kAieiq5IJeToj5Ia-pNyTlz6jo9Uw&oe=6ACFAA8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPyMVDIRtPcQ7kNvwFj4CTk&_nc_oc=AdrtnY270yfxG5B_LQoA_nIznsgaXl1itqaHjDa2lB236qgNqxJRNbm0SXH9C02cjSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW2so4N9aVp-Q9eKbF7IGWDKShVRMbiVbzJnalyzhl9g&oe=6ACF88CC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0G-K9KdSOIQ7kNvwEOQTVp&_nc_oc=AdpPE70L2WeTbgaDoY0mfnirNY-ZwTceLMVdnpOR9tpik3wvUV97LeN46BdQEJP8gtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBVsdezocf9OeSTdE2JJQYiqanFmy9jz3JRZYhC3GIZw&oe=6ACFADE3"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "908659141179566", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035372_908659144512899_8652328318294046392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_agtDu7h_7wQ7kNvwHzcawP&_nc_oc=AdpqdF0_pGStWQoGgpc7IM-f9npOrxflDfxrhJxDM3zTD7AdglNbBP_7IGBUjfC0Bck&_nc_zt=3&_
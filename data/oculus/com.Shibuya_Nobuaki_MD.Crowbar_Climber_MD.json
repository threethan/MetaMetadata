oe=6A35541E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUyUMyPSsPkQ7kNvwH-x-8t&_nc_oc=AdqNBvOQpLZXWCJNJpLxWyCA6L6FvIwNGuaQGmehbzCBvZyf649HZ7k00ABZkJ20L4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WSPnvO8yr3tMVjssPBsPgNxCZDGNvEEMUjjsMGkpzgQ&oe=6A354612"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03U1nS7Uy3AQ7kNvwF6kLXU&_nc_oc=AdrEUhxrnubZ8GOs83WGl-3qx3DWNpzxNuvZ4nVL0aCGo05JdyoiYfLf-pj4HHXpD4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rSCGSnm15xUIlpuaiMr0XEJglu9KWa4B1rlzoQwiCzQ&oe=6A354F65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SVp3H0FCx0Q7kNvwFnot49&_nc_oc=AdqyOGwRkTEkdGiHyBULn0ccoRd-1IP5EZ0N5kmv_leVYc4kNW2e-d7z6nPcCpf1umk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vsNgFNP-RKwyAxte1hA-u4yrkBtD5EVEIWpPsWGQpxA&oe=6A355247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh_KSnyz3rEQ7kNvwH3R7OW&_nc_oc=AdpaKtVj00wxP4uuxlmtnyuBjdG8Njl13ghyJMCFeTcEQAvnb2EX6Mh1J8fy10co_PU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GNobvmWPeOJGvBE0I64LcLbsa5q1gI85tpADryivIhQ&oe=6A356C83"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyGrh21bBQsQ7kNvwFLamoC&_nc_oc=Adp009mUcRYMhVeyC6jDjYUfGubuke0zXiJgpBhnTmDPl6k3mCE5Wtz1J04QaUfe_qE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K-XwivAnFRm51GX2H4Je6uXjR6G8ZqdRvQs7tz5XVRg&oe=6A356B0F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_28881752216
ent-sjc6-1.oculuscdn.com&oh=00_AftTGvXq9dSsX2QSCj5RvdjMg1lTFrFHggrjRc5wfhy-dQ&oe=699850E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvu2mM93YAoQ7kNvwFnF005&_nc_oc=AdnLmFc5POa6zYbUA3Etgbo2Sa_JmAdTxfHWWI4mhRQJNACq1FF32pXzSKPVp7hUeIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfskOMQy34ntJ384oALSbXyhawSZSbC9nKCD0GUvFOZO-w&oe=69984A79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cejOg7tPD_QQ7kNvwGlZTNM&_nc_oc=AdkiiIAgpJwbYdXXsCqgKW73pKwAZnYgqsVu_TRxfTzbYX4yjSNOEE3NwdH2LFf9B8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuxYW8knDMU-eZavRC7vLqFSTd6XsdqxUqKVmEc-s2dDg&oe=69983CA3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiHndSURdloQ7kNvwHujcXy&_nc_oc=AdmRNsr5tJNJmtva7VlxSj2aCtDxCpTwdLRXdE5vnOH4tK_pCLhnNuMc1jaz4jijJvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftqGrzIhPNFvIC2QETvSw6oX1h70iR_ZYa49PMJofQODA&oe=69987140"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRlETLDJXcoQ7kNvwHUp98T&_nc_oc=AdlZv4V0_nX35AzlAOailmPFcoQmCxl4MPF3IgAM5zJNsx736e0B0VjryEqIsb8HAqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8XSUfvig21YA11-EnxXL6vY2JTL0RJHFfRnae3gnEyA&oe=69986336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSBwJtekkjkQ7kNvwEorb5f&_nc_oc=Adk_Kdszqgibhde8p0b-ORtVWu0hUA702Ly82kY7_7PmDw0iBcTUyGLS8RFyP-sDwJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfufBGAeQS2gtuJCebaYmjKaj08mE_-5Sdz2ByFvz_fR2w&oe=699868A9"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxSzWQLKHZgQ7kNvwHloyyq&_nc_oc=AdknMIDQAgMOJyxyvuXlRMzfdD4Npx4zMkreByf-p67Zgv5o2ZpG9UJTEYEd9yHhn1g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsXAtSgEoiksKewsW-XpfHM8JGpsPMpne_QySp2odhQRw&oe=699849C3"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0IdZfkM3xAQ7kNvwFvv2T9&_nc_oc=AdniQzpW-cXZaXDz1vO-jOM2bTMhCI8cSRutVgOM2Vxs2YVvr4VI4L__WHuuIqmu1Kg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRSf2DE9SmCteHEiC8muZfXE-j94kw3nTs4bGTEMN6Qg&oe=699869E2"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na7wSbBP68kQ7kNvwFauRXg&_nc_oc=Adl1k9Xop1FiUppV9YurPyI9yK21dPxgehppS5K7DGcdRC4DUe5DkW7_5pzIcQhTogU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs10uGR_G9nodVlbNqtRjIoRTNa0OaIwg4ZrclmAGiZVA&oe=6998566E"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618440_12
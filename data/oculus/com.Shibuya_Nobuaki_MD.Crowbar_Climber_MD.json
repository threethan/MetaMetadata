/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue5yPsJkq34Q7kNvwH-PFdm&_nc_oc=AdosCWEhZjyMl1M9-jRzqG-Z1VCAQsE_z7yCYl1CV7xfe8Qav94HLkE_UjofjcLVSGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rj4hpqGjo1aP1WsAdCtlxSPP0KuJWzuUtJJJTcq0-kw&oe=6A257412"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB7kLbRht6EQ7kNvwH3byEl&_nc_oc=AdqLBCC-PSQ_lkkBpwMUucULZFXWhDXenoxgit163stpVFwwRDLUYuUlIQHN37H2ZJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TpaL7XI9cMxsszx-abDBno6RgLtoroi5wY234e23kNw&oe=6A257D65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNmXF7NqtWkQ7kNvwFboI-0&_nc_oc=AdrC3p7Mgdw5kaX4nDqXHaebQ24fGnVm0uFoBUPPAnDAPDGfXgjfbQWk9hr7DF_Hvps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vW_5dVMEXoYFHtni3Yu9L7SlDo--JYcL0Yt8B8PEcTA&oe=6A258047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueBHD8rY70kQ7kNvwHXLSpj&_nc_oc=Adq0cIkutrsmp3hh8NKOaqZpyQaoZm9eDUMxBKUMVGLOaSZJwxApatOupIbe_PLbLEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CgRVOfW3ffudh2XcZgDaXB-fyw2ZauLllWI8RONFP1Q&oe=6A259A83"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dADTGAaMt0EQ7kNvwE9SH45&_nc_oc=AdpP979yp39QcFLQEY9GIUU84ZMz5pyAp10FQoTeKI4HBGj1ciQXzCvnKZfMxK0V5cI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T9fBxMkJHRF0YcYABIFUG08XYMXnyMTfnDkb8MRkwPw&oe=6A25990F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97jW3o3K4koQ7kNvwEBX2He&_nc_oc=AdpakRyq8tUskqyFIBgXC9hINniZmbBpwcQ12bw4
GNTtGwNywgUiYQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YxIjZvnF_bLuPqQKExgY_tUNB3CaxGmRgFfgDLUEBqg&oe=6A41319E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2jPTTtNJlYQ7kNvwHRZGIP&_nc_oc=AdrRVVEsCbj2awE_aN2QKzqcTRuK5jOOog7zO5b7kpq4TE4pw0kdZ6Z3XRNil8BZ-QU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wASL1gD9PZ-BFyMUyJD_jpQuX1CHFmnFXSkMBlx91nw&oe=6A412392"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcGPGb12-j0Q7kNvwHv_pjq&_nc_oc=AdozclJBNyczu7ZsiDl5aPPWx40ehicHd4IVrI16hTeuW47Ne15kYDhiX95EZiZFI5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8yYx52FZk9uR0NUgZ47kXgt0lfl8jpX0iFGfeEW-vdw&oe=6A412CE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CScD5H_i7U4Q7kNvwEbfTHB&_nc_oc=AdrUdKKEw9j7nDwzyugNTQfQJ7rUrgQD95hQxOISHAkARmEBXkF3gcM4vxhAR9IS7kA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TDMH2Od9cZFAFKLwnMp7bZmUHF1PDh5bawQ2T7bg70g&oe=6A412FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuRvjrGyrhkQ7kNvwEry5j2&_nc_oc=Adrx1a_A5qXtkrRA62PK9vU3pEg92-OG_7eDAn0LmxvEqNuQGsMzT7UPcPvPkwYnPbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tu9iB2KkEjsk_yUWqLtJ6OThflmVoE_8s0eVCI-DC1w&oe=6A4111C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ypt02ZgsLgQ7kNvwFwDUvP&_nc_oc=AdoBWTJMexiIOAYDwGBviI3D3Krhpjhie8xVuI9BnNt81MXrAUdAPjJW28oBqzkLX8U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QEiVmsi3zdX3-8QohrQRJOlTnvGn7R0Tt3UWu6NXmwg&oe=6A41104F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
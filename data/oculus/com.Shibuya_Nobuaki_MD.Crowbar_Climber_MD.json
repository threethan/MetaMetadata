ent-iad3-1.oculuscdn.com&oh=00_AfuMS4C-R-P1bYKLP7lsFmLJ3L8leeh4Ximm4Boj2d8F9g&oe=699D96E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI5VWlb5AYkQ7kNvwFV4sE2&_nc_oc=AdlobMADp45NVNuhunai-V3Px5LNEap8hZBRnUewPb0jwAvrx4HcUUTHyO1sA4gdkAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsu7QuOZFSEweQBY954zKVBP93W6dKzmRCeerZz3oai5A&oe=699D9079"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TUY7cNTCNwQ7kNvwExmpmu&_nc_oc=Adme2cFidX848bS5_v5cL3lVTCDkfJ2apc8KPz5by-4onHlcn5X6_JNGKUi5tRDVB7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8mify_gY64DeLVbHWItdi6EpLMo9qLaICY-rJkzlZww&oe=699D82A3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJiPKq9wwKYQ7kNvwHOoqcV&_nc_oc=AdncZpsJghzyoeHzh-YkXtOHeZQoyqrgq1AON9-ta_OBf_7lq-jXRWEK0XVbL3a77lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvnl6ezPCDk9JgeD032_3xBAM6UKuH6gHuzUUw8kD7KvQ&oe=699DB740"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pc-wvrR85EQ7kNvwH5dBJI&_nc_oc=AdkuGDASSyLik5cyo2irR_iyvasUQ3N2iBwRsU8HxuLe3kxKCV54f1C2q78lMdUn7m8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9ezhAax-fRXpbAcOESn_KAfpA6mgu_SIUKrQG1Zt8fA&oe=699DA936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFOdx_tvFY8Q7kNvwFBMsDY&_nc_oc=AdmOpKR1ZrR_YdMLlF_vPiR3OtDoLivKCiEqM-tvrTVI02hzmAO1VZwoVix-BvqCk84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbDXjpqkQ64k1QK1JDQ8dG5qSw83nxOw_jToViDKzETw&oe=699DAEA9"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP2hKZjQjx0Q7kNvwHcWfZG&_nc_oc=Adlf2pM3pgioZZkQVJOA0EbsVgG8WcMNE5La8jfIAmAHLn39fy9QGDLSsmRQkSEY-Ts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4sQc-3yJvs2nOqLFxDhV2NLU23_H3g7ddwdKuqmndyA&oe=699D8FC3"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JaWVRKgk0wQ7kNvwHlIDbj&_nc_oc=Adn_PzvfpYXcZss2_Xf_gxC88arAvRT4b1SRburSORiYJUm2PGuCcZnmE1ritX_wuGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvcQdBYRzQCyiEy0cGv7rQv7XcCUmQlAARjhhSpri-ypw&oe=699DAFE2"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEU8POB8A0Q7kNvwGm_pCR&_nc_oc=Adm0XY82_9eK5gjr6rtWoxLPFZDHxlwK7MLXkbWb5dMFfPhhMEqRTscz7QdyqfBX9wU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJqPRmjjDbNNK9AlFIzZXdMavOxgR-X59TI8Dr7eztRg&oe=699D9C6E"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_12
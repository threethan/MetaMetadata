c_oc=AdqVxrNz-KxU6gSvbEIXGTwk5VqroWv4FVij-6bm5mTjaFLDnlSu4mIJQ5MzhCFgvO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1EycgYnctnaOoSDTB1exvgP_HBkUc1nm6O2CiXQzL5Q&oe=6A340240"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApyYsVK1Dn0Q7kNvwGGmX9V&_nc_oc=AdrLtMy-nz107tAHxTBZ05kdQAZ8poiHyu8yP5iDqre7P05utMzCQmYxZyfuiWkkvU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Md819pkzSiD299Ap1q8qDl7yv--Puzj90iztWP5ozOg&oe=6A33FBE4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V0Pm20f--4Q7kNvwHsyJFU&_nc_oc=AdoYJVepX4Ue-4jE3hRqyUL8YeNsTz0Lv7V7vxZ6EQC31whVgm12hJMB-6p0FXA8N5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Utk-Yqh_4Dga-EKyz-On7RIT8WOsdVZqObiC2k4kXAg&oe=6A3410C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Ub2AZtwk4Q7kNvwFgyn17&_nc_oc=AdqQG1rCdr60DQzi3DjTmupHbNmIPpKdGYRdhHPOytcjufl0m8O20JRn1E9NcSZ01L0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97G-EngJkxet1JIuP2Po6APD18ioRq9QnxxbytBOLy5g&oe=6A33FE3D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1np74I_16kQ7kNvwE0WAgx&_nc_oc=Adohcte32R_-MtqC_BjHVYtaamV1I34kMR_myiB8KBsu8XpXG6LKz7AeuEQw-UR0Ruw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uPX9J05RqOFhfaD6e22g0XsjnFI12wD0iIlsewwhENQ&oe=6A3418A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623601_2042896823278392_2811420873830425964_n.png?_nc_ca
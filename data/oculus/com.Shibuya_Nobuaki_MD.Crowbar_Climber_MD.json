UTOHbeVHpHruCLihJetdyOSF_gtt9gpX0CqXBqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKsm16uF4SZEayB1hPGY6cyHASWH_un4Qq7mJxiSAqsg&oe=6A9AD5C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnZJx5bZ-mcQ7kNvwH4f9zn&_nc_oc=AdqNBy9dHpS8dVPfVs0ctP4K-drtAQODsrGkHP7TeCyzjOFujZeo-NdkXy4ncZ1eKxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYkHGqNy1fHMPNc-p5UtiwKV4y9lk8L0TFBGnGhZ7Rig&oe=6A9AF003"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFqqrOCBSEkQ7kNvwEsO8aT&_nc_oc=AdoJcuBatA9XfRffbEwW-yP5FC4hraHCX6HekC7QM4GO9Nyxu3TRmgeqxOpgqiE-IGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVqCtCAFl3QoKWawpWhOOckFtlBWNXt461Kffh0vbpug&oe=6A9AEE8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dap5juF7f80Q7kNvwHv3Axh&_nc_oc=AdpVkKLebYZ6VripfPZguKU5Dy1UEKTW_33pI7-IBNcRCoG1FfgoRNe4KZzhM6PGjGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJQA5oU6tfDIRPRlIy-3Zj5VYIZ9em1fJCQ3DHZKoypA&oe=6A9ACCCC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1L_s6DW1n0Q7kNvwFw-af6&_nc_oc=Adqs28JFjb_7VY_Vt9NhA49Ka6wGxpIG2atcc4H6PdYPHkHqrDz3ecKouyKMsRKpgrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmGSXDKJVGCoz6zweOyJaPrJhdxicu39TpGJUt1p-y8Q&oe=6A9AF1E3"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "908659141179566", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035372_908659144512899_8652328318294046392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Uz_qdd6HEQ7kNvwHu7Anf&_nc_oc=Ado6s6K_FETqNCqLUClMp41JI1mbzTwj9JdQ5lssRqoxuo0De2fkOnBUBfyafsZQa28&_nc_zt=
.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2cqwhR7L0kQ7kNvwFPunKA&_nc_oc=AdpG-zbmaoQUKGhGOeQY9YaN9MaAjhitH6CsetNVJJImqTmBH7SZF3HaiOiuuulZ0j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xXBFBS0Eq8JPmmgJZ6s80eDZjGzyVzxsB0OgM0AA4lA&oe=6A47C8C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3GvuZKViVEQ7kNvwGAgG-_&_nc_oc=AdoZI98pDu0aSO-B6zLI8s95Kar6CHvyPgRFIlfO7gLMe_gu7HyZlnkLF-wQE-LIE4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QcKmXjr8cg8hXPxbgnhBacr3R0kjET0TmihJl9R7qoQ&oe=6A47C264"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP44T_yilHUQ7kNvwFrW0Pa&_nc_oc=AdqH-CLYEbQ2To9R7voB1r328EkQB17ZKktYYQG9BK6jiyGevvMb4FEJ9PG8z1Twcp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u4DW_BlKnYFhsRpd-dXDOXnTv7TZ3bYJlNAZjhqwxGA&oe=6A47D749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOG7g0Bq6qYQ7kNvwH9Db4E&_nc_oc=AdoUX4J4pnCiaxT9FlEXFuZDemgOBWZwBci16EL50Bvlp3k-uL5Lbp1p5mqssBxuZ4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lWyM1mF2j4aHn3F0Waq7OJKzQe4Qa0KqFmOe9AHgm6w&oe=6A47C4BD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4EwJzrAWzwQ7kNvwF_hjbu&_nc_oc=AdpoTsRIHmd1eiLb3GvYBtoQhNm18pP008V6YqZ5pd5JX2q_sjIuhYWGJMKdcFFSWAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82eNWhCSVRu3K66ZeO8D7yCQm_4kFLLU2q497ObiBBJQ&oe=6A47DF22"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_
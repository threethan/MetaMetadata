.com&_nc_ss=7a30f&oh=00_Af1qUfc9rNSi2Z7TzqCnvQl1L8kex6cJ5wA4hEqR11_umQ&oe=69E4EC6E"}, {"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30b9\u3099_1080\u00d7360px.png", "id": "1034501425088666", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031618_1034501428421999_2451223709124391201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er9g5317kuwQ7kNvwGtVaht&_nc_oc=AdpMwmMuIObzkQkaCIDwCtntuPTP6Gm6zSeQ5EWjd784HJJCkhCBf0W3dYxSFFZP4vA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iUWI-M9jZtugeETctZlq3IG37tLD6AEKqoHMtdeTTnA&oe=69E4C2DC"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "982875623608285", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_982875626941618_2003859836911121711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oM8azUMrVpwQ7kNvwEwfI6B&_nc_oc=Adp-S41LpDkPU9q3vnqC8S41Zt3ddOsyYtEWDRNgGiRgU73BDPg5DHe0aX6wT7VlEHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YSTtIOzzHKU79dN9lh2a-HvR5Vn05sRBaEVNGdEnr7w&oe=69E4E6F5"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "561168062997759", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572928_561168066331092_5754473564035552185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xKaL3EiiOsQ7kNvwHqIZTi&_nc_oc=AdqFvcRRBDxD-fIEeIpJfOOC72KcQe1TxwXmb_doUpduFFeblWpgTs-5sQavQdy98JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S1oJF03_eV_VCJHwzaUl3lTNATG8ZG3_SZt65Fcd8SA&oe=69E4E5FD"}]}, "id": "3704118076398870", "locale": "en_US", "screenshots": [{"file_name": "Steam_Screenshot_01.png", "id": "508321898775594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_508321905442260_1779725050188987969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43Ya0ubCTnsQ7kNvwGk5AEY&_nc_oc=AdoRzJa0m
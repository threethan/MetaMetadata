v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At3j6ImWcloQ7kNvwGMhrbs&_nc_oc=AdpbLsmodtGlPN8Y0O7_XWuW-QVhVTIiyjU6mG1kk0Xmn8hBpNz8bw8sPmPYhi0VXjw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5zJAHk8q-xfyNkBiTfUOqNZJGb-d_elCVnByY832Gg&oe=6A1AE812"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJB_jVXk0LYQ7kNvwHtTpg1&_nc_oc=AdqYJfpWMzebNLKfdtWU4HJn6PF04LJ5e4hmPvHt8jGuhojPCw7NCb2l9bwRR4Q2pak&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vOgORxI5b0vGKkDWs-31HRleTQbRMo4cvRxFcgi11iw&oe=6A1AF165"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqF_552ArsUQ7kNvwEfr-kP&_nc_oc=AdoOH-STp1jLdY71Vz-9ZARHECQb5MeK9pAsEgJ9gg826FpiZrPNAaPEpsu2ODfGmQY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69qxQtXLwqsz5ONyGS5vgWtzzC9yC61BIWtqb4wQp4lA&oe=6A1AF447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GesAsl3x4vIQ7kNvwG3cxg-&_nc_oc=AdpFJ-Q4ioNtiKCXui5AeLAt0qHLIA4Ivl__SXaVfyNlU6sujWiwnup7LvBzZEKGxTs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5estyv2kvMIrtRfhq9XtofY2EKC4-SsDwS8bUxP3zlZQ&oe=6A1AD643"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT1HeOrZpF4Q7kNvwHu8B9W&_nc_oc=Adp-BnYt6ehs7EYvfdmBs7NSjhXFz5hg15TLkMsnwCQr7LZMFSiQz7slQGomL2K9dOw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hPxnG0e3X4HN92i0a9dbdta2L_kYiZAMAANigq4BBGQ&oe=6A1B0D0F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGfFgposa1kQ7kNvwHDpxlE&_nc_oc=Adojm9BuLULcgx7pBNOhQsqUvzKx7hJ0j6IK0Mi
ADHXwa11aKFogzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A-zQ36yWENPgLTSteJ5DdFwg5RxDZg1iWAiyqNU5q6Q&oe=6A3A9A1E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZMURY1I1OQQ7kNvwF6JmF-&_nc_oc=AdrWEGC4lo8q9NJM2iqPzL1gBGWY9rkffR0TXhu3BJYt-7-jujh79oE5HFn9zwpR1rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ejvi21_Scu3D32HmWj2hkcFql4ec2jJLIIA1rdYhBVg&oe=6A3A8C12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhhNTgwhckwQ7kNvwHqyWJU&_nc_oc=AdoGSmvyAc3Q0sTdpKJNB4nApVFczS5ERw17SHnouSpoq_CJotN65SdMPhmVbiJI_ds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gU7YQFNsq7kmdTNYEDsLh2x7_I-lk-1p3UtuhS_PpxQ&oe=6A3A9565"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSj2cD2TGFgQ7kNvwGlhX0G&_nc_oc=Adqyc1NiwSjhcCJhrpI-xslr-3Rm1jHVIKjUGhfJ1566ly7OlUEJlhpVQmsAJQSIRfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9fhHvY8Xvk8ibMoLKU9r0JNig4u6kruo8oDfaYUIEw&oe=6A3A9847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgCr-NDNFrMQ7kNvwEV9UcH&_nc_oc=Adqxkn0PyCPlpnlldEilOalIQO6yDH6NPShqf5GmV9hoqtDslI29cqIidv4rYwU_I34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--jbyd4jAk9-x7c6R7Em2LdxowHlLp6Ps2Usgw6Yplbg&oe=6A3AB283"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMJp1lQivTkQ7kNvwFhSclK&_nc_oc=AdpXPv_ZFwOHbW7kZKdpKASGde6ctFV75MRAVpvJ_JkbUUGralIURdnXQKs3KcCBpCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82i8kJbnwb-sRh-mqMMatbNeSaIfZFQJ-_rOEFzf6Ddw&oe=6A3AB10F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
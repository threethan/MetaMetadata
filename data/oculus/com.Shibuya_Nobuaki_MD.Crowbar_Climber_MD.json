64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa6S3s-BFnMQ7kNvwFsHN1d&_nc_oc=AdozC8vTbIIwHrE16TtmugwQ0x1nusodMDVM4BoG4BjrqsmIXjSfSADVvZQrE6qd-K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhw3UTzcPZ-1mCFp9mFR4p_YZZSTkclXdvRyQjMTR-gQ&oe=6A4FB1C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uve_ydYI3MQ7kNvwHIsskK&_nc_oc=Ado6cby6qDKaBViw9mSQ_rLK37UwWBFuHI80n6ZmCL34-r7X-6yHIK9DotZ2qGL8tek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkPI8m4R9SP_obvB58hM4T_1ImpyPs62rNZlnRZYcWsw&oe=6A4FAB64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhzxiF5rMZkQ7kNvwHS8umf&_nc_oc=AdpqqT1yDJrSdr5ZNzlrSPyQ4GMY-W2X4Kyq-ahYt7K_pkzeDsjVh5W66RCSoHeb100&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBesG76-22t0pG_VBXq6luvHOIUtBquuaZVbEh-OV0W6g&oe=6A4FC049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb-NGeDbpWAQ7kNvwGDM_5b&_nc_oc=AdqbNXKu3E2KyVGqO8WRvpamyQiF3qnLdbiEk7s1Dj6bTAri-kLoDuFjodzEl7adm0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAjoHSHcsRAIemWxigKMk3gjVRgMiuC9oNVfAxYhkb0A&oe=6A4FADBD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjXwzhtILEMQ7kNvwE-UyeK&_nc_oc=Adoap6xEWhCoLmkDmVCkf9IkJeI0hLdKsLnOddafcQfKp1JaJk5RtVAhBZKhnNY81B8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ_Tl3yxbs6TZdMBkV958jbMPZrL2-HjoR65mediGscw&oe=6A4F8FE2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
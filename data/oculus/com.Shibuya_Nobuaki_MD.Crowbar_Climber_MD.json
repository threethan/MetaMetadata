d5-3.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foO9P9OfwF8Q7kNvwHQt_w1&_nc_oc=AdmbriyAI0nSfUJ_8XhN7fhE7vTVuOfNKO1HNX7d3fDltCy5s-UWzV7PZ42bnahs0RY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztDsumV9-u8ICGsb8bE0zkDvtUGYGxn9Z9DCVeuKCMSA&oe=69B4211E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oY_xvtYXWgQ7kNvwH650cx&_nc_oc=Admy7ZarnUzbfYpmT0ynacmYjGznto-WwNQXOwsfL9M2P1JDN6ZN_WffFT908WuSGiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxex2oqFaIvqFi--GpVtH5zSFg35iYUzMiQdiF0YaIjWw&oe=69B41312"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TcWoOIwncQQ7kNvwFftkIC&_nc_oc=AdkZ9m6jOtAjv6syBB2jQEqWIj997m_aUmozJwUrhpTUfh_7z_xZk-iNNI-T1pi40yA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzo-cAq-CB-y3da65w13rWehsK-kIdbDvDq_l1wZsYa0Q&oe=69B41C65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4l2T1i4IhsQ7kNvwEF0CLu&_nc_oc=AdkmNzVKq8UfKlPKqm0AAWvWFe4muuh-5JAcH3VPveyMFq4SSmz-XGvvRg4bKDA3uFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqNKjLlYBRhC3FXQf6bWEopvi2ddL2DlsvIlqgO_Gdkw&oe=69B41F47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpqOG5UxyA4Q7kNvwHBv9Lt&_nc_oc=AdmVD21ExqsB1qjjgzyQwkgAnS0McpD1NkvA4uDlXaeoWyqyw74vAwGfmE-y-Lf7LPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzegmhV-zvChTy5qUu9j3j9YkXoy47dVI-tizCRAB-Fw&oe=69B40143"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO-nEhY-1jMQ7kNvwFBpN6v&_nc_oc=AdmPuTnRESu5NEnUcOdzk6IojPl8szGrsyM3KqJni34Aj33ywP1J1ebbBqmewUzVZbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_
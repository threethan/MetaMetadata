FT-UF0ZvQ4rW20c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95g6lXFQ2JMENfslWlH3_D0ezTbe8P2vSPcnv_FrAvKw&oe=6A3FE01E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2jPTTtNJlYQ7kNvwGIeGvZ&_nc_oc=AdpW6McOow3U2sNZYKWNUby0lUY-Bu_OvvxQwf54bARPwepcM_PSCEYARDB4DPye2RM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4gkADS89ovGIubQucqOnqhgguNDaxNzd0mzMywwmMng&oe=6A3FD212"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcGPGb12-j0Q7kNvwG2HZC8&_nc_oc=AdrrJIw7H4G1b0AJAnZu12Kb0W0cqtNlxVfmYx5CgBN_V9vVQ3KvtSFgfMOPFnKvvxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ggYAi4rTI61j9vIbAIyiLKDvirswnuoZ_4YWf_xGPpw&oe=6A3FDB65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CScD5H_i7U4Q7kNvwFWSrOi&_nc_oc=AdrF59wEaei5hPHl6BrSm9yYV012gga0PSpyvb0r-uFXuID2luvdiftuMWjCBTP16QY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Nmk6II-TGCGyuB888zBokrSNvqCU3172WCcqiiB0qA&oe=6A3FDE47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuRvjrGyrhkQ7kNvwE9Ka_R&_nc_oc=AdpUa9bd7U-c8k0tYIiCyr54euKYyvZD6vPqkDXnKWNigef45qEpNjfMrjfyp2bUf_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1yij-i_3FP3iGubRYe4Orx9_clAdJUeGzR67KMt9oNA&oe=6A3FC043"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke1ittzxZdIQ7kNvwHdj-ST&_nc_oc=AdrBvEaVn19Qe6hDbwaWK1ycSKck-HgVzG_MSLlKrf6F5aiNR-KyEoS-YIL7OtoOexQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-STFgo43YKXV0ckLDrlNGvDjAm0EIRYP1Vm4D_LGR8IQ&oe=6A3FBECF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
ent-ord5-1.oculuscdn.com&oh=00_AfvOwjfxz5mQo5XXU1Rg9I0DAWiV5p6Cb5BxImPb-XjmtQ&oe=69A42E66"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up1Vz4jcClkQ7kNvwF2_bND&_nc_oc=AdnqoN2uv6l2noKXsvrAWNE9XdOvBmE1L4ZJweIwaxarpusROCasHhlA-A2_t3ifRtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs_y8lGQryIkBJ9UnAMefS1KO4yqo3_AILeXsI6BE7keA&oe=69A427F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUq_W5-nmgkQ7kNvwFyUdYa&_nc_oc=Adk92hc6T1DzOOP8hQ2SIexB0aAUUcJi7-7Wnxkm_G2L3_NqvVzrXNV9Kogoopch_zM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvwsGDJ5nkWf5kueE9cssiGsfzwHgHv10_10wakxmP5Xg&oe=69A41A23"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWba5SckaCoQ7kNvwGLKtY2&_nc_oc=AdnvTr4E8F6ZjHZloQteLxKzlgvZ0SIsQlB6gtYLVPSb-NQM2HS_QxwiLhc9UfICbiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvOeFG9VsqL62eA4o_GTQIEl4GS7G9V57477fegzTMTzQ&oe=69A44EC0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1LqPUY44j8Q7kNvwFLPu36&_nc_oc=AdlTzQFEI83mQ2NArdcB_JzbkM23m1ijoKNC5cffwSghyjFhsyqCFVsnoRb-DzZz-bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft85j_dbwmnoqsuZs9PdmD0quxNme-_9RsQt4y5CmsOaQ&oe=69A440B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uxp_VDCYwQ7kNvwFLP1-E&_nc_oc=Adnn7Nd5yZBQGBxmJ5Ov_hIVcEbSLxTL-q-GZLWJrrRYVhX2dBkwWfKlbLRI-Y5KLmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfudWr4wNSms7oG4eUgjpIBEeqYTtCZGN-VdiF6eiKvljw&oe=69A44629"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_JBJA-LPv4Q7kNvwEIxwoc&_nc_oc=Adm3nRbi1bYnEqxLwiQ1h_K6q_em9vEvXJZBpsySWEhO6aaUoRxCkjq1YQVaKPDH-EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6UugyjIcrsgCfBoLDBDbzEoW5v-H0FeuTmt3Alvj3AA&oe=69A42743"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNp2cH6RuIwQ7kNvwFyPeDe&_nc_oc=Adnp4aXnSHyVP8NCUdz0bmntk2uIONiRWfGShvra73zIXRQ1YB01AZ0pA_NBg8HKYZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuqW832dew-8NtZSzgDC24dKqp2QYr_PNJRdNVM5q9Xyw&oe=69A44762"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1-QfS7w20cQ7kNvwEa_HRX&_nc_oc=Adkqhv3S7X9lzlvpna1iU321G7PNhTj1cSLdzDMaM_7LuUBvnspt-uwSba886lK6HOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfscMoKsQTisml8B1Dr-pT7dJ-IZiachOOw5RAEvHpfPfw&oe=69A433EE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_12
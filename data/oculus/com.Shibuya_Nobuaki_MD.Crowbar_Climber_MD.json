com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mJKlTezGfQQ7kNvwFH3oEp&_nc_oc=AdqPOwoxDoKM5PD-LcdumcxDrlZ2skxHmVbtNeG7L1BrLx8ZSflrA65x7WwWHaqIObk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NsFSyVSwKxrJx3j2yCL3jM9r0wECKI-3lqq-FsdxVSA&oe=6A0F0A92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEfy3_thD88Q7kNvwGWLZ3t&_nc_oc=Adqex6rkIrDM9vqk94xXtx6QOruWwYngOAq9QAm3a7l-hn7nJ8IRsaz8tzLPfD08xLE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67KhMpHs1WQAzebVbQNV39sTsA0lCeuUlNne5RsI8OsQ&oe=6A0F13E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgj1NoGU4qAQ7kNvwGwL50S&_nc_oc=AdpU4ueM_bsXp_eRakK8v7rb48lpe06fmzRA1-yFc3ROJ_uLLCEQ8mY9a-FKH1T6PmQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pLI9IGY-YD57O8DfiwoXG37ur1z3l3qTgUUd1CKhjAQ&oe=6A0F16C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_HsMAiEQREQ7kNvwG8DyoY&_nc_oc=Adq7iYfJUkA87t7FZmDL4CYB0kwjuDeVETDrluJdUmwGXREG91mKIV3gCmZoxq_Ugec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ynQ-ik_iToqVwYsiE_JN3D_oR3zoLAS7-7Hw8BqSlDg&oe=6A0EF8C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUVNwIH7bUwQ7kNvwEeUqSh&_nc_oc=AdoGT_g2cBT8c50M4Gc-4Xh1HiFqgujlEH7U5pB3gTuTxZ0b_LbJNe4iqcMNKHq-6so&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qB4OtD9Jkfn5DTY1KXFAJJHX0h3ySPJGcBAhaBlxZuA&oe=6A0EF74F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-yJHg70QOIQ7kNvwGtXkJt&_nc_oc=AdpCLqA3cB43oCAdlZLOUtn6hd8OYvFi92K
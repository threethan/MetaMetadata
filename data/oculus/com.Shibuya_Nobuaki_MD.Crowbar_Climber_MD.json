64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD23uJvdvJwQ7kNvwF_RzDm&_nc_oc=AdrHVOm1WQ2zLVPgUXrQn0AibKamxpQU1JiPqMMC3VWtqx2DhIDfvtCu7oIyW_0UCm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SylNaEEZnv6XuPD6B8Q-LANo2XYF014oOk2SBpV6epw&oe=6A4282C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GRFMYmMB4Q7kNvwHxeAtA&_nc_oc=Adph3masT9aID8o7bHtSfHjI4BoPcO9Vjfnc-um8x1Q7rSpfSb91qBxzczxazBR3PJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C62KhctBXS5xt99T6HAh5bc-zhiynQ_h5FXNbi29qbg&oe=6A427C64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSITp3aRagEQ7kNvwEOKvUe&_nc_oc=Adp_pUojRUJzy1jEhmbTh6S83voW1F5nuU2DIRmmVr4lA6mZ85c7Juw12hGI8owS7w8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qN_WN3Cv5c2FvaQ0JMcC6ajpDOYkPCUf4fX5UdAfilg&oe=6A429149"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8__-qHwLRQQ7kNvwF5Wv0J&_nc_oc=Adr-MUcNyf8za304WBDZBPVUPbvaJ-VE7ke_J-kVlb2KJioal8otNHVKDDENGF6CW2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_jEh55EeSAomuRffpC03FNEVbI50xHu_7HpE8a3iwLg&oe=6A427EBD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V6MG_tkz9QQ7kNvwEvrRKT&_nc_oc=Adqg4u-SvYVnrEm8x2X7P0VTOqQJH_aLmBY6nX7OS9qOzBdkfz70GQLNxPf77MpdAMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AQqYoMK8MWeG69nkonlrvE0MiBUhIumlpriypV_6V8Q&oe=6A4260E2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
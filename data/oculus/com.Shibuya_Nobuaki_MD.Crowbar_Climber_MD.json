=S-HG-m1IVt4Q7kNvwFLypQD&_nc_oc=AdqAcX5QVMG2lWzGQPsUy0foyQpIozJzzay8q5Ald3ErbAFShBmYYLP5MdP7aBwtjRc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHK6o1Z1IdPyjXOI1bogiSdxs-_qdUdyOo4gOHy5ATfQ&oe=69CFCBE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbqZwjdXLucQ7kNvwHn6hlW&_nc_oc=Adrf8xATwiVZ7r8BsCD3vOSjjzFHpd9NpDlvOOd16zQXRr-WialyZPimUkAQaGQTtjg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_Du46Mzuannc9aQ0vWYV5E_YKhbIHG0R9fEh0MAphBQ&oe=69CFCEC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5KiIWa5fyYQ7kNvwGNivDp&_nc_oc=AdpjP3v6ebzMXc9R_EAKHzJJciIIVFuraFB154-HsADKYCNoSAC5Lej8UnvikFqVC00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXbkGYglfE3_iQxPLMmRJe2mvxnpVaiRXy_PQkdIzFSg&oe=69CFB0C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L93Rd88YCC0Q7kNvwEf2e7Y&_nc_oc=AdrkL6eWDGwqCLgdYQntnjgJbPiYYAxybRDNi8ZiEV79No56huGmYJkicuBvEpFCxco&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2IGrDvKaSsZqQIL3LgEs6ouoUuoWGH3ceZ2C8Ff3BvA&oe=69CFAF4F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dJG59Lp5zUQ7kNvwFTZG_O&_nc_oc=AdrRKUUR_fCb2HpmD5tl9xmwXTvq9JJr6fraqSIzUwpQCO8mBM8Gm5siltYTbRhRcWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtzjyL3L8XOxZKnUi0w4U889aOXdVGRY8ZPOF1so0uqQ&oe=69CFC5CC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrCWOm3T0ekQ7kNvwGnShdq&_nc_oc=AdpbfM5S24oTVotS1R2pNwTtfpiMPHvgXe8TuBJKxApu0nbOi-xSHxUoYFkZGw0
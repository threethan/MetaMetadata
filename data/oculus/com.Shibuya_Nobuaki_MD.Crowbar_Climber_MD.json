ent-iad3-1.oculuscdn.com&oh=00_Afvjs0s8Zaq4NVrhUGSUXEHTcSPxCl8szPDB8pEyXhhE_g&oe=69A6D166"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZHODm4INpgQ7kNvwG8Z9Vl&_nc_oc=AdlEKdV7iNlGSnd3qo70cZVDdhVFH0TkGNHOlwMdu_18uOAbIZMDeYMO6YlL_1gC2RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuh_u32hBegx_YqZjsdbRI__3ef2dGivZqnmS9cFpKDww&oe=69A6CAF9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ2WT1pd_h0Q7kNvwGdB5r3&_nc_oc=Adm1LCLtQpSHY6BlUEDsFPXXkQmNcPLi8rQRBSZwoDSPUV_BTSOhJb65et4RhBde40s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3pxQslASts7poY9n5VKHh5vgZrbQdpboIYlrsc4HzBg&oe=69A6BD23"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVXhRv5JGkUQ7kNvwFH163S&_nc_oc=AdlXjpIaEdR7AhVTlp905BQsBYI3G0HwoGFE-lP2paxk3t3879v6qIGvC07jI1bo-dI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRTF4Y8gTv76j2-rTzAgvlB_fNNoFPjuEehzXUFkTkkg&oe=69A6B980"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1LqPUY44j8Q7kNvwHhvkhv&_nc_oc=AdnrgJ8VQEDEesen_95WUAazKklen_-x0M6p9U_qj4OhBWl6Tq1bneg2-TnUgfTfIsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoAqLEUYk5Bp2ZGJNAhBf9v7h-zwZgpYa8qy1Fdm5u3A&oe=69A6E3B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YliuDHVeejQQ7kNvwGJsDnZ&_nc_oc=AdlxanTkOMNmBTCNAgEeRcbZRvEYKcBd1QlaDsChEABKKRhm_X47o7HQ-R8Yl0GTVQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxWr2EPYDKi0egkTKkQjsbq-eQjLT5_RgiPZV2C6vkfw&oe=69A6E929"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrTZIAh-Fu4Q7kNvwHq8W3P&_nc_oc=AdlZ0HpRBEKydS_soq4FYXyeWDtDSSt-nX7PxmlDrc7t4hdhQozfnBBemg_lBRmnvnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTUMuyzIQ2h4U9Ms9aIXBbvmDDmPRqw73jAo7yjpGJOA&oe=69A6CA43"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeAbhj3Nrq8Q7kNvwEh6lsg&_nc_oc=AdmFi7gapvfADQNTVRbK2rgrwxj3ab1_IrxxVqHmEIdT9dR65r_9YJZLQmFGwrdtlf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8UH4hKInWqRScn6sI3VvXcQLRisFTD0f5DUzh0O--bA&oe=69A6EA62"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEiH61AZyagQ7kNvwF_WYU9&_nc_oc=AdknhFt7fLnXF9br0PzhsGG-oljCnjD79-5GHnbFrArfoMhT43Lcz_6MBKs1bh3nPZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhyqQbPK9bOjbPm6aFZQsS6fTL67tjwTraUu4ds4yChg&oe=69A6D6EE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_12
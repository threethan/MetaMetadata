=wCUHPRuZWMoQ7kNvwGp3Qwa&_nc_oc=AdoICq5USLd0lvx-tlqg4Kj0D_VDby45Gk0i8Oy4D1D2824uFIIP4apAfXTHLtlnipw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzntp3x2LPrf9EssuGoevK5dg8IKxBcr6gXPJ40pKZX2g&oe=69D11D65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iPnSECoMm8Q7kNvwFYa_CG&_nc_oc=AdouMGLpR_Q5mv8wB4i_fBvRxnqK_LhEl1aijvJG63fXBSG5KT1jcgNnD65TZ_vO-UA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxd7DvmzbRmXBml-zzlYqKIGCHd-kty00tXpNjK8ZXshw&oe=69D12047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIMYxx7yTgEQ7kNvwG9CkCw&_nc_oc=AdrGes4JiQtBynAJd6FO5JIOYKJCAksEnjZwg3p1NEpvSEGMwgukMDrb7UzNFjOHn1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgcD2mcH-f82jiam0SPuOad1zFFDElN130sc6yikKqqw&oe=69D10243"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L93Rd88YCC0Q7kNvwEKg4AO&_nc_oc=Adr7quFT4Pzgcyto323WN_XxRm--iR8HuFgTIc2zAX3h1MF6pF8nHBeT69ERFEPa8AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxd-qzY8CE2qPmeFHRlXFsnt5IDWrY-WlYBLm2HDjrhSQ&oe=69D100CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZT2DD0AjSkQ7kNvwFQbLXr&_nc_oc=AdpGAY1IMzrDoKqmsZ4GWPFpg0cZRS8BUzyc-l_tvumzzaDRiSj87XuRop6HafhBlRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-pmqxgW51nwhVcQHsQ-TgpE2kJXRjOHWlFUAR7B7HBw&oe=69D1174C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrCWOm3T0ekQ7kNvwF2sQ6a&_nc_oc=AdoABo6xt7JZixRca8a8Xiejl1WsqxGDN7-Eh9Tu72KUVSM6GzMZJ2epuPQnwF9
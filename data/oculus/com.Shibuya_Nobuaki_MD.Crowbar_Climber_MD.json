ent-iad3-1.oculuscdn.com&oh=00_AftHtJrU4beQB_m22ar0J03BknDWLXthU94vP9AshBg_KQ&oe=6999A266"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw1yktR-k8UQ7kNvwHjp28Y&_nc_oc=Adm8sqJZm9xAwKhPYfbUPbTvurODddadhDn370EZ84_HwsgGyHbNxHwoZg-AUIi3_Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5uLWMom9YErJBFlYWessUiTjI55G_FTpXEaHUznsj6w&oe=69999BF9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxMaTRvUAcsQ7kNvwGcNDde&_nc_oc=Adl3HMw1sJFBQX6vf3a0fSLU1F5SOOWmwYcSdA52j5IFFOzrighGwAmBLASCp8OCHpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_86KO_w98RLPsk_pHZdGXyurJMb4m1lczopYHJyVrcA&oe=69998E23"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FntCTPOvQQ7kNvwH0elH2&_nc_oc=AdleZyx3WfjpH4BXMcWJBiLiD1JNiC7MoEwo3YzwjbJRliCvzLNriLaZWhxLwLirv8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunBiU7hJQc4aj1lKbzbIadFWZIlm4a0ZnRg2zsxyOpIQ&oe=6999C2C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRlETLDJXcoQ7kNvwHmMtZF&_nc_oc=Adnft90q2q_RvXvFIJAclzK8MFixfMZ6i_DuvpHK3HT6PaY4FpjRkdIi1CLNfcH8BhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvspN8ZrNRrYLml09TbfGZRS0JfWmn8sMW6c3ZNq2tXKw&oe=6999B4B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4AxjhkG6GQQ7kNvwEIxYIa&_nc_oc=AdneW68S_sjM6izyP6si1ndfW2BwmKEyefr_ef_1HtPgyz4ikIFoDoGhz38QbNONEig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9b6PYYNiHUsLvPKilbj1gXunD_djlFd7R_YUIEI6Onw&oe=6999BA29"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxSzWQLKHZgQ7kNvwFUBIRU&_nc_oc=AdnVPm8FyJyEr6SQXwfvmKRrCg_ZNOFNnWyXlWplngIZLzZ119JZah-4jGWkX9JPzFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIQxzVl393PLu4zYNY__FiparzSALDVZoNB4K_Sjr1iQ&oe=69999B43"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6yS8vkDMSQQ7kNvwFYP4Q9&_nc_oc=AdmEWVmLCzNcJWaT4E8OlqT3YkehxMbIXpSgslWFn3BwA7EO6zCWZnDsYeJh_asJ4h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFjslHnTR7C5CULja1Ba5kdb7kg-vs0onl6ERkQAMkGg&oe=6999BB62"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na7wSbBP68kQ7kNvwEFeI7Z&_nc_oc=Adlvqwv3D7sF8avbOeO0yJDDrFgnw5uX6vs34b0PJ5pvozxZpzFlJV6DlTTBwg2ifbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2SL_IekgFDxPvG7OlNebhKnBD4DV8zQf1TdaeA8_Y4A&oe=6999A7EE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_12
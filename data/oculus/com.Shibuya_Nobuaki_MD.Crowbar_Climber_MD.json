f3EA7jvBIWrb_7vL3oCvbzoFPOpuf9SyvxHqs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97dsEiTMDi4rqgTqFW6paaeTcHvqX11EarDkuzKoYxyA&oe=6A36A59E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUyUMyPSsPkQ7kNvwHz53tN&_nc_oc=Adr18ZcomKeJHNh66YAaHm-_nmDf1yrAxLc7mJx5VUiuggYymMJpdlA5bpV6QchUn6c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bnLaN_UCxEvJfgryuu4gU_SDhh9ibNDpswFoLr4TXBQ&oe=6A369792"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03U1nS7Uy3AQ7kNvwFEOc0b&_nc_oc=AdrHoe8rMpFdAmOWC0pVgA52ZHr9MUn1FdG-IUGVMzvQ9wjC6FqBcZQqrpDhmHnkMeQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H7B9gjmVe9vwpUFbkNKkKhJe-qGdEwkm8AkJIvYFLAg&oe=6A36A0E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwIwye70MoUQ7kNvwG4yq15&_nc_oc=AdoJpvR6CtmcS7AFuIYpqejo3nyaNk6O4i1j3xjJ7eUtsNdmEE4NTU2cYstqAE9PtSk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af962cK5JYdfu07fJNGb2cuY-bkxzruguv94RB2EcK4IhQ&oe=6A36A3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh_KSnyz3rEQ7kNvwENQevp&_nc_oc=AdrAsuBPIzCGmPNaJkjjNq3j6yEr9OCp8b539vnjsl1a3Rm5cK9l2KqXGXug8ajvbuY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MK8BZJ0z_zoiB-jJzWNAlXWYwfUzPcyL0rNOmrfJCGw&oe=6A36BE03"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyGrh21bBQsQ7kNvwHvBhwP&_nc_oc=AdrYTi0Ugv3qn7M9NDgJDK8cBMEeIIdoZqxy9jMM8ofDhUfnT9PIhUfmFLmYU-OX0NU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WnwwcHsT4HT2MPiRAchhjwfX_y803dUChsU0MStFAJw&oe=6A36BC8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193
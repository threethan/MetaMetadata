1Jbdpbof5NBQipw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WiXVuacmcvtY3rhtPq7kBfHSF63DmCz5QPBHDIq15Jw&oe=6A3E8E9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ExRrDJY0V8Q7kNvwEDr66V&_nc_oc=AdqizlJQ214_w2BPaUC1LVufEM2zxfNd_CFQCPwxaMaya55EiI2Zz0evI5r5jgrd6rY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8roCUtB7aS5VxlxcSn5b83RKvnQoFN1Y5qX5Ff_xQ8Yw&oe=6A3E8092"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_QvxB8dGgUQ7kNvwETlijd&_nc_oc=AdrVdDbUvEl3bpRS-0mhFvJ7vIbKVAzQUSiT87ErF8U8n-UVXYpCKmXCGUySKyOt7AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QsrDp1fkInnKz5IfloAxZ4XfU5GbfA7Ga6GVPaJ6GKg&oe=6A3E89E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CScD5H_i7U4Q7kNvwGs1Wz7&_nc_oc=AdrOwAcuToeKw6qMtiOUQAXe1xTyv0FTqcSQjcj6xnTPaSJkv7KW0pHrUg7pn2T_V7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CJZjXSSySpv92ZNN4hK3lvJg0-ia-rJRTQzck-0F0Xg&oe=6A3E8CC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNWhaQA9jBEQ7kNvwGtZTnM&_nc_oc=AdpgQsVmkHR1zIJEVbuqddMOO8jaFWFZRTxcDjPHtBH3TRcEZS-Z9lQuwUt6BDJW8DI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96wyoiLuwBpnCWzvvYrBYYMKsRvKsh0QC-ILCFLrP34Q&oe=6A3EA703"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke1ittzxZdIQ7kNvwE8RErg&_nc_oc=Adpr4bgEoshyzN6yTmNd5aJ3-mkEnpHfpft2AgFlZJ2PT8-w76g6F40sduyGJgiHGPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wvqLYt8fcgZgCuNX6byonoeohmlL3JTbSmPKHAhzHuA&oe=6A3EA58F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
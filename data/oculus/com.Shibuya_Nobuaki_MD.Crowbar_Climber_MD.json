t-sin6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpHFby8sBA8Q7kNvwFOh6Oz&_nc_oc=AdozZL9iq0RH5Rs9KvtUVapPV1nzuP1UaY9a_ALYAQlC5OtILndxWbyjSCnKBKy3VNM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zllfpoz7ZWjbpv51Of1KptuaPbnIrWMsa6nJh0tzDfg&oe=6A22D112"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB7kLbRht6EQ7kNvwH7SUat&_nc_oc=AdrP9mFCxPSArQ8oSxeRwio_17klWKxcHrpJopshwzCGBaZ9YpMt9rYGbT9qBJMdsp4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91miV4EyiI_rsjj1O6RW0gNz7PwKPcbeBamB_Wuh6sJw&oe=6A22DA65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNmXF7NqtWkQ7kNvwEZ1J5f&_nc_oc=AdqAgHiwOmWl2A_QIJDn6tuPT8Yx3lTnswjAX1tzDInjkDOwmAifggFS-rruEL1ovY8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ny-EO836j9I380taHwg98sbxfRrGz5E4wcjKvpiuxLg&oe=6A22DD47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgEsR_bFeKYQ7kNvwGUFEbn&_nc_oc=Adq6nJ61bqBKtHpcTA1wblEgVQQV5t_DDWhHt6DQiJBG-5swLHoNtskx5Cewg8IpEEg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-cHeOSbERh_L1945vjnYwo3fTWNqAawxda374yu6evA&oe=6A22F783"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opLOHLJxcEQ7kNvwEcW1pP&_nc_oc=Adpx-yGfVI4VNPOUlnKjiUeYBqzw-1LJv45UoI3iFyORcPCWNu2JMadjZ-7I-KU5m5Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b_vIyj1ygnvy9ymVzoITvw0oQ_Bv2T8dfGX5ju-N9iw&oe=6A22F60F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPUei89IL1MQ7kNvwGPy7Wm&_nc_oc=AdpXLpxFor8jOJE
.com&_nc_ss=7a30f&oh=00_Af1HdZtafo2952TzAn7y2VJVXm5ZU1AUzH8pTSjrfPTGhw&oe=69E2496E"}, {"file_name": "\u6a2a\u9577\u306e\u30df\u30cb\u30b5\u30a4\u30b9\u3099_1080\u00d7360px.png", "id": "1034501425088666", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031618_1034501428421999_2451223709124391201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYM-e0rJ2QoQ7kNvwFBuPq6&_nc_oc=AdrIChMj5Mb5HMyym2HamWNAkcjhTdfwgNDJmcPNUWKtlo-VUWP3JUTvOrNskPZgxs0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u9AjfG2LtwpN3bu63WsFzlA295j8RXNgPGkaqhLCbqg&oe=69E21FDC"}, {"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "982875623608285", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982608_982875626941618_2003859836911121711_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3YR0sWYCwMQ7kNvwGoivi1&_nc_oc=AdpF7LpT8J6ghunv9f2OGikKk-DEjDgky8iJNnzfpIZFYohLc-TctIa4US8tWLQf-eQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y0OSZ6X4iV5yPgOGcpgCs57F97rFvvWDRmYQYdVrZTg&oe=69E243F5"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "561168062997759", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57572928_561168066331092_5754473564035552185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=933JIs6y5GkQ7kNvwHkEMzK&_nc_oc=AdpWDse7py6uYU1-on8_3ovMSmvD8Z4jg9cqvE6_oGCIeAEWTgKA1EqTHAq1WD0HZZI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nG6J_YFgYv6C9zhvlE8bIjUZIQk1tFkBLn3Uwg3ID2A&oe=69E242FD"}]}, "id": "3704118076398870", "locale": "en_US", "screenshots": [{"file_name": "Steam_Screenshot_01.png", "id": "508321898775594", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974835_508321905442260_1779725050188987969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vl61f6fTz0Q7kNvwFtMXtY&_nc_oc=AdoX1gmWF
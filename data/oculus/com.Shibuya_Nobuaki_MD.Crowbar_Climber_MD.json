d5-3.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4654mS0GwQ7kNvwGrBQ7-&_nc_oc=AdkiV3KrWDfasjoAOQLsW46HJ8ecasirn8Aj14j_qGN3ENytb4qY09Xjr7gJTDs3rno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9BUWRRfWfDEqwhbetpY1HM6Zvh7LpUiurm5hJToK8Lg&oe=69B2CF9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oY_xvtYXWgQ7kNvwFpLdtw&_nc_oc=Adl9lc6keMEBe7jmkTyXy8TmWDUNq2HV7uQ1b2Y3gRHDckVG3rLdk4o1uud7IuOCLz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXphxXRWs_1mCFiNeEonBHy77AkYAAtwhyPivBJBtPqQ&oe=69B2C192"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TcWoOIwncQQ7kNvwF11Rbt&_nc_oc=Adns0bop2wTlywgEBobDpVDBUx_Sn0C-ZFrB5bAzyMTILnq-In4WlYgk_wGBqDKyIiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUbhOJzQWgtGEg2_dLsMFar6NH_iZjbq6Oz-SGvUUcpA&oe=69B2CAE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4l2T1i4IhsQ7kNvwHVnIrG&_nc_oc=AdmCgBQAJn3n4_Wb2yhXbzx-VKIyV6OBR9KrWaDqyj6NeFsXYOLBtAvLRGvF50-ukNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl_lVI0CggIJoh95uBQtib11Bqm1tc6EPDyA1CdSDoRQ&oe=69B2CDC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpqOG5UxyA4Q7kNvwEiNBXB&_nc_oc=AdnG42xG1FtFfTOBVpm-vX0dltnKSdGPvFSWkF0zksekoY3ZAZbrrNTPcbI_L64Nd5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvQh4Xj8VvwM4uzP8aj0AAqAxlyUnCD3zgaMWhifT_BA&oe=69B2AFC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO-nEhY-1jMQ7kNvwFbsf6X&_nc_oc=AdlIrL_Zzg6uAiD11EZ0l0NN0kc-gv-U0GvJZNYySpLb54MIP-S-k6Xg2JsPSQU3lmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_
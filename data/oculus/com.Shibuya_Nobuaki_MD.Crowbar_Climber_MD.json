64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocnzKhRzUXkQ7kNvwGBN50M&_nc_oc=AdrbBsu_dj_cckuC8RxyQIBJTNKYpAE9fLULWGHULjMv2M8fdWwboCHo7y713n9suFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XJ94zNQG_ibnBxn8r9gcnrRHK3dzuBoCnojV7c9gADA&oe=6A43D440"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GRFMYmMB4Q7kNvwGjHdWp&_nc_oc=AdqsEMQKOPGUls91GxDOoKwF_okTIyNVzAOxc7qf3k5WACzPDUjpqYCSGVrq-63xoEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fOrbI7PBnLJnXKNU7pOnZ0JtD99mKRaVdOlswDAk0gQ&oe=6A43CDE4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSITp3aRagEQ7kNvwHC9udx&_nc_oc=AdpCSAXcg3TmX_4YM41nggIvGd9DNrXbz9k1-EVMFLYqspAVkeXcb1IR5ZLBsuPynQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K5mAQLAyyI5Z2eUleSRg86kZ0Ylzbk0Fwzc1cYIebkA&oe=6A43E2C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8__-qHwLRQQ7kNvwFTzFut&_nc_oc=AdoS0KFf95IvLI2b1wnRZxA0RSddkqWNIloGJeY5gUVBexgCU6L79-hH9B1hm4b5Cd0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BAUvRf7Lf1EHx-aDzr3RNs0U0grydvXlxdsMSakrh_A&oe=6A43D03D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v5vnGH2tKoQ7kNvwHmad70&_nc_oc=Adr1USmOficV4T3Ocy9kZBycOTqxplmddxMuRsOvDC3E7M1CenmC9K3kAhAzPvLmdwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D_6fmi5gcax4rFKEA6WAJ6tTOUmp6KfCBNqqL79kKuw&oe=6A43EAA2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
34748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXFLWSDWt4Q7kNvwFBDl2-&_nc_oc=AdppSYfG0v5qq_vTLVECRzbv3wiaV2PsOEn8O-U5ur6nlnw8tEOuwSuK4zXMwKrTAJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ri3XVUwYBZ70jHNZjOSlYmeFP5vEyVRvxfxMwq2UsaQ&oe=69D6681E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJqNRgC1IaQQ7kNvwEOa4J-&_nc_oc=AdpMCMZYS3-v22kYYYMxiIL_7ICLZUl1pGBCW_p2WysWPP_seiXjVWTYR5JpgN7h9XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_vwAVDAMjTdZZ-AGHmJDKNHmW8qniYmW72B-RfiadrA&oe=69D65A12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwy99X1ZnIgQ7kNvwGVihcr&_nc_oc=Adqe2TYxTiHIR9jwJBz30_0QlsUzYDo1iwDX1SYAf-utHMfe5BqGg5Z7mGG6gkMx4G0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2siUgwBGNgji3hbu3dhzU9injgptEKexNNckfRjtb8PQ&oe=69D66365"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sX4D1LRhIEQ7kNvwEX1ZSt&_nc_oc=AdpdrfOUNkbOE-HGso1w5Ru9m4IPq-6fV0jAeI9LwP3xakFuTrGpS_KXhRY9HPc8pYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12-cGxZS9uJvgMH6l2YVxgcU1T8m4yVrKp2eXjJxHHBQ&oe=69D66647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvKlpJvFvA4Q7kNvwESXT3E&_nc_oc=AdouHTxU2FRzT-_B5_X2PXDg9fYsXt70T7AgJrl0o-vNezLGrey5IWustmPmw2Vnj1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01A9IUjC3GhWpp3XskgOLrIwajhQkf3QLUMriSDh515w&oe=69D64843"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3SDpt2JQwsQ7kNvwE4mpUr&_nc_oc=AdqJV4OK40qxBP0GAEhuAzVDWiN07sXAwBBHQcLam7lGFuXN_Ul-tohtUn0-
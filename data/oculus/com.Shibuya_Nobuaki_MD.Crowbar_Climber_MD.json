.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDaWv7_RMVgQ7kNvwEEiZzN&_nc_oc=AdrFfOQEIkPMDMP2oF4fqnJTqt824BC_HsaZ4W6qsvOJPmYKE4CS6HIROCHO7P1ROlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8XMzMxPM6a0yLwvvl_oy4mGHVTEcyxJzF7Sh0gZ4rqA&oe=6A4BBD40"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKWrJNg07KgQ7kNvwFbh9bX&_nc_oc=AdoCUSKpCCyQS2CG15bgX1M2jzT6-gcrScZau8wo5EC7B4_IkUP10lY1SI8fVW5ZMVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI_rkDbpaLaEhYMz30wzIUC_5vA8TlcZUSmLfGmrMAhQ&oe=6A4BB6E4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zcsmjkptWEQ7kNvwF90Jpk&_nc_oc=AdqzVXt55l_GnvkIVvm-xhzu2ytxWoFsoP_IN3-yNfVi1blpUi1X4gh-ncEpy6WZ_lU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9dq_AiYRO-zMOWCmgEd4da3nlheV4HdCGUX6LyxrGRA&oe=6A4BCBC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjw2lO5lFgAQ7kNvwE6RNbE&_nc_oc=AdrfPTPozsjw5avGmQJRAkJOWPioHjYc5-sVzqe-awNGq6StHBbHtugnKORkj8mc394&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrJbipDDlXhAVSvKCbfUboSBW50BXs1SDQqgfid7zMrg&oe=6A4BB93D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_1JJOI--w8Q7kNvwENJNgJ&_nc_oc=Adqm59XU4yF453nmWlD1QfEk-EYFLf8JNPTyqlz07zIHmIvfHkpHYv3j3tCCj_KBjZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDPMeg8p4b_u9wh-PpVVCWBztmJKBw-TcwtsmG5pFSDg&oe=6A4BD3A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_
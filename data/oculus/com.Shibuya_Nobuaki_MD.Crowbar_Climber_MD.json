.com&_nc_ss=8&oh=00_Afy-jbsNRLohrnKUS-Q1JXl_emC6pukJvtTKuB8wWS0K3Q&oe=69BEA865"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKm4mFaaKY4Q7kNvwFVWjb2&_nc_oc=AdlwdRr1wLgEN9GOb_U_GArWG6rk8CPfsOA_dxiIwRfxm4cegsIKl5WgKWSybLM39GY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD9EKkgmWMhSI-9wmZJ8Kz8iBSSj3kRTWxE0alt-dETQ&oe=69BEAB47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS7dYhvpb0cQ7kNvwFY4ZIJ&_nc_oc=AdnNNnL53jFPof7JIfMCWN-bYL5GgXXAFCblEBYizqnYXcCuBORYQyxLk6yFBmu5BRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgoDffkoxAKF2LddkVicXpLX07B6Mw84vpIylgHHN7ig&oe=69BE8D43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVe4BxWpbSsQ7kNvwFL2BKm&_nc_oc=AdmDIYnewveBQOIZvcXScSzf3_8HA4N3D9gV6r275IKtNfPmuupEY5FzSXZ9tcb6cmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz06gaWL0JjjyCy2y9PHMftsnKwM_jdDRJVOmfoID8rAA&oe=69BE8BCF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlCzItRzrYEQ7kNvwFOMhs8&_nc_oc=Admriv9xTjSPaUurJatfwdk7fyaHbML9iCdZhpb6bYhTRi3zyJ-L4vTEzHTQBsz4xxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYW4hTK8-zEqmZxAaZyJIOk5vN0WWFbzC0pSaccSQosA&oe=69BEA24C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2gDwQQ07PAQ7kNvwGtuG44&_nc_oc=Adleg-z_b0pRJPTiExlUrv72heFruPCSHUd5YRj6QM2rj6sCYIhMUmHjXjt86PsQNM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyefXy16cxb0UCwEZcJLOsN6KpuCHFuJ8CxoDT-LVZW6g&oe=69BE8F23"}, {"file_name": "\u30a2\u30a4\u30b3
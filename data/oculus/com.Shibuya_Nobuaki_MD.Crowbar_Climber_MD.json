keyg9nA39F-22rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vzYR5C55dxPoSxUfdk6BpYKBLnia3_-rYlOnOzJCoOw&oe=6A3BEB9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ExRrDJY0V8Q7kNvwFD37zT&_nc_oc=AdowryPo6kYo0w37Y4Fdzs0fKYyAmKd2M9nFpbXIQCesN2P_6_F5gcw2aB3yolh7nP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sgdLiWHdvGEaEDjL0zS97nDMeo54-NF0q98UfAs-CVw&oe=6A3BDD92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_QvxB8dGgUQ7kNvwHxNz6V&_nc_oc=Adq27OBnz70VrZEGZiYcJqe9FvW67wcEaUWpu7OTPt2xDOw5Lr2rxxmo0sRmmee2d5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RGycmf_gi6OcoO3svilaN6jwlFDnN4U3UpfbAMZtM7A&oe=6A3BE6E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSj2cD2TGFgQ7kNvwHa2urU&_nc_oc=AdpaSgaHPMk87TbA049f3SkwQcAc7LA9KyQMthfXcV1SZJmIGgFj9b-m-de24lgRZBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85E4kl2qKkwMHqpINQbZdw45G9plAzQpT2ARUBoWkR3A&oe=6A3BE9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNWhaQA9jBEQ7kNvwFH9j8A&_nc_oc=AdoZ9fxjU-mBRoDIEv9cx2i-dJPXu5nVhNCIP71gQNUEHiqerVCV0yNN76dNoxJO-lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r_t-WGELLk0ppWwZIbywtbS37iK4SMkrF_4vb8X2H5A&oe=6A3BCBC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMJp1lQivTkQ7kNvwG_M6mf&_nc_oc=AdqVMw_HdA06f3ICUN54NaLiLl57Cn_gbb2qRWtr9RLD5MMTFPNlpzDYicFmy-NaU_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bwi6v7WOrOzl_CILdCcAT9cr_53b610qXiB0EN37VmA&oe=6A3C028F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
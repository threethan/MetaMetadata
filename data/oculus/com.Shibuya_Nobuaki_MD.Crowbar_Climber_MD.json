j7mBZTBtgAM75xJXuQXjx_S6VkmMAL6SSD5PpddyI8hggxZZC6mswo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI__bO0g5akVQU_cQqwIlTdwLjL8t7GVhQ6BVRWRIu8g&oe=69C91866"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG9r0RemUnAQ7kNvwHKuKkG&_nc_oc=Adpr-edTbUiQ7Q6zwLnKQFItblTgbz14k-D8qS-qMgtBGdpLV5ro3GHsdy64JnzEuW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzelTuC9GWI3SOTz_YgK20mYCrpYBDwu9qXxkDuOV5r3g&oe=69C911F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_G2RiB-aqsQ7kNvwFVC6cX&_nc_oc=Adr3os4bXr4rWzNfT0bvH6wsv1-eNdHfUYDYFVkfyO3wLxMmuVf_snYmHq6eXneaVds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzydpgTSftuH8N8J0rLDpsYffd4thiM5bJ4Q3lw0U3AQQ&oe=69C90423"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gonp0dCG6t0Q7kNvwHbnwRF&_nc_oc=AdqoFN2PVtA8xO_ld7lysk2h2xvL43BLp8-_gvGJ4HtKs1GHVT97HqP50IboWudIy8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqBChhLRpCVZqyWtU_4l8gQkvVVEUalrdjNlCWZ9E91g&oe=69C938C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20MMbxTR0HEQ7kNvwHM1c9C&_nc_oc=AdovE7UexE_TBgkBorkyfTg-GSXynXjjxQNXwWuKak8vZX41amy7gOd33I_ff8ghbtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIZlY_34LTSmaoDvsyE-_3sTPZtwctkGuNNgrq2PCPQg&oe=69C92AB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKNZn8u6K-wQ7kNvwGfYY6K&_nc_oc=Adq6n-uGoNCGhWN6xQpLrhBSll8i7unQk8e6alhY8CDF58ORMM9bsHjT9lAksnxgi0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya0tDxBmniolgB3qtO9hUD1eEsgAMG404IbMcki5WVMw&oe=69C9187C"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1Sq2JLdqncQ7kNvwFXmfUk&_nc_oc=AdqzZx-rts5W42T6XBKnXND_1bSm3PL4QB9zwrBJsBoc3-98k4uoe_TcRRVDIAKkHYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyn4zdOwB0-Ya6VyQ1_7Gb-soehTiFLLGcxNcETJnzBvA&oe=69C914CE"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X03MXEv1ftoQ7kNvwEUNCCP&_nc_oc=AdooxvdIgYJxPjGZAtUE8XxPgty1luKtDW3TMXmodOMP-ostJt7gdo_ldVb2cZRZouo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf1cEkj6VLtEwE_zuE68ditr9HCqRYwwx7H-4lLqc_1w&oe=69C92279"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb=1-7
.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2cqwhR7L0kQ7kNvwEze827&_nc_oc=AdoLM9K-se6ixGgG7WxOQ3Vm6ePmxxsjF7t4c7gp6-yxWiZatIEDS_-wU8FLQNulnY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA83y129Hav6qB8jiWPNWiQXojv13p8hOvuR3RrlRyk6Q&oe=6A491A40"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKWrJNg07KgQ7kNvwGcbiaC&_nc_oc=AdqzewWv0p73WsdlsUeRvYJiBZQ5D6leQl5T271gg7AD7RKQ3J5cPE8b7-7Jo4jP7FM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0AOpoV-qR8kJe7SnGXyfsWNOsJpCo0Q3-ddSRXRnU2A&oe=6A4913E4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zcsmjkptWEQ7kNvwH1j80D&_nc_oc=Ado0Geer7YLSpFTS3gqx1yVoQEfIq6Opz6SZkx5k2sE4GT9KIPZDKtUvAj-in8wcR4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXc8IAGp76opn8RMv4yHQzMe-BP74QX-N5BOJhDz0C4w&oe=6A4928C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOG7g0Bq6qYQ7kNvwGIG3Ad&_nc_oc=AdqoCEejeSP_bykFTWJ57S22zpDaLwLAJkrprU_I-Tyy-0AJwLidkngU9hBwiAjZZZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA3p03DfKvDzACH2VYVvRiJcKqCqUhpPb1tP2OZuslGg&oe=6A49163D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4EwJzrAWzwQ7kNvwGLbH0S&_nc_oc=Adq_5LaisYhibJfPO4KNINA_sIv5-18tVgQnXTeoke92QV4aYFc0viIfx5Kk6f0zNUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcrJc9tjo7OQcXXfZfJSiPHURzmSJy2tJTA8JzUECtfw&oe=6A4930A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_
ent-iad3-1.oculuscdn.com&oh=00_Afuxgo8AvLCxPqs4tVh5r7-L_oU8OG4XRkaH6il6DmfpXA&oe=69A2DCE6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up1Vz4jcClkQ7kNvwElVaFb&_nc_oc=Adk6kir6X2RCPAbwmU9mpjB_iamqmKA_-8YDYOmOtuRjF2_kjNHhOOhjQ_NMuq08-GY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHoj8-7EM6xwZyyWGkK43Z4nix6T3yLk61yvlPqY7rcQ&oe=69A2D679"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUq_W5-nmgkQ7kNvwE9s8TE&_nc_oc=AdkIoNMXqkRaqlAGTHNeBlWYZuErMUexv2fzaDl8M3-GZoCZo3qbeYLmv-GYq9Tunkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afts8MQSucpk3jZTkRYnWxiTNXm4owd0X6Y2GEtKVrmZWQ&oe=69A2C8A3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWba5SckaCoQ7kNvwEbBW6c&_nc_oc=AdkC1sAYZqiLiK1Zp6ddEiP3P2_J1v4FfVnHwewzuuCDH60pgVuk9zi0k5J5LbL5v94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_u6DycUckCQq6uW4CmDa5OUWunigDYwFPiBrtQJLYuA&oe=69A2FD40"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNJQlzPO_rwQ7kNvwE2yz1I&_nc_oc=AdnJYhFuG-_FjTY4ETRdu6m8hHRPMOeC4qBN0jWAPyzWnDjUOO2xII2Kf05Z22RgJMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumoQRPferjgvbBQPyY1J82diEfLe9t74WfJwMHyBCVZw&oe=69A2EF36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uxp_VDCYwQ7kNvwGqtMmV&_nc_oc=Adl8tSJ5iHZvJxVzb6oKt08EWXSyUQZgJPEQJqODkss9vMNN8SZ1OG-wos3UfCA3ewQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0y5vbpcHG8cfbj6VG8Wuok4QEeckOkUNMiQeOligLOg&oe=69A2F4A9"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_JBJA-LPv4Q7kNvwE5VzBI&_nc_oc=AdljI2Ri5D958m5LsHRcSnD3dYthhSljjxZFbjfSkTeW_seYNFajqdp1LCHWSWmwHCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftL_CSJVk_mPChP8lN-2nn6GI1xGs1fvYYqIwHs313J7A&oe=69A2D5C3"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNp2cH6RuIwQ7kNvwGraZkm&_nc_oc=Adni5jH2koEKAMMebXJ4v2OlORBuiA5_-WXnydFfLkOP1uUnVQQogp4AMaYn5xxDbX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6YhD3LidQL2L8QbZjaJxNYJidO7Luy0IHW5LAt_0Yzw&oe=69A2F5E2"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1-QfS7w20cQ7kNvwG7Efs7&_nc_oc=AdkYusMEM0T6sqDFmESuiI34GrSj2TNj4p5PgO0hywm_CnqzRWQ5wF-GvhJqiYIBm8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3ER-e-KjgpA4uje22FLsSyzsGcq-nBQ6PcSG9weTPaA&oe=69A2E26E"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_12
n.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIvdPk_Ir6AQ7kNvwG0K7f1&_nc_oc=AdpMqreEYEwIZ1n1RmsUXS5AQDvfHJm3yFoozveH7XXubYRc_yK2SiR3MqJLfTt_TfQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k1WvExxCX52qlBuNv7reX2ludh0Z8vUqr5Kk6GfP14w&oe=6A12FF12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsV71xwOdX0Q7kNvwH5gYwj&_nc_oc=AdrZhULniUf9kt6sZCGuTF0gEGWGTKEKln_mkHjjyzfXD994oAu-3xyT9sRQCX-n7jw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cPNh6aPKdxC49c0gipGl-u19hNw0GMlXCOmBnQjWLoQ&oe=6A130865"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAnPbosIfLwQ7kNvwGwh3xJ&_nc_oc=AdpJzivxtami8Dttj8h38cvB8Hy6rRjUC92A4uhI_QQ017_Jqb4lcA83ScKrCLILhmM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52lKyCmxjvPZ-7Dr5oIPBZfK9FFwA8JR7YKTCj89CXRA&oe=6A130B47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1R3Yzj-0bgQ7kNvwGcMEAk&_nc_oc=AdojtVt0QOqXR5J3Iy1Xn6kqDeOTI4F93bgmaV0YVFdHdv4pRAP9isoOdqag4O57jFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TJUOdFQKEiH3Rht2L4JsGawUBKXNYg_9_gi3UY3GugQ&oe=6A12ED43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXbNVHvcIf4Q7kNvwEvj3zF&_nc_oc=Adob-99dy9lxiEKEkDVHoEU9PgpoKuFHyX4VHVPsEf_b3FE39i9wArURiivamHFcD4A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ambleUS8JtdLPXVHorkWWpWjZfQKttf36Foak08yiTw&oe=6A13240F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qVv_iOyraoQ7kNvwHYvxga&_nc_oc=Adq8CLnAZDfCzz4lvutK-t8T0JDdxMsDF
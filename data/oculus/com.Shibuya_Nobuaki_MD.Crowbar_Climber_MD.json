fmfAhr7W3fAP8Pcl-K9TOJD1dcfUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx885JVzbX3JyUwDhIIWYMZYPQtaU7LuMyQjXAQSTReeg&oe=69BBE966"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbwnoV7EVmkQ7kNvwGFIuLT&_nc_oc=AdmZJDBT8KkJi_uj6mGluvkmBnt4CyNp1mvbPAdZ3ky25MyLv4xaQ8bktq2-J_KF2Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYOukRm0TiBYvDBpLnozkd4HVZi6rxrzXaOPKmkDArlg&oe=69BBE2F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJVE9IePW30Q7kNvwHdlJ6e&_nc_oc=Adn9IKbgdjA4lOtriBopgxKL9QaNQf1Tp28YPFN7vzWefQUE75tVGL25zmcl2BHbKbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFy2-DFtdTuUXJhksl8h64WdhXB8SunIaGbmTwb489mg&oe=69BC0D63"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXYmd-cXulEQ7kNvwGdgwRE&_nc_oc=Adn0gvMigP5Nj23gI5uZfzRw10b-F51L3jX41oAAO3CclFbw5vv1uGRlCoDC4e91IJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzf2hlVblZs3UXnOY9VoKyJkipyejvw0Tw5XSs2mWfKKg&oe=69BC09C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Cvt0pwg0oQ7kNvwE1Bhuc&_nc_oc=Adn2DLL5NZThx8Ml2HWfeWrH4MvoUrtNmLYmiGoZsrZCKkhbBi2WAkpcvFxq5_kFQnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-abJRmmRh4dPoFCx1Z3W5x0lWCAG2sUxQ37OsPSC2gA&oe=69BBFBB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr8UG5KcevIQ7kNvwGhpl1W&_nc_oc=AdkY4ttlOYCzN3O-ItuL4X6o_D20Y0LXj8Q7VaOUiu4Ah6s3CdPm3Aof8ryeAbjyyZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6AOtxXMsWKITa-5SguzXxw4o7P0jltimVi5e2uyZyXw&oe=69BBE1A0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6VxP--pjgQ7kNvwEjDq19&_nc_oc=Adk8x6gHBm2LJqotsnWUqR5kEISUaYOCC0bMaxpcSAZSMDCHkyGdQ9Irco-aBt5KpMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytoJ5dtKCRhN0zkzW0wNcomXUETH_1Jh89HYOVKe63Mw&oe=69BBF50A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeLsk8z9LGsQ7kNvwG0vql-&_nc_oc=AdnZA0oEXCYXqztom4SDfDCQd4y3-9_G0OoayAkQ1dchBgipDy1iGcyzQ0wFT1cu-VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhNhVbTay263onpXzQ5zwzRG4Sx0XO3RlWrRrmRe51eA&oe=69BBF988"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqdlvj2ij7MQ7kNvwH1afh6&_nc_oc=AdmL7D
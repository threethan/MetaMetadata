hc=iwy99X1ZnIgQ7kNvwGIjMql&_nc_oc=Adq1pB4N48vWn6b-VCSWuXAyl3Wql3P2wjpPZgUcZVKk6DM0rU9D0Qws_Tfbtn90Tnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yRsERfH2Ty0yuBYGxFusIFWPkCNXbUI8OCuPDmYicLQ&oe=69D511E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sX4D1LRhIEQ7kNvwHKs4cA&_nc_oc=AdqzT9YuTzpJ-vs-_D2jpCv4ZHwHUnOUiZ89TRsU9dY1tD51YSmsZ2ZQdcNNARQgBqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rUZxl9ZAbL3jlYw1DN37v2HQkSbp6aPO02kaVrSCqkQ&oe=69D514C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvKlpJvFvA4Q7kNvwHke_Jr&_nc_oc=AdpsIJH8sGzfzFNVTGl688zITxW8rCchffqR2a0cJMGm_5mtChWILElZ_HcOFs21NCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E3m71mjNsRal4shK-Y9Em3rYUbDQpc5QhaMmk4ri4rg&oe=69D4F6C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1SXFD_cgUwQ7kNvwHi95eq&_nc_oc=AdrQd59rh2erNts4cftjuy4I93gZ2F9xrMPcoI8lX9o9ePz8Bw45Cp9fwZDbg0M0cVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ov05-x_OOmDXLahGcEKlzlBb2rNEpYvFOnFf1CnIzuA&oe=69D4F54F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp4hNADLdiMQ7kNvwE15TRK&_nc_oc=AdrcPsZRF8Pl2VKaFIPE8oA1zVjEVw5pPorOqNJUKUnJ3a-kV3ch6NBW5-oUKT8d8Nc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qcE04xbNwgnBd95kTf8YqjgDfitjTNfIPXOmsbkRWsA&oe=69D50BCC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAUo96clfhMQ7kNvwGl7gVE&_nc_oc=AdrhEQvH7wf3cD_2hKA4qRP1zQwag-1DMAgRT521iTXTF6p-oFjoc6P_XbQuf
.com&_nc_ss=8&oh=00_AfzDrsIZZQFqPvNwd99HRvA4BAfPX6WeoVSsPCwGvjiRrA&oe=69BFF9E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKm4mFaaKY4Q7kNvwGplVxS&_nc_oc=AdlUUJX7Qmv80fz78tyj2U_xItz5G1VaRBwd91mmtkKRoDne1rdjf_1LTxkYTr70suc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1-iQJeEGuYcAf1j2RbWITJvFvRqO4wuV-03PACiQ2ag&oe=69BFFCC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS7dYhvpb0cQ7kNvwEvsVsu&_nc_oc=Adl8c0dlulv8KgwSp3qYx6voJuQw0gsvYrxhDbHpmceF70j5MD563UlBpQ0U-_Ij86I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZRh5RSin9ULuOxOoj7ZI8LCtD31GPLRvHf10Umj3J7g&oe=69BFDEC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVe4BxWpbSsQ7kNvwGcpK2e&_nc_oc=AdndLCUxNwimphbVvOvwo8vtSp08K2OZO2TjAK0x3q48YjfhBfUTi6cP_Q15MlNqV1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlOy1KOrvwslwUNh6ePXbpPpKMULto1i6WJWrNWX0T5A&oe=69BFDD4F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlCzItRzrYEQ7kNvwGTkcrW&_nc_oc=AdlIPi2rmuCZeh-wY_Up_4uojGs6DUKPDGTECTiNAa0VBdliPauATmvUhv6CTtuUrHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhcQvViQh6dabxhH6mUon1J7ugUhs28_8O8Yj0_ePKEw&oe=69BFF3CC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2gDwQQ07PAQ7kNvwFVwQUk&_nc_oc=AdkiTZKu1oAoLXMYCdJhWufoplCb4HllA8q1dJDVUjshdSThT97ca8YVeZNSPyy3cI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSFzG_Ks9bDOM_uqIwBArcHLrRLJqps_xG-8jQ-CBejA&oe=69BFE0A3"}, {"file_name": "\u30a2\u30a4\u30b3
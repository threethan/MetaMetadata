2_9079405998737762_9094242307546121653_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjZxUMn9WtwQ7kNvwGhi8wP&_nc_oc=AdqePlIOor9QbHng_2MnH_grjxZ1AGyFLSpDnvrAjnK2RSzGsZIHinM6px4qaJWNc1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af818ET3sddUWwylu-PyUCDDbFRWuXWwwkwDqX5GaecwQA&oe=6A2ACC43"}, {"file_name": "Steam_Screenshot_03.png", "id": "1755858621896986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036696_1755858625230319_778379431936277179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuEpefq5zNAQ7kNvwE0bxom&_nc_oc=AdpRlGuR73dThtCedTaiiyp5EtOW909HD0LMHj5MyQj18l1RdjQIJkccPbDAqB3GtsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Szc81paTiHFb_s9pTv2FGL-kXa25p7crx9sedul2pA&oe=6A2ABD17"}, {"file_name": "Steam_Screenshot_04.png", "id": "1439119550090780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036688_1439119553424113_9093722860365123709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGKgW2gkjHMQ7kNvwGCtTa4&_nc_oc=AdroNqnSayH1tsyNtCpTjr049qRM62h49SrlpTDcrPwm0idFN71Y7wWdJK2Tkp009G0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U75wykBy3rhDXbfnkUCtAZW3ifsl0NtT1nKL35RmQRg&oe=6A2ADD92"}, {"file_name": "Steam_Screenshot_05.png", "id": "1780261162724960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982574_1780261169391626_8321852278874860698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NebW40hf2vgQ7kNvwFyFRGG&_nc_oc=Adp_dIyZ-ECh4N4ANjwWDnwW8CqJdFXI2msrr4UafGYdLkhXMehHJ8E5SG-eZw-fDx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HSZFwpmNTFkwodQfKGQfN7Tz0dnEVycRq7XGXgdLBQQ&oe=6A2ADFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30af\u30ed\u30fc\u30d0\u30fc\u30af\u30e9\u30a4\u30de\u30fc", "keywords": ["\u30d0\u30fc\u30eb", "\u7269\u7406", "\u30af\u30e9\u30a4\u30de\u30fc", "Crowbar", "Climb"], "long_description": "**\u3053\u306eVR\u30b2\u30fc\u30e0\u306f\u7269\u7406\u6f14\u7b97\u3092\u3053\u3088\u306a\u304f\u611b\u3059\u308bVR\u30b2\u30fc\u30de\u30fc\u307f\u306a\u3055\u307e\u3078\u306e\u6311\u6226\u72b6\u3067\u3059\u3002**\n\n\u8155\u306b\u81ea\u4fe1\u306e\u3042\u308bVR\u30b2\u30fc\u30de\u30fc\u306e\u307f\u306a\u3055\u307e\u3001\u305d\u308c\u3067\u306f\u9802\u4e0a\u3067\u304a\u4f1a\u3044\u3057\u307e\u3057\u3087\u3046\u3002\n\n# \ud83d\udcaa\u4e21\u624b\u306b\u30d0\u30fc\u30eb\u3092\u6301\u3063\u3066\u2026\u2026\u7528\u610f\u306f\u3067\u304d\u305f\u304b\uff1f\ud83d\udcaa\n\u300e\u30af\u30ed\u30fc\u30d0\u30fc\u30fb\u30af\u30e9\u30a4\u30de\u30fc\u300f\u306f\u4e21\u624b\u306b\u30d0\u30fc\u30eb\u3092\u6301\u3063\u3066\u5d16\u3092\u767b\u308bVR\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u5df1\u306e\u8155\u3060\u3051\u3092\u983c\u308a\u306b\u30d5\u30c3\u30af\u3084\u5742\u3001\u6b6f\u8eca\u306b\u7acb\u3061\u5411\u304b\u308f\u306a\u3051\u308c\u3070\u3044\u3051\u306a\u3044\u3002\n\n\u679c\u305f\u3057\u3066\u30ad\u30df\u306f\u73fe\u5b9f\u306e\u4f53\u529b\u304c\u5c3d\u304d\u308b\u524d\u306b\u3053\u306e\u30b2\u30fc\u30e0\u3092\u30af\u30ea\u30a2\u3067\u304d\u308b\u3060\u308d\u3046\u304b\uff1f\n\n{1070195904130341}\n\n# \ud83e\uddd7\u200d\u2642\ufe0f\u7269\u7406\u6f14\u7b97\u3092\u99c6\u4f7f\u3057\u305f\u30af\u30e9\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u305b\u3088\ud83e\uddd7\u200d\u2640\ufe0f\n\n\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001\u7269\u7406\u306b\u6cbf\u3063\u3066\u30ea\u30a2\u30eb\u306b\u52d5\u304f\u30d0\u30fc\u30eb\u3067\u81ea\u5206\u306e\u4f53\u3092\u81ea\u7531\u306b\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3067\u304d\u308b\u3002\n\n\u30ae\u30ea\u30ae\u30ea\u306e\u3068\u3053\u308d\u3067\u30d5\u30c3\u30af\u3092\u63b4\u3093\u3060\u308a\u3001\u529b\u4e00\u676f\u30d0\u30fc\u30eb\u3092\u5f15\u3044\u3066\u5929\u9ad8\u304f\u98db\u3093\u3060\u308a\u3001\u4e21\u624b\u3092\u4f7f\u3063\u3066\u8db3\u5834\u306b\u3057\u304c\u307f\u3064\u3044\u305f\u308a\u3002\n\n\u3042\u306a\u305f\u3060\u3051\u306e\u610f\u5916\u306a\u767b\u5c71\u65b9\u6cd5\u3092\u898b\u3
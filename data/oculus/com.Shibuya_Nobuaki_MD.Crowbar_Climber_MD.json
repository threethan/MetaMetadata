c_ss=7f20f&oh=00_Af_M7bgd1sqRYJiHhnGFl3LK7XjCDuT2m5SqxTmGDcsNIg&oe=6A2824C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98jBVIY6CEoQ7kNvwHc-G9K&_nc_oc=Adp-9qgC0WIynjw0jpZFmI0hyWUnRCQEQ7oGCy3meY1X4fxsO6mSjy5qKE3si0PfSEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96yAK5yWWAEVyyFggscTvVoPqZfLYvPAgqeip3cRTKnw&oe=6A281E64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRcyJGBBInUQ7kNvwG_LWXM&_nc_oc=AdprC0N2hx27-ChVSf7VM1N1Np81xNYk5IwmqUUyJNQLKbLqjfse5wO6sLzaEsFlW7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UZ2EuifWPxtgzRYug240YWBLjlD3ZPERZ-oeZTGZtFw&oe=6A283349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "997194399682950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_997194403016283_2414986522900241963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZ3hL9tCXPgQ7kNvwFrXi70&_nc_oc=AdpTtInPm_r1L3EPszJlultRRwH4XDabrikm7u8BGYOxy0kqI-1KZMjsRDE8kgm1TfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cJLqyZHLW17698eaLl_nnokQFvXvcToRSk4F7Kuq_oA&oe=6A283256"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{1671435490707886}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{2339678569868647}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all?\n{1683919399266895}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from!\n{26712839881658080}\n\n\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2491874854662321", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_2491874857995654_7151269643203248800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whmfj2i8nUgQ7kNvwEa_z8S&_nc_oc=AdouvdpBYjgYEznN5E71j8HqrA7u_Cj1zOX7WI5kb5g_gH88JE1lSENwcgZuVxBOgDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xieAZe_mHsIzpTTTp_NnShNX6GRrTzyqbKa689VzzGA&oe=6A280E34"}, {"file_name": "Hero_Cover.png", "id": "1963731821685694", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595112037_1963731825019027_4734823188066437645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeMZ888vF4wQ7kNvwFTT2nx&_nc_oc=AdpovTiowJMGS4ghxOkUUdlXS2yU-RsvKlGqbs6yR6pUQaGeDjM
v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At3j6ImWcloQ7kNvwHbVZ6a&_nc_oc=AdqbU-MQcy_mmZ0xWa5TrL4GL-q-v20B9Dt13Zf2lzSNQSltFEG99HAiRyqa12c6Vd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nXnNUtghkrwox0mPzXSSv-tSQdU5X3tUTbY9wLmY93g&oe=6A184512"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJB_jVXk0LYQ7kNvwEE9uP9&_nc_oc=Adp_3jlSNnk4LTPk2r0VoLNmhHNKX2McQFEUaMWGjtqQHX9EO2yB9qZdkyLWVJNz0NA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m5zWDAIz4q68LEe_fNfc2i0uVSlptyjbVYskG5S0_eQ&oe=6A184E65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqF_552ArsUQ7kNvwGK0L1Y&_nc_oc=AdqvcFPT8XKDVedHOpRbQzWK4NMjDoKH2fICXkCDSWSuhdDjZh6xwDm4QUGVzzdiDNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tOdzMR8kFN2mIhYGu-JDW17TqGaAb-LFZljYwJ63bIw&oe=6A185147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GesAsl3x4vIQ7kNvwHqhAU-&_nc_oc=Ado3NJm9iAlPJgxx537kVso26jPDqiHTve1njUhVK87yN5OfuqIQV8ZjcuxLoLKlNk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i9u0C50sP16W9FdmBVhoW0YcRwYdfaEgXWjViYQZZkA&oe=6A183343"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHTcGf-lnqAQ7kNvwEjLAIL&_nc_oc=Adrq7adVO9_0XxmQSPctTYarsUXXNJcRSVu8GANpBvweAqOIL1ejuo5EomGfPjPGKhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TjxNaYedPlHFdT23_wVhRcZ9C9ALgX_x01GGlX16kGg&oe=6A1831CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGfFgposa1kQ7kNvwF55v9B&_nc_oc=AdrA4_hv2ZytTiEPpzyIWAm3IbBj1Nd7QCQyACt
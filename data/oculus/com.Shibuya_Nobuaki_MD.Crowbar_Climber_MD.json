ent-atl3-3.oculuscdn.com&oh=00_AfvHNAHZ1AhnLj-h7YKMrULSc50WTErfyTQAmz65dhN-ew&oe=69A57FE6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZHODm4INpgQ7kNvwGKtveW&_nc_oc=AdnendfBgNgLs1MlKQ9H9Ca6Ol10X9v3uwwV438IcS0x4RnVtPDTgU1bzc9oW-1STq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftebOJHzXSU7a-oF5STyyaX0cRU4Yiu6jIPtK6i4Emm2w&oe=69A57979"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ2WT1pd_h0Q7kNvwHS8x6A&_nc_oc=AdmYGGvmpe03yc5T_HnUEmB1wTY2iJSAt2lD_M48-tEqlvvp30CEWz5ZUyHygLzaCzE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftNi3baoYSi99ZKFoywRnS8gdQsZzzd4DPDIA4Pw-8eFw&oe=69A56BA3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVXhRv5JGkUQ7kNvwHvwtHy&_nc_oc=AdkMcWfwPd5jDV9wAEfl5CE2AALfUCS5H3ceoLMhx1eacjdg-4f_dmJn8b5tFibjY4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afulqc49oU4hdems4G9XQPaJzVnfRvDLknHzMnirgSfBaA&oe=69A5A040"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1LqPUY44j8Q7kNvwHXB9yR&_nc_oc=AdmqfRDO8lZ28IQxCdRc1PW9oBUCkB1mJqR6tq_hrBShyUcKwJSP-PO_FaXzsIZhu5o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftoi0-T-sAP1ju_BTvqjg2iKal70DCrmOQY21x20JGGKg&oe=69A59236"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YliuDHVeejQQ7kNvwFzsalZ&_nc_oc=Adl4QmgrZcG3efGaL--MdBCWrhfmUyesHZtVvzgXvcezlCmKWEwuuJpFgBWTRC2JumU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftwb4GQ91RWYVLq-GVtXDlkztaHpWRtNoxxWEv06ncmkQ&oe=69A597A9"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_JBJA-LPv4Q7kNvwEMRUbE&_nc_oc=AdkmTstmBSw8t0f2ikauhajJDLZUSiyBYaNt05bDL0HnNivuB_uVYrHKaFYNcEtmC4Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftRMTDZq2U7ePkaedWXJI2mdxb8hB3R-uTeQ9ihi5JaVA&oe=69A578C3"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeAbhj3Nrq8Q7kNvwHvb1S2&_nc_oc=AdmRJq0yA0P-ax-cWaqurh73n1dWnx6e9LkEiAW_3noJCh91xs634dNggP6TTNp0zlQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsoR68oh6NjveyUKBoIdUBypetL1k1q3jUHmuvoTQVAIA&oe=69A598E2"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1-QfS7w20cQ7kNvwHfwfr6&_nc_oc=Adl7_l364rN6NdGGdtGKhawpyx0ucTDwChcTTetav-3ads721F027trFLf2ReXhnulI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv1BrRIGcR1et0KG3QhO791loMZRATaS-8wK18XsUYECg&oe=69A5856E"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618440_12
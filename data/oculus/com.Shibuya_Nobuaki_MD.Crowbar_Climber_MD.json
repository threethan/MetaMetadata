eUP3MpmaCQPlNJc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uiVjQA99-mZMKwlaiijSpoRu_GMYZ7Phn-Ow5eah3_g&oe=6A3D3D1E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ExRrDJY0V8Q7kNvwGa5ibC&_nc_oc=Adrh4zJ14prMuoPADONKipc5qxuxetbqUO94tHRMDMpvrAXBUxABAQt1tSMEPK2owQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0KZkwy-uxqlQ7U0Jfe0PdyVuynka4Sqka9yKMAMaj-g&oe=6A3D2F12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_QvxB8dGgUQ7kNvwG8QThp&_nc_oc=AdquRbWpqZ9DC2-bTlWXj6PxFEOWJc44ceEt1HPialt-0bu8ZJIv7ArA1juBoQ_zREc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G7NRaEkLwsIxBNleGRjFpGKzFU2YxgJ5KrCIceLu6gw&oe=6A3D3865"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSj2cD2TGFgQ7kNvwGozd1Y&_nc_oc=AdqHKc20-IUFgBsnk9NW62FLDYLS2t-bD54y56J6JD6TopzJOsIX-XJ8HVMCLyUZnWI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9emJGAYHANdYHiuZsdidyciQJEeeTpWjMZM4HXvzouBg&oe=6A3D3B47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNWhaQA9jBEQ7kNvwH_kSxJ&_nc_oc=AdpTVX3dvxTGQ6Xdb1pQnw4sfzxZkUOmVBKWrykexRXGQgdHU2WfF3ZgqMaD-VCeDYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nbqONzaVam2FsVDknckJjmXWI3_XHd_kfw6TGcZav-g&oe=6A3D5583"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke1ittzxZdIQ7kNvwHd7Jcl&_nc_oc=Adq2R1Q7gwjZtIQP2RXRAD5TjywbxWlm8hs7d5uemz9J7rPnfPtM1LdmrQk4l3aYgsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b8emNmb9JPObLij1-PCTwqRoXUCP0Joylc_Yrl6k-3w&oe=6A3D540F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
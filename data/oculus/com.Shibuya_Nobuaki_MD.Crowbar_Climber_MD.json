8434748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmijpSc1NIQ7kNvwFRQ2GT&_nc_oc=Adolh-WM1-7rny3AFKlTm_aHXXvxX7eLhgapGWjbzbgb3_GmbsgPAhHloNBiCMwysVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y7_bRfPy7aBRRJEuBO-VajlRoqoMalUhdkuiu5C43BA&oe=69DBAE1E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inj_1vYnhNIQ7kNvwF5y3KC&_nc_oc=AdoPVEZLN1C9P90FF4AfqQHiTg19Du3HgDuuW8xWiTX5YJ676r5WbKiPjbA8spIGEv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10mF4QkIUVLZcOaz_8WXwTQKRDuezNjXcWWN9qkXjwnw&oe=69DBA012"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1rrVc86aMkQ7kNvwFGhORr&_nc_oc=AdrypW2qGanBu3CqgsTH8SNbv7ZZNdHMExYnH3ROp6vVKRPEqsBR5QucLdDOQdj97wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S_NIEgQHaLKHTon2KwUgtq2YIJk5hKC0OKbTRaxshOQ&oe=69DBA965"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78IsxYKsGUoQ7kNvwGgVqqz&_nc_oc=AdouqPi6TZ0D3H1JH6KWb-xvBrw7Mbjl-F_rNAcaBLLUuT3s9LtCTLtoqArJAUQeMKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GVeGO5Y2Heek4D9D3p6AQTsmenRPm8z-6bqJhX7QAwA&oe=69DBAC47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMNEKIkkW2kQ7kNvwHvSs7l&_nc_oc=Adroa_mWBVhANy8B6us-hZjuA5BnYpCwd5aj3YXtIID_Iv-FzYHRJdQPK58AsBKZLbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vMCpMQZJqnDqHiBY9ncBt7HXpXhLxDy0Px8meEB3Hmw&oe=69DB8E43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxBM61sNsO4Q7kNvwFM_WSf&_nc_oc=AdqO7VQdRZb_NDJS8e9jbv04cd8WU_GwnKlUp1p1xTYkkFbseOVj9-pxzG
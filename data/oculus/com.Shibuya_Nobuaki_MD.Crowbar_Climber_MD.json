64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hdw3b76nL6AQ7kNvwGEvKcb&_nc_oc=AdoVjMCe4zWA_yKFgEWUzVBmAK88pSeyhJ6GenZMkhBkd1hmihPk8SI_WqNOfIVeAKw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKuzYESYf6nszTcymNAwgdj79SDELBW-kQ4W8bdg2lQw&oe=6A53A640"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iX31JD7v9YQ7kNvwFxFfni&_nc_oc=Adray0EJHXSlMkEadMEtpFY0V1UmhFJLBkGbzokUR--fuc70OiAaScw5Kq0Bo5lnJpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTwvV-_RAmh_stlZN5CEYdMIpYjTGTvY3krxIh6dI2pA&oe=6A539FE4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7CrFugHVCEQ7kNvwG4fOYZ&_nc_oc=AdrVzBXHC34JLZ_NxPyJvIJ2jEVK_4shhH-JpFtr011NZi31DsdcS2aL4zityNcbe4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrvtlKwd9GbEvQaR7Y-X1y_BdSdPucHruWI_YJ2mtIaw&oe=6A537C89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1v88c5kwz8Q7kNvwFGhVEp&_nc_oc=Adoua6VieQSS6vKgtAzuKACVtTL29Ub_kX4ZRyb45f_7tqagBwFOpgR68qTRIVY67hE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAioxzyUQ__EKPoopQEqSGu2qhXGPtMx_6idfJfPwAxIA&oe=6A53A23D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoOQOiYdWwgQ7kNvwEeP4Ly&_nc_oc=Ado-UE-RT3iIrrLix-V7ZeY8VxxfQVNAl9HY4ssbK1FK9nlcs7kgJgKeLxQoEshAva8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhi_D7apmMCQwsbVL94xU7Ku3xT-YSms9Vvc_Dqph3hg&oe=6A538462"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
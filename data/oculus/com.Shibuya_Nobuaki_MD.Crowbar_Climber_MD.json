ife0mlDnY9XkfSsJTQQRRkcKgK9nAchk6ZfBR8AGqq1SnJ3ql1_z8-X4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CdrVbr8BQ29X8TYaQFtr_yQTCYZWEhsSKg38ZoRhXjQ&oe=69D3A466"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YYUb5CwViEQ7kNvwET8Od4&_nc_oc=AdpQT05Qmmi0vuNdPB6Z_0-RX_M06cP9lKJa2pSJ1R4zUikMGLtMZ4n13dNNr_-xr84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cjkbqSArEnxI_ZOimE28BhN5FlMLPWgzZlA_y_XYT_Q&oe=69D39DF9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JZDpHr7OJUQ7kNvwGbol0K&_nc_oc=AdoTg4AB6oBCSjP1JigYyiJAU1JqQrxNFHECVelxiK6tIKSX8Sq67aWAsWFfLjTOqsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kpu3UOIQ7-tH5lnxPMgIC0_rCaSVgQ-MTPRafq_LcaA&oe=69D3C863"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uohd_tgfl0EQ7kNvwEN2Pf_&_nc_oc=Ado1GLmJm9g-Kuqb_MrOrkp2iRA_XNlVMoi3HE-2mRAPKLWOmCuy-jgwZDRFqnWVjOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hedR53NIvTeBKwn1MYa0LZyPKIfKW2-juNXFwksJW2A&oe=69D3C4C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CEL7l7MGMQ7kNvwExtQAh&_nc_oc=AdozUELBP5Gaakt6RYuydPu-fxORow-kwzcWB6EIZjg0mBmdsrv_jqFHlLlX75Q1k88&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qd-JvQ0hyccDKeYuSPvCyBV-Q_g5TOVRmwWHXbAz1CQ&oe=69D3B6B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdP7730ERzwQ7kNvwFwLIe2&_nc_oc=AdqTVCs40sU6g2-Z5debGVExu5mKa_qx4DJxta-ntu-dlPT5ZvFI9lTKzVEkC7x7srw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pI51ucsE0XGpXScKFmBEyXP3nRL2EzXd4Kzc82hsULw&oe=69D3A47C"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il-_DwG6PzYQ7kNvwEv7d2V&_nc_oc=Adql0Aily-UQxZk3nHCiYPTNU5BxuBbDhxZ-Ybr72cojcWgwO5L0EI60LhvugjvJehE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uLhnLRi3N5Efs1SJ1Q7e6I9cRO64HIid9B3OrNFd6Rg&oe=69D3A0CE"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=657lSSgbWJoQ7kNvwEani4X&_nc_oc=Adqj74wyb20Sex-mywuWxWmxKQuN0cnEv1QPQL9K8vb9X1-rhiPWWGQQnpnniNUtEr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y3d1Ai11wl1sfbs49q6RvCi61Df-wiQZZWAkIuv-YKw&oe=69D3AE79"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb=1
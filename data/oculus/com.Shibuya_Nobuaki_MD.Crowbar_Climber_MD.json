om&_nc_ss=8&oh=00_AfwnMf9mk_iIxkqS-SqP7AX2r0ei8WTnxGBzucFx9TQgEg&oe=69BC0565"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX6oQJOUHyEQ7kNvwEAX7v-&_nc_oc=Adlk9EsZKhVCijK-JaI_fxWC6p0WhJRh4RruNSMVuj2s7VF1XfuAoMqyK05Th0wLErs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8ctMS8rC3Rv5aIW5GX8pvKRhwjdF97NvnY5GtP3Y2rA&oe=69BC0847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eFm6fOh59oQ7kNvwHEzl8W&_nc_oc=AdkBSZ2iEUxFdvHlOSojRcu1KNn5MGY5ZZk3POemQUpYphWb9iS_o1wRdg9Av9pckcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6nt40O9HamtsS8MI-BdCCyr63JC-_6-2B9WpAXHRo0A&oe=69BBEA43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_Gf_hl50tMQ7kNvwEMhYqe&_nc_oc=AdmNmy_F_R1vz8TuWLe2KuuZF5hdcdrgyeQx0nQ9eUJajhhYYQZKsNVK7LGhg9iS2y4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrAq9b4bY7kgNNCFXzqopj7ZfTdSDz5XH2Dd1bWShdCw&oe=69BBE8CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDMBLk1lj00Q7kNvwHbsJkd&_nc_oc=AdnB2RZ-0dV-pfuCxZW3HjXU1FQ11tIYmvnv9x7jKUmhgZgc5bfoseCiLRJPkZkmJEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxj1ORze8qAla-UImnADscoptQLMbgsv2aEfdO6qTJznA&oe=69BBFF4C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiVo3njBUOEQ7kNvwFQ36Kl&_nc_oc=AdmScV2EerAjZcs9PXR00p0ydFto9lTYsIkzdASmdwgiR3a9O5tQ1wqRQ6AWNoL7Qjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxETyajFKyywLhcPieCWKUqXZO6GDJLQf_alIJpF1oE_g&oe=69BBEC23"}, {"file_name": "\u30a2\u30a4\u30b3\u
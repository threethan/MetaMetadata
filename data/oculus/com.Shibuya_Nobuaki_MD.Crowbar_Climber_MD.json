_jnPKJ5Z1YPxU44g631ZufE2RS4JFwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHMZBc4VxS1QtpgRDBFFmPZy0g773jX-TVNKjpOWGchA&oe=69BE8C66"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYYUigYG6OwQ7kNvwE1-bht&_nc_oc=Adkd1zzRr4jHhXmzXFKOaanRQcPOkNBkK7pJEVKLGG7_8p7yjqBP6qEuBittMiEA_1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuUop92tb7qW1PbuLDJLl07bbHuKkCamjz_-Byns0YuQ&oe=69BE85F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOixu8BymdoQ7kNvwFYTOZH&_nc_oc=Adlu4Ue1HCBAPL_fJNrjRkRH0Hyy6vttc7NqUdpvVb8FBIy6n2QsvrrD5jsG92dvjF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNRW9mKWi1xFSlKnzfvUqxtHxwV5SQYpmiFbEBXwB7EA&oe=69BE7823"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu_LuFL9olQQ7kNvwHdN0Kf&_nc_oc=Adk7NsrOK3ahuiYKQZE51oMDzqOg-LleCwher1H9PhRZOc_aKQp6cTugxB_KdHOwe0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQKjX2olcB5tEhdu6BD8Hk71rW04DbCIetpH8HCakckg&oe=69BEACC0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Cvt0pwg0oQ7kNvwFSUwVQ&_nc_oc=AdntuTC0YYlRvOT3SJVT1odHVaVg0ptcXANnv8uOxPgBkk4I0dbg4x7Nx1lNxEr_e1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmSEZ0mvOI3KjVs7AAoHY2Zdq2QjDLR3s1x1Ga0gRUGw&oe=69BE9EB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n2gb4df1rgQ7kNvwFLhLEa&_nc_oc=Admn_gGRcV-7jzOLQ86yMlas3BEU7Vlfw-CJIvsueVUGu3Ig31foQT6DNtMq1J9P-QA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmfNsYfbZ-0Fe3G4MfSaA3tZcnu_lMlsNpEwYzWpJGSg&oe=69BE84A0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUSUAMF8_DcQ7kNvwEYdPUK&_nc_oc=AdmZLkq1TFLyG5NudGr6Dzjt5dpx85qpK-aLViUc-RJuvYlXLkYvxno5TnIlhUyx-6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-F0mPAOhfy5oVe-KIkX3v8uLEXL4R6um9zfqSgrGHVA&oe=69BE980A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu2K9I5rjXQQ7kNvwFlY4j_&_nc_oc=AdmIs-mVKYsXcm-N7C_1t6dQt1zUyxJ6itHSUqFK96mrW5IvbSoK6S5E3E1FD3F6lgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_ogsBmbkyIF-IfPpSGZpwBwYrNoyRJSVRVhcPCqti7w&oe=69BE9C88"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqdlvj2ij7MQ7kNvwHNciW4&_nc_oc=AdmH
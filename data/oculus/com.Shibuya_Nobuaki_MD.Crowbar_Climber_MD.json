KJDUensv9fIHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5Rxb9MQeOQvVTP8AXw5TC6u1WUrznJ0fXnPBZDj-52Q&oe=6A4BBD9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok7deaVudDQQ7kNvwHJRtk8&_nc_oc=AdpRw8mDiytPrUOA3lE9GavTC3M-7PSGVPzwIMtbuLfgPJTRj4bMbVWitS_3DYFf9Mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL5xvNs_uQDAUqB6oiBzeWFZIYInixXlh_cYk3z6pROw&oe=6A4BAF92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob1kn57QrIMQ7kNvwGa_NTd&_nc_oc=Adrcvh8v4YqxUhI9sZnrW3eznY9Xx7M-Si-zQxu0MTO-eq0VJkQDW5HcdMdIwSuRM_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB170R3CypfN1n92EEDxTLkikCnm6-VFAfkQcyo0Br_Vg&oe=6A4BB8E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-5JePZsrWYQ7kNvwGsAQ-l&_nc_oc=Adq3NTstqUJIkeipilD1g3fovsLvG5V10iHia-rSWfNcFlIuTnJvHtWuZWl5Qlxx3YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTwAHSA-3In7bkQGT1bO8I6sCF7Yr4g9sHqGQIhdCHKg&oe=6A4BBBC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_67yQ5gQTUQ7kNvwGEPC4J&_nc_oc=AdryBISgkh2viqjhZnXtYhbaPC100IN-i4YdBWT6tvcoegjFQVjc1XKMp-Qw9TFZxis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEQaVhQOa4uELVqisVIDP0_qPXSYqGmxxUWiqWmxAG8A&oe=6A4B9DC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgEzFhz9lDAQ7kNvwEO2Pa5&_nc_oc=AdqEmCYqWsJkHXZCQOAdxe0kNMbSAP0tQEyh0C0EOjyBkbL1UrHO-m46JL1OVbSycVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDMASO10YQ-EA-ptHJcFMhlNhbHsNiLhxyaJbmsP0L-w&oe=6A4B9C4F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type"
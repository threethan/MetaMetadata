=2_GsORDCcfYQ7kNvwEUxE_C&_nc_oc=Adr7Av-SdhSmMLl5XH9b2rvCCiC4u80woQfrRl_flTl-iXA_ptljwt9-8irOGbqGiOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlUC-bxwe_m43ncWC3cqH4iCjjjZqScWDyfuCydaobBw&oe=69CBD765"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPumge0usEQQ7kNvwGDYYQG&_nc_oc=AdrHsNOTV35BMjVjhCW9kvIIcklbyTATL3w6tvIXJ61D6r6FrFPSia_lrS3oryi07rU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGgA9YSXmAv5Hze-vTR7BRhAhPD325cBAtRBX2jNCXfA&oe=69CBDA47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaezGkZtiW8Q7kNvwHEJ8Zb&_nc_oc=AdqMm4Z1uAcEtwB67BxE7O0C5sNlF3ECwHB-52KSz63rmpTmRQ5KEIQUgnlFxijihrI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqdMY9BOYb7nkxqTWcvzCKQoRXQgz5Yfpi5A2A4zPvBQ&oe=69CBBC43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96FLXx31iFYQ7kNvwERQVWc&_nc_oc=AdqhxjrzeY8n4LPScISmJA6o_Ej1WT7_je8XYufVJQKfPJVc1cIE0-ewzmf8aSCs4U0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytBG7jP_7Fc8xsCxey3XdueL8QJbfDKwPlCE-gkiBWYw&oe=69CBBACF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvEoOWjcWKEQ7kNvwFHriDQ&_nc_oc=AdqAb3VPeDAr4fkEdhPyAfENZgDf2yNIE-SHFLOY-m3XNvc3cyAw34cDR3blpO8K5Ec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjIywVShgd0hy9GNzPUNu0l5P71uDvFiSla_f1mVxtog&oe=69CBD14C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIQupur5k74Q7kNvwE91ov0&_nc_oc=AdpQ6zMY0ibYeuFLAAA0xYjHhXvtha47JU1QuJXwwwba9tepzAkeDRXoD8YZcHH
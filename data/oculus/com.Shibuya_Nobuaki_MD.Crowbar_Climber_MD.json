v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqqkmIbM-eIQ7kNvwHAJspN&_nc_oc=Adp7mRau36D6a16WkWlRoGdEd00MsiQM3cqWWXtDgZp6bwUWRH-kk_D1eTcWomCzfCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vEWb9W8BfomOOcJZPajrYUi2CufkQD0YNQU30rGqRZQ&oe=6A1EDC92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNHNSPl5A_IQ7kNvwHIZTCL&_nc_oc=AdpZD5Xe0Faa8bnHRmViGYAxeZQ2BsnFpiYcqI3zRhaCSYQW9jlxWZveFZpa38Zl7tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af443on6XXfdJDd8NXa_EV6jc6sYzyiglIRoBT5ncc5UjQ&oe=6A1EE5E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnxzB0nWCBsQ7kNvwE54p8_&_nc_oc=AdoIOFaIzbTwhHsPv7meKDJp4iWQ-nFspDLNtwO6e2Ia9Z88hkrifFHQdjVM2fme5Ic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Q_oyWRNwpbFKD0zXpIl01xG2xlJWUWWcuqCMZn4hWw&oe=6A1EE8C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_mnZr2hTOoQ7kNvwGaGdIX&_nc_oc=AdqcSXhX7MBkifR6aE52iT2ncnHfQ03I8lmyWLv5-hyz1jkPKhs6JISqZx1FqVUjGJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wdAr69R1PMBjqGzqvhss1alLFEo4CqarwWMhMJOSkhw&oe=6A1ECAC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Scs0_I9OjoMQ7kNvwFPfL1_&_nc_oc=Adr5LqYBoQDuNqTdINWSjnHj8C_Hyu2kuFyvD6pA1LmnBGADf1gkJqHB8ypo9XZTw10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kxu4mhykkaJ0I6kfcJd2xHbGwli-TaPisFuBX3gZvNg&oe=6A1EC94F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaO5DqanZBwQ7kNvwEOqNBP&_nc_oc=Adol5L0EjGnvFMlvrVLo1MNDdfXODfHfZ_3gxt_
veZTX8Sw49TaHgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_JYorYmhbL3lOyP9kBCK5kISHc0YvG6TQI6eORYmMFw&oe=6A51039E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBBhmI_tAmgQ7kNvwHqexyD&_nc_oc=AdoqcfP2Aw6q81Tn-OfhW2p_SVL0B8d0lnrkd4e56lz7kyxfDimDYGZiX4ZlkhI5fJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfGDCAtdw4sXw_yj2cdeesEOSYQ1aSJQMrCFBOk3yEEg&oe=6A50F592"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qalX6Jq6rygQ7kNvwGIfubL&_nc_oc=AdpyFpyuuGoCsetbq_thjVjw6CtNV7wPKHO41BYgoce7wWjBAfUyXD3LQQFAx59TTj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzB_bV8lo0KQIL99yK7lwlfyWIoSXvBS_irz3DidtfLQ&oe=6A50FEE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNBr9AIchoQ7kNvwEhJYTK&_nc_oc=AdrDCxUH24TmtqLhMxPyNd6f1mNQUVfcHqWSa3IcamT34wHIHhYSkHfTe2gIBa7cIaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGUN8vgzSA051CcXYa4Ot7Upt3dndNgk8JMtf2yjo_Lw&oe=6A5101C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcLpPyApA0IQ7kNvwFoVH8R&_nc_oc=AdoM2JCVEtKEMTbgIDl_s-wWXJhKELw1-vhD6C3ZVJUwjBpnXjFiZhL9q0wggtruQO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhQkGZK1oSPrFuOWNbqTB-UZ5cBHTjOfJQT-mGXciJqg&oe=6A50E3C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vf5DFun8FgQ7kNvwGIPjOE&_nc_oc=AdqlP4xeBSJHOXTL_FWHL8fJiDdnni6RSmZaS-oJ4u5Fgs0tMnVsuOSiVemh1o40GiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0OiI43sPVAGBNVPfXDZulE2gXMtpgqzydVGMgdW9pMw&oe=6A50E24F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
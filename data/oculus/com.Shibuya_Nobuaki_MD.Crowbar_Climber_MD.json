KR_4itH5gX9gwwhx1vvNFfcPheVTTvLTBM5f6enPp1l5YskWFjcF5vI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpRDbNutlrCsWGmoSLcv2CaNfO4wKLwhyMsQ6wNHEi_Q&oe=69C523E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzkQ-_WNHAsQ7kNvwGQN-09&_nc_oc=AdoTMTJom3cdEo0mI2AD3C1ew30tqrMa7485lX38iq8B0J2OKnDYTkqAwr1jLPtAlmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1x2u_2tq9quXExCoj2Cw-ECy9FYOrzzrTJN8jzi87sw&oe=69C51D79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdCo9-lAr-QQ7kNvwHccuFF&_nc_oc=AdoIFS0e891XG20f6UktrxCp3Z1Hg4q9Zal26krrtCMlXnbPtkq9tTE-kz02l0AqH1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxczmV3ZWWs6WhBzFP1aVP5xUjJmJtxzQPhIY96Bw1cow&oe=69C547E3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP4wMlzPhOUQ7kNvwHCxxVY&_nc_oc=AdpTMfTTOnPId8CTJ4xUy0xWM8dlg2qCg-6SOzeBwu7UsOII63VJUEBpNOe1mvf5mWo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC3Z-u-FaIJinvzdTGor0HwJzAViS-kGraH0neRgrSoA&oe=69C54440"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OseD3oZvKM8Q7kNvwH6UHZX&_nc_oc=AdrPW639bdeh2ARgzIfjtKjCpcPdUWLs2WeSPhieeGZAymTRZfOVU3YD9QAC9yoqfdk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrx-FzZHjr687leBuG764n0zTrTZtxGVvN0XyyzxsHhA&oe=69C53636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6nuYgSX0y4Q7kNvwHcMNjz&_nc_oc=AdpEBSKgXnUBbBbBZFmsbIQaz9e9fSuq_FXGJtM0F76eWNCWaceo-kjosY1FbjCD_qw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDGh65BpRj0b3wcRuw6POj77EjVGNYrDZXgSpU61WoMw&oe=69C51C20"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg2PXePSQLgQ7kNvwE0stRy&_nc_oc=Adq5lE9I73sePVNTmZE1iLPWIE6gCyWbU9ZRbL8LhDN0SN415_YfLReATqxtKeq-Ne0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkyiIr-JbdNSFBCJ96MIT4f4XUUF7Aevbr4xyErWKJ9g&oe=69C52F8A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x591YY_gE4Q7kNvwHCrs90&_nc_oc=AdqCeZ1PnL0bIL-K8XdNRIKkhB-HwagmTLCPleoMt-AvmR_TmQe1i9S-r0GVb9TKHRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5lmOnlyl2CPftm_ewMEMagor8wQmS1K6v-JOiRr17dg&oe=69C53408"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_n
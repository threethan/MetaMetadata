ent-ord5-1.oculuscdn.com&oh=00_AftTMVKcA7Sscfq8r3W_Zuvs-Z-rFtEdCU6TfWutpATMGQ&oe=699AF3E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw1yktR-k8UQ7kNvwHiDSVX&_nc_oc=Adl80li563ZV6DZfyX_VXy89liagoGKCYBAZRFWkLVJMyrm2AgdwIt5QQULD1mpZ4GI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskT0EHPdqEETutO2zIhk7TNuam_MMPyDQi1EUxqzpCRg&oe=699AED79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxMaTRvUAcsQ7kNvwE3ZAz2&_nc_oc=Adlyu_2pBiV6AzKDeX8mrW06Pquqve0O_zG_NmZjcPhc99nk1s4mvdQcMSIzSmeqPMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsB65mC45t9NwDIqzi28LGQcK8N8XF0d71iIKWd7q_8PQ&oe=699ADFA3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FntCTPOvQQ7kNvwGi5ZNK&_nc_oc=AdlqmczuFZXi7cLzKPEtaALMBv9NnXy76zyNHrIV9UBbHHZs31Til1goU4sk27845MQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftM37DACB7fmv39GSAFMT8jG8NiiUKZ_AfwSDaO5gx2xg&oe=699B1440"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRlETLDJXcoQ7kNvwG_rtiV&_nc_oc=AdnZhzbB9NHHxrfcwKeu1JJYmiIX-zXbYhxEI5Q82hk_O3PzbgCbgoHkTDHdJyLUUZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftO1rpElW-z6-07Pet4esuLkr0iMomWVUiU8jLa6ZjXUQ&oe=699B0636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4AxjhkG6GQQ7kNvwFzA7r7&_nc_oc=AdnZCNiJrKoOgR5POIXI9sUak7gB-iPrdmHf_cct9cptSnXF2--PfIYvZuM78nPY3XQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afur9yWB5YSi269CyCg_fGDsbQnixhbYbYpoPRUvSclotQ&oe=699B0BA9"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP2hKZjQjx0Q7kNvwFDKtq3&_nc_oc=AdlWtlEwcDT9mb54dU7jr0roSf83ItiQJNM_2OOvqcIDbL0yx9ZSg5sS-YAOLAIWWnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afun13lBlLJ_-PdBy4gV7lcF7Jbudv2aXQOZtlWtcXMniQ&oe=699AECC3"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6yS8vkDMSQQ7kNvwHtnEAL&_nc_oc=AdkdSdmjuqOppYOcpxbP8IsVYs_C_KhkXBSV0_w6_GRjuSg9liWZ0wbLtK5Gzd45VPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuOky6yQmn5-oG97mSF9vWytaRPd9dUqkpIsdjmSx7USQ&oe=699B0CE2"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEU8POB8A0Q7kNvwFZtz9b&_nc_oc=Admf1MOxS2my1bveq-9Oig9ACYHNxQ-4VxgSu0sg_IN6jDtDaje_xOtAcqs8LOcXwFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvq0l-mtYESqpQucPBomFHBZDHY6jUFfQLkdLAqd_FMHw&oe=699AF96E"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_12
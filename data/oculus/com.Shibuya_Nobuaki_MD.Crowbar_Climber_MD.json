F6MGyJRp9-cPK-LNOYh2ddvShT_bR_u8zfjeREvcyOSblXjkyD9tXKSkCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Yx0OOBVLXfHKHiYYgso9Wk9QTjgQf-WeOaUDorTCqBw&oe=69D252E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YYUb5CwViEQ7kNvwFJToHO&_nc_oc=Ado87JW6QCxvNCrUxQovM2hbbQMNYPWNEpxKpR9emi42jlaEnQuWxOFHv0CMSiAISAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rlipnpnPZUi00WOYH-1DRjMJQZNYLjeC5yHX7xqq9Ig&oe=69D24C79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JZDpHr7OJUQ7kNvwFk6Z9E&_nc_oc=Adp4xQz8setYbr-KAyGIeu2CTUZT08K8EpPL53b9-XPzRDw9vB-JaOuh-eeXRmjJawg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CdDWQwR_W_oRuFUXcTYPWUgoZ5d4Qin3xV5RZrnd_YQ&oe=69D276E3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uohd_tgfl0EQ7kNvwEHZ_o0&_nc_oc=Adq-ECiQDD8AEy8xSjz3jJEWvIyKPiwWXbHE4wTbpaV4MoPMRjZW6qkR-oGzidMjP5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MYlk9I__bZMhivuoCgEdqFir-vOzHx8o3Ty_db_iH6Q&oe=69D27340"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqmmwNJ-O-EQ7kNvwFlnywI&_nc_oc=AdqvrEANm8LxoN-wkN4dXc9oZAdgOjzGGAxAckQ0RpBvzWpPWLt-zPZto_42bMilJr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TE_Agtuxe1WpmiuTmw-7pS8d3Qv_TzPT0duI_A89oUw&oe=69D26536"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdP7730ERzwQ7kNvwFzuaYE&_nc_oc=Adq7uHz-K5rn460GoxJ9sZadCuHTnd66U_I9Krm9GJ3K7RzBCrVfyfEK7cEWaNLGDjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OdJHoWraB_elmU8kxW5IWcdUCl5FMmNS0RO52WcFe0Q&oe=69D252FC"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F44tiA09LNMQ7kNvwHFT7wP&_nc_oc=AdoFR9YcfORFotCZoaetdMxfCZbvE3JMy2G--_o8LSmgciUcg_BFpjrKLbDAxfgo5R0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m6zy94vkpD_jlrL6VdRNK1FOKO_3N4eig8LLIfH3V9A&oe=69D24F4E"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=657lSSgbWJoQ7kNvwFZbFkJ&_nc_oc=AdqiUGnPBLCirDBAN5Ar05-45KUotGrcRA_D656jsqC31aBqWCC7SOUdEgrJNnBrPGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05uk_OxFTowJJSGcNCTCF81QZpe9mpDw1e6n44dg3MSA&oe=69D25CF9"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb
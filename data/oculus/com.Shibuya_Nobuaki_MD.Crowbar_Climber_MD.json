7M0KWhOgCDlmC5zU3mCJKIStLpSijj1_WwYY9tI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIJhMr5j7MPxXWxeVfDOl3_VVreGoKzNDRVZDP2o2NIw&oe=6ADF63C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBFsMzStmfUQ7kNvwHERjuD&_nc_oc=AdqWre_g_lXU7BHLiX3XSLUywtLAQsakJULFK4TzF_bC_cB-qqlpW_M3kvOYCPElR7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWAzpHrTKL_Oey330nqMxfeZYGstUR0nJs0FW_9mCbIQ&oe=6ADF45C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7G3lPa2nYQQ7kNvwHMm3Qy&_nc_oc=Adr81sd2Sx5AStmW9RLkWo3do0wk88j96D-m3_RzTrBS62mwSZEZEHtQM9bDes7o7mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpjomsKzLrE6xTb5Iu8Bxib11fbmidpHOpZYLWoOu6_w&oe=6ADF444F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9LEgyYBH1UQ7kNvwFZjgJY&_nc_oc=AdoYiMs5B5MdI-blXHlZiazb3ET8Xzaz5Tfk-oMvwIJIIKnP_tUFMWSkcEhQhj9YW18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNknqbSQyzw13gJEv1MYuBXNxRN4nDRtmBz8YmIpRMwmw&oe=6ADF5ACC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrCG3suhyRoQ7kNvwH39dxT&_nc_oc=AdoRoyXQH2-4sM4a7LP2RggIK6qQcj3FSzavBmRnX4dZnz1gyxBpWNZDdYpnKjibYpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0YFRfZ_Tp8Ip1GuEZ3PES61ljAikkzgym5jf1l56h7g&oe=6ADF47A3"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "908659141179566", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035372_908659144512899_8652328318294046392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyBwTD5-Pk0Q7kNvwEg4n38&_nc_oc=AdrhVcI0dNi3Phf8GdjWQrTa3LkCpyQVwAjasLCCknQgFApIb92x6mPZO3kFOIO6i34&_nc_zt=
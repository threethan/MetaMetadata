d5-3.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlEHs4teuawQ7kNvwEgVK5S&_nc_oc=AdkZxu0qN1DBgrrWJE4NRQuXh1y0MfuHUGO2bpvINOQC_vBibLCapnPk0zpx5M0g3Uw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-XqqgvLtWiWeA6kVlz1N-bbrc5HRE8dvKEbCffbHUyA&oe=69B7DD5E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnKc-HqtmBwQ7kNvwHLp9im&_nc_oc=AdlI5MJ3mpZYt5hTVjfLk0bphXFWj5UUaS6p5yZOCO1I92ykI17V0vzo43598PvAz0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMs7WHHZSmGD2JojnVqeBUZhHKacC4w_5T1ByUQZ7AMw&oe=69B80792"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7ZCqFZoNEEQ7kNvwGNleFG&_nc_oc=AdlpCbPeH64oTC9ppb3hgjTX7FARwXPVHJOVfnMFXvhlVnm4EgzNBgWHw2SD1HLXOU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfylSMlBkIk9AvCEjOFrvcxGM3XB1fafooBaKpIHIeW8dQ&oe=69B810E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ9peZEdRacQ7kNvwFWEST0&_nc_oc=AdldxcfwzPLoYsR1EFRYRc3F_YAbJ7w9dyr2PCsuYFsrZYjGgwTnlZ66xiW7qzaB-bE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgG-_ePo_SxEn-UsYxfpIs8GovjOgaPR7bJrN97DoRiA&oe=69B813C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00YP9dL5G_8Q7kNvwEqFTFs&_nc_oc=AdmZeC8EX9PfrQeTjgbXkuBnu2m6nSufrdvHbP58M250FnbL5LZNSxHOMi2zEOzvuZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzn4hFYu3o-217apS3cL_jKJc4rMK9X2FBVKU4al-a6GA&oe=69B7F5C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSkjG4dt4QUQ7kNvwF9aIEx&_nc_oc=Adk5LVFG6R3vcjOKVZPy7rMeijvBT4KlnJlxkBACURPxYFfyJ6t2v1_iHTeNx8heK5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_
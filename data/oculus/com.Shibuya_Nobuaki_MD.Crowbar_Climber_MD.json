com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mJKlTezGfQQ7kNvwEIO2FU&_nc_oc=AdoGlgWctKLWMAIJ7zwEHufU-D3gkDTfUVj2dUtfXhywCrJ7jNXhX2eEzags4aB6fKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68xN_ctzSrIJxv-vKoabdqoz9SwbrAmaE93VbScFWa0w&oe=6A0DB912"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEfy3_thD88Q7kNvwHmf9UO&_nc_oc=AdqptnhFuphqRUZmddqpPraDOabSwSSMXUA7Kv85iXIeZTw8LyDAHINvuFch7hswmT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pkh5qmhcjTcMItsrIdhXY8_i_7WGvvt8ciBWYRZ2s7w&oe=6A0DC265"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgj1NoGU4qAQ7kNvwFrziV6&_nc_oc=AdrhOX7HR5liLZiJLdk25Y3aXNdHx1EvEbaYWrS7kCeB5MHfAlAMRAIYbykuQwlyjfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ocNuRZQ4BbgNrZqiScR_fiEW2NfMdSYtqvb5g0sacZw&oe=6A0DC547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_HsMAiEQREQ7kNvwH0n2ho&_nc_oc=Adpw9hMFperCnVjagWZuo8vdZKmJDgq8fnlV3Dco64yQXYMyPOH8pVBYmmN9piQ6IAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JLM6sUs5FWZJDhXcZivEXWnv6njkXyOetKR-keI5yiw&oe=6A0DA743"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUVNwIH7bUwQ7kNvwE_65mt&_nc_oc=Adr7IqTUzjw3RRzOtec_YcHJtZyLfdNxhZQnuny_JH9qi7X8dEMbP2mG0K6zDecWCsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rNw31SMCEM0_hEpMEudbXRoeda71HxKRQVFK-k81vFQ&oe=6A0DA5CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-yJHg70QOIQ7kNvwG0UWtV&_nc_oc=Ado4-FKVy1UB9pRy8jqLVjcuIX1q4oqUpCj
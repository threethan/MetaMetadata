sORDCcfYQ7kNvwHgij0c&_nc_oc=AdohuO1R8mlGPRVm6lQNB_386PltK7jyaKaNF0P9NtF-ulqgXeS6NjhgyYABUU1eLmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlBCX_c0gJjH1Q1cqD_HIcOu3dJB0f-rBgKAQZwgBy1A&oe=69C93465"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPumge0usEQQ7kNvwEz0F_4&_nc_oc=Adqgh4pkak-v3QtA2JTLFoFyJO9lp-YYYaOp550ttwYdHAyePIKL1hMWPgjXjYsI_9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYTZpsJuyqF1TyzV_E9CKe_TtaA0lBjBXCSI9WfLk8Nw&oe=69C93747"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaezGkZtiW8Q7kNvwEFCxti&_nc_oc=AdpldS9AO8s6fNt5y-9kF1qL7bvDm_PBhtYax_k29et06BD5J9mqsCQ4GvRjCAVtd7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysROcte0q6Arb46ZLrL2lLJ9f57xNi0OQbBOKF2N2ZQQ&oe=69C91943"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD_C-6gsjhMQ7kNvwGwKKoX&_nc_oc=Adr3RaZOj_6bROFhq06AnFM46Tp6pky8iv75YmfeqHOylsWttArhVsm2fVT0Brp0zUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz72iE50V5jg2sGLBhv9h_T05PVKm1mv_cZq0o02NAvcA&oe=69C917CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvEoOWjcWKEQ7kNvwF3ssYp&_nc_oc=AdoQ6NB5Rv1LTEwd84LxJ-UM5cP0HsPAUoiQ3WdexLLG7Lye-BlxMKMSKP3FdL8LHNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPDgjbfR5DuS6Oay_pyYcrCROyjBDII9CkQKopi82RNQ&oe=69C92E4C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2aeOclPZcYQ7kNvwHsHjde&_nc_oc=AdrArL5GLkAX28KFPWE_emBkUWD4UCK-xrYxCkxuT3-jrQsAJKteQhaXmlcSAExxfXQ
=2_GsORDCcfYQ7kNvwEwdx_5&_nc_oc=Adqq99ou3fBhS2hJu0-VrgzjdvL4KepVlCHopcDtSUU7WH6UewJnUHFr8BynIfkOPaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqRsVPUTWeXflVpyFmcw6NNd77S-hmbei_1zy3URIjTA&oe=69CA85E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPumge0usEQQ7kNvwG3Dbzo&_nc_oc=AdoWAEqTYgzgRfySyufRwltqTvAk6Aws1TWqkrcktQYci2ahyvLJ2ArBqQruK2LcSaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0tYjq5iv2U4acWUdFWMdoJcTAw9tZnSj2EwTsL_atqw&oe=69CA88C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaezGkZtiW8Q7kNvwEWDl5q&_nc_oc=AdqugmC-_UXy92r7BGo5wybJmqjxaItMZgo1DyWuWMLvqFRGoX7R9dWWtMEOdr35IwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2yxl5u9b0UWGF4Ax3qFiDHKil6hnHmOVV6pINeU8FeQ&oe=69CA6AC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96FLXx31iFYQ7kNvwFY0h6L&_nc_oc=Adr5fcvJ8if4io_K5nGAUyd8MCgrRMRo2d9q85bCgZiWFxIWQDvowVwHTI7ICgUY2bI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzxcky9b5Su4UBsrhLrmRYFQCO8FZJmRcFJTB841bfXJg&oe=69CA694F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvEoOWjcWKEQ7kNvwG0hztS&_nc_oc=Adom2pDC3DxxOCmlr7Bu33Vn5fmaDp4h-NGA4oMrOgwidJyB0ldijxi5BZ0u_YOtOrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9YzIynU8sR9CRFok7TQwJkoPOp2Y6LL-6YrCXmmg9Pg&oe=69CA7FCC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIQupur5k74Q7kNvwFWNbvI&_nc_oc=Adp5fq1rZow8Zls7lHRYQyhyx50KdcrRsah1BesWuK1dubhZI-HyH-8GGEZ79Mc
ent-hkg4-1.oculuscdn.com&oh=00_Afu8HyT2LM9ACDKWnyYreP2r57XFDjmW4O0QltHTeTfwdQ&oe=69A18B66"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up1Vz4jcClkQ7kNvwFxJj5m&_nc_oc=AdmzcdFXs7plOgWMbVL25Sw-2fh0zVeMVfFv9S_hd16oN6_ynDkVHuFipmBKWvjeEus&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvhwdE1YcvENK_omJik2TCQYl657HlT1t5GmJWLEXa2Lw&oe=69A184F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUq_W5-nmgkQ7kNvwGv11dt&_nc_oc=AdnWdeSkgOpa0mQOq_xnB99c4poTpLFn7nP8oeTfECfq006mawmfiegpDgQWK_xuBCE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftgLyKgiRyDTTTQkrQrFqhm1z-5iTs0INgANYVeiR1_5A&oe=69A17723"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWba5SckaCoQ7kNvwHV8bbb&_nc_oc=AdlFEYrTHME7eGE3OPfJDWxCFVUnfsQBFP7wTJr44E9NgHIZspci86cNDlpVS2Igzl0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfunFen2I0_BQ9k3FZ4_YZfqG3b2G4tKztOSmlx3GOguMw&oe=69A1ABC0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNJQlzPO_rwQ7kNvwEPgXY4&_nc_oc=AdkniGrFND88Qck9hp7cfqE1ciiglXZDNyEdt5t999DjWiHkE_267v1GzlOwl9HTr_w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft_2MWDL_-L03N2nHpzPYYlvqJ1uICWOGgBTBnOIC02tg&oe=69A19DB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uxp_VDCYwQ7kNvwECuKrY&_nc_oc=AdnCUTDuDS5QC5sc4K5vfEqWyZPgV7v9eMDBdf8Mo5KfAwxeFmNZq4SozVJogY3RGpw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuovPZde62vLciw0z59fQyY2X37s0hOUc8vUJ8sGL_R-g&oe=69A1A329"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcBF1lgN0p0Q7kNvwGIVx1N&_nc_oc=AdntAt7qbqyykg1D7wkksOMVpPiJtYg9MLWs443XL81rlwOBZVW2xWyIAXD9r4V70YQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuE7nWDe6Mz_9LHc3Trbd05pLWLoZ7H2kZ7zUW92qMBPw&oe=69A18443"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNp2cH6RuIwQ7kNvwEiWcsf&_nc_oc=AdmH1CoFUkABcwHx4-wAyEX27Bc7E8e8ot7ku_BVV_6S6A5qYumljgggHq85rQZdD2c&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsglH4b-QFAA3MZHQvZz9Hxk66ftE4oMsXmv5hewGtTmQ&oe=69A1A462"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRzwD-_qy14Q7kNvwEbMptv&_nc_oc=AdmYb1HPwSKAocZsaSPLoYjpqfC_ckDrB8-TQdMV0UhcHsc41I9TyX-roxr8dZvIGe8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvvoyOLAgHpBlmotO2VLbNLWXNbfpVXNkwqrJt_tCZnRg&oe=69A190EE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618440_12
l_I4rNK9Y_Jkb-gWSqzHo4y9Uchs56zmbFbw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4nEAgUgn6yLz9NbXW887Lp-7geLnGbGMhKjn7Q2lykQ&oe=6AD38647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFyRVSKtO-AQ7kNvwGHpThs&_nc_oc=AdrH4NcLL-yFy9A1PFcSyKCJlUW5ieBlcENoN3xNJCa8m0GIsJsG5EJh4WSaG4uVFjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNros9qIJbU01OuiWbM1ryVUK_Rv-UMsQtanbiEsGCXQA&oe=6AD3A083"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if4WPhsACf0Q7kNvwG3OWG1&_nc_oc=AdpzRAQta4ZPWk9E-6ZG9KVE3UIkm3GeSKgYcjYDhDIPdc-AMoMKIp9W0dMLkmWB2Mw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzs40pu9cCCgZUXCmm3MWqlmCmPJx9lxmVNx6lbKiahA&oe=6AD39F0F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PuIndXUcGQQ7kNvwFGCKMr&_nc_oc=AdqtRcSngfsE5jCqTOdvNtnKA-ehwiNEp4MHcg9UGSTee5d59MqZ2BwZKUxjWEd66-0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3wdw6UP8blCZ1Swto4OMbdQ8gErvep0TzxknnJQJn3g&oe=6AD3B58C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYDtPdAuytQQ7kNvwGH1ozc&_nc_oc=AdoFcNNdmE6ntcV8n3q5iN_4zlqkgXkQjQMpgStOM6JuCkpOhKFWvy7nYpljsGgSrYc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSzOgXRd_maqDoaD5z4q1lQYUoF0o8frq_jJUJeJHd8g&oe=6AD3A263"}, {"file_name": "\u30a2\u30a4\u30b3\u30f3_512\u00d7512px.png", "id": "908659141179566", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035372_908659144512899_8652328318294046392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_hcR7U2XAcQ7kNvwFvvtoz&_nc_oc=AdrlzHA7sc0Vq4NRXOYeBArEl7enCIhuBeoIW0_IAWKkT0KD_Dj-5M1gXPTISPS3sq0&_nc_zt=3&_
3&_nc_oc=Adrgo3eDMcNEkLan9M5OZp4pjngMhHgXnZiWNFDO8zA6alzTwWIOtxfOf7hAD8jCizM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9851inA-RPaZobD3tLWBQBUCn9l96x-HWWuPO5q-I5hw&oe=6A3553C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWktnZijTfQQ7kNvwGIN6Q5&_nc_oc=AdpmEUui4MdztGX8yea3zjPWWOV1SGAFpgyyT98nEd_RC08ISq_gaLsxHqmrBgR8rR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nPwV6Oc2uGg5Rf5_JD0OdyHp8KLFOaZcHT55CC9zd4g&oe=6A354D64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W87KtwGJ-8EQ7kNvwHNfty8&_nc_oc=Adp9plKx4qXWEgP_yCvfN1i8fCIGQc8eTqjDDQ3p-RQlwd--QsxaHDR1B4E5LCp6XaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pyaS1dXJ3N17b402hAn2R1hewwbFM9fEjcpDAL6rXkQ&oe=6A356249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Ub2AZtwk4Q7kNvwHveXY8&_nc_oc=AdoAjoxXnWVLIRySIWuDDPQNN6iyUYshP8fwIH0RKOs_O07kEgZPFIQu5l6jMRCzd2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QvRmSZQpgueOTihGzZAcSW3-06stWtGLpUUbvUHcJcQ&oe=6A354FBD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1np74I_16kQ7kNvwGxYUno&_nc_oc=AdoRAAjrJ9F1tuFq__-O8j79AOPPAgz1nLMWXBpkySjjwB6a5gSltBfgr-DJ9M1TDxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nXKzWDIWQogLd0AgBx4hQRCuzCc20nsjdUDqzS09ehQ&oe=6A356A22"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623601_2042896823278392_2811420873830425964_n.png?_n
4xgZhkeuopm0dJf8O4wGTll1KP4g5s3PimmhytZC9B8eoPhMCqCBzIU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRxeg3E-bhiYXiF91vu50GxqschlcnLJFe3BPzOBkmEA&oe=69C3D266"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DufzV9dEeX0Q7kNvwFDe3I0&_nc_oc=Adq3HCraBGKmafO_ug5DZikbTIboAZc6DMn33GV1cf9kuC2sQWBTTcp7lqun1U9yoRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf2_U6vvL7fQ1UKje854Tgl2WO5InCfXl75gkXgL77uA&oe=69C3CBF9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGskwiO-BjAQ7kNvwHXBDms&_nc_oc=AdoByghHssfdGQnAVUsfe_JtTsjrKGWt1zlejNOqnTCLXgC004KRTThk6acid_ytNbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0fHgO5REJWe3wc5YNP2ElYl7rcQ8QVrKEA4gnuAIxwA&oe=69C3BE23"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMRyMuWKNE8Q7kNvwFOLggk&_nc_oc=AdoahfF0Xc9T1veavwY4lY6xtdmOJxp4XHhjGKEAyiDjDkcKeRYTYf-ihx2nreDbnik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLnXCPLfKcqyKEpMMsGqQ0vF6iLpOInyFAX5qLMU5ADQ&oe=69C3F2C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OseD3oZvKM8Q7kNvwFg9ejW&_nc_oc=AdrESS6dZ8O_pKI1Owe4BmjLFhipvKAwYJ1ufZAOiD9DLuNGa-Y-FA0UY2I97XcVue8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiVoz0XgyAFz0SlPBFCokV6oIsnpLIPsJ2SCPovbK01w&oe=69C3E4B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL7FcVEZVLEQ7kNvwFvC8Jq&_nc_oc=Adrh4LV6gWS1zPvoxid5pz6HMxG4bU2VZTBiEerHLKUW_PV5hMYP5kWH24SXw46J6Ws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh7pz6BimoL7uosZbG0N_IHgynzU3VdoWnYEB9vSgdyw&oe=69C3CAA0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg2PXePSQLgQ7kNvwGGS3pp&_nc_oc=AdoyeLgCtB2oaGOZmtToRmcetmxTJqzlWgGLwGBpZuOe_rCWQe8zYE6OKQx0rFqrx24&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo12OyFR51KCHr_gwcRbOTdMLs07pj8o5l1loUlwZ6RQ&oe=69C3DE0A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x591YY_gE4Q7kNvwHdLVFG&_nc_oc=Adr1ZyACFEyh6hMHGDf8HemO3nITrzbs_q_E7ef1UiZy5V1P_bKA1egNig90Ik2Yomk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9L7kVV7BhNbmcFBaBXNzAincIkg1g_WOrz14rbsj7tw&oe=69C3E288"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_n
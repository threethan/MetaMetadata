64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79kEfURQx0Q7kNvwF5sSBY&_nc_oc=AdpmH6M7PpRkD4XziLUW31kgvA3eHJ6gcbqbs-FhhCXyQv99hWiCgcYAYA4V2E06jP8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jMYRqlkSfvbp7q56k8GQH9EUStD4pq9nC7UCT443l5Q&oe=6A3D3CC0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol9o5yt5dFEQ7kNvwHyJ5Y4&_nc_oc=AdpvL6ahQ_FgTfQpywnbAbL9yFYLnf9hUlWb0cMovWZiRN6XbW7_UVll5qXkepnUzrs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RvIGn23PoN3QTrru9RleD2yO0HMQCxcSX-dYmvWpDaw&oe=6A3D3664"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja2QvY9Ztw4Q7kNvwH9NVPd&_nc_oc=AdphiG-XSA1DU4FntWE3f2bRIo40X5KoX6njRDFeGZ6rzPTwQkdfaR3D1bpcLO0K2bA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EhQySPgBIcozHu2q4nMtVm1bGetmvXNzjVJQd1ndoRw&oe=6A3D4B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2lgL_B1xTYQ7kNvwFzeyHR&_nc_oc=AdpW7NG2ctmQRDMOnloSZd5qM2gu5PZeLC5h21aB6JgCW8Q1cgexsV4AcYg74Wo1oxo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tfPHmvIFTM2Chfujo5u5XdAhjSX62PzoutZBOU8jnIA&oe=6A3D38BD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vWsPQ5E9RsQ7kNvwGD6MXY&_nc_oc=Adqb0ysQTYejEJhIKEm6B2VFKd2IchY6SaK5MGFCUDR25x_87Bm1e1g8xUgZS0J1rTg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kgfnw9HzdurOdWGOZHDdHBC8TPLvVUtaf4KfmQdousw&oe=6A3D5322"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
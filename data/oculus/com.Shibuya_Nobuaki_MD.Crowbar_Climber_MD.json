3m6vd4k29l_pvulABhgv0KrMtNyIWXH0g2NoihjEXWzi8JWMrqocrVzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUmZ-A-q06oztFdl7NaJaMMi3fThW7jbU-AyBG7BAPkQ&oe=69CA69E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG9r0RemUnAQ7kNvwEfT3LU&_nc_oc=AdrnEX0Ue5b01D9-VgnsvUVwb2_AoRi3LXJHo0gcdBG6XAQkoUwdp-ddMX-hKBkMVyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoEiV_FslRSahbyAmWryC8kcoT1VJNapfX3vsWzdb1iQ&oe=69CA6379"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_G2RiB-aqsQ7kNvwG52_rT&_nc_oc=AdrwiNREH-itQTZx_7BpfcCnA2c823Im08bqxACrkodQCM-_FUX8RWavlYMzQzRgZlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznDvNPnkggPFjcCPrQ2y_J02kKcIIu0Op0AnhPfe24vA&oe=69CA55A3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gonp0dCG6t0Q7kNvwFaDEV7&_nc_oc=AdoB2xdG1Z-1DB7m0ibQELKS4XOjwIYU4o-80aXDy0kj0RNPVch11rtdtAWhaZzPlZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4X7AaDZR_D2OjbJ83M_RA8TSagG30GmxDbloLbERSgw&oe=69CA8A40"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20MMbxTR0HEQ7kNvwH0X2mu&_nc_oc=Ados-isyCNwv5zd_xH4zWzUb4ZMaSxiiucHvAiCVaL7xgxDIondn0Aa_IjGG_uwXnyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTX2WRNUEoR35gy-pj4uuJbdJ6ZXIV3Yprogcl12e6QA&oe=69CA7C36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKNZn8u6K-wQ7kNvwGe2O91&_nc_oc=AdrtItsVjvpWN_9cG7YLHVcFR9Q2CBbaDGDJmJAxX7tnovdx0b0e5-IqCiayWN30W_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzY3Bu7C-IicC6pXHiC2Ph9kiskx9TEyrK-VO1uVlBy2w&oe=69CA69FC"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1Sq2JLdqncQ7kNvwE9nk2M&_nc_oc=AdpYul89gbN0g8XHpnmkzCujcxLtlBwbQ7XJahTOqodmxi9znS2dNvM8xZrWdmpdO8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr7El0mvZkTnd30OrTkbXCJh2bRu920RQEzeen7RHh5g&oe=69CA664E"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4at7aEpsfUUQ7kNvwGgjGOS&_nc_oc=Adoz8XEP3iHdRFxI4zfCbf01GOx8js8acy8VgifsBMZqXGhWDoM1NeYxJmQzWLI7pms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIv675LXv8qkWhCj2Lu7sE24K-u8MWr8SO1zRXl5jgbQ&oe=69CA73F9"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb=1
8434748", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmijpSc1NIQ7kNvwH2QxAE&_nc_oc=AdoU5tnryV4Y3mpHQBDFzsNr6XVp4Thjg0yrVwvXqdhS7U_W6FQp63bmhnG5OoOK4Nw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b0cli4PVsC3OY3gh3dKdjq0LMqak0sQbL1wqkmB5SAA&oe=69DCFF9E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyxa-ikPMlMQ7kNvwGqQW2R&_nc_oc=Adpr2ETNribMGe4wLvC1gsGK4L4po7HEJYo1wjCx_OKWpSsLwGQJgzzbowhwOUH8wDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hrcxFgpDiwFI-v6SmaLT5e1QQc5qXh_RZQk332eal8A&oe=69DCF192"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ghpHDALrmcQ7kNvwFYKWLH&_nc_oc=AdqdUe7scu_3JE3mwqlw8og3-K0rJb7pZms3mMNqJasJARHP-ZRiKGy-fXNPYmS5wgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26mtyTiIHDSkqCKcAUbaG06ih4Oev5yB0QH5_zzAblDA&oe=69DCFAE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqJkIyavMbUQ7kNvwFEb9Ty&_nc_oc=AdqRm4I9y0B1ce2Fjc6RuZli38XhdwPc-axqVy7kEGmNR4fX4QoNwwrr6fRKniVKniY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hpIG1fA2YAU5OlRPWNTB0Jm0IiXQKchrOHIit8uaAGQ&oe=69DCFDC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-z5z6UyGe4Q7kNvwHaSCcH&_nc_oc=AdrmpTfi5G_CK-Xacxi6qZ_q5elgMiFiADpPjslkdrNLOYavQNM6UZ8jg8mUqLRYP3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zRPc5dqqqIZPhF7oGcjmt9nr_LMvDcmxAc-R3CHAVug&oe=69DCDFC3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxBM61sNsO4Q7kNvwG4UmjV&_nc_oc=Adp5nYB-Bsx_vdTSbY5Dcldzrd7hZf5eqI6cy64S1bsBhvQAji7UhJztS2
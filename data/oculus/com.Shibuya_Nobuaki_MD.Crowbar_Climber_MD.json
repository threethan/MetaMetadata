_kI4hX2pVoB7yEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eUBVEXJiFsY2PaG0kIWwDNxJ58fWTD2gwaK1YUiqniA&oe=6A43D49E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjjzUuw0T_oQ7kNvwGt1UlY&_nc_oc=Ado6TxpAGn5rCC_mnXq5VOcj2laU51DkPdUSei-En56jkxOw4e_Y-1Fo14fQ04wlVmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZyRjMr56oO4i4NlbBDAd_l_88esAxUKgS7KV10oNzeQ&oe=6A43C692"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZuj_meBozUQ7kNvwG8WRi3&_nc_oc=AdpNzs3uqsC8Ept3eeosQnLZ3viM6Kp5PXXaTp9iUmdcCuxBvrzh4U75FX8xZpJI3is&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AZBnbAIEISZUNsNBrAXGfhHCOPzPwAs9JMEWti6K6sA&oe=6A43CFE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJX0X59QiYoQ7kNvwFzqCst&_nc_oc=Adplv_gbxHUeeC8RiBVL4VQsvrG8kW_9fuMsSQob1BKWM0i06O72g0aGouF1-_Aeyso&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMi70PNw4jT8aPqudgiQPX9ljkGpAFSxbF0_oIZUALg&oe=6A43D2C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PMaMxks25sQ7kNvwFKXs8a&_nc_oc=AdpubB1c0c87X0KuvLif09GJtk8bdoyR_b2_VkEQ_L0WlTqKTGzqNAhXCc3sdjTsFp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Iy68K3wIm9iZETG2DQV3U8XHAy-TRLosHJvbe-4FlA&oe=6A43ED03"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ypt02ZgsLgQ7kNvwFHCVU_&_nc_oc=AdpxHG9g-QY58fDz16shgWBrMLmfrfhkj2xXJG-LZu-Ew6-G8U_rELx4LzpfNnDx8tY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3fH0LvMf1DhuZIK0YNFlIwQiOwm_7cnebTESmYMulVA&oe=6A43EB8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
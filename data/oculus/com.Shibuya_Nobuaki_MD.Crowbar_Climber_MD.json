6033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVJbnhCwtGIQ7kNvwEhD9H9&_nc_oc=AdqsvA2anLwE8PfPnZu9JZqVHmYd8Shy7CAKEAdS3845HRmDEoe2GXcZpi_J22B4H_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dZ1Xemkk5Thvs0WlbsMdeWldP7ZuzRyZ4mlcNIvo-rA&oe=6A032D12"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THIjoQ3kw6oQ7kNvwHTVg0O&_nc_oc=Adr0BYzrXup-v2OtxJJ4lKFyETRgDB--KpN0ju-jee2ysSYScE64UCwzTIllUx6bFzw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5465tLgXR7eoMVaWpFxEx1JXyKERsPEvPY7NTjKZ9nQQ&oe=6A033665"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw23CrK__3kQ7kNvwGJHKCu&_nc_oc=AdoB_juBFIhnGheaPIjF8dc2NFKKs33uNQCMT0QwIJqQexohyvjOoq7ctd65IWFE1aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qkl7lbNTxv8rz6pTI2mvuBTHPXSAQh_uneDZ9gaCKig&oe=6A033947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_AvzmwZGToQ7kNvwGJLweI&_nc_oc=AdrUd6p63Gv2PffgY_x7Pe7t-BAK8a_EvcN53F1YtgLFbXABVCJ901o61tHRuIMhoSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aoaxNtzY1M2YsnTx64p9bTLDdKTGUaOSbSBD7hVTxBw&oe=6A031B43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVjLYD2usW4Q7kNvwH7ZIFb&_nc_oc=AdpvegrUmzlZEnyUV4iPfMngzL3Xvju3VKTAzU2WTDAo8foFJFXr2Z1hxvSRp9FB6vg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wk-XQp0axrZ28JgDLWaqMbF0zeH-IL99jHiStidAgoA&oe=6A0319CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JJELvuNJrAQ7kNvwGQFN9X&_nc_oc=AdpkKLUFMe2Hq1gbmrlbe5GrycL4VM1mreXfk-a7JbigLeU9JoqVV1szzcRYSn115S4&_nc
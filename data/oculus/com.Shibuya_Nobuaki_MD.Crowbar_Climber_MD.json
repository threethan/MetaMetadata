/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue5yPsJkq34Q7kNvwEP04U2&_nc_oc=AdpTCGQIeHUAavfusCT2OpHp0nkUSvNR1c0Xkz1zevv34qoe4cbS97-Mv4PiTs0-qQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8tMKefgNNDru7uuOW0HSEnuT6fnGNC3OV8b2wyOEg0Q&oe=6A242292"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB7kLbRht6EQ7kNvwEtgca5&_nc_oc=AdpWH8FWz58Gf0k7RkrRAOiKbkD7U-VHPt0nTXQMfEYefE5VCI6SzSpX4cK9q5roukI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fa9BFYZbYjzs-_8CWuBCW-zuG4KJneS13PTKwjoS_0g&oe=6A242BE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNmXF7NqtWkQ7kNvwEgheho&_nc_oc=AdoaOiRFq_m0pkVET-Javphkm0E6zI5hkdt4Whe9pU5y6wusmflsrYpwL0CK10BIjIg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gs-tb-wbRGd2A0AmVJbSedyabV4FKpy4eW8JdL3yStA&oe=6A242EC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueBHD8rY70kQ7kNvwGcZoao&_nc_oc=Adr88HtvYeU2HdzeCYi7osSrEOXYDoAMnT1qevi_Ige6iSG_Rnk3OlggnFdNIf1et3k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93odd3umeqqPVOy6XXWHFT22ZCh4U1oO01be-1T9xy-w&oe=6A244903"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opLOHLJxcEQ7kNvwEPh12O&_nc_oc=AdrukqKnJr1__aVjuQxxbdImpyyoOK621Dd47tD5jZVop6wGyZYHYZRhNA5TqQeZVwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_32FXX1KA8Zg02DS-WcmxdNcn3Y4rb90poLNiwYwFvtA&oe=6A24478F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97jW3o3K4koQ7kNvwGIWnln&_nc_oc=AdqgVTvw1y9h1cAvYlIpEnepjvIgrdipea46Ro90
hc=NGKKoXYE9bgQ7kNvwE7Pygv&_nc_oc=AdqG6fdQU6QgOagAJgEW9l4Fqh2hH9tFOe6VdipGMsnXBHF6CKJV9WBfzYc5qPOPP1E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWF6awrh8cG_cb0nOkKyLirpoedBb5UW7FwWxCrxXKjQ&oe=69C7E2E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7oNv2tNqmoQ7kNvwFyWvCU&_nc_oc=AdqTwuMkhV3PMBdZnHbPTtd1Rm5ODhkgMHSIwjLvdYauV-K_LhKkFQponcsPI7aBgqk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeQCBCeib3s36Ps6-qN5sp0kzTU31-UIeyacZLdEmFDA&oe=69C7E5C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=932Jy4gsLREQ7kNvwGtX_fj&_nc_oc=Ado2U-gQwih-4vEzkpEoZnqyWzRArdCZVQXezcmuiCm4QufqXt3GpLijfsT13jQFyVg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2ViCODaFhz60AaXM7V9USznLkJYnKm5FJeMcwMefldg&oe=69C7C7C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD_C-6gsjhMQ7kNvwGY3Ke1&_nc_oc=AdroYA9TcclkZcPZIQMQ-nHJLPgb5oSHnfBZcPYK4E6sagwVuN4qUp7p5KxYJHBkR0A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0e8g0GbQKzIJoWjVH48MjUeF6i5M2G5WufIG722Huaw&oe=69C7C64F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iibJVlqMLgwQ7kNvwGqPGbi&_nc_oc=Adpb7Vns4KpO2FYrAer3_TN2mwDQUoXxOVZFyoG38ZdQVReQ6IiiTbwf3H_3Z7IUB08&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxbbww5ggQv4q7g84166xSDlY_KqjOOvObws4DnPCVyMA&oe=69C7DCCC"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2aeOclPZcYQ7kNvwGMLE95&_nc_oc=Adr0RL9CbCq3AQL_mDt6sU2JTuYDRB15ctDCOiGQbjpLwQscbrI9ST4sMXyb1
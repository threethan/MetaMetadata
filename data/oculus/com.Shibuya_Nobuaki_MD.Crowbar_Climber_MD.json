64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79kEfURQx0Q7kNvwELri2l&_nc_oc=AdryxAGnrvqLHrZCadYasGWYkV3aWp3AzMBYTSqYCWTY_9fj7RUuwLdaTx5lls7SZ20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p0LgEW_K-pUEKvE2WmEHj7VgqygwHnO_9HVG4fbl3ww&oe=6A3E8E40"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol9o5yt5dFEQ7kNvwE1GRr6&_nc_oc=Ado_NH4IQgFZwUZGuxobMKUtlO9G1VPcqV4ky8gIfvmY4BpuVFIUXu54VI0xFuqnDd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fv_RsFxFQBZnsJCouMgIT30hpCP3I9B7cWILAZ3rCjA&oe=6A3E87E4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja2QvY9Ztw4Q7kNvwHBO9Gk&_nc_oc=AdqdrV01Vuh1KXkcHfSh364rFN5mSefBb1qLCGkfhd_iHa2_-TKVk8kh_Al-Wsy6OF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83EFl-N6c0n0ClYD5dbwId0AYpQr-Gqs6BnvP2LGdfJQ&oe=6A3E9CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d6sMIkj8kYQ7kNvwHaxm2E&_nc_oc=Adr-MR_kaCKFsmpRwQ-OZq4KRG99vgar_YtRkStcDjJF1-o0Piu0xJzcV1i-rJkYgJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cqcAFZ2b__kkIpTsd_39cwZ0zFllxn-2auYUrW2L8Hg&oe=6A3E8A3D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vWsPQ5E9RsQ7kNvwG7QIq-&_nc_oc=Adpk1isHHMZlr6kU4TOj7xgUbAqJVoO1R_60csNQ4YX_Do9nMk5YT5MypjzGscMKpyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Iu4Cnavx6L91vPQ5dJtVF0Ge1Afxlq2VNjOd4ltzGEQ&oe=6A3EA4A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
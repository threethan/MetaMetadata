64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R79kEfURQx0Q7kNvwH1cnXW&_nc_oc=AdqBaBDe_FAcPOQYZz7Y8iUeHKz4UTUb8rDLVXHhwmK93ret-UHTdBh7thmWlzh5SgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lfORtMCsxU42Pg23Nljuamri1AUJqIG6SBZhNjYvJCA&oe=6A3BEB40"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNSJ9J58jqUQ7kNvwF31qa1&_nc_oc=AdrXtVou24yjWEB20MkcDKNUB7RNcBo5M4E4J192RAhygQ-1_JCiuq4S3QtRpouaWnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_fxX858v0xWrvXy2izUUnU_mh5EdiiAND2rp3y0MH8A&oe=6A3BE4E4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5ZtAnWpiNoQ7kNvwHtKnhW&_nc_oc=AdoXAKd7fczAeIVQ8-alGStiYBJvenYoRsOQLEBofWLqzilnBSHdVaAOJDITl93oQcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hvtXr72y9ZM65xwLCjPB8NdQYwRQGdiSLqkZb9kg1Rg&oe=6A3BF9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2lgL_B1xTYQ7kNvwGhbXJq&_nc_oc=AdoqC5bF0MFP9J_Lb_J4MALNuQO0FPu18y8O0lxRkIoGxmMKTVFxHE-KEKCLtyMJe7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D8aR6Zzg4yiWqnQWZ7s3NuxI63xMvJ5zeERlTIH4OMQ&oe=6A3BE73D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vWsPQ5E9RsQ7kNvwEUdaof&_nc_oc=AdrcExzxXItnoNgidpKxx_xnqQLgY-reD7jKNgGVSTD8hXqACMaATroEPVSG0mCw51M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8deGjTwqxbJ2AoCTL778t1oI1Jnl1YWm0LXeE3WEqmpg&oe=6A3C01A2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
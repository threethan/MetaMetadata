.com&_nc_ss=8&oh=00_Afx4LqeBwqbBe6m6chxE3lUTVLZT36U-WReBCVDBVBgyIw&oe=69C14B65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgyvTEODIUkQ7kNvwEt7eBj&_nc_oc=Adpyd-OFirPdMtVZvubHzWinyo63VxIAVFRAz8XI4CI48wYIHRKbgjkJ_KbCmS7N2h8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEBR2mvNCXQ1n_d22U1GFYlQ-I4KYNGVoGGJjq2wthIA&oe=69C14E47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGnV9HJwZ0YQ7kNvwH3PcBe&_nc_oc=Adr6gahlwHSEaOsczx8HOFGXULx8Jl-AIoPEWze4xSnYhiBwXs7QnjG-bZZt_UXgSYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2oE80FgAqYDdSoITl8W_p2UDxVSfZBpAUek3rCOqFYQ&oe=69C13043"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVe4BxWpbSsQ7kNvwH7YvNw&_nc_oc=Adpuxw72TmN9suUYEUBo0ZGL05v2_T8pI7u1p8YupTLPolzrCqqFgdCEZWGNMYxSJH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwasFb1gsRClptqkVcdtZTucraZanlC5jD5oFyEKUwapg&oe=69C12ECF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035422_1600193204253763_2888175221652773853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YIvn_EziAkQ7kNvwFdeL2n&_nc_oc=AdoBk5UNPkkQOaIlxQZFxD0WVJ-5DpSZqL855HKByduspitjzcGbB4tFU-3rOLWgZEc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzKCBx43JSDCid9uRlI3L8bZHzmp252Jqp6zzt2Xeuyw&oe=69C1454C"}, {"file_name": "\u6b63\u65b9\u5f62\u306e\u30ab\u30cf\u3099\u30fc_1440\u00d71440px.png", "id": "1251561352757340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75308616_1251561362757339_7215552342212717731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2gDwQQ07PAQ7kNvwHTAYY-&_nc_oc=AdpBmFkl8aYAYV3W8PZU3NGYb99A-gjK5SWCLpaLjj7Ef_XF7D_q79tIo8Z87Z3feXQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-TmSEKS3TZJORXJgak1WEC19G-TZlY1ssy2wX50zctQ&oe=69C13223"}, {"file_name": "\u30a2\u30a4\u30b3
yXs8C10N448y7444529njjlmP40CE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxBhRmko7ZcqVSFEWfhjgFY8WnnYoaCbv-UT3JoiZNQw&oe=69BD3AE6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYYUigYG6OwQ7kNvwF-HIz2&_nc_oc=AdlRfWh0bh16PNFNp4REUnRW8gPR33cjn5NRafX72SjbNuSURjmdIJPAK1z7rDhUFKI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCdmYJDDjJrNP1t7vv89NjfmLGfes2wtSkPXUDvmjLeQ&oe=69BD3479"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOixu8BymdoQ7kNvwHmQxyY&_nc_oc=AdlohNxthEi_Y8h0r344bb5ktDLveJftLBHvbuB8RbIffiFylGgMUCRO-GaDvqjnnoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh6jhlYSL2WdRLV64YmTveCk3cHAgjKPSRhYlthPlzWg&oe=69BD5EE3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu_LuFL9olQQ7kNvwGpmHBO&_nc_oc=AdkNHoVBgLxFJsutte1e83wZzwn_OpjuAvp69dPAMXk3WG4H7zqPTLwKhtvfNDqpzrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj9EP-aEsVMPDZVjt3sZmGDEbm8YJ4DSCX8gzSgvPJ8Q&oe=69BD5B40"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Cvt0pwg0oQ7kNvwGH72cp&_nc_oc=AdnNFBJj4bFsihLk1mnqqWxJcRVgxvlftNbPVYCvdRyLcV508Q_lU9tBjr0wx2W3Pww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUuZJkug_Di4SsXUioHZLlFCCUdiwtoLxXwlCr1Ap8CA&oe=69BD4D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n2gb4df1rgQ7kNvwFIgHQK&_nc_oc=AdmvdjK5kdRwRo-JyGuXEuhNz9YluALB2iflbgjJBTv-jItX-3y3kkRxqrwjqT3yU64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBS2SO4voYkdjN82HCcsYyk1LL8fR9i1XspBQNWwYoZw&oe=69BD3320"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6VxP--pjgQ7kNvwFFMMOS&_nc_oc=Adn2kqONmGumWalHNtC2gZzLpRynlztMwx1bhL7gBPOAbz5CvgdW0FQ68ubakJf2Mvg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF1DcF-1GEx3vrjsRPqVVzyoLEcVJsk4bkzWGFAsnXpA&oe=69BD468A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeLsk8z9LGsQ7kNvwH9I54i&_nc_oc=AdltUz7qzP1B_XXx3CizwaUr5cWgvz0n_64wq7i_D4p8lMG-x7BMEqH1K8BKCyO8s0o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX8H8T9n5obzVh6mpc953IxcZmEoF_EonTF3wtApBIKA&oe=69BD4B08"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqdlvj2ij7MQ7kNvwGgvHGl&_nc_oc=AdljH5
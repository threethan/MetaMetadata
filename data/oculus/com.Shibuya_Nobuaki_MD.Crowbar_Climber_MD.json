-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgl_4mZTeNEQ7kNvwHSp91p&_nc_oc=Adp9fozWiZLl3ZkjReDKmyv8XOveJEgA7D0S1Pj0xv0h-QrtMLvPniRSiLgFEM3tZhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U3phmAB1SBYI0jrsfsK6d5DApGuovPoA-p1D7cF-5_A&oe=6A130664"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNwjMvhVv_kQ7kNvwHO5eOT&_nc_oc=AdrnZtYr-9gKAXme2X2FoLnaeuBaPBsijstsH17cXJor3zZ4xYLLZ3Vba02AnChe5mA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7izYYStZwm4o9HuZO-IunIVmgVIpncWDB8OwK-xnPizA&oe=6A131B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "3083011868575827", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618499_3083011871909160_8489055195229745254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWMECeYJ5ysQ7kNvwGhkzav&_nc_oc=Ado0XzrAdCXwPvrJZGUDe10YO7hCDhOsSfD4olg8s_ZK68Oerm3du-nimqPQJPAFnOs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lkz8WZrwqiJMewTCt1eikTqal7VfBOXsyNTiJBfPP2Q&oe=6A132097"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{1671435490707886}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{2339678569868647}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all?\n{1683919399266895}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from!\n{26712839881658080}\n\n\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26974240215539526"}, "review_messages": []}]}, "cover_square_image": {"uri": "
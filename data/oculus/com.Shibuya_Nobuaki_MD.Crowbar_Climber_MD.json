.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocnzKhRzUXkQ7kNvwEj6LTE&_nc_oc=AdoK3v_HklIAzjJn8SWG9FE9s2MTtP3laSNgA0xgO1v3JINyOUjytbJi8Fyi0i8Kh2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zMVvrSf4LQHhtQt3M1wSzh8vc3L4OBXMUEq4RBUguPg&oe=6A4525C0"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3GvuZKViVEQ7kNvwFdR2bh&_nc_oc=AdqAu7uXyv7bMLG0d-203V40QK4VCrfOQJxwdDBweC1dn8ESprczkNj4IgOj8P_HpxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VEXFi7zfEjaY62oRy4G1hAcgg1Ec1w5NJE7ZATLn4UQ&oe=6A451F64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP44T_yilHUQ7kNvwHU1LGa&_nc_oc=Ado3EU53a6I1z13YJeXmXaCY_1wfk95lUOcYaBzqu-bHFPoGHmfRFMA0jfHDUBborvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8srQW_bkjybPMc1ZxiwaCa9HidbFiL3D4-WSju_xyaA&oe=6A453449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8__-qHwLRQQ7kNvwHbVhJ5&_nc_oc=AdqT5WhtSeln7sYAaVpbyYxRbP4xzRPYayGhzZ7ZV8CJZlVCo1nRco-H2HcLRAQGofY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y7ihpfDMb_dqPl3M7uvYv4YJNQV7TaVRCzDlkDM8FZA&oe=6A4521BD"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v5vnGH2tKoQ7kNvwGw_23h&_nc_oc=AdoXvofgKsCfmZHKoJU_uRHldQBZVueJZ8fW2sVyw9cQDcCzTHSf3nX_bjgQY-xZtvI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XgZy2y7h2s4BX19YlyvKTWdgx-jV7HoWRpd-prKryvw&oe=6A4503E2"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "APP_
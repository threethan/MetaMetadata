uBdcD99PnPmNX3Crwsvhow3K1gP78kWbkfOMI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dn8I-9PYA3R-up-G_WSTRkutwSsp2kBIOzn6CWpeVKA&oe=6A39489E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZMURY1I1OQQ7kNvwFY0zaz&_nc_oc=AdpAAtuQHqz6Hf0RuMwiF63MRiSFwaqIC11QwmufP6id09ce8vUkelE9J5hI6OLuIj0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BMptgz2WqqoDSl9iHAizfRBTzom99H-opaXGUqNKCrg&oe=6A393A92"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhhNTgwhckwQ7kNvwGOLicv&_nc_oc=Adr2InDFC8F-FLq1c285Uw1yRoip_nO-dDT4EDWwfoaUeoHgvVwh3D93ko9CQZJDDwk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UueJ_5HzF05GVMme3FyNHzilKOJqHfy2fgFIMADZaFg&oe=6A3943E5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwIwye70MoUQ7kNvwFgYUG7&_nc_oc=AdpxiB6TwC2JzVBe7e2owEpWlH99UL9Oe10NrcN-aV0ZUdlZj0sKT3AA6EqcC3MorQY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i31akWxX4YQNpOFkNN2NmKLn2NtpzG9EM-O1hH_BqPg&oe=6A3946C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgCr-NDNFrMQ7kNvwFOcD3l&_nc_oc=AdqX8lu2ztyqH8FEOXEUGnAEmPVrmkY8vnBD2iDR6fXGlPPI7GmX40MG0MvxUQW5XXg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83yVFuusarqnv7frQVmouQC1zb17pn3TWKHWNwjq5IGg&oe=6A396103"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMJp1lQivTkQ7kNvwEj7-sU&_nc_oc=Adq_o0XQcAJMmKKuKcuplpXrRJpSe5E2WThfPJ8uUZNkKVvVSx4-VL48J5miSnxWEu0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ioUOD-LXBTFDZelvKk_XjhLnDcyo_HHZN6QvzL_rRxg&oe=6A395F8F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193
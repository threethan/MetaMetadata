uscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCR_7wptIEwQ7kNvwHlankK&_nc_oc=Adpa1vWBssTeyJp-heB2cy-YW5pbF7Zrlswd_ZA1ga4NT9DstYvbkz-Wa9RFwhDmkAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RRrXatVVT1cliGgz3u-233X6ZZPgbl39KyPfj5m_qoQ&oe=69FB4B64"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3spDzJkp_gQ7kNvwEFoAIt&_nc_oc=AdoFE3euS3SlcU4bMKX8Q1Eg0C6lt_EKsU2Hbl704ifKjc6ARLTbBBcMhlwA9B8LtQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U5ppE0vir2dMtzbkY1TeCBpXwWG3Z52brrUpvX8xMJw&oe=69FB2809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "789503320556422", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619465_789503323889755_6094931996965140766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPYpboZ93_cQ7kNvwEETxrd&_nc_oc=AdqGXvmPaQ9shizh6MErnciyQ0yZF7Bt6o0II0Ic5V1-30yYRvZagPYq0NB0_vWbwE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MmqKXmJC_Jf-2sTWKeWixUrvfEbps6UCOWPMpo-wSWg&oe=69FB40C0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udc14Chained and Grained Update is HERE\ud83d\udc14\nNew Chain Mode Stage: \"Cluck-back Canyon\" is HERE!\n\nThis latest stage takes place on a peaceful, quiet countryside ranch... at least it was until the chickens staged a coup!\n\nThe flock has officially taken over!\nWatch out! These birds will charge at you with blank stares and explode on impact!\n\nIt's total chaos out there, with eggs that send you flying and mushrooms that paralyze you if you touch them!\n\nDo it for the animals who were kicked out! Work together with your chained partner to reclaim the ranch from the chicken army!\n{3157327724468740}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{1671435490707886}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode, where two players are chained together and must cooperate to reach the top!\n{2339678569868647}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from!\n{26712839881658080}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all?\n{1683919399266895}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n\n{935059665974508}", "short_description": "\ud83d\udc14Chained and Grained Update is HERE\ud83d\udc14\n\nNew Chain Mode Stage: \"Cluck-back Canyon\" is HERE!\nA chicken army has taken over the ranch!? They'll explode and throw eggs at you! Work together with your partner to reclaim the farm!\n\nPlus, the Skin Store is now open at Home! Try on a variety of unique skins and find your perfect style!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26639769932319891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1548130103311631_4828474740262015295_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C71Vpf64rLkQ7kNvwE-tezU&_nc_oc=AdoJJatRpYkjw17Q3ziNbwBvwxEgwXkGE2tyNnNl0iZJD6FwwFhutyECTlyqya9VfBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WtpdTliTrOxLG4su8yzSo1ddtTtPC7tfDtPXlkaxkQw&oe=69FB5069"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crowbar Climber", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1730304000, "lastRevision": {"nodes": [{"id": "8724223384301154", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8724223334301159", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "440213825342220"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "\
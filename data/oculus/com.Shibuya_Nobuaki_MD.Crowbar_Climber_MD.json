uluscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaXC2I3phXYQ7kNvwHfPRuk&_nc_oc=AdqZHghp4EuvwVTXXJr8ugoW5kYzEfI41-hxreWmAHJn-fjI1WYRXcfLTFZ-zPyLxDw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D_rtr9-6B_fEKumjsTiQtakOsi4l4Syyjxr0EQFd_BQ&oe=69E63364"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xn2JvTnWSAQ7kNvwGj3reS&_nc_oc=AdpTM4unGGIvaV3LX2Z21z2r-xwDPNHdsXuuvyv51LCBUDfJY_Hl8HDeMiCOU7SNsQI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02bxKnFg6i-aJ4EgR3Ih9OFQQhG-mnGuqlroRpZdyTFA&oe=69E61009"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "789503320556422", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619465_789503323889755_6094931996965140766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3EhKq9c3LEQ7kNvwEEMk0q&_nc_oc=Adpgh4O7scCof5AkFsMfeMceKj7h9t3IsQB-KdSy5soyKK4B8qiJLWfPVi5Xi87-hK8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LVddSuqH2UIjjT--8U5n5c479R2IYYKmTl7LjQq3HYw&oe=69E628C0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udc14Chained and Grained Update is HERE\ud83d\udc14\nNew Chain Mode Stage: \"Cluck-back Canyon\" is HERE!\n\nThis latest stage takes place on a peaceful, quiet countryside ranch... at least it was until the chickens staged a coup!\n\nThe flock has officially taken over!\nWatch out! These birds will charge at you with blank stares and explode on impact!\n\nIt's total chaos out there, with eggs that send you flying and mushrooms that paralyze you if you touch them!\n\nDo it for the animals who were kicked out! Work together with your chained partner to reclaim the ranch from the chicken army!\n{3157327724468740}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{1671435490707886}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode, where two players are chained together and must cooperate to reach the top!\n{2339678569868647}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from!\n{26712839881658080}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all?\n{1683919399266895}\n\n# \ud83d\udcac Join the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n\n{935059665974508}", "short_description": "\ud83d\udc14Chained and Grained Update is HERE\ud83d\udc14\n\nNew Chain Mode Stage: \"Cluck-back Canyon\" is HERE!\nA chicken army has taken over the ranch!? They'll explode and throw eggs at you! Work together with your partner to reclaim the farm!\n\nPlus, the Skin Store is now open at Home! Try on a variety of unique skins and find your perfect style!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https:/
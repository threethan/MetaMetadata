S3od3nWb8WrtfvfbWIbBxtlDSZeaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3ACmiv0B-IuefqLliHOgEAWKRLH63Mmn33-a7Q4-1Ng&oe=69BA97E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbwnoV7EVmkQ7kNvwFQ6n0U&_nc_oc=Adm-SNdlmq0WM4KDwqLC1U2XIPBV_l7L5MS0a8Q2X74qGvZCmJ6en-k9c_DoJHQQ2GM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9D3kT5946c3YO0pJh0ZfxwqSuraM_QIec1F82vF_E6Q&oe=69BA9179"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJVE9IePW30Q7kNvwFujhbo&_nc_oc=AdloXgQnvOzX4g2yaidC4Bpjq5kJbMlxR26zkfj3CqOIegJ0j1EWnoofJ440t6FBuk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJ2g_U5ZKr3xm6WXsPPNbpP_xUzYrIsx83dY-VEJwETg&oe=69BA83A3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXYmd-cXulEQ7kNvwFPMWNS&_nc_oc=AdmkqJTfawyfTvFIe3Z7Eu1LIr9vI9EN2m6Prf96BPWF-dUXrZvVcNxzv4iTIiOVzR8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTA_n_Q_CtHAmdW7-G88CdY67iS6FqP3O3y2XsDeu71A&oe=69BAB840"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOa4YBo6W2sQ7kNvwEpEwWy&_nc_oc=AdltPtd0cJkj-eeYKf3jVQ1wHCqSuUwIxCb2hK649U52BKA_b1Y4wZThAkLzsIfmbVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDNzxRouN3tBOHJbQp6TWKF85uOkyaPLSbT4KE6hw2CQ&oe=69BAAA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr8UG5KcevIQ7kNvwFQ1NXh&_nc_oc=AdnRYPEya7mnqh8ZVek9h8wEJLMjMNlM7QJXFwndpgBEm7kXrKhSkeryC2L1NOfBvB4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz27GiUIrPcOAuHDnSbxBC540nG6AJDCZJEfNrObHp2EA&oe=69BA9020"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6VxP--pjgQ7kNvwH64tST&_nc_oc=AdmN7ip7jlD-RyXJLqqhgRwcTTuLCyMU4BpWaSbFBuTTKH-ri-GEOk3tEMClI7DuheI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvnP3oH_frwrC0RmcwPK3-9ONO70fu8_jkKKGn83HS0Q&oe=69BAA38A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeLsk8z9LGsQ7kNvwEPE7He&_nc_oc=AdmEDoilp6bUwG4kQWa28m_P183zG6p9fxHNAy9a16ZMlq8pZO4ySURR5JYZCBmgpaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyfv55lHsUTMLDIyOyJTh12ANw1Bnjxg5Y68sPRz4WcmQ&oe=69BAA808"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XszE2tplt-IQ7kNvwG1uK5F&_nc_oc=AdkMKN
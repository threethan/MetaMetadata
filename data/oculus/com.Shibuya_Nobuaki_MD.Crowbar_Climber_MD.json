8IHHQLAA&oe=69CD1F36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1242158360983481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_1242158364316814_2731870058677847700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn-m6oj0Sl4Q7kNvwGL_i2E&_nc_oc=AdrvIi2bPnEBvNsBGVHaZjdyYmaXRqQG4Iqat9lFj3q8y5LZCP2iSvD9PdAqA1WPV-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKfrmDKAL1XbfYq9CTMjdI8jo_8H1WmP51hGnS-6uq8w&oe=69CD0CFC"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Icon.png", "id": "3093612327499394", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_3093612330832727_8910583508320471575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXNok8FYj5AQ7kNvwEf-03P&_nc_oc=Adp1r_PvcPoBiRrSlYWFZmOsiCiltT0293DIKWDaPyZm6zHHTqq4duGuD1Sd3BviBmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_Rd88lJfo2Ohpd4x8RtNNa1EW_FRcOgQO16JzjxZw-Q&oe=69CD094E"}, {"file_name": "Cover_Portrait.png", "id": "1512838307080450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1512838310413783_4467698964541317371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4at7aEpsfUUQ7kNvwFASJQE&_nc_oc=AdoHc_Jzl_NOocxPh8asT0rcf32MCi1yqSi_XJYXwVghsf8hQYW5bTSB1Vjm7ELfy4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-BUsEfWDgQ084EPxyMF9OJsDYM4FL7LyscAk6-j6Mzg&oe=69CD16F9"}, {"file_name": "Cover_Landscape.png", "id": "1252608493126468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1252608496459801_4108158355378478438_n.png?_nc_cat=104&ccb=1
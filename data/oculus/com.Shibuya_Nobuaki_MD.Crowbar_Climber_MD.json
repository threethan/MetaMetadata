c3-1.oculuscdn.com/v/t64.5771-25/39035447_2519556351768081_2234390948281231888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4654mS0GwQ7kNvwFYLy8C&_nc_oc=Adl1nRNKEw2U45ivNax3YsOZFZ6a5khbl9lq2qvjC0YSnxjQq3qEm7WGo-GgSGR6uYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk5TSSzPs8KXM_pUsjjWKhhaqSMGhh0vpdgof10h9WAg&oe=69B145DE"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oY_xvtYXWgQ7kNvwHcTka7&_nc_oc=Adl1Ttg_E0-7Eot3XVsZM4wiC_jk6uhN4FoG0S0fwx6byhvx-m6UQJu2mSf2LPKgIy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4wslBOdQkxzn-RbJJmF_ENWrOq0Rmnib__Uj4nIpaIA&oe=69B17012"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TcWoOIwncQQ7kNvwF9EC2l&_nc_oc=Adn6t7B2H9Gp4Ta2WH07UZzfcFAq9ZsnV4M0__1CZ2cZ7squcZ1f9YR1Uc8utdQhJQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfWQFvZEJ081kPE5XsavTUnYKhIVBUkRp1J5sIadQqlw&oe=69B17965"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4l2T1i4IhsQ7kNvwHWDnkW&_nc_oc=AdkEnSf3L1EUTqV_ZBrpB9k3WmaS5l447QKxxTExfE7KS8pDKRmvjj7YHcRrApggX4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPp3ytLGmC5a9e2FnBMHADKTDePBvdcdnFUQ6Mw_YoUA&oe=69B14407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpqOG5UxyA4Q7kNvwHwDZXM&_nc_oc=Adk1yS-aEJ-ptX68k-CxiOHHbQTZezWyeqzGGzlP9q2DkhQhTe70COQfmtwhbYCBNvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6iSoS4qEpjnz_pc7RUOBE-eai-iyA9SyvmOq_UHc-lw&oe=69B15E43"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2j14-IPbSMQ7kNvwE98nsg&_nc_oc=Adl_wYtq9uMcW_bhYbmQ7rdznfWjXz5aLnfizxy1xyU50tMgRbwiDfIstCxqfBfxmho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_
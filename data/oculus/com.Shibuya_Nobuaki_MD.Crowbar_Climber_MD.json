L2Zjn1j7ZZB4UQp94IdH8cOYgMOfCXbNKOm0OxKjpUBuUC8fMST2nO4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN4EzOVr7OVusJv2qMjEn3s5zuvTfTbWDD1uh75H5m_A&oe=69C280E6"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DufzV9dEeX0Q7kNvwH6BE9T&_nc_oc=AdpC10ay75JY9PKTYTi2OfXebTFhS5LLaVLtYEZ9ixFwSk6wxDNoyWVRSjIiVblwiTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWuY0PvssVUIwBJA9Bl3xctKkr1rLV22rFqOTBQ7woAw&oe=69C27A79"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGskwiO-BjAQ7kNvwF620rd&_nc_oc=AdpM5i8FiOFfjkktSc9BcHMo_fcq6ezRhEEIdBUkZXEpRIGnviBwKCs7ZMgCDKNWBUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzBZ3YJTH76BE8VUneVnHowY0h94k37WymU-23HkdiRw&oe=69C26CA3"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMRyMuWKNE8Q7kNvwFbKOeZ&_nc_oc=AdpqPZ-RhxggnW6IPc8AG8ZJiD0MbHlVVRlxb1IyaT2AZlV4OwvKW44sxWEG31cRRMA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySclg00Rx2iDxFF3ffGLkCdIVpCUz-6CYuOfkzTqlJvA&oe=69C2A140"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyrHl-69ZIQ7kNvwG9Pzcl&_nc_oc=AdqGBdvTYYkWV747e7NNpZEu0h3bTa-M0lMb5eS-gkQEcTw9BxEx6Kp31fGZfOcF6xA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzINxxLtzRZqr7XXUL2bryR732UE1MetqvcqnrZvttU4A&oe=69C29336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL7FcVEZVLEQ7kNvwF2mLEr&_nc_oc=Adpt_nIUjwapElPVBi7_5fBQWbkgR5C4f4yzskGRv6NjS4uAwGYNULjgONobVRgyzGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSDsto1vfx4gmfhSHhv-6zRB_nLXDDgKJaz0RCdAfIiA&oe=69C27920"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg2PXePSQLgQ7kNvwE4vm-v&_nc_oc=AdrPP4cNkhbfv-R3D_rnKL9BaInaxdgDcr9vY66MePhnEW-VCZNlq5mU_epNiC7j4iI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmyD5uKI2Br4aB8SAjYYjM4glfJVV2IoUIyhPHl_wgEQ&oe=69C28C8A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x591YY_gE4Q7kNvwEY0Y6h&_nc_oc=Ado1sbWTXCx6Dm_3Fqcx5YM5meXQ4lcsabrWb4fbtlWs6IOWpvV_LjXfn_5lWtZn-SI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5hCrvnNey5_i_7f7fCnYe_TwaUTL64SVH6civ2oCX5A&oe=69C29108"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_n
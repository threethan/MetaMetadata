4jBepUiaP9SYIuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zvTSoK_BpshoZZe0BoY3qKbT7roAMZlVaxDqtKmsUwA&oe=6A37F71E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZMURY1I1OQQ7kNvwEcipeU&_nc_oc=AdokuhtQ41lR94wvK_gMDJAq_QVskTVJD218EbNlmE7VnLZRjoAoug6E7euIgrmcDRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9udmeWgB_9v3EoODrAekapTLuRGJKieaFDy_wGlmXxdg&oe=6A37E912"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhhNTgwhckwQ7kNvwHuV3cW&_nc_oc=AdpakG8pQ4Q96rIFdg-XTYqMnCE_wJvY_RZGohUp0gbOlAOT0aQIqFmlDQj8IM4FeAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6V3_PTbVuldkA0j6PXMRTTKshurGOsEdiWtblWwDcSg&oe=6A37F265"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwIwye70MoUQ7kNvwHGtQ-S&_nc_oc=AdoTa3TzKuZVrAu29kWiuqfz23Xrdt-nT1vD8ffLj7LOoDyaAD3OrTlL71ll-ZHrHTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ojH4xelvfYEHja2iAeRmQF7a23a3RMkCeb7j2ud_ULw&oe=6A37F547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgCr-NDNFrMQ7kNvwFjfRdb&_nc_oc=Adqwbo2cbRqEa8wWkEnsFsJYo6a-ouML5vhZNqfmR7dPYvv9f9Pn1Ozu8pMDKZz3sXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rCYsmVy4Pgo_oGNLbd1XaNAcPSIpyrUGBFAjl3jQp1Q&oe=6A380F83"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyGrh21bBQsQ7kNvwF_HrBE&_nc_oc=AdprClaiDSs18xnR2A2EzsFtAqna2M50z4FexiFtXk8sI_uaB1_COZYLx_fB7i848Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BqVWYL2kZPEWncVh0T-xF5zlYVq2eXgCH36e-9700tA&oe=6A380E0F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
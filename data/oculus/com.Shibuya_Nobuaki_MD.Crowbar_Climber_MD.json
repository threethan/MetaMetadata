64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD23uJvdvJwQ7kNvwGOgFgY&_nc_oc=AdqXLse8SwP9STbrONy2eFxpVudE7HOfpsdfUHq9msujEbl4e_WstTjnxHDdrFhOGRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4lj57cfGU3gG4pxFLBTYaOzvwclQkgumA3gPEuxug2w&oe=6A413140"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_44_24.\u9759\u6b62\u753b003.png", "id": "1798359797792059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828806_1798359801125392_8980942235751302133_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GRFMYmMB4Q7kNvwG4Xtur&_nc_oc=Adqs3aznFObCCiHZwmybc4mGfkcQ8kwgvSo-mAJFVavTFwmG9UuyRqYyUDfYxKigshI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j6PNOQcly6T2Av7kLIdJQwob6qhdRlTRmCtyyE7txCg&oe=6A412AE4"}, {"file_name": "38974783_1245640976757644_6511698305735211905_n.00_00_24_16.\u9759\u6b62\u753b002.png", "id": "1456508806173883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618252_1456508809507216_9026317066520199601_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSITp3aRagEQ7kNvwG4ZBop&_nc_oc=AdobxLxYPvjhUqp9MxUfWH0g6GLPl0c1JpccGN0Ar_P64KwfUIvtXkLVZdvHfbuKhs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jRDYW8UFKE8zWVsTDyTYJLM_yU2HL3hl33SxBC5iaMA&oe=6A413FC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1932112667472058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623314_1932112670805391_1208315299792804652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d6sMIkj8kYQ7kNvwGmdgkm&_nc_oc=Adou7997IMWgvOE9f5LG2fYw4bFx7kj-cImAOvM80tCo1r5UzFdKTcQQtgD_EHrUzi4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ll9oxVMrvCqeCkBMZAEmThQC4c1lcgAEEsJVEwpBAkg&oe=6A412D3D"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\n\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?\n{980803631420786}\n\n# \ud83e\udd1d Have a Blast with Friends in Multi-Mode \ud83e\udd1d\nIn addition to the multi-player Race Mode, you can also play Chain Mode.\n{4531084310548952}\n\n# \ud83e\uddf1 Conquer Unique and Chaotic Stages \ud83e\uddf1\nWe\u2019ve prepared plenty of stages packed with various gimmicks!\n\nCan you clear them all? \n{1668836977661543}\n\n# \ud83c\udf81 Dress Up in a Variety of Charming Skins \ud83c\udf81\nCustomize the look of both your skin and your crowbar!\n\nThere are tons of \"cool\" and \"funny\" styles to choose from! \n{1593160558900959}\n\n#  \ud83d\udcacJoin the Discord!!\nCheck our Discord for the latest news, player interactions, free skin giveaways, and more!\n\nhttps://mydearest.net/CrowbarClimber-BazookaDiscord\n{935059665974508}", "short_description": "This game is a challenge for all VR gamers who love physics and brain teasers. For VR gamers who are strong in both mind and arm... see you at the top!\n\n\ud83d\udcaaYour hands are crowbars, ready to start climbing \ud83d\udcaa\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms. Can you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "Cover_Portrait.png", "id": "2050042312262026", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_2050042315595359_6777568878911362369_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V6MG_tkz9QQ7kNvwG6iqop&_nc_oc=AdprPyX-ARlms-eEm8es0oynW5xU3rmrwSNMWmrkHN3sSP43ssP_bqc_9_fnQazqT1A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IQYm-cdlO0akz0m4Zr62ls8bkhE3__efEvVHfwJDqBg&oe=6A410F62"}, {"file_name": "Hero_Cover.png", "id": "2042896819945059", "image_type": "AP
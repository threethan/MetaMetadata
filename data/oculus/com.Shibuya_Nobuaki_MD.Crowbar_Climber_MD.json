Jt-y5Z6AW2Yo5ZOODyfkoLqJaAT8ZkQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJHX3al3Lij97RvsBWllCYkh4DnAbrhTwUd9esGCRrMg&oe=69C12F66"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DufzV9dEeX0Q7kNvwFiVzKb&_nc_oc=AdoghA76OND3Dd2CmiGNoU0gNXI_USrobBySGUDYZX8zBckhFpm0GTAsuRdIDwV80Zw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgiki1DpYdm2viypg_BcFXWnSNoSVbn3N2PGJNN4T6gA&oe=69C128F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGskwiO-BjAQ7kNvwEJ5NNv&_nc_oc=AdoSfrI0hPdBqvGILo5kJUQpHWrk8lG9dQF24ztK3AbGODSeC3cQ2pPeUpda4CNxPHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhfPugDun46Q9ejxg6fehUqW7smkENxlWWKuUModn7Nw&oe=69C11B23"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMRyMuWKNE8Q7kNvwH9GlAH&_nc_oc=Adqd9heIMAk_9SfrTrIjZFNkhPJ5g15eLLZQQELUq6LjIKlkGW5f6mSjpVsuQMgW77E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWjBQHhyHx1mnHc40JTZHExDZUX8-j1rE5d2hym_guuA&oe=69C14FC0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyrHl-69ZIQ7kNvwF1pzxc&_nc_oc=AdqozOw-cdbUoqoaXkNRVQu4VTqqEv9XgM_r7c6YKo1QkMAPJKEHCj7tQXs5q29V0hY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZJgJ9vIm0LCBNcIwFBFaF7zIip-Tc9mTV3crKAQgr_Q&oe=69C141B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1723690111950045", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618937_1723690115283378_3233744645794341002_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL7FcVEZVLEQ7kNvwFLnfzO&_nc_oc=AdpY_H0KdO6Zig3ilSS9Wm9h5-ipmlFCGWLlBoczjz8pdpcnu7_U52VSLaDiI0yl9GY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwIKpIvLgXqwL4HWOIOTZRf0wKDgNumcyOyxur9zdCqGQ&oe=69C127A0"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "# \ud83c\udf00Warp Through Time! The Toy Planet Update is HERE\ud83c\udf00\nA new stage \"Toy Planet\" has been added!\nThis time, you've been swallowed by a rift in space-time! Climb your way through a distorted, low-gravity temporal void!\n\nThis stage is pure chaos, with multiple worlds colliding through time and space!\nThe \"Prehistoric Area\", where dinosaurs are ready to strike at any moment,\nthe \"Pixel Area\", where everything is blocky and pixelated,\nand the \"Temporal Area,\" which whisks you away to the next alternate world (and hopefully home)!\n\nThe Temporal Area features a new gimmick where footholds and walls only appear right around you!\n\nCan you reach the exit of the space-time and climb to victory?\n\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "\ud83c\udf00The Toy Planet Update is HERE\nA new stage \"Toy Planet\" has been added!\nYou've been swallowed by a rift in space-time!\nClimb in a low-gravity void where 3 worlds collide: The Prehistoric Area, Pixel Area, and the Temporal Area!\nWatch out for footholds and walls that only appear right around you!\nCan you reach the exit and climb to victory?\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "4294229844161922", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_4294229847495255_2252573535889192916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUSUAMF8_DcQ7kNvwEZ1_0A&_nc_oc=Adqq3CpIQMaH5uzs6xFnE28ECcduK-j14A8xkLmiubg7Lp8qaYASVUeBwFqbK2xdcHE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyk_IiGfwxpqCGYC_sKEq9myB7QMEobGvQaZb4Df2glNA&oe=69C13B0A"}, {"file_name": "Icon.png", "id": "1901214563851917", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1901214567185250_3434446826684819340_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu2K9I5rjXQQ7kNvwGnVi3Y&_nc_oc=AdoaeBJY4xooJBhFU5_SHB9reIQXbvDy0H4yqryo9U4gJTgn9svcthxu-ZRZp_EfdgA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzG-5U0dZusWtoyBHs-lF2EOg09KRNuWz3I4Hqcsxurfw&oe=69C13F88"}, {"file_name": "Cover_Landscape.png", "id": "1396174165616383", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499625099_1396174168949716_6710108657779290607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EUUMsVeQxMQ7kNvwGi9xJh&_nc_oc=Adpo
QPW0G95Gm3uFyxE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD81br3B5pWLOzSwH-tvA99T7mqqHwIqpixzGpNUe2vjw&oe=6A4E609E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok7deaVudDQQ7kNvwE4rGUQ&_nc_oc=AdpBsGd6R8CT2QdlCfqppA9eUsPEujowYW4yrnynG8qE-5l1aLUJ7FHxxj9rqlO9yLQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5rohICQOYvuDbUA84ShMc7efGs6Yp7fieg_zSYX_SNQ&oe=6A4E5292"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob1kn57QrIMQ7kNvwGFgKpM&_nc_oc=Ado9kK1dCvGTAjjXpj01lFYES1w_taLFNgL3nbZLi9J6GND-eLb70e9CzOzYivL2TBQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn7vdV9CK6dNWcH2_6qPdRHQBh3nFzCP1PnWD_jGu5SA&oe=6A4E5BE5"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-5JePZsrWYQ7kNvwE57Y0I&_nc_oc=Adohme_L_Xr0JOq6d6M5IydYr4DxT9ILHzjYMtUwFuxciNnQgDXgY0ANPKyFJNEI5Ws&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoxP1tBVWDzA76ergsVO-aPNhQ09-8SzKHOK8HlWEvaA&oe=6A4E5EC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_67yQ5gQTUQ7kNvwE9xgpp&_nc_oc=Adqa03_AFo51jVzoI2StzX9hPPGzm9xKVreGoBW6qiKVLnfiXFqyFTV_GyGFgv01nGY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Wm4OQ7BX4q-_7ByWGNusCjLf6FIWiNOeNYHKZmHW9w&oe=6A4E40C3"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scGawhgu7MgQ7kNvwEU8V5C&_nc_oc=AdolqgI6AG4GJinUZCB1P4amKebzbc4so6x0bKGBXRWu0cwoWGuUahs6d3584sf2334&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3FeHws--3V8senS2wVtlPP9hDDA1h1-3oGFIhQ_lbLg&oe=6A4E3F4F"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
ent-ams2-1.oculuscdn.com&oh=00_Aftxd2g3bTUc0Dr_I2fdTyXAmT2PVu0SVBtWvflDgK7ZUA&oe=699EE866"}, {"file_name": "Screenshot04.png", "id": "1532986304816342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299845_1532986308149675_7794760000563981808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xI5VWlb5AYkQ7kNvwGK0A-7&_nc_oc=Adnbz3vB1V4E9yaAJJ0lffLzqMSa6pW9y2IIsyIzkgUEGy71SI8vXCMMiRAUHcdqNPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvSSloHZOf2bU4DBVo0hE5MiceYQQzyB0gHeWzQUbkupg&oe=699EE1F9"}, {"file_name": "BAR_Meta_climb.png", "id": "24688897320727196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620432_24688897324060529_8535333182862460764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TUY7cNTCNwQ7kNvwGRNh6F&_nc_oc=Adk0U1giErEGbAk7MM14JrIDVfEk6Y3i2eRmo8gFPlfx53OqS1AdsHDUmd-ZCbXFPd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuOTN1BRnMuBvAoPGcX8bZFrCpxuHPR6NswENOf-SRyCA&oe=699ED423"}, {"file_name": "499618293_694850010362442_4578240610339580021_n.png", "id": "2107321256702634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_2107321260035967_897548686956573062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJiPKq9wwKYQ7kNvwH3UrF7&_nc_oc=AdksSgqEL4dzGBxHzVJSNXli9NghsTeZlBez9qpKX4pNwbkYkqBibeONue16iMlZaQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_PBYM_6j6Gx16e8JM6OGtAgmEJWPHIt-PKNvAsoInug&oe=699F08C0"}, {"file_name": "499619098_2345066902593724_6955110053482756252_n.png", "id": "693986250235275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_693986253568608_1890013783084103612_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pc-wvrR85EQ7kNvwHFhN72&_nc_oc=AdmilGzW3mEeLKfjKfcFUkZ0pa3RmGCbU5jgb09Lsto7XhrjqENH7hFaKjN84H9Y8ho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuYyteqICo8myvc_EmZ0pbWRb6OUiWjA8YZtd3TTgtDaw&oe=699EFAB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1514051349661902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1514051352995235_5620356262610719997_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFOdx_tvFY8Q7kNvwFJ43yZ&_nc_oc=Adl6y3XjPc_q6ed0I0q-zz10mpreeCZjaXhcUVgE4ooydGsadYAFFVtyBIEiQ4K9RWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsot0LTCJsWTnH5HvztNtDk_ZKGOlgmEv4OJisPFQn_vQ&oe=699F0029"}, "display_name": "Crowbar Climber", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "It's Valentine's Day and Crowbar Boy is all alone! Time to take a trip to The Sweet Alps in the new Pathmaker Update!\n\nWe've added a new stage, The Sweet Alps, inspired by all the candy and sweets every climber loves! Climb through chocolate, sweet sauces, and donuts!\n\nBUT THAT'S NOT ALL! Now YOU decide where the footholds go! In this new stage, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!\n{3901836126764594}\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "Now YOU decide where the footholds go! In the new Pathmaker Update, you can place your footholds wherever you like, giving you COMPLETE CONTROL of your climb! Take control of your path! Take control of your DESTINY!\n\n**This game is a challenge for all VR gamers who love physics and brain teasers.**\n For VR gamers who are strong in both mind and arm... see you at the top!"}, {"images": {"nodes": [{"file_name": "Cover_Square.png", "id": "2674605569564840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_2674605572898173_1543694344434582714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcBF1lgN0p0Q7kNvwHyn1b9&_nc_oc=Adm-q9etJcqc0Wt714DFK8IiqAzHV7Lyy-Au0I3ZyZqnNseyQxrLejMu-6kMm5XhD24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuRgsXnsX88Rhd4EKIjUtsq_f7uzRYNshOPXubf4pPQaw&oe=699EE143"}, {"file_name": "Icon.png", "id": "1446420630342336", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_1446420633675669_4938928416569755363_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JaWVRKgk0wQ7kNvwGFvKfi&_nc_oc=Adk3Phpdm_n9b8_yr1PG0pwRp-aVpxYJQxJxEs_w5VmDXlOpyR2hv_crtdBTpuDSK_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfutiCeP34szbNWjsMzhvv-mMwrocFlBdLWLuZRXCoCeUg&oe=699F0162"}, {"file_name": "Logo.png", "id": "1337332947689029", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295661_1337332951022362_5500251865447151953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRzwD-_qy14Q7kNvwFJtDWS&_nc_oc=AdlUeJSX6-78tanU1woKaaYNcnUolMR8SaqcszYfqulaZVNfcVC4O1S0223cTks1keI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsd-KAnuul9CqXQCfnc2YOjfW3vFGa9NMA_c4qix8PISw&oe=699EEDEE"}, {"file_name": "Cover_Portrait.png", "id": "1256790313058535", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618440_12
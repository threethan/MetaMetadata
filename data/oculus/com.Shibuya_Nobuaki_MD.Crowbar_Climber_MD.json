21kUzkHW3SbE3cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7w6FAvEVwUsNDs9wJf9OSv2Zz4ktWOwguW-WjqXGQCQ&oe=6A4FB21E"}, {"file_name": "Steam_Screenshot_03.png", "id": "1548440872700104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982608_1548440876033437_3846505249450171897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBBhmI_tAmgQ7kNvwHSpotl&_nc_oc=AdqKE9eFDz6S4F6KHZ1lVvCL-SqtYqbNy2-qUq7q56Om-IozUV1bMS60uLKtnPQVhB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqi9Iu3F60jjzn48wXLw9ZwgzlvvveDl0V0a2Vgr_50Q&oe=6A4FA412"}, {"file_name": "Steam_Screenshot_04.png", "id": "1285291335801131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035456_1285291339134464_3340480892359411112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qalX6Jq6rygQ7kNvwGY4A5u&_nc_oc=AdpVnTyjTjwgtnm6wgUtCZQ87GGkmPONGMdQqOVg_-nGTjttKGqSNiBtI3l-UAiTPDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIN_B68EPwqDma_Z4_I4p7KiVB6EF_mEyQypcgI3dQig&oe=6A4FAD65"}, {"file_name": "Steam_Screenshot_05.png", "id": "1103813564447820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974842_1103813567781153_4416741342714344124_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQNBr9AIchoQ7kNvwG3uFXd&_nc_oc=AdrYA8om5BJGIBlqaUzbOe3OkwHkMGpOcITH5BZxtN1Lzm8N90Rto8g9hCLkzCBwYGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgFahPc17fL68hiEaymr94796KfkNfzc3NEfqqgwH4xg&oe=6A4FB047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "461453252991834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_461453256325167_5103001946371630376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcLpPyApA0IQ7kNvwF5Mjw3&_nc_oc=AdpyYcyT_1w7L-LBvpzq0-jvDwwJKAZAb46aF41ePgcM4Xr36dz_O_NnFDA1fPyoDxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOqzy1rTh5auuVsoATEBcMrOlx6xpNyJoTnX5POJd7sA&oe=6A4F9243"}, "display_name": "Crowbar Climber.", "keywords": ["Physics", "Crowbar", "Climber", "Climb", "Action"], "long_description": "**This game is a challenge for all VR gamers who love physics and brain teasers.**\nFor VR gamers who are strong in both mind and arm... see you at the top!\n\n\n# \ud83d\udcaaYour hands are crowbars\u2014ready to start climbing\ud83d\udcaa\n\nIn Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?\n\n{1245640926757649}\n\n# \ud83e\uddd7\u200d\u2642\ufe0fMaster the art of climbing through physics!\ud83e\uddd7\u200d\u2640\ufe0f\n\nControl your environment and body using a crowbar that reacts to every move.\nGrab hooks at the last second, launch yourself with powerful swings, and cling to ledges in creative ways.\n\n{1284515982538891}\n\n# \ud83d\udcf8Share your gameplay videos with friends!\ud83c\udfa5\n\nRecord both first-person and third-person perspectives, just like in the promo video.\n\nShow off your crowbar-climbing skills to friends or share on social media.\n\n\n{1761655857997683}", "short_description": "In Crowbar Climber, use your crowbars to make your way up!\nFace hooks, planks, and gears using only your arms.\nCan you beat the game before you run out of energy?"}, {"images": {"nodes": [{"file_name": "\u30d2\u30fc\u30ed\u30fc\u30ab\u30cf\u3099\u30fc_3000\u00d7900px.png", "id": "2199490983740498", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001705_2199490987073831_2924059073434962003_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scGawhgu7MgQ7kNvwFLNClC&_nc_oc=AdqGGoXjWWFp0j2a_-aLW8oaNintLs2J-NrhfuZGy7ArEUy3oSVUqPIgSp50uoq5zrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_QC664Ifd2pXstGqvrrN33oDM-6N0mw0XA3Dy4DFUEQ&oe=6A4F90CF"}, {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1600193200920430", "image_typ
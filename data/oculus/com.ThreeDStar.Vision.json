tar.Vision-20240902-192146.png", "id": "518193644035075", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8q99wzS2LkQ7kNvwHYj_o8&_nc_oc=AdqDrC7He0en4HurZFnR9gZONC4foTNmPpBF_UDtp0A3TmP-lanw-3Bzy4pzxGjlQE0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4M30RojF8LaxgdFpKCO6rouDabhsAFioRr0mrc2On8g&oe=6A8EE08E"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEAbvXhMfvYQ7kNvwEAz_jc&_nc_oc=AdqqzVuD-T8O1kMO6NhY6jQUNxSTLhC8rdaN_LwepHGPIMkT1h6yGttJPg7xSM4-0H0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9thsDx4ALNT27cfyAWXlz87Ghaz5kDBUlbOgi0ieRhg&oe=6A8EF97F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name
40902-192146.png", "id": "518193644035075", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Novul6yITMQ7kNvwHtFLAZ&_nc_oc=AdqYQU6jPva00Tsp5Yu_Omtoc6MvK98378vfxOsDJub1eLjaZpXfgFLUFFzxbMxtQs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyGHqw9kEAqaKxuVEz23zZd-Bj8gn0zQ2-P_U-IEwQfQ&oe=6AEE04CE"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIDdpBjzsbgQ7kNvwHBGKk5&_nc_oc=AdpokKvm9L7LFou2T6IxKN8oJkYJ8tPiayyDf_Qz9FZfg-iTd1xtOs12mI4PM4rDRBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg0ONgTEtElH6JiEB6XhbYef_Lrd4Y2ZSsXaEHBvakcg&oe=6AEDE57F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name": "3D STAR", "s
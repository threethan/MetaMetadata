tar.Vision-20240902-192146.png", "id": "518193644035075", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGHG4w3LpvIQ7kNvwGtxUXW&_nc_oc=Adq3Mb8uAU6X9B_A8J2AAtw--VcVBTG5G2un8qFX6IsBruwdpOBueaN7kusJWViVK40&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOwOZjldoC57opSBu5tCVknNlUyzmLww-rLh2u2bpWgw&oe=6A85A60E"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqzSiICtsXYQ7kNvwGBEfKB&_nc_oc=AdrSK8krDAVIDJIxYAnchWB6l2GmmsICi9Y8N6T3IjiIh-1X6DW3K5irGLib8Ya70Jc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7O05jDgqUjTEgtv408TrwcR6KAileRxd5fyLK65LBKA&oe=6A8586BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name
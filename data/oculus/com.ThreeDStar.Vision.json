t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACzc2WPgY-8Q7kNvwHnXIv7&_nc_oc=AdnjVM7g6-cVal_VVwiShs23ko5ME_mcm4N5co9A9J3WZVGIGPufoZ19rH3GSeE2oMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5fmFGxd3P_V91U390WGwsFPz8DxMaFc3IG5CiwOEFEQ&oe=69B94D8E"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRkYywHqk50Q7kNvwGbDsWl&_nc_oc=AdkYnx3mMNX1FixmVbSswq8rDJabzsbOAxDDrDLdT2dSmwQmGWxHyN6fWrVXTykN4qg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzawL2dL7TwoXLCs6cFtQCxTy8vQPk7AzG5xZ8aITlmAQ&oe=69B9667F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support/", "website_url": "https://threedstar.com/", "c
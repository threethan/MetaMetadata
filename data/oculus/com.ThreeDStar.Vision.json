40902-192146.png", "id": "518193644035075", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC3vGPhvPacQ7kNvwFUW_TI&_nc_oc=AdrwC-3a32qXo4ZL_jhQthbrmJ-zJUSHLZx_TjZUOjTXSzTfUMnMHLgpSy1PYNaKqto&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOleVm4N1ZOOECFu4iVNTnKgYVYa8Bf-gpx4Bgog_Nsrw&oe=6AC91ACE"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjJVQ171CSIQ7kNvwF9ekkK&_nc_oc=AdqIHL5gARR7hOhZvkmV63KdtDXLzthGSHR-UW_pABvhoC5xYdAoGPVpq13VN9_ehCc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN13QjAAw9674ThqZKM0W_qRRvOlOPPVTYMp6cXmGZUKQ&oe=6AC8FB7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name": "3D STAR", "s
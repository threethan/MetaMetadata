40902-192146.png", "id": "518193644035075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN_VWmrHiUwQ7kNvwFb5exO&_nc_oc=AdoZ6Fvt35GBeb8pXsBCFsfVQagXXG_3lwiEy470gdZO_XQAU3uOszbYXfetgB6KZ6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1op4xb6qQ3ukbog0_3NwNp6CEnjBlKcLKsTbvWxKArhg&oe=69DE378E"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo1tW8wEwn0Q7kNvwGS-uDE&_nc_oc=AdpqIU6TgvP_sqywEBJV32cbSV7xJWTwiXzxY3o6FkQU-cURxrzWCQqQHGxquMxXyMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xIVwIINECplD9ul67KW4fqOh5gv-vINECNJLKbSXIEA&oe=69DE507F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name": "3D STAR", "s
t64.5771-25/39031613_518193647368408_3166324069899994473_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xZ0o18D9rsQ7kNvwEOxp6E&_nc_oc=AdkmMrctOPm17xqUBrX9zElqefVAEUHzzk6RtScvVtKE54V9fjzWbazCVKLnc8J5o54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLAisQ6Ulk1JWKAyFVHsK4PkBSWm9nk8TM8kUY_d1PxQ&oe=69AC1E8E"}, {"file_name": "com.ThreeDStar.Vision-20240902-192944.png", "id": "526749893137041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75411999_526749896470374_5469838111762535395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKWEZCbnD-EQ7kNvwHPa6LN&_nc_oc=AdnrmyK2U-rkCztRFjZzzWwFTLcbwIwsfd2l6DU4iF5MPr77R3aPefPnCtK5toApE-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHe5Kn4b5JhLihNGw079JBxUdjaYaH6hgdzElBA3Tbeg&oe=69AC377F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision XR Video Synthesizer", "keywords": ["video", "synthesizer", "motion", "graphics", "generator"], "long_description": "Vision XR is a digital video synthesizer for mixed reality with a classic semi-modular architecture and familiar vernacular, enabling everyone to create and enjoy absolutely mind-blowing real-time animated 3D graphics. Vision XR synthesizes volumetric scenes with high polyformy count at cinematic frame rates in real time. Sequence together dynamic forms, textures, and lighting. Adjust parameters like tempo, scale, rotation, color. Add dynamics with envelopes, LFOs, and special effects. Use layers to build up complex scenes. Teleport around and enjoy your scenes from various perspectives. Save and recall your stunning creations as user programs.", "short_description": "Mixed Reality Cinematic Graphics Generator"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/privacy/", "developer_terms_of_service_url": "https://threedstar.com/terms/", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support/", "website_url": "https://threedstar.com/", "c
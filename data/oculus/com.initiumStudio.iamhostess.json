6_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBO0Ncz3jbgQ7kNvwF-L1cJ&_nc_oc=Adp6aa5l5nb62w_9AWQM5mNZntpY8qCHZQCRlvryiqxAZUOaB7GBv-mjVipYBQMof3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zyWn9FyM-9NeeUiPX-QM3H90HaOgKVdSYpxLhZLrrTA&oe=6A073C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440store2WL.png", "id": "570512645913148", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_570512649246481_9216474204481390044_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km_nqiGFIicQ7kNvwEY8uNs&_nc_oc=Adrk7sNMG4jFpna_sykcopLfM2T25DJpjCPR3BnCSthr0fZflVUrR7KCtBNsQ0fJuAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jL3QpXdaFJRjfwFuPHwSNiznpDvEQROP-RQEjmAmPJg&oe=6A0720E0"}, "display_name": "I am Hostess", "keywords": ["hostess", "airplane", "airport", "fly"], "long_description": "I Am Hostess is an immersive VR experience that puts players in the role of a flight attendant. From pre-flight suitcase inspections and security checks to in-flight service and passenger satisfaction, the game offers a highly interactive and realistic simulation of the airline experience. With engaging mechanics and a detailed airport-to-airplane workflow, it combines entertainment with realism in a unique virtual journey.", "short_description": "I Am Hostess is a VR simulation game where you inspect suitcases, check passengers, and serve on board as a flight attendant"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/about-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
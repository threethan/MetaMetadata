6_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nJY48vm3ccQ7kNvwHt-IAO&_nc_oc=AdrEBy2e06SIFjcWusqTIcZ8IT0yEyozvxPDHrdj7KjtHbsQWF69lHTEU6vjUhHheXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q21kreEbGk0IjFQp6mb9DAUQgTSe7YmJ3IHzKnR52Rw&oe=6A243D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440store2WL.png", "id": "570512645913148", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827277_570512649246481_9216474204481390044_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJH4E8mM4-QQ7kNvwHjKPRg&_nc_oc=Adr4LKspTNPoE0PSPwQVofXYpbM5fovZ11zlqeVa7KeIACCajZsd1sBqJ0FOSc82rcE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qNN3Cly0T2qABT3xa_bfquVkOGAoa3dTYxk106Nj3Vg&oe=6A2421E0"}, "display_name": "I am Hostess", "keywords": ["hostess", "airplane", "airport", "fly"], "long_description": "I Am Hostess is an immersive VR experience that puts players in the role of a flight attendant. From pre-flight suitcase inspections and security checks to in-flight service and passenger satisfaction, the game offers a highly interactive and realistic simulation of the airline experience. With engaging mechanics and a detailed airport-to-airplane workflow, it combines entertainment with realism in a unique virtual journey.", "short_description": "I Am Hostess is a VR simulation game where you inspect suitcases, check passengers, and serve on board as a flight attendant"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/about-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
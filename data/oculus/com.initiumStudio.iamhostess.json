2_4608006471410814076_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOKMvF0kBkQQ7kNvwHoFx5R&_nc_oc=AdqxIeHpDEiDvfHWlB2zTqKuehsPSs_mTslO3clhf2FITdiNJEazm6gVSJUFJkyUBpU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYZigLzt6asBpbs2nrVpukFWDBXMK8DAUbt8oApRqFOg&oe=6AA41EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440store2WL.png", "id": "570512645913148", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827277_570512649246481_9216474204481390044_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KJ619atGoAQ7kNvwEZo8WI&_nc_oc=AdqjJgP3CMfyM3QjmTK1QUFBwgjZDcucVEy3u887PVekPadUXw1Zq93bLyDu4mWT4y0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGcyT278xYppEt8_cgzPAcYRZx9d0EGEfBeWaFZdM9rg&oe=6AA40360"}, "display_name": "I am Hostess", "keywords": ["hostess", "airplane", "airport", "fly"], "long_description": "I Am Hostess is an immersive VR experience that puts players in the role of a flight attendant. From pre-flight suitcase inspections and security checks to in-flight service and passenger satisfaction, the game offers a highly interactive and realistic simulation of the airline experience. With engaging mechanics and a detailed airport-to-airplane workflow, it combines entertainment with realism in a unique virtual journey.", "short_description": "I Am Hostess is a VR simulation game where you inspect suitcases, check passengers, and serve on board as a flight attendant"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/about-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_RE
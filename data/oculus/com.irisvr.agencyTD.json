d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtyvs1P9rvAQ7kNvwFr5z6Z&_nc_oc=AdohkFncAhoZorAeZwsvCACue_eWuSz1aTXpocrEXJZLA2wzO192fMR-YrYiJvBKuas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GPQi8TBaFzQ2yRTJ4OKMBDXOA-YAcBOgjRqql2Welow&oe=69ECAD4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ6FPyz5Y_YQ7kNvwHD1Squ&_nc_oc=Adqnnyi4ff0L31VpyNMz_xpkAX-4W8iJhyW0JAIuqE0zp0Lfn21JTL-BL6nN2CzZ5VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DoJcMmazBQ73NJ6a_xPJBlcgaGeYRnmuglgWy-Wy36g&oe=69ECC92F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6_SiQym8r8Q7kNvwFtl4df&_nc_oc=AdptZRVQSYA_yi7XX85qRABzt1uWqA7-OS3miEMA1sIN10eFvXGKuxxXGNG7t9UAxRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H0CX0UrqJLylE9fouss0rUlqZgdn0sZQ8rsbfadDIog&oe=69ECB88E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg86w3HPHnMQ7kNvwFSf6Jj&_nc_oc=AdprJmn4wMJlRS0MUOBVTtQ270MNaq3x6dflSVEyf-KHXA0IUQsLGTS0rC-R3jnjQm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V3_raYyMjjTQAtgA2N-Z-YjdaapcCc2f5ZOd_dqfvjQ&oe=69ECD6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=083klYo1yg8Q7kNvwG95CqN&_nc_oc=Adr9pR0zmbCqixqyI7r0Azr4DBB7V46WgR3p1E9n7kodEgVvqsi8jT2EXbj57HwYvFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dGHyq7WzswVyIML9d4G1uV2BFyOOnW_m_VvMK-uwOXA&oe=69ECA7A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
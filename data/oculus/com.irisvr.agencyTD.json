d": "127991675991805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl7LlTF_7fYQ7kNvwFT29Qu&_nc_oc=AdpL3ElH5XIrgfs4MuB1bRNmOLGy0SaBXhzEdH8Q_Y59AY6ROJwF5fdj2n8gmDwATeg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a2sY21Ge8TZiRTgZ2kTQqWhoJFV0i6XiYmDvzeLCQ1g&oe=69FF224C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dit-ztJuiVEQ7kNvwFx2k8B&_nc_oc=AdrR_OP5UPYS0lb5qc0fu29dPTeMt68S-Bd1N5xiujjCwmroXaiMAk74Yw-_kLpDyMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eccHXPqpu33O1DRaZ0dox69vvHiouGqGtQ93_OHTjLg&oe=69FF3E2F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LtzySXqA1YQ7kNvwHdwunN&_nc_oc=AdrSbj3Pge9sG0VKo3LZO1cykDSbkwNAyOpOSGwW0UNwdPh7lAjpsILjPtgoAc-Bh9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WkgAo1BY5utjmVON_7q4B0-NYZc2zHNqqyfm_j0XGVw&oe=69FF2D8E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWjj91C-eq0Q7kNvwGQKsE3&_nc_oc=AdrB1EEqSZU_2cwK7l0AbuoVvj-6zYMJCUA9Oz4dyz_St0wtKGkInOEbNfzCLtvkUuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g3olO94e7S_kYKMcocjNT3-rlGI_MLzV2I4E2vTE7qw&oe=69FF4BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvPbfM_eglsQ7kNvwGWxBOv&_nc_oc=Adq8oR4BalbB-JGrRiV1Qa5L3w1so8LORmsJpVvnTHh8x8BdV4ppMq8OWMWNYFGleFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O6VVBiJQxfgyeIrAX2H3dLT_ewiacf_PvTM961V35mA&oe=69FF1CA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
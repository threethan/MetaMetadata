138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2UN_VF_lPQQ7kNvwEU_PwJ&_nc_oc=AdlXQ9mERmqik77TC1Y-WdONPeio0hIZq4loLUmwruhsOsjvYCIC6Hv_S555Byn08hE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfapKXzRCK9pbyfW2vKOWj7lGNeHJcmuMslA3LwQLJ6g&oe=69A6CDCC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1Tx-WUeu4Q7kNvwE1Jtfq&_nc_oc=AdllvidAyXGVdzgJB_-2xsQHHM1W71PT1AeYGYVpWaIkq8EB7ukD9joy6XpAE7EY91I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPWeMgPNSpN2oYQ3VB6HYT9HvmLxHEXd5hNWFhM9hEcw&oe=69A6E9AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwuqeeoiAKAQ7kNvwHEF5K1&_nc_oc=AdmsSnROjn4Nse5YDkQse0mbrgx6a-CLYmRusr85hr0O5ONqPMIYxBKSoX-pRkIkVUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS7PmecZwgwOiNsZVn53iismqq-c2eG0U79QDsoDmZOw&oe=69A6D90E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJo4D1ya4OIQ7kNvwF1Usjj&_nc_oc=AdnTDiODTE5XIJ7yRWVsCVs2gQ12WRcIbZaM9AKmGj6v8C8tiqZWZEgvA-gA5BgT8ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfusM6mwrs8gvMoKz3TZH6zNCDTlH4YNkLNxlNRZj1lrSw&oe=69A6BF31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MzH2nH4zzgQ7kNvwH6-jmG&_nc_oc=AdlPd4V0NwCGQTZIYEZ0Mn_b8-Pjc9V7_fQXfF-vwAhOQ8nZHhAjc9oXb3qDOskoh9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfseP4IkjNuVxTEZqNZH0Dpfj-0sq2n83B2-CSageL4IRA&oe=69A6C828"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kg_DY-Us1EQ7kNvwHqIkTN&_nc_oc=Adk_njxlcJMxsldyA0F3L8rElVuFbdrhT7KlSnHuw0k6g0jR48PY2ts-AUnp7Jq_PY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftb2eJaLUWNKV_fUF8gcigppwo6Lu5VbeS0NfTSKD-KwA&oe=699D934C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqnO-x8W900Q7kNvwG_efVt&_nc_oc=Adl7gNvg0SW-Q8CZiO2YMlq5m6rzmjiuLp-4qVH8m8PlK004I_9c3pkM30Vk3Ex75JQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUitt9DmuXH-JGqa6C98EMIkUi0GJfn9Gd4gBd8GluIQ&oe=699DAF2F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI7mDsXbsS8Q7kNvwHk7bhG&_nc_oc=AdkNpuxKttBnWR1gbMKC6GPIHFeDdwEPrUVYdBGV0n-eWuKSOsrP_h-21spUt6mqMN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1Z4kku9hSTvBUmPo2tsPTfks9v2xkJLKUbgdX_8_1Kg&oe=699D9E8E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab7-lC5Q7hEQ7kNvwERJSiS&_nc_oc=AdnkUJ892AZl2E66oPT1h-r9vXroEbghwNalCMy-hTGep5BDBynkImfKtLTTsrcJL3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspmlmzQs3HxE7Mewi1l9-2SKQjU-tEkraP7Y4QKmIk-w&oe=699D84B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQbnfqXCYqMQ7kNvwEqpkY2&_nc_oc=AdkCfJPDfjaPeQjMdZMaVyDgPhGqx9pxOblR7Rj3pZgOfcCn6GeID8a1YKZJ78q6Hj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYwMdbVdzdwqcmAJ1ImnMl3sUpKVpOmrdbYJvvqaLArw&oe=699D8DA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
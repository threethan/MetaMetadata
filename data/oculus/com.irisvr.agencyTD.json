d": "127991675991805", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9ZfvAoJTxwQ7kNvwG9ndxf&_nc_oc=AdrveFUjK5x5zlc-TCyhFrFBIwNkivH173HGS6nKxs15YBeiPNPzwFdMx20OnLMjo8E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FUZ5tOPA-zitzOZlOSfkoP1yuJCieyYxNKuONMdUDXg&oe=69EF504C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms6KpLMRJw0Q7kNvwFjWhVV&_nc_oc=AdpUwJGXm3W33OPWoftdLXVQLDeIB5YquaiFzuol938cl4rd-IjmOjavYTohJHBuTx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lHLA68AmMnHpM-4nI5f7uKNLEm2aPFLqPtVGD3KvtNw&oe=69EF6C2F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6_SiQym8r8Q7kNvwGjfS07&_nc_oc=AdqvTaoH5se_uYUCy8wWz9gfSbQX9xnBbRoMU66ryhyijT1S8ytZidGPSt3KPyyhoQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QfDOjJzgkjslRTlFhy3q4hr5rd_9Mw9nGgW7fpZUxfQ&oe=69EF5B8E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg86w3HPHnMQ7kNvwGcRxQy&_nc_oc=AdpuRFhhZ6cR5CPaU_a1PhKSDgFNS9Znqu--tmUi-PIOtzEYG4cuOuGAaceiYKrj6co&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QPZ3CmEdlL2pstTKD-1J8F2vcKhmNzuF295wo9Sc5gg&oe=69EF79F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TfMnXWxnckQ7kNvwEywoGR&_nc_oc=AdoHrxEcG2iIkiMEFjtjn267cqx6Q2FBQHJUptxrJgR4sI4JraHOnwsycUHKR6uh4iY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01Kmw0QVzQcKfNwgypjwn2w2WRvINDDgV2gbj-3_lrXA&oe=69EF4AA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
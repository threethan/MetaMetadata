d": "127991675991805", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AtP-swX8YAQ7kNvwEfiEWW&_nc_oc=Ado1HXJCz3fr6ShpzGlruMMs5nlQWOvhPlody5_Yw9p9S6qQ_E8T11LrW1w5pGjLZBM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpYmValisIDiT-HARruTiFazmGWxSgBnTQfbj5o_qNzw&oe=69C3CECC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIYii1ENTUsQ7kNvwH5erjg&_nc_oc=Adp4UcrAaSW8lw4wzbfHrBXr5iVUEe9hsiuNzgfdkA4MGsEUaAyIjZEJBmUnRsZTVa0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCWTmihqBYb5YJD4_zFiwvt88Qex1PxC55dMcLwix1JA&oe=69C3EAAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6_eB4HIOXIQ7kNvwFLvJbY&_nc_oc=Adr1a-PpYX0BZTmpwx5yr7xxGWDYx4P6dBjYEF3-4-kbyH3-5Na2fRtixFiLsbecS3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXr4psgl_xiWsPvEkMbkX_vLzWzPsGEHx8uH02yY2cHg&oe=69C3DA0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra0igC4P3MQ7kNvwFLT0DV&_nc_oc=Adqhm6W8wVaivEnLPm-x5VZMitTYCKy5W-bkteeg393jfTkn6TfKzDf4oxLMHel6Pts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3ieyDxcDFtgg782Q-h3uhqu-VOurRmkyk0C8g4VA0ZA&oe=69C3C031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3u6Ags--sKUQ7kNvwHkmPbx&_nc_oc=AdrszzRvGXi70g_5mYTzXtzgGrgeCcjMqcp0G3iJWIXaVH2g_wnYYfmNqh_m6H4Geh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDJW1gZVepuISGg67Dy9qOrlHfzE6CXNQ5sXPYZgJE1w&oe=69C3C928"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
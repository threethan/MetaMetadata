d": "127991675991805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl7LlTF_7fYQ7kNvwGHjBRN&_nc_oc=AdoNE5T14W6k71nLRyHLu_B4AyVAPQC6SU5_40OTFTk_4d4aRRMH6KNHf9_ivc-Zg08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ULPSgWhsFo0Q0HLTMo5H0d3uFWac5HxtsvSZxdMsW4Q&oe=6A01C54C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcMfBSWN0VYQ7kNvwF6NCqJ&_nc_oc=AdoYFTEOzOeDK5GpmKQB7yN4TNDeXM_M0bBY71muywtLbeQAIl_cuH15P0erVl7Pjek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Cv46_naQyYmUyhXHX7eFyPx2_rUtm6kXkVJROHtiorQ&oe=6A01E12F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1esxHNovRmkQ7kNvwF76IX4&_nc_oc=AdrJBXHhPM05Ukbkt1zzuFkMmM0Cfo4KYWME2hX7GGK6-f5owy5YFavvRx223vUM_6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HUPUeV_UEcghX5XkpH_wx17DDvbkAksRbJdy1gYSsHQ&oe=6A01D08E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXZ6x7HrJy4Q7kNvwHp9TuS&_nc_oc=AdqFiRQtPeZd9coBjdr_JglLhe1kxLxhqDh00Z_ChdvjIiWMQY0lCp6jg0QGlO4kEcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b1KfMJu0PBBb-vX4dKjzURhRXG1jngL-K1t_xHwk8Qg&oe=6A01EEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvPbfM_eglsQ7kNvwGwIvne&_nc_oc=AdoOYVy27pk9VdBAAmlYf7mxab3iKh5WP6OEQ84LbLJ5KhLCNKSXma2XZCwXMj7L7HY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zDtlC_VRb9nEUlC593aaX5NIiVtdufgTPsSA3aBvVqg&oe=6A01BFA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
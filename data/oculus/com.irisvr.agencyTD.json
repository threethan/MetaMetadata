d": "127991675991805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0iZQaLkU18Q7kNvwFsQcY3&_nc_oc=AdpHWRSOOlvfho86Bm7jiUJ2ing2vZ1ALM9EFzTDjwWXBjqyF7_FNYPGL1tDII_JmZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAo3aG5mlmpighE-e1-9Nn-0oL3peWqElRkirRNPhZ9A&oe=6AB0038C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSa22-xQTMwQ7kNvwFPAax4&_nc_oc=AdrfzbUiPhYjquEutnClgnv4X9tmFpfsxhnM0M6jrZ92hsRxBFAlgfizNmQTfRTa_Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImsbTIQZPZFVQG8LwNVG_kF3DczLbMmRhiT2RkiLYNMA&oe=6AAFE72F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVnXR5Vv0GIQ7kNvwHqUdk8&_nc_oc=AdoyLcBVUof_oruh1P8rEJGcqCF2lTugrUgxbOQl1-e0hNnzrgNCYwUusjSzqbqD9bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJstHUc118e75As9POvlc1C85MQc_dn45TQknx7YFzLAg&oe=6AAFD68E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv990bjkKXgQ7kNvwEwEQ-_&_nc_oc=Ado_PctLCkA4uDKJTDg9hbYo8fJFcA9zq30rfrkhj2uv5QkFp2zIFtIfRDPCKWFbxJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6yWjkAk0vaMu0v_Mz3P2C2SN_x0m5DycSFVveRspqlg&oe=6AAFF4F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_p68SDY3lYQ7kNvwGMIvgj&_nc_oc=AdpltBigs3Vnx-TP9WoOblv-5jn86waPLM8QjnaxFW6yBfrf2doDxKJYm8lU5OZurvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICLhY-NG55YDRS9U6XtvKd7l2iPiYOKRP8MzqRyAmYXg&oe=6AAFFDE8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
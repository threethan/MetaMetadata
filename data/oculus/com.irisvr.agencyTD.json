d": "127991675991805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qCxthMbAGIQ7kNvwFh-shC&_nc_oc=Adpg_GFY1hVb6sbUiPKr5B-rQfaDBZDn3oDrPaIXjYAGBAeMgqVqIAKtkmAG8I_PkCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe5vf2B-NpsUZazvdcblv1BdGIboqPDxe9ipjPLplAsQ&oe=6A52690C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5d89tFu4AAQ7kNvwH1kLEn&_nc_oc=AdrOaH-V_98XXV3EkmBLxFIB6OvS8pNp0DH_jMgfuidoOTxfxtnYQK8S3EDhlMcN2EQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYsZMzQL2ybA24b0QBxeybQwbDUbV5_e9Ga7lqp-yhHg&oe=6A524CAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_aTrNiw84IQ7kNvwGS1txm&_nc_oc=AdowOwShMuBgkvNnZGJ9LIaBUlMmyGdASHzV2GwjwPMitbVwE6m9kczK1WKpI9atbWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVKVk6cHDui76Q3DRXbuT7esD-v7XiBL8QJgJe-H_u9g&oe=6A523C0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFXSr8OYQFoQ7kNvwHsHCqX&_nc_oc=Adp5_ffZSoMiYjYwPkpG6a7D4f_zUs2j6ey-yc3KUASIcFORmhKxXBX8AAtPAdli4e4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPH7-RChCjA4ub8qRr091f-pSAbzE7md5guTNGSv5sxg&oe=6A525A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8CnnkNqEAYQ7kNvwFz1s0Q&_nc_oc=Ado1FCq3FVp1FlxY8YyWand3tCrZhUFpKkaSyksmoPELIm202fwHQQvPaYWgGImFAbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9WAU5kjBXUKy6BIzuJMPfFEIjyVfhEvtZsr_C0efirA&oe=6A526368"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
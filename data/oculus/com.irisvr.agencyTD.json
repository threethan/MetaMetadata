g", "id": "127991675991805", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM6Cv4dln4IQ7kNvwHIlmsn&_nc_oc=AdppmSk466qSs7OEu4x0PHA5HI0woJ0ZV9NtePDSU4lYGPnkLP66PaKa-riLsrpn_6M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dh47qakjkyQBB9zwhMXUnPKLoXc8_Qo4OZZ8huwhYww&oe=6A22F30C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k6Me3hpJsgQ7kNvwGX9yqd&_nc_oc=Ado875mM4olaTSctVi7zAIJZg1dTiHjXRXz8NRgsh6fEsmLxQ8EEFdcDn5QrvTo4hgM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4sY-2rPFSQlFQgO3ufLx7DajPEMpmI4h2VQ8H9rFHFA&oe=6A22D6AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2JeLlzwTnAQ7kNvwELhbM7&_nc_oc=AdooGNWsA4CVUJok9XPFbTWYVQoF9NCZt0K9avsIXELNF6_QD0nyjSi_dexrYGLJD8U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G6_c3uYNP8Tk60suLG3V78oZ_nTArTA7H7QeNFSpibg&oe=6A22FE4E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQZu57ZvMCQQ7kNvwHSCHlW&_nc_oc=AdqFw-2o5IUqz3tm277amLT2efeTAiKXAvjOtNIfQWpjBF3LikfHTqX35lJE3yq104o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bCADyN-nHSwfsWdAQTlF6MBT6s2531Ue7ORfvtDoxUQ&oe=6A22E471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T1rIN5UJ-wQ7kNvwHHlChW&_nc_oc=AdqldU5Eyq3WITGEVVXJ3DzP7HljPpbnGnZLTkE6Ao4dloMuh8ILmHHWQKTKj2csT-o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ecuOLQfhs_VVdu4At9Z6FVroPinwth7Ee5DJ86XOq4w&oe=6A22ED68"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", 
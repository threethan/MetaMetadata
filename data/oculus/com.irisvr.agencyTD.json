138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEi4CKVn5zgQ7kNvwH25Srs&_nc_oc=Adm5kQWsxLT94br4sWsP_Dql81ay688Q6pQ3__kvl2sYwchMWPac3YeoFpYKsRcjC2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvN4SkAFB3gi0fKrZAD0_tu9yA71-SOyCPNoqZ1-ARn4g&oe=69984D4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AReQUyaB72gQ7kNvwGMQSvM&_nc_oc=Adko8S-ZKSRLBUAjb1z4JGXx2qchApFRjLa3nGoNKaGSj5VaVPZthuauu_2HNSa5Trw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu4jEJ1BYZHM7ZDRYhfqESdX8pvZ1IuYpsnYKFojlRSaQ&oe=6998692F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgH0kUQJm8oQ7kNvwExOoIM&_nc_oc=AdlwecKaHqhuDaHHHmf8JYwPh8KZQC8r-PhiLOVhgdGQyzcR3pZChaFO4J4OP4oXTCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsfoi0nfJUaD2zdsa5aKtDX7d7WoDyyCIsP-qBCLG3upA&oe=6998588E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K50-6tiuCQYQ7kNvwHFDVg7&_nc_oc=AdnfzAAx_Cb_HayHYOUG3otIrcIFM9O5OSXz94B_wodubP8hYuWgflPaWLvR6LxD71w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvAlJiWp-UDVWc5aetWKRySyYTc8R4vqVwYIvOFcO_jiw&oe=69983EB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50uLQren0GEQ7kNvwGsUavx&_nc_oc=AdlFN7dEMTVYVRa_U0RGMAWcifCHV-eZ6LEfl0JHGyLOkIdrG03pN_uF1eyAUHNQ1fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs5zwsXyGXJLqP27Bo_O2fWesPcG8CdZK6-3xPtYsNDFw&oe=699847A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
d": "127991675991805", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdiFk0CXe_QQ7kNvwHW3zSa&_nc_oc=AdpcCRqSt_eDRYHTLj5kPMql-2FhD0YZU33eWaOUQFW7DHCWJEFhK4NHsji8zLVVDHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE59LD0kNXqra6scs4xklcVgQNB5KAa8LWJ3HNlaLYdA&oe=69CFAC4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqbapzihRawQ7kNvwFscjYK&_nc_oc=AdrY_Q54McsRZKzm5tYwEZYFm5j8BoLIeGM3LiHHpYoWDSA5ybv_G_5iYRqGg-VDbVk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT7vdJEusyiKMWU4uhTls1b2QgU1GM47kifL4tfr-zPw&oe=69CFC82F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5diuOb28HMEQ7kNvwE6QvGQ&_nc_oc=Adqrjp3rKgvdEtehhRnx-dNwThPYLGVZ_fPZyaPTEDXbjGdDX0Lwo3rGF5FkdazggUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv2pbtg3uZ257pO1S4AAy6gKEyvodFX-Cj_gxL4jKD1A&oe=69CFB78E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWNHnyi1x1QQ7kNvwG51FT3&_nc_oc=AdqNxWPzHIJWkLWoE_nUMQ7Cy-3Ke9TQ_kOzdnXRPEcu3VWPZDUvUJneu8VmG_1yzKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAeI9SkOYeNggrtKUsKdYKEa-x2RSbJoSI1jITaPc1AA&oe=69CF9DB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tWfj1T-MYcQ7kNvwEw5IAw&_nc_oc=AdrH4a_K8OKDrKLLrN6tk49V4T1CqjDSJxKgvUfngD3Z_7wKerSsBgcT3Ds1BFALfHU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKxjMAJGhGf9eWVyMkL4OYT7y-EplJ6heO3ZFufYZ4Xg&oe=69CFA6A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCyby-e5uEgQ7kNvwH1j0Uh&_nc_oc=AdqZIdknIp1qoL7xdcokLwAWCkFuCXEFKoIlx51wUshpYSx5faJ952RKmR40PiAeEhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDaOhWwersQeLLmG8pUz6aLQFremxrZs7qO0r2id70pA&oe=6A689A4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU-Rw8_OqroQ7kNvwGHMGxD&_nc_oc=AdrFFAtn70-2SqZe4CQKTEVFKn7H7pw94qRiWvuwQqv71buj_l2aYIyqDhXSnVpXMEE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBRnI8lGwk7AbaJJ3rU2POZ5WYgqt8gKWBIVrJVMaZPQ&oe=6A68B62F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w_vBLsF2KQQ7kNvwGJoM-p&_nc_oc=AdozonTuJ6VaooZSusyL9SAOsUnanhzxUeHsW1fKvIkoCbaiDPJ3xpv7tzS1pUvOvHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrMGCCfmIagaq76pnm5FWC_w0z0QY6PDdfoqzyvNNHpg&oe=6A68A58E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcOKtkX3XvoQ7kNvwGF37Uq&_nc_oc=AdoS6KcK0UOK-Y8Zpy-7xxqEqrld8VrzBJA2WgMdmM2DdaPybGV5jle4DS4ynk5FDsE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXT-xyvCUbyHmednq4AgrFwk8aQSy2HjuVrJD8ug6IIw&oe=6A68C3F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vNR026eymQQ7kNvwEzKqKc&_nc_oc=Adrk43txsKnK-it1I9olkhZn6U41S2ZXCZvGIfyo5kuH4k79c7yXNy8C2SQt7MYFsgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9PCtHFTussUxFRsqE9b-8EgLGLMcqbjMOxcXzMg8lDA&oe=6A6894A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kg_DY-Us1EQ7kNvwHlqQAA&_nc_oc=AdnJXF8eDoN85ZKMdObJf22Lu9hNYGcl489JZFF4bQFLLuI6U_u-IeMzetz7JFHA56I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv97HLipWRabZ_4lt_qBvl8r1Ufhnas7_oJhgtzo6SrFg&oe=699EE4CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef5QA0pTH1IQ7kNvwEjI_BT&_nc_oc=AdmhLRU1_5fAdZhUP41BPsfUw-EwArw2E4_kcXj5C1YMtVF25iqpIvAhWJATwoPU4io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuTiepU_cBZs7IxkyVyq4Y69-JIWqMS-FEM7Ea2d7TbWA&oe=699F00AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI7mDsXbsS8Q7kNvwF64i4u&_nc_oc=AdmHyC4IQwFHQPrFxsAculO0Y_nJ9IeWuJN3844qMbC0WBE4f4Lf2EvtMre_G5PpKKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuogh13vMrG-TwhEskQccsElu_DHdfBM8EK3P2sqXAWrQ&oe=699EF00E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab7-lC5Q7hEQ7kNvwFrmik9&_nc_oc=AdkvUE0S4KpOj52UocHBa3kt29dkcETdem2C3iwy8kNOTFjgKccVgXy8XrkDAs0O5TU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftoDMnrj8hLA7k-iGe5WG2gqoLlqp2BO2P0Ogw9c1kqTQ&oe=699ED631"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQbnfqXCYqMQ7kNvwGDzefc&_nc_oc=AdnbP7DMzwcR5NWKsPMb6neOGZZ2u6O66ynng2YKEqyTSfM-zxkzpjpkyFz4DXBZxww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJlnOrT3m-4x8XAffaJiqHi8tpJJkNvT0dlwjtQdSCYA&oe=699EDF28"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
ttps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2y7YMEYHygQ7kNvwG1aq7a&_nc_oc=Adk1DeukdOQ2jW9cQL9s2kI5Vc_0aCymSeS1GhLDqG28e3xzk9LXFsqlUS43hbWgKvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwLBH9ufhS9G35gNZsINf0L0tumoTKC1FH4ZqmHvlspA&oe=69A970CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1Tx-WUeu4Q7kNvwEuTqnH&_nc_oc=Admq-XFk5hvFHiJJBseabV2AhieSoF8u-GF_nqH0oycB-4j-DG3hVWxHj0uB4n8iCyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsUVi6T355wkdENKfJ2rVMX8o3e6ZnmuGipSmxeJwDz3Q&oe=69A98CAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj7KZnw4WHQQ7kNvwGKrt8z&_nc_oc=AdnzZSCSWvwwISkyRpGidS4PcEUD5C00brzKxTIryr6IAeNniLkStFTgcA6EVwY13a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuQo8AMmWOcPcoM5zkR4GB2EX-6HmK_ONub1wF70WxiGQ&oe=69A97C0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML7OhC9HY9wQ7kNvwGhGgPH&_nc_oc=AdnBH9Up_96DaNujp24xDvm4DHaSSRB62L13FoI7SaQVP0WiYuxDyTqohi4rtFDfQHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftNsbUl8vvjaseEJ0XX-Geu200VXzmWBuS0T3iB_uXEVA&oe=69A96231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrsVEjsY6bIQ7kNvwHkMDO7&_nc_oc=AdkC2nONdF7-ZoyKHGmBfmJjXoXZyOQsmPkE4OvjmAx57_KrEHfblHc25Mv1l4sgz3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2zrfyfnnKNIcoMcBa9Rwp872mHWHFMmj5609wXaxpWA&oe=69A96B28"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
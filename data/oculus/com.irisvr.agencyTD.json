d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q9YFy4MMDYQ7kNvwHIZnI-&_nc_oc=Adqe7A4txa6yNriFRMflj0pAbD1hkb3F4-wVcQcTUu6uq-zQJAVrz4YGjR6i8FFQCBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PQDSMoVe3kjf4Ss6ryLYkzSuWRxKugUvHzJ2RutnfsQ&oe=6A2ED08C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP3qN-eAIqwQ7kNvwFMPuLj&_nc_oc=AdoJ1M0Zar9lUYEh57ZHdqsksDAQdO-NI3me6o9MhErIOJF2kU31BrYk0wvo2mjveto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s2EHKaUKGyoa37Av9_aERv7A0FqNRp6QRiMc-wJ4-kQ&oe=6A2EB42F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNot2WpS2ZkQ7kNvwHYEe--&_nc_oc=AdoSxw4K5QKjtExrDTRsAt13fkV0tVDudGytoaCOGCDYsQ0H-0xuuuGZIk426VMdddI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MKRpbXwoSf5EHc3SNP1AQo-0OQ0lerBvY6puMkZPvRA&oe=6A2EA38E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QiJW3DL9tsQ7kNvwE74_aO&_nc_oc=AdrEqnM0WQjGKxCVp8rq_u80ou3nkIR6CPCOK2yeuzbjljjhDr1K8a66kbk2H-3SssY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ESsvtRI7l2s8qr-iUJCwunvaFWWP-ZdNsx_XIXsaPIQ&oe=6A2EC1F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvHcR_tOOrEQ7kNvwGR_BTp&_nc_oc=AdpiOeM4ksJFgLEUnrzFjljChGVPX72QitTRBmjUla-kcI54L-5AJjM9FUMGJNU8VHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xLI2k3Ym3V_OJ2jK2If2vdeyqCDF5VBcGahc1MmT-TQ&oe=6A2ECAE8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
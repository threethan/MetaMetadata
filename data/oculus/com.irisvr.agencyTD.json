ttps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZFCualRwuEQ7kNvwH5oiLG&_nc_oc=AdmZtuF2WW3gYY9LRZhW_IefA98V_ElasVxDOmQhYGuXgKDtk0Sqv_W4L62eXsdHBKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxe7h6E8-PzPcqEoceEoRRplUzDN1oyH3Jk3p23QF8F_w&oe=69BA944C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQG01jd_wU8Q7kNvwEH4VSp&_nc_oc=AdkQ0RiZSIcVBD0OeMa5Aei9I2wXARjkWFGXpJBUf_6-XsSoz_dx3-uXedYr1N6jvYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2UXF5_WQdtObQltK6SIRuQfjNYlmTuya2yDg7cJgL9Q&oe=69BAB02F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBpGKbCWCokQ7kNvwGvOd1V&_nc_oc=AdnTaCZfy7rn-x7cDNDGGqJOedrL0_7lrHP2r_rCcymdyJsHCRjuokEwrLeOxypH6Ss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgE3zJF4BeoeInBNA_g4ugpgbq-ixv6trRhYMeh1MkKA&oe=69BA9F8E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHA-nCEA7QwQ7kNvwEluijP&_nc_oc=AdnZ1GIinl4OWwHyUzN7MSERL5huQsxgzq7Kbx8e0A5MVhrURYNdS9hIgrxdKAIXsmM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxcpxvXH8rvl9BJMnMIv05lUAxfktYYKv0N4zwapFU-w&oe=69BA85B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbUDwtDhOBUQ7kNvwGy3dcB&_nc_oc=AdlksoTVV0q38V0fhuYvYdz2dl8AHNYqoXupGou9LUJE7gtXNr8LagBiReeDJFNBym8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDnOcce871TEC9J6D2gkQFdz-2VUF1jJDpi6Z4bFdg8g&oe=69BA8EA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
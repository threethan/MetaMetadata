d": "127991675991805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILxylwMq0j0Q7kNvwHybw-f&_nc_oc=Adq28eVm2HDqnySFc0JuC7b6G_GNeoeiMgE4KGWltkPUe4PPpTUTYm46q8YhJ39d4A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGHqaxlGzsHsSxwMKJQk17VJqIZLdHNS4zj0l6F9fxYQ&oe=6A82F84C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3CAJk4VPE4Q7kNvwGJRBC_&_nc_oc=AdoHEt6iY3x703NN-9bsp-jQvSLg7GkLSO9_wVez80t62YNonThLW1eSrNkDHrgbjwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpbtFWkBQEeBmaUuZztIuTCUfpAH2U0MwW-b6_KWLI-Q&oe=6A83142F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbX3VWKuDOgQ7kNvwF5Qdu8&_nc_oc=AdoNiGQF5xBFSZUAtNkJWgWwY0XMNyW0373PdRdVgBe18UdlPwEUnJY4NMiH3k-8BRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDSPcgBS7WgEzu6_E25IzpXcumko1JKjxAvgi5vOmVug&oe=6A83038E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5h47SrUNJAQ7kNvwETG3Bt&_nc_oc=Adq3-kj8QIHSXPIGM1b6RIxS-CCHzu6_oUnLcofH9IqPUC9MLdo7xvXMM6fozQQkJQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2dFcIIuMSrWMGQDaUhG4fnmBuVaLDB19mdK4TB-9dBQ&oe=6A82E9B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CS78CZgbMsQ7kNvwFtu48a&_nc_oc=AdpRLEQ24qMwRcOncJzA0Iyd0mD_yrd7aEE7ZtQRg_idb9oP3zHHbM7Bk2m1eCG_NCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjlvnIYMjeLW90mIDUgcySdV87Q4-rxMN-CWozVumKYw&oe=6A82F2A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J20Yl7Qw9oEQ7kNvwGFCv8N&_nc_oc=AdoJ_uIc7wGENGlf21MC2ENJkrRFx58LWW2y5_JdIc_1r6w0fEQ-t8eXT80__fpUJJk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByrMtKwyjI7jWud-Q_CxJ6AJyMXutLfno30WSljRA-ug&oe=6A4E3C4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAEyfF4794QQ7kNvwG-b6wt&_nc_oc=AdqEX-uIezQIVlHcVzFb-g4V_JXnw0olBgS-lgdYc60HL9WcfH4ACz0LwuqgE5Xo46U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtHbpwSOTkQmSQEeKkZGsD9RKtsoEKuqg5urL_OCGPfQ&oe=6A4E582F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVGkspnOd1wQ7kNvwHcWZBK&_nc_oc=AdrNttBgtjMYvvEaqWnlaXv9qnFIqYVyKPEpRWqyvVDghDIg9eXnRED6vyETe9jIRiM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp5I1scRceluiX9jxP_dDOhwPpLanCb3eiXvs-yXslaQ&oe=6A4E478E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yFyuCKXMZYQ7kNvwFq39Iy&_nc_oc=AdoCMrdBqDjLfHcVVClGVIexj0sxYw_qLRRoPOdw7aXpC9ao2tzz4M809eEtVLQUkXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwLL6drPsdw0z2a9Qa8I37RMZU2vKMiAVytiiqylVEQQ&oe=6A4E65F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kA733zw58AQ7kNvwH5dJC5&_nc_oc=AdpA420HG8PR5uNx2AcN1_WtYXxv1Sq8dhXFjdVhPBi4gVKoPgSZRiYAVfJPzN29HVI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsPXfYEZ_QBeXTbLtIyxChIFk1IZHX2W0b9laoW6KI4A&oe=6A4E6EE8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va7Bh9Vf9ZoQ7kNvwExxcMd&_nc_oc=AdpvhlxmOgkxKdkbHDxsEOFYCPCQZF1E7rhp5H2Gf5lBAMvTqYRq_J-QKOjrrNeT-GY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBP4dQGECkKWjsTs9E9EvlmVFiililBMzYB4FzxKixQw&oe=6A90274C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyGBZPLlEA4Q7kNvwFnnQo3&_nc_oc=AdqaNBFmTVwJdpMY7jjAGrCp6ba6LFtxKwEN7Tc51pt6ANRkbwXjxOU0wWfWxVtHKZs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHim4H9AoBNCgolug9CHUM6nh6VEna9HVQbdQyzFcRX-w&oe=6A900AEF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MaJU4YQPh4Q7kNvwHfm6J3&_nc_oc=AdpzPo5Ur_ZqXQ2q8v3smDC-31s3yW1tQzMhbmwXhqX0-OPxkyG8AzdE6DtLH7_IZbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKOHgd7pQzSpSPjixeU_7P1VRoZUhUG5QknGQJ7Sf5PQ&oe=6A90328E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHrTPhVDeT0Q7kNvwHfFZ5-&_nc_oc=Adp4IkCCwwmgWtbRQr_xSQR6ywqmhwygRnCu2E92oksM3ndozpMFIleTr96ef05ub2o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ619LdDxhNTtjLI7M2Hrh-_K7WKtrCjYuKlZdpFgRiA&oe=6A9018B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2S7-0BhrB4Q7kNvwGF6zmL&_nc_oc=Adqflhz144dutKy4IOB8RAuDNy6lTo6kg1GIftFNGIks-S5e2scOvZnOW6JwuGpOvM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx3VrhGSyhXaRJ9rK7ajq8yUkM4DYAl__lLxheCu6tog&oe=6A9021A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
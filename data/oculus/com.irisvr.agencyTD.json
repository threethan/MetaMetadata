138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DecVY_HWOIQ7kNvwEqgWYp&_nc_oc=Adk8UGQvFeMkC2qBV3ADjeaLHayz4ljvtVGQWSmWww9G3qt1IkuYT-_EZOqr26BIPVE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvOpPC00RvcaaqlMk-BBA2cnZimGzinB_-nFhxHBlI0qA&oe=69A187CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef5QA0pTH1IQ7kNvwHGZ1Z_&_nc_oc=AdmOQHbPZ5hl-c-_dP5LAIvx5i9MHN_i0YPkh8v4YPuXHQj2iK7xYq1UrRy56EjyyqY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsvtI5o736PWNz-ZVDRu6c-yXFlw_nVvc-KOn0h9iX3fg&oe=69A1A3AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a58VMKhu-vcQ7kNvwEUP3B3&_nc_oc=Adkje0arMrpQbpClP07ISFGVXxy-1JlwSU-tlwKunye570mceNUyGNXNra4MNQwXh8U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft6g2HPonV3hJMKLgYPnLBM2PZ5ThgNrmPhHS1Zne717A&oe=69A1930E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw-Zt_G7iCYQ7kNvwHD9dP_&_nc_oc=AdlXeeh__vKjHXlNZQwsNqOff9zZZYdFPk_f48H_sqX2Cc-eYYNkfQ2lLapKcE2WY_A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuR85dzQxWVHtrNBFJ6L6SMdSQZF7XVNr6szuudL0X24g&oe=69A17931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrs9BkvYH04Q7kNvwGOQu-9&_nc_oc=AdkxrwiwyjFTj1Sq8l9TaPl8K23roMMQJiSCld70-1cLMGmLdozind8iP01rGQZzHoo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftgYniaV6Rb1DXRiPmG95t5hxK031CVeMKSuz5EPcZB1Q&oe=69A18228"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
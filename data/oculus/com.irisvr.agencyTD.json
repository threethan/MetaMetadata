Uun_eSgYHs6ww9YCEkG6fAE_RhiGaSedSg3bA3u5J47ik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4k91m8s6PqvKLrk7CX6PO9NC9Ht6vfbUeWwixtufstg&oe=69C147AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6_eB4HIOXIQ7kNvwEHXG7u&_nc_oc=AdpeECowTmscRFavaa_WQykrOk4vfzCh4RfGXylhQjIf35r3olo5drhA9fxVOsprmHo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrzBOrEj2CyDboCAUF-gJQLnAmtSYiMVuYW2HpoiWOJw&oe=69C1370E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra0igC4P3MQ7kNvwHLtHas&_nc_oc=AdpFm1rsnuVr952oJ5kf6hI9JDXsi5X5jytNy6F7Q-uGa8X7JASjz9xGNb2jjmP1zKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyLWSJPLdL-E68d9OYTvhalMDuFUmdJe9bOhjuBYokkQ&oe=69C11D31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPUSXmDkCh0Q7kNvwGcy0m1&_nc_oc=AdpvAbO2r80XdE3zCzvwjCAIrpuTpPKcFuEo3P87UkJTdD6qcWdkeXNOTawGNs-8GiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQWJael90tfKGUIXokLiZcSVOLP5wJQ4DmZImyrZLvsQ&oe=69C12628"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "284073983855141"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "343158500568319"}]}, "baseline_offer": {"id": "343158500568319"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1622655960, "status": "PUBLISHED", "id": "343158500568319"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
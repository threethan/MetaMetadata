MRFvwidGXQ162T4o5eln_mlfl89ffWYYCgZedVesFa94o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCRE2tONwlmmCqJUZYa7fEte8v-TjFA6vXdqYQFXKYDw&oe=69BD532F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GyPaCAmSngQ7kNvwFRTRQn&_nc_oc=Adm_ECkwBscUR-jtBx88_-XhBE2skNLprkrW28EhUpRWPRzeAtaQNn_1dNLDOLv-iCU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwS6xtoXo_2vpZ4gMvts1oGSiaqyr1OttJs3wUSMx2gCQ&oe=69BD428E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvxrG0EQPnsQ7kNvwFW8oPs&_nc_oc=Adkl9yA3g7ektPc7IICXhS9jmv7Z4CF8PBwuy5mWhr1MJBheu5Or0UJCNCFurL_FNN4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwZeeSTUYbHvt4hJ8wz7RVJbwavCBIaA8cCQQ6gwZf5g&oe=69BD60F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y406V4gD9D0Q7kNvwE-7HPP&_nc_oc=AdlR1HdbAcY_t-GzgRK_hPSpDrRMM7JHdxU4ksfB2grX7SjrMsl_iuhGfKlmaZVR3ZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5kAp6XssCA1F5LtZDE-h49ch0MexdpKlRB4c7rW4vCw&oe=69BD31A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "284073983855141"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "343158500568319"}]}, "baseline_offer": {"id": "343158500568319"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1622655960, "status": "PUBLISHED", "id": "343158500568319"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
d": "127991675991805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phY5Ji-F8HkQ7kNvwHlOHvs&_nc_oc=AdrNKZZ4QoCas59lfY1s5rPpmOP7fgKVerNIF1PTnpDULt0koH-04eug0WxU-jAkuj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVqIK3PrPsQF5zFJrxmMeucP4rPMQvHVi37VIG1k30LA&oe=6A7477CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxCPLiFecicQ7kNvwGITYaI&_nc_oc=Adr_Esq6FYiC2I5ICP6L2xJvEP1tU9gvNH23NO48ZbJXs9O-FnOD2W6pGhI5hFVKN4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtSGiDYDq-DTrct-Na5XwB7YuwSmu6Vg_DQ6Z-73UbeA&oe=6A7493AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjMjQraB3-EQ7kNvwFm_WpJ&_nc_oc=Adri76PyoeDn5pf2-4ItZZ7X324wy2bLAQ995JCd2IZcmek1ugA9tbxf0XoPsJzXTEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHivhhJpx6-GIn105jsifhGtsQuTwyxA-w4RmkZUOS9HA&oe=6A74830E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOQYhmrd4CAQ7kNvwGGh64V&_nc_oc=AdqP8BCN28ubuFrszbWCAOLvTU2-nUtzRiSrVSXgj1qdgNtrElMbwH2NepYDP1NGQGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXgpZRRw56xZiLSO6F69yXFKvL22n-Qf8S6t3fVqj-2A&oe=6A74A171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAfC7RCqw_0Q7kNvwHooOkf&_nc_oc=AdoM7cVlzXr8hsD7VgHFUqD_5cPKMWIht8B2jRNmeUwVMyLgA9dzOpqgdeB4dP9Xy2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF0gi6l4nOWBXWP7TzTU99aH-9qp6ovpRqIXcF1d65AQ&oe=6A747228"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
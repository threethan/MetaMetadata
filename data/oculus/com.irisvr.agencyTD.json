d": "127991675991805", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzakqafmcfsQ7kNvwF8vCgA&_nc_oc=AdoMBU3pEIHmAeizItIcrwN0IGrAYfQvKa_322cvh6MwyjECHQ7RHJdzJKZsMDsPl44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afywhnshv-sRiyFdGuYB2r_iOFU8PH4M7LQnkH_M8T1wuQ&oe=69CBB7CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXgo0HsPI_0Q7kNvwFR8boX&_nc_oc=AdqrmMweQ6FPJAUWdX93MdgCy_X_ITDqyQBlKgilcdOwga3RSyO_Bhs57bcFm9hBIe0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6-O93WZx-TEeH8CbZycaIsvQo9b9QIhqNYDVhpphkZw&oe=69CBD3AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot6IFqPD7lYQ7kNvwE_Fol2&_nc_oc=Adqv3slhy9dVTnSCMCouA9v-eSipQmFiH-HC9H7Bqql5_Q7T1koWUh7U43bKhstFr_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYerc-AwtvF4lALvKLXT8EnUmc00A8el4uMKoDrMlLIA&oe=69CBC30E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3-43SuJUXsQ7kNvwERbNvz&_nc_oc=AdoVMqYEgOogkyg54YEkBGvr6jSJV9XQsaHu1dPaNUaDd0pE4MUg0zZJOKG0HEsF98s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYA4JpFIGqb3hs4XRVjwhi0qMW8FNh5PkTH_bkk_RyEg&oe=69CBA931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHmsFVYDJ3kQ7kNvwGxRyFu&_nc_oc=AdrUnn1Bq9Caoxh9aek9c_z0crRvzD7-A59fWu7OeBjICZcm-yeUUIxFb6wv3odCEe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvjVU-wn_KHuTG8x-lGA2CK5G71yGrwh7-k3KaLJZxQQ&oe=69CBB228"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
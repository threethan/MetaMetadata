d": "127991675991805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyRr_2tnGzwQ7kNvwEAJEVx&_nc_oc=AdrY3txYkcLSxRf6jtOYfBhmOX4135sVVIUsyljpPYTh5bEA1d4rA0UX2WmTbaylCl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVfhPNGbXEG0F59ft19Yslnkwdoc2NXvI3dcyPCk6PSg&oe=6A6C8ECC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63CWWtZgfdwQ7kNvwFbXBDS&_nc_oc=Adrv7M3ybD2kvgQVl4NKiL_bSxqI_FhLMQPUoo_IdjNp5kLQ9MCVe3dQ5j5WHUBAS2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7MV_0bGMeS1R0i49tBaCsA3AXbdg-uGXD9q-bqPk0Nw&oe=6A6CAAAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLVTRaNg_i8Q7kNvwF1ftXh&_nc_oc=Adr1n9hKkWKHg2Ozaa-mHzQ8wcByUW1hDIpzpmIJWD5rcm_k61jWIiuzkNoFh_8xuUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACGxkpXFP6gGTVL03LANWi2Jnnzldv_5moNc2kK8gZZw&oe=6A6C9A0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1Irm3lmf9cQ7kNvwHdjztI&_nc_oc=AdpCaLli0wL9qV-EDSd2NFGeu9_FqrEFinZd4Upxbw9g9mFLrWYaz1v8PLiNvrraFIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH_4E5Mv-vor-l6RdMP5HUdfK7j66womdW7d_KBDZLRA&oe=6A6CB871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzKOgY5ajGgQ7kNvwFLuOLt&_nc_oc=AdqS74tnQ8hMPLYUw4_Cqp8-97zw7EsnlkUADnrWtGmpK5M7N7FpCCHCYA9kiulFRiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgM4_Uojzgdf5py1u8k-22esATAlyXapeMZEPnsdfjTQ&oe=6A6C8928"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
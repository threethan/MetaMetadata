d": "127991675991805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85KUpJF-48gQ7kNvwFfvUrK&_nc_oc=AdoVZGaZ0wNYDSbbeRV0R1Ueu-3h6LKW6rmOw4crVvQFsGtV99CkrpHwQEtHo5ZkRAI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn8RW9xhXo6SOKxOZZCBkXh9dXVGIsLTr0Opd8PmM4nQ&oe=6A9FF94C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4OTFS8lqK8Q7kNvwHIIolI&_nc_oc=AdpzwxR7UFavC2NyVNfZb0zUZw-Ppzzhobd46dgsQGmXhmnN8htimadpdxbWZ8ADT9M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInxhteh_qcPKT_mvTKRWoYhWYvbqpN1x6xPseAAi_g8Q&oe=6AA0152F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOQR2L1ljLkQ7kNvwGWG5e0&_nc_oc=Adow1W4sqgu2Qzcg1og7625rwG91XXSjhQfBOaVMXTnBMqX_TDOdLBDVuctshWyzLrI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7_kEohXAsuRIuPEqXM5uhkMsGNoW8HMXMEUkMkK4vvA&oe=6AA0048E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSTqKoQI2U8Q7kNvwFaoBZQ&_nc_oc=Adpx-40NyUvy15yVbLAZVdabV88xfO-7On_EIma3Vzr7lyEuQG7FF_-Wf92v2gvUdR4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGHRUIuocYIsv7J3VdP_Bs2VEyGljVrMk9pTKoDXHEYg&oe=6AA022F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXo0xZKQvpcQ7kNvwG4o9BU&_nc_oc=AdpnD9BCyOS4hPzlfPLyiAPgoQD8kh7R7JPJ5G1Frpuhi1BthlUjP2B-sAlXzMcAWZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqpvE8xdT92Izvaqb-pNOdZ5ZkQLzp2PJ2JfhtPLPSw&oe=6AA02BE8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
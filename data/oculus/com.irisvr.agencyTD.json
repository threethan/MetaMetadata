d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J20Yl7Qw9oEQ7kNvwFQEZUM&_nc_oc=AdpYVBQF7bPjTUIOr2COsYbSi6XevRw8ZD7safb7MdeL_hUrHK5q8xqRu5mlMpG3z4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAiSSlylQzmZlb14brUoXBbU5KNC0l2D8AcHYquHVSbw&oe=6A4F8DCC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAEyfF4794QQ7kNvwF7ldyM&_nc_oc=Adp6YgjZAkrzOm9F9HecyDAhMIY8ytpbEr0NCmPW34pDSiPn-y4pni6tLyen494YtqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa0kXpux9GmEcTjipirw1fgzEw3-fW8fTi58N-bV7OaQ&oe=6A4FA9AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_aTrNiw84IQ7kNvwFjMmlk&_nc_oc=AdolQd-DbxZdAIlxgSHLtGriVWGywLje54pr9DEIbrOBijbc8zKbRzG16f8FfDPb_gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAmq29b0LrxO3IyKDxlbuKWeBY7GwBqXzIHOiUTmKfkQ&oe=6A4F990E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFXSr8OYQFoQ7kNvwEDcew_&_nc_oc=AdoU2FedP5-nPPExmfGjAGESmj-263_rGlFslYLsagsKFHhhLX7UsQX7w8OWYqyuMbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPz04-RHsKHXyOV9ljyeYCebkpNipEKClHg7vswTwZ6A&oe=6A4FB771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kA733zw58AQ7kNvwFb9a3x&_nc_oc=AdqL9-P2b9aC0s-_xqYmuAF-6rhC8rmKVbyEufj7lIngcecYpBMeSCZgyPeXvS7BbMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ-OAa9xNDSfHR0bYe7zdVTPFyszytgSTL8lvkJCv9dg&oe=6A4FC068"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCHpheqj_5cQ7kNvwGlYmZm&_nc_oc=AdpemG-Ul_1AAzqa9njQXFg0saPUl1HJRHLGRvsYHDgQJReog09iVK-6-ap-VvjqCNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AQUuOdGJGQFDVarHHBW_PuiZEzL9gnYN03ul92pbwcw&oe=6A4501CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPkQdAllaTUQ7kNvwF2sbho&_nc_oc=AdqA9SEZFb41bgNN3knT9h6pdxDGfPin6RABhjkH29nas6RkxTTSwNn7x4DvzQJTw0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mm-mFZB9WvYw7GLS0CwasLruSektT-F0mOczF212lvg&oe=6A451DAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC9vkO_-iZgQ7kNvwGJWUi4&_nc_oc=AdpfNZqnGsoiFEQGAzTSmRj7XQ7Pos-M2X0BTf_G77E0cAyNAYHjuvFMr0sN0H-adrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fk6MdqoXxQHtuNhK5n6ozUI6m0V8DQ1NyHH5ScDExCQ&oe=6A450D0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n4M7-K9BRAQ7kNvwE07z5o&_nc_oc=AdrP22ZQYkjzZyAyUfGszr3SPri7J-YFgn_hJzsBNVb41tRSaA1K49NBQ8ektTvoVO0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l-cozqaVKVklmiaUbz_oUBZrWx1b3UPU-P25zludHKw&oe=6A452B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjmocW5f5icQ7kNvwFKLQoj&_nc_oc=AdrJGUcPD90URMci_E1A1O1v8pV1naS8u0zMecByJHCTsfhfCcmZ01HiTa58v1cIoCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QbvexGFfjU9ZjIMeDcHZxi_YTu3qiEeIYkN5yVfJluQ&oe=6A453468"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
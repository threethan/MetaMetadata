d": "127991675991805", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q9YFy4MMDYQ7kNvwECRDk9&_nc_oc=Adr5kpQZmLzz-jFT8cxokc_4OLFmlJCFqx0_31mU52hwK5aA1CNcvyEsBPWbckS52YE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fJaUkYYsPURNZCXPEsoWbuJI5FL-VTCSHFJE4Gn-uHw&oe=6A30220C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP3qN-eAIqwQ7kNvwH-h6M8&_nc_oc=AdpngymDrYutcshWxEtckveBQCle1YVfLLR4AyWDuPL_1_QOlEU90l1oCF29w-sXNWg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5RmYatwu1in86yrxRnBowvGxmxjRu8WX-4ERr6PNvLg&oe=6A3005AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B1ME8EhIcoQ7kNvwGxveTs&_nc_oc=AdpfR54Ne8LmaYMgbgitt4OKpo_vG--EsZSDlcYMnQyauwjixj4tjZY1lLsKNkwf2h0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v8NRzRdlw31aIRbJa8uYRiyuY4Mkdz1PRR6dc39ZlDA&oe=6A2FF50E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCcghtJugV4Q7kNvwFlQb0Y&_nc_oc=Adr61SPpuZx1HhrGMQuQeTdTZRD1pyYxR9LqKX6J89jKTnPz0MwIBZAG8HjPILcb-BA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Cy3AR4aetQZSg_-SqDUfAI2CL7pmbIDTJ9xjDhUSEQ&oe=6A301371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvHcR_tOOrEQ7kNvwGPVSOz&_nc_oc=Adq3lVrIR7Hc4puhmycsCb1VgXVMxm-QN_UK1QHf26L015BpAIgn291A7LFs--y-gf0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GnL0yRDPR_2z6ZGhTPVHO2qUyZqnseOkpQhQquoqnQg&oe=6A301C68"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5taULCk18sQ7kNvwEXKk-O&_nc_oc=Ado2oH-nMiJGbocCP8uwz6uCnC0CPLkZGh9w-N7R5liby3kog_6lplAlXtIBmfTsyfA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJg5ngMQupr0SuO7Nl2xTd40NL-O_zn-8AZUvlqsc9EA&oe=6A58C84C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9m8tyREQu0Q7kNvwGd_4h7&_nc_oc=AdovAfC46bv3N5iu1P35npa1P_9kbSUtgKLA0YaEXz430ot83YrFr-9UG9vepcsvKwk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeHyA5F4w8RzGiUB60p0eOEdxvbysLjWSL53LLumlahw&oe=6A58E42F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPpKz9j-IWQQ7kNvwEMd6vQ&_nc_oc=AdrBSr9NtAT3-1Ofmh58x_pODiqXXxcwDxL0Qt7W4ZHXFUPVd97K5oLJZqu3ijtYCF8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiXLYAPt1lZozc1ocKKjDVSpT26JBP-_2VT_e27_hNDQ&oe=6A58D38E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2Mx_yB8atcQ7kNvwFos4nJ&_nc_oc=Adp9vR2hUXUYFhHhqOkfqSe9C6IQ3LOZpyRnUWjV7Q2QPSR8UdpwsBaUREE_D_TbwCQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEIvCkzEFKEJy_cxmMa6TsGyJKoBsvPupGAc7oUTqO1A&oe=6A58F1F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZysVds_R5FYQ7kNvwEUUwS0&_nc_oc=AdpKTRIoA0hW0PvU3L0NAV2DR3qIHsRSgg61NV1mtmts3nPU3-7wp0EeP2qFb-XZrOs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXJES93IV8t0DdFItg2Z4c3LwW0QFvUi23DnpaG_N4FQ&oe=6A58C2A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4yl6Cb8JF4Q7kNvwGRlXrD&_nc_oc=AdrAffThZZTv2CecfXPNp3qR3U8KOKM9xWR-ES_pi_VDfuza2QQKkK7-eTW6WffJaDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TYyfVL6kGoht1rjkUT3BXcOnadVBvxqxt82r_bAjC5Q&oe=6A1EFE8C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr_s_-WX-OoQ7kNvwGJ1f1A&_nc_oc=AdoYfP6AGMEtJyJJqA_r7PnsXVzcTtKT8bqHSkta9wrto0lfDsJRR4km8MajEktRfVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B8tbVNnvQzZoDNCWITqbYlHQi9iti4lx_X55dHMgiNw&oe=6A1EE22F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgsv0dlPwt0Q7kNvwHQBHQE&_nc_oc=Adq9hhUHAbILWF26fo53DO7KfXktDSNaHUROgdIDAdEbC-EB2CmIu4As0h2aq5kenGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wUA2YtxNE_uMm2DdokmpFEmTxgpjLAS4tNe4Fpdi3uQ&oe=6A1ED18E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou8VCAhAQx0Q7kNvwHR6lYW&_nc_oc=AdobBcnalEZAefUuEioEQXUf16pQhYnF2bsK81qwCJqM7-poUC_j6KrroRFE0kJ2lew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61_VpiU3Ceg-q6-sEirwOKr27hMl-Zi5IuQx30h92eIg&oe=6A1EEFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXx1TD9CQ3QQ7kNvwENO34W&_nc_oc=AdoakZTw7XN5ArE0CEJ0KH6Oq8UVgZfK8X4S6fpwNYX8HiQ1q5cb3hz5yOxATVbt3J0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wpFG3KQDr_Sf7CmqmR5oqy6tP5T1xriCeWbvJoYeHrg&oe=6A1EF8E8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABqdbtBush0Q7kNvwFbZIP5&_nc_oc=Ado1frXzmnG76IpQ1xTWd9bpAXkaoT6FgFuJ-kLznmRpS260gknYnJU4uhrpyGT4RmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7LwxarpKo80sVkE7YC1ciLPrChSZpj-0bOHkL2cQAIQ&oe=69C27D4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIYii1ENTUsQ7kNvwG7rAvI&_nc_oc=AdpzQ72jICneaKqAHYyUHN_qb1Inaw9ZIIEKU9fYkbY6OHjnZbU8LWEGtnC5AnELqpU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG53fDKqTr-ZbbiUMpJpltgKuaL-Y-flzvp6fyKTSYSw&oe=69C2992F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6_eB4HIOXIQ7kNvwFmuYSE&_nc_oc=AdpaGt7VJr806h-zf5a7G-4_hKb1y1-e-BthZmtneGCTPy-YlLS8rEbt0fjRDRR1gWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyKdEwuNfwGQ6gP2bigiye9KnIw2OvxCe3R05zayzeHA&oe=69C2888E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra0igC4P3MQ7kNvwGeEqHN&_nc_oc=AdrW56u6yn9ZbkX2epi1EmP0urL3q5clxXvya5ZFKZbobPo5M5MX6u7N9LIDwGqQZno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMwUZoX-Yal693rhutn0oWu4PHzKVnqvxtwdFv45BuZg&oe=69C26EB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPUSXmDkCh0Q7kNvwEop0tN&_nc_oc=Adp7zrBgPMGGliSqQfgFlhrNJ0a_tAnTzplGEzozLiy7DeIQTFVKLAA40XPHGfWesMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh2NJSbHi2uvs_hXT4l6_oPsurUgMljTNoQiJsaTyrXQ&oe=69C277A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
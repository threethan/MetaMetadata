ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ1Izwk6dqsQ7kNvwHGEv-x&_nc_oc=AdlZBdBVUf7cRzV8ogQPKCyEnSUPJm9T3R_R-A4FpMICrfuX4iSOl4MwGagmMGi2Z88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZRWdZk7_czxC6nTDJWV_mzwNiGlDvyHj2X_T6JAi6Aw&oe=69AD654C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-hl0URfxyMQ7kNvwEulKFB&_nc_oc=AdkJ12sGb53wJ88t-BBq_9tHyKoe3IsgDUlvUPHrtm6QQmkd3ZemC0SqF92ejbiklHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRv3Q55stHOMLGA5c_cBzwEIl-Oqzi1_kMG_1fUW6frg&oe=69AD812F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0zZM3NMJdYQ7kNvwHKfiH_&_nc_oc=AdmLiqSgyyQZ25W7FEXCdwmrg__99tPAFItxRTNVouw-k3ysOrhYnZr541XwJWDG7LE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2QRvK3iY6OZEU7hGcpbseic7NaGgmCeMXzpmyrTUv9w&oe=69AD708E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcyfzZLsNwEQ7kNvwHNfH8H&_nc_oc=AdluFRc1hjr64zU478WTUBMDcQFgFMJAYYe0gj_ICy-DLZoWWdlkeg1HfsvbExNppaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9I9J-qhX7vwgKHl-djfui-Ot0UOh9UkAh1N25UFjOQQ&oe=69AD56B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x96krDegV7gQ7kNvwHwDF6r&_nc_oc=Adkpi11hXYqJz7wIH7QcYX9jIlvN7IpF8LnkYsZo51ZbcBCHstvtIePNWyfQ_70kixw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEh_oUYBWY1m3wu7icih58FmoHgT-RqB25E9e_xyOetA&oe=69AD5FA8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
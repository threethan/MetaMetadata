d": "127991675991805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LusKWgF1XfcQ7kNvwHSemjo&_nc_oc=AdoKWyOMGCbRyURBlOsAl8YgqWPoWnxve0VojvB_b22daXBmxLYd__ld8FRgjmoqij8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qIEzf0xDGzQHOy-Y7N6sqDVQ0Gmn_KS_TOB51hRz_Qw&oe=69F9DC4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WFKH4gqN9UQ7kNvwHacd7O&_nc_oc=Adp3CZCyQvupcVG-Q2ryL2HETuS3BMVmMeMYlihVxSLQmpBgNHuGaUy7ChK5pweHlRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TORIsYKdkRjSNrW2BFImXhJfihXVqb9SfD6J3m0XZUA&oe=69F9F82F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsoI5j2ALvAQ7kNvwF_VTQi&_nc_oc=AdpfN5EQm2ImiEBkOqw2TPhoR7qsNP8nTMBr6qZdZIDXVfj1X0EJqgod3TlPdzoiN1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72qRQ2DjvMvZfNUM30B-hVE9z31VYx1oftCvky6F2jCQ&oe=69F9E78E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp80j9TJS3QQ7kNvwHqb9Rk&_nc_oc=Adof_pFQlLNge726h5FisnBWiu1Zp5Jj8sALsPQNi5I6UfZUcfWpNG0T7oMHV5gOwoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MS7wBloCio0gCUVCqWdjhCwDI0b-xcDd4zzO67eKM2g&oe=69FA05F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef4-MixrmI4Q7kNvwFy-yRZ&_nc_oc=AdqxhM8i27kKkezSLDC4CT88Ho6lIeWDkvZ7IswuUJa4yr0im4sL38CAt14BKYDAbV4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kmbbdZqeOh9eoAGgNLMxFQk7iHU8TfQgBV6_0hmy5vw&oe=69FA0EE8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
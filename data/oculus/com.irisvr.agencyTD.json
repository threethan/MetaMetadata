d": "127991675991805", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZK0rDqUR0EQ7kNvwGBcOXq&_nc_oc=AdokG_3e5rhox31CQ4wvpH2uAWWUZ07hApXLL9jfN0y_9GF41t1-XN5TNaAA9zWcJLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48tz8qjUlmlDRasyXh84pFL3ar3uh7VDlm9d99yu_O7g&oe=69FDD0CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dit-ztJuiVEQ7kNvwEPCxOS&_nc_oc=AdquYOe4DwMw_hQBZz_NSA-yCaFlsdVT3zazZTp9aH59WsLhmjJf12KFlumfMMX1x6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i_4rJ91l_i_YEsz3zXflbl76EiA1UkA_OlrzNP03Q1g&oe=69FDECAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LtzySXqA1YQ7kNvwEIdYkK&_nc_oc=AdozAjNX-DsBpKcdIDoIOhhD1HkZwdJDymQM73fvpdK3PJ6sakEln_p2aqUXs3PcfBk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bov-WEQQBCNLmAR3kyZnqAwZ1xRG1WjY30ywZHZ_QTA&oe=69FDDC0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWjj91C-eq0Q7kNvwG5LHZt&_nc_oc=AdprsBTy5Kakyx7BVxf_6g9gWJ9LhSzDs1l6_ERGz1dmR5gsoCNvodp20NH6j4HOyPY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af779SJLmnpgCQk-2rQduzVq3adGrQAEiq047eEovVPB8g&oe=69FDFA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruEFrL9OeCQQ7kNvwF_VqSg&_nc_oc=AdpOxsP_OxNg-kDkOPCoXn3AmiHVOOtpw_3mSTFRHZsOhefEAvKmpAMJPf1RKwh48h0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OWZHDKqyg6O1DqgGqzJodZzNVwIPlz1LOxax9eVjo4Q&oe=69FE0368"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMbRoJBcfWYQ7kNvwHDkfY8&_nc_oc=AdphWvzRL1en6mGfCRBvI1GjXPOilsoMnRi-maZ1brAd9IbIGQueOhVw2s-pUj_e7gM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5x0hmD1-FWVek0Q0qYr_CpLUTX8O1rtYgwRqS-RDKwQ&oe=6AF9D78C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o74mnRIqkXQQ7kNvwEky832&_nc_oc=AdrDWV92L6QjTSZq_xaA0uK8oZY6pehtJK1gd3wk7dRk2pD-NfBoNJ2PKRB6q-Gui8U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMBswuduFJovKV2aGmx5W7kK9f6lgoTNGGdA6e0s8khA&oe=6AF9BB2F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hMq8t-KMvkQ7kNvwFVRzIn&_nc_oc=AdpKm0G0JyA2Ly9k4DEiJXrSkS1vfESS6GjOXJq24FcYRb3_qhDy1GI_kOHDd6nVDZU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSieScKIwADtLRS7iuKi4eeyMn2UPB0B0_L9MviG9sR5w&oe=6AF9E2CE"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prKiDRxcuiIQ7kNvwGTzfZB&_nc_oc=AdqYLRZmVUBgUFP7FP3kHtGyvLqKeMbv90ptGuvESkqPieej556KYBy1jolmtRJWWBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQllJ-Ogej8yTEHKlOMrss9XT7_N6G3LJ020pPdHsxMgg&oe=6AF9C8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVO2oK7kZ1cQ7kNvwE1MQkf&_nc_oc=AdqYAvQKJJPlQIcdazjiMrvjyzajr30fXq2opRKnLvFwfMJFkUrav38xJ2hGqyp52ww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSur36lZVTPpXJu8C9QwRLehSvOSs046eWn13i-4UqP8w&oe=6AF9D1E8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
d": "127991675991805", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INkHfoYX5MQ7kNvwHsCQ9i&_nc_oc=AdrUh8SWNEI4HJsayhognl7JAiVnb9iqbGPJgFzoZ5bClHfYCxNnnJdx02TwqvifAvI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oT5DQS29mFex3Z6ui8T0UJr84lUunPwDwiB_80GPy8Q&oe=69F4964C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOst9RP-OW4Q7kNvwFMvpfV&_nc_oc=AdrO8eU9JnF2upp9dRkAsAbTCcFG6HuvZ7bW_-ScmiWcDOKBSEvSdg0StcLhe7HSFIo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PwP6i0DGY0VCFkqKLdiDUcyhP_eKJ5zeSl6Y-U3n9Jg&oe=69F4B22F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaZh7Q4RhikQ7kNvwFb9uO7&_nc_oc=AdqNzEtI0xSrDBNKAInHb4-TvaUypeiVE8WfUxQraFfK8jCQQIipjvo5fvAopUpR-J4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VrWt8oHBKLegu6Xh6R0nDdgFgA6DueLEuNQx2865ntw&oe=69F4A18E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Elf5nBjMBd0Q7kNvwEh2pVt&_nc_oc=AdpDNn5EcUKBahLtccVuAMpteuNO6B1EBIhjmHHixl-Rh75bwrsbvJO8IBPm16DygrU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02G4dMAJFoDvezErb2u2ho3xnCWz6sTcZnswulaHNo8w&oe=69F4BFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCBSBuIk2eYQ7kNvwHRwrw8&_nc_oc=Adr_s_zbFpFcfTCTHxDDlR_wVZ0ptdO3Fnw09tIfCVLhXjLbWtg-TNyEEsMXXE2mcfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZVosRCXAC4_iL7fFlJiMm3g6EoHvyJEp1Np4k5MTvqg&oe=69F490A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
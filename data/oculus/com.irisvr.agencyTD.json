ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2y7YMEYHygQ7kNvwFLI_ky&_nc_oc=AdmG5W7l5Eu538IXRiEqwS9FpuOj8Q5k-AlGh-TGVMIj1XEjMsXDzTg4LgaSphteIDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftjD9HKqGCjz51-1lWXNN2-AeRx-544SN5K77eWimyMMA&oe=69A81F4C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1Tx-WUeu4Q7kNvwGQc0iO&_nc_oc=Adk34RYakw46z9kyH726mp-t5Lejwd3tWNwWHx2tsfzlI3YnALRvGHJMuT-hudUTE-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8nW_u9oIdKOtKTdqmcEAchIzr3_6D5LcU80yHNc2KZA&oe=69A83B2F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwuqeeoiAKAQ7kNvwG8FuTh&_nc_oc=Adm-6u28kxqIOERKbETew_P423K4wirR_wgHag7Pu-dDGbeSaNS3vE7IW9HYRGguiGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTNeJFyz7zg0QLC-WnyhzE4Fzx5n_MSBm2vejM4kil4w&oe=69A82A8E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJo4D1ya4OIQ7kNvwGYn-tw&_nc_oc=AdmL8YPhoNjQtt7HjMo9a-BgXUZC54N0fzrSAGmITsyMQ6X-_Oz4hJeeTpRu3ybu46U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft1WSjpZrOx5ytVV1S5tv2gPE5Dhonw3fXBGH8GZIrsBA&oe=69A810B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrsVEjsY6bIQ7kNvwFhgGYz&_nc_oc=AdnyV-HAhvQsLBIl98rmIdCR7JH7kLFVqQEDIgYPAIEbzS1hc2Ed45MY3eal-3siPG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNXKhkcRc6S5PQeOYK5E3fyIk_rAndRlVzLrW4gfWAMA&oe=69A819A8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52Ph8jQh9jcQ7kNvwFDfPLN&_nc_oc=AdqqWFVs13KCtYsG178NyRPN4KSngbtWewmb-qRMws3LfvuHYdRTMtTNBcRGkWQ8Z9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu2S-DnICB497Yfz5XtIz790s_E5PU9Odmi5rGsa7UFA&oe=6AF5E30C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h69BDwQcbZIQ7kNvwG11QXV&_nc_oc=AdqdetjZM8djCKSVxGPV_kEdspcOlXqgyQoG23sNcK5oCybq_TPP9t7kG-gv1R4x9l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPbIQuV3wTmSTiuPorFf7cjDGrNVNyw_QkHEJ3Q3oY9Q&oe=6AF5C6AF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8ErVXC2bp4Q7kNvwFU1Qra&_nc_oc=AdpNGzbleisOi9p9m1-bBIOqthwBL93z72vhnT3oMw7SlL-F_0ZuMJ4qiUIWd3wyYQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMN9y8ZPhtoPlLoWp-iu6cdvcbglWtvlNpnA31eFVcTA&oe=6AF5EE4E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY9-hWiHKgYQ7kNvwFAfg_V&_nc_oc=Adpm8kQQz-jnZRp1bSmhMlGpSJqyzCppamnFfKtQEQ0r1waTzZXXjB75ZrRbQSgOqWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpGtOpeJNapu8TU-NM4ZTbiC_KfUjhDyzlrjBLDVsMmg&oe=6AF5D471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3yOAtAKOwsQ7kNvwH9oe2i&_nc_oc=Adqd6xFjSmBkkHY6F3Pj8EOHxtiuUCsHKuW4nsa5a5p643v9IPjoeUdwUnG2Jx7ZiX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXuvvRRn79Hmf7m0Q5NTzLT-biNpzEN9985OEjkFzZvg&oe=6AF5DD68"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
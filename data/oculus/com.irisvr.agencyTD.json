d": "127991675991805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVQi2ObftMUQ7kNvwHulHXJ&_nc_oc=AdrCOQJjR1Uz8qZ5ITm2MwC1PSQo8SoHan2zwozQKcQrrcUV1KKHqMdKIc6LmV3nhFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u5FmWl8M1RH0HbdwwezRMNPPpf6raohdIPHjf2HR2Wg&oe=6A0AFFCC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOGhAMkOdAsQ7kNvwEovV1W&_nc_oc=AdoGz0bZbKDR4Cv8SKI5mzQliM7kDxURNCyHrLgk0jZDYNAGWVO7hoV34q6eD0edakU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KZDr6PVGRLQlkgntabRS6IJuklWqhdSNS7f2VBvAKCA&oe=6A0B1BAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Y3FQYREOMQ7kNvwGzsIMy&_nc_oc=AdqAziDfS4GhT8RJ9wDf58MxHi49TwsAthRi-UNUXowLv0VSMfNNtprCR50-UwKu24w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cBEnGipkGHXQo2NmkAavQak8VyhoC7M8V3Orn9iZXfQ&oe=6A0B0B0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jodv_ZwcO8wQ7kNvwGx3x-I&_nc_oc=Ados5n1ExCw2oRJJ749ecbRdbF19ONM9sXo0w9iO0t_kJWUpkTQt_03Z36zM3NHOl_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k7O8uc3rlJ6FCDJwgkUJZxEB3Fib4fy8jIQnL6ruxNw&oe=6A0B2971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRhyc9RaHzUQ7kNvwFw1vwl&_nc_oc=Adq3YmNdVtI7xg8HYiFFVLX1TyKlTUEOxzppGfK7L5TvmEhjVQv3sMvm68DqFYQH0lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RvodoIaVYVAh57LoDWyhYOpqXGJGwvPbDrlp4q9owEg&oe=6A0B3268"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar